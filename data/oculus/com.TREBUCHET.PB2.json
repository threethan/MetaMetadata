 in Crime.png", "id": "1024658029387143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572947_1024658032720476_5689212251956983818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMJmrtcC01IQ7kNvwG49VcR&_nc_oc=Adq_efIZUam18mwlVUSs7eZwx7jf7fTtKs8LQX3rRnmHpB4loi__ciHmEkvUgbCm5bg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhFsmhM4b3HdGu_Ib6au6ip15oQiQSA7ZbWlICSt6Bgg&oe=6AB002D1"}, {"file_name": "Prison Boss Prohibition_Screenshot_Oh Crap.png", "id": "425693563361363", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974835_425693566694696_370051274902793744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=409Bx_fcMuwQ7kNvwHv06bk&_nc_oc=AdrXxQBgrEU-iWMdQPgXTU5JVh2ZAEgUG2inBVVUPHoCv_IrNESiTKQ3IZhhVuZk6Nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnEgFxSSFSEuldfyBxAqsXp9HtpuswQPwr6hQSloRgKw&oe=6AAFE77E"}, {"file_name": "Prison Boss Prohibition_Screenshot_Hen-tastic.png", "id": "432454183172380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422387_432454186505713_9218756103114527940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aP0UzUZAfYQ7kNvwESJmRc&_nc_oc=Ado8gJELVYhi0g_2GRsu5CimiUsSF7887nk0pbsi1VXrmnIusd3iTuVJYBUgcrVklas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_5vr2la0O_Rki5jXL4GGeisVymoIjCttVCfhZVHdqlQ&oe=6AAFD1BE"}, {"file_name": "Prison Boss Prohibition_Screenshot_Money Money Money.png", "id": "1256824289025626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568673_1256824292358959_8673190978710547205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ItEspkBQ5sQ7kNvwH45MXF&_nc_oc=Adryq7vkODiybHDoID4cJjDsC8u-VlsKpxXZCgauPqG4uCSEs21r6EDJLZFXAGcwkFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUSPOZPvg8Ye3BIVn5MrRMv3I8aNIcrWw7UtTVjnHJEA&oe=6AAFF7C9"}, {"file_name": "Prison Boss Prohibition_Screenshot_Something Fishy.png", "id": "884975446873311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974561_884975450206644_8203175898811460979_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9djrQLia2LsQ7kNvwFrtHe4&_nc_oc=AdobNINWfSwfYSkp2pl8IledigzKptnxIAlz_zo0m_KaH_kINKGt7iGhURO65hX_uwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0HJTr1jeRKTcjsPPXfaunbDXd8y-0RgUG68M28bX7UA&oe=6AAFED29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prison_Boss_Prohibition_Landscape_2.png", "id": "900749498575041", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974685_900749501908374_6816906205502750065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18PjOaG5_KEQ7kNvwFEfm1u&_nc_oc=Adq3OLNJXzNvAG6RpS-Gj8yup-hAU2IY67167d19veoKyHJSMbw-AjoouwVjCEc1Bfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEtZ7FykylhCxCGeoSO2DeDbt3AznqmANSkPBpkXkgEA&oe=6AAFED6E"}, "display_name": "Prison Boss Prohibition", "keywords": ["coop", "multiplayer", "simulator", "tycoon", "job"], "long_description": "Welcome to New Yolk City! A wonderful place to live, except for the Mayor's harsh prohibition. Run various shops throughout the city, crafting and selling merchandise that's both strictly legal and questionably not, all to get super duper rich!\n\n# PLAY SOLO OR GET A PARTNER IN CRIME \nYou can become a self-made-egg or play in co-op with one of your friends\u2026 or a totally reliable stranger from the internet.\n{1931018550679511}\n\n# BUY AND STORE YOUR SUPPLIES\nSupport the local economy by sourcing your raw materials from nearby suppliers. Rest assured, this premium tobacco is not only smuggled but also certified organic and fair trade!\n{839268621662680}\n\n# CRAFT WITHOUT GETTING CAUGHT\nBrew the finest illegal beer in New Yolk, roll cigarettes, and adapt as the Mayor flip-flops on what\u2019s prohibited. But be careful\u2014the New Yolk Police Department is intensifying their crackdown on contraband. If they catch you or your partner, they\u2019ll seize your merchandise.\n{391810040388901}\n\n# EARN CASH AND REPUTATION\nSell your merchandise to everyone, from workers to the wealthy, to earn cash. Accept special jobs to boost your reputation among the different factions of the city. Build that street cred!\n{487577804078148}\n\n# CUSTOMIZE YOUR SHOPS AND LOOKS\nNow that you're rich, it\u2019s time to get richer! Upgrade your shop and equipment to increase efficiency. Enhance your appearance to become the coolest cock-a-doodle-dude in town!\n{878456107496343} \n\n# THE GAME WILL ALSO INCLUDE:\n- 4 different levels\n- 20+ items to craft\n- Leaderboards", "short_description": "Prison Boss Prohibition is a VR crafting game where you play as a shop owner smuggling prohibited stuff. Produce and sell beers, erotic magazines, cigarettes, and more! But watch out, the police are cracking down on contraband! "}]}, "developer_name": "TREBUCHET", "developer_privacy_policy_url": "https://trebuchet.fun/prison-boss-prohibition-eula", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET", "support_website_url": null, "website_url": "https://trebuchet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "9097178063642346"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1080163567832460"}, {"status": "PUBLISHED", "id": "1061223002993610"}, {"status": "CANCELLED", "id": "1371230994836564"}, {"status": "PUBLISHED", "id": "1484668233066508"},
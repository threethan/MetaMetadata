tent-ord5-2.oculuscdn.com/v/t64.5771-25/491823398_4205001486487069_1618644476196036336_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN2iIF_EKdAQ7kNvwHOaSey&_nc_oc=AdoJ1KOg86SIqf1gSIlUfR7QlOnpv-ueZwyru1PsH0-ot-NnZ_IQ-Yh3HC3tKzDneoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cpocl_4AkkgZOqpOviowdFG26g1l_NwrvG6lTANYmkg&oe=6A01ED5B"}, {"file_name": "Screenshot6-Mouette.png", "id": "739223172059033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822800_739223175392366_317344347960101093_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7efSw_dCbMQ7kNvwERLevw&_nc_oc=AdoLQIrGTlSQ9AU_9QJO9aS37Gu3B4uwyN2Gml6RbfW1tldddEIUWDsuDHapaIdrXn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H2mbzxlFvPy_RrpJFPcqaibYjIXGl3jcXYe2c7ZOsmQ&oe=6A01D3CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Thumbnail.png", "id": "2112347326210378", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_2112347329543711_1022472039446489060_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvSvv3qKW2sQ7kNvwHlhplk&_nc_oc=AdqgJQ4h4Gsfey0s02nhgwbdn57Xe7L27S954wbVDYWNwS6tyO_cyt-W5Du7Ec25tjI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72TKpa59b71bb7pgSwYAAJbXnXJfZMbARBQ7jdP6Vw9A&oe=6A01CA17"}, "display_name": "Crime Shop Simulator: A Prison Boss Game", "keywords": ["multiplayer", "simulator", "job", "craft", "cooking"], "long_description": "                                                                          \n\n\n**Crime Shop Simulator** brings the crafting and simulation antics of **Prison Boss VR**  out of the slammer and onto the streets!\n\nYou can become a self-made-egg, play in co-op with one of your friends\u2026 or recruit a totally reliable stranger from the internet.\n\n\n\n{1406188351090863}\n# PLAY IN CO-OP WITH A PARTNER IN CRIME\n{552076781316863}\n# CRAFT WITHOUT GETTING CAUGHT\n{2876644245848569}\n# EARN CASH AND BUILD YOUR REPUTATION\n{1780452482869691}\n# CUSTOMIZE YOUR SHOPS AND LOOKS\n{1389387445440565}\n\nRun a chain of stalls crafting legal and not-quite-legal merchandise,  all on a quest to conquer the black market and get super duper rich!\n\nBrew beer, roll cigarettes, and adapt as the Mayor flip-flops on what\u2019s prohibited. But be careful, the New Yolk Police Department are intensifying their crackdown on contraband. If they catch you or your partner, they\u2019ll seize your merchandise, and your business will be plucked!\n\nSell your merchandise to everyone, from workers to the wealthy, to earn cash. Accept special jobs to boost your reputation among the different factions of the city. Build that street cred! \n\nNow that you're rich, it\u2019s time to get richer! Upgrade your shop and equipment to increase efficiency. Enhance your appearance to become the coolest cock-a-doodle-dude in town!\n\n# THE GAME INCLUDES:\n- 3 different levels\n- 20+ items to craft\n- Leaderboards  \n\u2026 And more!\n\nJoin us on Discord: https://discord.gg/prisonboss", "short_description": "Crime Shop Simulator brings the crafting and simulation antics of Prison Boss VR out of the slammer and onto the streets of New Yolk City! The Mayor has gone on a banning spree, and now the black market is thriving. Work solo, or recruit a partner in the new co-op mode! Roll cigarettes, brew booze, and stack up mountains of cash, all without getting busted by cops on patrol."}]}, "developer_name": "TREBUCHET", "developer_privacy_policy_url": "https://trebuchet.fun/en/page/privacy-policy-pbp", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET", "support_website_url": "https://discord.gg/prisonboss", "website_url": "https://trebuchet.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscript
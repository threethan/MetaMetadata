n Crime.png", "id": "1024658029387143", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572947_1024658032720476_5689212251956983818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81_0Ix5c_FQQ7kNvwHdcjI0&_nc_oc=AdrUP1wY-yBCCYEtNAaGnS6s60TdpyH5ZgboQz6X2gGlGYcMKOTpwg3IwKEnK_-r6zI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK0k7tUTvMiYX47cyiZgTW7bijz6342Opyu0VJ4vB5Fw&oe=6A81A611"}, {"file_name": "Prison Boss Prohibition_Screenshot_Oh Crap.png", "id": "425693563361363", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974835_425693566694696_370051274902793744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzLQl7xPssoQ7kNvwFZsqsu&_nc_oc=Adow0bd9t49ODmSOJgrWc8LPCn1jOIIn9m3mwP-4gGF4TzIo-pCYtkBhxxtCVK5xRqg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv9ycZz6krF6zRKkdymYFtASTl6OIk4aM3jTubdot1vQ&oe=6A81C2FE"}, {"file_name": "Prison Boss Prohibition_Screenshot_Hen-tastic.png", "id": "432454183172380", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422387_432454186505713_9218756103114527940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVerHzk1RpgQ7kNvwEjolDU&_nc_oc=AdpwhhQwTftEPTUMQ5vzODzezdJFYUKVjMPsS2codTwGyxZFHevvVAeeOD1z3QpoBRw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNwtSBP2MRxwdw4IH3-BIeu9QTrxVNzdhQRoWZZ3b4fg&oe=6A81AD3E"}, {"file_name": "Prison Boss Prohibition_Screenshot_Money Money Money.png", "id": "1256824289025626", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57568673_1256824292358959_8673190978710547205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37UG594NjZEQ7kNvwFdxzeS&_nc_oc=Adr9YPfgcFMldIPo1fD1r8BgaALDTDk0TJLIGKLbKxouGRMaYg-_rrIECUPLr3hv92M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAYTs4YnauwSB5eYvNb0q-hZLpa_TVErfPW8Za_RYUgw&oe=6A819B09"}, {"file_name": "Prison Boss Prohibition_Screenshot_Something Fishy.png", "id": "884975446873311", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974561_884975450206644_8203175898811460979_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_B0ZpYFC2cQ7kNvwF7Uh3e&_nc_oc=AdrHUEkH_LOA0ZoFI0xCrhT5Pshs5dIXLLJkvSPzvpnKWTMLRMU2qn0vJMrsg_jIlwA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX0Kd0VU5GKuGSeV6fYK5Izo0mU8UKmeFeMviuyXzkYg&oe=6A819069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prison_Boss_Prohibition_Landscape_2.png", "id": "900749498575041", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974685_900749501908374_6816906205502750065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJfZ4b3U63sQ7kNvwEcFbU3&_nc_oc=AdpzwZbNllBKumb5PK1bTuig3QXqwqhiIno-4UOPu7AWC04eRDtgMVukt6gDAXdV6wI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs0PTeYC4HHG8yL2WnDwgNaiT_bLr7gzzbtJANS5u8BA&oe=6A8190AE"}, "display_name": "Prison Boss Prohibition", "keywords": ["coop", "multiplayer", "simulator", "tycoon", "job"], "long_description": "Welcome to New Yolk City! A wonderful place to live, except for the Mayor's harsh prohibition. Run various shops throughout the city, crafting and selling merchandise that's both strictly legal and questionably not, all to get super duper rich!\n\n# PLAY SOLO OR GET A PARTNER IN CRIME \nYou can become a self-made-egg or play in co-op with one of your friends\u2026 or a totally reliable stranger from the internet.\n{1931018550679511}\n\n# BUY AND STORE YOUR SUPPLIES\nSupport the local economy by sourcing your raw materials from nearby suppliers. Rest assured, this premium tobacco is not only smuggled but also certified organic and fair trade!\n{839268621662680}\n\n# CRAFT WITHOUT GETTING CAUGHT\nBrew the finest illegal beer in New Yolk, roll cigarettes, and adapt as the Mayor flip-flops on what\u2019s prohibited. But be careful\u2014the New Yolk Police Department is intensifying their crackdown on contraband. If they catch you or your partner, they\u2019ll seize your merchandise.\n{391810040388901}\n\n# EARN CASH AND REPUTATION\nSell your merchandise to everyone, from workers to the wealthy, to earn cash. Accept special jobs to boost your reputation among the different factions of the city. Build that street cred!\n{487577804078148}\n\n# CUSTOMIZE YOUR SHOPS AND LOOKS\nNow that you're rich, it\u2019s time to get richer! Upgrade your shop and equipment to increase efficiency. Enhance your appearance to become the coolest cock-a-doodle-dude in town!\n{878456107496343} \n\n# THE GAME WILL ALSO INCLUDE:\n- 4 different levels\n- 20+ items to craft\n- Leaderboards", "short_description": "Prison Boss Prohibition is a VR crafting game where you play as a shop owner smuggling prohibited stuff. Produce and sell beers, erotic magazines, cigarettes, and more! But watch out, the police are cracking down on contraband! "}]}, "developer_name": "TREBUCHET", "developer_privacy_policy_url": "https://trebuchet.fun/prison-boss-prohibition-eula", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET", "support_website_url": null, "website_url": "https://trebuchet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "9097178063642346"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1061223002993610"}, {"status": "CANCELLED", "id": "1371230994836564"}, {"status": "PUBLISHED", "id": "1484668233066508"}, {"status": "PUBLISHED", "id": "1268786688765582"}, {
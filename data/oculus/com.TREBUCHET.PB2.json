ime.png", "id": "1024658029387143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572947_1024658032720476_5689212251956983818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fH3XpX47cYYQ7kNvwFK-Yjh&_nc_oc=Adp1b0Nf7DyV5KVuB4jJ3ZhnRfe9Gl-yJ6YhivnUHVqNnhTSBaHygkT88rMAUWUzZgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LxedhIOvf-yzhfoJqfBPlten2H8nSRdZ_OIjkAy4ilQ&oe=6A05B911"}, {"file_name": "Prison Boss Prohibition_Screenshot_Oh Crap.png", "id": "425693563361363", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974835_425693566694696_370051274902793744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ra8CcTKTB-AQ7kNvwFB-uw7&_nc_oc=AdosFUvstq-vQqf-o11UCRXqCz5bKWcnzCRzHmL1rUBhOCdySMDmIAcae9psKJiliIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M5203fIIGsHZSNHJnwtACBB8f7J72Y6XpVpH4Lb6yaw&oe=6A05D5FE"}, {"file_name": "Prison Boss Prohibition_Screenshot_Hen-tastic.png", "id": "432454183172380", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422387_432454186505713_9218756103114527940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joAvAVLLHPoQ7kNvwFQUSA9&_nc_oc=Adr5omCIMFBhi9MKAhcmkzIhns6GcQUFTZRRFtXbo0PDV14X3GehgdTz5aJomM0Sz24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c18v3fCQQ-056dUg7RVx7MHRrB71rbyyxuyqNqsA7pw&oe=6A05C03E"}, {"file_name": "Prison Boss Prohibition_Screenshot_Money Money Money.png", "id": "1256824289025626", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568673_1256824292358959_8673190978710547205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDn4gF9iGfgQ7kNvwHreflq&_nc_oc=AdrmbmPhfKhav64d3N5Ru0vHaUrRbXV1C8IjtjyMQALyEJoxeyQVb0z6BcWVNyvXJ9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pPXVyt9gfhVGIJwnKm2h73QFRhw596rwZobhaX6VkIw&oe=6A05E649"}, {"file_name": "Prison Boss Prohibition_Screenshot_Something Fishy.png", "id": "884975446873311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974561_884975450206644_8203175898811460979_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdrL4qOrnxQQ7kNvwF3CQZQ&_nc_oc=Adr7mfrVSF7ksflviJj7CwjJEZgnqLQFM26kmqWQI8nKicW0nOYIpaYFv9jneQ4EgXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N3KRekZFjJg7u5UOiIQ-Gyy3u6kwfrdHTwJMqwCoSTQ&oe=6A05DBA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prison_Boss_Prohibition_Landscape_2.png", "id": "900749498575041", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974685_900749501908374_6816906205502750065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gtHhnDgcKkQ7kNvwEB-Zbg&_nc_oc=AdrSah3KzYEs2CAHpRew7xsMKDh7XEdjnD4ZnfDXhkVqxf9EmJhSFQQ9_wYimgw2GzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nWVdANkCJ6gO_3ms7biQrA95PEAhnz3Ha5q5Pn4FhDA&oe=6A05DBEE"}, "display_name": "Prison Boss Prohibition", "keywords": ["coop", "multiplayer", "simulator", "tycoon", "job"], "long_description": "Welcome to New Yolk City! A wonderful place to live, except for the Mayor's harsh prohibition. Run various shops throughout the city, crafting and selling merchandise that's both strictly legal and questionably not, all to get super duper rich!\n\n# PLAY SOLO OR GET A PARTNER IN CRIME \nYou can become a self-made-egg or play in co-op with one of your friends\u2026 or a totally reliable stranger from the internet.\n{1931018550679511}\n\n# BUY AND STORE YOUR SUPPLIES\nSupport the local economy by sourcing your raw materials from nearby suppliers. Rest assured, this premium tobacco is not only smuggled but also certified organic and fair trade!\n{839268621662680}\n\n# CRAFT WITHOUT GETTING CAUGHT\nBrew the finest illegal beer in New Yolk, roll cigarettes, and adapt as the Mayor flip-flops on what\u2019s prohibited. But be careful\u2014the New Yolk Police Department is intensifying their crackdown on contraband. If they catch you or your partner, they\u2019ll seize your merchandise.\n{391810040388901}\n\n# EARN CASH AND REPUTATION\nSell your merchandise to everyone, from workers to the wealthy, to earn cash. Accept special jobs to boost your reputation among the different factions of the city. Build that street cred!\n{487577804078148}\n\n# CUSTOMIZE YOUR SHOPS AND LOOKS\nNow that you're rich, it\u2019s time to get richer! Upgrade your shop and equipment to increase efficiency. Enhance your appearance to become the coolest cock-a-doodle-dude in town!\n{878456107496343} \n\n# THE GAME WILL ALSO INCLUDE:\n- 4 different levels\n- 20+ items to craft\n- Leaderboards", "short_description": "Prison Boss Prohibition is a VR crafting game where you play as a shop owner smuggling prohibited stuff. Produce and sell beers, erotic magazines, cigarettes, and more! But watch out, the police are cracking down on contraband! "}]}, "developer_name": "TREBUCHET", "developer_privacy_policy_url": "https://trebuchet.fun/prison-boss-prohibition-eula", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET", "support_website_url": null, "website_url": "https://trebuchet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "9097178063642346"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1268786688765582"}, {"status": "CANCELLED", "id": "1675923550432669"}, {"status": "CANCELLED", "id": "3488671511285848"}, {"status": "CANCELLED", "id": "875481731752493"}, {"stat
 in Crime.png", "id": "1024658029387143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572947_1024658032720476_5689212251956983818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE44HCUwuK8Q7kNvwEmJOMF&_nc_oc=AdoqpFMfEvjpBwUkSOWnsFwrcKK8XmYtKfkuWbzzBRdu3j5h7nUrt5ZV7XgnjXH0TbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1gndcbWijtL8jlflnVTT7_P2DQnd-fqbEJ5qYBqj5QA&oe=6A6C8E11"}, {"file_name": "Prison Boss Prohibition_Screenshot_Oh Crap.png", "id": "425693563361363", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974835_425693566694696_370051274902793744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMnceUudZMgQ7kNvwHjvs-I&_nc_oc=AdrBgs9JWdx61kuSEGOLn4DCdIQ3V4zHbrzkLPH9MixS-lVmCp2P5L6QxLxm0moi1po&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBto1UqCoI8z6JVO4xTykJwxiI1tJYpx2b_iY675M2vaA&oe=6A6CAAFE"}, {"file_name": "Prison Boss Prohibition_Screenshot_Hen-tastic.png", "id": "432454183172380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422387_432454186505713_9218756103114527940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1AkBA9LnTgQ7kNvwEvu57L&_nc_oc=AdqrQ6DpCnyQp-dRsJBiA6URJiPxWV5f7gFXjTpBeD6JoAANGsR_vv-xFFjWXSbtRy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdTxiS2ogAPLvOCFIKhoGYiHqu1_n-AttU1jCQ1bGMVQ&oe=6A6C953E"}, {"file_name": "Prison Boss Prohibition_Screenshot_Money Money Money.png", "id": "1256824289025626", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568673_1256824292358959_8673190978710547205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjPuhxzggWAQ7kNvwESeYJs&_nc_oc=AdpTMBlobeQ79jQsf1Osug6k-KnJVG-B7HI4nYtdGJ-j3zylBKHShYCe9bDqfcoOfT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfDV3ijg3gMA0NKRprXdAeOZjV4z8q8fbto4k7Mlg7_g&oe=6A6CBB49"}, {"file_name": "Prison Boss Prohibition_Screenshot_Something Fishy.png", "id": "884975446873311", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974561_884975450206644_8203175898811460979_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOfbiTpQrk4Q7kNvwGKeyau&_nc_oc=Adov4T0-EbIkGqv2bmZSHOFACUEqdegbd2FaBCyFE4HgwA8gjL9OymL-i1gIFSD0E6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxQABOrbrOJ8SrzTIy9xLQ2X2wrlZj0k46TfB1G2Ecpg&oe=6A6CB0A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prison_Boss_Prohibition_Landscape_2.png", "id": "900749498575041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974685_900749501908374_6816906205502750065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hJ5tfTNarwQ7kNvwGTG_gI&_nc_oc=AdqT_hrTOorRq96s_lZgx9GGWFZosCAPpswsHFy9IvOerYqZpPWWIachY-e0_DzTnzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPoeKReZMlDu64INC_qRnrGvihBi2xXR35YdFSgnaBgQ&oe=6A6CB0EE"}, "display_name": "Prison Boss Prohibition", "keywords": ["coop", "multiplayer", "simulator", "tycoon", "job"], "long_description": "Welcome to New Yolk City! A wonderful place to live, except for the Mayor's harsh prohibition. Run various shops throughout the city, crafting and selling merchandise that's both strictly legal and questionably not, all to get super duper rich!\n\n# PLAY SOLO OR GET A PARTNER IN CRIME \nYou can become a self-made-egg or play in co-op with one of your friends\u2026 or a totally reliable stranger from the internet.\n{1931018550679511}\n\n# BUY AND STORE YOUR SUPPLIES\nSupport the local economy by sourcing your raw materials from nearby suppliers. Rest assured, this premium tobacco is not only smuggled but also certified organic and fair trade!\n{839268621662680}\n\n# CRAFT WITHOUT GETTING CAUGHT\nBrew the finest illegal beer in New Yolk, roll cigarettes, and adapt as the Mayor flip-flops on what\u2019s prohibited. But be careful\u2014the New Yolk Police Department is intensifying their crackdown on contraband. If they catch you or your partner, they\u2019ll seize your merchandise.\n{391810040388901}\n\n# EARN CASH AND REPUTATION\nSell your merchandise to everyone, from workers to the wealthy, to earn cash. Accept special jobs to boost your reputation among the different factions of the city. Build that street cred!\n{487577804078148}\n\n# CUSTOMIZE YOUR SHOPS AND LOOKS\nNow that you're rich, it\u2019s time to get richer! Upgrade your shop and equipment to increase efficiency. Enhance your appearance to become the coolest cock-a-doodle-dude in town!\n{878456107496343} \n\n# THE GAME WILL ALSO INCLUDE:\n- 4 different levels\n- 20+ items to craft\n- Leaderboards", "short_description": "Prison Boss Prohibition is a VR crafting game where you play as a shop owner smuggling prohibited stuff. Produce and sell beers, erotic magazines, cigarettes, and more! But watch out, the police are cracking down on contraband! "}]}, "developer_name": "TREBUCHET", "developer_privacy_policy_url": "https://trebuchet.fun/prison-boss-prohibition-eula", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET", "support_website_url": null, "website_url": "https://trebuchet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "9097178063642346"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1681395686100933"}, {"status": "PUBLISHED", "id": "1442663023781842"}, {"status": "PUBLISHED", "id": "1061223002993610"}, {"status": "CANCELLED", "id": "1371230994836564"},
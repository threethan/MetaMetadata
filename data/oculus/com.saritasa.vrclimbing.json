}, "display_name": "VR Tower Climbing", "keywords": [], "long_description": "Challenging skyscraper climbing.\nExperience the thrill as you climb from one floor of a building to another by utilizing your surroundings as a guide through intricate architecture.\nUse our leaderboards to see how fast you can get to the top and compare your performance to your friends.\n\nFeatures:\n\n- Variability: reach the top of the skyscraper using different routes;\n\n- Leaderboards: upload your highscores to Oculus Leaderboard and compare them with your friends;\n\n- Tutorial: learn about game mechanics on a special training ground and practice them to perfection.\n\n-  Fun: exercise your body and thrill your nerves substantially by climbing atop a skyscraper.\n\nDeveloped by Saritasa.", "short_description": "Challenging skyscraper climbing.\nExperience the thrill as you climb from one floor of a building to another by utilizing your surroundings as a guide through intricate architecture.\nUse our leaderboards to see how fast you can get to the top and compare your performance to your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/a3c389bf-b853-4539-9b01-840dd37d7716", "developer_terms_of_service_url": null, "publisher_name": "Saritasa", "support_website_url": null, "website_url": "https://www.saritasa.com/3d-development", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
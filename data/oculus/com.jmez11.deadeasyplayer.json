cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3os_P4l389AQ7kNvwHbIGw5&_nc_oc=AdobvbnvoFe4eSLdSi3wBdP7c18XB9WT1WlY4t2HjzJngIUBcyFiVkmRAdL6ZWjlLxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyexFv5u45WOhTuQrTEJsDL3FAmzuHY7lA-4pKSFDH2A&oe=6AE9F0C8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evtjZG8DNU8Q7kNvwGYUtXI&_nc_oc=AdrKQUlbn_MpLXCistcdv4RW6hG18_jhSiA-ynqmxa-B4DBXCi4hzBu-0cj1pqDBz-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUCBTrYSbC5dt4Sk82M6wFbhmJkR-FK-oOH6ituaiAxA&oe=6AE9DF17"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Rgm7AgCp-IQ7kNvwFj0A8t&_nc_oc=AdpZNbNwlHPy5MpZHEZeDH-uFyil14nXIy98t6IRq2iV0sju2j9uX_HmxD3xaKbnVYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAYjMyNet072lkVRZqahCU9R7KoP3S4Ed6v7bg5p2D5g&oe=6AEA0828"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
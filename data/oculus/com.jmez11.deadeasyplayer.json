cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG0ym8Hu478Q7kNvwFHeXkR&_nc_oc=AdqAMA_CtVp26DkqfMWJQkEiH5MbABmKOIe3XOBVfibK3sNj6I93MQo-jZM3nl0HbVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqM9rLY3VO2S_Tt-4D1SpPAaMUU2h3-41lPgQDhkCtvQ&oe=6ACCEFC8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRiI9iA4RKUQ7kNvwGYd5A2&_nc_oc=AdpnHWvmaZsE5m1nY5VzuKC32Uo0DsATzlQiMGuzDiAn0GZpYGLCawpEeySgRpKnkF0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQSl3-ARIb98mv0zorgc5b6t8L7B8uObmtd5wTDp4Oow&oe=6ACD1657"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_RgsIWQRPAQ7kNvwERRHOc&_nc_oc=Adp3mfwSpsYluWcEShJ97GeUPA5AaxTMGZ8_7q70CdLn3HBrxf18vHwLVSS9Y6Dl6TA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp4NPisKPerNrcik78E_cjuDIZXP7G8BY14K9vCdXzaA&oe=6ACD0728"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
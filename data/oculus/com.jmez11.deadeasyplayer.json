219"}, {"file_name": "deadeasy-screenshot-04-2560x1440.png", "id": "1644469890803396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg4Hd9xfN8kQ7kNvwGOl2Ov&_nc_oc=AdqjK4B5ojbfwvbLlAYuIfM6phikgjOQfirMOgFxXb_2DhPA1a0gwI4-o9129rk81Nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmI9YOQ8JGQI6YdxlI6wPUH6EEhQqNiW7nOMAZnbfYJA&oe=6AF47CC8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdTkcXReXM4Q7kNvwEf3Abz&_nc_oc=AdrC9GKYitxbm50ELxS2rXagNQIVhMISSsgLu-iOQqELpIkU9FlC1A3Y5HrYuQ1jA2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMb8ciFJCkXly4IRH1sVRieiM4LXjjUXH6nuTxE4Z9PA&oe=6AF4A357"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lP-0IixykoQ7kNvwGIgocR&_nc_oc=AdrbluBftSRml_Z_eZFcMMAvciqM481a5_T0DRbnbmG650hiqezNWseYlykifQVXDTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCg29FU-E8suAuWr1XkqnO_ucQMZ4q2uE3sgQDTxcRWQ&oe=6AF49428"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR ci
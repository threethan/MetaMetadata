ur headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "developer_privacy_policy_url": "https://jmez11.github.io/deadeasy-player/PRIVACY.html", "developer_terms_of_service_url": null, "publisher_name": "OceanSideVR", "support_website_url": null, "website_url": "https://jmez11.github.io/deadeasy-player/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1481750990680256"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499621314_2051888265434993_5048736291123824434_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzphK2IG5FAQ7kNvwHniQqa&_nc_oc=AdpPmBm-TJlhybdITa5riThTsRPKMLkT4iPRc0lPT4BaN31TUSUge8TGVxrwr3qdX-4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2RYr6HFf24NVuN-0qmcoh26WQz_LOHdzANZnmY0JXVQ&oe=6B084404"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DeadEasy Player", "platform": "ANDROID_6DOF", "context_category": {"context_ca
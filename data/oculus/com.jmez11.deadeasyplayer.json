cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GYG1TgJKJUQ7kNvwHx-8Za&_nc_oc=AdqAJKDgGoySIkYPuQfUNwZoF1-Jkpz1c49tkJ1DSm7jalRa7je69tQC8bTWLtuXdRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnEj1R_fVOmokPDWC4Gv3pznZJGBrLsfD3M5nuczRHhQ&oe=6AC65848"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1crDIv0h8UQ7kNvwGdNLp1&_nc_oc=AdqWAfVmCBppd1Fx-MrSkKPpLayhpuKBlS8u1M7rvN6Ci4HrVmyPjbyq1xfnTUgrENs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmpEJuTD6xarxG8jrBkFQXU19tzr_uQa-sdefRrWTfwQ&oe=6AC64697"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqFsWXkv_vYQ7kNvwEG8wAN&_nc_oc=AdovLEbUWc2eSjzdNc4e_2iORo0VrOAm_n_MsjQ1qr5MairNTcr_ZsCB0YjsdJGwMPc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQMRrd1EU28TtLitUxFBqFotNL6xMw_UujsBO3oplorQ&oe=6AC66FA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
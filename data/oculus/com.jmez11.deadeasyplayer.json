699"}, {"file_name": "deadeasy-screenshot-04-2560x1440.png", "id": "1644469890803396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhbwMGI0kqYQ7kNvwEEu1sH&_nc_oc=AdplXC3ZcYf-vC3QyK4cfF8AAK18vyBJca8zGQmONdeIrydq5qmilydquf7urmHHDak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXfnJH-KKn9T6Coanv5LnnrUz2eEBF50VogZfTLcbSVQ&oe=6AF8A988"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mgw-1MQypikQ7kNvwH8jQil&_nc_oc=AdpZqflh3a3P9NjQLgOU9KbvfkHe-35wI0Y-SBiVxjH22bBn9iIR_dnKerascUPFA3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQEsVyNTr3xokk4VNRGoF1MP-e716tYadh-4cENBxcMw&oe=6AF897D7"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HatezHl_e2YQ7kNvwH-p8nP&_nc_oc=AdpK6DDvbEavm3awgYsqthxaS2wD5_zareApSs-wDuS1r_W_AZWzHtVzsodg9KaWgqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_7vGVE9ZbO0yyj3aSQr9rK2WE1z102T123s1lyZ7iyw&oe=6AF888A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR ci
cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic3mQlMW7roQ7kNvwFa-Spz&_nc_oc=AdrBbKjJ49NmQtnwvJR5UTgh5FzHLiGtXCXhhjE6wWG_sQ1oYFS5fR21OrmX-DZ90_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9IHWHjdH6906IQYA4A41avXSmQL_Y6UKdl3U9EjH71Q&oe=6AE0B648"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3CM9XXtD3EQ7kNvwE96nzd&_nc_oc=AdrnOlrG7kH19ByQYLSVgg4zXl7-HQbBc34YqvVF0GbwyA1C57JS6n-vJKMA6-bfhJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLlWsToRJdQRIM13wBdSfq7wNRAOPzjfl1hkdj-A4mrQ&oe=6AE0A497"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AwvEivMl3sQ7kNvwEYBLAg&_nc_oc=AdrJYgoLbOP20HKdTgd5UCyisVjfTKOZxzKBLsYrMuGfPM7R0mdU1nzTVT0C9Ez6Vsc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0jzQ8S_8GhS_bJmjLfhQptBBM-gKfb2T_XeOmlOyKDg&oe=6AE09568"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3os_P4l389AQ7kNvwGkGHN4&_nc_oc=Adq_qPUpRIviuRDi9k-r9zjMTL6Dplj8YHMpBT9JgrerY_PzltFz2WkufsRLJOf96HM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Y6iktH-E6HCVabcZ4PpHVEqIvsb9cY5S9dtV39wkwA&oe=6AE89F48"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evtjZG8DNU8Q7kNvwHPDqso&_nc_oc=AdpLhgrQiISNoLc-md2FMetxLFmTEQ7Hu72M9amusUJAROWZ9Lb-j2JA-TWm5i27v8M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ5ZGGElALK17RplEeGZsOjQkWmIK5czecSCy4Do8Ubw&oe=6AE88D97"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Rgm7AgCp-IQ7kNvwEs7WjQ&_nc_oc=AdrY4-_sOUG9SRlqZJdHhhX-OwIVsyEeFC_FK7CNCB6BVzRwkQcjbCvXo3k6z-Bj7mQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzisE4XsPK2Uqt7HVsL-MCyPLAa9kF4h8CFp1kqmdTig&oe=6AE8B6A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
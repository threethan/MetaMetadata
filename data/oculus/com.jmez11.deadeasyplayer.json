cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08zltp754B8Q7kNvwEJqUi0&_nc_oc=AdqAiiBJoMGwXau3_IBEEoT66tW5SCpH7oBRvnjc35gj8oMvRc6sEEzQNSa-FP4dY0g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRH21SymQKKYtFu9H-28fIChSEYu9ZDmnt51HUgCj1kA&oe=6AC8FB48"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR2XErZYIAsQ7kNvwH6K8pM&_nc_oc=AdrINfapcZA29lwsRX5RO2YS4xSvrrQw_CWRTbmgIrjzDFVre-7m049tDCUKrAXXYaU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd2meoxgRMocb0nETiAZF9EoGWaE59JxiyuaJ1mSXQQw&oe=6AC8E997"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWFxHCLO6iYQ7kNvwGjnsjq&_nc_oc=AdocsFTJuBNMruGkaOAHQ0Nxv3Tr_EmsmEKqUFKQJArW6Bs5ZIvkvJG3narxmZJIFlQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2HaCmnutAYaXLRZswadHrCdzeoV4uFwJnshP_gGatoQ&oe=6AC912A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
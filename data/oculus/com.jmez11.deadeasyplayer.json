cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic3mQlMW7roQ7kNvwG-jKxS&_nc_oc=Adr4NiIWbiyou7CF9-VmzWL_wacBXc8B3-Mkuf-aU9Yz_Anp5JsCZiGKoi2KJbQuOlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHmERTIoWyIQcVV8avsay82yoWQCvt_bI9lNOBKVMSIQ&oe=6ADF64C8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3CM9XXtD3EQ7kNvwE5IwKe&_nc_oc=Adoq41NLDG3FBlrz2GWH_W7e-6ZbAfRsr0E8Tzrx7Wbg6iDXjSmFte3Dm7S38A9e8lI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbRkSDnVp5lQKcpBJVN9m7fTlvvTwo8TyuMI5GQqmFsw&oe=6ADF5317"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoM-ueVREYEQ7kNvwHGHOak&_nc_oc=Adq1-GisnLNO3muDG9rLBbaRnaX7fb8t2O0TvZNhp2nOfxrd0KaDwHfx1ED6EdK4rEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtrUfe7xPzJCTcWed0cLbCTDRg4A5fiKNlqBc-HkPM6A&oe=6ADF43E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
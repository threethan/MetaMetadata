cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwGoEc8rWIIQ7kNvwGf_kR3&_nc_oc=Adr_-HTtXhCNPnkv_rrx7QmrFW5KKvBVHzaeOH9Fq3N8WbeNsCzbWODFENVbXKenZuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Bn151UAavaKiEjoc91QoCFHgA2lmdhTMnPO2EQYFvw&oe=6AEDE548"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyE6LW0jpV4Q7kNvwEMSa8K&_nc_oc=AdrpG6Gbh1TByjSOl9KO8hnw-BNzR4k_Vr0vL_lQUvyAqUZi3Ss70C5ja0k-bPUXv8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLcJNSm5QSLUk9qlBiICAmCtDZnCRE7ZckOVx_vhFmTg&oe=6AEE0BD7"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqG7SOIl0u0Q7kNvwEaFO4B&_nc_oc=Ado7HHMfkqBoY9YDRXf9NFbIOVsaAeLcWQaEgOI-5cT63mjXQPvRV8xzQaOABTd9LB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEpAu5P24F_Lxafi-FkY86f73xEup_RR8mLTuebthw8g&oe=6AEDFCA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
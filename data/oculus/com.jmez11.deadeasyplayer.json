cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3os_P4l389AQ7kNvwEaYCE1&_nc_oc=Adr7xMd-deIBKiNxd6rP_8FjeKs6GBUva1ju2LVSYPT3QHSRI76Lv84-MS-UfPcZP9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp6tsm8JLx2-vCShbqjq9_SvubUapP382r0glYLyjBCQ&oe=6AE74DC8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evtjZG8DNU8Q7kNvwGYkPez&_nc_oc=AdphdR5kSc7n5LI-OLwkGuiqc1I06ZF98qfqkaQrfYf8m8mkclHe6NzLk7_GRGWbBnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROEQxkZf8kUxhhc86XL4oTLwMWFhd4eJNHU2-FY72ztA&oe=6AE73C17"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc_xsIWeTnwQ7kNvwFrEiXd&_nc_oc=AdoCVuECxJvp_f7_K2uWOXwa_9MWNnfjkAkI5_f-lAGZoIpYm1rFK84PiZmDTcSr9DM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3VuK7F1ToWK8Roeg_CvnwoWJ1VxrS27qWekKNUkNidQ&oe=6AE76528"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
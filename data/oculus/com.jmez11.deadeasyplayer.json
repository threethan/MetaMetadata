cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08zltp754B8Q7kNvwGVRMyr&_nc_oc=AdrHMzpy26qKGSkIR-_c_1FZVx2snfx7elyGfg-kCVG0ZeAU2Tbqx8qe25Glq7NuDrY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWIlxtpwB-GUqfRqeXaSwWJ1oL0HhwBMSo25gSmxhfXw&oe=6AC7A9C8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR2XErZYIAsQ7kNvwF82rgy&_nc_oc=AdrgCiGR2Fn0PCt1Aaiyz-QOWzVVUrR8KUXXfXwqw409MQMqZ3DGO2W42UYgI6XXO70&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFUH_-4IoshLcYgFzQ-nZ7j_K54MzDS_Q3r7dINv7bBg&oe=6AC79817"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqFsWXkv_vYQ7kNvwGgDZM2&_nc_oc=AdprKVf4--3z6EwmOke9Yet-n0CnVFuqyzZWd125UD-gl-JGXToiqQTIa37xcqIgZ2s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3oKQL4COViTGYyXNIXQAsjPJsE34hyha8ePkU-SSAyQ&oe=6AC7C128"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
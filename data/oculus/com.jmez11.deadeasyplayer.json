cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6kdrgVmVcoQ7kNvwH0igBf&_nc_oc=Adoxe_vz0gAxNyFgTowJfK7L5LMGRVHYk4PaZSUSSbI8VTF6F2z8f1sfJdtErhpnGRY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM53h3cj2q-As5Xj96B0i5y1Er8nf2BkmXb7AdQ_y6E5A&oe=6ADCC1C8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5vs8h_4h3sQ7kNvwHqN-pE&_nc_oc=AdqULgDEnlUtYXwZPyOBXK4qqVFgIPEVfo51wj3RDlKJuQ1lIef09JQZrdGIyZ7PLl0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsYRTcfvawrTOXB_M9DRID9rU9KTev4bI1PmUrprM7lw&oe=6ADCB017"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoM-ueVREYEQ7kNvwF1pT6n&_nc_oc=AdoFJoDo98QXssKQr8U7w9Ay-Efhb-2O-qHm2tUMGtJFZ-g5aAp01UPlZA8ZakPWyHI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfScG4VZqE-ttmhl2Q_Pum3CSFlbDS0V9bNaZ08Cfy5g&oe=6ADCD928"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
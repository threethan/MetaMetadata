cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08zltp754B8Q7kNvwG6yy1c&_nc_oc=Adr8oeAxEXHUXE1Bif-XBSoow6V1DUQs456sj8c7wGyapodMgtwvNi3HDaZVNysAL-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYkqJkdJSmsQf9quqyIfUYL1Uk5yWzcPpQ8QklZ5jAMQ&oe=6ACA4CC8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR2XErZYIAsQ7kNvwFESqKL&_nc_oc=AdpHppo-mPp1HoT1fk_X3xjGWCT6kfi8Et7ABZTcW94-mYsMlCc3pJ-vD9b6griMNbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXgR8N-zKfurky_7g64_VGGNVFc2BYz2bw8QI3WH0KCQ&oe=6ACA7357"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWFxHCLO6iYQ7kNvwG1xXUL&_nc_oc=AdqhuBcMBNqcycBn7E3i8nNKgRqMDuU96UWAcTPwDytPBrE1-XIcbDqCNo6nboENQ74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8zL1O-D69f2nl2-ZHyuEtgb50VBBycNPcQcn5qCKFxw&oe=6ACA6428"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6kdrgVmVcoQ7kNvwHnM3jg&_nc_oc=AdpfEQ2v3cuGws2QYx7b_f6ZuUJTTV2raSHzQ8cNhniqMb05qMMrAAWLNHwU2S78AWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMHOn7m6Wid7UozrSyUh1LptdFuk4k19EhVC6dlmrkkA&oe=6ADE1348"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5vs8h_4h3sQ7kNvwGIQjxn&_nc_oc=Adpx6k60-ac6dZKIKPjMl_BiSbBkTc2jPy7JllsxLPKOx2AMtJkOegrtjv_pK897ZKk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlQiNqrCr0D_WINMQX4jroYlXTyLymVspr03WHRuqhHQ&oe=6ADE0197"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoM-ueVREYEQ7kNvwHeYKOp&_nc_oc=Adqyx6-5rFhkDigo9b7f0b14X830OE5GT9w6qIIj1pgWrvo_jxiM2hfJem3FK95VIcM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdaLRl5pjbQ1_XXUSlZ_THHHs5QR4XHO57vFrvlTgPSQ&oe=6ADE2AA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
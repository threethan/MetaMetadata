cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBA4FIXMW1oQ7kNvwEFGSET&_nc_oc=Adpo1OiKamJU9KoR9T0IBbZGbJzTye1pyPruVQiYPoB7biIUwHT1bvBKvfWevynr61Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkKcdeJem49qotCZc7fkmolt7dw1XQy0cztDmd8n-1FA&oe=6AE35948"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ub4x2bRvIQQ7kNvwHWSI8X&_nc_oc=Adp09HIAHThwk5RF5m2_bKwp4GR7K1iQz0VBqZvQxHT0YB3PPDQ35gp3MmAAjZiD7BM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHZdcLN8Mt5d3YQ3fOL0651IuCfsJCiH7WjONaOVOJ0A&oe=6AE34797"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AwvEivMl3sQ7kNvwGK2ZsQ&_nc_oc=Adr8qvzA7qlJpxsDl5X2kX_mol3AbHhZOM_VndRWwyVpdYG4J0lL5jCzBCKItMKVqBY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUQwL1xjV2dXFEclC52vooveBHM5DG4NXFG3F6UdOtJA&oe=6AE33868"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
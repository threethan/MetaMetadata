cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG0ym8Hu478Q7kNvwG7IjHz&_nc_oc=AdrxayvxqQAmCbN_8Un1qvTQIAhV9hlAhJmBqxN6C4ISB0L18g5tRCM0JJVU4z7Y3OQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkgT87x7nuj1gbQqe4ZVu_1U7I9JX6dP-fUSKVEYumcA&oe=6ACE4148"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRiI9iA4RKUQ7kNvwFd8gp7&_nc_oc=AdoMxxpNZ8NF5VHbJdz9b42qJ2U3Or4sH6OTt-65BOSNM3c2dWCIdoY38x5U_HtMHCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNipS9HjkOB2Vfbqod65le7hqtrACmqj79hXkPR7jVhLg&oe=6ACE67D7"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_RgsIWQRPAQ7kNvwFRWfDp&_nc_oc=AdpfkBOcXhw9Kbvgho1e3MYZvOOAMaEbRBkxevsRn20KcBGXK_G2_kuJkionfBU64Gs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2X5Kjxx5SRwUwCbwZc_kUq7HRV0st3hFjBkRZHYFq5A&oe=6ACE58A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
099"}, {"file_name": "deadeasy-screenshot-04-2560x1440.png", "id": "1644469890803396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg4Hd9xfN8kQ7kNvwGCarUo&_nc_oc=Adqbqo8jMrjGpFAwDSbnAMboKrx2mXG2SzTMSZ1J-EU0Vem829OyR02CJSfaEyTVSvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT86Nz3-RYnoVazY1DXH0ykAB0Y360EO-pLPfR8QAJk7g&oe=6AF32B48"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdTkcXReXM4Q7kNvwETcTYq&_nc_oc=Adrpsa_0rnGJ5KgtPckYbjfLXW5XH8mu3cc3j1uVdNaivkDybw3Gu1n6K74Lv-ucwzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCJe22gyzKIIWZjWN_olu2AOsGsBCVFoO3eKxlF6Oebg&oe=6AF351D7"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UntgS6UYefgQ7kNvwFFD5q1&_nc_oc=Adp4Y7GabMvGfE4g_Ji3hPhbawii5k7Tr8euig46gf0RTO9XTE1z7caqvUgltRtXTr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR3Jj_DdqBb_HgE3g2ttj1SBrkzxWD3xmTxdVpOOAm-g&oe=6AF342A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR ci
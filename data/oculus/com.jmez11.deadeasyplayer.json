cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYZWs9YG00QQ7kNvwHw0BfK&_nc_oc=AdoMGn_MObRclkvITFB9D2s_zXCWV0xmuo8HaQ5LHfp0t_zSZjKc2mHHBS71CMcHjlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf0Gis4OkRZfKRneoIU8xCfawTJRI4Toz36FsYZ_A0oA&oe=6ACF92C8"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwtd2PesoTIQ7kNvwFAy20C&_nc_oc=Adr-m037BfczO68EtZJlRY64TJIAVOPI97CJKP86Ugk6jOuvQ6B2zWe0-gaKW4YSFu0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTdMl_fw03F_3W1pCW7kl4pRabIjymIZJZipxHxHEa4w&oe=6ACF8117"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_RgsIWQRPAQ7kNvwFoBio4&_nc_oc=AdqLFuwHWlM4vRV-dPXX589j0wS2XTqK47hWnLnJc-ZOgTCEi906U8GQ9FAMDSOLgVI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQcbujQfFXNeSM6MeMJeIowC0StrT9rLaka4I1P7L9Gw&oe=6ACFAA28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
cdn.com/v/t64.5771-25/499627527_1644469894136729_7085191447425434139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8auj4nXcoHkQ7kNvwELaWq_&_nc_oc=Ado5CfkJ7HMxsTo00ZWQDhmwo2F9nsqPKez7fDaxfPehx1TA4rme6hdvwBZ_-jCETUQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB-yuL5mVCM9fUUzZjgRkIEKIn9KYPBoLRtQO2d_QyyQ&oe=6AD38748"}, {"file_name": "deadeasy-screenshot-05-2560x1440.png", "id": "2350317412371360", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620414_2350317415704693_6665860957596127791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flLz49An68gQ7kNvwHV_m-L&_nc_oc=Adr9mrLqbLDsI3EoDsRq0RneLJOLyQ9pS5Nouid7yTtsgeVzXW-SwpAv-imEhR3Qu4U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtvx_4cBFdPakdl25a2c1AdMXVK6wSgOpKdF3oJUJyCQ&oe=6AD3ADD7"}, {"file_name": "deadeasy-screenshot-02-2560x1440.png", "id": "2224811258101248", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620384_2224811264767914_6346218012109768376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uphqAmn6JIkQ7kNvwHxmTmq&_nc_oc=Adpz1lzf2o2XjDT35qfhhKB8ZpibP22l8lLPVPnvFVq3H00i0Ma4in9SY6YGu0awK6U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnB_Siphes7Zp5kzSLQiSOOyAX23G8vWzV1zQwJGuHnQ&oe=6AD39EA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DeadEasy Player", "keywords": [], "long_description": "You want to watch 3D in real 3D? This does that.\n\nDeadEasy Player plays your 3D movies the way they were meant to be seen \u2014 side-by-side and over-under videos, in actual 3D, right in your headset.\n\nPlays files from your device or over your network. Other apps can hand videos off to it too \u2014 use it as the external player for apps like Plezy.\n\nSimple. No fuss. Just 3D that works.  \n\nSubtitle and multiple audio streams supported.", "short_description": "VR cinema player for Meta Quest 3 with true stereoscopic 3D (SBS & Over-Under) playback."}]}, "developer_name": "OceanSideVR", "de
name": "ElifBe_Screen7.png", "id": "9602430256512229", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391749_9602430269845561_377305249797287630_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y10PvWd64JMQ7kNvwGP-ve3&_nc_oc=Adp902GNJPMJks2SKypa7MZLjnQW1WPzhAT8BvKWVqjFw1vaEU7bthOVoGK373tWiPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EJuY0E3qAQ_HOnsKQjNUf3T00lnkddjGN42gFFFJh2Q&oe=69EE21A8"}, {"file_name": "ElifBe_Screen13.png", "id": "2233786533684975", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393475_2233786537018308_5244196320857253589_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-fSLKQxxyAQ7kNvwFWLfyD&_nc_oc=Adrts_ObAQ5l1bKmFOY5TkfLXe5DW0Vl1OOdM4sdQStSKJb3CxFlsk8YP_PX35U2H0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oNgJgbsMLmxiAEowsyJ4xhi7xbqCd72-8nZn0tikWgg&oe=69EE1EB7"}, {"file_name": "ElifBe_Screen3.png", "id": "909020024589105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821887_909020027922438_5312352045989169052_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRiLvl3AcnoQ7kNvwEJNJbZ&_nc_oc=AdrcQ45vSnYC7KHCCGtYsMwTFK86J7WJ-NjMkWlC3G4XCrdvAVYkweOWyG76qO5j2F8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gpR-0SEd9DYO0LburdYInURRe6EK3ocaProrHU6gZwg&oe=69EE0593"}, {"file_name": "ElifBe_Screen12.png", "id": "1815284299256204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821847_1815284302589537_958438017287220024_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIRG98PzySAQ7kNvwFY_4oy&_nc_oc=AdqGtNtZOUUb0BNNuq27tByKnTb2qFWy0vqN6ODg4PVlvAfZ4wGl47Fhn-3N-tV9Wk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N50V0h9-hpkwZz7T3Oxz3HEDnvBJccC92QS4Ee6UqzA&oe=69EE07E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zeichenfl\u00e4che 1 Kopie 7.png", "id": "1587418508859470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75241696_1587418512192803_947928201677028245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi-tUc6lwa0Q7kNvwFuJ1qE&_nc_oc=AdoP0rOBfSFVddFIVXOSpnbUms-O5JVRZdudtVwWkWKWJ1wfQnnfxUXhLbKpp02rJN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WQNjPy4uNs6dAcXA5cGwtLclLTZrQNmkViOc1PJGkmQ&oe=69EE0CD4"}, "display_name": "ElifBe VR | Learn reading Qur'an", "keywords": ["islam", "muslim", "quran", "koran", "arabic"], "long_description": "\t\u2022\tInteractive Learning: Dive into a series of meticulously designed mini-games that make learning the Arabic alphabet both engaging and enjoyable. Each game is crafted to teach you the fundamentals of the Arabic script through interactive challenges that progressively build your reading skills.\n\t\u2022\tStep-by-Step Progression: Start with the basics and gradually advance through more complex letters and sounds. Our guided learning system ensures you gain confidence at every stage, making the learning process smooth and stress-free.\n\t\u2022\tImmersive VR Experience: Enjoy the immersive power of virtual reality, where learning is no longer confined to a textbook. ElifBe VR places you in a vibrant, interactive world where you can see, hear, and interact with the Arabic letters in ways that make the learning process feel natural and intuitive.\n\t\u2022\tNo Prior Knowledge Required: Whether you\u2019re a complete beginner or someone looking to brush up on your skills, ElifBe VR is designed to meet you at your level. The game\u2019s intuitive design ensures that anyone can jump in and start learning, with no previous experience in Arabic required.\n\t\u2022\tBy the end of the game, you\u2019ll be able to recognize and read the Arabic script of the Quran, opening up a world of spiritual and cultural discovery.\n\nStart your journey today and experience the perfect blend of education and entertainment with ElifBe VR! \n\n--April 2025--\nAll 10 Chapter are now included in the full experience!", "short_description": "Immerse yourself in an exciting VR world where you learn the Arabic alphabet in a fun and engaging way! Through various creative mini-games, you\u2019ll be guided step by step through the letters until you\u2019re able to read the Quran\u2014without needing to know Arabic. A unique learning experience that combines entertainment with education, bringing you closer to your goal with each challenge. Perfect for anyone looking to discover the Arabic script in an enjoyable and interactive way!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.youngminds.digital/index.php/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "Forum Colonia e.V.", "support_website_url": null, "website_url": "https://forumcolonia.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10082319048458939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_948228587029587_9204719486040076844_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR2iWz_la5YQ7kNvwEN42gT&_nc_oc=AdrL_1PTwdkU9RXE8XPG_WJ_2c0sghZRqLrIm-UJnaVn3GTi3vE0DlOqAuuKsEL4lww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DvKmmWiAbWSFZrJ5cFF2SQxyTNPbLlSGxmivcBNeOzA&oe=69EE12E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ElifBe VR | Learn reading Qur'an", "platfor
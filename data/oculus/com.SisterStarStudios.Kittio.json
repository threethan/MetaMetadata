id=6e7a0a&_nc_ohc=XxyolBKcTyoQ7kNvwHLd421&_nc_oc=AdpgbF6sMNUilk07N3ExxuQ0Su3IxgkW5jYhBQ27CXVWi0jjwsMZvjAE7lD0TZPdTc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlcNPftS8lsqoQ3k22ubbmQMUHb1wXzsjabOtNMsmTGw&oe=69D103A8"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcEyPwlr05QQ7kNvwG4a3-J&_nc_oc=AdpXBX3HZyo08PLGu06Z8LCDadCq1aWO4aCVIBdYXf8Hscl7aPTj4pxyM8gAX-0wB7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afze2oDm-tygJA0Pl-SywBMRjyqOsuxCTuphsxsyq8OBDg&oe=69D103CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https://sites.goo
id=6e7a0a&_nc_ohc=DGhN9CcijJgQ7kNvwHFoxv2&_nc_oc=Adpi4djZfXuFQ54apdmJjlFeC1dIbaSNqoUnZ8YtPKOy_8c-7bHSRAt4RaxQaWoMekM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZVH1fN6j5Op4zkEyGeqiCDhiPQg6r6KPuHgcfCRqikg&oe=6AE098A8"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqFuOxBPc3YQ7kNvwGtl5EI&_nc_oc=AdpsfIzdBaIGU3pZ8lQekUGnxTF7EtRL_Sx0mJLa-BVp-isdGzE352tvrFNHfRvsR_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO47ySOTJxLHS-TG_aSB2tbvqtL0yCJ48NT2baLR7y0Cg&oe=6AE098CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https://sites.goo
id=6e7a0a&_nc_ohc=7zleQB3JBIIQ7kNvwG1ucq8&_nc_oc=AdoTRGFchhIdAZQfd1TXYGaNDiaG6QA1-ExdQdeHIcFg1jIsM12S7H2JDV0cpWuUkvI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcpCjfs9itAVzpxZpqmddrKMl1tG3Xo3-Vac8_WPR0QQ&oe=6A917EA8"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bYeBV83FzQQ7kNvwFeRcew&_nc_oc=AdookJmRmQgvLQwDmN_hg8Bb6M5EWhWnibmpDAzB9MbiSg-kbZ5I8-smS2UFERwpNog&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKjxnyySVa1zo1tNjw6WgA8udxJmEeeM0VxKj0OTiSzw&oe=6A917ECF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https://sites.goo
"}, {"file_name": "Untitled design (98).png", "id": "921426267227609", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822968_921426270560942_4013948452632980892_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no8uUTXjkVoQ7kNvwEIlDey&_nc_oc=Ado90swRjb32uxkiTezjr9G7sJK66t4pKSrKRKRFIFtYWlJ00oX6UneVNMhffL2DY-Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0CStoe2yoV2T4RUP43iJs-cOgcjD4jXN4au02lmoBjA&oe=6B0B3928"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LulUheor0b0Q7kNvwEgYsh9&_nc_oc=Ado3B1RSvgKiI8b59EoDRmmAlLuscW_9X2i_ucrbSyP6AMwUd6p35TnyYzWm9AdmfvM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJmaprgjS6Vwi4gQRgxXHnXgR30SDk-EhTTyNpU5561g&oe=6B0B394F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https://sites.google.com/view/kittioprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Sister Star Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/kittio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25245749058454609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310667_2019003352289811_972693517913511302_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvbVQAC2udUQ7kNvwFmPlxe&_nc_oc=AdoX-krommlqYHLJ6fIMdhalIuOG3uoUxCrLdyF4e8rcunAeU6rqNNBF0a4braxFSWQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_JZcem7WOFkWQ8U9PHbYo3NdI3NTYo_B9vHgDJT0sZg&oe=6B0B3AE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kittio", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1767
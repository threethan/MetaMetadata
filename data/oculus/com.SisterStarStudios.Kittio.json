id=6e7a0a&_nc_ohc=hv5RThmUXKkQ7kNvwFGKZzr&_nc_oc=AdpVQux2AoF3HUBE59ppdR3ouuvTMikBz9VF4wht7UalLYiTCkxIHGQ5pGV7FDPSWVk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUSpNIj2yqlIh8omhSoVCe3xWA3EUCH_jQy7NS8_NAJA&oe=6AF9DD68"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rs5mnJoPJqUQ7kNvwFgzSgv&_nc_oc=AdrhoR9OSwWwWQ_VMebynUkNpu1dfxgv566MBjSkkswzRFF3I5mFA3EqiVk4k2C_RSA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPCXO_-Ro9DnItRVkhguhfB_C1VpNiJLqrGhn8JDrQQA&oe=6AF9DD8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https://sites.goo
id=6e7a0a&_nc_ohc=Oka9I3GMkGQQ7kNvwH7A1JN&_nc_oc=AdpTv3lRa3q0c8yUO-Qagw6T4qNdTQ8JbUiCCI4Zs3Vkeovi8Uv7V4Cu-Ugyo_OOjPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLypJr0j1aj9ijOTmzVjWSvodHTFNHDyOL49DqPP28qOg&oe=6AB3C5A8"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkleMbZN-OkQ7kNvwEcQn7N&_nc_oc=Adp8hMs6DozU4Y49It7GRSGyftGHD_dU3JcfmljbIc_nMbwZ6hgbosDnqUAQz8fcAvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo7aD6ee3bUrF81MIYmJK4lruBNm_oN0nyM1cyl7-2eA&oe=6AB3C5CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https://sites.goo
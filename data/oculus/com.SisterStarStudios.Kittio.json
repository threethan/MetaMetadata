id=6e7a0a&_nc_ohc=vWgSchRms4UQ7kNvwFGwTMv&_nc_oc=AdrD3xC44jbLhVWa_c7ROSqE110PJzB6D-v4RAPVmaOu1hNN31dcvy_UEQLiVT0ZPXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS84LX-YDLOD5JEOSzT9fwehu27C8IYr6775VkUtFnjA&oe=6ACFAD68"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejjb2OCzYf4Q7kNvwG9nLc2&_nc_oc=Adqwyu26JhlnHxyjECsd8F2bNOfuwYNabvK2KMaJvYRhZj7HnK4B-q1ST113A-VZST4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP88OvqyFhEu0Lsx8Kr6YjFIsjCG8W5_UUlJgvtSbmnzA&oe=6ACFAD8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https://sites.goo
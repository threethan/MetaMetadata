=1-7&_nc_sid=6e7a0a&_nc_ohc=mBZwhDbF9KIQ7kNvwHbk7q9&_nc_oc=Ado6UqxgKzRPJ1cNT2WvImcB7WxPAFsBlu3-YIC4XyUYHmj4aASgvbGYjnh1M8cE-Bw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEce8TxbpiU_NWeJKXbFN3HEdextdEZTvcVjjQi_v9mSw&oe=6A8D8A28"}, {"file_name": "Untitled design (100).png", "id": "898656066056637", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499295272_898656069389970_8123005329998132392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__gstLiKel8Q7kNvwE7iBgm&_nc_oc=AdpGb74f7ugntoRQ8I7S0NXgAAVqafO-Z1vCfC2_jFzxdG3pikz4Otnt20RdyBgqPek&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQscqfoUbOQY9wgyKLHHvyZC3faArr2zUaBcfcbq3UgQ&oe=6A8D8A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kittio", "keywords": ["cat", "fangame", "horror", "fun", "kitty"], "long_description": "Kittio is a silly, chaotic VR horror-ish game that looks dumb on purpose and isn\u2019t actually scary. think spooky vibes, but everything is kind of stupid and that\u2019s the point.\n\nyou\u2019ll explore weird levels, poke around for collectibles, and accidentally find little secrets hiding where they probably shouldn\u2019t be. there are currently 5 levels, with more being added over time, along with new secrets and nonsense.\n\nKittio doesn\u2019t take itself seriously, but it does want you to have fun. wander around, mess with stuff, and see what you can find. something is always hiding somewhere.", "short_description": "Kittio is a silly, chaotic VR horror-ish game that isn\u2019t actually scary. everything looks a little stupid on purpose. explore weird levels, hunt for collectibles, and stumble into small secrets hiding everywhere. there are currently 5 levels, with more planned over time. kittio doesn\u2019t take itself seriously. it just wants you to poke around, mess with stuff, and have fun. probably something watching you. maybe."}]}, "developer_name": "Cassette", "developer_privacy_policy_url": "https:/
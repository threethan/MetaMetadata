71757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2qm3C6H0EkQ7kNvwEsls4z&_nc_oc=Adm_webCvZ6smabKTK9NKiMFRKb-ILVC5vscwUvJsM5_jECLqpXuHOcuFeOLqPlNT7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsJk9ZsrUPYr5n6bkODMWEcaP3UnXUZQKMYLc0ojG4atg&oe=699ED0ED"}, {"file_name": "migrated_image.png", "id": "637032750453112", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VHdoKoMkMoQ7kNvwHPABJ_&_nc_oc=AdlS1aJ3QBhR-2raqGTkei5eq_hFSIiTBrRofZCmmJF_t2M2PgMVtfPqLVGLV0kKKTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv7-TCfGCuZR34YDbLgO3icZSimP9-dxS4i3RKbf1nL4Q&oe=699F04B3"}, {"file_name": "migrated_image.png", "id": "217095079700059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O524y2B-Qm0Q7kNvwHKcVT9&_nc_oc=Adnv0Fb7OozUkHU9nDi64UtNRtzTHmLiV8KfFsPUillsGhNHhzjvIZeh2VXc28Kc6FM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvi-143MoLtE1Jn_uapND-kMHSE7KenrB3aedNzvXwhXw&oe=699EE4D8"}, {"file_name": "migrated_image.png", "id": "211814026546536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_1576290842438024_6608560174267367424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKMW6upusMsQ7kNvwHrNySD&_nc_oc=AdlpRh8FkbeQ63MJiekzqakugd7isUTHW1Pg1VusUxV1eyLqcT5C9iziKuWWolmNHxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsMgggfbzysl9kE1f_etUxhE6ntQyxJ8jYXjZdsJ8nA8g&oe=699F0642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1643669579028609", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162711_1643669585695275_2787966308099031040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPyDOmpQNTYQ7kNvwFTx9V3&_nc_oc=AdkWcj9ZN9y64zZqgkQMbITafTHC0PgNQU9u5hXneR8XyaKKTblzCtWek4GTLtiLQGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsyfverHCK1_SXZLntEw4ppOWtakOeaXEsGYF-rS8jGNg&oe=699EF6B3"}, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "An early dev interface lights up. We are up in an early build of CLOUD Inc., the groundbreaking tech that allows the user to upload their consciousness to digital permanence. The soothing voice of Theo welcomes us as he materializes as a point-cloud hologram. He speaks about the technology which allowed him to map the human brain. He shows us a picture of the departed Doc Wolfe, his mentor, a man who gave his life to the research.\n\nAfter introducing the CLOUD and the possibility of uploading your consciousness he pivots: \n\n\u201cBut what about the journey? What we found is that DMT is a particularly important part of the process. This is a chemical our brains release the moment we are born and the moment we die. Some say it\u2019s the GOD chemical. The closest thing we achieved to simulating this process is what you are about to experience. We call it AFTERLIFE [+]\u201d\n \nWhen he finishes the speech the screens fade and we are left in a dark limbo with a slim, but infinitely tall, crack of light.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
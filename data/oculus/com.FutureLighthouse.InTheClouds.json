3028484814263_4618537509171757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPat_1uQoFYQ7kNvwHtZl_V&_nc_oc=AdreR8uGBhrK8yej8p_0Hj7sBn9MnsVSvOYETsIWgkUvCsjeYUl1ByIa7-p5fHSny6c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3iLHlDz1I8LfRIuiTsymneULJRpoP54JUaF-qJfMegbw&oe=69F217AD"}, {"file_name": "migrated_image.png", "id": "203088174252498", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJJUWQcPzLMQ7kNvwHmxkOm&_nc_oc=Adpp8d-Iz13deW7r7h9VynVa9p9nEMRiKY3P0IXW_6kibTSMOoy3kszkXzAiWypw1O8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af06k2I-FCqWACxJ8poFA0doI0VjC1Pm6Lp57q0P1OSGaQ&oe=69F21333"}, {"file_name": "migrated_image.png", "id": "202815661040262", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO3YkXLppKMQ7kNvwGjITjk&_nc_oc=AdpVs9zzASo0UhLNk6HYuBaSVmCYX-npCkZLvqg3N3HJcvU7WrljeADdph1t8TzGhWE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Rz4QqEU84_tXfOLV7HxZ4H9Nhb5Bv8F9eH3gUl9A7zg&oe=69F1F358"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "In the Cloud VR Afterlife begins with Theo James (Tomiwa Edun), the genius inventor behind Cloud Inc., as he welcomes you to the Cloud and walks you through the technology that allows him to map the human brain. After introducing the Cloud, James will begin to ask you a series of questions to dig deep into your soul and better understand your morality. With every answer, a slim crack widens encompassing a visually stimulating journey to the other side to reveal your inner truth that may or may not be what it seems. The VR experience, based off of the Crackle Original Movie, In the Cloud, is a spectacular and mystical ride built with live-action actors, visually stunning special effects and 360-sound.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450657583366374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162718_1916296695303796_6980233067671584768_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpFGL0kG22MQ7kNvwHnGVnD&_nc_oc=AdrJEJG3gKf9NcgvH9OK2PMzJnFueZ6JcaFqYxMP1l7E8xyyS4OGe56w5ui-7EhgPHA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1irsPe102TtcvpobVFyVzis5absUR0Se4dezy_Df3org&oe=69F207F0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In the Cloud: VR Afterlife Gear", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517508900, "lastRevision": {"nodes": [{"id": "1427971333991242", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1876666982349412", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert"
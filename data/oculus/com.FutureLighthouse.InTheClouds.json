content-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_1453028484814263_4618537509171757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K-7GCz-93MQ7kNvwEhEc6N&_nc_oc=AdnWMip7HfPOmKOqv0uSQE81EyeWC82YAuR1KsnsiXmVGOcrphcr0gplmE4o1b36bjg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf3lY8pRrBBUb9GVQtR6quXup386cDHXkw3k6Bq3MKpw&oe=69AFF46D"}, {"file_name": "migrated_image.png", "id": "203088174252498", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkR1p0SktC0Q7kNvwEX_gn4&_nc_oc=AdnSaWolFdQAiyuCG6GZN-ORMQYIHoN_vhh84KVcy-IOj5xCdhoTLjUUtS_o7Xxcgpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGG-R0iq9KQT7MuhUOt1oNXmN3xxxobQhQdGH0nk93Xg&oe=69B02833"}, {"file_name": "migrated_image.png", "id": "202815661040262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLogIL6CJuYQ7kNvwFbgsPt&_nc_oc=Adktu012ydfjhvtyUupTYYUnCA-pjOA03o-Qtq1S2YkLWimkPFb7nKwtzrWKirsvhvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfysSVPQI9xv6GNtpvilZ-0BhwuYuUZ-epR5yzCpi7fbDA&oe=69B00858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "In the Cloud VR Afterlife begins with Theo James (Tomiwa Edun), the genius inventor behind Cloud Inc., as he welcomes you to the Cloud and walks you through the technology that allows him to map the human brain. After introducing the Cloud, James will begin to ask you a series of questions to dig deep into your soul and better understand your morality. With every answer, a slim crack widens encompassing a visually stimulating journey to the other side to reveal your inner truth that may or may not be what it seems. The VR experience, based off of the Crackle Original Movie, In the Cloud, is a spectacular and mystical ride built with live-action actors, visually stunning special effects and 360-sound.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450657583366374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_1916296695303796_6980233067671584768_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHSFvIqK4YYQ7kNvwHDu1Be&_nc_oc=AdkJg4AzBwJ8ZTIOqJ1RSj59ehmQtE_f3xm4eMMOxLX8gM7eYeSJd_vt51nzjoq6eP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7EiQNfN36j4rSKeoZi-ur7dxK2vVKzCeVTkz-AAYyOw&oe=69B01CF0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In the Cloud: VR Afterlife Gear", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517508900, "lastRevision": {"nodes": [{"id": "1427971333991242", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1876666982349412", "is_first_party": f
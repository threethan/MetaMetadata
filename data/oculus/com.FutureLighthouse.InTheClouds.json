71757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stDdrcOzF04Q7kNvwFvdIj_&_nc_oc=Adn3hMi3sNyI3PKlHxPKyKESs16AKKI89sNNPxfmEWcFW92c4lPPeeNbLlOzev-Hs24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuB75_3u6i7tnlC8AgzmNW-SMnN3LDVtWY6YJxiw3PZbw&oe=6999C32D"}, {"file_name": "migrated_image.png", "id": "637032750453112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-JPsKXXjI4Q7kNvwEKVoYE&_nc_oc=AdlCn6GUTM_6MLOcAKWPNLtV7bnDVPllKY1MENS98Mmjv1Ba91HXqwfB88bxykvwUMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJb4uFjCEKackkvocTQpGUmfn_PfaGLRghhdadKlRatA&oe=6999BEB3"}, {"file_name": "migrated_image.png", "id": "217095079700059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkV24BXZp70Q7kNvwHHu9PK&_nc_oc=AdlJEID-8fAxCbE7LmHzYjVdx4L5Prq_5kx-YjfXcGdqzBFevZMryc-OMN-ZWuhcJMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsu4oL-O1osUbhdJ8XPf7aEEEty99LIE4dJ424-CMOCkw&oe=69999ED8"}, {"file_name": "migrated_image.png", "id": "211814026546536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162718_1576290842438024_6608560174267367424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFfNpGk_EbwQ7kNvwHxDGVC&_nc_oc=AdnBMx8rSBV1yHULOFUlbkFZMxIhbuTmVSlOdvvEQfhQO5ybJvG0fS0MGSCn3iRhNuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsM6GlhxT-CI9EhRpHXX5OACOmQyHjeci2qpF0nUoq88w&oe=6999C042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1643669579028609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162711_1643669585695275_2787966308099031040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-i0hjLh4uEQ7kNvwGNPxzp&_nc_oc=AdlcsY3C_HtYxgDoSzsEYqtrQT7VNmstgaht8nTbYWWYKK2cA_MHnHVVM0ExzwTqC4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSi4bWBptBnSr3ukk25ExQ8qr5DzD5Rlf5ktHXas9XCw&oe=6999B0B3"}, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "An early dev interface lights up. We are up in an early build of CLOUD Inc., the groundbreaking tech that allows the user to upload their consciousness to digital permanence. The soothing voice of Theo welcomes us as he materializes as a point-cloud hologram. He speaks about the technology which allowed him to map the human brain. He shows us a picture of the departed Doc Wolfe, his mentor, a man who gave his life to the research.\n\nAfter introducing the CLOUD and the possibility of uploading your consciousness he pivots: \n\n\u201cBut what about the journey? What we found is that DMT is a particularly important part of the process. This is a chemical our brains release the moment we are born and the moment we die. Some say it\u2019s the GOD chemical. The closest thing we achieved to simulating this process is what you are about to experience. We call it AFTERLIFE [+]\u201d\n \nWhen he finishes the speech the screens fade and we are left in a dark limbo with a slim, but infinitely tall, crack of light.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
content-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_1453028484814263_4618537509171757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNWz_BoJqC8Q7kNvwHV1qHy&_nc_oc=AdnYiGCCC0SjsiF1gd8POg52wA5rMvQBlAXLGJ72HmSwBOdUdiYCVHe_WmK9_ygRjE8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPzGkuSt8hnXn3K4TABUpny2JZeRwyNcOMWBQsKYlEmg&oe=69B68BED"}, {"file_name": "migrated_image.png", "id": "203088174252498", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg-5vqCGPaoQ7kNvwF7-ZNB&_nc_oc=Adn19sZa481et-KFlcB4TWT-o16x0lFgl5cJjck40tb4DKUoX-wzaPcO9R4lol0tVrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx23CYdG0XlDEBRSD1CN5Ss6nB8oi9TVk0x9HwJUyBpWw&oe=69B6BFB3"}, {"file_name": "migrated_image.png", "id": "202815661040262", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH5HFLznGREQ7kNvwGPif0w&_nc_oc=AdmXmsPVkoLedv3LQL-0PKixvDYMnf3hWcvKPnMfCoPn1BunZyzN-mKyAejPUPWGR5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFeJHn7cSZMfKrtu4n39k0z1O58Ed6XFYchnFq918UjA&oe=69B69FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "In the Cloud VR Afterlife begins with Theo James (Tomiwa Edun), the genius inventor behind Cloud Inc., as he welcomes you to the Cloud and walks you through the technology that allows him to map the human brain. After introducing the Cloud, James will begin to ask you a series of questions to dig deep into your soul and better understand your morality. With every answer, a slim crack widens encompassing a visually stimulating journey to the other side to reveal your inner truth that may or may not be what it seems. The VR experience, based off of the Crackle Original Movie, In the Cloud, is a spectacular and mystical ride built with live-action actors, visually stunning special effects and 360-sound.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450657583366374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_1916296695303796_6980233067671584768_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIvpMol8qhAQ7kNvwF3ki4M&_nc_oc=AdmM9NTjpcwJh5zOTx47atkPZksLDySQ_So_K25X_2k8JiLPg-2riqakkeFf8f5OTbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfRd391o6fxaET76qRKoXOomdXfCPOMVG5T_jYpAyIVw&oe=69B6B470"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In the Cloud: VR Afterlife Gear", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517508900, "lastRevision": {"nodes": [{"id": "1427971333991242", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1876666982349412", "is_first_party": f
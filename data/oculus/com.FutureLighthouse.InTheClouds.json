content-ord5-1.oculuscdn.com/v/t64.5771-25/11162718_1453028484814263_4618537509171757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMpGrPPaIuUQ7kNvwGA3yNd&_nc_oc=Admh7D0APPW6G7jxmD6zu5KNt_SvjdIFGmyN6yiZZGI67J2CNboObdk_5L0ySJ-oKJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfaYtoPWPF3CpkPGcPOSkVJ386v3fTGlj0U3ZTxbvT2w&oe=69B4212D"}, {"file_name": "migrated_image.png", "id": "203088174252498", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SdygX_lSV8Q7kNvwGODEL0&_nc_oc=AdmLJhRNh026wXkxw_XIpz4Wg_yjoMd2IwxTxin945OfG9ZfUagp6lxfXxmUJqQuipw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_WyyMNlNqKHR9HhcpGn9Xn3MrLvtlJxNhesengrgx4g&oe=69B41CB3"}, {"file_name": "migrated_image.png", "id": "202815661040262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efNEw4NsTo8Q7kNvwHp8fiO&_nc_oc=Adnv4z3GNpUDDkM26J1qi18hkp9EhT2cqMBkEk4iXFnm1AER9a6iqqU6CrZLgV3GVH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXeKOsoTxNOF2EPM5ENDEvZZXnqMcJNBXXAArs7ejjKA&oe=69B3FCD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "In the Cloud VR Afterlife begins with Theo James (Tomiwa Edun), the genius inventor behind Cloud Inc., as he welcomes you to the Cloud and walks you through the technology that allows him to map the human brain. After introducing the Cloud, James will begin to ask you a series of questions to dig deep into your soul and better understand your morality. With every answer, a slim crack widens encompassing a visually stimulating journey to the other side to reveal your inner truth that may or may not be what it seems. The VR experience, based off of the Crackle Original Movie, In the Cloud, is a spectacular and mystical ride built with live-action actors, visually stunning special effects and 360-sound.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450657583366374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_1916296695303796_6980233067671584768_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBF7BUqstAAQ7kNvwH4OOUL&_nc_oc=Adl6oLpwDG_tOIXobLnNkBWDLSOhIC-QHiJjKLNMD4_bJbdUH9AuHs3NFf6okGKZMF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJv42JGgRsk4oWRw0PaBW7JEh87WCHwvCMJ_SvdEzQ5g&oe=69B41170"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In the Cloud: VR Afterlife Gear", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517508900, "lastRevision": {"nodes": [{"id": "1427971333991242", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1876666982349412", "is_first_party": f
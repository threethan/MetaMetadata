1757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NpC1ofWSYEQ7kNvwFOcZ5l&_nc_oc=Adkbe_379O47yP_0ATZsACPxEbBIN7Pd9GimSpqBv83JJKJTGMvDSNrJYu9-8mCIHB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWjDcG6_cHzyEb2OI7Wbw2NhB_74vX72uzKZVL6GuoOA&oe=69A2FDAD"}, {"file_name": "migrated_image.png", "id": "203088174252498", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gOJsZ6GnXcQ7kNvwHwvC7q&_nc_oc=AdniGL7kOMq8puIqzZiiLCs8iqnGDiWV9BZDeGpLA4qF87fl_4altzKs-TdQ7Xx22f8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnU0LOmY7GCtV1Dy6EY-B11J_E1RFHlZbmzONcEtzSoQ&oe=69A2F933"}, {"file_name": "migrated_image.png", "id": "202815661040262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuLeLKWk03UQ7kNvwF7AP-Y&_nc_oc=AdkwVhhjrtatj5gVtWgch3zaao1z6PI_fl5qUlv1rg35Xll6iY5-hYE0WdKhmlCCeww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFD5XgkgCOlT1Himmhy0r2HPNHs5lLSMcBOYEYaKhblA&oe=69A2D958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "In the Cloud VR Afterlife begins with Theo James (Tomiwa Edun), the genius inventor behind Cloud Inc., as he welcomes you to the Cloud and walks you through the technology that allows him to map the human brain. After introducing the Cloud, James will begin to ask you a series of questions to dig deep into your soul and better understand your morality. With every answer, a slim crack widens encompassing a visually stimulating journey to the other side to reveal your inner truth that may or may not be what it seems. The VR experience, based off of the Crackle Original Movie, In the Cloud, is a spectacular and mystical ride built with live-action actors, visually stunning special effects and 360-sound.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450657583366374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162718_1916296695303796_6980233067671584768_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPVRQlzBY1AQ7kNvwFMoVI1&_nc_oc=Admy5_s5aBZGRji_rZqQtzDrzYGeUSs9KuuO6_Hf0vArD8yLHJD2ZogkzexMu2U7Kpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunYTHO1kDRhJ7FDiArOR0Z15PxoccZVVGYRKwr1I7feQ&oe=69A2EDF0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "In the Cloud: VR Afterlife Gear", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517508900, "lastRevision": {"nodes": [{"id": "1427971333991242", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1876666982349412", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1696005197107861
71757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NpC1ofWSYEQ7kNvwFOcZ5l&_nc_oc=Adkbe_379O47yP_0ATZsACPxEbBIN7Pd9GimSpqBv83JJKJTGMvDSNrJYu9-8mCIHB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWjDcG6_cHzyEb2OI7Wbw2NhB_74vX72uzKZVL6GuoOA&oe=69A2FDAD"}, {"file_name": "migrated_image.png", "id": "637032750453112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gOJsZ6GnXcQ7kNvwHwvC7q&_nc_oc=AdniGL7kOMq8puIqzZiiLCs8iqnGDiWV9BZDeGpLA4qF87fl_4altzKs-TdQ7Xx22f8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnU0LOmY7GCtV1Dy6EY-B11J_E1RFHlZbmzONcEtzSoQ&oe=69A2F933"}, {"file_name": "migrated_image.png", "id": "217095079700059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuLeLKWk03UQ7kNvwF7AP-Y&_nc_oc=AdkwVhhjrtatj5gVtWgch3zaao1z6PI_fl5qUlv1rg35Xll6iY5-hYE0WdKhmlCCeww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFD5XgkgCOlT1Himmhy0r2HPNHs5lLSMcBOYEYaKhblA&oe=69A2D958"}, {"file_name": "migrated_image.png", "id": "211814026546536", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162718_1576290842438024_6608560174267367424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysSTUeXWdPoQ7kNvwHEWZSZ&_nc_oc=AdnOdp41Y6FRPUzUV1fr9sIqouUgpXCqR0xvG_OmfX_RINtApALKs-QWFrxwZTQR_SQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu39AqTD6Um_B3KaCQs7zPNemliuRCMXdORPrpLHDc34g&oe=69A2FAC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1643669579028609", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162711_1643669585695275_2787966308099031040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYE7eswF69sQ7kNvwEofzlQ&_nc_oc=AdnLHUwXR8uw-W_ynpzfKz_kghb_zhQj9rkIWEBbjBFGWNXvKYEAou61v5eINhcBli0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4tqRjC3Hpq1E4-Whwvu3l5d9J0jBHCAG4thJ4bRdGvA&oe=69A2EB33"}, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "An early dev interface lights up. We are up in an early build of CLOUD Inc., the groundbreaking tech that allows the user to upload their consciousness to digital permanence. The soothing voice of Theo welcomes us as he materializes as a point-cloud hologram. He speaks about the technology which allowed him to map the human brain. He shows us a picture of the departed Doc Wolfe, his mentor, a man who gave his life to the research.\n\nAfter introducing the CLOUD and the possibility of uploading your consciousness he pivots: \n\n\u201cBut what about the journey? What we found is that DMT is a particularly important part of the process. This is a chemical our brains release the moment we are born and the moment we die. Some say it\u2019s the GOD chemical. The closest thing we achieved to simulating this process is what you are about to experience. We call it AFTERLIFE [+]\u201d\n \nWhen he finishes the speech the screens fade and we are left in a dark limbo with a slim, but infinitely tall, crack of light.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
5/11162718_1453028484814263_4618537509171757056_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPat_1uQoFYQ7kNvwHtZl_V&_nc_oc=AdreR8uGBhrK8yej8p_0Hj7sBn9MnsVSvOYETsIWgkUvCsjeYUl1ByIa7-p5fHSny6c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3iLHlDz1I8LfRIuiTsymneULJRpoP54JUaF-qJfMegbw&oe=69F217AD"}, {"file_name": "migrated_image.png", "id": "637032750453112", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162682_142709443024684_6787841205943140352_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJJUWQcPzLMQ7kNvwHmxkOm&_nc_oc=Adpp8d-Iz13deW7r7h9VynVa9p9nEMRiKY3P0IXW_6kibTSMOoy3kszkXzAiWypw1O8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af06k2I-FCqWACxJ8poFA0doI0VjC1Pm6Lp57q0P1OSGaQ&oe=69F21333"}, {"file_name": "migrated_image.png", "id": "217095079700059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162732_1674016092620383_3343980898654617600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO3YkXLppKMQ7kNvwGjITjk&_nc_oc=AdpVs9zzASo0UhLNk6HYuBaSVmCYX-npCkZLvqg3N3HJcvU7WrljeADdph1t8TzGhWE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Rz4QqEU84_tXfOLV7HxZ4H9Nhb5Bv8F9eH3gUl9A7zg&oe=69F1F358"}, {"file_name": "migrated_image.png", "id": "211814026546536", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162718_1576290842438024_6608560174267367424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCr61I7wOKAQ7kNvwFQvYYF&_nc_oc=Adr7g6kD8xC09HUvqO55DaO9GyqTxiiR_xcw2rSXUxszSeg-VAOPk517su1LKZ6q2Sc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BpMq2Jg-LESgt-hxLQnWDum-dmRyxSwUfWiz-uYhy8g&oe=69F214C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1643669579028609", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162711_1643669585695275_2787966308099031040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv9RAuZTZYsQ7kNvwHm7WjC&_nc_oc=Adpz7M4Y2TkwyvO1hVDl1R0yHL_4bWmf_Lf_3xkFYztzxz7M38-M3DULdbF7ts9xWkY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2pGpUSCwxcjEkDrDUlj8O9KAx7etBv3If0Kkjou1uKRA&oe=69F20533"}, "display_name": "In the Cloud: VR Afterlife Gear", "keywords": ["InTheCloud", "Afterlife", "Future", "NoraArnezeder", "JustinChatwin"], "long_description": "An early dev interface lights up. We are up in an early build of CLOUD Inc., the groundbreaking tech that allows the user to upload their consciousness to digital permanence. The soothing voice of Theo welcomes us as he materializes as a point-cloud hologram. He speaks about the technology which allowed him to map the human brain. He shows us a picture of the departed Doc Wolfe, his mentor, a man who gave his life to the research.\n\nAfter introducing the CLOUD and the possibility of uploading your consciousness he pivots: \n\n\u201cBut what about the journey? What we found is that DMT is a particularly important part of the process. This is a chemical our brains release the moment we are born and the moment we die. Some say it\u2019s the GOD chemical. The closest thing we achieved to simulating this process is what you are about to experience. We call it AFTERLIFE [+]\u201d\n \nWhen he finishes the speech the screens fade and we are left in a dark limbo with a slim, but infinitely tall, crack of light.", "short_description": "The waiting room of the Afterlife"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.futurelighthouse.com/", "developer_terms_of_service_url": "http://www.futurelighthouse.com/", "publisher_name": "Future Lighthouse", "support_website_url": null, "website_url": "http://www.futurelighthouse.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
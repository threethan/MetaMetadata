597754_8047331025133290047_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWatRNuGrA0Q7kNvwHFF_J_&_nc_oc=AdpLnIFazH943kqCSl6bdOG2WVQbS3aAy6OvczA5Ut7fhP3ce1VRT_TAFUskhyc_r7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0o9HWx8wxWxSp6Hu_Yzbdcev-F4UugHeAjXQoljFC7yA&oe=69F0B8B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "696966651969139", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982522_696966655302472_5287169594548358940_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGVu7bZQansQ7kNvwEq0VXZ&_nc_oc=AdqWyKRb-O-sIy9xKQS3SpZwfr2-lwNMyAI3DqiqzmdtMPI7mVPWz5GsoRFIQcL2epw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2gBTE1xJXxIgYCMqWIC-l2NJjfQUqTGSYoWbJ0UrfkQg&oe=69F0A043"}, "display_name": "LAXVR Skills", "keywords": [], "long_description": "**LAXVR Skills: Immersive Lacrosse in Virtual Reality**\n\nDive deep into the thrilling world of lacrosse like never before with LAXVR Skills, an unparalleled virtual reality experience. Crafted for both enthusiasts and novices, this game offers a chance to immerse yourself fully in the realm of lacrosse from a first-person perspective. Here's a glimpse into what awaits you:\n\n1. **Four Main Game Modes:** \n   **Shooting Mode:** Hone your shooting skills, master different techniques, and aim for that perfect shot.\n   **Goalie Mode:** Stand tall between the posts, anticipate your opponent's moves, and make that crucial save.\n   **Defender Mode:** Learn the art of defense, stop the attackers in their tracks, and reclaim the ball.\n   **The Medicine Game:** Embark on a historical journey that pays homage to the deep-rooted origins and traditions of lacrosse. Experience the soul of the game and its spiritual significance.\n\n2. **Casual Play Modes:** \n   **Wall Ball:** Perfect for those who cherish the simple joys of the game. Bounce, catch, and repeat. Sharpen your hand-eye coordination and reflexes.\n   **Free Shoot:** Sometimes, all you need is the open field, a stick, a goal, and a ball. Practice your shots or just enjoy the serenity of the virtual field.\n\n3. **Community and Competition:** \n   **Leaderboards:** Push your limits! Challenge yourself, compete with your friends, and see how you rank globally in the LAX VR community. ", "short_description": "Dive into LAXVR Skills and elevate your lacrosse game! Engage in thrilling drills: fire precision shots, stuff attackers, and de-twig attackers with decisive checks. Can you score a 2-pointer past our goalie? Stop a 12-yard step down shot? Or shut down an attacker's split dodge? Challenge awaits in every corner!"}]}, "developer_name": "Duper Studios", "developer_privacy_policy_url": "https://laxvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Duper Studios", "support_website_url": null, "website_url": "https://www.laxvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9990375744369855"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "600161926050865"}, {"status": "PUBLISHED", "id": "257344393951430"}]}, "baseline_offer": {"id": "600161926050865"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736009040, "status": "PUBLISHED", "id": "600161926050865"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "An
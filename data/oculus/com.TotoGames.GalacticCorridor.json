e_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoAymdOu0GsQ7kNvwFHwlLK&_nc_oc=Adrw7n3MQBY8UFcFej53oYkhxwfsKD1SbGRaDy5ZN-sQU8b0Dhako99-lrSjpqj12yM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBGI2YcA1hVe8ZdavxQ2s3RtJyt9UpFqpy1TGHwnHncg&oe=6B084D30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalacticCorridor_Cover_Landscape_2560x1440.png", "id": "4627193387562551", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823259_4627193390895884_5312934501684470882_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta59_4n5ArMQ7kNvwH7dWko&_nc_oc=Adp28jMi5qCnW_KmX9SQ-1zRMh7_DhMPsmtEvqj-4ZtOUgg6724XpQn6ZAtHziSkCeI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTngN9WDJ4lGWhADlc7tN8t6IFfBeawCdUD_VfgCVObMQ&oe=6B0845FB"}, "display_name": "Galactic Corridor: Space Shooter", "keywords": ["Spaceship", "Alien", "Galaxy", "Dogfight", "Starship"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29645257758440938"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823757_1820299249392967_2529949014294351726_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ScpnEujdpwQ7kNvwEqnBsv&_nc_oc=Ado54ilxNA67S5miVbIKLc4omkrPxqQFN3U5t0aubm9gpDs2Wd-2OGlxltAUAvTDdyo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgYHiKO8ixRD45wCJijSL66J8SQvaORECL_o2erL6ZfA&oe=6B083E83"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Galactic Corridor: Space Shooter", "platform": "ANDROID_6DOF", "context_category"
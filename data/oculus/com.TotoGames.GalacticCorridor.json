5&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yUKJM6VHqgQ7kNvwHdtSKt&_nc_oc=Ado5EAoPrAqmNN_idA--jCkHsRJTVXhWO73hwpPgpAUHj1Z57rfVTVzctrMXqvnOB9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_A_359BgwNhovWEohmarqqU-GaFhr_HkLC2sZoUnBLQ&oe=6AEB4BF7"}, {"file_name": "SS-02.png", "id": "1330361517840636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001715_1330361521173969_6103998901719825169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtHSQtZOS4wQ7kNvwH5WHlj&_nc_oc=AdovMlVMYzeNbmPad5QLnOj4X37pQD2l8pm5YrLTjH44eQiqKiF3-B8n6sR90TMkqfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT04go1Oc_2me6uIEGhUcJ78KsXlVj9vIhfZqsTMtup2g&oe=6AEB5F04"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wr-pUqAo44Q7kNvwF2EMfR&_nc_oc=AdqpctK9i1DEDuXLl873fjnBd886NGgSE4ClhHelulHJy485W58PTKwGgW90rJC0VK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4CQsxxI0w8wYGkYr85hJlmB0FDay9O25btrQ0HHI2cQ&oe=6AEB50DE"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04Nd_FhML5AQ7kNvwHhc03M&_nc_oc=AdqW7YINMOHYPgDuOfQImRpOwAIPNeXYvxCbdg0uFXEuLkdfEeJOmYr7CuQs-d_J_qI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ0gFB4i-eGcD6-hfF4hjVyAlx8iQp7h020rVu7ViPKw&oe=6AEB4C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75330721_1142869790778791_6738508368157138775_n.png", "id": "608412628330845", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348036_608412631664178_7827978073378113168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUZzAXqh3E8Q7kNvwFavbuk&_nc_oc=AdqlbUWxUZ6L4dEbJMykgGtAn8V9ETnGYEPhr3tOf-t9Siijlz-ZlpgyrFkA0PhNTxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpUcTbvbd2HC4EWRDxiX6gDNZ9Sn8hj-rJOHv1FgAJLA&oe=6AEB4E84"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
699AFA6B"}, {"file_name": "SS-06.png", "id": "580397078179214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003276_580397081512547_4347607821019348926_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6syp4czF2oAQ7kNvwHfmLzi&_nc_oc=AdlibYg0U8hwdnQNaTC7Bs4DMev4WDPn7sQu9iKuBbZjUh363pHJFz4vdVk48Gw7nak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs2Eq_PknCcJeik0UB-d1Ct9HqjlBJdxca6Dh5M1RnBDg&oe=699AE537"}, {"file_name": "SS-02.png", "id": "1330361517840636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001715_1330361521173969_6103998901719825169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1w5h15P7FJEQ7kNvwHmEtLJ&_nc_oc=Adkg1rH1o-AALZGJByKw0kNvCo7lp5c3ttbY-OPtOiuqgPLCu0ysJH6Rv5CVcZXhwQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsd1fw5VhDNDYXWKa5inAOr39NRWyOA67fKtFdRlulfVQ&oe=699AF844"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3ELRJ1DccIQ7kNvwGb2JI4&_nc_oc=AdnPk-mU4PJF0KY8FKeC9tNYzRsS54aViS0-nOTM-TWMRDYcK5Tp9sKBuK8uDit7vxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afts7_yz_GdDiIsHQeld8dpbZiQB50ZZnRQ6qYUQ3aHxcg&oe=699AEA1E"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4NxaGb5v80Q7kNvwEdaeF3&_nc_oc=AdmaXVaDN6ngFftkj0IOsCZVqtb8JkpLwMilPYMgArxw6rTStlBp0dvALsO4_WfSS68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftHy8hlxIJ3Te5J_YJmllwy6PH4UTUup2S994lrlMXD7A&oe=699AE570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75330721_1142869790778791_6738508368157138775_n.png", "id": "608412628330845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_608412631664178_7827978073378113168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfawYtWPYTIQ7kNvwHvhyAx&_nc_oc=AdnqwK_KiCnUWOsJj82_7MsCicqysC0yTRYwIZfDWo7NrjzKHkZeHjOsiE6-whBVPXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftiSc9R-YZ63VuzA3j6_8NnSoV7gL-_2t_SX7S8H1fmPQ&oe=699AE7C4"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "37440400758348
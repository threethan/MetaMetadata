5&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi_U71Uoky0Q7kNvwG__GO6&_nc_oc=Adq1foi-2D_mlSgGRhmEfA2yozdAA_JqvEIWyRLbpcNBrROfPrd_Sl7pWW80QhYzyGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNuQjBDz-CGjCN9LN1Zp4wHfa_UxVVIHYuWz7oBDckUA&oe=6AE75777"}, {"file_name": "SS-02.png", "id": "1330361517840636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_1330361521173969_6103998901719825169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fATqydoB5XgQ7kNvwHfAC2-&_nc_oc=AdrPPYbOF-4oymr2ePDdFCzz43Xt9E2-3CXkNuahthZGDEZhzfe1FOvJCLWNq0YIuQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwGtxUWYTuKQSlJdxk9M1DozdBtV6a9o9qIMtGWQpf2w&oe=6AE76A84"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11QMVvJQZ-wQ7kNvwHNYaOa&_nc_oc=AdrvEMBKDvqIlfQMMjwV3axDJ5MD-fRbat0AoNoL5ubnT-Ml62INIfXfxMYhh4Z1rxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6cOBAYyctijgL-WSNZW5ak0VNXUMgBpVe7gFQ-nwZqQ&oe=6AE75C5E"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdzpEngxqNAQ7kNvwHOUl5N&_nc_oc=AdoO5MuyzkZx2b7EnTUUJRy5eGpnjv6OC3xX8W82K-P7oOKd37FcjZLmqsWuu4FjNco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTizhfUxV_6i1O4UnWvLz73Z2DyYYdZTIN9g6IfqEXz8A&oe=6AE757B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75330721_1142869790778791_6738508368157138775_n.png", "id": "608412628330845", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_608412631664178_7827978073378113168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmrgKv3DbusQ7kNvwFFCEdg&_nc_oc=AdrO5avMxBLbCHql3JouiucDMpxbmil9Gu_y5tt0FwLbn2hU9mqXLqPcgNBxLmxBm-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK00sH6ymcPsnjpUlA6fOD_AEhBYKVjHW_HhJvxPYBzQ&oe=6AE75A04"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
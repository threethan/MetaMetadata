173969_6103998901719825169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGEi5M69BBUQ7kNvwHrGUwc&_nc_oc=Adqbq3c6uBTY3oMbofQaCpSyhe_H1oudM-471n7P44VJDQE4pv07h-mUPLkIfUxjAOU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO16ybihlnMRYKJJ7JmD0SURufIqqV8Ex5u7AGd8d6XVQ&oe=6ACFAF84"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNX8goLvkNoQ7kNvwEjGyWo&_nc_oc=Adozg_90v1iPS_QKSJ-GRCUsMvglwwtB6prx-zr9CfctAZj50H7yS-L1n1xTZLihXJ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlzb6hnypMUboW4XGhFTrDAOGKoD9OBdhKSHpOUTGW0w&oe=6ACFA15E"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcpFVcEDjsYQ7kNvwHLof4O&_nc_oc=Adptj9uqAylzcnZ7Yajlig_yN1RRW4R-hqlNZSimKixscaKk6N-UFfLBOQXyx5VOqds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt5Vg01bpd_fymCq6uwIQDaPwyaMpaBaQ0O9INA_GHJw&oe=6ACF9CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalacticCorridor_Cover_Landscape_2560x1440.png", "id": "4627193387562551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_4627193390895884_5312934501684470882_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP9zRcYSffsQ7kNvwEcXI5H&_nc_oc=Adr-x7bvueDw2WCX885NWQhivWK_d8d1F7rmR5XWeU6pxhScBbuqiDD-3PxqwKN23-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLt4mm0vfIvJ66xwjCCMmIO8IiS2o0D2NT8B36E3FSTg&oe=6ACF957B"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2
kGmFlg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjxm6hW6XD9NgOYsVLFxCm-2lw8eN-XiMngvnKbJzefg&oe=6ADCCB77"}, {"file_name": "SS-02.png", "id": "1330361517840636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001715_1330361521173969_6103998901719825169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y9HPIgpzxYQ7kNvwFXVTGn&_nc_oc=AdorQqPsf95YB8cUq2xKGkTPcPjTA4sFtQjpRQRswUIBigOY8PxwBo0CTktir4q_L2Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfymeB4DAz2-JR9t9HXs8KGaT4n_7xG-BryqkCfJtWww&oe=6ADCA644"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFQ-inwYLTMQ7kNvwG1gtzf&_nc_oc=AdoXtUKz_8P_vF_0ham0-GDiuDrvhJVcdgcOy4KbH0URADgRAjE4H06H0vH6_9VxMV8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEAZ-Cguk1P-sqGZkEJsuOZPpuPJtPzCzdRbOF2dAezg&oe=6ADCD05E"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMleTmgmJg8Q7kNvwEfULfe&_nc_oc=Adqi14T5o5ZwVSmX9NMxRliPTaSJn7LsCr1rTYy2JXOPSG3BjswIoT3kg51rwt7-NnI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRUdu9EaYAHbRsvfLOXgKu2_Db4Lnd8bjEYBmwmJRmwA&oe=6ADCCBB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75330721_1142869790778791_6738508368157138775_n.png", "id": "608412628330845", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348036_608412631664178_7827978073378113168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0Xptn5IpGsQ7kNvwHfvRVD&_nc_oc=AdpLhuNSMNrb34ShaLD3kEwS8cX1I8UBVbGAlj04nnUpBagS9SUU20hJ7QmYAssx3ww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9481-_kgNnGJ2xUc1SGJ_mleV3wSdDyymndW2Rrlh6w&oe=6ADCCE04"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
&_nc_ss=7f20f&oh=00_AQR4C23KOWoJIRDqCpMACVEbeLldiA_dY7yat3UrpWChJw&oe=6AEF4304"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
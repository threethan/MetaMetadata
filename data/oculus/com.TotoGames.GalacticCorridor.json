oh=00_AQP4LEE_ZgVZM6xnmLlm-eXkuGCN_xgi1da99Zw6RVtCNw&oe=6AD10104"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNX8goLvkNoQ7kNvwGn45Ak&_nc_oc=Adp_k-tWnbqJ9CTAHaK5nvMwCCErxz4ubktyNp7PwfnBXFpnwSI9Af6-gi_aT8bk0pM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBZhFISvXY9VkrgnJ92YL90uN3OgL7pgGaissWJzR0xQ&oe=6AD0F2DE"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcpFVcEDjsYQ7kNvwGZ4GCb&_nc_oc=AdqxRUwKevhHFITPULQiARyBO_k5t58DrtV_Bs5ZcD4tnsGrWT-xBfFGwXHHK02U8Fg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3c3BqqdsS73Td_AY9CFRp12nzTG548oLEwh1javle0g&oe=6AD0EE30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75330721_1142869790778791_6738508368157138775_n.png", "id": "608412628330845", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_608412631664178_7827978073378113168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i525OAIni-sQ7kNvwFNOHpO&_nc_oc=AdrXK1cRk6P0_CegKHX2ufZEx49Jb7gLJASK0VszqdQREnAHnd-O89uRrlV9Uh-DRVE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5kS16mvm_pIsdiqEm8Ao-dHw169RYp2DvtwlQ2td-Nw&oe=6AD0F084"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9337144176345595"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1427817592172298"}, {"status": "PUBLISHED", "id": "1664052560928154"}, {"status": "PUBLISHED", "id": "1020054402955643"}, {"status": "PUBLISH
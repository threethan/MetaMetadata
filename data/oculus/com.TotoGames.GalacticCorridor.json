name": "SS-02.png", "id": "1330361517840636", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001715_1330361521173969_6103998901719825169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjqQDFX0-foQ7kNvwF5jx-u&_nc_oc=AdpsF-HJC5zk1gdlSW0pV7Nny4BXXQoEc91lWC2T93cdkeEB3YGarrSwmU94mo3YtZo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORNzsBYGYiKfAWmhL9PJCwYr0avziT_hcPosCRP7mrNQ&oe=6AD3A404"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPTWHA0N7LoQ7kNvwGu170u&_nc_oc=Adq_hhZCDSH-n-dfhgr1gGJULjbt9P_Z1uA5zQ8Ac7wx2uWeHiV-MVDKp7qEbXRYeF0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZnpH_42sSRn_CKvhVUOICBUy99iVoaOa5wpTIv7zh3g&oe=6AD395DE"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-023uo2M9loQ7kNvwFHDU9l&_nc_oc=AdqlcmCbb-vqi7n-guLRkxsK6ixYlQAVTdM6hChCTFj7q8JwcKpZYbQ_W2_HdzHyEUQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd2wcrjPIByR2t2UwGdMfzTWelqNR3RvSo4IgnwhZ2eg&oe=6AD39130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GalacticCorridor_Cover_Landscape_2560x1440.png", "id": "4627193387562551", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_4627193390895884_5312934501684470882_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7yugR9eVQwQ7kNvwHHB5qH&_nc_oc=AdpY9z-TZsl9udWV5X3vtvXmDBaBNnPNqw7sjAZfamU9NFBmPg-lVXjenano3auK-jo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHyxWRzAF3Wy0UTmKQ-rr2gbtEz2IbRrInk7m92EoWhw&oe=6AD389FB"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
5&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0lLul2MilkQ7kNvwF-Vl44&_nc_oc=Adr56R5SJNtwXnRa63eE0VNXSWT2ycqMoX7BAPhD47aYxG4EC_SEVzG7d768xtR4kg4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOj45nIaojbYI5bbUiXTxe-3Dm2LVZFfF__Dbm5Gk24A&oe=6AE362F7"}, {"file_name": "SS-02.png", "id": "1330361517840636", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001715_1330361521173969_6103998901719825169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A-4h1aUi6UQ7kNvwGGeWBw&_nc_oc=AdrdHCHbiaIXYm3tekcg18txVwl_tM8RCA1SwrwTtCxiXyK8fJHPBFO4E6kLJwG20ds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsf6W2brRzCu8JWFGuCwBFC4FFfoQ4ZhCRTx9tfgb2Dw&oe=6AE33DC4"}, {"file_name": "SS-03.png", "id": "480705915047969", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75443248_480705918381302_5223996666039014695_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HloOCAu8QTQQ7kNvwFJMUUw&_nc_oc=Adr4i6uPJGflaFTSoe0Mf8Lbivnk7lY92u4v-Cnm8tLqOq9egX9jEc0ow2YcDwpSV8k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8iYaJt7Y5cRSR9EUTx5ZjpH2nGM3KP9ueeZf0zpAMnQ&oe=6AE367DE"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icx_Fvb1NTEQ7kNvwF23Kpu&_nc_oc=AdrU9T8cOauqE-qnRVZ9iYBIxIwGf4ZvEkpQtNO0CpxXKHa9OzNiNNuEDgIOfz6UKl8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMwwUx-Xi0T_mHMKBcROb4jvk2CVT7Vm_h-u9qdivq-g&oe=6AE36330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75330721_1142869790778791_6738508368157138775_n.png", "id": "608412628330845", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_608412631664178_7827978073378113168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvJ5k2wXjkEQ7kNvwFGCQoD&_nc_oc=AdrqMBGsajkvuKxsG5sGBLPc8zYxlBBMkeoRkkKFWuDPf39HRJBgs9-f4jFwg-PfLGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcgo4xktviyoEDSHWoPxyAjpOGo2fgIZaxYjQz0myf6Q&oe=6AE36584"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
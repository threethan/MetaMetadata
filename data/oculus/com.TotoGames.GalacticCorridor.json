YjBCfhenZWRU9tb1bv-qI9gcsKXHAGvKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcIpQd5Awpx0MofNRnMCfx-c7ObmtOV3UBALUuffAmpw&oe=6B0DD01E"}, {"file_name": "SS-01.png", "id": "590240793608402", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221321_590240796941735_2272622210460028300_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__LYP3eT-bkQ7kNvwHpCtgO&_nc_oc=Adr_IIWZX7F9Bieda9JZKFt_B6cOc4nkONrHImxHa6J_9dN88xKt1ioO8QqooSwnm4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbDH14hF1ZfysIU9TFngoiraGlDxdFA6h5blX2tBHziA&oe=6B0DCB70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75330721_1142869790778791_6738508368157138775_n.png", "id": "608412628330845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_608412631664178_7827978073378113168_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mou-XUIRKvkQ7kNvwFJUNrM&_nc_oc=Adq0yax4SjBb8YVARrOBcdPg98Ay2r50WyekJKT_kg0jSefF3qDrmeXlF_nmTco8k5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPJ6o8Nv1dP0shJh_S4hRhCPF6yEIZV2H-P7vwWKF09w&oe=6B0DCDC4"}, "display_name": "Galactic Corridor", "keywords": ["Game", "Space", "SpaceShip", "Shooter", "Alien"], "long_description": "Galactic Corridor takes you on an exhilarating journey through the farthest corners of space. As a skilled pilot, you\u2019ll navigate your advanced spacecraft through treacherous corridors, seeking out high-value targets across the galaxy. Equipped with powerful weapons and shields, your mission is clear: hunt down your enemies and obliterate them before they can strike back.\n\nThe game combines fast-paced space battles with strategic planning, as you carefully aim, dodge incoming fire, and track down targets in complex space environments. Each mission brings a new challenge, with diverse settings ranging from asteroid fields to alien-infested zones. Upgrade your ship, unlock new weapons, and become a legendary force in the universe. In Galactic Corridor, it\u2019s not just about survival\u2014it\u2019s about domination. Get ready to conquer the galaxy and prove you're the top dog in space!", "short_description": "Galactic Corridor is an intense space combat game where you navigate through the vast reaches of space, hunting down targets and destroying them with your powerful spaceship. Conquer the cosmos in high-speed, tactical battles and prove you're the ultimate space warrior."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9337144176345595"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "4708012989417750"}, {"status": "PUBLISHED", "id": "1427817592172298"}, {"status": "PUBLISHED", "id": "1664052560928154"}, {"status": "PUBLISHED", "id": "1020054402955643"}, {"status": "PUBLISHED", "id": "1158141045819942"}, {"status": "PUBLISHED", "id": "544652881908542"}, {"status": "PUBLISHED", "id": "465607869922795"}]}, "baseline_offer": {"id": "465607869922795"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjAnbByR64YQ7kNvwEqIMeJ&_nc_oc=AdpIJGm6NjGJTdHRLQH3lVnriTlsh98YMB74dEFLad83Q17tDlXeJzITh3jayJT6wxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL3IcECQtMa2kZStv2GfoBPhNMywEdiG5Fkiah2sp6SA&oe=6A5CD08C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzRRcLORqikQ7kNvwGg7JzM&_nc_oc=AdrFL5NFSoQFA5F_9Kq66VTTOw03N7IRWe25JgAB2ATVDw8tdfezxLmetYGHZ2n8A-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArs8sIqcZKQx-2_JKR6lReC53EhQ2Nf8NF8k6_YShhtg&oe=6A5CE09E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1vU4s0a4ysQ7kNvwGGM42p&_nc_oc=AdpuV_Bfl8oRDpqcFqG81i0kYE0E5X1-1iiu3h1y8U01i4tbzIXIlxcotmLUieNMU-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfNZwscWbSYvTJMnstnRRNA-PYGckUJLDhZa_zs5ZKMg&oe=6A5CC3B4"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmFJnaLilhUQ7kNvwHyaTcq&_nc_oc=AdqVOxRa_PIE6QPB3jUu2H63qm49UQzDcz4gE4nRVY2-Bhe8p885wVq1M52igMRJ2no&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnZcEEHfC2tb7E4y-AG8_lw98U42fimN5n4lbQ7wDp3w&oe=6A5CCDDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connecti
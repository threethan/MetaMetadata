oh=00_AQRdryCP-lG6PpGFMTkdow5kHz8d1WJAaSNq2FNbPRJLxg&oe=6AF9CE3F"}, {"file_name": "2.png", "id": "1687583032389208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8HrcJ7l5t0Q7kNvwF_7ylI&_nc_oc=Adpw4o6G0II3CZ8mIMuAcvns7ip8TI8dtNNqQKzpdyeQKyyuXIcB9b_0SGYAmtn_2Rc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdjOuKqW54sQ7RhMaaFvEYFhCfrPek0PdNjMPAsZv_5A&oe=6AF9EB4C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlloYgXeMTsQ7kNvwEAhyMJ&_nc_oc=AdrwqPERz32845im4ZAFi9RfJlcnRFBalnAGK7aXoB_u5hOKJVYfEjgvQrJRfjmryTA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzJGuc2nKNHtwttwsEgxlzYl1LAGLvKPHeYCjAmryPhQ&oe=6AF9C31E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrLU36mUUGMQ7kNvwGpIQMP&_nc_oc=AdoGHcTR6U05DVsULgkw_Kxigu7hSu8dbNJvdRjiSnmTXXa47TirJsygnXpCuAi3D7M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8_60BzP2TPTkR4sh-Ecm7CNdoGysDgTDUN95GVKvtUg&oe=6AF9DE74"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-cOCEOY6A4Q7kNvwFKLSC0&_nc_oc=Ado-bE3qMYe6S0_5vJI5H-T0aOMQNDOrLuUAw-8Q7kiZMPi7ks8dcuUqGQ7fdULJG5w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhjkB7g28B0yqUC-MovG9rfjg-nLPQn4ygOpYwPXAddQ&oe=6AF9E89F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
nt-sjc6-1.oculuscdn.com/v/t64.5771-25/499623443_1302034772047566_8578001474183558177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOfrlt9mF4EQ7kNvwEtilNl&_nc_oc=AdpVSQOj7G2K4VEc0B45AfHWjyuoXEV9y7EGeRupEozjLMyQSM13Ai6OscHgI2utRks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz7CHxLeo7XThB1YWOjpP6354XgVoeDBRh_l1mBQkyFw&oe=6ACFB465"}, {"file_name": "Icon.png", "id": "1230616885687896", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijpGu6nud-kQ7kNvwHU6lap&_nc_oc=AdqPRmAJSUljEcjhcpoF0b3iX6KeRmUkKEJF9QYCYxpvF9S8RfCV5nsVhJjDUbvUmK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNByer2VWIdNEQdhL-C5X9MqsRzUj2gD5IHvrbk2I6kkQ&oe=6ACFA927"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYPBfRrYP8YQ7kNvwGr_qDX&_nc_oc=AdqjuClxJsypTUEQ4B9nklaiCmqmLcqB82TD3s1y1RlLAupmJUIAYpfyld5sUe5Syjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqvbF8Q18IEl0A4wyX6r9OldrUy-DS6o5j3IhEPiLDcQ&oe=6ACF96D1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKxw2WY9X3IQ7kNvwGVuj18&_nc_oc=AdrmiY3Wx5cqcjGeSvwkZ-3kDoODCMm73mAeGvx-lbsKFCj3RgvvbMCF3R_wdwUtABs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPYDy3AO9JJY-0j7N28RXwssU7mok6FJ3Evg8AbafsqQ&oe=6ACF9B56"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdY8XVHuXcsQ7kNvwGVoc0U&_nc_oc=AdoxUiXej7hCavMe9cDoIYJM0ywZgfgd9reZ1Vmt3J9CCK06e-wnL6G9g_PVWup70is&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhe54FRQThqC3I_4OQ3aQgf3wDQ6Q7mC1PEBDbTOgnyg&oe=6ACFB9A5"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8cwEYZdbqIQ7kNvwHOJh8A&_nc_oc=Ado2VBdhFhnuuGHB4Pv8Ur8WXKCA64zOOVeNR_Fq0ui_MpCDgMX3jyzghN2xCHoGg-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEMaHMo1rvPcQARcV53ilO6ZVYEngxiJ0fpw8TQCLMIA&oe=6ACFA2AA"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM02b4_g4a4Q7kNvwHtQHNE&_nc_oc=Adpfan3_-D7xCG5HJP-fkK5YHBABFOsAg8_vQJPebuwO_hDs6uJDc6BdIfAP2AEjR1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX8JUU9-VKOUO8tz5656InVTWoDfEPKJq_4cgszg5hlw&oe=6ACFAAA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507823984_
5731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv4CGNVFuOEQ7kNvwHM1V_v&_nc_oc=Ado46zIa3B3IfdX8r-WDpOgRMq6NgLdk-CnhUEFrjxyokBHmfO6rk0Ef3nbZ8HUCLMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDivpERjKTG8qs-QV3z0IB3jwdoMdjdi8PadpHfNtftJw&oe=6A68BE1E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB7nGnzOxo0Q7kNvwGOD_rC&_nc_oc=AdqTeIjgfTJw6IZeOFM54c0FfdaJ5ZPKWCAgyE5uvWeL_dZ2ftwYk32TOA0KU9wfB7w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGgkNJ_mhtG3426i0eFtdZct8qOJpSWCRknpnmzcecmQ&oe=6A68A134"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm1bjus8ArQQ7kNvwGb8oz-&_nc_oc=AdpCTaQqWWrTi_GBvIfeboQaqtJAP8-fapPSHe3CATpSe_5EFbnznu_GeOd90-KFGog&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIQ8rVdLHtB-q5yiNIzmc001-1ONZALB-N45e5YHimyQ&oe=6A68AB5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1185413921317719
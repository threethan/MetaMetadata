oh=00_AQMb0etQmal87_gLZcG-kw-D2B0neBNApGJx_DacCMcR1g&oe=6AE0C1BF"}, {"file_name": "2.png", "id": "1687583032389208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7ZLU-_QQgUQ7kNvwE4EotP&_nc_oc=AdosKsAqCIuzkcVYIh6fpfibCDUkrolSaJ-KGZMK0Ykk7XLax3n38ezv3du7aE9--pY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7d9ODukqxei5jS6088RtwuMSmhBg03Etj-dU8nUwvKA&oe=6AE0A68C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTplk1VM40IQ7kNvwFGlman&_nc_oc=Adp846PVPuwWg7iq8lqCB8sLBBpQaEpqooy-kW5n8Vz7qWEO8GeV2DQQnkFIIUgduzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0x0ysqUlSn1lZDERM59T2CASA7ulJ2jqgByEuySnb0g&oe=6AE0B69E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03jw7HJXogYQ7kNvwHeq5LJ&_nc_oc=AdrZA0my48qKu9mHptL50MqOAVP0Hv-H_H64PW0seGFwScqas48D0aNf-1XTd90Nfdw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwIPJ1c-HmhXOYHlzWEp6gxYRmHhjBy0_YCTNjiXq9CA&oe=6AE099B4"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aFHsTm6yXQQ7kNvwHwEJIc&_nc_oc=Adr_r-RavmAdOasA0eGo8jiiBfCH2lUuYPpyBoL6NvjRcg9tLjR3NabaycyCQznx2J8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOncyNe6TkzSK58INaEY7HeHLgPRU7EZw48ux3n6MJ-Fw&oe=6AE0A3DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
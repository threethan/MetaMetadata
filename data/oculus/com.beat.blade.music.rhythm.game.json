me": "Icon.png", "id": "1230616885687896", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhR9Q3FSg90Q7kNvwGPytqK&_nc_oc=AdqnblHhIR9r2SqaQvC3q_tcCWixOBEOV1vXaZGShr8FSHjse6DQ5kaPvPFK_eAWYPw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRlwpKktXLscvCYgSoMbzd7UzAPRW5XMv3YROwOwydlg&oe=6A859CE7"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIH8H4rJRUsQ7kNvwHHnTkk&_nc_oc=AdowWrh0b-zWA3G-Sb9hVBKa4L8oimE_zsFPttyVZA44JQYJdLXTWOilQRIsvZG5BNo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHbvNiDQJVkq4RtqNrISHcuzIMFLc4asAIBFlVW-hwpQ&oe=6A858A91"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPD0s8OF4YQQ7kNvwFqP-X9&_nc_oc=AdoZNcRx6SkRBb2Zy9IU7F1zoolGx0AqU1cEzjWxyXWBE8Niy-ZoVPFMBNizgWpze0U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES05k2eyu1JuYLSuUbsTJbmqUbcfc7GxE6CayQEH6U_w&oe=6A858F16"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvO3XU8VEVkQ7kNvwGC9Wml&_nc_oc=Adrv_o3A63OmuCKAElrraAZ2SQOcuEdLD357ZNR1hKm0YKaCcUAhrUc3423uJUPdMME&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3oLwa8YD01pNdl4d3WSXTYnxeC0kirNWN_PTqkdcWkw&oe=6A85AD65"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxnxxiooeHkQ7kNvwGO9nUy&_nc_oc=Adqx8y6zkpjHDjObOmnXLanp8bTPxxzgF_XgZQQmQxTZitQtLUsJZyO2BMEt9XPbc1o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI7h3rQNcDANAW-pQG1b_wwutqLHs0mPNGB_9qAfOHBg&oe=6A85966A"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tEsEGN8rGIQ7kNvwGqUGF_&_nc_oc=Adoj-_CXWNFlcXHcZAI5clrVf15djIN_A0uCRr8DBKKcVMQGuPSGO-nkVmm9M7L60ZM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExsekRo4mEaH6tZlZq1gZHZPxUq4N7FyYA5aMr21zFKQ&oe=6A859E66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/507823984_1610484593844130_153064461291051697_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3cV8TXTs1MQ7kNvwFlxBqk&_nc_oc=AdqoosR0_32StXDR0uoktou3_yNJJj0CyVyRyKa0h-jgCDL5hpkYYEysSRvW6wd5yEk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2-SjaEBG_PkqYLzbgshRIetHUbYrinDfWyoPG1bh4sQ&oe=6A859D0A"}, "is_concept": false, "is_test
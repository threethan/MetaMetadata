oh=00_AQOtTioDSI19KaSJiNvrJ4icfzbTF-aQUmmPCzvng-9vng&oe=6AE364BF"}, {"file_name": "2.png", "id": "1687583032389208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7ZLU-_QQgUQ7kNvwGDO7VY&_nc_oc=AdrpSaJjsEhqGW4DY5KAkSfFhUG7gKfxqlTjcD8EnERbB7wBendP8Eyx5KxHzf7OAOI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9PZeHDTEUjV1jt7SIetjy8PJ1ToU1-xe_PIlHhtDqqA&oe=6AE3498C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdOglxSG2mIQ7kNvwEnZgxU&_nc_oc=Adq0O64lxATEkiGVcT5JdHaBxfBx_U63z_UQtVoxmtFFb_YOdC8Vhr1kHfz_4520O8U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8c8aUMS-f9X284LVTOars9dkoQ5D5U-GBIXJ13tATQA&oe=6AE3599E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRttTnnhpqQQ7kNvwGhpjxa&_nc_oc=AdqjntELOBXehw7xukm0n1ZuEF4Y_AnY6a4HeBSwsebLiW2pQYdlSXmiSK3ODm-u6kk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvZA-0PGw0pmDGN-USWgUjCvLvD6fK2sH8XK0GczXQZA&oe=6AE33CB4"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTCnfwpYsTYQ7kNvwHBYew7&_nc_oc=AdrZSds-Ll5Cf4YWQ5zK-Srv6ZNVs1wvkA73ynTT1d9yUfPQuAQ2-u-uk0T3qRJazx0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMssM9VTEaDF8JstNIxYRrEkfrP5bNoq1R785exJDGHtA&oe=6AE346DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
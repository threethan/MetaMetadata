https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLDx-K1u_vEQ7kNvwF2r-Au&_nc_oc=Adr4Wg2VF7p2iHS_5mbQHPfZHGN8zwaC3ar6xWPpuH_fSJSzhHDToiSsoA0jFU7q1pc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-X6Kwni7BV4ful_WjOU-LjGxru8Zjy7sqRvllDL_PNw&oe=6AC8EB8C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qZRF5FpgZAQ7kNvwHPfPDH&_nc_oc=Adq5GIBbsPVdV8vP0qFu9gnpL-V2yzAaVCqOcKwc1AqTQ_-A2zJOIMqVulhwZqAp5lY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONFAHYiBV3JwQpW2PkfSV2QctSzh5X9REFnqU0uwjgkg&oe=6AC8FB9E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6buNAqso9joQ7kNvwFFxyx_&_nc_oc=AdqIXV0z92ZVLOMx4EXRNWYRb9EjWCFrRGBw_1khbD8OO_Jt2-zhhykMvth5lhSn0oY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEykAh_CK5g4rXZlvwX3y3y_eCZxUepZIET7ADsLLqGQ&oe=6AC916F4"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdRpXzrcwWwQ7kNvwG4f7g6&_nc_oc=AdrhzX7EIN1FRjdeS94xw4MdorU-FD0ikicHrir-4RhGa6sMqijWK6xtRbxv8U1eny8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT8BDaP6svwhvPk4zOrKWGZxLPXXtUJ-m-2wdmy50F7g&oe=6AC8E8DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974
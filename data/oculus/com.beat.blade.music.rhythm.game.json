5/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3Suh0uQQbMQ7kNvwGsf_SG&_nc_oc=Adr3ZjMW85wOhjvZapmnsQuQ6JiytT5TsXznF8HP-RhbymwVE05fXapR8CIRyYOU15c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd1SSMa0smGpBt7E-3XSRpVOCptIXtjUg7SaGsec9d7w&oe=6A689BE7"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpiLLZ-sup0Q7kNvwH1UgpS&_nc_oc=AdqmQQM66lNF8XZE-sFRYHa8tVvaanX1R1JSRRGbMZ5G5aXe0z3hxnfi6irDm68U63I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwI2FVmWXZrgMcglA8w-6GxymUK2aiTOVgACEJnH6NIQ&oe=6A68C1D1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrYSkU-H7XgQ7kNvwFO1-6l&_nc_oc=AdrDdAO2Fgf9jEga4R2tl5LrKzr8fYa34vrMklYMp4yHTezUGfWWIObGcdpbZ8aghyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjfj3-viCbjKyh8Q7I9DqhYdJEGYQZxeUKTpCtxRBTXw&oe=6A68C656"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQvvuZGwKigQ7kNvwHuIa7U&_nc_oc=AdoFHmdhfneMBc6LN_wVF4VfaMeC7dzvUZypllsYYB2rkwk-IRayvtm0vXr3uj2fc60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtLr77SxOZTpeRU0eXy2w0ptbRid9tSIeegtiKhJKcqg&oe=6A68AC65"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poSQ8XuEXMEQ7kNvwFgGZ-d&_nc_oc=AdqTIYEbgAKScsTHwROW0uOCOkDuaLdFptr5tyU87NdHMhIf8sZ1d0UN1B2zlR5nYtw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmRcvk_4-I4lxVphd3RJsUxpOlrHn6OGjBAjjmZHHOIg&oe=6A68956A"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMSvG9oLNIgQ7kNvwHj6QW4&_nc_oc=AdrIKs9e21ufSIGrI2BEBm_6GMpJyuQ6PiM_woXO0yy3_BmOHi8N5ZqJCZXMox2et14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNybvG6kwBFgqcP7dcYQhj7xzHIQK8na1OyKcA78y3mA&oe=6A689D66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507823984_1610484593844130_153064461291051697_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eBdOmyetc0Q7kNvwEa07jp&_nc_oc=AdqVaZgufU4vijUmzxPjaldy4Val4LM15BWpz9OG3WOAXmHdpA_Yknpd5sHJ43L1wUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCj--wzPxjGG86YVnaS0ljFhfmFmZsq2ihMq4esm_Gog&oe=6A689C0A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Blade", "platform": "ANDROID_6DOF", "context_category": {"context_category":
oh=00_AQS7PuVVBtryoGT1wK9g7wPidtXF3zXZ0SjIWR93i0czaw&oe=6AF4883F"}, {"file_name": "2.png", "id": "1687583032389208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bffh7QthanIQ7kNvwEHOmBq&_nc_oc=AdrdbUnDh44HDI3CpjKEj5igSyNF7t4jcZ9vhPx69MSeLdIhFXoPzsTkBROxVVtMUDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvIXXLMT8ATlUUcMQBAlAtlhSQ7ozMaGiMS3OlVkq1cg&oe=6AF46D0C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXJm2pWImjwQ7kNvwHZWO8R&_nc_oc=AdrgvHgoLwxsNuB13lM-4QiDpgrVRvRqbPxavDICfiHTj3Rw697xu69zt0-DOpmq43M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYQyFOHchMpX3ESxG0nkefc8fs3m5Q34v4NqbW6TPPOg&oe=6AF47D1E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfIlnfy_vOYQ7kNvwHA_hQz&_nc_oc=AdoLRXYbg58Vl0PsTDj8GW5CXkdfmgANvzzcLyoxbFRSwio-_mF6tRYVQlQxj4x2qmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQypPLg4BK6nkPAdTOzRTBcAkvDJVdguiGTi_VtCpy1zA&oe=6AF49874"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HesvxFRsgcQ7kNvwHDDqUn&_nc_oc=AdpFt48SiLKQT5necn-iRGIa9lsTcaFq6Xs9k1fUi1DJ2Zuqva13FsM8e6AGGV8CE9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYncbeVEE02jz_p-fTRPtmquzxilORtdGeqJOCYy93PQ&oe=6AF4A29F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
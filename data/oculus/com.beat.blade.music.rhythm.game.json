nt-ord5-1.oculuscdn.com/v/t64.5771-25/499623443_1302034772047566_8578001474183558177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VykairT2xMQ7kNvwHraglS&_nc_oc=Ado3IkkDQcXSYZiIK_VLLcbYVo8F1ntRtSDOBLGHZSrA_z8wpRnKmQdG43Js3VfhoxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXy3G6T2Cv_PR928PTZArVXw6JzyYu1R0hoftafwMxjw&oe=6AC641A5"}, {"file_name": "Icon.png", "id": "1230616885687896", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq-NoZ3jkxkQ7kNvwF2aU0w&_nc_oc=AdqD-ovGFtK5ya3fIPpll7fX2-qLtf9XIKFg4piPPxEr9BDNjE5pQqmxEjrEaq0sVhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIukdHMRV5V3pVdPe52W7SfJOCIJ6PhVYvobsIMkDu0g&oe=6AC66EA7"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlHKZyz_xFwQ7kNvwFKqCdf&_nc_oc=AdoJ94hFCL7Mzvim8EMKtuvADxYXe336W5uav7EAd-QZDmOLapks9G8lnl886JGasak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRr_J7zHkqyC_IjGq4cW-GKJ3jSkKWLSXWnyxpG_a3Uw&oe=6AC65C51"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM1wLTckCyMQ7kNvwGnpL70&_nc_oc=Adq4HzGOkiLe0ABbn2lOM6I4aIQWeu8nq1H3a_ZOF1QkuoLj_O8cJfDj7r3t9rLLzM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2HLRLlBNFJIQ-QAgeOsOm6XjvpF8-ExysJhDix_CM6A&oe=6AC660D6"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq4mDEQQqL8Q7kNvwHRj4ae&_nc_oc=AdoBDeSttu16DThe7ClOgvKljORmNRJRX_xKIu7mFO7MHrl4m8Gk1vwH0rDwE9VuqlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZL5XI6UWgDXQxi38sa-JP_BfTflacL0iYpxxE_AgJng&oe=6AC646E5"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gugIskUdp8oQ7kNvwFMbVhX&_nc_oc=AdqN6zZRRfS43ynl-mj6sK53Sw_b5gxK49a03En0wdygEVg9yL8JegED09tUGFrX1qM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxs1Fgf__XnAl2CJqsxD_gYE7zg7jRH9spuhwIwDVPNg&oe=6AC6682A"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNPD7e3VGG4Q7kNvwEu_OTJ&_nc_oc=Adp4dMUIq1ypv3MJuPOfBEUL7CbZwQ-XuDDDyPm2kLompLk27SrWaSw7VtT6Qm0piVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOphnQX2d3pvKKbuaJTiFEbsjsm7JH-mfqzohAsrOU8DA&oe=6AC67026"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507823984_
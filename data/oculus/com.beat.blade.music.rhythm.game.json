nt-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1302034772047566_8578001474183558177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVPuFXMBAm0Q7kNvwHtFsgp&_nc_oc=Adpz6Vp5Pfo5rKZNs8aOO4t2RjswXBeYGM0bzM_cPi1M0JJZqPd3i9k70wB_-tgB9ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT3tIeYPgQKoTAoe3Y6T3zDY5-gGJSckj8v2FQCfR9pw&oe=6AC28565"}, {"file_name": "Icon.png", "id": "1230616885687896", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTAD63MgzJgQ7kNvwHtT1ld&_nc_oc=Adq4hItGt4j1DVdIq33uLz09OE6dnIwL6tOAO2Q7TOo52XPGO67Q8q6LyBkdVYdvbT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA1QC4TeHIk1l4nmIWFKaktG-ppxSE9lyqpHDgAmilzA&oe=6AC27A27"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOmx4aXomc4Q7kNvwEBXMVL&_nc_oc=AdrRzO92s2ryV6v4UWw9YFaUc-nL9aECGepmYCtMfyGk2pdELrsTJkPMSjdjh79p-5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2oViEFF18aN0p_tGwPiH8s0T1NcwoMR4w7of3ShNvIQ&oe=6AC267D1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ktAHn5NArsQ7kNvwEo0rDT&_nc_oc=AdrvQAwkMB2PJw5VlZJRF1drRvMcRLrQ1uQX3pvq9NBzLQynkwv0nmpFDCr1O2IXTBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9XHvpVFPbDyAS2AsgSFJCBBG0Ohl4AyA-PuFqKVDXZA&oe=6AC26C56"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKmsm278JcYQ7kNvwFnxN1U&_nc_oc=AdoAaDj-2sIpRHz17NLH737x4k3J42gSAvpdz6eqTSR3tzn_-awJEc9CQVyq1U6SFAM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ8WzkCN8bDXUugI4alea_lzNqMnajOyAJCTINUM-u3w&oe=6AC25265"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUN5Zf9hw7MQ7kNvwFP4Rc_&_nc_oc=AdraELU3hrY2xvA8KoVuI84DWBAGltVX-CRA8iGkOvsL7X6utnM4DicLHehuyTdmAN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE6dm3VsrcNCp1K5FN7dfQx5HhxquDrjfDm77jt3IMDA&oe=6AC273AA"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhzRI1o1ASIQ7kNvwEEpUNo&_nc_oc=Adptpd5L9hY68GfZ3uhX5gfdanm-zJOYoEPKi_Ot_Bhsu9XtzX75wqBSYRRFnmZ_B80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq-c544M8G2mLvcStHa55zUR9ca2Gf8CMSxacMN2bxJw&oe=6AC27BA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823984_
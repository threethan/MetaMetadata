nt-ord5-1.oculuscdn.com/v/t64.5771-25/499623443_1302034772047566_8578001474183558177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46C6qtvlulsQ7kNvwGl9-9O&_nc_oc=Adoo0buftdfCzs5OngwEFaS3ChMnT_XNfAtSkLSZTyZN8gPyvVHe5Vlbh8O8mfcxyGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8OP-OGXkHERD5pEMnBFCytJUWe7FIhdd4cINOlswHFQ&oe=6ACA6E65"}, {"file_name": "Icon.png", "id": "1230616885687896", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHuQYLzNmfgQ7kNvwH7kAwE&_nc_oc=Adr0sNKQzIRpVc46QQdxYyoUSOnouZ9HIzldSdb4Tgf72vzgGJbIcM6KXN1e96Ajpe0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0oT7dYNSdA1vynnd-SaOfRn1lsmw2Ru2KWLdzOJ9NHg&oe=6ACA6327"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyrT3ygAuKUQ7kNvwFxmOJB&_nc_oc=Adocgcf1-fhKHPaBAGsYeSiIu3K4ZS1OB7wm-ZbVTPLcJ0r_EmhvCysQq3NomyNy2Y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgiesm6IA0UHBijxBbh8d54NjCmJqIZlT7ZZQbqScnAw&oe=6ACA50D1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9w_kMDgLfYQ7kNvwHda4jC&_nc_oc=AdpXPjK7xzm4mvrjABy010arIHfs8bw2g4EjtQ2FAIlxEB0hfKeoS0e3Vjc156aeVxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMziXEx7dcSNXdqKEWiazdnSHPijga7ZZmb82e8Bq3EYQ&oe=6ACA5556"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLSjaGvsF6UQ7kNvwGUiLgg&_nc_oc=AdqG2wgG4lqwhmxJaaLAewAI1coGRkZTIIBwpeV3elic2Pj4-_IyZe_QnwFVkCAyG6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGpZDE59erY_aTHSLxQD6n2Ie4-o3Ydz-5IDq2lFXNFw&oe=6ACA73A5"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBAz3j_6H5YQ7kNvwFvDV0b&_nc_oc=AdqVT9vPhx0OPgchLasVTYGHy7KqkHsul9mZdNkZ-eSPaiuPQtf8h405CjrFnoyDWTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYpbKQQky-XwNJJmDUNj-yK36mslfsy4d0em8OwXEX2A&oe=6ACA5CAA"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZobjTpZcnMQ7kNvwGyMkS_&_nc_oc=AdobiBIi7K9NZMZuyv1TXP0C0tN6uaB6GfQ16JYGdBPC7MqLx3PBDN94iMYMo7d_WH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvq7g55yb7eTyUuvHYJ1LGVyCec3wpnkYTHB3FskiYBA&oe=6ACA64A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507823984_
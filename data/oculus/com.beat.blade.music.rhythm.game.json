Icon.png", "id": "1230616885687896", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3PEktiRWPwQ7kNvwGWiYDC&_nc_oc=AdopzOheHc1qsAvM8k8Cro5ORfL516MSWxihn5Jmji_9FigZBQVsxn06pXUZ98DjEtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBz3Ky1AAteBBA2wyYvLWqQyj3QblyZIm4cGQikjintw&oe=6A6DE1E7"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn7If0zfH7MQ7kNvwGL295n&_nc_oc=AdrENT3cAGGHA7tpUa1Q62Tr9MxGWf0pN-tWt1_ZUaiZ4hjfh1G5FXkVqezQXWNxub8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO4iPU7XQ4vge32pgYC1N4Xz-J8qVYUp6Johvi1UpfSg&oe=6A6E07D1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S8NOqzyimIQ7kNvwFGJs7b&_nc_oc=AdoF6q1vXAZjp7pD5dOxzofzf5etpvq2KhS7JkZbd7Rs62ASHbF3euOMcd5exeoQlvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj4pC903g87YG5pCaVHc-ni0UDWmFSmBxnf7eOW8BP-w&oe=6A6DD416"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5yzzkfuO5QQ7kNvwGrkMhA&_nc_oc=AdoRkWX6LOjfpgLY-LbSy_GfmbevqQVtXL8eK0KAXPbmxHWhjgzWfqnuZoGNH-Ij5O0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi7MjUSAtZ5FzhRc3D77RCpMuWXm_obB0qBDi5kLW3tw&oe=6A6DF265"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewThYXv72YAQ7kNvwFhNWhz&_nc_oc=AdrraRDymDFqG27vDbfUyWKz56Yyan9Q36jsYAIItMfuwxiVUIbkpkAHy7usap9P57I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7yipLUd3TNR0cQRSfYTJU4HWcS6umgUqSqewJckLJdw&oe=6A6DDB6A"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZOfpOsTaFEQ7kNvwEYCo6n&_nc_oc=Adrm32_zKUv1MrVHUzxn5U_6VC4Rj45_F0dejYkjzbbkpcfbH_puJDn-NYDrRZ4kCg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhXfAyQ_QWNmyYigl__7pXI3oNbtDuoqt1zJJvCbikQw&oe=6A6DE366"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507823984_1610484593844130_153064461291051697_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqJgJzAkid4Q7kNvwHxqDsl&_nc_oc=AdogKPbFd_ITLppmxZak0p5NgYkCpHXKw0A_Y8AyHKyi9z6bTpW0Wy4IIk5NhA58NWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF3zCdjmmH1tz6J3xiWEicYPp0j9eHYmuYwPfmYM-AJA&oe=6A6DE20A"}, "is_concept": false, "is_test": false, "is_
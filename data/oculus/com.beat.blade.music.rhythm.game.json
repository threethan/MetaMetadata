oh=00_AQNQ8-vkdxZ9lh-fCPj13t8842KHgbBifS_hHIvr3DTBBQ&oe=6AE2133F"}, {"file_name": "2.png", "id": "1687583032389208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7ZLU-_QQgUQ7kNvwGOOm3v&_nc_oc=AdrBOdnjXlS-tD6enCFX8AzQ6_1a9NlB9B6FvyHz_xUjn9kIbjyFKmZbQoXHyzWpHAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMobzZ_hlxSxAyg5f61FHvh_0-ZZM8-xS-dGdTsy7iIkw&oe=6AE1F80C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdOglxSG2mIQ7kNvwHsKDdd&_nc_oc=AdpOhTjVE8w2IGv-MKuUEewmUVWSnwQQYv0w-n7iAF6a9nrhLGaObYDZtl-6t2ggq5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHruC1iziyQOW0a2ucffwNZ7CwJG_7k0bmk8NZguqLgA&oe=6AE2081E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRttTnnhpqQQ7kNvwH-mVcH&_nc_oc=AdpDPgi8r9C9rsgitBlAwNo3eltLCPl_K-2X0IOUsgbWlFUt0ciJDoJizT5EJkp-jDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3vVyFXNug0-eSCMQz2KYot0k2PAILqc8wa2aVh9bSNA&oe=6AE1EB34"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aFHsTm6yXQQ7kNvwHzt2BA&_nc_oc=Adpakizc0MbCh6eJNIagL7b-cd1n1S4wuW9UdmGZkIyCWmWt0xRPv5p3AftOxg2YX5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi5N1XXUtBLNCWaiA83Yoiq_51MGq0kE2bqpcRAbmu2Q&oe=6AE1F55F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
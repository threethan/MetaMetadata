5/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tlSNiPzcsIQ7kNvwGxWCxq&_nc_oc=AdqkcjHQp6nsqWKpqOVe2-mTWVoB5dZf5vRHpZ-k3l3jOrPHxxL-yAt3TjUUsHGAOz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd6N1lSebXxU63qZt-6RewJBwJFi0THertaFDXsCT15g&oe=6A6355E7"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSPg-2FWCvcQ7kNvwFW4Jc_&_nc_oc=AdpfMRcgc6nHd-H_8Xf_oIGuzYUe9KlziPW0DWr1XVIhsD-Sy_a0mUl-Y8FHuf_05PM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsQXnP5hYZYawV85jKfNJ7aV0XSwxKaWrVrMBdDn5JKQ&oe=6A637BD1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlIiwgLsLrEQ7kNvwH6Gvxc&_nc_oc=Ado8EVa-nSY5ZQquWA7QYDLqgS4S1wwSlulnGZ5ihBOHBf_AOVbPGLIZLGU7xaDxYTw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9LPkjBcDduamqrDNRVI8OzuOZosud4iCo_6CNMDlsCg&oe=6A638056"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvBqL8FaHTgQ7kNvwF1ZDd-&_nc_oc=Adqw-cPm0kzK269Pk0CF6cRPxrCCAjtMmD5IzWe-OV0yWKq80oH3HB9RkKTYey9GNqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX21CIG-VX3xxQB4CSSeYQLHNV5hgn1iPEJitqxAHzuA&oe=6A636665"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5r2tsfmzPQQ7kNvwHJ4LHL&_nc_oc=AdpustuxbumsPCj-KOTCGutOLNzD_vdxaMFMQ2eOtfVNnMP_dAauMMR6CyGyYnek-IU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWrmtDxhKUwW5yub3bMQ-erdXwQ4F_vtYzaXsZU_fXIQ&oe=6A634F6A"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ercgu_wQbhUQ7kNvwE93hiH&_nc_oc=AdoJpmRrSmfXh6Dz-Omxcmf3FPLaeGwY_9ZBVb8uw2G12HZUYBP3gT8eP6EojWcxZs4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpGpjZ6BJO9t-M8T9CgQyODwP8GEmyQsHVa-H1B-XL3A&oe=6A635766"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507823984_1610484593844130_153064461291051697_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qksgu96PhHkQ7kNvwG4wX0s&_nc_oc=AdoDIFQ0-9VivZcajIOZvKOGTCmFI60oADZ9Gb0_d1vFQJ8ZUAtTDzyR7M9dxpYDVBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDijMRHmXH21En_zVdrIPelEJZ1LhtJjiHER_Hu9xCo4A&oe=6A63560A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Blade", "platform": "ANDROID_6DOF", "context_category": {"context_category":
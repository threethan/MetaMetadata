5/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tlSNiPzcsIQ7kNvwGl5PYG&_nc_oc=AdrZywtQ5oUBDsQXQ000D5xFhSxjxfD0rCsVs7hHbkA3OtMl9xfzX7ZdI5gOMZl5v4s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRDqbrNq_wk6MIbsDzNXtTM2uwRhFHFnZkXYPF23whsQ&oe=6A65F8E7"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvpo2dMg4HUQ7kNvwGkkoVe&_nc_oc=Adq8ZJpv1R5iP_6OY2rO6oU8YeZ_hENiaQDGluATDjDwvAUXfDGOHsGkQWbt9DJPyQs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC909v_KTOF1ZbbNPskXWUzIyOWZRwZNe1GUPvIP0lZEQ&oe=6A661ED1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cg-KAuDdfx0Q7kNvwGGvjS2&_nc_oc=Adq0wQXDTKqAB7jueftLP3bJA0sPP1iN-QMH9CIOfCOBWQ7tpB3gKfds0uKehvOOuHE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxqCEcXNC9N5cmBbFhPc724QebbEmO0CcjjStOPDzIrQ&oe=6A662356"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xm0TDyFlw5wQ7kNvwGQIiED&_nc_oc=AdorYyDa5gLgsu8389dT3518JMyiusp1Y3qlmiVxrhkKHrMZd6TCpIW7kv28ozwO3MY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvF2uaxa_aKcf7Q0M3wWTyUB-pgej2nGT-QAHKSQ4yuA&oe=6A660965"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms-fYFs37IsQ7kNvwEx41kI&_nc_oc=Adp3wHn0CAceg8yE5Ljlaf4l1GdfvGNXiY7-jw9YVKyU4srxkiychnVcDU57n0Ac5-4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTSKwphRbHfQndfnVZLSsilsoSyTFF476GH6PZwfphog&oe=6A65F26A"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMSvG9oLNIgQ7kNvwFXthan&_nc_oc=Adr3GZhuEMY3tAZH62AzVZ9zlRKtllQUTdkZs8bTbKW5g7OIHdrP4ppDS_grmPPB7Ho&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIoRjjm-5YWXV4Q1iwVijy2gE90dwixuPu7xewLWeP5Q&oe=6A65FA66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507823984_1610484593844130_153064461291051697_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eBdOmyetc0Q7kNvwEvz8Np&_nc_oc=AdqYEV9ZRAufpqevKE_VGR9S2q6C0tg0DrsJELJCHM9PkiyQL2_pHD0XzjZKRbPGRek&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC5SRSIVVizBMqkpdW94PtP0raH-SLFnfxbMIvnG2wGg&oe=6A65F90A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Blade", "platform": "ANDROID_6DOF", "context_category": {"context_category":
nt-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1302034772047566_8578001474183558177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtbuA3VEwrMQ7kNvwFeeEQp&_nc_oc=Adr_J2H5PXgIt3Y0DljLoRE-VX9uk8QJPDq5TbawGgFDLU2BeLRupclUu6PFKronEM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFDRiinmww12yRdReyDEsKVD8m29POcmpAehr6ConLRg&oe=6AD25765"}, {"file_name": "Icon.png", "id": "1230616885687896", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_1230616889021229_7408384582545816686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS65hlXAPqAQ7kNvwFDU0PB&_nc_oc=AdoH1RD_kltYFKpYN1Yv04S0uZCCbk3hlPCzjLJKQ8mMoGGge4G8wa64JpMBMztpmDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC6zkyvX0P9FLECdqT0hlj5TL2GLO-TKjrH4ITmMN5Cw&oe=6AD24C27"}]}, "id": "1674006387055747", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "977982221530721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312422_977982224864054_3072827890093229090_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYPBfRrYP8YQ7kNvwGcWMVx&_nc_oc=AdrELCfIZSW1pBunMFQIQzdQ-DlCg0Sq2yvw5zLT9uwxVmO7gYco19G_OhY2XLt0jz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8KNhYGqF-kGwSGaoedl6eCyrMXmWg_X9v5_24sp9RqQ&oe=6AD239D1"}, {"file_name": "3.png", "id": "28236073335982165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310646_28236073342648831_3942091160523186108_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKxw2WY9X3IQ7kNvwGjl9px&_nc_oc=Adq6Wwe5d6qJIyXnhOZUU8U-kGsuzCeTY3Gxy6buDxy9cxI2P_iZad4QdMHUqiz5UJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMRzIJfJV-rkCLaL-DzwLFrc_NggupXlx9Lij1rigB8Q&oe=6AD23E56"}, {"file_name": "4.png", "id": "1527725392131713", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1527725395465046_2961696855170049640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdY8XVHuXcsQ7kNvwGFLViQ&_nc_oc=AdpvFD-y6wTMlyy_gniv3DEBxFaXGSJOHBJcNHxoJKVcY_JhkzwNKTiTwqNAKGS-9Ig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoPGEh9JuhArAvy0pNIjnvgKeRt8SDSmrK7L29J3-3dA&oe=6AD25CA5"}, {"file_name": "5.png", "id": "1380850910540095", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312310_1380850913873428_2843225670408242816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8cwEYZdbqIQ7kNvwFG9xio&_nc_oc=Ado1PYlVtXVgFaCR9Uc-_lw64a8LLSKQmnka1JS-1UblqxM9Xj43cFtVKrsaRrVNMR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtkTQ7rzg70erAGdO1W7tmWLwWQI3tiRjLe6mw5krPWg&oe=6AD245AA"}, {"file_name": "2.png", "id": "850012641054321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_850012644387654_8382873097328498055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zklbZuaPKpUQ7kNvwEfwXoI&_nc_oc=AdpMurUWuVsW9Dy63IV-ADJyZomQ51Z9s6YlThk0DH1pY0uj0ivVdfBNdZHklM0WrZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYSzc641r-GDEi-XI1YawKVPlAwI8m0l2jqLgNyw-lLA&oe=6AD24DA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1196125923579852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507823984_
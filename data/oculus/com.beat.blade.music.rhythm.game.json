oh=00_AQRfEtTXSq5onZ16OXFbNxD6BhVANKLKhWXfJPYHFiiiYA&oe=6AEDF0BF"}, {"file_name": "2.png", "id": "1687583032389208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD4RqxRw-xgQ7kNvwEG44ij&_nc_oc=AdqYQUGOPMVd3IendmWofjBMh_olA3J1xC1ZtCFKGZTdXAgEEF6gutzKymqWcuLhItk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkcA1pVchIbQSiqg-5FwrkO9C2BYRL6Mif_s1ZGQZOww&oe=6AEDD58C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxCjpoazcsAQ7kNvwFah62s&_nc_oc=AdpDhMAzWdi9_ryls09KyX73n_QqbVTQKPe-DXPcrDOIh0j6M90Ywwob8FeVcUgUjmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrD9Nx4RPmOp98Bkauqv8jVL8h0iwV86wivtRz_eCdGA&oe=6AEDE59E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV_aQc5WyEQQ7kNvwGQvPku&_nc_oc=Ado-s1tL3R8FePJM58cUPSMLhke6qYRkj81j5Mr6wvSl3p8k74uUanqcammS8AobUuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNhxqki-eME9mjuSH8GUhL_-OkB_ddeGxVxt-ZTImFNg&oe=6AEE00F4"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oom0NVAEPnMQ7kNvwH7qWHs&_nc_oc=Ado8yc99Pl1tkC3ahCfClQROg_j-tSHvkNAy21rfltl2TcFSk-L6CedbWSFXat0IaD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8WcCcUZEVkz5E5ccgFq7fJH-z6PMZgf0Vu8euNiaTLw&oe=6AEE0B1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
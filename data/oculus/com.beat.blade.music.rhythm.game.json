om/v/t64.5771-25/499312470_1011082731375877_8472976699639124306_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJkaDkrAjzYQ7kNvwH9xzyK&_nc_oc=AdodbJ9y3aihAW-V_eFPvJR-2H_ogG1BhTDQKUHEs0S0B3z872Db-XuhZbpusJH4mNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z2zK7zSZyiJ6EOiTwhGNXQjE1kYf8cNu50WIhEtEY6g&oe=6A3145C0"}]}, "id": "4440890672821565", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "986044040720908", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/595143057_986044044054241_6319946954959014686_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw-KPOjL7ZgQ7kNvwF7uqei&_nc_oc=Adrb0uD0Ro229_AiMX0jOkaefvSElrrFJSvN1m_77nVrYQFMEnl7WRkgZUnLe5OjODY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FrJiF89SOvdjNr1Cg3NPtSqNeYAUc7VuU9nCiEyNFyQ&oe=6A316A3F"}, {"file_name": "2.png", "id": "1687583032389208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620504_1687583035722541_7507673610153076124_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHy6tiMTsRYQ7kNvwGbR8dn&_nc_oc=AdrSRRKtOYfGxyCWIboaM5Lq128mwYBT40W6K4s1uV-djV2XR00NLt-dsKJaTkdbWYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iW7m9fQAb8T87uXZHDnBJ2sttfsfJ9EYxXp_HGzNCrQ&oe=6A314F0C"}, {"file_name": "3.png", "id": "971804612398133", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_971804615731466_8929055800547931018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_zr4fMPhlYQ7kNvwEw9m8_&_nc_oc=Adr10ZzUGLD4vmXUt10ZllARqgc9IHkqWaWXo1_OuGYuRzOkhegrLH1gLRwSEOUDjds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fKIRx1FExSRfDUIij6sdFqcFfA3i1CAtEl1sZkK0ebg&oe=6A315F1E"}, {"file_name": "4.png", "id": "824590883826843", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310817_824590887160176_5197064716659224950_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb_ltw4aoqIQ7kNvwFrsg4-&_nc_oc=AdptuueXpKl89o6zPfXTRJ0G4LcZ7E6qaDzdUkps79CL1DasMj7VLPNr_SDRbct_0gI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nOBch-Bx69fMcFwaVF-DT-AVhjzRRVqsnd9Y1j6iTfw&oe=6A314234"}, {"file_name": "5.png", "id": "1027497399953684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499626172_1027497403287017_6826082835293901071_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqKJXG0DmswQ7kNvwH-CHDr&_nc_oc=Adrh506w11a2t68MQnsTHx_WMKytQSurzlqsllps_oOV3ZS2YkwTW7e0awwwzJOyxvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vxkekrPoh0owuCl0zaknPLGt55RsLis6ifMz2fpk4kQ&oe=6A314C5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Beat Blade", "keywords": ["Beat", "Blade", "Rhythm", "Music"], "long_description": "Unleash your inner rhythm master in Beat Blade, the ultimate high-energy VR rhythm action game!\n\nStep into an immersive arcade universe where music meets action. Dual-wield glowing energy blades and slice your way through a dynamic barrage of incoming notes, magical runes, and obstacles\u2014all synced perfectly to a pulse-pounding electronic soundtrack. Whether you are looking for a casual music experience or an intense arcade challenge, Beat Blade delivers a satisfying, full-body VR workout.\nKey Features:\nDual-Blade Action: Feel the rush as you slice, dodge, and conquer the rhythm with precise, physics-based blade controls.\n\nDiverse Track Selection: Choose from an expanding library of intense electronic tracks, with varied lengths and complex note layouts.\n\nCustomizable Runes: Personalize your arcade experience by selecting your target runes, ranging from mystical arcane rings to spooky ghosts and carved Halloween pumpkins.\n\n5 Difficulty Levels: Master your skills across five distinct settings\u2014Apprentice (for beginners), Mage, Sorcerer, Archmage, and Nightmare (for true rhythm game masters).\n\nHigh-Octane Visuals: Immerse yourself in a beautifully stylized neon-dark atmosphere with dynamic lighting and explosive particle effects.\n\nTrack Your Progress: Climb the ranks on each song with integrated performance grades from A to SS.\nAre you ready to test your reflexes and rule the leaderboard? Put on your headset, ignite your blades, and dominate the music in Beat Blade today!", "short_description": "Slice the beat! Dual-wield energy blades in this ultimate VR music rhythm game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1185413921317719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312470_1011082731375877_8472976699639124306_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJkaDkrAjzYQ7kNvwH9xzyK&_nc_oc=AdodbJ9y3aihAW-V_eFPvJR-2H_ogG1BhTDQKUHEs0S0B3z872Db-XuhZbpusJH4mNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZrhCt-p-X8QPVTtXbMlMZA2lV34TMcHPiz3a6aYJfSA&oe=6A3145C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Blade", "platform": "ANDROID_6DOF", "context_category": {"contex
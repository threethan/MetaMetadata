8aElrL4Q7kNvwF_DcpJ&_nc_oc=Adr4GYFWTolLphPUKmXSih3T1D4rHDQREqykexi4vfbEKNmZoEYIyBo0si7tb3PObIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXz9euN_R9UzX4WZgdGW8hSLCU8S1nAKo9HqjMszQgYWg&oe=6B0EF199"}, {"file_name": "Screenshot 2026-10-14 at 2.12.28\u202fPM.png", "id": "1130055642739054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673759338_1130055646072387_8762967099260716906_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyrpWTUeqKAQ7kNvwHhZhcr&_nc_oc=AdpO0UIzZJOcZp8fQpciWqOiwChdB00uLc_FRHaQP-FIvb5m_2y83oa3L3KK4vDoS7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUaiupVENUt59m5ClxnfKRInX5YACqM66t0BljnBXBt3w&oe=6B0F248F"}, {"file_name": "Screenshot 2026-10-25 at 2.33.09\u202fPM.png", "id": "2018018642246863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_2018018645580196_6044084015115893045_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBxXHWFm8YIQ7kNvwEU3nYh&_nc_oc=AdrTKgXwvWEl2B3h_BeW1I3sPghk02vInX7taiJGIqPdURM86cgY6Bu8NVCSjdgPgPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLkPciC8-i_6woHFIygN95KNvRUSNG5mAJHIJTANsArg&oe=6B0EFAEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survive The Zombies", "keywords": ["Survival", "Roguelite", "Adventure", "Zombies"], "long_description": "# After 3 years of development, Survive the Zombies has entered Early Access.\n\nSurvive, scavenge and explore a zombie infested city in VR. Build your base, upgrade your character and recruit other survivors to fight against the hordes of zombies at night. \n{1145926084756087}\n\nThe horde gets stronger each night, can you survive to Day 100?\n\n# Survive the Zombies is a VR Survival Roguelite. \n\nKeep the fire alive. Scavenge a zombie-filled town by day, fortify your camp at dusk, and hold the line when the horde comes at night. Every night is bigger than the last. Can you make it to Day 100?\n{4052162995085799}\n\nSCAVENGE BY DAY\nDays are short. Search houses, cars and crates for scrap, fuel and weapons. Go farther for better loot, past sleeping zombies, bandit outposts and the swarm that hunts anyone far from the fire.\n\nSURVIVE THE NIGHT\nAt dusk, run home. The horde comes for your fire: runners, crawlers, bloaters and brutes, and under a blood moon, a boss. Let the fire go out and the dark belongs to them.\n\nBUILD YOUR BASE\nFeed your campfire and it grows through six levels, from ember to inferno, healing you and pushing the dark back. Upgrade your bench to raise walls, traps and turrets.\n\nGET STRONGER\nSwing bats and sledgehammers, fire everything from a pistol to a light machine gun, stack powerups, and rescue survivors who fight beside you.\n\nESCAPE\nRepair the power plants and the radio tower, hold out to Day 100, fire the rescue flare and survive the final night.\n\n{1878562830191877}\n", "short_description": "Survive, scavenge and explore a zombie infested city in VR. Build your base, upgrade your character and recruit other survivors to fight against the hordes of zombies at night.\n\nSurvive the Zombies is a VR Survival Roguelite.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://starkberrystudios.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "StarkBerry Studios", "support_website_url": null, "website_url": "https://www.starkberrystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
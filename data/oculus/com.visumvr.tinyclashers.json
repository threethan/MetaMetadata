ng3og75IV3unEAk8p9yk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xjjoLPcTwFk1E8Pf_fO0D-N9b39-8U6re_kchQomqfg&oe=6A1309AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape_v2.png", "id": "844554501624289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819396_844554504957622_5513275946537921397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQvpRIGzdlwQ7kNvwFbi9Wr&_nc_oc=Adpk8-AMbb53DZIXmRBeC9IU0i2erTMfKQ22yNh997RFovfIJ4bkN1fhSG3fvcv6BU0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hz2nYog5Pn7-XPX4ZPyKaHaTjjKlBNhxuD7E7NjnE2Q&oe=6A131410"}, "display_name": "Tiny Clashers", "keywords": ["Caricatura", "Combate", "Estrategia", "Fantasia", "Aventura"], "long_description": "Emb\u00e1rcate en una \u00e9pica aventura en un mundo vibrante y lleno de humor, donde la historia medieval cobra vida en un estilo animado y colorido. Tiny Clashers combina la estrategia cl\u00e1sica de los RTS con un estilo \u00fanico que encanta a todas las edades.\n\nConstruye y expande tu reino desde sus humildes comienzos hasta vastos imperios y recluta una gran variedad de unidades \u00fanicas, como infanter\u00eda, arqueros, caballeros montados y catapultas. La recolecci\u00f3n de recursos con tus aldeanos y la gesti\u00f3n de ellos ser\u00e1 esencial para mantener y fortalecer tu facci\u00f3n, mientras defiendes tus territorios de los ataques de tus enemigos o para emprender un \u00e9pico ataque contra ellos.\n\nLos combates no solo son emocionantes, tambi\u00e9n permiten a los jugadores enfrentarse en batallas \u00e9picas y mapas generados aleatoriamente, garantizando siempre partidas emocionantes y llenas de sorpresas.\n\n\u00bfEst\u00e1s listo para construir tu reino, liderar tus unidades y conquistar el mundo medieval con un toque de humor y fantas\u00eda? \u00a1El destino del reino est\u00e1 en tus manos!\n\n", "short_description": "Tiny Clashers es un divertido y colorido juego de estrategia medieval al estilo toony, donde podr\u00e1s construir tu imperio y liderar tus ej\u00e9rcitos en batallas \u00e9picas llenas de acci\u00f3n y fantas\u00eda. \u00a1Construye tu reino, lidera \u00e9picas batallas y conquista el reino!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jetv84.wixsite.com/visumvr/ssd-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VisumVR Studio", "support_website_url": null, "website_url": "https://jetv84.wixsite.com/visumvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "2691890164460465"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25682557917996946"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308131_1354780592967718_4032957289321283024_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SUzkfbda9wQ7kNvwFCcVwM&_nc_oc=Adr4_r0-Ju63EcsBGjLf45SL90LzxRA8c9CzrxdQ4omsbq2SKS9dhdftk64lR16qhao&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zg9FeBL6ZYNB59AH9UqxjGVFj15GzUZKQA3B5fARyqQ&oe=6A131964"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tiny Clashers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "World Creation", "id": "1725996564472128"}], "release_date": 1763143200, "lastRevision": {"nodes": [{"id": "7300947573251260", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7300947536584597", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1823588755701719"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1388241879486975", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiny Clashers", "keywords": ["Caricatura", "Combate", "Estrategia", "Fantasia", "Aventura"], "long_description": "Emb\u00e1rcate en una \u00e9pica aventura en un mundo vibrante y lleno de humor, donde la historia medieval cobra vida en un estilo animado y colorido. Tiny Clashers combina la estrategia cl\u00e1sica de los RTS con un estilo \u00fanico que encanta a todas las edades.\n\nConstruye y expande tu reino desde sus humildes comienzos hasta vastos imperios y recluta una gran variedad de unidades \u00fanicas, como infanter\u00eda, arqueros, caballeros montados y catapultas. La recolecci\u00f3n de recursos con tus aldeanos y la gesti\u00f3n de ellos ser\u00e1 esencial para mantener y fortalecer tu facci\u00f3n, mientras defiendes tus territorios de los ataques de tus enemigos o para emprender un \u00e9pico ataque contra ellos.\n\nLos combates no solo son emocionantes, tambi\u00e9n permiten a los jugadores enfrentarse en batallas \u00e9picas y mapas generados aleatoriamente, garantizando siempre partidas emocionantes y llenas de sorpresas.\n\n\u00bfEst\u00e1s listo para construir tu reino, liderar tus unidades y conquistar el mundo medieval con un toque de humor y fantas\u00eda? \u00a1El destino del reino est\u00e1 en tus manos!\n\n", "short_description": "Tiny Clashers es un
tps://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821972_680979814771425_8541731876517148522_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNtmM_seVcUQ7kNvwFvt5nQ&_nc_oc=AdqI8zCbEaK8xrIaoPBhlXPjWUhtgKLxSxE6ZcwMnW4fJlvSE46u38Gp8mem-5GanJo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yAgSuF3dGJ7xSU3EEXsYXZ2O2RBc7-cmHE9MsJWw_RA&oe=6A130C08"}, {"file_name": "4.png", "id": "26288023697453610", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819396_26288023704120276_6585673007728339612_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vExkR5JEgbMQ7kNvwEvJV8Q&_nc_oc=Adq_JVPs0iMZu9M4ZGOPk7_es0Z_P9y5Un5IQMwcoMC1TDq2Ft21NieTFc6ObVz8KRQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OnLTfE1tOYxdA_8WeQnixPfj1iweepZKiuN0_rsJMRQ&oe=6A13068E"}, {"file_name": "5.png", "id": "1366804131761846", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298502_1366804135095179_6338398260647683459_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hw56uiGZvjgQ7kNvwHQEKvw&_nc_oc=Adqh6TRrJpvACCRs5xhMGavpO5BOCbBb18bLO4bv05gCS4tESWw34fWSQXOcyh1fLcA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kb_oGZ8vgyEs2f3WnACBLyMrbUZ4F4c44GsM2OEZ9UQ&oe=6A130C43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape_v2.png", "id": "840241985260416", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304305_840241988593749_5735712309313958076_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6dGfZjqj5kQ7kNvwFuHze8&_nc_oc=AdqffHxnSnRlANdLpbO_LPoYusUdPhuuoZ7DM_QQLHvaYqmXwtYmf3eZlrojUJ_sANw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ja32s3kZbNfsTs3-gB0GH_fFMD7En8s9mv6LmVc1ODQ&oe=6A12ED4A"}, "display_name": "Tiny Clashers", "keywords": ["Toony", "Combat", "Strategy", "Fantasy", "Adventure"], "long_description": "Embark on an epic adventure in a vibrant and humorous world, where medieval history comes to life in a lively and colorful style. Tiny Clashers combines classic RTS strategy with a unique style that appeals to all ages.\n\nBuild and expand your kingdom from humble beginnings to vast empires and recruit a wide variety of unique units, such as infantry, archers, mounted knights, and catapults. Gathering resources with your villagers and managing them will be essential to maintaining and strengthening your faction, while defending your territories from enemy attacks or launching an epic assault against them.\n\nThe combat is not only exciting, but it also allows players to clash in epic battles on randomly generated maps, guaranteeing thrilling and surprising matches every time.\n\nAre you ready to build your kingdom, lead your units, and conquer the medieval world with a touch of humor and fantasy? The fate of the kingdom is in your hands!\n\n", "short_description": "Tiny Clashers is a fun and colorful medieval strategy game in a toony style, where you can build your empire and lead your armies in epic battles full of action and fantasy. Build your kingdom, lead epic battles, and conquer the realm!"}, {"images": {"nodes": [{"file_name": "Icon_v2.png", "id": "25042503788784777", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823893_25042503792118110_5364444592308563251_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-i7Z4GFRQIQ7kNvwGjXC0z&_nc_oc=AdoDq-1jER5NFJLJKPM7_CRUkYN-vVBlFFFrmsOvSFUDlA7ED4o-VAiGa585Cu7vaYc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af460p0qgz7jJxd9dmL_vuQYMhN8k9tewzmMZsj2mj4XHA&oe=6A13213F"}, {"file_name": "Square_v2.png", "id": "4129589780629134", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618515_4129589787295800_1001571336641585_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUH4C5MOv2cQ7kNvwH6sMfI&_nc_oc=AdqIEbS8GnmD10t1icjrtSEi3qqIgsWC51l-kKbklYRb1Efqo1FHpCdZfx8eDfCEN84&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G54CC4TPnMI1qo-HR1WxVndHw2
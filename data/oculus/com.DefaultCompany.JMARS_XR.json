com&_nc_ss=8&oh=00_AfuY0opa8YHsBD0bGl4pUM500reZHVuUctV-JFLHbUe_Cw&oe=69A80F90"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpT308DmbTIQ7kNvwH0FxUV&_nc_oc=AdkKmNxJBSAkwvF_qIM5YUlWPkfWi34-J2PsEKG1M7uwV_ov8JlVqItlOjVo71vjEJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuB9g2b4AfEve_4NS-3euysbkCMs7ZU1NjulwpRKyjlzA&oe=69A81866"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8wbqvnuu7QQ7kNvwFB-yiI&_nc_oc=AdlBLXP5Fk7R8yrrbtfDnry0Mop3AY8FBMVQVNf1buM7pUoNo84JpHhCUYq5heucjs4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuWDLT-dJ9Ed97-gl9HBhFBMRpWfRuMXA9CfVc2GYfrTw&oe=69A80E8F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
com&_nc_ss=8&oh=00_Afw35xpnKuCkkTH9EgRPhtoA2Z5xkrDl2XSEZT3NUv1ScQ&oe=69AD5590"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2J7XQ3w_ycQ7kNvwE9aKuZ&_nc_oc=AdnvUrsxFbAwFlMLiXuEsm_3J0J9DoKxcg_YNlplQGyA1pN2lUWT9Univ32klvXQtBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxD5jZXEjvVdntUuUwWXeZoIjC8mVw_Wedh4JAnUf0Fzg&oe=69AD5E66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlwuksKAXdEQ7kNvwEK3lYJ&_nc_oc=AdmGzelBc7DuyGe4ByP6ouUhvyJqfq_rZAPVzL98uNL8nFUNyDDGahiC8ANIF0Y9Hws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYje062EUMWk8_mssv4OS3X4s3r4W4wGrAzXqnvr6CPw&oe=69AD548F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
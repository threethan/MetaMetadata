com&_nc_ss=8&oh=00_Afx99cdjD5KfKo8UkEgQumseMwQ17WTSgiNlhk58UBz6iw&oe=69BFCA90"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP7xC3aDC44Q7kNvwH3PRWX&_nc_oc=Admetlrf3k2ofYwJDYadz0A02WFC3StmdPL-cxfUGzZOIfYsbcSYc9HW4vvl4VnNE4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8oEQ14kcZUdtgQcb6u8hM2pMUjW8uEpnDtIoFV9MI4A&oe=69BFD366"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFnT49lhWxsQ7kNvwFCcGjN&_nc_oc=AdnA31p7W8vH9yPvhjLWkDHj412MsUUAO4ypUFXyJjCsUP_js418RwubeTtiVz4zzxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfytUha5PYkgu4dc1D0TIXoJSlBtBcROAuvZebJiqzSZRw&oe=69C001CF"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
com&_nc_ss=8&oh=00_AfyXvnl6SekLtdwsL_Q5Uwg2AfJeK7SyoNMkLI5NTCGnXw&oe=69BE7910"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP7xC3aDC44Q7kNvwGILX9r&_nc_oc=AdlSUTiy2i3QbYuLG0OR_81Xtp55q5GBoeP5M_zszk0cA6uEw81ubg5unLODTwVwfk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt2x2-ASW23d3KUIn0oCJb0cySx9tLE38IM8XMTx8kTw&oe=69BE81E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFnT49lhWxsQ7kNvwG2OXvS&_nc_oc=Adl8d_tIoLTl7qqbZEm2i4p2mkAfqk-zL8nnr_uZCSm4kBjOmlDelysnaTAgOvWyHeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afykm8h8uiJWftvNzrtu2hLpRjXNwiauUTpToNKYrbiRHQ&oe=69BE780F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
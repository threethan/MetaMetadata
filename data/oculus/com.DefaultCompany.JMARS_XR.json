com&_nc_ss=8&oh=00_AfwWJ3r6b-eyKRxRO6Qll-MJSfVHud3hCDv5avQphlB3wg&oe=69B93310"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-37vfVC5m8Q7kNvwHwnDRU&_nc_oc=Adnj7EkYnRaE7dOLzEECnAFLePzcdB94sTdR6MOND3Do2nGIZFdeb514_J-ndN6Jd_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyahvwmbhaT5-GInEoxbAJp1BqsAfeCEPxopeSCkUdxkQ&oe=69B93BE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjkNQ2lWtUwQ7kNvwG8snFN&_nc_oc=AdlY_Ieo4q58NJsPP4Z-gIrUc6oK7KdQ3d4cDwxFELlTcvxr9PMl9ZbfahKdhj7KQDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyJL4B_fpF4MUhd1uXYgrZ1qzCoGQVPks7gbVYCNakTQ&oe=69B9320F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
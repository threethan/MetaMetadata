com&_nc_ss=8&oh=00_AfxkMDG1g35WHu5TaxKcKmlH-nTM0Sw7ZtYGvNoyjFXimw&oe=69B29B90"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0y8_nVmBLcQ7kNvwH-nMcB&_nc_oc=AdkcocTwj5gU_dHzN_cznGJ25TIY2jgBJWOeOxRQX7X1MsuM1cK2lfy3zzrA5UAS_t0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzanku8-ybwIG7cEGWJlW3z2QCJZ2BglKLXnhyjMDJQDQ&oe=69B2A466"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXY92GCGHYkQ7kNvwHE4FoT&_nc_oc=Adnwp2MIaRo0BVt5QO5EYGtOoQFn9FiP-nOCGzLPPLzgzIxUfptxToW_S1Fax2TCZxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfydMMCFT7upMFn7c7d8I1xbgw8pwyBf7Q-xsPXjyUcPfg&oe=69B29A8F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
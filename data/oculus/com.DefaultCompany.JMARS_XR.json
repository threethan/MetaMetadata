112702517953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n_tBONvhlkQ7kNvwFcGlRg&_nc_oc=Adpy7KSaeiQV2TIiVrker8N2ER7g6Gern3JW_9HG0_uhsnORbG2_cLsipaCKPUxzH3M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXvbWYHxSQ_DwaJWkzNNcrAsuzTvZdYPhLSbEiuVLszw&oe=6A8D64E7"}, {"file_name": "Podium4k.png", "id": "605167495789823", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974448_605167502456489_1888525164810637797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84qeId75QGsQ7kNvwEIoKHH&_nc_oc=AdrAh-uolhtKD2BeJn2ztWgAs2VdisiCwTJhy40yHeJvg4NfUsZ-pVK-PgQ-V_LIw2U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPyE2WoRBoNu2t0ET6mAbnvW3nbr-273Xw2IsYCSIzMg&oe=6A8D73AC"}, {"file_name": "Pins4k.png", "id": "1145804843803689", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75230038_1145804847137022_1037747449794409257_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtWQq_BcgXwQ7kNvwH2bGdR&_nc_oc=AdqtxkMn2GsmxBUQ1nY5pkXb0H3fzLhhYfK9FCUxS5uL0vPyrZPxCDxj9ttbzkwM8xg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8m5ZUbuZszH4jY1rHxoXFQtdmDGYBF5yTOTXqLsZKzw&oe=6A8D860B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "appLab_cover_art.png", "id": "918904686569600", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974627_918904689902933_6738412427440167074_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bz1hhnZ0T9cQ7kNvwFA6eTT&_nc_oc=AdrfF7_c-vjv4SedPUWoJleLW3dQ4IBFYaRWwxJ1ZCnT5EBhgLI81VFzmu3oNsSRqMA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENC3hllWmSGO4HHJW02JFI1ZUrQ1b0uWjUUbDrSFRC4A&oe=6A8D6ECE"}, "display_name": "Planetary Parfait", "keywords": ["JMARS", "Data", "Visualization", "Planetary", "Science"], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, Planetary Parfait is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\nPrivacy Policy: https://meteor.ame.asu.edu/projects/jmars-xr/privacypolicy.html ", "short_description": "Planetary Parfait is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteor.ame.asu.edu/projects/jmars-xr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteor Studio", "support_website_url": "http://meteor.ame.asu.edu/", "website_url": "http://meteor.ame.asu.edu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8519081284887925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982517_462900756678024_7636270891271662669_n.png?stp=dst-png_s360x360&_nc_cat=100&
904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7UHgU7a7YMQ7kNvwGqgWuC&_nc_oc=Adnhe0eEOkdqy2tR-bCU2uLkcs7Kxa5PSMrsM-UA80UApDfdkNx80J2sXZVg87QOa28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuh2FLhRkuQzl4QutdL_AMzgtET5J4NdoT4wyXxY3DYJg&oe=69984666"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u2gNXSrp9EQ7kNvwFrNFcN&_nc_oc=AdmsoF64_B9-u5eWlSaBgvmdOSqfzVpnJt3edLk0UathlCGLX5F2AMAgriZZGx0SynA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuddYm9puJny6eSe0lk5sQ7uBYGumBemRFCUxOvuq8eTQ&oe=69983C8F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteor.ame.asu.edu/jmars/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "METEOR Studio", "support_website_url": "http://meteor.ame.asu.edu/", "website_url": "http://meteor.ame.asu.edu/",
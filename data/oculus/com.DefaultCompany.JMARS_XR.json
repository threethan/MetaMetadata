com&_nc_ss=8&oh=00_AfsPFEqLjr2VDMXU7AxM9PMN_g69K_r4I5RfcuqEm8s_3w&oe=69A96110"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpT308DmbTIQ7kNvwH8M6ds&_nc_oc=Adn2sESqppOp9Qc-XmEvEwSoidJV9I9P-n_wSLHDUP3yX8EKPxKGIVJa5uVIA-sm59k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsmsrP2kaoQ7N08WtMEgeDzFlbTSlhiaVBrR4Sv_uvr_A&oe=69A969E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22MkExFzl14Q7kNvwHBiOH2&_nc_oc=Adk_Y_FJcDCTUAJNavGhTSPaJBU0Zj3xcPHW0MzLROedaxGTgPI64wcUfdy6NDG6Plg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvmZuJKLO8MYjJsHC5H3zwsIFfBTcchcDo-jnbMpnlK2g&oe=69A9600F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
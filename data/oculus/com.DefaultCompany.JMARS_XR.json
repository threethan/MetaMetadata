com&_nc_ss=8&oh=00_AfzDoCvT287GtiZ-D6UmkfEc9AnXqKKap3unjGcs9tcI8A&oe=69B53E90"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0y8_nVmBLcQ7kNvwGbuhp-&_nc_oc=AdmcBrkl1fCefsl71ze-1cJOsOVLHI4ks8s05iscoHc1Vdxt0vYtgDoArbRU-X7QC8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMr3bsEzqEwokdt228jwKhCSed8Ifb4lzVyMOjlaq8Iw&oe=69B54766"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYQ7faNejawQ7kNvwHUWoN5&_nc_oc=AdlnGhDwpEzxb1Ofu_eXiu7idqoC1X6_0eCPxw8GMESNs0xUTT45o4M3l7mAnVO1l08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4aLjg-NCXcwMegubnlmuVACM7QE1rwGYAYxTi1K8-Ug&oe=69B53D8F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
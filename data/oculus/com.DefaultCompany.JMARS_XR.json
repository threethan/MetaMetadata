com&_nc_ss=8&oh=00_AfxY1a3jtN-TboTYsSiLRHEDgycyqa4K-Bxp48X-gt2n0Q&oe=69B14A10"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0i5iQfQpXx0Q7kNvwEFJuQj&_nc_oc=AdmLlCWeby62SVt1AfLs-x52ZAoEJH2PoacIouiv6rSNYfwFnoG3z52YEt7OdZGfTtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhe2VwlwBni5m5Chps4lxUY2rlhstd2j3zjXfaRmnt5w&oe=69B152E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXY92GCGHYkQ7kNvwFzZ9RF&_nc_oc=AdmoMHaWrgiaIVEvUxrVeW8EFbZM-DbCQ7H9ytkY9AwxL7y11GhQs3WQZkKwTfercJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6etwf3zeoiKw9C47ryoPfsi_Ebtr13l7R10_zqYmUZw&oe=69B1490F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
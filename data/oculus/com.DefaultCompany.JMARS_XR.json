com&_nc_ss=8&oh=00_AfwYbuc3ZXdBPXzT6AQWnCk8JxaIyJ9aCxGQjlSdVfjy9A&oe=69C11C10"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP7xC3aDC44Q7kNvwFakrCm&_nc_oc=AdpYP3WWN7srS8t1o6h6oqd1BLPltx7B66ntQtT5HxKRf6It0BDQCUNiSBEkkR73Gko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0ol5UoKMHzh0OInB8vTEz-yBA-2MILkmEllZtQRRyZQ&oe=69C124E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBMMu-mXw7sQ7kNvwGym8I-&_nc_oc=AdohO_Qfy7qmvymJZbKPHE3Khr1OUFHTCmqWDBOxC7HvtETe4la61U6rC4krWqMSwzs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7YDTFHEJTOD7O8Ox61u-acIoLvm6zefLsbjUZU-lVcQ&oe=69C11B0F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
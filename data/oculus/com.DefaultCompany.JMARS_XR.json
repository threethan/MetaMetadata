ON8S-_LqFHOweje6sWhDuu_Jjv_2EmlknOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvQv4VrG1oSRAVxUjympsC-D5sLXFb1VSnuCWWNS9Nlpw&oe=699C5AA7"}, {"file_name": "Podium4k.png", "id": "605167495789823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974448_605167502456489_1888525164810637797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcTo5-ZaZ3UQ7kNvwFxn7Pw&_nc_oc=AdmPI0hXxc3WWKjRrgpnUo_lFbjpTqandMA-S4dFPC1ILOiupn7M9BkPAFu5UGP1-zc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxDh0TMe1PzpS6jTRtlufZvL7DuOntS5PfJ-sHCmNqHg&oe=699C312C"}, {"file_name": "Pins4k.png", "id": "1145804843803689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230038_1145804847137022_1037747449794409257_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYzxaXHfF8gQ7kNvwGp_k9_&_nc_oc=AdlB90YshpLaizcezFtMV3OgQm1QAHJ0hTpCkEU9XO4e9JSnbG1Yw-SVoZmDtKUS2-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvivMTdPznumXlYLzLEeE-5W-YzLDUDFKmM7d7jaIRuxg&oe=699C438B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "appLab_cover_art.png", "id": "918904686569600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974627_918904689902933_6738412427440167074_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebxSlcF3zuAQ7kNvwGBRQaX&_nc_oc=AdmGIHHnmabeSjTWTAOH8gREzyqYp5UtKQ55Ia_KbFkEV_kLcOBKCE_5dGo0bIElw8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftss_qv5SSxic3oPtntOwiSZDa5hoHBJuyssI4iob-Gyg&oe=699C648E"}, "display_name": "Planetary Parfait", "keywords": ["JMARS", "Data", "Visualization", "Planetary", "Science"], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, Planetary Parfait is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\nPrivacy Policy: https://meteor.ame.asu.edu/projects/jmars-xr/privacypolicy.html ", "short_description": "Planetary Parfait is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteor.ame.asu.edu/projects/jmars-xr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteor Studio", "support_website_url": "http://meteor.ame.asu.edu/", "website_url": "http://meteor.ame.asu.edu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8519081284887925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982517_462900756678024_7636270891271662669_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACp5gZHwmTkQ7kNvwGUyFWt&_nc_oc=Adk24JRGRN2bZpuPm6pIBlfQoRTlNQT2hJJ2XEgWBzW5G71LEs1Yq-Jmx2sn5IAA7QE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_
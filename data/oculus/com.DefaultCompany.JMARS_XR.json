7953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqNf_7f9Q24Q7kNvwFC8vfu&_nc_oc=AdpLz-PTFl-qZw1I-5xjv_3wP7_owmioANaHu2aG5clA5iygtYVq7_9b3kPE-zSCUWo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4BRZR0Xx5gYB4-PBL6xJnD8F-0bbo2xpdawS7QNZptQ&oe=6AF9B827"}, {"file_name": "Podium4k.png", "id": "605167495789823", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974448_605167502456489_1888525164810637797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf3MBtLmFXYQ7kNvwEZndbn&_nc_oc=Adr5CQI8C-KJU2gKNGaLCowCz4_I8WFsidX2LOv6YqwvR8XKC9mt7euM2I6E0ek1nX8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO208wuYsbYBTGb1SajUUxF17gTr6Xk8oUJBKm4kMdnw&oe=6AF9C6EC"}, {"file_name": "Pins4k.png", "id": "1145804843803689", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75230038_1145804847137022_1037747449794409257_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21jWVH3zav8Q7kNvwEwueFU&_nc_oc=Adq4ZpahLGVfta9EGX3ph1vb7yJ0KopOQmR8UoC4olCSH4uI7NBGJeC8SnzOikVeOJo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt5T8gS2H2sRSmxt8_Jkk-Ua_6jucr2IkIE4N1BLX8vQ&oe=6AF9D94B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "appLab_cover_art.png", "id": "918904686569600", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974627_918904689902933_6738412427440167074_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My_8j_N-6tgQ7kNvwHacSub&_nc_oc=AdrnPLD50Xcit6rP98mPq04dIuEA5GomURbJsdmUVrp1UnWceqI8B3Q4Vvaxsmd1dXw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPALzyGLqk0cTxklHJfW8AX08UeSTEulOxXRFqNZ4ltw&oe=6AF9C20E"}, "display_name": "Planetary Parfait", "keywords": ["JMARS", "Data", "Visualization", "Planetary", "Science"], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, Planetary Parfait is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\nPrivacy Policy: https://meteor.ame.asu.edu/projects/jmars-xr/privacypolicy.html ", "short_description": "Planetary Parfait is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteor.ame.asu.edu/projects/jmars-xr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Meteor Studio", "support_website_url": "http://meteor.ame.asu.edu/", "website_url": "http://meteor.ame.asu.edu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8519081284887925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982517_462900756678024_7636270891271662669_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_s
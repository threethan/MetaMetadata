com&_nc_ss=8&oh=00_AfzR7GxJrFiEE20c3cN3nAbkGCIBgitziO2TBOi_YtN4IA&oe=69AEA710"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0i5iQfQpXx0Q7kNvwGZVr5_&_nc_oc=Adkqc6pe7kae2d81GAObmAZ06N5O2Z3z8_vY6a7xwug9YQavVd97MH7_cY6hNsNDCHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1jvIeutQHnxhK3dq2CUKj_u_CPfUZq3He4HouTgj0ag&oe=69AEAFE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlwuksKAXdEQ7kNvwG1FAyw&_nc_oc=AdnEixEh9f1Mfk3RKFoZquUCvcoa8W1LRf-HGAQUHBBa8t1QwYNOSZbCSYNJi3tUKhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK_-L8_K87DYmU9mOmb2hX_073xiJk2B88CAR7s3bLkw&oe=69AEA60F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
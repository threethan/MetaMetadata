com&_nc_ss=8&oh=00_Afy0JO6VGSI87RoZAxqP3m75ZWkz2vFjrIRuIv_Rp2AMKw&oe=69BD2790"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Z3E_c-09AQ7kNvwHyLTxU&_nc_oc=Adl433eiRlAG6ZvsVsrjgOKuBiEJRYj6hQLlALkJ2dL_Vi8j6QtHRTf92AlqZn-2KOQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3zzgEYm8IvjRPabfzPrFrNhzPxVJgxcb7KaozsZ_tEQ&oe=69BD3066"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFnT49lhWxsQ7kNvwFdpwIp&_nc_oc=AdkTNv2sGxhEtvrKBbS36sHJ5yBkfh_LjI_7gWTesz8xQEHbx12VONKYiaLVsmfKWAo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxxeiydluj5Z0T_kguUQCjwvtxH8QyLQO2MMP2JFQgbgQ&oe=69BD5ECF"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_priva
OyRsCeBFT09DiilTF1xqdWlQBqjvCWj7sHjPb1L5t8DtERfirDkvY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4nnuruKWqDJv3i2HsEoaMO4WAmi3wKcITgwVf5YW8ZA&oe=6AC7AED0"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsGNJjZ0Qy0Q7kNvwHL3n9g&_nc_oc=AdoN7s46JZmkxCy7ZbBmRKIrIjNFpGy2OClaam_R_TLdjTd9IdW0dQWl1pCtO892Y5g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgojww8vluMT7JZFr3CvZIoQCtOHfo_MNgakmgvD1xnw&oe=6AC7B7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkCSJZBlmSIQ7kNvwHtyHbl&_nc_oc=Adr4-RANvtbaV3VciEWzeBKVNfd19gLqzCqJCbuV9_Ov2DHU73Loc3XaOeHolKZ7UkA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg4fUgMEojCND3yVdSiSHnGIQZlZtzZIGEmR0qs0gHgQ&oe=6AC7ADCF"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meteor.ame.asu.edu/jmars/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "METEOR Studio", "support_website_url": "http://meteor.ame.asu.edu/", "website_url": "http://meteor.ame.asu.edu/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "501639482148086"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "586157766384665"}]}, "baseline_offer": {"id": "586157766384665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1676098800, "status": "PUBLISHED", "id": "586157766384665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27346678428368260", "version": "4.3"}, "id": "735495554830307", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5666705306792218", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27346678428368260"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id
in6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7soPb481GBwlEfZNaR9amDsGpXdnvUxNANhmXTvD1iQ&oe=69AAB290"}, {"file_name": "i2.png", "id": "739889630744345", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031308_739889634077678_8774823006904544637_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2J7XQ3w_ycQ7kNvwELwGEa&_nc_oc=Adm-hjlGh38fGvLRKO5k6EYBQosMHZhLM5ilB936ZJOhf4_Oh7UImUaoJuPDcTYaGLk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFgDRlDg7xugBM1ESVmEdRHF6FA4Ztvb-ryfH28CGSLA&oe=69AABB66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "into.png", "id": "1608918926210476", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974880_1608918929543809_9145368718460416182_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22MkExFzl14Q7kNvwFSYhcz&_nc_oc=Adlt6iH-qz5u3g94AeCCI268jaTtAlIb7hzQRsGNhDvanXlD-r7VmG9dpxkWue_ILBk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGYmWxSm-flLFNQ-2yixp7WKbatEqBUenOU4FvuKS2wQ&oe=69AAB18F"}, "display_name": "JMARS VR Viewer", "keywords": [], "long_description": "Based on ASU\u2019s Mars Space Flight Facility JMARS GIS tool, JMARS VR Viewer is designed to support a wide range of scientific research tasks, including geologic mapping, feature analysis, and mission planning. The platform includes a variety of tools and features to support these tasks, such as 3D visualization, annotation tools, and data layers that can be overlaid on top of the terrain data. It is intended to be used by researchers and scientists working in fields such as planetary geology, geography, and geophysics, as well as by educators and students interested in learning about planetary science.\n\nFor more information about creating custom terrains, please visit our website: https://meteor.ame.asu.edu/jmars/\n\n", "short_description": "JMARS VR Viewer Platform is a virtual reality platform that allows multiple users to collaborate on the analysis of planetary terrain data."}]}, "developer_name": nu
er": null, "video_trailer_thumbnail": null, "display_name": "Illinois Tech OER: Brick/CMU Wall Demo", "keywords": ["Architecture", "Educational", "Building", "Engineering", "Simulation"], "long_description": "This app is an interactive architectural demonstration intended as supplemental material for the OER, \"Building Envelope Inspection and Rehabilitation Engineering\".\n\nIn this demonstration, users can deconstruct, manipulate, and scale the individual layers of a 3D representation of a common wall construction. These layers include the brick facade, concrete masonry unit, insulation and mortar. This application also features a menu with a short description of each layer.", "short_description": "An interactive architectural demonstration intended as supplemental material for the OER, \"Building Envelope Inspection and Rehabilitation Engineering\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://guides.library.iit.edu/buildingenvelopesOER/privacy", "developer_terms_of_service_url": null, "publisher_name": "Illinois Tech Paul V Galvin Library", "support_website_url": null, "website_url": "https://library.iit.edu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1107125379156847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499295279_1490241399810482_
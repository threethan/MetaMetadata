c_ohc=zukeYKr6ve8Q7kNvwFY3UEj&_nc_oc=Admw0NuPQKyJmWYUzIwkzC5MQlIb9cAyVzRASmYgCK--nX93F7n-ksdqRBmewSOpD4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4T6Tt8xq8D_-r2UtDDEfx8rzA8ZToWF5iWQ_ieIEJhw&oe=69A6D179"}, {"file_name": "Screenshot5.png", "id": "1723946911538552", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831038_1723946914871885_8586719770328030825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy6_olGLjAoQ7kNvwFeEt8H&_nc_oc=AdlrWG8DtHalbbJhEp1WW5Mae4p45FR_sYQomG5F-urgJ3mjtoV9qxUI8_eur9xMe-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwHfufmpM_raLHeDOIfztdw7ZiLBv8h-1_ldMX7NTa3Q&oe=69A6D216"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meditation XR - Mindfulness", "keywords": [], "long_description": "Mindfulness Meditation XR is the #1 app for mindfulness practice in XR. Discover a happier, more mindful life through our meditation courses set in 360 visualizations of nature, space and art.\n\nOur meditation app is for anyone, whether you\u2019re brand new to meditation or a seasoned expert. It\u2019s also for anyone who needs a mental break, a soothing sound, or a peaceful night\u2019s rest. Our guided meditations are divided into courses, the first one being completely free and the pro courses having free previews. Many of our meditations are also available on YouTube VR.\n\nOur Masterclasses are taught by world-renowned experts in the field of mindfulness, and we have breathing timers in both visual and audio form to soothe you into a relaxed state. You can choose whether to meditate with music or without.\n\nWe\u2019re having a positive effect on more and more people each day. Take a moment to prioritize yourself today, and enjoy the app. ", "short_description": "Mindfulness Meditation XR is the #1 app for mindfulness practice in XR. Discover a happier, more mindful life through our meditation courses set in 360 visualizations of nature, space and art."}]}, "developer_name": null, "deve
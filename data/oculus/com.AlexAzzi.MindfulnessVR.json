com/v/t64.5771-25/491825074_1046559384045901_5353844671882201970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDtfpFzxnCMQ7kNvwEnjYAg&_nc_oc=AdpUi3LxOXZL7C3qW2nS6QgNYjjD8Ox-p9XMxpO5Hj2Z232SbeRYyFOv3YtzaCX7rQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxYGdSskuzxHvP3GSRIQtNjSj0K88RnmE2MxKdmEArHg&oe=6A5CC079"}, {"file_name": "Screenshot5.png", "id": "1723946911538552", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831038_1723946914871885_8586719770328030825_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw1mGefYhkoQ7kNvwEfhpZh&_nc_oc=AdoL8cp-jgiLEt42-3lhiJQggJjHa116uXE5DFsdP7HgCQxQc7iY-gB9J4C9zHo8ebg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX572hb2i0FdZmOEXGpDPXaOH2uzA0khsTYwNYWGsT9w&oe=6A5CC116"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meditation XR - Mindfulness", "keywords": [], "long_description": "Mindfulness Meditation XR is the #1 app for mindfulness practice in XR. Discover a happier, more mindful life through our meditation courses set in 360 visualizations of nature, space and art.\n\nOur meditation app is for anyone, whether you\u2019re brand new to meditation or a seasoned expert. It\u2019s also for anyone who needs a mental break, a soothing sound, or a peaceful night\u2019s rest. Our guided meditations are divided into courses, the first one being completely free and the pro courses having free previews. Many of our meditations are also available on YouTube VR.\n\nOur Masterclasses are taught by world-renowned experts in the field of mindfulness, and we have breathing timers in both visual and audio form to soothe you into a relaxed state. You can choose whether to meditate with music or without.\n\nWe\u2019re having a positive effect on more and more people each day. Take a moment to prioritize yourself today, and enjoy the app. ", "short_description": "Mindfulness Meditation XR is the #1 app for mindfulness practice in XR. Discover a happier, more mindful life through our meditation courses set in 360 visualizations of nature, space and art."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/68ca91d8-c4fb-425b-90e8-3e3ab788f552", "developer_terms_of_service_url": null, "publisher_name": "Alex Azzi", "support_website_url": null, "website_url": "https://sites.google.com/view/mxrm/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25131761143119862"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827718_29252574207721549_7279736092701766298_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZjYYlXuw3IQ7kNvwFpdr_l&_nc_oc=AdrjcEH2YNIKizv2HA_QQCeXhD-6th78-E8tLq0GtAhEd5LTwPajGMmYSfEUOcypBGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChrkyVauanTYv99dOwsLH2AqltZX-tBeCXt5eQgAx6ZA&oe=6A5CE269"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meditation XR - Mindfulness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1712960640, "lastRevision": {"nodes": [{"id": "7400763583312891", "release_type": "SCHEDULED", "administration_status": "APPROVED", "
574241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrTMbBdHQ-oQ7kNvwG_dMqK&_nc_oc=AdoK9qSYlYy5jM3cCU7rRpdssnWhRuoCOFDAXgrhuv-ipYel97WJU0IWW8g8gVXUwik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADNMwg5fgR0udU-b3O7SHTsCFogeUUekpIHCcH3brbKA&oe=6A69ED84"}, {"file_name": "SS4.png", "id": "2055620651868362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_2055620655201695_841050247891813486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWn-XsQ_kj8Q7kNvwFRY0t9&_nc_oc=AdqDFdtW-M7rX4Q36S5ygBz_3kppuaIZ1A6YBB7SL_oSzUKkV8axFCbLPxEd4t-JxiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFhCag3sMhOxL7aPbBG2V1aPttPAi6Neo97XD-VxC_lA&oe=6A69FAFA"}, {"file_name": "SS2.png", "id": "2096131944556189", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_2096131947889522_3100244231853512994_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6dSDW0XbAIQ7kNvwGVrqa-&_nc_oc=AdrNBnTAocaedJriwX3amYkdc3Lxyzf1qzYrEOLEF1-3kBEatajItXrL7G_z2eTTE94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAR2bJTK-s-7C1og5kttbG88fdfWatdjCktTArOFqKvg&oe=6A69FC5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Fire Fighter: Job Simulator VR", "keywords": ["fireman", "brigade", "truck", "rescue"], "long_description": "# Experience the Thrill of Firefighting in VR \u2013 Heroic Rescue Missions Await!\n\n**Climb the Ladder - Put Out the Flames!**\n\nClimb high and face the fire from the top! Use your firefighting skills to put out the flames and save civilians.\n\n{2326554851118568}\n\n**Firefighter Rescue Missions**\n\nRescue civilians and extinguish raging fires in this action-packed VR firefighting experience. Use your expertise and tools to save lives while battling fierce flames and dangerous situations in this heroic adventure.\n\n{808330205543383}\n\n**Be the Hero: Rescue, Extinguish, and Save!**\n\nRace to the scene and rescue civilians in life-or-death firefighting missions. Use your tools to put out flames and save lives in intense VR firefighting action.\n\n{1213614294019505}\n\n**Explore the Firefighter\u2019s Hub \u2013 Your Mission Awaits!**\n\nStep into the fire station lobby where your next heroic mission begins! Choose your next rescue operation, prepare your firefighting tools, and get ready to embark on intense rescue missions.\n\n{836788292489456}\n\n\n", "short_description": "Step into the boots of a firefighter in I Am Fire Fighter \u2013 Job Simulator! Immerse yourself in thrilling VR rescue missions where you battle raging fires, save civilians, and operate fire trucks. Use realistic tools like hoses and axes in high-pressure situations. Experience the ultimate firefighter adventure with intense, interactive action in every mission!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33007560248859836"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1311310120639053"}, {"status": "PUBLISHED", "id": "2136188363814328"}, {"status": "PENDING", "id": "1854580985222485"}, {"status": "PENDING", "id": "207341649
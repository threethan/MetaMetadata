s=7a30f&oh=00_Af36FowYfHr_eTVQ3Hu7qExCeVXESxuPTr2fjzqCw7AfoA&oe=69E7767A"}, {"file_name": "SS2.png", "id": "2096131944556189", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823271_2096131947889522_3100244231853512994_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCMh86jD8Z0Q7kNvwEsndL0&_nc_oc=AdrpOqPiBqkNwtWbE_kPRJqR9knajrMR8E7fiao-cPZ8OtmXHjpOu3bMMsdecu4iIXw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X-CyCSa-GGnKTLC2XXZ6uFbaSN3bRKSFQH2EzO4UeTA&oe=69E777DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Fire Fighter: Job Simulator VR", "keywords": ["fireman", "brigade", "truck", "rescue"], "long_description": "# Experience the Thrill of Firefighting in VR \u2013 Heroic Rescue Missions Await!\n\n**Climb the Ladder - Put Out the Flames!**\n\nClimb high and face the fire from the top! Use your firefighting skills to put out the flames and save civilians.\n\n{2326554851118568}\n\n**Firefighter Rescue Missions**\n\nRescue civilians and extinguish raging fires in this action-packed VR firefighting experience. Use your expertise and tools to save lives while battling fierce flames and dangerous situations in this heroic adventure.\n\n{808330205543383}\n\n**Be the Hero: Rescue, Extinguish, and Save!**\n\nRace to the scene and rescue civilians in life-or-death firefighting missions. Use your tools to put out flames and save lives in intense VR firefighting action.\n\n{1213614294019505}\n\n**Explore the Firefighter\u2019s Hub \u2013 Your Mission Awaits!**\n\nStep into the fire station lobby where your next heroic mission begins! Choose your next rescue operation, prepare your firefighting tools, and get ready to embark on intense rescue missions.\n\n{836788292489456}\n\n\n", "short_description": "Step into the boots of a firefighter in I Am Fire Fighter \u2013 Job Simulator! Immerse yourself in thrilling VR rescue missions where you battle raging fires, save civilians, and operate fire trucks. Use realistic tools like hoses and axes in high-pressure situations. Experience the ultimate firefighter adventure with intense, interactive action in every mission!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33007560248859836"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PENDING", "id": "2136188363814328"}, {"status": "PENDING", "id": "1854580985222485"}, {"status": "PENDING", "id": "2073416490105106"}, {"status": "PENDING", "id": "1635150070745038"}, {"status": "PENDING", "id": "3504990226329342"}, {"status": "PENDING", "id": "2290621984795721"}, {"status": "PENDING", "id": "1463975095321492"}, {"status": "PENDING", "id": "1526197678837925"}, {"status": "PENDING", "id": "2099625354208925"}, {"status": "PENDING", "id": "1570731488042262"}, {"status": "PUBLISHED", "id": "2129381401198214"}, {"status": "PUBLISHED", "id": "1163552309327316"}]}, "baseline_offer": {"id": "2129381401198214"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2136188363814328"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
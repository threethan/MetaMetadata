70_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv41g3cKRGsQ7kNvwGaBkyP&_nc_oc=AdoqgClLjwruk477zBGWwi0GS6BuU2FhC0TvHRJ6KLCH-ZL0ehGkpYU5p612PACcKd0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvaVAxjdF29AMnFGxyrxnnkHFRnQW0Efz4PKCdhWLhTg&oe=6AA1526C"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHy4KMbBEAEQ7kNvwGqFQdf&_nc_oc=AdrEQKhogFNj-0PFhb1_acQJ23bD-vVo19H0yHo3avd0kukHWT06fbifGIxSui8iU7g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1yDRCKavk9M18iTT-bMJtgAj4xBYJ8SF6aW_WbuqKNg&oe=6AA15AC6"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yEfcDsccIgQ7kNvwG61f1n&_nc_oc=AdqDxieuWVmYHU3rX9B8luQSR_-5KbtZ5SVtNxCDxsnCrCC5jN6mrKrTimIpaIJuM3E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKywjuwCEpjtd10OQS4au9F1fBaAp4WTW1NNjjnPFVVbg&oe=6AA153C8"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnfH8TSbjV4Q7kNvwG0xzP1&_nc_oc=Adq7Yo0dE928il_p5mdFfSIBGKaxMwMxCu01wXxQYAGt0rbUE8A_czBsBkuoLAw3Rn0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRmQ1C8lRLgoVyY1K5KXpuUDT6wxa7WaC2vrcnSIzDKQ&oe=6AA15501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23azioLx3ZIQ7kNvwH5kzI2&_nc_oc=Adp5Ed-ZZJM6uRDQF1Jw71xrjRP_3a8y9YLlUCH4ICKZdx5mLmuc1yJWzoT4eBgPbMo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHCmduQlEp2m30kRNehDnKmGLgOA6X9WY3eRxzoovMaQ&oe=6AA151EF"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_servi
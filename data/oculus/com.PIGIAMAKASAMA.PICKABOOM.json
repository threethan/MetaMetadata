c=7ffzvq4IvOQQ7kNvwFlrdA-&_nc_oc=Adr4vh18Yq3pf2ytbqI526dP_Pp8nmvz7sKtc4BM6-JD7rZEvPrczDg16UnFdsiMsi0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBPGOWqZbUs1eNZwovxw2cqOpxTwqefyOZgpwyMOMJvQ&oe=6AFB2533"}, {"file_name": "PICKABOOM screen 5.png", "id": "26340191032350470", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825257_26340191055683801_1947524011451423244_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXyV7RojENoQ7kNvwEU1wqW&_nc_oc=Adq4WNeiMGe1nMCP4CF8QYkLTKCjgcKgx1ozUd9pJ8DExUgIhJZbyJXIADQYIUHP6Yc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqyffxOB8o5mv94mqDqogQ9BG_NUgYg4DwsD0IvJVxmw&oe=6AFB361D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "End Trailer.png", "id": "1645374636513462", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823901_1645374643180128_6414114088449502866_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqZEA16q1WUQ7kNvwH71cm6&_nc_oc=Adq185dpInIRHNC0iuCKJfsAUR46MbuNladXkU0TXNzZkuC1egHob1uRcw3uVKk_xjo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzzN4jvWL4sg_uvEyMSFzd5JmmT-Gr4Elt4nTQFnOJhA&oe=6AFB37CA"}, "display_name": "PICKABOOM", "keywords": ["survival", "horror", "free", "shooting", "mining"], "long_description": "\ud83d\udc7b **SPOOKY ADVENTURES** \u26a0\ufe0f **DANGEROUS BOSS FIGHTS** \ud83d\udd2b ** \u26cf\ufe0f **MINE AND LOOT ADVENTURES** NEW PVP ARENA** \ud83d\udca8 **RACE MODE** \n                                                                                                                                                                         \n{26625863637042260}\n\nENTER DANGEROUS CAVES, MINE VALUABLE MINERALS, AND FIGHT OFF ALIEN CREATURES TO SURVIVE.\n\n**EXPLORE MASSIVE CAVES.**\n{1277545327906163}\n\nNAVIGATE VAST UNDERGROUND ENVIRONMENTS FILLED WITH RESOURCES, HIDDEN PATHS, AND CONSTANT DANGER.\n\n**CUSTOMIZE YOUR AVATAR**\n{1000141166048660}\nCUSTOMIZE YOUR MINER WITH UNIQUE DNA BUILDS. PLACE THE ACCESSORIES WHEREVER YOU WANT!\n\n**FIGHT BOSSES.** \n{1992847338010690}\nCLAIM TREASURE. TAKE DOWN POWERFUL BOSSES DEEP UNDERGROUND AND CLAIM RARE REWARDS.\n\n**TECH TREE.**\n{1342354037946372}\nUPGRADE YOUR GEAR AND ABILITIES TO BECOME STRONGER WITH EVERY RUN.\n\n**PLAY TOGETHER.**\n{1761786788533442}\nTEAM UP WITH UP TO 11 PLAYERS AND SURVIVE THE MINES.\n\n**WELCOME TO THE MINES.**\n{1363649142273658}\nENTER A PORTAL, GO DEEPER, AND SURVIVE THE RUN.\n\n**UPDATES EVERY WEDNESDAY.**\n\nJOIN THE DISCORD \ud83d\udc49 https://discord.com/invite/pickaboom\n\n**WELCOME, MINER. CONGRATULATIONS ON JOINING PICKABOOM!** IF YOU\u2019RE A HARD WORKER, A GOOD SHOT AND A RELIABLE TEAM PLAYER, YOU SHOULD HAVE RESPECTABLE ODDS OF SURVIVAL.\n\n\n", "short_description": "\ud83d\udc7b SPOOKY ADVENTURES\n\u26a0\ufe0f DANGEROUS BOSS FIGHTS\n\u26cf\ufe0f MINE AND LOOT \n\ud83d\udd2b NEW PVP ARENA\n\ud83d\udca8 RACE MODE\n\nSMASH DOWNLOAD NOW. PICKABOOM IT'S FREE VR GAME!\n\nJOIN THE DISCORD \ud83d\udc49 [https://discord.com/invite/pickaboom](https://discord.com/invite/pickaboom)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pigiamakasama.com/pickaboom-vr/dedicated-policy-privacy", "developer_terms_of_service_url": "https://www.pigiamakasama.com/pickaboom-vr/dedicated-policy-privacy", "publisher_name": "PIGIAMA KASAMA", "support_website_url": null, "website_url": "https://www.pigiamakasama.com/pickaboom-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
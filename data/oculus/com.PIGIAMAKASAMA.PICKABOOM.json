d5ME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe4-IDlixULeuN5Uh5QAzbQ4W7rkDNsl2h8kATUcSA-Q&oe=6AC3D71D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "End Trailer.png", "id": "1645374636513462", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_1645374643180128_6414114088449502866_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYe0pwvNkEkQ7kNvwEO3gCP&_nc_oc=AdrWLaDtfuOmN7cC0nEPJiL7B76ErV0E50IYmusFwht1bHEiuKo3xdVvEXHzy2BGioU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMctdy0Zdl3i5IhqZ7T6IEEjh2IKk9IWkUnDWe4m-DMeQ&oe=6AC3D8CA"}, "display_name": "PICKABOOM", "keywords": ["survival", "horror", "free", "shooting", "mining"], "long_description": "\ud83d\udc7b **SPOOKY ADVENTURES** \u26a0\ufe0f **DANGEROUS BOSS FIGHTS** \ud83d\udd2b ** \u26cf\ufe0f **MINE AND LOOT ADVENTURES** NEW PVP ARENA** \ud83d\udca8 **RACE MODE** \n                                                                                                                                                                         \n{26625863637042260}\n\nENTER DANGEROUS CAVES, MINE VALUABLE MINERALS, AND FIGHT OFF ALIEN CREATURES TO SURVIVE.\n\n**EXPLORE MASSIVE CAVES.**\n{1277545327906163}\n\nNAVIGATE VAST UNDERGROUND ENVIRONMENTS FILLED WITH RESOURCES, HIDDEN PATHS, AND CONSTANT DANGER.\n\n**CUSTOMIZE YOUR AVATAR**\n{1000141166048660}\nCUSTOMIZE YOUR MINER WITH UNIQUE DNA BUILDS. PLACE THE ACCESSORIES WHEREVER YOU WANT!\n\n**FIGHT BOSSES.** \n{1992847338010690}\nCLAIM TREASURE. TAKE DOWN POWERFUL BOSSES DEEP UNDERGROUND AND CLAIM RARE REWARDS.\n\n**TECH TREE.**\n{1342354037946372}\nUPGRADE YOUR GEAR AND ABILITIES TO BECOME STRONGER WITH EVERY RUN.\n\n**PLAY TOGETHER.**\n{1761786788533442}\nTEAM UP WITH UP TO 11 PLAYERS AND SURVIVE THE MINES.\n\n**WELCOME TO THE MINES.**\n{1363649142273658}\nENTER A PORTAL, GO DEEPER, AND SURVIVE THE RUN.\n\n**UPDATES EVERY WEDNESDAY.**\n\nJOIN THE DISCORD \ud83d\udc49 https://discord.com/invite/pickaboom\n\n**WELCOME, MINER. CONGRATULATIONS ON JOINING PICKABOOM!** IF YOU\u2019RE A HARD WORKER, A GOOD SHOT AND A RELIABLE TEAM PLAYER, YOU SHOULD HAVE RESPECTABLE ODDS OF SURVIVAL.\n\n\n", "short_description": "\ud83d\udc7b SPOOKY ADVENTURES\n\u26a0\ufe0f DANGEROUS BOSS FIGHTS\n\u26cf\ufe0f MINE AND LOOT \n\ud83d\udd2b NEW PVP ARENA\n\ud83d\udca8 RACE MODE\n\nSMASH DOWNLOAD NOW. PICKABOOM IT'S FREE VR GAME!\n\nJOIN THE DISCORD \ud83d\udc49 [https://discord.com/invite/pickaboom](https://discord.com/invite/pickaboom)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pigiamakasama.com/pickaboom-vr/dedicated-policy-privacy", "developer_terms_of_service_url": "https://www.pigiamakasama.com/pickaboom-vr/dedicated-policy-privacy", "publisher_name": "PIGIAMA KASAMA", "support_website_url": null, "website_url": "https://www.pigiamakasama.com/pickaboom-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28400500216265686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314641_1410381420982373_7806221056693147855_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrU0NKfNRUwQ7kNvwHuS1AW&_nc_oc=AdpcdMkVkfTdAdYwLqlBmYEd2DJ_WqZbo
70_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFC97qm7-rsQ7kNvwHTxx4x&_nc_oc=Ado4jppU9c8W-K2KkhZf9GEZiXQIDzeJyBOnrFPWENFGJ0ekdmiXpcOBLA30snvY7N0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAP-vIKhPBINKMo1fXf4dDYw-DvRQ5Uza9L3XUp3gicQ&oe=6A89976C"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ympaK0Wa330Q7kNvwHVB2dZ&_nc_oc=AdoOa4Rw8BOHnaAMAy15-Lt1nIQG87AHygSN_Q8hFDNqkhUxLIs2PyggS-M-ObzoJKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLcLCvWISupEjqMjYP4Wl-YlZRGfm4IFeI8XWXRFSNZg&oe=6A899FC6"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxkgArxjVvgQ7kNvwEibD_o&_nc_oc=AdrytVekfpSceFxqwqLUtoSwvyr2ej3GrIWQLG2PpaBffKEjtUyZSx6hx8O5-WJFfcg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFUY8wJwR73fvfjm2liNB6SeHgftdYm4EkjeNCjui6tw&oe=6A8998C8"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vootX8L85_gQ7kNvwEZmN_K&_nc_oc=AdrCosrSnbjLT2NLwY9l9vBsrI8ePhCia-pILw4G8t0wnW9_vbUgNeHypD01tWbIB54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdomZUfCu0FDuE3W1CXNDV0XPXjOJHLVEb8L1vYBiYEw&oe=6A899A01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWLuznDqbDcQ7kNvwGFvyI5&_nc_oc=AdoScaHm264pp267hTiYDc1v688wuZpf2UMt0G-n8e0A5l8kl7h-Z6bXsKDJgcAtpIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWjdwzFv4M84p6K2Nz6mE_Vh8i0gfKzxgIG0IYKSsVCA&oe=6A8996EF"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_servi
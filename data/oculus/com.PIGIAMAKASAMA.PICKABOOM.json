70_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qEUBfbEvW8Q7kNvwHA4UTx&_nc_oc=Adrwjtt3ezv0NJnTR8eCARR9UzYQgnzb4CVl9hX0QRHjl8xlgrOBz4xbv_tzJBwyaUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbslRnp4jp9z_hZeGXMm7vjy7HJ4aPxbLmjPsV0vUl7w&oe=6A95E56C"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YWnrOAz-pAQ7kNvwGIFoKc&_nc_oc=AdoPXeoAgymhXw7IH7aqVd8PEl8JeC7YHls4nQ-KFPtqWaxkpGsT2b-uZv_IFsERsrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNRBUEaFGYBzNu_ZX7CtLdXtocXdpZRITwHszzXReO3g&oe=6A95B586"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgoXVVXx-CAQ7kNvwFeGD91&_nc_oc=AdoMrfGrS6yLlYALrTDSyxF_y3ttbenOhOkz2sZHAW6eDU8cUMBLDsFYIkxN0RtFVR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6VOfKgM_JboAeJ_QLH1b9IjJf2FcVoz39a4Yb9QCP1g&oe=6A95AE88"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKCXcvSOrQMQ7kNvwHOaQRJ&_nc_oc=AdoAWAcADv5ehpHdQn5GlFeEO0h3eQPhEpt4qJZhXvD-fh2Z9v9f_alsJwxiaOYlJs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMaEwDVI5vCmLag5HHXC4V5LPQFonfy86NTVToexj4kA&oe=6A95AFC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx2w8Ml7pqkQ7kNvwEv-N49&_nc_oc=AdrjA_G1vN2BgXbbdEgCQytd830XasGHdOs9krRYyQp2XUFuw060ffgqWdFCVmFaZOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-mkCB6-ewgPheQjsBrwDZwxTd4xGOdQOtiFL8dOc4vQ&oe=6A95E4EF"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_servi
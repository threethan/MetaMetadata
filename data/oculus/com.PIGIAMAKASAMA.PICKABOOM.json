0_1491182682100098_4328055637240389670_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAgTi3auVD0Q7kNvwHyztQs&_nc_oc=AdpURHHy7hTbwfFhxwCSgYct38JDYRvsWhacqtHgmUIiqUXTeuwKdNc42CKIdQ5CtYE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHleJ7NwhXrg50HjWVK5IraQdriLLuerXLDZ2avK7GAwA&oe=6A7DB9EC"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sh7hmZebl8Q7kNvwH4nn4I&_nc_oc=AdqJ8xoE0VY9m8j8u456F8Z3uGoV95K1u0GwHB3Ehf80B9F8KxLD9fvobQRDf1sPQw8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTOU8FLKDTPEfWwo_OVI_Hv-KcDoacuMB5F91vHy2oiQ&oe=6A7DC246"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viktWLFozucQ7kNvwH_UOe_&_nc_oc=AdpfUp5iFJHxvZ3r_Rp04IFionlQ9bWr0r7__06CSTnIhiN-l1awRZ6j75sdkgIav_w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFdRsbSeq5phN-HbTcjX4e08tFfbDhyapYA3vTMbAJzA&oe=6A7DBB48"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHBPSahT2ysQ7kNvwHeSg-5&_nc_oc=AdpkNZcq6YnfA16iCAkz_2DMxobWtYGm_E-onfA3dd_lqk8nzE6JF1DeEBQTxpwnk9w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU8GUHKViCOGn4iLJO5ueVJA4JX7v9uQkVAXhXI1qvXw&oe=6A7DBC81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrcW53wQXsQQ7kNvwHtWnAk&_nc_oc=AdpHP-oyXQdtU-PzU68_odFKbZtxsrfZLwNMcyJG3sgMNxVDV1SKfTpAC39mtn8wHsE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5VOAGIWbvqc3pdiLXURpbPsZKTjsZ1dLbxZe_UL4D2Q&oe=6A7DB96F"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/
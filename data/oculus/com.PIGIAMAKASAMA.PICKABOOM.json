70_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1DxiB7KkvYQ7kNvwHr01M9&_nc_oc=AdoMkFAHzXrDch0tjrBL8fbt_e5Do7xrDIla9h2LA9lCMODfU5R2tGkShNzbchx8vyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ-_iNe0CF0bSO2dcsHttKaeINm6L0RkgYv_bDbYqFHQ&oe=6A635BEC"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNqJYXCyfeYQ7kNvwFGMr8t&_nc_oc=Adppj1UBAp48eiaYW8VvIv_svlIj_C_zR4msqlJt7IlYl-8fpPjQBJBV8vUhsIJeF84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8hUYPcNzAY_JJ3Ejj_GpYDjVJ3tUUZlU_amwLxTRN5w&oe=6A636446"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K6VHlWqmhEQ7kNvwE3_hRu&_nc_oc=AdpUZ8JKVO4YqYCUMp59f2BK8QuxEZ7LFvVjJKH6eHw8kM614FyrgCtkr7-ZzgXqG8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYMjZkoGsU9K_Z5fl3iSC-9ikt-UA7XNfPqaSzWQ1wag&oe=6A635D48"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-EXMqIBq-MQ7kNvwEkSOGj&_nc_oc=AdquynTY52CiSCOwdEe7OFXFg_XdWDVrdAUmiInjsj0E-rHdjSJSV585Co_iMHSjje8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeQhXu3BKm4p_3wNib3f0AW_A_0v64TgsF20ZimukpHA&oe=6A635E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXNRFUDOI5AQ7kNvwF6LOkB&_nc_oc=Adr5STuNdDq5tzmpk0UoVQ_Cq7elKCh9WminayCwkSBd9ecbSahvc18Ine2EG3nnWLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlg8qv2F5UVJSvWLaX8vhWobIMAdxI6x5itbMa6waU7g&oe=6A635B6F"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_servi
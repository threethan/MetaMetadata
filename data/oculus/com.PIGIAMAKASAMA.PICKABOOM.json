/v/t64.5771-25/499618885_868639479558072_2272643366466742551_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IF_BE1MZcDgQ7kNvwEG7aXt&_nc_oc=AdlDJvR88XnSvF57B0QFuYBRmKovHSisiyLrxcLQ6kFQh1cMYjubX1jMRmyuYg8G3Lo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft7AKMspqZ-0JTouz6pjxcpX8lF1alzB0AEpqQG0yyKEw&oe=69A5842A"}, "display_name": "PICKABOOM", "keywords": ["survival", "horror", "free", "chaos", "multiplayer"], "long_description": "# \ud83d\udd25 PICKABOOM \u2014 FREE 11 PLAYER VR CHAOS \ud83d\udd25\nDrop onto a hostile planet with up to 11 friends. Physically mine glowing crystals. Escape monsters in collapsing caves. The deeper you go\u2026 the darker it gets.\n\n\ud83c\udfae 100% Free | \ud83d\udc65 11 Player Online Co-Op | \ud83e\udd8d Gorilla-Style VR Movement | \ud83c\udd95 Weekly Updates\n\n{752224041199216}\n\n# WHY IT HITS DIFFERENT IN VR\n\n**\u26cf\ufe0f Real Physical Mining**\n\nSmash crystals with your own arms. Grab loot. Run when the lights flicker out.\n\n**\ud83d\udc7e Relentless Cave Creatures**\n\nBig. Loud. Close. If your flashlight dies, you\u2019re not alone.\n\n**\ud83c\udf0d Massive Open World Caves**\n\nNo path. No safety. Go deeper. Survive longer.\n\n**\ud83d\udc14\ud83d\udca3 Craft Wild Gadgets**\n\nLoot resources \u2192 Upgrade weapons \u2192 Go deeper.\nFrom utility tools to the legendary Chicken Bomb.\n\n{1839225910314692}\n\n# \ud83d\ude0e START FREE. LOOK ICONIC.\n\n\u2022 4 FREE starter avatars\n\n\u2022 Deep DNA customization\n\n\u2022 Limited weekly Skins drops\n\n{25347199751624948}\n\n# \ud83d\udcf8 BUILT FOR CONTENT\n\n\u2022 Pull out your in-game camera anytime.\n\n\u2022 Capture chaos. Post clips. Go viral.\n\n\u2022 PICKABOOM is built for TikTok and YouTube moments.\n\n{785846607897954}\n\n# \ud83c\udf0d COMMUNITY + LIVE EVENTS\n\n\u2022 Join one of the most active social VR Discord communities.\n\n\u2022 Contests. Dev events. Creator programs. Weekly drops.\n\n\n# \u2705 Built in Unity. Featured by Unity.\n# \ud83d\udc49 Download PICKABOOM for FREE and survive the chaos.", "short_description": "\ud83d\udd25 PICKABOOM \u2014 FREE 11 PLAYER VR CHAOS \ud83d\udd25\nDrop onto a hostile planet with up to 11 friends. Physically mine glowing crystals. Escape monsters in collapsing caves. The deeper you go\u2026 the darker it gets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_service_url": null, "publisher_name": "PIGIAMA KASAMA", "support_website_url": null, "website_url": "https://www.pickaboomvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25841640602151673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_838393808882967_4283689197081328698_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN-752fXE64Q7kNvwEPvj55&_nc_oc=AdmbUjl31sA4_Y3H1y8ECOe84PGqCmYZSBcCV9P-Y8a5R4RAgLrlbIspeXBMvgxjpQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvEEkeRmBmQqXcCp4167TYMfikvPwr6z67YMw5q7PlfKw&oe=69A56CAE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PICKABOOM", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
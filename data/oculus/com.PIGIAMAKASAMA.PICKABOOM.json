70_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN4j6oVBNxgQ7kNvwHz7UPr&_nc_oc=AdqrSNScnxL_pxRI6rCJbcyDUz9jlQ5ZRLzxdaDuAaQlwNBnk7neorAoqZdeCavbC7U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw7WQj-bsgrahpuRc3Hf1mFPjQp9poC9n0eTa1GKuTtg&oe=6A91806C"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPyuNK9h6-wQ7kNvwEQhSQx&_nc_oc=Adoi50N24BI2KA7_iwePZBELcE6L0IUTiRybkSdyuFso096hzCjGRAAULX-v_L2yNmk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkq8ILy_PGPZAm19jQ3QRRGAKP0a4QE-iZnSEOgf8Aqw&oe=6A9188C6"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z99VRUN500Q7kNvwFS5nrN&_nc_oc=AdrBLLrogEGNKP9ZUd3zu6DvuPt57598OFdLxwrNbHZBBMSMOBCNEhe_6tAn8vJKxP0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkdxonZiKKaFEpoOnNbf3SSoXoW4DV0ni6HcLbzuCRvA&oe=6A9181C8"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJyodHXhsRIQ7kNvwF02aXK&_nc_oc=AdoeCYseMADHmm96dCEPv2u75gCDdfZ6DXem-bE_InhKvp5ZoF6gEHQJ8bNusEtc8hs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnmY0VhFSd0u6xLEENYKeem1ucDvyQHkLWQJVz_6-STA&oe=6A918301"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bELrKXQC94EQ7kNvwGVP7ij&_nc_oc=AdrgZyYM1QmgwIxy5HhM2qM6WLeyfD7gYrmsSFozMwCB9sY12TxBllPXF0foe4x0rB8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHafoahdWJt4FAQl9vVG7Apk5CbU_GEFyzAxEDYEKIBBA&oe=6A917FEF"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_servi
CbH0Y4A&oe=69A826EC"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVHnnJqcg9cQ7kNvwEf3e2T&_nc_oc=AdlICIwNPwMwAqEOaB47I_YEFCw0o95dRVFHRpYz0E7lblhkUgQ_1JFdyjpeDft2m88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvWkcU-Z7F-byJ3bnYk3NGImeWJtW8C5Ak93ebfq0fqdA&oe=69A82F46"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_FZa1hyDXwQ7kNvwHPxz8l&_nc_oc=AdmS2d54NzsoicmQrhWCbYgIUIroQ_IGQghzvllovWVldI3Cm8yLuLsEpXQijBa2tB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKSHGjQnExG7mdIp2mfgSbaTBpLw3XmOjTMs0Dw-9j1A&oe=69A82848"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYWCyib5LhAQ7kNvwGxkTEo&_nc_oc=AdlHpD7j6fGLcNJh_8EdLdrJwV8axdxIuWueuVfhwcb4DJlSAAZA4W3sXoo7Ue1qXjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFF926oBFee-PBFTYokZOTo0J8INgOLw2P7vCQVMDCcg&oe=69A82981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRownF7j9DUQ7kNvwGSOsYM&_nc_oc=Adm4sCvQ8G7K2xj3NPk1h3kP-XRrGnVuwW99uDnetc54fZYpKGPisUKBLQjTP7fRhuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvpPrcNhEn8A24KH9bQgZrrJCP6XGJehJjwH0FWc_MbZQ&oe=69A8266F"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_service_url": null, "publisher_name": "Unity 6.2.1f1 + MQDH", "support_website_url": null, "website_url": "https://www.pickaboomvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_ca
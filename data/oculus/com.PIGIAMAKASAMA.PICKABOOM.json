70_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_VZqxvoqp0Q7kNvwHO0Xms&_nc_oc=AdrPut6gbVt9lWleXLTzZc4HRx4ZE4Wap7_Us1AtHQmBJA74JUMJ_yaijTuF5RKcORw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt2soCi8RG6LDjUyRwxRwfUt9Ugjsxio98x5ciMfEDsw&oe=6A4F956C"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__ILgXpyCnsQ7kNvwE-gkHW&_nc_oc=AdpSpC7qv1EtTPku___HC1C8qLRQboWDROQpB4yg1C-2FK0VMnvOSi249mcBn37Thaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD75wK0Q5-c7cbpikBGWXvfXeoDIyXeI2B_6iEEI8OHGw&oe=6A4F9DC6"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wzALT0vLbsQ7kNvwHE-hTp&_nc_oc=AdocYYRArzUzWx1sLl7vmDhOIdrnWDTkYaMws074_nnEbwukZc64DmB1kwV27FqZ1Jo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCFNIgRICj-Dt02jDamDfCnqs9lsxbMfOJRHxR0mq3Mw&oe=6A4F96C8"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P02UwAyiNgQ7kNvwFI3u-0&_nc_oc=AdpGhjWNpBgFwZmCaGc21L7DIb-0t0V_1FErvuDTjJhnRd4deVrDQ5AcSvqmyaIDuw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLDssu2z0G-SQGrZj9zEEBiFZfdR6a_FGTGMO63S4CMA&oe=6A4F9801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeSZIAThaJMQ7kNvwE3UuNe&_nc_oc=AdoHZVYmNZeuy_zsl50nhYQA0YIcM2eMKAYs6qziRVaP8NSN2MLGHb-NW23Ajo0oM20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm6UneBhQQ-QtYEf4qeuSYtpYHQ2JMTwl50BI76-Q21Q&oe=6A4F94EF"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_servi
0_1491182682100098_4328055637240389670_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esSfXtd_4EgQ7kNvwGjRn9s&_nc_oc=Adr1sJiz1mkyK0l47tVGiTZ8yN6bzW9-34xkb7oJvo5XITcBDQexserGOJ5FK5DcXPw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7oTSmddsMJvqRYCo-1CUeFqYL0XsMppRGpD8krQVCUg&oe=6AAE816C"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfj5aILMnHcQ7kNvwFEEzuv&_nc_oc=AdqEmE_Yv1xqLjk-BKa3XdRF1rtTLDZDXer0ThnBwMuX9y0hqlwG03UI1L6yhOLvhRI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvY_yw3H9SBu-wFya8fK_bXypre_a6yakBDmiM9LEOeg&oe=6AAE89C6"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axX7gUFJ9mUQ7kNvwG9rgEE&_nc_oc=AdrswfygdnJQhpD-3pnCPUghs04wvNKT7OJTnGtVuYauX8YxEDjL2af1DnFfBW-ES80&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-XwcSxFtzEb1jcEAbuNycm-k680kZiv4FX8-fPgGURw&oe=6AAE82C8"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn4On4JzwXoQ7kNvwHNLuax&_nc_oc=Ado50OmbBGpmk-PCUURI6SvYzmxko3lxnxliryNBnnL6Ic69l2eFXdmibWMuHx7DGrw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaRWZHUB5uVF42EKOs-1xdvfGiftt11WxNJrfIaUxOlA&oe=6AAE8401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IpqweGYtw8Q7kNvwEs9eLe&_nc_oc=AdpbuesDIe0xC4PBw2QIZq3sQzZZ1vQ_eF-4xHOBWxNGkjRxgIPCojNWWtLeOBM81Cc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA3C_lfk20Z2n4-ZLl8tz7pxw5imFAW_R1o9kyE8dauQ&oe=6AAE80EF"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/
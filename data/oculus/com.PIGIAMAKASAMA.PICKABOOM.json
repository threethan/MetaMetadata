70_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=en5q9ERCyTQQ7kNvwGdL7RB&_nc_oc=AdprzInGu4hJiZrZV5f6aZDsdZlWnoNhUB-ARQbEdIIQO7X4VXxap71SdHxmK1pKK3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKEAyn6xIDmrunV8DJnG665e-hkAh26rMmqPaG8Ygnkg&oe=6A5389EC"}, {"file_name": "PICKABOOM Screenshot 7.png", "id": "1871460380468166", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617775_1871460383801499_4177718352564188009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBCgsgXTWpsQ7kNvwF9Bb_3&_nc_oc=Adqju0UiLkDmct37kH9sQxhwZSofbxowe-6Vg6I2ULsJCQ_7T6Up96To2xBdHujLH2g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-Xxz8BBLWmLU4Fl8Yi4-F74cvY8do1fEuHqS0pnNpEw&oe=6A539246"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuNaBlTzfNAQ7kNvwEUEXYB&_nc_oc=AdpFCOHE9R3f8Yiojc7LCM4GhFNAYl4BkRvMrEFmwJkups0H6cNe6Tbyce2PUKV3aVo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj1UISO4JOp9shsMcxkbKzpncaMmxKts2_uJU1EmxRXw&oe=6A538B48"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLOWU0_grccQ7kNvwGD_CBH&_nc_oc=AdoVOefFx4O68wU9W51oozyyOsO_lNzLM-OjNLkZgtQ0kYHwgjCPxdVqEx3F8tiM0OE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPtagxHV0nKwf2ChK84NOxhvCkQrOKcgDvojRlVoOQAw&oe=6A538C81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmh4Hj69VZUQ7kNvwF75Zen&_nc_oc=AdpNsHCkJya-s09dwAIthRXu_-o258_23MITC3C8PwCvNAJ0wOWCBQW-AuvU1isAjK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUsxwRDX55n8e9KL0vQWlkRxcPfKMVDW5AVpLibTq4Kg&oe=6A53896F"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_servi
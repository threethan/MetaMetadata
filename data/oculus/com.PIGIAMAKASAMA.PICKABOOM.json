8009_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsPh1utpdDYQ7kNvwFLXKvp&_nc_oc=AdpR0weew7rNUlJ5KKe4GVTZZMqS6COfojjqV0Few1FXXq7j740Cd1nvObQioyQ60GM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h5CWmQfRTm4ha_2V14ZsC6kWQPakfixZiwq87f1KMHg&oe=6A33EE46"}, {"file_name": "PICKABOOM Screenshot 8.png", "id": "1202494335071082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618442_1202494338404415_1314104998578942016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSnNHbF86dMQ7kNvwGt10KN&_nc_oc=Adq1-UreV01d1euQq_Jv3Pc8VfwkANH0ETHarL-agEOlroeIetDdIoSFT2Q-8KlQxEk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VRTVuUMvUTgj3bYaicsEpiX8EQcBeMam_ql3R2TKUMg&oe=6A341F88"}, {"file_name": "PICKABOOM Screenshot 9.png", "id": "1534195114587820", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617729_1534195117921153_8691084946846864449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8mw-6rB5EgQ7kNvwGeo8bU&_nc_oc=Ado_2IRzi3H7c7ZaaPczpql6M9Zf0B6yuGxhvEb2rch_BCyps1caEM4smL387ldCUPQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7TPs95FENoCUeqghfEwdnq8OZIExtbdIho2mtaIx--g&oe=6A33E881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 1 2560x1440 1.png", "id": "684914040932095", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618910_684914044265428_2959950593095626719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2-mVE9iJb0Q7kNvwFNT1iZ&_nc_oc=AdqH5UdAr_lYIylAx2_EB_sMLCej_uX8yhqUTba72DSM-5jQ054V1IoCV0XK-FYGmYg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88icEgAbYia_IMGrSSODZYddfTX69Qt94qQ4Sfe0iS-Q&oe=6A341DAF"}, "display_name": "PICKABOOM", "keywords": ["survival", "naturaldisasters", "funny", "horror", "adventure"], "long_description": "# **PICKABOOM**\n\n# Survive Natural Disasters. Free-to-Play. Weekly Updates. \n\nEnter the explosive world of PICKABOOM, a **multiplayer VR survival game** where every match feels like the end of the world. Team up with your squad to survive floods, quakes, and freak storms before the next cataclysm hits.\n{24914414018221905}\n{1393192055699014}\n\nVisit the **Avatar Shop**, led by VR fashion designer George Hermano, and mix survival gear with outrageous couture. Limited-time \u201cdisaster collections\u201d drop weekly so you can look iconic while the planet collapses around you.\n{698296172970507}\n{775418032145060}\n\nFace terrifyingly **unique monsters** that evolve with every environment, from crawling cave dwellers to colossal storm wraiths. No two encounters are the same.\n{1839225910314692}\n{799801039502319}\n\nWith **weekly updates**, new maps, disasters, and gear drop constantly, keeping the chaos alive. Jump into public or private lobbies, push your friends into danger, or save them just in time.\n{1287406879811240}\n\nJoin our Discord community to test new disasters, play with devs, and help shape PICKABOOM\u2019s future!\n\ud83d\udc49 https://linktr.ee/pickaboomvr\n\n**EQUIP. ADVENTURE. BOOM! PLAY PICKABOOM!** \ud83d\udca5", "short_description": "Survive Natural Disasters in VR! Free-to-Play. Weekly Updates. \n\nTeam up with your squad to survive floods, quakes, and spooky monsters before the next cataclysm hits.\n\nUse your 3D printer to craft new weapons: your own tools decide if you survive\u2026 or not!\n\nNew disasters, maps, and gear drop every week."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickaboomvr.com/policy-privacy", "developer_terms_of_service_url": null, "publisher_name": "Unity 6.2.1f1 + MQDH", "support_website_url": null, "website_url": "https://www.pickaboomvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
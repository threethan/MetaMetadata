PSCsE1H4qInsg8hKm8AbFa2KDXt8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZo_9cyWtG_RTNARtXe6gK50EEQGqPXcUNVrL6NmiyOw&oe=6A92DABC"}, {"file_name": "Scan.png", "id": "308872574992257", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223475_308872578325590_6636054780775919658_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsjRQ9mlzIwQ7kNvwGjFKDw&_nc_oc=AdosI-eHQAD2i5s_L4UHMrOPmeiYc7G4Ky9rmL8mf1udq9rKIOV-923pefDZt7PLsgw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKBbZKg2aULA96GIMPCjZKOnv19rcFsEziG4O_wrH9eA&oe=6A92CCCE"}, {"file_name": "AR.png", "id": "1120942435738297", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422394_1120942439071630_4444957082847083691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwGr8EA1NyAQ7kNvwFhT5N9&_nc_oc=AdoSpJFPh3BvgbcV2pk-4SU7BqCbfGQ858F4hPrij8inaIFYGwHtZpYM8hcb8N0G2SQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIlki2ieNYaUY5op-FA9E56ID5JyaPZF9cJx7dz-LY_g&oe=6A92B450"}, {"file_name": "Outro.png", "id": "833532391864456", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982727_833532395197789_2455978168416510090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nmpYxSoejoQ7kNvwG04y9N&_nc_oc=AdoyjrKawgvm5xUc_uHMeVIkk2gkJSqzskPo9-h7QvOq1deikpSnQG0EkfoI5l78s5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGURdA5jXA2bk2W0xgiX7BYPEb-M2OQDSCzFcT79HCWcQ&oe=6A92C2A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1350689075540903", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031363_1350689078874236_3671146087760275177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do7UD6OjxukQ7kNvwFWwWK5&_nc_oc=Adp5fUFh1ZN6t2sYDz-7sOtiI8x9pj5FBmRt0FZQ3O9gPXAE2QgowIoKlaydYWhbnpk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf9tFZsV-TleKZkURuXSJ6f8OdjunFJ3Jl_Ewm-bTL7g&oe=6A92C915"}, "display_name": "MIKA VR Campus", "keywords": [], "long_description": "**MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung**\n\nDie berufsbegleitende und bundesweit angebotene Weiterbildung MIKA steht f\u00fcr Medien- und IT-Kompetenz f\u00fcr Ausbildungspersonal und wird vom Bundesministerium f\u00fcr Bildung und Forschung gef\u00f6rdert. Tauchen Sie mit MIKA-VR ein in 360\u00b0-Videos, interaktive 3D-Umgebungen, Augmented Reality und 3D-Scans. \n\nMIKA-VR bietet eine interaktive und effektive M\u00f6glichkeit, Ausbildungspersonal in die Welt immersiver Medien einzuf\u00fchren.\n\nErleben Sie praxisnahe Anwendungsbeispiele aus verschiedenen Branchen oder Berufsfeldern und entdecken Sie neue virtuelle M\u00f6glichkeiten f\u00fcr Ihre Ausbildung!\n\nWeitere Informationen unter:\n- **Bundesinstitut f\u00fcr Berufsbildung (BIBB):** https://www.bibb.de/ \n- **Leando:** https://leando.de/\n- **MIKACAMPUS\u00ae:** https://training.leando.de/goto_mika_cat_23116.html\n\nKontakt: MIKA@bibb.de\n\n", "short_description": "MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung "}]}, "developer_name": null, "developer_privacy_policy_url": "https://worldofvr.de/datenschutz-mika-vr-campus/", "developer_terms_of_service_url": null, "publisher_name": "World of VR GmbH", "support_website_url": null, "website_url": "https://www.worldofvr.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7592534554196940"}, "rev
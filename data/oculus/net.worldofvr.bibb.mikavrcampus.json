z98LqJ6AnilHesSArWA0FWJ0yFjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85_tPa0qNH9Gz3moXs4cPyuDQZfRLakE43X9U7muNVRA&oe=6A3E7ABC"}, {"file_name": "Scan.png", "id": "308872574992257", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223475_308872578325590_6636054780775919658_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOR_CX-bq0MQ7kNvwFPJOCh&_nc_oc=AdqbspTWVeGmy2mjq_FF4ez6tt1Zcp7EuycIVFUg4BV4d48P87b09ob9dG-iLJxzDzg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aclxwKMHz9Rj01fqRk5-hdXM6M9IOEewatCZk02WNWg&oe=6A3EA50E"}, {"file_name": "AR.png", "id": "1120942435738297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422394_1120942439071630_4444957082847083691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxNnD4s8XgkQ7kNvwHu69tb&_nc_oc=AdrTvgCH8Ar8fcR3LdgEcS7Mr_UDxSnNNV6gx10SqeYOOqlE6kL0TaAbgcTRw7iHxAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-otzmTBhrBgTF3P5BreFOvpY8rZhIUTOCsUJDS_-rCUw&oe=6A3E8C90"}, {"file_name": "Outro.png", "id": "833532391864456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_833532395197789_2455978168416510090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j1hM0vhFBMQ7kNvwE3FrrE&_nc_oc=Ado0BVkfxYastDY9Hp3A72rz4L-p1JbgVW39hNjzn382n01IP5HKYzv0yiXk12JDK_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X4Q-fJfX6pUp2mpz7U35JD3hbMQUDFv1-6KSYlq77og&oe=6A3E9AE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1350689075540903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031363_1350689078874236_3671146087760275177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm-f7c5QsBUQ7kNvwHC2LQH&_nc_oc=AdoTFtg9akMVeXLucgWAYffKerZokYg5PyjHc22lTcgsyHiJua_vFmm2Jl9LHowRe0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cV4zJbiWS5etrh5hZwL2uSDq9CAU0nb00Pv3_9YVaWQ&oe=6A3EA155"}, "display_name": "MIKA VR Campus", "keywords": [], "long_description": "**MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung**\n\nDie berufsbegleitende und bundesweit angebotene Weiterbildung MIKA steht f\u00fcr Medien- und IT-Kompetenz f\u00fcr Ausbildungspersonal und wird vom Bundesministerium f\u00fcr Bildung und Forschung gef\u00f6rdert. Tauchen Sie mit MIKA-VR ein in 360\u00b0-Videos, interaktive 3D-Umgebungen, Augmented Reality und 3D-Scans. \n\nMIKA-VR bietet eine interaktive und effektive M\u00f6glichkeit, Ausbildungspersonal in die Welt immersiver Medien einzuf\u00fchren.\n\nErleben Sie praxisnahe Anwendungsbeispiele aus verschiedenen Branchen oder Berufsfeldern und entdecken Sie neue virtuelle M\u00f6glichkeiten f\u00fcr Ihre Ausbildung!\n\nWeitere Informationen unter:\n- **Bundesinstitut f\u00fcr Berufsbildung (BIBB):** https://www.bibb.de/ \n- **Leando:** https://leando.de/\n- **MIKACAMPUS\u00ae:** https://training.leando.de/goto_mika_cat_23116.html\n\nKontakt: MIKA@bibb.de\n\n", "short_description": "MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung "}]}, "developer_name": null, "developer_privacy_policy_url": "https://worldofvr.de/datenschutz-mika-vr-campus/", "developer_terms_of_service_url": null, "publisher_name": "World of VR GmbH", "support_website_url": null, "website_url": "https://www.worldofvr.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7592534554196940"}, "rev
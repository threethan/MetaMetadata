5F4s1M5DZ4MXhQlybeKVvZE_KllY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tJiqMA5OkEoQWmaz3-2QbPyPkZpdcrBP_cBfwxPUD_A&oe=69D7A5BC"}, {"file_name": "Scan.png", "id": "308872574992257", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75223475_308872578325590_6636054780775919658_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8yubK_PrsAQ7kNvwFfAqI9&_nc_oc=Adp-0FsfM784D8vsAxDdqGroJDlMvJ00_ah5M-Prx4GZ6vblMpqSh6OE4FxWS_o1YV4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tFysBqcQk3Apw6UVW7xupn_Rx0pYw6z-p1gc7is6VDw&oe=69D797CE"}, {"file_name": "AR.png", "id": "1120942435738297", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422394_1120942439071630_4444957082847083691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llSaQCh3CsAQ7kNvwFIs2Xe&_nc_oc=AdoMORV9lGQmXeSkVmdcvlvomtGCBv9-TSfLc8hOAyPvvkMMKUq8NLsow1mjx-vZ4PE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ebw1ysf3_XtBjt5D1S1lRAY6mTldxEUvkfytKaL89bQ&oe=69D7B790"}, {"file_name": "Outro.png", "id": "833532391864456", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982727_833532395197789_2455978168416510090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YiJu9lUFsgQ7kNvwHxMLiv&_nc_oc=AdrZ1181Kf6UEvd_VAfWtKRtq9SNbSfzWLaPOzVihnbqMHoVfzvOHPSqNrzMOpJrDQc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Jg4bFAXTRY6w2nxhn6wkq8jTYrhawIC5AEhBQEVSEfw&oe=69D78DA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1350689075540903", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031363_1350689078874236_3671146087760275177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6nkXdXbff8Q7kNvwEECuYR&_nc_oc=AdqTLDBRZ27HOFBeUFXezLhvFJ4rHBu1VHoV0JcOqxTHDDZtzz2CsZSfIO4fr73lqpI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af066G6fnuws0hh3fG7P3R_IWO7h5HTr_UA9IhM5TWC34g&oe=69D79415"}, "display_name": "MIKA VR Campus", "keywords": [], "long_description": "**MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung**\n\nDie berufsbegleitende und bundesweit angebotene Weiterbildung MIKA steht f\u00fcr Medien- und IT-Kompetenz f\u00fcr Ausbildungspersonal und wird vom Bundesministerium f\u00fcr Bildung und Forschung gef\u00f6rdert. Tauchen Sie mit MIKA-VR ein in 360\u00b0-Videos, interaktive 3D-Umgebungen, Augmented Reality und 3D-Scans. \n\nMIKA-VR bietet eine interaktive und effektive M\u00f6glichkeit, Ausbildungspersonal in die Welt immersiver Medien einzuf\u00fchren.\n\nErleben Sie praxisnahe Anwendungsbeispiele aus verschiedenen Branchen oder Berufsfeldern und entdecken Sie neue virtuelle M\u00f6glichkeiten f\u00fcr Ihre Ausbildung!\n\nWeitere Informationen unter:\n- **Bundesinstitut f\u00fcr Berufsbildung (BIBB):** https://www.bibb.de/ \n- **Leando:** https://leando.de/\n- **MIKACAMPUS\u00ae:** https://training.leando.de/goto_mika_cat_23116.html\n\nKontakt: MIKA@bibb.de\n\n", "short_description": "MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung "}]}, "developer_name": null, "developer_privacy_policy_url": "https://worldofvr.de/datenschutz-mika-vr-campus/", "developer_terms_of_service_url": null, "publisher_name": "World of VR GmbH", "support_website_url": null, "website_url": "https://www.worldofvr.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7592534554196940"}, "rev
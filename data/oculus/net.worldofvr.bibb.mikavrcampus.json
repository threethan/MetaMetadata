n_iVIzV9EaIMgYRNdgXRz4SPdpgs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AN0DmEDLcPmJGEzz1hUYMcEjG5iMgpUWPMXxp5mLXwA&oe=69DE3D3C"}, {"file_name": "Scan.png", "id": "308872574992257", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223475_308872578325590_6636054780775919658_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XmFZFNQTOIQ7kNvwHDnyxP&_nc_oc=Adp7s6r2DJJOVnVDv-L_axXqD89V6I6OmMAYKPrDqckC0V55knZWy2EHkw4HKzLTPMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y0rOOqQRCOVM8piQYCUgQy4hBXTpEbPuFnCj4erVcpQ&oe=69DE2F4E"}, {"file_name": "AR.png", "id": "1120942435738297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422394_1120942439071630_4444957082847083691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zxZrSQ-b3gQ7kNvwF6zTs2&_nc_oc=AdrXRNRpPSuXR1qh9Fk-SM6xuVBSaferBDvV_K-ff_2wv7mDr_9MdiwbUW7Ywty2kow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v72JqVtBxpzyOn3_OJuBQEA_MZW8KR5lvcZygt4ovfA&oe=69DE4F10"}, {"file_name": "Outro.png", "id": "833532391864456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982727_833532395197789_2455978168416510090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO7hbsypl3QQ7kNvwFK46Xe&_nc_oc=AdrkFh_M6zuqagpTZ_3XITJH_7OgZciQVWlm9kFBrnGkf1qyn_-b67458ma2jYot7k0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22UpBZD8VCg9tWfUI0toFdbolg87ZxiX1Uhm9uOW0McQ&oe=69DE2529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1350689075540903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031363_1350689078874236_3671146087760275177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9-eULsZ1osQ7kNvwHyD5ky&_nc_oc=AdrDBzJw9_AZs2CzGbbdR9nwBlpOA4teaaX6bdkjDu8D_pyDIGm5-bunTeZGmLfKIDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aYC_w6xEYYaP4-mGSvJIDyofqv4G1Ge9IKkkDY44bww&oe=69DE2B95"}, "display_name": "MIKA VR Campus", "keywords": [], "long_description": "**MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung**\n\nDie berufsbegleitende und bundesweit angebotene Weiterbildung MIKA steht f\u00fcr Medien- und IT-Kompetenz f\u00fcr Ausbildungspersonal und wird vom Bundesministerium f\u00fcr Bildung und Forschung gef\u00f6rdert. Tauchen Sie mit MIKA-VR ein in 360\u00b0-Videos, interaktive 3D-Umgebungen, Augmented Reality und 3D-Scans. \n\nMIKA-VR bietet eine interaktive und effektive M\u00f6glichkeit, Ausbildungspersonal in die Welt immersiver Medien einzuf\u00fchren.\n\nErleben Sie praxisnahe Anwendungsbeispiele aus verschiedenen Branchen oder Berufsfeldern und entdecken Sie neue virtuelle M\u00f6glichkeiten f\u00fcr Ihre Ausbildung!\n\nWeitere Informationen unter:\n- **Bundesinstitut f\u00fcr Berufsbildung (BIBB):** https://www.bibb.de/ \n- **Leando:** https://leando.de/\n- **MIKACAMPUS\u00ae:** https://training.leando.de/goto_mika_cat_23116.html\n\nKontakt: MIKA@bibb.de\n\n", "short_description": "MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung "}]}, "developer_name": null, "developer_privacy_policy_url": "https://worldofvr.de/datenschutz-mika-vr-campus/", "developer_terms_of_service_url": null, "publisher_name": "World of VR GmbH", "support_website_url": null, "website_url": "https://www.worldofvr.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7592534554196940"}, "rev
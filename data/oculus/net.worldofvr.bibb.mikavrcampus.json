TR58EdtbtJeHqK-8HfbL66OZxZe8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzD7ND2oGuZ6uY1rBdnmgzLx4QfxHQsAFhSuZOcP_ojA&oe=6A86FD3C"}, {"file_name": "Scan.png", "id": "308872574992257", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223475_308872578325590_6636054780775919658_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHiaaKx9RqcQ7kNvwFdqrC8&_nc_oc=Adrn9dz_zr8wo-KME0lxQW18Dyd5zgsSqrJGIrFupP-P2Dh6Ej-6oI-mzNaSzb9F0v0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfdVJMSo5kUfZquWNdgBW9xobKG4p4FhWDWl_GeysmWw&oe=6A86EF4E"}, {"file_name": "AR.png", "id": "1120942435738297", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75422394_1120942439071630_4444957082847083691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p_Ho9MNLIsQ7kNvwHW9m0c&_nc_oc=AdqxBavwxldjFpnMj9EKFA2dEROaelopQhOFhGCDjT2zmr8t9qK5Nvr3ue8rlw91DLw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ6H867cfzO32MI_7s0ycJEyAmd1YU7s-9KzdJI9msjw&oe=6A86D6D0"}, {"file_name": "Outro.png", "id": "833532391864456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_833532395197789_2455978168416510090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK5gFcCZJKAQ7kNvwGEjewh&_nc_oc=AdpLNJCGYl_j4D89QcFF7og7HjbtIJtZobggkBlcIZn-fr2Ph-GxUf_8huQk6sQyEVU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtfv1Ttl_QQU_QiJtnX078WoS2I_tL-xe1pJcnIjD63A&oe=6A86E529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1350689075540903", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031363_1350689078874236_3671146087760275177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trc21XPQKUAQ7kNvwE1W1-S&_nc_oc=AdprV2rBoy03LvnduB6tc8BZIIAwPafE7YWP2FsI6b02ZW5ffMMe6x1HCazeNS6bqU8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpD3MXMwIWe9LRekx0iDPMSmR8I05wYyN1A4nQQSOnxQ&oe=6A86EB95"}, "display_name": "MIKA VR Campus", "keywords": [], "long_description": "**MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung**\n\nDie berufsbegleitende und bundesweit angebotene Weiterbildung MIKA steht f\u00fcr Medien- und IT-Kompetenz f\u00fcr Ausbildungspersonal und wird vom Bundesministerium f\u00fcr Bildung und Forschung gef\u00f6rdert. Tauchen Sie mit MIKA-VR ein in 360\u00b0-Videos, interaktive 3D-Umgebungen, Augmented Reality und 3D-Scans. \n\nMIKA-VR bietet eine interaktive und effektive M\u00f6glichkeit, Ausbildungspersonal in die Welt immersiver Medien einzuf\u00fchren.\n\nErleben Sie praxisnahe Anwendungsbeispiele aus verschiedenen Branchen oder Berufsfeldern und entdecken Sie neue virtuelle M\u00f6glichkeiten f\u00fcr Ihre Ausbildung!\n\nWeitere Informationen unter:\n- **Bundesinstitut f\u00fcr Berufsbildung (BIBB):** https://www.bibb.de/ \n- **Leando:** https://leando.de/\n- **MIKACAMPUS\u00ae:** https://training.leando.de/goto_mika_cat_23116.html\n\nKontakt: MIKA@bibb.de\n\n", "short_description": "MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung "}]}, "developer_name": null, "developer_privacy_policy_url": "https://worldofvr.de/datenschutz-mika-vr-campus/", "developer_terms_of_service_url": null, "publisher_name": "World of VR GmbH", "support_website_url": null, "website_url": "https://www.worldofvr.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7592534554196940"}, "rev
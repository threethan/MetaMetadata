_F0IYkwHm4G6pmqtBzT1lDEYUH-w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GAC9t7bQr7jJE1xGnuuMxEK2kGyQg-aU13GFP_V9Mmw&oe=6A16EDBC"}, {"file_name": "Scan.png", "id": "308872574992257", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223475_308872578325590_6636054780775919658_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNSH8wC_BCAQ7kNvwFm8k4M&_nc_oc=AdqASsG2WTOxl5YR_YtD8vF605TsIwztPBSE0xBAKfTfmofZoAEE-0nv-bAfy9O7Wlg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qWmkFWaj2rqtkDVyeZMF1YNiUZHMJ0Sspn8DtHv3j_A&oe=6A16DFCE"}, {"file_name": "AR.png", "id": "1120942435738297", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75422394_1120942439071630_4444957082847083691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXrqBf94Zg8Q7kNvwEmhU2e&_nc_oc=AdrST09xlAoxtFv88n0hBurWQV5hOqQuXeLWrAqesZy0FKDdrSQ9gW4oFe50ee1XOZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sCAgW_MQE3-28iny_gf0w41qKLFoIwTyOCHBYV0kdAg&oe=6A16FF90"}, {"file_name": "Outro.png", "id": "833532391864456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982727_833532395197789_2455978168416510090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DEKLCVYShIQ7kNvwEYFHVq&_nc_oc=Adrps16m6d_vMSn2HQYFmuV45HbCF00hh2YaNtaUrRYLixAvFDuJh9SL6vbLVMo-uoA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wjKut7vM_-zahRgDROiUke3ujl0msGGchwm_hmf3FTQ&oe=6A170DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1350689075540903", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031363_1350689078874236_3671146087760275177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_coU22KYuDEQ7kNvwGGrYof&_nc_oc=Adojs36oQHO2nKdbOPOSTyp4ajPUSC_h0Fn-SmPSNnjmxH-rl76Ws80aiP2GocL5dG0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cqw_3aBB4b07HSpBj8nA96wXsk3Cj6OPjMU0EucugTw&oe=6A16DC15"}, "display_name": "MIKA VR Campus", "keywords": [], "long_description": "**MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung**\n\nDie berufsbegleitende und bundesweit angebotene Weiterbildung MIKA steht f\u00fcr Medien- und IT-Kompetenz f\u00fcr Ausbildungspersonal und wird vom Bundesministerium f\u00fcr Bildung und Forschung gef\u00f6rdert. Tauchen Sie mit MIKA-VR ein in 360\u00b0-Videos, interaktive 3D-Umgebungen, Augmented Reality und 3D-Scans. \n\nMIKA-VR bietet eine interaktive und effektive M\u00f6glichkeit, Ausbildungspersonal in die Welt immersiver Medien einzuf\u00fchren.\n\nErleben Sie praxisnahe Anwendungsbeispiele aus verschiedenen Branchen oder Berufsfeldern und entdecken Sie neue virtuelle M\u00f6glichkeiten f\u00fcr Ihre Ausbildung!\n\nWeitere Informationen unter:\n- **Bundesinstitut f\u00fcr Berufsbildung (BIBB):** https://www.bibb.de/ \n- **Leando:** https://leando.de/\n- **MIKACAMPUS\u00ae:** https://training.leando.de/goto_mika_cat_23116.html\n\nKontakt: MIKA@bibb.de\n\n", "short_description": "MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung "}]}, "developer_name": null, "developer_privacy_policy_url": "https://worldofvr.de/datenschutz-mika-vr-campus/", "developer_terms_of_service_url": null, "publisher_name": "World of VR GmbH", "support_website_url": null, "website_url": "https://www.worldofvr.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7592534554196940"}, "rev
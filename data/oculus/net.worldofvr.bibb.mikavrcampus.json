51rcbqYYEhvDoJii6OINy-6Jpuf4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmrJvwZ2oNtcyTKf0-rJkVvMuLndI1SPMLWP4dVcczHw&oe=6AA15B3C"}, {"file_name": "Scan.png", "id": "308872574992257", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223475_308872578325590_6636054780775919658_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpyXNMgpTfwQ7kNvwEEQJZ3&_nc_oc=AdpbghReHwp4fQ1i9aZyp-ZBJoCwLwfhRGfVm21C8sjWoxyKXHmvmOAmLZdqKNaPEWE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKitpmyoVOyn3R-89OiJ13eLYyrmCoNrZPwAy2QY4Eaw&oe=6AA14D4E"}, {"file_name": "AR.png", "id": "1120942435738297", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422394_1120942439071630_4444957082847083691_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THHBgLoOr2oQ7kNvwGDt64a&_nc_oc=AdqqUtL86Dia95aQAxO8G1Tnx0YUwoCAJ-e5maVQN5p9DVINoP2upDj7na7UtjLFZkA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyzyyUXXgXdJhX1BgAknSuwqmrcuOLrfeRKyqNuJM39Q&oe=6AA16D10"}, {"file_name": "Outro.png", "id": "833532391864456", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982727_833532395197789_2455978168416510090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Ydq6nGCBcQ7kNvwHuCBlb&_nc_oc=Adq8iqlvp4p6WfqScZ3ZUwr33C3KlG2NMrC1GKorahVxuCqKeu8_7Vitq3gDecXfOb0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITb6YpFMkKFDhf7bIR_yzXZusYxzrm2MjGIOz_mRnVsw&oe=6AA17B69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1350689075540903", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031363_1350689078874236_3671146087760275177_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl3ekE_pUG8Q7kNvwHOtSOm&_nc_oc=AdryH3zt1IXcqzSun7gLZxJpFFTA7SFpQnxWHDYMKGO5Eby_4f2_V4r7K1aJYxHwGk0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX2e-cpYDQmA7kHG5YiotVzHbDA_GtgMB5WrwXQ5A_Jw&oe=6AA14995"}, "display_name": "MIKA VR Campus", "keywords": [], "long_description": "**MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung**\n\nDie berufsbegleitende und bundesweit angebotene Weiterbildung MIKA steht f\u00fcr Medien- und IT-Kompetenz f\u00fcr Ausbildungspersonal und wird vom Bundesministerium f\u00fcr Bildung und Forschung gef\u00f6rdert. Tauchen Sie mit MIKA-VR ein in 360\u00b0-Videos, interaktive 3D-Umgebungen, Augmented Reality und 3D-Scans. \n\nMIKA-VR bietet eine interaktive und effektive M\u00f6glichkeit, Ausbildungspersonal in die Welt immersiver Medien einzuf\u00fchren.\n\nErleben Sie praxisnahe Anwendungsbeispiele aus verschiedenen Branchen oder Berufsfeldern und entdecken Sie neue virtuelle M\u00f6glichkeiten f\u00fcr Ihre Ausbildung!\n\nWeitere Informationen unter:\n- **Bundesinstitut f\u00fcr Berufsbildung (BIBB):** https://www.bibb.de/ \n- **Leando:** https://leando.de/\n- **MIKACAMPUS\u00ae:** https://training.leando.de/goto_mika_cat_23116.html\n\nKontakt: MIKA@bibb.de\n\n", "short_description": "MIKA VR - Eine Einf\u00fchrung in immersive Medien in der Ausbildung "}]}, "developer_name": null, "developer_privacy_policy_url": "https://worldofvr.de/datenschutz-mika-vr-campus/", "developer_terms_of_service_url": null, "publisher_name": "World of VR GmbH", "support_website_url": null, "website_url": "https://www.worldofvr.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7592534554196940"}, "rev
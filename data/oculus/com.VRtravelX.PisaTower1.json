.png", "id": "1321191752587249", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334066_1321191755920582_8926713733563749233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryizXZ-6z-IQ7kNvwHGNdvf&_nc_oc=AdnaIR9-7WIdrebv0V_IOR_S99SyTHaDJ1au2S5xy_mJUEL_ypCgy3LZh8PRjxIn-H8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUBWHcOHYf2yqWZdTJxmeTD_2XCDXzjO-VDYqq_8fdIg&oe=69A2ED6F"}, {"file_name": "screen2.png", "id": "1289604465546871", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_1289604468880204_1685059706904543181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVmd3xoSDQ8Q7kNvwHGDNL8&_nc_oc=AdkAurRIyVGcmywcfQpPhsBo2AKp59McS_cVawlQkhNdty7-xKS3hvzvVxmxJ0VR2ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvb_5gIPAO0cowVjKu1Wdn1B_cK-hC6E7jJ1Ih_Qwu2nA&oe=69A2EDC1"}, {"file_name": "screen3.png", "id": "880126530940405", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75280979_880126534273738_6771297695201328142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4RJCdtaX2gQ7kNvwE2WMZg&_nc_oc=AdmilNV-956dnfSoV7EJ8M7pKddaRU7fQREtO3dMeFmVZfAQl7zvS63sn2zbXSuoc6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5RJFHiCaW3C8FNbhcxESCGFqcZaEQZqVoFEV6O3qi-g&oe=69A2CA99"}, {"file_name": "screen4.png", "id": "1803156673845859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222939_1803156677179192_2943790923120172284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE5mAV8uxTIQ7kNvwHHuUth&_nc_oc=AdkzdMYTZ4VSfskjjEA21eOlR3Q9SzBjSC9wzDLYIaR9nGiLTY8KsJfmn8asVScswHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfupWnUVZmL9nq_b6HY5SMtE8DnhWEUTfpQ-U458p6bWNg&oe=69A2FDD4"}, {"file_name": "screen5.png", "id": "922047410129121", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75241695_922047413462454_7198410467638125953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTt3z1UHs8AQ7kNvwEgX7rR&_nc_oc=AdlJveQ1Udjra-EOKWmYbDS7mq6o0HqQZnjpAX-fdWeBJDVMNIpaILV9amh0ScPjuY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjxTNzhXKgGRyChxzY-Wb_6hILd8A6vuTNIOm_dr4zFw&oe=69A2E81A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa - Climb the World-Famous Bell Tower", "keywords": ["travel", "pisa", "sightseeing", "italy", "tourist"], "long_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa step by step. Your adventure begins in the tower\u2019s entry hall, where you feel the charm and history in its ancient stone walls. From there, you ascend the narrow staircases, peeking through small windows along the way to catch glimpses over Pisa\u2014a preview of the panoramic view awaiting you.\n\nAfter a while, you reach the first platform and can take in the view of the Piazza dei Miracoli. The tower gives you a whole new perspective of the city. But the journey continues: more stairs lead you higher, until you arrive at the upper platform, where you can enjoy a stunning 360-degree view of the entire Piazza dei Miracoli, including the cathedral and baptistery. Up here, you can feel Pisa\u2019s charm and the allure of this unique location.\n\nNext, you reach the bell platform\u2014the absolute highlight of the climb. The bells are arranged in a circle, each a relic of the past. As the bell chimes begin, the majestic sound fills the tower, immersing you fully in the atmosphere of this historic place.\n\nAfter this impressive experience, you descend the stairs, exit the tower, and step out onto the Piazza dei Miracoli. A few last steps across the square complete the experience, allowing you to fully appreciate Pisa\u2019s beauty as if you were truly there.\n\n#pisa #travel #italy", "short_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa from a true tourist\u2019s perspective. As you ascend, peek through small windows for unique views over the city. Once at the top, the grand bell platform awaits, featuring historic bells and their majestic sounds. Finish with a leisurely walk through the Piazza dei Miracoli \u2013 a one-of-a-kind experience that feels as if you\u2019re truly there.\n\n#LeaningTower #PisaVR #VirtualExperience #TravelPisa"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Climb-the-World-Famous-Bell-Tower", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8625168277559151"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "899358572584652"}, {"status": "PUBLISHED", "id": "2166330850564497"}, {"status": "PUBLISHED", "id": "1156515773305434"}, {"status": "PUBLISHED", "id": "25313212381610186"}, {"status": "PUBLISHED", "id": "1308626754159782"}, {"status": "PUBLISHED", "id": "23975821255345794"}, {"status": "PUBLISHED", "id": "986733183554458"}, {"status": "PUBLISHED", "id": "927913919111993"}, {"status": "PUBLISHED", "id": "902775352031100"}, {"status": "PUBLISHED", "id": "552154127399693"}]}, "baseline_offer": {"id": "552154127399693"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "899358572584652"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", 
ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoKYyTvBELEQ7kNvwFDtFvu&_nc_oc=Ado4r08v7y46KiXdFx7qJQV1BvxfegBaBE1CWooXLRusRTSQADLXMeEr5LlSniiSuMY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6toh5CyjhAxHq-QpY_j2a2Fn6n3g0JDdsjtQSN9v2TAg&oe=6A1B0820"}]}, "id": "481562364927508", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "1321191752587249", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75334066_1321191755920582_8926713733563749233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wTmO4qVT-UQ7kNvwG0vveL&_nc_oc=Adp4nTVr3cablB5UfvRqJ8ukx5m-TSZshWoP12_JHXq-j_DvG-W8p73gzh4f3_hOpHA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w5dlhlE0f2i6BXgnt0YRcQMZY8E4efFY_KbwPSZCISw&oe=6A1AE5EF"}, {"file_name": "screen2.png", "id": "1289604465546871", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982629_1289604468880204_1685059706904543181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSZSw2xz1CoQ7kNvwFD-8TT&_nc_oc=AdptdCgy3EBOu1JPUfrad3Gf3imc9tC-Ak1wvNPRD3pWP2Ov81ivIFbz-PHU-8xE9LU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PpxrR6fbQ1l8IMvBR7aQ_U8pIwfYZ-f8WM6ZJ9MOUBw&oe=6A1AE641"}, {"file_name": "screen3.png", "id": "880126530940405", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75280979_880126534273738_6771297695201328142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgJlO16xPVMQ7kNvwGPdGGE&_nc_oc=AdoK7gEYClk9Q8pTj_JkD7Qj9vxD8-mENj5526vKFSKPkTF3xYmlessjcFAd4CSIo3k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GUnryIbdc31i_OIMKEH6ILi6ALWxg6keLPP_MiLXxAg&oe=6A1AFB59"}, {"file_name": "screen4.png", "id": "1803156673845859", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75222939_1803156677179192_2943790923120172284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOXCqAjsIXAQ7kNvwFHGcOB&_nc_oc=Adqkh-NriFttJYDkAHfXhomzDm5CIZnHlyd1omuqITkGDhK9ek-wf3SZnZ_TtVsxYR0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XpTc0YzC5XD6HthSEvMOy3U5prnM-nuS3mmaDrdsO0w&oe=6A1AF654"}, {"file_name": "screen5.png", "id": "922047410129121", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75241695_922047413462454_7198410467638125953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_HFHkBabsIQ7kNvwFnHyTZ&_nc_oc=AdpEV0H-4-GWzCMkFiuTNG6nrCesK6YoRRdlmWv87py9N9xYXwQBw1FRDv1DzkdYUpA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58LB8_a5FhMTc29oW-y5KI8ZAinJa1RkFfe2rAO4eqhw&oe=6A1AE09A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa - Climb the World-Famous Bell Tower", "keywords": ["travel", "pisa", "sightseeing", "italy", "tourist"], "long_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa step by step. Your adventure begins in the tower\u2019s entry hall, where you feel the charm and history in its ancient stone walls. From there, you ascend the narrow staircases, peeking through small windows along the way to catch glimpses over Pisa\u2014a preview of the panoramic view awaiting you.\n\nAfter a while, you reach the first platform and can take in the view of the Piazza dei Miracoli. The tower gives you a whole new perspective of the city. But the journey continues: more stairs lead you higher, until you arrive at the upper platform, where you can enjoy a stunning 360-degree view of the entire Piazza dei Miracoli, including the cathedral and baptistery. Up here, you can feel Pisa\u2019s charm and the allure of this unique location.\n\nNext, you reach the bell platform\u2014the absolute highlight of the climb. The bells are arranged in a circle, each a relic of the past. As the bell chimes begin, the majestic sound fills the tower, immersing you fully in the atmosphere of this historic place.\n\nAfter this impressive experience, you descend the stairs, exit the tower, and step out onto the Piazza dei Miracoli. A few last steps across the square complete the experience, allowing you to fully appreciate Pisa\u2019s beauty as if you were truly there.\n\n#pisa #travel #italy", "short_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa from a true tourist\u2019s perspective. As you ascend, peek through small windows for unique views over the city. Once at the top, the grand bell platform awaits, featuring historic bells and their majestic sounds. Finish with a leisurely walk through the Piazza dei Miracoli \u2013 a one-of-a-kind experience that feels as if you\u2019re truly there.\n\n#LeaningTower #PisaVR #VirtualExperience #TravelPisa"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Climb-the-World-Famous-Bell-Tower", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8625168277559151"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "842026701735403"}, {"status": "PUBLISHED", "id": "919946807245838"}, {"status": "PUBLISHED", "id": "899358572584652"}, {"status": "PUBLISHED", "id": "2166330850564497"}, {"status": "PUBLISHED", "id": "1156515773305434"}, {"status": "PUBLISHED", "id": "25313212381610186"}, {"status": "PUBLISHED", "id": "13086267
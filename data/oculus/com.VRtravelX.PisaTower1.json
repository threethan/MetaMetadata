ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwsG3bUNzP8Q7kNvwEA7Qw8&_nc_oc=Adri4XYOp1P4gsm6yRHNyZvQvOfDc9xukpLFUTggZ0IkspdOUWheQdnECxGoMyi5Z8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPKIB2V9ZkWYCCxftHYYdrWxqP4tnr5SWH6tlscjK_lA&oe=6A5F5DE0"}]}, "id": "481562364927508", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "1321191752587249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334066_1321191755920582_8926713733563749233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEvJLRU_J6sQ7kNvwEqPGoJ&_nc_oc=AdpBmZZpF32Onta-36yQ7PwSR3JLtaIR6OI41J5tl7FNV11p6zuHAj96QGzR2SruFZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxtl_-jbymzNPvOnY816ZmPD-xV-slmsD49QRp4r4FTw&oe=6A5F73EF"}, {"file_name": "screen2.png", "id": "1289604465546871", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982629_1289604468880204_1685059706904543181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlXOSm8wZ6EQ7kNvwHTivlp&_nc_oc=AdpkNhoi_Ego-ywF-n4YOg6v_i5xxvVaNiNxe69ZlH44fjoZY24OOigF-IVbCtuyrlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgYevCBTH0QNnWnA9FsozdB6oc6fit-tYi3c4dT9c7BQ&oe=6A5F7441"}, {"file_name": "screen3.png", "id": "880126530940405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75280979_880126534273738_6771297695201328142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52lbSRHl4iYQ7kNvwFVi0Cy&_nc_oc=AdpMv7K21HbgzP_rS5Mfg7HteMdvosHS0HWX-fe0lez1kDN-yzFqj-2Gw7Oa0ZzJ7_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmBv_cM7CQL8CqfQPL4GnK0V7SInlShOmr_GFd1_EF5w&oe=6A5F8959"}, {"file_name": "screen4.png", "id": "1803156673845859", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222939_1803156677179192_2943790923120172284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6IIIKxOqLMQ7kNvwHI1UZg&_nc_oc=AdrKgeu7wAH_AP-GqZiyN-7ijuz71x7km9XafpvbIQizzTAuB_GiMG3onPOcWioo74Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw2v6PjjqcMUztyITknXDxqX6uympWiHDL23ivpAkOlA&oe=6A5F8454"}, {"file_name": "screen5.png", "id": "922047410129121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75241695_922047413462454_7198410467638125953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX1RNYDwA8AQ7kNvwFhnzE9&_nc_oc=AdpbhWz6WEWLZTbKw5WbC_RLH_8evfxbOjeRf5yCNp_DSuzn4se4qzT2ZjLT5fwga6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH3Aq0LVUIKWDiw8M4jZe76NnGQkvCFKvN-20nS5P3IA&oe=6A5F6E9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa - Climb the World-Famous Bell Tower", "keywords": ["travel", "pisa", "sightseeing", "italy", "tourist"], "long_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa step by step. Your adventure begins in the tower\u2019s entry hall, where you feel the charm and history in its ancient stone walls. From there, you ascend the narrow staircases, peeking through small windows along the way to catch glimpses over Pisa\u2014a preview of the panoramic view awaiting you.\n\nAfter a while, you reach the first platform and can take in the view of the Piazza dei Miracoli. The tower gives you a whole new perspective of the city. But the journey continues: more stairs lead you higher, until you arrive at the upper platform, where you can enjoy a stunning 360-degree view of the entire Piazza dei Miracoli, including the cathedral and baptistery. Up here, you can feel Pisa\u2019s charm and the allure of this unique location.\n\nNext, you reach the bell platform\u2014the absolute highlight of the climb. The bells are arranged in a circle, each a relic of the past. As the bell chimes begin, the majestic sound fills the tower, immersing you fully in the atmosphere of this historic place.\n\nAfter this impressive experience, you descend the stairs, exit the tower, and step out onto the Piazza dei Miracoli. A few last steps across the square complete the experience, allowing you to fully appreciate Pisa\u2019s beauty as if you were truly there.\n\n#pisa #travel #italy", "short_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa from a true tourist\u2019s perspective. As you ascend, peek through small windows for unique views over the city. Once at the top, the grand bell platform awaits, featuring historic bells and their majestic sounds. Finish with a leisurely walk through the Piazza dei Miracoli \u2013 a one-of-a-kind experience that feels as if you\u2019re truly there.\n\n#LeaningTower #PisaVR #VirtualExperience #TravelPisa"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Climb-the-World-Famous-Bell-Tower", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8625168277559151"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1546351797162770"}, {"status": "PUBLISHED", "id": "842026701735403"}, {"status": "PUBLISHED", "id": "919946807245838"}, {"status": "PUBLISHED", "id": "899358572584652"}, {"status": "PUBLISHED", "id": "2166330850564497"}, {"status": "PUBLISHED", "id": "1156515773305434"}, {"status": "PUBLISHED", "id": "253132123
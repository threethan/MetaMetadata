Yn7efG5mJF9QhQsXMQ5dtFxcwH3mOO2uZW6eeS5MolIR3Nszc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8BB55jWT4K4dS1V84VSMgbn4goNsuUZUg7Vv8V5aaaA&oe=6B106A99"}, {"file_name": "screen4.png", "id": "1803156673845859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222939_1803156677179192_2943790923120172284_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLn67DLpBf8Q7kNvwFyTD2u&_nc_oc=AdoZWe-Zu4oYWHozk_OrnMZFoL-gfReHbaT1Q7n3N-IYgmmxioH8QAvS1-WUA7yJuTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1aBfuwJ3GLwj_7ETMNamNsQIkVLrLM5ODFcq8KvYT_w&oe=6B106594"}, {"file_name": "screen5.png", "id": "922047410129121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241695_922047413462454_7198410467638125953_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjFt52OHRJ0Q7kNvwFwbEL1&_nc_oc=Adpa4LZb_TGalFHt7VJut7gtNpOY9pREuVJ32IfBfdczLKK7KAeG0cOcy-8j4_K-IX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXucO924RoV7o1iX8joqKOMODvq8cGEf_Wkjsee4FUMLA&oe=6B104FDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa - Climb the World-Famous Bell Tower", "keywords": ["travel", "pisa", "sightseeing", "italy", "tourist"], "long_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa step by step. Your adventure begins in the tower\u2019s entry hall, where you feel the charm and history in its ancient stone walls. From there, you ascend the narrow staircases, peeking through small windows along the way to catch glimpses over Pisa\u2014a preview of the panoramic view awaiting you.\n\nAfter a while, you reach the first platform and can take in the view of the Piazza dei Miracoli. The tower gives you a whole new perspective of the city. But the journey continues: more stairs lead you higher, until you arrive at the upper platform, where you can enjoy a stunning 360-degree view of the entire Piazza dei Miracoli, including the cathedral and baptistery. Up here, you can feel Pisa\u2019s charm and the allure of this unique location.\n\nNext, you reach the bell platform\u2014the absolute highlight of the climb. The bells are arranged in a circle, each a relic of the past. As the bell chimes begin, the majestic sound fills the tower, immersing you fully in the atmosphere of this historic place.\n\nAfter this impressive experience, you descend the stairs, exit the tower, and step out onto the Piazza dei Miracoli. A few last steps across the square complete the experience, allowing you to fully appreciate Pisa\u2019s beauty as if you were truly there.\n\n#pisa #travel #italy", "short_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa from a true tourist\u2019s perspective. As you ascend, peek through small windows for unique views over the city. Once at the top, the grand bell platform awaits, featuring historic bells and their majestic sounds. Finish with a leisurely walk through the Piazza dei Miracoli \u2013 a one-of-a-kind experience that feels as if you\u2019re truly there.\n\n#LeaningTower #PisaVR #VirtualExperience #TravelPisa"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Climb-the-World-Famous-Bell-Tower", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
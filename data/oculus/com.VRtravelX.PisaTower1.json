_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75250458_566819832393129_4548943642065323704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1zXp5AoXG0Q7kNvwEkslWu&_nc_oc=AdoD-QV5PLzJgeUiodJk18i46CA8t4RNXMlHcLDxzKFJ6dwmZgAPu6r0s2gjjZLoK28&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmkvA_LzcKYLc9vdqRn_fdts-_-XnOj8YRr9yH7QcCmw&oe=6A635260"}]}, "id": "481562364927508", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "1321191752587249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334066_1321191755920582_8926713733563749233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOWlvJo1Xu8Q7kNvwHf--1v&_nc_oc=Adq9rDUTgAXr73k3oz1DR6SpKbzjf4EUzmo0DYe8kbndtCyZxIfETq1oGWu2Ygw1C7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQHdI0d5Y7bRTcTHHUIb0mofOKJzCbB4tSMRyXOSKurQ&oe=6A63686F"}, {"file_name": "screen2.png", "id": "1289604465546871", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982629_1289604468880204_1685059706904543181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-cafpzi2SkQ7kNvwELHCKz&_nc_oc=AdocXt8Sq1V-zkYRwQPkA9OoRaAWjMSuplEU8vfq39pamq9ru0DiWYrJwD-eL4sjcI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnBNojmdbJbIN5nWSi10KcopCFzYKYElPyteqEaY0dKA&oe=6A6368C1"}, {"file_name": "screen3.png", "id": "880126530940405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75280979_880126534273738_6771297695201328142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L-7E_yR3sIQ7kNvwHPaFgB&_nc_oc=AdrhdVwJaxnx-T0DkLqxKFGd7ko_F2PHBxxdH3JNcQcW-swSr-PTOieQjuOSRDCsSb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCBnkHphROUWAjLgtTOaP-vDqMPphvttDES1RwSaBgyA&oe=6A637DD9"}, {"file_name": "screen4.png", "id": "1803156673845859", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222939_1803156677179192_2943790923120172284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFnvDnPpJLAQ7kNvwH9FmQP&_nc_oc=AdqZ7jNII9D5H0GtTmWYqZPlH4eXvMECq7ualkHi_wY90_20ra3uSDiZTq9MZNqZkAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADu_S--Tt8ZoL6hJ4ucmFiQ-JYVrfDO-5G6gYExOJ7QA&oe=6A6378D4"}, {"file_name": "screen5.png", "id": "922047410129121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75241695_922047413462454_7198410467638125953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IByInDEl7sQ7kNvwG4S2iZ&_nc_oc=AdqY03BE_PiWr88WgcIzxATT8sqfdKo3ZEZrnwhaqvvs2mL3SH9qxEB65Q3faP6KpYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9IYMNBMVp6Qft-he6aswKF1OltZARSP7J7nb9aq8aHA&oe=6A63631A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pisa - Climb the World-Famous Bell Tower", "keywords": ["travel", "pisa", "sightseeing", "italy", "tourist"], "long_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa step by step. Your adventure begins in the tower\u2019s entry hall, where you feel the charm and history in its ancient stone walls. From there, you ascend the narrow staircases, peeking through small windows along the way to catch glimpses over Pisa\u2014a preview of the panoramic view awaiting you.\n\nAfter a while, you reach the first platform and can take in the view of the Piazza dei Miracoli. The tower gives you a whole new perspective of the city. But the journey continues: more stairs lead you higher, until you arrive at the upper platform, where you can enjoy a stunning 360-degree view of the entire Piazza dei Miracoli, including the cathedral and baptistery. Up here, you can feel Pisa\u2019s charm and the allure of this unique location.\n\nNext, you reach the bell platform\u2014the absolute highlight of the climb. The bells are arranged in a circle, each a relic of the past. As the bell chimes begin, the majestic sound fills the tower, immersing you fully in the atmosphere of this historic place.\n\nAfter this impressive experience, you descend the stairs, exit the tower, and step out onto the Piazza dei Miracoli. A few last steps across the square complete the experience, allowing you to fully appreciate Pisa\u2019s beauty as if you were truly there.\n\n#pisa #travel #italy", "short_description": "Immerse yourself in an unforgettable VR experience, letting you climb the world-famous Leaning Tower of Pisa from a true tourist\u2019s perspective. As you ascend, peek through small windows for unique views over the city. Once at the top, the grand bell platform awaits, featuring historic bells and their majestic sounds. Finish with a leisurely walk through the Piazza dei Miracoli \u2013 a one-of-a-kind experience that feels as if you\u2019re truly there.\n\n#LeaningTower #PisaVR #VirtualExperience #TravelPisa"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Pisa-Climb-the-World-Famous-Bell-Tower", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8625168277559151"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1546351797162770"}, {"status": "PUBLISHED", "id": "842026701735403"}, {"status": "PUBLISHED", "id": "919946807245838"}, {"status": "PUBLISHED", "id": "899358572584652"}, {"status": "PUBL
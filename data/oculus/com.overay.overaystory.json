o_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "1262373598891504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824522_1262373602224837_3077113971073055599_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnmu434X4cUQ7kNvwEFMCKK&_nc_oc=AdkxAfsE-BZUWBqDUalzJpTG1iP6-FfMNfynoHzwGgxo1Cyq56tkzpYKMrG7AaDqLSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfskV2RsUnx09h8RpmI2sdZ-9eBd3cWnYPoHM1M-4OWFDQ&oe=69A44077"}, "display_name": "OVERAY STORY (BETA)", "keywords": ["StoryBoard", "WebToon", "Previsualization", "ConceptArt", "IdeaSketch"], "long_description": "Were you tired of complicated, exhausting workflows?\nWith Overay Story, instantly visualize your ideas the moment they come to you!\n\nPlace props and characters in your space and pose them freely to express your thoughts quickly.\nCapture your scene from any angle and create compelling compositions with a variety of effects.\nReview and share your shots instantly in the Meta Gallery.\n\nStage a world before your eyes and turn your imagination into reality\u2014fast.", "short_description": "Were you tired of complicated, exhausting workflows?\nWith Overay Story, instantly visualize your ideas the moment they come to you!\n\nPlace props and characters in your space and pose them freely to express your thoughts quickly.\nCapture your scene from any angle and create compelling compositions with a variety of effects.\nReview and share your shots instantly in the Meta Gallery.\n\nStage a world before your eyes and turn your imagination into reality\u2014fast."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://overay.com/docs/privacy", "developer_terms_of_service_url": "https://overay.com/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://overay-inc.gitbook.io/overay-story", "website_url": "https://overaystory.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
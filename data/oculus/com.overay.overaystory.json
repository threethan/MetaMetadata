o_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "1262373598891504", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824522_1262373602224837_3077113971073055599_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3GPD1p8wAgQ7kNvwEiF6Ph&_nc_oc=AdkdrrDsfu61rTEU6ceu0oUm1n9YZWOAssd3RM3cm6jR3U7z4JsfKl2rCTBty0JaLzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv5sOZ5nKG-wOk3r7UuZH4pg_fNYpDrW2VmmxmQ2DmhQg&oe=699EFA77"}, "display_name": "OVERAY STORY (BETA)", "keywords": ["StoryBoard", "WebToon", "Previsualization", "ConceptArt", "IdeaSketch"], "long_description": "Were you tired of complicated, exhausting workflows?\nWith Overay Story, instantly visualize your ideas the moment they come to you!\n\nPlace props and characters in your space and pose them freely to express your thoughts quickly.\nCapture your scene from any angle and create compelling compositions with a variety of effects.\nReview and share your shots instantly in the Meta Gallery.\n\nStage a world before your eyes and turn your imagination into reality\u2014fast.", "short_description": "Were you tired of complicated, exhausting workflows?\nWith Overay Story, instantly visualize your ideas the moment they come to you!\n\nPlace props and characters in your space and pose them freely to express your thoughts quickly.\nCapture your scene from any angle and create compelling compositions with a variety of effects.\nReview and share your shots instantly in the Meta Gallery.\n\nStage a world before your eyes and turn your imagination into reality\u2014fast."}]}, "developer_name": "Overay Inc.", "developer_privacy_policy_url": "https://overay.com/docs/privacy", "developer_terms_of_service_url": "https://overay.com/docs/service", "publisher_name": "Overay Inc.", "support_website_url": "https://overay-inc.gitbook.io/overay-story", "website_url": "https://overaystory.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
78553014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw-lBt1sc68Q7kNvwEZG59y&_nc_oc=AdmWIHcwLbdVpwFc9MxtrIPFxdnUGhG35JTlf0bOIDeEfs0jdIaa5vQ7BdIvaalJnso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspIbmqCMLd0HAk55esnWVESZ4otpn-AsRTnohyKs821Q&oe=699DA32E"}, {"file_name": "screen_3840x2160_2020-11-27_17-13-56 (1).png", "id": "156938542896641", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982695_156938546229974_7410313526847646328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fhXRmqqyTYQ7kNvwHMP9g9&_nc_oc=AdlckATVUIMG89H7LXbfJD8wz1m69y6MVbLGwHzjV_PmXn9IBHmSa-D0CgiJn7Rkz58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspchCrPdmlpPsG4eKIFdXxOjtj_JhMnxQ3q7KzLVDxhQ&oe=699D8FF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031356_213311923513579_7305137637476163119_n.png", "id": "152682753322840", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982701_152682756656173_886551930651521230_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmjvtsPz6QgQ7kNvwGyH4S9&_nc_oc=Adl4wRLuDRcl7NoRcdP25cnyJzBoL0SFcpxSdvoT7gt11ulMKlNYx-Gbkzs5Jjae4V4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft49uuFLFt1x1_UWb88uk0B9Efij28DqfWH1_0KU51VVw&oe=699DB28D"}, "display_name": "Ven VR Adventure", "keywords": ["platformer", "singleplayer", "moss", "adventure", "action"], "long_description": "Ven VR Adventure is a single-player platform game built for virtual reality from the ground up. \n\nFeatures:\n- Take on an adventure through a magical land.\n- Enter the world of Ven thanks to VR technology, where you can look around in every direction, lean forward/backward, and zoom in and out to enjoy an extraordinary immersion experience.\n- Team up and work closely with Ven and use everything you can to save his world. Be the hero who helps Ven save his planet from destruction.\n- Submerge yourself in a world of magic, invaded by machines and deadly enemies, full of traps and dangers.\n- Save all of Ven\u2019s little companions.\n- Challenge yourself by trying to finish each level in a time trial mode and many other modes, comparing your performance against a global leaderboards.\n- Perfect for players who are just starting their adventure with VR as well as those who are looking for challenge", "short_description": "Ven VR Adventure is a single-player VR platform game. You happen to meet Ven on his unknown planet, invaded by Bruce Nelson, who wants to destroy the magical world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monologic.games/pl/polityka-prywatnosci/", "developer_terms_of_service_url": "https://www.monologic.games/pl/polityka-cookies/", "publisher_name": "Monologic Games", "support_website_url": null, "website_url": "http://www.monologic.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2950497688595810"}}]}, "scheduled_offers": {"count": 32, "nodes": [{"status": "PUBLISHED", "id": "776767671508621"}, {"status": "PUBLISHED", "id": "1256593926111328"}, {"status": "CANCELLED", "id": "710101488320106"}, {"status": "PUBLISHED", "id": "1188924022234277"}, {"status": "PUBLISHED", "id": "8975736855827159"}, {"status": "PUBLISHED", "id": "899312765356915"}, {"status": "PUBLISHED", "id": "402176429482562"}, {"status": "PUBLISHED", "id": "1577523789341487"}, {"status": "PUBLISHED", "id": "702512257850416"}, {
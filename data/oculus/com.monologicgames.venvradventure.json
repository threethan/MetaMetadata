27_14-30-52 (1).png", "id": "448998762901864", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031519_448998766235197_7610870648578553014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nP1TRZQxekQ7kNvwFPvmMZ&_nc_oc=AdqmNYkfVFqATXZdfZu9NKblJs9SJzHsoCMhFjZtuzHn9Wu4A6-Q3hnvJDI-2vtjUfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfFV83vAZiLK6ZCV8DVpHYBSqW-pjFFpibf56NLZ7kJQ&oe=6ABA672E"}, {"file_name": "screen_3840x2160_2020-11-27_17-13-56 (1).png", "id": "156938542896641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982695_156938546229974_7410313526847646328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVLMS8kZHucQ7kNvwERpwLM&_nc_oc=AdorF4bTQphJn0DuP4ZtQX6RpDiMvBxhcY1YgF1SzloUzIrQT80Z4Nn4mjWfcWtcVG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdI8fVA1ZAh0UFphVa0QaK6pHbYyLzkiDYG45QjEVCvg&oe=6ABA8C36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031356_213311923513579_7305137637476163119_n.png", "id": "152682753322840", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_152682756656173_886551930651521230_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qkCeIVFyTYQ7kNvwFrShKH&_nc_oc=Adpzwlr2vNkJTcu_fWUmBWeEGoGwVlDH7yxW9aOhOsxVtHa-FI81w53bAZIKxhZehwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmMVTnmK6_PUIJvyE7q25kKuZEWFAOaIVATGbho5Jtjg&oe=6ABA768D"}, "display_name": "Ven VR Adventure", "keywords": ["platformer", "singleplayer", "moss", "adventure", "action"], "long_description": "Ven VR Adventure is a single-player platform game built for virtual reality from the ground up. \n\nFeatures:\n- Take on an adventure through a magical land.\n- Enter the world of Ven thanks to VR technology, where you can look around in every direction, lean forward/backward, and zoom in and out to enjoy an extraordinary immersion experience.\n- Team up and work closely with Ven and use everything you can to save his world. Be the hero who helps Ven save his planet from destruction.\n- Submerge yourself in a world of magic, invaded by machines and deadly enemies, full of traps and dangers.\n- Save all of Ven\u2019s little companions.\n- Challenge yourself by trying to finish each level in a time trial mode and many other modes, comparing your performance against a global leaderboards.\n- Perfect for players who are just starting their adventure with VR as well as those who are looking for challenge", "short_description": "Ven VR Adventure is a single-player VR platform game. You happen to meet Ven on his unknown planet, invaded by Bruce Nelson, who wants to destroy the magical world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monologic.games/pl/polityka-prywatnosci/", "developer_terms_of_service_url": "https://www.monologic.games/pl/polityka-cookies/", "publisher_name": "Monologic Games", "support_website_url": null, "website_url": "http://www.monologic.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2950497688595810"}}]}, "scheduled_offers": {"count": 32, "nodes": [{"status": "PUBLISHED", "id": "776767671508621"}, {"status": "PUBLISHED", "id": "1256593926111328"}, {"status": "CANCELLED", "id": "710101488320106"}, {"status": "PUBLISHED", "id": "1188924022234277"}, {"status": "PUBLISHED", "id": "8975736855827159"}, {"status": "PUBLISHE
27_14-30-52 (1).png", "id": "448998762901864", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031519_448998766235197_7610870648578553014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dp8s23GTkoQ7kNvwFL2XJu&_nc_oc=Adpq7R-xYXMXUnl42M-EEbdD_YlGm8u5tls_UIjYRyhweKGOPFlmcxRuAjetbKEV2RI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxjZwEJtS_a02y84Ols3gWJYZCNXcnSM0jD6C5-LhHXw&oe=6AF4A16E"}, {"file_name": "screen_3840x2160_2020-11-27_17-13-56 (1).png", "id": "156938542896641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_156938546229974_7410313526847646328_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGNJmXkcUpIQ7kNvwEZd4gT&_nc_oc=AdqEkO3lTOn63LBYVEOm8Jw6JCMh0qAdfYtX3m0aYtjuFzm_Jp7juSKQD8XhMtq81uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeBVlA2rxY7s4fz7ci5aQIgrmEvdRSBFTEP7IATBJf1A&oe=6AF48E36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031356_213311923513579_7305137637476163119_n.png", "id": "152682753322840", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982701_152682756656173_886551930651521230_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEp4Ye0q1cgQ7kNvwGvynaV&_nc_oc=AdokKtDl0BO8CGkaQwJol93MmynTRH_DiICaMzy-Jip-m4BiZETQM4AWy3mYJ0HgRR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsN2G54WJhXdPvDvq1T7ifQOcgwNuUzmllyQwDlKQ7FA&oe=6AF4788D"}, "display_name": "Ven VR Adventure", "keywords": ["platformer", "singleplayer", "moss", "adventure", "action"], "long_description": "Ven VR Adventure is a single-player platform game built for virtual reality from the ground up. \n\nFeatures:\n- Take on an adventure through a magical land.\n- Enter the world of Ven thanks to VR technology, where you can look around in every direction, lean forward/backward, and zoom in and out to enjoy an extraordinary immersion experience.\n- Team up and work closely with Ven and use everything you can to save his world. Be the hero who helps Ven save his planet from destruction.\n- Submerge yourself in a world of magic, invaded by machines and deadly enemies, full of traps and dangers.\n- Save all of Ven\u2019s little companions.\n- Challenge yourself by trying to finish each level in a time trial mode and many other modes, comparing your performance against a global leaderboards.\n- Perfect for players who are just starting their adventure with VR as well as those who are looking for challenge", "short_description": "Ven VR Adventure is a single-player VR platform game. You happen to meet Ven on his unknown planet, invaded by Bruce Nelson, who wants to destroy the magical world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.monologic.games/pl/polityka-prywatnosci/", "developer_terms_of_service_url": "https://www.monologic.games/pl/polityka-cookies/", "publisher_name": "Monologic Games", "support_website_url": null, "website_url": "http://www.monologic.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2950497688595810"}}]}, "scheduled_offers": {"count": 33, "nodes": [{"status": "PUBLISHED", "id": "2215431642657785"}, {"status": "PUBLISHED", "id": "776767671508621"}, {"status": "PUBLISHED", "id": "1256593926111328"}, {"status": "CANCELLED", "id": "710101488320106"}, {"status": "PUBLISHED", "id": "1188924022234277"}, {"status": "PUBLISHE
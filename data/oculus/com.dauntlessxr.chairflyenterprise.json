dPTzYrtWmsiSJmm-liAt9nRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvCKcFQVBz9CyS3eAuIwSqVQMCEAHthL4SBtxtctqqyg&oe=6AAA8545"}, {"file_name": "Screenshot3.png", "id": "4483654168618769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622202_4483654171952102_2790387822185273649_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtHw3FEpv8sQ7kNvwEUA6KI&_nc_oc=Ado4WNwA2d8KZMtbmcEos-4qQ_V4mDoBhwwACSdXLHqrin6J5_pz_snvZAaGTGtdumM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvD0pM3mW1r9-5u3iE_PJOwj2k2AXpMr8G4lsQWlLZaQ&oe=6AAA9EE4"}, {"file_name": "Screenshot4.png", "id": "983800978070623", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620655_983800981403956_4960040346578155391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKZYjfoU39sQ7kNvwHm1jGL&_nc_oc=Adqxi7el20viemEMyU84VbEkj5CCLLbbpgkIAmOtfRoxzqaJpSnSDcYCdPH-fXGmAiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw0u8HWj8Oapz7AlcjxdXg470ziPTXWPzd4RsHdCSYFQ&oe=6AAAB134"}, {"file_name": "Screenshot5.png", "id": "2361274121275835", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620630_2361274124609168_6241599516448868949_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuwYL8vksLYQ7kNvwFSjmwG&_nc_oc=AdodzDKzveDEcP9XG1sc5QgcCAF6bVaQJmMeHs7_165fV1hEMP96vBm35IUs38x2U2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITX_6twtUs6aO5X94UwuhIuFrhEpq0_0eVHyqA7xvCEg&oe=6AAABBA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1348988000642007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628092_1348988003975340_2576079806420696382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ8cwv63GzkQ7kNvwFxJsQZ&_nc_oc=Ado9b4N7Lg1tVNq3zwB5MTJ1TwDsE3hZAkDInQNTKw2HRqjo3NJpmMf1Uk3yF9_Y1lI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfPo2ZvpGpX260ozGqJg6iRfVNMaQDG1f-tHAjTjqp8Q&oe=6AAABA3A"}, "display_name": "Flight Deck: Enterprise", "keywords": ["cessna", "flight", "training", "pilot", "cockpit"], "long_description": "Upgrade your cockpit posters with Flight Deck: the most immersive and hands-on Cessna 172 cockpit experience. For student pilot\u2019s & licensed aviator alike, Flight Deck brings a true-to-size, high-fidelity 3D Cessna 172 cockpit into your living room.\n\nFlight Deck is a digital to-scale cockpit, that complements simulator time, but is not a flight simulator. Flight Deck lets you physically move through flows and cockpit procedures on the ground using your own hands, in mixed reality, no cockpit posters required. Save your simulator hours and your instruction time with your CFI for the tough stuff and put in the reps and sets to build your cockpit flow muscle memory from home. \n\n**Key Features:**\n\n- **Interactive Avionics:** Every switch, dial, and control is touchable, just like in the real aircraft.\n- **To-Scale Realism:** Step into a meticulously 3D-scanned Cessna 172 cockpit for maximum immersion.\n- **Hands-On Chair Flying:** Practice cockpit flows and procedures in a distraction-free environment.\n- **Affordable & Accessible:** Get professional-level cockpit training at home, without the cost or hassle of a simulator.\n\n**Why Choose Flight Deck?**\n\n- Build real-world cockpit muscle memory with hands-on repetition.\n- Practice flows and procedures using your own physical checklists anytime and anywhere.\n- Stay sharp and confident between lessons or flights.\n\n*Note: Flight Deck does not simulate flight or include built-in checklist automation. It is not affiliated with Textron Aviation.*", "short_description": "Transform your living room into a Cessna 172 cockpit and upgrade your pilot training experience. Practice real procedures, cockpit flows, and checklists in mixed reality with a to-scale and interactive 172 cockpit. No paper posters required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dauntlessxr.com/privacy-policy", "dev
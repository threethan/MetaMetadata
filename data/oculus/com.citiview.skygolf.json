sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT75qLt5ZXE9kcKAZSU5H2CiIVAYY8zVagOpk-fkPvtrg&oe=6AFC6B8D"}, {"file_name": "screenshot_5.png", "id": "1619488056285453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1619488059618786_4105279490593783422_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsXwBrcrrbkQ7kNvwGRxGBE&_nc_oc=AdrmQ-OYh55gvRW53MmYEabD9mbTLkkTGQoZsZG2cJ-zxZiXRWMYKt1bsxIJkx13Ha4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWeOG0zD2KJjB-YMyce_g_rxq5JFjNyEPmKavVw_XBbA&oe=6AFC7E8B"}, {"file_name": "screenshot_4.png", "id": "1329633125753806", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604366035_1329633129087139_2742781216482732862_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ6Eo25z0AkQ7kNvwF4wfAQ&_nc_oc=Adp3PH1HNBRu3Q2Qpo9IhYk8iDrL01SxALlynrQ9-AISNByVer3SoMnqggAjbbdpYEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIJ6qeToVQ3FqKb0fZvFmjV07jtAMxUY1j7HmPzjDwAQ&oe=6AFC78E8"}, {"file_name": "screenshot_1.png", "id": "1806918830479568", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1806918833812901_988668152317712891_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRBC80T58vgQ7kNvwGbCAOT&_nc_oc=Adr9wst0ZCBmmNmcyk4Ee80XbM7hbhnbDU-0L-6DuAb_OVuAGxvdh3Vl9PItLWlXmQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ4JR2hjznnNc6BtC-k2Nw1WGf7uFd0Dfh8PS1YM4KuA&oe=6AFC7C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "4447915395423213", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_4447915398756546_7844168975704264857_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd96dCUvjP4Q7kNvwGR1Qyd&_nc_oc=AdqWiEnho3pvm4QihOMTYy6mjLCcbxX1fMQXpROcz04vZJLN3PsrOBla67aWb3Kt4z0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3I_ENlGuJYpHF8H0qfAJ0RLt0V__hnjaXVKde4aMczg&oe=6AFC7C0A"}, "display_name": "Sky Golf", "keywords": ["golf", "minigolf", "multiplayer", "platformer", "putting"], "long_description": "Sky Golf is mini golf on floating islands high above the clouds - and getting to the next hole is half the fun.\n\nPUTT, THEN JUMP\nEvery hole sits on its own island. Sink your putt, then jump the gap to the next one: hop across rising stepping stones, ride the moving platforms and grab the coins hanging over every jump. Fall off? You pop straight back onto the island - no penalty.\n\nTEN WORLDS, 60 HOLES\nMeadow Island, Candy Land, Jungle Temple, Coral Reef, Frosty Peaks, Sunny Beach, Desert Canyon, Cloud Kingdom, Autumn Forest and Cherry Blossom - each with its own colours, sky and scenery, and six holes full of ramps, windmills, castles, tunnels, bumps and sliding blockers.\n\nPLAY ONLINE\nPress QUICK PLAY ONLINE to golf with whoever is on, or start a PRIVATE GAME and give your friends a 4-digit code. Everyone plays their own ball at their own pace, and the scoreboard shows every golfer's round hole by hole. The host picks the world and everyone goes together.\n\nPICK YOUR CHARACTER\nChoose from ten fun characters - a clown, a jester, a bunny, a biker and more. The other players see your character walk, jump, swing the putter with your real arms and dance when you sink a great putt.\n\nREAL PUTTING\nSwing the putter with your own arm. The ball rolls true on every tile, an aim line helps you line up, and you can play right- or left-handed.\n\nControls: swing to putt, A / X to jump, B / Y to stand at your ball, left stick to move, right stick to turn, MENU for everything else.", "short_description": "Mini golf in the sky. Putt across floating islands, then jump the gaps between them - hopping stepping stones and riding moving platforms to reach the next hole. Ten colourful worlds, 60 holes, and online multiplayer with your friends as ten fun characters."}]}, "developer_name": "Citiview Studios", "developer_privacy_polic
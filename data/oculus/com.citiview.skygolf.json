iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBN0JtqpqN0qMnj7FreYAPwff-Nx_DK1a3LQ7ERQDxsw&oe=6B05A60D"}, {"file_name": "screenshot_5.png", "id": "1619488056285453", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1619488059618786_4105279490593783422_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2BPDnBnt7QQ7kNvwH7Ds4p&_nc_oc=Adrovzpv5DDYfe4eiEz1Os-zjZ-THNRyPMqNybd_4wlzmh6VJD49IgEmKZkPRL0V4Ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlzEMK4WzlgHZ1tcOMHhWjlGFYpHSkbqP-L4knQbcPhw&oe=6B05B90B"}, {"file_name": "screenshot_4.png", "id": "1329633125753806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604366035_1329633129087139_2742781216482732862_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDADu5zOupsQ7kNvwHdhSVy&_nc_oc=AdpLCDWJB8Dw65ZMue6KSz8oZZCqayOlzzzPjzecmTWe7HcUn9ZSDtkqNjEMRCrfk6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnu8vf2YKXfWi4DhpGb_KPacMtx_hTr-32SMOaiQnVPQ&oe=6B05B368"}, {"file_name": "screenshot_1.png", "id": "1806918830479568", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_1806918833812901_988668152317712891_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iiTgzbjgIUQ7kNvwGtLo09&_nc_oc=AdqvdH-7lQWS7bGp2LIfT8yIgul_rORQwQUDBmT4owe58Lw760F8d01gM8zkxz987BE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_-Dz7YbaDQ6tRH_Mxs6JuiWmWI-bXP01nIzLhC6oFuA&oe=6B05B6A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "4447915395423213", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_4447915398756546_7844168975704264857_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hVxCcx9w4cQ7kNvwEuIrF2&_nc_oc=AdoPLB2Yb3Re-n2ry8b4haeW_A2YC6XstIQuZolHFzJb7c4TGmdv3JSJfUzpeT9S5eA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs5ilK40ap42tVZBNnN5ZUNoExLNXNtWmAZ1gsYXwzLw&oe=6B05B68A"}, "display_name": "Sky Golf", "keywords": ["golf", "minigolf", "multiplayer", "platformer", "putting"], "long_description": "Sky Golf is mini golf on floating islands high above the clouds - and getting to the next hole is half the fun.\n\nPUTT, THEN JUMP\nEvery hole sits on its own island. Sink your putt, then jump the gap to the next one: hop across rising stepping stones, ride the moving platforms and grab the coins hanging over every jump. Fall off? You pop straight back onto the island - no penalty.\n\nTEN WORLDS, 60 HOLES\nMeadow Island, Candy Land, Jungle Temple, Coral Reef, Frosty Peaks, Sunny Beach, Desert Canyon, Cloud Kingdom, Autumn Forest and Cherry Blossom - each with its own colours, sky and scenery, and six holes full of ramps, windmills, castles, tunnels, bumps and sliding blockers.\n\nPLAY ONLINE\nPress QUICK PLAY ONLINE to golf with whoever is on, or start a PRIVATE GAME and give your friends a 4-digit code. Everyone plays their own ball at their own pace, and the scoreboard shows every golfer's round hole by hole. The host picks the world and everyone goes together.\n\nPICK YOUR CHARACTER\nChoose from ten fun characters - a clown, a jester, a bunny, a biker and more. The other players see your character walk, jump, swing the putter with your real arms and dance when you sink a great putt.\n\nREAL PUTTING\nSwing the putter with your own arm. The ball rolls true on every tile, an aim line helps you line up, and you can play right- or left-handed.\n\nControls: swing to putt, A / X to jump, B / Y to stand at your ball, left stick to move, right stick to turn, MENU for everything else.", "short_description": "Mini golf in the sky. Putt across floating islands, then jump the gaps between them - hopping stepping stones and riding moving platforms to reach the next hole. Ten colourful worlds, 60 holes, and online multiplayer with your friends as ten fun characters."}]}, "developer_name": "Citiview Studios", "developer_privacy_polic
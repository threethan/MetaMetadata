SEh3jU6FnpDOIUg1LXqmFnSAVciCMq3cFF8bA3zpoJEp7vnwmi4vbWuONjO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkcxDOJyGmeJmLfKpOMMpuA1RDwUyqBongqg9obSEtjQ&oe=6A9C26BF"}]}, "id": "731253083021982", "locale": "en_US", "screenshots": [{"file_name": "2560x1440_2 - \u526f\u672c.png", "id": "1770675050484967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820219_1770675053818300_490007869250672253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoniBT07h7YQ7kNvwHApPGA&_nc_oc=Adr6O2-__l5PO5xtNOVXB66gpwXWC3D1sDJQlsT0_Yy3wsHjHs4psbSoLeBQdfY9dkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmUojAOAKvOMB0dkkHdKeG6s2mbt_L3sS5HHHzU7ODnw&oe=6A9C2CC4"}, {"file_name": "2560x1440.png", "id": "3718255158467055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819934_3718255161800388_8283147924584031865_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcpoBjR1BNcQ7kNvwE-ZhQr&_nc_oc=Adp1m_qreOyNiWDZiSCLjqwC-rz3zgdSR0a-iKdwK5BjWlSyWnYR9p6kZehAfPsPdCw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwTjPwo7Nr-0Go23bzVv1P7VQeEFeybdp2eY0b_MU8zw&oe=6A9C260A"}, {"file_name": "2560x1440_4.png", "id": "617233111453740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828806_617233114787073_5994511412438203115_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05FUDZcjBj8Q7kNvwEC_stY&_nc_oc=Ado65GJZo-E8B7ghN8ivvjU-MAyWj2YYHKpsiB-x05JtWq9lid9LJKOjKkLc0jOBRvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWOCPjdHYM6eykbkGinGHTE2YLKGRjb3QvnXfKJhYv9A&oe=6A9C2634"}, {"file_name": "2560x1440_7.png", "id": "2247657765656125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830607_2247657768989458_6101317861083012441_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boK4CIbJE-AQ7kNvwGl6XTL&_nc_oc=AdrjjvQ791IG3JhfwGmAk57YFJ3aWAXxSyh7m38VnMHKavjAWdbmJSqn5Fhb2ia_za0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8zr3iAVB07ErVUVEO6fkv16QYh0pkXnwsXTRNhvFwCw&oe=6A9C13EC"}, {"file_name": "2560x1440_6.png", "id": "1097203975679990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830888_1097203982346656_8852316981528730531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HtW3J4B6yYQ7kNvwEUv9Dh&_nc_oc=AdoLP8vzPegNb1duKc_uvociXqpVCrZj1dBMwUNavyNaw3NRrT7i5rmZdlA2KaabL9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuD3xit9sB4-CKYhBzjIvsFzuOy-1OyxZETYJI-vXGlw&oe=6A9C34AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DungParty", "keywords": ["bug", "insect", "microcosm", "party", "skin"], "long_description": "\ud83c\udfb6 This is a \"flavorful\" adventure and carnival! Transform into a hardworking (and persistent) dung beetle in the microscopic world, immersing yourself in simulating the life of a dung beetle. Use your pincers to grip the ground and crawl, keep pushing dung balls with all your strength using your forelegs, or grab dung balls to hurl them as weapons at enemies! Crawling, grabbing, throwing\u2014truly \"pushing dung balls with your own hands\"! From mud pits to flower clusters, keep rolling to make the dung balls bigger. There\u2019s only one goal: fetch fresh cow dung and horse dung from far away, and host the grandest dung ball party on the grassland! But the journey won\u2019t be easy\u2014sneaky flies will try to steal your dung, grumpy bees will come to cause trouble, and ants and pill bugs will occasionally \"help\" (or hinder) you. You\u2019ll constantly engage in fun offensive and defensive battles with these interesting insects.\n\nAs a beetle, you can climb anywhere: mushrooms, stumps, mounds, even your friends! You can also switch to your desired dung beetle species skins, showing off your shiny, handsome carapaces in various colors to your pals!\n\nCrawl into tree holes, light up mushrooms as lamps, host multiplayer dung ball parties, and unlock different mysterious endings through diverse gameplay.\n\n\ud83c\udf89 Roll on, warrior! Your dung ball kingdom awaits you! \ud83d\udca9\n\ud83c\udf3f Come on, let\u2019s join this \"flavorful\" grassland ecological adventure together and unlock the joy of the carnival party! \ud83d\udd25\n", "short_description": "You transform into a dung beetle in the microscopic world, immersing yourself in the habits of dung beetles through climbing, pushing, grabbing, and throwing dung balls. There are various gameplay options, such as engaging in offensive and defensive battles with ants, pill bugs, flies, and bees, lighting up mushroom lamps, and holding multiplayer dung ball parties.\n\nCome on, let's start the joy of this \"fragrant\" adventure and carnival from the perspective of a dung beetle!\ud83d\udca9\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/67ce17ee-0fd9-4b46-9bdc-e45682252535", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/DungBeetleCarnivalParty/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24082056864736843"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1351675136911342"}, {"status": "PUBLISHED", "id": "842570588783298"}, {"status": "PUBLISHED", "id": "1346008753473718"}, {"status": "PUBLI
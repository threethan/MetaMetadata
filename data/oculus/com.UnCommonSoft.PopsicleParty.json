x35l0J_VSPz3vmdX3rGE_leBECVo6Yu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Sbej8T8rvpyblY0tEazW2AEuaC7GI9kfumnwaDLoXtw&oe=6A3BE88A"}, {"file_name": "2560x1440_4.png", "id": "617233111453740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828806_617233114787073_5994511412438203115_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4p9X-Na9lUQ7kNvwFA3k6g&_nc_oc=Adr7NvJgJRGtvrWliisq6Qvr-21brueOBxSls6KG7lQaziN9QEyK8BZsDLhTm768-zE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VNXTnuwKO_rMc3LZf8n7OVN8TrQ48nT6kbizDGlKbQg&oe=6A3BE8B4"}, {"file_name": "2560x1440_7.png", "id": "2247657765656125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830607_2247657768989458_6101317861083012441_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwPHxabd_0YQ7kNvwGBAdiB&_nc_oc=Adqe_il62-m1dz9nFus-0SruAPFd27X5mvHnr-oPX7saAiM79mBEYm8e9DMumLRfdns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_55eHZgY5rZkaSgxyJGuPZ1VJB453Onmgdm3953TOLMw&oe=6A3BD66C"}, {"file_name": "2560x1440_6.png", "id": "1097203975679990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830888_1097203982346656_8852316981528730531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjtiDeINhTkQ7kNvwGrwqO4&_nc_oc=AdpH16tIGKuvWy1GwluW5w_ebMkcA3f81iZ3sLOPMlQfYGXUX_LvxzvBPlB1GaUIXN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GnJeuG14mO02lzNroTndtnWKxpO3NJ74w2tLH_sGtBA&oe=6A3BF72F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DungParty", "keywords": ["bug", "insect", "microcosm", "party", "skin"], "long_description": "\ud83c\udfb6 This is a \"flavorful\" adventure and carnival! Transform into a hardworking (and persistent) dung beetle in the microscopic world, immersing yourself in simulating the life of a dung beetle. Use your pincers to grip the ground and crawl, keep pushing dung balls with all your strength using your forelegs, or grab dung balls to hurl them as weapons at enemies! Crawling, grabbing, throwing\u2014truly \"pushing dung balls with your own hands\"! From mud pits to flower clusters, keep rolling to make the dung balls bigger. There\u2019s only one goal: fetch fresh cow dung and horse dung from far away, and host the grandest dung ball party on the grassland! But the journey won\u2019t be easy\u2014sneaky flies will try to steal your dung, grumpy bees will come to cause trouble, and ants and pill bugs will occasionally \"help\" (or hinder) you. You\u2019ll constantly engage in fun offensive and defensive battles with these interesting insects.\n\nAs a beetle, you can climb anywhere: mushrooms, stumps, mounds, even your friends! You can also switch to your desired dung beetle species skins, showing off your shiny, handsome carapaces in various colors to your pals!\n\nCrawl into tree holes, light up mushrooms as lamps, host multiplayer dung ball parties, and unlock different mysterious endings through diverse gameplay.\n\n\ud83c\udf89 Roll on, warrior! Your dung ball kingdom awaits you! \ud83d\udca9\n\ud83c\udf3f Come on, let\u2019s join this \"flavorful\" grassland ecological adventure together and unlock the joy of the carnival party! \ud83d\udd25\n", "short_description": "You transform into a dung beetle in the microscopic world, immersing yourself in the habits of dung beetles through climbing, pushing, grabbing, and throwing dung balls. There are various gameplay options, such as engaging in offensive and defensive battles with ants, pill bugs, flies, and bees, lighting up mushroom lamps, and holding multiplayer dung ball parties.\n\nCome on, let's start the joy of this \"fragrant\" adventure and carnival from the perspective of a dung beetle!\ud83d\udca9\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/67ce17ee-0fd9-4b46-9bdc-e45682252535", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "web
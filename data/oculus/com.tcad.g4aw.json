ment through natural VR interaction. \n\nIn other words, point at everything you see and listen to the nice sounds!", "short_description": "Go for a walk through a world of music with your canine companion!"}]}, "developer_name": "John Joseph", "developer_privacy_policy_url": "http://thecoloraddiction.com/g4aw_privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "The Color Addiction", "support_website_url": null, "website_url": "http://thecoloraddiction.com/goforawalk", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "EXPLORATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636174614273279"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035306_1128756113983363_2158733400003837952_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMy-IJYkOuIQ7kNvwHdtqS2&_nc_oc=AdqqAFFwg9VmvHN5TEXxh_2oCTVDq8GdkmYXR9LtkzPi6OtsHNv_I0Ar5GIw2SCVF88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1rH_2gMNVCPLohfKZ-0yS2ZAzU66x13hqlJjR-YkFsGQ&oe=69F09BDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Go For A Walk", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1578592815, "lastRevision": {"nodes": [{"id": "1922886801348213", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1795066593933270", "is_first_party": false, "enables_in_app_ads": fal
bFk2FarLOCgy5mU1SP5A&oe=6AFC7D1A"}, {"file_name": "carroll2560x1440d_2.png", "id": "243426440584290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974557_243426443917623_1920693179965736549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zO8jNKQv6YQ7kNvwFbQXOZ&_nc_oc=AdpO0iwVcO2OJRMmkqI0aPdtEAnrdEX1xpzFrPeDJ3FyisOiSodohyaw5wszulLD1ZQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNpFdSRx2hF6yimNhUfWVoKKtEn2M3fYHu1BjaOsfYTQ&oe=6AFC7261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "carroll2560x1440d_2.png", "id": "2347534712057196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982715_2347534715390529_5894851663346044801_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89WxdXsbJgMQ7kNvwEsn7iC&_nc_oc=Adpu26NU27F-zrBId8Z2w-gJbWxwgBj4H1jAJwe5uo38O-3JNvXq5bdkm3V8Yw-eGfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeLvKL2ayr52--hFvuRFsIbgp_tENJA0leiZ54gC2b-Q&oe=6AFC6F15"}, "display_name": "Carroll's Riddles", "keywords": [], "long_description": "This is a paid preview to fund our further development as we visualize human knowledge in VR. Thank you for your support! \n\nIn Carroll\u2019s Riddles, you\u2019ll play games based on Lewis Carroll's Alice in Wonderland (1865) and The Game of Logic (1886). Carroll's Riddles is a new expression of storytelling and STEAM-based learning in an imaginary place where ideas can be visually expressive and evocative. Alice\u2019s travels down the rabbit hole and through the looking glass are found in classic and modern stories, as subject of many a metaphor and neologism. By combining Carroll's logic with stories and art from Wonderland, we\u2019ve expanded the context and meaning of this legend. In 1886, Lewis Carroll invented the Carroll Diagram, a tool to allow a player to visualize attributes and classifications of subjects. Confronted by interactive Carroll Diagram challenges, you solve each puzzle and gain a deeper appreciation for the underlying principles that govern this world of wonder and delight.", "short_description": "In Carroll\u2019s Riddles, you\u2019ll journey to a fantastical land and play games based on Lewis Carroll's Alice in Wonderland (1865) and The Game of Logic (1886). Carroll's Riddles is a new expression of storytelling and STEAM-based learning in an imaginary place where ideas can be visually expressive and evocative. Confronted by interactive logic puzzles and riddle challenges, you solve each puzzle and gain a deeper appreciation for the underlying principles that govern a world of wonder and delight.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": "https://www.sciencevr.com/support", "website_url": "https://sciencevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "970571560564116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974684_461365885036390_4545596542630897745_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sL0V1_Kj1wQ7kNvwHDEcke&_nc_oc=AdrjA4gl-_f0X5iGr2dt
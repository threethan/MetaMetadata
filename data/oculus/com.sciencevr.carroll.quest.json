2789885414607865", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031391_2789885417941198_4749968781019198653_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvOEx2NCLgMQ7kNvwFgUZHm&_nc_oc=AdpplSoDFU0G1a9Z93XuG94nKTHaraBSILRoiRBE9b4m9zTNUxC8Qi7L9bdBeY-dwUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ2MTIgr35jfSIASlt8nKySfbFk2FarLOCgy5mU1SP5A&oe=6AFC7D1A"}, {"file_name": "carroll2560x1440d_2.png", "id": "243426440584290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974557_243426443917623_1920693179965736549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zO8jNKQv6YQ7kNvwFbQXOZ&_nc_oc=AdpO0iwVcO2OJRMmkqI0aPdtEAnrdEX1xpzFrPeDJ3FyisOiSodohyaw5wszulLD1ZQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNpFdSRx2hF6yimNhUfWVoKKtEn2M3fYHu1BjaOsfYTQ&oe=6AFC7261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "carroll2560x1440d_2.png", "id": "2347534712057196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982715_2347534715390529_5894851663346044801_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89WxdXsbJgMQ7kNvwEsn7iC&_nc_oc=Adpu26NU27F-zrBId8Z2w-gJbWxwgBj4H1jAJwe5uo38O-3JNvXq5bdkm3V8Yw-eGfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeLvKL2ayr52--hFvuRFsIbgp_tENJA0leiZ54gC2b-Q&oe=6AFC6F15"}, "display_name": "Carroll's Riddles", "keywords": [], "long_description": "With ScienceVR's Carroll\u2019s Riddles, you are invited on a journey to a mind-bending dimension created based on Lewis Carroll's Alice in Wonderland (1865) and The Game of Logic(1886).\n\nWe design Carroll's Riddles to create a new expression of storytelling and STEM learning in an imaginary place where we can visualize ideas. We heard about Alice and the rabbit hole from cartoons, books, and movies, so most people are familiar with them. In addition, there are metaphors related to Alice found in many modern stories. We believe in combing Carroll's works in mathematics and logic with stories from Alice in Wonderland. This experience will be both entertaining and educational.\n\nLewis Carroll invented a tool - the Carroll Diagram(1886) - to visualize the attributes of things that we re-created in Carroll\u2019s Riddles. Aided with this interactive Carroll Diagram, you can only make your way out of the tree hole by tackling the logic riddles. ", "short_description": "Start a journey to a mind-bending dimension created based on Lewis Carroll's Alice in Wonderland (1865) and The Game of Logic (1886)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": "https://www.sciencevr.com/support", "website_url": "https://sciencevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "531090975115318"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "504805104015995"}]}, "baseline_offer": {"id": "504805104015995"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617319560, "status": "PUBLISHED", "id": "504805104015995"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBin
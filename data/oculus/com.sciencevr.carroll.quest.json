5A3qduKRm-ZeN7rYvBVA&oe=6B05B79A"}, {"file_name": "carroll2560x1440d_2.png", "id": "243426440584290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_243426443917623_1920693179965736549_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Db4fPYlJ-oQ7kNvwGan45y&_nc_oc=AdrKlB9Xi7CAfsS7cMLNQ0X_VCBoGIuw6V__dGU3M0pKt8g-2h3oyKASLwGyD3uFduE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo1BsFLoyjqXXv8UGf2vj07U20yuImFOJ--wRGS2uEtQ&oe=6B05ACE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "carroll2560x1440d_2.png", "id": "2347534712057196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_2347534715390529_5894851663346044801_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Etvx_-h7RsQ7kNvwEMLYNc&_nc_oc=AdqKuuhAZCif86HSPN3vh_BLiCP3L6DWgGTdm74a59BwvWo5TbsmuAgLb7T3xn-FKXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgDr25QVb1i2UB-XBNnK65Jf5bhskw8giZdipZfq95pw&oe=6B05A995"}, "display_name": "Carroll's Riddles", "keywords": [], "long_description": "This is a paid preview to fund our further development as we visualize human knowledge in VR. Thank you for your support! \n\nIn Carroll\u2019s Riddles, you\u2019ll play games based on Lewis Carroll's Alice in Wonderland (1865) and The Game of Logic (1886). Carroll's Riddles is a new expression of storytelling and STEAM-based learning in an imaginary place where ideas can be visually expressive and evocative. Alice\u2019s travels down the rabbit hole and through the looking glass are found in classic and modern stories, as subject of many a metaphor and neologism. By combining Carroll's logic with stories and art from Wonderland, we\u2019ve expanded the context and meaning of this legend. In 1886, Lewis Carroll invented the Carroll Diagram, a tool to allow a player to visualize attributes and classifications of subjects. Confronted by interactive Carroll Diagram challenges, you solve each puzzle and gain a deeper appreciation for the underlying principles that govern this world of wonder and delight.", "short_description": "In Carroll\u2019s Riddles, you\u2019ll journey to a fantastical land and play games based on Lewis Carroll's Alice in Wonderland (1865) and The Game of Logic (1886). Carroll's Riddles is a new expression of storytelling and STEAM-based learning in an imaginary place where ideas can be visually expressive and evocative. Confronted by interactive logic puzzles and riddle challenges, you solve each puzzle and gain a deeper appreciation for the underlying principles that govern a world of wonder and delight.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sciencevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.sciencevr.com/terms-of-use", "publisher_name": "ScienceVR, Inc.", "support_website_url": "https://www.sciencevr.com/support", "website_url": "https://sciencevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "970571560564116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974684_461365885036390_4545596542630897745_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGgTNQjiRogQ7kNvwFu4f7l&_nc_oc=Adrpq69kgGog6dPNRCn-
bwvqlOmF4WQNjKuFVHzn-XP8Q&oe=69B164D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2 - Cover Landscape.png", "id": "2857868737799309", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974654_2857868741132642_952107251669802106_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT_MHNXeDxcQ7kNvwHRi29w&_nc_oc=AdmkzQQPg75o_uUd9TLf1HcTWpeP64gqwaDWddqcWU_QPFh8f6D-_Z_5UfKudCgM7aA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNCoyywYy-UMw7Ti3JG6MeRAOLHsruNd1vHNLgZ-1G1w&oe=69B14A91"}, "display_name": "BaselineZ", "keywords": [], "long_description": "BaselineZ enables a new way of visualization and exploring your 3D Geological Reservoir Models. Get started with the Tutorial Mode, which gives you an introduction to 3D Geological Model visualization in Virtual Reality. Next, explore the various 3D Geological demonstration models that are available. Start playing around with zoom, pan, rotate, and the various visualization options. When done with exploring the tutorial and the demonstration models, Sign-Up to get started with the visualization of your own 3D Geological Models!\n", "short_description": "BaselineZ enables a new way of visualization and exploring your 3D Geological Reservoir Models. Follow the tutorial, or start exploring the various 3D Geological example models that are available. Start playing around with zoom, pan, rotate, and the various visualization options. When done with exploring the tutorial and the demonstration models, Sign-Up to get started with the visualization of your own 3D Geological Models!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://baselinez.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Craytive Technologies", "support_website_url": null, "website_url": "https://www.craytive.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "conte
g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip7npu2VwiEQ7kNvwFwVQ4x&_nc_oc=AdoUZIubcJ7b_A_nIt9CUl7ZP_c-e4o6kT_Z14CXeVu2kygQJFapEV4qufC4Q63tkKE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuv1Zx2Ayrbx1MMZ1RPelzEmJwYDQl1W875bBQMtKZUA&oe=6ADCBC21"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9OIAcyiFQoQ7kNvwEzDIxX&_nc_oc=AdpJHHP4E8tNgM6G7-zklcYn9gAyUCgC8S4_0nqWC3Jy5NROQtaO5ed4g0skozO7Alw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAl7uLHe09_M1tsul9Bvhylyb0alvbgGK0jlJyoubhmg&oe=6ADCD44F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7annVUsYBJEQ7kNvwE2XqHF&_nc_oc=AdqZU9nOsCUL7Rev8T6cYs3_4Buuii29YOYAwUfvK-pgsk_pQo__U31sKS7eYNCdVks&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7F1qpmsfPX3k5BwTOWnduLWbzOXB13VmM0vbm-vNgRA&oe=6ADCA269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4L00TFtMDAQ7kNvwEILuQA&_nc_oc=Adrj38nu3366RcOwDB4-e1WZy3BpN10hGtSD1G4qcs6YG6jAlNhyZE6_luAP6Np94F4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObZ2qXzBabVdJo_frm9y8LXoK5_QLUJImyYshm-U_7wg&oe=6ADCB88E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28144609651820068"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id"
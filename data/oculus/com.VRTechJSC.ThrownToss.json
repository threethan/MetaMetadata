dn.com&_nc_ss=7f20f&oh=00_AQS7Cx8WuS3fY_krG6er0BsJizBewzvT2m5NoY0nt1saMg&oe=6AFB3923"}, {"file_name": "Screenshots_4.png", "id": "1332512364425436", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468725201_1332512367758769_2493834518282663623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzD-Iit4UzsQ7kNvwGAY5JC&_nc_oc=AdqrVWlGVebMYnvbDcvT1I9vtNI1sU_r0m7g7RONQYzxyPp1r20ExzSux2_fd5sClwY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuq0njHvGzKSJ5gUO5gNIM5bmrfy_sP9uK2t44yOGxrw&oe=6AFB46E1"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXfamAZflhkQ7kNvwHY2zLF&_nc_oc=Adrl-sPmcAdN6hNviCztaP9Eju3oTZIXwM031nKyuHbNaRe5f38226XUtsbCNID5ma8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs7o6FFZGT-_dEKF3dtHCaiaNdbbuL1eNQadzvWcrInw&oe=6AFB26CF"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGQHKXEZt3MQ7kNvwGxjV_u&_nc_oc=AdoafIrMZl24Z2rUaXEP5FdIVjDDINcdtXHuJenz7_VIZOmSty0KEAW1TeN_rzi0zyA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8c17663oeGqllC98WJz2UFUEtf0nt3ouNBTg5xyKzfw&oe=6AFB2D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1WhKfLm-1AQ7kNvwFsTpPm&_nc_oc=AdpLYs70qsR_H0KxEeRRiyobypeeF9Raju9iGVK3p5ti1r59cVwIoCZCAEmV_MBopek&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7ULRM8W-ldlNYLwIuMnD8w-XZJOV9ftoX2m0ryTgx-A&oe=6AFB434E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
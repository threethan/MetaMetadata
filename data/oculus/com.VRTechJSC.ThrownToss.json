OIJwvjRP99OgPkuiTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg49P0DctjrQ41wZXCaUZxX_gIYD2KWv1vwZjsxTqpjg&oe=6A4BB721"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz78fyhgObYQ7kNvwGL0W8j&_nc_oc=AdowTA8NIbLv-qc47HFEIzpWp5SMIq2IvDh1d47Wns79ZrQ77HnkVuKenBGIGAUCL1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqYyiaDJwb3ZxABkKdYnHtRi1GbFVktKFpaTZAMtkUrQ&oe=6A4BCF4F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rJUN44qviQQ7kNvwG2sVPK&_nc_oc=AdqRcMOZ97cfpPGD6GUSKwbSkd3tpXIxY_K1OUvkfdRv4ErjqIQCiarhR8psnepvFkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUCitJ5rhvmAnqdfip89haBM65un5LJ0JLVsuK3Msm_w&oe=6A4B9D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q345HnfpsR8Q7kNvwE_0GKv&_nc_oc=AdpO9JBAxkCSx0N9R9lOEEHBUQnV57SJx3zP-aN2fQgtRBdW16dGiEXCIOjQwsR0uT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV9XkJcdRLTqidYeusIiAxej2c6D3l5T9Q4QMPn1DqMg&oe=6A4BB38E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28144609651820068"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1549727436520928"}, {"status": "PUBLISHED", "id": "1035297142781029"}, {"status": "PUBLISHED", "id": "1665805121219563"}, {
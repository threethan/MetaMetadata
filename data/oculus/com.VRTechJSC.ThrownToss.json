g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2tXTNlnKsQQ7kNvwGG3VNr&_nc_oc=AdpPPvvjrjcRKdJC2vJ1AGU4heqEYJom7d1a3tUjunn0F6mFBmd1Ah13H4_CoEPUZyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYTeu0xSMsg-G4iHk_zt9SDWkHcJf36T1rKsbL1-KuZA&oe=6AE20221"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aarYOH35zl4Q7kNvwHv8h86&_nc_oc=Adp3mT3p6OYqBuNNp1eC5HCoeyyQ3BCMcBSNDsNWAqycV7gYoExkJK374sC5NgXiQEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmYW3bgjXOJzvZZMNLmzRRigbsRJLAIZcFdZl4WrlljQ&oe=6AE21A4F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B850wDR9BHQQ7kNvwG1TzZz&_nc_oc=AdrRQH9G49sRD-qfCvsFFv_6S6jb6PHbLZpIfCgtpAywq9-Jmbt8ODCRs_AwnPNAMqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm8LEqdlJ755mJAXEp26tIAmnQK6qK3oxe2i9if2-_wQ&oe=6AE1E869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4I9KWQV4R8Q7kNvwHVESJk&_nc_oc=AdrxsqYm0jUk6_gzdOrx68sSfX2uRUtsDVJzScrB-SImNXluDFKywwcB6NSGkS5z474&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcMY_IBH1YPJ7FaiTw6mBQVpFc8IFn9Ce5AbbTbsFrGQ&oe=6AE1FE8E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28144609651820068"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id"
g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND1hJ0dMuaUQ7kNvwHAeIff&_nc_oc=AdoCYtAy7pvM4TU5bV6qS7YKhJooBbeUNgtJdR22C0F6QepHCRhllJS2_7nwtPs0-5s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM_iZt1x9xnZMOkYGen_WxkagCp0SULtCeID9B6rHB6w&oe=6AC50121"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-NDjWyVu8EQ7kNvwEVp8E2&_nc_oc=AdoE4N4QTuztDQHa_FL-o6VeLZdcNLv2fE6InCzmEv9jL37xHz6kuNx_roVgssWdhVg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMfMBMCp2rhu_cfw7Mt3VfSCj7cpS7J2Yl7j9BOXD2rw&oe=6AC5194F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9jzk4PFZkEQ7kNvwEYvPlr&_nc_oc=AdrRtxkkj8pQETl0zVQCVJgT7Yv-E7ZElaqA2FECREWsYvH3sjAHdIOPAabGXyf1xyc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSop6cCgNjjQ58VhZSdRe26gvliZ_uKdF1ZMHr7D6j4w&oe=6AC51FA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fA1t24OZGTkQ7kNvwHJMRBC&_nc_oc=AdqwfNnH6qYtBDSgoAim76OGGan6q5s_PFKd2D0qz4w-TtJQ63hJjcpRHJm2D_7xHBU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9lsv0G6tLHGEyj1ShFms877OWOzJMNg6jAixfJov6lw&oe=6AC4FD8E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28144609651820068"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id"
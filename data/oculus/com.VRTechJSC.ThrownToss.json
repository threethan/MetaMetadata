dn.com&_nc_ss=7f20f&oh=00_AQR71GxzqhwUiXBQ2lvAq-ffWWRNsXT4lX8J3V1Sd4GlAA&oe=6AFC8AA3"}, {"file_name": "Screenshots_4.png", "id": "1332512364425436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468725201_1332512367758769_2493834518282663623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzD-Iit4UzsQ7kNvwGf3JvS&_nc_oc=AdrkmOGhoxXy1IqEBrHK8NCz-EfxhwkM07a5oWdmi3DapdZ2eaKh-RubJczh4DVGVvQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXXaqt2jqpDiKYrw7GNkkmBUWdx27PJTe8uUX6laWrIw&oe=6AFC6021"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXfamAZflhkQ7kNvwEC9r5P&_nc_oc=AdreQVBEK1eZr7Q7o4ymTqkDcRfnidIGVEXJHhq2rE4QJ_6EHyZ7Tr32n_s1LCHoDtQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPyk3B1ChD4iwHUR5ZkeVmSkuSqKwxUTl9DSHs3Xz2xA&oe=6AFC784F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGQHKXEZt3MQ7kNvwH0fPku&_nc_oc=Adr38Ky9BhyqeTNd6wroR90JSEDHEowkHNUvolVYRqFkNHs6hQohaFMgKjkTL9jtr-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZRLrwk7Q0R11BOqQmt3DWHsPo3KW74pJJ-duwA81VQA&oe=6AFC7EA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1WhKfLm-1AQ7kNvwGL98ur&_nc_oc=AdoL2Fg1A6IzRnBDjFDeU4JuGATjq260dfsjzoZuwJCK2uLNY6PnVPt9ni7lu8SctVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRct2_Wh1nKeUHQ7M0xJbD5aSAdZmoEqNd9GlFeNFMUg&oe=6AFC94CE"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
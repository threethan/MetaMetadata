dn.com&_nc_ss=7f20f&oh=00_AQTXhYugvPoy4DiXaO2eYd2_Fz0iKjg73uzyRnxrelGWuw&oe=6B086823"}, {"file_name": "Screenshots_4.png", "id": "1332512364425436", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/468725201_1332512367758769_2493834518282663623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeKqGpM0P18Q7kNvwGuiQ-U&_nc_oc=Adrbpv3ABXSgIdaOuthCMPs4g1fNMfoPs05en0THcGFVKRT4MqGV09iDhFvXmLqtSFg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKJ0fcI8osLaH7O8RkZGeEG9cMv_RE24SuvQP3PVkfsA&oe=6B083DA1"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwYV6zp38ccQ7kNvwHjiIoX&_nc_oc=Adrwu0SwWjohSZMqDrTqjFGwTiGY8zaWh4Ekcp14Nex2rmTQkD4eC1v1pb6ijSG8Ruw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFf2SRBrblaWxPmOWoiB1sn71TlOPs-WQ7n80bZfIZMw&oe=6B0855CF"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwLXs8BDRYAQ7kNvwF8NWF_&_nc_oc=AdqTw2pgoUSe7BdZgHmrGqgK-Qp4l-Un18bERq64FAkIHPZ51rP-UJtR3FhvTf951qs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNbIfzcDT4jMzf6-_CVJrVLo4GKgQdqvCUlM8GJHhLng&oe=6B085C29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmmqKsUG9ycQ7kNvwE-rFnW&_nc_oc=Adockf0S6LPiwajXlcadd3WtS2He7XTDalcMoRzXxwjRPDn1kQYWW_lLujZiFTtOXK4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQctGD0mWsis02zYNUjVLKsagV-zylL14H0BplCfwWUgw&oe=6B08724E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUIGUf8VBKoQ7kNvwHncCR1&_nc_oc=AdoAyyk9n11EvlH3BCPmXwalotVo-CrqhD7ePVlk7F4pVfJ1PDBSG8NR9D_nZUx66rA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTjdAXNbGKWdC1AEA6s4_Px0owrfvr1WeZE64L8G7q5A&oe=6AEC8E21"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dABFyqz-nsQ7kNvwHiEnoU&_nc_oc=Adra_UKF-fErhG9sOd-qGpMrQ8Pnarg3MV0mmohzKYJtBEEfZTPqfa61TUoDaVaox1Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuWp7T0TFaB74SRGVDAu3WwmoPRf6ZX0fFr-Sk3GdYCQ&oe=6AECA64F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4o_Vj_lpAVsQ7kNvwEzO2qs&_nc_oc=Adq9bLv_TXssokRGiij-mL6ggOba99Gr40i4o2UodgXn_4SmYZbeaHlOQYuVug5220o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRog45bSzKpkRoBNjgwnwV4QJarv8s_z4vUAwOlX7BeTw&oe=6AECACA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMrUpCihBKsQ7kNvwFMHlSu&_nc_oc=Adoak5yUrcDwm2vdEDpp_ATVVHLz6anT9bozRaFyYnaPU7Asy0SY2COPWYsv9VSxO6w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbf18TDY9EKoaOTK5EBjNzHm5nbuNO32I7eWpvUt9RCw&oe=6AEC8A8E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28144609651820068"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id"
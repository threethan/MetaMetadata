g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlbpprYHoaEQ7kNvwG_avC6&_nc_oc=Adq3T4AaZdfuhdjxXoCkbhCjs5yujh3RBrabm690olxxiD6EGTkHxQ6dL_krYe5J5ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb-1FjM4lNjC1qpPO7OdDUhrcXFWmZvbHao1SRu8I91g&oe=6AAAA321"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzK6BxOzyM0Q7kNvwHFpHRl&_nc_oc=AdrPFklH3fMYOY6G2fQNEPOViTlRqt_CXJY0SdvnOQgQgdVSmnQdu6eqQn4FaM_HcKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcS5rJ2-AkA5I6J_0MjUP0ruzIBVIa7siH0xyQFZRTAw&oe=6AAABB4F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_7xqoirNboQ7kNvwGbhytR&_nc_oc=AdqzHHPPG1RBLzNQe24xhS-uI1GAR7CbR7JKPQ8A1hSbyuXX97V_F1uwJ3StRgKQbnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgC-tUbuJ85vImmpWXL7URyKZvo37nhSPidpqcIkeq4Q&oe=6AAA8969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LinrPC6hs4UQ7kNvwHpL4CC&_nc_oc=AdpfHwxF8hRZ5_dqlVx71fjfYcf9_563ob_2yx8IwYR-gra5Smn1KrHnwfLeH3lB72U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCRSAGdmygCHchJTJA3cy5V_zzRQQ3JtIuGaWbdfuT4Q&oe=6AAA9F8E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28144609651820068"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id"
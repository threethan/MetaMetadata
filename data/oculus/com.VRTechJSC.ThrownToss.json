dn.com&_nc_ss=7f20f&oh=00_AQSJymXUioxMDjl5F3j7_bhLQ6LyLYk-oQdYeouri4xadg&oe=6B05C523"}, {"file_name": "Screenshots_4.png", "id": "1332512364425436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/468725201_1332512367758769_2493834518282663623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeKqGpM0P18Q7kNvwHHybL0&_nc_oc=AdrB-IVlh-bw1R_irDVk-OddqMY2eXfxlDf2gU0WaerKT-S3rzSTW2d6Vrm5uKVewIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMVLmIL9GMkMDbiFcEVi0XhWgF8-na9Cvof9Z67z1Tag&oe=6B05D2E1"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwYV6zp38ccQ7kNvwEEeibT&_nc_oc=AdpVthAZtc0TmbPTL1l6zOnHoxXjQ-94eGvWDfEElck2OMP8gKSHDIU7vysbJL2QsBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmQYat1ATZPg43234Vd-uuwsNgTuHHoXxFpK09Nov3Kg&oe=6B05B2CF"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uak5ALRZxFYQ7kNvwFaaGZ4&_nc_oc=AdqFUmdkNCrImFkW8Vkp1yaxpnusEJrYlvER0_JuzRAuDAPLBYy3aO4-7JolaP64CE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0vH1qMzrnZM9n82SqM8C0h0ZLsDEPiMt0iIw4S2xB0g&oe=6B05B929"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmmqKsUG9ycQ7kNvwHg6epw&_nc_oc=Adqp3aqUCGTqdgP6LnMWwwevpjuIUHraVUXFQFei4tKpA8rJxQ53sENitZD9Iuse6ts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCsTIdnqdhi1CeKalUHXSciTak1_4fU4KDbYTaOfmTxA&oe=6B05CF4E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
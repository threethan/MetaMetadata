dn.com&_nc_ss=7f20f&oh=00_AQQ1QA_7YrYtjQSX3JajgqNfqrzleP399Tnuq9JaNmtPjw&oe=6AFF2DA3"}, {"file_name": "Screenshots_4.png", "id": "1332512364425436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468725201_1332512367758769_2493834518282663623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR1XLlH5thgQ7kNvwFeGIb8&_nc_oc=AdrukpdPB2CqZnKS5ceZ4mWHXYOsLu1Jvo8EGnQ12vxr6D7mIpGW5T13PSUoH0XbDQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrwv-xs5JRjWs0bGs_mpg2XOpyhcPO5d2bVKa4p1fx-Q&oe=6AFF0321"}, {"file_name": "Screenshots_5.png", "id": "1778999639527408", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/468782274_1778999642860741_919755812166933756_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZQvZmv54xYQ7kNvwHWcEAM&_nc_oc=AdrBL57_Dr1Aaxz3zG90pJ1LHSRk2WSQH-Q1eUke6hgZTgAFaXxZOt2B_7bSSpiwIMI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIQAibf69R7rPNFVjn6bxCaqdZBEQOJbsf1GasNhYKXA&oe=6AFF1B4F"}, {"file_name": "Screenshots_1.png", "id": "1770432533691421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974628_1770432537024754_5636662912625262115_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O35MVc-FM4MQ7kNvwGjrm8r&_nc_oc=AdqD-070dgTwgncwdNQqxnaQcGMmQ-4nWx6mSXWZQc9wZsM5BnP2zcy5n0YX1I6oc7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg8p_2oLiFuSFQh7j6TTWo2hczu2BC2GhzgoSJVpJNLA&oe=6AFF21A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "588727970778899", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57568683_588727974112232_7157595735585792244_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxnWEBDx9NAQ7kNvwGDpJ0_&_nc_oc=AdpZp9blAQG_LjgTa_DSDardksz8-zrbv0dYT27S-q0NBSxS2Gu5axhbtHHb5mqswKM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSatoosNYWUbIgRuMhTH-DeBRtNdevO8Gx-IGmFeKFnlQ&oe=6AFEFF8E"}, "display_name": "Throw n Toss", "keywords": ["throwing", "toss", "casual"], "long_description": "Dive into the thrilling world of Throw n Toss, a captivating VR casual game. In this immersive experience, you'll embark on a journey through exciting levels in the Campaign Mode, where conquering challenges unlocks special rewards.\nUnleash your throwing skills in the Throw Anything feature, where you can toss a wide range of random objects to rack up high scores. Each level presents unique items, making every throw a new adventure!\nChallenge your precision in the Ring Toss mode, where you aim to land rings on targets for bonus points.\nAs you progress through the game, you'll earn coins in both modes, allowing you to upgrade your experience. Get ready to throw, toss, and triumph in Throw n Toss!", "short_description": "In Throw and Toss, every throw counts! Whether you're competing for high scores or simply enjoying a friendly game with family and friends, the vibrant worlds and engaging mechanics ensure hours of fun. Grab your VR headset, warm up your throwing arm, and get ready to hit those checkpoints like never before! Embrace the thrill of tossing and become the ultimate champion in this exhilarating VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/931bda30-41d8-41b9-b478-4141b7bb2e9a", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
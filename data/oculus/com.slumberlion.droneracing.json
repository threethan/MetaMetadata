scdn.com/v/t64.5771-25/499317894_685600070744862_3995715964492546632_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32aSMU29MC0Q7kNvwH5eQrj&_nc_oc=AdqfbD8HeoYpscUHo6AwMlmWfurpWldhcqj6WlrKZaMrfBGLkI_FjAMjAfEeKK4-djM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRexqP6G2lDCvv46YDjWuTOQS0dQOaBbg-pKSwLed0nZg&oe=6AFDBB77"}, {"file_name": "ss4.png", "id": "1191527102660451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308194_1191527105993784_4771376574341556239_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0-ItgGE2_gQ7kNvwGZWT29&_nc_oc=Adqtja4GXhh0wkOVUHGVBRKzc5cti3pOgJo5KfjzdKK-9H4VTe39ZgOmUMEuBqh7Ym4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWj0CfZcLvqQifOeVN_nViH4vuqOC6AmK7CNRW-QQiUw&oe=6AFDBDDE"}, {"file_name": "ss5.png", "id": "558205100400427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300574_558205107067093_4830250981905564323_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sbYaCt7hUMQ7kNvwECuaCt&_nc_oc=AdoREP9yZII20g54wM9SiISu96q6TvMgjDDOiii5yQAZw6bY2-y4JeZuimtEGbirWRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDm3qJ14o7JyMJ5jiQwzg9TQfh1cvKLFKAQNc7BZ1fyQ&oe=6AFDDC0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DRCover.png", "id": "685135500891719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298254_685135504225052_8965096047718517136_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo0jmXpbWu4Q7kNvwG2nbJB&_nc_oc=AdplU7nkyJ9vSlKVqzC0GASQ1afYB1_8oDgi4hqMHi6RsvlLdm-g4rJOZTaiGA0pfYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH8N-In-UAEyffrwruJ3RoyCTY2Nv_0clVAwQKkRxgPA&oe=6AFDC8BD"}, "display_name": "Drone Racing", "keywords": ["Racing", "Drone", "Race", "FPV", "League"], "long_description": "Welcome to Drone Racing! Experience the thrill of FPV aerial competition in Drone Racing, a fully immersive VR game that puts you in the cockpit of elite racing drones. Fly through amazing arenas and environments in first-person view, where every twist, dive, and turn tests your reflexes and precision.\n\nBuilt for virtual reality, Drone Racing delivers intense, skill-based gameplay with tight controls and realistic flight physics. Compete in a challenging single-player campaign or race against real players in fast-paced multiplayer modes. Earn upgrades, customize your drone\u2019s look and performance, and rise through global leaderboards.\n\nWith dynamic tracks, responsive handling, and a pulse-pounding soundtrack, Drone Racing offers an unforgettable VR experience. Master every course, dodge deadly obstacles, and prove you\u2019re the fastest pilot in the skies.\n\nKey Features:\n\nImmersive VR racing with first-person drone control\n\nSingle-player campaign and real-time multiplayer\n\nSeveral awesome drones to pick from\n\nVaried tracks with environmental challenges\n\nGlobal leaderboards system\n\nStrap in and take flight\u2014Drone Racing is the future of high-speed competition.", "short_description": "Drone Racing is a fast-paced FPV VR game that puts you in the pilot seat of high-speed racing drones. Soar through futuristic tracks, dodge obstacles, and compete in single-player or real-time multiplayer races. Choose from several awesome drones, master challenging environments, and climb the global leaderboards. Drone Racing delivers the ultimate virtual flight experience with immersive first-person controls and intense aerial action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slumberlion.com/privacy-policy/", "developer_terms_of_service_url": "https://slumberlion.com/terms-of-service-agreement/", "publisher_name": "Slumberlion", "support_website_url": null, "website_url": "https://slumberlion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
scdn.com/v/t64.5771-25/499317894_685600070744862_3995715964492546632_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvcINm33sDUQ7kNvwFvO_5D&_nc_oc=AdpLTspJJ-KjED04rmHbe9dSXRT6SCfAQfB-op1H0W8tYOkQlXZmhGfSHzFpunlHt2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Hb2qZ8nKO6SI8WicOm03G4vi5mLRSbFHvqbtP5zm4w&oe=6B05A477"}, {"file_name": "ss4.png", "id": "1191527102660451", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308194_1191527105993784_4771376574341556239_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyzRiltrRIQQ7kNvwFs1GII&_nc_oc=AdofNbyfIjTCF8b6wJouuEbGr1xn7JEHU2ggfTrIovj8j7gvBu4Uk0r3PGujnhlKRLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8T6upyxPCncQ39Zd9kiTuLNQTEJG5K9u9ayTTn_g9Sw&oe=6B05A6DE"}, {"file_name": "ss5.png", "id": "558205100400427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300574_558205107067093_4830250981905564323_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lye6ZJnKCZgQ7kNvwGV2QGI&_nc_oc=AdqR46mhUg4cJL-ibEXimgZTnT7PNJNhKruuVOjLN3TmQ05cjpijTK66Mwxhwq-NFV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBrcNp5hhWlMXLNNwJy5HswDdyD5LCv0BXdFEnHv6nJw&oe=6B05C50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DRCover.png", "id": "685135500891719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298254_685135504225052_8965096047718517136_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18XdbXYndGQQ7kNvwEDJP0X&_nc_oc=AdqHwo102SnUU8OE6A2TFGbgcaxFVNr87AOIqWPJxA5xNTX7zECuAi_HM7DqTz5wV6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYlLzdj7OEgCkk26rP2cXgAh16MoFnwiButCnlpkpfoQ&oe=6B05B1BD"}, "display_name": "Drone Racing", "keywords": ["Racing", "Drone", "Race", "FPV", "League"], "long_description": "Welcome to Drone Racing! Experience the thrill of FPV aerial competition in Drone Racing, a fully immersive VR game that puts you in the cockpit of elite racing drones. Fly through amazing arenas and environments in first-person view, where every twist, dive, and turn tests your reflexes and precision.\n\nBuilt for virtual reality, Drone Racing delivers intense, skill-based gameplay with tight controls and realistic flight physics. Compete in a challenging single-player campaign or race against real players in fast-paced multiplayer modes. Earn upgrades, customize your drone\u2019s look and performance, and rise through global leaderboards.\n\nWith dynamic tracks, responsive handling, and a pulse-pounding soundtrack, Drone Racing offers an unforgettable VR experience. Master every course, dodge deadly obstacles, and prove you\u2019re the fastest pilot in the skies.\n\nKey Features:\n\nImmersive VR racing with first-person drone control\n\nSingle-player campaign and real-time multiplayer\n\nSeveral awesome drones to pick from\n\nVaried tracks with environmental challenges\n\nGlobal leaderboards system\n\nStrap in and take flight\u2014Drone Racing is the future of high-speed competition.", "short_description": "Drone Racing is a fast-paced FPV VR game that puts you in the pilot seat of high-speed racing drones. Soar through futuristic tracks, dodge obstacles, and compete in single-player or real-time multiplayer races. Choose from several awesome drones, master challenging environments, and climb the global leaderboards. Drone Racing delivers the ultimate virtual flight experience with immersive first-person controls and intense aerial action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slumberlion.com/privacy-policy/", "developer_terms_of_service_url": "https://slumberlion.com/terms-of-service-agreement/", "publisher_name": "Slumberlion", "support_website_url": null, "website_url": "https://slumberlion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
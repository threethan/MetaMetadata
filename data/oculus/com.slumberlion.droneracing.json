6dfGawm8FghMVSp_pipbaNRgU_SSfoOG4jDTSNUPUg&oe=6A7B36F7"}, {"file_name": "ss4.png", "id": "1191527102660451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308194_1191527105993784_4771376574341556239_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkgW3Kwt_NcQ7kNvwGOYFXu&_nc_oc=AdoHpbs5NvlqjGwId3nfEZv6_JKfIDKx78CzuJskY2Om-h202xevGsWQ6hCovVthvSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE45wBeo7EOmJ5BnwItMKXEhdVBC3_QtooTZs_upVX-ww&oe=6A7B395E"}, {"file_name": "ss5.png", "id": "558205100400427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300574_558205107067093_4830250981905564323_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBFLlUR7-_QQ7kNvwFQNfgz&_nc_oc=AdrCm9MbR_-9SVNEyB1qCwxkej8D8B2ofY9nHBEV4h3FD1RlRTxURrXLNcwEtcVHmXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWm31b8kHbboLmva8XBt_4wp5qwTmj4Zf2K8Cq48qIsA&oe=6A7B1F4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DRCover.png", "id": "685135500891719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298254_685135504225052_8965096047718517136_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t91l-6pyARUQ7kNvwG7GnK1&_nc_oc=Adp3WREwe5kO-ymGGGdACceWzSZVH_NdG5MYZXPwQXiB0OybFt7v3_BYaEf4cU-15w4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtDTVVLktBVIG4qZaJ56dFGJfsPd22lDBD3KR_eAvwSA&oe=6A7B0BFD"}, "display_name": "Drone Racing", "keywords": ["Racing", "Drone", "Race", "FPV", "League"], "long_description": "Welcome to Drone Racing! Experience the thrill of FPV aerial competition in Drone Racing, a fully immersive VR game that puts you in the cockpit of elite racing drones. Fly through amazing arenas and environments in first-person view, where every twist, dive, and turn tests your reflexes and precision.\n\nBuilt for virtual reality, Drone Racing delivers intense, skill-based gameplay with tight controls and realistic flight physics. Compete in a challenging single-player campaign or race against real players in fast-paced multiplayer modes. Earn upgrades, customize your drone\u2019s look and performance, and rise through global leaderboards.\n\nWith dynamic tracks, responsive handling, and a pulse-pounding soundtrack, Drone Racing offers an unforgettable VR experience. Master every course, dodge deadly obstacles, and prove you\u2019re the fastest pilot in the skies.\n\nKey Features:\n\nImmersive VR racing with first-person drone control\n\nSingle-player campaign and real-time multiplayer\n\nSeveral awesome drones to pick from\n\nVaried tracks with environmental challenges\n\nGlobal leaderboards system\n\nStrap in and take flight\u2014Drone Racing is the future of high-speed competition.", "short_description": "Drone Racing is a fast-paced FPV VR game that puts you in the pilot seat of high-speed racing drones. Soar through futuristic tracks, dodge obstacles, and compete in single-player or real-time multiplayer races. Choose from several awesome drones, master challenging environments, and climb the global leaderboards. Drone Racing delivers the ultimate virtual flight experience with immersive first-person controls and intense aerial action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slumberlion.com/privacy-policy/", "developer_terms_of_service_url": "https://slumberlion.com/terms-of-service-agreement/", "publisher_name": "Slumberlion", "support_website_url": null, "website_url": "https://slumberlion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCU
scdn.com/v/t64.5771-25/499317894_685600070744862_3995715964492546632_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMdjGAUrthsQ7kNvwGZANkH&_nc_oc=AdoP2ZY0NxQXnw46Admx5oHss-7BObJiGqy6kzCHTQ7iZSXXVxttg9TfK_8WMT6ndZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9hDrSget1IA1UTlBvmxCnV_kxwPW3jVSEQnQtrsucdw&oe=6B01E837"}, {"file_name": "ss4.png", "id": "1191527102660451", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308194_1191527105993784_4771376574341556239_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygpl3se0_tYQ7kNvwEJSMgx&_nc_oc=Adp2hthWzpvTCG6YBTITJQW7T56LBX5GvfzcreOyU_UQbx3VEsT3AcYtfyNDxKLyAXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuZFq82CNg5J77dFw2Bhoja7hjYFgEeKdzBGaHxjSS6A&oe=6B01EA9E"}, {"file_name": "ss5.png", "id": "558205100400427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300574_558205107067093_4830250981905564323_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CEpwKSVhHcQ7kNvwHKrdih&_nc_oc=AdqCYCvmCqG65ZW__S3i087SVMCf4cvXGlQw88NOH1DTIenv4V_8__A7Rm5igAhcA7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCEfVVq-9IM-8ZPdMtnp23JWdWz4YsLbrm3r47m2ObRw&oe=6B01D08B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DRCover.png", "id": "685135500891719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298254_685135504225052_8965096047718517136_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96rnnTW0g-MQ7kNvwEHCTGL&_nc_oc=AdpNWCWYMH1xrKkMpdA6JgyV35jUVHgxwqGoRp56Vr6JkCV9wK7HhVzuI2m_CbU70Xo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSql5Xs_cD3RTVLb9b4oIyB8eZlvSs2lfVWM9HD1G2g3g&oe=6B01BD3D"}, "display_name": "Drone Racing", "keywords": ["Racing", "Drone", "Race", "FPV", "League"], "long_description": "Welcome to Drone Racing! Experience the thrill of FPV aerial competition in Drone Racing, a fully immersive VR game that puts you in the cockpit of elite racing drones. Fly through amazing arenas and environments in first-person view, where every twist, dive, and turn tests your reflexes and precision.\n\nBuilt for virtual reality, Drone Racing delivers intense, skill-based gameplay with tight controls and realistic flight physics. Compete in a challenging single-player campaign or race against real players in fast-paced multiplayer modes. Earn upgrades, customize your drone\u2019s look and performance, and rise through global leaderboards.\n\nWith dynamic tracks, responsive handling, and a pulse-pounding soundtrack, Drone Racing offers an unforgettable VR experience. Master every course, dodge deadly obstacles, and prove you\u2019re the fastest pilot in the skies.\n\nKey Features:\n\nImmersive VR racing with first-person drone control\n\nSingle-player campaign and real-time multiplayer\n\nSeveral awesome drones to pick from\n\nVaried tracks with environmental challenges\n\nGlobal leaderboards system\n\nStrap in and take flight\u2014Drone Racing is the future of high-speed competition.", "short_description": "Drone Racing is a fast-paced FPV VR game that puts you in the pilot seat of high-speed racing drones. Soar through futuristic tracks, dodge obstacles, and compete in single-player or real-time multiplayer races. Choose from several awesome drones, master challenging environments, and climb the global leaderboards. Drone Racing delivers the ultimate virtual flight experience with immersive first-person controls and intense aerial action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://slumberlion.com/privacy-policy/", "developer_terms_of_service_url": "https://slumberlion.com/terms-of-service-agreement/", "publisher_name": "Slumberlion", "support_website_url": null, "website_url": "https://slumberlion.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
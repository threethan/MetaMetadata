 "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499307346_2647793642219559_3379658331804898232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoed8xBQaWwQ7kNvwHDuuya&_nc_oc=Adoxhsfk2Y1Wf4N79ZgcGj_aydlRESnDsKqHMjK6VtH3ld2ljfMrGGCLzSLAZVrPvfM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34mVn5ppQG_UW_JfImhB_lyz0fPzru9qu89CORA-x-Ww&oe=69E24D32"}, {"file_name": "SampleScene_Custom..._01.09.2025_08-25-44.png", "id": "765655392878845", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491830589_765655396212178_2899569217702732141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_Q9qz13DBAQ7kNvwGSEMtM&_nc_oc=AdogDFrphf2AnKeEpRP9jgPm6EYLzoz3TgzsalA1nSEy7NhxA7LB0Ixdcgzm70dm2k4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LwyJYzFansx76OTygziKQLPEFJQ5Hki8J40itRRTJbw&oe=69E245A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vault 53", "keywords": ["vault", "vault53", "53", "scary", "horror"], "long_description": "Step into the dark corridors of Vault 53, a VR survival horror experience where every shadow hides a threat. Trapped deep underground, your only hope is to navigate through shifting levels, solve environmental challenges, and flee from the monsters that stalk the vault.\n\nEscape the Vault \u2013 Each level is a maze of danger, with new paths and obstacles standing between you and freedom.\n\nRun, Hide, Survive \u2013 You\u2019re being hunted. Outwit and outrun terrifying creatures that patrol the halls.\n\nImmersive VR Terror \u2013 Feel the tension of every flickering light and distant sound as the vault closes in around you.\n\nHigh-Stakes Survival \u2013 One wrong move could be your last\u2026 how far can you get before the monsters catch you?\n\nDo you have what it takes to escape Vault 53?", "short_description": "Step into the dark corridors of Vault 53, a VR survival horror experience where every shadow hides a threat. Trapped deep underground, your only hope is to navigate through shifting levels, solve environmental challenges, and flee from the monsters that stalk the vault.\n\nEscape the Vault \u2013 Each level is a maze of danger, with new paths and obstacles standing between you and freedom.\n\nRun, Hide, Survive \u2013 You\u2019re being hunted. Outwit and outrun terrifying creatures that patrol the halls.\n\nImmersiv"}]}, "developer_name": "Universal", "developer_privacy_policy_url": "https://universal790132.wixsite.com/my-site-10", "developer_terms_of_service_url": null, "publisher_name": "unIversal", "support_website_url": null, "website_url": "https://universal790132.wixsite.com/my-site-10", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "31100175422959271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499307451_1727692024549586_4851237156289960006_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4FDG69SJFwQ7kNvwEuD15m&_nc_oc=AdqHJmGnFnuDC5rZ2OWWChY7SnX269PHJY0WV3iqoBR0Ik7ePeRRaCQBFDu_7-NGj7I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0utsSZsAO8FXP7kMnomt3GBEt5uLmb_YGaqkhXP_KWzg&oe=69E24043"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vault 53", "platform": "ANDROID_6DOF", "context_category": {"
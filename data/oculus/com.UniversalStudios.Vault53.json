 "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307346_2647793642219559_3379658331804898232_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6-mcZcB1akQ7kNvwGWdDsw&_nc_oc=Ado6P4U2EQZKCDTPTP9xid7QhY-uFk7pAOApHDXr2yVKjHum5U5VXEbj8oS3MO9TX3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aPTLWzNrvCMWr28sDycJKiGEWIKAak_h7fNAuGIzMSw&oe=6A297E32"}, {"file_name": "SampleScene_Custom..._01.09.2025_08-25-44.png", "id": "765655392878845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830589_765655396212178_2899569217702732141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuRkyjuuesgQ7kNvwGjLaD8&_nc_oc=AdqT0x88ZhlIqZJc2bDWlCMcqMABhjgQVhaSZCLA-Q55WznUF4NjsQveR9l2zFRDF_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a9z5szy2TAnfeqwJqlcI-xVnD-jFEFcAUtLdK-_RlmQ&oe=6A2976A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vault 53", "keywords": ["vault", "vault53", "53", "scary", "horror"], "long_description": "Step into the dark corridors of Vault 53, a VR survival horror experience where every shadow hides a threat. Trapped deep underground, your only hope is to navigate through shifting levels, solve environmental challenges, and flee from the monsters that stalk the vault.\n\nEscape the Vault \u2013 Each level is a maze of danger, with new paths and obstacles standing between you and freedom.\n\nRun, Hide, Survive \u2013 You\u2019re being hunted. Outwit and outrun terrifying creatures that patrol the halls.\n\nImmersive VR Terror \u2013 Feel the tension of every flickering light and distant sound as the vault closes in around you.\n\nHigh-Stakes Survival \u2013 One wrong move could be your last\u2026 how far can you get before the monsters catch you?\n\nDo you have what it takes to escape Vault 53?", "short_description": "Step into the dark corridors of Vault 53, a VR survival horror experience where every shadow hides a threat. Trapped deep underground, your only hope is to navigate through shifting levels, solve environmental challenges, and flee from the monsters that stalk the vault.\n\nEscape the Vault \u2013 Each level is a maze of danger, with new paths and obstacles standing between you and freedom.\n\nRun, Hide, Survive \u2013 You\u2019re being hunted. Outwit and outrun terrifying creatures that patrol the halls.\n\nImmersiv"}]}, "developer_name": "Universal", "developer_privacy_policy_url": "https://universal790132.wixsite.com/my-site-10", "developer_terms_of_service_url": null, "publisher_name": "unIversal", "support_website_url": null, "website_url": "https://universal790132.wixsite.com/my-site-10", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "31100175422959271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307451_1727692024549586_4851237156289960006_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUVERRr56JQQ7kNvwGY1zud&_nc_oc=Adon7LvV04L3hzqvvFoxgDy19CmjdViHQAKcwYehemQfB0d-o0D_WYPwfyvhiiIG9yo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87fhskLt31fBxFywAPUoDpdtzmBT6BOb8g2hdPJVgxlQ&oe=6A297143"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vault 53", "platform": "ANDROID_6DOF", "context_category": {"
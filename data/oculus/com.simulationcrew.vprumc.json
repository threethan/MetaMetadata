/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l9l1FCa2BoQ7kNvwGQnqMY&_nc_oc=Adr3iQS1rflVa8rVJsH-QyN1FAWNLGYrLI4OZ3Rz7o7-kyJAm54evHLUCE-yXiS7nps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6HBtucWKhCvhFCN6b4R_UyW9b3hWfCDnwupY_QUOBkg&oe=6A5E1BFC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2VfTx3AnfEQ7kNvwFUjOEh&_nc_oc=AdqbrZEJb4_pw2YmJak9n6tgV9z3v5chprRfFUxtAjpBzU_U0meaKy5o27Sj2EKZwf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7HAxVinBTPuF6q3KETcb3todmWeJaRGVMTGAPnmf_hg&oe=6A5E2D40"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snjaAv97McQQ7kNvwH6Ist_&_nc_oc=AdoXyUr0nhTarr1esDY0ce7opMvySv-XqE0s2NFzE1q8wng1BFAnX3dnwyCzGQkDUzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5vmAy4kT05Hp3-QOzES4fQSb1dowbNZQ4QpgDiFnd4Q&oe=6A5E0418"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujSuaT4X5UQQ7kNvwGZLI8s&_nc_oc=Adqs66QSB4mH5mmB5VSvDm2t-fNXxQa-eR0rDo_RiksuPXNs9NH_5Ih2JBU4nu-MpdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVymITc31p6BnKRhqy48mWwitgkwtc0V-htaEgNfOj7A&oe=6A5E1FC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
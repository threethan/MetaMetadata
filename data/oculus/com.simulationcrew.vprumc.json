A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWFsQ42ObfPeAoJQ36Ytw5OO9r7AODpI4mlFgZz4GZgw&oe=6B0066CC"}, {"file_name": "Screenshot_02.png", "id": "914805022658635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts2Q39rFpQUQ7kNvwEc8UD9&_nc_oc=AdopuAdE-pTx-RRvVxKVBQf37EuDdWwYethrTxfESAUcKp8ZrmSj20gTNGCDOK-9lhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAJV-D9kXnvTPZybXweP07uqJsvlGlJJMBQd4nMIFpuw&oe=6B007CBC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWPFyMIXyW4Q7kNvwE_Wtdh&_nc_oc=AdqG6fANS0-Ybh3_1ProiOaJ1J53IiIYwfrmqIKVzVvk9x13s9GkLz2hDd2kpEAaNXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBj3fiDWs5UTkyD3mWFAUNXWoJvNPKRmZOcMdVeMAMpw&oe=6B0055C0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euc-9cJ3EoEQ7kNvwGU_m2n&_nc_oc=Adqun8f_fYaPpWdDF6qwsFXB9rTUKv80WPnRGzKWZw8LtdupVuW3DGRoOu8jiipxyfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCFJh3NCDV621FbIq9Nn3rvQ3rZomXI7PStjS9ckER9Q&oe=6B0064D8"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oW_Ui-s9yMQ7kNvwF7kMr2&_nc_oc=Adowl70zH_PILafmQHajToe96DlZSMempOChHrTL_QqkQ_bd6HiHl9vmUYo-tcb66c8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIsurswk0baGu9vnmtLakVTPEBGSVeVYT7dpoM_TDihw&oe=6B008080"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "36269221144
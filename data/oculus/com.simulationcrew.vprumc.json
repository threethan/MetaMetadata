/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUwCGfDcTEQQ7kNvwF7_Jyt&_nc_oc=AdrX9isQJCcY1dApoxM17-GIoY4UJmgAXTlQPH94jieL2IZjtWS_Av52ZQQ4rUpGq-o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHshBGI-Y46y7kSmWFccIpvDZoTAYyh1sTaChaXPs9hHg&oe=6A94297C"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dpwYgXzxwYQ7kNvwEHCOXI&_nc_oc=Adp1fXmWnEj7I1CBz2srrT-Ll7XWRPqvYXqxo-piAHrXHni0gdUUPOVEvLKjm5YP4n8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE__UcCSp3OlV8OtSAFi-bgXA8nMC-3YHp81Nc1kztKWg&oe=6A940280"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS_YVbmsJOAQ7kNvwGqKRCG&_nc_oc=AdqfwgccaICGmXxBIXagrHvQ1TeeMgAWvxOnuG9KvtF9lBpmaSC3-iKX0HanG60KAVo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGoXdSkZXXpriCMqlZK4j8NGsiUTx6qYsSr5pgsj4r2g&oe=6A941198"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXYpQJjV6m0Q7kNvwEITb9H&_nc_oc=AdpZYSyulCvkzMFcGXPI9AsUH9MSk94Nqi9hv00SRvigOBEbXLA6odhRxX0eUXJIgpA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHOt30rMpNhl3RW-dNYU5W-0Z5Jz06H0DwOU9BacMyNw&oe=6A942D40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
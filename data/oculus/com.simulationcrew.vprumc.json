wGAB0l1&_nc_oc=AdpQmYiH-AgMoCtL9OLJGO8V4quQjT9jv6-YA3teo0hvaZa3dNvABiBBmp4VBIX0ZzA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Cmdj9Q62Ft_Lg5hLM7qC1hTuoZni0bNzcr1U4hKQ8iw&oe=69E774FC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLTlzapI-XsQ7kNvwE_8lZ5&_nc_oc=AdpYjvX3RN-joyoES8dFlvcbiE1HW9ZpqVdu0DnH5wh0FfK7aHl5Mg2PtEx5CO5eFug&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1a-E84YvqwIOr78akspRl12Fz6EzspaK1PilG_oIWZjw&oe=69E78640"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ocX__J9fnAQ7kNvwGRFYLu&_nc_oc=AdofZ0c8rDDfcW0QEDq_IsRFj8yKiF45zCgDpI5ZHpRpUB2s-2LPzlArUUuBOb4r928&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VW9gk9_4HRvE7BzH5Bf6D4A8LJb24h3r7QtKtSBl2bQ&oe=69E75D18"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2Vkq2t_rw4Q7kNvwFCUT1p&_nc_oc=AdpAdnyhH5zmgvzNhObKS_inRKMsj4oekXRRCzw8rRaUxtEDdMWx6fEKO-Ea-6x9QAs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MPUBC0g57CD3r5H5t7bVy7OISOStKD8FVHHQSA8F65w&oe=69E778C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"
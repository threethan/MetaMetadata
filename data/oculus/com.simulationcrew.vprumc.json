wHbiAUH&_nc_oc=AdprK8rP59ctLC8Ww45eP2AnEiMD_TMcG_a6OH3OTnLBfJhSk2kuOyPSaIp4XEwkDCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy34WMDnnB84F68ZPrkvZE5hABp2rAkj8hdBqe7HtSZw&oe=69C28AFC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jy5DyRZK60Q7kNvwHwHRGX&_nc_oc=AdqwzyaAs4VVJyhH43NPI0Xyt7vyBwJ4WmufrRGhy8wL9ltiqRCOAJowGHHhBVU9Dik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfMJPtUtXkJLSeUHk_mjpBRE9BHTdLGQBXa0pugy-FlA&oe=69C29C40"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRLer2qF9AAQ7kNvwFNUvAX&_nc_oc=AdrWPlz5dzIU535RXs_xFx3LnU_gRDGVXf4XoDItQ9cf902sHpEF0JSb-L4dIu_xdLQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_iSfGFnRpCdJ-RgKZkDVs3qzP__SXg30n1a4Uw3MsGA&oe=69C27318"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efXI2m9oz8sQ7kNvwFRb8Ic&_nc_oc=AdqT0ZsM1NGuBa8iZi01Jc0OFizJxsVV-cSGhOdjuky3GYaav4fapiEXuwtSdo6fYbU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLMC59essSuQZf2DD65MSe1_WiMFnY13ydHhan0TuPDg&oe=69C28EC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"
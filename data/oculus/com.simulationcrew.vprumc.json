/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRNq5BFNnMEQ7kNvwHNrw4R&_nc_oc=AdpudKJUhlxgQefaAcrqIunsNA_RHEg6EIFsj0A9DOM-NCFve6QKo3Ert7UNOs1mWi8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9VUEAUp1FdhNUv9prok5qK6w8lxGLU0DLsSYRNNFHyg&oe=6A58D5FC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiGUB3tS2hMQ7kNvwFwvJM6&_nc_oc=AdoKWBa0ZjFzxbTHoelC96NThKoje2wqts1wlu0FSr5MBswA2SJuHWj3NnxE-_hFIaw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVUx_2Yx9URA9R4ZzuZ_18qnhxa_cEw99-j9ZmEkoMwQ&oe=6A58E740"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KXCO94WdZ4Q7kNvwH_FRUR&_nc_oc=Adrs-xvDGG6E12Ko771fuLsJuCN-1Y4H84hVwDm_MCUEU4YyvgMSelaqieYMDroeB2s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq5Ny9jqf75-f5SKYrIfGdArLpnoDPY75Ec4K_163TXQ&oe=6A58F658"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ronp1pKE9D8Q7kNvwHO0Wa_&_nc_oc=Adqm5H5QFXbjmzWA6X-skBCSUZrY7wiaf_TLblw8BdK96l8_yRZC89-sDFY6Jp04yqI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNfa1zIfCPXMzrDvr4ayaCI96YsQd98THQcfOPY_VlWQ&oe=6A58D9C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
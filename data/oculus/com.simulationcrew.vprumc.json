VB7GaslAvndOfuZiEE_trerFN3TRd3w0h9n4o_97l-XgSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvgMsMfdFWuQ0rvWsh92gtu9rQouhaM3LO_U_sprXXDTA&oe=69A97E7C"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iary6Pm7X5wQ7kNvwH7R-Vx&_nc_oc=AdnTAijho_5mMu3vnMzGjvV1Kp55Qqk__H5-7WBfY3piE6yjrO8RVbtUkMDhy8g8Jjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsts0X-LtBp_VE1Pv29jJZHAc1CKXEVgxSYUwFk4Os36Q&oe=69A98FC0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P7sAV8PsxYQ7kNvwFxhLox&_nc_oc=Adnvg4dyKNoxfRXP7Vg8SD5WUwRH-SmtfHgATJR5wxN2zWuUJhRhtMNB8KRJldOxpPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv0jAsvid0D0tlOI4CkiBwmUuAHhjAxNEt1pCVds11EVQ&oe=69A96698"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CijndDgImVwQ7kNvwE9DFti&_nc_oc=Adnkw4mhTJwG8gvYnOwDMYfuEq-0BjXCMuK3oJq3BUip4_TI-Ig0Y4kq_MQpmdeUKPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsKiVFGcmdNUq4rDJy-7-MjxlThhdjJI91JAIAnE5Q_mw&oe=69A98240"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"]
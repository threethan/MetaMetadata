luscdn.com/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlsT0RDtIUMQ7kNvwGeCTTr&_nc_oc=AdoIkKXMD1Xvkf41vj1DTQy77YSM9eB7DegJpRXcnRX5NTLsAFyG_UsrCjMsPFdbZ4s&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DA-MofpJ1aLKRsLVLkTDvLctq9EPWoEj_d0PkzCZi2Q&oe=6A2300BC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yditawnNgYsQ7kNvwGGBRyD&_nc_oc=AdqhmTtQ2LKXZGgTgXFvMFroUKido9h_NIG-oUuYVNAjvoSNhYgJ0N-hFAWDsYaqOY0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q5XVlp7XUyjOWzcgGRHrcELdJ_DGv0sXv67w9FM2rEw&oe=6A22D9C0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2froWWR_s8Q7kNvwE4eD7y&_nc_oc=Adoh4zIFy72QPsJgzZs3h_m6ukZq0oT2WEnggUreJQ2DcNhvV6hmaio4fQqrt5TY4zw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fjtcl2smLNiTVsA7wEa94TI7CbTxEeRr-GaE_zPaRJA&oe=6A22E8D8"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=decrrQPdE-gQ7kNvwFqnJjh&_nc_oc=AdrG_0f6VGcxYrZRQlv3aeB8KbErcdmO2z6uryOzMLrOfy0sUMUSU7AZiwSBNxNNhCM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92p9XwY57KIxTroC8x1DmH6hYN3fI4lSUdtp0YX1WapQ&oe=6A22CC40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomm
/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqkSYRfF5oUQ7kNvwHX2VFg&_nc_oc=AdqggI_wK8D9CmewHZ_J2EDoI0soCNiYu2eLPFhUWqXfAh_LEn2KDmJz0DfR6_rQ1QI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7EqQrhzzhJBiYdR2QuCiY7hBZERQHOl-EiI9iUVT_dw&oe=6A7F117C"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HfHuw6wjZMQ7kNvwGdKM5y&_nc_oc=AdoBd5iANWK2k1ej6-vEQ54cFW5Mh4M7ivHSzZj-IIbFK35e2oebYYPgUm0Z79QG3_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqVrawH2zRpprqI_vj2XcTgV2TO4Qjf4tX437c9oB_wg&oe=6A7F22C0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JnSZjmKAToQ7kNvwEd0v06&_nc_oc=Ado6B1HUGmtsShzjA5hk_9e9wJBEMF1iUCTiGctfbJkvvWEXMcZH1s-AjYU0vfc6jXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAEQCXIEfQM7c3I7WuWOLWvPHEK8YeSwUycgw47s7lSg&oe=6A7EF998"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBI81jRhVo0Q7kNvwHhpAG9&_nc_oc=Adq_wP8Qpa97XWiMOeIJ5DNvMF3jl0FRkZ3jNTgqM1eHMvCCmQwwX1MeW3wOybiX4YU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExEisDsIYQTGbKEgy4hjo9fPp3sm3klRxg4rnA6nBdUA&oe=6A7F1540"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
uluscdn.com&oh=00_AfscgS5ARBjxuKma37LgsAN0Vkb5MLAWyoP9gYjyzEcuPw&oe=699DA0FC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG_dEYQYSKsQ7kNvwHQKX1C&_nc_oc=AdlJssWQOcvPUnGceRe31Zb42ITV2b6Co9DMt9T8OzfoOsvKZc5HdlKBqHlwKocGBoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftnEj2Mkii2_zdXRZYcBdnr_cKRUHVBWnptqcjuXGZPkA&oe=699DB240"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIkU6HPmbfgQ7kNvwF7fs_y&_nc_oc=AdnndZ0C_W2-XldVs8KhvUxJ3O3ymyRAEpqmeu1UtsaXdQ3GMeE9oAlY--f_XWIS9L0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFyqXxF5311Ol0EH99xVt9qRS52nAvJU2JfsAFQGyTHw&oe=699D8918"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8rsiTDMqBoQ7kNvwGGiNGt&_nc_oc=Adm-7ICUfhiGyhw33xldea4aEULc-CnVI-pP-HaL7GHYMDe3SJkZW8kc9j8_s3WEUlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPMQPJliT1ga2_icqUHOa7upQayBzaVr0x82qhv_3LUw&oe=699DA4C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "668521421169412"}}]}, "scheduled_
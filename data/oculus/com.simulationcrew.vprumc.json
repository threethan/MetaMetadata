/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqFrQVI7PVUQ7kNvwF4sfMN&_nc_oc=Adr1DRyJgl9sHuai20BCSHla-nufMxcbQ4zesCM28WcgNRh2SGyx3BBiwHFUpY7ihoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ozsv_Nfwm1uAhznu3dB3uPY_O39F7kFVUNXEb4yct0A&oe=6A15997C"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo-s6Fv--KcQ7kNvwHbWs31&_nc_oc=AdqHVTKMoZ46MfTk5tFTbOHE4xa-BWqRprqENuKNeKrmcc7tSyGdN1sR9RDJZ01iVx8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6phJ26JSRy4I-f29D44EhkHpeWuv7YV2JFX5iMgTlX4Q&oe=6A15AAC0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poVVsu-P0MUQ7kNvwFSbpv7&_nc_oc=Adra0dQK8yuyth7yZEdHefbSpuZrucER0Hom5q4aDs7o6Ybh39pndGNgzv4mTnWZS5Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pRWXL6xeqBVpTktgcLk_ybOiOyy5s-hXo59ac2M6pkA&oe=6A15B9D8"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjCudaVnTSEQ7kNvwEu5pPw&_nc_oc=AdoVKaDu_NTHtgt3-WNbthpvvw1ddHSv3hDhTtyNr6PZD5uV5KqlZjBO1gm_NzPqTnE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FKTNqfEBV5UC1H_JXzAJaYyBFXs5zlYDbnx6B1bWwyg&oe=6A159D40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
b=1-7&_nc_sid=6e7a0a&_nc_ohc=trVC0yKLzV0Q7kNvwEkvRif&_nc_oc=Adr0K5hR074DweYJrCCSgS96nTKPIusCWsmARMa4HAKMAH9Zep8C8xj6paCO4muwuww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdBLCBBQjnirAvUrdgX2wfW3A9plg5lvLzwVr3UIlO9A&oe=6B1038CC"}, {"file_name": "Screenshot_02.png", "id": "914805022658635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph_MEnzssYoQ7kNvwFQpg2c&_nc_oc=AdrHPk1hCt9qR3RYoXh_t36IQXIJTaHg41YgiI9VYxEPygQZPJTCgAJY33OwIZ1-858&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWvdZCU9hZPVefW7dLaQsP7PiLsRMMte9W7eavqKiyUDw&oe=6B104EBC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4YwKip6l8oQ7kNvwFoJJnp&_nc_oc=AdoH4PIkL9c5B6WowYqyydjx3qhOWmo_BLD3J0PiOutOLV93OJAkbSLkIH0WtpmdtzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmHgSxAj9-OHb0SGrW8tyJ31cMT4qXbn1sz_k4RQqUVw&oe=6B106000"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3Z1l4h8tssQ7kNvwEIMAb0&_nc_oc=AdrXNen7fcykYH5_cwPA0ve4xS57iO_pbJLYZ_AjfKrgnrPCudLEl7cqS1bTde5_6hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVnaofBoRc1ou5GZNvnUt-6-w6xcD-USPDG2EkWVxZ9NA&oe=6B1036D8"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdgJsVlConwQ7kNvwEBC_Lu&_nc_oc=Adrdg1QMyYthLZ2N6_I7jWbdR90t9TAnJYQVVtTyVDKWMjYRl93SXzrZU8Nl_eP33GA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpTEIW-001UkluifBOParqfQ8xnz9PR1Rpb7HSUuVQnQ&oe=6B105280"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimula
/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2mgRVxsGigQ7kNvwGpsfrk&_nc_oc=Adq9ug8U4RnluaKjNBiEkwy1iQ0Pom2gXlLlqU1DB0Dg829VlNIt99mKYaJayQKC6Es&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEkTjynR0cfRKaFkJLXtiWP_4B-vmKgAve3M0GXcfzcg&oe=6AECB63C"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsZ4xGYIzMoQ7kNvwFmDyRO&_nc_oc=AdraKLcbqonP49xJ-Gsfa0HYXrMhukrhjgZW60WI9-le9pqumBU5vlN5qAHrthW7cU8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU8vj69Fh9GmwvKgsBDfJhGGKbF6kRaU0z-aVAyt38EQ&oe=6AEC8F40"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmPHlLP5wiUQ7kNvwGnFZIl&_nc_oc=AdpLCw5QRTh1Y2exNQIAtPPDiIcG8mlFxAhoyGJL7QVMBAshmYbcoIggfRx2_S8m-Ck&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1UxaB83BDhCP9bosaSh_55fmkOu4itNvoJ-Xv9Z_blw&oe=6AEC9E58"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9agh2mjoh8Q7kNvwHVc0uv&_nc_oc=AdrWMnludpGBu3ogPrcjw6azqrXOkH7K96d0XCfSFNaj2b1uMg6Wc46MJ_0C1Pngn7g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9B2E5YaOSnDQQnaTLs9PrNxrfdC8HXkUljySgPW6fIw&oe=6AECBA00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
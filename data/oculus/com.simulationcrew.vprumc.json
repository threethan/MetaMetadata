/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcdVhxopTk4Q7kNvwF2iG4Y&_nc_oc=AdrgruNjS4K-fUMAtgInXJ2N5oHVAd-PzVbD3W3bTrzKpX-HgaP-5NQfsZE5ZNmf5J0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCev_nOyzVmct-v0Gyja5whgjfNNfz_E2SqIeMd8tce8w&oe=6A6361FC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1uY4SWq2fwQ7kNvwHmVeKm&_nc_oc=AdrR-esFA92T3rfgTBpOEBlSst7UwnGhXLG_bsEom5ifC7Boiy0ukRz9OLsaSbPCWBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwe3HP_aKKm9F7CrV5Wg-g0bL1vb-zIyX7_-ukUyhU5A&oe=6A637340"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yu5-4BNBYc4Q7kNvwHpIl4F&_nc_oc=AdpkBtayimachi3707txEU1QIHF-wv_-ObE13ReCv6YhHl7Q6E8FqQMCUBAuS6p7Fps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDowCRyBSuuykZveQR3eHJhSfW1sos_mrkS9QOoaLGelw&oe=6A638258"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD1qxMBqI5QQ7kNvwHiUwmv&_nc_oc=Adr7pM1BoXkjUGTYSQPQP-yrlChDbQcg5j6rVZnOEWD9E36m_HMtCr28i2OK-GmTocs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWPk5XMYboRXUyQ46OYcbYkoEXJkmye4GJLa8fjJSpqg&oe=6A6365C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
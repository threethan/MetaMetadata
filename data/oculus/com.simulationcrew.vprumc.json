/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kk1GjyeVVc8Q7kNvwH94lzH&_nc_oc=AdrNMz0YEeD75zy12hiRVhDLcydA3ypzcw3d5BVqjjAx4_P3NGzq63hD9e3b8wHbWnE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KST-cfjfbnfXPa2UQo9OBF5YFfeGk9jRUc3_V_yiVoA&oe=6A12F67C"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a2VN5bBM5QQ7kNvwEfxECu&_nc_oc=AdrQwXECt_jX05GU63Q9OnHpQUHMXBvYelVx9z9prfpAF7G_wcLpPvdFfzXUAXTbPwI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T3vzgcs6ZnbzS3n2qIolM0H7ojMfDXHPJvQf3GOVsvQ&oe=6A1307C0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poVVsu-P0MUQ7kNvwG73B4P&_nc_oc=AdrC98CbcnzrWXCJAY5fm4ypONGcq6EcRnnDDRs4WAaF0mZv82kInPi4sB41sEFAfd8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ncZymn6k1Tw5KSo0itoXaag_Qwxbe7xWMOoa3PlN-Nw&oe=6A1316D8"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGK0H2YGW-AQ7kNvwHk_yqP&_nc_oc=Adq5kp-npem6q6fintjcdc8GvTvqD-3MZJcqQMd3hIDmFrdckWw9mchzSZiUFt9rNN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sh3hxzpkrE9XUOPwdOI36z_89-lGeWNIMAGGAaLob9A&oe=6A12FA40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
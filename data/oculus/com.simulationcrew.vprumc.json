Lp9Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3_EdkR9fNbRM213IsOBEnCG2gWjMC2xJJEREnpecDtXA&oe=69F200FC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyK3cu-ri0QQ7kNvwF59GH5&_nc_oc=AdrHO-52QK2YxYHECrt_jg6PqJCf43J97NoY3R3wp9bDw71dQxsn0bh1F9MdKS25qWI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Wuf5IhZC7Sj8FZm7ynHF1lMg2eUwxFFljiE6VMFK5Jw&oe=69F21240"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWcdv3pZDHwQ7kNvwHv3Qde&_nc_oc=Adq8RHpZJbjcESjYoFQj6fei406bnatcFE8iYuc14cLUDYRfgEFxPWW-aJvvoAp80LE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0i0X0WZI9gVb5MHbHAw5Og3nlryAtmeJE7LTXp1gG2ew&oe=69F1E918"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1genYXVNzhIQ7kNvwHHPZBj&_nc_oc=Ado_91FomDOoO_vmtVn0G7V1JnvfHIh7mTdNqKi8Uh1_P8lo2Ar734wbkgpOoIEqFCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1V1PJmFryZh1uq0lzeSeIxA3JjPQjgUUl1RWELaCKEdw&oe=69F204C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwU2HrTnQFUQ7kNvwFwmIGM&_nc_oc=AdqsbpPY18WX6qyxKp0IvEwSfOpP4FLM6_pMCMkLvTAsso4WERclzszY0rpWjwCddkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8HoNv1nwWRYXAqEdgvYhqtpuzHjzAbHIbrPj0hUUxtA&oe=6AC134BC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VTuzq-J2JQQ7kNvwG0T74o&_nc_oc=AdqNHEJT-p7LhcHbPLhmXiECNvGQ9nsc09MNZLt6_R_iFXeXRI0RjPuK4sqselWxyhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX1dor4H-g2fGePQ-tshU-fCjrDNsLhWzO5CBZCM8U-Q&oe=6AC10DC0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26-bXIQjQ_IQ7kNvwHMFYWy&_nc_oc=AdoxV473W6Fmhj1Vyps2wRVZGSF7La8D3wUsu4XqVwg4ynQnzWjljIllGzfRf0zBye0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOYDl7HZdHswt83eQLeNHqtl_Wp3ImUER8rTMSSi1PwA&oe=6AC11CD8"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwRIxPC7-GcQ7kNvwFa1xd2&_nc_oc=Adr0RGQKMR8VYuWstuG2QvA29dLnSEo8Mg5fClzMGUmwxGQbYMNhG6XdEP2hX7XPVDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF2dO74_Fe3SVd5XqrrAJHpuz4ly4XVxnfUjeR0JzaOg&oe=6AC10040"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
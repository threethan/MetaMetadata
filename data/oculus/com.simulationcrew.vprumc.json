b=1-7&_nc_sid=6e7a0a&_nc_ohc=2LSZqAj93d8Q7kNvwGIP_u2&_nc_oc=Adpux1mQOC_8RoA-sLK1uc11KfvtMx-u4Y56-bwfeDrz2Fn2zxvS7znyC8RuxzpR_N4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpe-_Dg4SOeRc2AoTqJkzya3Mt8LBfiDbUAKNM4NlfUg&oe=6B0DCE0C"}, {"file_name": "Screenshot_02.png", "id": "914805022658635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WFGj69xsogQ7kNvwGwMmEI&_nc_oc=Adpok0wR8-z4wdefshJpMytUktuk51JgSDjPHO3ypV_lWzSjdKkA-Sy4t8ldooI74tg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXzT-V31iOf95gWrtmvjbubxWiKksXapPNaKLUqF2xuA&oe=6B0DABBC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzjkF_aCv0kQ7kNvwGbZ_Yh&_nc_oc=AdreRcCb9Dd8izzQt7eRX1H1njjEGfD2kLkuR5tiCeB9BcAnrsX-LZoMi7YCf-IIO-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeafEbtZwPRaRbiKzRju2_IQ0Qi2ZeYyoew3yLdIS0aA&oe=6B0DBD00"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y18hJnG3nmcQ7kNvwHFZXAH&_nc_oc=AdpS36M3iEoYFZQpKoh3oRwrQrwVedchNKjWBUrhvI1dFu4G4McCKi1nFqe1LbWKCo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5ayAN7SXjW_OAr1RSBoYHPpMy0hhVoxqRZPN9KNTshA&oe=6B0DCC18"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdgJsVlConwQ7kNvwFMzrfI&_nc_oc=AdroS8RUvin4x4fH2IRvBk8ygIIihArCGcpLoa0CRNknL5PatcbQlC9QzbqK97XMALE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTxdUpuBkANWiX7OK-fYqdMk8HKlYgDI3puYDqU50Gkg&oe=6B0DAF80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimula
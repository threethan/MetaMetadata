b=1-7&_nc_sid=6e7a0a&_nc_ohc=TY1BKFYDVTcQ7kNvwGAhwZy&_nc_oc=Ado64o7l_gb5SBV3Fh5a0F46qIsDGhHL2VEcNdsYT-EYRosASl0liGf2AcjydYJoyFw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi_iYUHspThSO92XyV78i2-r4qitbO0ekBLok9a26BzA&oe=6B084FCC"}, {"file_name": "Screenshot_02.png", "id": "914805022658635", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75416833_914805025991968_4856246461759096441_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve6-JRjwJhMQ7kNvwHG3M40&_nc_oc=Ado4kxQoCoeaiv_CrA1AdH7kMJUIusn2moxXZQxcRsKS8tkcksAwDPiHlKzhudnJ1EM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8c4nKWqjJtw3O2Ic0cb2R4GpvnIr5K11_zNkHwnzXoQ&oe=6B0865BC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n16azKGwHkQ7kNvwH0rDga&_nc_oc=AdpL4jIJ004wSNFRhI3_NUZKEHFudfQSemCEAWT7wWKiS1Gc4q3N69dXvoVxzyXKXEc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRErybRTPO20eYBhIfxC1DH2PenI0pFFb8tiE3VHtF-UQ&oe=6B083EC0"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0LBDeAFvNcQ7kNvwGbXcSL&_nc_oc=Adq4zmStSdz6m27FujFBHg1j-dD35Qv4B8_xFH0Dax2JC-TRSIqdiG5VeHtAO3C3ol8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZeUb9-8fuNsuTdHschfVzBKfkKOwJt0iOHVNYw5lmBw&oe=6B084DD8"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oueOZkl2bWwQ7kNvwFxE2CR&_nc_oc=AdrJbmWDQBO9JL951BHWAdFPN40Ecm2QC-MhmCsWvtbJG6pgncKTLY2ddZbMQDb8-Is&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi4NlKjJb649vhxZKWvaCaRO1macUuYdx9Y67pXtBELw&oe=6B086980"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimula
DtkGpdEkXzcoYzRVn0cORqsW038WpgKCLaQ2G3AFkRYpjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzb_yQtZXF8DwNXFsRGivkcMvJdgzM4WTc0C542PmJvfQ&oe=69AD72FC"}, {"file_name": "Screenshot_03.png", "id": "339100464014062", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75289719_339100467347395_7659630426918722172_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD1HfDQ5dy0Q7kNvwEWPxfC&_nc_oc=Adk10hb9zO_JbjHQmCgjziD_C6vFCDr-WPWMfdF_mm9Vk2veIXkCq2KdkEsIee6VELI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUEUEx9HeA7PcW4T_MSKuKE_ljlPpK7NsrSSj9pFTwog&oe=69AD8440"}, {"file_name": "Screenshot_05.png", "id": "471954967152830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75485578_471954973819496_2120467707786744430_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrxLPtEOy4IQ7kNvwFkHjgN&_nc_oc=Admi_t_CCNvloxM1JHouQ_XcBBIqn5JfG6FTrivd1Pi_oAYFvMnf5VS0hiLHAC3QRCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7Q7c8NseNK9b56jAOaG-pP_vV6jCli2ZVWb4TS26Qmw&oe=69AD5B18"}, {"file_name": "Screenshot_04.png", "id": "111357094197254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348038_111357097530587_4121207131802475143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXqY4yzSo1QQ7kNvwGK-wYy&_nc_oc=AdmL4BefSJyGq-1TJYojkUa3z5EG11KBI5B2Kulgg1bF_mxzzSgcqfwLlCMhH1dkQDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxc4fFNtbq9P1mRQqmO3_Sw2K7tiYkb5756ma-TZiP34A&oe=69AD76C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort and -communication", "keywords": [], "long_description": "People communicate through language. Through spoken language, but also through body language. In this VR application you practice your non-verbal and verbal language to improve communication with patients. This way you can prevent patients from building up extra stress for a medical procedure. It can help an anxious patient to relax. Patients experience less discomfort and overall procedure runs smoother. That is pleasant for both the care taker and the patient.", "short_description": "Practice your verbal and non-verbal communication to increase patient comfort."}, {"images": {"nodes": []}, "id": "444114790074195", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Patientcomfort en -communicatie", "keywords": [], "long_description": "Mensen communiceren met elkaar door middel van taal. Door gesproken taal, maar ook door lichaamstaal. In deze VR applicatie oefen je bewust gebruik van lichaamstaal en gesproken taal om de communicatie met pati\u00ebnten te verbeteren. Je kunt voorkomen dat pati\u00ebnten extra spanning voor een behandeling opbouwen. Een angstige pati\u00ebnt kun je erdoor helpen ontspannen. Pati\u00ebnten ervaren minder ongemak en de behandeling verloopt soepeler. Dat is prettig voor de zorgverlener en prettig voor de pati\u00ebnt.", "short_description": "Oefen je verbale en non-verbale communicatie voor het verhogen van comfort bij pati\u00ebnten."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": "https://thesimulationcrew.com/contact/", "website_url": "https://thesimulationcrew.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"]
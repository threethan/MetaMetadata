61028252", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031380_1260159764361585_5769019412615248064_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0orRcfKkAwQ7kNvwHApqtE&_nc_oc=AdrIzksgqg7Zh7szrL_e3BW5DijN0Cbw21l686RxQ_haKSKW0bcTRfZ7YUVOasqA0ag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bl5UWyJHLiGCTuZT9CbGt_xBnMxs89k00zLwOZ6kdQA&oe=69EE0583"}, {"file_name": "Solar_Lineup.png", "id": "2035068463295095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031382_2035068469961761_2300306408640013790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeC1hmUT9tYQ7kNvwEjAALo&_nc_oc=Ado4fVRxpTe6WhrxWO_qCuB4zLjF9PQY3cKJzTzuSu9WxUzjLRq0nudo-xk2nf46AHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Tzk7HD4FqEzJo3bqCHWR30hTnRNNWTJI1o78s-OtgEQ&oe=69EDF74C"}, {"file_name": "EclipticPlane.png", "id": "649643765610414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNLQh7tddpMQ7kNvwFgu8WG&_nc_oc=AdoIeSzzoZd-hysZBLpFsnIPzFt2Q4VTjs9Px4KAr3E5F1YWAUHyoBXimzF2u2DABlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18MwBQQKgJ4yoHWAST8Td4Ja3yD4MCDrrxTW4R07Ughg&oe=69EE1487"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iUEEHZmc9wQ7kNvwHpjMdr&_nc_oc=AdoqvFbSGI4R0n63l-uRRu85EfXYhPsjWLOf0SFuiVFEf679w-Z5xkq02FWatWd9x1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-ty5ksFw6aOF29EG-QwQrGFIA_So5xzYfcszBJ5kBeA&oe=69EE08AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsX1ya2TlFwQ7kNvwGgefBJ&_nc_oc=Adowu2UV4sgqY2figHBN8X_1I_SGI9ASHdQ3m0Uk5NyNaIz1RNos57mh0LB40sAU4CI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EjgIIupjR-Ppur_vjtDPObZ5spiTUpFRNpEWvSjE-1A&oe=69EE1996"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}, {"images": {"nodes": []}, "id": "432607531716369", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "d
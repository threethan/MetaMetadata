412615248064_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9_LMCHRiooQ7kNvwFK9_3a&_nc_oc=Adnhx2p35ZTyzb2lBPopI89PxBBLPWNzT848FzXasvrcskPdiwQ4lI0Z2qPw9YNWusU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvV3VU4nM2KKKmnQKjrFR1AnR1AnRP7LVDsBcJbVDz8g&oe=69A2E003"}, {"file_name": "Solar_Lineup.png", "id": "2035068463295095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031382_2035068469961761_2300306408640013790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiJJRrgZUsMQ7kNvwGen0kP&_nc_oc=AdlPDDpF1QiAdeeLzwURRoWYiAzciy-21YotDyWzPYlcsmT-CcBbwY4HVIT8RzAgjG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhttAzj9UPrHpvBHvl-ympxf7Wwblg-h5vAn8FR7R3OQ&oe=69A2D1CC"}, {"file_name": "EclipticPlane.png", "id": "649643765610414", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEHHUNeMKWgQ7kNvwHa1pdW&_nc_oc=AdknqYRtOdYXan5sQP7w1SAnGDtZeLoMculyrdhXSUuC7R_crUf7yDwSjWfn9snW9Uc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvbbfJ8zuFmc4u9NQrWDYBJw_MfDpZi3e8Z8q6d1976VA&oe=69A2EF07"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EAYVIZit1kQ7kNvwHpr0p2&_nc_oc=AdkHnjWmD3e_LKn6hAMGU4OIy42no2gMy0mTUWMoCAFZr1CCx_BXZyoe-gNImcLNC7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYErv6xTnIv3I74NhSBhBcreUfDD7v6aeUbJigVlaeEA&oe=69A2E32B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-GSJZ2KvdsQ7kNvwG-XDZs&_nc_oc=Adlkw8u2LvhxnvRyRlSBdTyuuvC9A3inCpZkOTadeFblvbmFRD3rF_TdRdQnj7A_PxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzBwxzr2Zgi9gtoEGT-MtGqGy2SyXghjhnoVrqEXRlWw&oe=69A2F416"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}, {"images": {"nodes": []}, "id": "432607531716369", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spheres", "keywords": ["\u30c0\u30fc\u30ec\u30f3\u30fb\u30a2\u30ed\u30ce\u30d5\u30b9\u30ad", "\u7389\u57ce\u30c6\u30a3\u30ca", "\u7be0\u539f\u3068\u3082\u3048", "\u590f\u6728\u30de\u30ea"], "long_description": "\u30a2\u30fc\u30c8\u3068\u30b5\u30a4\u30a8\u30f3\u30b9\u3092\u878d\u5408\u3055\u305b\u305f\u8feb\u529b\u3068\u81e8\u5834\u611f\u3042\u3075\u308c\u308b\u6620\u50cf\u4f53\u9a13\u306b\u3088\u3063\u3066\u5b87\u5b99\u306e\u96a0\u3055\u308c\u305f\u6b4c\u3092\u89e3\u304d\u660e\u304b\u305d\u3046\u3002\n\n\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u3068\u5149\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30c6\u30a3\u30d6\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u5b87\u5b99\u3068\u4e00\u7dd2\u306b\u306a\u308a\u3001\u97f3\u3068\u5149\u306e\u30d9\u30fc\u30eb\u306b\u5305\u307e\u308c\u305f\u30b7\u30f3\u30d5\u30a9\u30cb\u30fc\u306b\u547d\u3092\u5439\u304d\u8fbc\u307f\u307e\u3059\u3002\n\n\u76e3\u7763\u306f\u30a8\u30ea\u30b6\u30fb\u30de\u30af\u30cb\u30c3\u30c8\u3001\u88fd\u4f5c\u7dcf\u6307\u63ee\u306f\u30c0\u30fc\u30ec\u30f3\u30fb\u30a2\u30ed\u30ce\u30d5\u30b9\u30ad\u30fc\u3068\u30a2\u30ea\u30fb\u30d8\u30f3\u30c7\u30eb\u3001\u30ca\u30ec\u30fc\u30b7\u30e7\u30f3\u306f\u7389\u57ce\u30c6\u30a3\u30ca\u3001\u7be0\u539f\u3068\u3082\u3048\u3001\u590f\u6728\u30de\u30ea\u304c\u62c5\u5f53\u3057\u3066\u3044\u307e\u3059\u3002\n\n\u7b2c\uff11\u7ae0\uff1a\u5b87\u5b99\u306e\u5408\u5531 \u30ca\u30ec\u30fc\u30b7\u30e7\u30f3\uff1a\u7389\u57ce\u30c6\u30a3\u30ca\n\u5730\u7403\u306f\u6b4c\u3046\u3002\u592a\u967d\u7cfb\u3092\u697d\u5668\u306b\u898b\u7acb\u3066\u3066\u97f3\u3067\u5b87\u5b99\u3092\u767a\u898b\u3057\u3088\u3046\u3002\n\u6642\u9593\uff1a13\u5206\n\n\u7b2c\uff12\u7ae0\uff1a\u6642\u7a7a\u306e\u6b4c \u30ca\u30ec\u30fc\u30b7\u30e7\u30f3\uff1a\u7be0\u539f\u3068\u3082\u3048\n\u30d6\u30e9\u30c3\u30af\u30db\u30fc\u30eb\u306e\u4e2d\u5fc3\u306b\u98db\u3073\u8fbc\u307f\u91cd\u529b\u6ce2\u306e\u753b\u671f\u7684\u306a\u767a\u898b\u3092\u89e3\u304d\u660e\u304b\u305d\u3046\u3002\u95c7\u306b\u843d\u3061\u308c\u3070\u5149\u304c\u898b\u3048\u3066\u304f\u308b\u3002\n\u6642\u9593:12\u5206\n\n\u7b2c\uff13\u7ae0\uff1a\u9752\u767d\u3044\u70b9 \u30ca\u30ec\u30f
61028252", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031380_1260159764361585_5769019412615248064_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YIygVdUhE8Q7kNvwHr7lP5&_nc_oc=AdpIdx-vL4dkRRjwc-fVwfBEYdz6yDO0Jw9YX6UnJ8QD693sILfFBdvTOTF7v6MvW-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I-4EDJO8ebx9fh0zYoenUFbVUTLSF25-g_mTzAdNXzg&oe=69EB6283"}, {"file_name": "Solar_Lineup.png", "id": "2035068463295095", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031382_2035068469961761_2300306408640013790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO8dhh7r5DoQ7kNvwFZ4pjK&_nc_oc=Adq_2g79aVMtSpQB8iubbiWMq6H-4rSQ3k9KcKmA5BKstfZA2ct9YiXZLnU1jYudgAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oS3CrNYrnZVyYKBdYcJ-_7XWnWRjNlGbqbIhmPQ1E9g&oe=69EB8C8C"}, {"file_name": "EclipticPlane.png", "id": "649643765610414", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAJVL9KmXw4Q7kNvwFvJhZx&_nc_oc=Adocc02bqdProM9PeQ3Nh3ugjSMzpMWmuM0cuOfhOBvj_BCep7IYKVTjITsgcWnBqCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y_4wJHnXHZY8wKR1pzkx6RGJRgbCcQv-tGHmSpOSI_g&oe=69EB7187"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iUEEHZmc9wQ7kNvwFMD6Hl&_nc_oc=AdqeBxH0t0WgH2GBcJTzZV5VKVAM0qMEZbKZWlRyQJicMUNU9HKTuH-ZiV1Hb0-lNSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29-dYPyXD254xi3USW8-05Joe69Y2TyLfzvGY7W6dWMg&oe=69EB65AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6s6mC6hF3kQ7kNvwHCRibm&_nc_oc=AdpKu6MCaaCW_VQUs5l6xk7SwdT-wHrrmQc_mbrYXPE4BLqKinzVXW0OHYodOhYwl-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OnVekT4cFscXllgXDbORGf9ZTwUKHMfdDY7Jvnpb1Iw&oe=69EB7696"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}, {"images": {"nodes": []}, "id": "432607531716369", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "d
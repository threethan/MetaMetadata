61028252", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031380_1260159764361585_5769019412615248064_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlx9keJ5-LMQ7kNvwHFHju7&_nc_oc=Adog5b89nosM51u_HrwYQQUPyUWJwpQaf91dsdG7tu4lCHyyAAORiW7QQh_rDubhQMA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSxVIgD6p2ClSPeyDESCL4NPCyHLF2hg9fYTcSnbO6vQ&oe=6A8AE803"}, {"file_name": "Solar_Lineup.png", "id": "2035068463295095", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031382_2035068469961761_2300306408640013790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4UGPR15WVIQ7kNvwGuNB_P&_nc_oc=AdroB0735UdWrdwexP6mQGNn4FsKwN8_MEQpPC_EZy04qtvD6DXD3YdrYgJUfEIpEyU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwF64HpKPwASZbP6GZrXHMZZpEgNaOcGj2rG-Rwm1CiQ&oe=6A8AD9CC"}, {"file_name": "EclipticPlane.png", "id": "649643765610414", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbrjLWtkLQoQ7kNvwE2HNJO&_nc_oc=Adpz-_ipW4xXogPP3-qNStiE1wYMwFbADcc95n4jy0g1-niF8i369B69jndyNNL8VbQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKnkUZ4LOdAmohzg8JdkOBAAqxU57RTxJG6D-pnMjPHQ&oe=6A8AF707"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzTDqkSrazkQ7kNvwFNc4pE&_nc_oc=AdqvQpCcU9Z1UtDUSDYKOBTO5-W8BedyQSNU84jyG0XJg6CHX2YSG5vU-fPE5ptxwak&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYGNYbHiQNnY7XTYEeI-vZFhWxhRpUOXxuuCft1-mfbg&oe=6A8AEB2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3GQEBKF3tQQ7kNvwGG2p9r&_nc_oc=AdqVgx2dYpPkwqAdi15tpA1XjpvgLc1VCMCdPr5MZpUHRPTfXKyW2mt1Ksl9Zik1Q64&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFNYfSbVfl4DcguKCVzI0NpTF42l4-R3M9idpXZQ96rA&oe=6A8AC3D6"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, from executive producers Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}, {"images": {"nodes": []}, "id": "432607531716369", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "d
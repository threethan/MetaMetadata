t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbdVdP_fV5IQ7kNvwHUMWyl&_nc_oc=Adp_O3bjYu1DBN56c42XgsbD78RuBks6LNd1U4j22UQmMZhdr8BIdE8k32T8JimdPHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELjmghaYjH7Y5nwMtXPVq3yT_FFvabPL9iZOLXtUik1w&oe=6A89A587"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzTDqkSrazkQ7kNvwGx1iB1&_nc_oc=AdqSEI5b8oPbCWwKqU9ORwVvRDVYNZs9CiC1AzmqEV96GEVqExx1jeZjKj3J7z5zD1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmhKUnh-H7573D5WgrbbyXr1Hk3tAMG5S0kHQQOeoLWw&oe=6A8999AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6yqnjtHiTgQ7kNvwFLvmN7&_nc_oc=Adqdkqcy5hBpDShJSUv18FKUQk61ZoENkHoxvK2PgLyljV74tY4U6IV9Nfd1gKGygCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuJ5m7-fJgeWPge8WIN4DEAAcRK7L5tOty-8uCNM-VAg&oe=6A897256"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}]}, "developer_name": "Novelab", "developer_privacy_policy_url": "https://novelab.net/en/privacy/", "developer_terms_of_service_url": "https://novelab.net/en/license", "publisher_name": "CityLights VR", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "345644220528053"}}]}, "scheduled_offers": {"count": 4, "nodes":
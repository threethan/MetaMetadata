Gq7ERxFdQg3uzFLsSDO0xukY6b4Abxg5g&oe=6B0318C3"}, {"file_name": "Solar_Lineup.png", "id": "2035068463295095", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031382_2035068469961761_2300306408640013790_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k_1sbr1_GcQ7kNvwHZv_pU&_nc_oc=AdpULAHRiMSXTV_DkfVPs24iTlduOuzekA9b6tcruzCFP2Zqe2oHC6RTX_SCwHSj5us&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvhS1wJt7vdvconlaoORQGOQwZ5wSyeg-W4E4bx26Wlg&oe=6B030A8C"}, {"file_name": "EclipticPlane.png", "id": "649643765610414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VozLTzsQqIkQ7kNvwHI8kCG&_nc_oc=AdpNBtsc92WANdmBVXtxZbW7f0TfdDrrgf2duDelXapSYPaNrfqvQ18dNFCHzAdSs5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5DPRK_AGNbrrsUDmyvHWQCzGPKz2TVyNK5IHf0RieLQ&oe=6B0327C7"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO63gwzqwZAQ7kNvwHTEgbZ&_nc_oc=AdpKg0kWkS1sS39HLy8ltYQP1K23YoZTEgf4ZqgTT6RalpRcloYIxaqG77GII14yQGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6PA75RvYk0L2GHQi3XhxwjkV8eIWpbUKoI1RZNB5_fw&oe=6B031BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCFKh1DmuI8Q7kNvwEGGjVO&_nc_oc=AdpJ71LZzpRCU-W_L-95voPbgfsO9xZwtPAlpFh944978M6fVl5JiGzw8T3vqgokKyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqx7NyYzPjS1gu8n6LOGpjsfqhD4TRHZ-7E1hLl3Ki6w&oe=6B032CD6"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}]}, "developer_name": "Novelab", "developer_privacy_policy_url": "https://novelab.net/en/privacy/", "developer_terms_of_service_url": "https://novelab.net/en/license", "publisher_name": "CityLights VR", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873
uluscdn.com/v/t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UMrLpK9VnsQ7kNvwFTUnoE&_nc_oc=Ado3_5tkTITFzGoDn21vkaWH9t7m2s6G3TJqlMNx3wmdLamECpggqTEhqRHNpNnJybw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0WL3W98zqtxYxGj-PsxcycQcwP7z3a19tivr2dr9LiA&oe=6AA40387"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBGWRdXfTBgQ7kNvwGrLRYK&_nc_oc=AdoTGVQonq4TNrQQyKvbQlRaQQYmBT3dQfSLiF_g8YBqlVGVTQ6U21MsOD2KLQ9GXZc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIlMkf1oq3U7D7g7dTpIr7Y1t75HHN88MQ0EWrn_SuoA&oe=6AA3F7AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B_nnPmLLn4Q7kNvwE2ouEt&_nc_oc=Adp4SeHhThsYDdFkXGxndSQvJ7W4EsnHtvR4abZrrZcrCRXimFH7b-rWAVXHyy-ovkw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWkefOqU8a2pC_vD7VLsqYyNOMsZSmaOiDWKAjUm1HIA&oe=6AA40896"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}]}, "developer_name": "Novelab", "developer_privacy_policy_url": "https://novelab.net/en/privacy/", "developer_terms_of_service_url": "https://novelab.net/en/license", "publisher_name": "CityLights VR", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "345644220528053"}}]}, "scheduled_offers": {"cou
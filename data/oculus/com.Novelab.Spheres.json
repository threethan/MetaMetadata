YkideyTCsJ2F0E_rPKK9mfEV7MMoXKZ8Q&oe=6B070D43"}, {"file_name": "Solar_Lineup.png", "id": "2035068463295095", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031382_2035068469961761_2300306408640013790_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRvNBuPX7JAQ7kNvwFDOBTV&_nc_oc=AdpBNuAqOqNtchpBAnJI-dtVWc7evm-4P7NgLtLm8VJ-PbQX8RzOFcI_AMvQQQ0aWbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYONwYKoJ4yalOVCSphqbvk7ZxZlHPfZ3YtjT-fvXZ_g&oe=6B06FF0C"}, {"file_name": "EclipticPlane.png", "id": "649643765610414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b00Wwq1AMYQ7kNvwFhLR93&_nc_oc=AdqEz86L0SMbkrkXhXg7fJaa8meoTSmPuflKJh_o5u2AB0ARz0l4UVbYYrrC5JdYvKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0F3PRsoSKTICbDCDSDXnEKBbNEeFa99yxlGW5CzoSuw&oe=6B071C47"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3qjedOkPo8Q7kNvwGzKVMZ&_nc_oc=AdpG8JpXQkzNVFyaZP5wu8Ou-3yrWfbZ0Vja6fyLJk3MHJbC6iR5wJMkmMKpKW4chlQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOPQjS2-O_UHTBjZlb3x5kA2BsY1hfSar6mDpbpVrtSQ&oe=6B07106B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB0dpSdzSTcQ7kNvwEFTMsk&_nc_oc=AdpGxx6zYgK0JZLUcHVeJk69GZEXUXv6AhVR6F7CBx8K-YCCyp3UgoLgJ63Z9-k4M8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQy4XoYytAfRF0m9WWPLP5KJg8p35tVubVdKAOYxwmUg&oe=6B072156"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}]}, "developer_name": "Novelab", "developer_privacy_policy_url": "https://novelab.net/en/privacy/", "developer_terms_of_service_url": "https://novelab.net/en/license", "publisher_name": "CityLights VR", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873
t64.5771-25/39001691_649643768943747_4782537179678013832_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAqZ-Fubrt0Q7kNvwE-hoxy&_nc_oc=AdqRZvfAdHnDZlMgx-wWQRzmxCQKV2zZ6wmRXaSglD2RD4e8QMWOjiFzTqnM9EmrrsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgbm3fHEedeYCsfO5pbf_VYFT-JwNQO_eyK-974dNDXg&oe=6ABFB307"}, {"file_name": "BirthOfAStar.png", "id": "427474154904608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031347_427474158237941_7277177587629565452_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KZDYZGBTrEQ7kNvwEqFJPK&_nc_oc=Ado1vcrvGxAUPe9MnPxM_keRiCQVF4J2JTp5rU8rYJraNfjG6N1X72FNrZe3jItQr2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv6JvUKb5HESZDWgmaOTIfvM_nvI3Gfdmj6AVHoQRmeg&oe=6ABFDF6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SPHERES-trailer-thumbnail.png", "id": "782218069235443", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_782218072568776_7730529483395624132_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oKn-dJlOuEQ7kNvwEGYbbs&_nc_oc=Adq55XBK9NTjnKQMjdenoEYNKVXNrE4J-PgWRafHW-vS0CxJzTLbqGt6aauqytEkXi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCdOhI1D1tgoL2nMZ8jaZgrN2hZOSCCkbFDUMz_yBRmg&oe=6ABFB816"}, "display_name": "SPHERES", "keywords": ["spheres", "space", "aronofsky", "chastain", "planet"], "long_description": "Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith.\n\nChapter I: Chorus of the Cosmos\nNarrated by Millie Bobby Brown\nPlanet Earth sings. Our solar system becomes a musical instrument as we discover the Universe through sound.\nTime: 13 Minutes\n \nChapter II: Songs of Spacetime\nNarrated by Jessica Chastain\nDive into the heart of a black hole to uncover the breakthrough discovery of gravitational waves. Fall into the darkness, and you will find the light.\nTime:12 Minutes\n \nChapter III: Pale Blue Dot\nNarrated by Patti Smith\nThe Big Bang was silent. Then came sound. Travel from the edge of the cosmos to uncover the strangest song of all.\nTime: 13 Minutes", "short_description": "For thousands of years, we have looked to the stars to find our place in the universe. Uncover the hidden songs of the cosmos through this powerful, immersive spectacle that fuses art with science. Using hand tracking and light interactivity, join with the universe and bring life to the veiled symphony of sound and light. \n\nDirected by Eliza McNitt, produced by Darren Aronofsky & Ari Handel, and narrated by Millie Bobby Brown, Jessica Chastain, and Patti Smith."}]}, "developer_name": "Novelab", "developer_privacy_policy_url": "https://novelab.net/en/privacy/", "developer_terms_of_service_url": "https://novelab.net/en/license", "publisher_name": "CityLights VR", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "345644220528053"}}]}, "scheduled_offers": {"count": 4, "nodes":
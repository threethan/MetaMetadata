c_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoTePnYXofRfUbRcVE4VMSzeNry-hJ-al0hTm6SeHiuw&oe=6AE21184"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flight Simulator: Airplane Pilot VR", "keywords": ["Flight", "Airplane", "Aircraft", "Flying", "Simulator"], "long_description": "Take the controls and become a pilot in an immersive VR flight simulator! Experience the thrill of flying an airplane, aeroplane, aircraft or jet from an immersive first-person cockpit.\n\n\ud83d\udeeb FLY LIKE A PILOT\nStep into the cockpit, grab the controls and experience airplane flying in virtual reality. Control your aircraft through takeoff, flight, maneuvering, descent and landing.\n\n\ud83d\udeec MASTER TAKEOFFS & LANDINGS\nTake off from airport runways, navigate through the skies and return safely to the airport. Improve your piloting skills and master smooth landings.\n\n\u2708\ufe0f IMMERSIVE AIRCRAFT EXPERIENCE\nLook around your cockpit, interact with flight controls and experience the sensation of actually sitting in the pilot's seat. Feel the freedom of flight from a true VR perspective.\n\n\ud83c\udf0e EXPLORE THE SKIES\nTake your aircraft into the skies and enjoy immersive flying through beautiful environments while experiencing the world of aviation.\n\n\ud83c\udfae BUILT FOR VR\nDesigned around an immersive cockpit experience, this flight simulator puts you directly in control of your airplane.\n\nWhether you're searching for an airplane simulator, aircraft simulator, flight simulator, flying simulator, pilot simulator, aviation game or VR flight game, Flight Simulator: Airplane Pilot VR puts you in the pilot's seat.\n\nTake the controls. Start your flight. Become the pilot.", "short_description": "VR flight simulator with immersive cockpit controls, realistic airplane flying, takeoffs, landings, airports, jets, aircraft and pilot experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1351258298076539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673745728_1536883548457203_1715301017740665751_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3yyiYnOoUsQ7kNvwFCRCE4&_nc_oc=Adr7Xit5qnNMoKq79qjJe-ohg9pi64ZetPljfkwbyRB_LPUvKJCejIL6wY85Z0GfDDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN4rS7wWj-c41s74gFXXoLnwzfx4wFoRUqm5V41UU4lg&oe=6AE1E935"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator: Airplane Pilot VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1787062140, "lastRevision": {"nodes": [{"id": "1259157097286660", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1259157083953328", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "
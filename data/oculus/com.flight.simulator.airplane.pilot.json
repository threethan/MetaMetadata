_936020603972105608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1ffwwy3HJMQ7kNvwFYkamV&_nc_oc=Ado-iOozO7MX92qEGQnHg45KXsubCpMQPCAZCe3JFOeWrDO-t3rwA0TAdatjt4GO5dE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVY1ssz--x1vI8_kH6ZnvCLgET9G22Qy0oQBR0F6fwcA&oe=6AE21B23"}, {"file_name": "1.png", "id": "2085762552047107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_2085762558713773_5459870417826167528_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCU1f3K2gF8Q7kNvwHUyeVY&_nc_oc=AdqAHeInF-bt8UP1KLeoWzmt72Tgvt5TW6YEzjrFeppPcHFuLGTmG2AwVkP141hgQp4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkBUkitjyVjlhpneVYSe_mRSsufARNcZoG5T4yqzyV7A&oe=6AE1FA31"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flight Simulator: Airplane Pilot VR", "keywords": ["Flight", "Airplane", "Aircraft", "Flying", "Simulator"], "long_description": "Take the controls and become a pilot in an immersive VR flight simulator! Experience the thrill of flying an airplane, aeroplane, aircraft or jet from an immersive first-person cockpit.\n\n\ud83d\udeeb FLY LIKE A PILOT\nStep into the cockpit, grab the controls and experience airplane flying in virtual reality. Control your aircraft through takeoff, flight, maneuvering, descent and landing.\n\n\ud83d\udeec MASTER TAKEOFFS & LANDINGS\nTake off from airport runways, navigate through the skies and return safely to the airport. Improve your piloting skills and master smooth landings.\n\n\u2708\ufe0f IMMERSIVE AIRCRAFT EXPERIENCE\nLook around your cockpit, interact with flight controls and experience the sensation of actually sitting in the pilot's seat. Feel the freedom of flight from a true VR perspective.\n\n\ud83c\udf0e EXPLORE THE SKIES\nTake your aircraft into the skies and enjoy immersive flying through beautiful environments while experiencing the world of aviation.\n\n\ud83c\udfae BUILT FOR VR\nDesigned around an immersive cockpit experience, this flight simulator puts you directly in control of your airplane.\n\nWhether you're searching for an airplane simulator, aircraft simulator, flight simulator, flying simulator, pilot simulator, aviation game or VR flight game, Flight Simulator: Airplane Pilot VR puts you in the pilot's seat.\n\nTake the controls. Start your flight. Become the pilot.", "short_description": "VR flight simulator with immersive cockpit controls, realistic airplane flying, takeoffs, landings, airports, jets, aircraft and pilot experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1259157090619994"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2940246472995679"}]}, "baseline_offer": {"id": "2940246472995679"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787062140, "status": "PUBLISHED", "id": "2940246472995679"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1260896463779390", "version": "0.1"}, "id": "1692330348667443", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fa
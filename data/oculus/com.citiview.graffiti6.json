34315049318_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgALsN17-bIQ7kNvwFtRR2q&_nc_oc=AdrodleiHFrfAXdbCtLptdfqBBfJT46zSm0Ntd37m25xP4xxEJdM_YFmvzjojqIpfrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4e9eDCth4M2VxpyNVK8nyrImykiOTirNY2vKY39etRg&oe=6AFDAD53"}, {"file_name": "screenshot_3.png", "id": "2925632007769932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673819499_2925632011103265_4596001684459640564_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K57waMIJM3AQ7kNvwG4F0X6&_nc_oc=Adp55lT1XBvw2RTZSyEeIPWesh-Y9dJ5ta4_9VTfIFqLaeP8DMYpI2PIaZmHryKGX-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlwH6dK7-O0ZTcKuSlawLIXjPDLSkvMkjetcuf916O0Q&oe=6AFDB997"}, {"file_name": "screenshot_4.png", "id": "2286073285579359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/793139181_2286073288912692_782253615227926790_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkQFqEcRGBgQ7kNvwFHTffW&_nc_oc=AdoquNUjpk38xh8Bjdg3dSSMjszUC27pmyPWqdx3TXmhbd95R4MprW_TDMUG3cKSu7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWzPKo4kWWk9ADt4mo_TK-iFpQGhwKfwJbBJwFau0WkA&oe=6AFDB584"}, {"file_name": "screenshot_5.png", "id": "1113314634387178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596106838_1113314637720511_5278790084171432614_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOzThbpywoMQ7kNvwEvokqG&_nc_oc=AdouPxIgxdd26EbLbCOIkqL8SLfLBwnbTKe_otuVXUa50sBJ1UEr388Trp3oeY7sPQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYoty63imExRInoAc4KuC-lYPUkix6Jon6KA8IKl1oSw&oe=6AFDCEDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "4216328018511646", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604375581_4216328021844979_8689378508047812097_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZs0y5sYQYgQ7kNvwHZmA9u&_nc_oc=Adpof9pggwIi2baQqdyE8kTPalcj33YSzGHMpcRzRVU_y1kO_VY1fIzuTGjGTEBQAp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPC8eRdE2qk_KXTOq7nKIJkGpc4pXSZeHxgCleRlO4Qg&oe=6AFDD376"}, "display_name": "Graffiti 6", "keywords": ["graffiti", "cleaning", "painting", "art", "sandbox"], "long_description": "Graffiti 6 puts a pressure washer in your hand.\n\nCLEAN IT\nThe golden-hour alley arrives covered in years of faded throw-ups, tags and city grime. Nothing wipes a wall in this game - you blast it clean. The water lands exactly where you aim: grime peels off in clean stripes, old paint washes away, and the brick goes dark and wet, then dries in the sun.\n\nTHE WASHER\nThe CITIVIEW PRO 3000 hangs on its red cart with a real hose. Twist the tip between a red pencil jet that cuts a sharp line and a white fan that sweeps whole rows - and throws a rainbow when the sun is behind you. The jet even knocks cans across the table and blasts stencils off the wall.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils from A to Z, real mist and drips. Spray on freshly washed brick and your paint runs down the wet wall, just like the real thing.\n\nSPOTLESS\nA clean meter floats over the gun as you work. Take a wall to spotless for a chime and sparkles, light up all 13 walls on the cart's board, then hit RE-BOMB and the vandals are back for another job.\n\nTHE ALLEY\nSix real brick sets with deep relief, wet cobbles, a fire escape and loading doors - and six looks: golden hour, high sun, sun shower, snow day, first light and autumn gold.\n\nControls: grip to pick up the washer or a can, trigger to wash or spray, A/X twists the nozzle, X colours, A caps, Y photo, left MENU for looks, re-bomb and music.", "short_description": "The alley is bombed. Grab the pressure washer, blast years of old tags and grime off real PBR brick, then spray your own piece on the clean wall. A real jet that strips paint and dirt where it lands, a fan tip that throws rainbows in the low sun, wet brick that makes your paint run, and 13 walls to wash spotless."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffiti6/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffiti6/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341506332375563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596168449_956987036845539_2252868881292693154_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=935Jq4FsC8YQ7kNvwGd_wWd&_nc_oc=Ado-W3siaDpU2PyayEEFRcZv6Kad-zfNDdZie6-caX-VvyKFXGZJf9dfy1UEENBuJhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY4Wcui6pn0DK_6ELb4P_YVePPJVyS34IV0lcGITC3dA&oe=6AFDB7AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Graffiti 6", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1791403260, "lastRevision": {"nodes": [{"
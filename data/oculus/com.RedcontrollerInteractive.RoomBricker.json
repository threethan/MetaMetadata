id=6e7a0a&_nc_ohc=M9k36J56xQwQ7kNvwGUU2KK&_nc_oc=AdrjlVY0PEjWGWNC0eIYmPxRRMqF9l4gqnbibpUbOPtcHHFqcl4rRvaISsda5L23zJs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNOIB2eW-wMD31_xah9daAYWDoCg_3iBZeK3MQzz6fpA&oe=6A918167"}, {"file_name": "New Project (6).png", "id": "1372792568129642", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/654944867_1372792571462975_5961676233549586456_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1ISi2eEcWAQ7kNvwEQbgi0&_nc_oc=Adr8Gzf9EGl3gLaFpc4HlKG8ZtsqUjDTTdCWLs_3urQZtXt93AjuEpsPS-d1zgn89Us&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0b-LCZgMk3n63ShzEs1SZ9YwhPybNw9mogj5orTdSkw&oe=6A917048"}, {"file_name": "New Project (8).png", "id": "1268307526355337", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499620875_1268307529688670_721907827267762320_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsLQ5Fx1EPUQ7kNvwH6UgTJ&_nc_oc=Adpbc1USafVaAd4Iz10u10v_uN7gC0YeLiqnB7M_Y5AKcY-GMEJl_8NZDPHDdUWyOlg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF31s0kq8G1ql78Ha05TWmWDi8utIjDiVnBu4B5ECthIA&oe=6A9184A6"}, {"file_name": "New Project (7).png", "id": "1424320086410769", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/673522158_1424320089744102_5327905045944986320_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLk7R2n2t0EQ7kNvwGmGizw&_nc_oc=AdrNGh6Pury-JD4OYndIgkuw4aK-VgBklif_sD65rj_7tzqZLQ733EEzaHB5MOWrKNA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFejPxkvbflkK0hgTWwAtDAnI5IX--9KfOLeEUtcnvh7w&oe=6A9166D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (53).png", "id": "1801508704523701", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619485_1801508707857034_4936344073446161417_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDljHU1TDYwQ7kNvwG1KJRe&_nc_oc=AdpIW1sIsds4MCmg5s1hoI93d59Bnyj03_5KxhmHNq2EdFn5B1BYDaB5B2TodxpvAjI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHexl6DV0F7qvl456MWZBv_ayCKQRNTpOcOGlqJJhCGgQ&oe=6A916380"}, "display_name": "Room Bricker XR", "keywords": ["Arcade", "MixedReality", "Brick", "shooting", "ball"], "long_description": "Turn your room into a futuristic mixed-reality arcade in Room Bricker XR! Your real ceiling, walls, furniture, and scanned room surfaces become part of the action as neon brick patterns appear around you.\n\nUse either Touch controller like a physical paddle to strike, aim, and redirect the cyber ball. Move naturally through your space, build combos, collect coins, catch power-ups, and keep every ball away from the dangerous red energy floor.\n\nBattle through a 100-level campaign filled with room-adaptive spirals, targets, waves, honeycombs, stars, checkerboards, and dense voxel mosaics. Every level keeps its core pattern, but brick placement, scale, layers, and count automatically adjust to fit your room, making each play space feel unique.\n\nDiscover special bricks with explosive, armored, icy, slime, portal, lock-and-key, and metal behaviors. Unleash Fire Ball, activate a Floor Shield, create Multi Ball chaos, or use the right-hand Laser Gun to clear difficult targets.\n\nUpgrade your power-ups with collected coins, chase higher scores, and maintain long combos for bigger multipliers and bonus rewards. At milestone levels, face five three-phase voxel bosses mounted across the ceiling. Target exposed weak points while managing the ball and dodging incoming projectiles.\n\nWith neon cyber visuals, reactive trails, voxel destruction, spatial sound, adaptive music, haptics, and no artificial locomotion, Room Bricker XR transforms your own room into a fast, physical arcade battlefield.", "short_description": "Turn your real room into a neon mixed-reality arcade! Strike the cyber ball with your Touch controllers, smash room-adaptive brick patterns, collect powerful upgrades, and battle massive ceiling bosses across 100 levels.\n"}]}, "developer_name": null, "developer_pr
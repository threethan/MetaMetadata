g?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv996gpeTd4Q7kNvwFMLIcy&_nc_oc=AdrAddGNY3CSCFwy9p_h71c89bLgmjUNGXPtWqllk5QViQEGTcF7EV_Ji_CIg_DDtKw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6CVgYD061TLSETaYvlJZw_6SZ37a7jIPG9Zc9jLNj_A&oe=6AFB314E"}, {"file_name": "screenshot-1-village.png", "id": "2858542594539064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830441_2858542597872397_3028983610632281836_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCXFRZPfL6QQ7kNvwGVMRWv&_nc_oc=AdoldeG_aDjb6jwvqtjqQZ6pY5kr6Wo6BWsEBbkVJd3M-9OSKd45l0ovUHUHYXtZUSg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFvPsAOijvhGqnzRKVFHKDgrMChfUE9bYnBRArF2v2dw&oe=6AFB1FA4"}, {"file_name": "screenshot-3-fishing.png", "id": "1661300078944872", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673819499_1661300082278205_4249210771583569968_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNGcvETsyP0Q7kNvwHLiloZ&_nc_oc=AdpuuEUVQdjhYwkWJGnVtkFi98CWtk2Lu4Gr9eHFM5AOh4yGP9X6kg1TMIaNNJbayxk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf4pc_3DV3pLw4GJTI-YBmH2LsH2q2vdFB4yz6dLqwRg&oe=6AFB1F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic.png", "id": "1647737306710500", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595129854_1647737310043833_9122737948554312444_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zgaWh4-7A8Q7kNvwF1mi82&_nc_oc=AdowjCxg_WRw2viCB2kPSM8eya7tASDmI7BSA5WysZFSE3x2ugloApxTW4X7fXVyUdM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZp5fCPITH2wfHwbQqvUnzhVMg8xEAdegowuom2LlBeA&oe=6AFB4789"}, "display_name": "Vagrant", "keywords": ["rpg", "roguelike", "deep"], "long_description": "A whole realm on your table, drawn in light.\n\n  Vagrant is a survival RPG played on a tabletop in VR, rendered entirely in glowing vector lines, the way an old arcade monitor would\n  have imagined a fantasy world. Every realm is new: hills, forests, rivers, towns and ruins, shaped from a seed the moment you start.\n\n  YOU ARRIVE WITH NOTHING\n  Pick up loose stones and fallen branches. Bump trees and boulders to gather more by hand. Craft a stone axe and a pickaxe, and the land\n  opens up: timber, ore, a workbench, a forge. Build walls, doors, beds, chests, farm plots and fires wherever you like.\n\n  STAY ALIVE\n  Watch your food, water, warmth and rest. Hunt, fish from the riverbank, forage berries and cook over a campfire, and feed it wood before\n  it burns down to ashes. Nights are cold and dangerous: light a fire, or pitch a tent and sleep till morning.\n\n  MEET THE PEOPLE OF THE REALM\n  Talk to innkeepers, traders, smiths, priests and villagers. Take on their troubles, trade for what you need, and listen to rumors. Some\n  of them are about things nobody else has found.\n\n  PLAY MUSIC\n  Pick up a lute, flute or drum and play in the square. Townsfolk dance, and some join in on their own instruments, live and in time. A\n  crowd fills you with courage: the longer you play, the tougher you become.\n\n  MAKE FRIENDS\n  Win over a stray cat with fish, or a dog with meat. Your pet follows you everywhere, even underground, and fights beside you.\n", "short_description": "You arrive with nothing. Gather, craft, build and survive in a living tabletop realm drawn in pure vector light, then find the Amulet at\n  the bottom of the world, and the starship it was made to power."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/vagrant/privacy", "developer_terms_of_service_url": null, "publisher_name": "Atonal Fugue", "support_website_url": null, "website_url": "https://atonalfugue-ecfggyfue0efbwhm.westus-01.azurewebsites.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category"
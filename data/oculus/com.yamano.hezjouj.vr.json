_sid=6e7a0a&_nc_ohc=Itp0vDQ4N-oQ7kNvwGJViPt&_nc_oc=AdrP24eJJYcmZORbBpFa0kzd1Z23PjMXLAOF7W_8vVxoWisOOSEoku6W6Mmmd770G0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0LzD6tUvwxKdCmxg4LqYHBfd1N8klShmII1H3qxJZUw&oe=6AF332D3"}, {"file_name": "05-enligne.png", "id": "2039508240057284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673751957_2039508243390617_8845639738076155836_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VG-gMAQBEIQ7kNvwH-OdCi&_nc_oc=AdpY0U8EpVyRfxJ2wJVbTEoP03MJccEZ4yksGk5xQrI77WW0VgzBYK84yP6VwE_DVDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv11oLAMPWc8VrJ-dOXfSyrnQNHL8g0sl4L64vqfuN9g&oe=6AF32D15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hez Jouj", "keywords": ["cards", "Moroccan", "Morocco", "multiplayer", "tabletop"], "long_description": "Hez Jouj (\u201cpick up two\u201d) is the card game of Moroccan caf\u00e9s. In virtual reality, you sit at the table: wood, zellij all around, mint tea, and opponents who hold their cards, draw and slam them down right in front of you.\n\nHOW TO PLAY\n\u2022 40 Spanish-suited cards, 5 each. Play a card of the same suit or the same rank as the top card.\n\u2022 The 2 \u2013 \u201cHez jouj!\u201d: the next player picks up two\u2026 unless they answer with a 2, and the count goes up (4, 6, 8\u2026).\n\u2022 The 7 is wild: you call the next suit.\n\u2022 The ace \u2013 \u201cMatl3bch!\u201d: the next player misses a turn.\n\u2022 Nothing to play? Draw one card, and your turn passes.\n\u2022 Empty your hand first to win the round and score the cards left in the other hands.\n\nIN VR\n\u2022 Your cards stay in your hand: hold the fan in one hand (left or right), take a card with the grip of the other, lay it on the pile or throw it.\n\u2022 Point and pull the trigger to play or draw. Hand tracking works too: pinch to grab.\n\u2022 Seated and comfortable: the camera never moves on its own.\n\nMODES\n\u2022 Against the computer, 2 to 4 players, three levels, house rules (4, 5 or 7 cards\u2026).\n\u2022 Online quick match, 1 vs 1 or 4 players, at the same tables as the Hez Jouj mobile game.\n\u2022 Moroccan voices in Darija; interface in Darija, French and English.\n\nFree: no ads, no in-app purchases. Online play uses an anonymous sign-in (no account); your nickname is visible at your table, and you can report or block a player.\nPrivacy policy: https://aminezamani.github.io/privacypolicy/", "short_description": "The card game of Moroccan caf\u00e9s, in virtual reality. Take your seat at a wooden table, a glass of mint tea by your side: hold your fan of Spanish-suited cards in one hand and slam them down with the other. Play Hez Jouj against the computer, or online against real players \u2014 people playing on their phones included. Free: no ads, nothing to buy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aminezamani.github.io/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Yamano", "support_website_url": null, "website_url": "https://aminezamani.github.io/privacypolicy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1284279278110287"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1606763657574675"}]}, "baseline_offer": {"id": "160676365757
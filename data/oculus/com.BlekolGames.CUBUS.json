3-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDvcIgL7NugQ7kNvwG1iRNa&_nc_oc=AdoD3_2mVUk9DsfBnnFNQ7zloVwjpBfh4DHsaSPXLShPQ2lJJGjONYRnZkOnpSeQnjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIyW2I5Bl2xfa7vp4PP0wjO4ilheDH4VJ1dfhGQgGhuw&oe=6AF1F589"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coNNNrNhZosQ7kNvwGcbm-A&_nc_oc=AdplbdEfquJ6QsNWCkSmggW5g88g2qHxDJcQwh4DVKYUWFeUJEsFrcJ9L9V_pJWAF7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKlWTJcS3kCavCooB5EUrN5aTa_xRnVF4C4kZqCnssxQ&oe=6AF1D7AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s4SveAqrqQQ7kNvwEWYQLN&_nc_oc=AdoKg5aTHf0angRGe39_m4FaSkcprE4uOYNSRi1JrTVLGgoEdYYQP7jXRNucGS7uQ54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3kOQUNvMSzxAZjixou8hFyGY1eEEqUMrxOvwPO9UkMA&oe=6AF1E043"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSjXYpqiF54Q7kNvwExWrvh&_nc_oc=AdrH_PyLvyPsUj14L5UIazx6tNeowiw2UiB_XoV4jj0-Jh7HuIww68WEbpHZGSARuxk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzlPMhEUaj-JeNTsvZDIghh7pIfBGrtf5WSiNxs6A7UQ&oe=6AF2007E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkPmDW1bSSAQ7kNvwFdJlLI&_nc_oc=AdqxtNotwbf7AR6eY7Krwm-mAUa1yOBxHxmK9HeX95HDjDy_nD4Qdv9_OuyEe4b7oxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7FzPahr2fFWzxn3-dIikAyPRE94Vi4WejGdbBtiWjNg&oe=6AF1F213"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
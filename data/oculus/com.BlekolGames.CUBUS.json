5-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbScESTNPeoQ7kNvwGQXnYW&_nc_oc=Adpnd5yHPkhiu1kGnnvQvzCJjV_kdrIInIKtv71-Rrdoqt1X54xPpSxYRl_5TNJ39RI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNAoer1WAJagPJhUNndljsDK-O3cZuARF7k6Qngnit-Q&oe=6AF34709"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coNNNrNhZosQ7kNvwG7NgTm&_nc_oc=Adre1jW8wFToNQjKCRp3k9cbcuBmQShPIrMD-uWdBCSOctXAgwFjvGrYNiiRKziORq0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdUHVQ57qYhLZKtDaYVNAQf_xXeToEs6cSVlFIQlHaTw&oe=6AF3292A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_9boslZgAEQ7kNvwF5cwVr&_nc_oc=AdpGonv5wx53oZEQW8-ZjETPutmaJc0ayma5UhLlqQmvJJLCzQtiCKg6DvW7Jo8z0UU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnrmV2ZclXxxiT9DOGr1FR8okiqDWQM5YhUfPwa8E5xg&oe=6AF331C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSjXYpqiF54Q7kNvwF8QWxm&_nc_oc=AdoQ_aTrjpQP1z4s_6H1h9xhEmyGUacS26_Hbj43liiiLcpzObwD9aYCpTGSB3_iT_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjpNKlnPEmr87EQlXie-4KRDX4qLJLuJYiGzSfeHli8Q&oe=6AF351FE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ec2BQywhG3oQ7kNvwEKwXLJ&_nc_oc=AdrrUwUlQXOgxKehhC6s8AVyYz5s-RaiTyfvdRQezRu_Nyr1Cw0HrthSz5C7FN-ZwB0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsFSnzq6rMFN_IQq01lvIgY7K87KtTMpt3K0m2pn9hIA&oe=6AF34393"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
3-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQQTLNOZiFMQ7kNvwFFYg_O&_nc_oc=AdpRzt1K8rNwHEw_qPQj0ttZm0zUwH9ejmaa5fA10x_VCWuSi9e8yLVTvIl5Md5QIUc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmyi990fxDyfBHaLbm5O1Ccq_JLWWaXCBAHmOhuo2TYQ&oe=6AD10009"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKYNVaGMY9cQ7kNvwGjmCsr&_nc_oc=Ado6FwXUj1EXylfUmWC-Af2VT7CDm6qBXQmdwfP7jt-PpN95ma3C6LGOyY0RGzZ9og4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs1WAUWe46GZx3oiGRPl45J8ksz_Sz-4ofz0b0LvkcvQ&oe=6AD0E22A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-8FHzCd0iAQ7kNvwEIBiSw&_nc_oc=AdqiGUWI7AFHv5vbfbDNpRs6Dv0MW-yHhhKGPpGn2mDGauBS-JBrVdSSojzpB4VzejE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgq7wmScUreVGQt7E3EgCYiEp1QExPb5L-6pzhlcKhkw&oe=6AD0EAC3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDKB6knflq0Q7kNvwEyj25b&_nc_oc=AdpHB8FcP0ppexKmUMPvyhFWPHcGddsOw0kzn5ld05npmoWqQx4DRQxVBYxUr06evJw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD9NdvIr5ZehVsEz9s_hydeWt7hNV2Tc0qBZhXMML_tg&oe=6AD0D2BE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ppj6mUVWYQ7kNvwF28gEL&_nc_oc=Adr7wIHE3qrLY93eRfWzHMhBwOeLBPslXdHFK4gPvWS6LMEqz8v-UYNn-2mqzcQhAoY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN75H1rePqL5e80jeSi9arb2twpJR3ZFL8tlDgCdASE1A&oe=6AD0FC93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
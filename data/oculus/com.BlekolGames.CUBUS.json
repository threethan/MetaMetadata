3-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQQTLNOZiFMQ7kNvwHfHiaq&_nc_oc=Adp_amirR8MCXL809NGAB3SNJbid9BUCue23ZRgxuTBmKPUK8tTTWVs7xsCbtsA1a1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5A3WFueoLDeXBsaX3WIbcV2VtWxBfkerMqgWytwqk7g&oe=6AD25189"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCIsqlFT69EQ7kNvwFAzC38&_nc_oc=Adri0DXQ8kLYzQOhp55JI0cdv5vBmRwtYNPwpPFZUr2-9ITLZ6-pHd8D4psRTmno7Fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtPl0QjHVKEW4NcEr2ft8PTeLFrNttyUpolvaOQzl8lA&oe=6AD233AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-8FHzCd0iAQ7kNvwHBWScj&_nc_oc=AdrwJIOAY8A_iR2jXO_pw_dQDNHG38gX__Ys1yFyQL_d4bQJCf3K7BPYbxe7LhH5g2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtSt74NFSd60GmnZ5a4t7Wr2duHA9nJAJc2Ew_4jbZog&oe=6AD23C43"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDKB6knflq0Q7kNvwHlmWN6&_nc_oc=Adp5phhuxCBK5NtNmveja9I1aa8cQHQup9w5g0qD25_OlulClxkdaOhvj_Jyrb_Yqro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME8SDHysC84Lr9wZkExZrsSi5Ul0GKzx6bAJ0XghorYw&oe=6AD25C7E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ppj6mUVWYQ7kNvwGfX7qb&_nc_oc=Adr571QatqY-53b9tGSB2uDDUiTKM1CEHZ12_KAgVQwX7AuH1Jpx1oBvYlBSVFU44WQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7XS4FeYCS1EYmbev6deGJxbPCvSlXa-GugJhz94jLeQ&oe=6AD24E13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
72U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y2TQMSvKAY7xZ9DkqTMGNTCn0yEKCPAhE1vs0h2SklA&oe=6A3D5809"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjbo0kqtuWAQ7kNvwFzM_IZ&_nc_oc=Adr50zxZvzxdkpyIRO-rv-_1TXsArDvJ4o4Z54snBbT71WknMw0l8Swma76W7Ecl6iE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1cDJh8Xn5z-tlJG7uBp29BNy5W4e32aZT35FHnU0Rpg&oe=6A3D3A2A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocRHihtON0AQ7kNvwEbsJ_B&_nc_oc=Adq0Afgr3ilvNVBcE9uT9GSQhNE33HwPP07Eg9HYLjQCYopparuIiIfwuEptr5_N5Lw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bWN6e6VOD08ctNrSHPuaJviDC5kgC4BOPjpZIKt11bQ&oe=6A3D42C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H4thGyBh5oQ7kNvwGdBeMD&_nc_oc=Adq-KBVc3mJkXbB8NgwDs4wm0sb-XCtoxbZ_QLSU6PAjjEC-OjG9uitXkseoAPfBbOs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9M6Wr0C9jhwLxF9Nbug1oJ_w2eSBAs2lK_2bXW4z0XA&oe=6A3D2ABE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHva4rgnufwQ7kNvwFtzb1B&_nc_oc=AdqHArh-5eXZdXxU98NJupRlaRKnyCyxnvtxPj-CFZf5iIVmT4khxCufbatlgUhfgnk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iTHQih5GF0ICS4eym28XCtavCe_o62aggPHDcrHOPlg&oe=6A3D5493"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
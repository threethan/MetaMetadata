5-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLc2-5EfimQQ7kNvwHrBbxf&_nc_oc=AdqWYLJb30VaCAqW7pNGrpiEk47v8IEdYmf1a1wwMfTNqxRgiUDSfdIHNX6UzW9xksM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUaFK_WROmWhU9PhnIXqgyy0PzgTzYnBIf2vvyWbeD_g&oe=6ACE5D09"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKYNVaGMY9cQ7kNvwF_Zytw&_nc_oc=AdpVCm_fw2qOfQ6kwy4JbbCFsR34DPUGIjrvHTVSaAgWZivGFA1P7S5VYTkN_2YsWug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5OnZLEmAzwHvVlo_Q_KoSUJ4Sfk2yMcWH-_JKfO4Shg&oe=6ACE3F2A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX5vttwvBUQQ7kNvwFxiu3g&_nc_oc=Adobl8liVt9O9CH9I0Rq4QEH1xXc34pWMNzl4vDmplO1oxaz5o38nJLfAoHGE9G8nJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqDV2658K9GRYm-nEaA7LiJU0f9jGrqGWrESY3sm1xIA&oe=6ACE47C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nqUYV71BX4Q7kNvwEL39Mj&_nc_oc=AdqRxgfhp8P3ltLBEQedPo07zPYD1huWE9-Z52Tf_4X4h4OcG9svLq24LQWWcf-uFt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4UYowJh-bjE0mQFIWU1SH14k5G7yTah053OSCUQt7PQ&oe=6ACE67FE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtCMtm9ZT6EQ7kNvwEiqjvh&_nc_oc=AdqF2lU8x5XtZUaYioCUa12nlnwfuf9h5mtD2FX_mHxSTTCFu3k6YooCnUkmutl1A1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTO_3ET1pkRn8RjQZsiK2KoysAx3cvuCrL9q1nh_Af7g&oe=6ACE5993"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
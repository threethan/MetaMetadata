5-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZFwF6T8zu4Q7kNvwFTqHWM&_nc_oc=AdqjJMFYVX0i4mEz7bRcjy6VkVQ2WVOgoHGMko7F9mPSnxcjWQ3pg-QzWaTghDF1tGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-_C5_HohifG3qgaF_gCefswnlVOGYZCyFIHZnStkRGw&oe=6AF73B89"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y8dAz-48uQQ7kNvwHyCh-I&_nc_oc=AdqLae0G80zZJDcIoW9XS6DqGh_QpOIhZL9b7y0vbroa4i4jQNK1mfCdiY2NT7BSydo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeEihFD0_EQQBnw5wZLAyCyftNZiW5uuZxas0MHkfh3g&oe=6AF71DAA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be3G-BeeJygQ7kNvwH8XaO8&_nc_oc=AdraerC5gNFnTrJopMuB_Ua-dAOal7tSJteObYkTZ2RXAdWgR5S9q2DjOxO-4Ze0aHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9z3HLaeF_bVfbXKIq1pL9_tOHm5QKo9D__mQc4PqX_Q&oe=6AF72643"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT-Kx6rYg3IQ7kNvwEbVdXj&_nc_oc=Adq646Y2EXvoZ_oC-9z8ZZaYcOUYAlPscrtfASOUKWzWIDaDjkVmFxXVtQRIkMFuIYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3h6aUc9jhewaZDv_BFijFRSZm9yTClZNowEQeBSbweQ&oe=6AF7467E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVQK-eecGHEQ7kNvwH921cH&_nc_oc=AdoEpofzMVCrPD7xdW8T1Bq4WhKzcy8EWl4YIsG1q5QDoalH2hqxcmd8BBeW_VzyApo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT81YAvisBJ1n8HIxtc4-0vsOqvhOCL-zATVD9r5ba9jA&oe=6AF73813"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
A6w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QiSGMASFVB14ea98JbMaqldrx9-yHO2YOUWdzzcN7cA&oe=6A1AD8C9"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTh5CMtKcKkQ7kNvwFb-oPq&_nc_oc=AdomE29E7mXVEEvIpq3n2OcKqo3xMIPy4ffCiGfGoI3LD4KB2s6L0eMRfC-veP5ajHw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gp6foQzD4zkgYlr_F0fxPsug5bEchKdJBLqI6XxlgIA&oe=6A1AF32A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vbh-j9Zxm8Q7kNvwH-hIe3&_nc_oc=AdqhByBVI2ueqQJfeVDoltfcmaP4oaJu31oNMg0kxGA4zZ3ISQGg71YwVxmWRlSxgbA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IpIpnhzIHxUP9frtpR59DK6lCGt5PE6RhzQ0W51rflQ&oe=6A1AFBC3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSTerXr60jwQ7kNvwGT9mXd&_nc_oc=AdpGDVAWVWKs0Sf9SxQxHUds4l6Hh_BVzC365T3DMgg_kktzp4scb8ave67jkv0WlZc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42W7BFpEx2KdIFtErj9KTM-jMi2kzc36_Rz1NvBWoxCg&oe=6A1AE3BE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAKRo5wgLWoQ7kNvwFmpjr_&_nc_oc=AdpyVLGZOD0VEg7VWA6G51gGQFUC0f9uXB_J6K3Z7MTyZ-AqoaLprRwC3VQN0dTZTl8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BNjg3540Co_0aGJtE4XxxAW4fiU67aoR6Dz36byUy6A&oe=6A1AD553"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
5-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeSihlZNiPkQ7kNvwH8cKKC&_nc_oc=AdqIvCHjlw6ox2fc7Dq6Wpx6M1Ub96fwMK3gmTPrI-bukFQQFpZVsQqmuot9pl9ySgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgZ2AvWaOShPY0llO90xXHO_nUJlfcFQXqJqeiyI-nCA&oe=6ADF4849"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCbgIiv_JDcQ7kNvwEpi4iE&_nc_oc=AdqdRVhuOYhoXrocsiLHyM9GNACBUsJpW1kdlSd0HxP7gR5xSyQ_PKQEtNYHlRF-RLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUlYJWw4BhaVxBihYRTegB1uEb7C6Cc0OfW4HNifAxMQ&oe=6ADF62AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1d2RhfXQ1UQ7kNvwEul5sC&_nc_oc=AdqJDh1Z75cir1bSj2gjcK1m19dm6DLhaZWSuA5cTUJq_8W12-SEylVLJca9TyA71FU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUUMSMJZ-KSUNHFz_e1mBxBxta2iJY3AE3ozhkTngSEA&oe=6ADF6B43"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhqaJuB8m04Q7kNvwF-a96K&_nc_oc=AdrATXFJ232AIJ103OzNdont9XVsA4q8iqe6or_o99u4YP9Fnmmy1TsluPky4mSJ9hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO717FolwYHpjbZpoVher7sIcwALHX-Q6CIcUzEpN7BZg&oe=6ADF533E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsyQTlq-9AcQ7kNvwGMIy0s&_nc_oc=AdoOqNmgjD4S4_eCE-fUlK0KyUKbhTVxZ5h1TS29oNooW6MSc9kSuEx-MT632mmVZM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpPMuw8Z7U35Tx9GT-TSuKpEUsz6_8-R3tmbkd91j2AQ&oe=6ADF44D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
Nhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV6hKvH-5VwuCOFfjnuCzedWTx0DjaacaVcnc4zPdhEg&oe=69D104C9"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgjRnu_Q6o0Q7kNvwHzzFpF&_nc_oc=AdpwltQPEzEBOYJ64-N2EiIlZ4HkrUT9epBYbQj-dlKkgN6e7MDJAphU0WJQ6lbwM0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmOmwvD1WqaoV11Zwi5oy0VYyJjmzN4P6n_Crqp6c9-g&oe=69D11F2A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HXZ1NFinyQQ7kNvwGBybWK&_nc_oc=Adqc1MKULibJzw7ZCUh_yEpmJJ662TdH0nRZNLEHf3W081hobGsPqGW5LKnSEGn-hR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxj7lZVz1cs0eiSQvjqmlOP1CCuQnFux1Xap-33BETm7g&oe=69D0EF83"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBX5ZgV4u-oQ7kNvwHjIqRp&_nc_oc=AdqQRdAzAION9-ft-ebib7zQ7nxf7yMs8U3s83DrA6152c0ez9PSe_j3i2UZC-oUf6E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy87vJFvRb81ZWl5y3apItd0E1-yi-qGr8zZ5qiQA3qyA&oe=69D10FBE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VmWD0l7QDkQ7kNvwHP5ge2&_nc_oc=AdqI39CWkCpsxb46uOoCv6EBo_a6I9bHcSLMwcqu-DB5j17oEVIV-GnfcN0CToejlqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzx83aou3dxZoDKOx32-apj3iGGuRmf-sYTkwiuZfMaxg&oe=69D10153"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
-kNiE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dhaGmahRqDOhFLFTSjVgokE-bKDGZm3lGG7FTfDzytg&oe=6A119E49"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be_R_4SigMMQ7kNvwHoueuf&_nc_oc=AdoGNbAeuy8VKFAhvSHylAIZYOVQP2auzrod_oBi1RvozKP_xeNdKlbtpv-1s1Y776U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FNtlPyOr4bOyHKts0cohsEr1GgErrc5VO3EJurMYq_A&oe=6A11B8AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObR63oHonj4Q7kNvwGg397r&_nc_oc=AdrxyoGtL5q7II_2-lDEjDlOKNluD_-UWyreMZJ-B9q-6Glcx-E09xLWN4_1h-4xIPk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B0ueRZCgjjl7RnT-j-i6rMM1dwuhLBlPMynGWMFKv3w&oe=6A11C143"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPviuJat-JYQ7kNvwGHxFXb&_nc_oc=AdpRTz2dkuNlzuzlH-h8c2I4WuomewQssprPaohZorq_lPPLzFYrDUzthZD4-Y9cKp8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62NrsigoqaoGyISbYahGW64mnJNhsifCGG8oi42okxWw&oe=6A11A93E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t78V054s_JQQ7kNvwFqjboe&_nc_oc=Adp0cVQ03N908HXqgCcfd6D8qFLZfVEulG1fPw1-HI0AqvWnCjdIo9e-Tbv-ucCz3Pk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SkQ8THwEcE4wra87AWd_b5H-X7z8TkURojQ4Atp92SA&oe=6A119AD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
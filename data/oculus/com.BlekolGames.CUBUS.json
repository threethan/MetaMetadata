3-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvMuZZBPHOIQ7kNvwG-LnXI&_nc_oc=Ado08X3h7zf3QLVpDFvNE7sBgKm8iqT7iLV-0SPRJCXzKDYRyMB6-lictKCigbjN-yA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvtLMyH_t98uk763OnVtbvmI9a_NHwNfSUyG0iQmMZrw&oe=6AE61809"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7lf5tFBlQcQ7kNvwG3-XKq&_nc_oc=AdrsSmI9HhjLhJmB4_AM-tXvmU_E0Jwq6GqtZWC3Njr_Ju0GRS1fl5pgdxRZvt2FeWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF4gnDYDwjtlEtk6i5QE3_PJqHAl78PDaNbstmfZmP4w&oe=6AE5FA2A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MuL6JWl1IQQ7kNvwG4Gj9v&_nc_oc=AdpaJoZGHhUMy9cpjkP9qL4ooQHcRhVq1EkOJRvO04hfWeuilxhs2ONsd65AA-Qofmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5L8xTP_lyPtDtJBToL1K7gcANMGrkjCbw6dZlIQu02A&oe=6AE602C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wvfKzqp2x8Q7kNvwE5iVCh&_nc_oc=Adrn5xzvmqJiwCYyWDrypTFJ90jz8Zb7uHaAWD1FOIhuwKKPZ-Xm3-r216mi2kD4wyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTy9PWcj0MmLrV41v7wl55rU6cvZSvECqK7haYxFn6UA&oe=6AE5EABE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY038XkBWHIQ7kNvwGPo7Pa&_nc_oc=AdoJBf0bBKB2OcK00NfmoC5rWJe3xYXTkxmM4fVFFWrxxSZVcawG-TGOGEgxLgs1GlQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1bMqk02d50FHTwGztJMhFUgvNiq6NscShnDMdM1nkZg&oe=6AE61493"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
5-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s63SB2zE6UQ7kNvwFIKhY0&_nc_oc=AdqcPL09nwCN4Dyc47G-XuS5ewtyRGeUkhYbV55eBT7zOKIqJNXAN6cq3MohIyV2Lx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW0_hUlmPjnz61xuX8Ql-8Z-uqXQybn9f4adCDKqtRTQ&oe=6AC67409"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GOycu7VuUAQ7kNvwEF9jOZ&_nc_oc=Adq48LB8GhjqSpY4ZgeQ4Gdik57Y8929QBduOnD08KknbT3_SCZV65pLm3Y2IsyH0qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJsxU0gUm0epooeOQ_QOUWOIQvhC3UhVGLCM3aHtls_Q&oe=6AC6562A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9ArCJr9qm4Q7kNvwETfefP&_nc_oc=AdpDz4CgHi7Oz_2Z1j2-Kj4v8UI_W9iWbrmHsX6e5VUqURX81q0_jPr_wKLB1axKTCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjcbui9NI1zcIvqFC_m0QcutJyZkajsXZFpU-Ens4EYw&oe=6AC65EC3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9UHCKfRV5IQ7kNvwGLw4TW&_nc_oc=AdpLPhGGSgbZf0Hd-VALejqcdBUMCP489TROVD69XSc6yg0q8AKXC-9S8SSc2JqeWzU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtN2I2SjhZQ9Zu4MC7Tzh8WfaQ7KvAhM0UzMhfnBlhHA&oe=6AC646BE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyhZFXwAcc4Q7kNvwFCzeCB&_nc_oc=AdqjyHo5b2jbgIvbCL4QamLxFZYKxP9NMZKpQsd5nhQRwqF1ysxDqfJOKT6D0pKtsck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-lvs5OrXNkhAnOzu_pxFA0smo0uB2Xy3H0QIDQM8qng&oe=6AC67093"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
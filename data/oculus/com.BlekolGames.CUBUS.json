ZRw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EAc3gQXShlA4-QITO4Ome9JWjFAGDCSTqi_wvLhEq5A&oe=6A1C2A49"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Rzi0rYOJk0Q7kNvwE2nP86&_nc_oc=AdpgcXYpLxxF7eNS5Nkcvh9uvFw_MslRq2zyJDbD_olzlRDDAIWYQzgGJLZpFjZxAh4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gPP0fTVuLVIsTjJdcJSr-uKh43TfpHFOvVqNlsF3lyw&oe=6A1C44AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vbh-j9Zxm8Q7kNvwErkrbQ&_nc_oc=Adp_a-dK0b82_FRI9zZ1ImAwkd59-peQszwVTQiimhK5dXNYaUPx824au91xEvIyo5Y&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZxQOdDoiDuAMqGXs1dNgK7BrFi62wC_LO4Jrq5omSdQ&oe=6A1C4D43"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSTerXr60jwQ7kNvwERugNr&_nc_oc=AdqiSxXYl6X4icV40blifs5G-GCQdvBcWCyWOKXX6kZbaoPGRpBAlpV103sppz-KZ7w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bSuTZsiaPYypWjYWutHVHwUlcDAG_sB6SR0qmmRKNSA&oe=6A1C353E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAKRo5wgLWoQ7kNvwFves1H&_nc_oc=AdpWhreOrX3EEAACaoTiOSdt8PbCCuZaxa8LkAbA45MeBCJUXVRYYT_1gL0ur5Zh2Os&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mERct5XWo-2wWClH8QBcJjUCfUHCwXTP1Dp5rFyhhlg&oe=6A1C26D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
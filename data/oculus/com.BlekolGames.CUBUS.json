Q40&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KSGejg2bN-fQUv49iP8uuL7JjGQ5MZUXD2zJmxDqkrQ&oe=69D79C49"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iz36IA_8MBkQ7kNvwFqx5hR&_nc_oc=AdqY0RS2Aw3xhFAR0V23mvjsIcaTf9GhxL_xFVeQ4Itexqx5m4MnOxXdoT43PEEMpwc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xS6eBBEVGBY8-zQYOskLGz9XV5eI8HuL76GmOece5jQ&oe=69D7B6AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5p8jTRudBIQ7kNvwHVD1pD&_nc_oc=Adrcui4EHZvU5WVKR4kuP_gtdWKmhUm3JBnviDsby0U-zobnr_GKpgTwOQBpP5DMcCg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KrK3IMPjDImyfAiSXlrQ3vRqKwOuopzLeE9-UQqiSPQ&oe=69D7BF43"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygdruCEVkrUQ7kNvwGH8sXM&_nc_oc=AdpLQw6MTklETGDmfRf28pjWN1onu_7xFi4O0F6jyX2tgL64XAZbs4CUgOx2E7Y6-5Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Es5I4BUK91h9syRy_OFDOb0mu671sChzTK0UCR5GJ-A&oe=69D7A73E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op3fn8hwCqkQ7kNvwHW4hTZ&_nc_oc=AdrLPLjNYa5QQiHSoCuaYmUgDR6Qn1ZvslEZ0d1PK0r1GWwP3YC4DEpCsuB3wLENUrk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ibjJBKJILex85jB3UwvXK_ZynuGs5IKXj7BHT31wfPQ&oe=69D798D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
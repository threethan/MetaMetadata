e=6A858D03"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OshIagVQvYkQ7kNvwHNXrCO&_nc_oc=Adr-YqTSKvEG5RRETjGEBoVPtDAIXtTIqQbKWzp_KgINxM3DcZgzO3_TjFh7IKRKs-8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLNEWcaYAzqTfeBrt6zIw5eMXYVn6TUvf7lbIYTeS1rg&oe=6A85AD3E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1iWS5anPIAQ7kNvwE2d-LP&_nc_oc=AdpWqGgyyRSCDuJxgR-_ScXrCdeGa3W8TluwCxqOpIJeACivEzwoBCWnnPl9-w1533I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEozUMK-fuCqAMds3Qy85Zw4c_lVNYMbsWsZRrn9TPOCQ&oe=6A859ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-9.png", "id": "844860955014900", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827743_844860958348233_2077116535604637391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhhofYM3UlYQ7kNvwFMmbyE&_nc_oc=AdohL8emjkRUnTjZv3EFyzjSgIOKpq1OBtpVe6k4xUk5nUsGRHxfhyzZJpFij8yeiUI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWXNeQDWwcLPh0WAgjTHUBUGoOHer__j7XDEV0tnBc-g&oe=6A85A3DA"}, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/blekolvrgames/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27813538788280943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824671_1113764690704714_8468131222286124141_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xi
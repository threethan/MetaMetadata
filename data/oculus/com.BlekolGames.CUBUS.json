X0bxW4wBx4evFtG2Yh3aO2PBoARIhIg2V6MPg&oe=69F1FA49"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q6XGX9EblsQ7kNvwFdkVaF&_nc_oc=AdqEq3V4xNHsxe5nru_v7_nYPR_gMRz75BqU72uh34x0m8jpXtIAdGpiOdLkZVUU7T4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1ADybziSfisLjRUScPpNxeySKLJtphDmQXayfWXrA1Hw&oe=69F214AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-GMB-uJbt0Q7kNvwFdgH6V&_nc_oc=Adrm7-T6T3YeEEXQvfDyaIvgAtJdkpraPHAlOH4Dt0Y1vQlloIP0X49EtIBQWXE_vko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af05XnWHjwNucGRmKU9hJ6oVfZbB0jpr6jENLNEETqER_A&oe=69F1E503"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IusWCRKRKEUQ7kNvwHOgYyX&_nc_oc=Adoa-imZjv1CMJ2dyZdl012c3Ung8jPn6matiVwzW0mTl90f5E_NZDdTMiWT4LMGMOY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t-gImKYIMSYrXuAZ4zcP12juhrd2b2SbfVh7eQ4woCQ&oe=69F2053E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTPe1buXihwQ7kNvwE52BYg&_nc_oc=Adp4uo-VL-9w6uUwyG9-sGCj2p9-0ZAwszdrna3aqZPEmu-2o92fRJX8k1gaTpJa_Dg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2z9T8ZQtScm9axDI26coAWnDkWcl5AunbpxYpTbHeXsA&oe=69F1F6D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
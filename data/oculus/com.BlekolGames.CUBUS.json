9883"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i3FyHPOYjYQ7kNvwEny98p&_nc_oc=AdoAh38NqIXfzu8-hQNmgQRiMxK2NZlsE6grTn5wStoRF5pjAzWB3HOJ6QsGVIpQ3ck&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPqZmxW416l4w9ziIXZWqjMZqO9_I5_YBrIWZsh-8LAw&oe=6A81B8BE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykeZDS-hkqIQ7kNvwFRgF7b&_nc_oc=AdoR-9OSGRgwyVuY43YV9EB_lpBUOXH-QvjDYF94cH222khvexUDlSfX-03HSLMYM8w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBmbPog9wPzNI8M7N5cYdnFVSKu0YlzMZAgocvpJMyow&oe=6A81AA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-9.png", "id": "844860955014900", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827743_844860958348233_2077116535604637391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UkkdD8z1GgQ7kNvwGYJW4g&_nc_oc=AdpQGJsd06_GF7DDjXlw98Fo0k4eAgJIJHZyW6pnRXuT9yolT-cMAk-hv5ht6em-6cE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAAL3S5i6RgrzAOl9a5Ro4svPuQw-sUJcpx6XOudZHDA&oe=6A81AF5A"}, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/blekolvrgames/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27813538788280943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824671_1113764690704714_8468131222286124141_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImjvcYOB9GQQ
SQj4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmxOKYQdowPctK2TMDh0nDffa1XqO2DOz-B8hS2PvuBQ&oe=6A7DB949"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcrmk79ViNsQ7kNvwEzLI6V&_nc_oc=AdrXv8Zp_nDt5bs9NH4WJ24SzK8AkWeqkuRCxsP-CB383OwhKjpFt_EW_zs6tfCZS3Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS0Pw8-cde3uRt9vIfJsgNrtfUlGVpZOtrGGCEnoay_w&oe=6A7D9B6A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Krh2Osc8WbsQ7kNvwEiqeIL&_nc_oc=Adqh1aErClttLk7XSDrYy3WCji3ED1tAJjzwa_E7qBEaCJNyHF34W_wWROlB5DV0a6k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq_j9xHhvWyzuUbnOME5tvKJdlcHDwKLF4Nkyr_IXLEA&oe=6A7DA403"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt9a541POgMQ7kNvwEvvpgb&_nc_oc=AdqLDBZlTuFMfHjfsKSD_gQYDERlL2HHNTrERWmpL97XwY8qbN1J5WkOc6HWM0Dosmk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN0tg62dOMAxycFnXLzPlSmZTQdwoiu8SZBvlUOoGjng&oe=6A7DC43E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJcyT0xyTPMQ7kNvwG48Pvi&_nc_oc=AdqWbaTZyM6kNyla5vLHTyKZi8Afqh0vS6iBwl7iMHSvtMKc7XmrfJ1sV-hVmzl9rr0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-wlEVUYt6l15kX1E7STv6OL_Tm24ZnX1kQuVSGaM2iw&oe=6A7DB5D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7bpv3aTh9oQ7kNvwGw7PSG&_nc_oc=Adp07xX7pIsJeNKTef_QOuabOa1QW5khD-vh_cCfN705rYSp6uH7cnhlQPjJjoMPIcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsQeATNuvjrAHNUqwTWRqRMwoztqibtmcUF3KErMIvTQ&oe=6AFDDDFE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1rBOGnjoxoQ7kNvwGSDdsg&_nc_oc=AdrVOsFU-U-aiTfc1bkAvaW5iuAHx8g0fUf-H0l4reqzPNKFBxtC-oYljg02RpSwIw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcMSVsApAR1Sosk51T20ThFUq-HTh74ow0gFmArPo2ww&oe=6AFDCF93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25350882434546603"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1488820139498364"}, {"status": "CANCELLED", "id": "884860684314536"}, {"status": "PUBLISHED", "id": "1398457605167460"}, {"status": "PUBLISHED", "id": "754102017732323"}, {"status": "PUBLISHED", "id": "1193350716282116"}]}, "baseline_offer": {"id": "1488820139498364"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772288460, "status": "PUBLISHED", "id": "1488820139498364"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25849206694714172", "version": "1.8.1"}, "id": "1492623399003333", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename"
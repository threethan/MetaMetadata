6-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZFwF6T8zu4Q7kNvwFOehyh&_nc_oc=AdoCM8UQE4DE2wDonSYzDdNLME9kDmd7TxEDZgpAKx6OLX9iGcIvOTdJs28ovfmxn3o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUzu76UEdE70lSQMkfs-SO3B2XoCUya_eUugrYLsXtAg&oe=6AF9DE89"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnH-L1OaK9QQ7kNvwGR_5G0&_nc_oc=AdrBrMNvZniuZo5UwmxUXcOG2izV5Dn67H0jO3FprrAmc8c5O_lv-xpi_2UABVLNzkY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBKgprQRcvX15j_ua8Pirmn-weaU0uPuiooya4buJ95A&oe=6AF9C0AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be3G-BeeJygQ7kNvwHnm8lf&_nc_oc=AdrB5TzCtQ9HGXvQVcepymnO5FtQmQ3NvjVtFDMgKlCifMDJ6-lSGYXIRjUmDes7mLo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbYlM0FyGpPQarpMgysKcXgpJ739hbCUjsROkmXloYIg&oe=6AF9C943"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSrpt2mDc1gQ7kNvwFGU6o5&_nc_oc=Ado6Dc8hdRW5g3eKMm5eWPUDN9RviS153cC1MpmgaRwdrr13GwefJnnwt462qGIeBZc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSb4W9qFj3uojDvy5FjcrLIPDZjT2DeB1o9-aV_moCqQ&oe=6AF9E97E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVQK-eecGHEQ7kNvwHP814i&_nc_oc=AdqJybtCQE7SkvFvT5esWatEd3dNIiR7ifvNUjJ1X65KrPT6E-rx2SZWWC6J0brN2Ek&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-1XKmnruQy79LiIo1Lqp_I5SDb-7z9bJJ35tC4lFWRQ&oe=6AF9DB13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
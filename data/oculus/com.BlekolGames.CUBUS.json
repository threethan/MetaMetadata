8CC3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4-AtuuQ75oQ7kNvwGfdLaH&_nc_oc=AdqVyljbQQsPLosF9tjaaM_CXUDzWccBxJXNGIO6okOfegqkoF6c8tZxyBNCVXLEfUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOX5QtO-M-wfJi-s2iLDVrHFY8EEfHpBp-TI3HamMfKA&oe=6AB674BE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRoFlq5YVsEQ7kNvwHrR4ss&_nc_oc=AdoSwo9dQoiwhxdijUzwscAhKD10gmjrlVdTfJFnew8u4R_vY4lMas6JcSMqPnOiSg8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF3gk2k5Ua1RS7iYndB6uLbMUwvS5VgegoOXmXbc5eGA&oe=6AB66653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-9.png", "id": "844860955014900", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827743_844860958348233_2077116535604637391_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXqe3N79ymcQ7kNvwG5UvoY&_nc_oc=AdpG6Dari5rCkZRVDGv6e-xWVAqbra8q1b7KeTtCjZ-EymXPvR-INOnvksIvrpc5SPQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ82te2Wv4_ijtE-7VGxBshf9hxPz5NI_gc-2gX477ng&oe=6AB66B5A"}, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/home/blekolvrgames/cubus-vr/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27813538788280943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_1113764690704714_8468131222286124141_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruf1NdQLMs8Q
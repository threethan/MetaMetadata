3-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3d_EQCEyOMQ7kNvwE1QrNR&_nc_oc=AdpbknIexmQf5h_SGDmtsCo7qw-w2U6Gj57TbBcbSBAqfmyl1OkSolVfYiNFkYmQdYs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxGT7jngLCksUgorOkyCd7szg0rwRYki9ipt-IbyIAyw&oe=6AC91709"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GOycu7VuUAQ7kNvwGtH5mJ&_nc_oc=AdrbFRWAxI3VrbLbXZJswXH3a4hrjSUmx9Ogl0B40ScFzLBzLSeiB_4crphPgYByd9A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL1ktSlFpr1ESR0oohp99eJg-rBUnmVL7_2jHgR8tGKA&oe=6AC8F92A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5q7lYHln-kQ7kNvwGrYzuh&_nc_oc=AdquIussDkpoWKj3qiM6DSO6xEFktmlc3WzO8ngcesp_2CKpBQpr9jy93YpkZjGuQuk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbpArhozg67T8tJmCeI31yJAdtVZBeExoxaw_onQa5Gg&oe=6AC901C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne05QQYbe2sQ7kNvwH5kqPN&_nc_oc=Adrcx5Otawo4lwhdJ-BwYXOAtQnk9n10swFJLmuDfVBytbf678TBiwQQpq14bXUFC2U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6O8qKXRg_kVUqY5tJFxMPw-40Y8yZtKZw_nSqernE3w&oe=6AC8E9BE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jx7sMAJK0_sQ7kNvwGubcqi&_nc_oc=AdpydLAomvddscO8yBvvvy47Aw56bfcq60cxrFpR2NUM2LjNVprurOZnMupAHQXJh7o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7aAZfkwY9Fpr69VPRg6qCBf23cnVg-8aqsy5etUpXrQ&oe=6AC91393"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
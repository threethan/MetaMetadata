3-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvMuZZBPHOIQ7kNvwHprB4U&_nc_oc=AdrJ3G-IQNp4-0yKbs5QanC4qx_50L6g6p23KZSLGhQaoGwsbzsTFgELxToAqYOle9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfcRtfrgs_mrk1jS8GjW3uvqd17ly-mZ6f5VM5HHxS2w&oe=6AE48E49"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKOeWaGXEd8Q7kNvwFRxwYW&_nc_oc=AdpE0gn75bBmCSP3PxFNkrK4_11k4VXEM-nglGubJq4Wyb9wuBbdGsZnBviOjD4SP94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSAF-XcFYcH9Ba_m0-HLgS0ABCPEuzHhz5kjhMvz5Tsg&oe=6AE4A8AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MuL6JWl1IQQ7kNvwGzKx-X&_nc_oc=AdrXPqMGznTeVx3YXACcvGaOZQWDguI-now6Nr0JZdOQSrf7FMUGViu1c2znrhGx__o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHJ2t1AV3fv7nAtTtiHyvsk1GmPXxVIf8heGLg7rhT2A&oe=6AE4B143"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wvfKzqp2x8Q7kNvwH7Y8dQ&_nc_oc=AdoB1ABWbLk4IOdY-mQfPAdBhRT7k6zEPu23B3xHEwxfjURaKbw_xZ3E7Q0vvTXW8d4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQaq78g8iagc92PUf3lDw04xBq5YNgZ_3zP5xfGDJdtA&oe=6AE4993E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY038XkBWHIQ7kNvwG5S2Uk&_nc_oc=AdolqdnLX8_ZJ67MjbO8qiVuq4p0iy7FpA6OTGWGQNG9IkAdxPwekr-8toG6vupogzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8ECvnXQ6wjXf9a2lG5cm5N1l0TpHFJrtuMhwCO9UBYg&oe=6AE48AD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
lIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2905oj0tlCr5ZgrOtOLzY3_uPuuveR6zdefQFv-qM8wA&oe=69F891C9"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XjgCIgOecQQ7kNvwG8G0E0&_nc_oc=Adou-t8cLBD4eKunp_dLoGB9mTPeyz_M-fmJYQUMbFclTik2ngYmSN6UF0W0HiAcKno&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af349RkdVRdl_UVYzfbzDxMSxngfokj8KdL42axWx04z2A&oe=69F8AC2A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-VKTdBV-VwQ7kNvwHmoIws&_nc_oc=Ado3v93QzcrMSbZVZndKPDXBz_AeQN_2fnjdkhWAI3bGSOhiHXiRf4u-tzCaeICK5FY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IpdaCt_-APSIsJHyQCgMjSdpVv5uqTlwljDRaBvvMjQ&oe=69F8B4C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeeF3lK9U7UQ7kNvwHXUgoX&_nc_oc=AdrsnD9Nf7BMZOziVrug_B9xnOa286CYUUEZGHuq9qEvMPhua-yIeCW_q5DCGYiEWSw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32ud2k0MnfqI79h5BsB7vgbkoHKAnkkXg6EZOXSIiMXw&oe=69F89CBE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ_6857RVi0Q7kNvwFNJM8m&_nc_oc=AdoHnA1NJF6Xn5p3aAIYxEUtZK0QVmHpfgysFq-V0nz1KlovXuGVqtyVWfIXguDQ4f4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30jA_IClRotlgXm1ocsJFHINc9oERRe5gcGtHyi9N2aQ&oe=69F88E53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
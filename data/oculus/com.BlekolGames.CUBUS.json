3-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbScESTNPeoQ7kNvwGot0tO&_nc_oc=AdoTZc1jlInmHU_q-eNjrgjnCLWlAMU8t0OKQGLRMP50piU7d-oGYY_yiF6Qi8NT84A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_6jl-LBMr3sQU_oB7_wWlTWBRdUC60kTKy9xp9mtgHQ&oe=6AF5EA09"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-y8dAz-48uQQ7kNvwGOQQFS&_nc_oc=AdqbkUyosbk5b5FosYhRBxdb0--PiyrRT_1hPYDCSm4FeGPab9cIm05fhLcGBqll7R8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVNIcpzdWhX9a547OmBqDKSyZt3xgWi1oFEaqoswdsUA&oe=6AF5CC2A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_9boslZgAEQ7kNvwE_HBSZ&_nc_oc=AdrUEpevhggozxyWN65excGBLGhw2CjqR0c6bJoSt16xLBAAjGlTF4U91rK36QWpGy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv-BrNmEaFli1pwn4eR6u5qr04jJkTlMD5L12FokNg7Q&oe=6AF5D4C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT-Kx6rYg3IQ7kNvwGmgv-e&_nc_oc=AdoNgKGex6EbZV_FetEXtJG2zGneCg04pZ9q5U-zwa4r2Q-TGuTbE9J5IGQhLvimYCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT8sa7w8a_Mr6z5fQLYPZY7ukyfS9WHA3QUjp9Tj7MCQ&oe=6AF5F4FE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ec2BQywhG3oQ7kNvwFTDIS0&_nc_oc=Adr2uJCmLAJFqynv_rL4FQ27ctdzIpakx7ndhDYwC70Duv0lbd-zWUigSK9f3JebGIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmn0qVHN475VdvOTlB7J8CCkkJmlgaS_hmXxzKwDRXQw&oe=6AF5E693"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
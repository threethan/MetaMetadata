3-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZwaosMo3EoQ7kNvwHTLcFo&_nc_oc=AdpF7Sz5D_0xihnoQSbuk_56INiLnPSjBuVppFxY2w01Vl3L_-0d-ezkpUsjtr4EZr8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGzD2vBxb4_NgMHXUuBezLoQ1AkbZZktZR24N-_wp3wA&oe=6AEB5E09"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnZfdgNs6rgQ7kNvwHohr8v&_nc_oc=AdoB41r-iz6r8QUgOAau4vtWp7v8D3LNE-hhtCTxpr74Pt2ukefM9Z_2yZFne4LPfrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT55K4BdMXgahbNjduUP87JhvNqOi_sE2_XYpQMoauuaA&oe=6AEB402A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUhD8zf7Bo4Q7kNvwE5Tn1H&_nc_oc=AdqHwCnSeruYXtAKj9uJQ1lRgFG3JmuzKVU1YgimRmGnTZd6KQi9timb_hic5YaI_n8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1nEq2iJZlcPDNwKH0bpTexgPsq8M8IShuX920eK5uAA&oe=6AEB48C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4_IIDpiIWMQ7kNvwFnXX9n&_nc_oc=AdpPyrUME5vax-j7WWevHw4eWy_PUmWc8ymHc5YITwrmQ-nR1lMSG8R3uftlK0iF--w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYfO5Zkehpyoi5P1230HR43Tbvb1epiqWXxQE8dNrtIg&oe=6AEB30BE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UPQ5C-pfEkQ7kNvwF421M8&_nc_oc=Adq-nsOrAC6-1gwQrVeWs7qVK3YwVnKjpwi5uQs3xpXk6rtie0tQtCR_0fUBR8wleQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpKSqlWfgwQbvHdwdsi04fzJQa2exbDrFRckHA9zNUnw&oe=6AEB5A93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
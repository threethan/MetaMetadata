3-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDgTidvZynMQ7kNvwEQDWRu&_nc_oc=AdpkHL6Fd1PyDdnsi4qjZWFYuyEHiwRjtbevbbArd-Q4SCLnLja9KsgZ5243Pm8GMzs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7ltVHnzSJcSOsRsuYXV84qoSLUijYonmV9xRvrTXA7g&oe=6ADCA549"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no056AXMU1wQ7kNvwGRZjp5&_nc_oc=Adp-3vgvnFavjuIXmgFDUXaGaUKwZo8e5xRalBfj92r1ozAYs1DI_mgE1oFNI185DyI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiz_EJy3pSgefOYvxdBt63p5MhpzUnqjMKxpokSB7svQ&oe=6ADCBFAA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO8mTP1k3PsQ7kNvwEPlgsh&_nc_oc=AdqWMmvlXBSLIvdrOk3EXnBS7Qv45_uYUsacUS8kqOp9_abj0-tMO4c7o1pFdJhDjvE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI0ZL51iXAD8mIJbViHF_RcZG4QIo1s34012nTVaCPRQ&oe=6ADCC843"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhqaJuB8m04Q7kNvwEBmjcz&_nc_oc=AdqywpxbmCMbQGcgVW2oiMSEjRtj7a32KeCe9ND1fcvBhdUgNMHTv_GCvHD2SoOtRT4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlmbF97VM9FYSFagNHYZUsTR5NAZtI_VtaZINx5t4VLw&oe=6ADCB03E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCt4bsd3BOQQ7kNvwGehrWM&_nc_oc=AdpRVVoj0NL2-XhDWRuPpQojNOAuGMLVG-YHPTDNWeuzWLXg0Hy29ruG3vC-eZWsoCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBW6neuuIsVIBwrIm1hgqNAgiGA8VL20CKU0uXJ2RPuw&oe=6ADCDA13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
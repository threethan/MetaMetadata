hoQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7cj9SwCAB1o9eEJ0E39iZzupEgrzUTYRbr9WvEse0Fw&oe=6A26EE89"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ_oeYKE3KUQ7kNvwHkfHMR&_nc_oc=Adqdx8qUyYYn4qhi5SkxTCC6SUfJ27wF3A7o8S5_FZ2tDQtKXRqawrTlj7CLpqEdurI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V_02o2030i82fQPf2vXz12rjal11cQ-UBGDwcOLj51g&oe=6A26D0AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGc_MupMyjgQ7kNvwEeyKNE&_nc_oc=Adr7BKuXT2sTfdeRMT_G8sX7N2MWQEaM9QABAe0zDK9fmpumuEEILAIf848a_86Nmi0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gxc6LTRcEpQwnXlN2r8NsUket3nUXf8U_Yrut2tZaNw&oe=6A26D943"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GZswmS5XtcQ7kNvwH3_CpA&_nc_oc=AdrjfQP7RIjDVZTJDNcHf9JoqGjGilYfsiNo_gYHZKt_bhJQ-7_OusskuacQcEPc3Ug&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K30Dt04abLGMHk3yR7bpkdo6AY19_WRpQyUsvGLFPyg&oe=6A26C13E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Selo7HSP0WEQ7kNvwFwJhmw&_nc_oc=AdrUTd4-BpZ72X4YIacjHFMt1i0gDXBRvgn3s9V_6hDaFTNMn5yvy6k6SC_POAFsnRI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ah_j7lepJiWWq2nc1OqOBkHmaYm0UBdEql6S3V-Qudw&oe=6A26EB13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
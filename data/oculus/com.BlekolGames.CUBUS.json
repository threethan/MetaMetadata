5-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeSihlZNiPkQ7kNvwE6pOTh&_nc_oc=AdqOuCR6ipMrUherLHNItbelwYEYcV_uUNb0d0WrXq4A4qSRa36dmRuxpfn-OQmxxhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPSajhYllAhTt0duMrmvziNJDM7Jh1AgdlV-MEQ5_-AQ&oe=6AE1EB49"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKOeWaGXEd8Q7kNvwFGwpon&_nc_oc=AdqVlTQ-tWSHgU2jgNp6nU9cGVWnl4LyfG2wtbBWV43VaPJKlt2NLKvJzZHeFTMTQto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiUHdD6v7yYd1OKgIYtQjQy4a8Qewu3T64cUNQmgGLRw&oe=6AE205AA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1d2RhfXQ1UQ7kNvwGetAUB&_nc_oc=AdrHBT34IPPDQt7qKeODsC9UwJyy--u9UBJDKCxEXNwVJ4gm8J4rhgaWtcSJv3e9lbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb8IFdijQCM5LYhK8r_qdvzGvyrBdjuHIfP2YfLzGT-A&oe=6AE20E43"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xi2bu_PCWTIQ7kNvwHZudF7&_nc_oc=AdoSOAOIVZM1NO-s72zbiJLPp7g-g9PHS8D0gVeKv4_ZAt0GgIKG5tOvIG8lBDTVodg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDpYewE6RQ-oznALLtT3S0Pfkio6B_N9YUqleSG7yPVg&oe=6AE1F63E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsyQTlq-9AcQ7kNvwFsn8xi&_nc_oc=AdqxFyGFWC8NgVXxhuIDAsZdJ8dj5eQ81GwyI0QoPsRi-lq2cKewA6iVJLqWvwv7Rss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_wNptOxRGe48XaQ_N4XeCtjuUOcPdsNyIXbmefafc3A&oe=6AE1E7D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
3-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FwusK1lYZcQ7kNvwHGuF8r&_nc_oc=AdpRE3T00l9iMul9hvIaHBDSqBR94wJdosYkaoai1j_9xGwZ1xNgbQBRFl7dWUNr_1A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTir9mB6rznLoanW7cp-wJTzi8C_xqXteiYILLMqZOkWw&oe=6AE8BB09"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7lf5tFBlQcQ7kNvwEfOvt5&_nc_oc=AdrSsrUnt8cp8CcUpYqma34tQ3PfHf3iwaft5UpkS4qNp2eHoVFfTbHlPtTeEu1irT4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJJfAoULWG4-1xo0RJqakeUpRuN4NLs6Pmt8ycGfYDqw&oe=6AE89D2A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTfRID00dkgQ7kNvwFQ7Xyb&_nc_oc=Adq4pZqBvfYUQKF-a6QYPdaIvxY1wWoUhGraT-ntXje9nf86QpmUNiXH2fn0HHYfpYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6X0bDMNxMo-W6mSkq_vsTL2RK0M6SaipRORfR2s4IGA&oe=6AE8A5C3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4_IIDpiIWMQ7kNvwEL8q9W&_nc_oc=Adrz1C-uHmzwihJFfYb1whE2uhLWHb_qk9q1KR1Y1nGSFYxNzLpdTsuVmiSkcTWjbb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ2Nqb8P2M9aFPbAni6AsACUEbEWzdYTRyG2eBlVoYmg&oe=6AE88DBE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHVUwC1CmG8Q7kNvwHozIKy&_nc_oc=AdoaxcFLIk2b6LAGCboUrhOM6CDf8dTEreSZ9FRJ90N63gAePkCBRExaTBX9SznrYzc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYF4JIIVbmVHp9IbHHIDiWifrIo0KyWuLPNjBQPLUj4A&oe=6AE8B793"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
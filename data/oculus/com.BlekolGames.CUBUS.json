6-1.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezRtjzH6gYYQ7kNvwHrIBeg&_nc_oc=AdriGyDDzI0sw_HZMBsCfxHInPG1bJUVtewhyfcBidON4txzd52NROXVpTXZKdwKS3M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN53sOeMos1FGzVamwH7wU1zqBZ2pHxZMqahaVzVJRXLg&oe=6AD3A309"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCIsqlFT69EQ7kNvwGAtw4X&_nc_oc=AdrbmdPGifM6ZB6Q8S8OHlI-flX5BaVO2i-BrmrzEUV37h8qOBJD4C6JDwMw52ku8Uw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQdrIi7g_Wn7mQYHBzq4m7E6SuJtGJ0iwHWRCTi8JU3Q&oe=6AD3852A"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtR4BlyDD5oQ7kNvwF_Sd4A&_nc_oc=Adp1YJsvc8xEYZXfMcS7ZLP6eveg5-R8pen5OKS7sy_amWHAh_f4u7UeFKrvFO5SKKo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkMXIqP4lDgCPz5_t4sVcW2u7O-1HestHJotapyq7wKA&oe=6AD38DC3"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDKB6knflq0Q7kNvwHZZ81b&_nc_oc=Adrr9s8Tzq-JgKVpjlHh1kF_0pAQqf1zWbrUlI4FaFXKk_egblcwTHLjasXOjybSheE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME3bQULVTtidd8j6qgs-qwrX4ueqPL-VNX2o9arCZPgQ&oe=6AD3ADFE"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moO5y3h9VBUQ7kNvwEW-H0k&_nc_oc=Adper7rpvcyelztN0u4nftmsI7YtWDrlR716s04To68VaqarsOvDvnop8VzK2JM6XHA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTvn_7M0NB4XPMaixJHBuOxSmit76c2ecH0oBv-vI-Zg&oe=6AD39F93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
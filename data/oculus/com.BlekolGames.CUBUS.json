5-2.oculuscdn.com/v/t64.5771-25/491818852_916796177696525_9151051103181343544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FwusK1lYZcQ7kNvwE-LFHK&_nc_oc=Adr7ky2leDv7mrYszxdn7xp9kMlTIbhLbClXhRyI-3XTwmzx0xzld3Ze7hCKRMMvwz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuD8R8l-KneuQUY4ly7RgXpKzLmGNRzadT50MS-RSKOw&oe=6AEA0C89"}, {"file_name": "screen-02.png", "id": "2040293746815031", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_2040293753481697_6133219485162432559_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnZfdgNs6rgQ7kNvwHH8Hia&_nc_oc=AdoBFx7huhibFkj2lBpptM-2_Aog7v3Ij7WMebkhwoIxGSROzVjJnElv1NAH9lIQ4j8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsJH4tJBy0zWyOTmTEe4qbNL2XuU6eP9GcEDkkBs9RRA&oe=6AE9EEAA"}, {"file_name": "screen-01.png", "id": "1596168881425330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_1596168884758663_7430794998196777634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTfRID00dkgQ7kNvwHmkOaG&_nc_oc=Adple06Y-DY7lFMyVy-TFgqIBhTyq-9tbfP2XhoU3cTi93_tCj0yp-3xwH0hK0stXlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPyw4m7vc56JdnLT5Dsdot_3o-xuodFrKEXOW5Kv6q7w&oe=6AE9F743"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4_IIDpiIWMQ7kNvwEFErVR&_nc_oc=Adp0ZSWHwyoWPwm1Ve5m2aUiizetcPljrksFfXztMOO1k5JrnRd2AaUSAJvOTnToe3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjLiS-PUPl8XpV50GpiLShp5EphznvnOHiMiiPjLT2zQ&oe=6AE9DF3E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHVUwC1CmG8Q7kNvwHoj9Wx&_nc_oc=AdqkXI_333GIXZtviBvlyy2uyFDiCeN7CDc0_gH3czM92SRaIQzRlKE9jx_qew1FZk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAWz9o-CGdjyBfgbtRtaS7jcmz-To8Jtw2ZTIsi-m0wg&oe=6AEA0913"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "27562921020
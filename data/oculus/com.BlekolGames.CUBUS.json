=6e7a0a&_nc_ohc=EzP3SeRkDAAQ7kNvwE3BV9F&_nc_oc=AdoqE0L-VoKiQQG23klM7MldFhTACRIsMoMo4W763DybZM8Qflx_wcEnzsE6gwv1rCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTToAT5cOg4i4DytCldUljbm-sX0sFqiuQgy7he19GSlQ&oe=6AFF0F43"}, {"file_name": "screen-05.png", "id": "2045227109567649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818890_2045227112900982_1962636466505235779_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7bpv3aTh9oQ7kNvwG3tB6j&_nc_oc=AdoA67by3D2zjI6TPWp7BH7MlErVCeZZLbRplbH9pSzP0QpAQ6g4lJIrAM9ZxUqonhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg82EM1HGejepOs8Bx1zqY371gfJfb7fZsaTY5Kvfzlg&oe=6AFF2F7E"}, {"file_name": "screen-04.png", "id": "4163786360527653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820855_4163786363860986_927856132487603251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM_Hvp0z2hUQ7kNvwEfYMwJ&_nc_oc=AdqQmOEJcamk2MMJGixnxeZsqQPp1FXq_BbzryTpCr4vumVFzPrxEJfUf8bfZIWuTQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjs1f8MQvwlat0RrmWtBXd1Gpcmtm3b4iuGAI2SDZMYg&oe=6AFF2113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-9.png", "id": "844860955014900", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827743_844860958348233_2077116535604637391_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyssgoCXJ_kQ7kNvwEqzUIU&_nc_oc=AdqzS-XcJXXJ0P28qogOmF1NfcjbA9JWcPyN7Tje68PHXmOB9NZ9uR_9GJnFJNmvqrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAZOyrwELvz-uveUCjN7sEpTZbdJm8ufZPC-CMFFR7PQ&oe=6AFF261A"}, "display_name": "CUBUS", "keywords": ["puzzle", "logic", "strategy", "adaptive", "minimalist"], "long_description": "Think before you move. Every roll matters.\n\nThis is a pure VR puzzle experience built around intelligence, planning, and precision. You control a rolling cube using your thumbsticks, navigating minimalist environments where color, direction, and movement decisions define your success.\n\nEach face of the cube has a unique color. To progress, you must align the correct color with matching buttons in the environment, unlocking new paths and exits. The challenge is not just where to go \u2014 but how to get there using the fewest moves possible.\n\nThe game rewards smart thinking over speed. Completing a level earns points, but every extra move reduces your score. Falling off the platform comes with a penalty, forcing you to rethink your strategy and try again. Mastery comes from efficiency.\n\nThe first 10 handcrafted levels act as an intelligent calibration phase. Your completion time and movement efficiency are analyzed to determine your personal skill level. After calibration phase, the game dynamically adapts to you. The better you play, the smarter the puzzles become.", "short_description": "Roll the cube, match the colors, and solve mind-bending VR puzzles with the fewest moves possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blekol.com/privacy-policy-cubus/", "developer_terms_of_service_url": null, "publisher_name": "BLEKOL GAMES", "support_website_url": "https://blekol.com/home/contact-us/", "website_url": "https://www.blekol.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
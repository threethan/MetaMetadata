7836_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZmlkrFeVmUQ7kNvwG-J8c0&_nc_oc=AdqUa52AWPYZ3UXc6_vTkjv1kTp-1YzCEbqEZMh8vTR891Lpd_K1QlfoVOZho6kUsTM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnbnp12RIcjn6zWB_AAUXNWW0qstiyT8n0o_o86bmcFw&oe=6AFB2882"}, "display_name": "Rooms", "keywords": ["escape", "room", "rooms", "puzzle", "mystery"], "long_description": "You woke up in small basement-like room without knowing how you got here. Will you be able to reach the end and find what is the meaning of all this? No time limit, no help - just you and power of your mind. Will you handle it? Or will you give up?\nPlay through three connected escape rooms, each different in style. You have only one goal - find the way out!\nMade by the fan of the Escape Rooms.\n\n[Game requires body rotation - please keep this in mind before downloading]", "short_description": "You woke up in small basement-like room without knowing how you got here. Will you be able to reach the end and find out what is the meaning of this? No time limit, no help - just you and power of your mind. Will you handle it? Or will you give up?\nMade by the fan of the Escape Rooms"}]}, "developer_name": "Wojciech Zawadzki", "developer_privacy_policy_url": "https://infamousdreams.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "infamous dreams", "support_website_url": null, "website_url": "https://infamousdreams.com/rooms/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_
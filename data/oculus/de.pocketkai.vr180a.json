5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzp5KFb6sM8Q7kNvwGBCpOQ&_nc_oc=AdrW9E8bC_CuVkqPq4-BqFLJ7mT17eDgnV86g4duGVHFtrwULIoyAit5WStxsxWFTF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVFyKhFFxUfwV7nIdSzedi2yBB-B9Vk7RHFHkLyz4lhQ&oe=6B05B0B0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQvS_zlR3IEQ7kNvwF7XXfe&_nc_oc=Adobx8o-rb5mrvlzRQfA_eiTEdxP-QQFbk4ggkWcni1vVQoA6gRgA7tsXytpv6KCABg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhlmSOexT431F7l4nkodyGudHaZMEOCQkdWa9Hz0jMhg&oe=6B05C600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZcxgcm9-p4Q7kNvwGA2qNJ&_nc_oc=AdrRBD_QY1AidwaGgKF9o-0G1Zb3hrtDdVIHypbloyw6s6X-RlkoRBZA-7k6LUcjXuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqDtBmrTiX-MsNy88XF9iB9VfJu1ZvsyzY5T8-q1vG5Q&oe=6B05B9A5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
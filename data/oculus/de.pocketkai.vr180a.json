5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6F1CZ3Z-CcQ7kNvwEYrwb4&_nc_oc=Adr-t0V7zDLf8Zsva_XounHnP4Zqk-Gkakt0KDB0ms9Q1rNCbfCgFBPfVCbJb4i2siM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR_o7Gi9nqVuupyLcPb4_bGMHyYL3BXXB30BEnnFUrWw&oe=6AFC7630"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGvC1-XZmhIQ7kNvwG_vOss&_nc_oc=Adqx8ReSAMTpbQ7_gRvE8R5H2bJC8XEUw1H6Z51QAk0Gc34dMIFAsdEGu1YTlua0ItQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj1DfzLh7bIY13RcoemPava42ZXkOrlu0Xm1pKt6o3EA&oe=6AFC8B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVcaNJVP-cgQ7kNvwHwzFOl&_nc_oc=AdqmUDhHaxzFXY7qzTTS4CETVip4JimKpj3d4oW-tZDo2WR4irylGMOMlOEEe6LOPho&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAqhxq67oROYKC2e7nzPydgIZtxrr7pSnX1bL59rNpOQ&oe=6AFC7F25"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
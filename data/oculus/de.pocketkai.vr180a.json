5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwHHoGdMcAYQ7kNvwEhW1kK&_nc_oc=AdrDhyASWO5hKqudE-WJcuQlytk2MrBYfXQZm1YKTKvkqmvZoSmI7gr_pG1ZfOWfZcQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtCuKmuc8kHR5W9jMb6h03vK-NJxV3AnpWFDvE64i1xw&oe=6B0B2EF0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XabCyi-l2wQ7kNvwHUp9Ft&_nc_oc=AdptWjIJVMjiOqxDL11TPD67CgePEflSz4La-2WlZNh86o0j8sbrOyZ7b_EVKIFtsvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyAzw98_hM7eGJUgyNykIuaR2X-nf8Yv00RcD8LmT02w&oe=6B0B4440"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lTY1bfjPPUQ7kNvwGcRy2_&_nc_oc=AdoEqxtLHxnM52X0XaWzLIBDceTufiJMFYAONWDHoCVMsriOQYplNyqPY6xfvuYTlq0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTg5Ydp212JmoRTAiJDzdc1mgv6X6Qngmp_J7mC_6KyQ&oe=6B0B37E5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
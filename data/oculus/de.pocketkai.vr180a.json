5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwHHoGdMcAYQ7kNvwF8LZte&_nc_oc=Adoip3Uva4yq0nEgXsTGVXVSHpx9Gcn9zO9R1B48LD0cKC82U6PwiZEh6LMoe4x5Vzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFY4Vo3C51Itlz_-Dy4EBscbIIf8w0R1gnfAcU-hBjHQ&oe=6B0D99B0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLMDbeZ77_YQ7kNvwGI3WLY&_nc_oc=AdqE-I6Z_RgmRkAxHuiGW7irT493kXNWZCwZEGvc2SK6WLJlzhBuijnNjCODcdKDMsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQD_16i9X27cu9LQ3xw1PyxEquklTHi6EfPDYjw3JYAWA&oe=6B0DAF00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lTY1bfjPPUQ7kNvwFU2nSD&_nc_oc=AdqxZRig2WeHR5QP4CLqayQ3ZjfgSTJGkxVAzbToOgN4pffNy61d-_jO7AZNnhBFngo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaP-8d_Gpn0srIInFVK83V-Wmdx_vSeQ9BKS0zijfLrA&oe=6B0DA2A5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0S2yonhewkQ7kNvwE7S4SK&_nc_oc=Adp8jb8gI2axzF8KI8f9EMgazyoaEC9rr-8caH6qoQrSb1v33BBMXpPEF8JcAevafZo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrNjL60KhigrzFCRxBWTCoF9UAjNy_nJFsGj-o_P0QBA&oe=6B09A530"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XabCyi-l2wQ7kNvwHO8tBx&_nc_oc=AdqYF24KVvbozSz_pkfIsX9qC7ygVo8pQ-LYXutNeFsx0AnakST9XRS_pB2ajZUaTUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFWAbGegmUwevjBQP5xtMAVGd864_kJ_ihUKm_MqjbKA&oe=6B09BA80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SnfvFrOpawQ7kNvwFFeIx9&_nc_oc=AdotX_Or-QzFSfMLRwigB-sGgQAoRs0S08xy3bc83Ub_-3Z9TPsd1OjNjRHF_J_lyC4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu7Vvmc8K-3AsKGAmsX-LDy-sUWlvDlcjM32RBCa6LdQ&oe=6B09AE25"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
-ord5-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiiGtYgNLf8Q7kNvwH-4Ytx&_nc_oc=AdncLLBtlYk36HEI5w2UEU0GwR6-2k2wGgNlA_nea9fJQIpiQmH3d78Fdy_pQSCCtCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftiZnkUp3KdPlEzUtXJKLCku0BN7YCDJeHNZOCqAwkZ7w&oe=699C52C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIbnRTKDuwAQ7kNvwF2i6GP&_nc_oc=Adksbo8wzVsyiJPc6aC-Td0rLJGOIaPiZjymvfgMkrSF634w5yrikuHiKJLrRs-QQb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu7W1rIpRlYmuZf97GE-9omWG3obBaEyE40wcx7XvT05Q&oe=699C4665"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bitrate erstellt, 4K.", "short_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen."}, {"images": {"nodes": [{"file_name": "hero2.png", "id": "3952056921731087", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391775_3952056925064420_4857476700525027439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynQ__MVaL_QQ7kNvwHQIlxG&_nc_oc=AdlL6UKLt1t0Y6v
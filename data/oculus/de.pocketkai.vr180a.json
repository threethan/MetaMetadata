5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6F1CZ3Z-CcQ7kNvwFAy6PJ&_nc_oc=AdrrygRighUUHRNiKvtPoq-aWJSXJ_sU_w1hEG8aFM8knplH0UiJTm8tbCUfALPLkzU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDXkR6Tt3fRbwcs7rcH660OwxHSEexeOQBsZfKd8dMKQ&oe=6AFB24B0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGvC1-XZmhIQ7kNvwF84CLk&_nc_oc=Adp3q0aP_X2iUiqo-8dtnBCbhjL52_GJ-sRpzKOduyW42-rO7dvv8r5ttxuBFjiyMzo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnH6-dfVSKoDlRmUPDuTaUvww8cxu22fXN40ANs_zX9A&oe=6AFB3A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBsH0nXszjgQ7kNvwHZi3gH&_nc_oc=AdogvVIYQXhQ4ff2oV86eGyCVbho3VavMM5ThI14edKuLjPjdw_awjPnjmZNEuyRsbo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN9IWrANeHQ7ocryry4SGqlaJA6i-vwcsUVTA8Txl3Fg&oe=6AFB2DA5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOzuKXO1S1sQ7kNvwGF2_d0&_nc_oc=AdqzEah_9q99eCvh8yWPzbHndA0vTj1ZYauOEFAaS1TLM_5tdnTXWjA_CbEu8eGJZl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVlTU8wgbt4-VPtO9RGdSBjOAnOwuSZY0Koft4UNach2g&oe=6B103CB0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLMDbeZ77_YQ7kNvwGGJldY&_nc_oc=AdqEE22qsPpegJeAYdHz4T32DtbLCXOeDlb7aL4Ql19kXoImqSy3upa7hjjFiIw81IU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWCjOGfr49oAPma_0QVBUgZLBB4hgV_p5tV675HEwYjA&oe=6B105200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-xaZSfRBb0Q7kNvwEDSrZP&_nc_oc=AdrSGVBjsoegjTzn21JjfHtWj-vy_vSi1tBA8gY1vPjD04cBUIryxG9dn_R2UPbZr3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVRvUzuc1PZWU46K2ZF4GxqMqM5wmtIKwJOAyieFznOA&oe=6B1045A5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
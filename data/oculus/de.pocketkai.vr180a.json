20f&oh=00_AQEdc8ew0K1tv42WuDBJHFQ4ii5JIWFt1f0kWiHI9_OPoQ&oe=6A8596F0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vox30fPUKT0Q7kNvwFK3HbR&_nc_oc=AdqIsnFykSW5b5y8kTR5nkX3xwFDggQXaoqfdyny8stzdS39qvz9fNc2z470mEvfsKo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQIWEo8WN0mqjJTm8D-99sCcTgnLw0ttkOjXBdmMi-Ug&oe=6A85AC40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYtb1u5jBykQ7kNvwFOyISu&_nc_oc=AdrHhs8WYaVzeKP22qUolqW7lg0ZeKIe-M674Pfxgg_ZdMdQlkSeNpVeR5jo3R-zVLk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGucpm_uM0MBnrkF5k-ppgHypxz5WWe8Y1VLkKYaUS4w&oe=6A859FE5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bitrate erstellt, 4K.", "short_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen."}, {"images": {"nodes": [{"file_name": "hero2.png", "id": "3952056921731087", "image_type": "APP_IMG_HERO", "uri": "https://scont
5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwHHoGdMcAYQ7kNvwG1pfZn&_nc_oc=Adq-c9O7lM8h1Bl5jA0mkMl3iRMDuZVUD4K-v9ao0FsW2YNxetbpEwIanyM_RpL8sds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYw3ogeE2IQZGGHP_Bic8VuTLiOouUZS1g4N1ikJk3FQ&oe=6B0C8070"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XabCyi-l2wQ7kNvwFNk-qs&_nc_oc=Ado_Z_x8F2wq152lgkNU_W5DM6DNN4h2I-j8P_QzQ04-mKiSEcHYqvCi4B0PI8HR1ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQh6Y4sxp8EDxyt3upkTTX5bF5p7gTkrlbrlMXqGlKB3A&oe=6B0C5D80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lTY1bfjPPUQ7kNvwFCo3e8&_nc_oc=Adpixq0GqcFox790uVkOc6eKItHSSG6y85Nt_FVdn300wDTGkHjKpP91P2jOQHH3wkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjAnvP3Nj5Gtvw0Ljgra5zcS_uPFQdlQSoKxN8fwBJ2Q&oe=6B0C5125"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
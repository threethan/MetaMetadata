5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzp5KFb6sM8Q7kNvwH_AGvT&_nc_oc=Adot0ZBm5SnV9RIpc1lhS1o5GprZcw5PF1hxDluty0e6htryBrEeUbFjm2DqWtGiClo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzom-SiVzseKOh19nRtqmV91euditRa1MC3JC4gZ8nPA&oe=6B030DB0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAmf-EacqLkQ7kNvwFscmu-&_nc_oc=AdrnJ2mZt4xOu0ol3x4w0MFDQHUYMCNPEwehzTMpMvoMZ0mOSWX_OjL48PYEL6fxnJM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbOThW1HVWqHWRCbnN49RFORt_cGv35qe_7hGJHkfgwA&oe=6B032300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrfOEZZX4wAQ7kNvwHECwTp&_nc_oc=AdquQT3mmg2GmB1pVHmXip5kl2EgJOT-Ddtne9-vc6IO6EXj5OzgwCWRoM1bJZZzbgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHL6FEMFcPzMgK8VaRGmgkr4mwFtDG66AuRXUULy1R9A&oe=6B0316A5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
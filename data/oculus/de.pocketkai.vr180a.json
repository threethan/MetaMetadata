3d", "real3d", "video", "immersive"], "long_description": "The app shows VR180 3D videos in real 3D, with different representations for the left and right eye, recorded with a VR180 3D camera. Use the X, Y, A, B buttons on the controllers to select the videos. Videos: In nature, AIDA cruise, From the cable car in the Fichtel Mountains, Tenerife... 3D is a special experience, immerse yourself in the 3D world as if you were there. The Meta Quest is very well suited to displaying 3D content. The videos were created in maximum quality and optimal bitrate, 4K.", "short_description": "The app shows VR180 3D videos in real 3D, with different views for the left and right eye, recorded with a VR180 3D camera. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pocketkai.net/asp/meta.htm", "developer_terms_of_service_url": null, "publisher_name": "Pocketkai", "support_website_url": null, "website_url": "https://pocketkai.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8897884633673185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391820_2085661101863946_3849249100847405183_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMSoV1OGf2kQ7kNvwGAZNnx&_nc_oc=AdpwVtnJ8TTBWwDwwfqhJr3AQT_9FqXaj2zydKCyPlUyYYrs-mnGn3xdYSaSnqG4bYE&_nc
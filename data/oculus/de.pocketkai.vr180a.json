5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0S2yonhewkQ7kNvwGsKDld&_nc_oc=Adr4G7iAqb9nMMPZI2XHFZpYm-gnWYUeMgONjC1pETvwv-2ueUFXJVN-gy7tTpgHJmA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTHEbrJEO0J-DFENwuja5S79hWl9XLfYYItzsIUvWXyw&oe=6B0853B0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQvS_zlR3IEQ7kNvwEwWeLE&_nc_oc=Adqk9aa8ty01DC5uFYZLjy7n-gNb9aAiViyWbrPQbF4t61geqbkT69UdaTr5791CyT0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyLBS29VKaVwlx4tFFVXFFpT3gqcwGRa9z3-E5t6soHg&oe=6B086900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SnfvFrOpawQ7kNvwHIIWXX&_nc_oc=AdpOnZyVkmO8Vbu16rB8cPFBQl9o3KxBoQmQwcW1ulyf68TFt_UrmVujDUG2fKR8y2U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9XAO4995x1lk2BbJTZ7Sp-wyJIMBoLAk3TOlLe0FXhw&oe=6B085CA5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
-iad3-2.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiiGtYgNLf8Q7kNvwHzey9J&_nc_oc=AdmirAlLO7iN1NvJi7Nzt5FUQdo2kTy01FFtNVymMJq5Xw0Rnwb7TcSXVpVnfrxqKQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvK4QnWylHIx9d40wYDzhNSkSyXxDdSXfFOLFQUzRY8ag&oe=6999AFC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFfD78cRdRIQ7kNvwHXnnei&_nc_oc=Adl0jwGwhF5y3KSF9RoSwi3zxCrfGRluvUvCfh7oN-AdyAK3I1yQs5z0n0VQ2NgxGak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMbE5UBl5JAwwVMrGDQv0ORrphWAljpkY79MgaAArJiA&oe=6999A365"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bitrate erstellt, 4K.", "short_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen."}, {"images": {"nodes": [{"file_name": "hero2.png", "id": "3952056921731087", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391775_3952056925064420_4857476700525027439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yg_YPsavRoQ7kNvwHz2A8c&_nc_oc=Adm9swpFOuPiBD8
20f&oh=00_Af8Fr2Vrxx8mEfs4GXVtB9x5c-29tGk8HEkG1SihT-4UGA&oe=6A468730"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehkuSBRKarAQ7kNvwFLqPdW&_nc_oc=Adr6D_GIt_kW--KT2_YbKzARKAZ4Sr-Pz6kJhxMXWZpYgFS3CKbPPJ4E2dZrngNxSoM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M8-SBvAM37BcYI9274NqJuDYcFTicgw6XtimPvNgsYA&oe=6A466440"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i2PQpt_0mcQ7kNvwE-k-Rv&_nc_oc=AdqzxAY_F-50UGeq60GIG3A8VO2pzKsTmMNda2nuYuh9vFjTf5O-rr8z5x01iXBtW8U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BSIgI24eFgMYUoiTNMetU6zAAyQbfEnfXupEEu8_qng&oe=6A469025"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bitrate erstellt, 4K.", "short_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen."}, {"images": {"nodes": [{"file_name": "hero2.png", "id": "3952056921731087", "image_type": "APP_IMG_HERO", "uri": "https://sconten
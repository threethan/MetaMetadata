5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bzp5KFb6sM8Q7kNvwGhR3MK&_nc_oc=Adp9jwvUbd7_qPATGPKgBt42xD27--_qhjWu5h03E8mvl98g9f2v0aPu6TV_8Chb5mU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFobpz4lMLtwxdNBUfFWggoqONmOA2t7s47Gr8PxFndg&oe=6B045F30"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAmf-EacqLkQ7kNvwEG--qE&_nc_oc=AdpI0nZueq06WLyc-5GuFpO2MlVpMU-TJSEGPLseoVkuqkGE_4JiEt_TL-6RV-X4q8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMkOd2zfc5QxttXiUwUkroE9lTHUYCovEBHvxPe_QOgw&oe=6B047480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZcxgcm9-p4Q7kNvwG-fwk9&_nc_oc=AdpX5AxPbaHCKneqV53Mwb1IrZc5SMbY7uRajOrYtyHjiZfZSGHBCLj5_8zNrbvyTdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnfOhYjC62xvtHzujNkUMASD2Xy5xiSJ6GZOlpt3I97A&oe=6B046825"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
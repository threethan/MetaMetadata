5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6F1CZ3Z-CcQ7kNvwG7j2uY&_nc_oc=AdqsQ_Q7tXf7obxbjZ4BYTgJD_H5w8GfqwNeup_QAwjb3aAdn2EhMVIOxXjiDa7m_BM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy9QxQL_hFB6dW4Xesx-kQryQCdMnKMrbO-LZOh3gbyg&oe=6AFDC7B0"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bexelJYF49IQ7kNvwGxcogJ&_nc_oc=AdrlMy1KiBbhJb1KLOiA_cqXTetKXzxylrBjBjMkna_WA48TXYZ81M2WC88XG-RSTfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyjNPmSSdCtUTfhknoKfO2C72Ued_WYV1BDkklqHrRPQ&oe=6AFDDD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVcaNJVP-cgQ7kNvwFKbH3m&_nc_oc=AdrZ7paCc62Vz7PvofqyANkdTxyQJ8y3VZIEHjXUcuLVpz1YSkLS4L2WruSaPO_GIi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShCagpB70Kr4_SDF65mWXv7tGAoJuDy-2jiDhOEg9HxA&oe=6AFDD0A5"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
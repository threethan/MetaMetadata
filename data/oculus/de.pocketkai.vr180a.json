5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGjEzJRkX0oQ7kNvwHEceeE&_nc_oc=AdpdOg5DMV5w8Vi12Qrv8lm9fNLXLVnX4Ahe0Ep12dTCUTxH2X5pEltXzK-ml_XAORk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRatIyN_b-te3fo5EYyWEbgFbTXBDqVOenclnIIPrI9KQ&oe=6AFF1930"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bexelJYF49IQ7kNvwE8mFjl&_nc_oc=AdrGsckA7lJWd9OhJq47m2TQDVioS35siIRAIkdEfcL1hwSvv8K9RhN5dGUzbH4vzug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC_yZSeI6Hx55wJYO-WKtYi3TGrgqGqmnqukXJ85P37A&oe=6AFF2E80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVcaNJVP-cgQ7kNvwFbqCRo&_nc_oc=AdqC-aaG4z0Hlkszy6DV5hJsWui5dJBAyl6Iiy5CyoB36bo0ri4pWG0MIvcQBWkz59c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQyYNXCDXBVgOvwEgeNi48jutyi-XNCrbQdFswckNL7Q&oe=6AFF2225"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGjEzJRkX0oQ7kNvwHGDJAR&_nc_oc=Adocl2OfvzJEZy6QBGNlQKgph5Tgc57q0r4Sh9ifXsDaqnNswSb74g45rur43n9mEis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWN-nE9Az-pNgpIn9_qKuaIElFb7xE64ibm33efFxNKw&oe=6B01BC30"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAmf-EacqLkQ7kNvwHlfSc5&_nc_oc=AdroQgMAWddqh5KIffTG_EMsZ04cAX_WKp5GdahMDk7T6sQhL8TzKtwEeUh7p1ZjRDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi_Eu0HBAU8gdKnEnz7bnSwHqYT-tiF_zCDkvewNiofA&oe=6B01D180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrfOEZZX4wAQ7kNvwEkrVXN&_nc_oc=AdrwFIQd9YR5sFgkRjUUoX8MG5a5nPDf_SYqfEoD7ymaunVCQjIvg2-wCG6yyS2onI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDTBhuWPHeD15VKDdd8Bd2potTtuKQCva1z_rTtzs0PQ&oe=6B01C525"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
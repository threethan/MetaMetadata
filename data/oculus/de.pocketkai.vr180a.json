5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOzuKXO1S1sQ7kNvwFU9nJt&_nc_oc=AdpWaA_vb4jRePr7a1jT6bnKgf8s55lgE0Y5_vyIjtPIKiuN4nArBVqaCunJA8IfTwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUumfdM73kvw8t6UCr2zlG4dOILK2-9E5HrT_QWq6mTSQ&oe=6B0F2370"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLMDbeZ77_YQ7kNvwFf8qN9&_nc_oc=AdrrSqQJMNBGe2M3YXrp9zguEREICFuXyhwZKqIe4nm6lRsmFP9bHRdN7kLIuD6PzgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9FtUZQrTFQHIJ-hHsijVbtCKn3cAWp2uZUBEAAClFUA&oe=6B0F0080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lTY1bfjPPUQ7kNvwGe_pBg&_nc_oc=AdpBoMqxuyiHPcIed4HFEWt2p2Df-gSit_P_vlO1TE7GhZUjKlWF_N0n9LqdUzy8bo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdWrDHWu7shd7BuKY0AmPL83E5UIeZsvldn7Dx_zFIvw&oe=6B0EF425"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
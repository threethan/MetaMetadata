5/473391731_1604228926881957_4049103744273282682_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0S2yonhewkQ7kNvwFwvnZd&_nc_oc=AdpQ6HEYNp-67jdYCVwFzShY9RL6CAPIhmFsuGfiB1oetbjjpv6LQqhHg1E0YTj-Fvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj8QTwMgD43oME-ht5-c-oKR52fwYJnUfuEZ6_EHsbdQ&oe=6B070230"}, {"file_name": "screen3.png", "id": "1161485735372742", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_1161485738706075_158740511354740089_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQvS_zlR3IEQ7kNvwHbKM-u&_nc_oc=AdqVyNPoAegzt2c4GBWfjkKgBBjVhZgj5jYTMMs3Ndg8b7jDMWrWomn7UUWOQSkrKM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF3-OKWyP6b6wH3quLg-F4N35CqT9qqDtrMgV63iEErw&oe=6B071780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vr180-aidacosma.png", "id": "2106542519778025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391817_2106542526444691_3711536852769783919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZcxgcm9-p4Q7kNvwEPpbTx&_nc_oc=Adoz-9qExonG2Nn2q7Hp8c6IbLmJ8m5MRbjpuFQkL8W9b21Qs35_0nZoBM18TAs_LGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB1BKcXDMp1HjW25kTX9e4sAvxe7kXZbClFehKIEL0zA&oe=6B070B25"}, "display_name": "VR180 3D Mix", "keywords": ["vr180", "3d", "real3d", "immersiv", "video"], "long_description": "Die App zeigt VR180 3D Videos in richtigen 3D, f\u00fcr das linke und rechte Auge unterschiedliche Darstellungen, mit einer VR180 3D Kamera aufgenommen. Benutzen Sie die Tasten X, Y, A, B auf den Controllern um die Videos auszuw\u00e4hlen. Videos: In der Natur, AIDA Kreuzfahrt, Aus der Seilbahn im Fichtelgebirge, Teneriffa... 3D ist ein besonderes Erlebnis, tauchen Sie in die 3D Welt ein, als w\u00e4hren Sie direkt vor Ort. Die Meta Quest ist sehr gut geeignet, um 3D Inhalte anzuzeigen. Die Videos worden in maximaler Qualit\u00e4t und optimaler Bi
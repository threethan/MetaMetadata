nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNyx9AwdZjeFbAl6gZg9a_CFfJQoh2fF8f0sOXZqQerQ&oe=6B045D98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440px.png", "id": "1303370130776205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_1303370134109538_4809942757144768901_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93c36coLWT0Q7kNvwFJM1aN&_nc_oc=Adp1Ionp3N0T7uClAwLE1OYWjcjFZQvcMxZQ7wKsIfVInR1yUPGHL5siD0HhtzeDmks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAL4cKxC34Vf2cQv1qs9wUbQDgd3ze_mUwB22pPSZr9w&oe=6B046C30"}, "display_name": "Smash That", "keywords": [], "long_description": "Smash That is the ultimate rage room simulator where destruction is the goal! Pick up powerful weapons like a hockey bat, cricket bat, crowbar, and more to unleash chaos across three immersive levels:  \n\n\ud83d\udd25 Sci-Fi Room \u2013 Smash futuristic gadgets, break high-tech screens, and shatter advanced machinery in a neon-lit sci-fi setting.  \n\ud83d\udd0d Interrogation Room \u2013 Tear apart the room, destroy interrogation equipment, and wreck everything in sight.  \n\ud83d\udee0 Garage \u2013 Smash cars, break tools, and demolish the workshop in a gritty, realistic environment.  \n\nWith satisfying physics, intense destruction mechanics, and a variety of objects to obliterate, Smash That lets you relieve stress in the most fun way possible. Are you ready to break it all? \ud83d\udca5", "short_description": "Smash That is a rage room game where you unleash destruction! Use weapons like a hockey bat, cricket bat, and crowbar to smash objects across three intense levels: the Sci-Fi Room, Interrogation Room, and Garage. Break, destroy, and let off steam in the ultimate smashing experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rajgohil28/Privacy-Policies-and-Terms/blob/main/Smash-That-Privacy-Policy", "developer_terms_of
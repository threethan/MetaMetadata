oculuscdn.com&oh=00_Afs8EuP2CYh2jVR9o1bX8rGlIQdoxyDbI2RTS_b-7f9UMg&oe=69A18CC7"}, {"file_name": "SS4.png", "id": "1149019173378560", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392019_1149019176711893_5164645721161773894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFIsnqJhKaQQ7kNvwF5gKve&_nc_oc=Adl0sJBG2iN63CWn4qeZOnsFk7EmX8bI9bmmojXlR9khapm_Y15QOiaKlarJEbdNe9A&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvupa8l4MyVrqRfLAn0jTkBlni7yt6a__Bbn-82r9Oa4Q&oe=69A185A5"}, {"file_name": "SS5.png", "id": "1307362490379404", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393554_1307362493712737_1277938943589129730_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_veNbtrocIQ7kNvwHrlI7u&_nc_oc=AdnT32w1Clao-Y4I8Tj11bDGG0sQIchllONEVlp5-EbbOlkAADFAiEWl1zn21HC6QxA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuScQeEp06ZYTgVASgu0vLW7RHPIlRkTZU29MDTI40uFg&oe=69A181D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440px.png", "id": "1303370130776205", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391978_1303370134109538_4809942757144768901_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa4c693qoscQ7kNvwFtJIbK&_nc_oc=AdmZTa9sXue3C5vYMDCJhG7jb9JMVWqNoMggVh22Mni8q2C3l81gYo4Mpe6YYoDs4ws&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftBsuX0YFSukxc-rUgmXIBEkWWqR7jKZNz0vx5eme5fEA&oe=69A19070"}, "display_name": "Smash That", "keywords": [], "long_description": "Smash That is the ultimate rage room simulator where destruction is the goal! Pick up powerful weapons like a hockey bat, cricket bat, crowbar, and more to unleash chaos across three immersive levels:  \n\n\ud83d\udd25 Sci-Fi Room \u2013 Smash futuristic gadgets, break high-tech screens, and shatter advanced machinery in a neon-lit sci-fi setting.  \n\ud83d\udd0d Interrogation Room \u2013 Tear apart the room, destroy interrogation equipment, and wreck everything in sight.  \n\ud83d\udee0 Garage \u2013 Smash cars, break tools, and demolish the workshop in a gritty, realistic environment.  \n\nWith satisfying physics, intense destruction mechanics, and a variety of objects to obliterate, Smash That lets you relieve stress in the most fun way possible. Are you ready to break it all? \ud83d\udca5", "short_description": "Smash That is a rage room game where you unleash destruction! Use weapons like a hockey bat, cricket bat, and crowbar to smash objects across three intense levels: the Sci-Fi Room, Interrogation Room, and Garage. Break, destroy, and let off steam in the ultimate smashing experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rajgohil28/Privacy-Policies-and-Terms/blob/main/Smash-That-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "SpatialOS", "support_website_url": null, "website_url": "https://spatialos.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8553298274767862"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1573945267133181"}, {"status": "PUBLISHED", "id": "1714938792748165"}, {"status": "PENDING", "id": "2262154374179641"}, {"status": "PUBLISHED", "id": "706234625067332"}, {"status": "PUBLISHED", "id": "1731309887418620"}]}, "baseline_offer": {"id": "1731309887418620"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id"
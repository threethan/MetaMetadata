oculuscdn.com&oh=00_Afs3100AJUUFUbgyxX-Ss0Lr24z3cI8hWmSqqNHAZR1xQA&oe=69A03B47"}, {"file_name": "SS4.png", "id": "1149019173378560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392019_1149019176711893_5164645721161773894_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFIsnqJhKaQQ7kNvwEupsz0&_nc_oc=AdkssGutgH-qKPEx09UnpSboWmISWcBcI8yXuZo4SHZyRb76uuhujjNWyPqLY_X7Vxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuwN7fpSsJEOUs5ooyJR1_juzhYrlDa94cSvahI8fYeXQ&oe=69A03425"}, {"file_name": "SS5.png", "id": "1307362490379404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393554_1307362493712737_1277938943589129730_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_veNbtrocIQ7kNvwFFZzdX&_nc_oc=AdkY7h2P8ryCE4tQ2_CcifrFSmlgzSNqn2mj0cSsQANUB4DDtEB58SMB5Xtm_eQ0DEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuqPUgCdsjoEHovMzMYBtkd_5KUNqFG-VS1pW869RQSHA&oe=69A03058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440px.png", "id": "1303370130776205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391978_1303370134109538_4809942757144768901_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa4c693qoscQ7kNvwHtL69j&_nc_oc=AdlH0UNoiKkIb3VBaHskxPmfP_rvYYM_7_MSUAoYVj3DGOVFalmKYKM5nLQrPef1Tgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNZtwhYWaK7B7zG0jpn4LOReMkPPBDkKrEKZxF3czzDQ&oe=69A03EF0"}, "display_name": "Smash That", "keywords": [], "long_description": "Smash That is the ultimate rage room simulator where destruction is the goal! Pick up powerful weapons like a hockey bat, cricket bat, crowbar, and more to unleash chaos across three immersive levels:  \n\n\ud83d\udd25 Sci-Fi Room \u2013 Smash futuristic gadgets, break high-tech screens, and shatter advanced machinery in a neon-lit sci-fi setting.  \n\ud83d\udd0d Interrogation Room \u2013 Tear apart the room, destroy interrogation equipment, and wreck everything in sight.  \n\ud83d\udee0 Garage \u2013 Smash cars, break tools, and demolish the workshop in a gritty, realistic environment.  \n\nWith satisfying physics, intense destruction mechanics, and a variety of objects to obliterate, Smash That lets you relieve stress in the most fun way possible. Are you ready to break it all? \ud83d\udca5", "short_description": "Smash That is a rage room game where you unleash destruction! Use weapons like a hockey bat, cricket bat, and crowbar to smash objects across three intense levels: the Sci-Fi Room, Interrogation Room, and Garage. Break, destroy, and let off steam in the ultimate smashing experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rajgohil28/Privacy-Policies-and-Terms/blob/main/Smash-That-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "SpatialOS", "support_website_url": null, "website_url": "https://spatialos.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8553298274767862"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1573945267133181"}, {"status": "PUBLISHED", "id": "1714938792748165"}, {"status": "PENDING", "id": "2262154374179641"}, {"status": "PUBLISHED", "id": "706234625067332"}, {"status": "PUBLISHED", "id": "1731309887418620"}]}, "baseline_offer": {"id": "1731309887418620"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id"
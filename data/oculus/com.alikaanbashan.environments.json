-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqyLK8o7kpoQ7kNvwHzuyB5&_nc_oc=AdqnNRV9wYl4dTVVY4zfBlqtFeHoBCgbkrR9Fm_M_-tGgIo0N6s61wYBB68kj3smn88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u_854H5HhYu8g1zPqlZUZDBWfiXe3pL0lG8P7d8JZsQ&oe=6A300E35"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33EKebChINcQ7kNvwGeclhY&_nc_oc=AdpJURloT0STLE-9IbIj7fcA-MZQvfE6odvhKKkG_I8qLmbd_wYxXvLfSb7KZHFXBXk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CeUyy-fjYVpB7EoRbgmQtSz7SjjfR2cNnFdqPDi6u4w&oe=6A3018F9"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhS5Lg5Kp_gQ7kNvwHR4YqH&_nc_oc=AdpACvEGKyYAfgrBa0aB1B5ucKqBcXqRBgWoKk4oBHHMX72FkGO486lW46dz1lfzmyE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JfvWAO9CrW37SiGHgFhVPKDZe68rgj_oVuxL-Pw54zQ&oe=6A300007"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yVVRW1HW5QQ7kNvwG_vh6-&_nc_oc=Adoiv-AI9kK-UoB-j2VEZoIn3SjMy2-y0x23d3ZhsdIuPg0q8AwD1dyOnQnJNJNZRHE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3B6k0qhiMiMvtJ_1q_IDg90dT8khHnvqEs98Xnxx5KQ&oe=6A300EEF"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deW-XEkVx24Q7kNvwFXRu_j&_nc_oc=Adr2TVS_bP5BFo4IvvjdqEQMhYFPlZVrTZahbd4DGQsXUgootUS7dexHc-w2qGML4Uo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wtx6iN3Za-SjyNv7IVaj2BI25sR0CbxMGEQ-GKujYyg&oe=6A301054"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wurFllHRZN4Q7kNvwFxWmC4&_nc_oc=AdpRNtT8DNIm7btBdCXSPTmKD1Mx8wIOmel43W8yDiZJofX9OFCJEMxiDviaMSJM2oA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCwh3xa4q7_1Icfmeftpi99ZcHDOpxAXxubMEWMKrJpA&oe=6AFC676F"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbqfNWZ62mkQ7kNvwE6jiW9&_nc_oc=AdpB5jgA9N5s2c7dpVkqu48C35GmvLZ98XN5ZvTXezIbe642KsFHl6Jkr3mOhWjHZtA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiAEacO8lRxWmqOlmfYLToB49a8B4GwBjR2LJbaegUEg&oe=6AFC68D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25548892368111905"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "4466956600243443"}, {"status": "PUBLISHED", "id": "1566443218608661"}, {"status": "PUBLISHED", "id": "2505059246607528"}, {"status": "PUBLISHED", "id": "1916298102335820"}, {"status": "PUBLISHED", "id": "903132595414711"}, {"status": "PUBLISHED", "id": "3138670189674032"}, {"status": "PUBLISHED", "id": "1878464816188843"}]}, "baseline_offer": {"id": "1916298102335820"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795118400, "status": "PUBLISHED", "id": "4466956600243443"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25800025256331947", "version": "0.2.0"}, "id": "853500414228208", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id
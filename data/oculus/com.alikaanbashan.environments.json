-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1Jy1Pxo5WYQ7kNvwHU8Ig_&_nc_oc=Ado6_Ag5_4jam-0XLTg-V_Y7UmL8cSGqXhujK0p9dUEMITeVoGmYnbjxirzHwLCULjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzd2Q9--JDv9yUupbrKzN5YHRt5uCRZ7_SZfAQwNBF2VQ&oe=69C93935"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gV7WWYhTr0Q7kNvwFlFSzQ&_nc_oc=AdqfDwXCnhpjzW4hawTlyg1e6OaMVHGxhDFXTRzSQPSuD1PsUsipTRV5RUZVG4_PNEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwr5yXj-sYPy84IeMSDjPuNFogcK__8qK3EZCiwZgzsug&oe=69C90BB9"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFJDIH9MWHkQ7kNvwGtJN4s&_nc_oc=AdpB8TvDAbjpRWUmPXytA2ffUDUXuvmdAzij9bqlMKnVwjMUJgz1DsZYGMQk6USMxa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFnKWfSZamZ75DXe2Wza2abi8n2dKm3Q8VtMe_J7mcaA&oe=69C92B07"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO7yBH-Yx7EQ7kNvwGT511x&_nc_oc=AdqsblilDh-tCVADxC62hyEX3hBiXTw1TkMkRZmaKD804HmZCOlgUYB7xXDiS-HDFAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuiGxTQgVD7ucA1YZRLnD61eJAby62Q_Rh3EoBSepysg&oe=69C901AF"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R939M7oLGgYQ7kNvwExog04&_nc_oc=AdrExsQ5tUTk6KFMdkH8b4LpfLe61XnhaZuzZnP8DlgQck3VvpgPeSVRM9Xdont41iM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyenUT6dP_zuuEL0HFIRFBir6kkLtrWN1sxh1KXS0DS8Q&oe=69C90314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
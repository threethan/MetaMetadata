-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Nwh7yopOngQ7kNvwERcmRj&_nc_oc=Ado1vpusLr4WlCJLPqvntK6VH12DmHvL9bZybUOVV6VGf_T_NiD9F99hNEBagEW-kW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TSeCS0haTjQ_rHqLoE2qZS0WgcTC-Ptffh0cMTEH1GQ&oe=69EE2335"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLfrSon1GTMQ7kNvwFGKte4&_nc_oc=AdogfnmbkphAcaoVF6Byn2waqi56UV1EMzAHmO40CDVF3mSphI797rOe2L5Ti1LHjHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-7tUmT7eJ5CRcf-SumQfQiLLxCBvIFJAKTNrkDyavfQ&oe=69EDF5B9"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1KP0iCV9msQ7kNvwHScPLi&_nc_oc=AdrzeTrFlA85fU5AIZ1fkcoicpEPwgLDTcBgx83BOJ7gkrw6WAJSrh3XY0ej79KOySM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P8KZDYVC69E1rfwi_LH_v0FhjBPEN9e4ME_ZN8PcP9Q&oe=69EE1507"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTXQcf_sinIQ7kNvwH0RgMW&_nc_oc=Adp91FUtVNCq6wy3ivbVNKH4YvBAxe3YpAhJtTdAoZz9hPiFIJgncmrXQN9uW0ZWJLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08s57XbacBjkCoCgtjW2Ez1CRJATzcG6hZ1l1RtPGmHA&oe=69EE23EF"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiGTrIsMM-MQ7kNvwHCpALU&_nc_oc=AdrZw_eyXPyWKHIKnpibXgFXNfAqYXPCvcgWPy2v6__PGKzb55z5D3qsJNQnSsiDNeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1chn69FOjNejYFZCar5UxZSXUWJLeOYCUlbQRecBtR3w&oe=69EE2554"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
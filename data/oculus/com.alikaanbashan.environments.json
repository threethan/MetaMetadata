-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83jy6WqXZMAQ7kNvwHhjHP9&_nc_oc=AdqZsW3QOyCJwa3srBX2-IVgx0YENa_UT-bQ9a9qZ1owH9JVjwTg52EEcjhGgqtDhEw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3c2XSd5i6VQHa3YStBa-eyr20LRSoR9gx0JfuLIWFYOQ&oe=69F36935"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kxP_XBnXnoQ7kNvwFu9D61&_nc_oc=Adop4ks8XvmPSh1R7odN6v1BBluZkDw49rqAO8ugpqr6RMtZdvrG02v5pi-IfT5lG_c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SKTHNIvzY9o07wz7ThUattROUEN-ohQY_96kN-Ha8Ag&oe=69F373F9"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbo-rAAtDC0Q7kNvwEsdyaR&_nc_oc=Adp62T3AzcBwvCExj78azmJzo_BsRl403SpHkgb1yn0J-qWUaNPZ1wmHcV_p_5qA3Bk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_GY_ahWm_Z78Kbdj4-rKJEAzMbEU0PNmeZZqoWCs5VQ&oe=69F35B07"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Sx3bwvNXasQ7kNvwEVgOeu&_nc_oc=AdqzD_FM25VTeD_zhRt1DhkAadvjjtm8dpTZP60wI3LCHqqAD9KZOV0veO5_-JfOqK0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eW1SeiJa2azv6W8D-LZOulLUXQgUx87x_WBZhPqP47Q&oe=69F369EF"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eALWswjM0wQ7kNvwHdwMDA&_nc_oc=AdrceXeE8-Y8LaLuXV1INBp21-hCBgrgUdIKK_ckivzuq-dEVZOr3ynWExD2KHNpLXQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QVN3X6XWs0XTpPXASRyZkier2htL1kLmozsREuubEJw&oe=69F36B54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
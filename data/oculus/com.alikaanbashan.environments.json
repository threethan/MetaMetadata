-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmgJfWfFq1IQ7kNvwEeFWxa&_nc_oc=AdpeO59cArMTSydKTIerKRsn2u3F1nK9uaORZFBKEn0YVcOAcKIH1LIW9MpmB6T15-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOFbrmoUzWxNZIEr0pyNuEFk6_9YQd9UagBEKcjZciHA&oe=6A4BBDB5"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTkee3aAcP4Q7kNvwE_ppNC&_nc_oc=Adr_ymPmJXv96mxOosdGfOl0he-ehTrTWrgTkwA8exdoIx9goQosnujL-LYZEOac9-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwh4oRNQ6yqvhUB8kt0257dAd5ZqbYqY2m5ASRXFOttw&oe=6A4BC879"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA2W50TntQ0Q7kNvwE0_CJG&_nc_oc=Ado8Y1E-tEUcsU1wX-uQrBlqgRhI-Qppb9e97Jj8CYMimoU6mskIdOYL7JEYZyxeUOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD00q1FZIS81aDscruP3xyXk5nwhBqgTlJ_QwRn6dL9Q&oe=6A4BAF87"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJy3Vu91YJkQ7kNvwFQFcVM&_nc_oc=AdrvGqXPXYafS97DrScmHguITWzV4NZnhuA9PvbADSUVXcXe9-HglDyCZOIBun15okQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATut4GOtnh2X-szh6OelsinRaFTENpOparKGpkPb4L7A&oe=6A4BBE6F"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3R8fFj6L3gQ7kNvwFg1sYc&_nc_oc=AdrfsEbsgoRmom0hhNCMbLwfvOaPEgG8a135slWAPy1WbwuctgIvsqRos22OMBKIWs4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHzG_2TENkuXzQAq-RK9CNdazHzgDH-4nvaHhs4PInLA&oe=6A4BBFD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X2M-P1HhG0Q7kNvwEW0ciG&_nc_oc=Ado24PaaGUTYwOV9gLEDqw3S9Kw3zICvpBVcKP-6Vegeazqn339-fF1gzH5b-PQPRWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX9ccstYkAA3YgFA52hsJdKbwWRnC4PBeB18LPVLOLoQ&oe=69D12235"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmK09CRaMecQ7kNvwEskZBe&_nc_oc=AdqMJ2LUdsAdjkAXQ1oxG1V3tlI_goTwB24kUYMKGgRP5hLrjtcEphK5xjxYJMitPNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGsfmej7JuNaxzN-WyxBeD2GLmrW9UuF5BDkoY8Xda2Q&oe=69D0F4B9"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvB4fgXo2tkQ7kNvwGtqfco&_nc_oc=Adp4HwrrYFzMx1ZDhX_bzE4URQlGdnPzczYxXoWnjiDuXNIguzu_YD6Sffq1IwgMv6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0JhEKCU6BHSsn4rG-ESuVWYvof7t2fRgE7Ngwp6bjgQ&oe=69D11407"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvjV8WM7GRwQ7kNvwGxIqdp&_nc_oc=AdrBJOUhDYIzEybF_OdbJaCX-rVD1poVNxPAROTCIp5wRWl19y5HaHlFV1jLyInKoqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEgVZ_5RRZJ66zhF7u3NBIxpl_MLpJjCBTPquX8vTVkQ&oe=69D122EF"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqUIYNVzeGEQ7kNvwHP02sR&_nc_oc=AdqqOJ8blR6FYtVsLWPq72zVsbpckzTvDf-TlJDpEOeUbgBFGh4yyWFsro2rp_zn8Z8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaOZy74Bv0FiVChXcGoSonJTiX4AX8lXPMb9e_j6LcOg&oe=69D12454"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
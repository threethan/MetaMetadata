-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGz06lO5J3IQ7kNvwE6CRl1&_nc_oc=AdqhzF8WkqBU8fUFnsU44eLyrIbuEqAfaOBW9n2fiKBJu7oYvlXs6r3Mnv6dVc51n5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iVDiDpbSwayYrrisHACIkEuu8nKOqfjZ4fMcJVGhWtg&oe=6A47C935"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBanNvctgwIQ7kNvwGKzgms&_nc_oc=AdqYYfWf4NJdaNo50QYQu7v0iUvubE8YPREwD3nqjjk-rH_8YegZhiegmtxPtG8NolE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e995D4YXbaFdhg8FKwWEahXR2zwdyFkxgE1CpW3ctwQ&oe=6A47D3F9"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2w6EjpEDEoQ7kNvwH2GUis&_nc_oc=AdpkTPi0Y4p_0I5s4soMnQsD3dCRmLzh7mDRajceITgj0531EqAWNYy08OGttjMNCBI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vSn2Kb7pNbaxcb_Tzdt_n7yhD07nM9zBp54qEbNyVwg&oe=6A47BB07"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J4xZylvXrYQ7kNvwFcSrBL&_nc_oc=AdoUutz1x2AE48ZvIUDQdkuG4UhtbeivFaFkCvUgv7ue71VMSKq9_cABzDRFPGrnCAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9cDb22YOiPyg-osxdfGQglHDUyvIpYRgIIXsmEYK2kQ&oe=6A47C9EF"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_B57QZVCVYQ7kNvwGej4Sy&_nc_oc=AdrCXcvJ08O4pLL1EZc6X0NuRlgEy_EJjZ5c8r26D5LB56NR_T0wi_h3ZbmMzCRE8w8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NXMNFGFKVGykWPbcczg4TcyncrmBFvI_lMTeRiT11Bg&oe=6A47CB54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
-25/491823949_1214968650002678_7740963525614649503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X2M-P1HhG0Q7kNvwGdwZaG&_nc_oc=Ado1pnktPyMWi8BuslV7YrHvyoZuGPQFtc6ypL8IP29YXaONEKWThRcGg4--GEw6pak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxrMKqmRLgdhjO7QFRa7vPzrFIH7Ls_pNTskjwZxhApg&oe=69CE7F35"}, {"file_name": "Screenshot_2.png", "id": "1377712270189525", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1377712273522858_602215956649155343_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM5ttTN_eqQQ7kNvwEXBryO&_nc_oc=Adok3occfEUPk46olXaHPjdbEPmQtp_VB2vzhuVTvqo-btdcI-EpR1Ll6Gk0eChmbzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQZsRHsj-VxBFyeXgCCXYiUlz4KGclOn4DAQUpvegrew&oe=69CE51B9"}, {"file_name": "Screenshot_1.png", "id": "4169468136638677", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821782_4169468139972010_1473385883316776083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvB4fgXo2tkQ7kNvwFg4Mpb&_nc_oc=AdqGorO0FvID2hx1YHvhASsJ1QyKr9-n9WqKZt9jUAHOIw8_tK7UwMNfww46ewHtYxw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBwjG1ZKi_j3ZFZ7cQHX72LCI1KwqjI7qhTmoJXLStqA&oe=69CE7107"}, {"file_name": "3.png", "id": "1417116919764987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_1417116923098320_3750281596481782431_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR46RKHeJG4Q7kNvwE1z_Ww&_nc_oc=AdoJ0rJxzpOL2uatHGcXf8CTXRUpMnXNCuqmidijrSfOSCzz63KaHvuh7QtH59rXRSw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfM6UVxABzDDh-V0M043mJ8vSg4Ly7hvHKO0DMn1qMpQ&oe=69CE7FEF"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqUIYNVzeGEQ7kNvwGqGceJ&_nc_oc=AdqGa1q9_siVudLaaVLlDiYuwI2IiH2K5EVBayGSLRxC5L1GDAOqInyluicRIYgfPC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRgZ7Z59cdcoO4DCF03PLQ7IjCOZgMgDcYvWKPhmh1lQ&oe=69CE8154"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
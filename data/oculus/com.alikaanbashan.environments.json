p1T7bhVUwhtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7lBASekRe6mHbwFwt6mBwL221V3SGd5kqQLmOoe0k1w&oe=6AF47E6F"}, {"file_name": "2.png", "id": "2251815738659859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_2251815741993192_7524767442872055140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLEU6JCDg18Q7kNvwEU0dRb&_nc_oc=AdouAgjMM0lAz5RVG6dNmH2ZkDdThgKUPYSPgLm_m_lqF7LDdiYIMfrsxHSx7eQSd50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOhRfMZ6RPjxjrE-RauH2v38Qf5UPgwI71faekr4t_Ag&oe=6AF47FD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Scan Explorer: VR Environments", "keywords": ["photogrammetry", "photoreal", "exploration", "walkthrough", "architecture"], "long_description": "Step into photoreal, real-world spaces captured with 3D scanning (photogrammetry). 3D Scan Explorer: VR Environments is a simple, comfort-friendly VR experience focused on exploring detailed environments\u2014walk around, look closely at surfaces, architecture, and lighting, and enjoy the feeling of being there.\n\nFeatures\n\nExplore multiple high-detail 3D-scanned environments\n\nComfortable locomotion with teleport movement for easy navigation\n\nDesigned for relaxed exploration: no combat, no timers\u2014just discovery\n\nGreat for showcasing \u201cpresence\u201d and photoreal detail in VR\n\nMore content planned: after the experience reaches 100 purchases, additional 3D-scanned environments will be added through updates.\n\nPut on your headset, pick a scene, and start exploring.", "short_description": "Explore photoreal 3D-scanned environments in VR. Walk around with teleport locomotion, take in the details, and discover real-world spaces like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/3_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url
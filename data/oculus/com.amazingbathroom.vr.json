op a video so that just the picture hangs beside the landscape. You can stay seated and change worlds with the page still open.\n\nThe interface is primarily in Simplified Chinese. Online video availability depends on the website, region and playback support.", "short_description": "Take a seat beneath the northern lights, on the Moon or above a city street. Explore fourteen open-air worlds, then float a browser beside the scenery and size a video to fit your view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xmaillc.com/vr-amazing-bathroom-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XM LLC", "support_website_url": null, "website_url": "https://www.xmaillc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1494229947102681"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1131572242933895"}]}, "baseline_offer": {"id": "1131572242933895"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795455600, "status": "PUBLISHED", "id": "1131572242933895"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1494411840417825", "version": "0.7.0"}, "id": "40133307522982420", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBi
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNGaVK537h0Q7kNvwEyaDSw&_nc_oc=AdraZ5HNe-aPhYaQuqZ4IU_urxoAvbqwNc4MyxMyk3aogP0Ey5DlB7h_9OLFb41mY4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxKsj3Ru-Gdvm9ICZ_GeZZxiXMcviNuuRYLtZqcLhkQA&oe=6A5F6F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "8739050696158476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982463_8739050706158475_2005460528317087778_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urdYXN3PelUQ7kNvwGWpy2t&_nc_oc=AdoDwOZ6NigUNEoIgz3GBWVJ1ab3DY_ChdwgJQPRWKtLWMV8kivxmTmReERQFnBgSFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYPeoATP9Eq6uWil_9bd3PSCEIwzeUvwjZj1Tmax9CmQ&oe=6A5F5758"}, "display_name": "Cube Jumper VR", "keywords": ["platformer", "shooting", "action", "adventure"], "long_description": "Cube Jumper VR\n\nStep into the immersive, cube-filled world of Cube Jumper VR, where one wrong step could send you plunging into lethal lava! Designed for VR, this fast-paced platformer challenges your reflexes and agility as you jump, collect pickups, and survive increasingly difficult levels\u2014all in a stunning, 3D virtual reality environment. Collecting diamonds and shooting targets not only helps you progress to the next level but also earns you valuable points. These points contribute to your ranking on the global leaderboard, adding a competitive edge to your gameplay.\n\nGame Modes:\n\n    \u2022 Free Play: Explore the cube world at your own pace, collect pickups, and master your jumping skills.\n\n    \u2022 Time Attack: Race against the clock for the fastest time while navigating tricky levels and avoiding dangerous falls.\n\n    \u2022 Shooter: Grab your weapon and take on hostile NPCs like spiders and drones. Shoot down targets while keeping yourself above the lava.\n\nKey Features:\n\n    \u2022 Immersive VR Gameplay: Experience platforming like never before in full 3D, where every jump and fall feels real.\n\n    \u2022 Pickups and Power-ups: Collect diamonds and resources to enhance your abilities and score higher.\n\n    \u2022 Three Game Modes: Free Play for exploration, Time Attack for speedrunners, and Shooter for those who love action-packed combat.\n\n    \u2022 Intense Combat: In Shooter mode, defend yourself against a variety of enemies, avoid traps, and shoot at targets to complete levels.\n\nGet ready to jump into action!", "short_description": "[b]Cube Jumper[/b] is a fast-paced, immersive VR platformer where you leap across a world of cubes, avoiding deadly lava. Collect diamonds and resources while mastering the game modes: Free Play, Time Attack, and Shooter, where you fend off enemies like spiders and drones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixart.games/index.php/policy/", "developer_terms_of_service_url": "https://pixart.games/index.php/policy/", "publisher_name": "Pixart Games", "support_website_url": "https://pixart.games/", "website_url": "https://pixart.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8926586694042148"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1915959329031301"}, {"status": "PUBLISHED", "id": "1670452811047891"}, {"status": "PUBLISHED", "id": "1331562228263172"}, {"status": "PUBLISHED", "
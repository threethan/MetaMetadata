=6e7a0a&_nc_ohc=EPgwADtMh_sQ7kNvwExKf2T&_nc_oc=AdpK_HO1AIq6mJWjauB-y4oafLzYJPdzN22eANICuKdzge5tVXE2zOBO3B6DMGEum1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6OXQ4_gsQ2AMpz_Q5-TvJJhTStPVhZNQJl5byn_L4vA&oe=6B047BB8"}, {"file_name": "sc5.png", "id": "1779383302883466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568680_1779383309550132_492969080114956020_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpeYY9RzLwcQ7kNvwGTiWX2&_nc_oc=Adrnh9KJmsnlB7BdchsDjGLk9SFp0lRXTtMz9Z9l-2EQ341__nh6GpwLF7tffX7ZB_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_q4PKldCK-rNa2dvdcpwF78FkYwWctijx_XaDnjVITw&oe=6B04732D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "8739050696158476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982463_8739050706158475_2005460528317087778_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xCcxG2guLYQ7kNvwEgvasY&_nc_oc=AdqT3KOpsEt18WEIWRXTkD8d4wDzHB_YzYyJeNAtM94rG1uh6h6wRIrT3VkH59Ahc04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc0latamngMUNLArdSWvOkyVOuoeEWmj5oKbxMdwr19A&oe=6B045B18"}, "display_name": "Cube Jumper VR", "keywords": ["platformer", "shooting", "action", "adventure"], "long_description": "Cube Jumper VR\n\nStep into the immersive, cube-filled world of Cube Jumper VR, where one wrong step could send you plunging into lethal lava! Designed for VR, this fast-paced platformer challenges your reflexes and agility as you jump, collect pickups, and survive increasingly difficult levels\u2014all in a stunning, 3D virtual reality environment. Collecting diamonds and shooting targets not only helps you progress to the next level but also earns you valuable points. These points contribute to your ranking on the global leaderboard, adding a competitive edge to your gameplay.\n\nGame Modes:\n\n    \u2022 Free Play: Explore the cube world at your own pace, collect pickups, and master your jumping skills.\n\n    \u2022 Time Attack: Race against the clock for the fastest time while navigating tricky levels and avoiding dangerous falls.\n\n    \u2022 Shooter: Grab your weapon and take on hostile NPCs like spiders and drones. Shoot down targets while keeping yourself above the lava.\n\nKey Features:\n\n    \u2022 Immersive VR Gameplay: Experience platforming like never before in full 3D, where every jump and fall feels real.\n\n    \u2022 Pickups and Power-ups: Collect diamonds and resources to enhance your abilities and score higher.\n\n    \u2022 Three Game Modes: Free Play for exploration, Time Attack for speedrunners, and Shooter for those who love action-packed combat.\n\n    \u2022 Intense Combat: In Shooter mode, defend yourself against a variety of enemies, avoid traps, and shoot at targets to complete levels.\n\nGet ready to jump into action!", "short_description": "[b]Cube Jumper[/b] is a fast-paced, immersive VR platformer where you leap across a world of cubes, avoiding deadly lava. Collect diamonds and resources while mastering the game modes: Free Play, Time Attack, and Shooter, where you fend off enemies like spiders and drones."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixart.games/index.php/policy/", "developer_terms_of_service_url": "https://pixart.games/index.php/policy/", "publisher_name": "Pixart Games", "support_website_url": "https://pixart.games/", "website_url": "https://pixart.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
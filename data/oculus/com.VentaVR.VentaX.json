?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHy1ie6DygQ7kNvwGhvsQJ&_nc_oc=AdmbqHFqBOSgAfjPX6TNm_SIsEFw5HJlqVcZuEOMMWT0wvgCki-KuPFasJI8_RTjnII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQrJtFmm0beXw1-1BuwC8MRYhQZwfG-F8uAE6QlKk44Q&oe=69A2D066"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf2RNBiGMIYQ7kNvwGsPvBH&_nc_oc=AdlC3I11i8kZUWXMIbQr0dyMmJNW1Y35zI5RXjwFT3iYLMv6e2EnqXdoazWbeSSK8c0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsynWPJG0JERRe_VO1dEz3b32NEobgo4esU6HGxff8XBg&oe=69A2CB4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe2WUux8Q6MQ7kNvwEIxhFD&_nc_oc=AdkOO0F5mGQXG4mkMtfR1ByBzXWlDRbE6ejWc_jSg4JSQAJlajHRaSzJzkAsCDr2bS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftE-n80Sn2WUmK6FKOW2Esbj02Nd_mYUl179GCGSEJZvg&oe=69A2FBD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PaoX7US52MQ7kNvwE7kqku&_nc_oc=AdlgulWybOqxl0lh3tAsA3fcYUfhcsi1d9e3BdKgW0NUjbvMZfY4sdV1-EsQn86w4y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft39Ox54g0XI5D2Q_QeZLP7AqMRTPmx-Rgbrgx3x_iGZw&oe=69A2ECCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBJRv39v_2wQ7kNvwE_-CnH&_nc_oc=AdlIeSawObE57GckQzBA1koKJR5ShZns2c2XQ98BhAXiiGmjGla1SdWt3BDp1y9qxTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsesk48UYliQRypFdJOErgd0minlqidz3pTlO0coE0d-g&oe=69A2C99D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4FN5_9Nl-MQ7kNvwEF_hr7&_nc_oc=AdlyAmyEUYMmUwd4Cr0UKp49YcSnP9Vzuq3_C43utRd04SEnJyMk26E3hgickq5SNrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afufa7edvaX1jZnDyO3Mvu1-tPDkq23XI0rZwe1KWzbs4A&oe=69A2CDA0"}, {"file_name": "01_Hero.png", "id": "1082791666697111", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556807_1082791670030444_1
2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1EkWJiPF8kQ7kNvwEFi5Xj&_nc_oc=AdoHwkKH-FUMt1Gty5uBeSzRBrlCOLYgpAYgLRskJ3Q_MH6wQ1oBt8s2AS2oHZbZXCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Rr14-MuH21vJM6ToZ_GVR4Z2nkZtXK3KKy8LOFHLVw&oe=6AC11E26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYEdImsxGpEQ7kNvwEI2gL9&_nc_oc=AdrcO_t5Rqlb0ZBDS6S1-7EqK1FtrIMGFy9FLCpzORK8YQekJSAAmwJU7qAnejEvV1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPe-jJbYqpsLHPE56r1U9tjqzp-SDdkByDVS5Es1ypMg&oe=6AC1190B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmDDJLPGxx8Q7kNvwE1Kfhu&_nc_oc=AdouK0nElcSQxVJSmKD2PiMbM5_W75AEw9LUKpye-QUEi3Mf8wGbtd1W3wB9C5GReIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpaoXcL3OHfLTaF0L6VfBpoeN12U7JwlkBlmBM3r2dXw&oe=6AC11153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBfkvtdMv-8Q7kNvwGGgFZN&_nc_oc=AdobR36FxxnU2hBUOhDjci5S-vVblGyM9aFvh48fSktnLYl7w3BCcFk5GzjDGZc35qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRKn2KdIzl_RERDjasuzfabEY803pC6FZ67e-8MuM0ZQ&oe=6AC1024F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msbaMzoOS5AQ7kNvwEJZQXh&_nc_oc=AdoJkZ4Xf6aFo_TH7JUZkFADI4vRpqyRYHLESaP2vLBT-DUMxTcxt-AVhS6NmtCUbe8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrFWuFqXa0yy3SCdzo0vy5A0A_LF3M0bqM_-YKx0jr_A&oe=6AC1175D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aetHKKcam1QQ7kNvwH3e66X&_nc_oc=AdoeZ0VZVqW_NwSrOhyIRsN8NEY-99sWe-SkHgBBAj5GlsywZFQm0A2Km6c3lFlHytM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS2Tv65MOCIqDiwC_BwaTR73miWwrn2w4Z90f
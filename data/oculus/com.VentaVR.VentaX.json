-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9O-I_BZhYcQ7kNvwFZmkO0&_nc_oc=AdkGpoOqxvP0hp60EKnHRGC6fXI2E6sHj8WKALRaQJsBiLGb2Z5LT-x-ZIcIFMhJbRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwC043mmK7q1yFwblZ0X4vUakqleQkFm0k6REqt-G6GcA&oe=69BE7FE6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ8QEheV6rEQ7kNvwEVcjkl&_nc_oc=Adk22L74Z6p3vE_fCNug62ZIQkHlkME-Z-SQNhqrIGB-E-AKEO_tAhAT-ve5YBxpvIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuaKcfxees1QxQIDEv7hqV12l8dul3PpRufIRsqY7yPw&oe=69BE7ACB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-vYXjRZNoMQ7kNvwG1kSYw&_nc_oc=Adn3upgJ34-cQyAAcyVVxCMMqqi56YMz7KNZ-OPdTfwqtchKqAnxKPo9S-mp8XUYEYo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPKFKp-8CWK9h7FfHSFWOtUNFhoDZUiIvaaBL4H3D6FA&oe=69BEAB53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkE_bDlTeQcQ7kNvwFQrJwB&_nc_oc=AdlQJCTnvbAQtFqUmz8IidX6dAPKnHSAH3DPMwwNKdL0Kf8x057VY6NTOkaIiWr33T4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfSpmDeaBB6hMCzrmjgs8rsgt7IvQ0M1fxAYWjF0fPPw&oe=69BE9C4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFeCpyRIp6oQ7kNvwERCxhC&_nc_oc=AdlZsna2BqwF9K0q11k-emIwXR-fnDJR_VpBlit06sX8VoaDZVAuQAa9lYD3d07SoSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwX_v-xclG4XybgLZbTwAenuRbMZZkEad5QN5TvBnG-Vw&oe=69BE791D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rTHwe-o-MgQ7kNvwFCZA6G&_nc_oc=AdmyJ0mANKIHeM_PLMfkfpBIjZs7cKOwb-yHWNA506agB1fARZceb7pJsy6CofzlFlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-uavR-ca_txF6y6X6I5eCuSEAuDsr8Kijm_oTxYSL7Q&oe=69BE7D20"}, {"file_name": "01_Hero.png", "id": "1
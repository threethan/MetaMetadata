?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFFSx2rP9yEQ7kNvwF91gsV&_nc_oc=AdlvhvPhLuLXhg2uKj72nbEePz-g9LM0x35b9AVq1mDz0_z4dDJ4HU_NBfuJ7WVAUJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-2NvgHjk28SI7vKTIa8o0wuFDv3vglgH9U04lSBYDSg&oe=699995E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2JUD1pauwIQ7kNvwGVDS1s&_nc_oc=AdktncEzdNhKTKdM7I8t9BQzW3qtUjdanQCWqgnn7WuAFuu0eTmBFKTm4sIcfg39azE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsdTCzNcTGx_AaiOircUwhPJbGedgZudygAl7IcsRlogw&oe=699990CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq5xczBpIsAQ7kNvwGQSh1A&_nc_oc=AdmqpLh3eADrfMjB0q9Nbml4AfuNchEAK5XvCsY6MQhOrBZ_yOdWl_lq3erkyLxI6nI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuY436H36ouEvdcKaXliqfaAxv3083GJg1jEzVMW0WOaw&oe=6999C153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqrPxH5W8EcQ7kNvwFYru2j&_nc_oc=AdlU9cPJz95Vao8V9kogZFrmPrSf4W4BMomfI92uizpLGRGWKNNiKJIfNgN1X8OQo9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsfb6zlS3RjVGeBPXYwtnLlvAlNRaDSYtnGp5BifaGCKg&oe=6999B24F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcQNhKdugT4Q7kNvwE-oB68&_nc_oc=Adkabxb8EqpJ9mIlxi-2dPoa7RtZPheBaNLfAjf4wC--QqVGDjLluS2zhQcik9IzlgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5BGSXBK2DATU8kQSZ4Mjdbw6QLFBJelZ-eHGyQeCiIg&oe=69998F1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BfwXT1Z6E4Q7kNvwHPGqGL&_nc_oc=AdkHtFn8LlRR5oJmT8JBDD7pUUslCC50J-UkdfdbMka48jaoMKpoAOAgSceMTkxG3Pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXWquR08khnLJmAdZoP0O9S-hC8r8TSq7G_Bx0PZjrPQ&oe=69999320"}, {"file_name": "01_Hero.png", "id": "1082791666697111", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556807_1082791670030444_1
2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1rQFtQnOgUQ7kNvwFfZCPy&_nc_oc=AdqnoxbSIlLNRiQaTyXFl4U1WLxaU_h4GQkzrOKDf8R4QzJPvxUna0WYxxl9HhU4DjQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QWsGD5qRvNJ50_QupCp1HWNCGGhKMGgLJPLuz1dRsxQ&oe=6A340DA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HiAfLSWc2YQ7kNvwHzcsJ8&_nc_oc=AdqD0OcV7utgXwVMYeUai0sgVQpDq8JpmMTIKpNn_YflsP9Lhp3oFIwDDceTJ5AEB_A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MsWxqIZA6ZAI-Ogdy5EQm5vOPkvTMuJECgphgdNKU1g&oe=6A34088B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eru3rPtILDIQ7kNvwFBLl2Y&_nc_oc=AdoGcMAsCrwSme-VgP7jnQUojS23_mzRencWfJ3LFXkWfEpy6EBF32WZSw9gWefPHWQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D2Ei0wfwQvsDmzrGTyJkfp8CBLnzU-jqiEWDctjuOlQ&oe=6A3400D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmIHTcxMQbAQ7kNvwH-M_Fq&_nc_oc=AdqBFkLbYpOWX759_i8UN9caJWy-KXTOo0cadN7n9-pwKbKWtSHckNEKZJUShPw71TU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jy6lBAXqmAui6_7l87AiRojcvr2n9vXsbt_ooDo8tjQ&oe=6A33F1CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iPC3y4HGkQQ7kNvwE_o04c&_nc_oc=AdrJI2HAlF2kUbThoheP-PgLd6EdQo-jzM6MQEzFQxg9_pTwdSXJTeT_3ojrorThqWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RdV2TpPFZ4nZm-UjYoXVxrViP4uiKnrtyXmDCYpBIJg&oe=6A3406DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-xAvutneZwQ7kNvwHj95fT&_nc_oc=AdoYB06atkXeVhJeBfWCf8MzGGzjdpLb-fNWt1pw7zphAGJ9TKtm5ozHzfrRfcpfSA8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qF5C5gmyxB8VQLj2qXWqDx7QpD_XYWIOM84e
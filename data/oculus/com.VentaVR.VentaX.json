2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NeLyWDuYckQ7kNvwEFIlYN&_nc_oc=AdqTq_wOauDjItPL_vd8x1HdNWmMBcpGsWL16W8juUYeekL85INcNVLwz0XtLugraXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw15DNRqjGP7bsJ37wR6Qc2-PGq1MpnuOnP3ilkmZf3A&oe=6A6B6CA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrvpmF_-274Q7kNvwHDrJZT&_nc_oc=AdpDEagq9bvbVCCamCkjlX799LHkpf4fcOB9436UDWU-WQizHQEl19DMcRfoZjqwUVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy4THAX26Ng-llEuZ_Jo02ic1WT09Py3gsd-yAiFbbrA&oe=6A6B678B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YITqO7IBEtkQ7kNvwEKWQsd&_nc_oc=AdpN0Kx8AFCh3NqBOYoP9_re6SPggOfSxylJSy1X3fG8MODiUdSwjVMAEmBptjWWj2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6kp4J9bIuTAn4PnRS9Vu7ppqRHVb90xvMa2eTQZtuSQ&oe=6A6B5FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKOOeSHW1D0Q7kNvwH6HiN8&_nc_oc=Adphm82GH5_iu2Hris-dYOV1xPdPTCne-EVJMujisods3iGzX_kcb68onAdgMZAyS4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEwMFtyoMK9QQQZ0EAj9oVjLogeO3c-YJu2OAIjhXuVA&oe=6A6B50CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv5sE2tDeckQ7kNvwG1FhCD&_nc_oc=Adrda2iKmgPQtpZXqoX3SnHTZIHPp2SFoJ_agyU7-ahsYY4-K3fSulB_aaBQIQpOTsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWLbrvXkcUykcIPdhXmO5IXsv9cn2EYjMnuHO2s5NY2g&oe=6A6B65DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waA0Ca4LLBgQ7kNvwFYVr7u&_nc_oc=Adq8Qew9VZtuQWRnMWFNki-_e1jOzlUw4K4v0ZB0lkXi2TcvKsNX0UYuPuG_0p3G84c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnzNPAnffB7j50CJZMhOeRh67m62mph-1yFVX
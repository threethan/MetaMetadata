2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNQBBgiirf8Q7kNvwFrPjVv&_nc_oc=Adrr0VDnlf8TKoReGNKLhuPIgFwRFzmKTER1ethNwrUCWXMIs16Ahf9mU669PxO24iU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-72vQ4ck28uLO8MGL4lluWFyb6MoOTOZjwvb5fCbY7KA&oe=6A301926"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vHUNhOfyuQQ7kNvwHOjbg-&_nc_oc=AdoRhJxdlYtCDaD1BEzz1eXXqlCuGVSAlKMlPiTUjqCtdw6E5KUt7rz4upiHncsVnD0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CUf-UMXnVZPuXT8AxwPup_HZFGj6O_yhk6CNFsP4bQg&oe=6A30140B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-l20Ko4yewQ7kNvwEpBhP7&_nc_oc=AdrY8dC6qjYISNYPSF_W6WYkGdN1lIV2tf76wAkqJEA33Ttn2aeZnAKuwX0KHt5ZBNA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ICvDBpXnoZc8MShO8zC1qhjtSf2FxzXn3Jrv2hTU8dA&oe=6A300C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U2W9pTt1zoQ7kNvwElOeEU&_nc_oc=AdoyftgK5Pftzi3CWheJw14eBEQx4sqJZs5vVcRt_L_hAjZIe6wxIivVg22Jvx7maVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wWoNZ8HFlV_Qj689X21Iv5GX7xClZrJRSXQs0h6BGJQ&oe=6A2FFD4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LF2KiOKFby8Q7kNvwEnYedO&_nc_oc=Adp82EkRNjYxAGzBsdVjtQu2IpJaCR1b9i5ZbhxDZorh__wdE59jsbfBpVEwwBLd0Rw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89k0z1jAHETcyy2KizXWgoLEjm4xFKvtPbfPb2WFA_pQ&oe=6A30125D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4dZ8_K55Z0Q7kNvwGSw4rc&_nc_oc=AdqaUsiNGHiZlIsR6gDlRq3Ur0RAENSiiUewOMptxSsMxRJXnSXAUI2_FUCfie_ErzI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2zNe4iLmWVO6XiK9hYy0YjqiJEVsV4supzIK
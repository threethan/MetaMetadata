2063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NeLyWDuYckQ7kNvwEDeAzm&_nc_oc=AdpWHtPQIaRwVe7wzxvDj9teofR2TrJd9M7oOj-T2A3CJezwwSLcOqaDMFGjPHVX5I4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA76Ddm8QGfj0mpQQj1taIcyZ0B99Zc9Q_Tq_4jfPNpmw&oe=6A689166"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyN1f71J1bcQ7kNvwHqWila&_nc_oc=Adp6X6g3ID354TvrI29-2mmF6dUD-HE2BSBq5WJZ7BQ2PRsPFnCluqnRDCwAXloyWiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZEXYomJsQY0Vd0qrPew1aAmpksScwMyY4c7FK9KRxcg&oe=6A68C48B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP3_rOQ7DncQ7kNvwFy43Q6&_nc_oc=Adp31POzsQrQY0TgAragSrY9HLk4lI7qjY_0vCAqFKOni6aAfKbajLCfFI2H7oiS6q4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzxiBF3KEC68O5UIUzkUiKkVM6QgaOrgcUud3iIIFKwA&oe=6A68BCD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oZiKECb5E0Q7kNvwGttLbi&_nc_oc=Adpas9c9HZ1vfKHzZNvoSoXgtg-8K7qIz4ftJWE-t0a9dsad729Pb9qMNvBKpZKNWqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt1Gr52jXIrLB7DX6V8yHrjou_poh0qiL3WlJBKH2bZQ&oe=6A68ADCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv5sE2tDeckQ7kNvwHIV_cK&_nc_oc=AdrIfEraZU06SUBXXq3g5PMI-mu1adPKkLsuoB1T7ivSaSvRjMzpm1_7-qk1obeK6aA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoBPKlUptd0nHCb4ZzFyW9FdFn-VpcvTR77mn2GEB3_A&oe=6A68C2DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waA0Ca4LLBgQ7kNvwEs9lmU&_nc_oc=AdoTtlrNPE82bMfT7KzN1nn6dTKCaph7haTyR4gkgccfBoVph5vYSzTprYV-Dm5Awg8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9V8EDsfwveMh_G7yIpH8kKZytxcbUFK2a13W
2063", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7As8soWq75AQ7kNvwFdB970&_nc_oc=AdoTd-4u4hMBsVGWX58NuLDlyFPJdrmFyZKYX8it7JSqp_b0wwYrtyXtHPlkR3Aljek&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkFHWtTtv-9L_ZYD2fnjVYCWJf_iAGsozzjiLOklxisA&oe=6A9412E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3bxdr4yZCMQ7kNvwFLtQQg&_nc_oc=AdoV7Ka9wFV9MBJK50dBxSDoiLn3rwfX33J1BLMmOVAUCV_2CZ-S_S2RQ94Kp1NvKJQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9vYadE1rk6petJSBtC1l_U0l9DvB2nZKJSSbh_ZAn7A&oe=6A940DCB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLbunY6X-IMQ7kNvwG3yeTb&_nc_oc=AdqdgDpGcfX6hXQsg1qyjrg96Z1s5QvceUSwH1SenMIfU5YwWbVlpzgr2O3RtpKt-Ak&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtNWHlqRjx_vglv8F9PlhXHSnynKpUUX-vFCMNxBCGGg&oe=6A940613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT_RvW7NvOgQ7kNvwGZmXvg&_nc_oc=AdrQfRqB7GBwigUdUZQsK3tgfMHTo46W0HuTcFQPc-rVNLzstnv_7kYjn3SnmqxrrMw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUDgM4uwP7Vg1H67e3JXFcF6-2o6JqMG0mEYgvDEqUbg&oe=6A942F4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0hf-O0ywN8Q7kNvwFtB603&_nc_oc=AdqrI7EJ3l10QfVZfF4oKGi7n6lxp6jd2Yzy0Dm_hDUAUZlIzI8Nsv7B0kxZWTU8pYs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe8WnT2EbnzLd_lIkide5ob89s59mOntS17qSV4kjwHA&oe=6A940C1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUV67bSkAEIQ7kNvwHIMheN&_nc_oc=AdqXD2zze7mKZgd9V7RHeCKjPf9rA-o3KYx62mB6T6zGTmIZotMIxmP9_ZoXzXl2Qjg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQp98Abe126drpnrFfeSdZTU6kCtzZ1ESAe5D
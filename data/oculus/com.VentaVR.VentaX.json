2063", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITfbP9GhLDgQ7kNvwELjEtE&_nc_oc=AdoY58RS_LiyL8K6Yp-r0qo6Y211XI9_whFkClro7N_c5GfY03p-8yGod1_VxgfBxtM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0v3Z3fFzSwNhaR-nEdkGZgYzXkW-nDVaW0ZUFSjQ8SA&oe=6AE36526"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNlS0yIPaWUQ7kNvwFQAyed&_nc_oc=AdoNPDxFKlOQPwT7ES7OrWsVtFFnAILCjTi5Ot5zMTcba4aCIxUPEQJBJfUvvzSkE4M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV7YYTvNMTR_G3Lye3csLVffFY1xhet0Npp1kiwUNdrg&oe=6AE3600B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiwgyJWa3PIQ7kNvwFITF2P&_nc_oc=AdoslCeXj8sOSJj_u6XrE2dwclP1eKyPJM6jC78mt-n2Slfqm08wWKtIqDd3c_5P2tc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3sSMHbCpGtwaUEcli2sjngMgphPMDYjWYyJ5J7LfsVg&oe=6AE35853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E95b_p6p14sQ7kNvwEuRJb6&_nc_oc=AdrvYJkdUr532IbDgXBRkARL7VU1QGod_-AL_sbtuW56sq7TTl4fC0AHFrTVB2uUrSw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfg994yBrzBM59TGJrHqi3ulJajoJ5f_AUuwwclekThQ&oe=6AE3494F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-i6CaazvlQQ7kNvwEesibL&_nc_oc=Adp3GKziNLzJFOgOldglk4YQKBX8evCPU7DncW6uwVhyph27ZUT6CcUi_CTwm8H4y-s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_MzOnL1JxeiEf_tERWwUykqUEXxXl9vZN9lYbqnBXEw&oe=6AE35E5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ry_pKhlhkQ7kNvwGaYFqj&_nc_oc=AdqhRVMt2hPTugqSSF52Gjmm2ckzffMJm7UGAwgmQnhKF6PxKqto_gZgc6V7Cg7cv08&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLD9uRO0xTynSmN8TtYwyGUef6EDm0kCtZyPn
2063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knez_dRQPqMQ7kNvwGqtnjd&_nc_oc=Adob5ZG6THxKUy3A-L7mrMK4dtuEIGxQyXvMiH8mh_qALX-40D3cbCGy424nOcOcAkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0UoSmt4hmSnClemb4cfI8p5Btam__u35sk4hEW4QVqA&oe=69C27466"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKbVRilUhNsQ7kNvwFYdJ9h&_nc_oc=AdriDQI2cxlkku3bqaPA3pCzi6y5wa6yjmfP9YPafjGsNUGOwbOty19M537qdDAMesY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5DzQPMm7jwZx6KlSpS-RtTW3A9kiN9r3X4XGvo30qCw&oe=69C26F4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGLaamadmV0Q7kNvwEMXhSY&_nc_oc=Adqd6D_okEg8f9N4yWcMhY1KgNFaP-IydX-0sT0haF8Nh79NOq34UcZUaQ06CNeQijo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjrAevSE4vwTBWWHgAkpHdlI3SyYT-c208vscH5EgE5w&oe=69C29FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfafCVXV9mEQ7kNvwGrQpst&_nc_oc=AdqH-6qpU51ztdrbaIj0oldhKn4icJenU4XvmvShqr4HKHHFeOr_ZDgQdSjXoh8kGW8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU1dJSX-zSqKipmrDyJCEHVgM1I_6Mx2LsmM07JyIw1g&oe=69C290CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yddcbd0P0EYQ7kNvwHzdOYe&_nc_oc=AdpPENpBa1Arq5OeDGHDo29Lyar_2E8G26CXa9kfg871py_bZNt9dXjlDeR6xvayvtQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG4GXch_fSwVj9datixnF2H1x-11jp63IfFvTA7lQejw&oe=69C26D9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X24gA01io7AQ7kNvwF67xli&_nc_oc=Adpr_eCQmfeyrDBsHuqtvIyaC7xAQoygjrMeXyVQGh6NLggpwvBAJBfLeh1V7yZBDr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzuH_lc3i6atiVdMAwLh-kmiTact4GebwFSvV
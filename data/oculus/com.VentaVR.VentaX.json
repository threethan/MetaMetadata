2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pd1qRH9irkQ7kNvwFsnEoT&_nc_oc=Adr2r2ICOKekstxlCJ5J_vrdbmQPMDsmub6SfU3OC6tuXkYziFeoG7EehTZ3E0_DjoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREcRYTLHUX7x-181GcON_hVXZKA-4gqe2g6YgkI7j0cA&oe=6AEF42A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VU8EwCRzlIQ7kNvwGqlq4C&_nc_oc=AdoxeGG2lFSGpS8FR3RyHbdoHiZuDEVoFwBjt3vSWaU_gdSRKu6XBLXRr0gVcPChFTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrHuJpjbihsZ2MTjStXvukJ0c6WoT7zJsxsC5jzNrnCw&oe=6AEF3D8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tXUZqioj3UQ7kNvwFzehHg&_nc_oc=AdpWYNG2QDazFAeuiiIkgiqVp5mEm7aneiVLfRYTIU-cjAWfA4MGMgGVRVJZrQPI8NI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSYyHy8sWrnS6fuyBlkYCGW9D1syMHebZjLBYjn52ySw&oe=6AEF35D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqsL6NlHN6EQ7kNvwHkoHug&_nc_oc=AdquX-jEgiLlNn3dJ0spMWvFm99EJFQq75o4kRqn4Ix9aVAeo58qk5azsExoiHave3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRvNBcKj0gFU7Hkfdo1ApM6EWHAUi2Miun_CmMUZSRpg&oe=6AEF5F0F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ITeSXchOycQ7kNvwFyDIWI&_nc_oc=AdpG40ceHwJy649kJhqd0ogP68ZBK_vfeN81sDfP45JILu_Awb85nQfcDuGnBwj1x8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8KnoMe8lRgDLvvK3LbnnzBpsPSj2DQMK_ned2WI8rWw&oe=6AEF3BDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdsYpFBrzt8Q7kNvwGP3bKj&_nc_oc=Adq7mf9rssQiag65uVKtK5a-SpxzfMQK0pMNPnn2STqQyPM3aN9M-xHKpGHAvyJ9IUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWb2TLmGYrElPmsZix8Tt9VzrHhSLroQOOAxr
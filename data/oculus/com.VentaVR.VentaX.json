2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28CVYLoT4yYQ7kNvwEfIZVu&_nc_oc=Adp8zbxcL5tRKPqF2GJ__r5MGsEZ3qCkiO5OhkFFuWbYAeDq_Jc0ExLsiztVrFwtEPA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7RATmaVK_cosaNA50j5T3h2iWc3gNNcVB4lAMUK-Inw&oe=6AA028A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZyf4i_yqCYQ7kNvwEKFsqv&_nc_oc=AdqVvqTi6AL5ZqA_M9Bl4H6kBQk56_Ma-o53ljkdQEJaGkQRFbOSyV9L6Fzw3MBiS6Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKupjNARtlswZuhzhQ9V66m25OHCcxdP8yfSTZj7YBDoA&oe=6AA0238B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5VyRAY0qO0Q7kNvwHIP0wa&_nc_oc=AdoaDYhlFO7owSbIp-Qu2OkEYd6rYy-XW65X4lkf0eZ5-SHkYpnj50Cp38lYEER0C44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR99q0utKw458z0a0MGKpYnbM4ZVQ73s7IGiAVhmyKmg&oe=6AA01BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnaCKXVJiY0Q7kNvwGjZM7b&_nc_oc=AdpVs4BvLD363TeRf192dovaua1xQYW4jh2TUaWooxz34F9_e4KtUXbVKKJw8-pxg4w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYeU3yilSSwvolIvCvvB_XGp2ls3zK76YMA52mQeXXYA&oe=6AA00CCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXnOoyE8gHoQ7kNvwG3GIuJ&_nc_oc=AdpKL6gNMD_8ur8mQ4ATqN6QtKVSooLkpuoyvlMYAnoh7AQeD2YbKhjjBeba9kjM8uQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOls9B6fLXKVgxYoPpT904QuDYhe8oUwvdYFx0J4ioog&oe=6AA021DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaCTWB1XsrYQ7kNvwE-cL4W&_nc_oc=Adoqi-mQnqS64GK6iK865uVipbesV8m_pB7hnhDnGfZ912Fmbz2dLaCIJBiSO2HWeGY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3J7Xvi6n2dP8fvc5SEfstAEl-XNZW9rc9gs2
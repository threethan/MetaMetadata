2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dGlrYHhv9wQ7kNvwHZyU6c&_nc_oc=AdqFL-eSv6t26vYDAF-LMNuZCf0_SR56yX8dimsodnwB6DKScMRRTeu5TksiQxbOZgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW2ABLLfifH64BOzY251BeFP7UgqGvZiO1smFnIsgkgQ&oe=6AF72BA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye6C9sn2g8kQ7kNvwEbeEnr&_nc_oc=AdqYgy8sUN12Js4mNcO6KOuqBOm69hS8-h2anW33RdQz3F1j1QJEN4lBEolcbg-qpfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtBy-d_pjzaYYthcxAnOzjvhjOG7MzxUQdUYZDB8jXkQ&oe=6AF7268B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwTN88J0XxEQ7kNvwF6ZYan&_nc_oc=Adqg3TabpWwpQfyYLJMNOrTIkfKj0Dibg-Hiqt8Vg-Bb3dKHB9MTYw6lTAt9l5wh260&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReZQSBLCmpem-YwDM9rVcNKrgCC2_fooTxbXjidccCtg&oe=6AF71ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUC9XgUUv5gQ7kNvwGhbufU&_nc_oc=AdqEtinCXsWQsUGo_yFt0xUq_kr8WoFE_vHr2XDL-lpzlyRI9CHF4AaLBVt2qxkqP8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFOe5NpIdJitXiVDxNL0RcqMDQ7bliZZrMkKgRssnRZQ&oe=6AF7480F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJOzAAuWOvAQ7kNvwGyGvKo&_nc_oc=AdpQQ_ytAFFSka9JHYNb5abIzrHLRkiZZsL9UjTnKF1ERWnck8ndjpDN3oK5YFuM_RI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEBQw-M0zWBA9P7T4ZwB5Fbhpf35-S5ugBZMxKaMdOYg&oe=6AF724DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0va-vceQx_YQ7kNvwEAbKhI&_nc_oc=AdoyfFM1GFIVNg4s1t2TAh0mSS335vnVqr8BjmYrxdy81p7J_cxZj5kdWq3Qu_niyt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1yplsKbyuEVTeAclvyKAKqZjQIs93AXNRhzz
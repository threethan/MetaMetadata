2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttt3MasRJc8Q7kNvwF9JM8V&_nc_oc=AdqjwPr-wFwpvXh5RJ68wyTYzOU2JwuNcRjdT_f1A5kYuBUrnnUCfHIMmPvOlAzxA-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPiKl_G1rUTbEQqHzymI4P-qxZYhf8RNsrTovhkl-CzQ&oe=69C90BE6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXm2g8rqyhIQ7kNvwESaM4-&_nc_oc=AdoLf-furp3efERAy2r55Sx7oMc6UUkX9F8CbI88TSkQAW40Lpx0BlpXBH8rIsxKWUs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnS2pwi4GAvdIsQRnCtoiSvILXI2Zh8vjCOZItMQt64w&oe=69C906CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdA91drpjNQQ7kNvwHP8XEx&_nc_oc=Adol-jemGcQnKNos7EEIwoPNUpjpWMv_Ci2v98IeZnnI3pZWg8eWz-RiB0PUru-1VIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUPG5DSB2DytOIn32J5prnhoBPvKK9LFoFEl9QPue3Ew&oe=69C93753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQkEZJD_wY4Q7kNvwHeaYUj&_nc_oc=Adpu85e0jImhc1L1Hvnf1w9mirH58Dx0t2fBZA0fzP4LSME-30BMlNPjFcCYqaEvmk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfUrWbpdcYNtWjZIucul9cSdpuOjpTTV8eaLGsr5NxRA&oe=69C9284F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEmfUbPWqPkQ7kNvwEIvrD_&_nc_oc=AdqI3Yo3gvx5tCFlXDWlsLzLyUPC5v5U9CJwYTZNN9A101WP7m3EqQUY_HmGpo1-_ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM_PSlVkF3xiAMXIVjdGYIPa_CfdF9TfP_X8nVeW0AwQ&oe=69C9051D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTlFkbjQCQgQ7kNvwH1L_uT&_nc_oc=AdoPHgIWyupKX6udSV7rFrMpELMY1I3K4q6exIKHNbSKbGFIi6o92doQPisfUEXFfIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ8CgA8MilDiKv6CgGVHqsLCXXvks7Oqd5UPX
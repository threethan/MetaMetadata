-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFEOJST6xqkQ7kNvwGg4V99&_nc_oc=Adkm74Lh9BYLYcw29gTvR_ntj1tnqElU_X1FNNM2JdCVOs67xpmM1NLyXzMz1x7h2hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0blVDgr9p9fahbQhLX3TLVtybkR7VkvQfPRcA4OmZLw&oe=69AD5C66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9538cpBcJHkQ7kNvwHO-caw&_nc_oc=AdnxlmwwW6ld-NouY_Db0xdnc4ZneaEXaTha2kyz3yOocjrVO0i-r7bX-NNQdVYFHZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcVAbzLHLUMLkiAvDjNPBVuYZpTdrMAMqnZbncayY_ww&oe=69AD574B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyTnPYFDSq4Q7kNvwG9hzLG&_nc_oc=Adlo2QAtFkpDHmigTpGW_nla8O9K09sIICMu4rZhO3znyvl0PgfpeWm65jsLxvnbnDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSQGzrfexVAjELxxr0vtoITwwoCnRl_w7k3tFtrR97Lw&oe=69AD87D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWo9ZVgjW_sQ7kNvwGRNGOu&_nc_oc=AdmugKbB5fYa4BA7S41wNuE2fIWuYOsvv7v0MnJ7m-DHbSe1i5lV8ukNN2fym_1du1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXsTWz7iEDz60x1DiszVJn7nN15wmvpF6fFGBicJY8qg&oe=69AD78CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoZkD_6IACMQ7kNvwGuEUSg&_nc_oc=Adl1hQla-2trh6DIeWR34gtRjvBIVw10E9m6h-yYDaWbYM7g9Wn_GYekOPndc_zOEK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1Z16SslBPMit0FGI2ue9zPOibAT9xqv8BWRWhABLDDA&oe=69AD559D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFaY568h2PwQ7kNvwHjOOu3&_nc_oc=Adl38s_JoUg2VQDtoABDnYqQxvDG_ZEUkMNM0gNPFTgXB1aCDydDf_VI5wSCzXbAuA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwv6qOcx1QgmjFcSte1gEKTm5QmGPqBGuFQI4A_hRHoA&oe=69AD59A0"}, {"file_name": "01_Hero.png", "id": "1
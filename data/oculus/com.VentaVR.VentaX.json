2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8bjAnc6bJAQ7kNvwHbhNxX&_nc_oc=AdrPdWc2pHqig_WhJC7qAR-s8ySBzbXF8hAMFlWj1w-J10S5uwyTtL4zPFg9sfWrvww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PNQfXQg3QhxqaXLhoN8sonSKs8CAoIKA9Tz8UyeD5fw&oe=6A185E26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKb7mQs0Z2EQ7kNvwFDthlZ&_nc_oc=AdrQnkwUdPbtzVU6GN2kOYW8beV_KhGKPa-i7bdlxwdBr-6qENnQQe_5VMBFIrQj5f0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_b4o3zhJ0kThXLUPPw4TEsAtSg1vI_h58rm99NnCNVw&oe=6A18590B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U_CSDERf4AQ7kNvwFjIAgq&_nc_oc=Adoz_gLcPYIxEw56dzUYByGwTYegl2iB8pSnY0JfGdMzl_ZdWtMDO2IMpK78ATz1IaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fpsq0uk5DGcm5-C8XoZg47-1tpR3MnWFvIv6VdzZKQA&oe=6A185153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlR11j31s0MQ7kNvwEktV6F&_nc_oc=Ado8i5NDNahrW55e2t6fjHsH2vkEJmUYzgQJRG6T3YsZnvywXhfKRHH5voQbiJlF6lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cj3XECRRH8-Ytel-NtT8Y2iOcysIf8ZgZ8NnuG-z_qg&oe=6A18424F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4Ce-8gSxEEQ7kNvwF05cuJ&_nc_oc=Adqj7mQh6DI590xrGhTjocwj2wl4mkFpm1EsjFEHZKyVpbRp7poPJie8x_oqisnCII0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iORylFcowqwYax-r-m3FAwZF_nOf8-lViw2U4WQ8Ryg&oe=6A18575D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRUEU3G88gUQ7kNvwHH8Cdv&_nc_oc=AdpFEzI7sphUHH0Jk1Hn0su6ONnn9X1CcegFWtzACQQ7BFGFLCJ73KEXe1QpVYZe__c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qQUKHaCWNtKX7rIBm7NdNsFPUVn4RODO1ReS
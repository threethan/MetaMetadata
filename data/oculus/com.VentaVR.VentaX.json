2063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOnauCSPku0Q7kNvwFs7eY2&_nc_oc=AdolcRmcOrrgKEpnkz-y76q6s56zviK3WWXZ9iQZ5AxdQObZZdMwzsrhzlO2wlgZQno&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUu_9AV2IqULOtwRiChzf8GD6m_QbNC01ybx7CjlDbdg&oe=6A58F7A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8qQDIPObx8Q7kNvwFia-Cs&_nc_oc=AdpMfAMsFLsfwqKhVDwktf8iAwZMCONxKaCtbhMGhv5mvR3ytaUCukeywGM7mQ-i6so&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHr3E_WzwPqHww1QgbWVooJd-ZtqqaQJ1RHvUczpbEdA&oe=6A58F28B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k66j0Venc9gQ7kNvwHM0u4Z&_nc_oc=AdodoEUzShOwFeA66vMQQ3MU2SGYneF_rlFQIDXTTzVErfZVhTZ-4--bvnt7dEgA3cM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8BUsRbZX1afh1nR7ks4ux1Sp-JLNkpx8Pqj6MaFlI_A&oe=6A58EAD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOe9Yv9J-3IQ7kNvwHqzNfV&_nc_oc=AdqWUcSLvfEYj8wmqg2g0W9xOaSrhntWk4Z_k-fB0FYpOx4JFMn5c6dAIzI_MOjmimI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVLHrQFCccWxOORx08wZLn0JbXonPToWhQGA-XoPT1Zg&oe=6A58DBCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzE6mMQQLCEQ7kNvwGoPVGe&_nc_oc=AdpGT9E34R8fDpnYf-YEwNJi3AQiWJxzKBhUhtTuRsof6US97SlqJcKqSmJYJJdp1CE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2BBL0mWDTfaFjTJ0CzZ42qYxFB1EnagYEdc1Mhf-HkQ&oe=6A58F0DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI2RXMJJuHUQ7kNvwELShGd&_nc_oc=Adp9D8KNiWXu8-mIcF4DjDcSslCAoEYTk7s1gJoy7o3JFnrEFHjQyhmd9Ky9xH1by4w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNccsTcv4cRAJM3MD6bpQflfQT_kvuqe791sl
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIK_PE10kF4Q7kNvwEMSslQ&_nc_oc=Adr5beWxXZOnENDZeErT7NmAVL2y7Q6tmH5kVQCejcyG_7CPOdLz6QseDFpTrIwd-tU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOCfifSysOltQox9t2OVdcU_N8JLEEDDr1Mn5gdfI50A&oe=6AD241A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VTXXNl_eWMQ7kNvwG6Z1uP&_nc_oc=AdpMzrM3UNMWvNHBdSavC9kThAqUQQz9KqG3FbfkVJM6FYCHQg66x9Rssz_G5siy6bQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmwPUyiAT-lSJ2Nhgu7tls8XJ7jT1A0sfrnqrBZlYSTA&oe=6AD23C8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PowSdoX9xMkQ7kNvwHU1gEV&_nc_oc=Ado9zYoqyimdRJxbN2nCn_QrrnqK1veAXU1wRwgOegHLc9pQayhs8OgUEPbUZZw8P8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMSUCSi3vN394rjyvu4P236wYlslIbRF3z-2Z5t_Xtig&oe=6AD234D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7U8GYRPf-IQ7kNvwG7-O8h&_nc_oc=AdoBhK4QNyxDcKYznIf5fCySgH5mI5d_0k9sTLwMtfKWa-z6CEXTbFL4ksq52rQsd70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLuE1nXm1Y22sngc0RITX_N7yZPx26dNvRRL88QMIK1g&oe=6AD225CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSDkJuG6wCUQ7kNvwHhoros&_nc_oc=AdoH51hGqf8A8g4YiA94cRRVmlkZsG3kBwjf0sYuCnHLOrsEeVH0voDWUivTnKh13jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA4WKXjUMqLkyu0SUgZluSEJZ3xDHLEkmdduT7Gm-7cg&oe=6AD23ADD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRi40zw3pZEQ7kNvwGoQb4Q&_nc_oc=AdpHQkQY1z-MPfhftnahzDimehX038jCESTLOqQhRutsmeVLnR38MaDIwzK181153u8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2wWwxWu_v_teyk2J59YGueDDhWCypzDVzw32
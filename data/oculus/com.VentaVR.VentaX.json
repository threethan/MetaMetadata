2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odU07VxpZ4QQ7kNvwFvNVnN&_nc_oc=Adp6MwXUVZ7cJJD7-l6Du1eoucVyvqWAp70UcRU4wLEbervvjPYYVZr-kJcPiXmWWQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwXRuGwDh3dM4notnTvP4LLZE6zDuSiIKrZbOOaf0xeg&oe=6AA56EA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWBGUQn0sEQ7kNvwE-nURX&_nc_oc=Adqr_rajWMU8yM03ZGckFeZCELQt88Y4kZuehxdrM1sBbIg_1XJms_SdK6q4G0BjWV4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuWc3Dfq8OIfaxp-HqJgjjST39ho4pC23mK_8XUKZmDw&oe=6AA5698B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X63xNu7TMTMQ7kNvwFjsTQI&_nc_oc=AdqPtZXMQYL8tRaIz1YhF2fxkRUHzFFFGKIufLRNIHI9bmrkU0FCBB_bIvd7nmeoCAM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLISpfQy_gPx13LwDCM208tSBP60A02OMopOw5_UtD8xg&oe=6AA561D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD10C5KDfykQ7kNvwFchrxg&_nc_oc=AdoIYzFuzv2GB8kH91f-zbhRA8fQsHT8a3miyjJaL5oAs9tkUJWjuvZIpFEwgLsFUnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbdfkHX4mdrrmWDubHBrJg-L9GYKn_UElWdO_2pmPuoA&oe=6AA552CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9F0LGRrlHoQ7kNvwEQtTiW&_nc_oc=AdqQq7q8ulycwo9A4nHsyM7maGzq3ZwQD7PN_rLdok1-IzmRNAfV3HjgMfWK8vIAaFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmIdE42a-tFLrrZI4LqbF8fWn6Ou31fYu2rxPT_BE2gg&oe=6AA567DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P90bWrmOvNQQ7kNvwFtJ5py&_nc_oc=Ado4-VkW3YG24KlXA88wjO7b9TRkDIuTms-Jws24_D7HmiiFw5jWuCXzvH7ODTVXg6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRYSN_RDQReyvIby6SBQv0r2UiS7_yj5xWyxt
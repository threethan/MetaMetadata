2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXQdEKc_O7IQ7kNvwFeIFmv&_nc_oc=AdphOSZT7lMb70TbsqFR5eA2wmqTgFNQdxw1W6nGDSz9YTjK3J_SXyPKyCpRGQShP-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAVD4jD2J_dp8gMQDTpf9L53Zqmoxsmm2gVnIFcAAtug&oe=6A999126"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aONYn6WMo-EQ7kNvwEFsqAh&_nc_oc=AdoS-afsR82l3ME_VdM6pQBd7WUSXwZgBkwclzESDUuaHlNZ0CNqOPXU2oKwjDYeYDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLggEI32RzaLsKxdvvbVE2WBQGZ9n99i8ZAmCK-AjbQSA&oe=6A998C0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzez8ITr1UoQ7kNvwFSz-m7&_nc_oc=AdrEXgIyKQ0so7WLDKX7oQAa7XpWqhT0tXuxZ9W_mVBqQzBzt1b8jn1x2XOf8AqgfWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4IFCAkRtzrTN8usLmdufCQA6HEl1J99LdM7PBnTKB4g&oe=6A998453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5kUSdcPCJMQ7kNvwGDKjzj&_nc_oc=AdqfIfkAH7fumfrOVY78b1moa74nN4SUdr5WwXHFxEhsPZKePP0YxdsPpDgRWBUG__o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9R_0ZKV1zMf0-FGgk4PJs41CwjS_TiD_TcRktcLiw3w&oe=6A99754F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1_PMaDIG8kQ7kNvwHwdGUe&_nc_oc=Ado9RP4fmsyREtJQBTWE_D4Q63UnZCAl_6o7P29Vco3N2Ur6PsJShxlCrlNqnSkRnk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI92NbfTx12c_HsWBoSojGVNHJ-fbx1XVDepEgDYMlwpQ&oe=6A998A5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbkWHs1hbRIQ7kNvwFmLzJC&_nc_oc=AdpdpiSrQJrJAvBCYp6FrPnnW6afqZBo3D47al7ik6waWSRct_yTR32d8jFB9Et7w3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV5Z9qcitnx1vBjCU8Ad56lcyOZ3xM78ZShhe
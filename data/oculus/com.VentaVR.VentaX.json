2063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1PZthuU4kwQ7kNvwGmQo9w&_nc_oc=AdqhbRgAqqIcUnwtHLsvKwDHf0jfxDS47uek1GmC_ZICgNiD6NH9cNXcod2Y6SlKr4o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTgKPjMQ35qtzGHCVUt3XsTn5K6iUuBg41DEtUMw_h_g&oe=6A883566"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJwoy_sDv1sQ7kNvwEonhG2&_nc_oc=AdrGvxFBVDOiS9KTe5fuIGsIK_KV8SebumqSFYrXRS8WvWoQ74Q6tFMSWFMN9AXSAIs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_hOrO0WfMD1nrGWd81vxsYhnty24HVNSiJY3fCEdnQg&oe=6A88304B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84z-Fhhu9dAQ7kNvwEYJXhv&_nc_oc=AdrP9mEQC1O6OmfqGl2mf5fQ6QfwOCXU63a_omRFSD9Wmw61cRj2ugKgAUJEdKACTsQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsoxK4QbIZZYSI-JorBuPJZf40sSCqCEVqLxLyohxuaA&oe=6A882893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-0ODoYVtY8Q7kNvwHCQr0e&_nc_oc=Adqnp9NXqepw8qRyEPmpwS-H7gb-LZS0d284y6raxWqttVyOBqzgyHoyHnPGWv9Lv9o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWpFQe-7bWWewZuOHEu2Sdbj67QxK0qmUcuCpbVZ6ibg&oe=6A8851CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1_PxGt7-7IQ7kNvwEFx2_I&_nc_oc=Adoh_ku8UuLxhBsyCHmtD50NFgPbYkDU7ki02CNxpQulLmc49D83yrIR5QIQJhowoww&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERg02o8jQCnAX_hThWrAFkFFgzxjFMHRpjGwz1p5yieg&oe=6A882E9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZGHySXUzuUQ7kNvwHA-180&_nc_oc=AdrgB1dM4qd9j_OVFuiNDAdwD_l2bGjRzS-xj9RHnWdNKbiM0GnPY59IgEFN6wo_A1M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8Emgwzfk3_NkHF_jLk4cU9aNfOxYZgNmMqQg
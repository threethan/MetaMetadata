2063", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6x5xo9LZfMQ7kNvwEa0dWN&_nc_oc=AdodXt7l0gtBXedyjQd9pToOUwhGJoNCXf2HZy9Oj4qYdaAbqP_x395YITAZgKW6Bn0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mkABiREhUeb52Wz3DYGakkWXNPQ-AI5KlTHhJw4YKlw&oe=69EF7FA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL-uxPzNkVQQ7kNvwHb_9wz&_nc_oc=AdosmOEyMFT1b39GoyimOUa5vavd0DsdLtbooihRYtOp4IN3WfvJO9ngBqorYGAoRc8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38JfpmWAsCrY8jlZPD1t8EX7LaDrwyTXHlc3s-9nRTFA&oe=69EF7A8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVhOyeYifbgQ7kNvwG-DY_K&_nc_oc=AdoGFrbL3aowYpdVbCi3zVgSX9nrqm63xwiG-OpRW3YWuqlHcvsgNvZhT1YR4mf5y6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HcigQnA6wgnTsuMSkYhCV7lNGoVcTyDSmeFNtAj4YjQ&oe=69EF72D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSaBaznHeIgQ7kNvwHBObCm&_nc_oc=AdrJ_Ox84P_kfeXqbWAzXlFoZTP0G8_1S6NdtuYC3YP2Foo5OJG_fALIc3re6BPLRZo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cKENkC7zIlNO9x2CXqqwKIklDBM4QDbiXsWMsk5hnvw&oe=69EF63CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUjzKkIWgUYQ7kNvwHX6r3y&_nc_oc=AdputQiBYDl0JN9KVqohqHlX7CWcJmfzHkpKGKzttt1xlBYqfQbt6QcakoXz4TIA0Ek&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tKtD9xrIEOwMx_9fpqXlMf8gHPogeEgQmPwonET7DaQ&oe=69EF78DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwR00vuse6EQ7kNvwFKby35&_nc_oc=AdplGpMIFl_CpPCOpN66cqeEbcEcaYW8ZMrnUsT4oSTe8ah6sVPF78oNb_qtIytLl9k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uf2Oq94BVs9jL_faoJS0qRLz7Vk5U0Qwg0yT
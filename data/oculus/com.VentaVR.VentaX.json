2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYz2-UFpCwUQ7kNvwEiZVOL&_nc_oc=Adof7hUaXgpQT5VqoN-gFGydQoshPwj9YIUWSGWC7z-Yyx6-1VyIS1iuNi5NHlb7pdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TSNKZRRGKmNFG9xvytlwXzD3NeuzLcV4KqNtmbFwRWQ&oe=69E4BB66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivoPhWBa52UQ7kNvwE4eHVA&_nc_oc=AdpcXAqkmA18pB-ZW2G9zzXF_BnkG_EYgNPdQsFiiViW1Gnd6Kgpqkc3n7dfAZeZGfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U_Ct2GSGf23opjl9hEypS00JlUhjuJow426r6Oxbt0A&oe=69E4B64B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TELOh9K8C58Q7kNvwHFiv0K&_nc_oc=AdrQUPbODxn9zN6V_v9Bb2X9rXAKfBy4KwYA9hsXVAvHYxlX5rplagQ5SYadnexxEsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HRH43OqOIMDeqHURAfWpVseeKhmDFAwzDs4Sj_nP7-g&oe=69E4E6D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7B9I_4jj_cQ7kNvwEA1X5v&_nc_oc=AdrrMsZ5DtDQxbKTgb9IpS_oR9IdG863trzdhDzrYs7-A698ONudlI43o2M_3Z7Pt2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23PLDHOg77vMY5yvmCh6kr5fda20ntkAeU-cK9pFIDXA&oe=69E4D7CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11iPv-4kAvYQ7kNvwF6G0mA&_nc_oc=AdpPska7rZNzsWZZHe5kaRA2URNNixlhAhaOf8y026j98XmBdGqKjy3keC95LfWi5y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m6Y2E9ywQK1u1bmUIutu704858gWV-E5_FVMhHgwADg&oe=69E4ECDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHWpUzaaUhkQ7kNvwGBarNr&_nc_oc=Adr9bgzJ321Am8IOJ2gABok4lfcG29itsQbiVjh01gLttqiuYd3fmGzfa2smyg0Rky0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07p9IxLFk5ycvHbgxRTl6KgLwzm64BCio86DP
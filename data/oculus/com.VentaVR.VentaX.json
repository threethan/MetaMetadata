2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z_h7wFcB6cQ7kNvwFCSEv8&_nc_oc=AdoLlJWLzP3QblBrJrRg_8WxH4orS8QdJeHO6m9f4kdmd6IPRyDhNsmm3TJ1zyKlumE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRuQdJtN2UCS4hYCWiIGJR8HFfHyyMNbBJxuVW1hKpjg&oe=6ABA86A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjRjEtK36GsQ7kNvwEMyg7r&_nc_oc=AdqNpl4IzZTD-2lYzcbGGcekGmpZLe38oso3pzmzQ_3rDc7bHSmWAJyO-1N4DFO5TbE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX7z6LeGrxhooLLMMtbVc529qASlOpy4SH-qpbwe4IcA&oe=6ABA818B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GgDBhObMawQ7kNvwG3Oi8r&_nc_oc=AdpZwyEgrm2-eKxTJnTZal1upt9khNWgn-5L9RCwI3VULt0A-hJYwGETD7t1ZcrvG2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo6DZMdU_x_S69FV5pVoF1OqOh6tPzsgfc-34fCygg3w&oe=6ABA79D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HABphWAkNXIQ7kNvwEHoDJZ&_nc_oc=AdrCu7BUcrWYM9-N4WGsqJ9HA27R1UseRH7T-Cao5fLitMKJp9PuNP_hdiPx7xhBFlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC0GL_K61p94kI-HTgFEwZrKF5QbTOEYklpvcXUOSc6g&oe=6ABA6ACF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0rUeo3vPd8Q7kNvwGh_ozY&_nc_oc=AdrCaa_hQJdbvDhNvmXZKvwnZq6XC0aROdtjkt7qdQzspTCC90kqSscsn4sd4LMGrvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMXr3ZCiSjUxBjkPFot03gY_N4aKKDV6AFJ8topctb4w&oe=6ABA7FDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4waYqcfGbIQ7kNvwH5keRF&_nc_oc=Adr5_H1Jo0roQc9Enmup7KGrfuDfLPEFX3uWU20C8vIGT-RpeLx2dCt8NcUJS1BVMuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpNmgcQwDZ0M1q60F5FCBTFOllzSGBa9CP4Fz
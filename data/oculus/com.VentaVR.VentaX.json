-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLjR9vCMxsUQ7kNvwFNz3kw&_nc_oc=Adkn_-ck2ZPanNptcHs-JzBgccsIyCTiuHD6WXAcCWeHhgwVcCYB6SERKVDBV1eXQ1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsluPLqdufR9rwRAF2RsrjNcf_9Do7vpHNwLAoIIGOyxQ&oe=69A967E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0UI3H1plCUQ7kNvwG5JAq6&_nc_oc=AdkZmHcP-XBYqa3s1zgi4dA2mS6E4ojdzISLfD-KvzgKPhx0o1uIUau_WTCInD77nq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu9p7kc9Sd1yncKy5sYZ0PouKepPKqAnSUUye27Yv3SGg&oe=69A962CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N_6vKWE-PUQ7kNvwFJGwi4&_nc_oc=Adn3_KtAWZeua46o3ufwzUdUjC8nIPv3BNuvgd1QjOeqb-CMcHX1s1vUdY3ISgvJqZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs1aLBvyEVpUwufC1_5X61XPn7O60EzFa_CXtlM7TnEHw&oe=69A99353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZrazsAGIJ8Q7kNvwFGplFu&_nc_oc=AdkS505_7uy6Ne685rizLNRFVe4nF13X5vm1ZwIaklIReVcoggBgu6rd9h7CZ2ilzGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvI2t7Wc7d95UH7BrdFRfzL4HQr-Wj-C9UPSXLaf5SuhA&oe=69A9844F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60DbbgfAGjoQ7kNvwE98mLs&_nc_oc=Adn8OiGWKKwXI4nduoKGByn_E-M_3mOxwBCrBcOtwVwP9KyyrIh-ONitK_tVjZkTOrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuofzRQWgJYHixjuDqyMHqecRrGCj_3-nupGIiurhqCRA&oe=69A9611D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXCa2rsbr_cQ7kNvwGzL65y&_nc_oc=Adn9EMlZFwwNr_fzy_jPC0uRhBmdQ0R7F8nKiEKcDIKx_o3NIqDkg_2RSnUetaIc5Tg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afveiy8Q8EhzF9rJj9eE5Ffn9Ykhhs9zD613rtIY816L9w&oe=69A96520"}, {"file_name": "01_Hero.png", "id": "1
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM3Hm28JzOEQ7kNvwFic-eA&_nc_oc=AdouPQKZNimjKq_32-4cURkkJ67YV505y7ov0BYGD8YOhLGCa_0KBAf6KdhBb8lROes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GRlidbDjpaU8L8KWKz9iQ0YkaO2xD2Ph67ck6lWiSXA&oe=69DB80E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOIDi21nePsQ7kNvwGmb2rS&_nc_oc=Adq3E2MohSraQEcX4uISP52uE3n7VDvwA3M_UwmshvJAcrrSyvlWLnhhw6be7DWMErw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sd8_RE0Jm60CNVhodb1h7VVnD_zj08k7ImHPWZfCkMw&oe=69DB7BCB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_SHNkZU4OAQ7kNvwG_HPc7&_nc_oc=AdoWDRfp5K3G4cAYiyyJPb35EL-j523sqT7zh9Tx8wBvfhXsc1r68SJyCUR9AAtYXko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23_Zo6G0ZShs1QY1U9OsrNqGu8Zz22ZEqpzJ6wgB5zMg&oe=69DBAC53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKuiO2ZZEKoQ7kNvwH0q9LH&_nc_oc=AdosD8WbIo-2SyRVuSH2ra141lDZajYBQHonCpaWtODAvUreX0lO1BXksVY5zkCn-68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-HVrRVqQ_Xz9exWAxN6tUoUqMA0OMruGb7YRIF2UNFA&oe=69DB9D4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tvbm4GJLy9QQ7kNvwGl3sJ8&_nc_oc=Adp_qEnBeMs0ZM4XXNwUvZj7Y4EY11TAiljBdBI8VuY4fW0HS8VP8vQA-WWR8nLkx38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rf9MK7nEmm1bZ9-2ZmxKteHwCptr9wcSJv8fAwWrSBQ&oe=69DB7A1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBmsR17wWAcQ7kNvwHXfO_S&_nc_oc=Ado2aQZ18i8K96fJgiFXfq_Bn4ziCvTfMboghmF1Q7aZTUgQhmB4V2onzuPtF5nHX-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NGGQjsrqIuLE5etboEmZq26HNfLJLBZLCQeY
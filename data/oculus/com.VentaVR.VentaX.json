2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2-ZAfYPQD4Q7kNvwHZcdjE&_nc_oc=Adqi7U2zPnJn5_HcLIDgqv4guue2vtXe5NmpeaBS7enHkaAgduyTF1L_dycVycaTWo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zj9JAvceuaNTnX5CxZFK-8_m3y-pV3pDwmnFF05uGyg&oe=6A1469A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6U9ex5t60wQ7kNvwFKraFF&_nc_oc=AdquPAjFB5n_8FjwEMeYfJBb4Ik9S-zzrUQpVIaYuSbr7g_EkIAQJfiRgZcbLw4tv24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PKKQUjZxwaBS1DGcH4PEmKTmonLoGaIcrKxwYT5eTqg&oe=6A14648B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRBLdNZvhUkQ7kNvwHn2oTi&_nc_oc=AdrO5eJbgmASdVueWhI80I-9OyzfTSSlrys6UzsskN-oyCh-QWetzum3W1kIZeNa2Ms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bFWjioHAaT1deZLhOz1xldmi0ZE0xfBElsOkZqtOZFw&oe=6A145CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj3k9uwzvlYQ7kNvwHNM_35&_nc_oc=AdrheYJegpbfTzIoSAD6cSnjJpt493vuDtyF6gTTEpkYVrwx04-8KxxjNNt7kWIGCvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Vc7hdubEflNRcP2VoVhdSlhHmHCU7MMNESz0Jsa5EQ&oe=6A144DCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGGmaZ0fOVAQ7kNvwHB_mfV&_nc_oc=AdozX-rifLwTh0lPnsgr9IasDuyWmmG-fBEce8nSvEwRUizHEwX_fuWAU6MvnExfzRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mc5hFEKTLgWxonO1AJHggYYz82R6USibOVseutgYzZw&oe=6A1462DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wULj6YLpqR0Q7kNvwHIoPDN&_nc_oc=Ado59vSMnGTcvgYTHo4LmTbBqdP0daaCIkGRqHqfqUBkkKUKCfTJVDf0ewg8UOxAXKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t9tI1lfGjVPHHSLPFCGFilQd4G5qBKt6RTUe
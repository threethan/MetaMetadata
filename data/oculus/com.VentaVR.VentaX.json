2063", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcPsuheT-kwQ7kNvwFRHG45&_nc_oc=Ado_XLAOo3c6ils-NSrNG4C3d-suUavMaAidCpHgeJiEILsDspDG2a1ki1vHLjBEEmI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6IsDywarv57TzRh-7DdyhdD0926I2sZwHKSjmnEQWog&oe=6AAD57A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gLVLoHCxE0Q7kNvwGC-fFp&_nc_oc=AdrVzaH7bPbLjLuDH4B6b8fni3Bg4Rhk1Tc9OvxKsOezCqF3gr-EWfmVa3U3zpcxMwg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyqTTcxJwbKfvvaU9fTGJ3QZUeSLMAhgonbtfDtjCinA&oe=6AAD528B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9Ddgs0C6eAQ7kNvwFTwM5p&_nc_oc=Adp1-6Ej0vtOyLwgf24uu_EWPqHLDzw1dXxtv5lbWVByfDIwInB2lfepXHH-2p_SEMM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5dekh-EswmbSdFNSHHdE49Den3VLW0-2NJiuSjbWfRg&oe=6AAD4AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9fxQYUhIRcQ7kNvwE44fgR&_nc_oc=AdpEaM4OLdLcp0bGhMz9mP3OrN4AQ3h5uw1lSinN4NqJw1E5YiEc1mzoE6hClH3s0bQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISsyNW1OIefsEE6t8bHjJV-Gx8m59HA7ScIzlRDcASEw&oe=6AAD3BCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x65eWHmNsLIQ7kNvwHfTAZ5&_nc_oc=Adr8ItRutJ63IJl_xAbsU1vpmerUi0I0IQAVjhM3D-IRubpLW2b9JJMpRVm3GTjgk3Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2swT3tIXEhr2Xv2-aXl_eCa06wdDkcyRoNuMw1NPksQ&oe=6AAD50DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeCDGua4J1cQ7kNvwGS-Jdd&_nc_oc=AdqdV1BPYHFdK8jumfYFkIg4hLtrSV1LsQir0TX6MKPkWhhs1cQtPnCMeitRPhO33O0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL85YU7PtASmizqfeWT2xbb9Q65KI82cm3Q7-e
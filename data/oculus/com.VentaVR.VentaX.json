2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZxc80IwAZYQ7kNvwGWRSlR&_nc_oc=AdrlZ6cfNtMI-a1T-Ebi6Aa5tjDSDK7ttO5MjWO-8SBmCxdQtnIiZkTC-pgm6_NRrfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVfGvAx73dlGIerEdklCD9ogHKXYW3OVUfzOVD2OoUOQ&oe=6A526026"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU6Kj7cHsEcQ7kNvwEK9urg&_nc_oc=Ado_LQk4LGe2p-DBTYNQw8TIcXjmvL1nHxlgLO8aIUat8Wv8zpUC3q4h-um_A1d4fuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWPK24U4ZIGlxjaQUnIcYCzsii3iL6g0oLm8Ti_41a7w&oe=6A525B0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9igyqMmdpIsQ7kNvwFn18xD&_nc_oc=AdoJrKO2gTZ5rCEuOYIl_jzP50ZKClXEQho3miTY2HiCVjBrP-e-pcZKAaMxHs5xchE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5nnadapbZC9MCXCKFK0_IIG2AElD6bzXXUnviHjowLA&oe=6A525353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkmlYmVxDqoQ7kNvwFUT5L3&_nc_oc=Adq-GUCGEUiStRwN4EiyEQCVQ2AawSWjmlCVJjMwDMj_ShPazWpyMEbzn5Ia_o6lwUM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh25nN_iuGA_uSW0TS3NqMPyx09O0sm_l-qM7xpmw_aQ&oe=6A52444F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scIzZx_-AvcQ7kNvwGpqZnA&_nc_oc=AdrruZqQpPHMdWtLyGtxsayu_iDWDRbP6YI6aYg9CC6uP8N1vvBWPbJkLe4Pu2E8_po&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD58mqQ-bLmtEvI73K-qLVWnKH9q7GJzFqMYbyXt1Ovrg&oe=6A52595D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrG641El9awQ7kNvwHAw51C&_nc_oc=AdoR0RopSN-PvuUrmb9klZ484CawDxa40aAWGk7rzp58f2i_UURzgen5SNvVBJ7K6JM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhvlnT2rx050Pa_aAzt6x6l7Zf5KJ9NaXqtPE
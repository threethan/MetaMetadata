?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6nbwS2X6RAQ7kNvwGVIfhq&_nc_oc=AdnrWZ33uVVfOzzrsPrSXLpHclxYwXsYy3P3HEcYZhfmweiWMAGZPupG8B2jOxHSw7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBJJ4NzG8Bp2uhXHlaf88ipaTegn8cuZjcjTsRY-Lgbw&oe=699C38E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2JUD1pauwIQ7kNvwHvfwWG&_nc_oc=Adm4JMD4Lp-L03S270wIXTv7lnZeCQlIw2yCh8g008c54X64SDSIeZTemDg4W3Id3uU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuyrwTHTgkchkBNf-ugMy-mqj976Jhd2Yl-uhS1ZAUnkQ&oe=699C33CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkc7Q_5LUdcQ7kNvwFQzWcI&_nc_oc=AdkJLCkJSKrqbpiCvFOlzBzs01N-SbaBvZ0ypNyavLCAjg-ob5DnB7IaZx1ZqtBtC2M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsk4-NWSeaCv2Y-WYUdM6nYDE4VNq1CBl7CEnJRPiF-sw&oe=699C6453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vYK0hxPNR4Q7kNvwGFrKSg&_nc_oc=AdmbycEcwkkkccquWm1GepcKcn4axmgI9sZcOBxgy4Bqw823j_xj6ENgybcQQob0fdo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftKGdFGt1M1N0TgvydTvFsb4WJuz_sUb6wRKLqBFNhd1g&oe=699C554F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-Nj2EtGtdEQ7kNvwHoZG70&_nc_oc=Admbs15Ky0lqE_F9c3JTbOrpRmrUACDW0L-DmtcYG8OAGf4rj6XHMH_ecCSaX0hf5Ac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftTq5VMIv60fFWAKsszq3mHUPI2Y8b8q4rTjRBsmmsUBw&oe=699C321D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOewfgVGovUQ7kNvwEpDJHE&_nc_oc=AdmNQJFxn0KRJN2TtWxdbE3Ori_R7HJzHBGHVvrBbGiff4ZIDAk9rb510fehgvdgikA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuFavVCOfbsLr5EZtz3DW8z0snk7fle-MHjXxsQdl8d4w&oe=699C3620"}, {"file_name": "01_Hero.png", "id": "1082791666697111", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556807_1082791670030444_1
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXQdEKc_O7IQ7kNvwFXKXGz&_nc_oc=Adr6O2Pgxh0MsasBcOi72RGyQBISXD2CeTxOQsPGh9C0zfkG9BJt2zt984hL_l_Fisk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1M_MNgRP71wCxBJQheX322jqiSow2kciFqC8Ku8gsZA&oe=6A983FA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aONYn6WMo-EQ7kNvwE61h13&_nc_oc=AdpDH59RPW6iT8j6R4qJwToxcoVmoeXtx-rGz4k8Dgj7SnFvIC_4ITMv8V3ZkKRwlVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgXSkQaHxl4OJPGoJPBKaOOXQJuSCFvT41eSoSAmeIYA&oe=6A983A8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6ji-Si9gMMQ7kNvwFYsDV_&_nc_oc=AdpvZdIuXCvTvcdRoEeMUWFRldhpf_pLSbUQRNORkPOYgPRE-HL64FMNZ3vyVF8GQe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPreuQ2JaW2NGJQMgbmeE4Th0iWW2kiWHtcuYfD9-ksw&oe=6A986B13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGatQW0orz0Q7kNvwGPC8HD&_nc_oc=Ado_8HdK0fXIL6ntFCT-BDTBsBMnC2noRXNibhZyKcMWSaYezM5uAheD4EfMwoNFlK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQJI9i1IjYO6hRAvoTpwOKk8OKf5H76hJQO2866jO2Bw&oe=6A985C0F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1_PMaDIG8kQ7kNvwExG-6t&_nc_oc=Adpujk-T64eYhOG4QOSscjMVzQmtv0rLhKrqA2Kwkeh1kc7CSlq_SIrqtsTX7j69er8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrEWiiWB8Q_TM2mUV_5qF0fjd7yih_9Jr116GOJBXOVA&oe=6A9838DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbkWHs1hbRIQ7kNvwHOOfjc&_nc_oc=AdrXwC5zfLEdTK_8mBD4PRqNMHyYWHAK8_lHaOGeqZwOin2ScxndgHtQkoSxKOjkgpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeLNhKsz_G8X6iDnCQNm0VqbvwV728NCSZbLU
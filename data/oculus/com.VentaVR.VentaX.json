2063", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dGlrYHhv9wQ7kNvwFb-wqq&_nc_oc=AdpgiA1blnrt-9Tyilk-zl1KZsziCjTKPPPlnrS-P8meXfWgWyuMq7fh4vQyCRNmw_U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi1SFYND2gmY--prFWYTVk--irrkKbd9czfcPc5guMGA&oe=6AF9CEA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oWWKQFKtzsQ7kNvwFgLR9J&_nc_oc=AdrfnNmjIDOjD7kp_DY0Of5hpsrfC7cBQ0MMjzbcr7jXobvG1Yg4Iy2Riwc_-tBzDoA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOlG1CttdFLNdJi-X_BInIM4NOA6nhk7HaYTvYoRYEoQ&oe=6AF9C98B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bMpNMiNL10Q7kNvwEuqS7M&_nc_oc=AdrqYUXlzi8LodjobJbHU1whveXXLpIuThiqZiO8BAlib5kAW_K4NMXWJgCWT46ShZ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsZhyPS4VJOfd9iimlTcTDpiEEThPEUaZEyTDbaCMeLw&oe=6AF9C1D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q9ayjHg2dQQ7kNvwHlX7Mg&_nc_oc=AdrAF3DSVcbzYmmwccrIqZ0CdTAFNDnxJiLk99_kMZmN97pdt1_zhoobjDFDX5oBH8s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa8Yi4jmMRBp1Mx8e-jVy4A6iyUEPIv-PIb6UHWAPuGQ&oe=6AF9EB0F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJOzAAuWOvAQ7kNvwHL5ab3&_nc_oc=AdrNh1A7wyCjh83_kn8bobTxo4T8yrpNRvq8nWFITO2te8sXx6o5A1Db6thCQG5cF_g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHWCkD6cBDw-Yd3kWPocsYsRMknrjH-mDUn4ODZ6E7Kw&oe=6AF9C7DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyOzzT_a4lcQ7kNvwFgVzI2&_nc_oc=AdpkuUrY4iWEmZ_bsyjbhl1uCsSN4wJRO74xyUCD0quzt9MOIU94yn1i2rLM-iiR-0c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTh10ZnB5pWv5xaqdrFhrp5433Jfl0c1SqCxZ
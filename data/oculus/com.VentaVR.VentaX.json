2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7As8soWq75AQ7kNvwFVw9N_&_nc_oc=AdrhW4XqMtGp-5afetx1MyZtXTHnJ7toXECJSMN6cwMrdfG7yjwhSnIp56aLqAC73Ro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH08PHhYXpbcaY7k6NIQPDnL7oi9jLs0K-D8TSyeIgRWg&oe=6A95D4E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aONYn6WMo-EQ7kNvwF7W-aL&_nc_oc=AdqeGMaKWDCHq2e6s7ZhlUiCpDoUE_KoEHs13dYMh9gKhwPnCGn0kxNSGcjreTphvIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENG4qT21--9Y3ok3dSxsRmQq6Efbfr-9eN44fy6C6RAQ&oe=6A95CFCB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6ji-Si9gMMQ7kNvwHo_n9D&_nc_oc=Adpdxmz2Relj0I1nqjB1Yc8Hr-jRIXyLKsktSEPkUSSnrD22e-FjmrMpVuGMchNSYIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ0tY-OYV3j842UE57bFJGgOJSGGKE2lyuQ2kJNA852w&oe=6A95C813"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGatQW0orz0Q7kNvwHS2ZFV&_nc_oc=AdoFXrZuvzfot2vCye8I-WaeIkJwTItizn9AcOgG4S4dtaRNQH38TNNZ3YETFvc0T3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuN8EkbL_1ecK7kkdCyDUJX8wZNER2dGrWPEMy9k-Puw&oe=6A95B90F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0hf-O0ywN8Q7kNvwFln_jL&_nc_oc=Adoqz_1VbsPzpfs_1OUemToqlBcGN9Dt3gOobC5X7Q0hBjwkw7XZ9ARjjh-zij1_OT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg3w_OMU8FaB26DxTR2k9Z5qBbZ3Q3hSbJB4NyrVMXRA&oe=6A95CE1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUV67bSkAEIQ7kNvwGE_Koa&_nc_oc=AdqIyY9k6UAufIyhhySuF8TlJOVLz1sFzeNboNsdpIEluhwM--A9TGSpjFUo4H3zR-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGnXgpfxEy6tD1Ae8dETMmq8GbjbDEJxb5oNP
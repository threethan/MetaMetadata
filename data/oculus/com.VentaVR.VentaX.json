2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlGKQONKAaQQ7kNvwFD_Udb&_nc_oc=AdoeVG10ZQhrDAHuHhAynngTHkRQPUJOnqkpejTfbxyR4SIH4L6RqiurMy_o1c_9ZbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99wKo1nied0X36q1QsiVMZpH0PQdGOKWlRIKrcZaADQg&oe=6A355F26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HiAfLSWc2YQ7kNvwGfdvZ5&_nc_oc=AdoYOnn-skLjMydWJLc-3NS9t2zR0oyuI5659MGaD6Y76Pq88ktopFTi7H0AEEUnDCQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hiqMwwRV8grusMIsMQsyLXIe25SJFG91ztcTSBHyVPA&oe=6A355A0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eru3rPtILDIQ7kNvwHVS_gr&_nc_oc=AdoLr01G4su_7ER1-kXIrY-ZtW6PY3Rj0yKvAxLUxTeleZt7nERihKPQhvPQ-5t82qk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G9pMid7haBAXgobbge3JUyOue4iZwnNjH_-6HYNC6rQ&oe=6A355253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmIHTcxMQbAQ7kNvwHINCYW&_nc_oc=AdrzWE4bhcGEB74BlJ1eCFUoepTRfQwQyqJokKLxU9tQlbWBe2_aCBfkC_QggbEl1d0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5LKev7GTzswKek-b9MfNm5Qz-vYZXe4YK1wWpwoCleg&oe=6A35434F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD9lz3V6x0wQ7kNvwFsXNnw&_nc_oc=Adp8-OBkYxGym60gHbPPx1y4Chj5OJJXwnI0UmNwvk5n2Zt2_G5vvH0UMZyThBJIBMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l9ltzhQgmuEARXJfmUtX5q6JJ1EqIKuB2XTbJtRIpVA&oe=6A35585D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-xAvutneZwQ7kNvwEae0jS&_nc_oc=AdqZ_iXNMvqRCgv90ci50Q4VC869c8OxJ6u-cZyR4rJF7muJlC7IMsK7oBpLWKouTL8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jOJwBpLxCNwI03AMvXc8CGYYBNvrZFShtkFU
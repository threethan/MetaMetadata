2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z_h7wFcB6cQ7kNvwFBMbfw&_nc_oc=AdrLMfg6WJJ2Y-JkAGT2bKXvuEhEpJTZKDNAHPxtvPhk9izAKax2PipO2h5RYVIY4oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWHPDWTSSN05Mr2KqypaviCMm0BSerwtVyoc2smJ3orA&oe=6AB93526"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbHewTuwGmMQ7kNvwGu5RzN&_nc_oc=AdqTovhl02h7v9aQEc7Nj9mtkl0S0R7Ijq5O0iDKKjS-5FTlRw7bTUtgL75bGi9S73Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxHMBdAx-ro_veJMcno4td4i_r2NBOiZRoILrYHBlXQw&oe=6AB9300B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GgDBhObMawQ7kNvwFk3oYE&_nc_oc=Adr058v3jc71cUX-CHdPd87iVIAhygNWrlhPSjkzQ_EoryhcfxxdeHpdixG5Cyo7ZT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVZniJDwIS3shSashmZrKxtrPRmHQWbJ-EmxvPnVR3cQ&oe=6AB92853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HABphWAkNXIQ7kNvwExBj9w&_nc_oc=AdrLYJQkHg40tgQi73Vb6vHWNEG2EeOlOkOm4Lif0KjgQBfYGGT1NAQZ-INAJIpjQJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1huGMSbxiWCEQ8TRl1l7s6d_myUKt14LHUMi6PVtCxQ&oe=6AB9194F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0rUeo3vPd8Q7kNvwFbvHHm&_nc_oc=AdqzVC4GBfzczaHpT7nc82ndrmnrzm-qjOa_zd_NL1FHtl-I4p3BtrqW1MIP1fb32zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnh3zexoXSmrBkHkZECYIZb7BogIEWBJL9cgiwmjoueQ&oe=6AB92E5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqlLFDfwOz0Q7kNvwHv0os8&_nc_oc=AdpD-t1xnU80JtO-ma9O6KXnGZKYt-UfcheF_qu5SsvanupS4fnKRvrkO_aa-z7LS1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqrmhTrxzOR6_Ud1S9pZea6_QMHvj99-du59u
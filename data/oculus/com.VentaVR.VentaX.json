2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M6cB7y_018Q7kNvwGFhyZg&_nc_oc=AdrFAQklyHGWIaADxSXk5pv9KXkLZG4qJFEWG3eCqXRF2_Dy5WSLNTt4UknFN4F-L7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59jJlyYytBMXXfmQolQx8vgSqTpOMv-iT1dS45GzsmJA&oe=6A204726"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DNFZV9rI0oQ7kNvwH69S8w&_nc_oc=AdpvU-yrzwV1eNQaJUze51VJF5iRSiKNK3qYypAxvUgag2MrZRHoZPsv3qYdMk7C6HY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CUnzCNhQYlgy0ARUhjcqytmpCz3lSJ9zhCiP4aOPpew&oe=6A20420B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSFvHF-ciL0Q7kNvwER5rZC&_nc_oc=AdpZHVSNsJjYF8xhwJfYQ_2JQCOcvGVvUblRYvyXQBs_9pq9Jc71o_K_jysWxI4YqEo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N-4R8j_7FrOKAy57QYBND-dMLTz1o-nTPHD8M9LX0Jg&oe=6A203A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnNyUcfWlqIQ7kNvwGUutCY&_nc_oc=Adr9w2M2cPW0aLvwLzcXmmi8VTo7YRuNNp0tkCqDVaccsnqKbEHCZe5rmVZweO30ViQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PSVGON38e0-acWor-0JgOnksboiHWPj81Sf3HZn-tNw&oe=6A202B4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apz-pINdsJYQ7kNvwGaWzmX&_nc_oc=AdqQ2tuFr7uxGBngEQqJWSX2Jdb1ZClIW_FQKkHSskyJKvne2UtfVikKjeUc-na1FZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BcmyQdlJVUdIWZTIbpR5Rto2DFMKdOtfKHRQb0EYELQ&oe=6A20405D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njLJfFL738QQ7kNvwF9xm0Y&_nc_oc=Adr-3JEePzb6tF8LCJ3uljiY3_PBb8sS5irzntkTt0OzxzQqcsMNAxfsdv-ZD_9IFH8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74Divpae_CzNfNtpVcDf-4f8x7U0CuUvKw-gb
2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf6TRU72_CQQ7kNvwEb2Yhs&_nc_oc=Adru4JE9Sa-PpXccAVV4vaxigByeyFMc4qvyDPKg-Amz8mE0iuy0h_0nmdnINEihIOQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eelzt5euqNq6bpA6Ak7LzHkH63B0d5DlmH46YRpxi0Q&oe=69D397E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W76z6yTNDfMQ7kNvwHy2w34&_nc_oc=AdrwKlpfC8RfkMptBj-OcK_TDCL4Gz6Um4TB58x7ws71aNC97BQPQx3CtD8uJI2fSr4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V2UsGX3fl5Oiyhcq4dYy_jevaf6vQTov0wmxqffpp6g&oe=69D392CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OxUaHGtSMwQ7kNvwGn2vXV&_nc_oc=AdrmUwV5NNZqgTxfjFLb58yw8g3uIE0v7moONk7THjzZn5aBuVUdYqDfeNui3LV29FE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FhTeTChBNsi8nchZJTlNOyFYp23xtKicaBiWdjcuXfw&oe=69D3C353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EC4AwBGd9DQQ7kNvwFR_4zM&_nc_oc=AdrdUSqc9eoOzM7MXab14kRFGW5QeEFib42lGncH_MnmF4cAsy6Cr6JygshI-jzg-fE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cVK2o5iSxXy8skNfpWOdXaXfHTzv99s2Iv5rz7LBicQ&oe=69D3B44F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AL3v9BHBzIQ7kNvwEohJX3&_nc_oc=AdqmBi4F_TdqUcW7Wr-LjoIINeCyVyFc28c9yDfDXtzvHIdhP4RktvvMfMTSfW1XQN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y4rzOWx5NqYsJbZb8GCMB07yYXWM-628c7VOG7gE-8w&oe=69D3911D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7J4GVgHmAIQ7kNvwEbFNxt&_nc_oc=Adrz5dGVgupoX4tkrO9jvCIxq3BxnMjBmQKmEPA_nDLcxp137f5Fz9xiX_vUbysz8Xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06g0QACYQSTud24oHHr1Cij6pT0pc-QmDuuJg
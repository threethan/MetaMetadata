2063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1rQFtQnOgUQ7kNvwFc0Vrg&_nc_oc=AdoDjTKjMqpcrSBbB6xu5GxdJzBUKBwSsc0RUlPKphzeTW7shcmaLG1U-yuI68Bysjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FwtCtC-OLh8Xd-Wbk7baat_rKoAOZ7HLovOFHqUubjA&oe=6A316AA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vHUNhOfyuQQ7kNvwFjK4cr&_nc_oc=AdrpYY_E9_EtJuBpLowczV9bW4sm1CvYesL7u9gf-It28M5FEOHCwAMaBRyCbcBEDpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qJwmFKrOp_o0gGalTAG4JLzleMc92VzNBXTw-kWy3Qw&oe=6A31658B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-l20Ko4yewQ7kNvwHNblrp&_nc_oc=Adr8jfOQiD34pUhvwrmwqCxsmUHS0rOM95jULKcdAE0Oh1gywSh1Sox5SeRJDsvxZXQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7nZxMxFOow-XcJ6C_GaAQ5twQEKjNacH3YYf12ogaGg&oe=6A315DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U2W9pTt1zoQ7kNvwF4fUCV&_nc_oc=AdpYJiIChbtZkio3o_uVwe5060kF_EQELT1Ppw2PekGp4z7LVGY0gaQu8HdtxDtrJHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5aVPrYQ6T8I-nxnOGIuf5ZJFsCLSoo28l74ZMNkZSkw&oe=6A314ECF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iPC3y4HGkQQ7kNvwGF3XPu&_nc_oc=AdqK1-ZYswcxOgdakpmVeEC9IVDzzj_Shs6Z3e1GP0YGd-zkCVJEtDsZOzsmcwhV3qE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XSk9zIgy_R3C_sIs-GtT1yyVVrwEntF3zNY9j8F9UNQ&oe=6A3163DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4dZ8_K55Z0Q7kNvwH1unZK&_nc_oc=Adq_C5CLrzjYU4l_dCGCR0Hg0easWj47EmkmbhH395LDE4qwMEkO6U645Ads6KH-0RI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m2ATFz62zAA_A0T0yNqFFXesUtRNLuKVyEPC
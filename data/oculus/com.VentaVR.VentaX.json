2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1EkWJiPF8kQ7kNvwHixYHQ&_nc_oc=AdqM9bj37pYhkKse0MlkfMUlr_94Ezs3WYqf9QeH3CSckUPjE6RRUhamcbW8EFDuV9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFkyUcK1g6pg66OgVSsGTyKoHl3BZWW5oBqJUR0Io4BQ&oe=6AC26FA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKmGCtk31o0Q7kNvwEmSYga&_nc_oc=AdqwvXlG6I532EdNDuSnee7GdMqCQzXb8jI_q_HbPGiGApjJTstxWYrduVs_GrghJjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObNWIMio17Tqd3Q4rZ20ATbjS-xRTC2e8nrMZGDWWPPQ&oe=6AC26A8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmDDJLPGxx8Q7kNvwHDh8YQ&_nc_oc=AdrW_EOaDRs_HigetnOZYfz6VQfJ6P_Xp8jT_3LVjXhkJWLLwvHVFnJU5W25NGkDTX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwzlUOtr9lIY8_Yvpke6GMrYfS2wAc8WzRha8IT4XiDQ&oe=6AC262D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBfkvtdMv-8Q7kNvwHmaAUv&_nc_oc=AdpbYHMrQz7LDJCUX_8sbi-VMiIWLilTBQ9abHFZELuKDPlZcFEQ_LTBr3BkLuGB5pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUEXKUeTo6q8z3iBW62_oV_vo9nwdY3VVqKQp2ILk1TQ&oe=6AC253CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msbaMzoOS5AQ7kNvwHjWWTl&_nc_oc=AdoTDoPOVV55A6WOmkjeO66EHld8hxNOB-dLHokYoJaDuC1eCk4Doh_fXw-LuYOW_tw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3cBWrqqN9vXwb9uPWqMBBzdPQWA_h2iyNb63Q3w90BQ&oe=6AC268DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBCJB2hToJgQ7kNvwEflaSh&_nc_oc=Adr-NNiHOaYqJkIrlM5zvEOU3hO0QySFowxG6x9uLMVjL-is9z_fQiRAJv2DHj5WxaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfayDxFRhfDJV7jLhbNKJSsfjbX4FqHGye6aN
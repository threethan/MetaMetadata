2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttt3MasRJc8Q7kNvwHGEvg0&_nc_oc=AdrmuHP79mSiBFnIfShwcyeaybZRLygbtb9ikXHH0xCr3yhdGUzp6-sVSGrArvj2fZA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPjL3WEORG3t3SWN-iqE6YF3Wi0a_iJY2vhD_1y4JKOQ&oe=69C668E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LenhXM21xUQQ7kNvwGYcFgY&_nc_oc=AdqWwBwmovNdiL3wMgqOz2UpcelpW6z3RTtaNvIOESdRpB9JrnJKM2PQZwmEdvQAE2s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzY32jIM7Wq10AiJm2bL4Dmscd1Wh5U4rcw--K768W2xQ&oe=69C663CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBh07pM7dgkQ7kNvwE2Jwoo&_nc_oc=Adpp430Xc1DAyNW_vmiUQFOrRBps7diePPNKTVjW2NgK5igff5YZDAEtK-6mriLFw1s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5nPIGQINjNPHbKnR1ERN4wAfoY1P0LRgZSEO7Cyy2LA&oe=69C69453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AryUsMJeFRYQ7kNvwGOlLiz&_nc_oc=AdqrvwsVVOAyk6aeXyAn6OolTCLhRRozuHbK9m-eoWd1Pfw-IakvhZpvNiCl6VXXs9A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxGGdukANdHm0zxfNu_JJjqxA5G2Z5HZQdCAFrppksrg&oe=69C6854F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEmfUbPWqPkQ7kNvwEsS08a&_nc_oc=Adp6JrjLsKErbWeZcJPXqonf8PtaE_Fedc7D8G6h2feHlDTI_419zAtMoung0y0ClHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyOJVvHeNkAesAVulsAC-RkCnWxb-ytvcIxvii_lIZsg&oe=69C6621D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTlFkbjQCQgQ7kNvwGlF9bU&_nc_oc=Adqmxq4VHugSZiblflN9543Y6oVatjmRMS_3IMv8NSEWZiAPHFkpo-KuNe6bvjaDWuw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0AQgUiG9fENBgqPjylD5oA4ESc8ZjSitNfKs
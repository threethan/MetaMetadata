2063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2jIWCEYIEIQ7kNvwHW8qAZ&_nc_oc=Adp3HZcpLaqnS4s7sMoVXDK-weRjJr_x6p1ygfblapUQzWc0TQ076B-BnXAMH6uomSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2S7gmgdG0cHMtnp_TIY0CgW1EDdZh2Jq2vLHB49CGKWw&oe=69E0FF26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Kn-KfJHsEQ7kNvwHUVa4y&_nc_oc=AdqTUxa6XN2oP2b_yefWf281UQ3TI3lKTF62B9tQnsdZmdv43Q7NVn4a9GPratlr7uw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1624f41CTQMAto89-Eq1QKKtBwCneFnvM1c9uVTTykRw&oe=69E0FA0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWt_L3O8PQMQ7kNvwFegwfZ&_nc_oc=Adq0gmyEPZqfVLwaPFgbGPbkakM50_1-8l9t7VFfZ4qFN110V9N8CsujmvHOwK_SqQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DHWqCq_dByMmp4JhMtv9lkomyteDNAxBMXIbRx1TzwA&oe=69E0F253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPxr3LXkrAcQ7kNvwEW69As&_nc_oc=Adq8mDlZckrfSFqU1IsLgww-yrz19UEOqn6WQrVAXZp5xtTrm0_yUkARhVEzyQgZCm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OPNV88iPwI3P6kxFy9pOOVxpWDyhbGz8xte9HlVtpfA&oe=69E0E34F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFUfVuGCSM4Q7kNvwHTHgdB&_nc_oc=Adrq3hqNKj8JgRkNmcG4btTnSa4tFjvZgi9-_Ao7PLCd4Y21aLNxvy6UkVpOiWr7Q9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2phBb6eaJkPLqD9dK1AIv8iTrfHAj3ROvpIiXbZA181Q&oe=69E0F85D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPNh9DZ5QlIQ7kNvwFLnqS8&_nc_oc=Adp2FVPIuNKdFQyAgPk7NcQmmfhzK5T-QcUR5P0g4dosWaUmZbPkAoWqh_-lmuHXtWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gmVfk7fYaPdJljPmgpS7ci1S0DrTHrPUL_Tu
2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_4-uXtT-vkQ7kNvwFXcc6I&_nc_oc=Ado40coVDIBUhnZeIRz0oETmIx1POYqEIIjTUIda-x9_tLJZGgBAPCIGqJ9OawQllOM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISWnphfXmBjM_C2b002Ml_EWjgFIqpnwS_4nSX23cG4w&oe=6AB14C26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P5I7EVZwdEQ7kNvwEO_sHJ&_nc_oc=Adqf364sKvlsyhXQJ8ET4POlWsBsw1SH2HEBymgylTGk-m3aFG11hd_5vVftO6FeH2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgiEuJ2l-rwKeU8RjBfPlF2LA8VtlMzu5mcmaatKvOPQ&oe=6AB1470B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jaXmtkhtKoQ7kNvwESZx-n&_nc_oc=Ado7PTwXBK33swDbsSFrPZAKoY-jAXXn907UJezPNIorfsJ3JCBNMoalffpty4u8DCw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSf2u2d0Fiwz-aeva63LYimPT6rX_GEvi2IHgkNg39yw&oe=6AB13F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVNTZwE8eRYQ7kNvwFyz55u&_nc_oc=AdrwSCPMlRXTc82IVPnqbhi8Og7J-wfrwSn4VFGHqs9pwhTE9emHFnoXznM4fS_B344&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYlRYl0YUvZbyRykzA_8IBrbmGhSfjwa_iJTopgnbrgQ&oe=6AB1304F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmk4-QxnAeEQ7kNvwFD5-xZ&_nc_oc=AdqLGIjcVr3tzAA3eKzJu3CEJg24cfwPWjPzEC407yfCmqN7mSM6Dt9vjsqS3MXcfdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxKueWH7r6MKCSYukwn1arlnqY9Ws5dNcX1nZgEOO4Eg&oe=6AB1455D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juDnHkWAGC0Q7kNvwFCQ25N&_nc_oc=Adq3xzEK1VPlPinKHFSwzxEUxDW7yp2yQxslksVovqB9r7xnA-qOe--DE2fJvSqPEPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4pQDD0hCN7zPlfDj2IIIScveoN_DGOjaKrJM
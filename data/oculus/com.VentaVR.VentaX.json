2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ubjc_fv8k4Q7kNvwFwv7GO&_nc_oc=AdqdQx_1cjpKSepID3yxu3Nz7sbinpF0s4YQwYrz9NK-S1ntEoVG2Z3gTIpm6NUifQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z13QGs39yfH8N0o1aWo4Fo1IGehNW8vvQnejnfd3QDQ&oe=69FA0BA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOke_0-5thUQ7kNvwFweQwB&_nc_oc=Ado489N3QppantnprAaejelf3BmG1OMNRi5eJ8fBKv0MtooIpblxr-KpUUl2TC-hGxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SsmyTttKfHcDar8WwUo4Wc6oyyjLIC7gnyyDKIWFunQ&oe=69FA068B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3sLIGWx9X0Q7kNvwGPHwnL&_nc_oc=AdoxnbaiNm9hnNnjVvzKUYt-eyYjQ5768fq4qyv10nYApVjQMm_otIGBr8UVvrTQTDU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7srBWX4RUqvdPp7gp8Cygcqmjy8Xgvl9_CKhfC1mo7ZQ&oe=69F9FED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3GnIEr4EXUQ7kNvwFCD0iw&_nc_oc=Adq8bMmHrieVEWyHE3tuqEDwiCTtA_NFs5LziUf0C98ATCGdlMmSttpYcmRwEvRpRC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e8Ci7AHwhO9Y25mGMtLtpWNYxra_JpVLVXzmbQvGJjw&oe=69F9EFCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTGLzDGwKxkQ7kNvwHOOPBv&_nc_oc=AdpKXFTdWcIueuR_oPp9Lix9vRyfHSJcTN8wjn_42fPyUnmfLqv7-QZT6WgDj-YTLhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZtjlqI5xaE9JxDePcF1ychSIFaGRWnH6d3VsyIDyVXA&oe=69FA04DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zprrI9HvqEQ7kNvwFqTeyL&_nc_oc=AdpxQjMQy--f1VZyGV4pRfVM2u1FQstNHSwXmH2gOm4jM8me5Ai4VKXG2MLNUclh8JM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64U52Twq7BH8B6e982YDg_RLgunNZH_8WFhQ-
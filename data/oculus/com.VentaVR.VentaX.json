2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4glkw8McafIQ7kNvwGCVHHO&_nc_oc=Adof9tYwWsP-Ozf128Ugk2WVIjPrQ4f60LddZ9AflLHwuiaeVjYBrdZ_6UipfsztKCQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzUPg_PJ0rBwqH9vInFIFZ5lHdAmUxsursozWFBgRYJw&oe=6A5E0566"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyR6_q-zhg0Q7kNvwEXYDJB&_nc_oc=Adq4tHoSLKZz1lSYiFq9dfn21Ace8UW_0DcZwvnPmBaXdeV16_RVKLDLH9VubrxFTVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJBwI42Kw6kxL2bWgke6vAh1s90eZc4Pl9mMNx-ankng&oe=6A5E388B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXQomj-979QQ7kNvwEZHivH&_nc_oc=Ado_y3Ju2YqWDZtJjzQwyaedmtZGmaxfqICV1fqwm5pN6Xf-04jc6mfxYnBkghZZFmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjeo3c3YA-aaA-ynjgaTHSGYXICOaPPZYADtMZUghtkg&oe=6A5E30D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2Xdu6uU9oAQ7kNvwHMsYKQ&_nc_oc=AdraIte1F_f0se_-A-pDD9QeK7NSJtsAWeGpmNTrFDgZUnVJpEVP38W_kRKP-09hu6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm5bdVYn5O1JTvzhWSFSF-umERmiTbGJ6KvqiXFoyV7w&oe=6A5E21CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RslED81eitMQ7kNvwF85O8h&_nc_oc=AdrffsKKb2nog9mlb6-p2VE0EPyyyxw4IV9COTioEwh2_mtNmQRD7dZhibWR6vM9B2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlZJH74iRIL4MCExPmjMatNnPV_d9CIi_8NtSA414_Sg&oe=6A5E36DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CDX4ecnz3wQ7kNvwGOJfE2&_nc_oc=AdrOFsd6d24MrFYolP8WSh-lUGKDrPQ8mfhU3vxHraQ-NZ940TDlxqpEI-YApmO7qbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMxR26iB1kJKYtzXOFIoLO2QFBcmyMYwJY75f
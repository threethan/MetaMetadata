842063", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-JgIFeMWEsQ7kNvwFCPTMu&_nc_oc=AdozTKNTvGR6yvfUkZe1LhMfZfhl0E4tRU1o-0KkB4pxuqOigoWylqqboY5VQscCngM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlv235Q0hvpxyncSoPDE8XN0QPIHMCYNGkIgRd_vv1Rg&oe=6A7DA966"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCHWycAUHDMQ7kNvwFmz0xj&_nc_oc=Adqw3zUw2d9ij-O0gTc-NPx4Y9ax4AYuzU-nhzGcmwcKA9Ml5z4bZFEVgxUI20qRg2Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExVULw6Gr4mKjXp0XpU6IaLp23XccO4iG5Sumw5W93rg&oe=6A7DA44B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFIH_ZUSMIwQ7kNvwHdkK0q&_nc_oc=Ado7Ma3zLxLI6AR12IqN1q40FNOsEH-gLxXx8wOlHytHLFRSsqYOhQWnaLZGDexwbzM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkZ3xr--Ku0pAAf6p9yRmBQq7ecil_zY28Q2-p_QffHA&oe=6A7D9C93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Hpl_Hg0EYQ7kNvwEHn7g3&_nc_oc=Adp_rmGyVT7XhCWAo69LqJY54mICNAlVcOOuy1bE0g0tyxiYe0FVFn1Z_2eKwCU1k4g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfje6E-W0wSMggvkLCvIhw04Z4oNJWvkBdePiLUQ0EmA&oe=6A7DC5CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OclhlGXKnjsQ7kNvwHvT9bx&_nc_oc=AdrcbhPYMFcfaGSxjWrzjP9EUHSMJNmX1gwxZd9kVKiGITX3P4g6nuLuP2KvhQ7veEU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECMVFokl_xC4RAWVBgXqRp5lLdmdH_wrJGxT_ZZe0OlA&oe=6A7DA29D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW3WsPHg7l4Q7kNvwEFqf9E&_nc_oc=AdrB5Q0tqO58_FixnT9ZZVF4EAdjm2zLmFP8q880UwLpYB7LCoALwB4YZZ9yzxhjaMA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe2RA3G4_XXa_JH5zGXFiz6g0PxBYnGSf
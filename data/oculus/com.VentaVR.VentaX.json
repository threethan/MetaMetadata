2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1PZthuU4kwQ7kNvwHbnZ5e&_nc_oc=AdrzUGJsclsBN_QKTnW22M0JNsbdrq4dJkTRrU9AGqxI8D09DoNXPSXNVLSx7MBDH8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKjJmjfjX5FsPBUTK_pkfIpilflx0Vzvh4EOKj7IkEbw&oe=6A8986E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJwoy_sDv1sQ7kNvwH1prwl&_nc_oc=Adq_oyylvxSmXYSGVcOUULDNtPMXkmZFoYM4N109p44AQIHPWnDRHPyagGVAjXZPZz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmGpRztSNM5vmAumxLJTKKv7DMCyqvuzMlLvxqszGDdA&oe=6A8981CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d25mCqO7LWEQ7kNvwHPH-nX&_nc_oc=AdrS9mZXDj9y0UrhHZE8LFWh5onVI1mf0Wbsm979MBCEXuD0gJm8bTBXzUDQ7Ojp5e0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLULkzqbPrZk0383EmsYiuuYw8dgwfLFQvbnlCa1790g&oe=6A897A13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gijW2osEnnoQ7kNvwGv4IuO&_nc_oc=Ado3A_nKIRZGpoecD-v6RugFzhfT-2NRf6IcNFug2oRd27UL-Cszl5wEaTJLnoxx4qc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgfp3lWmPPKDc-Ww5Q4pfXy_7reWl25SOu4LjzTGFLDQ&oe=6A89A34F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1_PxGt7-7IQ7kNvwFG8NOy&_nc_oc=AdoB-wIN1G-NQ4D65nfDcBTYHDmM7JvHAMuqNT_9n2PiHqYPmLHACkDKKqp3xHC4aXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrCLSyzmZLZgah7eznxHgsulqzZyDSUl0GLnHPD8mAWA&oe=6A89801D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZGHySXUzuUQ7kNvwELKSlk&_nc_oc=AdrZYRpxptYOWU1F3g8NS-ypQDNN0PeqDdU1gZwSeLDvkVJnQpGV4R-oK-l-1S-hf18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhlCjlGaSK2wu5YMocfk-cYPJ3I9r-fRbGawI
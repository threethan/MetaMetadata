2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsy7DI71W5kQ7kNvwE69v0E&_nc_oc=AdrZSSh7k2qBOLWCWxTtfSRlmDUenUyzkgTBzyFcKBjrkAkGszEwqSGTR9U8n8NZQCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA04ty51egI_8SLRc3ofr1LtBSyn9URSFKOgM2Qrf1vMQ&oe=6A4D1A26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9AVxvwRxvYQ7kNvwGUqaNA&_nc_oc=Adq4V4GMbivCFi_VfH-TgNuaDVVNx3MmPhHn_5gYg84-hsNoMD_X9wIrorV-ZG_KMJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnEdnY78Tdzw-6Sbc23waf8sMxpOK_vHhIkHXP_xm0fA&oe=6A4D150B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWYq9PTKleQQ7kNvwG2Eokc&_nc_oc=AdpRgeXkeEQrIWylKMvum714KXMbGjjW2eX3n_pz7Ok7H9BaldYKJ1UuDtV__qxHKv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2sZUchS_dqqroKqAC8LfsbWg00rKDRjRmcmxZyZpPoQ&oe=6A4D0D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvullaOMSqMQ7kNvwHknSR4&_nc_oc=Adry-U6VfOO4F799GYZRJ_ytgG2dzASSF_9GAvpxwHmbmuWXazWhAtDlLgSdv34QtdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASWWI4KgGDFsJOVFLszvgFVI8DjCCQKuqpGCdMvL-rZg&oe=6A4CFE4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou5oEvz0mkkQ7kNvwHa13yX&_nc_oc=AdqgGEr6LH9PgVsP6j0XnIKy0tjl_g9cCkTGtfsLinzmj7gVvPzvXo1iLHnoFmzjNhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrWK4lzfXIZ8U3Hhz9iY9TY-deFW6qZ45LGV7xdMnxWQ&oe=6A4D135D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vtnEH0L204Q7kNvwEuvCFk&_nc_oc=AdrKg-R5TcQ7NkBYoqRBehkMcAmQ5DYgEPk079To7tBUWOIyyA7nx6U5We5aBmrDmmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDVt6ercY0tNbSB7KDh1UtYLSL4KPT7MLrTqL
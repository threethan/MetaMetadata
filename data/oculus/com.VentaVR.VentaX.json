2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbnboHTlLmsQ7kNvwEYSdSH&_nc_oc=AdoanW92-uAWkyZd1Xvibo02QoyzX_SBwu51TcA9UzbpxuX0vCFfVDcEUa7HhfFJHBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X18FqIxwMMun-UDvirn2u-mA3Byk0qGXRmy30eTFa4Q&oe=69D8DDE6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOIDi21nePsQ7kNvwHx2AMm&_nc_oc=Adps5HZRVPkxZCx8J7zCuBOhJyuZrujQPD_hC2VbFdSxFcVElna4r0r0BN6lcXWKSW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D03ekFYpv60JbG0P2TSQpYBSQERGSJFvbbD2S7VjPYA&oe=69D8D8CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRKgAYYDYHkQ7kNvwHWyhJA&_nc_oc=AdpSVthu6rK7HXAFXyQycrnItpugs7WUnJsxI2efUPa5Tk652YMZTyG6JNF3Dc8UVxk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A7rm4AgO67zc197l26b2A0j-rlhYttb7_IUMzx-m3DQ&oe=69D90953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN46PrQ5944Q7kNvwGSnFIt&_nc_oc=AdqeatKCyKj6H_R3ABEsrG79xBLgTopADRN9kaI7yr_Uw20bMKAKHT2DvIZ-E14ZSrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DRRbdEAbCAivJZ8mHnDcZQn40IbhacvVcYra_K4sbSw&oe=69D8FA4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4IAYlEeGZkQ7kNvwH1OBrP&_nc_oc=AdpG_l1HVSjYPonJ1FHA8hqwgMuIBAhQHeHrbJTN1_8JGMYJiDN3Tu8kYpqYm_tIkhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nla58aqsoESFGbTqIogVhpZYc_1NKkvlYSnWOhF3ZIg&oe=69D90F5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYTi2iO5SfIQ7kNvwGCQCQc&_nc_oc=AdqLlkCxeECLqJDiVRGqFozWYuXy-492GiKYaVQpTZK968JOYSEpJU-Dd5x_Dt-R5aY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CqHGhwcPBsJtFHWJvqg_C60-c-Qw4falO1ip
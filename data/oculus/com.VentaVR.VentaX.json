2063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf6TRU72_CQQ7kNvwEhdevT&_nc_oc=AdpBnRP0JDXI7O0T5H3UmmToXVcJRNOmuMNrODr4G80NksyLhG_J4NXx4gO2FKqPtrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uAsl5mFhjOmVGRxpNmY54hmwI0m-3mQM-yUWxqEPnKg&oe=69D27EA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W76z6yTNDfMQ7kNvwHJ-H3w&_nc_oc=AdrNwCXr8YMaSYJLJrrQlwDv11q-74deSMOVdZyik6SI3D5U_gSi4YHcRmWHj3K2iNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nYxoB5QVEMS9GXL6VO_xHGSZatgmLbvs0vbP3E96z6Q&oe=69D2798B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abFweKHKHCcQ7kNvwHzGJNx&_nc_oc=Ado3KYq6XjBa0x_3KEQpobN8bM1IsscbAI14RCk7hFZ57WMzu866mb4Uyma_k8QOsJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jGBuptzb5T7tyimhAaS_ddpndRysjeI2ChAxEz-T9wg&oe=69D271D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUxJIa8hJEIQ7kNvwE47VhG&_nc_oc=AdqeRpw1_ss0I5ypX7i-8GZHhPXsLvFCYm-MSWbWuT_XDIm91kLK9x3zVQ40CKx6ERI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aSCKDsG_Slqo6DeaNc7tBHzfr5MhZ1DupKCn-mGBfNQ&oe=69D262CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AL3v9BHBzIQ7kNvwHM6-3D&_nc_oc=AdoaUnDxZDvPxAqZ20oDz5DUuNH2_O3Ga1EYu-HNDQEh6PlilfzXuUxECRXAsKy5y1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cWMDBlZdvE3QpgVk2_dmE6CGeedyvJKDnIzksOf-ncw&oe=69D277DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7J4GVgHmAIQ7kNvwHc2hDz&_nc_oc=AdqtVLj-DZl1RNzYj9ziRKGbSTl7GEpXWuWorHCd6w0XrBsLGiVG9MCUwKxxjSO0ujk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05MrD78z3DyavVycXFnRM41cZlOg73DfPk_Ug
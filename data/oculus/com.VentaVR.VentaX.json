2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4PFy7p25IQQ7kNvwFckGey&_nc_oc=AdrIq7FuIyyayswB02POUlEWAx2M8uviYz2N6Leb0inI0XheHCXaswdsdCGuCUv2wwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82nw1o5ejpDwQgJQtbczo8H4nFNXlLC-5siyOkETHJLg&oe=6A3AA526"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGpzrsri4lkQ7kNvwGjkB1j&_nc_oc=AdpJHSD4bQKj1fqjuhoPCfgRjeGT_D0IC0A3Lj2x8e10B8fkUV16y8aj9nkWJaEwyz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ITdCT0QILlhaYqJD6vR9zGEZQWYT9VcOoGo-1XqA-xg&oe=6A3AA00B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_O_xrYbjmY0Q7kNvwETLQef&_nc_oc=AdrlGvySA54crkHOD_l7eCd5D4EKi9uVxlw2Bl3DAFctgJkoMz0W4DjGy3cBbEQuqWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sWH-JJVo_8Wx_lq0fsImkD9DfdQCiA1tNFC-cTR6OdQ&oe=6A3A9853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyd2tf_7iTEQ7kNvwHR4jy7&_nc_oc=AdplQMUWmU-RMPmKw5BOq_sfIhKIs71YkQY0g27wv_wKHC7WcadhtnxEkYVv6RAn1io&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CMsUZbVagyvkRPuYDVj5qWkoaj0V5SPtYvIpGJV9j6Q&oe=6A3A894F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eRM2uaJyE0Q7kNvwHufyW-&_nc_oc=AdoPCBdaFLKLWpFJNHmBN_oPrm9xy_SxxKCpvFEBQsgkIcpxIxvpLASNR3jKClg36kk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9n3TDcl82ktQyHmig4Wcpl63tlVgCziuV_vYzNxC2zw&oe=6A3A9E5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgqXokDwAJUQ7kNvwGBbPhB&_nc_oc=Adr36xSz1X86eHGrwZKcqPkjX4cdqvBTpvsu7bCFHMLLtyjT-hTWxf_YcnIHKjLdDNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af911rpcpOYHJi7-zJ5GNZ7Aj1wLd5owxt6MwoQ
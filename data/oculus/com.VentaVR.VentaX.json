842063", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4PFy7p25IQQ7kNvwGemlVr&_nc_oc=AdoeWe7X96qFR2ie5nvsu9l_ttbcsN6mrFa4TUzn4lQXFpIIycDJkuL_IFoXGLl56fQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IyJArUAQD51PQ-kCtGwOAuWhRTuhaLLvzb5A4SzjM4w&oe=6A3953A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGpzrsri4lkQ7kNvwHqyWeA&_nc_oc=AdrHJeXjVXKS0IJ52JWGcS0rpBMIJbqJ18Q2oEmQNEJj7Y9XeK9fHhG_t2JUa1sLQu4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KCmA7DpIYBWgVS1tKdhbfXR74QGFyJRJ6TPhXgt3Ogg&oe=6A394E8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ea1I2PfALQQ7kNvwH6g45h&_nc_oc=AdpCECMoUDiiFsy28kmZw8HdK6lZrHEAuaYVA8XkT6J5mN6fqLoH0NiBjPZc7wPVYcA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j_9sMhaeg2p2seWJZfCWq7YBMyZX9yHnOMPOdL7k9SQ&oe=6A3946D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYYYR3_838oQ7kNvwFkw19d&_nc_oc=AdoIKTG94YsHBKUxSExvxahaKoU3Cij1jWSWnCw48dBE0qFTM1yHZbBTuVZgMMBUlu4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jb-DVXHKcTjAMtAnqptMq6SHeHQpl5V0MQmd_zP0-rA&oe=6A3937CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eRM2uaJyE0Q7kNvwGTgif0&_nc_oc=AdqxOtHMpzJfKyxOKx8PiV3RDy2vioT3f70J8y6yJLwzsDRvFySdtQALe_0ThFw0JUc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P26l6HdCx7PdoG1K9FIxruYYYSFqjbftnp8QmMr-Ksg&oe=6A394CDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgqXokDwAJUQ7kNvwF424zx&_nc_oc=AdqonAsZdTXYlpMhzEOBs6sTTHWDE0de0aFEVF8vhXJ7AiF8sV0T3P2fsflQaimqKvk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Abv4Os_avkZ4CqdGH-HrnvrobMJJn4HD
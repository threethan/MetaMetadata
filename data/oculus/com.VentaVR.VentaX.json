2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_4-uXtT-vkQ7kNvwEYsBva&_nc_oc=AdrplNCj7GstzJCylQlA3TTWkxckWWu3Bf5CHpOKKvDj-uSUrtYJC03t-d2fAFNAEEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfDkZikuvCQkjrw76bysN5ky6DNcAl2mPHbkf2s5tmyw&oe=6AAFFAA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P5I7EVZwdEQ7kNvwGMvEek&_nc_oc=AdoHQj7DC-qiok4sNuJgvu8MXF12Gx7ZtvjS9L6arxx7wdJPKpRo8MIsPwGRbIj888A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgE7p-AmGl9ugi6i8s5z7xzLJigDh9lbsBvbob0EpKFw&oe=6AAFF58B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9Ddgs0C6eAQ7kNvwGkEIsR&_nc_oc=AdrjpbvTWUN4MypfAOICszi0uvrj5GVRhutXbjdK1Ox1FMtvvkGrc9xcOWnkI8hvHv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeX4thPMu6vKAbnWhCY1naH_jKcPoEdKSto-PyHtu7dw&oe=6AAFEDD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9fxQYUhIRcQ7kNvwECg925&_nc_oc=AdqTex_1PNqQPqn-jqp7izFf4BeYJBaUh_nVuCdS-voCFrLM8tDzpPjs5pdZKRGCrcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOH6loxJeZH2vjGf7d6t0W2B0hNxMActqld8AwOcFwTw&oe=6AAFDECF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmk4-QxnAeEQ7kNvwET2vfE&_nc_oc=Adooa8NY7AcMvbQZ3qQ9Ux70IY91wHaBJNaZMGTYmOvyGyttkYbl3Qqutq6NLIl07Rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqyGIwc1yDwE_GqIqxXvcYnOw956G-68lSYiWdNzjBQA&oe=6AAFF3DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juDnHkWAGC0Q7kNvwFnlloM&_nc_oc=AdqhH5AAUsm0ufzhqRK8diQJ3mldQ9Rp_vXofNDTodYPTuLv-4WQfS69Lkc16VelKNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR6XGjpDCLEVt_mw6K2iHvmUVaIc6X0rNnIic
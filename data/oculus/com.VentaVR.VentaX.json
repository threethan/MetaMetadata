2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_8QsgYJvq0Q7kNvwE4mMyX&_nc_oc=AdqlHlok4nlwhvq5q5WfuSbz_l0bdCiQXwgTHRd7zEaulT8f6IuKNei8USXPlFQIQvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKVKc1GDoflS7e3Y-8tjVNxTgLHf1r1JcbDuTs8Csung&oe=6ADF70A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI6LyjxdNjwQ7kNvwGLvD8G&_nc_oc=Adrfuh9LoGxUUiPlB8dzTZgYNvG1_iQ2A6EtirPxpptcWY2jsbb5tbg-cAfKRz5y84U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOurI0QV9cHiHVDAkBevEl4q2Zl5LhQyvDftmoI_ml7Qw&oe=6ADF6B8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caPCAO2TZg8Q7kNvwHN_lwQ&_nc_oc=Adqde1TuqB8bQ6nhbPEc1PmzUe1XGiKgKHanDLRb0aPDeEQlAcjjATQT3cSTE0PtJGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvWTAKr4nUKhdNacRJpVRXg1R-F1PNwO7R03vxRQdIgQ&oe=6ADF63D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g6yejS8W4IQ7kNvwHCEFhR&_nc_oc=AdqCMEiro7-c8v7hE5yhS5TG-IrAapaVOyzMkKTbbi5A8RLkT5V-JdF3ofTI4Uebww0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5A7VoqXUwzZIU75AImPCTWdstareksHX2RdZMyaubwQ&oe=6ADF54CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4ES8Jp3v1oQ7kNvwHtRW02&_nc_oc=AdpBZoB6skubHHxIJM7vwrrNkQ_4y6lDwJaFK3NdIcSLR_Y8I0rMhTX9oScWzvIX8i8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5kAML9WWn9UF-mEOcq8MUmQ22MkudNajb0MFxqQseGw&oe=6ADF69DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIMc6UqUppoQ7kNvwGDuJOy&_nc_oc=AdpiWwjsMm9SrlZ_ZIBF55z0eXkz4mD0A_nZoksoK2x-AhAYn1TiYRx15ZOhSFZbbP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGtnKcXDYdBP6_Ghp8dXVSCLBC00dhMOgEThW
842063", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2-ZAfYPQD4Q7kNvwGLTdtF&_nc_oc=AdpOTK5w1uBrLs9TveSa1yddgZSEmz8NLjZWo1j9rKEhPwqNZloVNI61uB2TnWn2p9g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65JDc_pwdJFLwO8M7VS4ccN9LujzfIPLZyv2kOTMWn-w&oe=6A11C6A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_xXLmLxD2MQ7kNvwGAGOhg&_nc_oc=AdqTIxlFoNGw9ZevwQ81LZH_hsMzTpP5YNmNEJWvIdTx8sClZk_qOuYorDDWkTPIKPw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NlwTexj7RZCQFSLGERUIrt0_ru_VFrHN_BMudA5ENug&oe=6A11C18B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeiGcPTSRKEQ7kNvwEwhTZl&_nc_oc=AdodR0i05maGXlTj0UB_yxCxSlaMln8x09nAFWKOSL4cameUwHOb-Ubpf0X71sJ0OAY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tx3iIVeoR27EQ6tN4dMv9HQLTMTFxVeNNInOZonp66g&oe=6A11B9D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vaqe6B-kB0Q7kNvwFvduoq&_nc_oc=AdoAb0SDkCUIElKdJnTWi59il4g0X_29XilKsiXnaERYvW62MFHLTSgxfU7KpPSGNQE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uc4ZVU7hvbR2waVaxtJafBxVBkWh2SnJRjp6oGRgVeA&oe=6A11AACF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGGmaZ0fOVAQ7kNvwGjY1Rm&_nc_oc=Adr5qLcz3syeIPe2vJodXXb5rcIT9aTBBZElDyZUulcqgtGq8X69MeG84E0ClhX59I0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AG7Ql7bhSJoLPU33RZWDjbhSij06NyoSz2Te0vJg72Q&oe=6A11BFDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rxBbLk3hj8Q7kNvwGROHpI&_nc_oc=AdoyfXnAcO-kSGE7OpnuH-nUtWCT2zuwyHupOo7kzRnu8L63TJjrAgUGYJ0JUnZP8Jc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZYxx1hRMF3GFx9m4wA7sGltxcZyhOImo
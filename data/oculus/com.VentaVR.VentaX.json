2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHmb_YPZBIoQ7kNvwFavp2M&_nc_oc=AdqfyLBVtzETC0HY0jGaRs_oWGBrQlt0kBRIps4DbG3ropkoEfTR2S1OTxam9rqJR7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVpHUmyZxxvP59_9mTqJ7cccp-VsTHzxsGyM3Yz5GwQw&oe=6AB540A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVx03qBQlDcQ7kNvwGeUAaW&_nc_oc=AdrlROb9l531sUbD5BUGXHBC3i2abxFDSvOQTBwtomnHOcHa3hOTJ7PAvUYsKj0W7IY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyijFbOnhmJxkj1yt_QiT-TJ6GWt_cucwqo42VAbfRsA&oe=6AB53B8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqvxQOXOUA4Q7kNvwG8SxIs&_nc_oc=Adozh3dKWKRixvfV5WBNFgsmNVn64LRW6__AdPxD-CwPPbLPFSNp7mtJKQXI0mIORAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo1ll9f2sS9ArtBEsZpTrHT-iJgFgP15IvvxOYgL0fpA&oe=6AB533D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmDIxtsw1xoQ7kNvwEiI6S9&_nc_oc=AdrnIEVj_ZOxZJ6AcF3twuPni1fPXKKJZx8j-Xhje5pmR2FdCRLnfOpiuIodsMP8DXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSowZkiQUgDLXQohuS9ImJV0N_MSJTOWY6R1SdKU_M-A&oe=6AB524CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oCgi3euSmUQ7kNvwEp2Qf-&_nc_oc=AdrXnp-su7ajUYjwcYOSkLoQEmA8G55bKkv1jUiJQnSFmGoGVZwX8KRAB2y5yW8jNro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM_x3OO2BwS_qiHGkwh6ghfMXo_rV30qAbs9sld0L8pw&oe=6AB539DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGpY-by5MigQ7kNvwGklzAV&_nc_oc=AdqiDRL5si4nhMbVm4cx8bnxKgJZWdmFuQ14iBq97i7TgSFiQBZbdJlzOkAL0i0bBWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLULM6CXlRzXkMlI5aaTB1RGzd-_Mag5dfpt4h
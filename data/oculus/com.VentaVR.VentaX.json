2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tROKpbZ-GsIQ7kNvwFB7QY4&_nc_oc=AdpGQXbFF4BEIEJykGwBLSAvonS5vAPstPohMNWrrclUlw50_b_KAX1lpFVAuDeaWGo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r0LFRkZl0-wY08i9o0jjIIjPtYDI-JF2KSd0oAdN6Iw&oe=6A0C80A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SzJAdlmTDcQ7kNvwGT8htB&_nc_oc=AdrTTt6thJJ562f0MpPkm7pMzrl_tNwCG5XZY9qCpvMVWzacWTiYNAYnMJ-Lcuu_Al4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vfIDJ06JYUTq3Z3yVAhY3FsfNyfaNCDUztS-lgLOUPg&oe=6A0C7B8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B3Vui-S_LMQ7kNvwGcwVBH&_nc_oc=Adrz6PY_V360-zlqCeuT-NXWAiBQunWub-TDf-3EDTj1HEiNFfb9515E-fVPHmMuMqI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hru1o-fsyjxDtKj25nMCmBV5iaqRHexTBCNRoYY6HFA&oe=6A0C73D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6y5xzL6AucQ7kNvwFtKpxx&_nc_oc=Adr1xooLkhBPRHqcGzQgG8J4X7L_-l62Ql7rqOoSTDH9rp-fpOUFMfIXVZgHDCzT95I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KNn8ST0yVzJT3RK5bX8YGUBV5KLxIo4jfsCpYQpWK0A&oe=6A0C64CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejTb_MRRzygQ7kNvwG4ygn5&_nc_oc=Adovm2zonJM6wwUjjPi2aa7c-oj5tL1SJuxVCX_1HWzuKzxVuRc8ZFIVZ-fimRY0cEk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AsmwsqEmOELaf4M37KQPmvT18hJDD20o3NgM6Kau85A&oe=6A0C79DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r7yPAQly4MQ7kNvwHbAb8U&_nc_oc=AdrC5XlDsTCYsJkPu50nOLxb3KuIHzGiniBfGBGyyDlcTozdMIdiSJz9VIh9MNX59XY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lP7j3CA_tOipNIBX0NuMqSVS7p-1_RO3LXwl
2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3Qc9nujIg4Q7kNvwHjJJDY&_nc_oc=AdrfsXc-TyZVFxH5afj2n3uFB5ToamTxW_7el7VByXC9Ia6EvxVoVknVflKo73FcUoU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmvqMyfSt0LsjBXww63ux6297MTcItFqMvklNiXgTXLA&oe=6A6F28E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc6kKjwHA80Q7kNvwHrktPs&_nc_oc=AdrmPbixbT3e_dlAymH1T5jMVU7zGjVMBub042sdUVW37vBMTBzmAzM_itbeYRNhASg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrkZm8ZekKu102cQa7SFVNYT364m9VUzKY1Xrjsxj7YQ&oe=6A6F23CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFpO-TjufpEQ7kNvwFTfllP&_nc_oc=AdrmCM1klT63uKWt8_MQC4X2gfhX4RwgXjcJ-ch2o_ro7RGIPX2s9EZmmNSmtEg5Xv4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmljjaILmYB0eTWh1Yn4m49MEp6_CKt0WTf5qLj8nqCg&oe=6A6F5453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axZ_3SyknKgQ7kNvwHhue9D&_nc_oc=Adqmg7sBL-RUsKU8xqJ_qBE8ZZmLBqDuHptxciHzfKrZijg_fgeufzImUBTJO63bftQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKDsRaIrNRrXCKdSB9J9Kt83l-PNSNeUQh1R0VQqsQxQ&oe=6A6F454F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MWpWR6aKkcQ7kNvwFLmpdV&_nc_oc=AdquPoa0v13QJ_0kGcpWafKOm2gcGkiCSPKxMd6nd6r4LZVF4kSG2IR2nsMBZpYm-f4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2Z0SY4QBzLgDy13GwK58EBjYaeGkGECNhsnnEZYaeOQ&oe=6A6F5A5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpZyd_EQSX0Q7kNvwHRX0wC&_nc_oc=AdobSE20CQPueACV76Q8CRYyBU-uM0jtSWfYEyFr3ftUEuenuTkX0ajJHsuNvBQnNlY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL-DjsG1p8dIEv0vFr5zaqtJTPblR8MhPVIGv
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FddDWCaKw0MQ7kNvwG99tj0&_nc_oc=AdrDRIrOf8LzJN_23CwIzy28AKNhsui_C8yudBReFZrt4vY_SpVNDbA5BLx2PZebgHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFB6VCnV_QM_ubNXDxr99V9Tcst6dgThynC8XTeWBZAw&oe=6A677826"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyN1f71J1bcQ7kNvwG9vZ9a&_nc_oc=AdqQ-NqzGdhXggLZSQx1USANAQFjINdU0jYo_fu32w8UTO3uqpsKNaNaD3SDPTVnMs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_3TPGrCgB1iNOX0ZY_rPlZy2wqM4BM4j9jyMrF18DGw&oe=6A67730B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP3_rOQ7DncQ7kNvwFdGwvH&_nc_oc=AdqeG1XEj1J0rFB3B9t_lCWaP27JJ2zn6eAuXcVMoOW-En8x_nmohywz6vGMfNdTfJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeUCgbKGlFia6dC9WaBFGsZ7tmCwc_SqwCUk5-3Fjnyg&oe=6A676B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oZiKECb5E0Q7kNvwGfeclg&_nc_oc=AdrBWmQ_p8j3Dj8nWtQDtJAUvjN7UpE3vTISu5y_WZFUTB-2BYp_1S5k0nGAYvxJjxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ7DBAWoP7bGO_NtZwXMbdI011ACaOt0UqHbU4G1YL8w&oe=6A675C4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl_S5ptwRlcQ7kNvwGII2Ze&_nc_oc=Adp3dBjpn0QF36iBMIoWS0F8IAU3BcDlzvmyTaYQoDLvpD2vgPoMnN7bibM8nB5Qirw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1oQ33BYPBfmBMLcRhbkB-EapvcbLzheYMSplyWgGrpg&oe=6A67715D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjzhO4PjsHUQ7kNvwHIc9nx&_nc_oc=AdqtMrGleYVBkOu1VRQa4OWIR9Oz3OsMaIZAZbfBT6lfmQSgkrhYOPpuAZXUVPg7hvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjKs4JyFmI-21p2jv71ci4kydk7TkHflCCpii
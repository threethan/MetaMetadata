2063", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QW6RiGeOeg0Q7kNvwFE2-Aw&_nc_oc=Adr9fUoaU_xWIE5XOWbEcKM45j68KV63bSJwAlpvmDKGtJzbFfgH7duNQOOY7byhtGM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54EvpEtS1s_NWwiKBoOWDShlWXP-2MvIM017ykujirjg&oe=6A107526"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_xXLmLxD2MQ7kNvwHUIZTM&_nc_oc=AdomudoTaqHcRtdsww0A4iSn1WCm0T8e3LCgR9-JviTwoH9uM8HGMNX0xoVfAkDcNR4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XJwCDhv432g4e-h0Qv8Wx-2feJ2avV2NFAB22Uiphjg&oe=6A10700B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeiGcPTSRKEQ7kNvwF4KD4r&_nc_oc=Adql-e3D35v_whp0xvpDgU5KGkS3_iZghrkzjwTJPc32ra7IB0mYQEU7mFWIv_26RCU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5238adaCMIqSkiQZwscPudZ4235COgkX2rDGSCAvYAVQ&oe=6A106853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vaqe6B-kB0Q7kNvwECGnul&_nc_oc=AdoRIHqwZW7G-b6qOkUgmQxzCoj83Bw87eE-r9rJXnXj7lEgbtZB2Sm4wI-B61wesxs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tmeDrC8GXNxqrMqZFBPAnWQ_lF3ntEeSTQfaXJ8gZhQ&oe=6A10594F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jsug2pEXHMQ7kNvwGzlWy0&_nc_oc=Adp0R3DnM5bHA-mPocB5NrDFZ6k7AWqSAxkK-erdvNObR92OzFZWi2lS2iaivuqBtK8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KAmuFTi0--tK8fpfibAOo2J_42k1CpqULtgYgfEIdCg&oe=6A106E5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rxBbLk3hj8Q7kNvwHKdswe&_nc_oc=AdqPa93jcIGGRT88-Gxktq4aYUaIklDQjZiWHLjd9sErfc3ar8tDJwbWuL-YJfAMdjk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hZUxJeys9zNJ9086UI5AjmsdFUlp7HmQmDyS
-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9O-I_BZhYcQ7kNvwF-LaAz&_nc_oc=Adkl1CXcp5AWhTiwzAKbOJM39PGnseSUyyDyqDoWO6Ru-6Kce4LjkR1jCfO7lTYDiXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxeh9AhvFJscs4AiCb1_t7XJqLzalgzSB9-ZHw6_YEDIA&oe=69BFD166"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ8QEheV6rEQ7kNvwFtlBJE&_nc_oc=Adm3CDrKM7pOBd6isNHNL_fv50o6vU3O4S8ak9yE9WnLmoCOVZHaS0WnPeBcAqiq_MQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy54X679H7JMrafW7f4j4qn_-5K8qQRks3zvd_W3dpxIA&oe=69BFCC4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGLaamadmV0Q7kNvwFC-Ugs&_nc_oc=AdkngvXAIwg0hLveItaHBgEcBNNLa_lnmEeryxCuEF282gcvX7lRY8_K120ZBImNSS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfygNJyQLxTR9bLk1xfEVvYgEtz5AGlmrnXV9jfwz8mAcg&oe=69BFFCD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfafCVXV9mEQ7kNvwFqcBN6&_nc_oc=AdknrLDW4iNwQBIkjRagsoRRdseG8AgJ0x_DnsHGZcg3i4hx3w1Y2O25CsXPNBTOnU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvfSt1zkHVDJd-dbqb-dcd0AZiO13Ar3ZIQEhxb-GFUg&oe=69BFEDCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFeCpyRIp6oQ7kNvwF6XU23&_nc_oc=Adldd1EVAlhgzraWY83tnTWyeqXyw9glOgoARMqIPGb5Rbkh886YHhU4hRIpcjz04iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFpv-Ydm11V0an9oJqmArQgUUPEVwgU4NwAVp8KrGk5Q&oe=69BFCA9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rTHwe-o-MgQ7kNvwFXQYgA&_nc_oc=Adl--IhKdhzRmFXOqhX_E-hi-161a9h9vVq-HWPM1e7rbVqTvB1Ki4XptNSzSIqCbhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnPY4Zrgvf-iPnZn6PS1Hnso0RCM5P43w4LMCadtQBmg&oe=69BFCEA0"}, {"file_name": "01_Hero.png", "id": "1
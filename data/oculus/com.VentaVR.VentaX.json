2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgAHRt2ig5QQ7kNvwHL7ADh&_nc_oc=AdriOPP8ODOdbXbcFPltS9u0VPOG_3uMofINhx4ZPim4tHsue9HB1J8iVKaA0Hd0fug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDHiHraGc1Pd6XZ0eYRuR14BQnLfi_5q--pqmOoMATaQ&oe=6A576DE6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8qQDIPObx8Q7kNvwEHqo7L&_nc_oc=Adpm-aBfF0iJNxhFR8qSTpTkuIcLTWXOaZ8OrioT28eqZbpKnTl1HCcIq0pRyTtslqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEeLvjjFOsy5JA3ADH5P5vmRc2dPYetzXC7TkaO9SPgg&oe=6A5768CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k66j0Venc9gQ7kNvwFp3fIV&_nc_oc=AdrChg5kWZ8a-fDSg3PWyGgPp5yXUkeQJzB1VmO3b935SZfJjSj32Wk__DvQbQJUzmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTkZva8XoelDHHN7UkVGoRnhhLkLsd6JeNzXAEChRK5Q&oe=6A579953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOe9Yv9J-3IQ7kNvwGqcJhD&_nc_oc=AdouSHH0oJLj5XEIiwlPSPOEM44GkeSpK6dth2HUojZyvL__EntSj8p3xGdYJ9JxJsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRQDCG7y3QgVDpBKQsk_TiUB7FjrqQ5_tXo996jOzlfw&oe=6A578A4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqM2t0nToqUQ7kNvwFgcVdJ&_nc_oc=AdrLIc5LR3rrLXKS0UE8WuhCq00vu_-DDbl07gKvCf9A3VM6EGQNInVuITtru7E58V8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8IxXOz0iDnoWQb9L3qMU0XItqnGUOzr0yP3jeJ8QhQQ&oe=6A579F5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EEuCedcBMsQ7kNvwG2bskf&_nc_oc=AdoF5w3r3O6VwKak1o3rytK9cXyOUVguYQI7DwhvCeJdq-Y4A3UzbwRVe2oxIYzPKk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMEqLZpQk6i1KCbObcGoFPmaQwDEHM8O3YtZI
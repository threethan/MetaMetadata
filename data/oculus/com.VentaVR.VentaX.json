2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2BiPgroL8IQ7kNvwFYiKOl&_nc_oc=Adro3JgCbd2ilKZUQsFgtW36cQeOCEU0k-HQZ-CmlAHLBp9dy8k-vyBgHExLlonyTu4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkPRAlzKdZ0mFTAnaK-4gdUWx6zeFYuMS9RpzHpq4H_Q&oe=6AEC9FA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VdX2CWI3IEQ7kNvwHD4d80&_nc_oc=Adqo7eqO_AMZNuGmYrvM1bVnEMmkzhbvrmAlykkpRb4xzDgV6NIw0aWEiVXjdSRKEeY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTdrcOq5RgeXPdeu0nbn7-6BqjeUSTii13zVbYJsAZZA&oe=6AEC9A8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tXUZqioj3UQ7kNvwGQwSI8&_nc_oc=AdoaKaOc78yElMbKi1dpXs__AfDAmQlO_6_sUftft2AHF6xRvFBZHO7ewdOo6KssQrQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC_nq2cqCRw2J4cSIYbOgamfMTcOScWXMwadVNy1gDHA&oe=6AEC92D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqsL6NlHN6EQ7kNvwHVJ8Kc&_nc_oc=Adrovj7cMMvKcjJM-zBVASK5sR2pRnGNPIKL3cMoxzVfuUZ7wL4z8L4L_x3kYuS1x5g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiZj485A5moKXWrZmmqOj9Bk__GWxnDZywmUPImoLesw&oe=6AECBC0F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yygD4eYjoMQ7kNvwGgJw39&_nc_oc=AdrYUeffCUj_4VoFChKCBGx8GbEe-AcXVIdfORPMJ-WE2ha9ore2sgf5livOMQJefDA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI0YPpV5wHm5Q3kkPA9v0yXHsiXGQ8biLm2fSVGgs5zA&oe=6AEC98DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aALdJKd0Xz4Q7kNvwEdzEfP&_nc_oc=AdpfkH7TN_Hhp5fCI-cGgQblzKV9WH28thHj5DcnpxghMnxgH8xsh0gly2ZGk0L350c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbqvk41eNoH1zY3rXN9PbjOVjLXMXWuoPIp8U
2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj7EhJzsTkoQ7kNvwEG-1Rs&_nc_oc=AdqJog7mecfwzX_vOPXNPydxFGk6Eofq1TzcsP--vGNACvA6ERzr1IiJJzxtD3XaSuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJux6mA1wOFu_N0ZtD5PYOCob4NFimtWurk7HEld0aBw&oe=6AE9FCA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VdX2CWI3IEQ7kNvwFbFcZP&_nc_oc=AdobSTDKkQruUa1Q4BMQbagcX3qEAC-M-AKmu6svEpCGgbWzb0i1UzmOivc-rnaIJNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgO_qj6agCuESOIf6T0JOE4de8jgEhkbLdzPOtG54XtA&oe=6AE9F78B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Je-npIqnQQ7kNvwFCXiBw&_nc_oc=AdrE6R9DpLaNBrP7gfYYrRW25YZJA4e0Ywe9pOEDSHtXgW0q3VDCL1Pv9VqFp3-n_HE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNatFksh610czaH9DWxL0ddwKPa8vRXMGr3wxBk_5uhw&oe=6AE9EFD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARgIu0YntmkQ7kNvwGXPwTs&_nc_oc=AdoZ8yF1KFlzwgY9SjWzXJk-NP-lV4tGuexWriFfczTanEhBE07rNy1pWsY5k748CD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReooq3JznCdEj39Yvr5R5R5vMP5nJ8RFwZ6r7MFiXvVA&oe=6AE9E0CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlMNrUt3fcEQ7kNvwFuL9T-&_nc_oc=Adoztr86ripmeoRkOK2RKOORziQi05ZzG0Fr1ryqsVd0nkoBUPUIzKCYOJ7_yh3R4_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6eojLe4Pec2GN1YNFtgchzxsS_CDCa0Z6CVuebveuSw&oe=6AE9F5DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aALdJKd0Xz4Q7kNvwEWiOkJ&_nc_oc=AdqtVFnd5MKQtxKbjB0qKOUq4P0jeKzZ-r4rB6PyVsmLgJgad-mWq5zcoS2bHdrdmOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiq654eYIL5P4UbWEmygkqqZ-t4KJziV4XGJ9
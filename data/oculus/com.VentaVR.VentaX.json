-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bl7oz9XdvnsQ7kNvwEe6HHo&_nc_oc=Adn29wWapR2Y8XrRgQEDceizHBCbMjoJI4PnLH0cfIjKi7-fGqw682zYwlT34IBeqjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk1NLV9ejAUokvZxin7-tCe9xq5-vTOMt0EVuHRtSXNg&oe=69B696E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1wdmhxv-esQ7kNvwFFajPe&_nc_oc=AdmU6FqQd5DmzqycdQNKuEQ3zq0SLgXWJWei99GXqf8o34dwdY83xFQKSYGEcCiY-9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN8w_EX7N3YFRW3ELTzAdJjnYpOAxhxRjfslsnOIdFiA&oe=69B691CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7_eTWP9E6AQ7kNvwHRrU8Z&_nc_oc=AdkeaGHz5SsjUEUfOEwO8IEij3dpFVLtcvjBYcHHXDFJ3OiWzzgo0ImUxU7oeK3erZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx_123tuDRqv2cLWeEZ197YA6r2ZFYl-Ikf-n2tyr7dw&oe=69B6C253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEjcAFcCVT4Q7kNvwFtCc0x&_nc_oc=AdmF6ixSvBbogE1dE6BnZGR4eTpkblI7bTLI1LkQRNFdCemK5s_34PCCeKw_UbG0CDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLhXPDihoctBaV3Al6iPE2xdFk84mllN4MBPP8JBmhbg&oe=69B6B34F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vox_svnIp_IQ7kNvwF5uMUM&_nc_oc=AdmxOVmJIHLDx0ihy_fZi8dojs5uFpN-4xycdMGN3OKBbYWx3dppqex25Te39uQlgKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXoIW0XC3RV7CRPMrusxpUJhG3F3i__-RTJZokp_qPWA&oe=69B6901D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UpuNqF4PWYQ7kNvwF_v85q&_nc_oc=AdlQv_IhKrZuhVd0OSLX22nZ5BQsgJqyOSNja8kYeZmjmT9ff8hFNvgYYo8tiqn61SU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIofpr5DMHVuyJNQP21KDb6Sh8JbWU8psNn1pNEIFRRw&oe=69B69420"}, {"file_name": "01_Hero.png", "id": "1
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3KA8zqy-q4Q7kNvwHWGCjf&_nc_oc=AdpU8xVs5v8d9yiuLvKEXqjCiX13hfVqdOlh2FNfF0CMG-cj4sQnq77NorWaBskcFQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxnTlmQEehRSqTio3NoMAyrPJSq7MAexr4kSZ9vu93mQ&oe=6AF5DA26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye6C9sn2g8kQ7kNvwEO_o8q&_nc_oc=AdrYCm7bIhNxkch3IVpTMQfG4svBoTQDWD83KA-bz2qf8GG3h1PQ3cOPMb6V2BLa3_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3Zyw7oDr0a7rnMy32rQGU5m13f7QCG7QQ5GYUuMgkzA&oe=6AF5D50B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwTN88J0XxEQ7kNvwG67T8q&_nc_oc=Adq4KMUHdNPUfSWBtsl5J4lDLqIpKumkmYjIFfiE1_C-x-VnrCsPAmE1BJzvgnCXs4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlDXdcNpoU6yJgpP4qnIU1a62VPG21oD0gHvC1LzXQBw&oe=6AF5CD53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUC9XgUUv5gQ7kNvwFmggjG&_nc_oc=Adp8Bc9FcqQrX7m0fQBJJx4hFExdbusnKPwt0nYuV16Eg28R2rFVHYDVx13NLQrniLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzCSlqffg6sjFS8ltzUzimRoYfbOTdU9pu1qCJC2Azrw&oe=6AF5BE4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdCrPK8UDNMQ7kNvwF0URkl&_nc_oc=AdqNbHIjYVlXDYy5aUi6izCSLN4ydkGxGOMVuaLpRNx7Sgi4FFcmGDxG8QeyLe8puEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQATlYUAqO1_NsL6yKFopBT-4OzJxAE91jdFx0r1fp5mA&oe=6AF5D35D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0va-vceQx_YQ7kNvwHFyimV&_nc_oc=Adpn8X9TI1S_OwAtCE9Yu-PGvGTZflS2aSae9w-W0GfeSpRssel-0UnVsx9jt3eEyyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREifF8q1K9CkKSKZZpleq7j3OeSPgUbn2_19L
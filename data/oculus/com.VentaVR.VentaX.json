2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErMN4m29FUcQ7kNvwH12Bg9&_nc_oc=AdpSgdWbin_WkdQK8X8hA3nKN-IzlFPRygPW8LLcd675j7e9q1vwKmSQG9ky_JXpCfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuWK2RpiYNMRNTdU8qaoLbVXDu6znWlmBNd7h-WyIj2A&oe=6ACBAA26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWUUdgq02U4Q7kNvwGbLviH&_nc_oc=AdplyFW0IwBXUAxjcKi2WnQSyNYE2wp5YjNX_073zK1tD9FebjenPZKPKLjROwRBcHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN23Nwivipe_s5PH3xjruG7F--ycJRYwj-vgi1EBOt07g&oe=6ACBA50B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr-atywgCO0Q7kNvwEVzsic&_nc_oc=AdqynZ6VGBqIH83IL6ySwzsXZEF_jCztsET1wBNDo8Qh2rougHsH1sYlpr1pDk4Yobo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO23CGb7HKi-Y57SSXemPjmHlNs7w3pM2geo6UskpCVg&oe=6ACB9D53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIpsuRhWk4gQ7kNvwHtpiUH&_nc_oc=Adq4yeQ6lMoreVapHmLa8pBaS4YDEIz6iPHLwgbQfnlMM_TT1fOXraFQja5wt-5SwOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlBXbw-pS7VrUK-gSImSeeBCX1zjNoFlAwn23XFeGg2A&oe=6ACB8E4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AstoN8sl7JkQ7kNvwE1eRgL&_nc_oc=AdosBTKMeP5WW0NOceED5EfcKZEZ4qZA5D-LVG0rRgFursA7cW-2gzlaKvuUyDJKRWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBAturat_R9zPAixTkMxon8J28QFYW7sD6icyH0GVFUQ&oe=6ACBA35D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg0XlXjMmjYQ7kNvwGDy-Cq&_nc_oc=AdqnYIZJqm76G6zZwpt9N7eDGOnX0gPQGOJ30SSgFEXBWoRek1k-YQbFubG-r2uJC8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWo8w6xU-DX8eJjvHku8ZJv6NNBdfg6JYrm1O
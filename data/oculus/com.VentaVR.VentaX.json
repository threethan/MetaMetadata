2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPMlU9d0b_UQ7kNvwFxrouX&_nc_oc=AdocK2q5beIjMotWz7X4aoX3FMPpf7qqt-ga3BEdYCsOrjIL6DQjRKnPLi7MowL9uiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBYR6k5-zWitngq9U_qPmiEqaJoPyRmAqmACAszCJ1Ww&oe=6ACA58A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWUUdgq02U4Q7kNvwGQDmIK&_nc_oc=Adr4VMlKmvXSf597ISjHQbHSxfp36ZT5R_utHegE1VoJcfkf_4SEI4Gp5xFvA13tuuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlaGgWtM8CwIfLUpmis6eBp2JELpDFgWcIhGoI1tRx9A&oe=6ACA538B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr-atywgCO0Q7kNvwE_Ly0t&_nc_oc=Adp2wnazjx6fcEyPFa8Rxqz19FEtkauHx-dNcQtnlWLwKdm-MM50bNd5wd5eZofqoJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCah1kERYJ8ncrHzaj5lM76cIswCQarYedpYAvZtQefQ&oe=6ACA4BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIpsuRhWk4gQ7kNvwFYTA1w&_nc_oc=AdriXaC7NZJ6ldy4B_qvdHIyEFSVpsGM8OhoXYLkM4iR4Zz1u_5kamKG9IUef1SmjN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMW5qZ5JI0xMRGWbtTAq6LSliFxkIC_zxMbxWGQzHGIw&oe=6ACA750F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMzojBk5tzMQ7kNvwEDRUd9&_nc_oc=AdqMl-XxWT0B6QBrmDG3IByOwbuGOKkPRTVWERv5nurtJWLMiOLJIF24Pu8cnigUVHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEfuaBJNT0VX4_I9PPMR3t7nSCoEcTSkeqr5u7UvhfuA&oe=6ACA51DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg0XlXjMmjYQ7kNvwGZ-fSK&_nc_oc=AdqkGnTqnIdEa09zIfafU3BkLu6rRDg44GFaGV5XM99Be5iIbtpEryeLFrhKIZiPnww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfj5s0Qw5Ve5UWml3ATDHyt0jyi-ZsDEPMadi
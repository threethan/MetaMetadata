2063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8bjAnc6bJAQ7kNvwEAN7mu&_nc_oc=AdpWnfwarcUh-GZC3x7-Ftb4ibiSNMpZXLR9jkPudioDxO1wkalbm6FIJSE6OFEczxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49YyYDGvJDoH33uTWeV196qM9xGmzmDIspDMeKG10Flw&oe=6A15BB26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6U9ex5t60wQ7kNvwENDe0o&_nc_oc=AdoBoPgy7-atXUqim5aJrCv2OLYuxbe7Dw5j3QqPeP01FKrZPXKGudQ7abfiVR-tfSQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m4L_u-7azesHdFqPrjCzFPgdvNYB4FiZVMsqijVY9tQ&oe=6A15B60B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRBLdNZvhUkQ7kNvwFI5UwZ&_nc_oc=Adp03XG0xVG5qZCEKDdCPqD0D9lktaVKX-DShOXz54Wr_0oTN3wgyk4z1nSDsI4E2XQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OqdyQDX9XNiTa4ntpVTyCmRpdE1TTCDMy9_YE7FBtjA&oe=6A15AE53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj3k9uwzvlYQ7kNvwEWUcsP&_nc_oc=AdouOSOLo6kIPZ_ozty74VVA1PNMCbj-87jGIb4N1z1-yFxuJzGNm3SW7KJxCP4n7oE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a1vK4upHq7wdkSUpL4Vw0DiS4bkB6LVWevkqv4U_J4Q&oe=6A159F4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4Ce-8gSxEEQ7kNvwHD1Wky&_nc_oc=AdqdFuNpBEUCQRefC_LXAzSQlWa7EeS3SC0KQmUbKCb3XZ0dHjdf2yWe0N4LGeXOWe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WpZkUEuZpv6EdbxLyn6sGMvBrdS8tCoNz34shuz-R2A&oe=6A15B45D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wULj6YLpqR0Q7kNvwF5Sp_M&_nc_oc=Adp9yL0ssQ3QJ-xllEHqxpNybzvkMm3GiUUos0xCDsCKNbLuVfyYw_mAk70W3U-HLz8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yIs-A2h3WyZlzvpiuwfR6sbNB5eDxw4v7eaZ
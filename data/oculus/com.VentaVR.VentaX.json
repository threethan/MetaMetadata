2063", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FddDWCaKw0MQ7kNvwGqbl-6&_nc_oc=AdqHkR9g543Na7cfvNIZ3t9SrWfEsFFSIiZY5u0l9AIz1ipTkGR8Q5fp9lQOTukf1l0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSmL1ZONJ9YqFJyXvij7VCpY8hR3Pznt-Vy0luOdqsaw&oe=6A65EE66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXrvU9h9XuUQ7kNvwF8CJzE&_nc_oc=AdrlisY5AdjQAphdZN2EgQNm4bdjUTeycDKB9Ku6BdgieJjUXSKQEqNssoK7WQQlZuQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBK2WadINLytgQkJ0NgfNYSDyi2fs1X2VqfNGaSyzkOw&oe=6A66218B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP3_rOQ7DncQ7kNvwFQDxuC&_nc_oc=AdpdltYIUX-DynnM8NStuiUA-TW9992Rff73lAZmzAUz2p9E7cYHFpTpE5obVRApvKs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtzd-AkyxYwoql9zwY13jNhu0QNt5xCcCWQ3icYU-s6g&oe=6A6619D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oZiKECb5E0Q7kNvwEinfCA&_nc_oc=AdppYrR9PdlLlrf4TPKk0E93wjoaLWGsBK0_oik6wksYrRv9qPxCEZjceyfzpBE-5tY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBialPI03cVKiY0vzhWYubeGseyoLcj2GeeLJbt_7wxSA&oe=6A660ACF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl_S5ptwRlcQ7kNvwEQ1XlJ&_nc_oc=AdpSHqi2SjrdybqC9vkCirWYBRAw01_Xe-__8uJe0p21fCEoHbL3YyN81HXuZnti0jw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDliU2CRgOW9VIOhurxw9A3R5NG18z8Mbt9Qk-USeXzA&oe=6A661FDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjzhO4PjsHUQ7kNvwFbU-G1&_nc_oc=Adp4wH4LDbJCdLXWuN0YGD2SgVLSAKYeUATOwREeIog1H7aUQGv88CJgdDZYEjTD7ME&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmN9JZTAQxylhzR1MAxBbCldRNDpzn9AJJjuV
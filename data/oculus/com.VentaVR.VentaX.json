2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lanOZB-Fy4sQ7kNvwHthW77&_nc_oc=AdpCijo9mE3cgB3lIfvuZubidVxzuA2bA6rOUbCNlP7JprgNPZUFK66D3hY7My0_IGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mPu00PaR74xLXGfZ9U6D3T7JOkZc2QwAIdsEJbtHLaQ&oe=6A0497A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95K2WQgwVD8Q7kNvwE2117v&_nc_oc=AdowG65swG5HjjnJoa1EamrB3PAOCuE4ByYp9F9biGvREEucOc8L9ou0HGSkxEIQSt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZXIUyKGFwi6RwBd9DMA0I-w9tUREzPrad7x2Rd3xb-Q&oe=6A04928B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJy_9j2xP-0Q7kNvwH_BbPR&_nc_oc=Adp7DxsznUp_Q3lEsu5rmo3PHnpX0-yp4wDOTu5Aadx1RMl-YNnwzr8-LFr8sPXfe80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iK3IEJeURxgH6hFsZb6EySOzb5aMjydLMFVTdVKdfCQ&oe=6A048AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhLWpmccjDEQ7kNvwGK5SVe&_nc_oc=Ado-GgA0wH6lmpWwwri8ZwOLhKLZmcE8Mgtsa-Utn3P7c_TzVJhFJWjpJ1r8arGCu7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lft9CJaAb-VQLSysfyMdrUPFZI_SzLup6M8mWC2Akag&oe=6A047BCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i76V2Jn6r6UQ7kNvwEyQDrz&_nc_oc=AdrrxG4OOEkJ46nWoQ9bc55K-BrcmmEIkBupzf9Qq30tAIuwEZMMNdvfj7o0KOn5bEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CWvSsxd2_RKGL1PuFiaEuIns0QC1ggPWJxawOsEYt5w&oe=6A0490DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UST9Yc5V9QMQ7kNvwHaIyQ9&_nc_oc=AdplTfnU0gW3X0_tYdZmto38FQgtTyvJW28BEaiAc_GJPoK6sWx_2UzSOJeGV3j1dCU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T376Oowhmd882zd_y8kJZjrkC5ln8Odc7T2J
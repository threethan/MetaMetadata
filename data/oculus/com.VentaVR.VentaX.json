2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_65AaNxI0sQ7kNvwG0fDMl&_nc_oc=AdqegWMNPDqldnXk_Sybcu1NdPkvb1jHCpihbH2ZPBrlS3tadmXhJh0iEl-bkWwAi0k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZrOmWziLrURVYn7D5WxivTvmigrpKVaMU5II6Dqxyag&oe=6A4A7726"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OChcAgWc1poQ7kNvwH29wl2&_nc_oc=Adr4fjtPCQbQ9Sv3EfUN4ggZ9Levbot22vyoQl74EDcT5_Hp8NFMfN3ryHPTrbcxa74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSS1VpgXMW9Q67U3rj3dKlvWxRc6NzSu9bSiERHxJVeg&oe=6A4A720B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWYq9PTKleQQ7kNvwHXtC2v&_nc_oc=AdqJPNYDTpKu1WsK1S5GVcG0fVo_zhouN4sWvfQZCt3XvLU4MllDEZcUE1vBdRy0a24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ZymLciDJMA6CiD4RTL8URU9k12HgZt0Ic5A_vHooIw&oe=6A4A6A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvullaOMSqMQ7kNvwGXXuf5&_nc_oc=AdpnOmN0pOf6v9eM0Q7OkEdalm3uI23QCcdT7f5yHGqRVdQorAQAl8MIDnfKU9cq3Kw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbaJJGdGRGa6k8PEhZzrQaL3z15SNsoKS3SSomyjKyDA&oe=6A4A5B4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjJNQFYvv9wQ7kNvwEK2Agn&_nc_oc=AdolQYCl2S3AbYxvv0L4MeaueYiGbEvK8XmmC-Xn0_ZhYiP2Z8wjv6_jskPHyIMhYRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANpn15jL4pvnkSd2Va8suiI96fPuykJ3rGE200MhXUrQ&oe=6A4A705D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifCOgYeHV1gQ7kNvwGZoqKI&_nc_oc=Adr5zG00WS5oAbvceN_9-VOSlrwlUosPVgsO-Yyoqytp3LXMyw6aszET0H7XFNcK0TE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfq6anvKhJ4QQyOSQW6WbMY8J0wuNp3J6J-P1
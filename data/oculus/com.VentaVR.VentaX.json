2063", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYz2-UFpCwUQ7kNvwFOMgq5&_nc_oc=AdpQrqtxKHc9S0BsXS5W1O6KOrThgGpPZrcKSFeSydtJbfwQgfdiZ8kU5a5lZl9oPt0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LsGA_uTj-ps0UiSRGUsN0uIv614_Q3H2peJFxFkg8kg&oe=69E250A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Kn-KfJHsEQ7kNvwEi6O9f&_nc_oc=AdpV3pCrUvSlnlGSe42MXxuix-0ODr-VA3yH_HDBkv6lDf9GMkyJyU2q7WJuGmIEK_0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZQFShNf7WhQ_B7mYqCVDMIfLTdPv9_EN43W3Jw5FofA&oe=69E24B8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWt_L3O8PQMQ7kNvwH6KkPg&_nc_oc=Adp1m9VmxFQfPDhHtiYe5STM2ltpWpa7k1rBIy7uIGxNFIdYF3ag6ivF8Rz4uIcuUVU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S8Y_9BcPW0xmaKbEygzja096HGFm1GHhD1zbwyl33Cg&oe=69E243D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPxr3LXkrAcQ7kNvwGvsPuT&_nc_oc=Adr1PqrlI-IQ-WgmN9HS8O9YJWsA3KqdICPJhZ1NlZ4iiF5QzfexNuLqvauVNaZLdiA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jhqRIgZpUz0mqR5yvsOyDINVLwXHLYQOJtrCscD7CFg&oe=69E234CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11iPv-4kAvYQ7kNvwEDy_pC&_nc_oc=AdqFU7R1P4d8NsrpX8VorcHS49nsvbaphbxEJVCYN5ARYJQ8aEPqAa2uQJ8hxeZmQxY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bDKBgZSWy2cdLBpqXuDlsqRs7yXRCCHhvrFvQAlk_yA&oe=69E249DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHWpUzaaUhkQ7kNvwFrCmkc&_nc_oc=AdrwheWJpy5jR_XhfnagmqE8__f6LUI0IcVr4Wvlu9611l2q-1a_k0NSZbsRcDBCPAM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3soOuwmz64sayFZCNruOho7HjVCp4Xbxir5Ye
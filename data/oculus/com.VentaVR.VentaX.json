2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNQBBgiirf8Q7kNvwG2CBQT&_nc_oc=AdpZT8O98q937TrRsWhn7iI3EbpNopBsw23rHe_kF2EGbrJ8vINJD-QANTk7Chs7qlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-buS1GNTedqBwhrXbKv_Omklf9CPwIzwTHAY23l5eTUw&oe=6A2EC7A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jio0lTTvK1UQ7kNvwGH3XEF&_nc_oc=AdoQl9kxjCFOQX7qi5vQt7EwyLSk4r0WumyHzKR6abNRp-d0_ZDtZqjLMHKB1fwUd3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-CoimZCFAtJqNt6GSnDmZnnlx4GTjlWnHJi9ffaGxQQ&oe=6A2EC28B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-l20Ko4yewQ7kNvwFI9_HV&_nc_oc=AdpXTzpBBDQ1ciPR_UGU5-0TqR6dqZonTABYV-3LnqkNJ0zA_vxs1B1c9CJitunXUuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Enmj3zhm1XMEpa99GrYDW98dkbNR7wkB2joW0BtAtqg&oe=6A2EBAD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U2W9pTt1zoQ7kNvwGZl-9T&_nc_oc=AdrFeBjKc72m4nw5MOwsgbSmwXp6CTi-GOzEBzTHk2m5IkqOTeXuuRONGvJ4Lof7laU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0wKb7vsH8t_1uWiFMyx79dirLy8thII9Tc1tnqYNPqQ&oe=6A2EABCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LF2KiOKFby8Q7kNvwEJ8UEa&_nc_oc=AdoImCP3llqksRI32-t66Yke7q7S_PgpX5FDtgAlnm8M-lb5KcsCYyxAXUHLTETs00g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GxMStnoc1jIv4exWe01FYdckQu9qpQ9Xs87nU_jRlmg&oe=6A2EC0DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpeFm2TQV9EQ7kNvwFUPc2q&_nc_oc=AdodE5xVfSDXwvjtkGO3jLsgbfjv6Y50CAewWyMJnIfogQgJUcNB8oc8HhWogC3DYh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O1UupNr-0cZ0kkkO4UloGphaGWXSqoT2Y7cM
2063", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knez_dRQPqMQ7kNvwGny4c5&_nc_oc=AdpHDyEctM1J2EuEQtvfZN7o6fPoYH002ZekjeNEKacInMsfmsGTZH_K6l1isO_Je4g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVncvCecd86mmEPGf92msEQVPx5V6-m6BkMIFLNcUnVw&oe=69C51766"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LenhXM21xUQQ7kNvwEykufl&_nc_oc=AdqJ1VqvRP2Wlx3edqiqlK_lwSwddyRkhP5QNLihTnjXhbQh9FajJokTNi5Zg1J9Jq8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDkwb-OQTSpD14AdgQRmyXkG9PmvypOuGEEPI5wzPUlg&oe=69C5124B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBh07pM7dgkQ7kNvwFVurND&_nc_oc=Ado2hkDcgoOdkFFeiZQzwd3js9KFmmryPePbt85-Li5HQ9lZM3HfRN6EYwyQP9zc2so&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFlxMsTjUzcTQXlf4PHRNQyrhHDzcI-4bp_cQ4DiTepg&oe=69C542D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AryUsMJeFRYQ7kNvwEf1nKo&_nc_oc=AdrtKDoAoycgO5PdAR23Z5KmD1lrejGY_M-vXZYSXNQEDYB0NSLHIFUbhXIXeC5XFdg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4KrMLjPAjVNEAfIg5WU65TFKhoU0Mkek2KGI2rmCJNw&oe=69C533CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yddcbd0P0EYQ7kNvwEAkULX&_nc_oc=Adrh6IBxhF56MrYxZWNZ1OX5d_novb7UnKrV7q7Pyd7fzQOc6TGYfNA6znK8ClxqP9A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPKz2bFx4l0YqjMdRpYalCQdiMtk_jQUydq2SGOuRsew&oe=69C5109D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X24gA01io7AQ7kNvwGZcMh7&_nc_oc=AdrNt75EoKEcT5dYDriBzrEM68IoEaYf4KpFlZBQx6Kcr1W2gVYmQ1aoxl_NJGLoJ9o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyN9Fqs5dn3knHR4uXN4Pdl8FweB5SBw_M1xLq
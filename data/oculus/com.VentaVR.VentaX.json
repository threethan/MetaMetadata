2063", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzU9zME5r30Q7kNvwH0j_Ux&_nc_oc=AdpU-c5jkVaLbWwWKSJ09Ox9rpKnSiFqBefoSfkZUudEuVZQjv2WbGJ0l9yASeEYCok&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ukI8gbZKXQ8T-NLL1lJbILgoAvrmlsj7NiCAj8ycB8w&oe=69F61726"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OrowSLQiOkQ7kNvwEOBQGj&_nc_oc=AdoRmK9LGFgPIqjl59xT1aDf6zDseCtyHWievQD4yP9HwYXPcEO6p1JOh54WXMk1i1Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lvrYFWZ7EMQCcjjbzQqlMHk2x-fG69bs9P1k4qE-fWQ&oe=69F6120B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwiFNRgV-ioQ7kNvwEDqGUU&_nc_oc=Adqd3b3BP5Juo0frF5Rqzvmz-9NGixlxgDAJebbw5bi9T4nJk8on5a7D7YFQikMhljI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DngSZTuNyuRgUPBZbfF9ntrYUWpH_M5GKojXKSHJp0Q&oe=69F60A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdIkmEFHh0wQ7kNvwFumBcR&_nc_oc=Ado1srOUrc3xSq6xNQo1NyUIxnIrddgDiLlksjAaCt3r0B7LgBgL8DCJOYfZhbMtKFQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PcHhKDYwPEnk4HmTCjBUppL01lcCDohLJ_xA202QOKQ&oe=69F5FB4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trVPBIMHpTEQ7kNvwEfv5Cv&_nc_oc=AdpwF1bLX0myDVDZfhKuu-CG4zYaHtnHqro0LJwjiA_AiXRxy84orgVYlBQglzpmUew&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33CT66XCd5oLelWEk1Y1ZLGd-4Pz3Uwhbj4KGWiBnbtw&oe=69F6105D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDi2nTO8IcoQ7kNvwHzpCW4&_nc_oc=Adq_REjc2Z0ilcDS5s7a13Ju6WTnLGzMRkQ6QzUDXeLTUpgLuTUK6iAtZ8_YUofjocs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af281xs1Abb-V7rrSnhMQydbVhdQJR8RWX1cGwy
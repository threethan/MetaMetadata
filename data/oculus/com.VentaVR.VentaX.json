2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC8kZEPf8gsQ7kNvwFQ5mJD&_nc_oc=AdoXLL5CzCgf-Hb7gQxAkgw9KHm5SQufR8AQqLFhQImMJsEfXP5IB-Tpzq9JFZUmti0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwgXINnxW0g54PlUSL4effVqiBGHsPwreUmPUPRSG3EA&oe=6A61F9E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtUfZcxPsIkQ7kNvwHDfnWy&_nc_oc=Adp7k_e0yrSp14OygP7_KVcskmwfKF1AfSea_ihj0M4Fnm0Y3q8m5vMVr765c942zI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUWXkBgBRR2B084JIttEsjImZf2cI5r3WwDWtvup-FNg&oe=6A622D0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNL4pgND1ToQ7kNvwFDQ0KH&_nc_oc=AdrMze3KMNwbWQxcb-kM6COfLI27BENZUPt0hNPikItpGvaBXkVblzhk6s5MyKfzt3E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt994li43Hj7_d9EN045fum5MZaIygLPD-gsvsS0RvSQ&oe=6A622553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQs3Ro_gZUgQ7kNvwE59GX-&_nc_oc=Adr01gjOeZR08hZQkgLdlQAdyuq6YskBQH4GZcO1aKA8c0ntW-0wl0U1htxs07ailAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcoPv1o_ZjnOZ_l7wO_YsK49yQmJ7tBDFRZ-wFVLocyg&oe=6A62164F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBMlVItmgBgQ7kNvwFM8EAE&_nc_oc=AdoZV7Sr58HIBw2pdBRvHox719l5hWM4BZsdfxkTL535HhjTCjblgMawu1HcP959Sx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEcs7__ZU0opRhGy2ST_EfyIYQF156_P699_K448hHLw&oe=6A622B5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzztlktFHvwQ7kNvwEIPaHg&_nc_oc=AdpOEbBc0oX_4iSvtwClEQzwKA8z1LuIITeQM2-1vYrxBtoVY6bLDJKQGMXQ8WuRX0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3vr9mTwbLfBRZJDY0iqnJhmII_Fw3dpM3drK
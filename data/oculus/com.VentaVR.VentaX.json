2063", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNbIDWC6mCcQ7kNvwEP-h76&_nc_oc=AdpB7-D3mVyIwBS92FJfQFF1qrR0iZPyuCf9YkuOck1ItzaPGjFOCPSuM0kY80TE_jI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tXq549jpTrVnGZqdwC9GsmMsuQkJ4BC1OUrEthRJ9xw&oe=69F4C5A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OrowSLQiOkQ7kNvwHNpK85&_nc_oc=AdrEucyYIlZ1f5LknBRBapFDYxpEQlT6tKyT3TkaxMtcEFAcxgqCWysKNYj4BpRPsg8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iDhnmhOi1X8Bwn8O5fGR32zntuGx1-RSRO4aJDD4J_g&oe=69F4C08B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwiFNRgV-ioQ7kNvwFRRY5D&_nc_oc=AdpYHxP6gwLSNJlZfmwe75gpF0Z0-0JUGP8yi2uPmT1ozLPClEYP5NyA-yhtOdvfFKo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1r8D0fHtFrAcAz-TK_KE12j3ZdRCWS6TIO_9d1J_9h8w&oe=69F4B8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdIkmEFHh0wQ7kNvwGUQegs&_nc_oc=AdoNm7GWONA34qQvONg-GhL1QQTLvitnem9F3Sady44ohftNiwUjFYM2NEUX6jspiSM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00JofZNLEUR-CkAuHT9f8Xt_BsnRCHCt4T1SN9Wirr4A&oe=69F4A9CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mkLusLlI2kQ7kNvwFmBDDW&_nc_oc=AdpuODpt8X-av2fZFljMC9MPjzMVVc9CD9d7tV1mZN2UJ_YON4Z5q3zwvg4HzPo1EGA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BIH5gXi7gaDiNRvNpteOTWYImUjL_2fBNQb8e1YNSuA&oe=69F4BEDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmNkab3XR2sQ7kNvwHubHuk&_nc_oc=AdrGoIZT-dNQ1fglwEXpTbfdAnF0XUVepxh6yZbyJPbupUna3ayNf6wWl8BP7rawpts&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hWQedKvfAkHlurI1903hsRkMxZl3uVW1MJLP
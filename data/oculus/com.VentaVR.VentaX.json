2063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_8QsgYJvq0Q7kNvwH5sqmK&_nc_oc=AdreycNlO12lbNywhl5zTjKKg15QIc9jT3UUdEFZNIOWDOVl4DgjX7xyu6PjlU-JQkk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq5tWyEyon9_uwU9gbf2igY5FqxERAFTnVWp4MkFZ2Aw&oe=6AE213A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNlS0yIPaWUQ7kNvwFOfdO2&_nc_oc=AdoDrmIDwnq3-r1TKjDHKqQF-qgqP7HZJyXnMQZI1GUgh1lo9hxfc4gIifFf50Lq1Go&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUdYtnCKG7ZCw4MGDmiEz-xSKjBsrFKoRWogb93W6dBg&oe=6AE20E8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiwgyJWa3PIQ7kNvwFnj75T&_nc_oc=AdoAa8I5qt-ci1TS4JEujBabvVf_PMY2eN-VIoOK19RR03IVGhQByfacfH1fxD945NQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJncR7Oaw6nA6cZxl9BeYxOStyAwBOSAdW1DP7hsXUyw&oe=6AE206D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E95b_p6p14sQ7kNvwHtuXi4&_nc_oc=Ado6rMUXcveGIcq9JuExdeTmMpnHbgEr_EKsdli_cuGoD7thJ4se1ZhRx4gdd-z__80&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvnbDD0Ya2EUVz3f25uns-tt2DrNsew2g1c-BWpC6Iqw&oe=6AE1F7CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4ES8Jp3v1oQ7kNvwFCPHGT&_nc_oc=AdpFuhQjo34VhSUuN3I1E2Yi1PFpyL3K83Y53OWKlsG_u4440ujbsUqzCLt5yHnjEdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8HwkUq13hdfBPLABTX1gIjzWMdwqjIi1NiFoQxlvUYQ&oe=6AE20CDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ry_pKhlhkQ7kNvwFpbqRm&_nc_oc=Adqq-c1jTX2o4zO-h9QVxVudtOsgrfQACBKSjov3u2WselS6PEhNnHzo66CzR-ecnvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGsRDZuAZ3c499aA3c7QvRDZfBUp1tc3jwZc1
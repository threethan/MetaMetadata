2063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmYdb5_6EhcQ7kNvwGtgUqy&_nc_oc=AdpiOZbPVkCiFKVyVlXBsTs7Jawtk2ZPbVt-4wUaPBPV5eNZm-kAOgdQ4URE-d1Lig4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkQ918SRLrqYIU63B671X5nXCPjPM2hKAo_kMnR9shmQ&oe=69D0F4E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W76z6yTNDfMQ7kNvwE3_G7p&_nc_oc=AdoDIKTWv-oG2g9eZSbvWssqE57hBsTZ0oyMBZW4QknBQyXUdj_LA2ei_PXYpY6nUQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpD1t3_keAhhfEoOR9mYQaqGR1aRN-7QYqdEkHHE8VNw&oe=69D0EFCB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abFweKHKHCcQ7kNvwE5Fg7a&_nc_oc=AdrZb1epgmdWvkW-72f6vihJsaOjY8Q3kMjPdZEKjqiGs4wFf06RTSa5drSLqJWhG50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNUtvR6mcV0iEUzONRB6n99r1ITKxIyIiDVk9z1Jh0PA&oe=69D12053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUxJIa8hJEIQ7kNvwESn5kc&_nc_oc=AdpeG0VeWXwhDh333o5RHvrnXHktiG1fgN6qek6jknhu2osaV-EAQyOAYVEj-adfTgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBkgVIuSWdKzTAvuKcCU3m-DQtD22ysKKCWCJm3C2B9g&oe=69D1114F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B-FjDq4Mb0Q7kNvwE-DGSp&_nc_oc=AdoCmE79ylk3QBMbuB9KA63yRdyxnxX1MqzaV2qsKNbAPwZjTlQh0brVY3ud0R6vwjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzybHuEBtUCToaHd8f-Gp5UWxCiD_fKSiDgIQbMTkGpUw&oe=69D1265D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr-XYNXklFAQ7kNvwEi-tw8&_nc_oc=Adr-rRJN2nhuOh3ypj-VKUtYGWu6W0QymsPiX9G4Gq7nykJsX20s1dPPBBCu1cFkK6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaR0csuIRDdHvGrl4gNvqFZ37yDlKp6Mwkask
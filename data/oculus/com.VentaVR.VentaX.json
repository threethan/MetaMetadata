2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj7EhJzsTkoQ7kNvwEj1aWY&_nc_oc=Adpc-p-4gyBPNXuY0IGkkEVpCuDBXw0pLFyjQ6RxdTYMUWzPYMh8bfpeHPxma_PsfdM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpGJragoohQ9K9Mu6qoc1heyIsB-_9PHGGvc2R79AkFQ&oe=6AE8AB26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKlKlZIl7AMQ7kNvwFZW80W&_nc_oc=AdqwFJNYBZDN8jZrjvUl-nYDweNixEQi1U-sIOVU6ftiwPcNEE3kQh95cfzlIEa89ic&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh9Hk0WiS7bmhMZUZ9d4BmCd9XL9_j3Wa3NID21l-KcA&oe=6AE8A60B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Je-npIqnQQ7kNvwHoJKsA&_nc_oc=Adrn8vinQ6BHFhqbcPx_v3CFthYxcM7krwIbECqqIPUwl5FfpegcHWC4WPuAvZ4rWMs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXEALSOh82maeQWN8DwEatoeclSMPAfxiGDkI68UHvtA&oe=6AE89E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARgIu0YntmkQ7kNvwGSxFyz&_nc_oc=Adrs844LgjdtHD0l_keROl-C3gXg1rV05_VbM1yPl2KaZmXxsBncZaeU-2-YZae75YA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaXYR22top3O2NPFDiPI-KQ57TSg-HAM_3WECyIF_WfQ&oe=6AE88F4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlMNrUt3fcEQ7kNvwHrBa2a&_nc_oc=Adr2pvYnaIb1mIj4_RxymI6uJU1OWxyMkx_VyKhWUQYbZjFnrYwrMfCvhMvM4kKJgfM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOkjUSGpAO88qaLt9wMyP4VwNEHWQPN88plo8OEwtQFg&oe=6AE8A45D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGz24ht2duwQ7kNvwHBHoiJ&_nc_oc=Adri8cwbUJfbet-j4NeaAofNyCEMs7HN9FcFsLRfR4Os1zcePQJlc3XmLirt5nhkUdg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuFTUHyHqnf78DLgaqow69Px8gnPwAlIK_Zpz
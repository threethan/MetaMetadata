842063", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odU07VxpZ4QQ7kNvwG8FUAB&_nc_oc=Adr5y_XAhitajPqEKMFPKteqMwOjRBKUCCnLWJiH9Wm8dd5heWS_FkyQga7ybshUn4g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoG8Koit9gm7oEcuHGFrzvVFsMdXpFUL4aeBH70gz98Q&oe=6AA41D26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWBGUQn0sEQ7kNvwETLVOg&_nc_oc=AdpBTiusJ9vQQ7VbJcqNYfHBrgThwb_aJzdQqdu2lFLNWqq4_JBFo4sN6yKfVowR5Jo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLseEb5IlON7CEwF-3SYIdpBBof5zqH59aU1vXz8iaZDw&oe=6AA4180B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjpLvBJ2fv0Q7kNvwEtVRrT&_nc_oc=AdoZ3_wLiEGM0HceOQuNqYybROyGb-MeboE7aCeJwT22b6uP2C21sGBU92H7ceehKD0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZnWqU1lgAsc649xS1tV2eHTw4_aw4piubqg3HJDZAyw&oe=6AA41053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Dqk6oFL3cQ7kNvwHLzEy_&_nc_oc=Adr9bYprMvLeoWfPEJRE23cdgH5BGM49CK417HSI4UnweQngqJSDdMit06oFm0JFWN0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLcL1q49emSy1dacL-L4x84h6FaosbRvgDpXl88ozs3w&oe=6AA4014F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9F0LGRrlHoQ7kNvwEa6GHS&_nc_oc=AdqJcTyREKyoX_37mdzxwRbd3FKlAdLimeW9cLuNbo7tPjOyjTIB42wXA5PgBhSdjKI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-IKmoRWm5yFGaLvNZmamzy78Mlp4SsMuhfic-ld2cZw&oe=6AA4165D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P90bWrmOvNQQ7kNvwGjDFC6&_nc_oc=AdpY57XzABxqc4X11JLlSiJvUgh3R2eYjut0zCE1gWIqFZB5dFY7lWKEKipebtcJp5o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKawIVC6hn9dMUA66SzXgNCaprJWXm0FF8
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pd1qRH9irkQ7kNvwHYvX_3&_nc_oc=Adqp5yn1vPAFnW0uY2xalVHUaqGMX6eoULs0elYgjdOTpkIpDSmE-zDn0ID5sazkFDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy0-sXT1_vu8aZIIVN-j5mkfhDnZySagewWyHoozcUNA&oe=6AF1E5A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvtd2j-6wz4Q7kNvwGiH4Mx&_nc_oc=Adpdzp99aN8jozoERjMS3TedMrCdwSEYyrlPfKsirqy8RdouO5N2nWR_ugKioYsYJqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW-JkzWIzEXveYdCdKoNonMI8y9nf_KJWM422nqGw0sQ&oe=6AF1E08B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ErqJG6OpxAQ7kNvwHvrnZA&_nc_oc=AdplnBFSlqEMykPG8QvkCIHPSNgB7SrS3VsUDZpydryKeDsioQ70r_WRLwgAGBjhgBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQICympZZ2qRxnWjmnxHHdwP11k8Y-VeV5-T52k33CR8Q&oe=6AF1D8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ7CY1ZXYJIQ7kNvwGM04sr&_nc_oc=AdrzB1jO4XW19ssYZEKokqxIjf8CJ112UR2XsCD0Rd34dStWMngEFRKWM4Yjwh3YqDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo9szYIaI5S2QAtegVg8l3ofW0WTHEzDQ5WpNAy1Yyaw&oe=6AF2020F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ITeSXchOycQ7kNvwFhace6&_nc_oc=AdoJWPzPzvZ4U0KCs2bxqYKbOT5BmeFHCOdegmBNXtQ20GjLDPLEH-bK6AzHm8y6grM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG3cVcjRgsrhCDmfLW9UubSrYcg347GHZzo2zKfFXqgA&oe=6AF1DEDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6uuGfXfgH8Q7kNvwHAx-Go&_nc_oc=AdqmteN1OXOxVRA1xYwtyDU7szG2TeOUuctgsNjwzzLclhTNzm0VAAXTMFgUKGZOQ7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2f9phWIgC62m5VJuc6XncfFTGRKlG_WsKR6z
842063", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcPsuheT-kwQ7kNvwF4NSEs&_nc_oc=AdoY9WEQ6xqC86SMa86EsFgxd92hxIySROXwVa7LwoRGGcpeynGQ7Pddk-aygcU5CKs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqFMlcEVsCAoGYiZL8yGoNFvNW8NlbdwgwkT7empn-CA&oe=6AAEA926"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P5I7EVZwdEQ7kNvwHhvr7A&_nc_oc=AdqObhbYSjKmd31KNDECUrRiqUqjc4VUabKf1UqVcgAX9RL-lTzbH2x_5GjEZp1II4c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE3eKEqASQTXKmU0LRgpc2spoEY6dX0fMO8_gCWXuxGA&oe=6AAEA40B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9Ddgs0C6eAQ7kNvwF7pnmH&_nc_oc=AdoCl7gDtO22t7xyu_xDmfdjzJPD1-Rw75wndip20t3gOyK5f_g8WrgjcnGhkC8_pwE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIv0P0E_D40yX7Dmx-OEu9E5J1vgIow25M8acoZAlQhw&oe=6AAE9C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9fxQYUhIRcQ7kNvwETp2nm&_nc_oc=Ado6f2gRW7mOjiMIAoL8dAkSULsa5mnSBCfzFjbji88TsyimeDbAXWqe_OUISAzlR8g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPatSWEYbvrpQsC7G3zmGw84ttQew-SsdvKNN86vkpfg&oe=6AAE8D4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x65eWHmNsLIQ7kNvwGvBGT0&_nc_oc=Adq5SIfD39EgE6J1J1LhSzBskWDUW9dZhJhEP0bhH9OdxQ-GrVDfQRm5Tpv-pZeS2UE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4o_F8rMfPKrc3n42Tj-dFLLeqcEyRDHV0fsw9QQigYw&oe=6AAEA25D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juDnHkWAGC0Q7kNvwHke7OD&_nc_oc=AdqyqUZKqS2kkGmClU-6uqXKx_gJuH_7foNJW6MpX3Q88v_Vy2ptOcY8v3S6GhMnSHg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-c6TAevvoP4-oD6J-qVqumJbZ6XeOVXB
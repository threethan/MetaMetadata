2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzU9zME5r30Q7kNvwEvrPmk&_nc_oc=AdpPisEFWTc9VqCJKN5UVrTvOge3JYYSpOhEYnj-PtvLNepOwOFiHGci9iOGw6f6AfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DzLcW7XNT6gUjoJBTz23VRlpaxiOsEz2OvaqaeBy_gQ&oe=69F8BA26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOke_0-5thUQ7kNvwHK1Bu3&_nc_oc=AdqiuXIvSnq7ByEMIElJL4MuTw1KUCnHa_V9j-EyHRzkb6Aaff8MHY9GaxSNoRgxbP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qeXAPpbMrYnMXL_7eN_gprQ9ed2E7eEyZdMK0a3cWWg&oe=69F8B50B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3sLIGWx9X0Q7kNvwE73m-w&_nc_oc=Adp0GJDzkg2kIg283JnqVkV8TObnVpLLORmcgD9CnMhZIK0wWsaUgX6yTxAM_eeF4uQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39Pe35x9CxEA8tZD68w1aBt7vFjtku2BQsr80BX5xwEw&oe=69F8AD53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3GnIEr4EXUQ7kNvwEgNKlA&_nc_oc=AdqzXsO7_83HBoGskSYdt1bckLDO5qaCzfdneKGQPzwzuz732m1-_yctE768Mg7uKos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-KdSL3-44xHbh3DvBu2nEwZ9QE3KVAV2qoxsmW8EJFQ&oe=69F89E4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trVPBIMHpTEQ7kNvwHpF7mm&_nc_oc=AdrqTyTOjPaew2cw-gwDE-1ZrMHDZGpJpVQCrsdCOaFv7WPxjbOvq2pb_B5aQCEf-xM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vh56rAvFJUyjCg0wGrTsSU8jNM1QbMCiWIQf_mEk5SA&oe=69F8B35D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDi2nTO8IcoQ7kNvwERf2Wc&_nc_oc=Adrbak_1wTQ70B-hmszW1FryhIdyN_TtIyMJXuvRzzfLcrQSEX3_BZsCavqI25Ny7tY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MoF0cZRtakstRn5Fp5PLhU5g7HwkPbOsXKpu
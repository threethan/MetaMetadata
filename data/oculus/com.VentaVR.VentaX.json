-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myger_h-plcQ7kNvwGNfMTK&_nc_oc=AdlTGmG3N713R_bcrkFiVXYyyhzUjG6Hmxa1aCV91ClmghdpKOOBbiUqNI1a9TAza8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGJmiKjSacjy9GQfblofd6aKU_CxmLB2eRe8vbYd-4ww&oe=69AFFF66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9538cpBcJHkQ7kNvwFiDXTu&_nc_oc=AdlpzL-HSvzE-Ns4XgrpJZtfCA72aZn_Jgmxrfqcb15pjuVPITbUg-ZD-oO35JhkZNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_6K8T3iFkdgDpeqCkzTgSnIH-6Xaf9QveEpVBep4ODw&oe=69AFFA4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y57-ljXQh8UQ7kNvwHPqKb4&_nc_oc=AdkOpbn-iYQZf5wwzk9rMYjUrO8XMR3MO5fIeh_E_CSH1QYVEFS5EvVJ-UhG5E7Dr_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9BT9eiWpyqQPpg8l_q7Ta-YWx707BhmkEnjFGlCYe0A&oe=69B02AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkt5VL_y9soQ7kNvwGFqWIu&_nc_oc=AdlQvcULIXn3-6N7aE6oBz-otX121qagpJbi3pjtgIdoN65tA7QM_-QGWLjWP2BjXNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVlrj4XLLsMPfDfhNduYsNTdG9YMTCSj_rYnm6Jn46EA&oe=69B01BCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl4Zpg1IxtEQ7kNvwH4oy2U&_nc_oc=AdnnvRSSFFcfcAiaFbevOlP0tuBa-CLIuASV9-jx3mAnd82AGhDyhm-c9NVKwBs8xQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrrBz9ENi3e5wKJWAlyIkS5L4ZKtWdVF2wx9niENQmng&oe=69AFF89D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvmkM1GFlXQQ7kNvwE5_qR7&_nc_oc=AdmwiimRismcD8npaeSgHe3ZEIibPyFhz_tt7U4f73lt-h5I1Ywd9OIR0yCd4zkpO2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW2Y4BfDoc45f9emNBS9NxDlojguHai8JTE_rswgiBJA&oe=69AFFCA0"}, {"file_name": "01_Hero.png", "id": "1
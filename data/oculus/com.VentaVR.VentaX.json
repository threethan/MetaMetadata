?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHHy1ie6DygQ7kNvwHmyALU&_nc_oc=Adl8TvzTVX2YppvEwIlikvm-efuFiH0YwJSE-cEGC8TaLkaG4BUxsE_aYmxaZugeqfY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsnbO1jUxKiLpawjGDNe4vGhmpsDOXTsopRoiMdIMlnMw&oe=69A57366"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28uMUrA-4kwQ7kNvwFkZmOy&_nc_oc=AdnqVlfoHTcu1PrqJ4ssV3iuQ0y5ybAO6xvhOS3vcHnHm7KWb5A5ruaWNn7Yw20Zwyo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afumz0mG9yq-UI-e7uehfrcv-T0XPrg1sBax7xVKSG6DoQ&oe=69A56E4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmhd6YNIjEgQ7kNvwFiD4a_&_nc_oc=AdnC2oeUYQtWXPvXrj0nuQdoxlKr-tAQxcFoN0L1Gqvl0B_DNF8e7T5RXSg4HeLDAP8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft6KstvOpYOp6QxvwCPYphnvBdMNdik1xg9AsEHYk8B5Q&oe=69A59ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny36c8Lttt4Q7kNvwFyy7iL&_nc_oc=AdlYveTZ1RFzDQErNj28DVoQEAtaiJzNybGPW9hV5kwC8TgoO3ySksqLc7YqPqdj7ks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuxarFgI8P8D9C_7soB8RhFDT2zcpT2umkaCda_qX73sg&oe=69A58FCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBJRv39v_2wQ7kNvwHGaQQB&_nc_oc=AdnAWnWOe9uqyER9PvFvD5v6gTX-3IOrjupfrzs7K9UPGCSlQz040BKPcI0kwB5llyI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuo44wfRPJmVPHQ1p6PQ2dJJjUKm0V4fl2snHpsXcGMqg&oe=69A56C9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4FN5_9Nl-MQ7kNvwH3WI93&_nc_oc=Adng4ytv8hy_0Ajkg25hc7IPn_NmuFsdUC8cEju2miJjhu7hfjlqIlmBLcNeKWjapx8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsInVACo_TRGqzEupTG5XrHIW_ND9vny_k-QaWCQhEhlg&oe=69A570A0"}, {"file_name": "01_Hero.png", "id": "1082791666697111", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556807_1082791670030444_1
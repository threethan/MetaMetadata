2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsy7DI71W5kQ7kNvwE2tEJZ&_nc_oc=AdrRGOPGG_PG4yIOdeDXTDEWFZn7bDFhMxzNdzkoTJuUgTIRNiV02URXrj3nAvC5tmk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBngP8peCBo8p4ZtXeWBPZNIZBoT6Moi0bfhbeBuYK91Q&oe=6A4E6BA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9AVxvwRxvYQ7kNvwFUHjD0&_nc_oc=AdolBGlxyk6DAKnjrSblsIxQgQYqr-r26gdJW8g87XeHCnDUqQGMaUySql-9X0KcCeE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3aVbAADFr5rtlsuuj7Sk6IbzDvbj4QHrEy8T3expuzg&oe=6A4E668B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca9uxiUav8sQ7kNvwGWQQFP&_nc_oc=AdpDEi6VvvS-XA59bcTsISQ0686h-Vr27MHsDXutx3g4b7zfZ87eH1e7nmllEnG25H8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkdUe08ilNPc-BiHyQleVnKySE4FE-ToohR_iWU9imFQ&oe=6A4E5ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iQwamYb36AQ7kNvwGZW0Y7&_nc_oc=Ado9sbSh5q2qq_-bujf8fS5OOavzzhBjlO_jn8cmuHUwcKdKy1IWnung-4cCT3213rU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLEUvwWANKFQYDoQ418HMBKgwD4Kf4c-4FloxMySMjtg&oe=6A4E4FCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ou5oEvz0mkkQ7kNvwFWdEYZ&_nc_oc=AdpHqNvyT4OSN3PgVbvvuojF9oWQkSqU4T7r5Ir52jH5nidPRU9bh0DHga3ftkrbzGc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtTs-tZ9EPAlittheDHm3OBaTFVMI_6JYcqaYQoDaZ3w&oe=6A4E64DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vtnEH0L204Q7kNvwGtfzlt&_nc_oc=AdqIGah6w9pCUUdwZWLIFuizV5-GkOs8ucPqiowOC1cW8ZnkWIPMUI2UXEDcSEfoSzs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwCTLmMhyuT1wsnNTsYxagyoz-ygkDW0oIX-y
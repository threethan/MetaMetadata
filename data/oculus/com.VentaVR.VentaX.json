2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCva1jQOOf8Q7kNvwG5rxIN&_nc_oc=AdqTueMDnO291H90VYtwX4szn6mFQPJoSVVgZLloQ4TYgiBH-J6MOB4i28EIv8j8OSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TAxYABxf5ivmqiD8G-UfMK22Noem5AKwH6fLFt7V5cw&oe=69ECA466"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL-uxPzNkVQQ7kNvwFeiPYm&_nc_oc=Adq0RFXfjchjcNAwfvjE6uSIUoAp0luAa2L93sIJXuF7S1zcStymAXwz-4qISETZbA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_WRPmthSjFzXC5A_KweFUdn6UM3bpvVf6DxRZ8x9A4A&oe=69EC9F4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCFujLo157IQ7kNvwGqZ1kc&_nc_oc=AdpQ867lBffM-_q_jh4DhjR5Xvg8CcaYoGR2s0KscxaF2t9Xu6UlGjxcgxXZkLDBYt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Mz8XePTUBZBb8pfwUF0DTyLZmFaYv5ckRlnXjiEq3Zw&oe=69ECCFD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jkuusmqLRYQ7kNvwGWwj9M&_nc_oc=AdpngeDRn4Q25vV-E07a5OqXL7cuFigyirJC1IBKCWb-i7E27ixR_815W9fxunl0zLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hGOSsFLkIZisxm4miS2G5lOzn7hFtmh7aFfpxSWFFJg&oe=69ECC0CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDQO6mtYnCIQ7kNvwFbeIBy&_nc_oc=AdrToicdcNuMcF7BabvcvglCO8_ydXzRw0h18jZw_s_FnK0Lky7zm1416t140CqAuXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q2nwR5dYB0JL30RRUDPF2rTVGTVi6Jq0wIuX54PUaww&oe=69ECD5DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmbq2YMm4XEQ7kNvwEWgkGL&_nc_oc=Adrzxb8rkdtXy47Gk-3QMywMQkuUBrwHg9k2lKJuHatvtAMMYlThQPpPif4ycW5Swvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V_dGST9ipADvRspZAvOfEoH945__bcsrAz29
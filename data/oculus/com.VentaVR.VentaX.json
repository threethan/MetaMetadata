2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCva1jQOOf8Q7kNvwH0ReAw&_nc_oc=AdrYEcHMwTStJzMd5eITamz-yj5osHiVf4IOdr6CUlPq6sWHKE9etU5k-D2M5IQdWKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zDtc-VsHEzghw1IFQ2jCg36r_MqY8B7AXUeDo2LfBtg&oe=69EB8B26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lWRSUfpUaAQ7kNvwGR4MDH&_nc_oc=Adp93u05221VFiLx9evz2ZU06gixQbxbXm3zSVfIJgf1TMyKeAjsv1Hyq9F2eq3Qhs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CmHukStWtcPAdYmdkwriT-CgVeiO7sAuPFuk_GNys0w&oe=69EB860B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCFujLo157IQ7kNvwFpw1m6&_nc_oc=AdpuUQzCXBgarcypxhEc3_H88TgiOJdSJ5dx1EGY2j1kD502t4COBomPvdv16bXpoGw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ggeAwJIPdSe4Tp3wHiJSo8RATTv_pqkNjn6dH2wH54Q&oe=69EB7E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jkuusmqLRYQ7kNvwE9XGtF&_nc_oc=Ado5PQcHOdzSz4aVWCwL2EJQGLcVV2dj1ABwyxKLCX_i2WHXqQ9amFBHQYCH7uqTcr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ih7gY6Xj4jkZSbvHM3Kbu-xSU4D30BHnaYL7h395byg&oe=69EB6F4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDQO6mtYnCIQ7kNvwEBFrPU&_nc_oc=AdqjuNOaRd2GFyotoyE5BRVxwhI1dTS2vXF63lcHn1t36Ml7K0Hanwx7ZvC3e-aMknU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PUqp3FklMa_VpWGf_tB6j2pqAMBSZAgbuY1YKt2O5gQ&oe=69EB845D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmbq2YMm4XEQ7kNvwHfE3LX&_nc_oc=AdpH-Ws2e972KikMq296sP8hY5SrKvz2k0AZCbPsHOtNvVJ-e50IsoRQQGb_WujdrOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ruoT2XTX710v1cAGV_t78hbzbTnW31XiClF1
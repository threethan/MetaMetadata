2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwJ_dvaLU58Q7kNvwELqHad&_nc_oc=AdpZaVISNnw-ONrbOSBd67sx1F_leVsQbe7OAd9-VQ6nu1Km9cM-uLTGb5sJERUvb9E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ujrTmW5Hwu7ZNBBwVRYlhhKC1M319wbWSjabzEwlekg&oe=6A43DFA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oIf2ADrXUwQ7kNvwH5QRAw&_nc_oc=Adqgbj3WMsDePIsPXo4QY1wFLnrGH4DAyDoHFRbBptF1O_W7-csQHav-jArlTGMkcjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dMSGZicBPk47LDdNOOM3falY9o2LIG3oWcU2XkY7Q4w&oe=6A43DA8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMBz6xve2ysQ7kNvwFZcn5q&_nc_oc=AdqiUgM8wlutqjEGZMryec62ez7D1wMXwRpy7gTiceDdN03NHRcj1Sb8dTGiBt4DNjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QSQp_fDQfj8xMqKT3vpt8a-TVoc0DgbFA4gdpI9Snag&oe=6A43D2D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PedIWOa_-NEQ7kNvwFE9L02&_nc_oc=AdpaFGZ7jUbe-tFVRnD7kfyT6VyxiYFl00PCBLjpXBmcway2bo3O0JRVcgU4zLKgKrI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OorXUrxXF-8l192TJykKErpzzzy9GYLAVQH7J3Hx_tQ&oe=6A43C3CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca37oQnkUCwQ7kNvwEM48w7&_nc_oc=AdpGa2wyOZGfN9QhMQwoR1I49IrZHvIvRYGIwRKjKa-lnHc6FVk1hMcmcKFIq3zTMPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PCa8fUjTxWg1Cx62xijuA4H2_dGj8zwnF8ur97E7Onw&oe=6A43D8DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ7Coa8SzJcQ7kNvwHaFIJ0&_nc_oc=AdrG_cx5aTpoxCf393sQcZ4mbR4g8aa3TDeCMpPfgZgS39sXTQF_FyQeZQaeS6bTThM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MZNmyJWWgGnIPHzU5102ZnTcbKYu0tKSU9w6
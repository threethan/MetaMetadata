?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFFSx2rP9yEQ7kNvwHW_XlV&_nc_oc=Adk0ykEIoMsGIQc8wTXGt8wsdZfyJX-FO5UGI_tF-YTqVX2XUq2qud9WSxxWxtS_8JI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfszCguNJsGC1iAz7iZdG4PcnkpH8tJm-YWmXxVq9MZtVQ&oe=69984466"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3rMSb_PXUYQ7kNvwEY2PTn&_nc_oc=AdkpTrpHomLXo6EcDOzzy__l0UKt2wUtp6ECjPa4HU8f8Rd_8LSZuFNCziRGY9t-qTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsDjF5zN0LwRXsLrNNHuOvlBuIqsKiBcRNcFhxdhOTvFA&oe=69983F4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq5xczBpIsAQ7kNvwHY5E35&_nc_oc=Adm8mqiQnfTx9Mzi96n20dsKIWE9XEDD6jGCAHWhtil70NYkJPdmLM5zoen7gHJSA_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvzoN7U3X8mR2_CCrWNWpcCXJ5hNVVD0zmmI5RRtKXZyQ&oe=69986FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqrPxH5W8EcQ7kNvwH4JrHZ&_nc_oc=AdmBUW6odlPz8mBHO_U89Qct5lFJtsLJBSk5C__j0dk70WTT5PcOx1jjRHmyWZXqSis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfssRlKzCeJ7LZkmsTJo-Ol3dkbrybM3Tk5_41JM3xBqJA&oe=699860CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcQNhKdugT4Q7kNvwETsOGL&_nc_oc=AdnITaVmAhauxBiYejAWl6tSWR47P1Rq5IANHrlFirA8PyQ3g1DXVEBSymilxgeTZVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftAD0UQvSGXz-tFyOwFo_kp_z6hQpTcjY1UZm6FIC2cCw&oe=69983D9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BfwXT1Z6E4Q7kNvwEGqz7h&_nc_oc=AdlpWet-aMWMTo_NjyQBmBPA60YOwaU6qQgNqThQJo78jooD0mAATNDJpDzOKbArSsk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftrknVoQnmQz-wtzSoh61gf1tM7-6BvGZ15PhkI605sLg&oe=699841A0"}, {"file_name": "01_Hero.png", "id": "1082791666697111", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75556807_1082791670030444_1
2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZfY9f4a8BgQ7kNvwHhsoOx&_nc_oc=AdpE5WID8JzFbcRtLIv7INbSyjL7Q5cLj0i3240MMc-9IfJuaKE6Fq1bLSoT2zQY1Z8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qZEiWvMqMtkUwCbOR0gFTiAnAQE_ZGXkyJe-rvY1ubA&oe=6A3D4826"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is9Fw8s7ORcQ7kNvwG0li9G&_nc_oc=AdrOwFPWOwDOEje_ZwZUi0Qf9xLuxPrcaGj12ZbbxvUaUG0kfeW-3zjRKWaggP-xqgM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VPgG4Nxp32_qFdSCAEZXLHRcO1sbdEt2yeb1WTjFFmA&oe=6A3D430B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_O_xrYbjmY0Q7kNvwH8ZmGE&_nc_oc=AdqI8RWQCTYHArUQIEL3POOfdSIkj3ZJJY1Q0xlFpkssv5vlqjqXqUWs_AvAroUx51g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8HB87-pf4ZPV-XJYHIPYMMUKnI3GzKCpYBnvFcg88yw&oe=6A3D3B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyd2tf_7iTEQ7kNvwExi2-E&_nc_oc=Adr8mraR-WntoofohTxc-sm6_-WbdW57CEL9vCUHMX0CT79CakmUsfuBbAkWyyWKQT0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bFsgVWFSMejyPTHwXRty1IH0A-OaoMBawgJBhbmGTpA&oe=6A3D2C4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqi4z35XHn4Q7kNvwGMZvmp&_nc_oc=AdpYvetqaWAptb0E-09212O0D1uskq3e5zjQEKwbB298EJqHV0pwXNfvrkVDzTksuWA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_stn5SXorurP1rNKuk6iNjV8Ljh6c7Qu9qh8ZjuEALfg&oe=6A3D415D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-XYASF9BgwQ7kNvwGwo9fk&_nc_oc=Ado6e-mH_YEQ2d_EnJDmHXqyCtxq-tr8R5jWdbXrB2sDcnKbdQXZ_mLVGYApkSdc5UI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ec_71HRJot0OIMLS-AEg9Hbg2rMklvLwLvhy
-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RWwbARdOqcQ7kNvwHn0rL5&_nc_oc=Adn1ZA7BMNghCqaj-BhdiMG8bc7EEHHS6lN941ySenZZj66mhXOH1HRH36RcLV23c38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9LYFNwtwCRyWA2TwOSnjWlrM99aGKbcp2om6fqMdUvQ&oe=69B3F3E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN0_QWQ3hqoQ7kNvwFRnzPG&_nc_oc=AdlFZ1OFjcvfOM3hACGFqP2UeG-G4tUYa55Xf1qxYhJ5fCQwOJ1V6KIFr893FyeODtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3LgQjcAP_x6yP_TLgiRbfSPaOZWFEHtBTkn5fMqTs2A&oe=69B3EECB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7_eTWP9E6AQ7kNvwGU6t0b&_nc_oc=AdnCQ4YYba9NrMlIIuwE6ozHhTRSfzaZO8GDdDi_uCC4qccxBfKbMKQ4vu1mpz1HjYI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzD03IZCzGmD5fY3AchHqkK_zNbV6VQ2RNgwqt9548E3w&oe=69B41F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEjcAFcCVT4Q7kNvwHUp4Dq&_nc_oc=AdkoSkkt4XmTp1BsQiz11yJIsHw5M8dwOCCHKGjkrpHD42cK1Vw-aBSVOOCFutQ0lw8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4RjkAnJbra8PGn8FJm2qv1Q5oEiW0WDE1vdZPRMl7AA&oe=69B4104F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoJ9tQLyIbQQ7kNvwGyoaxE&_nc_oc=AdkL5af-jTkqpO0aslUN7FswHy0Mx8-K2Hv9HUlUe_hBcYX94rwvfbyyIq4KgrkGSx4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5vQA-fSkhStnNzT5v6tFXJPcicv9qP-e3MyC4esdHPw&oe=69B3ED1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InRg4cR2jbEQ7kNvwFEYo8I&_nc_oc=AdlIihPfFBu8wVNXLF6mxBfFXD7bWDifh-WwsMVMe6a3PXn4_dY-fqVyBhtMPkl3vg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzI6OXqfdMqd7wqQOsUQnmbHH6l0pQRP-edli9N9bolLg&oe=69B3F120"}, {"file_name": "01_Hero.png", "id": "1
2063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tROKpbZ-GsIQ7kNvwGczL68&_nc_oc=AdqRw1XcnXFv-wfUr9egliMX_OW5Q_MOaUkEGX_Pc0tYcyhWSpzzfUodngyTq6LAt5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78pX4RhFF6vJ-GTveGgH17x-MjyMVdGP6nNdeTwYtn0Q&oe=6A0B2F26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcJoGxtdjgIQ7kNvwE7ZA9c&_nc_oc=Adp2TM1Cy3gX3Hz0BCL5sSPQgQGO3V3_xhh3yfbTDmyasNDwRFHFyj3uFNzwmRlWr4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DvlubrWeUQ3MaF8r_rGEDbQzWAMn6_wrOw5PwKNFPKQ&oe=6A0B2A0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B3Vui-S_LMQ7kNvwFiZFET&_nc_oc=AdqEWnJ3-0JX_a7KOumSwkFFXSUg9KUorRdtsQaiUWQLeOAWMChugWgzoKHU3N7ltZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57mOWJp7ZECZ3GdEje7AHW32767xg_ZrpxSYq4J9_kCg&oe=6A0B2253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6y5xzL6AucQ7kNvwEVPe0X&_nc_oc=Adp60Gw1MJs2IThVqIvpudqWrVLQII__8k9i7Gy-3kW-sI2wsfpqgMlpCIXW-T8z-XU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_pQuKRLCPQNU9C1uFfgL1ozqcFgpJzE9F5kimC5AItQ&oe=6A0B134F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejTb_MRRzygQ7kNvwFHvKWg&_nc_oc=Adpus-QbEGJAsITKKqIUucc-_3rOvFfU672q4b3bdWh8RtU-buDR-9I74dSURGVjOK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i__EEGNkNChWts3VODagMQlA7dParzII3vFdvWdllJQ&oe=6A0B285D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP5TBHb5OqAQ7kNvwGt_oP0&_nc_oc=AdpqO_TDLNSRv7WLyA66VcDNOhl-rahqfDdg0W1njR6AQ553kddG4gVdpU69u7eV2IQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Tk4goLQPGSmNA7qw_K0-dOS53iC2vCpiy_zZ
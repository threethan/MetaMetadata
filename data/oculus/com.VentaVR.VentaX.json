2063", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg9E7BbYl5QQ7kNvwFYmHs-&_nc_oc=AdpSVfy1dh0eJSzDxDp3_GY-gjxZ_N0SluDSv7WLW23cxMl4CwEFgMF23OFBsDiK7JU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG488kkwz3ZbmIpDHJfbMv73xZb-S3I6wP3WgVEWKytw&oe=6AD39326"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VTXXNl_eWMQ7kNvwGaAOL5&_nc_oc=Ado2glA1ANNjUV7it-KSA2KN6xGNJV3GWSgIvSowK-8evzmFwNGyXmCjKqHQ7ZR3WcM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9RlkcCywdsAbkPmDpW3-Fs1vFQSf7yuDjws2pAXSu3g&oe=6AD38E0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PowSdoX9xMkQ7kNvwFa8k1P&_nc_oc=AdrvvbtnJ8hqGxIj4mALOHleK0YZlc6U4umL4Nad9am5uvdrI64EB-_ZF2h5HdIqeWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkybHzjiC-CxT10pnMrBPkOyUINcScOZJhzDJWOHFe_g&oe=6AD38653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7U8GYRPf-IQ7kNvwHfm2L-&_nc_oc=AdqEwwlhEw55ZcaMUVIgtF6a6XnVZIiYZumEOX4MUbY061zXp8yLy_52-woi9FDANr4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwx1T2ecgQUKbbeFI3GbwTUzuJkKgY9zhL2hj02r8dBQ&oe=6AD3AF8F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvWG_uujFAIQ7kNvwGwNyAI&_nc_oc=AdrharmJHGNVOaTuFWVtgcihHra4OKX3zkr-in2KclVxhUjyaw7OW76JEH74yOUJDWs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtn0Eff9M42L0xkfr6bt2QlslJlsPvkHEy84dNy3scMA&oe=6AD38C5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRi40zw3pZEQ7kNvwFigAOC&_nc_oc=Adr6214nB6ksh_3morRhds5Q2CA5cHE1d3PwjMji60Clx8FtN9hJq-6fubVXPeHzDmU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSGfjr79_yNLevURJtvLl240vVFiO_gXGMma-
-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RWwbARdOqcQ7kNvwF_ELuM&_nc_oc=AdlN-1RwG9AMC0wLfgSCX0T-L0gRUjs-sg_8m1uDsg1YxMe3qPRv5DEd8ls_fo0YZlg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy04m1ATp5glPBbT2XQygJQ1r7d9jvzsObT45Jmwn7fWg&oe=69B2A266"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN0_QWQ3hqoQ7kNvwEbT-DU&_nc_oc=AdlLg2l015Pqs1o05zlUl26YxxMa811HtT6VKTewRE157p2CtD1G4Y8WXmd1RiARLT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYvTW_zXCk4aZAT7iPO_UAecxn8LPUJ0hXrUxplTrHlw&oe=69B29D4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y57-ljXQh8UQ7kNvwEAiF8d&_nc_oc=Adkq6gur822UQVqRkUxkfysfR-90cMs2lRDVbTqKBR9rAA91xbX5LJNvLruZS-sfNYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRfCpOuSwcYVbAa4O-hrEQQNBWtna-u6XLW7o4WFmSPA&oe=69B2CDD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkt5VL_y9soQ7kNvwHe8-7O&_nc_oc=AdkEe9FGmT1IUrM3bmqwLAvs4CKnIpgiLKgH0DU-RHryvLEmwscl7h1v2R4roUIfH4c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfkWtSfbBBidN7sZm9MWtiQA-9oIW5DLEAHegehlXb0Q&oe=69B2BECF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoJ9tQLyIbQQ7kNvwFMVUfq&_nc_oc=AdmagVVGy1D3piMEO3q9nkpcpNoR6krUblA7TscQF0RPCK2Wfcl0A5kN9x7hebg2omE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn17fjNuem9GPOKY6Ef4OiC07_a4zpMG3oVSsQOurEAw&oe=69B29B9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InRg4cR2jbEQ7kNvwF0xJ6K&_nc_oc=Admrp4VFv1KLLpdvht75pQ-8_KJNimvsc1_FromkfU9D7KHSeXJ-4n9X-H-A0Ck1YFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzh1QSsQbK2N9MK5lBncPAqwQ3L4FcYqxHdTYAYt1zVkA&oe=69B29FA0"}, {"file_name": "01_Hero.png", "id": "1
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5XUZXIMPQ8Q7kNvwEh-OU-&_nc_oc=Adruu4zViis997C6gKFOsiZcFziXtpeve3m0GtUs3O_C5q_d7dqDqWzWOwaT0-eQ5Mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ItgVWU-NkD2tXj3gNmJnZKHcXXYSAArzU1Z8UOuD8uA&oe=6A258D26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB5tVfP3jCAQ7kNvwFX0SLr&_nc_oc=AdorIEH_9IM3fQJ961j29RbTU6-KWNJs_UQd_nRsLYbpalEPxPO2Ht2m1e4gHEgXbmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VjsMokG15xdSxivo0Vu6n5HiGhONEaTYrL5IfOOUQQQ&oe=6A25880B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK3ftyaPBGIQ7kNvwG40PNG&_nc_oc=Adq0R0kJwrd9odHjJGHP9MgeT3XykrVyUDeuTSYMzyaXAnDbr3X0ytYDgTR_kkl1viU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tEKgUuEka7G8_7mJ6MLt0ojKhQA4rHW6CZzHgnotAMw&oe=6A258053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA_j-DnG0J0Q7kNvwExmYWr&_nc_oc=AdrNUPfWS7rX11oe5rAhByG7W382IgePmtoCQoxB9jnM6SanoB5zL5_g5G4buiX5eio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9YJexP__raJIHfds2DRnuZN06wyfnhYYc2Qv8vB2MXw&oe=6A25714F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf0D98g551IQ7kNvwGnmo0q&_nc_oc=Adpbi7SUnyJgzZiEOZCUEfO2QAt8I6xQXgxs_z4qz5IABo089CrTaA5V8hK0NBNFGws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90dMLstiXsrPJ4z3T4Jz8jUdwu3Af-qaGhJ6X2SJtd2w&oe=6A25865D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtALb8kVXjAQ7kNvwG2mPnk&_nc_oc=AdqLpwJVB9qv9UUI2PgURF2e7KGbhWZJY8620TaxWFkDp15heNqOeERmbunrs3b1lLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Q2YNGBMm_I4W5S_mDTO6prpqOPaTAfqHfov
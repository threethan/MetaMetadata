2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZfY9f4a8BgQ7kNvwEMiONn&_nc_oc=Adqyq_n8AgDFZrC9fkMYwUGBIWfKaQuBvGsmlzSMFI5G1vJ6BKyafhY9ODz-don5M78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y7m30OlYw1Kx-xB4M0J3Gci7KqFcMhSPnMLCSlzvrqQ&oe=6A3FEB26"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYy8gq7HrIUQ7kNvwER3y-Q&_nc_oc=Adr1VPsPVSfM3v4_i9WKYYQKsxpdr7XqdFT6SiXqh5WFU7PJ1zYGH-I7kzK71lhHSms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WuIsA11a79rzTOqCmSHo_nJnfQUFrCzI3LG_4u__05Q&oe=6A3FE60B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yP1Ea1ON3UQ7kNvwE_I2fA&_nc_oc=AdrfVKCatls6fsmpc3lqRYIg9Ferv76kF3wV2jGuZd2NlcDv9rnTT6LTx-L2qsAi6Ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zw3eZ2GJEeIdi-WA53tFTts5Z4hUTO72vrPVUxxaXoA&oe=6A3FDE53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI_CwJoQklUQ7kNvwFnq9v3&_nc_oc=Adr5IPf2QlHKo4-7xByKdhKATmFfcyKq2AmGW1Lb8mWZzr7JMEZHaEtJhcd8EvkPrKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UXJ47-KytecjmnPqqIE3-_KDDWJU-qMxVO48ICon1Fg&oe=6A3FCF4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqi4z35XHn4Q7kNvwE7twbi&_nc_oc=Adqg_eu7Px2racgmYcbmX1VCAisOvlRVk2CtHTUBOFWaKgyai4YWWDhGgpo4WYCJOc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tyxrw2HtDwwdNICoN-HX7iLSSgIHuWhx4Bb1cd3CjWg&oe=6A3FE45D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATnOLxxRJUgQ7kNvwGtTNkk&_nc_oc=AdqMNRhG-XMX_kcNn1g5pgNcnZ0v61DSvk1IJ2EahmqktIFK169kdiAsvPsTPjqNUeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XGihyA31ZGLnwaCQnwIIAIUtKW8IxDoFswNp
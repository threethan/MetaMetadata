2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FddDWCaKw0MQ7kNvwED_UVx&_nc_oc=AdoJoFku20YQQpA-gWEd1gYnVwdLFpp1PI-5Vmf0tfzLBVzz1bedI4D1C-n66r-g5FA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCgSAGY627x4LeZP5agXNI_D_d8PxSeZ00bH8Aceud1w&oe=6A649CE6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXrvU9h9XuUQ7kNvwEtjbv6&_nc_oc=Ado-zb7prFg-Cp-Bb8K2-hs9ZbtO8dLx1IHDmrRYsM9rsiL5nxQQz6f8EV_9XsYb23E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgYJtixZZx1kM2coRJ7R0F21WPzIP70cNj1nLWxgKeOg&oe=6A64D00B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNL4pgND1ToQ7kNvwHZILEn&_nc_oc=Adr9iopzAzncdVp7UzeCSCyho-b5Ua1JMzCUenwB7zQzdDnerh11VyA-tJ8RlJAq398&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy6GImZxX_AM5H9YtwwMpK9YU7h5JWDJGiNxKE9lHL6w&oe=6A64C853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQs3Ro_gZUgQ7kNvwE1MOLE&_nc_oc=AdrF1zeaWedBe8lel5-09wvTq6jSab1RogoMZjTbn4m1HiPiyK1iZcY7Q1Dqp8qbm60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwnxYtx72raq_L8NYdz_NcxpzLbHbOn1QMY2o5Dm0dDA&oe=6A64B94F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sl_S5ptwRlcQ7kNvwHqSqAG&_nc_oc=AdpLXvQ5LYLSd3QdkMv7HtBmTN1ZHY7KWeChhHFdj0ieNBUqzfQB20LJY-tPH2FRa3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_XSpGBCaXYKq_cEQGDsWTRYDmQRF9oRHkx91S7WsnEw&oe=6A64CE5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjzhO4PjsHUQ7kNvwGN-CCi&_nc_oc=AdqRxISh_sbeGe0vefzUhq0Z9UxwxDkNDHtZqo8sfWc1ehde07w7CIrbFbxC5xp6gl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCqib_NO9XMiOXdeNddXM2dlvThzsLbKLNona
2063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3KA8zqy-q4Q7kNvwHO1UHW&_nc_oc=AdqzcjrTruCb80eICsQYcn4DJV0E6jBcD53ONuYbaVJExZ8M4ts1odqzCkJcnRow-SA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9rreOpGm-1lf-oY0h8RpEY0P103HXi0CihgU6PVou6Q&oe=6AF33726"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvtd2j-6wz4Q7kNvwGSpGFf&_nc_oc=AdpKllUdde1RGD1tdZGeCeTcygHxDgz-x3U75sUZSeUPSHB1LshiIBEKsMQmnwgwbUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7LGVxlb2dSQDsEWipB3laoz8GZQ4TTJoWLdM153dd_Q&oe=6AF3320B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ErqJG6OpxAQ7kNvwHeWMHL&_nc_oc=AdraVFUuzde5WveNj21phbzhKuuadYY6a8aORHXsrtpsbE2Iz2yGBJSn014UOkR7CRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR62DtmGbh_RP2IXUp6ozKAR5IbGnkq5yAq30_3QEGwCA&oe=6AF32A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ7CY1ZXYJIQ7kNvwHRWW3W&_nc_oc=AdqMkRuofdYVRGK78sux23v4bQcwYJ6SG1NmpGtRzgHm6f2-ptBXscCGcBBtIvy_-c8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn17_bM1aOKieUaa1e1ig4IH-hoD_r6oruliuxh9qqPQ&oe=6AF3538F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdCrPK8UDNMQ7kNvwF_xfKv&_nc_oc=Adrt_zEu17n2gL5I8IIEjCtuPcn2e3taC7-8Iu9UYgHkz8jkcGshdbrTyU5LIWz1iTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN1S516J0gEGS9yc7Yav4am6rPHqWhS6lsInbXtQGb-g&oe=6AF3305D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6uuGfXfgH8Q7kNvwGfvFa9&_nc_oc=Ado2cIEKrCH7TBWC7Fv83ncAXCAacJ-qJSnkD2znHk7tPbKFHvNLz7MJi7Iro1QHdNI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7zmeqBngmzvQWsPqYrzHLp752RyZCA8lz9xA
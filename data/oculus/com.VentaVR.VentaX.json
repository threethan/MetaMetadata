2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-JgIFeMWEsQ7kNvwF_gJW_&_nc_oc=Adrg8kUTp-xsk5kuCe2AybwvtyeDno0gEoGSpZqBV1a-RKXx__J3kS7WQZ86xQ-TZDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuCgTnDQeWRsoDt3vGmakC8qQ7nrTl0eyAJKMBcsNKnw&oe=6A7C57E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCHWycAUHDMQ7kNvwEEluC9&_nc_oc=AdqTFFmCw_H_87cXiZ4gmCmoEpLhkBP8edRYb0ipgvnCRaBv2NVuSmU0OMcV3P0Z43w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMKb30O_QOmgUcefIFrilm2kaB3xW5xN-gekHOJFAy_Q&oe=6A7C52CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOUMfsP5ZmwQ7kNvwGKxzjF&_nc_oc=AdorGG1tukQEbwjJsTCg9tFr06Z_frcb3-qjx2ilIy2lGL7dJZhclJbByoQnc9nQnzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkHIqlF8PeXCbWoZUWH6dqO76huoSGHPLgOF5EphJCTw&oe=6A7C4B13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QToZElk1sgUQ7kNvwFvPFoI&_nc_oc=AdpYzSBaCfGFr-HELdShXt8rqsX-nl9sUQfHnlpwcs95wflRWqjTxmI9JKrEJ8wF2bQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4ff_s1zVp2yyDR3-aGr6aHrhIwDovCNIzmhMbapja8g&oe=6A7C744F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OclhlGXKnjsQ7kNvwErQH92&_nc_oc=AdpgKmqn-owo2VDCZfjT-iyTyGwDw8x-t5C4SdatiPtE3mw--nzLqvmpnjNx4O6xiOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi1uvARGYjXVFyrym5wAbky_srNxVsYpZ_ZAEWZIzydg&oe=6A7C511D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW3WsPHg7l4Q7kNvwG5VlSZ&_nc_oc=AdruvQbHwcpgXALcJAXlAdyya3pQd2YGHxMrLgIUH-K4RWU9nk99WOKAqOKbAmYLX4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHljc1lKHAatJgWI3vqU-YSWH1F9OmOTN8ve8n
?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cDBdrpeoCAQ7kNvwHnWo9U&_nc_oc=Adkqis2Zjv0PhFN3bryUDJnjz3gcsDoNo_EuFjoYscGkF-ehr-6uzry94ivZA8Ig4jI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQRa_uy0BnCmNqcQYFMnWNszX53epexRDaZiZcywFh_w&oe=69A02D66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHsJAUc2Vd4Q7kNvwF9H872&_nc_oc=AdkXFg7-acJgoHcY7s-4SDuWx3dqeycgmxbf0_vaeKmQ0d6EOMKZmz9b4oQ_g9SHanE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8Ku-pzeE5_uDXwZ-g4PUVMfPSOxV4fToU9ZOxddAxiQ&oe=69A0284B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe2WUux8Q6MQ7kNvwGUk3zJ&_nc_oc=AdnG-Anb8VSb6rx9rG8bY3KAGs18fOPxbrMhx-ttmghuK9lQ4RkfiRuzLcI_Ud1Cvfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDRtBiX7N-knDiaEXa5YVEnH9ei-8MjrdqgopHgt7wPw&oe=69A058D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PaoX7US52MQ7kNvwFZKXM5&_nc_oc=AdkV1U9a5Gu_Cl3hL30_9C8sngpO-6rPOVzPkKyalsR47VWHeuF3IJuHvFGN_GA3SCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsyMPXhc-dSuZ_1FkWMThhv0KrAdaZ39A2mwdW6VvZMmA&oe=69A049CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzvkTFgK_bkQ7kNvwGUrPWx&_nc_oc=Adn654ZAKxytcsoY3a24zB9tCXVvIYnvUclh9ssMDp8eoduSYb2oREmuVez-8eveOoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftafD-952CyBhdP1clPo4j3dqIYIvj0mYJiPUzir2y7ww&oe=69A0269D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3daXHfiOqisQ7kNvwGl84ge&_nc_oc=Adn6iM2UuJweH2k944ikexh5J0qU_EvXaAk1AStJt-ZHDMhecekLfdrsXUvtBCnS_do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJ-0WaeJ0VFT104rDvqmmokODmeYEC64ILcxEDCe1fag&oe=69A02AA0"}, {"file_name": "01_Hero.png", "id": "1082791666697111", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556807_1082791670030444_1
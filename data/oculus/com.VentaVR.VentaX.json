2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlGKQONKAaQQ7kNvwGDVCFX&_nc_oc=AdpDg0GosnSLcMaFsV6uIabjtxeGrUmYRaA4ZgCjsiPcun2yNz9IAyCica-QNLsyxog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97TiOPU1cUS24G0GSXGHNtokjhp78os-HdZ6Kg1AkVrg&oe=6A380226"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGpzrsri4lkQ7kNvwH2qFMR&_nc_oc=AdpkYjl1FQwUjET7b9WMKsyqO5MNnhYUWPMt-3a0ewhEZ41whbY30CoMZYNGZ7O0eUs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GmaJWRNG6xeFXV0waY3EdKNYK1voO1U64wk30Bu-diA&oe=6A37FD0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ea1I2PfALQQ7kNvwHtj-ip&_nc_oc=AdrZs-g0nwWrPf-vpxb9Ckm0KQL3VXcucfRsA27rKLi_lVUpYrHeLgkA-SRQJvXBpxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AfuvRX57TGZWm03zGfF2zz2Hm84r5SOcZTQRD_RP9BA&oe=6A37F553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYYYR3_838oQ7kNvwFm4gWQ&_nc_oc=Adq1ylddQGta53m-5K6qRNlyROCN4AMgT6bfy67EQfeWoG70aF6koD9MvTZlkZKlE2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qdhLB6SKInQFvc6gssVBpwn--66AEpb0-fvR-2bDN_A&oe=6A37E64F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uD9lz3V6x0wQ7kNvwHzvtUB&_nc_oc=Adp1waHdziQHcSiTZsZRH3_F8gtoFhUMeUf0w_1MnrUxHIFG3a9LCgjYKs3-ccUma0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ERiRHtUbNEFTJ22vKavuOPLS0kYoYV4rPHmBtmuk47Q&oe=6A37FB5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgqXokDwAJUQ7kNvwF_0Qjq&_nc_oc=AdqpBJ4IJCboZenSYkrYu_j18thvBxnk197CelFCpbhnRp4ivi32GlgjPnTZb8tcy4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JfV--t2pHZJNctCaK11DkXgS0TM4ihvnKsk2
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbnboHTlLmsQ7kNvwGmAH8_&_nc_oc=AdpLi8OWIEB_DiLuznIHOBCfIeBI5JamQH5fvBnR8MnNBBuXaA52yTak0lGG0p5lpuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-01D_HhWFghiSXs20h9ViQS4WVY1lSBQ38m5u9OWdiQ&oe=69D63AE6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmk-O1zoGjwQ7kNvwFAKxCD&_nc_oc=AdrjpFgmbwAMZR0W36FgCGEN_yulcok4Bxp4rYFCWbv0eWRhYVQI4YtEyLWPcodwwfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29NQSdMXF_-INzfLjMJUOawxP5yJko_EmjoZyBtjp-5A&oe=69D635CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OxUaHGtSMwQ7kNvwHBsM8t&_nc_oc=Adpuz7ApxiWaCEFl-E9EguumYZvA71lr0AOjwM4uEkQ2YleOYBqliZcG7I1ZibR8JmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QDH_Amzwi4-zTsZMxdF_X2sEk0edcDQIvaUJ4SYSaww&oe=69D66653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EC4AwBGd9DQQ7kNvwFHE6wQ&_nc_oc=AdpJBngaj2UNeAJGoXPKpCUKmRbnatn1vHJBfh7Bm30uGcKFn_QDY7YbyQn_6dO0Z5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oHC0WgMJFCC88kIISKBipHGj5BfmRz_a0aZjRuiCIIg&oe=69D6574F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4IAYlEeGZkQ7kNvwEe7wDU&_nc_oc=Adp7_F41I12UKrmOCPyyvg-L61B3OJx8A6OBDNPBixgoVLbUBHiS75ZVDs-pjhxqNeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L9W8I8NfBiLWpXSWIQDd3zPZUg6FzGxKtPI2ZcJ0-iQ&oe=69D6341D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYTi2iO5SfIQ7kNvwG42i_c&_nc_oc=Adr_ENhZDI_T_WRAgjTE_QzYIW-HzLvhPKuEcpZno292btghs3VLFAvi8i2wBaKFKzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Bcv8ahKze9dONdoh6S60XFNICd_IefL9OdSU
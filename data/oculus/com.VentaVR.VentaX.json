2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lanOZB-Fy4sQ7kNvwFluEAK&_nc_oc=AdoZQ6vhRbBg8bgNe31lDtaFE-JQ-RQ4PBd7sIA5I6T5RTTW5mrlDb0qgM0T1o-Pp70&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ICr3ioby5uBD0cicNOJ5dUVmOFHEOAQtfwe5-k5hXrA&oe=6A034626"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUf5LJhFZIgQ7kNvwF4mwS-&_nc_oc=AdpBJTyuhJuiif9TO-MkPXkjQRVLMl19wsPGnR5r-nF8UMyYFrZ-tL0mfFZaGyYbe_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gPz5MLMMhozHO04BKfKIOeiIxQ5ncdRHab0NeiJcCQQ&oe=6A03410B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJy_9j2xP-0Q7kNvwHFS4Gd&_nc_oc=AdotfuAGXqawQGMWg0tXBpqXaa6vPE7F9Tfab8JAwn7YrybloCyKrdBvXuduMZvIhCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42FbzbFYtV8j94CH_qU_rsCzV25K9RsC7-OyqLRwBznA&oe=6A033953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhLWpmccjDEQ7kNvwF4BYFy&_nc_oc=AdpxpWs0efCwm7dtiuhe4qHfxPlP1Y0DxJY5IAMlxD9xqfHynF9Gq8Ox5cHYIrvx4AI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rTLRg00ozjYYzv34IAMBEkSAowsxuxitM5vcrSZHIOg&oe=6A032A4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i76V2Jn6r6UQ7kNvwGQTbDV&_nc_oc=AdrdE4T-lfpyhIWYX4d6rVIesrZtMXg-gLLwZyNT-MtxISMwyaTe__57Rw3lblswIE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S-jEVayMgz0o1dHvGsFQP7JhnhYoW2ynfdx0FP1a3XQ&oe=6A033F5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UST9Yc5V9QMQ7kNvwEU9YcC&_nc_oc=AdrKrMqqA0LZ4zso5Lsq-OApr3sEShassLF2XD3sdCROY8UiDrO8obFavtd2KJZ-_xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tynavKIR3wI04jP9a6ngnT6ahtAR2GsGboBh
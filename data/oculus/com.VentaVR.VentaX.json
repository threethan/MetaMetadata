-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLjR9vCMxsUQ7kNvwGx2NNm&_nc_oc=AdmliblfnZA1_TRMMeHrrGc67padGaT5RaYZrenUr7mztwmXOn3QeDt1zX7k_tUlKNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvHo6RvEFCbmOoaOhvamcnim_0P5fmUwq8gNwqjFvBncg&oe=69A81666"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28uMUrA-4kwQ7kNvwE0PwTQ&_nc_oc=AdkT-U1d17hHl9F6wkcZwq-Tof7_gXT9Ev3x2DaE79JH1vyvyyW4k9uOQWIXw3twG8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftDWkzxEShwP25dqGsSYLagM61paSWfpH-TFjysKs6LVQ&oe=69A8114B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N_6vKWE-PUQ7kNvwFc2elg&_nc_oc=Adm_bl_CHYTM_-rbV0sUEj3ZFHnxAXugLb2NHCOynKgAStjLVoAjIVUk93YmYHr7YJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftFaCxSxCFosSTbxJ-82wcDklRIHkXVZ8RUv5GBs6ZrFQ&oe=69A80993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZrazsAGIJ8Q7kNvwHS19Vj&_nc_oc=AdlNa6tCeJ0QcyZZwQINX-26iL2dVD8Va-puNYEMLKvFVPTuk0Y1gLISdKZPgfMQypw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsBLBSVZJWAGRzpV9ug3vOGAFBMyJAZoxLcL-HjV-Dmng&oe=69A832CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60DbbgfAGjoQ7kNvwG-vZXf&_nc_oc=AdnJxfniMDuozb8vvKXW1Q1_O5r_SQS6eW8BqAJMUt7boKJwUaw9jWFtHSGTeoaaF30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsbPtfydCU7DvmAzjkQVj0aL2XmqjX6wM1vCG5d_nbd3w&oe=69A80F9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXCa2rsbr_cQ7kNvwH9O6wp&_nc_oc=Adkyk72kXcbviWYv_qfUXzgwey1msmIJ4YMd4drooJJdJ5gVDNUWZMHV3h0TfQt5Kno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs2KXMJqJS9AC6YoPPC4lK40rWmTkbt7L7HPDQYOCZ0ZA&oe=69A813A0"}, {"file_name": "01_Hero.png", "id": "1
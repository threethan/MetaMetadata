2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VnAkoHCoDIQ7kNvwHATCD4&_nc_oc=AdqTa-dbOxU5jZLnlFLAKp6ZRWhHo4XZ1tzzqFADsuo7k61myS3Jq-XpqsaI2W443U4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY1Hgyc-_2JVBDQFyAHt0tIaw2NMbEwqGrRMkZSMnZVw&oe=6A86E3E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJwoy_sDv1sQ7kNvwG6CR2b&_nc_oc=AdouY2IKsW7kmAhm6o7cWsC1ErofVFvmLLth4IxSbArlW18a7eiIrOsVg1BddjfGX8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2ng3wmf6HPlB5eercJyUmz940US3OLGquXOppS_pgAQ&oe=6A86DECB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84z-Fhhu9dAQ7kNvwHK8-qh&_nc_oc=Adqf6CM9gDIdoEXdHp0wSBj268zJ1vqYjtQM3FkiAQXAYIx2u9sViHdUg_hCAcft5Y8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFJsacRhTg6-LBygQKWR_xxVB7TVZZ3tVpXmohF9fqPA&oe=6A86D713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-0ODoYVtY8Q7kNvwE_TmLA&_nc_oc=Adqhqj8IrD-eh3gOqlYEVdj6qD0aGut9R3xtA-rq9ydlyoqWOzAuRNGJIzAzXOvIMHE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuGkiht-ELjbg-Inf7AhC8xxO4EYIe9ysBFpoeeUde7g&oe=6A87004F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l63CaupZL4YQ7kNvwFUWPmV&_nc_oc=Adr7tY8IkuXEUg1LQbmlpmDCZWQeLZm-lC-pTSe8HSVkT5YHmNgP4oo_ogtMX-6vQVU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPNY87ig3gh_57wfQOLv0FtZP6yUIrSPbcZKtl1wRqCQ&oe=6A86DD1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-VvZh8pF5MQ7kNvwEoyiKy&_nc_oc=AdoDY5l6uZ869TvRuvXHQH-MifOqveJ4HjnZcNrlFaD26S5X3a6gomJiGLcFQB80rFg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO0pCln7D2nVCHQLK5ao7qPkio_w3-rG8SL3h
-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myger_h-plcQ7kNvwEB-YA4&_nc_oc=Adlmrgtfq_hfzWJrzFY9n5p5ty4-oqr1WoxvOrOnx-7_GG7_BrrGM4ChDufPhSBYDYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLJYFdKq7qKA9TmUR1r0CVLKy8PuSo-ZrQhp86LMv6Pg&oe=69B150E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN0_QWQ3hqoQ7kNvwH5mJHJ&_nc_oc=Adl49davvF9bCvdwQKhIrfW854YDFX0GR6DJWy8EJhyujTotfAGf9fn8hHtVKA_qoyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCyiwO9abWXv6lBx1ToE58qnsXr0Cjt8SbfSBjT6X69A&oe=69B14BCB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y57-ljXQh8UQ7kNvwHne1Vw&_nc_oc=AdmlrDe6BEEWOS29N30FMWJFoFMx70JwD3KynETm1kZQR1olifN_VLmQQaTvG39woNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_HmJnvIxAKnWE8fatOiE5BGh2MdS2R9rOsfUlwGEBEQ&oe=69B17C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkt5VL_y9soQ7kNvwEb1Rlo&_nc_oc=AdmUG-3Re3zedCXpF932655gGqP6IxthutoRtwMruWA3IZotdmN1HAKwLHk-gMEfTuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwlBJ6x2Ffi7JDkjPsqPf8Feox2xF7tfUJGe-bTbhc-g&oe=69B16D4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl4Zpg1IxtEQ7kNvwFBkQ-9&_nc_oc=AdkgdKb1fHiMe9Y83IzJHk_PbQgHz7UprPt2pmPfYb4hhkjr6NujSDEE2hQrt5HmnqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIAZddkZmic1JZIK7UX6QIlDa6Dr6V-T-Uk6yKi4fdqA&oe=69B14A1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvmkM1GFlXQQ7kNvwHsxYLb&_nc_oc=AdnJNfwl_UBmlnJwKywTCEiQG2lfp3EtBHhKNSA9d9TRHTmVb1cMJNkB3McFaB1IVTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwI5msljGcQOWMbS1W_vd6t-3RGL07P95Kt8lulnx_Ilw&oe=69B14E20"}, {"file_name": "01_Hero.png", "id": "1
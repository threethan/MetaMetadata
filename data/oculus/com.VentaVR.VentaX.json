-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bl7oz9XdvnsQ7kNvwFlvhpK&_nc_oc=Adlo666RNDaV6MUPeQ9uyaP5Owo8b51LPudmNqYbyMhMjMlgH6WiXF5ry3fhDg3SBNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydQZhoHJNNCUIRWwStcL0OVFMBKu_BudAOcr-iGsbBYA&oe=69B939E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCElOaosD7gQ7kNvwHiYN6b&_nc_oc=Adm-q7_iZKShRV4ksluFC_PSqbN6KyGibpA3GyZLPPthNJZtb66SLuBJwZSOOmyXRa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDbtyJrbnjDKlafwzeMLyiMQDLayEMgYbQuDlrLsMrwQ&oe=69B934CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Cz6CR5Y0ksQ7kNvwGrfSsH&_nc_oc=Adm38Tj-W-1qeP4OZTsr2v1Lh2eQr6tAHZB5YVqWT_e-bTxKOlrr-5sen_JMvIWGGOc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzzKmpJZ4Lt4IiPBmImasGz7rOYbVmzRJO6Ru42pQul3g&oe=69B96553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9nopQ5EAgEQ7kNvwFNNcwl&_nc_oc=AdlQi4mg9_0bgETMnUp0VbzRxyV6o9UA-P1ZfvuBYfbxl04sVqbC7G7PZuLJkDijgK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqNAzm-zA-4txTrmcJtncWeAGB8_XektNVa312DBDIMA&oe=69B9564F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vox_svnIp_IQ7kNvwHiC8Xj&_nc_oc=AdkxiLxmvWh0Q0RR965QWOFFbTEUr7bJObXabbFsTaIFWLKqcqXS0e-yHuL6hgIbuvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi40LrPdy6GdPZ11yI1LwVtn6VD-_Zpa-wdfi94tjFAQ&oe=69B9331D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UpuNqF4PWYQ7kNvwE2zR4w&_nc_oc=AdlOfdtohbs1hwic4oayBSE6tH8sQyDo1cpFSb54ysO2VxS5zp-YjddTV0BFQYzoc8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfypDVWpmkSUG5xCsgi6YqV0k6HD6whZUYlnSIyiaToz3A&oe=69B93720"}, {"file_name": "01_Hero.png", "id": "1
?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6x5xo9LZfMQ7kNvwG8aeaa&_nc_oc=Adq9IsfRbxI_VgLbsjJVe8OnoUqOVnvzrkvKY8gB1A-y3vmvEeIJmlxSEsnp8-5rO94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2WW8CE0bZ-Jpggcx_UzlrWJDtkk_jDNNldBZwDgaTy_w&oe=69F0D126"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DApqbUy9phAQ7kNvwGutjM-&_nc_oc=AdqFBj0B1ae5uqiCYnVHsHNEWBTrWbkwcAbjaSnWKGknoqyNrEbL4aUGQXqYNp75Uek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2YvcsY1sA9NGSq85pp2UxCP4HyKBSgABduoU_7rB7HKA&oe=69F0CC0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVhOyeYifbgQ7kNvwEqnbPx&_nc_oc=Adp3k1yhvjX2SWhAVnXyxy61YT66kDv2x1u-I5LuF5BdzaOcVinKyF5eHXs0YaHMTb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2cLvufclXA9pvAoxA8gqFtyEzzBNCR1cxXWUkQtq4M6g&oe=69F0C453"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSaBaznHeIgQ7kNvwE5CfIj&_nc_oc=AdpEzTDXmMHfNuq29Hee77Ws--V3wHTIyhQb-IPEVbdt2owcYopcdr8yv003Z9WfxrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3cBTo6nbVob8rgsa3gbhlADwaXrebWZYlBMJF2NyqOLg&oe=69F0B54F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUjzKkIWgUYQ7kNvwFXYWkM&_nc_oc=AdrOBwtQVYsVg3hFQOxW8PQpdnBpDLtMXf_hKBdmmfwfN8eFIQ-_vR6UQcAb_DJAIlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2J9CGPuQN81Fx_ivheO4tvnY4x0V0ZGgyqRMKST_GakQ&oe=69F0CA5D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwR00vuse6EQ7kNvwHNAHaE&_nc_oc=AdoB_2iNWJPjzrVnr-9vbW1jFQAX_th35_1QuS2h2ZZ5G-S0fjTZe1UtvV6BTEjZ3dc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2TwS2GtE3mFp8SRSsa4ZSqKewVTGnJwwT6REMso1PHDA&oe=69F0CE60"}, {"file_name": "01_Hero.png", "id": "1082791666697111", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75556807_1082791670030444_1
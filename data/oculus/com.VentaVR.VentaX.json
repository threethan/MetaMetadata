2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53Yi6WgKeqUQ7kNvwGsfeT9&_nc_oc=AdreFHhcxJOBttegJgCBp1g-4SOiCgQgCSoT5D9OSlk4Zb1eqzRa4RrKGHj6VgOaldY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1Y4s1cJhn8EaZf7zWVAfPdu5_45Q-WoERNqMC-h4mvg&oe=69CA5D66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXm2g8rqyhIQ7kNvwH9kxmO&_nc_oc=AdqEanS6PtlTi1Ycj2PUVzmQOomHrrEcpP8luH_7F7gPB4NbZjSSBoR5VQVOXoCRSgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFRdz7XBuwteLT2UFt8qWzTJaVArMQCqG5lcaptD3r7Q&oe=69CA584B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdA91drpjNQQ7kNvwEoIdS_&_nc_oc=Adpntp_s7B5UmzpO5-9qQjO8ftZ4CKS50eoUHgwmBwQSHlPkAKOs7_kndf1WyALWvRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWj1jAr_OltC34q4b4ZWgrSs6bxTmlnSdm9Fi2p3gO2Q&oe=69CA88D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQkEZJD_wY4Q7kNvwHN2zbt&_nc_oc=AdrqvplH3JA08RTmdwARmfZ963BM0mzhSoS42lI8logPH4P7k-Fyh69ryR0N0wSsCTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzcwy7VgciR2T4JSylRTnvyj1de3stYPSPzfAdp28z2Yg&oe=69CA79CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANsf5avrDl8Q7kNvwEojr6P&_nc_oc=Adoyw9jFi-kw-pzMYdMxAhvkMYNd8ZGUarQN2EGtCYK4VvHc_aMbdCP3Htc1SGxLn1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkCWBAA7J96j5maHB_ByUBZS_jacd9_YcFMJ_QnxNaXQ&oe=69CA569D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sux62L7qIGUQ7kNvwEv_i3F&_nc_oc=AdrGaRdfr156hZeoZvhQO1S1-CDGzCKfJrDhHMi_q1ups2o9bp2dbpbNASYgi9NTl4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7xyKL8N-W-WI9bxV9RZRUGfKDjFW0CFJGUac
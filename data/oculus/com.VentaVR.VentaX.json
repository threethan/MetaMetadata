2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLzkeJqUSJoQ7kNvwH9QOUr&_nc_oc=AdpeOo0zLPhACzc4h3RZ812MvALzi3ZuqQWzEGaCQh5GGe1-m1XiCkNh0ZQxS-sz_5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQsoXGm4fPlyi2bSU7dUlvfryRJuJw5rm9yO2LjyFFyw&oe=6A7B0666"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCHWycAUHDMQ7kNvwFmw4ij&_nc_oc=Adox1irFxlQ0HEvaZ5xPsTAYRXGfm4mpOzyCjNJK4SArMz3iYStihdPIdgiXWwTNoMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiL4mKsUwhsUqdP24pGJo_TnnMvanNXEBlyJ9jobBNdw&oe=6A7B014B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOUMfsP5ZmwQ7kNvwFW5E26&_nc_oc=Adqw13ZlOnM5B2gaEBHXW7b0oD26OYIqoIxA4EvbixSAuttsWKUA3NTIXgT9l061NM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnt7q3kqKrxdaFD9f95Uo8QceMBTilPc9MVxnYflCBsQ&oe=6A7B31D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QToZElk1sgUQ7kNvwHJYysn&_nc_oc=AdoOJ8hC8au_-2oR1ECwdT-zD822J5_z-ADAvKcVM3nWGCJjTjYgR3nVW21dEPMll78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC6aVDeO7nOPYrc-ssrKEuKzuJsSyVU4yG2yjSsQ-PXQ&oe=6A7B22CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf9csTv3CE8Q7kNvwH2Z0Re&_nc_oc=AdqjboTp9Hkxq4n2JDcjei1ExWut-Gd0uK5xaW9GTGlubM2ol4E0C80bhQwmwwa0tDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKWQU4Assx2xJbRPnm4oUU6lxjrpesBEFrHYRvLDLL7A&oe=6A7AFF9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEorZixSRO0Q7kNvwEFf1re&_nc_oc=AdoKCi1RKvJtzX0pEhC0NIa-pPRG76dYYcMAvB9J3X5HaVUXE_vlEWdivLH5XThMWzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZgduE87VfrZvIsJ0q71-SYUxyqztzs3-pA_w
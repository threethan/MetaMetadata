2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAPMIaWDAisQ7kNvwGr9I7M&_nc_oc=AdpEiF6b89co175698R4zOR-m-waM8ODww_zQi8irpjG6nmHtOIraVxhgsSbVV-6Fu8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkYiWGVTDYVSinOXmpQtdxnCl0uitrf8ZrNpwk1g8NLA&oe=6A804C66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvpu3M9xn9wQ7kNvwF20KA3&_nc_oc=Adrh8iyEi20AZ6PXLlDpChOn8Np1ItcNQW8fHNxlN4qNcHM4QuS8UgKq9XsOKoEz0uI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiOkGn2r5NDVw-IN3tI19Y0bob9d2fbl5shV0JQUDmeA&oe=6A80474B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFIH_ZUSMIwQ7kNvwFcf_3q&_nc_oc=Adotd__Vvr1Btv1uBdUzIPFJFkFPkjrbdzR3oxezJMH6DGp3gGVrpQT9tRdmY1000Uk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPZkmWZAx7U0w8kYKK-FefKgru6Bgx1NoMJ-dY066J6Q&oe=6A803F93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Hpl_Hg0EYQ7kNvwGizhuR&_nc_oc=AdpjJ7G2YdKxbEjSs_nU5ENdNhgNYiFfp4xBMroZVNRUSYg8w7AU_WjTyBaoUPs0Mx8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3zo2jX3QddwdKJVW7y3UQdXYN2GzVshSfFpvXdmYMIA&oe=6A8068CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjlj6ArcJRUQ7kNvwFv0Qx1&_nc_oc=Adp3CRsHXA1h9Pl1TG5lkmqifgTiEUpgAUXj-YV6a-yoeDgZbZYPSPHuSW8nNO1XMAE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMQ7KSpFQiP6AfGxL1gDAj30zLCT27omnoAw7TaHrBsw&oe=6A80459D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT_O4Tg7wUYQ7kNvwExEEyR&_nc_oc=AdpmPmwGXYO5a7zTtdwPUHT3rM-jnD_3O0wUSiuJBnaJEWDh_3i_kmvIQAoFGd1GjmY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEzjZhHSDPStMTkeLavEaEtvsYvX0UUGSlqqu
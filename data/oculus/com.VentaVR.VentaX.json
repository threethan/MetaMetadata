2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPMlU9d0b_UQ7kNvwFRZgTN&_nc_oc=Adq1dStBKZNgqi0l4NYxypHY7yk_arXMQcyc5Ss7g8WLbHoJPrmwJJSDTmii82hVkAg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN35cbl8xKuhmjukMWTH34cR5qmOdtc_nkAQQ8295M2dg&oe=6AC7B5A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJQ1yEbUFoUQ7kNvwHWw9Ge&_nc_oc=Adp21vUQ87w6WJFEUtpQNKT99OVCGWK-EyLW1GmgT1J3A5YqXWNJaChnzhDH6TJ3zjI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4O3Q00UZcxBAgqgqAgvRR0l_s1VxrVeofeIzJqOP5WA&oe=6AC7B08B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PngHgKPs0CcQ7kNvwFAjxFf&_nc_oc=AdruDo-UXGtsaLchlaYefZr9Q3hLRbwo41nKP9PptEFGPhpIEX8IyIXWk0k-dMlDCdM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKs3wgkNKo53jj7trLaK37ofjczfDcTBsGlhQ-c43GwA&oe=6AC7A8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGyC14Alld4Q7kNvwFEyLTJ&_nc_oc=Ado0CKONXMUwrNuzauQ10Ss0SHGvzrJ99omLFdCYNkzCOEXNbf1TIK9yb-OgGV7RK4U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM__yuV7XdIDhgg2HB0ypBjarsHywxz6JISmpJn9L2XDA&oe=6AC799CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMzojBk5tzMQ7kNvwHOxGTd&_nc_oc=AdqUtkkerldBpkdcvINCL7L0n5AX6nVf8iiile36eB6VIAMpyJjdQ_j-4qu4gwWJP7g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLW0-kBHjuRFT3i4QPsOKT8OYNZGQXhiAY4R3OkKYwKQ&oe=6AC7AEDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5zVQ3eJguUQ7kNvwFA6rsN&_nc_oc=Adr9hyZlsFnNFqihi9ZqVTS9Qhpklh_OxHO5cZQwI8CZnPCXnXH2h0jyrdCUV2evODs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf6AD_wWTqGB6LYaxEJWeHiTQVonTbl11fyNv
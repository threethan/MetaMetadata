2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC8kZEPf8gsQ7kNvwFmUKiY&_nc_oc=AdosCCLoaM3ayKB6Y7ymC2qvo9-rqW-VktCEWl60pb-L6BnYeH4RJUqSB-dXjJ73eZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkh0uYYrXW8tKbqFhiYttlRXu24xCbqGAft8ZJMhU0Ww&oe=6A6383A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXrvU9h9XuUQ7kNvwGRstCM&_nc_oc=Adrq_sKRLvrsMuGdPVUH1jJWO0dFE60aGLlU35pKpQYjnELZcCyoBGuc6mhT23e9rL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8XySZDP7gQZaI6d9hoSpqHAK1btYebA7LfzjWIrQQ-w&oe=6A637E8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNL4pgND1ToQ7kNvwHDwF9m&_nc_oc=Adp0qNYucxtFNWzVkVIOPXfRvgWqB5V_NUeLNXbfyKG4wqqeC74Gy0j8WdW37SzoK6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArmMotnHZt40JAIQVJIngbEQ_Ti2ZYaPC1uK6j3pTv_Q&oe=6A6376D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQs3Ro_gZUgQ7kNvwEAsPin&_nc_oc=AdruHHJpXfAmVOmR3jVEFyaBwEwx6BQ3iFR1dQHlIifCEerpg0BNC6CAK3ztw3hlgkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWs5CJ610rRCigbkeXcDvEVuI5A7Rl4ax3ICGuM-Q2Tg&oe=6A6367CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBMlVItmgBgQ7kNvwGFIM1r&_nc_oc=Adq5SS_8pAEygNUgquc1_19F3gMPaOZyjY0_ORd0M_yHot-6jvhsczRLYFDktfX-r_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsThRx1QKm0jFGN3HjNX308jzHgUJo2oSyV3-2CE6jmA&oe=6A637CDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzztlktFHvwQ7kNvwH517Zx&_nc_oc=AdpmOgT5JUtH2tx0b4hy4L5YsMFEwSrpbeCTgCtMmB0lR9m6BLuZ9MdR0HtlryfET6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFENr5YXotxtbowLUdUs-XfmMcE2R_vPvMZOW
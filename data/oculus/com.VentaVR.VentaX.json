2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5XUZXIMPQ8Q7kNvwHagyXP&_nc_oc=AdoIWRS7zGHJxJ9-DPJl2yypnMnmWjG1h5UF_9GW59Q3RjBxdznkQPqP8s6RyE_QSEo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BTyDxmQWm3zwfDeAQ8WmbVT3bCufYvN2T9ddghqLpVg&oe=6A283026"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20NQuVdv8O8Q7kNvwG_RgLX&_nc_oc=AdrzF18S62NUo_ez9Y0p6N93yVQUu_s7NZYL1ljCe6iFiy8c4RZwnCpEsj18KAoTUC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OFrZ2OevUIyuS4aLkBcHp8u0ZViNfzP2JJNoTJl09Kg&oe=6A282B0B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSJMw0FEviMQ7kNvwEepPmy&_nc_oc=Adr6g6oKdcZbUHjym6b8x2Ogip0iw7x4ebfAVmON6fil2ss0hmcIrMbEL5IhDT2xIC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qgn9NtOdnktbbeyT_c4qGO0pDTBsNNDAwU6m5aNRPTw&oe=6A282353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9msqVe9OT4Q7kNvwFXi38u&_nc_oc=AdpdwImADv7WTs4bnrpTOFssdWPmwcChT-MHoczDp0dtjIcWQ_t5220wXRE-F9Wse8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l2zksy_vxxP-UwjkL1KZ_9uJIaUpvCpU9uVnhiibaYw&oe=6A28144F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf0D98g551IQ7kNvwFTCoad&_nc_oc=Adr6E0MDPgbwpAvzQQiYGpG6cp__gCfBV3AdQtbnGjRZ3dlmVsttowRatkjMsLH_NnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W2AhRt1XREB-KS_KQzvhhgctD32RTmvTfb2fsU5KWkQ&oe=6A28295D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTK7PB8WulsQ7kNvwEhvM0Y&_nc_oc=AdrjdK32CUVBUF4q0n2HHmEHCFlJcAuXrgfNdKHjv4Knm1tKxFuQfFYSIr4ILL80cuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lo0-jf2-AfUYye4dz1yptVSWJ7nyLlK7bKGy
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLzkeJqUSJoQ7kNvwGJAb4C&_nc_oc=Adpx3vxaBWnHvitVjKS15q2vfVGkbBHEtYG9r6IP76xDqF6ItA05gT_fDxZOggfmQZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp29lCwmigWcXoaorDzikiN0zlr0kQtxE5MLHihqG-mA&oe=6A79B4E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7V0z1ASW68Q7kNvwE9DJev&_nc_oc=Adp5lvO2QlrZZUHbh8VYJIMeuUzfJJxM28xPMfWDrI39I2dlCxpP9kDXzaXLEFjot2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFez5dU01XKyAwvda6vZdEBK26pRs5HXsoKY4TPxbQd0w&oe=6A79E80B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOUMfsP5ZmwQ7kNvwGqiu0f&_nc_oc=AdoWuJcuZbL8xBRMG8-EgQnCL759_4LJIffZkOVuc7brYmIhQ00ADf8aCYUBjoAaB34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcPsLbpk1PHcD-O-_1soWEx91GpXEjex3u94jAU5qZqw&oe=6A79E053"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QToZElk1sgUQ7kNvwHd30-J&_nc_oc=Adom52cpT8RXznqATC2Gn7hDJK5Pl_fVYUS9Wab1SqDtiLziPWaA2VGxPIdf5FhX0n4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFersUeEe4yNQ_r24aHcIpgCVsSbNzecKDuQsuo8ludjA&oe=6A79D14F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf9csTv3CE8Q7kNvwEI3wjw&_nc_oc=AdrAKOp2KcsCBongb82PEFlRHNnxF9okvQcn97FbRgg64X2qAfJOHOurC8uS72UUFGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQh2RQqOG2LedbTRn2OrqYwwbZa7nkENZEKFXqb8uslw&oe=6A79E65D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEorZixSRO0Q7kNvwFjuQ_b&_nc_oc=Adq5pRJuC6Ncj7YzluyDXqEznWtWP3iXuZbQQaPJqp8_lb6TjQFTqknGYsCIARtjKJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuGcIFab6nwxWrdNon7UuLy33tq1Fuj_K6-YT
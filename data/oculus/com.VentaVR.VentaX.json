2063", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7As8soWq75AQ7kNvwFCJvyj&_nc_oc=AdpnvfIwly_V8McajSn-bWpIcvYerIWOBpDNg1ibVkT-ryR8AWCDZy0ZSL0xvLGawwQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnSz4SQZxkaCQD3drCOHticHPdpY0RAphx1BluP7rvFA&oe=6A972666"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aONYn6WMo-EQ7kNvwE2bWjt&_nc_oc=AdpWmePheZTZ63uaDJ_cIX6Yov_5x6diMv6bH1RjTIMcGNnersFYq5uwgSWTGmxxl_s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOTwLHpDQYv-vHUlBiw4mdnKi8arHgjBHSN5sqeFfabw&oe=6A97214B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6ji-Si9gMMQ7kNvwEHZlko&_nc_oc=Ado1kxb5rcKF1B3xuRnYF-WgqasLAKc5TxBqApIni6BeiUFuMD_mxvDbfZENBnobEgs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyKysjurLOJV6xHk-tf-p-TftK09DZjrdLnnVMLYK77Q&oe=6A9751D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGatQW0orz0Q7kNvwHOBdyv&_nc_oc=AdrZp84K3KrXqKD8NRWP12ktiIFzOmwCFRHNlO2Us98-9PnRJLqcHKmmFWoWWd_TCgA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWCyDI_bsHW4xQyRS7SiZLns4AzIOwYUawk05nrw-I1A&oe=6A9742CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0hf-O0ywN8Q7kNvwHout38&_nc_oc=AdoMyODEUDlTN_nWYCIQpBQQ4J-yHqw-sHVtDJJoyRVrbcMR-t6_qdjxHm47Cmacleo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHphVURCX6VJ35J1_3Y1KSGQdy-UhGJf0rNY4N7L3-Gqw&oe=6A971F9D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbkWHs1hbRIQ7kNvwE4Vukv&_nc_oc=Adrh00pUmP_-uXa7a9Mlb3UN8OTS4HqDHIwAA1ZMVjBQNzw1sqsgW7PcuxfvQB-SF7o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBD45BSQg4CgNoG3t8nDajPz47Tdx6st4YOoc
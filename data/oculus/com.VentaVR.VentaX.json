2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITfbP9GhLDgQ7kNvwFkFig-&_nc_oc=AdrqcNKKj987hwYq1r0w8RHmaRn4yeaaTyfFdKiIAjtG9WnKTONvgyHDVxocLtvTTGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-TkqHe-sFk5giLOHvrLA3-JzZqLLJRQSP0cg1C3XNIg&oe=6AE4B6A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNlS0yIPaWUQ7kNvwGg6gPP&_nc_oc=Adpqg4IED4Eb-MvH9RPGwkzKKyUWlk0_R7taEqYDB0zFnF9BYkw2C8SwF1xujekcxAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf4TJRLwj9M6NSjA021SvtRybF2gFpOVvogz8GrbRAvw&oe=6AE4B18B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wOmeAqJYM0Q7kNvwHAKR_g&_nc_oc=AdrkpNgzqQu4Gt7n15Pz9GRzG3WpAE4_UTKCPksF7OeUtoP3X-hHPt787olMVcCv66E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs3xNRIAv9Hjgs4_sW7BPCn69gnHILWYst-I9ZkCVxUQ&oe=6AE4A9D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XuJ41VdydgQ7kNvwHapLVW&_nc_oc=AdqXn3DDAzDfHkF8a7qMPUaJ2N4W9IfuIedpAQYmd1LMDFdcq2QR-CExaKYVFhoe5bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5nwc_9MdcjQHo9my6Nz-X2cVT3d9HGBnMsAejyr94fg&oe=6AE49ACF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-i6CaazvlQQ7kNvwErGL83&_nc_oc=Adq4tgiVEiLqd5uVuMr2s6gQ67HNT0AiP7BE1gBsMPfYMWQPd-weYtmvyvtvpNKf7Io&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKlcXI0BRUAcXdtK3Ek8orThG_iA4HyIH4g0yNWTL9cA&oe=6AE4AFDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ry_pKhlhkQ7kNvwEQxW_g&_nc_oc=AdqvX5F8TJ-BLBmAsFAKWS3VcPApN91CImHk5KqUL-9jOtVM8h_B8qRqFnU094KAiJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDOEcMxKLvYsL4wDkv8t45xPMiBKXDPYkJWAb
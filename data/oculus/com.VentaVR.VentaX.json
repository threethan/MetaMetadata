2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwJ_dvaLU58Q7kNvwHvgtst&_nc_oc=AdpXg99CJ0GjyBD-JuBomOiK4OdYDrVhkScy9TirtKK6DXqe7KrBEigBCUKRc4QOnyU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-avlZHMufDSp3GLteH5GHsPU2SEivSrAGyEd6Se8S5Lw&oe=6A413CA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYy8gq7HrIUQ7kNvwHfGox2&_nc_oc=AdpjtA0232BEv0ItzpDPl52gWH_1bI3-IK2TvLf1-tIBBqnVQ_ix5Ej9HYaqgB06rPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fEjzdHTANpTvNlmPL0e-112sVrh8UTMOucqWrArmx7Q&oe=6A41378B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yP1Ea1ON3UQ7kNvwE6dVnj&_nc_oc=AdpRpV3OKmuc8KWHK0ignmN1KLOS1uPqjVxAms_wjdcfddqYckAN8BJW61DdXWWxYQc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bHkx1Ba-RRbdIe7wwrRZcSGLQr0q-EySn9bMCO5o4Yg&oe=6A412FD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI_CwJoQklUQ7kNvwFuZ-Q8&_nc_oc=Ado9D5mmej03rx0OCvHfSZuipB7q45MnqIFIStlv5KrFGqRRu3hlidm1MrhdXsdl9Ak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GBeqSm6xH4n9nPTAStAAaBJpwHVHXK39BDNYqcvVtSg&oe=6A4120CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca37oQnkUCwQ7kNvwFVV3y-&_nc_oc=Adr_LYVgzpPN3-vCB33K-JfLfyR5yP_gCbw_I5Oe5GGTDNpJidCqxioZHJaQjftDyr4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tbzk1h7ifmEdWIRRP1nHmAmNYD8J6CBAtIR7xO2bsYA&oe=6A4135DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATnOLxxRJUgQ7kNvwF-eAn7&_nc_oc=AdpcdNTrGCWiXBNMfOzFGfHLoZmswnhlI93sHygkb02eBvSkvvi00LoXI9CKICZK3yM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tZFURfqYM47KwPrZLvbZn6_4L7Ff8SsYVJtA
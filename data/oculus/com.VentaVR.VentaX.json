2063", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPMlU9d0b_UQ7kNvwGlK5qi&_nc_oc=AdrhMqgkvesqPrk8ZgKeJ2e_m7hmEe2F523PT9V5rfpCxjDtQLL1_5Nca9HchIISxoQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA7BK7vV7tDtl4ReaM6uMAQxYUu3ZCVcn4etQ_K5AHCw&oe=6AC90726"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJQ1yEbUFoUQ7kNvwElQ18E&_nc_oc=Adq7UuZ7OtvbB4gtF5wJCnD8LcIku-HkLrnCFl8RVznDZ1M-mWoOvVQ36tFC5yExnow&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBw5R0u6ipOw5-JtXlQMS1AxMscONBBRbP392uQA0IQw&oe=6AC9020B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr-atywgCO0Q7kNvwG-W7tj&_nc_oc=Adp4KGdc4rVs0Qqclt1GT_QQcOJEk9SNWnphonQEWD3XJVrrjeoj9VgoZgEpiF6pTPM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP49Ob6P_90EC73TFekd2TGYracuFNOiJ5U_jgw91XzgQ&oe=6AC8FA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIpsuRhWk4gQ7kNvwGyNvvs&_nc_oc=Adp2ZWeUjUrlx5inZhKKcInktiZfPMIe-ZWXAMLuodPtVCsUetnFXhYwcV9yf3nJ-gM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO82x0Hr5WRu6yChx1iJT2pUT2uJAmcUWyKuu4a7fCaRg&oe=6AC8EB4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMzojBk5tzMQ7kNvwGQIR5M&_nc_oc=AdrGQy2qVNv6sByrowKAbf_ppW-glP-E57V8Ao49tvmRE6JQeY26h0oQiiQAXi6N3BE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfi6zLnWivBdYLYrxGUcbZ53MC_it_ipATkErP-O0cGQ&oe=6AC9005D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5zVQ3eJguUQ7kNvwFuRq6t&_nc_oc=Adpp8rWLNSWEBnR1160WAqmaLLedH59Ig6eWpx2TAoC3KERvanuUDYW8FyvLa8v0q0E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHTYFTFouKpkCUfmYF8VEHHsmsQukcPwe4CZ_
2063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzU9zME5r30Q7kNvwH2LbSP&_nc_oc=AdqYDC-1F04ofFhj_LcHh3p30ZkyS3VGkAN7IeVN3QXYTOsayG5X0YcpCtfKRcNjrV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dmcazA7HaIbMDAj980pXq7kKvy3ogEWVmHG8c-eZqcQ&oe=69F768A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OrowSLQiOkQ7kNvwGa6YyU&_nc_oc=Adqu9iFGO2KFaJFk1xOxEbTOZZOC8JwX3M-9yvX14SI8oD_tZiJamtF29iNpVjqbVN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eKb67WX50jubfCxWWNFAO8Sbgc2lfRJgQ1dmTEvCrPw&oe=69F7638B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3sLIGWx9X0Q7kNvwGkjWTk&_nc_oc=AdqT62zYaa4KDDwNjlnG5q3Y1nUmGnMoDsyd3LVmVr9dxd3lWwJUgFbx6g0wsO6Ehqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UifLQDsLTYxZnlLlQr1TTWZD8uK3ifi05ioB-WEwJNw&oe=69F75BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3GnIEr4EXUQ7kNvwGkvTz8&_nc_oc=AdredhE245XWvtbvYNXi49iTWQ41B1X0QM5y1K_r-zcfe6O_mKmwvHDbJDOIE48E--c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-dWd52SwYp8hPtpaZhvMuHJM3QnteFuJgFxAD7hQ5Kw&oe=69F74CCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trVPBIMHpTEQ7kNvwGHSY5z&_nc_oc=Adp-S2AmfGbEXYbsgyFOpiRfYUFo02Ei4efIEiZslIkmtEzQw-s7CNXZl0rFDy36pqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mQhue53kDPfwPkLhgAOaJTBDWoE_iD9j2NDz_a7qPgQ&oe=69F761DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDi2nTO8IcoQ7kNvwEZ4jOI&_nc_oc=Adqn_UGNaZkDIURrTC_uJQEeRQXmfOOtO1vxgh4U6dy0EH0k2cGK48t3K9lrQUTvHqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BznKooLEWfV5KVt22vlhu5AQfL6amC9hAI6o
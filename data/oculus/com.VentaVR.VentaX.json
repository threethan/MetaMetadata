2063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM3Hm28JzOEQ7kNvwFtjWy6&_nc_oc=Adr59kvOSJtDDjLt9ecI7v93ztGvtyqPUaO9GB9QQ_e9h5XZrmGIhhJnevcBSYIQ3Mk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dvH4rFETng6DJNSt0Z_-piS1jIun7pfbL6_um-9QxqQ&oe=69DA2F66"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOIDi21nePsQ7kNvwEaaqlV&_nc_oc=AdrJNgwMdiAy7eLnLjdgq5t7449SiGzmxxS3aK83c9_59n8zHyIitna7QpGDbms8CAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P-Ep-fU1pe0gjaejenr1LlYkjMIgEzr9tjAy0vEaNsQ&oe=69DA2A4B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRKgAYYDYHkQ7kNvwEz_4c2&_nc_oc=AdpCl9NVhiblhR3O_0RmTuWh8Rq0NKeCmpektATsajdkIemekwtD6sgF3FHw8ATGnD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3neyAMbM2MCJh6p-QMu-s-MuDnWvzzLBbeTuLFKkjExA&oe=69DA5AD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN46PrQ5944Q7kNvwHn8WZ8&_nc_oc=AdoRmBkdPBW-Lc2v3fngTLDwIWvRyhyhASIjeFySbsKkAuRQ7ukX9zsSLMZeBGg7gYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HC2NgPQ_Sru54ZqcIE7fo3aaRerRuRbiFLPY-NH3_7A&oe=69DA4BCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tvbm4GJLy9QQ7kNvwHQrGri&_nc_oc=AdpcmNY5_Q5O8IVvhQ6hIr5DnaElXk61c29_pulRC1s0WaXhgzGBLcLXGLhft1dl1ZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iDg6x8L8gv6takbIEIzuQGOdYcjXd9qfG4FpMcqu7bw&oe=69DA289D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBmsR17wWAcQ7kNvwFuF54J&_nc_oc=AdqSwKFzR0aHj3HYWy73xG-HomcJusYjB-mK9tPzEKewJFwKKnk__g51DLvJbRi4iLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ppvo9LluVwg-fBKn-m1jeMSBZl7PdQcc15Zo
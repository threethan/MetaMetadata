2063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZxc80IwAZYQ7kNvwHrPUwq&_nc_oc=AdrQ6fgdTJUzEeP6xAfNL8eKR-UAi0jvkVCJAE7JAL_yhd2nFhR7QjK4EWiQKMSK_u4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw-76zDaKQyzKA38Es_vQv-K3u6rGhp64CR76KG1RRiw&oe=6A510EA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU6Kj7cHsEcQ7kNvwFFCvsO&_nc_oc=AdoSDS4usGzYVePKz0J7rSGQiiGEf6tA_y574aKK5qYPdU630F7yzRZ-ORcjPCH0j7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcAnOKM1Hf_BtARpRlntwZ4T0cO41U8LEbN2xZxuDoVw&oe=6A51098B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca9uxiUav8sQ7kNvwGtpqi0&_nc_oc=AdrbzFUNMHYwkxlmyyBuJ2I_-Y3rVtSf5NiXb4vanJ9d0sssHAKKKFqLyMvXig3FBD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnlP-P9A3p56vQFVOglDvi9u3p2kx4clYlg-aTMjK2fg&oe=6A5101D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iQwamYb36AQ7kNvwFsr-CY&_nc_oc=AdrQN9xe2pXDYgFXkCxia6W6EpstkTOB-Cvcsosc-CsFRxWpb6YbDN66ByI9zYYfWow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeWkLhGN6wuL9MNKRI_0KSvCe9YJsi-MYlxJ3QNFYdrA&oe=6A50F2CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scIzZx_-AvcQ7kNvwFGN50s&_nc_oc=AdoxcGO_11MilwSdEGtuZ9S8fxZzgrUxGl9FERBGx7X6becNJ7uzHHvnn822zygfPGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwB0skGVpH5IojlYaXY3tH7SJWOKN8fbc2vaVnjjkCKA&oe=6A5107DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrG641El9awQ7kNvwGlGUee&_nc_oc=Adpi8jAAp4cdZgkjn9Jb4nquxNCyDHaudAcxKYmyWyv1LryddIlJeM-LM8SUf5NqhzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJwptJ63W48Ai7FR3X3WSTPmaNMOhRyn_lNHF
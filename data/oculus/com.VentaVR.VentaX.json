2063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXQdEKc_O7IQ7kNvwGCxGsQ&_nc_oc=Adq72Lb0sK7BYBRqm4JXW31SRanKnpN1kssuAjCdkwW3oOS0uZtoQHsUd8trT_xnX_k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbaXg82LKK4MuCn7Bmyj7cw3XqWZKBi-4GPVcBqxdFdw&oe=6A9AE2A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6vMkSAnJWUQ7kNvwGYR_u4&_nc_oc=AdqpbXEvlVwX9ysXAkyoSYprUwGJofJJn09fecoxuhk-_yqlEK6Tkd1aGr3tWChiF-k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoBMGllBI1EnzfQkxUx0ShfB2N9iYbr2TXzRfhucMLaQ&oe=6A9ADD8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mzez8ITr1UoQ7kNvwGyvfXj&_nc_oc=Adqlo754LSXxco7k73c5SZkORoT_ONvYTF6xM8jsMESnDOUuyipJ50YezkLjWrPK7TU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2AqTiM5Zjo9tUbCSeo73vdClKLEkSzjK8RGIDUKNsyw&oe=6A9AD5D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5kUSdcPCJMQ7kNvwF6ASn8&_nc_oc=AdrUrtQl7lQNa3Qi_lvSjhblAJSu8CYQdS-fvyboChas1iUj05LvwqBqKoZxtmdKsZU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-JPKgPU09XBPQ4gpO1hhj9VieQJV3Y0zpclMB5b29Mg&oe=6A9AC6CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1_PMaDIG8kQ7kNvwEKDKr-&_nc_oc=AdrEVCMT_822FGfwvTURJUoYWbRGT9_BZDAFAxLTQmCBWJVjCoi_wgLxSKS3XMIoqcA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSk0sILtKXZzA3sP9C1OmMnhA-oe2UwNI0J4ocAfdDFA&oe=6A9ADBDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30iYxUQid-gQ7kNvwElLKtz&_nc_oc=AdpwBsiiFrJ77nBF0JWDDIoibntDPKRKowL9aVQom_vuk9XGiQyVHtVfEdFVpAGUYFQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaNvz2jwMbeGJVuZPEBaeeKMUYqHA1azYKfwf
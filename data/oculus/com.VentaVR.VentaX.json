2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lanOZB-Fy4sQ7kNvwF7eNX4&_nc_oc=Adqd77E2nN6EF2gImALyM9gQ8gVVIqvvbCEnlZnWZ8C8VXB9uLkfgCN85q8tPYCHxQU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yrAPIW-O5u4J1fN56RfTbf0qxw9H9IdJn0U0EmxDHVg&oe=6A01F4A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUf5LJhFZIgQ7kNvwHCIYJ5&_nc_oc=Adq7_ScWX8_HeeA9-02HYBINms9h7j4YT7Fj2U-UY1Is2erARyrkUYIrdf3z6Ycyc54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T0FsggyIIqIWjR_Tkpkh_sHp2zqMsKNOplFKRUk3rNg&oe=6A01EF8B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGMEjsfXkkAQ7kNvwE5l97z&_nc_oc=AdpYjDxTuGZZvgE7Ql9_0L-_dMzY_05ACA1Gbvdr332VUDOssYONFSuB1mbqyKc3_ZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O31APuYu2G9uFOr_gTLJjXNawUed6IEIsxWADAbHdmw&oe=6A01E7D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDMrjXwHcEIQ7kNvwGSV4Fd&_nc_oc=AdrDatHWhrPJn3IycWeXAK4lxcEbOdvWxtyrjD5W5JBeNuDWXDQNm8fyThA85Nzpjp4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65WPFyvJPCkCOdzNvnUSr0BYMNCHirIJWBwGZCg68ckw&oe=6A01D8CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i76V2Jn6r6UQ7kNvwGkB-6T&_nc_oc=AdrTbURD8qL2eY3KFrY46i1cM1VVL5LWBAbjwtZtKZ5_TlB6i3gWyXqFTCQm_ZMY-mU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jIFMWsIBMOoFdt6x9d0cfes7OcUJ2xfsNll1IN07MOw&oe=6A01EDDD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UST9Yc5V9QMQ7kNvwE6ajsY&_nc_oc=Adrzym7dEJvS3UfAonvrZzzoM286yuJ1451bjt5g3M69gOEWesf-8PhL9qQQ7qK2Byo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DifmaBgdSfZ2IU_lm6QWboF29-Wqdqq3BAqB
-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFEOJST6xqkQ7kNvwEwddGc&_nc_oc=AdmQeWlxvy4A15635RuXZkkgEX7a170kXorf8osVQI3iRKm41LuXSXPKSaykBknhC_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzpILFpJTTab9WoU-YMBN78m8eWzmTdSdbYr2G8YuTSA&oe=69AC0AE6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0UI3H1plCUQ7kNvwExkP3O&_nc_oc=AdkXUEOqqEyTSErI4en0ODOpTW2P4ERpFHITzqLu6lL1k5N5UqFIwbpXaYgpPDnVX5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyhujEd9nQ5QfEKYRkmH3nkuDs39du3ebJa0gkyF8BZg&oe=69AC05CB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyTnPYFDSq4Q7kNvwH2QBWP&_nc_oc=AdkwezkFdSjaklKEEYnXMF1Mi9aOUmqXtmhFeb8qcBbedINbsmL9hcFcO-K4-RtQDL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnxUHjaXbkAJeNoaHDDV2Rrs-ac-hXV7B9CArjnhKtMQ&oe=69AC3653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWo9ZVgjW_sQ7kNvwH53xYz&_nc_oc=AdmFu2FQdTMLf4kgZ1KvbVfcr6LNmgZn6L8cs4iMGCyet4k_ul0pQn-ExVg6SrJST6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6Fg9g4jYwTeQsOzH1c7RmccCubFhtR-9FUa0agVNWxg&oe=69AC274F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoZkD_6IACMQ7kNvwF_kwDz&_nc_oc=Adm6Qk9_egrqMCmbyytt56MaqtMsCguNIyJIGNQFTEZBeuKFgcLMRmh6aWMP0J2F_M8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxpjg7PEfuRhxqO7w-4Ar5aSzZBTO7h0aKS2J3VPND4rA&oe=69AC041D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFaY568h2PwQ7kNvwE2mC8L&_nc_oc=Adm1lDc_YXdGhugXQuZfD2cCxYSPH4_7PEuMiEWz9crLYLJfcGOXxN-FvQFS-i59au0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyx5HRuf72L8Y9ETuvMlrBkfUu4EheRg4nYMnutGSPQ9Q&oe=69AC0820"}, {"file_name": "01_Hero.png", "id": "1
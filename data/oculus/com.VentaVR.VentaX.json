2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf6TRU72_CQQ7kNvwHuwlyl&_nc_oc=Adr5ckpbt6uGvRqzU4L3_L_H49DP_qcDA9OHCr6MECcZ1xdGhH_r2hs4jbKXg6A1Fjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af367p6fbipi1aTHzK3LerrbQ85YkCmS69GBsRWN4oXFnQ&oe=69D4E966"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmk-O1zoGjwQ7kNvwFHT_bq&_nc_oc=AdrnIUAePD1zuljqmU8KkP-o7YDs6-sc-xhh7SZyg6ifGQf4BbjIkhoL9eT1AKM-wrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07707i6VP06Sm_4eJEOmMbWh5O7YtO1kTbbQ9yIKl0YQ&oe=69D4E44B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OxUaHGtSMwQ7kNvwFLbx9y&_nc_oc=AdqyRSlXMHUqNL7XP9vv5HW_6nTSgYKm8_bKyzPR74viEFy3P44wwxtHXk6QgUJhUMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Tp7aY29SDunSjifEXwP75Zr2CWSGUqYZdUo_ZLvLeEg&oe=69D514D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EC4AwBGd9DQQ7kNvwFznIXS&_nc_oc=AdrkrDVQw8kMKTwMygMEL0xK0zODz1i3zeEGGjPSELSQbZ8_8Pqp5-Qhoqxe3bkPYYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02HQuoYTZDXGhSEuh26yPyEfOnAbzG7fLwDr998Da3yA&oe=69D505CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AL3v9BHBzIQ7kNvwFOqUPx&_nc_oc=AdpsqDKrtuVhGxtHSPIHYlBAWOO5mHsZn9VxmUZ5yZS8B6YuMInb3_zcY9inMtAEYJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32nGBMhl2WfVTiTqk7JuASlsU4eCwQ-punqn0vx4NG_Q&oe=69D4E29D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7J4GVgHmAIQ7kNvwFmeYVb&_nc_oc=AdrWDCVHM04QoVkNaXN2_OTz49nX5HUCCUoPR1Hi1QVzME_O51Oj9RVHT8RuydSghYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GsWLZaM8lq5aPZqUCul_nD6ivBNXXlO4btLB
2063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1EkWJiPF8kQ7kNvwH4fZML&_nc_oc=AdpRIqPJ0LUvcNIdVUztPMkSAh1yggIhNjTUAW7LiVf5yDwdqywlj05FK8VLq7mRu2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQvt1OFZ8bWu77xQbJFnNXUm5URJ6_gp7SZ5Mrogvqag&oe=6ABFCCA6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYEdImsxGpEQ7kNvwFYBP1P&_nc_oc=Adr4dHjT0ry5I2x-TND1qe6LIdk5lSNW7iMfCctfkcDK2Hgxn5cXDRDgr9NHPuimicY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOplTHWF_dvfFByvz1H7-R7uVE-JciZzE0ZAi_40cIbvw&oe=6ABFC78B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7ZPHNBNwb8Q7kNvwG-M43j&_nc_oc=AdqlTTRMWPIXq43p5bm_4wthXhIORwCK1zyIC1_RB762WtXA5WMI-McumpzAfe1tosY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrgbfgOR0Wl6K4847e7UkGEaMN1TQyDxHyt5Sqooj8oQ&oe=6ABFBFD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23H7zwLTt3QQ7kNvwGtC7px&_nc_oc=AdoiQAOlPKB8euHkKPKmt8GY4-jiMG5MfRwS-ru_sMqgA7_CTGPkeMcJQUVlNPGOd4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqW8rVE7dc6uM8wfzlU2iARPkwmTQmNUPlPteIHZ9Bxw&oe=6ABFB0CF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msbaMzoOS5AQ7kNvwExMjI4&_nc_oc=Ado5wOK1SU6Tod53_GAXrfGf2xsRJM3304iFaHgT7ATdNFSFfi6IwNW6AtDct_JNvtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh4GincJ56IodnyQ3PnvPlO-HAIiT3Ts1iK_4woOooDw&oe=6ABFC5DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aetHKKcam1QQ7kNvwHyQfs2&_nc_oc=AdqfMN7qmUs8w08EmhITFcrvvpJvBMSpbQcaYSWLzka7D2p50EKx-2ddRFmzSxVFTOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG8KxW3z1YH_vSBogd1csoz9fcRZrNhPIhlJh
-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9O-I_BZhYcQ7kNvwFZFiVy&_nc_oc=Adq-cXO4EPbz6diIoycMgmzgJzOPhBNCqcTlR3ZOt_JmPR3HCfrmCZOiopxw811Dz-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYwvnnyLh_YX202L5Ip7oZkJbFjUKRsFcGqVe6j2zWDA&oe=69C122E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKbVRilUhNsQ7kNvwE55hlF&_nc_oc=AdptK6tnja7zJ1fHg_g169YVxuPWQ3-dVYES1IrgiIV_-vTqTpHPQGZ1hxofmfoh8ao&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfhKuafG0_WfiaMSEIFpPzyUnr9WgOYQ3_ruVgxlRrdg&oe=69C11DCB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGLaamadmV0Q7kNvwHpnO2q&_nc_oc=AdrRL3DwsMx8vLV0vMRKgNonQ1Ew32IpHJfxGNFrPE13dBinn8iyc_6jEuzDussCizw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwiINX81nqjz3omAWKMhoa-tF_cHTnfdmV62oaG1NWsw&oe=69C14E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfafCVXV9mEQ7kNvwFgs1m5&_nc_oc=AdpV786eF4Z-idGmKRZiBhcvqENTdmiDqFdTwBCfA3fxGH93H_Wrk_HQ1L0RD4aBDDA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwcqK1ig0ZJ-YOEP0Ouwv0P_0G_uOttW8Cq1OTLZc5wuw&oe=69C13F4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFeCpyRIp6oQ7kNvwHPZFQF&_nc_oc=AdoeCBRpt4TUJSwTSO0iqoFEwP2Xi_asaARuneZDKj5Hc-ofQQnY0KKgCCOy1rq21oQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzbl2adXjU7Ziq6whbCXp2LjWo029f_zznYAHQUBjwdcA&oe=69C11C1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rTHwe-o-MgQ7kNvwGACa1v&_nc_oc=AdrYhN_YEkJH0RjBZW-HTf1imGUy0xM_P0HVdFgMriwWhczSBmUG8USN8gxZ5LbFikk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPgw4io2MxisXqLVoGWEYwx00Q6ll5rmED2L_0Cr1Apg&oe=69C12020"}, {"file_name": "01_Hero.png", "id": "1
2063", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCva1jQOOf8Q7kNvwFgXPuf&_nc_oc=Adr4GePWZrXZDBb37O6SoL21hUp7OHQNEYyMkw6cmi0z2SCNHM3EuFYCMLG7jHh-Pbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wHZuHs-0CtPyiSpXL-GUwsVgWVuYMoMvKqqYGKXsIDw&oe=69EA39A6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lWRSUfpUaAQ7kNvwEoRVm3&_nc_oc=Adql8hbeFZWOCs9XI95amswSZiYd-eO1yiqgeybAv6xrVEWc8mPa4BO9mpW9UkziBEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rb2XBPOragvw_jfCC0n1C0_OJ8nEWSFDTe3FuUyYRFA&oe=69EA348B"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PidfW1bDIEQQ7kNvwHJ8NrJ&_nc_oc=AdrovryuGM55BEpCjiryC3bv0btWk_eX9Ym1sLdiuvqukZywk86fK6Ayr0XIf8XlVJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wtKDpTGj_RAcE3303hVmEX_xBvB8RANQcJuwPSuLbzQ&oe=69EA2CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIZosvakNrkQ7kNvwFbZwJU&_nc_oc=Ados6WIqOFMJK5e2aTE7QCo_s2rCAx7sFu1FeoEXbsUQVSlOAGLYxuZKhwi9YuZXhXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PwmuZg-14Vi9Pux9GFxeI87Br4URgLHu_c1iSjI422g&oe=69EA1DCF"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDQO6mtYnCIQ7kNvwE28ZJO&_nc_oc=AdqK8PAq0ySz20DODdVaLJoRJ8bY8jZXXdU2gH6iyt7AjGGk5Bi3fOqpYy8L-h3zNLE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BjGUVsD0VBwvocapSPK89VYJ6pggGDJHPFsb1MPG5Jw&oe=69EA32DD"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmbq2YMm4XEQ7kNvwGCMboM&_nc_oc=Adpsk8nFMKcEsVZbcbbM3vKQlm7UB6TCmr7pQ9vEogheNsbLNzSLUkoyOc_T7kWXyTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tbdKbrbPg_Mq8dO3ZKwkfNwvmPlLignRD5w7
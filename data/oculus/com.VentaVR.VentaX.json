2063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443242_324840640175396_7527976900383511140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VnAkoHCoDIQ7kNvwGDIbnk&_nc_oc=AdppFW6cD7ouVBA9uHF701MM-jpzxAJMBbfJfPpGgqwvYPcwx1HPu_pHjVRFr1HFPT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsz3rLB-4aQMOwbOqUTqjLumRpVFBs-vNzXod2_Mkurw&oe=6A8440E6"}, {"file_name": "04_IZONE.png", "id": "1635497246859265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974800_1635497250192598_4885713622178140194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzZi-lDo5vEQ7kNvwEBVK-e&_nc_oc=AdrTpmOwt2nvaPIADqAUK0xwc_r8n30HV2kMI1pL97yOX_6mONA34zHDzRYR-RPdHcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESgq66xIecqXOWzDF49ARF6SZMNGGPTSG5R_kv9MY_tw&oe=6A843BCB"}, {"file_name": "06_TEMPEST.png", "id": "1555218178586201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334053_1555218181919534_3389336785450721409_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca5yIvQbDO4Q7kNvwFDyh9s&_nc_oc=Adp3QSvGd8FcI3hmpW9YqTkHCP8pafIcFl3COhp7Y4h2JvBDlqMocvjdwgNf_131lSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE74z-iWRxsJByo72pOe7tv_9OOvujTlRpCWPbCAfrMPg&oe=6A843413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_Landscape_OMGxLCY.png", "id": "886684883332180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422392_886684886665513_3928802769089218270_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5blI9jiW3IQ7kNvwGxk-sE&_nc_oc=Adpzlge2q7gWk0_suJRYhO2sAwqEXQd6ZD-kbHZfOccpuPHACtDLpMRxfCJlEXz1l0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwx4tRbpB5IgVhz7FGHgZAd_8OPCami_wvj4rElkIdsw&oe=6A845D4F"}, "display_name": "VENTA X", "keywords": ["VR", "POP", "3D", "Concert", "Music"], "long_description": "VENTA X is an app that boasts the largest collection of K-POP 3D VR videos worldwide, allowing you to easily and diversely enjoy high-quality 3D VR videos of K-POP artists, including music broadcasts and concerts.\n\nFans from 60 countries around the globe are meeting K-POP artists through VENTA X's immersive 8K 3D VR content, as if they are right in front of their eyes.\n\nDiscover the latest 8K 3D VR content of K-POP artists, updated weekly!\n\n[VENTA X Original content: 8K 3D VR MUSIC CINEMA]\n\u00b7 A performance that unfolds the artist's songs with movie-like stories.\n\u00b7 VR-optimized performances and immersive CG.\n\n[VENTA X K-POP Series content: 8K 3D VR performance VOD]\n\u00b7 Experience the diverse aspects of K-POP artists, including performances and variety shows, in a three-dimensional VR content.", "short_description": "Enjoy K-POP content produced in immersive 8K 3D VR! You can watch for extended periods without experiencing motion sickness, and the content is shot from an eye-level perspective, allowing you to have an experience of making eye contact with K-POP artists. There's a plethora of content available for you to enjoy!"}, {"images": {"nodes": [{"file_name": "00_Logo(Transparent).png", "id": "1444402182919663", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_1444402186252996_7014711383928885591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l63CaupZL4YQ7kNvwEXrbkU&_nc_oc=AdoW2NISVNBsUQjmU2NgF3mR8QjFQmHLJZGhLqRHpqkoaqMirfrzobwW76ocaqo3sEE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDT8WYwhrlS2Cr_WNkKAMmr0ZiuuA07xeAbhHZNEl8xA&oe=6A843A1D"}, {"file_name": "03_portrait.png", "id": "1171362250588035", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031467_1171362257254701_2035722783743461690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-VvZh8pF5MQ7kNvwFtcrxr&_nc_oc=Adrp4B7QjUoKcj0MUK_J371NjQ_2jyPgqotV8aiK0cN1ml8TwIb87Z2QB2ttjTfBHGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1b_ub2W3oyRop1nq9T1Ep_fOsrUaQpiVTgb-
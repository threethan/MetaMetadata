IT&_nc_oc=AdrOnj-7U8KfpTEO3ky0FbE-5d5_OElw1wrrLwbLnjivUuGp7iwgJRClrGCHfuHWS-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0uG9AQdnF_4l7HreBfjiPUkPXCSgWzjSd402eiSfBdA&oe=6AFC78A9"}, "display_name": "Curling Demo", "keywords": [], "long_description": "10 minute demo of the full version.\n\nPlay the sport of curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nMultiplayer is local only. Opposing teams are played hot-seat style. Handing off a single Quest HMD to other players. Alternatively, a single player can play both teams. If there are IRL people the room, they can easily alternate being sweepers by handing off only touch controllers.\n\nComputer controlled AI curlers are not yet implemented.", "short_description": "Play the sport of curling"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8088204274629012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974549_498724949411477_643202409147
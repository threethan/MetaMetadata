layed hot-seat style. Handing off a single Quest HMD to other players. Alternatively, a single player can play both teams. If there are IRL people the room, they can easily alternate being sweepers by handing off only touch controllers.\n\nComputer controlled AI curlers are not yet implemented.", "short_description": "Play the sport of curling"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8088204274629012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974549_498724949411477_6432024091476057667_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbsBw_vzkwAQ7kNvwGwc2Pl&_nc_oc=Adk4Y-azXQ8_9R11P27-2EBQAfgjWUS-MTg75Y16cfnNcVAfgdFC-CbA8hQH2_2Gk7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuTObdgfI96xYAzCKwJjLqHyziUAjq_La9I6M8QrofYHg&oe=69A43419"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Curling Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
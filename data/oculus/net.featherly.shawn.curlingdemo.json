 curling. After you slide across the ice to release the stone, hand your friend a touch controller and get them to \"SWEEP!\".\n\nMultiplayer is local only. Opposing teams are played hot-seat style. Handing off a single Quest HMD to other players. Alternatively, a single player can play both teams. If there are IRL people the room, they can easily alternate being sweepers by handing off only touch controllers.\n\nComputer controlled AI curlers are not yet implemented.", "short_description": "Play the sport of curling"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bouncylasers.com/curlingprivacy", "developer_terms_of_service_url": null, "publisher_name": "Shawn Featherly", "support_website_url": null, "website_url": "https://www.bouncylasers.com/curling", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8088204274629012"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974549_498724949411477_6432024091476057667_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILwc-o0dj5kQ7kNvwF9vGsg&_nc_oc=AdqxzSTWlejfshzH43Zb36KxKdrkQg2opdyuym-Xix5catbo1ASb5wFupzXnwwoe99E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z09pSmYGH5UoH0hbsOY2cJFMOBFs4Xq-_-eRjqyfRNg&oe=6A11A099"}, "is_concept": false, "is
 "keywords": ["fangame", "scary", "gorilla", "ape"], "long_description": "\nSimius is a heart-pounding horror game that lets you move like a monkey through dark, immersive environments. Swing, climb, and leap your way through a variety of thrilling game modes, from escaping terrifying creatures to competing in high-stakes challenges. With its fast-paced movement and spine-chilling atmosphere, Simius delivers a unique and intense experience that will keep you hooked!", "short_description": "\nSimius is a heart-pounding horror game that lets you move like a monkey through dark, immersive environments. Swing, climb, and leap your way through a variety of thrilling game modes, from escaping terrifying creatures to competing in high-stakes challenges. With its fast-paced movement and spine-chilling atmosphere, Simius delivers a unique and intense experience that will keep you hooked!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/simiusprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "A3HZ", "support_website_url": null, "website_url": "https://sites.google.com/view/simiuswebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9739220126097560"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscd
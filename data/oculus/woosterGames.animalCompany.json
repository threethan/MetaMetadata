02083982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7T1hmBsJ8AIQ7kNvwEJbcGm&_nc_oc=Adrc4bixAiekCvga9yf-xfglomOMO3ceMy9XUkr6H_C_s3Y7wHZHaBWaAQaBfejXBLE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YCOL5Nv1HTbyRCPH_XiCbb4Fqw6KNTdzdgRpCHU_1WA&oe=69E778AC"}, {"file_name": "Tera Community Adventure 1.png", "id": "985704907112541", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830593_985704910445874_1662229951269511874_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyCijYP4EXsQ7kNvwG2cHFS&_nc_oc=Adq4BUNcB8iE5v8YFgrakiKN2n78kc05HCLvXXrJ8lBa7EygYBxHQ5FePOeGdYTUDx8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18y1uREPtHBRjlN6Jp7TjQqw0q8c7bA8qomwv9GNux6g&oe=69E76167"}, {"file_name": "15.png", "id": "1252784667057486", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499293803_1252784670390819_8001233346963055834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x86I8UrbmYQ7kNvwG6RM91&_nc_oc=Ado_urKiY9UP7nMPis3pS4o3esKTHkd7QlAc9lRDVQjkZIa-AjRZhY1bfnbt2Xjway0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BwtEqzv2vu9jvLw1fvPM4hVzPJxnbim1rTSoMOvp1pg&oe=69E76776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape copy.png", "id": "1628504725018752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618938_1628504728352085_7364214903582777552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeXwGCYsWV8Q7kNvwEc_gv7&_nc_oc=AdoAR08GNQdsXFybCP0j_fjzmfKwVm0EglYLnKkMw8fpSQVweiMFIskC2Y_3hbbb7QI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A4REUMMUryr-h0HKavuv6JIY_JNPNRMD1mZB1ToxnZQ&oe=69E76344"}, "display_name": "Animal Company", "keywords": ["adventure", "horror", "sandbox", "survival"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publisher_name": "Wooster Games", "support_website_url": "https://discord.com/
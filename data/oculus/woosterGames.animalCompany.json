ntent-ord5-1.oculuscdn.com&oh=00_AfsnZLq6m7I8658jwvdRUb10hvG4DNTGHVj_I02UrqK0wg&oe=699C3E60"}, {"file_name": "Tera's Explosion Screenshot.png", "id": "1227873799189844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300619_1227873805856510_857672582019122498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQqJckHS4EwQ7kNvwGVuSQY&_nc_oc=AdlYxsGGY3Br7gCI0UvXS9jSl6D6vfTb_t_HXkpB1D6qmztrmiCcQPQFxjuamr4hyNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft7utAU36Pdc03EbO8dBanm__gb_QBAr3FStsbzL_ksqg&oe=699C3E1B"}, {"file_name": "VRShell Screenshot Mar 8 2025.png", "id": "1162526072228395", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819944_1162526075561728_3612483772541259477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQzraoE67vUQ7kNvwGdSxQl&_nc_oc=AdnAxaY5PHXv3U3PAKfyR4vsSwUGRl9hqfWuc-jUxKbrVruoFz1RaPGiUFGOxT0d-ZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsaWuqFOoBlI-RxXHferqHS1wgzrcS-01NZcBxMlPefNA&oe=699C594F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape copy.png", "id": "2818924551772944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619187_2818924555106277_7406746174254493737_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVfe_PhzMwUQ7kNvwGTLzcX&_nc_oc=AdlT81nMTXBYBVpKxiGR69cqPwvgFkfmi_BVYazqDFeKe4GOicXCF00mAcKmexlzj6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftNLZGIGfRjtKd08SqMjrSqr8LzaDZFKmm7F6KS-DhbZQ&oe=699C35C8"}, "display_name": "Animal Company", "keywords": ["adventure", "social", "horror", "sandbox"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publisher_name": "Wooster Games", "support_website_url": "https://discord.com/invite/animalcompany", "website_url": "https://animalcompanyvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
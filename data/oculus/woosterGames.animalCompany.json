8MQ7kNvwFJeWri&_nc_oc=AdqF28bzOGYwqx5zGGlGFUG8hu5Np2-cLT9KTCzFb7GobrgcRdBXif75vMHPelQhwx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9scKQUlWyuDewl2En70v_9Unu_IQp1txffq1zy6uNhKg&oe=6A2ECAA7"}, {"file_name": "15.png", "id": "1252784667057486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293803_1252784670390819_8001233346963055834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN3qmAKiWWsQ7kNvwE5qkoT&_nc_oc=Adr5rLD9UrDkB6ayE-UG6K5epBi4mmM07eHkVfaXiU11yrKkNfIjfQu5dL3uqqyqh1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ztqzb2NUc7r_jNjrqS6wNEyKZ0X_IsseH4KPIdHed7A&oe=6A2ED0B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape copy.png", "id": "950529177811078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_950529181144411_2190256100058882551_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHUSn4mjStIQ7kNvwHa7q_g&_nc_oc=AdrMj8WSSHBHWqKwI-zGAaY23vs3Wt0R250pZXcklBaVUIAsb2i_suVBTdAiB6_4Lf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3t_oZ4DNxnO0Dz6UHXaGNP3EZHMipRhdQrOYgKTY6hw&oe=6A2E9EBB"}, "display_name": "Animal Company", "keywords": ["adventure", "horror", "sandbox", "survival"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publisher_name": "Wooster Games", "support_website_url": "https://discord.com/invite/animalcompany", "website_url": "https://animalcompanyvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L60TlfZk1CUQ7kNvwFLM08A&_nc_oc=AdoBdO6UKbe-zOwI7LuGc0GJxQFOIhyouGnF-Tj7KFjWzesXcfyDkouE7QWUycWs02M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRim3E2GBJjZXpZ9Pel7av-fqZw9nyB6BaZXF5LC6nITA&oe=6B09BAEC"}, {"file_name": "Tera Community Adventure 1.png", "id": "985704907112541", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830593_985704910445874_1662229951269511874_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJQkY5huUWcQ7kNvwHBtAbC&_nc_oc=AdqtDr-V26bnUG3voBYjJXt0AgTmhlTwPz6IV8vMzRmlo8OmUEjFcLAIKX5A5rb1BjY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsmlmZrLjcQLq7giU_NCwLdLT8iyzV4c53Dtn_VZDoxg&oe=6B09A3A7"}, {"file_name": "15.png", "id": "1252784667057486", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293803_1252784670390819_8001233346963055834_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YegMIz6sqTsQ7kNvwGCj-R0&_nc_oc=Ado6EBU2W3gdh_jqWHH3Y-NwKAh_IbgZKwBzEmO5LI4RdsliqN8_O5wXkpcJzwqUOhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJTom3vbxPZxw60_VTFf8rj_b6J1MZYcEU6u7X3NQXJQ&oe=6B09A9B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1672936437773807", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624583_1672936451107139_2224297448687961679_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAWyWPMxj64Q7kNvwHE4vwz&_nc_oc=AdohByagWIuF_N5nZzJ-iwaCwZlnvAR771R5E04SuV_Uz448aMg9jmd728icVcFeWBA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu_A4HbJg3Ptntubg04GdJQdSm0rltPPyXVgCQvs-eDg&oe=6B09CED3"}, "display_name": "Animal Company", "keywords": ["adventure", "horror", "sandbox", "survival"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publishe
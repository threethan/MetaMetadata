_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WotHqggjTfEQ7kNvwHhBjnH&_nc_oc=AdrTu4i7X3OyBV9bS56G4sqkph18IZd6VrSyZM9d96X9LzrfC8L2jI-oHKbrqcCcZDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x-mgzj6_nFTTKjPqnKsse1D72Ag7L1deADM0TxbHHxA&oe=69DA34E0"}, {"file_name": "Tera's Explosion Screenshot.png", "id": "1227873799189844", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300619_1227873805856510_857672582019122498_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHrptqgMb48Q7kNvwGDEQf7&_nc_oc=Adp9uU_EIBynAuCVhLJT-IBNt8a3PgndaaY7K5_WcDWOBL5Hxgzl-S_rI1s8S2K8qc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GTvGpDgSgRUXy6X-jv5jOmyKxUPsvpjKspXiCASxPtA&oe=69DA349B"}, {"file_name": "VRShell Screenshot Mar 8 2025.png", "id": "1162526072228395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819944_1162526075561728_3612483772541259477_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGTHFRCZxCIQ7kNvwGbbXAe&_nc_oc=AdqWstj_SsvibY9ux2b4_uRYEYwKB5LYBquAEgF1c0gc9pTfpl19yVmET36FGA6FjUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vaNSgkkB5L3SjYch8n3c5nNHa2C1hl371HTdJtE9g0A&oe=69DA4FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape copy.png", "id": "1628504725018752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618938_1628504728352085_7364214903582777552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5MmhEyb9aQQ7kNvwGJJTsI&_nc_oc=Adq_E06dXiG9wKi-4cJFJIzQ_Udgg1Tt50n2veAOOcECL9M0V4iOe5033RTj1ucnrEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13E7tqBHHnFJ_mkYkxkGHw--KlsTJyLlYqaTh968TDyg&oe=69DA3444"}, "display_name": "Animal Company", "keywords": ["adventure", "social", "horror", "sandbox"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publisher_name": "Wooster Games", "support_website_url": "h
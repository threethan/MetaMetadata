2083982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCVOcgWnzE0Q7kNvwEH0Dt8&_nc_oc=Adq3H8-sMKtNJmjhbCM9-RPVCTZCW7qfYJPtnpqz6grORPS6gTLvi-rSl-2pMPVvou4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zzATsdSpReGp3DxFOyfPGTzvb92MbR5XO9PLP5ZwyBw&oe=6A18402C"}, {"file_name": "Tera Community Adventure 1.png", "id": "985704907112541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830593_985704910445874_1662229951269511874_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trTJrp0gGtoQ7kNvwH5EiG2&_nc_oc=AdrjNtoF5ldh2PxgsQWwYYpl5hRviMZOMfrooGVqdvSpaiToBUnm6oR8qAGT7j0j8ac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A9pYx3Xx4KgBYNbMXBNqCi8OWEHNHPDUOA3XEla8JCQ&oe=6A186127"}, {"file_name": "15.png", "id": "1252784667057486", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293803_1252784670390819_8001233346963055834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya-J15iuGVEQ7kNvwHNWSts&_nc_oc=Adq9RO_lQ3CoexukBO8xc2Pc-WybTcBO9IpBj966WuY2NcpUpNUVD9ET2uJiUEhzuDI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y-kp072ssgfIoUTwEKJEXnBHAyTdIL_T-d4sxNMxULQ&oe=6A186736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_UFO.png", "id": "2383242695513299", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619646_2383242698846632_2166557058368946146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ba8bjQrDn8Q7kNvwFdREEG&_nc_oc=AdpFVYEy9OYrVWea-zL9zUKTE4eMS4NsrH6_VkBwJ9uoPmMwRleqs43kiC8n1O-IJ44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YUoAWnwd7zMXqZLjdS6kzhNbsYFU0P03K4igCFruuPQ&oe=6A186558"}, "display_name": "Animal Company", "keywords": ["adventure", "horror", "sandbox", "survival"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publisher_name": "Wooster Games", "support_website_url": "https://discord.com/in
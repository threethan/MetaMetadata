902083982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ir0YXfkfncQ7kNvwGIJptf&_nc_oc=Adougl-HN7oQ0h5mvgTG6zm-G3AtRxG2dkQbWxCQjz9S0_9aCzYLJa1c7U2d9x0-API&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eF3ql5kl7XbO0wMnH0bMj0JBChbEJufCwFggM_osg9Q&oe=6A09BFAC"}, {"file_name": "Tera Community Adventure 1.png", "id": "985704907112541", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491830593_985704910445874_1662229951269511874_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1UKkZWaBnsQ7kNvwGEEEgN&_nc_oc=AdqC-yC_ddtWojTC16OnCCHxrgUOgQ0bqyl-6Lqttw4YeK-4IYftA0EuElheoyu_fiE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vCN7goIviohzTT9rJvE9PMeruDZicRvGAjuVt57bHoA&oe=6A09E0A7"}, {"file_name": "15.png", "id": "1252784667057486", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499293803_1252784670390819_8001233346963055834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uv-M7wHxLgQ7kNvwHfhVSV&_nc_oc=AdpNZqvysQRqLhW02DmkBbvzZLvmE9C_lP9NoBJaN1smZ6X_vGlTKn4QfIqlvmm2Jt0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4exKCjakeg3YzEabq0fZ8RtA684G56Eke2nePE9pWLRQ&oe=6A09AE76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_UFO.png", "id": "2383242695513299", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619646_2383242698846632_2166557058368946146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a40w-DnKfRAQ7kNvwH6IhMG&_nc_oc=Adq5x0hGzrduUnbKOlhWG8neiCI7nyomyYqHSA_faJBioKCtoRihgKDaEdlXWivOvXc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sLAOWYA2jyWJssCannpP7kkbJ3z9BALsiylU1t_IJYw&oe=6A09E4D8"}, "display_name": "Animal Company", "keywords": ["adventure", "horror", "sandbox", "survival"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publisher_name": "Wooster Games", "support_website_url": "https://discord.com/
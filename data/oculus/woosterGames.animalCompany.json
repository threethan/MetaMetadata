2083982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1igKOB44BgkQ7kNvwG_DAu-&_nc_oc=Adq5Wjn8vo121dszYhYaIQoDaWK_GKM2uu3UAu-krRG4cZxil690kXovMBadMpYJnhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VX1TgvnEra8kxfl3OHUx0Lli21Z99Z1ynMvMDSaTUrg&oe=6A0479AC"}, {"file_name": "Tera Community Adventure 1.png", "id": "985704907112541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830593_985704910445874_1662229951269511874_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubi4RDGkvzsQ7kNvwE8mN2s&_nc_oc=AdqTxswBpMmsFuPlFMPTDBuWywYmL4xLNgFS-HnFEszEkbGiWPm5_8VrX_XX46SvYLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42HEJ2uc6Ovq9jF7IVQEQD5Oy3maxLeSbX_tvukpLg1g&oe=6A049AA7"}, {"file_name": "15.png", "id": "1252784667057486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293803_1252784670390819_8001233346963055834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YA7SrmJafoQ7kNvwH1ilTb&_nc_oc=AdpYL8N-_RW3aSokYIvof3xeO3FG5JWNbX6WgeV6nszVK8X798vyrxbzGVuntZEABKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Dkwdq81JMy2iml1dAJ8j8qJGBjXes2W7gNT0fDWOjg&oe=6A046876"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_UFO.png", "id": "2383242695513299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619646_2383242698846632_2166557058368946146_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja9JnN5NMicQ7kNvwFvTdVO&_nc_oc=AdrH1OBsp-ML3ah3Y2BFGuZ64OsVO1fYKwnGzLBIUFlXRfCDn6k7jLOjLDUFG1IcCPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f_lMg204DFgMdmrhzS-5YMgu_hBYiYzSDlVj6lsC47g&oe=6A046698"}, "display_name": "Animal Company", "keywords": ["adventure", "horror", "sandbox", "survival"], "long_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break.\n\n{1435323367926186}\n\n# Why Players Love Animal Company:\n\n\ud83d\udd2b Co-Op Survival & Monster Fights: \nTeam up with friends to explore haunted forests, secret research labs, icy mountain slopes, abandoned mines, low-gravity nuclear zones, lava caves, and frozen lakes \u2014 all controlled by the mysterious Canopy Group. You can play in random public servers or private servers.\n\n\ud83d\udedd Physics Toys, Tech Gadgets & Loot:\nUnlock powerful gadgets, sandbox toys, and rare loot. Craft and trade weapons, vehicles, drones, and robots, then level up using a deep Tech Tree that unlocks new abilities.\n\n{2941247836074738}\n\n\ud83d\ude0e Custom Animals & Skins:\nCreate your own animal character with unique body parts and drip fashion. Limited-time outfits and characters drop every two weeks.\n\n{872452332141625}\n\n\ud83d\udcf8 Meme-able & Stream-Ready Social Chaos\nScream, panic, or whisper using proximity chat and walkie-talkies while monsters hunt you down. Turn every game session into funny clips and short movies, or run your own mini-games, tournaments, or music concerts with friends to go viral on TikTok and YouTube.\n\n{1722468208476484}\n\n\ud83d\udc49 Join millions of players\nAnimal Company has one of the largest Discord communities in social VR, with on-going contests, quests, giveaways, developer events, and creator programs.\n\n{713760597862874}\n\nPlay Animal Company for FREE on Meta Quest today and experience nonstop social chaos with friends.", "short_description": "Animal Company is a FREE multiplayer social VR survival game on Meta Quest, where monsters, gadgets, and chaos with friends collide. With weekly updates, there\u2019s always something new to explore, unlock, or break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalcompanyvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalcompanyvr.com/terms", "publisher_name": "Wooster Games", "support_website_url": "https://discord.com/in
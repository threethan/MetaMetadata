c_sid=6e7a0a&_nc_ohc=-UKFof1x97QQ7kNvwEi_86P&_nc_oc=AdlPR_Uwp5nxjTRKeWwfsSgchYb72fbfo7HOXTUEpbeNOec04pY7Q5A07Gvz9l2VnGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu1ZNndchnT9a77WTagooQAneohz6MWg1-NrR30ybb6Eg&oe=699867E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo (2560 x 1440 px).png", "id": "1620909068795241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1620909072128574_3025989847305827908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8im2KMWdnEQ7kNvwFV1Wq3&_nc_oc=AdnrCHyVRs17Bh_3_3i1cbAXUV2sP-aQu8GJ4obSI9cwH1CvZrZoxL6jLeb33l54FP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvaizqu8vm6ODQpK0OeJwp2A4UFn7XlluuT8N1fM6nr1A&oe=699861DE"}, "display_name": "Helicoide", "keywords": ["helicoide", "venezuela"], "long_description": "Realidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities.", "short_description": "The funds will be allocated to the development of the Museo de la Memoria Hist\u00f3rica Helicoide. \n\nRealidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.proton.me/urls/V25FJ7R9AR#OWtQQV4ENPUt", "developer_terms_of_service_url": null, "publisher_name": "Voces de la Memoria", "support_website_url": "https://www.youtube.com/watch?v=W8GLpIO1
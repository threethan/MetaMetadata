0834352574180_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnviSBVqvkEQ7kNvwGjw4BB&_nc_oc=AdofXhd78gxn7LgpWydr-yCUxQpqgWogW5N2WbtD7bILhuHAsYeDeAzBCzNtGO8XIqI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-5Ruizne3L4eyURaVPRUBKPuDFjtHsOFEkxH1MAVq9w&oe=6A941FBD"}, {"file_name": "5.png", "id": "603139265985018", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393762_603139272651684_1766906290889380804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-EJkVj_h4IQ7kNvwGDzXBz&_nc_oc=AdoWLgxLbLEPaXbnrenudQGRmmV7o2LZlaJQcASv3c19IKjQck2t_Fjp-C0JgmRWFrA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNhrhZM-rA-z1d-26dLh_XnZ-EW7MXSpda6HrQMFD8-Q&oe=6A93FE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo (2560 x 1440 px).png", "id": "1620909068795241", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391937_1620909072128574_3025989847305827908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eovFPs6Pvu4Q7kNvwGkn9Ed&_nc_oc=Adp6b5sJCmw_F9cfS18xVrc_kPHYvavblkUWkSjKv4LbS84uAVGh7-IimCpYE-m2qdM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi-9hi4GM7YvD7ebW4mmETGUqjevXoJOdE6dyJD1gWQQ&oe=6A94305E"}, "display_name": "Helicoide", "keywords": ["helicoide", "venezuela"], "long_description": "Realidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities.", "short_description": "The funds will be allocated to the development of the Museo de la Memoria Hist\u00f3rica Helicoide. \n\nRealidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.proton.me/urls/V25FJ7R9AR#OWtQQV4ENPUt", "developer_terms_of_service_url": null, "publisher_name": "Voces de la Memoria", "support_website_url": "https://www.youtube.com/watch?v=W8GLpIO1n1s", "website_url": "https://vocesdelamemoriainc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "361620458439488"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9492388527461099"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1142601224242663"}]}, "baseline_offer": {"id": "1142601224242663"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738962420, "status": "PUBLISHED", "id": "1142601224242663"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9936142096419071", "version": "1.5.0"}, "id": "997718545502317", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9348816795151607", "is_concept": false,
c_sid=6e7a0a&_nc_ohc=0U8dK3UXSDIQ7kNvwGL3MPW&_nc_oc=AdqlZYhl63-05V1MHvDym5hYrlQZO12a-ITBlWBmANGh8rsnPF8sZVO6gcjKpceo030&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af15uyUA1ijtelqhdcHmbFPZoDjqYb9xCCm2YPFL5QMNFA&oe=69F0BC65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo (2560 x 1440 px).png", "id": "1620909068795241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_1620909072128574_3025989847305827908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCdJiyJdeF4Q7kNvwFz31Dr&_nc_oc=AdpxiYrF5AmMz3YfX1FWy-mQ6L37ygjXyPLnXDmzRFXBwnCTNdFc9L24pvR283lO6Hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Zwsa5GL-xOkGBkNEm7IhhvorxC_eyN4eKtcn_KKCVMw&oe=69F0B65E"}, "display_name": "Helicoide", "keywords": ["helicoide", "venezuela"], "long_description": "Realidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities.", "short_description": "The funds will be allocated to the development of the Museo de la Memoria Hist\u00f3rica Helicoide. \n\nRealidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.proton.me/urls/V25FJ7R9AR#OWtQQV4ENPUt", "developer_terms_of_service_url": null, "publisher_name": "Voces de la Memoria", "support_website_url": "https://www.youtube.com/watch?v=W8GLpIO1
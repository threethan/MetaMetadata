473391902_995746772605262_361820834352574180_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMBQkECoK1oQ7kNvwGzWBt9&_nc_oc=AdpSzp747l6dVXNydo_8oLuIy-YKGjXLhyN2RyLuXY3DNCRTV3i70VM9UWTDIiYf1TY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3J5NAuHd76TZs74s-i3SVauIkTqUT6wnzXOsW8EZxmQ&oe=6A8ED9BD"}, {"file_name": "5.png", "id": "603139265985018", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393762_603139272651684_1766906290889380804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnGthd4ia08Q7kNvwFbDrC7&_nc_oc=AdrXKydNRS2kZbZXseawNuyqDwSxNmhz1w9TQgy6FsZ9bcdcH9Qc2u99Xy1FnNjk5ho&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLbLK8N-185qDa0lZ3AsJSuPLL_NeQgmBLwzFUqRo1pQ&oe=6A8EF065"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo (2560 x 1440 px).png", "id": "1620909068795241", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391937_1620909072128574_3025989847305827908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmrSPXE9pl8Q7kNvwEMpxCK&_nc_oc=Adp-QtoQJOFRGUGkonebvpSes_86HHEa-pyR6pvkszEUV0uSV1w2yoO0ce9MbiWtduc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyyF8JpH1Agv3TSR5uXTEDvn0fHEYSmzGEZsmlpvMuog&oe=6A8EEA5E"}, "display_name": "Helicoide", "keywords": ["helicoide", "venezuela"], "long_description": "Realidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities.", "short_description": "The funds will be allocated to the development of the Museo de la Memoria Hist\u00f3rica Helicoide. \n\nRealidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.proton.me/urls/V25FJ7R9AR#OWtQQV4ENPUt", "developer_terms_of_service_url": null, "publisher_name": "Voces de la Memoria", "support_website_url": "https://www.youtube.com/watch?v=W8GLpIO1n1s", "website_url": "https://vocesdelamemoriainc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "361620458439488"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9492388527461099"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1142601224242663"}]}, "baseline_offer": {"id": "1142601224242663"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738962420, "status": "PUBLISHED", "id": "1142601224242663"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9936142096419071", "version": "1.5.0"}, "id": "997718545502317", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "93488
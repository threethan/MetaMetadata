ms2-1.oculuscdn.com/v/t64.5771-25/473393762_603139272651684_1766906290889380804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwFoGMfz_DMQ7kNvwFbZgY6&_nc_oc=AdlnCPYbErlfQYbsPNnlPZq8Ph89AatiGzcpAfYiWyFfU06UVs9DHWqqwOfyDw3rfmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftbCaa3ki7_d-_UAQnHD_hdkZEHtjLsCVsG0bkTXlFu0g&oe=69A839E5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo (2560 x 1440 px).png", "id": "1620909068795241", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391937_1620909072128574_3025989847305827908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JYqq2zTLO4Q7kNvwF-2MWA&_nc_oc=Adm5jANoLCvrX3YqALNUfduPygkKX8SVINyxvF2nOZjHAh83wJhLPSJu7W4mWq3nFt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvZj9nOtpKbyXkyfpf4N1SZ8w6O1krJEv1cR1TaYKdJ8Q&oe=69A833DE"}, "display_name": "Helicoide", "keywords": ["helicoide", "venezuela"], "long_description": "Realidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities.", "short_description": "The funds will be allocated to the development of the Museo de la Memoria Hist\u00f3rica Helicoide. \n\nRealidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.proton.me/urls/V25FJ7R9AR#OWtQQV4ENPUt", "developer_terms_of
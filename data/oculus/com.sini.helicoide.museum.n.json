0834352574180_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaIpYy7GK5oQ7kNvwE96E99&_nc_oc=AdoIdpeXdC4DaQExFOAWB-D9go3qrBvI-LZm0rUou2ToKdfAHlAxM3-E8LTAV_BSZPo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18rNS_VT14vJNJcUpDS5waDgtYZ_FwxSUZzNVwUmpwDg&oe=69D7993D"}, {"file_name": "5.png", "id": "603139265985018", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393762_603139272651684_1766906290889380804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vCx9XMLytoQ7kNvwE7RB5-&_nc_oc=AdrXupRt2rhJyJUpYY6_WK2s1EE6sN9bvIFJ-pW0j8bwyQqvpeSo0GN8tG9IyY74XMY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H3pWZ1P8IyQhPUJ2nrdZ7w2r5WSe3dzioNdXI-NvMIQ&oe=69D7AFE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sin t\u00edtulo (2560 x 1440 px).png", "id": "1620909068795241", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391937_1620909072128574_3025989847305827908_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w05tuR7w3UQ7kNvwEZKyMz&_nc_oc=Ado4ID5QruP4m-00HUYutsn1EYEjqvyFkRzJx530yWXZdGprxIxM7umDDeq-100bEBE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T_33kIVhez8yXRGPWmOw_78Ij3Wsn2PzcGryOmzR8tg&oe=69D7A9DE"}, "display_name": "Helicoide", "keywords": ["helicoide", "venezuela"], "long_description": "Realidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities.", "short_description": "The funds will be allocated to the development of the Museo de la Memoria Hist\u00f3rica Helicoide. \n\nRealidad Helicoide is a virtual reality experience that recreates the conditions in the El Helicoide torture center in Venezuela, with testimonies from former prisoners and detailed environments. Users can explore the cells, listen to accounts of torture, and understand the repression. The goal is to raise awareness about human rights violations and promote the closure of these facilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.proton.me/urls/V25FJ7R9AR#OWtQQV4ENPUt", "developer_terms_of_service_url": null, "publisher_name": "Voces de la Memoria", "support_website_url": "https://www.youtube.com/watch?v=W8GLpIO1n1s", "website_url": "https://vocesdelamemoriainc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "361620458439488"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9492388527461099"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1142601224242663"}]}, "baseline_offer": {"id": "1142601224242663"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738962420, "status": "PUBLISHED", "id": "1142601224242663"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9936142096419071", "version": "1.5.0"}, "id": "997718545502317", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9348816795151607", "is_concept": false,
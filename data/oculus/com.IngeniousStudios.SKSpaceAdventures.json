?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xodY0n93vcQ7kNvwEeRDas&_nc_oc=Ado3HIghlD7_P7cJHlyQfqoyUqqMz0kwDvBrHIzo2k14g0zdgeHSSr1YGcIGRawO3xE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRug22atY0FQLGt9Iudz492ZlgkgbbkOJrEqSZLt6ZtA&oe=6AB51BF2"}, "display_name": "Shopenkraft\u2019s Quantum Curiosities", "keywords": ["Crafting", "Cozy", "Shopkeeper", "Simulator", "Sandbox"], "long_description": "Shopenkraft reaches for the stars! Run a traveling tech shop from the back of your ~~van~~ spaceship!\n\nThe game features **over 50 different modules** that you can freely mix and match to create all sorts of useful (or dysfunctional) products.\nSome modules cancel each other out, but others create unique effects and functionalities. **Experiment with different configurations** to discover everything!\n\nAnd if you feel like some of your creations are useless... Remember that the customer is always right!\n\n\n**KEY FEATURES**\n- **Unleash Your Creativity:** Freely combine over 50 different modules into weird and awesome products. Endgame variations are effectively endless!\n- **Master Your Space:** Tinker with levers, switches and buttons to produce the various modules. Experience the satisfying zen feeling as you flow effortlessly through your workshop.\n- **No Work, All Play:** Take a break from your inventive genius. Test your creations on innocent glassware, play a tune on your authentic xylophone, or give your pet slime a good, loving squish!\n- **Nurture Your Business:** Start with a humble shop and build it into a thriving emporium, one upgrade at a time. Optimize the workshop to rake in those sweet credits!\n- **Enchant Your Customers:** Adapt to the quirks of your interstellar clientele and use your adorable robotic assistants to keep the customers happy.\n- **Enjoy The Ride:** Take your time. Adventure across the galaxy and bask in alien vistas. Customize your cozy ship and make it your own.\n{866214486033696}\n{3997557257215238}\n{1019533047162291}\n{2236352786901375}", "short_description": "Test your creativity! Assemble weird alien components into a wide variety of wacky guns!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1CwXyE81ZI0zw1KIOTbRUp-FwmU59lVhH/view", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27523311680682700"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507829691_1653035769321724_640361130245386333_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJgodpApaGMQ7kNvwF0tqeK&_nc_oc=AdoHqniikhbdTX1_uxCdru-ClP4l1Pxcz22tE5nJt_XmJPO8zmnaeCsLZ9c46jbO6M8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRk6erznRSzp1jIyJQBnwRqCK-0V__pE-YS7euuX8Weg&oe=6AB53131"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shopenkraft\u2019s Quantum Curiosities", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_dat
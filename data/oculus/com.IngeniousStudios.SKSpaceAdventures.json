iPLDGexNzxe_o9opUhGwzkrvuoK9tSk0ZvDw&oe=6AEF5C3E"}, {"file_name": "02.png", "id": "1674076320474363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303116_1674076323807696_1677665889580147912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr_aWrS11m4Q7kNvwF9p8sk&_nc_oc=Adp70a-jyha2Atr9pffAz2vnp8srUjigTB7w4ohOk2zG324bAxmgbcp2DZXwcWBLgFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAyjvN0vn8og1_lMNpQx9q24ZiGUBypQUomwOJYp9e_g&oe=6AEF4022"}, {"file_name": "03.png", "id": "1326218776375977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303606_1326218779709310_265803925880693819_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slsmvJK0ICAQ7kNvwHM_1u9&_nc_oc=AdqLo_ATS-_vEBDeccNhyKibgVAWiGUe4jsrl2E9FaJVBFr8tqu-ze2WOWAwFTNoYwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6CRWeJo3HMki9ho6vJgUJM4-vvhYkjvWD7bScSsldQQ&oe=6AEF497F"}, {"file_name": "04.png", "id": "1325335783127762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296069_1325335786461095_6479242184130858785_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvymn7cbjDEQ7kNvwFNvkyf&_nc_oc=AdohVjyFOa7zd89wcWU1cRFVvNq2u3HcodtBckHXQei_ZnH6GTaYSGdJULxHvnCGDwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTIvV1J6K-gBv5wwCGbmDkwXnLq-59a0EklgAAfn9Rng&oe=6AEF60BE"}, {"file_name": "05.png", "id": "2155334578344871", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298451_2155334581678204_2881862925225128606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lRca8R-jgkQ7kNvwGHRm16&_nc_oc=Adp2FL7YSSuWbKNIpYi8Go8NVDBKMq6vejaeRAYYX3wZhjFxbhgj202ZtayxDM8HL-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDKGHV8MBEl4scgtKUHu_G9MrOIPXrdRPZUXwdzcj_sA&oe=6AEF59BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SQC-Splash.png", "id": "1020421107643895", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313063_1020421110977228_8031410648109206486_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txw1kmLC854Q7kNvwG1UVFa&_nc_oc=AdqqN7riPrjXScmTlhB5QPsHm1tek7jE5gpo1Vw3Nqj4CQR5ncbxUGnFI49PXLkpkI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ55AX9n0BzXVgcwXUKx5DfzQ_nGglcK8XsoAzBrMc0g&oe=6AEF5632"}, "display_name": "Shopenkraft\u2019s Quantum Curiosities", "keywords": ["Crafting", "Cozy", "Shopkeeper", "Simulator", "Sandbox"], "long_description": "Shopenkraft reaches for the stars! Run a traveling tech shop from the back of your ~~van~~ spaceship!\n\nThe game features **over 50 different modules** that you can freely mix and match to create all sorts of useful (or dysfunctional) products.\nSome modules cancel each other out, but others create unique effects and functionalities. **Experiment with different configurations** to discover everything!\n\nAnd if you feel like some of your creations are useless... Remember that the customer is always right!\n\n\n**KEY FEATURES**\n- **Unleash Your Creativity:** Freely combine over 50 different modules into weird and awesome products. Endgame variations are effectively endless!\n- **Master Your Space:** Tinker with levers, switches and buttons to produce the various modules. Experience the satisfying zen feeling as you flow effortlessly through your workshop.\n- **No Work, All Play:** Take a break from your inventive genius. Test your creations on innocent glassware, play a tune on your authentic xylophone, or give your pet slime a good, loving squish!\n- **Nurture Your Business:** Start with a humble shop and build it into a thriving emporium, one upgrade at a time. Optimize the workshop to rake in those sweet credits!\n- **Enchant Your Customers:** Adapt to the quirks of your interstellar clientele and use your adorable robotic assistants to keep the customers happy.\n- **Enjoy The Ride:** Take your time. Adventure across the galaxy and bask in alien vistas. Customize your cozy ship and make it your own.\n{866214486033696}\n{3997557257215238}\n{1019533047162291}\n{2236352786901375}", "short_description": "Test your creativity! Assemble weird alien components into a wide variety of wacky guns!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1CwXyE81ZI0zw1KIOTbRUp-FwmU59lVhH/view", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27523311680682700"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829691_1653035769321724_640361130245386333_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYG7DxRTQVsQ7kNvwF3OFJp&_nc_oc=AdqGjwlIgqQMOlApKiT-5QEXyYBGPu-_wrDVm8ytnGe4hUlU4xZZojeIk_4pF1zz0LA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStSac7QArjyFxzHCAN4K-Zw5sbpu4upk9UFXUU0Rtr5g&oe=6AEF3331"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shopenkraft\u2019s Quantum Curiosities", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_dat
m/v/t64.5771-25/499303606_1326218779709310_265803925880693819_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wjKBNjRXTIQ7kNvwE_FgBx&_nc_oc=AdqyjB09eXiBwfVPnrC29xAY7FENAnvjRZ51Tr5_gGxZzdSoqeSAyQnJJFDDQR6U6p4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVUiXoTgs-0ZvfHdgkEzICEf1kyBEeA4inPrOAOe3eRg&oe=6B0C82BF"}, {"file_name": "04.png", "id": "1325335783127762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296069_1325335786461095_6479242184130858785_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_LOUsPbRGoQ7kNvwEoSy2I&_nc_oc=Adq_VeRtQRHFyHXkgF9MVzyewH9hCpMnu97haHSuSfyPV6ePyAmVF2GEbnkIE8wb_-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRF8YEZOpJBhbOvjMoI_R6yleNQl3BqAq031zMXPJcOYA&oe=6B0C61BE"}, {"file_name": "05.png", "id": "2155334578344871", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298451_2155334581678204_2881862925225128606_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MrXlUxHIJEQ7kNvwG-vf7p&_nc_oc=AdqqdvCRom-K459co41J8cKGQxetL11xPZSs9-0X1iPE0tIr3GMd0px1yiD39MUsdQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRY877DoV_k6vPoDo5a2drCF1wKeZSQ2P5SXf_pDCAlqg&oe=6B0C5ABF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopenkraft\u2019s Quantum Curiosities", "keywords": ["Crafting", "Cozy", "Shopkeeper", "Simulator", "Sandbox"], "long_description": "Shopenkraft reaches for the stars! Run a traveling tech shop from the back of your ~~van~~ spaceship!\n\nThe game features **over 50 different modules** that you can freely mix and match to create all sorts of useful (or dysfunctional) products.\nSome modules cancel each other out, but others create unique effects and functionalities. **Experiment with different configurations** to discover everything!\n\nAnd if you feel like some of your creations are useless... Remember that the customer is always right!\n\n\n**KEY FEATURES**\n- **Unleash Your Creativity:** Freely combine over 50 different modules into weird and awesome products. Endgame variations are effectively endless!\n- **Master Your Space:** Tinker with levers, switches and buttons to produce the various modules. Experience the satisfying zen feeling as you flow effortlessly through your workshop.\n- **No Work, All Play:** Take a break from your inventive genius. Test your creations on innocent glassware, play a tune on your authentic xylophone, or give your pet slime a good, loving squish!\n- **Nurture Your Business:** Start with a humble shop and build it into a thriving emporium, one upgrade at a time. Optimize the workshop to rake in those sweet credits!\n- **Enchant Your Customers:** Adapt to the quirks of your interstellar clientele and use your adorable robotic assistants to keep the customers happy.\n- **Enjoy The Ride:** Take your time. Adventure across the galaxy and bask in alien vistas. Customize your cozy ship and make it your own.\n{866214486033696}\n{3997557257215238}\n{1019533047162291}\n{2236352786901375}", "short_description": "Test your creativity! Assemble weird alien components into a wide variety of wacky guns!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1CwXyE81ZI0zw1KIOTbRUp-FwmU59lVhH/view", "developer_terms_of_service_url": null, "publisher_name": "Ingenious Studios", "support_website_url": "https://www.ingenious-studios.com/contact", "website_url": "https://www.ingenious-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
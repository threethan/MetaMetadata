y and rule the servers, with rewards given for winning. Grenade game uses the unique Gorilla Locomotion to add an extra level of skill to the game, allowing players to dodge explosions and use them to propel themselves and move quicker.\n", "short_description": "Grenade Game is an action packed PvP game where your only weapon is the grenade launcher, with many different types of grenades you can use to dominate the battlefield."}]}, "developer_name": "Kriggle", "developer_privacy_policy_url": "https://sites.google.com/view/capsule5/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Kriggle", "support_website_url": null, "website_url": "https://sites.google.com/view/capsule5/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33449468474700167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822550_1992928881490206_7567874053776083233_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5WXmCFTNSoQ7kNvwHKDggN&_nc_oc=AdmLLxET5AVVaPqZJjAUx3vlZvnXeauIluJqLTWOmOTfcSTysc65KF0p9HidXDlLb90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBnGM_QhEvwY17n4e9UoZ_66ln6rVJTz5kWe0EMAs8zg&oe=69AEC47B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
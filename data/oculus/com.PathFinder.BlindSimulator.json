4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHSmqrZjfiAQ7kNvwEG-6jq&_nc_oc=AdrCTVqut5jJqYzL4M_rrcutcQsbKZZthpOVbpLjZ09Gt-_Isi2Z6T5v1FZc8Ai-Gd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvDSE32VYkYPuLRmJKmzPQ8sIkBlOVDf3Chdtb6To18A&oe=6AF1FCA6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpIv2rH97XEQ7kNvwEMmMBv&_nc_oc=Adr24TxRMvRsJATiXfAcElGniMGGxQkujoIfiJ1v919ZxHu8b77ZfbJCXYusW85MNC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1BKiFLJG-1Zec3chO2OXIUdh4aO9mvRZXV9PrFnkg3A&oe=6AF1EBBE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xnZykvaRbcQ7kNvwF_Iffe&_nc_oc=Ado12FnJIFHmu61-tIy4d9QwNaqcYpagmO8qVbn1rmnpkHr7QmbgeX6xhQYCfDeeXkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwUIxsil9WiOC_JhojGVuzhtFffESbxAO0EaWkom5kTQ&oe=6AF1E41A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYCX1vktuw8Q7kNvwGoPcBy&_nc_oc=AdojrAt2DbhnrCrNPqaczz2GvGpMIN-xJmpWIvvpfT-vppkk0zU6TJdp__dS_jhOj54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWsvH2luhGMkiJsLF7heixsctvC-SltjU3bFhyUgGFkw&oe=6AF20386"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCjxf1_0n6cQ7kNvwFDR1Du&_nc_oc=AdqcraaONOLGv419VUm7mp4LHYwLXvzg4dxOYR043h_qOwXNOH03RIOhvfY2XZusiHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo99xNYgGarMCFgGsUMu0G38ww3TvvZQ_u0QXt55fzAA&oe=6AF1D524"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjUJSHgJ6XYQ7kNvwFW2qXt&_nc_oc=AdpKYro
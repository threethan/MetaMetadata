4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHSmqrZjfiAQ7kNvwFRlcYr&_nc_oc=AdqYU6vhKonYVMhjqvDm2sCf2Otk18GNx1O2-ifGA9AEV747ayIj5pD3Mcl9tE2wUow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCXErqA5bKDGclBcdZP1TIMgsp4nZ9ubuZY71cKGFSOQ&oe=6AEF59A6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmD-3LtOF08Q7kNvwErCHYU&_nc_oc=AdoBd0Goyx6DgYiVGzuTNNAajd3BqX5-bXy88H0jMe3bO3jeFBrXpOd8Ai4NDOytCOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMcz_nhL0DnkivvqaXmSawQ10-4uTl1Vb_vOuYkYm-og&oe=6AEF48BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xnZykvaRbcQ7kNvwGlHrTA&_nc_oc=AdouGtr4XqTBh4ZDQ2ulWmJbyLqjKgsBbtcRDsTtOu-BmAcLqK8I90L3BZ8kn_QdNbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRmHc5ypZ1wLtHrNCLhOE8TajSiDMZyIQ_vWpLFhvebg&oe=6AEF411A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HFePFwPwUEQ7kNvwFKM_YG&_nc_oc=AdrQq-zDY4mmSRFobyi7sSFUCgfsJejgAZkCdX-eetCv_6JelfoNSnAo6H3CWSK55vo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBHnUv2JQJARVfW-CC0Uwsoc0E8HiBAb9ei3CQrLDvyQ&oe=6AEF6086"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c62lPjchck0Q7kNvwEXhq9R&_nc_oc=AdpGz4dkCG73MglH7N__TX6eURDlOHY8WRPIOCARTLoEKKEiPf53qUCP-ZGN-zrT2i8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7n4Vz21CdTGiz4la1GxEUJPqQtFV2NvvZnJjZuM-mGQ&oe=6AEF3224"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRwZuTo8PasQ7kNvwHfy6mf&_nc_oc=AdrKdeu
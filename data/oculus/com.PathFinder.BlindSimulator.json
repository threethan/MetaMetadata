4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8s5IBh514kQ7kNvwFrK833&_nc_oc=AdrGzMtIFYwRV1W5TY3RbY52C1dDWXSOIqCLqwPqr2M-BXa03vr2t3IOccMNhfSMpqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOidRZEHjy3r3RvhF6WttIlBvQxOIjZt_65TQ5EY_30w&oe=6AE49566"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO_CTl7azrcQ7kNvwFoxq_0&_nc_oc=Ado-FsltEjdOQMpUeE4AP7ekPtsxXvq19MB4PImwkLJs1B1QebLBz5q-8J-idgTSr_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk7STf5zarJEYtHsJawtq7Ybxj1bVPnJR5rBZchqLqiw&oe=6AE4BCBE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utMlSEJvnFoQ7kNvwHdFhEa&_nc_oc=AdqVbb8Z04MDI0p8Ohw47n25zlnqY5QBZNvIZcOuVx2W8YDAMmgKFHC0WfqhL_cPK00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7TfPncMRkKqi2fvDOfP5Kkkb_4UkP2WBcU8sdVJo0XQ&oe=6AE4B51A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWmyIglbAscQ7kNvwFFHGIh&_nc_oc=Ado2pyD7EV7kGJa2Wxm--tveirMSxEsWaABlRyR2dI4_SNgmir7i8q8MAYmVw11j3yA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPay4KSk8t4U96Wr15hQtlGwZ-eRnfVqsIXmGiEHFhJfQ&oe=6AE49C46"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-Zeo6l-YYgQ7kNvwGZYPla&_nc_oc=AdrtJBV1C-fbiB6lzx6LsAW-NzTEiMzdL1DXuHVhBhURBcEzsvRmIIOnmgurBbIJ9kM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4XdLhvU8GCqw8lXhfkFpzWrj8Q2JB6vnLLR_kARammQ&oe=6AE4A624"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFZhlnEQnYEQ7kNvwEKf-eq&_nc_oc=AdonT6l
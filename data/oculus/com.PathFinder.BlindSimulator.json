4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSH71sLZ_QQ7kNvwH4kbfz&_nc_oc=AdpzpurslG53cLm9EK2OCQ_0x62xkHGGvNSkaMht3b-_7q89UkjyXSW1GAPJ9n046hg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9lqLi17YPfRmzN-QGbuu--3La9NuQA2IfgXiRlybdCQ&oe=6AECB6A6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6InuC1vD2AQ7kNvwGDi-HQ&_nc_oc=AdqH7h_4_vVwmqaHeJAgW6oAch7schQBFR45hbdrlEMnWAXiwTGuVTYaVYBSZQOvIRE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt4WhFoH44f0-voxKmsEkBI0FHeSMF5CqJe0DjGNy8Pg&oe=6AECA5BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh92_-K6hdEQ7kNvwHlDUhq&_nc_oc=AdqZbgGrna2eiVb_6-rtKyfZxqqr8TYTkzfR6pLv6DLhUnRujcBxPyP91rkMqQ_D_4Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSOmMzVjwSZdMU5f9Wo6-BE2VZuW-3dMizFtDsll0WXw&oe=6AEC9E1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V2oboO-z1IQ7kNvwHuP5JJ&_nc_oc=AdoJSHDX1QozW8bUrB3KYe_0Q8uvgprkjbLyYu_6DhtqGlJXgwW97hB_vac3lEvPsX0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0uhSptByNbOOR-AxVnIaSpsrVCV5JE5lqy2GQt7pQeQ&oe=6AEC8546"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RiGmDhGKV4Q7kNvwEBr7rJ&_nc_oc=AdrwwFb16Xyl0irNdYmCTo8kDU5DvQnrmne6NjChDG0gzmxAQwEFo4a4wn5qQlhdjHo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH9BY-6IrAjt49HAvdTcRo-23DXFem_b-9ayDVieuEbg&oe=6AEC8F24"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRwZuTo8PasQ7kNvwFaQaGu&_nc_oc=AdoOgxc
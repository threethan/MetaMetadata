368F66"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vk30fzgbB6wQ7kNvwGOkBsI&_nc_oc=AdpmXaMlgQv4RcUJaOVDFbyxLCnIyG-Rz0ms-PFpxRVTVnjYDEtT8hAU9VPijfZTdLk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZWZdRaDNuMWbEq6UF08AH-uGQLsSBztyInIi4lceFPg&oe=6A36B6BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_c0D2DFgs4Q7kNvwH4vjrD&_nc_oc=Adp9WpT0By46vfDfW2HCSLObnhPc4hd7TIHEH_GM_PCIqD_-2KMweEbdGBdmDPdPt0U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kWLLs4ykx1yKCzZISMBTE04BuFwnL7bGL8hljVGyjMw&oe=6A36AF1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA6TYjz-zpAQ7kNvwFUm68s&_nc_oc=AdplQ2ytCleQC0QyNgjlr5iVh2Rm1Psqh7q_VfYlC-Jjks-iUgp05Vk_GzAm015iIQ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O1-l-jTUnSgRCuVkdgN9oozi7GlQx01AMXqKGVLTz6Q&oe=6A369646"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Hero_Cover_BS.png", "id": "2518919831796602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293144_2518919835129935_1413575938524185386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebPlhrBD61MQ7kNvwH1IJjH&_nc_oc=Adqd--Kg9FjvpsWfl_U2X7yAdt4JlSTP8peb8VPvxeUyBFN_m0-YUOQI-bRtRVKNCr0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TNhfYe1faafLCEf_m2hTxStpM6zceyjktwP8GNImblw&oe=6A369961"}, {"file_name": "Cover_Sight_BS.png", "id": "1889382115345316", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623599_1889382118678649_1627841262428749483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etteTzbO7nsQ7kNvwHBHq0o&_nc_oc=AdpI6DadsWMXX3YJ-0RK4sMHk1yskMqUtkJvrY9nyYq6Sje0smVni7IEPFVRE_fi0JQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VsSefB2UxM19glR_JL4sEun2alQWlfDKCv-jsZJ08dQ&oe=6A3698B1"}, {"file_name": "Logo_BS.png", "id": "1282969720083144", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293847_1282969723416477_4993364730064165298_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgJUS-wDUOkQ7kNvwGmCPSX&_nc_oc=Ado1ZaReBgNjumDsVUfU_5BtKk48Z8X7gBf9WmFa9-hev4YndOcoCBkK3_kh_tz0czs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CDQlnSRoV5kZgTXqo6LHKOmONlfEPpaGvZuHdvkjNfA&oe=6A369033"}, {"file_name": "Oblong_Cover_BS2.png", "id": "1157781019735461", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499624077_1157781023068794_5238881516523049829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toawZTM4HhYQ7kNvwHY-EYm&_nc_oc=Adqj7RY6umcO2__hA4m_obmriaRaZOvQ8pQcYPD-LfdV47w5hOfvJw2-NtaB5pNGTz4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YMTjWnSFzIfCWxTGoFYvxz4hgUK7EOT6Vq72HB164Yg&oe=6A369B7A"}, {"file_name": "Square_Cover_BS.png", "id": "1044964141170941", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499295625_1044964144504274_5146027077935030235_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKD5w1r1PYoQ7kNvwFZhSmy&_nc_oc=AdoCytiTXYV-BEN8ih2FI0eK-_DrADh2YPXSjp9ZOvWEMTPquZZcAlpNpNGJ78albOw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ollmJCYln3enU8a1xAT3Q3LC-pB7T0x1dtZY6lJMPpQ&oe=6A36C3E0"}, {"file_name": "Icon.png", "id": "709150421931667", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499300603_709150425265000_4771646569560130260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrTc0hxHiywQ7kNvwEElDwg&_nc_oc=AdrhtI81UxqrZgY9wbjzgIsKqhMGc4_mxVmHHLQ-mkMERsQviAYET8hQ_YPGkgQFqWg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RK0T6ttywD8c24NO2i6Tw0oafLQICSWIVeKFW0ed78g&oe=6A36A971"}]}, "id": "1353252840055641", "locale": "ja_JP", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "1117124723599516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299957_1117124726932849_3586840880
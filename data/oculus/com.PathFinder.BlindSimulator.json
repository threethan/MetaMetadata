4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSH71sLZ_QQ7kNvwGlLC8x&_nc_oc=Adqy9urjDpNO4USs8W3zrjo-a4FWsm39rN9MDYCE1scnzJvPc1TqL04YgrCTsfv_G5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR617m-tdi24N1tZpukXK_ctfR59PsIVXqftBW44W-qqw&oe=6AEE0826"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmD-3LtOF08Q7kNvwGUJvR5&_nc_oc=AdrKWer032SuyjDMIsHt-LhETnCULYhW9K_04EkOJN_97X706DLL2Q6NbQm6TOb93NA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsw_Tx-9HpxPLo71OTHVQ7USg_T7dumIin33Mv1b4VDA&oe=6AEDF73E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uh92_-K6hdEQ7kNvwGwV_FP&_nc_oc=AdoZbhHvPgMM-NVzk_XKqYbvIljfaqkVgVJPK51OkhWpoK8RhWOVeNyrPu6sDlmdIcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShlXihcgw24ZQVf0SxU7Y10qEkKmGjAUxSyCHxtUfwDg&oe=6AEDEF9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HFePFwPwUEQ7kNvwHUL1bD&_nc_oc=AdpeJysWljHMafbApfYq2JKnMtwSLSQbVjNwkDhQ5VGhoO8XeXWrPOGdOMWCueEarvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsfU27AqO3gCQDe3jBgGev-awXYN9ihCqecGg6-DSGRw&oe=6AEDD6C6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c62lPjchck0Q7kNvwF_IJfw&_nc_oc=AdqPuaf-aV-dV0XB39lJPsvD6bKtRvmLFd_0C1CuDQwwtj3BsJuHA2-pXA4-WhAfzjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRfWlz2tzGbfr0xnf8UecCPCxdjnX1mt-6sBss8mhQwQ&oe=6AEDE0A4"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRwZuTo8PasQ7kNvwG97joQ&_nc_oc=Adrlesr
4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBk74ZuXKDkQ7kNvwEAokXk&_nc_oc=Ado8MZK8Qfjt8c64jYKPtszM3TEn-KiSydBzPuQSr8Whx3b95qMCgQiqRDDcp9oLX0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB7Bgf9StuVMXY5_IYl2iIemRjXPsvU9m_5RvDgW1sCg&oe=6ACFB5A6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HejEJJxxfYwQ7kNvwHQA5ap&_nc_oc=AdrBVswd1UODHeHdi1D1pw-FUSM5Ribn02FkEZYMQ4qN7Rh-gRXc_IgATZ4Hi54B3ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5acfEo7Pd5K_SSadMrk67St9AMgtE2jCMwyXo-epH7g&oe=6ACFA4BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBNjfmr-jiIQ7kNvwHgR8Rk&_nc_oc=AdrfI1XOVKC7l8hZRQT_ascaS_E3DPU3kZBKb4z2-020gfe03zodm_NpThZbn6rw4Xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTOaUpDRRPfIuMtsK1fb9kIKZEGiVagwdyC8-w2g245w&oe=6ACF9D1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfKTZkBl8gcQ7kNvwGNr2hL&_nc_oc=AdodG9mXLLmi9cwpfEPkhAYvscysKdV9cYtoObnQI-5azoiq3lVhdyrjbzAaVyliix4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNGeRBmJ11mekDnqCMMzHUdLSlGOpklSsd1FQ-ATbBYw&oe=6ACF8446"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Xia1AFxUK8Q7kNvwFHL429&_nc_oc=AdqzGXWfIzAp9JjngjAn94jyEkRhlwZgV31STGb28iMzmXpRsjSYueQ84A7y4i79Ufo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcM69oXSUpUIPEFca2QqkTGIDuYsRQVw9ul1n29SNTdA&oe=6ACF8E24"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7Aq8sKTjkQQ7kNvwHGC7tu&_nc_oc=Adow6pO
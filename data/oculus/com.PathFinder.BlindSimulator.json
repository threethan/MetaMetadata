4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8s5IBh514kQ7kNvwGg4SOq&_nc_oc=AdpQ3UzIfQB4RGxID9HmfRSuJv2Y2CNW9meYGlYzANkdqPgiMDbT3mO42PKMJx6Ztis&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAzDflofS1QlHHryqFRzRcXTGEz4UJ9AC3bFy5bumRRg&oe=6AE343E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO_CTl7azrcQ7kNvwFCsSJg&_nc_oc=Adq2kkJaTNj3amcPBpjQZe7TKqI65WDp3224MKz2pH5t84kK8rgeIyhxAJsz1HAKCm4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe1Cb_Al1MDLimrPDVtsaRLUPQBBt6ZVaDF0FDlOZhlQ&oe=6AE36B3E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utMlSEJvnFoQ7kNvwGz88Y9&_nc_oc=AdqAoQq94nQ2Jk6k-TeUf-bX1DK9CBR-HiMORQutrERHaAOb3DOhhTDO8XoFcgcAh_c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwLhz5aubDWoIJAl0knvGhqbRO7nEFJIWdwj99AZ9xMg&oe=6AE3639A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWmyIglbAscQ7kNvwFxHPeO&_nc_oc=AdowxoKLXs3Fm3v_xq0w5HCBBlsIDtJm6zx5pHctzhJ202yKXJWd4-DHZcQGPKXtfuM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9h7wmlZZZymyIZiX7nWeruSLHteKFz2nyLv_gmgNwwA&oe=6AE34AC6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-Zeo6l-YYgQ7kNvwG80Ay0&_nc_oc=AdppPzcOw8Vh3984oPBvGTYiWi2Jo-nJymVZ-3HEP6lPz-vAXwG2Nyd0M1J6o7LL1vE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK3ewQ7R65s7MCvZoSGOKFGlUPKEHABoBb59yZteH9Dw&oe=6AE354A4"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w52psLGcewMQ7kNvwEi4fGa&_nc_oc=Adp73ZT
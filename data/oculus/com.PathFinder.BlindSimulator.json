q6_GO1BBB_AmQVnIjmOTMvsDRbFQ&oe=6A130D24"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03SqWvhEnjwQ7kNvwGpLzmS&_nc_oc=AdrhnN-ZX37iY9g6dFfdvUrto3dP4j-NClKm44vsKZZgrpiA7DxLqw7SqBsBqF6ye-4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wVACBj9PKwm6YcVUPaiAQR9bsw2412-XNIiyx_sytyQ&oe=6A12F6E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_fr_rVAZOoQ7kNvwFj_M1Q&_nc_oc=Adoa-9KTVks7yUxI1VzVvRSbdUgaK9swhpB7k1xRYUbBkDZMY2K8b48SckQ413JD9zU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qVegk4uFT5BU_IQ3wEwwB1LCtXJUXXpLFeCnwb7kDug&oe=6A131E3E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfZLGTzyZpMQ7kNvwG8RV6q&_nc_oc=AdpD3QJGnziFkt4NDD5KvOsqA8GPEs7hO0-A7ze-l2N9Fl3usBOhMfFQ8r0aqGTFkyQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JgMT7-C62ZOwEoWai_d1BrCz1XygLjTgwT15RIbU_mg&oe=6A13169A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzyDNv68TK0Q7kNvwG6cWmS&_nc_oc=Adogt4MVr6MBHfjjIWhz19TduD4h1P4UzsCTakbhcEoWU1zB723khoaw0KsGChzUpU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fwTwfugTFxSy8F8XXAWwR9h6CDTlHeH1_lCMHkG1ViA&oe=6A12FDC6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pathfinderxr.com/en/policies/privacy-policy?country=English", "developer_terms_of_service_url": null, "publisher_name": "PathFinder studio", "support_website_url": null, "website_url": "https://pathfinderxr.com/en/products/blind-simulator", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
393567_605004332531566_6897404566112965238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwYZjMly-WwQ7kNvwF_76RU&_nc_oc=AdnYsaxFYIJt3GCcH8DhUG0AMQ8zu5wM_KVwOYfNn0lnDmI4xuhWZ5H8hhbJdVTsh_U&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs85Y2FD5LE_seWpV0GvAaDPlu4QUmP-0bTDwHBR3MQzQ&oe=69A18C4C"}]}, "id": "665348565861089", "locale": "en_US", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "957802893167624", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnojHsF7MY8Q7kNvwFTFbHb&_nc_oc=Adm7kpEoVVeFqrf7iAIEDkZ1QD4PQtcg9lM7rQDmm_4paswwJTwREfT_wXXK05j2P8g&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvs2gtkxOYspQIr5XLr_-8jaTPzCcHCtjyGb-UEpI3xMg&oe=69A18804"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eNT-COmXgcQ7kNvwE2s8HT&_nc_oc=Adm3F1PlYwilo6ZqyVLAhYOkucnGi8sSFsX-izYtwjwCpgVDwMes2JAphlDFAnYUH5M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftrCQOTLhGamU9S4zvJrxisvGpsBugzHZwzcKt3TbgmEw&oe=69A1AC24"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-BDCuzdGa4Q7kNvwEqOzPx&_nc_oc=AdkDFhFRYQldS4dVZ9QmtX3LiveacYjIKVvIGgqk8_EJ8a4H51wH_3t8w7cuN0FJXhQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftdlKFOPhE6gFaCr4T_hEyeY6RqeXK04AUllsXLgOf2oA&oe=69A195E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV8R0Yra_uMQ7kNvwEzQw97&_nc_oc=AdmEQuKg1z7VzRMOm16eYe3DWg_3FXFgmD40JHsuTAEMscUbfPNBOyzSePuCe3ZuOYg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvJw3VmHovYAi3OWj3kAMNQVlv_ri4spIuFnq-56449Qw&oe=69A184FE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0D8jIdMZsIQ7kNvwEbQjCw&_nc_oc=AdkPmkVUxryuYdYxP5GzcNfI2f9hgXEix6guCu8NRGJVKdimTGCaPK8_i5kazBcqAng&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvO094trzorKsJW9PTPdI2AMwWF5rqo28K_FngvMEMHig&oe=69A17D5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimula
393567_605004332531566_6897404566112965238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjekWzlW88sQ7kNvwGwn5lq&_nc_oc=Adk2zvOlNXpb1P2Gs5U4W2Esc4czIMWT8sm1CHUc5j3i10jFPw7BkoT8jQpal0B8LMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afus9ZtFwTaJeweyUTtBeLXmvymHpSO6bnCQMXdEjaoSWQ&oe=69A03ACC"}]}, "id": "665348565861089", "locale": "en_US", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "957802893167624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnojHsF7MY8Q7kNvwFeHZEG&_nc_oc=AdkAKgiY15UTo1KvGzn_zs-Wl4_VTjU5b1oR5hCKnipq6cHSxl8fGeBdrGTonMRWk88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPXZbGeY2uBRF5yukTW0qoLYTMZ69n-C-8x3xc80auQQ&oe=69A03684"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eNT-COmXgcQ7kNvwF2QTEo&_nc_oc=Adkw6lalOHfQTyS3uJr0ZsKiI_t4jBogXPgrlF98Z_aRkYR_7TCeDTlWPsg3ynBaSPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuv7lvsufK-yAZssBxWy7peJ4YPyYsnqJxn7JKf2LFnpQ&oe=69A05AA4"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-BDCuzdGa4Q7kNvwElEW5F&_nc_oc=Adnz4tsiL2Gzt7ksMlZauR3q3bRwLRR7OHrT-K6qcMCvZr49M9jMaU2ezJ1vtyfkR0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumEHW54fFmEeXzWAIHZmIkD16a702FQbsfgB0Fjodmfg&oe=69A04466"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHQoFh4PUKgQ7kNvwGa7j2W&_nc_oc=AdmCn0OhKCfIZLivJjWX1OMzvEyzqaAs3xjOzslHsFE_nwOdeNFmiXJTMHKNUs7ENTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxygfOsli7jvK9hk9yU3AnZ62b5uFq8b-4tJ2ud6X3Jw&oe=69A0337E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0D8jIdMZsIQ7kNvwED1o07&_nc_oc=AdmP4DB5qWaRxlS22KoWpJMzS4rHQ4kJo8ZtfyzmNpkhlhRiKiEAVfdhfHgA-hMCFsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumZDsWCQaQvePW2xgiEDcTyc2HwAJZxIMV1qru45DJZA&oe=69A02BDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimula
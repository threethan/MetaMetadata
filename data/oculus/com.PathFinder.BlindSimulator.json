4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKYc8IjkQnkQ7kNvwEeM4QB&_nc_oc=AdpI6kxxHxGoZeORWB6lT0k1XTUfR7v_Hi5r-zb9qaf3sOVJ2RZ62ktyB1IsDVq9BZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA3PcHPnw30ncQqG85BreDK3hQWfUsh_0BMPjxhWM2Lg&oe=6AE770A6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ohm1f4k9O5MQ7kNvwEAO8ZS&_nc_oc=AdrRCzDKsoJiiNCmHy4uQB6RmibBl0MZ8azgmCY3EjEoPC4XaWQwqkMxxFYmWVKHEfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJQkWTQ2u7D-Y04zxm0kR_sZVQjxrd2PQy_yDrLQQqYA&oe=6AE75FBE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dEyWrLUGi4Q7kNvwGzGIfJ&_nc_oc=AdpSZjTFNPmb0h_zwQvm1Z-Q_M8yTdrdinYZ8AfIESjfBdKnOkbQWesih3g1zF3kC9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcea5e7y2Kj0ezdUh-9ODMm4DLLuZbI1bX7zudPt_OPw&oe=6AE7581A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9Bb0D0O-awQ7kNvwFpizLA&_nc_oc=Adr6MP5S19NuJ6LP_ogs0RjbwotrqSZORpR6QsIHzehXpPigoMXhFpVyWq9bDdeMWZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSybmAw08JN09bNbe1SzV4a5cWAu5ylbuFbFUmj09Rufg&oe=6AE73F46"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_IuouJGX5UQ7kNvwE8Xk5x&_nc_oc=AdolRy-tTEk8OTQfB5YPc9tWNLIX3Kd-MQLbVpD7bKbGOpeVCn2qHex51ku25_Ycdtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy3WGW5o0cqbfGTLAeZqoxuUjsqhuPlaJwl8sB6JexhA&oe=6AE74924"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFZhlnEQnYEQ7kNvwH0D9KQ&_nc_oc=Adr_u7Z
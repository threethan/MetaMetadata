-7er3JLhqA&oe=6A85A966"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6g9xc0RxiIQ7kNvwEthgFS&_nc_oc=AdpWK5-nwQ-IOeXucV8mYIr0W1jvZCP7nlrrCW16uV2ircA_7a1EwRtdJfNRRYcbOlw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4FH0AegK8B3c52QgNUbeHta51kZltt-sYZ9gtZnYROA&oe=6A85987E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEUzsniiDP4Q7kNvwGrJKdT&_nc_oc=Ado7nxSXfluTKCAO_qylEwWelUmtAIHKtEGWjvarkBH3URTITlsf7a_cCsxdA7vGfdE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfiljOlwSKaOuaCnJPi39FaBjXPSpfyAaRzu1tMOd0ZQ&oe=6A8590DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CR749N3KSEoQ7kNvwHh8shU&_nc_oc=AdppYnz2YvMzlSLO2sQUcZtojXT8NmB7ZoUbd9OYXzAYVb8biwXpoy3-PSt574p4c7A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrm33reR5x55RM8yHKUxEhQpacITBl2p_MKL2elwqZAA&oe=6A85B046"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Hero_Cover_BS.png", "id": "2518919831796602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499293144_2518919835129935_1413575938524185386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srFlNlPZGJgQ7kNvwGOcnMV&_nc_oc=AdphsWb8xNuB-v7_GVGZ2MHCdloSCIoB5dnQzNiiPOIKjwofjwcyN4ecDXqP1-HfNEQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcJsheaIFQYprQftINlnr6rdoq-2ihsryAVFYoDI2R2Q&oe=6A857B21"}, {"file_name": "Cover_Sight_BS.png", "id": "1889382115345316", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499623599_1889382118678649_1627841262428749483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_941tr4mQXcQ7kNvwHCUrrP&_nc_oc=AdoOjN5WjlukzGYAFzPLxu8U9KR8Ww-MiNV3NXyBJlV_nRBckpWLRDbv9-JMQZu5exU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY-g9eFD_nNZxEnY3MeW8zmp_INgx009DLFK4GCd7udg&oe=6A85B2B1"}, {"file_name": "Logo_BS.png", "id": "1282969720083144", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-
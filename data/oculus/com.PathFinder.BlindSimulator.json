4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npe1KyYIq1YQ7kNvwEmwEd4&_nc_oc=AdrkAHL56VMR968gK8JIa2qIQ679RfC4c_wcdFaahW2U5zhOr916dLHMoG-cj_4uSPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA1dpf9jYb3CDxPDMKMo77bpDCoZj4sFs9QxMQEOu1PA&oe=6AF49FA6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpIv2rH97XEQ7kNvwEhejr8&_nc_oc=AdoiM7oVRDPu5MRwlP-2emBLPOq37RfngQXUORqvTs2emOg7vCl2-uMrV041EP0H9sA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZKrPK6CQNzXXQD_fRt1F-KZIO3_YNHncBoLKbbk7yhg&oe=6AF48EBE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uuhthm3GGZ8Q7kNvwGjhezG&_nc_oc=AdqCCOPYdX3W7nzGjpLzgov_wq9aYZoR6A0bjTLjpdjEwfOn8lzCtWx4nlzICD7fktA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLilOzFrDt9OaJu6qVwrcRxOpWUhrzgn4YOKN-vTPwbA&oe=6AF4871A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYCX1vktuw8Q7kNvwE1BgmX&_nc_oc=Ado-dUSgLSx_oBsNK90J2w6yQB-IuvHH6B3wW-oNI2UybcKWKLdZ3erd74O0mDCpDkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0XHhMlgD80ZMbaIk9qEMG5tZyOUvXXAi3gyk-XMfn0A&oe=6AF46E46"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCjxf1_0n6cQ7kNvwFI3uWV&_nc_oc=AdrwZKJlr5Zwn8ZrD1pbI5HC4z2QPXV5UcIVQ4BwXL6n6tpOK91BdFBQUbr4aqS0MNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQUDjRM9xotVdte4sul57Xc4oA6VvFmsRqfodCHADcKg&oe=6AF47824"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSNwp-CNGv0Q7kNvwG41hLc&_nc_oc=Ado_Ik5
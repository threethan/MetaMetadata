4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPMtkmxt5eAQ7kNvwFdMVqN&_nc_oc=AdrfVpbjJ9jShn0B2Nv7tfqZJ9SJV05ymbX4ruY9Y6rsFbBhRvh-l_UgQXZmT7_ADaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Ep5oPpcCoF4Mx5Cw7nDN-hBiYGE8didzU0vwVkEXQA&oe=6ADF4F66"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FEkcV-Zq2QQ7kNvwHZP1Wu&_nc_oc=Adpa9Jla9vVgG6YN8Q2yzGQPQsPpOFesQyD6n1jqJv3MsQlDVh6hweug7JnaGYkVaBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZlZoNXSovIEHEniye0w2wtUJf2fHuBKKqDW3uQg27bw&oe=6ADF76BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBCTN-ylE5AQ7kNvwHEu_Tt&_nc_oc=Adr_ZUYv11E1HwaIWm0lzw4C_Z0tlCaGAU8pTogRgZS-A_68gECqTtSJrS0RoQeSmIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6-u8iaoVMlJAXY17GYvjdvxp-4k3UK_HBLQKCyGP9iw&oe=6ADF6F1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TQlAVPgN_YQ7kNvwHyJQ9e&_nc_oc=AdomuO5f2QCNOJvsfTpxL9oHta5F0HpRHNN6YoiVeaBkItE_-7FDHG6ATarXwjfrzmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5vJbuCu20Hii-pO3_m-wyh5Dk_NZrmwxB99VjgHpBJw&oe=6ADF5646"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3OackomkqgQ7kNvwHEFHya&_nc_oc=Adp6pPCYFJ6n27cAb6cdvUoT18YbDnYTC41ITO5eVSE4rAyDpZuVjFjus-Bcz-1_0HE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtx5GbuOfkeWuktYW5rNou-zLoQjGbm-cZKKxoime18w&oe=6ADF6024"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1obJUaiKzwQ7kNvwFy1DCA&_nc_oc=AdpvShb
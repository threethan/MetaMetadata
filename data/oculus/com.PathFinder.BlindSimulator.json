4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo7sZI_3UWkQ7kNvwFZvYtq&_nc_oc=Adp1XzeWzJLJ9311CDQvck3dbZqfsKwuC8wHL_JSnz_uWQc9hHc0CC1alp_5lOvox64&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgbdjLW1IBU-I6_s6zPi-r1m1YZHcHStrAxnN3g3SeAg&oe=6ADCAC66"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qgfIl-DDL4Q7kNvwEr5odi&_nc_oc=AdqDauo8U-8e-x0bW4inpeMhfpVkQUwO1n0zw9yLatKmXX_U2LKv7hmwvkZOu9nxums&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-HNNt_olp2hLQP7rOvWqIhLsctrHXnrJv8WD0yvacjA&oe=6ADCD3BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eIRxMS93eQQ7kNvwERBqUv&_nc_oc=Ado7y2MC_U8NIy4nVmT3pIAejrubHXDs8Kxzft1VOqXccA3-ID9Ehy7AOs6xlDmh5gQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZmLLORF0MasuZBNkSb502pr5KqWGtoYf4A8malkQu7A&oe=6ADCCC1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmpEWIj8vnsQ7kNvwFyw_Vz&_nc_oc=Adp06p9riqPeDALWHu-NydQ0GfZVfPXVFGKg9Ta_MmATcXuxuuZztYCGUjZIEbfhSkE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKoQWCzEHALNcHRWYIPiRdQP6NEEc1OQgro1maCLalFQ&oe=6ADCB346"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pHxxDWd52wQ7kNvwE4tbHO&_nc_oc=Adrm0rsr4iE5qCQdReGxq5tN0Be0n779fy97amjb-EJ1YHtKdgmO5AlL_7H1krEOGKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPebs428kj5ue61X6XHOUzp3nhHmKNhyCwTF24LMnzAhw&oe=6ADCBD24"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1obJUaiKzwQ7kNvwGMVT6a&_nc_oc=Adqsupp
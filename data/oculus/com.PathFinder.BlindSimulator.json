d": "957802893167624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADrJ9NUxKXgQ7kNvwHQ5bxq&_nc_oc=AdoOHW6ekYs9hYR7YWx4kTJDAgqlh9SCWbXhRgL2khm6DxiP0Pos8i4fB_1zjKOe2JM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvcvsGzQe1W3effaT2O765_cBlkfHNks59elSR9EQmoQ&oe=6ABA8FC4"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STELEzXdYcUQ7kNvwEsxECU&_nc_oc=AdrkCfR7jnJRRuSeXnZV1PGS-3OWZS93Z8KSnpVXnAH3wCPW5YpmhBNWZ1r4eIlLQyo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL44zdZ2zDHUkhm2VUTt6BZyuYFY1T5R12NKUVhuVH4tw&oe=6ABA7BA4"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj92q9GQ3LkQ7kNvwEXJxnp&_nc_oc=AdoS_fEjaYeM9_nMOXFbakF_WC1sb-pkEQSANRkWuw2EHiSa1sFfRFXz46RKNqiGnxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ83aVlg0oZVxtznVGVQtAyfEJHsMs7RdGh_uEiCc7SFQ&oe=6ABA6566"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8phryVnymgQ7kNvwGfwzdn&_nc_oc=Adq4PM3D6OIbnr0yVDVxnYzjcQdVyLqFhpS1tArYk-9sJpuahGxWRh0sLrFh57wwIyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9jon8uRquvX6WQMLxTAvVRBxWywnIw0sSmtQCOJCfNA&oe=6ABA8CBE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTZ2qrtEUgkQ7kNvwHBoTSZ&_nc_oc=Adob0akkbZ-TXnuckGWrN4ej6wmyrMDpXa6ihYtYCLQOoM7uXNoGujxOEra2eeZh5u0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr7GdVCqvtGH0u-nWySrGWFqJHbO9FOU3EAEO0cduqzg&oe=6ABA851A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimulator.com/web/personalterm", "developer_terms_of_service_url": null, "publisher_name": "PathFinder studio", "support_website_url": null, "website_url": "https://www.blindsimulator.com/web", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
tps://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE9sb47t9tkQ7kNvwFaT64o&_nc_oc=AdoLBx1aksMMASKzHdQILhgUdbNk149_ysLD3pd9tx19tFDxu0VfopchBaQCyLD-Vic&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDxsrMzJ6CAeSq_IZ71-cEIGOxFt7NJJO2xb5NaCBQlA&oe=6AFC66A4"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pmz32VxGVvUQ7kNvwH3Mq29&_nc_oc=AdopuCaYS_AVgW3soGxhadnNHBFbJekLFdbd1mZiaNQNC0gFNSmrrhcstU9wJrf55a8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqiAHpmwWsfIYApsWvS22DwjYDeemmwDpQLoQB0IzUsw&oe=6AFC88A6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPqxNJKx8wQQ7kNvwGtkD9l&_nc_oc=Adrj3QQq1RYeO6uigYKPdMqsApglUX1Gzx-DNAPU3NOrNukUmdjA1afC7oQbY2TH9eg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6XHj5h0zNRY6xlar75pq68znQzVP_0K1qGQaUDgrRKQ&oe=6AFC77BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReCN2Uh4it4Q7kNvwFjk8Nx&_nc_oc=AdoTvXi2APKBgoMgmQ4_jgTtl7GMGHgOUB0G85mrGp0yLuFjz-JH0Ng-fzomi4KlSC4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-kgAvr-zs1ViY5PYurZP10R--cDMrMUEwxj37ZsKVDA&oe=6AFC701A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtgz97HUA0IQ7kNvwFBTuWZ&_nc_oc=Ado3H2teHjYoY7G0W9Fww1TaxFTwNiPKofcegb5y-EJVsvgEjXu1GxdyNzCFCoOS-mU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTssw2ubhuo2bwGZSH2pqmCJ3UJS1ZzwsydD0i6WPrWVA&oe=6AFC8F86"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsO0SzWQYokQ7kNvwHwFxO_&_nc_oc=AdpMedSQ3pR5VaD_DPgaqW04i97zh3PjEloQ-grfmU3QdPKIPRzkNh0vW_aCTBuLhZw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQqzhGY74bpJtP6CDmd0b2frxqT1Y8jau4BBZPuamXfw&oe=6AFC6124"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab48Hs2gXgUQ7kNvwFVoo9n&_nc_oc=AdplgiP1i-cExyUfSa9LrZONpvLpj2DXQKnYK8cFJmi58a-I2Qy4qkwWDEfxLxWpL4g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmrDGfvEw9IKeAx8yduXP-Ax47b3p5GQZuOzlkpHaAhA&oe=6AFC74F2"}, {"file_name": "Oblong_Cover_BS2.png", "id": "1209701877470863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393704_1209701880804196_4082816502531390103_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46ApfBi-NE8Q7kNvwHBYSyG&_nc_oc=AdqP1Fm6aKH3xj82Q4tz6zbfITdTvNAQ7tloTHUfc4-Eg8rjra_0ZOYkvJjxLzdk8N8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlRt7uUrZ09Dri29PbPiC2APPT-At9Di5tLsfj_YjP2Q&oe=6AFC7390"}, {"file_name": "Icon.png", "id": "1197743645395862", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391950_1197743648729195_5393457135371850241_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r8Y6yJE1-IQ7kNvwHzW9my&_nc_oc=AdpftDaPh21N8-2ZeaKcNajJPgKcoAqFzilNvuUpJNTo6qWkSqAbmoPS_xfjutaG5Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkhhuc4izC0wc7MDbFJlUIZwhW67sHbp3tPs0skCJNXw&oe=6AFC8DC2"}, {"file_name": "Logo_BS.png", "id": "1178319847417617", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculu
393567_605004332531566_6897404566112965238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjekWzlW88sQ7kNvwHfCUar&_nc_oc=AdlDIZ3ik87Byzvw3hgjMybjQBTP4liEBESP14S2x9Oi2V_j5pdCw_eUO75u9v2m26o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsl66fbhRsuNUi6UQbhy91XBitlvjkqp5HiRKDr95IyoA&oe=699EE94C"}]}, "id": "665348565861089", "locale": "en_US", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "957802893167624", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xGQemCzojQQ7kNvwGp251W&_nc_oc=AdlmW6hf4RgMIi96LGz6_D1nJMNF2smfPMuGaipRhKZzb-gPxjQNMeI2fxRpfYoARoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft_tagCZyX5_oWJK8YmlQ9G270euoO1yye5R_KBkh70bA&oe=699EE504"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eNT-COmXgcQ7kNvwGVJRX9&_nc_oc=Adk6-93Mhch1z3v-HBTJMiYuxCQY5nJTap4E0qjPzckuU7fS7h4qYic05-WAeEhk5bE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs9yLBwoVa2V-pG1mMHdB4baEi5y6cSGu17y-2ogeoTuw&oe=699F0924"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-BDCuzdGa4Q7kNvwEWVZey&_nc_oc=Adnqyb8VabpkEJM1kt4XD5DF4N8SRjJrbflMUWky9Y_AA1LP2v-6rAWbDmbaTRHy2mo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfspQEb9aSlJNyYy8Qywe41KCaROz-4M1pq6XaEhpEh0tg&oe=699EF2E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHQoFh4PUKgQ7kNvwFDAWw2&_nc_oc=AdkHjcRUjHIF3eCBbNzxA650-0V2IcHbAFZfrLHjeR_PTlAng7pYSenYohQkJweBT9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvjAEmxvlrTfgkGBWkZdU7mZ_aJeFJRUIMTqkFw-VK1qA&oe=699EE1FE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0D8jIdMZsIQ7kNvwFEiw7l&_nc_oc=Adl90BZtil1nWiWgJfbHYNFJa5ehfGMW76chcJv5FJ8IxisCU0J1LXGkPexgJY8T3fA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftzARZTx_zDR6eamI_No5F6de8pLodNWxDcblAQT_vNxA&oe=699EDA5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimula
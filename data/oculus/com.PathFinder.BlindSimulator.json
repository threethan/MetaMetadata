7DC066"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJNek0U9LfIQ7kNvwGFZR0f&_nc_oc=AdrfbFCHAclPPJPLCnUmNxZ4nz-yqc2ZqT4Ax-d-gj9AxVK3oS-mvPjjP4j276dINF4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWrF5-qturDBvhUKaCpJApMggmf6fpbudvjVTqo0LyJA&oe=6A7DAF7E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3Bn2nTewJEQ7kNvwGWSA5X&_nc_oc=AdqQ114Gfx0FX1B5-QBHPoBosKOFYnP_EZ0UtvRhuGfvYPyBcLP_fplW1lLMx_ZFdt0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErB4Yj5LpFLyTxQf8YJxwqfij7Msj7vM6BdHan-5rtDw&oe=6A7DA7DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3CDhQuDx18Q7kNvwHzQDik&_nc_oc=AdpkIn3O8XZgnbQLbaZ74IhduFyjCy2DzLyBlNla2N5C2_PBjpw4oN694e9vBggNq_0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY0QqpEv73UiBsVsfjbe97a0DG_x-9mfR2dmCvJcwesA&oe=6A7DC746"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Hero_Cover_BS.png", "id": "2518919831796602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293144_2518919835129935_1413575938524185386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIMSwAIVzw4Q7kNvwEy0KPO&_nc_oc=AdqYmKRI2Cpqoct6rb7iYnrplO9OyMaKSQktXzMUTeQwt1XVEQmhDJsymkB-7vSMKyM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHax-Jc24Nc9FTJBYqW370Lkz7Qm-5G8KCqrE6r7nmtxA&oe=6A7DCA61"}, {"file_name": "Cover_Sight_BS.png", "id": "1889382115345316", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623599_1889382118678649_1627841262428749483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bRITmmu8s4Q7kNvwEKQI9h&_nc_oc=AdqvD3gJ-gWCHPsphWo_tRun63JTtqTNpJYGmPgI2vOKfjmUWLTqOPfeI_hy6X_5mh0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxU5NrpI4sGpF6eY_1yN5gLkF-8navYTlJRSCDPebHJA&oe=6A7DC9B1"}, {"file_name": "Logo_BS.png", "id": "1282969720083144", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293847_1282969723416477_4993364730064165298_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwUd98lclb8Q7kNvwGQwz04&_nc_oc=AdrdWuYZh17iM54UnXc_N6m6tMbiVPh5ypH8z1m0j4iIgPOFxTsgvJvOYuUFrYle074&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWanCkMt6CQUXMA5i26vA761ldVXyiQfMcAGk4n3B1kw&oe=6A7DC133"}, {"file_name": "Oblong_Cover_BS2.png", "id": "1157781019735461", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499624077_1157781023068794_5238881516523049829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRgZNcKuskcQ7kNvwEdUPko&_nc_oc=Adrm190Qs9Ke-usvwMQd_qYjpwntS3ryoi0PUamMiIz3xRaDniXAakGX6lh2ZRtjcjM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGmdYN1lJ78BqBMQUnICzJTBOXSh7saM6l0T2Jy_GtrA&oe=6A7DCC7A"}, {"file_name": "Square_Cover_BS.png", "id": "1044964141170941", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499295625_1044964144504274_5146027077935030235_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq5czFRJGPkQ7kNvwEtFyRA&_nc_oc=AdrDFSxI_vLTHtEgdln3SyQ-1EXQEIHLgCyKKIxvDvP7EAtqBHAlV_a4hqHlxdG4FLQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuZv_dvc5HfNZ4X-fnk2cjMyqRNqpAlB5ErhDfnfQ0rw&oe=6A7DBCA0"}, {"file_name": "Icon.png", "id": "709150421931667", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499300603_709150425265000_4771646569560130260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR7bDuN-icgQ7kNvwGe8w6r&_nc_oc=AdoRIVrKLxJ_H13Yi4mWCDsQ9TZBImao85bx-2YGp60Z2UJhomMRk21h3HpOJIC3rWo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0Zlwj2AM8YLACHZfYMW6wp0ib-PfaPatOsKLovJ-BVA&oe=6A7DA231"}]}, "id": "1353252840055641", "locale": "ja_JP", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "1117124723599516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299957_1117124726932849_3586840880
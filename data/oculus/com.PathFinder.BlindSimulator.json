A3FBE6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBQBygxqu4sQ7kNvwFg6Mrk&_nc_oc=AdrIUbVvLhXy4_Itu0PtesOU4YfEgw2S9TEdGe8Lql1NBDpHY7lwrS1uowLV2EN0skY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYOIi0OpQOsRGDoLyqDfp5rg9aWgvovX0C8RWmYS93uw&oe=6AA4233E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsf45SlDGPgQ7kNvwFI25Fd&_nc_oc=AdrT2WZPblBNDiMKCYtw7a1Ty_X2wBw3PXQvVeZFt4CFBKEeRzsnK0t_jzX-MF_yt-E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC4lpbH-SYmN1vzHHJldssgE8usOesdpgM9zClMDl32Q&oe=6AA41B9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZiytJn0xnAQ7kNvwGKbeOB&_nc_oc=AdqJExawd4-17cMmrKCxpdqf9bTaqzcef20YFtw_FA9QSLemvJDqqgN1YKUO5Z03HCc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR3psDgOKkAkutj4lMN2ree3Itf6bIJlLwvXMR8H1Fkw&oe=6AA402C6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Hero_Cover_BS.png", "id": "2518919831796602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293144_2518919835129935_1413575938524185386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7k0o0kE-gUQ7kNvwGulI8O&_nc_oc=AdpqD7S30DV4we4daGezllkn4zj3xR9lHX0r_G0ipAnJZd8jGjlM-6Bng_CFjjPu4D4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY1em-r3JqCkKg6p72dyRqKalID22zvJXXwHbdfqF6IA&oe=6AA405E1"}, {"file_name": "Cover_Sight_BS.png", "id": "1889382115345316", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623599_1889382118678649_1627841262428749483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esdsSylkzKcQ7kNvwFdX1Mk&_nc_oc=AdrnCy8LP0McHrOCdeRyZl3ZaKpwOFz--lao7rjUaDDjCFSBYL1FfkMgFGQacjR3krA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv0ZsAKDz9949Zpdq-6f44xDY92fNb0le2znMH-lJdjw&oe=6AA40531"}, {"file_name": "Logo_BS.png", "id": "1282969720083144", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn
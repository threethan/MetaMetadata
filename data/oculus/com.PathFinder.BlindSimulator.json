s://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9U64a2diSAQ7kNvwE7J2fQ&_nc_oc=Adq_LdvBrLp4-5qpTqnmdMsVghx4P3Yk7Y02pJeBc-G1pqmYoF18xUXMBTDGnIlwuDU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOrnXM4DPF2xB4YCoDiuVLCEHBe3TGNgHQTrwV8uCidQ&oe=69C139E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CUAWxloDZgQ7kNvwE4CVUl&_nc_oc=AdogmluXClAIltY8LGmLlxC7XQ2nMAcqKYg-kUkI72U8LR2K-2-OR6W7VdXpHGXX_9A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxstDlZtepr7BrG67gskt0L7fYqau8YVgD-B0D5XUwKhw&oe=69C128FE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijgO1t5zKFYQ7kNvwH8KFo7&_nc_oc=AdqzYfBKhIbv3cSapheJAtJHqsKLvBZupyZVlcHzQTFfrjh3lF5d4LQc4s_g_fBt0YU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzHOK2ZbzQKQyc3g7H9x7TP_Hc8rtTu3baGJZ7jH0Lnfw&oe=69C1215A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSDPMn7bHjIQ7kNvwHvW_6v&_nc_oc=AdoFhbpNVkJII26eHHtVteSFEZH9UM_17z6qCUm1uPLQC4GcG1FIfS7eM6dtwPhcXp8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNXdbSN1-fDISUpoGMoV85Y1FY4XdGwFAhHi70faltIg&oe=69C140C6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pathfinderxr.com/en/policies/privacy-policy?country=English", "developer_terms_of_service_url": null, "publisher_name": "PathFinder studio", "support_website_url": null, "website_url": "https://pathfinderxr.com/en/products/blind-simulator", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
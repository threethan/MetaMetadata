me": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5zsUfIhLi8Q7kNvwEMRA_Z&_nc_oc=AdoOLQz7g9w3EC6LQ1OiT1FsCRc5KD66FM7NRx1zmvn-6ce1g_SswcUHyJlasb1ZtlA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S2tjOp8sDbCQm7d6-J-EKfmMp2QqnHl11rJu8vGMhYg&oe=69DA4666"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE-MJJqpxp0Q7kNvwEhXUE-&_nc_oc=AdryxT1x11kIvHcK6IPyCUTHQ0vDVRyOw__3EfzGsLc8X80x99fMIdm8XP-fEGqA8QI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af242fj7zWT5Sho0INXMJe0ub5SMSbeyH8DRzTInTanJ1A&oe=69DA357E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7ennlBjKY4Q7kNvwFbhyZZ&_nc_oc=Adq8RsOSwImdKbRqoowAOFFUeMCqC1XWnMcpBnK72zdJG70yr7aPmQXlb_koxc4GhVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-DT55WMqoiOvT3vX9K03lwC8sU-0Ma6vAxvn892Yf8A&oe=69DA2DDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimulator.com/web/personalterm", "developer_terms_of_service_url": null, "publisher_name": "PathFinder studio", "support_website_url": null, "website_url": "https://www.blindsimulator.com/web", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8845196462248729"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1163015875290655"}, {"status": "PUBLISHED", "id": "1195234688990083"}]}, "baseline_offer": {"id": "1195234688990083"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745074800, "status": "PUBLISHED", "id": "11952
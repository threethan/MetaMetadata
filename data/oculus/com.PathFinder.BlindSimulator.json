4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNA1h0Pzg5UQ7kNvwFXiMLM&_nc_oc=Adr4C5U22CtU4P1V608awwfd7bM8Fu2JTKLjEMaUQ0wa0wpUj2wilKEtYrt9YU2f7Zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhG6n5IssmriCdQq0aDILwZXFGzaH3aPiPXgsid1C1yA&oe=6AC24E66"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXVhJIx4TfkQ7kNvwE3sAny&_nc_oc=AdqtBQ0jEgupiDrr0D_TGteP9e0a0YA_8yL2KEtRcMeUerKcuhzUGh_s7p2mrAa4Gn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs2s0JoY7gnNIIWiJrNjGOCbLCBRb2-k75K6gxNDGC4Q&oe=6AC275BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X14Ku-BTFfIQ7kNvwENACJb&_nc_oc=AdrFwSPUUPNx7w2y1ho_JpneS43Qb02we4zS_LP_RMm3hljvmyKu5aqvhfd3UAfgQkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAti1RUtI99Wr-2nsyBL7SR6KY4L_FzU3CMhzc3Bdvjw&oe=6AC26E1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYSyrUqpynQQ7kNvwEGMcFY&_nc_oc=Adq5WqXWNtsqC6eFi2GvQeXDbGOqAMsljohPZ6rnk7s7-qiDMUjnJ56sdhojCG1J1pc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_eQyogQFYoa_LV0k8vR0GgdEoruDf_pVOZ9t2bGsTEA&oe=6AC25546"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsiAxZqzUGYQ7kNvwHyzaF_&_nc_oc=Adp917Pz9AhmgJKqwmfdJ7yIPEKLXdPuacamI6hzkS_ywn6lqQ4RA8QP6XYrVgs3dBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf_LE4yKiMQpHIceUgZ94bxYppYXUrX8PDeKGi6ALteA&oe=6AC25F24"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0VO0M_m9Z4Q7kNvwHzfAy6&_nc_oc=AdrlA0S
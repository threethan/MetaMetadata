4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNA1h0Pzg5UQ7kNvwHRjaG0&_nc_oc=Adpa8VT_w5OBcYSgCVllBczaHxCET_lkWLd15AVguARmtPUBF8uY5I5aKyA1WPXqNyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMyz7MruHO_ivlk6JP5D4JghmrGobY1GQS5k59ZF30Kg&oe=6ABFAB66"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woKYW5RD7j8Q7kNvwGPkmUQ&_nc_oc=AdoilAR454HcDaBp6eW_5HtTtzBbHkZLHfsO74Bb9RA6asHmKrctzP9XIrLEPNGY0mQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwoN9LGb_qKI6EDgazc9RkIffiMejkiivEh7MOIBU5kA&oe=6ABFD2BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X14Ku-BTFfIQ7kNvwFs5uyt&_nc_oc=Adp5PcXatJ884U5lBQIBvIrLnI86gs6fiSUQMJWc3Gxzfv_UiY27RbVRO5x3DLwdsQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNryI44clGDPFM8Z3g6lgtoq-U-lGQTsPrAYZS_ywx2yg&oe=6ABFCB1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m0HiX6pZIwQ7kNvwHuxrbl&_nc_oc=Adp7rowp5RmyXXed6_PCOTawcZLzM1S0LViULUCnG24_Gb0XyDczJJ1s4hjG1_SYxXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3pHGscTmACNYaOB4_sEZ7VuqSABKCfnVLonQTX9XAAw&oe=6ABFB246"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoDXpuob4AkQ7kNvwF9JrNK&_nc_oc=AdrOLTDPbpfVkDkKu_kPAPQzc2_8vbusGI1-1aFK8cswZvE8idWuk8uCOueVgVqsjKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzbl1wvamrD20MkZ6eMlWff6P7Qgak1Fx0w0KVYKrwMg&oe=6ABFBC24"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vUgbWZcx3IQ7kNvwFjgrP4&_nc_oc=Adpv7Yj
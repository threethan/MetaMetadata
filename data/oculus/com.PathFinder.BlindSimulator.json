4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBk74ZuXKDkQ7kNvwGwLnlA&_nc_oc=AdrFdBr6FxZF6KG5LrDwrkw_FRPiP-Qc6R64RGl7ETM0EId5Whxm-9p97-h7Eg4tTc8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb5u1equFSzRfhjxfd0aiQsc3y0n2obeYbLS34MKmngQ&oe=6AD10726"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HejEJJxxfYwQ7kNvwGUchgq&_nc_oc=AdqfK2QQgzHjR0getz0rs35aDsg-UukdInsqO2qNFVbRxGe5ZznZW63JmDivcdYZ2Pc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEqNCykjcbabfX1xj5nR28wcWZB7s6noVzduuu2rdXhA&oe=6AD0F63E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBNjfmr-jiIQ7kNvwHXyujo&_nc_oc=AdrdReLnnVlKeNkHuVDleFY5S-jLVn2v0NaocfkGqjxR7SYoWtbZp0oDONYSsnHhh5w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE_d80rN1a5KeYgXWbIuErezFEWEz2uB_vTIAhb07DUw&oe=6AD0EE9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfKTZkBl8gcQ7kNvwHciTyv&_nc_oc=AdoXHm5iHSdjtOtu2J-H7klApepKa8AbEKU2n15Vb2qbVXAApacbWQHpSs0WYjXWrF4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2I46vk55KObGiu_D3XqEHlsDfuNdofrM-NLNOb5ayTQ&oe=6AD0D5C6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Xia1AFxUK8Q7kNvwGDO43X&_nc_oc=AdrL8TuLYiCze8Jy_Jy9Ivhx-4OY2eqd5xrIObHiDktPSEBKXHY-g0AO9wcOVAbmYg8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoOZ64Jk39dtmUQbqum5yesRLxe4Cq7B7RK8pJ0eOqXw&oe=6AD0DFA4"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0zG-fKB3K8Q7kNvwGp6IuH&_nc_oc=AdpVO9m
4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdLJMj2YlUMQ7kNvwEyAtMR&_nc_oc=AdoJZqJEIGP0Mg41SoPrrUz9b1nbODAE3B2FblL2G_LLl3urcsiFh9f_giuerQDXev0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSQeW2Vjk6tD_fT7EAn6Ngyljq8yTFFuvuudrBIPZTmA&oe=6AD3AA26"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hRMy_GaHo4Q7kNvwFaUmHf&_nc_oc=AdrzmJz4tY_jQz4uRI2IEjMWp5zpXiz6Rzp4AWOJA49PKGLZ2ogcgPs-li-G0H2mgxI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkA3SYCHIbl5tYpXaBQBnl14NCsZHaMfr_bgzCohRlXQ&oe=6AD3993E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiztbZYX-80Q7kNvwHe1ToF&_nc_oc=Adrg4PFfCFIahn0fNDZpn15SxVxPjEd84paHyNtaOTuS8SYUFQp6lKdsxrX-Qc5jt5o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKgXEdmcpP_t09-X4G-Af3CVQ4UW9y1xgiD3P30ua9xw&oe=6AD3919A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2DRCaKIp1UQ7kNvwFWTeP2&_nc_oc=AdoRcNTPIb1TxojAdZkQ28rRPAZLNm8i9jGpz4LisGWvxgZz9TqLyMk3ayuSyGmFO_o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONqba0-XmYZm3I10QKS015P-8ICkNeBK-RLO2wsyDv9g&oe=6AD3B106"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2GKvpjYaOgQ7kNvwFkHePc&_nc_oc=AdrRO3LFbGhjp5lj7Wryq3QAxTDCpsrw5tqeGTUadwgVnmSzJ7kBcJXk_wv58PKisaI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3BI3O-ol68YvDBfMuu3UW-LDmB5Tm2xofXzvDMVv1DQ&oe=6AD3BAE4"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0zG-fKB3K8Q7kNvwEFeDWX&_nc_oc=AdqaOeD
393567_605004332531566_6897404566112965238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXQoxZEGzwgQ7kNvwEuAXRt&_nc_oc=AdmgfVn1XUlDB5Zo2WyvHX7BJjoUc-oKEDUnBBPDG2P_Jjo-P17JQQduVWR6eGb3LRY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2QyOitn3vDTNfyjZ7C696Wp01wHjWitqmeZO9Dy9qxQ&oe=699AF4CC"}]}, "id": "665348565861089", "locale": "en_US", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "957802893167624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9-mzw5-b3IQ7kNvwFluVtF&_nc_oc=AdlOoNx81CCtDKwPztH33ICT8R4CLesKhghVGRILpLDnD7ZQ7xKwm1TZmOdcpi3qdsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv21BpMnRyJTKKAkXF2D9M8aWs9OPbZ4eSXVOlwkOA2RQ&oe=699AF084"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E01sHmTeZAEQ7kNvwF_hqUm&_nc_oc=Admu0LAiFnzClRo1AT4AdF-kP4GJEyKE7cV0Y87T7QDv8j7oe8uQEWlNgtK--Wq_36o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsGwjoZYn9QnDuU3FPn081pu3uuRCl2i4Sx1JtumG7y-Q&oe=699B14A4"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnMR9YS8kUcQ7kNvwEpBz2t&_nc_oc=AdkEQoYoxRSSXBW9VrJx9py7-UNQ7hxe-CZoeZ966csS53MGebcSRONMKBJPXfbOUEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsga4ySpRrnuQrFET_dyTzafT_d1B0iHmvIKcBlUhzkjQ&oe=699AFE66"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_X4-d_h5xUQ7kNvwH_9xZe&_nc_oc=Adk7M_oImSCl6W4OvTNvGtYK-sPuOSQV-q5Og8Nhub5jadpq-tw8iG8AV1Os_tF9D5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs01ATSQSD1gZBfc8ZTW8ZBWjSSq0DU4ow9DCWrISwiUg&oe=699AED7E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05jMcviEVMAQ7kNvwGOlZGN&_nc_oc=Admbue2youGrfW6ChKo8zQH6C30XzHK9XrtWgnK9cEZJeAEp_F7_ylq__ncZunQ52X4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsr2RTCtBXw5r1lboOc31wg0JokhGnAQCGj2zsKAzUPXA&oe=699AE5DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimula
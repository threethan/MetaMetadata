4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npe1KyYIq1YQ7kNvwFQcsfV&_nc_oc=Adr1L9WJXeAVqGw6gsFoUparc_XwRlJ9gTlkt20TpkyNjy2VFPSaorOXZnc3fCWqJ8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSj1dBkEBoeV5p_jsUwaDlRkPmSLhj6xMQmoICmRpmRA&oe=6AF5F126"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-qL0mde_DwQ7kNvwEbm1L5&_nc_oc=AdrfmlTARm4PhWRkQZny_sFbkOV_FIVR91cMvHMt2fNiIDhFW2Du8yGMXOityLYwlqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIQ32R2zwLXrzXqJ67a7vcpvF9wLBkAlSs9rKtfzvXYA&oe=6AF5E03E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uuhthm3GGZ8Q7kNvwHuhcFl&_nc_oc=AdqkEpQzv4E0e8i2q2D-8HydLWsgIyaVVIUW9KLq07PNHNMG6Vcatw8nmvr_hi5uvM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQisgR233LdS0WdINyt99GMGdzfp5L9mqcX0a5RSq40YA&oe=6AF5D89A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW73fFBCb3sQ7kNvwHLGENb&_nc_oc=Adot_I7Ba1M_GOCs-aK-MVuPyyedHZ7N93hWLQ6EsEN7wdHfxmuWMU4HnCpJFHcaMEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUgyPBWuJgQL30hu3Mu1ftCM2qGC4QnsHAIbxtl0HEBg&oe=6AF5BFC6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AxNJJXHTP0Q7kNvwHoAxyK&_nc_oc=AdrbV0MFPmBOcruG3eg889H4OeHqowgVnXGiiFFo3XYS4TF9G3rsXzabF6bDseWu3dI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRFD5pcOnP-NUv-oNZzD5PjNwcKuGWxKyGwmq1XzQipQ&oe=6AF5C9A4"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSNwp-CNGv0Q7kNvwGqId3x&_nc_oc=Adom1L6
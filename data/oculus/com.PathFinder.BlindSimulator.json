sQwN-GljSX6mkLfN9BZrPP8j6aZhe0530zUJYsp57Q0w&oe=699C4B23"}, {"file_name": "BlindSimulator_Bus.png", "id": "1193981155723968", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394008_1193981159057301_5666014942873184624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB2U2a7ijhYQ7kNvwEABbej&_nc_oc=AdlNgLbnkZFXpDegP02EhJPycWCjGJKHj96zsIbaAXejcxeALVaXfTdNjP2PZS35kx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsZy1W7uHWa8mBgZ5NTVPAF8-X2Ct8XIZ1x2oXFGAotYg&oe=699C4769"}, {"file_name": "BlindSimulator_Stair.png", "id": "9760667970691927", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393810_9760667977358593_5800303379105959405_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsGLVFapDVEQ7kNvwEDfwM5&_nc_oc=Adlf-SYXcstOHw8GX97JkEmyWka8DyGzuCCU0omedv_8kH1izARVBWESL6lPjx7Mj1M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuhNGlVfBMA9ylQlwrjejqPDPPt653hRNFolQ1W-kTFRA&oe=699C44C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1906768173452246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628600_1906768176785579_8601579510833830700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JT7VweWiSlEQ7kNvwFCDhKu&_nc_oc=AdnBHiP1L1b1sUswRaehpeIoyfX3kc7feyIcokXLNYRKiCFsFDYqTatQ545emICIb6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsGrJRH85uQJgnhiHI53rAKprRyVY5dm7aDv2XUFDSZaw&oe=699C63F8"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "\uccb4\ud5d8", "\ub9f9\uc778"], "long_description": "# \u2018\ube14\ub77c\uc778\ub4dc \uc2dc\ubbac\ub808\uc774\ud130\u2019\ub294 \ub9f9\uc778\uc774 \ub418\uc5b4 \uc138\uc0c1\uc744 \ubc14\ub77c\ubcf4\ub294 \ub3c5\ud2b9\ud55c \uc2dc\ubbac\ub808\uc774\uc158 VR \uac8c\uc784\uc785\ub2c8\ub2e4.\n\n\ud50c\ub808\uc774\uc5b4\ub294 \uc2dc\ub825\uc744 \uc783\uc740 \uc0c1\ud0dc\ub85c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uba70, \uc720\uc77c\ud55c \ub3c4\uad6c\uc778 \uc9c0\ud321\uc774\ub97c \uc774\uc6a9\ud574 \uae38\uc744 \ud0d0\uc0c9\ud574\uc57c \ud569\ub2c8\ub2e4.\n\uc9c0\ud321\uc774\ub85c \ubc14\ub2e5\uc744 \uce58\uba74 \uc8fc\ubcc0\uc5d0 \uc18c\ub098 \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud558\uc5ec, \uc77c\uc2dc\uc801\uc73c\ub85c \uadf8 \uacf5\uac04\uc758 \ud615\ud0dc\uc640 \uc0ac\ubb3c\ub4e4\uc774 \uc2dc\uac01\uc801\uc73c\ub85c \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4.\n\n\n{1264135861594053}\n\n\n\uc548\uc804\ud558\uac8c \uccb4\ud5d8\ud560 \uc218 \uc788\ub294 \uac00\uc0c1 \ud658\uacbd \uc548\uc5d0\uc11c \ubcd1\uc6d0\uc744 \ud5a5\ud574 \ubc84\uc2a4\ub098 \uc9c0\ud558\ucca0\uc744 \ud0c0\uace0, \ubcf5\uc7a1\ud55c \uac70\ub9ac\uc640 \ub0af\uc120 \uacf5\uac04\uc744 \uc9c0\ub098\uba70 \ud50c\ub808\uc774\uc5b4\ub294 \u2018**\ubcf4\uc774\uc9c0 \uc54a\ub294 \uac83\uc744 \uc2a4\uc2a4\ub85c \ub290\ub07c\uace0 \uc774\ud574\ud558\ub294 \ubc95**\u2019  \uc744 \ubc30\uc6b0\uac8c \ub429\ub2c8\ub2e4.\n\n\n{1196235982521710}\n\n\n\uc774 \uac8c\uc784\uc740 \ub2e8\uc21c\ud55c \uccb4\ud5d8\uc744 \ub118\uc5b4, \uc2dc\uac01\uc7a5\uc560\uc778\uc774 \uc77c\uc0c1\uc5d0\uc11c \ub9c8\uc8fc\ud558\ub294 \ubd88\ud3b8\ud568\uacfc \ub450\ub824\uc6c0\uc744 \uac04\uc811\uc801\uc73c\ub85c \uc804\ub2ec\ud569\ub2c8\ub2e4.\n\uad50\uc721\uc801\uc778 \ubaa9\uc801\uacfc \ud568\uaed8, \uac10\uc815\uc801\uc73c\ub85c \uc6b8\ub9bc\uc744 \uc8fc\ub294 \uc11c\uc0ac \uae30\ubc18 VR \ucf58\ud150\uce20\uc785\ub2c8\ub2e4.\n\n\n{1824207868479912}\n\n\n**\uc18c\ub9ac, \uc9c4\ub3d9, \uacf5\uac04\uac10\uac01\uc744 \ud1b5\ud574 \u2018\ubcf4\uc9c0 \uc54a\uace0\ub3c4 \ubcf4\ub294\u2019 \uc0c8\ub85c\uc6b4 \ubc29\uc2dd\uc758 \ud0d0\ud5d8\uc744 \uc2dc\uc791\ud574\ubcf4\uc138\uc694.**\n\n\n\n{1478816706654050}", "short_description": "\uc9c0\ud321\uc774\ub85c \uc138\uc0c1\uc744 \ub290\ub07c\uba70, \uc2a4\uc2a4\ub85c \uae38\uc744 \ucc3e\ub294 \ub9f9\uc778\uc758 \uc5ec\uc815\uc744 VR\ub85c \uccb4\ud5d8\ud574\ubcf4\uc138\uc694."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "1742746496664496", "image_type": "APP_IMG_COVER_
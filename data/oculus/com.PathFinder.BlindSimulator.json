d": "957802893167624", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADrJ9NUxKXgQ7kNvwFgH930&_nc_oc=Adokr84taIUo7bP7UfNCyJ4vORyfPYAYaZjjacxcKlbBuPYnED8X7bZHz4V8XK_glcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2Jzwa6IAIaJ-N8m2fvV6C_N44QV8jcq95uEPQd3eQoQ&oe=6ABBE144"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtKTNhhvvmIQ7kNvwGlL_AM&_nc_oc=AdrPSb4UxJoYyHx5q1JmMu_EEVlrIqRIcSo_R4hJLI-WdC3RFYRPIIBkRPQwDPUKf0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjEHg5cqz2BuV4FXJRa1KTTiN4HiQHenROWkB55-4PFg&oe=6ABBCD24"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78Zj4xDEgOkQ7kNvwGBxDWr&_nc_oc=AdqjLcwFeGRT1cFcvl3wVOeOzSM-0FtRBZJZLEvrDKOTdWQwbZfqS2EyKWdS4RX8FlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0uCA1rxiDesWrX5KqK9_eaiekarZOJWmzjSNxdh696Q&oe=6ABBB6E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8phryVnymgQ7kNvwGfyLIK&_nc_oc=Adpm2Ghtx3g95dvKLwlDdkYyeXR_6imjEAo6LDXGnDvLp71_DbrjrpTPMLVEsqsG6Lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyIaUg5hLVU0db8DrSuoRiTlf-r7sICxmnGyGyunJdIw&oe=6ABBDE3E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLKWa7sNSUMQ7kNvwF2sQrR&_nc_oc=AdrL-pP7hafMcOszd2EDVYWqboUUyeImUGqvPViozG7LSuQz_n85GfG37xQAjyRySF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ93Ievg888qz9xM-Tp_Y3bGWPZzm1n009amP8awRdWsQ&oe=6ABBD69A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimulator.com/web/personalterm", "developer_terms_of_service_url": null, "publisher_name": "PathFinder studio", "support_website_url": null, "website_url": "https://www.blindsimulator.com/web", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
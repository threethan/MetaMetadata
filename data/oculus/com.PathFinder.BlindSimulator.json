&oh=00_AftV3goFbP_p5buF3V2wa4il-CpGy8gHQz9OodHaBXR9Ww&oe=699C4FE6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_X4-d_h5xUQ7kNvwHa-s0_&_nc_oc=Adls-e8S91c_I9bga_J3jO1JSF-PLLixNHLH6OL3QviEpnXpxiprIAIFmIsDAOYpRMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftbmjAL2kZmfzzxl1VffL0I-rBolAJtm4F_eAxhZrfBxw&oe=699C3EFE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05jMcviEVMAQ7kNvwGTyUMc&_nc_oc=AdkrZTQudCNg1Nm_WXQhLpe8tqPbHITHEqdmodb2aSqFbJ9RwhmfFOhQFp-mj0hQYwQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftzRQmHkwaYwR9A1McAZzQzl3WNyGdqazf9w2AdpgNQ0A&oe=699C375A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obZ7FaPEak4Q7kNvwF6KExi&_nc_oc=AdmAswbhmVp0A1wv21itJ8s8ZWdKhmC3f6nBttWFfCKm3rGCNynuv4iKfuTNy-30ipc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfssUoYxVh51SF5d05sA6ULY4sg3qTubzePtVhcDXrsDkA&oe=699C56C6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pathfinderxr.com/en/policies/privacy-policy?country=English", "developer_terms_of_service_url": null, "publisher_name": "PathFinder studio", "support_website_url": null, "website_url": "https://pathfinderxr.com/en/products/blind-simulator", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9931967533571611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
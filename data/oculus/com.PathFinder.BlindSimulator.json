d": "957802893167624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx2MB8iBmWwQ7kNvwGshz-w&_nc_oc=AdqfjfF2V7R1gkN5cPDiUcvnDdmG8RltCQVBzyKjPhBqkU2CAP3BnDveLDQOln29WZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVhGXjE_Ke8ZBghfh36lLVsrOsLb4AsahMGjFGd8nVUA&oe=6ABE8444"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtKTNhhvvmIQ7kNvwGAv3vc&_nc_oc=Adpk5H2Yre0bcnVJY8KqAPFK1J0KPYxmyzssJRQqno7-2HVLwlilPtYrPU3_6MHRmE0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfe9BwLI6HAqQee-Of5LGUEpjS6wrR2evF89GC7KS-rw&oe=6ABE7024"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78Zj4xDEgOkQ7kNvwEg6RL_&_nc_oc=AdpZvIu9HsIb6n17O1rJgOfLyImXtuytMuACa77rnYjPu5TPOfYejwM5kz16gsUHcv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgyzNMU3uHtrGNk2ZCcm3P-3L3F0oh3CiwY-vikeE1dA&oe=6ABE59E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woKYW5RD7j8Q7kNvwEmnS3v&_nc_oc=AdoMZbp_Z5k0XFRkWJEvw2l6sQDz8k8wWmXmhCh7JseJbTy-GZugE-Twhgu9hzsdmTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIANyb8m3bgWZ8FbluzElvS0KUF9PCOXRK0yCK-YlqVvw&oe=6ABE813E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLKWa7sNSUMQ7kNvwG5SEB2&_nc_oc=Adrb2pzWRYHluu5ZBwZaAcbkPJh8NeIn4-_WHiktVYGn6wce0ClfTkRFt6NP_ogD250&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkQGxrMrpA62ob8OsZbcwPZ_DZuLnAcb2sW1nBeopvrg&oe=6ABE799A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimulator.com/web/personalterm", "developer_terms_of_service_url": null, "publisher_name": "PathFinder studio", "support_website_url": null, "website_url": "https://www.blindsimulator.com/web", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
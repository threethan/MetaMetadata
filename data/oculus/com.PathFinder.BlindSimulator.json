A941E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl4KVl9UuyMQ7kNvwHx19EO&_nc_oc=AdqhJsqsk41sdm9TSn5__OoqgfwBakuTzuMe6IYqj6KlByF-XSXv6rWmhgQyO2C1xpU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7hzGSnXAr357K0q8AFFrTvVGObN-Icc8OhSlxSxuZpg&oe=6AA9693E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FR9WM4Y3_kQ7kNvwF7HAkG&_nc_oc=AdpaMjQ6FAGemgmSChCs7KopguD2n0_vwYE-1c3-SH9gijAbLxA9w4qsC5WU57JDS3k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsVf5LQ4Y2JMGV7OZBS3tEDjT0b5KBtjAg6rYoS_Fwnw&oe=6AA9619A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJwuJ1REbnIQ7kNvwFZwhAw&_nc_oc=AdrYAgM_P341YUxJ2-RSpbuDw78Nn2nS_pgeUVDIlKKTp6euu9xr-wjjfeyQgW3r3Hc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOXAO86dg0LdWCU6KEaMAm3bx9M91FTb3GmFUz0b3Q8w&oe=6AA948C6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Hero_Cover_BS.png", "id": "2518919831796602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293144_2518919835129935_1413575938524185386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRe0XBlbEzMQ7kNvwHJb78V&_nc_oc=AdrFAURFTvv7U_QVr2gnBfEdfThfyxkDJjUgEORJ7QZSyDXfyHBWe3viDEJEPiVozP8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV6ZGIqViyAVwG5SLz-8h1KGA3CPuzdP2FUR2vrvl9pQ&oe=6AA94BE1"}, {"file_name": "Cover_Sight_BS.png", "id": "1889382115345316", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623599_1889382118678649_1627841262428749483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLA72W_2vXgQ7kNvwEZxxNJ&_nc_oc=AdpZBpPR6N1XH3kCsdH1m39siNRVbOx-Ah5AS0iepMr5yyE58gq3ZiB-1LkT1iwMzSs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx1nrHheIEwGJ4kU9lfrCGmKUgbBj-ioHr2tc9ga3SLQ&oe=6AA94B31"}, {"file_name": "Logo_BS.png", "id": "1282969720083144", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293847_1282969723416477_4993364730064165298_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFStfizT0WQQ7kNvwF2Jc_U&_nc_oc=Adp6m2xDmaO60kxNGhEvCoIfRM-QQ3MLWLH2u7hkr75jiskc3i6zbJn8UMpm8ry0jlc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIigW42B-XVibrczIfsNAr-bK4-ioCgK4BeNxx9mnnu4Q&oe=6AA942B3"}, {"file_name": "Oblong_Cover_BS2.png", "id": "1157781019735461", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499624077_1157781023068794_5238881516523049829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrKdXwVs5o4Q7kNvwHLjrnk&_nc_oc=Adrw0ekhpKRZdASc6KOvHt7C5enIT9rpUW7W4NskUPaoltsXvRi4RxdrJeSjXv-2oJQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs5vE4O_9bIgAUxEmYS6dNfrzwzOBHfdmSLSM-ZtSJwQ&oe=6AA94DFA"}, {"file_name": "Square_Cover_BS.png", "id": "1044964141170941", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499295625_1044964144504274_5146027077935030235_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQdm6NAJBtsQ7kNvwHw6Dqn&_nc_oc=AdrHOKzJM_xLVo4njRbsAr1kzUOnwvAj9kAP_0UQWe-o4JRSSPT96mw6v_Vz8dXQPgw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7eADSZtHsR8kUEig7xIZIq38P53AHwTOinplQUq-6cg&oe=6AA93E20"}, {"file_name": "Icon.png", "id": "709150421931667", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499300603_709150425265000_4771646569560130260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNtYJIbdo08Q7kNvwFD4f_A&_nc_oc=AdrT7ORQrFt13SXZWGXZoDtRrDxnnQWoXhTVcMp6taH_4q5M5sUZfevl8gCzjVwql-4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImPkYAc84TSF18p01ZfMGvMkS6RManMTcGzEWHKQPqag&oe=6AA95BF1"}]}, "id": "1353252840055641", "locale": "ja_JP", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "1117124723599516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299957_1117124726932849_3586840880
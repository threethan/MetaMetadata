466166"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHz19tXvmxQQ7kNvwGWwJor&_nc_oc=AdpzUlp4KaScEdIULRGPreGj5ZoT0_Nb7f4CccVexGlDxwFcQ2T7wQeEmNKNns1Bmz8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UCEQUqzH-z_qll0KN8nN_8iHGeo3XUP39wlJ6FH47lg&oe=6A4688BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6lAQUEgOfUQ7kNvwHyQgdS&_nc_oc=AdpWL0Mk6L6KhoBnVFttlHSxvLyh_am0HOQhjaiG16rhoqua3IJ5a6UWhKM9TmFrgOw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zyBX3r5Jogl9wiNEXfHEtcbZ0s9Ml2TnelbGBTkBzbw&oe=6A46811A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1ExIn2EuyEQ7kNvwE2Ee8b&_nc_oc=AdomyZqASgPEt2Now8YGPcFJv-rSS2x8sShbfFO_M7m7DrxGtunPI-Yd0RH1_kfUpho&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mxulG64mwpWUhDk7SYao50dqpaTG_ovsDk5WMJbGkpg&oe=6A466846"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Hero_Cover_BS.png", "id": "2518919831796602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293144_2518919835129935_1413575938524185386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coSZHAMvrdoQ7kNvwGYRHO6&_nc_oc=AdooqMsI6LIAwbg0rYVLNXwTpgRgh9HQGMUkwe9d3XotsT5X0n3C7L5k0atDAWu7j30&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bjOcPgBdoYrnVq8zm_ONw41UWHviwFAxdGBC8q2B-Aw&oe=6A466B61"}, {"file_name": "Cover_Sight_BS.png", "id": "1889382115345316", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623599_1889382118678649_1627841262428749483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVswqJgHNkwQ7kNvwFb-Zzy&_nc_oc=Adr_IC3b4E1tOpSXmDtGguVzKR6t00-Es2AViitTyVMhfSxzo4gw_N5lkri1HY1EkqE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_6QYY05T28X97Z-cpn3kTLDBcYqXIladF_8ujcCTxHA&oe=6A466AB1"}, {"file_name": "Logo_BS.png", "id": "1282969720083144", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293847_1282969723416477_4993364730064165298_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPtE7aoIxXUQ7kNvwF43leL&_nc_oc=Adq2PBOsWDUFU7C5eRo7ThJghSpMTAf0CiFbzW2MsAx_76knD89spa7tEUGVxmaE2L8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z0CKz8GpV8p5uN18L3p6MNfmufqcIs4lGntDHiLvpBA&oe=6A466233"}, {"file_name": "Oblong_Cover_BS2.png", "id": "1157781019735461", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499624077_1157781023068794_5238881516523049829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TtgoDEOS9kQ7kNvwGMsgWv&_nc_oc=AdqzXKuuZtNbF-d-1doBbpgBWzJSav57zJMsQKAueUM0K0V7I2qt7yi3dcfJViXrlrU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dXslm5GTQDCaHcEvlatHD3ta_-xoWVSt9FVQDsLgZZQ&oe=6A466D7A"}, {"file_name": "Square_Cover_BS.png", "id": "1044964141170941", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499295625_1044964144504274_5146027077935030235_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTcTBelKnFUQ7kNvwFUi-6G&_nc_oc=AdoFcElwjJYlKOx_rj-qRZu2IrvWpfnrU_cuUgLvzuC__WivEK0ouCLAmm6_4JJmouA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_Xges49UdKd8E2ZSsQKG4vRcMH8FV-9KqPlZh0B8e5w&oe=6A465DA0"}, {"file_name": "Icon.png", "id": "709150421931667", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499300603_709150425265000_4771646569560130260_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo6iE2soiTIQ7kNvwFtul3R&_nc_oc=Adqmth-Ke1tlowQjKb1Xe_cdoESJLeCqKfenbZkxfHtdvQGfv-_LzXDI5oUxbrE8WCM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KRvCQUrAiifiuqP7wazKmkslu722uCFxGBblF1JFsig&oe=6A467B71"}]}, "id": "1353252840055641", "locale": "ja_JP", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "1117124723599516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299957_1117124726932849_3586840880
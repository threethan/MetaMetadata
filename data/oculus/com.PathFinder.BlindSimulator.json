4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agYPv6wSZJwQ7kNvwExoUjC&_nc_oc=Adq5tGJYA0LJ86eVHioHcHlbIaIqTERal40QNFezjNUnAegtaBeNjhD8C7vnguzihMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV5QyONxLZDdL9SGMwc9yxncvQ_Ww2LzNdYwu8h3TQzA&oe=6AF89426"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-qL0mde_DwQ7kNvwEgTBuO&_nc_oc=AdpwKGT6NEC0Xg_X0p7wqyC_5gZEmWOiAaFe_LCI7MawlJ-326mGB9vJyQpRawTRMUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7parNfWaMCHgYBcOuo4FKACpAP9mmYTs2J09lmQlZwg&oe=6AF8833E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TmZLsy90CkQ7kNvwFxjJNQ&_nc_oc=AdrlfJFX6ybLKD5R8vlGfssO5YshGCiSX4vZDRa8B4v4AGZ05SVjMnUA-UIjDm9FAtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe-6_ZrP2xc6nAv0KvQCTNWvuJMHqZFNRs0LV7ry6yKQ&oe=6AF87B9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW73fFBCb3sQ7kNvwE6xO-_&_nc_oc=AdqNFZPJNG5VoL_YPA8PW0HqsEn2TglQWbVpl8Mik9ENl3W0GUlzo5c3GDPrKY3t1Cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTD7eaB_DibkRtf97rDTeHFbnKudSdDOk42y9fecuFzg&oe=6AF89B06"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AxNJJXHTP0Q7kNvwEHLQET&_nc_oc=AdrwMud52UhJFQl5BiI1SfJKIIfngFCasHgf1jndwjJjAOi93e_t8-87oYqF84xfCSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPud6xnX5IAtGhosTXJ-Viy2EmXUbwHl4mSQ208-Boxw&oe=6AF8A4E4"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnuW4W03TJAQ7kNvwHeQdaP&_nc_oc=Adqh4zd
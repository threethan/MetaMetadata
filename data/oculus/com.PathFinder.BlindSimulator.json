393567_605004332531566_6897404566112965238_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwYZjMly-WwQ7kNvwGekf69&_nc_oc=Adk0NKhA86hwFI8ZY-SbdR_XeWB95aMosxoU08gUtlyZHe6UhsHO93p2XILqzpgYBhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsB9lcS0KKpVfE24hw2c8LJa1BhTYfpu6Qiju4gagAmbQ&oe=69A2DDCC"}]}, "id": "665348565861089", "locale": "en_US", "screenshots": [{"file_name": "BlindSimulator_Hand.png", "id": "957802893167624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393741_957802896500957_4518928271139688772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnojHsF7MY8Q7kNvwH3TdK1&_nc_oc=AdlGkHo91aGmzGyiz2YcLiBjARY8rvPAtp7x_hxP6ORKkKnTzjlDjeH67D4-q4sNjVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvde66AyKfp8Hc-YOcfOpvW4A45THaaNOqtGNFPVOFkFg&oe=69A2D984"}, {"file_name": "BlindSimulator_Room.png", "id": "1161246895236776", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394264_1161246898570109_8736527194258045903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-j41b0bsjowQ7kNvwHKlIqq&_nc_oc=Adk5wJm4WUXPHOXMB2Pq6suEeH-OrVaXpRo-K64MKkCZnobPs9J3zoen0bs3xtkRP-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvtwXNO2ewwbjQKZcP21WDf1WeYoclZ2YvJUXpvfuTXHw&oe=69A2C564"}, {"file_name": "BlindSimulator_Crosswalk.png", "id": "1312845233302508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gXIpURTx94Q7kNvwEVapEQ&_nc_oc=AdnQkm7KGf4zt_x4RyAeh782U_XVY0Fam49IBdi6mWKmr51FHpsdD_5XIsyc6BWI1mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYeOQWAE42eRA3uxeNCEZsjyDeWGLyKh6yAlLR_-L6Jg&oe=69A2E766"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV8R0Yra_uMQ7kNvwGlJRpn&_nc_oc=AdkH_ah6KfKvO_w5AMLZkdc3RM5NogjiRS7s60uUSuGUCJbDIRX7KL8qPr2eAqGIKEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsHGcW544GmS8bw1f3sxIFgMvJLCZbRfD1MaG1XbDxubQ&oe=69A2D67E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na19_Db1JYIQ7kNvwGYJI5x&_nc_oc=Adm8hgszNDIBZ6yHIwFa88HXVH1TkWjtt8_LjMu1CUDIag7Vv4Feu8RqmGYq1y-cmUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsu7_stfXRMhNFagr3CaWTcdQQJ-L55MrI060xrb6bGYw&oe=69A2CEDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlindSimulator", "keywords": [], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blindsimula
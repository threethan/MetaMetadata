4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agYPv6wSZJwQ7kNvwHB3eqy&_nc_oc=AdryQLF-8E9EDl-bDY9HkTK02xPU5-AbFekHursSa7YR6P8PiScUvvonAOqjyowVyTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTegZc_D9MAYPcmJVHemh_hx7o0vd3sWjOkRNIhekcduA&oe=6AF742A6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-qL0mde_DwQ7kNvwFyf40v&_nc_oc=AdpGXgPS9qJaUNeUqFbUCuVCn7TqC9hnPRI9dAjDviw5roB_3ukaPgnwKq1OE6RmQp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRX5D-7Ei0nbEq5TtANX48jjpQATWHeI_Kk1EVtjOiNg&oe=6AF731BE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TmZLsy90CkQ7kNvwGfhroW&_nc_oc=AdoROEtIhOTqjvMkx--R226qqjMlMYXN7oAKFSXtWiK-7gJBro72fDusoXsfmUQfLsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB-qBPkd6KVYe84Za52fgDxFiIfVXgdo7lw3jCQ9hlmg&oe=6AF72A1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW73fFBCb3sQ7kNvwEOCLta&_nc_oc=AdqBGwQSwRDJofXUQcT0foqmlvIL3hLiQyRVfp6WD0_MwFbLV5f0zjo7wooxAHyEVl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAvcib1HsZiNoDpEPMLvBw7SbkW8ajTfss_4IabGJ9Fw&oe=6AF74986"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AxNJJXHTP0Q7kNvwG-ys1m&_nc_oc=Ado-fXNHvBDs0PxhwB9oFsKiMXQFXkxA0R6MOUzEJ74OV-wJJa9MDHh9XSk9FG_40oU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF3dNjUYZYkogcy2QW16eQuUty2Er5hsgQJu8lh3EOTQ&oe=6AF71B24"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSNwp-CNGv0Q7kNvwFHIu4f&_nc_oc=Adq4cu6
4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzvuZ69cj1oQ7kNvwGXsRl5&_nc_oc=Adqps-rze0fiKFSEGLrRi9yiguoHueJo_19yJ6jvinPEOxgWNkrOJCNilDR7xKa2lLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK7y7xeS91FY6cgdB5OdAfnL2RuRDpYIKzH_KjHjCKpw&oe=6AC642E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_v713DVAjUQ7kNvwHyI5pc&_nc_oc=AdoWr8DrDX2sVI0xFcn8PLfOEKsSIhgx5BafvN4qHk1hk1ID4FRkKIuSlA3MCP_sWTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXa4ygALnBUH2Dg6R_4fWWyDhzLXHgOgHYXmp4Ls388A&oe=6AC66A3E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SRoY7P2hgQQ7kNvwFhvLYR&_nc_oc=AdrJrU9CyVvva9qT_xm6b-NSe0SX-_vC0nN1MA5HTt59LLRkYUzYk58BKQ3uZi1GNpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf9DUbXepTA6w4Mn4e0TJUobV_ZrYgjQSC_Z1dwq9EOA&oe=6AC6629A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d90sde6gAtwQ7kNvwFnvFyN&_nc_oc=AdoRO0yvaHUhUacAqjeD89-NCeVkSvb1dldmttp2n6Hi8RDKi2Gt-tfZWWU9hsK8MuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRhHTG7aOv1ijkfTetcg3KnlW5t9XDQFT1AqjkYh5N5w&oe=6AC649C6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF9dwjNgfuAQ7kNvwEUIIVd&_nc_oc=AdrAs7As9L-BXhR8I0kW4lG2Rk_US5ggg9ZlvFFtkSZF-Cij1sxcg60NR0Nasmie17I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWHQUOfpWbZyIpvFMVC5JcIBJ2ea26msaPIpZMjZfq_g&oe=6AC653A4"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0Nj4OzJOREQ7kNvwHxuWDx&_nc_oc=AdqtP0y
AE87E6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmEMv82-pd0Q7kNvwEgmo2D&_nc_oc=AdrjShY-f_3YG-gi13-tcJg2DuB8zZrjoo5ZMBXVzzVpKf2ssLzu1fJLWouozbtvQTc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLq34v6vPhZU0E9JCM2pRw6LB2-QcYbZud5v9xs31nMQ&oe=6AAEAF3E"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2D7D3WKyHEQ7kNvwF2FFnd&_nc_oc=AdrI4Y-2tciHU6-Ep6YdcjqRLwgNj_DrzJ24QLJ2gsbpXEqJ6x2jvfRz_LIARphyQ18&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYyGYx4hMoxj7U7k7xs2QUrwMjCQQD1DPz9qSS9XKqig&oe=6AAEA79A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmyyamTs2PoQ7kNvwFykZjB&_nc_oc=AdrGUtB6CenOkLoAMqBniD_N6Y5ngB5cjYc1POASo9C5QzdwMNaIe63wktzg3dEjzXE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJho3QjvKcBf937ZIcuLN3GiWhhCGutTpIf-LtMoGixpA&oe=6AAE8EC6"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Hero_Cover_BS.png", "id": "2518919831796602", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499293144_2518919835129935_1413575938524185386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm7GEEIXwkAQ7kNvwHCGKUd&_nc_oc=Adq2bDlvYqeKbQ-PKEzmxxqHrfSnYfMHoLsiRd-3ZBMvnlizoVk2xOqqUcaaosuooFw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtow3sDuxBbdJJaem9jsBJ8UAeGrar8PsSug06kH3tkQ&oe=6AAE91E1"}, {"file_name": "Cover_Sight_BS.png", "id": "1889382115345316", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623599_1889382118678649_1627841262428749483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svSBAdYKFzgQ7kNvwEZs-TP&_nc_oc=AdoQluZJhVvU7LQ8qe8b8ZOTizziQ4lz39sTOaTpqiWa0Y8XhZa_4vj2JpsQRpX_J2Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3HMLKQXnHvwLcdTiaC3h7Urfws54KqeklXLmeMPJ3xw&oe=6AAE9131"}, {"file_name": "Logo_BS.png", "id": "1282969720083144", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn
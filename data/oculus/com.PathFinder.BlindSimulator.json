4.5771-25/473392132_1312845236635841_4691363004959173178_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7rsv_9cE4MQ7kNvwH_YvXa&_nc_oc=AdokyD7qGyzi8znxA4d8NyMqEz_d0jl9OR-dgf1_IICq1HRZheBIeV8AX9QqtA-brxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOSXB4SpM6XxtJkupSkBMMLuPmEmzrZrglilmLflIEIg&oe=6ACA6FA6"}, {"file_name": "BlindSimulator_Bus.png", "id": "1003437577895913", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391969_1003437581229246_653195394531631588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hy_aqgWpJEQ7kNvwFLYVq6&_nc_oc=AdpH1QA_stqMaYZBZP18nZkzMOPl7M2OdLwULw-zd3lnj8marOKmCw0M1Jzuv3_Rd_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcHXZgGHfp0usUtQvDObmofKuh6DMhsHYjw1ZDLxY95w&oe=6ACA5EBE"}, {"file_name": "BlindSimulator_Stair.png", "id": "4044188659173246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391885_4044188662506579_7546195151401081343_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPwf65g8-CsQ7kNvwG0k_Ql&_nc_oc=AdpPNRQoCw4kuMpTraS52_GmIU2ioqjwNrYHayXefdHkMlQp9V7JI-YCZJ6aQvEHsBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiCDYogDP3jnH1gmtUd9M9F_-_AsXc4EU7JKZypl5VVw&oe=6ACA571A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "1367209481281777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396584_1367209484615110_5666152302652103209_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O22CBo-lRn4Q7kNvwGGbV0c&_nc_oc=Adpo6mS5mebw68e2vlkoJr6-a8No2Sim_NjiUuJttgomouGr5dKvszh1FB00QoAmKno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxIUVcHVLfUzg0i-tPHIU4tgFBd5TyxkZy50ltXg-5cQ&oe=6ACA7686"}, "display_name": "BlindSimulator", "keywords": ["Blind", "Simulator", "Education", "Cane", "Experience"], "long_description": "**'Blind Simulator'** is a VR simulation game that offers a unique perspective by allowing players to experience the world as a blind person.\n\nPlayers begin the game without sight and must rely on a white cane as their only tool to explore their surroundings.\nTapping the cane on the ground creates a sonar effect, which temporarily reveals the shapes and objects in the nearby space.\n\n\n{1483889342761078}\n\n\nOn the journey to a hospital, players use public transportation such as buses and subways, and navigate crowded streets and unfamiliar environments \u2014 all within a fully virtual, safe-to-experience setting.\nThrough this process'**how to sense and understand the world without directly seeing it**'.\n\n\n{2251899381954384}\n\n\nThis game goes beyond a simple simulation \u2014 it conveys the everyday discomforts and fears faced by people with visual impairments.\nIt is designed with an educational purpose and presents a narrative-driven VR experience that resonates with players.\n\n\n{1438988117330894}\n\n\n**Start a new kind of exploration where you learn to \"see without seeing\" \u2014 using sound, vibration, and spatial awareness as your only guides.**\n\n\n{1846104142685848}", "short_description": "Experience the journey of a blind person navigating the world using only sound and touch in immersive VR."}, {"images": {"nodes": [{"file_name": "Cover_Sight_BS.png", "id": "4033268416954308", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_4033268420287641_2785436018341422265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8MjsY6JK7gQ7kNvwFnrQvt&_nc_oc=AdpakYJGemTT0bLFR3IQHrfj3LysTnhOHeP0qzhw9IScqFZjqFWcGILhqGrm_CtkEHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-53ilBontejo8FcNWj9f32Pc04RucOj4hEpuq8gBSDA&oe=6ACA4824"}, {"file_name": "Square_Cover_BS.png", "id": "1625345711494939", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392129_1625345714828272_1435062671831567458_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqDh5-v4oBcQ7kNvwEXgtM_&_nc_oc=Ado5U63
nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFTU52vxW54Q7kNvwHk4kgZ&_nc_oc=AdrmVK9SuhLDAOZ-orXtWkn3GDsgtKaBrZt-Skc2q8nMnniqkjYryUyf9__dtaKJVzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI169JNcbqBuizZ1OZLWxtLbp2F6uLysAXH7akctveHUw&oe=6AB53217"}, {"file_name": "vr-cast screen 4.png", "id": "1398405885719511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1398405889052844_5017029667778848005_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1WTxK2gvycQ7kNvwG2Ot5t&_nc_oc=Adohpvt5T-HlWTCuQFl5HypANgNJLRuxKHD6v_I5w_enB1yMw7PmBaosJgXagCqMDbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcK4PWGL8lWTEwYcSZ4mvfqw4U_xCR4iO_WT9JRrE2Lw&oe=6AB5429B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Any TV Screen Casting", "keywords": ["casting", "mirroring", "sharing", "cast", "mirror"], "long_description": "Bring your VR experience to the big screen with Any TV Screen Casting.\n\nWirelessly mirror what you see on your Meta Quest headset to most modern smart TVs and streaming devices. Let friends and family follow the action, watch gameplay, and enjoy your VR adventures together in real time.\n\nGetting started is simple:\n\n\u2022 Connect your headset and TV to the same Wi-Fi network  \n\u2022 Open the app and discover nearby screens  \n\u2022 Select your TV and start casting  \n\u2022 Continue playing while everyone watches  \n\nFeatures:\n\n\u2022 Fast wireless screen mirroring  \n\u2022 Automatic discovery of nearby TVs  \n\u2022 Adjustable video quality for smoother or sharper casting  \n\u2022 Optional system-audio mirroring  \n\u2022 Simple, headset-friendly controls  \n\u2022 No additional hardware required  \n\nWorks with select Smart TVs:\n\n\u2022 Samsung \u2014 2018 and newer  \n\u2022 LG \u2014 2018 and newer  \n\u2022 Sony \u2014 2015 and newer  \n\u2022 VIZIO \u2014 2016 and newer  \n\u2022 TCL \u2014 2017 and newer  \n\u2022 Hisense \u2014 2018 and newer  \n\u2022 Philips \u2014 2015 and newer  \n\u2022 Xiaomi \u2014 2018 and newer  \n\u2022 And many other modern Smart TVs  \n\nWhether you are playing games, exploring virtual worlds, exercising, or showing someone a new VR experience, Any TV Screen Casting makes it easy to share the moment with everyone in the room.\n\nA compatible Meta Quest headset and TV or streaming device are required. Device support and performance may vary depending on the headset, TV model, and Wi-Fi network.", "short_description": "Share your VR experience on the big screen. Any TV Screen Casting mirrors your Meta Quest view to most modern smart TVs and streaming devices. Quickly discover nearby screens, connect wirelessly, and let friends and family watch along as you play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://anytv.app/vr-cast/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Klebo Ltd", "support_website_url": null, "website_url": "https://anytv.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1188113707727037"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2997797930551701"}]}, "baseline_offer": {"id": "2997797930551701"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787167260, "status": "PUBLISHED", "id": "2997797930551701"}]}
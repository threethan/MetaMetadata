PnYQ7kNvwHqrceH&_nc_oc=AdqKR_Kd_aOePRUHx-UK7YWc5D9-T5N0bOvZ1pGNZDgYnNFFWJCH0Y0NtUQTJAdlVfE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrHUpDJabhKcxiNKy0dtZHzy6d7jOPHsnaWevGrmn3zA&oe=6AF9C2C1"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YfWuVpI4YcQ7kNvwFTzfQF&_nc_oc=Ado6Iv6epZhJJCyHhX94IYo2U3sK-yN4hWJVVqkhs-i-FK7UbnWMGVQVljXrS5DDt50&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9HQwF7F1OnRYswVFK4rPkRHwHOqjInlLLW1M2Xr1PbA&oe=6AF9E849"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hMlveNhhXwQ7kNvwEM2MOT&_nc_oc=AdqRpDcyp11aDTYXjb5-dYTheYa3Ff67XnDmuw--FeyFTcN9V-QOuMLHPloAmhkxbSA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIp9MUGZpqHqlDZNoggxI4wUM2IrzfUc921Ap5bQCEeA&oe=6AF9DA4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exTL6Cif4RwQ7kNvwERT30X&_nc_oc=AdraQC4SlJ8hrGXookd-CXd65T6zssI6XeKxw8cU53Wk3eBU22RcckpPY9_1hwEL_2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT55fwu2y3Om49sSi3oR_mqkfP9wKduIeG7qi9x8ccSIA&oe=6AF9D9AE"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed environment. This experience is a testament to ArchViz and 3D Visualization capability that Mixeal offers to its clients. Immerse yourself in high-quality visuals with fun hand-tracking interactions that makes you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. \n\n\ud83c\udf81 **EXCLUSIVE OFFER:** Discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\n\n{1612148679463250}\n\nSeamless **hand tracking** for immersive experience\n\n{1246325803733399}\n\nWalkthroughs made easy with seamless **spectator web app**\n\n{1608383426445800}\n\nSmooth **locomotion** using your fingers\n\n{1375551060140328}\n\nJust **clap** and change floor material and wall color\n\n{2324740284589940}\n\nExperience near-to-life **object interaction**\n\n{700393122468055}\n\nRoam around environment with **realistic quality**\n\n{1184578016409016}\n\n**Download now** and interact with the coziest space, enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset!", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
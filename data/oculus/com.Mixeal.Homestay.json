AeHxX18rdsQ7kNvwEJN6aM&_nc_oc=Adr5NK0Dzby3pRLBJbX-kzDgeXiCrV5VfttBX61BYYZa9yvIgz5-iLmlk4Ymiyns0Zg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0KmF-zot9caYG5a9y4Or7I-0Dsi1Ooh1_Kre2dTs8cQ&oe=6A4676C1"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW9d6pOf9h4Q7kNvwHDt5Jp&_nc_oc=AdrL4bBBtO0tnY-36JmCAWSQYznhjlbnzuFTirsUbbyYEq8i6XwpxghlxbBFCouMml8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97V1YMNNByDKbP7GKRSxHt-drTY0gp5uOiMBoued8yIQ&oe=6A466409"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoPbnE306TYQ7kNvwFNrgHa&_nc_oc=AdqZT8G6UZGIDFIBiSEbm2wUtt3kAfz_95JAxwMWE9tLNpw-y9a801Xh1s2wiW3ObDE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BlxaoKuiJqwYvVcIScG7Mdp8rwU7fyqse_H5a0SeZFg&oe=6A468E4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZbHN72LZKQQ7kNvwH8B-tj&_nc_oc=Adrzlb2E9dW7mNCQdMGGPP6CZQS4hN2Fs8LcLhFWNw5t3GwANkOSVj8WLz5vxuO5pps&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BDL8_ch3nRdvv2XaMWKphQATP7oMoZmFjCJ5T7wpijQ&oe=6A468DAE"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed environment. This experience is a testament to ArchViz and 3D Visualization capability that Mixeal offers to its clients. Immerse yourself in high-quality visuals with fun hand-tracking interactions that makes you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. \n\n\ud83c\udf81 **EXCLUSIVE OFFER:** Discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\n\n{1612148679463250}\n\nSeamless **hand tracking** for immersive experience\n\n{1246325803733399}\n\nWalkthroughs made easy with seamless **spectator web app**\n\n{1608383426445800}\n\nSmooth **locomotion** using your fingers\n\n{1375551060140328}\n\nJust **clap** and change floor material and wall color\n\n{2324740284589940}\n\nExperience near-to-life **object interaction**\n\n{700393122468055}\n\nRoam around environment with **realistic quality**\n\n{1184578016409016}\n\n**Download now** and interact with the coziest space, enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset!", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
=q3SXr2cNnw8Q7kNvwE7fy6X&_nc_oc=AdmdubCMdny0rbGcsRgbySKGOsQB_Hq21y3CSxSVjcYVhykEicfQMB6ct2BXKfdgSOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs0o6i6tq8EZdC_QJUZm_XmRWUGMSGSzoLaLsX8ekeZTQ&oe=69A6DE89"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igbD6xX2_tcQ7kNvwECCL43&_nc_oc=Adloiz5u5hF33ytlzgYararSnRn9KyFUhgJ8y1GLR2x_BPHD5patNMzmfmF1skzlU3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCww1sI6p4zRoXy9zrXZqoM2hGUcTVhnlcHLzQ9zOxNg&oe=69A6D08F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=appSfoG_aGIQ7kNvwF_KJ4B&_nc_oc=AdkYXhRcjfxsk1J_z3BLdTOXoF5XhjX1APorwriHD88YGOQIvQQynWHYgRiUiZe64Qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBn5OuxdBD9QjQpPB4w7PVNb9puIqxOSAY00EEI_Yedw&oe=69A6CFEE"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed homestay environment. Designed to showcase Mixeal\u2019s VR architecture visualization services, this app brings high-quality visuals and fun hand-tracking interactions to life, making you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. Plus, discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\nStep inside, interact with the space, and enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset.", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9241974782532420"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2005176499988550"}]}, "baseline_offer": {"id": "2005176499988550"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736314200, "status": "PUBLISHED", "id": "2005176499988550"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9984965311566693", "version": "1.0"}, "id": "852384573678717", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8669184929811411", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinar
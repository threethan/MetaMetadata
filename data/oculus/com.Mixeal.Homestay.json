k5NthB_nOE3PXX4x2NUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW7TJ_BbyCm1xlycW2Tbopb5fDql8X8SwbCQzuHxhJPA&oe=6A6377C1"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ya72qYcl2MQ7kNvwFNTcsI&_nc_oc=AdqLKedlD-_YNgdtd1P3UYzMjkvV2jVvg3zfadlf6zGFLAicuhIswPflgpy2fW7LcPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtCAoBNjS2WZ7eCRGhxWTiecZXr9CXIf_EAOw03FDCcw&oe=6A636509"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZINJXu9GEJAQ7kNvwF6CNhU&_nc_oc=Adrfj3y7VxFjl-zBERfzRPCvZq9qlrcik2O3sLdMYjMLy8VqjWE4Vv_rtae1QO2QEUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv94QTe6qLHQxioyTf2_ui2FiXOF3U917Gyvfy1iqXmg&oe=6A63570F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdOuyrtzYe0Q7kNvwFUJSLf&_nc_oc=AdoqioC9RbX2jVmmjuq4UxUBuapstN9JAUSUgQVRFmgvxHIUlIurJ6kbnzoRa9WCOUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXoae5G2pfM5-NiC4KRufp6_NmKlSY7mK2_NxS-nMWKg&oe=6A63566E"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed homestay environment. Designed to showcase Mixeal\u2019s VR architecture visualization services, this app brings high-quality visuals and fun hand-tracking interactions to life, making you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. Plus, discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\nStep inside, interact with the space, and enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset.", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9241974782532420"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2005176499988550"}]}, "baseline_offer": {"id": "2005176499988550"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736314200, "status": "PUBLISHED", "id": "2005176499988550"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"node
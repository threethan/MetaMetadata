0HkQ7kNvwH5F99t&_nc_oc=AdppTM3NG-GzDHbBg0_FYFSxhQZbieAupd85V9qvt9111mZxKpIxJl7os2zSgM8rZv0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiqyq0g5FzCQLEKlDuHmp-UlneESmQnz9o3p18jhCM5w&oe=6AD38741"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTEuf40YcuAQ7kNvwFoqlgj&_nc_oc=AdrKzSUwW1ZY4Oq9zqW6Lv3Bj_IcZargEYnsfUPH9G8rJmvRsNLV_UmwQBJxyuTQCCM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-FK3hhzRXStRz1j4-J8TdM3B3xJzWQkvgftiMdjFyeg&oe=6AD3ACC9"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0Dt7O86VBwQ7kNvwGO1BbL&_nc_oc=AdocDUme_17ij08c95PwetWzjB8t1hLVgLR1_pRs27yfSC_dPb7NARW-pOaCX0CGwFI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8ZcbjwVTEI_1A38eCk08DUrK9HwtuyT7o5gecxbsB4g&oe=6AD39ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AY9_lv4e1kQ7kNvwGFDqqY&_nc_oc=Adp7-BRxAU91Dx3c3xXlGy-INPzyYutBiWwaifYhMOHMs7zQkwuYFCaP-ejPiNIu-cE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHfz6XupI-KjKILFV6a5kn_RJExSFHJNkSt6GZ1Pluug&oe=6AD39E2E"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed environment. This experience is a testament to ArchViz and 3D Visualization capability that Mixeal offers to its clients. Immerse yourself in high-quality visuals with fun hand-tracking interactions that makes you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. \n\n\ud83c\udf81 **EXCLUSIVE OFFER:** Discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\n\n{1612148679463250}\n\nSeamless **hand tracking** for immersive experience\n\n{1246325803733399}\n\nWalkthroughs made easy with seamless **spectator web app**\n\n{1608383426445800}\n\nSmooth **locomotion** using your fingers\n\n{1375551060140328}\n\nJust **clap** and change floor material and wall color\n\n{2324740284589940}\n\nExperience near-to-life **object interaction**\n\n{700393122468055}\n\nRoam around environment with **realistic quality**\n\n{1184578016409016}\n\n**Download now** and interact with the coziest space, enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset!", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
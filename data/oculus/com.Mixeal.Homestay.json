oZkQ7kNvwGKRIF6&_nc_oc=Adr-qyayiA6rtLs-kWhxW-UuRxBtPl6kVt8hfRjL9WCw2gEPo_Gd-dJ7HhcWVhC3Ay8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxtNkSspNpoYeD7uVWbiUc7SpfIW5EwO0meDc60u6JwA&oe=6A9D79C1"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJSneCAm3R4Q7kNvwFl1Peo&_nc_oc=AdoM5Mqq5HYkV2C4JiUeRnwZhNZ3FBn2GYai3U3CcH5EC-Dlf6n21M-hWw8Qxu13Dh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIoZ6ECUoK5NLM5D65WhhI1SW0Q4xbNhjVOzi4pVtRVw&oe=6A9D6709"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqNkHtSv7g0Q7kNvwG604gx&_nc_oc=Adr7CYT5-Pifi_prYMndBdScwR1eT5PtoZFyW93xS7BO6VJiLpjM3P2s0a_PIZ1y2OI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9c4E8ardrqmOkzVum4yaV9mZ9UEb3kRWBEwYhijS89Q&oe=6A9D590F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBkIhhY9FS8Q7kNvwGk7ldL&_nc_oc=Ado_YaYH141V9BqWLUS-aIjz_UdSgLFdd3bCtjdOMPENkwmPjMvqgO6It6li46vBVY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7qQSGEmTXxNDLx7l_-AoRXsUhcvhTUq-iDF-LSVpwzA&oe=6A9D586E"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed environment. This experience is a testament to ArchViz and 3D Visualization capability that Mixeal offers to its clients. Immerse yourself in high-quality visuals with fun hand-tracking interactions that makes you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. \n\n\ud83c\udf81 **EXCLUSIVE OFFER:** Discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\n\n{1612148679463250}\n\nSeamless **hand tracking** for immersive experience\n\n{1246325803733399}\n\nWalkthroughs made easy with seamless **spectator web app**\n\n{1608383426445800}\n\nSmooth **locomotion** using your fingers\n\n{1375551060140328}\n\nJust **clap** and change floor material and wall color\n\n{2324740284589940}\n\nExperience near-to-life **object interaction**\n\n{700393122468055}\n\nRoam around environment with **realistic quality**\n\n{1184578016409016}\n\n**Download now** and interact with the coziest space, enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset!", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
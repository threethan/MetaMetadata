d5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy8ohdSl7NqBPFnBkzz9t7w7XlWkEyMbTpUw2ZFCTKvQ&oe=6AFDCFF4"}, {"file_name": "ss2.png", "id": "516498581313048", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_516498587979714_5948376444477011808_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYvNpGjbWxYQ7kNvwHeF1pF&_nc_oc=Ado4Vah_2RZFK1Ja6LyPSkPP6eNShSvA2fX5qBtOX1P6RRH5l8h77GPa_bW97wH6xt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRsstfPQA_lBn_jB6KBJ2vQkYov2LrVcIbMvni5-uicg&oe=6AFDB741"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwCd6tG06sgQ7kNvwEIPKze&_nc_oc=AdrxYI6YvfvcsMKwXL9g6VKsuD1S5k2ry-aBFjsdTUb9-dKQ-MnChYkNJcDjFKxRpW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy5uIL06Cj6cPWorxam86cadJHEFiYw8LQhbXVUd3RvA&oe=6AFDDCC9"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsb0P-bAOE8Q7kNvwG7fTwq&_nc_oc=AdoJEQ1Pk6CPn-X6vzxfALV0My27xfK9Np-4bDR_WW6itKflSaL99b0fZTOrz5VwOlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSamVeTSzF9HQfhVY8w_ocfUIjMSr54uDsgktt-1IpeFg&oe=6AFDCECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_D4-OheUiYQ7kNvwGyi-iY&_nc_oc=Adp5Tpn72rhUPYivI7TPdlXqDhqIdpGDr4Q_pxA0by8y0t5V5E9QPHqJwuVqWTix5sA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKI3jBocPDaJwSBr6rEivxkA6LKw7kmrS3Z7-OIb5ywQ&oe=6AFDCE2E"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed environment. This experience is a testament to ArchViz and 3D Visualization capability that Mixeal offers to its clients. Immerse yourself in high-quality visuals with fun hand-tracking interactions that makes you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. \n\n\ud83c\udf81 **EXCLUSIVE OFFER:** Discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\n\n{1612148679463250}\n\nSeamless **hand tracking** for immersive experience\n\n{1246325803733399}\n\nWalkthroughs made easy with seamless **spectator web app**\n\n{1608383426445800}\n\nSmooth **locomotion** using your fingers\n\n{1375551060140328}\n\nJust **clap** and change floor material and wall color\n\n{2324740284589940}\n\nExperience near-to-life **object interaction**\n\n{700393122468055}\n\nRoam around environment with **realistic quality**\n\n{1184578016409016}\n\n**Download now** and interact with the coziest space, enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset!", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
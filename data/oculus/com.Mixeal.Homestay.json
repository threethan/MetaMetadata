d3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR93wsWkFGX_JbFlOptqczPhzjAAniPYF5EMXbjCS4U-A&oe=6B05B8F4"}, {"file_name": "ss2.png", "id": "516498581313048", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974804_516498587979714_5948376444477011808_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CheFh9oBR9UQ7kNvwE1CsO3&_nc_oc=Ado7mH3UtbGnIgHorNjhbFa0h1U2wcDSFM88J4iTb1EyupvBXD7SWaL4C_kYOVnbw9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9tQXBbR2ns9fDqhfk_9cdn3fD--rymUNHjQ1Qz7_IMA&oe=6B05D881"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfuVRCGAvB8Q7kNvwFJMLvK&_nc_oc=AdpraghqpfD1H1QMQOYWFODRV4u0rY094PG-p0c3MIw23LTm1COHOpqBgH2DbBua_V8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeuwnxi8b2LAAbXw0gNLNMOFBCHoODbPDcXK0H3D3-0Q&oe=6B05C5C9"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIhE6lWG44IQ7kNvwFrt4QA&_nc_oc=AdpiRkcAYpKVkAKxCOwpP767ZvgK_Xk5RE7CtwXqvb1-nYD-3jSZyrDL0QZLTVyMyT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRtMHNz3uVPkDzUevQNxw8mcawwku0HSAtbGXFAJDOIg&oe=6B05B7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev9CHvtjnz8Q7kNvwEANTvd&_nc_oc=AdqLw98ZwLxMIsak0DkVQI1hvHj2av6wKX5lFHGiscxdDkiiMb0KHazY-eUYWLfbr5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrdaX3j_ClqN5Tndq_xvOcy_1_q6m-SJCkI2x3PCuM9w&oe=6B05B72E"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed environment. This experience is a testament to ArchViz and 3D Visualization capability that Mixeal offers to its clients. Immerse yourself in high-quality visuals with fun hand-tracking interactions that makes you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. \n\n\ud83c\udf81 **EXCLUSIVE OFFER:** Discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\n\n{1612148679463250}\n\nSeamless **hand tracking** for immersive experience\n\n{1246325803733399}\n\nWalkthroughs made easy with seamless **spectator web app**\n\n{1608383426445800}\n\nSmooth **locomotion** using your fingers\n\n{1375551060140328}\n\nJust **clap** and change floor material and wall color\n\n{2324740284589940}\n\nExperience near-to-life **object interaction**\n\n{700393122468055}\n\nRoam around environment with **realistic quality**\n\n{1184578016409016}\n\n**Download now** and interact with the coziest space, enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset!", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
2nHXmoKTSNPQQFeBpuo4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OIUTMIhyfmGgA0GuIJrJ0t19hBfntScI2kmMNVtcYfw&oe=6A26D2C1"}, {"file_name": "ss3.png", "id": "892753895704311", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982535_892753899037644_3377441545302561412_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljfNRpZactsQ7kNvwHyDAb3&_nc_oc=AdqN8Cb6VhSXnOa0otUrbui95wijVePmqBzZoxYyGWi8DCE8PWPkhNTrFmGJoIa7ynA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af978uw7jte-7fVgISSJRlkF0CrpIbCYSl7q6lnxDRBe7w&oe=6A26C009"}, {"file_name": "ss4.png", "id": "522459217157698", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462955_522459220491031_8342661140654831305_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbwZk3AO-ZEQ7kNvwFlUluW&_nc_oc=Adqw_9BJZihBSjpyYcXnPyQCeIqoYqF26oOr8J7zy6De9oaPXviLJ6RIUej6ZyA8ntw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mkCaTK20silizGyrL4tdWOHeRRMOpGeKOm6ogxQB_YQ&oe=6A26EA4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover homestay.png", "id": "547596661158685", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982484_547596664492018_5818219077722566481_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKmulJUucV0Q7kNvwHs-FhK&_nc_oc=AdpfR9ztsmyoHBSKwlBKJ6LKZfJ-H-wNlsgwhvFkbctYPwoYkjDSmfxWD9CD15qimgg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sBm8w8lLEJlpZr1DvbQ2SilYj1V09RDbinlNgZbmGZA&oe=6A26E9AE"}, "display_name": "Homestay by Mixeal", "keywords": ["Archviz", "Architecture", "Rendering", "VRArchviz", "Walkthrough"], "long_description": "Homestay by Mixeal offers an immersive virtual experience where you can explore a stunningly detailed homestay environment. Designed to showcase Mixeal\u2019s VR architecture visualization services, this app brings high-quality visuals and fun hand-tracking interactions to life, making you feel right at home.\n\nWhether you're walking through the cozy interiors or interacting with objects, the experience is seamless and engaging. Plus, discover an exclusive promo for Final Overs, Mixeal\u2019s VR cricket game, right within the app!\n\nStep inside, interact with the space, and enjoy an innovative blend of home design and virtual reality, all from the comfort of your own VR headset.", "short_description": "Step into Homestay by Mixeal, a beautifully crafted virtual homestay environment where you can explore detailed interiors and interact with objects using hand-tracking. Discover a seamless blend of design and technology, and unlock a special discount for Final Overs, Mixeal's exciting VR cricket game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9241974782532420"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2005176499988550"}]}, "baseline_offer": {"id": "2005176499988550"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736314200, "status": "PUBLISHED", "id": "2005176499988550"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"node
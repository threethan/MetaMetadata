 "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1468825691308752"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Store Cover.png", "id": "2347312622447736", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_2347312629114402_7974261389251626760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFAOmPFJIEUQ7kNvwGIvY_N&_nc_oc=AdpOCHd7LL3z7KSk_klfx0Jwnl1gIM60GGLhnoicqarFkGQo46noONz9TGY6aEiJM2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72ggkwv_CZFE0M2PNBqINlFwa22M_7a-05mswHK_bj1A&oe=6A088A1A"}, {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 4.png", "id": "2346368882551533", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_2346368885884866_4942496064935799891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2ok8_0AxaIQ7kNvwEvW7Kx&_nc_oc=Ado_QMehV_LXoIOsWpff3xKPt_JBbdquh0yQTvuYWOp6mFuY1BcswiIMz6jfCBaJS1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e2bZHq2BSOJesrtZrWbXzAxzAwiUbqjMmCmZtAQIE2w&oe=6A087872"}, {"file_name": "icon.png", "id": "2115976462513509", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_2115976469180175_5614362734201766134_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6zjp4eB624Q7kNvwGvUoaO&_nc_oc=AdoqX_si3MdkIVR9fiEszUs0AArXA24SUCpDVWbw0XA7ytF_NpKqUgr4rOjQVzpWrro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af525puMbZJ6oxAsuJBnH9k89ar5SqV8kHKp2pKsl0WBdQ&oe=6A087388"}, {"file_name": "\u30a2\u30fc\u30c8\u30dc\u30fc\u30c9 5.png", "id": "1909854952968246", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_1909854959634912_563670856664267756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDMB7sCMpXYQ7kNvwFgTAYW&_nc_oc=Ado-rehtp9yWOH2iMt2uyImSXpPodSgrREc95dNi5asF6Y3i5nV61wNsoLcmSxUCXyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ANGck3B9q5MCNULdq0cuzSPausGi_b0GHBuCpFek8qg&oe=6A087C1A"}, {"file_name": "tate.png", "id": "912312538277765", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_912312541611098_4949307920241121869_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2brbm_BhPAQ7kNvwGshbzp&_nc_oc=Ado0N6xBXebuVyPMzD58JOXpoxvKFvzwtqXfUCqD2ryCrUi99X_DWwD1am2L-4QwN3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RxEcnN2ZbMJfQaQKrOlCoyEN1v2N1xk0Mb5W9g_YTMg&oe=6A087BC0"}]}, "id": "1746493479664655", "locale": "en_US", "screenshots": [{"file_name": "\u2b50\ufe0e\u2b50\ufe0e\u30b7\u30fc\u30b1\u30f3\u30b9 02.00_04_05_19.png", "id": "1822830145057178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618938_1822830148390511_8387805958760188140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOIUIbK1cB0Q7kNvwGhIltj&_nc_oc=AdoiKZKF7wY574dw20OKIw1d5D3DqWRlIt3UUjH5XSDUPRJ-uGzeVNBx_8AoG5PCMWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QM0W_nGYix4SoQdWD2ARj7k6SJxwdkgotg0Ffa42qcw&oe=6A086869"}, {"file_name": "\u2b50\ufe0e\u2b50\ufe0e\u30b7\u30fc\u30b1\u30f3\u30b9 02.00_04_09_08.\u9759\u6b62\u753b018.png", "id": "2229893447414471", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_2229893450747804_5930125044827348519_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Mnw_0mYxsQ7kNvwEvoHvx&_nc_oc=Ado_tV1QHrRYbrGlCnjkUie64IhZYbyGtrhfnpWdU65czC6E8u0u2e9ZnGLt70Bqv5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5voiTLARO2Q2XQpyhhzUhw8f6o57yVR8XDevssygyj8g&oe=6A08900E"}, {"file_name": "\u2b50\ufe0e\u2b50\ufe0e\u30b7\u30fc\u30b1\u30f3\u30b9 01.00_05_18_08.png", "id": "2316234145538840", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_2316234148872173_3148671895050698773_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhZ9YI-osUAQ7kNvwG4vo36&_nc_oc=AdqxyblL1qCXMTm_cBhlEjcK8Q8kOsFTCwfhAFtTXdb9V7mgcIusKUJTZFtqVeIG1ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59okXHpWys2WCA6Dt91YiaK5Ybz_7iYN3FGZtwZkj-VQ&oe=6A089358"}, {"file_name": "\u2b50\ufe0e\u2b50\ufe0e\u30b7\u30fc\u30b1\u30f3\u30b9 02.00_10_00_01.\u9759\u6b62\u753b011.png", "id": "948420094258807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_948420097592140_6800166696459121182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiGnnwQthTEQ7kNvwE1UhzX&_nc_oc=AdrCqlM8IKuPjne0rkntuoDpfXpSqSgsqTSHO4SEQCH1OVICOM61cWNiushLE4qmgVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47pTim07oiEZzqYK-2tPjG8wFXYxW4bDtrk-jMtPqgYw&oe=6A088544"}, {"file_name": "\u2b50\ufe0e\u2b50\ufe0e\u30b7\u30fc\u30b1\u30f3\u30b9 02.00_04_05_19.\u9759\u6b62\u753b017.png", "id": "1543972903366657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308330_1543972906699990_3999552112831215925_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NISYwmZQe3QQ7kNvwE1jODL&_nc_oc=Adop7YgDW_NuODhsjaQIJ5AhaRYv-P5ZbBsgRn3h4GSHOphJxrc40cbZjeijASu5oDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77NOVnzVs8BE6wG0Q1wBkrhlelB3uo_IcJqS_PQzgW3g&oe=6A0879FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TableTopTank", "keywords": ["Tank", "Machine", "Robot", "Bot", "Battle"], "long_description": "# Overview\n\n**TableTopTank** is a spatial-invasion sci-fi MR/VR action game where your everyday space becomes the battlefield. Your room\u2014table, lighting blind spots, and floor boundaries\u2014is dynamically overwritten into a warzone, blending reality and digital threats.\n\n# Story\n\nIn 2045, the year of singularity, the Mars-born machine lifeforms known as the **\u201cOlympus Network\u201d** invade Earth to seize its vast **\u201cphysical simulation data.\u201d** Humanity hacks a captured prototype and finds a weakness in older models.\n\nYou remotely control the outdated unit **\u201cKasai Link,\u201d** infiltrating enemy systems from within. Using this fragile machine, you fight to shut down the core AI behind the invasion.\n\n# Enemy Forces\n\n- **Tharsis**: Swarming small tanks  \n- **Phobos Flyer**: Drones attacking from blind spots  \n- **Hellas Gigant**: Heavy tanks that crush real objects  \n- **Marineris**: Elite unit that distorts space and opens abysses  \n- **Arsia Core**: Central AI  \n- **Nix Olympia**: Final form that overwrites your entire room  \n\n# Gameplay\n\nYour key system is the **\u201cSync Rate.\u201d** As it improves, control becomes smoother and your unit evolves.\n\nFight directly within your real space, using positioning and awareness. Customize your loadout with modules dropped by enemies to adapt your strategy.\n\n# Core Experience\n\nExperience the collapse of reality and digital space. Your desk becomes a battlefield, and everyday objects turn into cover or threats\u2014your world is no longer safe.", "short_description": "In 2045, the \u201cOlympus Network,\u201d a mechanical lifeform from Mars, invades Earth to seize its \u201cphysical simulation data.\u201d You remotely control the stolen prototype \u201cKasai Link\u201d and fight on the table in your own room in a \u201creality-invading sci-fi\u201d MR/VR action experience. Drones strike from blind spots, tanks smash real objects, and elite units turn your floor into an abyss\u2014your everyday space becomes the battlefield.\n"}, {"images": {"nodes": []}, "id": "1524346066361966", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TableTopTank", "keywords": [], "long_description": "# \u6982\u8981\n\n**\u300eTableTopTank\u300f** \u306f\u3001\u706b\u661f\u7531\u6765\u306e\u6a5f\u68b0\u751f\u547d\u4f53\u306b\u3088\u3063\u3066\u201c\u65e5\u5e38\u7a7a\u9593\u201d\u304c\u4fb5\u98df\u3055\u308c\u3066\u3044\u304f\u3001**\u7a7a\u9593\u4fb5\u98df\u578bSF** \u306eMR/VR\u30a2\u30af\u30b7\u30e7\u30f3\u3067\u3059\u3002\u821e\u53f0\u306f\u3042\u306a\u305f\u306e\u90e8\u5c4b\u3002\u30c6\u30fc\u30d6\u30eb\u306e\u4e0a\u3001\u7167\u660e\u306e\u6b7b\u89d2\u3001\u5e8a\u306e\u5883\u754c\u2015\u2015\u3044\u3064\u3082\u306e\u751f\u6d3b\u7a7a\u9593\u304c\u3001\u6226\u5834\u3068\u3057\u3066\u4e0a\u66f8\u304d\u3055\u308c\u307e\u3059\u3002\n\n# \u30b9\u30c8\u30fc\u30ea\u30fc\n\n2045\u5e74\u3001\u30b7\u30f3\u30ae\u30e5\u30e9\u30ea\u30c6\u30a3\u306e\u5e74\u3002\u30a8\u30b8\u30d7\u30c8\u306e\u7891\u6587\u304c\u4e88\u8a00\u3057\u305f\u901a\u308a\u3001\u706b\u661f\u3088\u308a\u6a5f\u68b0\u751f\u547d\u4f53\u7fa4 **\u300c\u30aa\u30ea\u30f3\u30dd\u30b9\u30fb\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u300d** \u304c\u5730\u7403\u3078\u98db\u6765\u3002\u5f7c\u3089\u306e\u76ee\u7684\u306f\u8cc7\u6e90\u3067\u306f\u306a\u304f\u3001\u5730\u7403\u304c\u6301\u3064\u81a8\u5927\u306a **\u300c\u7269\u7406\u6f14\u7b97\u30c7\u30fc\u30bf\u300d** \u306e\u5f37\u596a\u3002  \n\n\u4eba\u985e\u5074\u306f\u6575\u306e\u30d7\u30ed\u30c8\u30bf\u30a4\u30d7\u6a5f\u3092\u30cf\u30c3\u30ad\u30f3\u30b0\u3059\u308b\u3053\u3068\u306b\u6210\u529f\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u304c\u9060\u9694\u64cd\u4f5c\uff08\u30ea\u30e2\u30fc\u30c8\u30fb\u30ea\u30f3\u30af\uff09\u3059\u308b\u306e\u306f\u3001\u65e7\u578b\u3086\u3048\u306b\u552f\u4e00\u652f\u914d\u3067\u304d\u305f\u4e00\u53f0\u2015\u2015**\u300c\u30ab\u30b5\u30a4\u30fb\u30ea\u30f3\u30af\u300d**\u3002\u6700\u65b0\u6a5f\u306b\u306f\u901a\u7528\u3057\u306a\u3044\u30cf\u30c3\u30ad\u30f3\u30b0\u3092\u3001\u8106\u304f\u53e4\u3044\u6a5f\u4f53\u3067\u201c\u5185\u90e8\u304b\u3089\u201d\u901a\u3057\u3001\u6575\u306e\u6bcd\u4f53AI\u3092\u30b7\u30e3\u30c3\u30c8\u30c0\u30a6\u30f3\u3059\u308b\u305f\u3081\u306b\u6226\u3044\u307e\u3059\u3002\n\n# \u6575\u52e2\u529b\uff08\u706b\u661f\u7531\u6765\u306e\u540d\u79f0\uff09\n\n- **\u30bf\u30eb\u30b7\u30b9\uff08Tharsis\uff09**\uff1a\u7fa4\u308c\u3067\u6bb5\u5dee\u3092\u8d8a\u3048\u3066\u304f\u308b\u91cf\u7523\u578b\u5c0f\u578b\u6226\u8eca\n- **\u30d5\u30a9\u30dc\u30b9\u30fb\u30d5\u30e9\u30a4\u30e4\u30fc\uff08Phobos Flyer\uff09**\uff1a\u7167\u660e\u306e\u6b7b\u89d2\u304b\u3089\u5947\u8972\u3059\u308b\u30c9\u30ed\u30fc\u30f3\n- **\u30d8\u30e9\u30b9\u30fb\u30ae\u30ac\u30f3\u30c8\uff08Hellas Gigant\uff09**\uff1a\u91cd\u88c5\u7532\u3067\u73fe\u5b9f\u306e\u5c0f\u7269\u3092\u201c\u8e0f\u307f\u6f70\u3059\u201d\u5927\u578b\u6226\u8eca\n- **\u30de\u30ea\u30cd\u30ea\u30b9\uff08Marineris\uff09**\uff1a\u7a7a\u9593\u3092\u5207\u308a\u88c2\u304d\u3001\u5e8a\u3092\u5948\u843d\u3078\u5909\u3048\u308b\u5e79\u90e8\u6a5f\n- **\u30a2\u30eb\u30b7\u30a2\u30fb\u30b3\u30a2\uff08Arsia Core\uff09**\uff1a\u5168\u6f14\u7b97\u3092\u53f8\u308b\u6bcd\u4f53AI\n- **\u30cb\u30af\u30b9\u30fb\u30aa\u30ea\u30f3\u30d4\u30a2\uff08Nix Olympia\uff09**\uff1a\u90e8\u5c4b\u5168\u4f53\u3092\u706b\u661f\u306e\u7802\u6f20\u3078\u3068\u4e0a\u66f8\u304d\u3059\u308b\u6700\u7d42\u5f62\u614b\n\n# \u904a\u3073\n\n\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9375\u306f\u3001\u65e7\u578b\u6a5f\u306a\u3089\u3067\u306f\u306e **\u300c\u540c\u671f\u7387\uff08\u30b7\u30f3\u30af\u30ed\u30fb\u30ec\u30fc\u30c8\uff09\u300d** \u3002\u6210\u9577\u306b\u3088\u308a\u64cd\u4f5c\u306e\u30e9\u30b0\u304c\u89e3\u6d88\u3055\u308c\u3001\u6a5f\u4f53\u5916\u89b3\u3082\u9032\u5316\u3002  \n\n\u3055\u3089\u306b\u6575\u304b\u3089\u30c9\u30ed\u30c3\u30d7\u3059\u308b\u30e2\u30b8\u30e5\u30fc\u30eb\u3067\u88c5\u5099\u3092\u62e1\u5f35\u3057\u3001\u72b6\u6cc1\u306b\u5fdc\u3058\u305f\u6226\u3044\u65b9\u3092\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002\n\n# \u4f53\u9a13\u306e\u6838\n\n**\u73fe\u5b9f\u3068\u30c7\u30b8\u30bf\u30eb\u306e\u5883\u754c\u304c\u5d29\u308c\u308b\u77ac\u9593**\u3092\u3001\u3042\u306a\u305f\u306e\u90e8\u5c4b\u3067\u3002  \n\n\u3044\u3064\u3082\u306e\u673a\u304c\u6226\u5834\u306b\u5909\u308f\u308a\u3001\u898b\u6163\u308c\u305f\u5c0f\u7269\u304c\u906e\u853d\u7269\u3084\u8105\u5a01\u306b\u306a\u308b\u2015\u2015\u201c\u65e5\u5e38\u304c\u4fb5\u98df\u3055\u308c\u308bSF\u201d\u3092\u3001\u6ca1\u5165\u611f\u3068\u7dca\u5f35\u611f\u3067\u4f53\u9a13\u3057\u3066\u304f\u3060\u3055\u3044\u3002", "short_description": "2045\u5e74\u3001\u706b\u661f\u304b\u3089\u98db\u6765\u3057\u305f\u6a5f\u68b0\u751f\u547d\u4f53\u300c\u30aa\u30ea\u30f3\u30dd\u30b9\u30fb\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u300d\u304c\u5730\u7403\u306e\u201c\u7269\u7406\u6f14\u7b97\u30c7\u30fc\u30bf\u201d\u3092\u596a\u3044\u306b\u8972\u6765\u3002\n\u3042\u306a\u305f\u306f\u5929\u624d\u30cf\u30c3\u30ab\u30fc\u96c6\u56e3\u304c\u596a\u53d6\u3057\u305f\u65e7\u578b\u30d7\u30ed\u30c8\u30bf\u30a4\u30d7\u6a5f\u300c\u30ab\u30b5\u30a4\u30fb\u30ea\u30f3\u30af\u300d\u3092\u9060\u9694\u64cd\u4f5c\u3057\u3001\u81ea\u5ba4\u306e\u30c6\u30fc\u30d6\u30eb\u4e0a\u3067\u6226\u3046\u201c\u65e5\u5e38\u4fb5\u98df\u578bSF\u201d\u306eMR/VR\u30a2\u30af\u30b7\u30e7\u30f3\u306b\u8eab\u3092\u6295\u3058\u308b\u3002\n\u7167\u660e\u306e\u6b7b\u89d2\u304b\u3089\u8972\u3046\u30c9\u30ed\u30fc\u30f3\u3001\u73fe\u5b9f\u306e\u30b3\u30c3\u30d7\u3092\u7c89\u7815\u3059\u308b\u91cd\u88c5\u7532\u6226\u8eca\u3001\u5e8a\u3092\u5948\u843d\u3078\u5909\u3048\u308b\u5e79\u90e8\u6a5f\u2015\u2015\u73fe\u5b9f\u7a7a\u9593\u305d\u306e\u3082\u306e\u304c\u6226\u5834\u306b\u4e0a\u66f8\u304d\u3055\u308c\u308b\u7dca\u5f35\u611f\u3092\u4f53\u9a13\u305b\u3088\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://characterbank.atlassian.net/wiki/external/MWE4NWM2ZTFhNWVmNDQzYjlhZGE4NzczOGMzMDI5NDE", "developer_terms_of_service_url": "https://characterbank.atlassian.net/wiki/external/NzU2ZTljMjA2YTllNDNiMWJiNWJmOTYxODVjNWE2Njk", "publisher_name": "TV Asahi Corporation, CharacterBank Inc.", "support_website_url": null, "website_url": "https://character-bank.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1676485315806614"}, {"id": "3744040075834813"}
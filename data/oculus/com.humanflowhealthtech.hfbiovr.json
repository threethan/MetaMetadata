277752927495072_5270904344691988134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoLUF6Kb8D4Q7kNvwEabIer&_nc_oc=AdpG4HiYYvyPqihwovTXhdWYgyWrgr0DSMsZzJqd6M1mOl5m-17RlQVcPMmkN7iuWzg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx96OST46tEYmVMELgPAqAq4aKToeqT7ACpOXvjSUNWA&oe=6A8D8558"}, {"file_name": "screenshot_sart_v1_2560x1440.png", "id": "1765651148131116", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491828583_1765651151464449_8318573202360319080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQvfRbH6lGQQ7kNvwHWw3N9&_nc_oc=AdokZJUia8XNZ0Ti62qqZSFoS0pbtLnhAttazTCJjtHsrPmlKe6T5mNy9XfKhDwVExg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx6KmeY-qhjTZtNVdoD93NyD1ku_Rde_Wrpb9So_bPQg&oe=6A8D8038"}, {"file_name": "screenshot_visual_search_2560x1440.png", "id": "1486277159378707", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823279_1486277162712040_4776001840881399391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPWCagcXDDQQ7kNvwG3BkKd&_nc_oc=AdoFY9XjH0l6aPaAcaUBmuvTqmF_vBuawWfRQ_jpAwa1SAGbeEq6L1zPKVwUZeHx1GQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRUTFaXXez83ChTxrjhspxOq7KI2B_0KWiNSXE-r9krw&oe=6A8D69D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero_cover_2560x1440.png", "id": "1556371759170459", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828038_1556371762503792_7720704680666894026_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGELdce6IpoQ7kNvwEJ2o1e&_nc_oc=AdoZiTB8W2Cy9w51dP5viobWdtBiaMfY1H18xr5PLzymtVp_RSyx2XyT6a7dQKMLVxw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBHlvXQU0JtdNIZtHObIN3s5cmFAalbKT-rBOnBqmzUw&oe=6A8D8E5B"}, "display_name": "HFbioVR \u2014 Brain Training", "keywords": [], "long_description": "HFbioVR \u2014 Il tuo training cognitivo in realt\u00e0 virtuale\n\nHFbioVR \u00e8 una piattaforma di brain training in realt\u00e0 virtuale immersiva\npensata per centri wellness, studi professionali e utenti che vogliono\nallenare le proprie funzioni cognitive in modo guidato e coinvolgente.\n\nTutti gli esercizi sono basati su paradigmi neuropsicologici classici\ndocumentati nella letteratura scientifica (PubMed-validated), rivisitati\nin formato VR-ready per Meta Quest.\n\n\ud83c\udfaf COSA ALLENI\n\n\u2022 Attenzione sostenuta e selettiva\n\u2022 Memoria di lavoro (working memory)\n\u2022 Ragionamento visuo-spaziale\n\u2022 Flessibilit\u00e0 cognitiva e set-shifting\n\u2022 Velocit\u00e0 di elaborazione\n\u2022 Controllo inibitorio\n\n\ud83d\udcda 33 ESPERIENZE COGNITIVE NEL CATALOGO\n\nDa paradigmi storici come SART, Visual Search di Treisman, N-back di\nKirchner, Eriksen Flanker, Trail Making di Reitan, Mental Rotation di\nShepard & Metzler, Corsi Block Tapping di Milner, Wechsler Digit Span\ne molti altri. Ogni esercizio \u00e8 documentato con riferimenti bibliografici\nverificabili.\n\n\ud83e\ude7a IN ARRIVO PROSSIMAMENTE (in attesa di certificazione CE MDR)\n\nPacchetti Psychological (biofeedback EMG/GSR/temperatura), Functional\n(training motorio con motion sensor) e Mega Suite. Disponibili come\ndispositivi medici una volta ottenuta la certificazione europea.\n\n\u2728 COSA RENDE HFbioVR UNICO\n\n\u2022 Paradigmi cognitivi fondati su evidenza scientifica\n\u2022 Modalit\u00e0 desktop + VR immersiva su Meta Quest\n\u2022 Dashboard di monitoraggio delle metriche di performance\n\u2022 Esercizi su 5 livelli di difficolt\u00e0 ad", "short_description": "HFbioVR: brain training in VR con 33 esperienze per allenare attenzione, memoria di lavoro, ragionamento e flessibilit\u00e0 cognitiva. Pensato per centri wellness e studi professionali.\n\n\ud83c\uddec\ud83c\udde7 Inglese (190 caratteri)\n\nHFbioVR: VR brain training with 33 immersive experiences to train attention, working memory, reasoning and cognitive flexibility. Designed for wellness centers and professional practices."}]}, "developer_name": null, "developer_privacy_policy_u
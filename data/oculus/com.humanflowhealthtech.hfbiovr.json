x1440.png", "id": "1277752924161739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1277752927495072_5270904344691988134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4ervmK_pmUQ7kNvwEiv2uz&_nc_oc=Adq6DQEJF2WyK484zPDPgJcpoy630OVtbIqfuCnTc_a9PRLkk-mbvA4n6Vm1-Bp6WnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbeOEu0j8SBcmawsJx5ZkeHp1abrILl0Cp0rfFRspm3Q&oe=6AF1EF98"}, {"file_name": "screenshot_sart_v1_2560x1440.png", "id": "1765651148131116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828583_1765651151464449_8318573202360319080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5qGetB8bs8Q7kNvwGCFPgC&_nc_oc=AdprPTIM1YwAeOWSdbZdAih5xgTcYOQLGrMJl0fzqvsPeDCxXErXkEw75gOyG0T7gUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCgxfz7wxT-M0TRxOysV7sSENnMGfSAPv6pFvZZJMuyQ&oe=6AF1EA78"}, {"file_name": "screenshot_visual_search_2560x1440.png", "id": "1486277159378707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1486277162712040_4776001840881399391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LpY8maZM_0Q7kNvwGnUFEA&_nc_oc=AdpjvA3E1QJzwUIghECDlGjkastGR8ThoOXLsNeSf5V-svx19HHl21jE98gEV21DoBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj44dDBl6lAAUQLe19bW_oIE3TUheyQlEvq29crIw8nA&oe=6AF1D412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero_cover_2560x1440.png", "id": "1556371759170459", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_1556371762503792_7720704680666894026_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg2SgVPD5c4Q7kNvwG_oJo_&_nc_oc=Adrj_0N9b5hE4oOsOmXQzP3cUCzLGvBMNYLBMlQ8mSHkGYKfU69mSAsLCBSvg-HpdJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwDycjI3UUYGANy63GlMjvBizIOTFy9sIdeG-72HaqQw&oe=6AF1F89B"}, "display_name": "HFbioVR \u2014 Brain Training", "keywords": [], "long_description": "HFbioVR \u2014 Il tuo training cognitivo in realt\u00e0 virtuale\n\nHFbioVR \u00e8 una piattaforma di brain training in realt\u00e0 virtuale immersiva\npensata per centri wellness, studi professionali e utenti che vogliono\nallenare le proprie funzioni cognitive in modo guidato e coinvolgente.\n\nTutti gli esercizi sono basati su paradigmi neuropsicologici classici\ndocumentati nella letteratura scientifica (PubMed-validated), rivisitati\nin formato VR-ready per Meta Quest.\n\n\ud83c\udfaf COSA ALLENI\n\n\u2022 Attenzione sostenuta e selettiva\n\u2022 Memoria di lavoro (working memory)\n\u2022 Ragionamento visuo-spaziale\n\u2022 Flessibilit\u00e0 cognitiva e set-shifting\n\u2022 Velocit\u00e0 di elaborazione\n\u2022 Controllo inibitorio\n\n\ud83d\udcda 33 ESPERIENZE COGNITIVE NEL CATALOGO\n\nDa paradigmi storici come SART, Visual Search di Treisman, N-back di\nKirchner, Eriksen Flanker, Trail Making di Reitan, Mental Rotation di\nShepard & Metzler, Corsi Block Tapping di Milner, Wechsler Digit Span\ne molti altri. Ogni esercizio \u00e8 documentato con riferimenti bibliografici\nverificabili.\n\n\ud83e\ude7a IN ARRIVO PROSSIMAMENTE (in attesa di certificazione CE MDR)\n\nPacchetti Psychological (biofeedback EMG/GSR/temperatura), Functional\n(training motorio con motion sensor) e Mega Suite. Disponibili come\ndispositivi medici una volta ottenuta la certificazione europea.\n\n\u2728 COSA RENDE HFbioVR UNICO\n\n\u2022 Paradigmi cognitivi fondati su evidenza scientifica\n\u2022 Modalit\u00e0 desktop + VR immersiva su Meta Quest\n\u2022 Dashboard di monitoraggio delle metriche di performance\n\u2022 Esercizi su 5 livelli di difficolt\u00e0 ad", "short_description": "HFbioVR: brain training in VR con 33 esperienze per allenare attenzione, memoria di lavoro, ragionamento e flessibilit\u00e0 cognitiva. Pensato per centri wellness e studi professionali.\n\n\ud83c\uddec\ud83c\udde7 Inglese (190 caratteri)\n\nHFbioVR: VR brain training with 33 immersive experiences to train attention, working memory, reasoning and cognitive flexibility. Designed for wellness centers and professional practices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.humanflowhealthtech.com/privacy.php", "developer_terms_of_service_url": "https://www.humanflowhealthtech.com/terms.php", "publisher_name": "Human Flow Health Tech S.r.l.", "support_website_url": "https://www.humanflowhealthtech.com/catalogo.php#contact", "website_url": "https://www.humanflowhealthtech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1154309511101322"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_1011685317890104_6483293768670564052_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Br4ZZzF-F8Q7kNvwEsvfMc&_nc_oc=AdpMnATfLV4Gnx-1EJczG1f-VwiwpH0s7sAZVefrti8xp4g4c0pCXhJszItBBJ9-hJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUNo96WgpUh2xcUjTAuHRZRN8BtTllzBfvPJMkAda0sg&oe=6AF1E6AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HFbioVR \u2014 Brain Training", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1781544780, "lastRevis
Hq5neF&_nc_oc=AdqoM_qL7YviI4Hl3tLXC51qMu6xf5KNCUOSRRSuqaqIDBUgSDAKm_6Y6xNMtSOs9E0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbH3hxtOR0ymhU2-Tg8D3W8T7F7EXDEwGh6nqUcR9qlA&oe=6AAEA519"}, {"file_name": "screenshot_mental_rotation_2560x1440.png", "id": "1277752924161739", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821796_1277752927495072_5270904344691988134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODeSzkfMTE0Q7kNvwHgZE4e&_nc_oc=AdqXDSvY2B9OnB7ssV58TPuVPQNdIPC3zxAifXLsXqunAFNvedOwjMUecGLgNHld03o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpXfrLLtjrqjIyoTBvfa1A5Ul3ABHhMi4EG8oOcu3K5g&oe=6AAEB318"}, {"file_name": "screenshot_sart_v1_2560x1440.png", "id": "1765651148131116", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491828583_1765651151464449_8318573202360319080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZ8bTe446F4Q7kNvwHoFJKR&_nc_oc=AdqszhIkOnVQEzPddsO8v2fKNiofz3zYj7tMCm2Lf5KxLCCh4yV15wIe2Mb84_9QQ4s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKESRnv8mM96ZMfmkocgSwFcPV6O2D6QyhlbB31Wz2z-Q&oe=6AAEADF8"}, {"file_name": "screenshot_visual_search_2560x1440.png", "id": "1486277159378707", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823279_1486277162712040_4776001840881399391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A21ESre1kKQQ7kNvwF3rg4G&_nc_oc=Adpe4NfcjQhAEtRpWxY1dbS3v4rHHkB_BPuHXijkY33w-cNLx0hbwFIcO50wdfIErqk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0chy4H6BWe5xsNFQQ_jXRw1KmzaCVULHW3SoutLBVzw&oe=6AAE9792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero_cover_2560x1440.png", "id": "1556371759170459", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828038_1556371762503792_7720704680666894026_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXXGrvQJSFUQ7kNvwFawOmA&_nc_oc=Adq4MSvgQzOd-QpwJS47EHLoviKB5RY_KQZAEXJEqT8Hhrg2unOIoxuRRHj1Sllln94&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYebKx-A5OPF-Vebn72cxORhVs0eumZwevf1EYTII8VQ&oe=6AAE83DB"}, "display_name": "HFbioVR \u2014 Brain Training", "keywords": [], "long_description": "HFbioVR \u2014 Il tuo training cognitivo in realt\u00e0 virtuale\n\nHFbioVR \u00e8 una piattaforma di brain training in realt\u00e0 virtuale immersiva\npensata per centri wellness, studi professionali e utenti che vogliono\nallenare le proprie funzioni cognitive in modo guidato e coinvolgente.\n\nTutti gli esercizi sono basati su paradigmi neuropsicologici classici\ndocumentati nella letteratura scientifica (PubMed-validated), rivisitati\nin formato VR-ready per Meta Quest.\n\n\ud83c\udfaf COSA ALLENI\n\n\u2022 Attenzione sostenuta e selettiva\n\u2022 Memoria di lavoro (working memory)\n\u2022 Ragionamento visuo-spaziale\n\u2022 Flessibilit\u00e0 cognitiva e set-shifting\n\u2022 Velocit\u00e0 di elaborazione\n\u2022 Controllo inibitorio\n\n\ud83d\udcda 33 ESPERIENZE COGNITIVE NEL CATALOGO\n\nDa paradigmi storici come SART, Visual Search di Treisman, N-back di\nKirchner, Eriksen Flanker, Trail Making di Reitan, Mental Rotation di\nShepard & Metzler, Corsi Block Tapping di Milner, Wechsler Digit Span\ne molti altri. Ogni esercizio \u00e8 documentato con riferimenti bibliografici\nverificabili.\n\n\ud83e\ude7a IN ARRIVO PROSSIMAMENTE (in attesa di certificazione CE MDR)\n\nPacchetti Psychological (biofeedback EMG/GSR/temperatura), Functional\n(training motorio con motion sensor) e Mega Suite. Disponibili come\ndispositivi medici una volta ottenuta la certificazione europea.\n\n\u2728 COSA RENDE HFbioVR UNICO\n\n\u2022 Paradigmi cognitivi fondati su evidenza scientifica\n\u2022 Modalit\u00e0 desktop + VR immersiva su Meta Quest\n\u2022 Dashboard di monitoraggio delle metriche di performance\n\u2022 Esercizi su 5 livelli di difficolt\u00e0 ad", "short_description": "HFbioVR: brain training in VR con 33 esperienze per allenare attenzione, memoria di lavoro, ragionamento e flessibilit\u00e0 cognitiva. Pensato per centri wellness e studi professionali.\n\n\ud83c\uddec\ud83c\udde7 Inglese (190 caratteri)\n\nHFbioVR: VR brain training with 33 immersive experiences to train attention, working memory, reasoning and cognitive flexibility. Designed for wellness centers and professional practices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.humanflowhealthtech.com/privacy.php", "developer_terms_of_service_url": "https://www.humanflowhealthtech.com/terms.php", "publisher_name": "Human Flow Health Tech S.r.l.", "support_website_url": "https://www.humanflowhealthtech.com/catalogo.php#contact", "website_url": "https://www.humanflowhealthtech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1154309511101322"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2165174557609737"}]}, "baseline_offer": {"id": "2165174557609737"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781544780, "status": "PUBLISHED", "id": "2165174557609737"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1297600523438886", "version": "1.2.4"}, "id": "1287818139791865", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppB
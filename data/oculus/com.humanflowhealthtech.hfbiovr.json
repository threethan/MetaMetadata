7495072_5270904344691988134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn4UcUXYSjAQ7kNvwFuY2rQ&_nc_oc=AdptWcgir9YyFNq-l2GVhpQpxdtYT7zNUXGq_Z09x4iFTmlkoUeXYnT451SQPCDDgLA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVaR98RwIUqFReqg_4DGwmBXsgzcLpGfTRjdxtAz7QOw&oe=6A7DB358"}, {"file_name": "screenshot_sart_v1_2560x1440.png", "id": "1765651148131116", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491828583_1765651151464449_8318573202360319080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMOxboiyIl8Q7kNvwEe2XwC&_nc_oc=AdpbI98GsFCmvgSCk6S3eC86FdDm2aYrBKFMBP4h3NJcIPL9biwnPShc0PSVG-2aQp4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGztA-upztZd5WSo6FiRxD0iSbQBPgDLpn-_kRf2mm_yw&oe=6A7DAE38"}, {"file_name": "screenshot_visual_search_2560x1440.png", "id": "1486277159378707", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823279_1486277162712040_4776001840881399391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WT2caKRsB58Q7kNvwG5YVVD&_nc_oc=AdrTqkxxXLzsyu2cnRilzGngc2NLlll0EJS8Tsja-05k_-JV5BUiT77mR30YKfgJA44&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn2qaqzjNQjSej3pId37Ek6sP4PAfKQSmf75k73arklQ&oe=6A7DD012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero_cover_2560x1440.png", "id": "1556371759170459", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491828038_1556371762503792_7720704680666894026_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2eoJuPA1jEQ7kNvwFG-RY1&_nc_oc=AdpAnTyPpbymtDWyhKj52LBqL6Dm8cl6F4HZWk0fbePHLdKCpNwjiLJLFHOw4mk_n1A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHJcXxJl-m4zf7jKwV80Jy68NQ3Efzi9TjthfI3iX0mg&oe=6A7DBC5B"}, "display_name": "HFbioVR \u2014 Brain Training", "keywords": [], "long_description": "HFbioVR \u2014 Il tuo training cognitivo in realt\u00e0 virtuale\n\nHFbioVR \u00e8 una piattaforma di brain training in realt\u00e0 virtuale immersiva\npensata per centri wellness, studi professionali e utenti che vogliono\nallenare le proprie funzioni cognitive in modo guidato e coinvolgente.\n\nTutti gli esercizi sono basati su paradigmi neuropsicologici classici\ndocumentati nella letteratura scientifica (PubMed-validated), rivisitati\nin formato VR-ready per Meta Quest.\n\n\ud83c\udfaf COSA ALLENI\n\n\u2022 Attenzione sostenuta e selettiva\n\u2022 Memoria di lavoro (working memory)\n\u2022 Ragionamento visuo-spaziale\n\u2022 Flessibilit\u00e0 cognitiva e set-shifting\n\u2022 Velocit\u00e0 di elaborazione\n\u2022 Controllo inibitorio\n\n\ud83d\udcda 33 ESPERIENZE COGNITIVE NEL CATALOGO\n\nDa paradigmi storici come SART, Visual Search di Treisman, N-back di\nKirchner, Eriksen Flanker, Trail Making di Reitan, Mental Rotation di\nShepard & Metzler, Corsi Block Tapping di Milner, Wechsler Digit Span\ne molti altri. Ogni esercizio \u00e8 documentato con riferimenti bibliografici\nverificabili.\n\n\ud83e\ude7a IN ARRIVO PROSSIMAMENTE (in attesa di certificazione CE MDR)\n\nPacchetti Psychological (biofeedback EMG/GSR/temperatura), Functional\n(training motorio con motion sensor) e Mega Suite. Disponibili come\ndispositivi medici una volta ottenuta la certificazione europea.\n\n\u2728 COSA RENDE HFbioVR UNICO\n\n\u2022 Paradigmi cognitivi fondati su evidenza scientifica\n\u2022 Modalit\u00e0 desktop + VR immersiva su Meta Quest\n\u2022 Dashboard di monitoraggio delle metriche di performance\n\u2022 Esercizi su 5 livelli di difficolt\u00e0 ad", "short_description": "HFbioVR: brain training in VR con 33 esperienze per allenare attenzione, memoria di lavoro, ragionamento e flessibilit\u00e0 cognitiva. Pensato per centri wellness e studi professionali.\n\n\ud83c\uddec\ud83c\udde7 Inglese (190 caratteri)\n\nHFbioVR: VR brain training with 33 immersive experiences to train attention, working memory, reasoning and cognitive flexibility. Designed for wellness centers and professional practices."}]}, "developer_name": null, "developer_privacy_policy_url": "http
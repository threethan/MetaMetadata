8608_989777640306752_5689016153902034345_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik5dT_qnDt0Q7kNvwGb4bis&_nc_oc=Ado3Z4Ig7hVvLRrYE2UPwrbJSqNfpYlP7-yeb5SwGR_cBn6qqwaYiA_hFH8dm9jQ4Ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWLh4PysMt283LKU7unOgk3Gh3Rp3Uvt8q-vj2ECSd1g&oe=6AF1E199"}, {"file_name": "screenshot_mental_rotation_2560x1440.png", "id": "1277752924161739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1277752927495072_5270904344691988134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4ervmK_pmUQ7kNvwEiv2uz&_nc_oc=Adq6DQEJF2WyK484zPDPgJcpoy630OVtbIqfuCnTc_a9PRLkk-mbvA4n6Vm1-Bp6WnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbeOEu0j8SBcmawsJx5ZkeHp1abrILl0Cp0rfFRspm3Q&oe=6AF1EF98"}, {"file_name": "screenshot_sart_v1_2560x1440.png", "id": "1765651148131116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828583_1765651151464449_8318573202360319080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5qGetB8bs8Q7kNvwGCFPgC&_nc_oc=AdprPTIM1YwAeOWSdbZdAih5xgTcYOQLGrMJl0fzqvsPeDCxXErXkEw75gOyG0T7gUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCgxfz7wxT-M0TRxOysV7sSENnMGfSAPv6pFvZZJMuyQ&oe=6AF1EA78"}, {"file_name": "screenshot_visual_search_2560x1440.png", "id": "1486277159378707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1486277162712040_4776001840881399391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LpY8maZM_0Q7kNvwGnUFEA&_nc_oc=AdpjvA3E1QJzwUIghECDlGjkastGR8ThoOXLsNeSf5V-svx19HHl21jE98gEV21DoBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj44dDBl6lAAUQLe19bW_oIE3TUheyQlEvq29crIw8nA&oe=6AF1D412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero_cover_2560x1440.png", "id": "1556371759170459", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_1556371762503792_7720704680666894026_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg2SgVPD5c4Q7kNvwG_oJo_&_nc_oc=Adrj_0N9b5hE4oOsOmXQzP3cUCzLGvBMNYLBMlQ8mSHkGYKfU69mSAsLCBSvg-HpdJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwDycjI3UUYGANy63GlMjvBizIOTFy9sIdeG-72HaqQw&oe=6AF1F89B"}, "display_name": "HFbioVR \u2014 Brain Training", "keywords": [], "long_description": "HFbioVR \u2014 Il tuo training cognitivo in realt\u00e0 virtuale\n\nHFbioVR \u00e8 una piattaforma di brain training in realt\u00e0 virtuale immersiva\npensata per centri wellness, studi professionali e utenti che vogliono\nallenare le proprie funzioni cognitive in modo guidato e coinvolgente.\n\nTutti gli esercizi sono basati su paradigmi neuropsicologici classici\ndocumentati nella letteratura scientifica (PubMed-validated), rivisitati\nin formato VR-ready per Meta Quest.\n\n\ud83c\udfaf COSA ALLENI\n\n\u2022 Attenzione sostenuta e selettiva\n\u2022 Memoria di lavoro (working memory)\n\u2022 Ragionamento visuo-spaziale\n\u2022 Flessibilit\u00e0 cognitiva e set-shifting\n\u2022 Velocit\u00e0 di elaborazione\n\u2022 Controllo inibitorio\n\n\ud83d\udcda 33 ESPERIENZE COGNITIVE NEL CATALOGO\n\nDa paradigmi storici come SART, Visual Search di Treisman, N-back di\nKirchner, Eriksen Flanker, Trail Making di Reitan, Mental Rotation di\nShepard & Metzler, Corsi Block Tapping di Milner, Wechsler Digit Span\ne molti altri. Ogni esercizio \u00e8 documentato con riferimenti bibliografici\nverificabili.\n\n\ud83e\ude7a IN ARRIVO PROSSIMAMENTE (in attesa di certificazione CE MDR)\n\nPacchetti Psychological (biofeedback EMG/GSR/temperatura), Functional\n(training motorio con motion sensor) e Mega Suite. Disponibili come\ndispositivi medici una volta ottenuta la certificazione europea.\n\n\u2728 COSA RENDE HFbioVR UNICO\n\n\u2022 Paradigmi cognitivi fondati su evidenza scientifica\n\u2022 Modalit\u00e0 desktop + VR immersiva su Meta Quest\n\u2022 Dashboard di monitoraggio delle metriche di performance\n\u2022 Esercizi su 5 livelli di difficolt\u00e0 ad", "short_description": "HFbioVR: brain training in VR con 33 esperienze per allenare attenzione, memoria di lavoro, ragionamento e flessibilit\u00e0 cognitiva. Pensato per centri wellness e studi professionali.\n\n\ud83c\uddec\ud83c\udde7 Inglese (190 caratteri)\n\nHFbioVR: VR brain training with 33 immersive experiences to train attention, working memory, reasoning and cognitive flexibility. Designed for wellness centers and professional practices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.humanflowhealthtech.com/privacy.php", "developer_terms_of_service_url": "https://www.humanflowhealthtech.com/terms.php", "publisher_name": "Human Flow Health Tech S.r.l.", "support_website_url": "https://www.humanflowhealthtech.com/catalogo.php#contact", "website_url": "https://www.humanflowhealthtech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1154309511101322"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2165174557609737"}]}, "baseline_offer": {"id": "2165174557609737"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781544780, "status": "PUBLISHED", "id": "2165174557609737"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1342124445653160", "version": "1.3.1"}, "id": "1287818139791865", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147897465075860", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1342124445653160"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1287818139791865"}]}, "change_log": "\"Aggiunto un avviso che segnala quando il componente immersivo non \u00e8 installato. Nessuna modifica funzionale: gli esercizi funzionano come nella 1.3.0 anche senza il componente.\"", "created_date": 1791140687, "id": "1342124445653160", "version": "1.3.1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147897465075860", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1342124445653160"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1287818139791865"}]}, "change_log": "Minor update. Improvements to session start and sign-in handling on\r\nshared headsets, and internal routing refinements for the immersive\r\nexperience. No new permissions, no changes to data collection,\r\nno content changes.", "created_date": 1791119451, "id": "1341647925700812", "version": "1.3.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147897465075860", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1342124445653160"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1287818139791865"}]}, "change_log": "This is a minimal maintenance update that continues the fix line started in v1.2.4 for the browser behaviour introduced with Quest system release 2.7.\r\nScope of change: a single function, openInMetaBrowserFullscreen(), where two Android intent flags were added (FLAG_ACTIVITY_CLEAR_TASK and FLAG_ACTIVITY_NO_HISTORY). Nothing else was modified.\r\nProblem addressed: after an exercise ended, the Meta Browser panel launched by the app remained open. Besides being visually confusing for users, the lingering task prevented the next exercise from starting, because Android brought the existing browser task to the foreground instead of loading the new URL. Two customers reported this independently.\r\nNo new permissions, no new content, no new features. Manifest unchanged. Same signing certificate as previous releases.\r\nTesting: verified on Quest 2, including that returning from the system menu during an active session does not interrupt the exercise.", "created_date": 1790323179, "id": "1316241701574768", "version": "1.2.5", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147897465075860", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1342124445653160"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1287818139791865"}]}, "change_log": "Fix compatibilita Meta Quest firmware 2.7:\r\n- Risolto errore WebXR NotSupportedError negli esercizi VR\r\n- Migliorata apertura esercizi in Meta Browser standalone\r\n- Nessun cambio di funzionalita per l\\utente finale", "created_date": 1789382040, "id": "1297600523438886", "version": "1.2.4", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1147897465075860", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1342124445653160"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1287818139791865"}]}, "change_log": "v1.2.3 \u2014 Ribuild con keystore release ufficiale Human Flow Health Tech S.r.l.\r\nversionCode 8, prima build via CLI gradle senza Android Studio.", "created_date": 1781522735, "id": "1155089401023333", "version": "1.2.3", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
5270904344691988134_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPrurS2KKX4Q7kNvwHSp5y4&_nc_oc=AdqlAebMxUxgv-s1bNiWYTaYvcAvyz3tUO5SLFDMaKBp6_eQQiePxZj-m-n0daMoi8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4ZxSDr0nNqI3CbmZofD43U5woJPs-rHXXnt3tUsjQxg&oe=6A492F98"}, {"file_name": "screenshot_sart_v1_2560x1440.png", "id": "1765651148131116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828583_1765651151464449_8318573202360319080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZyQcBJmDM8Q7kNvwEYEi3Q&_nc_oc=AdrhpyEcrl9GlcZc-DWix-or31WVLPxipZdKN_QEYn1FKPwk_iInwkQxUIoEEOq5A6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx9gMpUOuFbG1ft7qICCm1k5Pia9Fr80bfwHamfIf3zA&oe=6A492A78"}, {"file_name": "screenshot_visual_search_2560x1440.png", "id": "1486277159378707", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1486277162712040_4776001840881399391_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJv4LZA6JaoQ7kNvwH7rRPI&_nc_oc=AdrzZOwxO5hEn8pxg4Mq7YFvB7F7VRjm6DeoSfx697cVBD4DreVHB66lOxMtQm_FKK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGFcsxhpAakZ7pDdUhAPunoU2pyl4FF9duOwSADtQeqA&oe=6A491412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hero_cover_2560x1440.png", "id": "1556371759170459", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_1556371762503792_7720704680666894026_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy8Yx1Gw7MgQ7kNvwErz1qx&_nc_oc=AdqJnIGKJxHfsp1Yk7di8oTnpPR7ktwd31aWTcjiBRd_ZIlpBaZ0_CJD8Im80Y_mkjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3iBKe32N1SjDyPNuGO6wN_AyRGKkQaqFjdy139I8FtQ&oe=6A49005B"}, "display_name": "HFbioVR \u2014 Brain Training", "keywords": [], "long_description": "HFbioVR \u2014 Il tuo training cognitivo in realt\u00e0 virtuale\n\nHFbioVR \u00e8 una piattaforma di brain training in realt\u00e0 virtuale immersiva\npensata per centri wellness, studi professionali e utenti che vogliono\nallenare le proprie funzioni cognitive in modo guidato e coinvolgente.\n\nTutti gli esercizi sono basati su paradigmi neuropsicologici classici\ndocumentati nella letteratura scientifica (PubMed-validated), rivisitati\nin formato VR-ready per Meta Quest.\n\n\ud83c\udfaf COSA ALLENI\n\n\u2022 Attenzione sostenuta e selettiva\n\u2022 Memoria di lavoro (working memory)\n\u2022 Ragionamento visuo-spaziale\n\u2022 Flessibilit\u00e0 cognitiva e set-shifting\n\u2022 Velocit\u00e0 di elaborazione\n\u2022 Controllo inibitorio\n\n\ud83d\udcda 33 ESPERIENZE COGNITIVE NEL CATALOGO\n\nDa paradigmi storici come SART, Visual Search di Treisman, N-back di\nKirchner, Eriksen Flanker, Trail Making di Reitan, Mental Rotation di\nShepard & Metzler, Corsi Block Tapping di Milner, Wechsler Digit Span\ne molti altri. Ogni esercizio \u00e8 documentato con riferimenti bibliografici\nverificabili.\n\n\ud83e\ude7a IN ARRIVO PROSSIMAMENTE (in attesa di certificazione CE MDR)\n\nPacchetti Psychological (biofeedback EMG/GSR/temperatura), Functional\n(training motorio con motion sensor) e Mega Suite. Disponibili come\ndispositivi medici una volta ottenuta la certificazione europea.\n\n\u2728 COSA RENDE HFbioVR UNICO\n\n\u2022 Paradigmi cognitivi fondati su evidenza scientifica\n\u2022 Modalit\u00e0 desktop + VR immersiva su Meta Quest\n\u2022 Dashboard di monitoraggio delle metriche di performance\n\u2022 Esercizi su 5 livelli di difficolt\u00e0 ad", "short_description": "HFbioVR: brain training in VR con 33 esperienze per allenare attenzione, memoria di lavoro, ragionamento e flessibilit\u00e0 cognitiva. Pensato per centri wellness e studi professionali.\n\n\ud83c\uddec\ud83c\udde7 Inglese (190 caratteri)\n\nHFbioVR: VR brain training with 33 immersive experiences to train attention, working memory, reasoning and cognitive flexibility. Designed for wellness centers and professional practices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hu
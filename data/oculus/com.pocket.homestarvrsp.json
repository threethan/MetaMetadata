0e7005en.png", "id": "773125536591078", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoeWIST6G04Q7kNvwFibBFl&_nc_oc=Adqkiyrmx4FDcwkXsnuzvgPl_4_mpHF8lgbw7J-ZrGd82xdVvqiS81vsAOS2MpTktgM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-T32y7K-L5DnbYCO-ifrQ_l-XIApBt40bwe-3btsIPg&oe=69E769E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkEdHf8yGy8Q7kNvwFCy6kU&_nc_oc=Adr3QteCptKaxLts-wLG_pjMA0GLIqEh53a6VP2wnNvjdSHp4AnuFwGml5M-sQPqZ1w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sxv4VGCHiVHCrGaE5VWtRtB4hjPEGtuMncv0WynzuNQ&oe=69E791AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNJFhNrweVQQ7kNvwHfqCnP&_nc_oc=Adoy4Gbf2tHY4Ilw6-wS81d60itsfGgCSoQci6sa2BnVPK_Cbw6hLqVQKfwDoz1VM68&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sd3ztWTmo6ON7c67KM4ox4-7mU5vyRAhTDU3h5UR8bQ&oe=69E784DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vp2krM9vicQ7kNvwHXb4pO&_nc_oc=AdolDY5PMBDX_zrtT28EWEd9N0Mn9JF7lCGkTgH3l5ZJdvEV26oB_rCfynalBkkXfvo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KaYycjA_5a57GOSTwyH6i6w0_7q5v0WvvARpai_hVkg&oe=69E78591"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQTtPmwskG0Q7kNvwEndyxP&_nc_oc=AdrZmJaqnxTmM5e7kl1CTNQm-An_b7S7NgtQivpfwqVdl6BwgPF6k1C_cn5LyEW3HMM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KJn-PD-nPq4bUeFDr4eGoz2ENq_e
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avhR29Ro2BUQ7kNvwE3Kxvb&_nc_oc=Adq6IO0OG0eV3_njJt1cat57AA3d428M4hV-hqz9J0FcQXuAR8aQGU8Vz51_GF0V1xE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN73jTkPEMglwgoU-JQGlCvQNFMzbovpUQyrXpAvj7W_A&oe=6ADDF268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg8wjXkUpKYQ7kNvwEYVMRv&_nc_oc=AdpgoLzbqmUF5lBLEfY-VMJxaJ5sBSKOgFSSr97zmRb0kjDaopgIINcH_dzjYOTO0LY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqDX9wilmQR2lZTbckDlWAV9Q9bSfcMv8Cv2BVLQ4CZQ&oe=6ADE1A2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Va35Dq59qS0Q7kNvwG5chYy&_nc_oc=AdpbIZjqtRAx9JL82oXZkxOGskZVvgYRkanP0FzDvqjudRwIIQTjBaKqICO2dejud-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPryQKPvUFGJmuU08entfuJbLw8BnGZ3p-td6PaI2iAhw&oe=6ADE0D5C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=275yCfvsdT8Q7kNvwFygpx_&_nc_oc=AdrgornrEfoQsPq16mCu-hUdBv_iWIcYoAhYlfhOx7aKDDa0HaW25IqJWa4Wo-NFX_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYWQ6rycl8Nxu1QknNPIPd45IXeHlHF_hV1IwmJpVzng&oe=6ADE0E11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcV0S8BWVBUQ7kNvwHsI7e-&_nc_oc=AdqT3koyNlG8hcp-pFXTIx8MgfU6DwnQ3XyzizMMZAIejdwWWr9K3I8joKTGQwWcCsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg6AoCMIFwSzOYKbAravDSQsPKVlr
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cdp6dZeVbOoQ7kNvwHgKB7Q&_nc_oc=AdrW-GhtBJme3FlkgQkD_JKmaa4qeeMWrVNIOEelEdbkfY3vs987nO3Ep6zDp7Snfxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALBjP1lfH9CYEMcQ_z0P30WQY-5rNLw73GMi7rCaDn-w&oe=6A5384E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khOBKO_x9ZgQ7kNvwFfI_eZ&_nc_oc=AdqIlOeLs9EhyYhlh8fA8QwJQAmnpIi8FwUlWBH6J1A4gDlFOjw0s2FYrWWUo3rEKyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAdkQ1KhFsfqZlC7knwn0_g2u05idXkZJlSyDn6xeJYA&oe=6A53ACAE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B10-LpKjzK8Q7kNvwFti719&_nc_oc=AdpPTk3UWdYbEGlmLn_WyRLZRJqfKt2fhdd7xW2ai-0VjerZBCwhyLO35JBGpdHNduc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwd5T3a0jb10_uW7HWAk2B4b0VcWHJ_Z7xLD7sQgUstg&oe=6A539FDC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T_U9eOFu5EQ7kNvwFxbvfj&_nc_oc=AdomO6Ou2pEXFa_Yqn_GRKwiKDJBt6o_xCOtCNjsrIpbz97eSJDZ49S757hi6Sz3xqw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADa2Elj5RF0U_MBlxQk2gPVsLPmXhstMWXgn0Ct6PHUw&oe=6A53A091"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sGdjn0yUB0Q7kNvwG_Sy2Q&_nc_oc=AdpVjxF1lMmT2g1TVrJbTfo8bH8ul0DfUAdRE8JJ2rhengfLxpp9Zzk1v2i-5ChnbO8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA--M8B7FbTfNOAY_9K30YX4tku6ks
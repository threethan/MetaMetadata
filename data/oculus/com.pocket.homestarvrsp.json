0e7005en.png", "id": "773125536591078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tA90VnjSOMQ7kNvwHIhbkZ&_nc_oc=AdpCqzaMEX65SuakhUfVdqQQoIFum7j1cLr6iRw5eBbkb-NrjrM5Jb0sUEeJ7j0DYtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UmOEU-lSdcMAxpqCjIQP-EUMojdlgakQ3lr4lyCNJMw&oe=6A3AB0A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZOeKyixTkYQ7kNvwFJAggL&_nc_oc=Ado-gAde-BNBV_4hg6AqvgRf7PeffXteHkF1Kasv_ZIBj3HUPDFsM7LBb6oku8ep1mc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-ZgAYFliEmEvOAW5Bv-yuHgaQWzbciapvg-zUSWDAYA&oe=6A3AA02E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6D6YD_h9OsQ7kNvwFuxCKp&_nc_oc=AdorOhLKuRpKPaMrlXgzHbMkWBSzh8H9i0bB8FmXGysvhnKAMpYvWBFxAggvSKu6JkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g0gSkxqWijnJIR5MMN4dueZl6preZpDNEcGZ4dCVeqg&oe=6A3A935C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxAgVvOS58AQ7kNvwG6hpdn&_nc_oc=AdpM4Q5GbL4WDgwsFwXHRq4EJqELQVD8ia5pGQkI5qG0qp1SdAOrZOXKcgA0o2kCC7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BNI4gBmVDXXmvkptiSutAQI3PUQTDq6aRfTwYhVKATg&oe=6A3A9411"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZWvdJYlSvcQ7kNvwEziRFX&_nc_oc=Adp2_K0tfrCnGerK-Ja0ue2qaIjvXLCQv6H8Sewz9EEeAn11nk4SV0SxkluNuEvgi78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-67o6vn3VNYJzNoyB7K2qru3Nh1j
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNZQFZyG2XEQ7kNvwGXURzo&_nc_oc=AdoTIOSywliVDV22P7xlEf7ww3a3buXEA9qnx43ojGJTBE4s3Jz7Ftw_yjk8Zm8EqVE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DALxIaXm_Pi9H31UXq8pvbUwUGwCLR8DwzUG2huRcRw&oe=69FDD368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3tovsYbos0Q7kNvwEG1dVz&_nc_oc=AdqHytuBIc3BULmO8DdEV5vOKnHnIBXFhYsnmLR8_MgjTnwsVak-2rT3JnW-S78Wu2g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J8GVM6NXjZ88OUo9O1Ywhg2k_HWHKNUMY-806nJlPXQ&oe=69FDFB2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLhH0KnAdeYQ7kNvwE3696b&_nc_oc=AdpMf0ns-HZ8NqMXrdMh64oVRvc9g2_5Fb2didyiMzSrgtS5VkIC5WiHi88AOLDaofc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IkjUGbNzJawyplLSALe7-p018kDKFSFrgTV5MTsEvkQ&oe=69FDEE5C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RL3SMZUNfoQ7kNvwFpU8H3&_nc_oc=AdqmgTcZWIAiFrd2qR0c8NVeMXnP-6eJuH7pz9oEUhzBYXzqE3rqtow1IDPuKUo3dF0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43wHp-bsqme8oWtRJXhIvpWvIXC9xV6CY50L2YYiBaWA&oe=69FDEF11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZqFE9RRhk8Q7kNvwGg94SN&_nc_oc=Adqawjy7GX8bUh5Oo03E6EqSd8ANZlScwC_X08estsn2X9HF7hKj7rJW3S67K6PPOXY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tr7blegUrd3cSHPQOuCMsma-N6R_
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rijmFwEHMrwQ7kNvwHaog0y&_nc_oc=Ado5HZZipQ3w_jFaR58Ja3ULRTx9ZIGToBcF2duBSwqXYNZDOsMyJa-15leWGarLFrg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Wd9Kedf1dvaY_0hP3Kl_jHenNwh0yY6hSwENAxWAbvg&oe=69F88D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMQTJlS8qbUQ7kNvwGXtSfm&_nc_oc=AdrPFvNs-O1IrUqQjzGgoUoIB9UyGyMlVEg-nWOIgg5KwRsUbbs7DxitpZlgp3XMcqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RUZ-4ibxQHpnlZ1z8v3saFVZE4HMK7zV64ovTh70TQg&oe=69F8B52E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sBvoI_uZHMQ7kNvwHBICbO&_nc_oc=Adp3SsZTQY6eUJBRig_ixDP-hOYt1JSbfT-5hCJRkTH82AI1sJloKK4cNz60zfHFi18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HbeHpBSgZDxd6h5WIWZOMURaL16uKOnmEAyqaYjMGgQ&oe=69F8A85C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsHs1g8pHlAQ7kNvwFjMZ6I&_nc_oc=AdpNY24RSNC6NWRSC3R7kA4YDJ4Wa3ofzDWwp6S0Hcfv1Fp7YcNUOfO4gcS2yDg45gs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nsmQ3T1dLWDNacA4uYprjg6zYAvNT-iYdHXrhXnYxdA&oe=69F8A911"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lakx1DvPCkQ7kNvwHs7XFe&_nc_oc=AdplFCbRlYRJLV-tP7sUZMHI01qgvpgtv1kCedyha5ifDSfV0fGnp04XY8t-3PqLUu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2McH-V355srv6rJanOCnoxDKBEkuq
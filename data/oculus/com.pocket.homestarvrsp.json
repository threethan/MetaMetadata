0e7005en.png", "id": "773125536591078", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rijmFwEHMrwQ7kNvwGZyQWw&_nc_oc=Adq4zasGhNTCWdKqJbkfRRtJvisxMnhpU47XwvJPzVNgvS0gn9MWo_e9rVbyDSYQtvM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uFSI-0Sg6BJ6dv6rNsFE1xgeXoihU4yLQZT5SUNLS0Q&oe=69F5EA68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TQFzq7jb28Q7kNvwFsRHJW&_nc_oc=AdpA6x9YFJLz3OhZXjrhuustWQnA8H0p_PW4Bz3KWqbulp86yKJCx9jxrQWliZmN0kc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14YB4-OX4i93IQxxPVQ81gXMJ64nlxSe242suZu74ZHg&oe=69F6122E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4pik86RM2AQ7kNvwHYAl3K&_nc_oc=AdoiXcRjVTTwboj4nsZl3lPp3Ol6W5C0F2VDRPZwNsCl_82RlOHVCmKbGKVHo3XRGGY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-ssxFKRZIrUESP5xmouxtOlrPboijNCZzzXZI2wGYqw&oe=69F6055C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsHs1g8pHlAQ7kNvwF3LCsz&_nc_oc=AdqvC7hl_OFDHr6PZexuVey4mu9SKrMcTHVqhqQEogi-pBgzvS_R2TkPsPWtK7zkhh8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31e4DbgPKQSmpZCujw4xutRKm3CfIKotodUcoYeZxZ1A&oe=69F60611"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UDIt19DxUEQ7kNvwHJSjVb&_nc_oc=Adrx6o4I5xfRi9-1kJBfD0lsAHfa0nb-UMtEzkiYCXoeNiu9oIMBck8bWQAcu3GIucA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tlv64KLYtL6gIlJxENt09J8PAgbM
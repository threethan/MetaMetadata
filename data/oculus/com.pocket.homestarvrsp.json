0e7005en.png", "id": "773125536591078", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhqtekBofZEQ7kNvwE3fJTE&_nc_oc=AdpuMT5v-DRfcKRMOUQP0dKrLGn7Eu5DDlpuLaT28D11in7gEqZB5m7tu4M9-H_O5es&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0-4veFWijKJtj9ilX01BTizj4RL1uCLNU9WeUDRfAag&oe=6A941E68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orb1ntjw5QsQ7kNvwEaTmBg&_nc_oc=AdpMtYLKUhSDpfYcVUhMFgB_7RHugWVO29KM63MAKy95Eg4HfOwnK4kJz58kbUtDodg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzknQyuw3qxBu3XqSuaB6f9GpVHNMMLHlnDGmmjXnfwg&oe=6A940DEE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ThFX_Y8gGUQ7kNvwHzj1kB&_nc_oc=AdpqiflWNRYVp3-NFM5dXDTZYNUWrTnk_MCzKCxiEKxT_7GrBVdY0sv2eY7E2xS7_JA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY1l9fFupv5EH6EkCMCe0CnxBv3ILOuyVTt_32mbgX_Q&oe=6A94011C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCGO87jN4ZsQ7kNvwGyCMet&_nc_oc=AdoT2vSplYl0JngDLC3aIVKuJtnUDB_7tGQl7KjYSZDosujuCRQ6S-mileIejV8EwIM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQJvocRpUSJggmiSbuWs4ANNTvnMzV-c9YWv2hLnB9lg&oe=6A9401D1"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPL60uiUeBUQ7kNvwFzEC8E&_nc_oc=AdoAJgd_UQV9nHoHT9kyrpTalDpPNNRN0Xfb8gw-CNPTzFSYvLdIAV6LSCla-bjkZeE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJQuLI9zKltf-40h2BwufP66hZrxb
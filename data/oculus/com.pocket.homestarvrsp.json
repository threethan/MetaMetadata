0e7005en.png", "id": "773125536591078", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjA_HtJK80IQ7kNvwGMAhxD&_nc_oc=AdpPBJYk-XvPFvr6BQ0ZUXwtzTIcUO9wOc-FJNvbUi5h4Nt1IEOffKUdo-vIrtu1d-Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHuDzTpSgR_dda-N9KiB8-PQqLbEFFP5y4v0ix8CnAmA&oe=6A8AE3E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1yGkdLeTw8Q7kNvwHiQUnB&_nc_oc=AdrE3d-3hAcJdrnV0sN5KPj7wQ8vLDiX-a7Ua-LqHqo0BvZ-MLbSUW7Dz3nOTLj9BZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkdhGgpfRbLN3hu0Wyhoale2ROfuXz28xLzHNK74HdTQ&oe=6A8AD36E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or5Vjn5wFRUQ7kNvwHdB20h&_nc_oc=Adp_dl-ZmlCytW71ng1k77KCrh4zQ6-u3Lu48DsAVREcZoAmzgbj9A67orDyrXrMQbI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwWDiWSaFL8MBBBZS0LRA9Iuog-VqycwkvFKRBeSkBSA&oe=6A8AC69C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE_SAIaKkX0Q7kNvwHBEC71&_nc_oc=AdokOb8FSp7U9uqpXuzZw0UIRQIg3wG3HdF9bk38wWDGpFziptVwuJf4lTKXAFJpC9U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO9dMq7Lb3UMeJj8poNJ-zqNaxeimEEHQxV83RNM0kmg&oe=6A8AC751"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5O8e6lWdtAQ7kNvwFGVpd1&_nc_oc=Adp8Y3DCiMCHfKl68sM0n5xObh1_wxDB5jqrRlzOwuM5jr-aAqerWVY1uoSPh7GrnxQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_TURjqCcWUHmsoVW-zX6K3nZ76xy
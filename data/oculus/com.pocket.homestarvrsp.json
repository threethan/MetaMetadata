0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM7vxFKyA8kQ7kNvwF9IxNj&_nc_oc=AdoRU1VL5NhWAx49HosgfG5K9JqXHDiPmcOf_2vuQNS_xHjW5zalRXZdLf_y7EW5Nvw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dfHDk24dqHZsR325WpMrdxniIhPIuTrTuzFUrzuBfdA&oe=6A01C7E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnmv-e0QClEQ7kNvwHXVidu&_nc_oc=AdqKzaZoXt3IIlPXhezp0N2rZKXRXltMFjO2v-Rs16TMcryC817IDiMk0S2-emPH8u8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CqISDgTsO291_jupfl1WWaLz1NcNtichGQe_tzohgCQ&oe=6A01EFAE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSdhKE_9bbkQ7kNvwFWdjf3&_nc_oc=AdrgRGRLLIxQ8YFt9DThWZjoGnqkpd50RF1SD_LxqFyrbPiKuXjew03Qed6Eh6pBMMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qyLF4-GuItqRbw4kgoHPD34XDm9QqghQ5dzGedoPvng&oe=6A01E2DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUIOxOWefAkQ7kNvwHv3Yb9&_nc_oc=AdrN9ztBmHtVCEcimZmgutJWxV1CF-fSGomo1L3E3JM5a_Qy_kaTxd73Ceiol95rFz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6am1m2XcZVlRIrY6B3AI5iz4Q6TkfEga_9ZUWG5yu4tg&oe=6A01E391"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvR6jXN61isQ7kNvwEFVtEG&_nc_oc=AdoswWD7MAPLxVf2V9R5EIe6XrVSpPE80PEYrP16yTbQ9aJyIkwkM_yxM3mH-eWPPlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af586bFeXE-96_aVNRYO2D3eeqK1Y9h
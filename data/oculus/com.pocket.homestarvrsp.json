0e7005en.png", "id": "773125536591078", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s49P54WyrEgQ7kNvwGwKo71&_nc_oc=AdrjVPRRZiKQ0gpN3FivFtQUiuFCCZVxV0kVJ5zvwxKZAg_tYSHdXwXEKbt6jU74yQU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jSNhuAdEx93nz-e7qknV0qsPE0LtG2cC0KJTbEBfcng&oe=6A410FE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWLfvRbFFQ4Q7kNvwFnGK7U&_nc_oc=AdrBFZqSn_4VEhyarod0q7Z3CoUY0fkVpnC3uMK7jH26dO8nocEw6hw5xGthcG-DSmY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1hNbcT_sjBdgP1Otf4kahxFu4TzYGEzQo2fHiDlaVog&oe=6A4137AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Yq1tpFTdNAQ7kNvwF49fJH&_nc_oc=AdoF2pVME5550QDK_3ifiGkbhc784ZReyzkFSyZEc0XQ0kQc4PR-xq6KS1iZwj2ZFko&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7jGGhvjXIfFWsCbqBv9URNGWhA_bDkBLy3dEA-DSN9A&oe=6A412ADC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suk0GQW5rCMQ7kNvwFXgWWM&_nc_oc=AdqheETphTuYVlpOwUnbAxnGOkDKQJbVQoPbmicWi-kWAVN8BiIETcDSdXucUWH9zLw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87vS3ANMwM_wbeI4QqXnRgJSGxmRHXCRCEVuxlRa9cCA&oe=6A412B91"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhKkZrdEIskQ7kNvwGeIpjW&_nc_oc=Adp7nWUh1ZwTQ7kpEgWHtN3EJ17167AUH4zhkUUgAGrWzvRjcWpm8yGWK3o-d7p_1MI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UEiJbfPkfr2X4U3DbH-R1o_Fwpvq
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEg1nIFAPk4Q7kNvwEr5Iuj&_nc_oc=AdrpV8xJX8xUkJKtAHztoL-z3R3TZw3tRsOL_jApZwhtQBLQ_lC3RmGGlxnG-IZOtmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cZgI0IWbC41vkUeIEhNo_o-09jQImpfimzZCgeeLOXA&oe=6A450468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UDXeImSxEoQ7kNvwGcDs4J&_nc_oc=Adruc-1n4Dy1vdNFO9XDcJxzBW_JNB39fTNa0COKJ0I6g1Jh3t5FunrTnT4omHzuytc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QTSb1DTQmyrRIRV-3UcqZkbcgDE9gbGhUmnhdFMIrJA&oe=6A452C2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ze6JyoJHeaUQ7kNvwGFVKgx&_nc_oc=AdqplVx-h92F5jPSw6yz77tp2-ZZsjlp4UUheXRKzFHqJiL2waWz7DK_tVC2llIwV6I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M__cQSYVJ-lBHcMh2QPjDQhSrTkdJi1jO410qOyhgcg&oe=6A451F5C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjDp5Kf1SkUQ7kNvwF98gII&_nc_oc=Adqes5xdADTpH1pivNEShajroIHRFgrh-nJxlqVDlDlo7VbONPAPwdIdSJpC5l_Yjx8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fLrjIskFoDXEfE4vBhxNaip9v6QnVn78axAqIsWg1uA&oe=6A452011"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CR_6dx9g02cQ7kNvwER8a9t&_nc_oc=Adp-Ce8PZrmdfHZ_YXQUhczxNrkA-jbu-n9M-JoeYrPy-7KrvoQATD2Mje0XCPM88IU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JxnCvID8m4gMTXTtqeUbEoe5e70C
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuUdZmhJo0EQ7kNvwGp-r6a&_nc_oc=AdokaqFEAcP69jyRfISKQnbFjX3EMNQ-8M1l-5nEMvLDh1KLRxQM-e0i_mhMGWPwLbU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YHFhs-KSIeYWGSBUwHNBuBCTRBqh_mQQoqFwuJEPO9Q&oe=69F34768"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TQFzq7jb28Q7kNvwHiLPPI&_nc_oc=AdrIpawQqMM-94osVrAbOblQB5y2qjGpAua8tZyzWpxSQNPTYJZp2mNR9m6MzpiY1cc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CFa0kAbLizlEMowUXm2dQgON6gLA6noCwSePdNp-J2g&oe=69F36F2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWHdjn6cMjMQ7kNvwFHiaKb&_nc_oc=AdpR1vwOWPCI_k-zQS4FLgIVI_AFvxGQn3QNn3vLB_dgYuuGvd6wX0ueL7rlL9tY094&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RyIIFWNzKQ_tOgS_07QGpGKP1rGSpujs046TVH1vyzA&oe=69F3625C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toumTWKf6lQQ7kNvwEnMGuc&_nc_oc=Adrhk4aogbqy-vX4R5dKxscHsnqyMT9LvQ7X3gBQQwPwE9euT4Hoy9Yocs2cLYPu19s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HUM55U0cU47wwZ1PjGNb4mxA6Tg9c5NP02paxp-nqlw&oe=69F36311"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWKN5UmdlEcQ7kNvwEHKJV_&_nc_oc=Adr-XdVnNIsbI7dX6jtgYk2pCcj8_tvneSCmwuvMz-7KSPAlk4S9yTXfJ89_NFzrBJM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dP1BjrRwJqqd0zmaOt9pHI1lKe3I
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IX0xfkAp1oQ7kNvwFLv7g4&_nc_oc=Adp_P0FLxYq8oYCwmXvG83zZY41r-d1T6iDg0UVbBnA_HrKYyBsP0m5pj6oqpaizd7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVsbY0mo3cYVRGF-JdUU72wKAnyl21W6mK1Cy9Af7tBg&oe=6AB3C268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0QNA3eUgNIQ7kNvwEdHgl8&_nc_oc=AdqizYks76dyqVt4bRchEb2iAKpotW1UKRO3uPVfxEyMxVtMSmmfBguZTpVJnZUUKBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPHCEUN7JP16Zw_piWpUiCACPjDIDr-1cCR4XtSXBWuA&oe=6AB3EA2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ5H1wSklegQ7kNvwHvOoed&_nc_oc=Adpb9c4noAUeHLcI6D8QxwcZLvpnRMfSIwGwjxMz5j5LvVkQHZjgjsScli0wfViEra4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRkDbBuODTVNkbHL50-QVTJPhEA0DUT15IUWSZDyPKOQ&oe=6AB3DD5C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zsnyonwy6YQ7kNvwGnS8z_&_nc_oc=AdpRsCd-hHenoPqJol6cy9uCrCN1vrkqJrng-sOykKv8n8ASCm_UJ9bHzS0PFBtihXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTieq_5SeuzutRnloVXX-ndIH4fe0t0aC6EzAFk2Z-lw&oe=6AB3DE11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Fy-2ppHE8cQ7kNvwF0Gpj5&_nc_oc=AdpwN0vgu3xTmhPXUcDUManVBsJqYix4BoyMPmEJmeKDkUfF-lG_00VPBKG2-b5Wf_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZQq2DLByC8EAvjyIygPUa63jWnQe
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuUdZmhJo0EQ7kNvwFwuWSR&_nc_oc=AdqH1hyufiByzyAX24kuX_V3z0tB7eD8f4NIlL1iYKv-4-ZZqfk-bpgS2xFmvBPwrLo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04TAzaUW_TOkfdlwksyab3AogzOdyL55X0WoiWIvLNRQ&oe=69F498E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TQFzq7jb28Q7kNvwHTxsNa&_nc_oc=AdoQJRSY-CqlP1eorEZNLeTo8bLWxx7xC2ttqsGGPhVquXOL_s7JUoNf5eDNmPsuKdw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3t0M0Jj8Cvu97txxF0QbsUPyXdBZOlyXTs9qtcwFhSaw&oe=69F4C0AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4pik86RM2AQ7kNvwFCP7Xh&_nc_oc=AdqQ_Gtmtuz_hOucrwUeKN5vgV-rdPIcq8aGZdSs_Bx5Xa2AOEqaOOklusD-TbYYJys&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0so3ZZFFFVn20cP_czcZxfrBS50pMgB8VtOVdGV-98hg&oe=69F4B3DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toumTWKf6lQQ7kNvwEgBxDZ&_nc_oc=Adp7eMz5wbGQXqvEcNwSb9X_1953Q5_0kB6DNrftIz6JH2DfZNpH7K2qYUmmrPWpQGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UWIq3-2qJrbEMTuh1UPlSSSfZkvt4BxS9GXb5CdqZFg&oe=69F4B491"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UDIt19DxUEQ7kNvwENMae5&_nc_oc=AdrFOq0Rcu2jop7HO7pTZUOJDKxnGzTOnEkOxz2-1DCfA4J227JVA1XNGBsXuoWvDTQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jjtG7uwYZITC7dj4Z0T7hpqHX_Ws
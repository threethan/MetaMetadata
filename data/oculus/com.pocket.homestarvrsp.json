0e7005en.png", "id": "773125536591078", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS4GPLYjlrQQ7kNvwFC_LXM&_nc_oc=AdrozMDVM_tOTlDz79-8WMICrwW1x8KXz_dWzprOYjMq2KWAvnuCx2Gk_Tz8qdKZOOM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dk40PpHVQ6SMmlHAWftjj0lmH7i2pRnNENNoZ_QqJFA&oe=6A26EA28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0LqAGnmaCQQ7kNvwGyjvP8&_nc_oc=Adqu5Qwebumsiw9L5kK9223jNLPgWf9SZRKPqVHYOP_o1xyJvkiNsNDm_gx6hVkQt8M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_UUiWmDQJFI5whNAjl8UIhJldXsua-23AmZKRDqXKnQ&oe=6A26D9AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8Sk5PKmuhgQ7kNvwEv7Stv&_nc_oc=AdpqJG38I0Q4aQpvssM4KgWryqOaTZrjJAtIiQWYfzJLB9xCiZ_601ZeAgfPjbQ0hXU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3xM2MfhyhWBsutzKtL52xsjVA_H96CvZrlbLnb3mJ4A&oe=6A26CCDC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwOVU445rYMQ7kNvwFfMx0G&_nc_oc=Adpj40k9XhqBTOfQYkaapbnmGzdKxVaASwe3ZXCdbr5OOJ_D8OqP-RJG9_vc9_J8_SE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90IIY9po_1w6F_htZTfu58L-4Ly-yaDwxDMwBEGqRONw&oe=6A26CD91"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RxtdEQeOf0Q7kNvwEe1Mdk&_nc_oc=Adpj1BD5HYULMPYBXV5OVEgQ1TRJDpiBYKTQYNRaBhCQTOcPRx3JjvLpw9RIbTOBpvc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OByfnY7JBRXuiFAjNDVX-U9HpTO2
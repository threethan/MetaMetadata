8_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxxKXyx_GIwQ7kNvwGMwDZI&_nc_oc=AdlhI8pD8QUanzwpWanOkVBIcz-HkMKhbSG_TyvKz0Hn1J6czjk_SJNC02FzNBUwnXk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsnh6DjVQu5CStFOGLTtaImxgXdarw1Rx8b1JdHjlAh9g&oe=699AF2E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOJTBIc-naAQ7kNvwHeEYU4&_nc_oc=AdmS0ZqmY1o7qcmi9qxktrdCCMm-mI3c14J-6-kTCq1WqnwkKKzpnA_X1AujVA7QB7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvpxLtuKcHHYLERgdnq62hBNP6cLHtjSWjO5DYfwTQtAQ&oe=699AE26E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfkr_NJzgfwQ7kNvwE_coos&_nc_oc=Adnaxl4Y3-vaQT6nP7-9k_A3wLtJ-0PyZ-L0tS7z8lKnAE7YLN1ltSG2i0V4eVriu_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuwHilPal_aN3kWx5meXG-VcCdQ53XJIyZQSB8RCixgFw&oe=699B0DDC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfuINxuc8EgQ7kNvwH81b_9&_nc_oc=AdkX9INXOUfS685OmA0atOCml3-WATlvymWWuXqRePi9Fl_7XUjn-kkH4DzgsOzhkKw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftiJMirHezn7COSIhqa6h-Bycm7bsSPYSxZjfRVQBxcCQ&oe=699B0E91"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl0ZhbtBK5kQ7kNvwGhf3uq&_nc_oc=Admb6NUrLu6QDoa1eU6bBbpBjw99SS24aw8pJgX0VVjmXFKrwidg4GiJKZiD6N9s7Vc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftvv0fq9m9u8-G1JIJsoK2n_f6MdHyuDr4Gmegnor50qg&oe=699B0B21"}, {"file_name": "\u30b9\u30af\u30b7\u30e7004en.png", "id": "358753645175787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196230_358753648509120_2869682868110300
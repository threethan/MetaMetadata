0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UMqv0W7Cj0Q7kNvwHGb0YY&_nc_oc=AdpznMWckR7w88YAHQQyK1yMRZQGWfvxe541z9Ya2nZWCwsCyEUIpqw7eIdASmKr66Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN94at_XhK78jyvO3gdgXjbNSVVq5lJwhSlKUepExlbLg&oe=6ABFD828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_2v1ZGyQ44Q7kNvwG99Tf_&_nc_oc=AdqLFunWXEEERULXEn7Cewu4rZEK5VE9bbYAe9YKKcopZn3aoeMhiaxvziQ_yR-5Dac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtPys8R4VDB8iZLMHWYl0FU8domcPmuPfubLiWpsvZbA&oe=6ABFC7AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndE0xylB6i0Q7kNvwGt4ELD&_nc_oc=AdrSf6iIm_-qv2WtB496NPZxX6qigVNfQ9czO-Ljimk3hxOohFFJwDgOe-K3BKyOfKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrC233Qhy9JIQJUR7G2Xo7yk1T1f6lyrMhQl-PJ35KzQ&oe=6ABFBADC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvZVkeufsPEQ7kNvwGikME6&_nc_oc=AdpKgT4tLOIxbNPXE-0obhmtfLbY-Wkiv6t5y7xx7pT9ENBm2zHSe2mxBsv0ayK_6Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdypA6FdiyrccHWUodckWykDHTAASSDTMMsKFxavc6uQ&oe=6ABFBB91"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN-bwne3WMgQ7kNvwGGzbsf&_nc_oc=AdpPFAIcef03T338oydwzR-23_bR4PZRYASZ5TKoZ7XnffO7ZrtjqdEvDdSC7o_K3kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqTRKZk-pj-TlgfQFEhVO3rBUNiN7
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r4P0aZRBpEQ7kNvwFE3v2v&_nc_oc=Adqy5Gqui7bOGuVwXwEtXYb5rVYUM3qUcnFli8nVBy8hS7Eb_FP9IfgUMQrxbk8Rdbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj60nelOhDEPKrv7DpnuBlt_49pGZiczm4uXnj0J908g&oe=6AE76528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exezx27Eo5IQ7kNvwFPQ9Hq&_nc_oc=Adou9UZcv6Ti0twb-Txt2Jgw1aV-Z01j5lK5M39DrTk70LOQG6nho4x49d2LMlNJsWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS28ct75gAaddas0GLdThuufp2UJvn7GaHKr-m-AxsEmg&oe=6AE754AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3xeYUCD9xQQ7kNvwFSt3sq&_nc_oc=AdrKMAM50BJPOVqMzAFjbpS8JqeofaJhyMOholEetpLWn5Os28-aiUIyNLV3xhsmyGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyGXCm-EOTmiGhmN0s6WRm5yEgqDDW77YGU9bGRNmgfw&oe=6AE747DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaC9mtgkM7kQ7kNvwETWxR5&_nc_oc=Adpqwr2ABfoSI__BMb58y5jCifxqSFCFaDe76lveqcrTZgMNO7gZNwjSkYkJxiCO5yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeyj_Dzh1We7SQKvmUWxUhFjtvqw7rcyN-18VLhaGd5A&oe=6AE74891"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtADmzByvbIQ7kNvwFXBzag&_nc_oc=AdryZg8-8cTI_ihH2oa-cXxM3xsBtvwq4xk9tsTVwdpmu-WT_K8HvPMpwX2AO_5xjT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGhaYGU9kEtedx98eS0AAY_CTG43l
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoeWIST6G04Q7kNvwHpa9bI&_nc_oc=AdpA-gVNgnDvUUROuFe_OYGhcdwqpV8Xp54r0_VbJxZUT1OCXdXHL4Xrmx3mYUl986o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mPAHn3ndOaqVLeebPNLzVan3wQJjkmf3wdWHXIe9Yrg&oe=69E61868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_aRdDKixZQQ7kNvwGajqR3&_nc_oc=AdoyKmR9whKHDVwksBnQa7td0nc-Lhb5H5JNPFYg5XF6UCVRMsC-HGME8fCl2YwJqas&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WRqeD0ArX4KbXpTywj5zv1MhoZREsbWHYVAdTag2L8Q&oe=69E6402E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNJFhNrweVQQ7kNvwEMIugG&_nc_oc=Adr3ocn7VM3sv0qi4Zct9jLkbgJ_buyaRe39WABr7V8tK2Moy8HQGjHKtuLh7X34WDU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hTDO_no3Muz--btqikBwjua9l13FWx-aPU-UJXkgBDA&oe=69E6335C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vp2krM9vicQ7kNvwH_5Tnv&_nc_oc=Adox1sKd5SOr8k-SNEjFgsxyCrEDdCGbNHCDX8cl62IWisYGORclF-R_Zl8MOgIrtDo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I15I7_gXem7EC84M2qHlLGNCIQOxP_cGmoFWLpp4YZw&oe=69E63411"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQTtPmwskG0Q7kNvwFOFyuJ&_nc_oc=AdpemluJduJrtU7mnXD3jlfkogweTPIqiFuH43gRTu8BoElpK9O4yI7Rxf0QLbPLQAo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z3dfcqgQ_jSiCtC5VTW_Q7UsSQzk
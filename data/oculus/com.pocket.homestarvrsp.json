0e7005en.png", "id": "773125536591078", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNX-AJPom18Q7kNvwEM4Da3&_nc_oc=AdoFlzbIsH9SvM0oxRHSrTK9TkXWSJuxZPJMeKVJX_0qC4HBPi2fGugq0aCOpDr3cHo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL84wJNy2TBpeJ0mwBQY3ht-ntIj6dpbDFJN9iUzkBmuw&oe=6AA14D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKhLOKfXXuUQ7kNvwHmzmdE&_nc_oc=Adp-B-V1fPHIh8rxMXIYy4tfRcrWgItQV9qaBihTO6kEXthhRLjCUTdSQ0P-mJcNwTY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt1GxQzreMzeGW1VF2nWzzp03LnoobmGEv3jnmyHogbw&oe=6AA1752E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYaSzkqruCsQ7kNvwGpX74m&_nc_oc=AdoMS-ohJMvdqxKFabXbztkGtnsEm3eWWMHiYVa194fPzjOWbbt5paVZAYcB8WRmngw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxfNUdvjKFkn2Fb5CaTQnP9w2C_nUu2Rbo0TEFKqjKXA&oe=6AA1685C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAnxXtoRxnAQ7kNvwEotLC8&_nc_oc=AdphiJhLrcS05zyvxUwomYElgzrCv8H9rqwVqo6EVjmITnFJiGUocpSilVLWhKA7dnk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNcHS1lzoRNCIx9NM_gkgrrojhh1v5GyN_l43Xx3sCzQ&oe=6AA16911"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRtX-kX2ZTwQ7kNvwGREltv&_nc_oc=Adq8iJqIYdhO2hlGvOIhHyjWsiEdqE0yRHhTVj_1Mm8YOAMDIOo0vmGh98bFk4Tu24s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-P9aURJsWEuJrYMhRf6CG9vNnIvk
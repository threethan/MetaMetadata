0e7005en.png", "id": "773125536591078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oicdn8Ze56sQ7kNvwHcUQDY&_nc_oc=AdqziUegkAQSC_9ibsYlU88MA6xOtbh-JFxv7qyfJ5lATIiJO8LxRVibT3CKHY8WmrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG5KP52cR2yyljr9-hmxUKew1XctHMDA9Ybsi6ScnWXQ&oe=6A54D668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khOBKO_x9ZgQ7kNvwHpbWO7&_nc_oc=AdoGvP2M-TBoh6bMyR1pP-pYSQAZfsmfp6Aqs_gi0R1U_z6RfeZZ5QCZe84MjZf_f-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR9gglUvUabzfsJv5KAmHTXvNDehYcAXMsbTKUT8tOmQ&oe=6A54FE2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B10-LpKjzK8Q7kNvwHCcv69&_nc_oc=Adq-9QllNWPK-5VLWXQkMDoUPx26aZCaO90ZjCbyh6OV1zzIM8IUirBH5hMfLVayg_k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA0hrwXq3GlQuGbz4KUv5JNuFTPREh204JqTVg28fPLA&oe=6A54F15C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX4b-7Z7shkQ7kNvwFCrM3-&_nc_oc=Adofw4tTo-VvHOiU49Xf3GmpqLYh4hUvVMvbg3fV-IFvJbs-8xFXAl_G-C7VcCP7oG8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD943fr24ncU3WflQ-o8tBBDJmI-2Hg-2wyx-Xee_lbGw&oe=6A54F211"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sGdjn0yUB0Q7kNvwFcYebD&_nc_oc=Adr7v4JsPYVbuGe55BE_EpQjBDZQZmFRZm1Blz7hLYFWX60ImI4C0Yx8byGDzBl8n7A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm8Od2cc5_It7v09P6D8Lk93w2UFR
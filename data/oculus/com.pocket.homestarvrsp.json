&_nc_sid=6e7a0a&_nc_ohc=LARyJRC5ZE8Q7kNvwFrM-CD&_nc_oc=Adra1MkTiCIeA6zr4i2WYJeufPov2bXHidDnLKPypp0CFiVWrXhsQywYNoiyXBEL2p8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGxSdErS_1FO9ucs8EkjX3CIQbRY3DJCQknW6npCfwig&oe=6AFF0C2B"}, {"file_name": "\u30b9\u30af\u30b7\u30e7005en.png", "id": "773125536591078", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8wvp5CvNm0Q7kNvwHg0mVj&_nc_oc=AdoNrVB8FdLitwl2aZp3JjnlBMU5knIWz6ylwUUYW4McScdC6DIbrO9KQQ1omIeZzz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqLFFQNse9BZLsFsOgDKiS2FXPDU37leSDWJSslsMCig&oe=6AFF2028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Piy1FWj-hP8Q7kNvwFIXe72&_nc_oc=Adpdl5-Ue0sYWGeVb2QW_fDQkwY-iIUAK0eD7iJq7N4V0vlEcKajTtnMr-vhcxw5g8c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyydK7EHAKckQQsx7sYC_Uq3tjSVJUTPKqd11KqeDSYA&oe=6AFF0FAE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swNxn8dFliUQ7kNvwFXteDy&_nc_oc=AdrVIGtY-BBK8yqFHtrjKIOeygtgB545R9p0YsEz3xtRwQuGQ6sY4swQw6dAUot9jkM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWmmFcNLLxSz-ctITtOxt2NfPcvNvphaLjXdv6vyUqgw&oe=6AFF02DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO5_3vCvDNoQ7kNvwHYsoAi&_nc_oc=Adq6tmG26lvPh5HkE2tnlbKCp7TtbKoVKyx4TDm6M-F9t2F5-Lw4-Q088HI2rpQgdn0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXICVaoo4SppG3BxT4E3AkfTLfB_m21RsT4p2s9aOgXg&oe=6AFF0391"}, {"file_name": "\u30b9\u30af\u30b7\u30
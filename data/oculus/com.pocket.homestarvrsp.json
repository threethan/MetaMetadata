0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOydIp8uUbMQ7kNvwEM1I28&_nc_oc=Adr77WXoCAHDeqcfZt6R0AtoDuicYsGbRgZLp6wRMjhK5JuofQvdfVtsX7xIXoCrlIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09IXanPBvgz-BkN7SpYqOfhh_LiQ8POrrFJbyB4d_d4Q&oe=69E0D268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4nkqfTRpF8Q7kNvwGuMIDM&_nc_oc=Adrc2wvhnlUKKzGBhJzRLPi3qW8BLt1xsNUu5RFXQhGzAFxt0QHwfjvSJwDpGIUkI3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Uo7hMD8v5AMdk4LW4VG5lRSi7ycxpQ2FJSOB5kXxJRQ&oe=69E0FA2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFY_GqEHNsYQ7kNvwGZiDn2&_nc_oc=Adok3DgTkDyzrjR8AaBkta9kiiV7GIPU0-fsokZqFuOYW4h1rwmYJLEEzIaZw1bVhHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YaMhteTVNGT1dudfgv3ozv9vQreWuE7mD6f-IAREjMA&oe=69E0ED5C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slK92T9lYwgQ7kNvwFlIM0Q&_nc_oc=Adrbj_WWJ2AxwfqxjLWZ44zYXAcVMD0pP_asA3NM7uXX5WQvyZzcPwllPv1chFCZhxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LjnMqQvDPtkjkGg9C098OZMI5rGGim462kYPJktz8ig&oe=69E0EE11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBOmGG4RJ2wQ7kNvwEZ01tR&_nc_oc=Adp_AnyjtSP__LYBJ1YqwSTRBpAQ2fqZejab7Id_yHT0jSJqfHv8_nG0n84_S4yiVDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KbXKw6goEJXbfoccgeSR3KOlTgi9
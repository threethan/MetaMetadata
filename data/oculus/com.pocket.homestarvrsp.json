7\u30e7005en.png", "id": "773125536591078", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EamVi8gjfEQ7kNvwF43rQI&_nc_oc=AdrblQ-PX5BldazzlOsZnszgvFIZdimgV6cWSA2BB_EBEX-XSyhoA4McJbV7QHJwIG4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5SQz-YWRwT16_E1nTHZGmV4_Ieo32SwiYbJBihkh0Rg&oe=6AA3F068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKhLOKfXXuUQ7kNvwEoJ0ER&_nc_oc=Adp8HhpCAF3edf7vweRApelBzxgKoETUfpI7Ev16eeX6zGDxMvz8NLm4Q-7dA2Ob_2E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItwmKekbqWV9fbmQIMyL6LUy7HJPndHlLQbYKXyUJmQA&oe=6AA4182E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxecY_isuGsQ7kNvwGjPoFD&_nc_oc=Adr6Al_jWNQ1LsO0RYbVst-14HhhrP_FNNIyXbQE1kxhoShkHCpJ9jWoMZptx96FVsw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLTOttJ03zfmIGkSmoQHkLkckwz-j8f6sIcSdLQVPFeA&oe=6AA40B5C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SMHMe_yDzsQ7kNvwE4iBA0&_nc_oc=AdqNjN46GEejf7lrK5a26FH-4nvo4kiQCDNSUlNS7PDGwkWWgyzKWqdaspF4qoFmU8M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYyslBc7XV92nCVwq_bZTDQaI3cd_uaiZSipvDlW4THg&oe=6AA40C11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRtX-kX2ZTwQ7kNvwFrqZLp&_nc_oc=Adrp2imyI43AzdDMnadM9KLIc0YCWSDoHIrrYhhN1V3e4LbB0US71KaVMSG_fGu5Ge8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdios3U5W0zkOQlibqPp1
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI-h1WW6oNMQ7kNvwEpWPeP&_nc_oc=Adp_4mDmRTt8IAlK4e1ayP9BMW0cEeXze6ulkaEQDVDkzUo9rCvDi9Fw8w5u_MnNPe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMiFSulQE3rcgWgabhCpipWUqrVp4MEVqN-DbuY4sA8A&oe=69CD0BE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df1QUUTuCT8Q7kNvwHLp9Kq&_nc_oc=AdpLsbfqcSW6yECfMRYZt-As9S-QF6jV_jSRL5pGsK1gTQDfM-J5y6r5sfG37EvIcpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLvsa0AZ-TnTFm6QeeZ_FCmGdeYSr_7iF_HvQ23PTpXw&oe=69CCFB6E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUn3c8NaH-oQ7kNvwGsHTZj&_nc_oc=AdosOQBvHKHn1dwHmm19PLZvM8OPKBe4s5vC1IrAR8aZzWYHTPTD7VOiV76ofFOS7Rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZxkJYzKek9yRZM4Zyhsd6LGEi-z9HDxGGzV0qGK3rgA&oe=69CD26DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6k83ezgNEkQ7kNvwGTSmoF&_nc_oc=Ado3gTwa33mxPuzbhLQou3cCHbsWOQeJpivY0xtgSsNq-TAek9O37GcY4FUT5f0ycjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoTg3uWULO_XQJ7oqOnqplrM3sZGe7gLmSlU9yduobpQ&oe=69CD2791"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdSrLzCtLVAQ7kNvwGPWvrC&_nc_oc=AdpAC1zsuDUN-_fU0NerOacwALtgsWlqEAqhyo24y0tVEmJ9uep0SFGptvUqnoD0yJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzB38fusUixORx7sROpWR06TZ1jsSb
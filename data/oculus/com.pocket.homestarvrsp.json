0e7005en.png", "id": "773125536591078", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGX076I7z7QQ7kNvwFvzaO1&_nc_oc=Adq2uhkDrVXRjscHDXUATJGVb0ybYrN7X9TEZtXFLIXErKLAgf984ooAOH3w8za3CNw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HFPpHUA6zuPul1LQApQC707h8armW2soOsE8fS0hBrQ&oe=6A2C3028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqYxAeCEaJIQ7kNvwGbNyFK&_nc_oc=AdrNc8ktM1HD2ovP1mxXqae_Mw70swDIuWHOHVgEm8s45WyKqat_TcxCZiMGlNswfbQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oWzruqYhKUPtV6puw0xHXStfLnhM2zTGMKQpeG7pG9Q&oe=6A2C1FAE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkPtd8imHQ8Q7kNvwEHwSq0&_nc_oc=AdofzdxS6MY_5cawtyDcImDW1VYquQiVtQ1zrWHZY1e-OrCwI4SxSRU92lKkwGJGJLw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-90xTOosggNA0xyFzNayF7hp1C601vwhBYU3Plq2PwxQ&oe=6A2C12DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQmQL8NeXjYQ7kNvwHNki1Y&_nc_oc=AdpvZRtueZPih9NHUgEADDa_YLB-DpKq9ukuMnJA7p_uJPiiuh9H3FSH80McennUirA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NkEY0lywEDwzTERiLNM92BOk5ZxjI5kkjayUR0dMbNg&oe=6A2C1391"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltrhs40zKBcQ7kNvwGYonmt&_nc_oc=AdpZ3EjqTKvLcmUmEP_zXszHt9_LN_pwpCCv5FZ7YoVDFJjyZZZU1W5_eAPe8sh9tro&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ViFxrhxC948WNy4o5Cb8vTy6XAQf
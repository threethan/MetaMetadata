0e7005en.png", "id": "773125536591078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYRhXSlGGN4Q7kNvwESc-Kk&_nc_oc=Adp6rQvBSr3fyO9D1_rIS1lBIgXBEx6u27H2Nwbj6ihdxubFOzcFGfvgVwSxgbdC8BY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-dTQcGNJ84ZxgU6igHrWXVSuRdyFz4kE8JLvZbMCGZA&oe=6A69EE68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1TFJjFsZd8Q7kNvwEs26cP&_nc_oc=AdoDGNnY_FQjPM39J1Me9RtlN91F_JCSJn78pupIbBViZz5RTwpO-lZfBql7CBq2-VA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkdUAlzDdFEh8xRqf-v0W4NB6suaUhZJoH6rF7jvgJVA&oe=6A69DDEE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNYOzadgKXoQ7kNvwEyedYH&_nc_oc=Ado8XtIhZ7gDZnvMLkWqZ6ZMiQYiDK-k70toBhgzFSgCcSwLfV9L7KuBD_6i1OmJtMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD40EKr3DksADNhO2eTiQu9qRYpNGnBYCeZh_OlNtE_2A&oe=6A6A095C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwE6cI61BgQQ7kNvwFkITfq&_nc_oc=Adqi5NfpXdQ8DWls5lV_6e3A2cSPX2M6d1KtYcMTifAzK3DgxF6wfGHLSLDkGbu4XAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM0N2GW2So4ZY_JUQR_8aK8KqZ251ebcQ1NsQUy1aIfw&oe=6A6A0A11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBP7__TvxV8Q7kNvwE5A0Yz&_nc_oc=AdpMhq3EWzGaoXVvyCP0_aWhGWi_qX5kAr3qXWN3CiLHQ2z1lH4xMmSK7xJRcIE1CNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3WuHYcddOKP9v_xX1ZBwtsTzwVQB
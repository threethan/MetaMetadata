0e7005en.png", "id": "773125536591078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZLDrrfGOcIQ7kNvwFW2DNn&_nc_oc=Ado6GRYelL9Nc-M49if3g1cagoJ8O7-a7vz_Nww6dftGcjlg3jj8mbqhrf_z230wlso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf-0yblLAH2oG82Px0tZoxGimKQpzhDl2vNRUsojhC7Q&oe=6ABD3528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_2v1ZGyQ44Q7kNvwHsP5ac&_nc_oc=AdoL9TZxmAz2YN64nJso56aKEFWiqG5_achimBlHRLUkLoDpi5CXeYTtEo7HbyWNN7s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyTtx6Lc7Ud5cZV5wve7FTnmvV3MBJRRXbi3vKiTTeSA&oe=6ABD24AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUj9LDN1VUYQ7kNvwGHcly0&_nc_oc=AdrgWDZTO94iHdJhsOzGFh6lD_jJyB0QPdkw4VY8UzbUz0AzNQH2mIRjw1D92PhLtgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInSNsP6EaC6-AciaXryLvQnoUYlQAEoQQ4EL5rJCMIMg&oe=6ABD17DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxZheRLITUUQ7kNvwFD8CGJ&_nc_oc=AdrBrJKs2wmX8mxwvSZN7vKZB8qQx9joK6j9VVYuBpRIji_cCt1fgNjOxpwVDx8BPmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkXPP8T76MGX-pm-Usefdcx3BzHSeHHgstLCoSacq4kg&oe=6ABD1891"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN-bwne3WMgQ7kNvwGXwuqy&_nc_oc=Adp07l1ya4OPDWtDF6DuXW--sNLPZR3ZAiJ8nPcvnX0H2wkAZkIjRdY-dM0YVTHuzaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyYl4bGtJ29DBI6jwr2AodoRNICkG
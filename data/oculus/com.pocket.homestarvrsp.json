0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dvhb6y2EU7oQ7kNvwETtdmh&_nc_oc=AdpejjBM4RtH0v9nPWtSwCvTsr3mhZvv1TEt7w2fH568uN0-Ebh5zAFthm1NMasfc6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14G3nlDwH7GhG8QEL2iQNkPW6hvHkLtRrgQk2MRi5QFg&oe=69D3A368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOK39lthvdwQ7kNvwFznIUY&_nc_oc=Adp0XicQF4SDIJlChfyOMPeuUW0fj6Y30NAOoGrEI3vd-MBgDQBrJHr2uQYJKcRnq7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E2hDJ7wD1WKfELZ2aVoDKMaRjYcTAx2UIxkFd5FjvwA&oe=69D392EE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjOAh25QmOIQ7kNvwG11VHg&_nc_oc=Adql4FnFJC-isLBSAPMjwnZnxATbpwB4c1o10tYxwGcb9Q0PxOvbGjlz4uGcx6el40U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28bG72DGT6d03gGIhBxqWhEms-2oIHKgZrCip3iOoeoA&oe=69D3BE5C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sdl4s2puGXcQ7kNvwGgr61S&_nc_oc=AdoagJuKZyr4axfOYIpUCtteYucYkWKLzziAsIJubn1jYPKCTGBhzKS8nyqK6wmLL8k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mnxxi--oQcSDuWiUfs9jFS8hVCEFECKqMbvL59ZDzyQ&oe=69D3BF11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bl6rp3sk9kUQ7kNvwE04-1S&_nc_oc=AdpX-L202aQktA-gw7vNHvWYcakQRe5BBvElCWmxIelH5KPVz6W6Vp3k3wnVUbsB7jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LXMUza2JKNyfbRhR9wmST512IO0f
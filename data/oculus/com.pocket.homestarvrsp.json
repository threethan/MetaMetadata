0e7005en.png", "id": "773125536591078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eRGSgqEkR0Q7kNvwFILjaF&_nc_oc=AdqogKjlPaK2psja4FBOYm5mABUzsX41lffyqLhchRug2A8C9UgfiNjWSg_XVyHYvAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mVGsc_tG3gvOT245dm_C67bJv2jQBk1CdXc-6Yr0rtA&oe=6A380DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JN79B89kVQQ7kNvwFQxob4&_nc_oc=AdqAxGHAE5r8137eMP8xUlfpP5SfR2mO5bB4O9te1mpPRzWgEopMaUsOpKDillVVfL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Y8Y_opTXL7HDVJW-Q0aglcEQX3UZJTcPbpzMEb5crg&oe=6A37FD2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6D6YD_h9OsQ7kNvwFk8D4i&_nc_oc=Adrgi6uwBguCFIqEb3hSjyL-ss-mU-dV1et3T_FuABeiSuGygUEM_F-fGEvfze8NXbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q3UTB_PA5aV6_7A6tYr-FLiscDVebNs21vgrqyZSXig&oe=6A37F05C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxAgVvOS58AQ7kNvwFA2lFC&_nc_oc=AdruK361zqntLDpILHBQcZeWOcCvU9JnHpQRHTL2E4uLzZT6IMNLkq3Wnw30QxFGdgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IFC34ZzpBHS5xkCpeMMpqm4EfMWrQLSUFpsiKw0pS1A&oe=6A37F111"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsND5AJoiDYQ7kNvwF9SBj1&_nc_oc=AdoYwadRh7vEWtHdsyx5SGy9pJ0HeIthAkoPQgZJrSLobbaipej-eKNyhS9Z2a-0aT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-avb9DQp2mWDfpZ8AtP_TAmjeFAei
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-ExCVg81p8Q7kNvwGYmbrR&_nc_oc=AdrrZOTk5SBPFIzWQms4NBKHVs3ZMX9VKkW0g8KgRmYOSE0xPZOYsoxiSquhOAi-9WM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMggTqPhJ8il8ayq4keIAaLgfHc0PTyv6kynyo_h67uw&oe=6A60B3E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLKaPgUio8EQ7kNvwGUktn8&_nc_oc=AdoaStOzp_zZil5kN4kHppcUnb1iMVE_GCeIH1DZBUt4hqjXvy-7usOHqc9UxXyZoik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK983mBf9yPs8PuCr30rlpWJG4ipY-TCoUtPv4IvL_BQ&oe=6A60A36E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYvB49nMURgQ7kNvwFprVKg&_nc_oc=Adoxppbf-X-2VxrVvEpRob7OGHQOcqer5r-QPrsmcZ2FQ_C3-r2H-bgZi2hxBJXbJJM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSO-Zux5J0HITfBDjuisy1_FtfqGn0tEZosdLJTxnCbw&oe=6A60CEDC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3mBEzqcY8cQ7kNvwENxQAs&_nc_oc=AdoWE7MU1LYKfHwHdDdOHfywcqrF2SQlzl9RAsGh9QTHVIEMGQ2kHuzmEryoMzBLY-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiDb7IAEYUtdUq7bDCYE6aL22hu7PqxJAbapOoX_5Jow&oe=6A60CF91"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb6LhnqIeZIQ7kNvwFLBqo-&_nc_oc=AdquKTT2BAsTm3ITb9pH8jHGfMlOjyl1a6Zds3CRBrqSnP9zWNBzOPuTsyMsVEsTWuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4yz3yyLnxJYxd5QCoscgziHOfiId
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mYKGjAbls0Q7kNvwHGytce&_nc_oc=Adoy1mvdbt6LS_baA50Gyba-clogesGQ3YeqwHLN8d-kRWnaERm35bkPurO-jFhcwVM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFK5UIum83N7Oap6BOpm95HH_qtT6CKsLaBMUFja6olg&oe=6A8057E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gTMNqiNxskQ7kNvwHtL9pp&_nc_oc=AdpO8XYZ5mzIF448e8KefHNXF0TCoLwTU2yQY-G7DPXnnIhAnjkSN20UtI4EK3HkbyU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXzv8wXQ1n2pR1m5n1ohLXNmgALKgZq5k-4R6oB8hdpw&oe=6A80476E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V2rjj-Gft4Q7kNvwFqYS4f&_nc_oc=AdpTmebW_JuhfuelZh-ijYgsaibti0sN7hav4D2FJ6A1WSMei2kJtdhxYLmoyHuabqI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWxyALnRag7GaPFtisJUbtksfPF0TIgXeofcl_d7HvKA&oe=6A803A9C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8PK3I6ooiEQ7kNvwH5-EPz&_nc_oc=AdqgNXOK7x11ycPUFeln_LA2IhnSBd2G0X7PUWeoejXCNpd0OObthVHUZPeA-oX6_80&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ8wvrli7i60Okhl6FP8I1Ue6oKzB9xk45F-bWhANDyw&oe=6A803B51"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2q_tvfXuI0Q7kNvwH_Pi5p&_nc_oc=Adp_HTEMBM9bcCtijZXdo8ewrNVm6QyRA61t78J0X_LCcRgpCzktfZtaWYUd8CoXILc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdKmXl0-KxQ9ZCpKOE9R6vb0XT36D
8_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IFaGPBZAuQQ7kNvwEX3-mm&_nc_oc=Admqh2_RugU-oaHHH3n_uLIrJ6qKHfRz6iuKnNUCHKl3jm1MXXsO2GrEfWMlrs7i_00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5q_yh6VOpG--OPmdV_wHYu58Qggq6nePP6GfuZ7V6mA&oe=69A038E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7uN3futXHcQ7kNvwG4Y2jj&_nc_oc=AdnfANk26N5jthMaboPOmeqB2h7poQ4vEJLfMpT137dld93VEF_OuYkYJtXM7MrnLB4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxldmzMRussSJnae-Qmjr9ssfq79YxxczMQg7ZNpGr4Q&oe=69A0286E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmrCYritzFwQ7kNvwEmyhqE&_nc_oc=Adl4OcdRyWOMiMNk2ZcjFMkD3PtEjDDrrRqBW9J-uJPgefAyQepb3eMi6lkR_smtBSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3-ULxZGomOIXvNXlYvXr8Evm6MI2xu1B0Mz544QWWGw&oe=69A053DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBTqWpp8X6UQ7kNvwHW-MyK&_nc_oc=AdkXpbPBQLxjq0wAImGANNAqnSEzKpyJvt6k0MMjQILVRhCyLwSGAfQn4odrwzQlQ-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDktqOWeu_6PhH1asYAfnCec6AO7RyDUnkr-_jRne2cg&oe=69A05491"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0jXRG5arrcQ7kNvwHaYJ5S&_nc_oc=AdmZTUhhpowwezimMtBOM7_dhfwjKiEWwTl9jtVQVka_PXopRK8CVKTytF5R1d2r2mM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvxWSCJp5veHnZcrKQdEuDffgFR_7j4eQEOwTX0QWYKrw&oe=69A05121"}, {"file_name": "\u30b9\u30af\u30b7\u30e7004en.png", "id": "358753645175787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196230_358753648509120_2869682868110300
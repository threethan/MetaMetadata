0e7005en.png", "id": "773125536591078", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqcU89LgVCUQ7kNvwF9un8p&_nc_oc=Adqio6Dhby48m0FAYkuzd7HnVE18J29Tn2YE_9e1DIpyS7a3ySh2wgSE_BVNvbDuYYI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGThEI5i9bpBIqtczTm1dW2pQlGWEcZoBK-eitj1-H06A&oe=6A917B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Orb1ntjw5QsQ7kNvwHij0UJ&_nc_oc=Adrk4LhGv2-qodLJ8XzthoLHtAhyjWfFGdk780GZSUL8CLnaCcCCDYMHfB12CaWKglk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhUNypWAUKcmX7YkdyVyQKVAXPuQ6OSdJEEL6JHUG44g&oe=6A916AEE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8qxe-KuGBwQ7kNvwHlSMGN&_nc_oc=AdpoM_NL0AhgtzmUrXL-nsfdllnN9Oy_hXIONLNPulZbeJOJGUwilR1l3_qAdDU5FCc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmR57u-VqX36gO6Ju7vLF6LgBXArkYyOj0g-ZHk_PBRQ&oe=6A915E1C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iCO1PDpzY4Q7kNvwEdm8pz&_nc_oc=AdrFS8ZmfkRuR-Ug4iVwspokfxMPd34d1zr64Wa93Xh6Ggh1TyPvlsfA2v3GjXnqHZg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw7XJ80WreiIdOt6rxIEzYO6zqBtW3MHvUVQzI1vd6SA&oe=6A915ED1"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar6BE3eLlrQQ7kNvwFVP_d-&_nc_oc=AdqM0TJL8hf9rf-_bE_SNTkQb2ph1DQ_EfPGzE9sqpu4Mf7PBKBPF1E5zwGI6Fx5mBE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkZis5_kYWhBGs0kZIqePCOZimbey
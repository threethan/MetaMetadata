0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ealuxALeoFUQ7kNvwG2A4by&_nc_oc=AdpMX5L6Hk5q5i1m-DOSFtQpsw8BWxUrSeb3cJlgGH6bv-MfJhpm9Uv7fpxw9wZzvBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MCL4w9S7HdXhB39YsrmnEBoz6N09BtvP5uk9Tv8SnBQ&oe=6A3FBE68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWLfvRbFFQ4Q7kNvwHvUKX9&_nc_oc=AdrAG2rnE4PtUrruquAiinyWzvTGVQclv-oaVY-jCEiNlQU4Rt4KTKPulB_QcjAHm3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sSSyomsSsgQR2ieMWpXsWrrrCpS1W-N39tK2NY-7o3Q&oe=6A3FE62E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Yq1tpFTdNAQ7kNvwF0DmKU&_nc_oc=AdquBN8cq9mGpKOPP-lN_x_8bpihkXJDS0m2pwA3syvobebS03rcE6LwxuCRryCUz0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qAGl_nAxFC9G1inWp9I353Azy_eDQU_jdCAtfS0sk7A&oe=6A3FD95C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suk0GQW5rCMQ7kNvwFb9oJO&_nc_oc=AdpfH-GvNReVwoI5yzLVcCsi-f29uQbZ6IlKezKICDSdG_YGrDhFFncgu9FyRS-iz2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IXA1cxEWHTXHGwjNDAAaHpuO2sFFLax4f9IiW-8OOLw&oe=6A3FDA11"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhKkZrdEIskQ7kNvwGKKuVE&_nc_oc=AdqS6KIkT30VBJDqSabxz71LovIgi5Q5u1Gznm_YpICChfgy8Qcj9-46yPyBuigRph4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_nOn56VOKHBEIo9exjCV4BHvKSk_
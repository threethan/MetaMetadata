0e7005en.png", "id": "773125536591078", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmf4dJZ8g6MQ7kNvwHsj06M&_nc_oc=Adr4KtMNpIQ5GfVI9XezNtYLAMqZJE-J8qbogcKC7p0136e0plj7Gl9qkvTwa3B7no0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Uh__IqVI0952TAWCLpT61rmeMGDCGvFA9K9bQX7Pzg&oe=6A16DFE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBRmQjRGh8EQ7kNvwGyImxY&_nc_oc=AdpwuvXJ5LHwiQJvBeQzmXHPnDcqgWi32fx-o2bHYCziluMD6zKRyOPTR9jAmhI3uHA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PQ_-T-dGiix7jRel7XhDs3DHfBwxEBhMo0guY0Mw7Bg&oe=6A1707AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMMRV6dRHVMQ7kNvwGRcXo_&_nc_oc=AdoTG_u-0l4fLRw42Wg6j77S-BBKJpHszA5LLaqrmmBc019SfrHOKdb6wVEwifhvQ1g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CTP5z2orFzc3-PnBmzOvi1LKFw7VU5TQSgvZhHRH7pA&oe=6A16FADC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4BNIDi8H1oQ7kNvwHexuCg&_nc_oc=Adq75rajG1Jibgf-hKSO5txEe92gjaFxWkVt_dwCdxwhLGiRJWTKQ4ewv8NVZBvuWZg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51ay2RHp_MWFFMGNtAzqNao2nhT2k5sGXsVt0ssf_74Q&oe=6A16FB91"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCDSfxVMlG4Q7kNvwF93Tko&_nc_oc=Adr9clF4Yo18QxxFrJxKezerUg940mM9zVDt9tIwd9P7f66abjn0n2biGInZTud4uxo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nE6EAWqvT-dquC8PARDyjSwiojLX
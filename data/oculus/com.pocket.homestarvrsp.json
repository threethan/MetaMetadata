0e7005en.png", "id": "773125536591078", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjA_HtJK80IQ7kNvwE23LqO&_nc_oc=AdotGCeSWMgIDSW3jfLZp1Bw1S6SePxafftyOstXrgkWy_tXAAO-26LvrXWyQNcCr7o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmsfQGWawbbDFOPTlnwQdotnUFxZ1sPT_VhbYYakTsfQ&oe=6A8840E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWoV-CqqQekQ7kNvwEP-16D&_nc_oc=AdrzZojsHPcnNU2aRXqo9Y0CJExd-0cEtf2aK6wh7poywe7GrxqXUu8n8bYIyXuGWyU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtReADuoSLF4CgaFtkJnf_W0U2xdXMIN9LaRWy0nUIMg&oe=6A88306E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6_9OyO4kgQQ7kNvwFbi2Ei&_nc_oc=Adr8aqYZU_D6u4dESdwvSXV0VBm7AHAa7Y4uVWN8REhGOU83u3MHpZ2d8jzF7a-Xg9M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmk2ZUvopivhdcJtIZ3rdXROjV4yY7k4UW1fXRJ1dnFQ&oe=6A88239C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE_SAIaKkX0Q7kNvwHfwV7C&_nc_oc=Adoids-lZ2bqWaomWhzWwTSq55kbcPgtYzSTcL1jpm-RYTZZeHHru1OHAU48cBJKXqA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrZvz8J5Of6K_gW2h2f1tJvdgG71FR7DRWiCnK9Ot13A&oe=6A882451"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak52ZF6iDj8Q7kNvwEXrVAO&_nc_oc=AdqdFYeHgtWQpZmRYT7wSBbPGhq6dMFDrQ7pEw-G2c-HF6dqwusjyXJYCFaanbTcyzo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh_zo4qefdEB2F0gHLrpDlzNvUuQJ
&_nc_sid=6e7a0a&_nc_ohc=OpVEFUzO6pwQ7kNvwGdW2JY&_nc_oc=Adq31aNimosoadjeUwUB5ZirGUWLI_q8xK6RNY7GyxFGSO01fMxVO8hoVuz18yDpmhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFj6K5ofdBVu7sQZgIBg_sQWTzQsKu0j1kS78YcIDKaw&oe=6B05A3AB"}, {"file_name": "\u30b9\u30af\u30b7\u30e7005en.png", "id": "773125536591078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIjglid3Hc4Q7kNvwHFN1GX&_nc_oc=Adp5VlGLwdRr9jwjhDZXL_b0eWpbdpCi-y-UeKVdLfHqCYnHvRRU27QvkRnpN9vDQSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKkNBaquR7nlFalrrM20JupPiNTX6qz38y_aMmATDESw&oe=6B05B7A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXl5hSTVsW8Q7kNvwFdmaw8&_nc_oc=AdpErZ6dV0Y0FADE67YgduKJKnZNolOs2GeCLDJ2IxTOEgJrvLayRvR21lY3oA-JDN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe6fBjYHNJ8PZh3jGgMiNwdVum1_sGxZVFQUTjri35sQ&oe=6B05A72E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwHNOhTVWe0Q7kNvwEFdq6a&_nc_oc=AdrmHXzMbiB6cgYKdTX49zr1Kdpu-jZ66izsJfFZ5aSkeFvvaZ0dO2QUF1BjIEoElAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyZnyIvTsMCXHK5RfjXNY3VIH3MvWRLG3ChZKKEV8cgA&oe=6B05D29C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzjSpgvfLY4Q7kNvwEE6AbI&_nc_oc=Adqr8iOwyGxjjNGc421LAKntkEvo4YvmnlMlx5g2nN_x4NRi8Iiemd_D4nmUjJwXliM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuE4xICfoeldM7YhRW1ovtChFqEog6DK6tUt0zBhE2ug&oe=6B05D351"}, {"file_name": "\u30b9\u30af\u30b7\u30
0e7005en.png", "id": "773125536591078", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oicdn8Ze56sQ7kNvwFm2P_h&_nc_oc=AdrZXzIU2z2Km9AlVClVgSnoEajwSISOuQxKJiAFEyeUAXbRTXvhXkXY_fn0wiE_jUs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxEGJW4-F09w6kFjdA1rbO3v3xPV1AH85lxIOgA4_yyQ&oe=6A5627E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGdZ9jwQsvMQ7kNvwEs_PAt&_nc_oc=AdrvsgBmumkKYHez-A6oXLKQxqDkXgrnb8Xwqyp_IGtf1bnY3S6N5q43WavQnvfl_T4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBSaqTOFAawdPr4LtTlGmIaGgthpvrRNvalprxTo5NGw&oe=6A564FAE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B10-LpKjzK8Q7kNvwHfE5Iz&_nc_oc=Adoi3mXu-gHXNaDrP2YvO8mS6mzxHoAlY71UjbhZDRF_Qzy8-uMBxIhTZta94IVVpIs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWMKz87j_A4gyps9pPJ0QjiQOeHmvnAQ9tQZIBfXGnHQ&oe=6A5642DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX4b-7Z7shkQ7kNvwHfeD1r&_nc_oc=AdqkfjqKKCDNejVbwia2iNYrfdoiWjHK6zpJwGNgR2Oq7BrC00hZMK9p489-hbQSSaM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7U_8OG-5jsowCKDPW0rBZISZb1gjEDzfNsjCppew-VA&oe=6A564391"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_MH6hB7TI0Q7kNvwGMVher&_nc_oc=AdrPST8Pt37Svm5bjOmseGhzFSvBq-A590BkVc4B7rfWVTKIXUdE9GnayAcxq4t0j2I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGunMm4cBI9Q-keYLmiZBpNLFqB0L
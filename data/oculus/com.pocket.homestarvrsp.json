0e7005en.png", "id": "773125536591078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2UzENenxaYQ7kNvwEqQaes&_nc_oc=AdpOWjZRrZqcaUiuyVSpt2rmTpGqLBlx2br56m7qFlcn9mbxxEMUSeA8u5urc2Gfl9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrCUt0LNPXeMkkOUWva-YUAFvXHKrYgwzeVbwuhlxVuA&oe=6AC66FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9mkGrkCXREQ7kNvwHkmaaP&_nc_oc=AdrNy38pLHSFhL4QSQTAT-jqd2zAF67CdTv53rxWvBm9chv6dgmzuLpRUlLN_p5n-zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdQMJcDPVVWD9KaHDn6NVzC6AZLQfGTD9IgDS3ogv04A&oe=6AC65F2E"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdubhw9BqisQ7kNvwFcF5bA&_nc_oc=AdqdE5V_cJeuQNGQjsXWEF31I7jusKn8hgUKPGvkS5vCPpBjah_rFDBBgxqHavsvbgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdNB3DJaqi_knxBprA88T4CL6WMLr9Ooi6zes92C2C2Q&oe=6AC6525C"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FV5HBb6h5r0Q7kNvwFf0CxC&_nc_oc=Adpd1oEB0SeQWufHeyxPc14fgVu6KzAqGZ8OPUR2vlseiy5EHWDeSNIJC_wYwrD1zDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXUtO_fz4vUwzVNt6BNXQzf2IqcAvCk9aa5hbpw59yTQ&oe=6AC65311"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1CV5EfDo9AQ7kNvwEJoVf1&_nc_oc=AdrmcuPRH5nEiOxW8Xwuy2ii0jNQEC27zHziK8qnNUdzjDewWvTJBYp_UYG3VXK6_TY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvKWnnHxtyNw9lRt6SIN_I4IQxLh6
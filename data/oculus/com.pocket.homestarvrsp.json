0e7005en.png", "id": "773125536591078", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295893_773125539924411_1175187097494216998_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw6JxfzW-3EQ7kNvwFO88xp&_nc_oc=AdoyFn9Ef8Es7CPFf5vj5Mp6gXsQJCrJ19SsQwKs439slmumxhksCekAg1LyWj5bq-8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqJ-nKbrYqz24Tuachov0iGqYrMxKQwgWjGfMXhqeddQ&oe=6AC7C128"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30b5\u30e0\u30cd\u30a4\u30eb.png", "id": "1156832914718160", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75222943_1156832918051493_332060781951038199_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9mkGrkCXREQ7kNvwEW2Aem&_nc_oc=AdqGE4Asup2A9_HAdW96AkZ7Bi3-9lqvsCy6uKPn18492ym2ca4vjmeUhZ_CO1h1PiQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmyrGhZBx_jvlqo4lJLjAHDD3EZ2LGB1rgedIaBVYsZA&oe=6AC7B0AE"}, "display_name": "Homestar VR: Special Edition", "keywords": ["relax", "planetarium", "stars", "constellation", "astronomy"], "long_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'.\n6.Others\n\u00b7 Full Celestial Planetarium -starry sky extends right down to your feet\n\u00b7 Experience a sense of depth and feeling of immersion only possible with VR\n\u00b7 Reproduces an accurate sky based on NASA data\n\u00b7 Recreate what the starry sky was like on your birthday or special anniversary\n\u00b7 See selected locales famous for their starry skies with VR\n\u00b7 Scenery of the wonderful Milky Way that spreads out before you\n\u00b7 Somewhere in the 'Starry Sky Selection' where aurora appears", "short_description": "1.This title is 'HomestarVR' SPECIAL EDTION (special specification).\n2.This title supports the \"play while lying down\" function. You can watch the stars more comfortably while relaxing on the sofa or reclining seat!\n3.The narration of the planetarium uses very famous voice actors in Japan (Jun Fukuyama, Sayaka Ohara, Donna Burke)\n4.A new appreciation program has been added to the planetarium mode.\n5.A famous starry sky spot has been added to 'Starry Sky Selection'."}, {"images": {"nodes": []}, "id": "411038663599302", "locale": "ja_JP", "screenshots": [{"file_name": "\u30b9\u30af\u30b7\u30e7001jp.png", "id": "1190017244694699", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001702_1190017248028032_7230416444519635743_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdubhw9BqisQ7kNvwEm106j&_nc_oc=AdrBQclLsFJgH-ijUbjD2qXGdVQI5dnmN6wArke5JMLDsjw_YVwxuvbU9p50DrFWG_M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZyqXO8HCidySkBSuQLoxMJpKygCMJm1AayaWEZbbJZg&oe=6AC7A3DC"}, {"file_name": "\u30b9\u30af\u30b7\u30e7002jp.png", "id": "738729200255439", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982657_738729203588772_5361291790342939379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FV5HBb6h5r0Q7kNvwEhTuTQ&_nc_oc=Adp2YT74bEFRIYs0CwxDeUEii0ZHMg-AIp9h6f0GZLZzowIrU8clR0WVeuG4IPYckDM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-Ef71gdsO-LPDCK7vQ8bkwxPeFzr-yCUV0hsf1p_yrg&oe=6AC7A491"}, {"file_name": "\u30b9\u30af\u30b7\u30e7003en.png", "id": "1293296011025469", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031529_1293296014358802_5301923581996037821_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1CV5EfDo9AQ7kNvwHaKZZV&_nc_oc=Adp6tzX2gnoH0GYl-M8cQ8MHls8HHkGN0d5HlgAsFW-0Mn8e1jUn7DOIHSBwjKQvoIY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiP5QUj8wpHNOQc6X1slgtLD-RwMi
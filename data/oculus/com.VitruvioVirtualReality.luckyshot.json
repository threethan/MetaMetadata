c_ohc=gKZWCz9A6EgQ7kNvwEwYrq5&_nc_oc=AdqPTdd7fLOJLCvMls4nn35XmZ2JtueG7w6W3LPWZQz5w_VjE3a3xpxLVbERtQk8-wI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzWt4-pTbC-bXHWw1bdorfkJHepuluu9nAYDBFBFeiMA&oe=6AF73AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "260408_cover_art_landscape.png", "id": "1520137689906273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829165_1520137693239606_105701627584644602_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVtJXaVbl2kQ7kNvwFm-YTk&_nc_oc=AdphMFmNEidXZJijCEmxDuycbo24TYtr-eaDuJMkSuDwei4t6N7N_PddTmaXjn8PHzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjoFpQd8l3lAxT1jJX4j7nNKytwnsT4QTqRncuueJSBg&oe=6AF7411C"}, "display_name": "LUCKY SHOT", "keywords": ["challenge", "western", "casual", "shooting", "action"], "long_description": "**LUCKY SHOT VR is way more than just a VR experience.**\n\n**It\u2019s a collection of casual mini-games that drops you right into the most iconic scenes of classic Westerns, paying heavy homage to the unmistakable style of the Italian Spaghetti Western.**\n\nOur first episode kicks off in a tense, dusty saloon. The challenge? Knock back your whiskey, toss the glass in the air, and blast it before it hits the floor. It takes lightning-fast reflexes, dead-eye precision, and nerves of steel. And this is just the beginning, we plan to keep expanding the frontier with fresh challenges.\n\nNeed a break from the action? Head over to the abandoned ranch. It\u2019s a sandbox training ground where you can practice your aim and mess around with zero rules and no time limits. Everything is tied together by a truly authentic Western vibe. With lifelike graphics and deeply immersive audio, you aren\u2019t just holding a controller: you\u2019re stepping into the Wild West firsthand.\n\n**Whether you quick-draw for a few minutes\u2026 or get lost in the prairie for hours. One thing is for sure: once you start shooting, you won\u2019t want to stop.**", "short_description": "LUCKY SHOT consists of mini-games inspired by iconic scenes from classic \u201cSpaghetti Westerns\" movies.\nThe first episode was inspired by the saloon scene from the film \u201cMy Name is Nobody\u201d in which the protagonist must drink glasses of whiskey and then throw them and shoot them in mid-air before they hit the ground.\n\nYou can test your shooting skills in an abandoned ranch without time limits.\nFor those who want to play for minutes or hours.\nOnce you start, you won't want to stop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://luckyshot-vr.com/privacy-policy-videogame/", "developer_terms_of_service_url": null, "publisher_name": "Assa srl", "support_website_url": null, "website_url": "https://luckyshot-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27176869218675385"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "865000329770247"}, {"status": "PUBLISHED", "id": "1567428854834925"}]}, "baseline_offer": {"id": "1567428854834925"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785596400, "status": "PUBLISHED", "id": "865000329770247"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27353752134320425", "version": "1.0.2"}, "id": "723325956936635", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24865400919822238", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27353752134320425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "723325956936635"}]}, "change_log": "Update version 1.0.2\n\n-----\n\nBug fix", "created_date": 1785330501, "id": "27353752134320425", "version": "1.0.2", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24865400919822238", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27353752134320425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "723325956936635"}]}, "change_log": "Update version 1.0.1\n\n------\n\nMain Fixes & Improvements:\n\n- Challenge Mode: Fixed and balanced the bounty and reward system. Progress and payouts in this mode are now correctly tracked and awarded.\n\n- Save Synchronization: Resolved issues related to saving your progress. The system is now fully reliable for both local saves on the headset and Cloud backups\n\n- UI Input: Optimized menu command responsiveness. UI interaction with the controllers is now more precise, smooth, and seamless.\n\nGraphics:\n\n- Fixed various visual glitches and graphical artifacts to ensure a cleaner and more realistic VR immersion.\n\nGeneral Bug Fixes: \n\n- Addressed several minor behind-the-scenes bugs to improve the overall performance and stability of the application.", "created_date": 1785241182, "id": "27341178572244448", "version": "1.0", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24865400919822238", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27353752134320425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "723325956936635"}]}, "change_log": null, "created_date": 1783957371, "id": "27176859415343032", "version": "1.0", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24865400919822238", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27353752134320425"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "723325956936635"}]}, "change_log": null, "created_date": 1783701318, "id": "27147327108296263", "version": "1.0", "version_code": 16, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24865400919822238", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": 
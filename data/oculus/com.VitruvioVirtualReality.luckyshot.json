-25/491829165_1520137693239606_105701627584644602_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVtJXaVbl2kQ7kNvwFm-YTk&_nc_oc=AdphMFmNEidXZJijCEmxDuycbo24TYtr-eaDuJMkSuDwei4t6N7N_PddTmaXjn8PHzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjoFpQd8l3lAxT1jJX4j7nNKytwnsT4QTqRncuueJSBg&oe=6AF7411C"}, "display_name": "LUCKY SHOT", "keywords": ["challenge", "western", "casual", "shooting", "action"], "long_description": "**LUCKY SHOT VR is way more than just a VR experience.**\n\n**It\u2019s a collection of casual mini-games that drops you right into the most iconic scenes of classic Westerns, paying heavy homage to the unmistakable style of the Italian Spaghetti Western.**\n\nOur first episode kicks off in a tense, dusty saloon. The challenge? Knock back your whiskey, toss the glass in the air, and blast it before it hits the floor. It takes lightning-fast reflexes, dead-eye precision, and nerves of steel. And this is just the beginning, we plan to keep expanding the frontier with fresh challenges.\n\nNeed a break from the action? Head over to the abandoned ranch. It\u2019s a sandbox training ground where you can practice your aim and mess around with zero rules and no time limits. Everything is tied together by a truly authentic Western vibe. With lifelike graphics and deeply immersive audio, you aren\u2019t just holding a controller: you\u2019re stepping into the Wild West firsthand.\n\n**Whether you quick-draw for a few minutes\u2026 or get lost in the prairie for hours. One thing is for sure: once you start shooting, you won\u2019t want to stop.**", "short_description": "LUCKY SHOT consists of mini-games inspired by iconic scenes from classic \u201cSpaghetti Westerns\" movies.\nThe first episode was inspired by the saloon scene from the film \u201cMy Name is Nobody\u201d in which the protagonist must drink glasses of whiskey and then throw them and shoot them in mid-air before they hit the ground.\n\nYou can test your shooting skills in an abandoned ranch without time limits.\nFor those who want to play for minutes or hours.\nOnce you start, you won't want to stop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://luckyshot-vr.com/privacy-policy-videogame/", "developer_terms_of_service_url": null, "publisher_name": "Assa srl", "support_website_url": null, "website_url": "https://luckyshot-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27176869218675385"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_1587286866740411_1095549470767118524_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKGhEOluR2UQ7kNvwFCCRmX&_nc_oc=AdpPMrJPi4MXC9XswzqILv9o-7p9mxtllHIJ7v3DjPpyTGE4sVK_P--VuCdJP26iWyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlhxYNjd2V2OXTEt1GPuqAiSiMOzBL06qtFeS4LaPZJA&oe=6AF74327"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "LUCKY SHOT", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1784281680, "lastRevision": {"nodes": [{"id": "24865400956488901", "release_type": "SCHE
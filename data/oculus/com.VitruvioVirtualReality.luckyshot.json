=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYoGIfLU-fDXDOduEgDUoJUDQjXSs-UhxenFnQYl46DQ&oe=6AF734FC"}, {"file_name": "04.png", "id": "1384439070499718", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_1384439073833051_974766312152497496_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGEBBhwcKbMQ7kNvwGs5Uvk&_nc_oc=Adri3qTdBiytlDFboteb-qE4KAyD8VEHtLxNInzItVc9wpmhsg7UNpHIR5PECHaKQ2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEGI6lTnAi10Z4ffWsqnXtHytsLibBvorNkL5ENhhFoQ&oe=6AF72005"}, {"file_name": "05.png", "id": "1753986718933949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_1753986722267282_7183257771916992983_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plo0oelu4CMQ7kNvwFwx8VA&_nc_oc=AdrLE4ZmkiddTIFUPpGh0RBWV2Y0UYyGmm_zi8Z9O9702g6Iun9Y4mWqHDjxi2g5WjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8DkoY7iF0HrqbM6JvVzMvonQhQBP5NXlNFedSDmlKLw&oe=6AF73264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "260408_cover_art_landscape.png", "id": "884082080926946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308699_884082084260279_1573947325488252_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DdvagNN49wQ7kNvwF3cXgc&_nc_oc=AdpDyomg2kD5fg7Hofy_VbAUgn1Ub3cEMvkDQWwxzv4I_5aZLYDNKpFGZD4goZsIW4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAiR8ZkG5_MyikWcO8LbmDiy0UY1ClrZZm7NPEtIq6_Q&oe=6AF71513"}, "display_name": "LUCKY SHOT", "keywords": ["casual", "western", "sparatutto", "sfida", "azione"], "long_description": "**LUCKY SHOT VR \u00e8 molto pi\u00f9 di una semplice esperienza in realt\u00e0 virtuale.**\n\n\n**\u00c8 una raccolta di minigiochi casual che ti catapulta direttamente nelle scene pi\u00f9 iconiche dei classici film western, rendendo un sentito omaggio all\u2019inconfondibile stile degli Spaghetti Western italiani.**\n\nIl nostro primo episodio prende il via in un saloon polveroso e carico di tensione. La sfida? Scolare il tuo whiskey, lanciare il bicchiere in aria e centrarlo con un colpo prima che tocchi il pavimento. Servono riflessi fulminei, una mira infallibile, e nervi d\u2019acciaio. E questo \u00e8 solo l\u2019inizio: abbiamo in programma di continuare ad ampliare la frontiera con nuove sfide sempre pi\u00f9 avvincenti.\n \n\nHai bisogno di una pausa dall\u2019azione? Dirigiti verso il ranch abbandonato.\n\u00c8 un\u2019area di addestramento in stile sandbox dove puoi allenare la mira e divertirti in totale libert\u00e0, senza regole n\u00e9 limiti di tempo. Il tutto \u00e8 immerso in un\u2019autentica atmosfera western grazie a una grafica realistica e a un comparto audio profondamente coinvolgente, non stai semplicemente impugnando un controller: stai vivendo il selvaggio West in prima persona.\n\n**Che tu voglia estrarre la pistola per una partita veloce di pochi minuti o perderti nella prateria per ore, una cosa \u00e8 certa: una volta iniziato a sparare, non vorrai pi\u00f9 fermarti.**", "short_description": "LUCKY SHOT VR \u00e8 composto da minigiochi ispirati a scene iconiche dei classici film \u201cspaghetti western\u201d.\n\nIl primo episodio si ispira alla scena del saloon del film \u201cIl mio nome \u00e8 Nessuno\u201d, in cui il protagonista deve bere bicchieri di whisky per poi lanciarli e colpirli al volo prima che tocchino terra.\n\nPuoi mettere alla prova la tua abilit\u00e0 nel tiro in un ranch abbandonato senza limiti di tempo.\nPer chi vuole giocare per pochi minuti o per ore.\nUna volta iniziato, non vorrai pi\u00f9 smettere."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "27803867045876723", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_27803867059210055_6311920329405419092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx4mh6nYI-cQ7kNvwEX6ihU&_nc_oc=Adp1WzO6Q9COFAWlmP3aBUXGhnciYYmEpNmMd-aqQnc4zsPpOdAp-CUpNtjOzP_hi2g&_nc_zt=3&_nc_ht=sconte
197080154_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDU0v_lFAbAQ7kNvwG_6iTV&_nc_oc=AdqcAyMGkxqOYjCXZZQOlR-IpIc0_v4HlVKaoszd2yzfZVfkMGzOajidjCwstq0JvYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ20Kzi5LLlsG7PZdKVQHWxRUfK6HwlMSUvOfoeGSMFuQ&oe=6AB3F68B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotNCold_Landscape.png", "id": "28455764474037582", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391720_28455764490704247_2725059285206698887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoM21kKfiOIQ7kNvwFgTa_L&_nc_oc=AdprrbANPEA_GxPrTjRsV6bwiXKybTKUOjDA1anFIVlZNgjXUdBe0zZ1nRt4MZIVTYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDg4C7JeJc3PXveMcTI-T6A3Iy8w2OPbq2hA4NunCLBg&oe=6AB3D8C3"}, "display_name": "HotnCold", "keywords": ["Hot", "Cold", "Game", "LeaderBoard", "Competition"], "long_description": "Step into the immersive world of hot and cold in this exciting VR game where speed, strategy, and quick thinking are key. Search the environment to find hidden items by observing the hot or cold bars that guide your way. Compete against rivals to be the first to locate treasures and gain the upper hand using special power-ups. Extend your time, boost your speed, or reveal item locations with directional arrows. Every second counts as you explore dynamic levels and outsmart the competition in this fast-paced treasure hunt!", "short_description": "Discover hidden items in a thrilling hot and cold VR game! Use clues, power-ups, and your wits to outpace rivals and claim victory before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1wXW4Hyq5Rqr6HxU8MEokie4qwH6c4Wz9/view?usp=share_link", "developer_terms_of_service_url": null, "publisher_name": "Simofun", "support_website_url": null, "website_url": "https://www.simofun.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"
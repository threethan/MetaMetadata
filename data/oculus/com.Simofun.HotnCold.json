197080154_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJLUNy-vipkQ7kNvwEiSh09&_nc_oc=AdoL5ygwun82VYApPB_7hMNCZ7IqnwXEcjAmMgtG3xmId1hYJKngKWvPXUarZp3ptrE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a_TukMWvRpzi2E_kSg33b7kWSvk4oottfyxLwHU3rmg&oe=69D793CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HotNCold_Landscape.png", "id": "28455764474037582", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391720_28455764490704247_2725059285206698887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R0Sn-MFKVMQ7kNvwG2GNeJ&_nc_oc=AdrMxJngX5gLuTpnQ1sB0uXZqnTWuOT4dJDacuqZ_DQiExWxMvEir0MnrsK4TjgqdT8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I5BajvEEcufF3cvDTN-hKum5xubG9vvXsbm14g2FFHg&oe=69D7AE43"}, "display_name": "HotnCold", "keywords": ["Hot", "Cold", "Game", "LeaderBoard", "Competition"], "long_description": "Step into the immersive world of hot and cold in this exciting VR game where speed, strategy, and quick thinking are key. Search the environment to find hidden items by observing the hot or cold bars that guide your way. Compete against rivals to be the first to locate treasures and gain the upper hand using special power-ups. Extend your time, boost your speed, or reveal item locations with directional arrows. Every second counts as you explore dynamic levels and outsmart the competition in this fast-paced treasure hunt!", "short_description": "Discover hidden items in a thrilling hot and cold VR game! Use clues, power-ups, and your wits to outpace rivals and claim victory before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1wXW4Hyq5Rqr6HxU8MEokie4qwH6c4Wz9/view?usp=share_link", "developer_terms_of_service_url": null, "publisher_name": "Simofun", "support_website_url": null, "website_url": "https://www.simofun.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"
7aN79xPfbMt0-4lKb2mONi9kZFaBM1amKAfnkaf-oK4oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHNKnEQYW4_d2598LGxaYc9K3lNsrZto6ttRw_xU56Qw&oe=6B0C5E80"}, {"file_name": "LibrarySS.png", "id": "1058996299375414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035347_1058996302708747_1588685019892184705_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eTN9Sstg0EQ7kNvwEfhlSn&_nc_oc=AdoTwWxT_PNCobPif5DqpxYO-WxX9pgHDXKjB813xxuPbklVW6QM9Nwl1ZFF5PV76NQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYYdLLxUDczl_TisnY2KUAL1ambu61SjxWnqbWnMtpCw&oe=6B0C764D"}, {"file_name": "DefeatSS.png", "id": "1194436991903654", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031359_1194436995236987_3901069764779300980_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1AwtKyg1Z8Q7kNvwHznzeZ&_nc_oc=Adp9nu8LCi_zvDV8Drf_bNTiTBzCdrqgkLw27pM-qzI_h6NyM1zhmH2zuV5SO-ivY-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlOcy9brCIJSvGZbvlO_1GqF4aYLxWhbqM6x2z2oecMA&oe=6B0C5243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaImage_1.1.1.png", "id": "1957909358058006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031604_1957909361391339_779514435254246849_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws7zGgY5kGcQ7kNvwEx9hIL&_nc_oc=AdoAPrr4Ps5TjmqVnomjm43U4pJZ8CJoKApza70SbUePjgk-0Pd_2oGFEHUbSPTsM5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLk6rGtda18faTbM8gJYi96zJ8_szuM3KpkanJsR93Pw&oe=6B0C8156"}, "display_name": "Beautiful Journey", "keywords": ["Mindfulness", "Meditation", "Reflection", "Consciousness", "Relaxation"], "long_description": "Beautiful Journey is an immersive VR experience that guides you through life\u2019s pivotal moments, offering a peaceful and introspective exploration of existence. From the innocence of childhood to the tranquility of near-death and rebirth, Beautiful Journey takes you across stunning natural landscapes and through the emotional stages of life.\n\nFly over majestic mountains, float across serene waters, and relive precious memories. Each scene is carefully crafted to inspire awe and reflection, helping you to connect more deeply with your own experiences. Designed for those seeking mindfulness and personal growth, Beautiful Journey is a transformative experience that opens your heart, cultivates gratitude, elevates your consciousness and encourages you to explore life's beauty.\n\nWhether you\u2019re looking for a moment of peace or an opportunity to reflect on your life, Beautiful Journey offers a unique space for inner exploration and mindfulness.", "short_description": "Beautiful Journey is a transformative VR experience that takes you on a breathtaking voyage through life\u2019s stages, from birth to a peaceful near-death experience and back again. Soar over majestic mountains, relive precious childhood moments, and immerse yourself in stunning natural environments. Crafted to inspire awe, introspection, and a deeper connection to your own life, Beautiful Journey offers a serene and reflective escape for those seeking inner peace and elevated consciousness."}]}, "developer_name": "Beautiful Journey LLC", "developer_privacy_policy_url": "https://www.beautifuljourneyvr.org/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Beautiful Journey LLC", "support_website_url": null, "website_url": "https://www.beautifuljourneyvr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
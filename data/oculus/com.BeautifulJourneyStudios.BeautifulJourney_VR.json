YW3Fn5kzZkM-5ZC6-6hrt6eFa99-NXpGCea_GStjwXCmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRs66Ba8xkVWEn6LDuEjODf0evHtdDaoW49Xp8Uj6is8Q&oe=6B0DB000"}, {"file_name": "LibrarySS.png", "id": "1058996299375414", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035347_1058996302708747_1588685019892184705_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eTN9Sstg0EQ7kNvwFGBCX2&_nc_oc=AdpDCTW1JeML4_9mFapsdiKPB5PYH2tj3VukYc2DvB50v6SjKwO6UH4zBhvqaEISNsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTt93MKra9Yp6yhRChgmKacBniyVaooWSIEyBLvXQZFEA&oe=6B0DC7CD"}, {"file_name": "DefeatSS.png", "id": "1194436991903654", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031359_1194436995236987_3901069764779300980_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1AwtKyg1Z8Q7kNvwHmyfJu&_nc_oc=AdpBhaBjhxDtkT0iUWOjdulAs9z-P-z7EaNsfxG4vJvI0AiV5jhFQNPihAGQ7Ra2oUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLasQW1CsGEhUQMA9liWsk1ztL2cgNQP7pTwIsYCx0uQ&oe=6B0DA3C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaImage_1.1.1.png", "id": "1957909358058006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031604_1957909361391339_779514435254246849_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUFsqe_Mq9gQ7kNvwEdqdCj&_nc_oc=AdplfWgPAcZrERPrFTJ2vz-oDBjkjf8XNPKkvIwXlslYtcb8i6GL-nQ3_YbLNlQpD-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNKjqYPsbzOSyNPE78KnpiROXohEWchhI5rpj4-8UMIQ&oe=6B0DD2D6"}, "display_name": "Beautiful Journey", "keywords": ["Mindfulness", "Meditation", "Reflection", "Consciousness", "Relaxation"], "long_description": "Beautiful Journey is an immersive VR experience that guides you through life\u2019s pivotal moments, offering a peaceful and introspective exploration of existence. From the innocence of childhood to the tranquility of near-death and rebirth, Beautiful Journey takes you across stunning natural landscapes and through the emotional stages of life.\n\nFly over majestic mountains, float across serene waters, and relive precious memories. Each scene is carefully crafted to inspire awe and reflection, helping you to connect more deeply with your own experiences. Designed for those seeking mindfulness and personal growth, Beautiful Journey is a transformative experience that opens your heart, cultivates gratitude, elevates your consciousness and encourages you to explore life's beauty.\n\nWhether you\u2019re looking for a moment of peace or an opportunity to reflect on your life, Beautiful Journey offers a unique space for inner exploration and mindfulness.", "short_description": "Beautiful Journey is a transformative VR experience that takes you on a breathtaking voyage through life\u2019s stages, from birth to a peaceful near-death experience and back again. Soar over majestic mountains, relive precious childhood moments, and immerse yourself in stunning natural environments. Crafted to inspire awe, introspection, and a deeper connection to your own life, Beautiful Journey offers a serene and reflective escape for those seeking inner peace and elevated consciousness."}]}, "developer_name": "Beautiful Journey LLC", "developer_privacy_policy_url": "https://www.beautifuljourneyvr.org/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Beautiful Journey LLC", "support_website_url": null, "website_url": "https://www.beautifuljourneyvr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
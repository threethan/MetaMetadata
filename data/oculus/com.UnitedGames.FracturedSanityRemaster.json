cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vuNhk3-zx4Q7kNvwEKZqHg&_nc_oc=AdouVRLQgiX5gL3JEggizvnbSoADI0JW-M6asFUDSo0Vazxx8uMW_YZ97h0VU7ODF6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKrG-tUwFQf0xn8bSqriFDhGsXvWzYJUVdr3ztEDJEGA&oe=6AE758D2"}, {"file_name": "3.png", "id": "1678109723313258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618512_1678109726646591_2467622181704968759_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5vQPFSW4HEQ7kNvwFhY8PR&_nc_oc=AdpXdvNdKMIjwM1zD1G3V8GX0Ybqs5EWkYE2o7FBSlY7wXSsShcJ-9XAKIb4r4ZApdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsLt2xFvz3ahX9ZLjHQN3wocCRj25JVNEI2iYtEo0wgQ&oe=6AE7524D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "2039433646602968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619145_2039433649936301_8974366707716340448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL1Zqes6GcEQ7kNvwFu6BgC&_nc_oc=AdpTVLEBI6HSBYfuGoOWFa4RQU9mDq-OtjzGgnqRqdbQeC-XxMeY8mAB4qlbCk-l8lM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_v3yXAZX08ui7EannQdI8FsYVplGINfNxEXc8-20DdA&oe=6AE74001"}, "display_name": "Fractured Sanity Remastered", "keywords": ["horror", "survival", "puzzle", "exploration", "escape"], "long_description": "## About This Game\n\nYou wake up in a cell inside the Triton Institute. The staff is gone. The halls are not empty.\n\n**Fractured Sanity Remastered** is a psychological VR horror experience set inside a notorious mental asylum, where Dr. Matthew Simmons\u2019 experiments pushed Freud\u2019s theory of the id, ego, and superego far beyond reason. As you explore the Institute, you will uncover what was done to its patients \u2014 and what was done to you.\n\n## Remastered for VR Horror\n\n- Rebuilt models, textures, and environments\n- Expanded locations with new areas not seen in the original release\n- Fully reworked soundtrack and sound design with immersive 3D spatial audio\n- Refined gameplay and major improvements based on player feedback\n\n## Explore the Institute\n\n- Interact with a physics-driven VR world\n- Pick up, examine, and use objects to progress\n- Solve environmental puzzles by paying attention to small details\n- Uncover the history of the Institute and its patients\n\n## Survive the Horror\n\n- Manage scarce ammunition where every bullet matters\n- Reload, aim, and fire under pressure with realistic weapon handling\n- Face the horrors still wandering the halls of the Triton Institute\n\nAfter everything Dr. Simmons has done, one question remains:\n\n**How much of you is still left?**\n\n---------------------------------------------\n\n**Do you own the standard version?**\n\nSend an email to contato@unitedgames.com.br with the confirmation and we'll provide a 80% discount for the remastered version", "short_description": "Fractured Sanity is a psychological VR horror experience set inside the Triton Institute, a notorious mental asylum where Dr. Matthew Simmons\u2019 experiments push the human mind beyond its limits. Explore expanded areas, survive terrifying encounters, and uncover what was done to you in a remaster rebuilt with redesigned visuals, reworked environments, and immersive spatial audio that keeps the horror uncomfortably close."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fracturedsanity.unitedgames.com.br/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "United Games", "support_website_url": null, "website_url": "https://fracturedsanity.unitedgames.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
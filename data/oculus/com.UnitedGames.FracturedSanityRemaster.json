": "1350046363622344", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2469226926860743", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_2469226930194076_5286131523031997393_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElO61JLzSPcQ7kNvwF-Cxh2&_nc_oc=AdruB1mEraIwSjGvQSZvvXZCs1KM94cpC4wW5CASVdaJwenZEBncHQCBiSCvGI-36DM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3LPO9sGbiEc-RXgMRg3gvAVedVcg72zlKs_sg8mI-_uw&oe=69F0D15C"}, {"file_name": "5.png", "id": "971536371898641", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_971536375231974_1542703297055402259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jZRCdKWJpoQ7kNvwGTVC1N&_nc_oc=AdqamK6js2FkUv-NTrtGsK7ZG2cY0cnBEhK0rTD_y9iFDmj6i98s5b3Nxutzag4_1uM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af37Kguss2BEtdDEvRXZsDwC31qLN7flAzQ8oRv24XnAUQ&oe=69F0B376"}, {"file_name": "4.png", "id": "2016923365886826", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_2016923369220159_4901987939557469695_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQVmmA9H3rwQ7kNvwHjjdTu&_nc_oc=AdrFLMtSoVzg2PiQWpzq1ZyCRykCyoGJJGIJHvOdyVw-b5OdKmCkKFlBjbppBe2OUpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2fFusvlb2B6svN7C29b28CUWrBu3b_4dlyUrYEknKLRA&oe=69F0AE0B"}, {"file_name": "2.png", "id": "1305433518144521", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619159_1305433521477854_3307424570996256293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8KXaXkO8LwQ7kNvwGpD4rS&_nc_oc=AdoxgUmsFudsvEUkImtYbbPL6X0kSdlJYoEUArFzMybpFBkNcoZQ265NeNx5nYSjEj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2_eobnayEESxJr5MyZva8_kpxrQELR55UPop-pbSz65A&oe=69F0D052"}, {"file_name": "3.png", "id": "1678109723313258", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_1678109726646591_2467622181704968759_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoNjkVKxuxMQ7kNvwHD0kjd&_nc_oc=AdoCapmda_dBpS1GfU6neBGWm4HiHKYP2X7qxcI6oBuq2ccFXxDstMr4STZ2xjHAolY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2qpWyZzCdT3_T2bGhytUHfJHsEzINVD8isgekD7ieZnw&oe=69F0C9CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "2039433646602968", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_2039433649936301_8974366707716340448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2fSSA6Is_YQ7kNvwH0zMjJ&_nc_oc=AdrWzLQ3i7eH8QNyXxykdhqH6YQ3inVCwTtSBYqYC5QS3VGPJ4hGXZiZHSmwNaBcxeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1psKbRraMxHJYtZfuy2GzGNNcimgZqQEgG7uNVMvnZlw&oe=69F0B781"}, "display_name": "Fractured Sanity Remastered", "keywords": ["horror", "survival", "puzzle", "exploration", "escape"], "long_description": "## About This Game\n\nYou wake up in a cell inside the Triton Institute. The staff is gone. The halls are not empty.\n\n**Fractured Sanity Remastered** is a psychological VR horror experience set inside a notorious mental asylum, where Dr. Matthew Simmons\u2019 experiments pushed Freud\u2019s theory of the id, ego, and superego far beyond reason. As you explore the Institute, you will uncover what was done to its patients \u2014 and what was done to you.\n\n## Remastered for VR Horror\n\n- Rebuilt models, textures, and environments\n- Expanded locations with new areas not seen in the original release\n- Fully reworked soundtrack and sound design with immersive 3D spatial audio\n- Refined gameplay and major improvements based on player feedback\n\n## Explore the Institute\n\n- Interact with a physics-driven VR world\n- Pick up, examine, and use objects to progress\n- Solve environmental puzzles by paying attention to small details\n- Uncover the history of the Institute and its patients\n\n## Survive the Horror\n\n- Manage scarce ammunition where every bullet matters\n- Reload, aim, and fire under pressure with realistic weapon handling\n- Face the horrors still wandering the halls of the Triton Institute\n\nAfter everything Dr. Simmons has done, one question remains:\n\n**How much of you is still left?**", "short_description": "Fractured Sanity is a psychological VR horror experience set inside the Triton Institute, a notorious mental asylum where Dr. Matthew Simmons\u2019 experiments push the human mind beyond its limits. Explore expanded areas, survive terrifying encounters, and uncover what was done to you in a remaster rebuilt with redesigned visuals, reworked environments, and immersive spatial audio that keeps the horror uncomfortably close."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fracturedsanity.unitedgames.com.br/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "United Games", "support_website_url": null, "website_url": "https://fracturedsanity.unitedgames.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es", "ja", "ko", "zh_CN", "de", "ru", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26607299868959967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_1859724328058723_2516534665781281378_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWYaGjzKmN4Q7kNvwFUGKzr&_nc_oc=AdpVMXV1Ctu0eutYkYNMMbZOvYncxEJnk0wZWmbriXOUYDZYV9Z0_SVmtipV2Ja-JWo&_nc_z
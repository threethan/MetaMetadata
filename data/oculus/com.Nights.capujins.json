0287141121730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299808_2260287144455063_9126476827898712400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TurZrzyDTrQQ7kNvwF79vQo&_nc_oc=AdkCQ1ltyEFyJGxWNfmA8-ELOsjIwyNN-qn8kaKR9hRnDqgjBFGvH1IxMuMStszK_R0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyHwXAAGo5TKSTDomcn9ppV3G7Rrm084IZ4znxQbxEoiQ&oe=69BBE507"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal banana", "keywords": ["tag", "Gorilla", "Monkey", "fun"], "long_description": "This is a fast-paced VR movement game where players climb, run, and jump using their hands. Explore multiple maps, practice your movement skills, and play with friends in online rooms. The game focuses on pure physical locomotion with no stick movement, letting players rely on their arms to move around the environment.\n\nPlayers can learn advanced movement tricks, race through obstacle courses, and enjoy casual tag-style modes. New updates will add more maps, cosmetics, and challenges based on player feedback. This game is designed for fun, social play and active motion.", "short_description": "Primal banana"}]}, "developer_name": "Nights", "developer_privacy_policy_url": "https://sites.google.com/view/primal-banana/home", "developer_terms_of_service_url": null, "publisher_name": "Donkid", "support_website_url": null, "website_url": "https://sites.google.com/view/primal-bananaa/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
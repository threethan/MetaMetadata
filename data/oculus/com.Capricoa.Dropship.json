"DecoyDropSC4.png", "id": "1251424205416623", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035378_1251424208749956_8755804831935739733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmh8GIbStbAQ7kNvwFgjL3L&_nc_oc=Adq5WmRXYFY9rAoens4kb9etogHHR-GDBBzwglhjOPmI-_WB9nA5m-k0w8j_NQDgfJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEchlEQKuX30Jku5LofcHI6Ax1_oCPbE_7BJCH3rD02Kw&oe=6A8AECBF"}, {"file_name": "DecoyDropSC5.png", "id": "867212031374341", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221315_867212034707674_2185127010825152592_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5x91KL-4ywQ7kNvwFh4H1G&_nc_oc=AdqxL2n_U3fL28s9cw1038gdnpEyKQb55LTjGKnXzQBhFRViU2BifdK3LTSKL2pe63w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjtU38JJ613CijHg1ryw-lJdzpAa_4t1Fl_CqSAC9AMg&oe=6A8AE9BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "642680800936878", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_642680804270211_806891163600043355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae9INiLF3KAQ7kNvwELqOZD&_nc_oc=AdrI0A3XOiPzuo17s6LKIqWeWGZhR_13EtgpU--V2tc4Dbmq5wuYj_WS76loOTSsP74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQrsKJBf-CPQ7ZHhlkW8-3N2XaZgFX43n30kO2HnL9IA&oe=6A8AC6FE"}, "display_name": "Decoy Drop", "keywords": [], "long_description": "Alright soldier, what we\u2019ve got here is a neural-linked assault mech. We\u2019re going to put this thing down there under your control. Now, this is a decoy mission. You\u2019re going to be a sitting duck out there. We\u2019re hoping that you can draw enough eyes for five minutes to allow us to get into position to destroy our high value target.\n\nDecoy Drop is a re-imagining of the classic sci-fi arcade shooter.\n\nEasy to pick up and play with 5-minute rounds, this experience is great for those new to VR. The game is built to be played sitting or standing from a stationary position.\n\nPractice in 'free play' mode to try and best your own top scores.\n\nTry to top the global leaderboard in 'ranked play' mode!", "short_description": "Alright soldier, what we\u2019ve got here is a neural-linked assault mech. We\u2019re going to put this thing down there under your control. Now, this is a decoy mission. You\u2019re going to be a sitting duck out there. We\u2019re hoping that you can draw enough eyes for five minutes to allow us to get into position to destroy our high value target.\n\nPractice in 'free play' mode to try and best your own top scores.\n\nTry to top the global leaderboard in 'ranked play' mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://capricoadesign.com/decoydrop/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Capricoa Design LLC", "support_website_url": null, "website_url": "https://capricoadesign.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2911198439025039"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "192102870273873"}]}, "baseline_offer": {"id": "192102870273873"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681428240, "status": "PUBLISHED", "id": "192102870273873"}]}, "liveChannel": {"nodes": [{"latest_supported_b
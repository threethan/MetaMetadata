6229264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8apXDjUM-QQ7kNvwGXFJGT&_nc_oc=AdrJZWremPILfWqy36_re6cLJQFZReZI9bwmzjSNbJCD5B45DDxmcjkUmamFfUMIvNI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG88UXjmN4q9OuU8K5rNWIuQ0i3sAvkHppsBi0YQHRXbA&oe=6A8D736F"}, {"file_name": "DecoyDropSC4.png", "id": "1251424205416623", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035378_1251424208749956_8755804831935739733_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmh8GIbStbAQ7kNvwGKSv46&_nc_oc=AdoSK_4P7T7oeM3cU2-KawHRA4qNDpTWrkJs2r6RzGlxuUG9B8g85unzRlqYzUuE71Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxnmJmVb4YOR6TtJEvT3NyAW1MbAtY4jWCjfBBYMAGnA&oe=6A8D8FBF"}, {"file_name": "DecoyDropSC5.png", "id": "867212031374341", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75221315_867212034707674_2185127010825152592_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0igxyj-q0IQ7kNvwExwSVH&_nc_oc=Adpo3GPGss7tH0tFImKhoMnYKslRzYsKqzX6TZWw2q0-gCpJuUFCP-prj7SVBY8jMYc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2QuYKj5_fTXwqtKzBjTDUKR7E_Vs8hOdMo7-u5CIBXQ&oe=6A8D8CBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "642680800936878", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982512_642680804270211_806891163600043355_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJgHHyrsUEQQ7kNvwEJGS-3&_nc_oc=Adonz6aycGreQVbhpKBpnCEEQN-r4wSnP-ARYzF3hQsT1JvrwYRGIyXl7-bd36yk-tk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa8fNG8j6mN2POkyyG33hKdst2IkxjVmUS_2KlgDW5QA&oe=6A8D69FE"}, "display_name": "Decoy Drop", "keywords": [], "long_description": "Alright soldier, what we\u2019ve got here is a neural-linked assault mech. We\u2019re going to put this thing down there under your control. Now, this is a decoy mission. You\u2019re going to be a sitting duck out there. We\u2019re hoping that you can draw enough eyes for five minutes to allow us to get into position to destroy our high value target.\n\nDecoy Drop is a re-imagining of the classic sci-fi arcade shooter.\n\nEasy to pick up and play with 5-minute rounds, this experience is great for those new to VR. The game is built to be played sitting or standing from a stationary position.\n\nPractice in 'free play' mode to try and best your own top scores.\n\nTry to top the global leaderboard in 'ranked play' mode!", "short_description": "Alright soldier, what we\u2019ve got here is a neural-linked assault mech. We\u2019re going to put this thing down there under your control. Now, this is a decoy mission. You\u2019re going to be a sitting duck out there. We\u2019re hoping that you can draw enough eyes for five minutes to allow us to get into position to destroy our high value target.\n\nPractice in 'free play' mode to try and best your own top scores.\n\nTry to top the global leaderboard in 'ranked play' mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://capricoadesign.com/decoydrop/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Capricoa Design LLC", "support_website_url": null, "website_url": "https://capricoadesign.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8318319371524064"}, "review_messages
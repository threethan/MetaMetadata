csNUofRtFmrp3R9ykUWQSgKS0_ccix0LrVzu4U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIS6Wn8FlVsQYg2jxbzcT_woPTgDlVKv381bxUzAOinQ&oe=6AF9D090"}, {"file_name": "screenshot-3-boss-bursts-out-2560x1440.png", "id": "4489275407985898", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499621314_4489275411319231_4947503055678630261_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAFiN2uPfioQ7kNvwGK4HHl&_nc_oc=Ado46lyMkOWIy6BooRvWH3GEfq5xVINSWaMzcaCibz0m25aD03kbN3NI2sbnT1kBA3w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSELAE6wWTXHcpqic36QZoJ8_0X8giGnCghTAW6P35Qzw&oe=6AF9C89B"}, {"file_name": "screenshot-4-attackers-2560x1440.png", "id": "1648659737289147", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620599_1648659740622480_5142070648870912388_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chIjNf3DDvMQ7kNvwGlxpD7&_nc_oc=AdqsO67JATJBrccrTJ30Vei6kvgdSxwkK29vp3O-xF2-cZh0E1EsGxciM8ZYrJ3l9bU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY3WpDSe3o3UAiOzjXFR9UO9cy8xNWlyuYe-UPOHH_Tg&oe=6AF9BC65"}, {"file_name": "screenshot-5-special-loons-2560x1440.png", "id": "3021373268209445", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619059_3021373271542778_6440243176341274969_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWolk2iwp2cQ7kNvwFnY9tS&_nc_oc=AdoEjiYeShTvSyWuF5IedQNl90SD3REPOs_ycJ9XKT5mXomuma7_wWcgct1i1Q29ce8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiH34ewr3gcqML8vjTBBQCe0vZwST3uEkvnliqqdqmzg&oe=6AF9DDF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1158046133315134", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/836812670_1158046139981800_4535803815628717439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODuIUL2Fx3kQ7kNvwGDY_K_&_nc_oc=AdqSUXBoxiahmmIFsm-iWx4PiXE96-5x71Euf5On95tnFa8NPhZMRhNJghrAerV6lqc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF0CyERLSEIx5CH69IP_RQ4LeMlnkV2t7hL3yxYAesDw&oe=6AF9DE25"}, "display_name": "Pop The Loons", "keywords": ["balloon", "slingshot", "mixedreality", "handtracking", "casual"], "long_description": "Your room is the level. Pop The Loons is a mixed-reality slingshot game for Meta Quest, played with your own hands: no controllers.\n\nCandy-bright balloons float up off your floor and furniture, and cartoon critters break out of your real walls. Raise one hand and close it to hold the slingshot, pinch the pouch with the other, pull back and let go. The aim arc shows where every shot will land.\n\n- Seven levels of about two and a half minutes each, starting with Pop School, which teaches the sling with see-through guide hands.\n- Loons with tricks: Bomb Loons set off chain pops, Tin Loons wear helmets, Mama Loons split into babies, Boing Balls bounce round your room, and Prize Loons carry a gift.\n- Gifts for 12 seconds: Spike Balls, Ricochets, Seekers and the Twin Sling.\n- Critters that fight back: Zappers, Laser Eyes, snowball-throwing Snowpuffs and fireball-spitting Embers. Shoot their shots out of the air and keep your five hearts.\n- A boss at the end of every level, bursting out of your wall with a roar.\n- Combos, chain pops, coins and up to three stars per level.\n\nPlay seated or standing. Everything stays in front of you and nothing comes within a metre of your head. Left-handed? Swap hands from the hub. Uses your headset's room scan (Space Setup).\n\nEarly Access: the full game loop and all seven levels are in. Next come more loons and levels, tuning from your feedback, and more ways to play. Tell us what you think from the support page.", "short_description": "Balloons and cartoon critters burst out of your own walls and furniture. Make a fist, pinch, pull and let go: pop them all with a slingshot made from your bare hands."}]}, "developer_name": "Myto Technologies", "developer_privacy_policy_url": "https://company.usemyto.com/pop-the-loons/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Myto Technologies (OPC) Private Limited", "support_website_url": "https://company.usemyto.com/pop-the-loons/support/", "website_url": "https://company.usemyto.com/pop-the-loons/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341801509024907"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2330044121113938"}]}, "baseline_offer": {"id": "2330044121113938"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793028900, "status": "PUBLISHED", "id": "2330044121113938"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1359451620593229", "version": "0.3.0"}, "id": "1518589723702177", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518589723702177"}]}, "change_log": "Pop The Loons 0.3.0\n- New world: Balloon city, a hot-air balloon ride over a toy city. Pick your world (sky garden, Balloon city or your room) each time you start.\n- One-hand mode: look at a loon, pinch and let go to throw. Pop School now teaches it after the slingshot and asks which you prefer, and Auto-switch hands moves between the two as you play.\n- Every boss now runs its own fight: watch it wind up its shot and lean out of the way. Attackers pop in one slingshot hit.\n- Daily Loons (one run a day for a streak), Calm mode, and a Coin Shop for sling bands, ball trails and balloon colours.\n- A Settings card with toggles, an open palm to pause, and captions at a comfortable reading distance.\n- Anonymous performance reports help us tune the game; turn them off in Settings.", "created_date": 1793466132, "id": "1359451620593229", "version": "0.3.0", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518589723702177"}]}, "change_log": "Pop The Loons 0.2.0\n- New game: Loon Pops, a match-three puzzle board with 100 levels, Streamers, Booms and Rainbows, and optional colour-blind symbols.\n- Now starts in virtual reality, in a candy garden in the sky. Mixed reality is a setting in the hub.\n- Play with Touch controllers as well as your hands.\n- A new cartoon stretch sound for the sling.", "created_date": 1793102865, "id": "1347516975120027", "version": "0.2.0", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518589723702177"}]}, "change_log": "Pop The Loons 0.1.0 (Beta)\nThanks for testing! This is the first public beta.\n\n- Seven levels, from Pop School to Storm Finale, each with its own boss\n- Hands-only slingshot: make a fist, pinch, pull and let go\n- Loons that fight back, Prize Loon gifts (Spike Ball, Ricochet, Seeker, Twin Sling), chain pops and combos\n- Plays in your own room with your Space Setup scan; Swap hands for left-handed play\n\nKnown limits: English only. With no room scan, play stays round you; scan your room from the hub for the full experience.\nTell us what to fix or add: support@usemyto.com", "created_date": 1792831034, "id": "1342273772311014", "version": "0.1.0", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
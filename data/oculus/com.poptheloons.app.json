O2b1lWaY_9-5nagyYqNeuC5j0ili-rj6ExjJPA&oe=6B07177D"}]}, "id": "1644694600397740", "locale": "en_US", "screenshots": [{"file_name": "screenshot-1-draw-2560x1440.png", "id": "4437293329865296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620666_4437293333198629_6923886341449863099_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GHViYBOX1kQ7kNvwHz4LJp&_nc_oc=AdpgdgpDnegd23Ahkp4NuaWYN4P_PkY7uwgCp_FG-KgpPERN43-Wrby0Sn-pS9DumQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQicpFAKaVp98NhPoEtQK437YwvAld7N49ee1SrkMoSAg&oe=6B0720F0"}, {"file_name": "screenshot-2-chain-pop-2560x1440.png", "id": "2658389097922421", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_2658389104589087_2584251200687175104_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kwz5KYokZCIQ7kNvwEUXwNA&_nc_oc=AdrTnK0GtEkMix4WW0a7ru9b0xEmr0W8na1SgUFYIwBq_cLF4MHfsDl4WXZT0mf5sbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk-TdSFCmNeVOpbNNezh2rRtBq3N3MlKv_Z1E8Q-2E3Q&oe=6B06FF90"}, {"file_name": "screenshot-3-boss-bursts-out-2560x1440.png", "id": "4489275407985898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499621314_4489275411319231_4947503055678630261_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaE_M1-sIRUQ7kNvwFQ0tJp&_nc_oc=AdrHVEMLSksYIpxv__UI6bxonHXFoy5fuz9oPhs4o7OuDgChTNN4_qvCJ7ShSdZN-Hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFE2OZrt0-CrfTRvkVBedTkqdNa4tVLLgkbCHQaZ2Eow&oe=6B06F79B"}, {"file_name": "screenshot-4-attackers-2560x1440.png", "id": "1648659737289147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620599_1648659740622480_5142070648870912388_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY0gNJV_bI4Q7kNvwFq6ITS&_nc_oc=AdrFfINE5O32nZz2NAG-N6C30XQKelsbLz_0N4sqcYoE03HSuW3_C5cXWkeUWu47108&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnKiMIjTXUGlRZtLi-Upnw0u3IGNDo6tzCZgYMcvxi7w&oe=6B0723A5"}, {"file_name": "screenshot-5-special-loons-2560x1440.png", "id": "3021373268209445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619059_3021373271542778_6440243176341274969_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8dC4lW05bMQ7kNvwFKsGXT&_nc_oc=AdqShZPGjZNhNRNrtTmkyRMQYh7owhBmPMVVnbYuukqtlu0IrX7J2CanTFDQsjFBPeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJVbmTdNO75PjRhRSO3i7joma_lZGy1IDctW7_CfGTpg&oe=6B070CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1158046133315134", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/836812670_1158046139981800_4535803815628717439_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-ORyUZR6b0Q7kNvwGz7Fja&_nc_oc=AdoHkz7FEXmy4sHUAS-H9lt8iZ_OtmGFWLERf6fbxKuJ06D_ykwN-oSHWicLHMndcWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReTeME-z05tIhllZZzc6xH7KZ43kJueu6kShDIqri6WQ&oe=6B070D25"}, "display_name": "Pop The Loons", "keywords": ["balloon", "slingshot", "mixedreality", "handtracking", "casual"], "long_description": "Your room is the level. Pop The Loons is a mixed-reality slingshot game for Meta Quest, played with your own hands: no controllers.\n\nCandy-bright balloons float up off your floor and furniture, and cartoon critters break out of your real walls. Raise one hand and close it to hold the slingshot, pinch the pouch with the other, pull back and let go. The aim arc shows where every shot will land.\n\n- Seven levels of about two and a half minutes each, starting with Pop School, which teaches the sling with see-through guide hands.\n- Loons with tricks: Bomb Loons set off chain pops, Tin Loons wear helmets, Mama Loons split into babies, Boing Balls bounce round your room, and Prize Loons carry a gift.\n- Gifts for 12 seconds: Spike Balls, Ricochets, Seekers and the Twin Sling.\n- Critters that fight back: Zappers, Laser Eyes, snowball-throwing Snowpuffs and fireball-spitting Embers. Shoot their shots out of the air and keep your five hearts.\n- A boss at the end of every level, bursting out of your wall with a roar.\n- Combos, chain pops, coins and up to three stars per level.\n\nPlay seated or standing. Everything stays in front of you and nothing comes within a metre of your head. Left-handed? Swap hands from the hub. Uses your headset's room scan (Space Setup).\n\nEarly Access: the full game loop and all seven levels are in. Next come more loons and levels, tuning from your feedback, and more ways to play. Tell us what you think from the support page.", "short_description": "Balloons and cartoon critters burst out of your own walls and furniture. Make a fist, pinch, pull and let go: pop them all with a slingshot made from your bare hands."}]}, "developer_name": "Myto Technologies", "developer_privacy_policy_url": "https://company.usemyto.com/pop-the-loons/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Myto Technologies (OPC) Private Limited", "support_website_url": "https://company.usemyto.com/pop-the-loons/support/", "website_url": "https://company.usemyto.com/pop-the-loons/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341801509024907"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2330044121113938"}]}, "baseline_offer": {"id": "2330044121113938"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793028900, "status": "PUBLISHED", "id": "2330044121113938"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1359451620593229", "version": "0.3.0"}, "id": "1518589723702177", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518589723702177"}]}, "change_log": "Pop The Loons 0.4.0, competition build: every loon and critter is open from the start, so you meet the whole game within minutes.\n- Play in your own room: mixed reality is the default. Loons hide behind your furniture, critters crack out of your walls and Boing Balls bounce off them. The sky garden and Balloon city are in the Menu.\n- Challenges are the game: the Challenge Track, Today's set and This week's bigger ones, with live progress on your wrist.\n- Three ways to shoot, all taught in Pop School: the slingshot, one hand (look and pinch), and hands-free (just look).\n- Seven bosses burst out of the wall; watch them wind up and lean out of the way.\n- Calm mode is in the Menu: endless, relaxed popping with nothing attacking.\n- Loons always keep a clear gap: no more stuck-together loons around bombs or in small rooms.", "created_date": 1794926068, "id": "1396535376884853", "version": "0.4.0", "version_code": 32, "release_status": "PENDING", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794908531, "id": "1396112706927120", "version": "0.4.0", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518589723702177"}]}, "change_log": "Pop The Loons 0.4.0\n- Play in your own room: mixed reality is now the default. Loons hide behind your furniture, critters crack out of your walls and Boing Balls bounce off them. The sky garden and Balloon city are in the Menu.\n- Challenges are the game: a long Track, Today's set for your streak and This week's bigger ones, with live progress on your wrist.\n- Hands-free: just look at a loon to pop it. Pop School now teaches the slingshot, one hand and hands-free.\n- Seven bosses that burst out of the wall, combos and trick shots, and new wave twists like Lights out.\n- Calm mode is in the Menu; Room scan and a new Aim guide switch are in Settings.\n- A bigger, grey stone that's easier to see.", "created_date": 1794892336, "id": "1395803466958044", "version": "0.4.0", "version_code": 30, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794891955, "id": "1395796420292082", "version": "0.4.0", "version_code": 29, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1341801499024908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1359451620593229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1518589723702177"}]}, "change_log": "Pop The Loons 0.3.0\n- New world: Balloon city, a hot-air balloon ride over a toy city. Pick your world (sky garden, Balloon city or your room) each time you start.\n- One-hand mode: look at a loon, pinch and let go to throw. Pop School now teaches it after the slingshot and asks which you prefer, and Auto-switch hands moves between the two as you play.\n- Every boss now runs its own fight: watch it wind up its shot and lean out of the way. Attackers pop in one slingshot hit.\n- Daily Loons (one run a day for a streak), Calm mode, and a Coin Shop for sling bands, ball trails and balloon colours.\n- A Settings card with toggles, an open palm to pause, and captions at a comfortable reading distance.\n- Anonymous performance reports help us tune the game; turn them off in Settings.", "created_date": 1793466132, "id": "1359451620593229", "version": "0.3.0", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7_qUVFqDB4Q7kNvwEvG0DC&_nc_oc=Ado_0oIJ1wa4p2PsjEy58uIa6fvSBo9bXyuLwKf1luXWbKmUgyei-OM7OvlorgDJp_I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GbGvjfXm2dOGk5SjTlDAZ5tOhlqZqhTwvMG1CEe_sjw&oe=69D79002"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJqY64FxpvgQ7kNvwHz_HQw&_nc_oc=AdrsLBizXjWqkoGdM-yEru1LJaJF5B0HZ6z-aX4xbLJMokEjPpWHeaWpQzLvmElznCA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c8JsY-cKQPbyRtx9F2mZ_EIQLH_99KebKNKI6OLSF1Q&oe=69D7BBF2"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJakTgOZkRUQ7kNvwFuGf3W&_nc_oc=AdrmzfHRTdXre_2xpL22x9Xdy8ejuyeVoQ5Xqu2CL4VU_jf45Acw0TTJHIJ3xkadgqM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QQ1GlKcvZGVvtPZqxsTeUfrwjR-NXU64iMLbYNF_2qA&oe=69D79C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsJqQqUGql4Q7kNvwFSZhUn&_nc_oc=AdrkY-H-r_7SzYBRLqR0pnyOBLerOgWK-wl_Kz_azd6yhsXmhdFDLh0QDtV30F-dpmQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UtUbiG0KPcKmzgXr_gNhHD11C1s-9_IDftsaQR0Ui-g&oe=69D7AA25"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRmtxu0Xxi0Q7kNvwHJYqvc&_nc_oc=AdqDM7tANVgbtTYuPn0FsT4rIOInglJ
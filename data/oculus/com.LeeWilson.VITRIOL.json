nce to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWQzyTqecToQ7kNvwHxC_qT&_nc_oc=AdlYITrb1nO7hbnjHFUcDD6sP7WCcWfZQNtnsvQ0ER33TYkDKJ3AQgUuiSSW0HJWuw8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afud1dOWKlH56kDrfX17XkHTTEX_leoGR3zd734mZq6KSg&oe=69A17D83"}, "is_concept": fals
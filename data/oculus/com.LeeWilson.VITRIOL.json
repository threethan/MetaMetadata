3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmWJF7t9Jw0Q7kNvwHGFKnL&_nc_oc=AdrXQNhp6tO-fOwicFvwrRBLTpl_wRgJ3Xx2xopRGzV2_7wXvZ41IH-nRn-f-wKe9PU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ziz2jljG077RZzCSFItqKkoUA3kwxpl3HCrzNLjoiEA&oe=6A1DA7C2"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-P0YtNzojEQ7kNvwETUlQE&_nc_oc=Adp7H5BwcuS0wlWFwJbNGU4CpSRWLEmoaJsxq2hsDthG4BMo24t_nUoMrJqPURk0wvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af659YpZkKCzO6zFufRGuOsk-NnvzliUy7Wq-_Up9Rh4LQ&oe=6A1D9B72"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MogE_Cn4E3sQ7kNvwFdYNUu&_nc_oc=Adqabz4W82X9z3YB_qP32ROrkBo3uyZ3ZLozm31sZ6j2C1NT06Ueihalu1XnYnFqpP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K8RiVT0rFVec1lAxGSbHei0BB07u3vawft53gaBv3Tw&oe=6A1D7BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJ7i3YjFnRcQ7kNvwH0Ufq1&_nc_oc=AdqBjM5SUiS4P1oK0Udo7U2v3s9WduxexsipuBu-25UCioBddwBc1t7n58VtGuGWIeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r3mb8A7wVYSNX6dGOhDc9c-j6AAftZvOIh6ONsM01BQ&oe=6A1D89A5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCtD3M9RJwgQ7kNvwEjrmFv&_nc_oc=Adq775wdDcfkBZNzCzmGMzZwqEsgYc_
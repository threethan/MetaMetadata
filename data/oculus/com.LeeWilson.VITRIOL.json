3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tethMoICU9wQ7kNvwHbtbLP&_nc_oc=AdrAJ_t1_Fyn61IWLdUPqKNXV0PJVs07UHgRyfO40uIqc4iJBt52k_wautHiQ6bp6i0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IPKpZgpZ_CdXtf6JUGQPpuh8VsKmXw5wMRxe9IdABsA&oe=69FE03C2"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Aop-DhKBWQQ7kNvwFGf0rv&_nc_oc=Adp7HnSaJf1GeD7C0q9ejp3B8tWpfl2O0em5sY7PDvEEhqjIVNMAPjoIdjq9A85Si1Q&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X7wYP2pIuYoFysWoYvPVj7Wo1Ma6Jrb71I7bi0GGdvw&oe=69FDF772"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5T2a33kRRcQ7kNvwFUYFEA&_nc_oc=AdrEPv6JNLMnz-wQDHg56vX_8N7y5tLO_wftdMyaGckrd5rvmJa-3uOFwdpyZN3b_9g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iWP7OivbufO1Z3uC7KfefI4deF0JtEYTUp1g7i5bncQ&oe=69FDD7DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPuq6UlpM0IQ7kNvwHzN0Oo&_nc_oc=Adogd_qY5AcypMn20-tR2kcxVxV4ktNo8zYogGvW6hgOIYuNnO9q5Gd8CEkMzO26W2M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WYHOrrRCzpXuDY2ReCr0WOlKQKT_d2lfKeM8iOi8iSQ&oe=69FDE5A5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKiIjtQjemUQ7kNvwHKyCei&_nc_oc=AdrATsbXkNgnRYN3ceCtmraXch6b-m3
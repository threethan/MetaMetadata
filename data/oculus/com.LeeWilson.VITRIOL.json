3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paDWrNDvHqoQ7kNvwE0TGSM&_nc_oc=AdpVE1px28D4Ny5SbQu6GDIohfwJo3GOxJo4qrqmFPcSaQ5oD8GA97OKe31U79qs2ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmc9I0Xclum-mvDOAM5EK1lOyY6i5PQuilIxetNpSyAQ&oe=6A79B882"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDc050Ga-2YQ7kNvwFT8PuS&_nc_oc=Adrc3TKsSw3qjvqiuUc46yJoi-CfCTeThSnMXVn6tknjAGBAPQOu8reioz1LSkGa2-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVwwV6lXFqUfUk4DUgtt7Ru5Qsf2zqXd6M7fa4SJULeg&oe=6A79E472"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpeWHA3Kv4oQ7kNvwHyk4Z4&_nc_oc=Ado0XopaygCazCxX99BXvXJq29xayeuPCTtCtcbepz8q2-ta13M0khKBhSMctzz6ptg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXGA8IZKFeH-XrZ6CqfnoszGXZOE1xHUM52CB0VlYqsg&oe=6A79C4DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttFkExG6k34Q7kNvwHNzEW1&_nc_oc=AdrKJ8H6DZG7d0jb8hmegc5x9Z6pPkoxWmJdSPF8xHxRIB56DSas6cVoWgnc4IHTUkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnTb7SqTwb8cF9_DORHbFMM1h65BW2oZsUfvmzmGxAcg&oe=6A79D2A5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIAh3AyaIroQ7kNvwEfGhm3&_nc_oc=AdrVEnQHtOCMe6KekyWuI59knKqBbaY
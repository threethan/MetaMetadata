3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXCl5BTsLagQ7kNvwG5gFym&_nc_oc=AdooAfr5YZI7QKzxBfV8jwpQQSfL_m-DR-9U1udko-BnbUNeOlB_tIdI783cPhpF5W0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQJ-hEseNx9sWwtT4I_ZJsleF6Qr1AEc8FLTDEyncc-Q&oe=6A86E782"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TEsAeWhLB4Q7kNvwH50I_E&_nc_oc=AdoRlIJvv3qJ6gKahkr78EcwGD4oEsc0xvTHc_56BzDboygT9JQrfPfJ9L7NSO3ci_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmXFtnG5_3R9N5eZK0-QMRGLTIK2nlMYQj_tlkKqBdMg&oe=6A86DB32"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f0H8iz1R2wQ7kNvwEoc_Eq&_nc_oc=AdoMGzji53gbWwZ3xbD2IK2UBdG5tsW0ZqSjlQRWO7Z26GowczcHLJn3NHl7yQZ9-CE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_mMs8mR4tHWU6gZ7vdvHQPMIi7VvuukVOdOyUzlce2w&oe=6A86F3DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojY4CLwOp2QQ7kNvwHzm8Kw&_nc_oc=Adp-74wYsllDX-qNddP2A6rgnxsIGhVM3YSefLZjVIP7AhxWJWKO5pV00WultQn8mQ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRvp2kqkEInKGhsSN9SvsaCIwe87Ofw2nL2wU-DZjASw&oe=6A8701A5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gz7KL8R6sgQ7kNvwEI-Xuw&_nc_oc=Ado0i8Eq263dXWGL4KAI_HyhZrEHIIS
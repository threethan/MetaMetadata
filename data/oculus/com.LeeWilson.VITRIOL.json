3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zft0wpQ3GOkQ7kNvwGtgwFQ&_nc_oc=AdqBAvSGvt4oE6-d3BBXBrHaJ3AgbK5BLj5Fi91IGM5tSFO_m4x51oyLn3KcwRDEpek&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UbOMc38y2AIaghRweHlbt8POwxCkRCjQEGK1xs2c4vA&oe=6A1078C2"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgH1OhayHxQQ7kNvwFyRb6i&_nc_oc=Adrlb1lBLfsODetHRYB_zwT9RzW2_8rpib6SkENFPDyUsUl-Y4q4jqsFNpIC2avdSvk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p-u6-1Y35c1o5DXnL6fuTnoHOc3cle7cxoyjKcVvxmg&oe=6A106C72"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9DKrAfdCBkQ7kNvwFAa97w&_nc_oc=Adp6TGPeIAwK_RGRGJW658qqSJtAaPcNJ4AQVDp1-I0oFVY2q2UUJlaO6yfu67q964o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TRWlaaljgEiJraW4TPRDzZFrlmRtBpyZRhgvV9GdVYg&oe=6A104CDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOOkFO52Wa0Q7kNvwE8wth1&_nc_oc=AdrwKmFLt2IbricTSBpx_673qwSnQ58DRrvjX2VjeS00YFVHRa8Jc9NS8cDqyctYW7s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t3phXzx9i-_t2BdDrp91gqiKS6lX5VPf10xqEX7zwDg&oe=6A105AA5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XlTVbif5ScQ7kNvwFZ4d5d&_nc_oc=Adod7ps_NUsD6ZYi4ymEi4yR4it3wVL
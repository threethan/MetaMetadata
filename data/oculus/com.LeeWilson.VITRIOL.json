3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLXLY1OdwqsQ7kNvwE3Wz5G&_nc_oc=AdqT2cO4h2Rqm193bNHVQH7h5h-INtamtyDCzx2xlKod8ZVhvgNX6vT9ahcdI_RB1VA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-3CwmxUAi7713TEIHNNkPhpXqQjQYaRkzVXX72LJHrA&oe=6AB14FC2"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4QW5odoiG0Q7kNvwF6Ks9C&_nc_oc=AdpqlIpuPp6bOlLzyjwOdJqFvLZLzXQCAf1ufolqleibDm2ttXzM3dA1nTYj62nhyxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKL-sx-GYKQY3DFGZQa3jzn1HN8CfiJGU3t4oN2NipDg&oe=6AB14372"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOd75lCwKMEQ7kNvwHiHRoA&_nc_oc=Adou9E1PtkPgKYJfAr2SV3JFwn_zQ_T9NCTlCImd4np8tr2LCA8maQoVlyYcnhx9yPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfVzGPl-HrJcG8onA6_qecjdE8DSmjp8k2_GuRuoyHxw&oe=6AB123DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRiz0d3ng0EQ7kNvwFsIuVL&_nc_oc=Ado-VLNmWI1Ug2sGVxRLkBR_AdNhImBDxcGWRDqCatcUksx6zdwRsr3R30C7keDet_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5jyezNsEWMj3zElRFimr0-Efa4EiZUDgDgxie75VFxw&oe=6AB131A5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-075dTNGhHgQ7kNvwFD4-Jh&_nc_oc=AdrpXH0M8EIbtCw_0VOH8nxsL9b5TXb
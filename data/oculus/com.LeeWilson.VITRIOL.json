3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spXnJqx_2_gQ7kNvwGhTfPA&_nc_oc=Adpgig4QFhacRpO2k0CHnJyekkxIgZ-qsFUD5iTtoYYAIzO9PyjwlwzDwoBIRn1cnQk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvPWmSj0XJWht0lYiQ1S5RS4PMGFkNfhkufs5A4YM0eA&oe=6A902202"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuxdXz697b4Q7kNvwEDk0g_&_nc_oc=Adr4U62LVoNY1XDgrj1l8huf-NX1D2TuHT-v-IVj2z4crPAEpg_2jPSpGsxBTQJSXgQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2yKwW8yXQk1ZTSxZu1t9EgWMd8u6HCJMgNtE9YZ-vZQ&oe=6A9015B2"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkU5uf0AKD4Q7kNvwGmfVBw&_nc_oc=AdrVKge_4d4yodWLhlJPYxIs-b99uqWDQhR3ZGPmvTw4ip91Ldk6tRtruRKjfGMt5hE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzYIysro8X0IMjJ9fiIr_RclmigMX2hQ4Cyf5GLysS8w&oe=6A902E5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga11F5xPFqMQ7kNvwGCtcne&_nc_oc=AdpH7mWXQQWaOeRUE6ojvCD_1Gexh5dh6KlgrgY4uDXMehbOnO_bzswaCj2q24EYtG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELfNROF7PmdKirnLmChZdEJjLDmsSTbycmQ-pZ66s1Vg&oe=6A903C25"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg3bLUbflAkQ7kNvwEfsWaR&_nc_oc=AdrkMoIoHlUcgem-omKp-Ze32BczcBW
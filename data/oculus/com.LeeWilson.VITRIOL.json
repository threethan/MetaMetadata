tNHBB3WSvOBr3G0hEVQusJezGZZ4pdPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqG2UE8Q3BPesmlNtgWQ26erNuivCGMk76qTfu92rH9A&oe=69A6C882"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOj7G92wWHEQ7kNvwE6yHAX&_nc_oc=Adk6YhidoxhzqdRCsZkmg0uGL2HI4zCu2PF98P12Sni-PFQ1endY2KHMAzwMuu5rSj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVBbxDKIh7L9MlGbJtosHB_9h6g5-6zHrVu97proIGNA&oe=69A6BC32"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLmybQYwexQQ7kNvwFF6rwI&_nc_oc=AdnnBdcWnCmspIBT_AzugalOx3eTCeKlZHdjN54KElhelTqhrxttX0bv4UvcOX2fSTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLNWqQqslsg5aq6DPBoSqYp62Jr2m4vGfJFsLTGkaUMA&oe=69A6D4DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViyXq_Xld5UQ7kNvwE0g5gi&_nc_oc=AdnsqVr1fEkOmED8wW0XEhXPxkmMA2r545lUBnDlxnAV4yZCKv7GrNpY67QOJ4wJeCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXIs39og_imG0tMeF7rPZUqonlnwjuve7t-XLofCPm8w&oe=69A6E2A5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON_dSXDdUTsQ7kNvwFo_70y&_nc_oc=Adls8mnURBhagKrmncXnSZJxLdhbAUcebuZpzQ6x5o9b1vCHN45MJ-8KTnOw9wJ-iUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsOsGJwPvxW64Jcew7qWhp4MgtP-eS9DwQ8nWS_Yc0LeQ&oe=69A6C383"}, "is_concept": fals
AYmu9e2tbwbz9t1kKEq9Skt6PfXtuhtOY26UCUAc2FZ5QGTpa7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AcMxUDBg-x3Iia3tbj04axC6AT63ZiqI_cyjctOWZ5Q&oe=6A29688C"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNCRc9AzkjgQ7kNvwEA_9qL&_nc_oc=AdrGpsbRi_wlWtMddGjx60AUBRgC5MSmQWrtvjk_6JshdDUaF3MDsvVLbHjI20veNkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1XL-G8oRI0aixAL-oCxvIxOMX4CivCTUdoGrfR3-fLA&oe=6A29595B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdHlK41U7ecQ7kNvwEGKq_H&_nc_oc=AdqKHHLNdiKwu2nzQ3ZnFyjPPvOwY8VUmvjYTycAky0dMUkFfKjFjvct0fMsuZXRc0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wVlBm44uUOj6iOxQFnVd0CBRaTLbhpmabMHyIUF-rAg&oe=6A296725"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "MARCH FOR YOUR GOD\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality of VR through physics and retro coat of paint. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease VR is yet to experience.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, The Righteous Risen. The Wrath of God in Iron Men. All this scored by a soundtrack that hits just as hard, drowned in a haze just as thick. ", "short_description": "MARCH FOR YOUR GOD\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality of VR through physics and retro coat of paint. \n\n"}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8642895749145736"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1161131858733269"}]}, "baseline_offer": {"id": "1161131858733269"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740778740, "status": "PUBLISHED", "id": "1161131858733269"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25011882881820430", "version": "1.093"}, "id": "1721337042018994", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8027404130694904", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2
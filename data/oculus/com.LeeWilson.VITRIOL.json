76476343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwTApz6RZMwQ7kNvwHbDkJR&_nc_oc=AdpFwecxp1NpmidCI7nJnRDN4vDYUT5_IF2Vj3IUCl9RT0kPCUoKkolgBZ7hmbmSeYk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7Q9MJocxFD_v_sgek5EFYrEOjAl7uEf7GMf-GmSPSAw&oe=6A36B442"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNIj31Z0f7oQ7kNvwG9fLdQ&_nc_oc=Adqh--U6XQPgTP3mbNWvI55du4ukFj_nK6ZQXIOLoCoCcxA-S5dgIyr9v9LLOcFBOPI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g18qMQ5Ps9ruXsGR3ROnMrShbbpEhUENpzW4jrZ5aHw&oe=6A36A7F2"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuH9VxzXab0Q7kNvwGY4ebB&_nc_oc=Adp-dj3RYGrA_f7RNouOw2CJ_VH73CEUz0yTyrcwElOi_qJfp43MZu9sWjWuVwf5x84&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__tfsWr5qFF-lgX80iw7Uktw_t8Jhk_cLhqxn0ZBX77w&oe=6A36C09B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGVwtmuiuOwQ7kNvwHZCK3W&_nc_oc=AdogddGFXBTUEXnqaVHrStLHoIpjfAFgzTNQVTxmgSn80YDL5NV7-0LkGyK5wQdnGFE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gaSNWJIHOx8fuGu0M4vmYZYzjhhCyZ6iC9yeksznEVw&oe=6A369625"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3acoA36b1cQ7kNvwFaCKeQ&_nc_oc=AdpgODPM_bM1rit8M09K2
acking with any headset & its two motion controllers. \nAllowing you to punch with IMPACT & shoot with REAL RECOIL\n\n\n\nSlide, Punch, Spin, Shoot!\nBullets WILL fly, Demons WILL explode, and Blood WILL rain over a World in Ashes.\n\nBurn & fallow\nFor now the Demo consists of One Level, One Fist, and One Gun. That is all you will need.\n", "short_description": "Physics based MOVEMENT SHOOTER\nburn & fallow..."}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@STUDIO_RAPTURE", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27626337957041563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303174_2271336133665886_7227805036427785406_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHnp02Njf5UQ7kNvwFYSKte&_nc_oc=AdoWrzmZ9yQ2HGkNmIliV4kWMoM4mH4Ao-kaCa-ZIEyz1V7dets0h2unO6vgIw-gBVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSM4duD1rSd09tn00rRkaMzVpLVTmVjhsrinfigOI7cg&oe=6B0DC72F"}, "is_concept": false, "is_test": fa
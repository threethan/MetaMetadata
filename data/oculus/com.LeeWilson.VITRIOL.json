3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqaRaIPK7uIQ7kNvwHwoBs2&_nc_oc=AdqrVwpdACY1uV6dQSEPhi0kXKg1L-R9N_43RnNURuJQHSVhzTVGvcSWUSA65WNsz30&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zEdbJ3ymCjK5mPTEi4TKnS0Sl9_0BftJUdwDHkXDyRg&oe=6A2C2842"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng59R0l8fxgQ7kNvwHsH6fE&_nc_oc=Adql7LK013vsK9qdpWvZlviSFJGmWoWiC4HbhE2I0kdNJU_ubIy_CrWv3m8WNat70d0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jUcqqKLcfI5RdgVSLqQ7Sy8pNi_JIBPy5qQQMI3nFDg&oe=6A2C1BF2"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCAA1NYgbSQQ7kNvwFB1KJS&_nc_oc=AdokkJMSs4cGlgea8qNEFp9NN1b2jvqbmYGSa3Vz82sB5d8Li82qVkKhXQaljyFHEOM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KM94wTuayM5owb1r6-FBhg5dJ4mshNYs39ccukpqJNw&oe=6A2C349B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdHlK41U7ecQ7kNvwF8K_KT&_nc_oc=Adqj7zbwDuBOt856qAJZXf0wOiy10Lah1BCGmNH9QE_Ugp2vVpQ1prTOpbwiezNPcL4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af874OL2Xm6Cd0JFlG_CS6SrULC0CCAJvFtK9yHibp2Uew&oe=6A2C0A25"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVFOdiYzHXoQ7kNvwGNuGMW&_nc_oc=Adq1L2OqV8BhOpGPbgx1bUVpmafOGD-
3_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej3sOXGIFdAQ7kNvwE6sqn-&_nc_oc=AdpmNYXBiZincli6vw_fSUDVcyMPvy3j4IRv3jk-axPWqALgFXpc7YigVIeIOqGj1C4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCIdsK7Zf8y-e7IPNr4h94EsFq7F6D6736r8uoG96nwg&oe=6AB695C2"}, {"file_name": "GrappleBroker.png", "id": "945573537196809", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_945573540530142_8981120136422383789_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLUeP7-jZE8Q7kNvwH206Jb&_nc_oc=AdpAH5vIxC1LkOqvTcvSgpKjBDJRqiyRuI2IW0J8TXhbyXmyQDVHVufDr7VMmngGU0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn9WT1Ouz_tz4yrba32i_vxxrhbsEG022busDVQuTang&oe=6AB68972"}, {"file_name": "Spin.png", "id": "1302877217402173", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392338_1302877220735506_6589252251697966130_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6Lsro1ck4IQ7kNvwH4yWpS&_nc_oc=AdoE2Czx7-FIJPbqDDt-XoXDbBBgsKSjZPaSby0LyoD9JX5_bmbYISJqfLPKdBBKr3k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5R4yO9B43ghfRFG0gE2tNLybc8vw3anfWzCzYVxHyRQ&oe=6AB669DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HUHUHU.png", "id": "2035477956919467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392314_2035477963586133_3759903070723388888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wf3kPKXvBSgQ7kNvwFJmeER&_nc_oc=AdqozuaNo5ZvBa3TEbEKC1iIVtVUWYTKZf9oXPrQQdxfQwctsAtS9D23rCiutrZtKMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp9PGmq_bmGZqSimE70SEMKKNn-m6qNT8m6qJ_7SpWww&oe=6AB677A5"}, "display_name": "VITRIOL - DEMO", "keywords": ["Physics", "Fast", "Shooter", "Heavy", "Retro"], "long_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. \n\nFast and Loose - Long strides and Heavy Blows churn through the wretched horde with a freedom and ease rare to VR.\n\nHand to Skull - Physics based Enemies and an in-depth elbow estimation system provide a physicality and presence to the combat which enhances gameplay beyond what was previously possible.\n\nBlood, Fire and Pillars of Smoke - Sinners malformed, Righteous Risen. The Wrath of God in Steeled Men. Scored by a soundtrack that hits just as hard, drowned in a haze just as thick. \n", "short_description": "BURN AND FALLOW.\n\nVITRIOL is a physics based VR movement shooter. Combining speed and visceral combat with the presence and physicality VR can only offer through stylized physics. "}]}, "developer_name": "Lee Wilson", "developer_privacy_policy_url": "https://github.com/VitriolDev/Privacy-Policy/blob/main/VITRIOL%20DEMO%20Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Lee Wilson", "support_website_url": null, "website_url": "https://www.youtube.com/@VITRIOL_VR", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9330459860389318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392031_942862054669695_2945381102806313297_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgEJ_jcJ3AUQ7kNvwH1-wiS&_nc_oc=Adqxj5cKK-5COuX2tC0ZgEm0A6znFCU
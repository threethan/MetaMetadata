_nc_sid=6e7a0a&_nc_ohc=hPovV9dnqHMQ7kNvwG_Mwg6&_nc_oc=AdpFYDj8qNNnkrekHTch_DeOlX5Bo0371nje6RCFR9NIPC8hLpgLwB0sGJiD8jPXCxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QJd81XUT8Xsr1m1uIWGjmq1Wn3d-qIafR7vy4WQo7ng&oe=6A047720"}, {"file_name": "Core elements of game play.png", "id": "908716783334316", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_908716786667649_9219195802101839858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIGdgCIf05sQ7kNvwGbV0d-&_nc_oc=Ado9lb8oBrKQAuvnzOM1mfxPR0om7mDYX9LFa9S6WkJGLT4VYQ0oipjxGV1a4qR0gzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af688mtIse4hfs-0MpV_uqvy-o0k1imq2B3Bzrti2WZjbw&oe=6A049701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Launch Video thumb meta.png", "id": "1295631934949726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1295631938283059_3267256180983597643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2M--DAaLucQ7kNvwGs8nku&_nc_oc=AdqZiedWZ0Kp-ExS7P0rB3u156mc3BQ5Nt7npf35MAkeUe0m3flH_siwxMZWsIXuVWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fgQKssL6EcR6RAVB7MyzJilUIr36GU6f-SIbiGVJWKg&oe=6A046373"}, "display_name": "Iron Rebellion", "keywords": ["mech", "shooter", "simulator", "multiplayer", "Combat"], "long_description": "**Climb inside a colossal war machine, where every switch is at your command. Iron Rebellion is a VR multiplayer sci-fi mech shooter SIM that puts you in the pilot\u2019s seat. Customize your mech, control every system from inside the cockpit, and face other players in fast-paced, tactical PvP battles.**\n\n{1572799036680108}\n\n**True VR Mech Pilot Experience**:\nBuilt exclusively for VR, Iron Rebellion delivers a fully physical mech combat experience where every switch, lever, and system is under your control.\n\n**Tactical 8v8 PvP Combat**:\nForm elite 8v8 squads to dominate the fight in multiple game modes. Victory depends on teamwork and smart decision-making.\n\n**Deep Mech Loadout Customization**:\nChoose from six distinct mech classes, fine-tune your mech using an extensive augment and loadout system, and customize your mech\u2019s appearance. Adaptation is key to survival.\n\n**An Expanding Cross-Platform Universe**:\nWith an engaged community and active ongoing development, Iron Rebellion is evolving beyond individual matches into an ongoing war. Currently, Iron Rebellion supports PCVR and standalone Quest with a cross-platform multiplayer experience.\n\n{1267730347693941}\n\n{1114586743387378}\n\n{1180527426954687}", "short_description": "Climb inside a colossal war machine, where every switch is at your command. \n\nIron Rebellion is a VR multiplayer sci-fi mech shooter SIM that puts you in the pilot\u2019s seat. Customize your mech, control every system from inside the cockpit, and face other players in fast-paced, tactical PvP battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iron-rebellion.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Black Beach Studio, LLC", "support_website_url": null, "website_url": "https://www.iron-rebellion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25709112152124502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
_nc_sid=6e7a0a&_nc_ohc=TFH8atCs7JsQ7kNvwFH7hXH&_nc_oc=AdraFau20iM1etx0hmvzwmrVpCvQmxghYruyUiZ6VobweTyLZFlVxdIukRwfD50z7kM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKmvSA63muaKymPtAZC5CKcBYJGvv9KCzTqTptLuJI8Q&oe=6A5A28A0"}, {"file_name": "Core elements of game play.png", "id": "908716783334316", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974904_908716786667649_9219195802101839858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvNYzAsdyiMQ7kNvwGzqohc&_nc_oc=AdoVIWizbcdQFI4lpMlT8YSa23l1wfJkTvLcpoAaAo9p7IfDoX--37XmiMY-bynOTyA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBjOt3Fah5SW3s3ODIj07DlCALXzFEinPIfiev9E5GsA&oe=6A5A4881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Launch Video thumb meta.png", "id": "1295631934949726", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1295631938283059_3267256180983597643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9moJrCLredMQ7kNvwHLqn52&_nc_oc=Adq8ss85xAcbPkb2JiYl1WNtxQSU0w140VKWgPbioi6ZduB5VZ7j4kL8PI1VkJ-Y758&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgEIL6JAkIRfP3SaWEvNZ8QxOUIFC2PxvCC3JfY5fIXQ&oe=6A5A14F3"}, "display_name": "Iron Rebellion", "keywords": ["mech", "shooter", "simulator", "multiplayer", "Combat"], "long_description": "**\u201cSuperb and probably one of the BEST mech games in VR! - Think HAWKEN but better!\u201d\nParadise Decay Game Reviews** \n\nBuilt exclusively for virtual reality, Iron Rebellion delivers a hands-on piloting experience unlike traditional mech games. Climb inside the cockpit of a towering war machine, reach for switches, manage power systems, operate weapons, and physically control every aspect of your mech as you battle for supremacy on the battlefield.\n\n{1572799036680108}\n\n**Tactical Multiplayer Warfare**:\nForm elite 8v8 squads to dominate the fight in multiple game modes. Victory depends on teamwork and smart decision-making.\n\nNo squad? No problem. Play against bots as you master your skills throughout different game modes.\n\n**Six Unique Mech Classes**:\nChoose from six specialized mech classes, each designed for different combat roles and playstyles. Customize your loadout, install augments, refine your strategy, and create a machine tailored to your approach.\n\n**Cross-Platform VR Combat**:\nFight alongside pilots on both PCVR and standalone Quest through a seamless cross-platform multiplayer integration.\n\n{1267730347693941}\n\n{1114586743387378}\n\n{1180527426954687}\n\n**Have More Questions?** \n Hop into our Discord and join an active community of other mech pilots.", "short_description": "Pilot a colossal mech in a VR simulator where every switch, weapon, and system is physically controlled from inside the cockpit. Customize your loadout and battle other pilots in tactical, cross-platform multiplayer combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iron-rebellion.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Black Beach Studio, LLC", "support_website_url": null, "website_url": "https://www.iron-rebellion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26904638429238529"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.o
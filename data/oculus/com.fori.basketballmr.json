oO5-gK3CAOSg-wZnm_KSGLnfA07Nh0giTIvKfks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyidyLqfwt7jgpHHnM9AyJFBp2TxGRnfwugoUQaSV0r9Q&oe=69B95D93"}, {"file_name": "Screen 04.png", "id": "25520275274222489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_25520275287555821_2012326797416104286_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTCyJJVA6oEQ7kNvwGG5Gdv&_nc_oc=AdmbdpELpCcVjlMyPVMe-Vo9VtWTbypi-B_yu2YnAs3zq6ZwGYDWQqPcSEVSBSAZ9kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxqmq9KY8cDjRLC8tNu4mIPCV6DYrf3dyHvbnFwknJNvg&oe=69B95E1D"}, {"file_name": "Screen 05.png", "id": "1440068893750998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1440068897084331_2820687224807063652_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InuHgvWVgMMQ7kNvwGytfzB&_nc_oc=Adm4_bDSsXIQp6hHZFkp41_AJZoaQ0av9Lym9YpJlW0iIvfSBkLnVs81nnVq08a-hnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrXAn5OVoyFX5mpexJB7nsY8BMkHaHS89diKA0AjSR6g&oe=69B95433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "1442603080310301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619148_1442603083643634_4379852038314531918_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmOVZynLEHcQ7kNvwF_Qhn6&_nc_oc=AdlYsGOnPRLdRma92brV6Bc4VgvaBwwhFXH43h7VUF8ChCjhiQ-9D3Ww6wGW3dhlyyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPwCh433hTu4wpNcctW8tCZCBd2tnOsXlCpnH3ZI9Nvg&oe=69B9603E"}, "display_name": "Basketball", "keywords": [], "long_description": "Transform your living room into an interactive basketball court with Mixed Reality mode. You can use your hand to grab the ball and throw it, or you can use controller for more precise movement.\n\nArcade Mode: Rack up points and break your own high scores.\n\nChallenge Mode: Push your limits with a moving basket and unpredictable shot angles.\n\nPractice Mode: Fine tune your technique by adjusting the hoop\u2019s height and position to your liking.\n\nStep in, take the shot, and let the game come to life around you.", "short_description": "Play Basketball with Hand Tracking in Mixed Reality mode. Play anywhere with just your hand. Beat your high score in Arcade mode, challenge yourself with a moving basket, or adjust the hoop\u2019s position for focused practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foristudio.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Fori Studio", "support_website_url": null, "website_url": "https://foristudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25111594788469966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619836_1126872892749374_3771335018134577427_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wUxqdyGmvYQ7kNvwFUMICO&_nc_oc=AdntH5O8V6ObhpjxzLh2p8M9HN3ao2QAGp6WIBeu15fVscvpQQk3cRhgr9MQp-6u0Qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfykL2-KxJqfbOXFUxrxPfwlGvz_QA9xU3NA52pq3A5Z2w&oe=69B964AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Basketball", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
aVs_wJS2aiI1a_NYsVq8x-uDuQpVCfKkQjIg0S4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQQTWR-hHguPmZxx7NTU9JESnZSi03IL5_hbVU5RbWLQ&oe=69B02313"}, {"file_name": "Screen 04.png", "id": "25520275274222489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617762_25520275287555821_2012326797416104286_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLscFyYr_DIQ7kNvwE0u04O&_nc_oc=AdmXhSMKMriKUvneiOmmhx6hUVRHYg1x7lIp7YOOtZJhhDXUBzcsMPolorg6gg0R9Gs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVuJyEs48hab7UpwBdvWl3u2Vlyc6tc6H_sV1NCCWRWQ&oe=69B0239D"}, {"file_name": "Screen 05.png", "id": "1440068893750998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617762_1440068897084331_2820687224807063652_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPu8Ji7pJYIQ7kNvwGXKjOS&_nc_oc=AdljwRrnVlUq_EWQzGS4iioYcKmmzNPSefWrpwRfbeY1ggHnSoRU7JNl72NR9SAtUJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwg7KqFRM_rfNMaftCvkQQjRA387b1BUA8EpbpOkTNTyw&oe=69B019B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "1442603080310301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619148_1442603083643634_4379852038314531918_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEzHA_OxlVoQ7kNvwGtKl8d&_nc_oc=AdnUdOG70qcsFssa20CzVBkgJ27rn3B2v4lMIGOVnxtpPGtYo71JgLPOzaS0ida_fGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRPA_huLAsaEqipcx0M5cVW_eCXnfmO9-wceyDTOVlUA&oe=69B025BE"}, "display_name": "Basketball", "keywords": [], "long_description": "Transform your living room into an interactive basketball court with Mixed Reality mode. You can use your hand to grab the ball and throw it, or you can use controller for more precise movement.\n\nArcade Mode: Rack up points and break your own high scores.\n\nChallenge Mode: Push your limits with a moving basket and unpredictable shot angles.\n\nPractice Mode: Fine tune your technique by adjusting the hoop\u2019s height and position to your liking.\n\nStep in, take the shot, and let the game come to life around you.", "short_description": "Play Basketball with Hand Tracking in Mixed Reality mode. Play anywhere with just your hand. Beat your high score in Arcade mode, challenge yourself with a moving basket, or adjust the hoop\u2019s position for focused practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foristudio.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Fori Studio", "support_website_url": null, "website_url": "https://foristudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25111594788469966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619836_1126872892749374_3771335018134577427_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vpm0a1Y8A4Q7kNvwEdmp_r&_nc_oc=Adko3H1a8IcElSXc8cAa1thPowOjfeYZdyBZXyefYPbej-WqIF_idz5VMZx_VHBy7VM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwojUOnNDiSKoJqd14vHljJXjctSbfkksUDYVyDMKeTqw&oe=69B02A2B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Basketball", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
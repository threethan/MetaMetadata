O-5dp3yzAKlErVNZs1z1Kz7HVRNtgd8jj-LMkJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmQ6SRxxkDwm754toBmofiKzvo1zvzA0FRWd6PYyK1Ag&oe=69B56913"}, {"file_name": "Screen 04.png", "id": "25520275274222489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617762_25520275287555821_2012326797416104286_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5cc2gL_Ym8Q7kNvwHAnUt9&_nc_oc=AdmgQpw8a8oTYtw88PfygXKROKsoDeShICsR3uyi15PQDZ4fBMcfpkPR_EnT-t0Zymc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyN6XS-JkYia6lY5XcF4d51r33A6a2smBxFr8dl4OC_YA&oe=69B5699D"}, {"file_name": "Screen 05.png", "id": "1440068893750998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_1440068897084331_2820687224807063652_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nYQCcVmz1gQ7kNvwHFfNaf&_nc_oc=Adn1LR9ma-vB7H9Kvum9hLWXqKxCd-zSIkkbf1J_hZfdDPluBA3dfOII97X5eMqrips&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIiw6eBVZtouShlLFZoQnfnYhH6ypN0FaouzMC8O8DeA&oe=69B55FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "1442603080310301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619148_1442603083643634_4379852038314531918_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQonQhJk4uEQ7kNvwE4Md3w&_nc_oc=Adk6k7lceXAZxS3VeQ9TKv34_msOcpCC4pHaJlSn8gRX6zl6fQQvevcdSAj3skwT1VA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx740fpgkkqjLCkVg24Lv8VGfLFK1OAw3OoaTO-JxY3Bg&oe=69B56BBE"}, "display_name": "Basketball", "keywords": [], "long_description": "Transform your living room into an interactive basketball court with Mixed Reality mode. You can use your hand to grab the ball and throw it, or you can use controller for more precise movement.\n\nArcade Mode: Rack up points and break your own high scores.\n\nChallenge Mode: Push your limits with a moving basket and unpredictable shot angles.\n\nPractice Mode: Fine tune your technique by adjusting the hoop\u2019s height and position to your liking.\n\nStep in, take the shot, and let the game come to life around you.", "short_description": "Play Basketball with Hand Tracking in Mixed Reality mode. Play anywhere with just your hand. Beat your high score in Arcade mode, challenge yourself with a moving basket, or adjust the hoop\u2019s position for focused practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foristudio.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Fori Studio", "support_website_url": null, "website_url": "https://foristudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25111594788469966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619836_1126872892749374_3771335018134577427_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSJwuRCRxTgQ7kNvwEE0m1V&_nc_oc=AdmfiBW8eRBP-S1Rg7WA_pM3dbdLRG1dyFI3VdBHzDwJSjx8F8I8bp4HjFnpjYWy0mM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQ0r6Ichuntf27E1ey7NlfffCW9iubbKJuoUQki6FrnA&oe=69B5702B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Basketball", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
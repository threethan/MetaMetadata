XGhhJ3MQVe4FAVv8Oq8P7RoEu1AqIWXmq8_o6PA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNrB05ojBxVhuwleReGV2yj3bgsrvbG5KI8WT1cFGpSg&oe=69BEA393"}, {"file_name": "Screen 04.png", "id": "25520275274222489", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_25520275287555821_2012326797416104286_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xBEDZxAHF8Q7kNvwGyCvBX&_nc_oc=Adl6rHZm8y0yTMfjBh6JWegA_PkqQqkNWD62vppXPRRU84eu0CinKMXxq-zyZt3P00o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysjgrXN08-KL907x2c7r6vgwbU8PQ6NcFlz1yR6UIGlQ&oe=69BEA41D"}, {"file_name": "Screen 05.png", "id": "1440068893750998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1440068897084331_2820687224807063652_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xHoBEJA_bIQ7kNvwEqQVqI&_nc_oc=Adk67K2m5sA30cN-Sgxvs5ZVbVjbY67c5s3zHYbXCV3wXK4URofOEfLsMyGLTMlOzCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNf1Zfz61LQmxSVlU6vh4qXvKvqrYJSPCA7EAO94iIMw&oe=69BE9A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "preview.png", "id": "1442603080310301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_1442603083643634_4379852038314531918_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8rewIoebDAQ7kNvwEvyXmj&_nc_oc=AdnPyBSLYxBapF9J_Uhtq2yUpQ0zqxohUDaU4iXrNXizZCT2Xero25zq1xICxaM6ugw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1arvMUDKzUCDJKEm1QU8yx6JjatCurXC5h2xj0gcNUg&oe=69BEA63E"}, "display_name": "Basketball", "keywords": [], "long_description": "Transform your living room into an interactive basketball court with Mixed Reality mode. You can use your hand to grab the ball and throw it, or you can use controller for more precise movement.\n\nArcade Mode: Rack up points and break your own high scores.\n\nChallenge Mode: Push your limits with a moving basket and unpredictable shot angles.\n\nPractice Mode: Fine tune your technique by adjusting the hoop\u2019s height and position to your liking.\n\nStep in, take the shot, and let the game come to life around you.", "short_description": "Play Basketball with Hand Tracking in Mixed Reality mode. Play anywhere with just your hand. Beat your high score in Arcade mode, challenge yourself with a moving basket, or adjust the hoop\u2019s position for focused practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://foristudio.com/policy", "developer_terms_of_service_url": null, "publisher_name": "Fori Studio", "support_website_url": null, "website_url": "https://foristudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25111594788469966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619836_1126872892749374_3771335018134577427_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daE2YL1Ei5cQ7kNvwEk-G-R&_nc_oc=AdnHHtDXAa2lPyqKwU8o8buwLU-HUtknbUUb0_wWIJHXJel0Egd5_WB8v-HzPThWKFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbSf7ht6vh3mClWE3KFZGAZcWTZRljVz11gCitpymXag&oe=69BEAAAB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Basketball", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
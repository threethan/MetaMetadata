7369"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Thief : Crime Simulator VR", "keywords": ["Stealth", "Simulator", "VR", "Heist", "Sandbox"], "long_description": "Step into I Am Thief: Crime Simulator VR, an immersive VR stealth game and VR simulator for Meta Quest where you sneak, steal, and escape across detailed virtual reality environments. Experience heist-style missions, interactive houses, and sandbox gameplay designed for smooth, action-packed VR simulation.\n\nCore Gameplay\n\nMaster stealth mechanics by avoiding guards, cameras, and alarms while planning clean escapes. Use non-lethal tools and gadgets to distract AI, create openings, and complete objectives with precision in this engaging stealth simulator.\n\nFeatures of I Am Thief:\n\n\u2022 Heist Missions & Objectives \u2013 explore, collect valuables, and escape undetected\n\u2022 Interactive Environments \u2013 open doors, search rooms, discover hidden routes\n\u2022 Gadgets & Tools \u2013 smoke bombs, sound distractions, freeze-style tools (non-lethal)\n\u2022 Police Chase Gameplay \u2013 evade pursuit and outsmart security systems\n\u2022 Movement Freedom \u2013 climb buildings, navigate rooftops, and move silently\n\u2022 Sandbox VR Experience \u2013 multiple approaches\n\nWhy Play\n\nDesigned for fans of VR games, stealth games, and simulator games, I Am Thief delivers immersive VR, realistic interactions, and engaging progression optimized for Meta Quest. Enjoy action VR gameplay, virtual reality adventure, and a stealth simulator that rewards strategy, timing, and exploration.\n\nEnter I Am Thief: Crime Simulator VR and master one of the most engaging VR stealth simulator and VR adventure game experiences available.", "short_description": "Step into role of I Am Thief: Crime Simulator VR, an immersive VR stealth game where you sneak, steal, and escape in realistic virtual reality environments. Complete heist style missions, explore interactive houses, avoid security systems, and use tools strategically. Designed for Meta Quest, I Am Thief delivers action packed stealth gameplay, crime simulation, and engaging VR adventure for fans of VR games, simulator games, and stealth challenges."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26322979924050787"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1491898935801562"}]}, "baseline_offer": {"id": "1491898935801562"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778234340, "status": "PUBLISHED", "id": "1491898935801562"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26384614841220628", "version": "1.0"}, "id": "940919118850935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26322979910717455", "is_concept": false, "latest_released_binary": {"__typename": "And
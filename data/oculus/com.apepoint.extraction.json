t=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40rnxI4uAOCIVA3lOr1q15VGEIMrimLNCPEOI8edft_Q&oe=6A05DF97"}, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a hardcore VR extraction shooter built for players who thrive under pressure. Every raid drops you into a dangerous environment filled with valuable loot, hostile enemies, and other players fighting to escape.\n\nSearch abandoned locations, collect weapons and equipment, and survive unpredictable encounters. The objective is simple: get in, grab what you can, and make it out alive. If you fall in battle, everything you brought and everything you found is lost.\n\nPlan your loadout carefully, manage your resources, and learn the maps to increase your chances of survival. Every successful extraction strengthens your arsenal and prepares you for the next raid.\n\nApePoint Extraction delivers a tense VR experience where strategy, skill, and quick decision-making determine who survives.\n\nEnter the raid.\nSecure the loot.\nEscape before it\u2019s too late.", "short_description": "ApePoint Extraction is a fast-paced VR extraction shooter. Enter dangerous raids, search for valuable loot, and fight other players to survive. Escape before everything you found is lost forever. Secure your gear, upgrade your equipment, and prepare for the next raid.\n"}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_
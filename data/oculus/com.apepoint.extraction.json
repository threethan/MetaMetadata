439905047352_2523047794082008779_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfO1xOz8ulMQ7kNvwFrmw5y&_nc_oc=Adrv9Gbu3xEp-0IfaLC0n5V6--opYMYmhsHs0VGijYHfkncH07NDXK_b5xEoSrXRDZs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu3k3ChU50Imf659l0xukAqCNgC1Tz9JnASwty-ti3MQ&oe=6AF33A5E"}, {"file_name": "Screenshot 2026-02-21 180155 (1).png", "id": "1848692629337565", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_1848692632670898_515098417430980052_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psACvDJZLdsQ7kNvwHXDSuP&_nc_oc=AdqnnpeKZEv7wvq4hCapBHiorfbzVc9s7i7lm5PsddWlBdpT9j1en3DoUGO5ozjFAwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjBd2pmqV4D5OJPYPGGS28awMRhSf2GjJTjVHyLMSW9w&oe=6AF352FB"}, {"file_name": "Screenshot 2026-02-21 180220 (1).png", "id": "1983975995884371", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_1983975999217704_7500665761677953453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPsDj49cQngQ7kNvwEZrFYS&_nc_oc=AdoNQghpzrCRUaw62yPlT5OjD7-sKomNtfSLu0aTcbLOPIZbblUgIU8gTr0QvSb_rQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdjWO_eMNlK9ObJPOHNHd27ekSdV5YiMJL09p_fVxLTQ&oe=6AF33031"}, {"file_name": "Screenshot 2026-02-21 180416 (1).png", "id": "1580047669712421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_1580047673045754_7197421319484600003_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aJomn_DCv4Q7kNvwE5gix1&_nc_oc=AdogzcV4gHgkf3C6XT_u0rvFyJiyL30XVawxDFOU3BjK-iP2z8JIViGNucbFHfZeAMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlaCDbapOByoCwpibtMkWWmhwxpB3SHPcEg8W74ed_YQ&oe=6AF3480A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zuserunners Result (1).png", "id": "1097955252933414", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1097955256266747_7097360964437021635_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeRs367ir1wQ7kNvwH5Y9T8&_nc_oc=AdruPEg5g17OWlw61Rml-acA5YO179q7CvjvpPzTCgeyeiyhP6sOwldt30eh0OS-YRw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToKLXS3jSKtviAPCuOVleyZ-whdQy2hscjN3k4UMGQRg&oe=6AF3355A"}, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a hardcore VR extraction shooter built for players who thrive under pressure. Every raid drops you into a dangerous environment filled with valuable loot, hostile enemies, and other players fighting to escape.\n\nSearch abandoned locations, collect weapons and equipment, and survive unpredictable encounters. The objective is simple: get in, grab what you can, and make it out alive. If you fall in battle, everything you brought and everything you found is lost.\n\nPlan your loadout carefully, manage your resources, and learn the maps to increase your chances of survival. Every successful extraction strengthens your arsenal and prepares you for the next raid.\n\nApePoint Extraction delivers a tense VR experience where strategy, skill, and quick decision-making determine who survives.\n\nEnter the raid.\nSecure the loot.\nEscape before it\u2019s too late.", "short_description": "ApePoint Extraction is a fast-paced VR extraction shooter. Enter dangerous raids, search for valuable loot, and fight other players to survive. Escape before everything you found is lost forever. Secure your gear, upgrade your equipment, and prepare for the next raid.\n"}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758348
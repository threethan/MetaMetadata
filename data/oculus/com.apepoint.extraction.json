439905047352_2523047794082008779_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66WqCg9J0joQ7kNvwFPvPmY&_nc_oc=AdpRxMU8gRTlxw4vtrvlCL-h8-SAil1H6lQXqqlcBrc6sQwIQCdzioGFaIgHJJMo8Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGuEVxHH9cToQrWyNbsgGY8-2LX3tVqc9dAKv-XFMNnw&oe=6ADE225E"}, {"file_name": "Screenshot 2026-02-21 180155 (1).png", "id": "1848692629337565", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_1848692632670898_515098417430980052_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmzt5I8hs5EQ7kNvwF4sHua&_nc_oc=Adp1fq0xM5Uc1kcqVd4nEkA9sFkiUGTtHBI-oLrP2gjX1eeHLaLV4KSSH7GR7bArIog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN4hiWiJHzHP9xldo7MLAUaSapv1mes9TgX9RI7y5oXQ&oe=6ADE02BB"}, {"file_name": "Screenshot 2026-02-21 180220 (1).png", "id": "1983975995884371", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819859_1983975999217704_7500665761677953453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KApWDs5Apc8Q7kNvwEq03kC&_nc_oc=AdrkEuGLPh7ZrFGlHlSX3IRkNyY-HgRBjG6zpRsGN2luQew1lG2pOLqEE_1lQfIGtnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrCBRrsdx_JuW5rr2ZV0W_OYXVJn5hB3dpl-Z6y7JhDw&oe=6ADE1831"}, {"file_name": "Screenshot 2026-02-21 180416 (1).png", "id": "1580047669712421", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825305_1580047673045754_7197421319484600003_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgOWY_dEb54Q7kNvwH_rxHX&_nc_oc=AdqH887Di3AefU663WAAmmnVwdT5YvsTWlj8TmqCdhy62Hf6Pnzp_b_iJg8JwK7MRbY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPccTo6J2ATCXEkI3R-4_ec3CE6lJcuY2CB3rNK0BM-tQ&oe=6ADDF7CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zuserunners Result (1).png", "id": "1097955252933414", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604360590_1097955256266747_7097360964437021635_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUGSha7WHhQQ7kNvwF-Cedh&_nc_oc=AdqUW72tgmrhHkfpvGNLnwVPwUmwCDsLDziLOhcg086_81-IDSn2lM1pSxkdPc-Y4uA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK-RmGp2lu6j7tnuYlJd2RPTfqbqKyQT1sQTXn68k8wg&oe=6ADE1D5A"}, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a hardcore VR extraction shooter built for players who thrive under pressure. Every raid drops you into a dangerous environment filled with valuable loot, hostile enemies, and other players fighting to escape.\n\nSearch abandoned locations, collect weapons and equipment, and survive unpredictable encounters. The objective is simple: get in, grab what you can, and make it out alive. If you fall in battle, everything you brought and everything you found is lost.\n\nPlan your loadout carefully, manage your resources, and learn the maps to increase your chances of survival. Every successful extraction strengthens your arsenal and prepares you for the next raid.\n\nApePoint Extraction delivers a tense VR experience where strategy, skill, and quick decision-making determine who survives.\n\nEnter the raid.\nSecure the loot.\nEscape before it\u2019s too late.", "short_description": "ApePoint Extraction is a fast-paced VR extraction shooter. Enter dangerous raids, search for valuable loot, and fight other players to survive. Escape before everything you found is lost forever. Secure your gear, upgrade your equipment, and prepare for the next raid.\n"}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758348
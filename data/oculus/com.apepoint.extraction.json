439905047352_2523047794082008779_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p56PPuWGoIwQ7kNvwGg6iIR&_nc_oc=AdqVBrsCcaNcy23GeCZsu2qArlCpg_3il9omTYodpTEMJbz3CNkFdfU2ZeahDSiWgJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPeyRRwe-o1oaJJhEY-hkvWyv5tdMQAvDq0YZEGvmAvw&oe=6AEB515E"}, {"file_name": "Screenshot 2026-02-21 180155 (1).png", "id": "1848692629337565", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_1848692632670898_515098417430980052_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Arq6CvgOeI8Q7kNvwEU7P3p&_nc_oc=AdpwFnPbhOwQN2Nw1EzVBfw2MGCzj1PHA_YxOtqPne0E9AlwBbfbJUkBq73vC4eYT9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1eqPV_E8KK4sYfzvKOA7wNAnjebPBIbpBVNxtytWabA&oe=6AEB31BB"}, {"file_name": "Screenshot 2026-02-21 180220 (1).png", "id": "1983975995884371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819859_1983975999217704_7500665761677953453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_Dy1nojy6YQ7kNvwE1-i_o&_nc_oc=AdoFCeSJKAyuward40dCb9QEhlno7V1b0ABlwT0gTWucv8_770adlFyi9I_EZ8YiByY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwHcHGguoFujQ6TNhoQmIm3GBciMzyvEDCRxjMcTKJoQ&oe=6AEB4731"}, {"file_name": "Screenshot 2026-02-21 180416 (1).png", "id": "1580047669712421", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1580047673045754_7197421319484600003_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTc05oa6ZVIQ7kNvwG_2gvk&_nc_oc=Adp3414LghA2iJnbpc4CsmD2nJPQPGdQOg4RJPWsctyidjEUYQAFpiIr1TmMdjmXkgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8RPVIKDoZd5UM16Q2SS2h5wqZZ3UgUU7U-KRjf_CjXA&oe=6AEB5F0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zuserunners Result (1).png", "id": "1097955252933414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1097955256266747_7097360964437021635_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZYDDDF1DRwQ7kNvwHmwuMJ&_nc_oc=AdpzpNdkIDvPOVnXrZRH-SPHmKfj6Y0Uo1-xFLouTIw4TyzUuF5fuYbR2W2EU128BWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH6puDY6DgX-xd4fZPuDfYS_Dk7Ul9wAQAxgwEafHfLg&oe=6AEB4C5A"}, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a hardcore VR extraction shooter built for players who thrive under pressure. Every raid drops you into a dangerous environment filled with valuable loot, hostile enemies, and other players fighting to escape.\n\nSearch abandoned locations, collect weapons and equipment, and survive unpredictable encounters. The objective is simple: get in, grab what you can, and make it out alive. If you fall in battle, everything you brought and everything you found is lost.\n\nPlan your loadout carefully, manage your resources, and learn the maps to increase your chances of survival. Every successful extraction strengthens your arsenal and prepares you for the next raid.\n\nApePoint Extraction delivers a tense VR experience where strategy, skill, and quick decision-making determine who survives.\n\nEnter the raid.\nSecure the loot.\nEscape before it\u2019s too late.", "short_description": "ApePoint Extraction is a fast-paced VR extraction shooter. Enter dangerous raids, search for valuable loot, and fight other players to survive. Escape before everything you found is lost forever. Secure your gear, upgrade your equipment, and prepare for the next raid.\n"}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758348
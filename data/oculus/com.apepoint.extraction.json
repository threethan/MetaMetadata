.oculuscdn.com/v/t64.5771-25/491827611_1464439905047352_2523047794082008779_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vxl-zA0jhicQ7kNvwFFeek5&_nc_oc=AdoULdIpCMRJlgGHFE3IC3aAYX4r28dYBtwWfQSCec1UY6mUlP8vkzVayYsxacqtHbo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERob_Ui_fLmDwkB3xtl9BDiqBqwoZvS6nmJDGoWOxAow&oe=6A91731E"}, {"file_name": "Screenshot 2026-02-21 180155 (1).png", "id": "1848692629337565", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491822307_1848692632670898_515098417430980052_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70oXPIwQurMQ7kNvwGsjlY7&_nc_oc=Adpf-DVG88UWDwFPBkqj5fiGuZBm-P7UwP6beW2eEYoCI-6OIw2LBJZHphNzbqSrjOw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFVxjosSkNoyvuM0HxSPWliGkZ1cv7SeEy7GU8nTYBqQ&oe=6A918BBB"}, {"file_name": "Screenshot 2026-02-21 180220 (1).png", "id": "1983975995884371", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819859_1983975999217704_7500665761677953453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkNyRpzUkr8Q7kNvwGTnNjw&_nc_oc=AdoThIW_81Yiwd3bxX3G9lScBNpgs1k-yEBLrmCRYetEK_FMRpDFvvQA9pxMFPg-BVI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFycC9MFMlF1PZXjl1TZGQc5lP43Fr1L1o1yRQI82Lf7A&oe=6A9168F1"}, {"file_name": "Screenshot 2026-02-21 180416 (1).png", "id": "1580047669712421", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491825305_1580047673045754_7197421319484600003_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPlm31kziNkQ7kNvwE7dDoC&_nc_oc=AdpQlVffKUDl3njKray9noNyiE3N6HM0wEzqfQeHA95W5IJy5eqE2OJd8eES21lIEf0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3Bxqa-QMndoAYBtVXaGP87-gggSvnE2yZbJBVKIRYAw&oe=6A9180CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a hardcore VR extraction shooter built for players who thrive under pressure. Every raid drops you into a dangerous environment filled with valuable loot, hostile enemies, and other players fighting to escape.\n\nSearch abandoned locations, collect weapons and equipment, and survive unpredictable encounters. The objective is simple: get in, grab what you can, and make it out alive. If you fall in battle, everything you brought and everything you found is lost.\n\nPlan your loadout carefully, manage your resources, and learn the maps to increase your chances of survival. Every successful extraction strengthens your arsenal and prepares you for the next raid.\n\nApePoint Extraction delivers a tense VR experience where strategy, skill, and quick decision-making determine who survives.\n\nEnter the raid.\nSecure the loot.\nEscape before it\u2019s too late.", "short_description": "ApePoint Extraction is a fast-paced VR extraction shooter. Enter dangerous raids, search for valuable loot, and fight other players to survive. Escape before everything you found is lost forever. Secure your gear, upgrade your equipment, and prepare for the next raid.\n"}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_
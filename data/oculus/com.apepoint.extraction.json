NP6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-HTK_HagwmgLL-2M_AjOudO9TFnyB1jhaiRyrU7An0g&oe=6AB918BB"}, {"file_name": "Screenshot 2026-02-21 180220 (1).png", "id": "1983975995884371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_1983975999217704_7500665761677953453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oYMYC5qKeYQ7kNvwFbVUOG&_nc_oc=AdrrK843C1g3o8Irv4d2EmVvNwoxgeeguWsJvyph6acO6KuOjwWdmSK-G59QDUjMduU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj7DE4J0cBh4Tvb5yVQbCu3MQQmEu5A7OFbo30ePt9BA&oe=6AB92E31"}, {"file_name": "Screenshot 2026-02-21 180416 (1).png", "id": "1580047669712421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1580047673045754_7197421319484600003_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_XWONAMXRcQ7kNvwGTOhhs&_nc_oc=AdruBtTXzCeS-BsJqPk1ia7U7_Lga_SrVrn9WQx1-7nH85ln_uM04rHES8d5jVInXxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfZrrvV0ywA_7K2G1C1oD2kL8X1pseT-u59fnRRAD0XQ&oe=6AB90DCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a high-stakes VR raid mode where every run actually matters. You drop into a hostile zone packed with enemies and hidden ApePoint caches scattered around the map. Grab what you can, stay alive, and make it to extraction before the timer runs out.\n\nNo two raids play the same. Loot moves. Patrols shift. Extraction points rotate. Sometimes you get lucky. Sometimes you don\u2019t.\n\nYou\u2019ll fight through AI, outplay other players, and decide how greedy you want to be. Push deeper for more ApePoints and better rewards\u2026 or cut your losses and get out while you still can.\n\nThe more you extract, the stronger your gear gets. Better weapons. Better upgrades. Bigger raids.\n\nIn ApePoint Extraction, it\u2019s simple:\nGo in. Take what you can", "short_description": "In ApePoint Extraction, there\u2019s no respawn safety net. You drop in, clear enemies, hunt down ApePoints, and extract before the timer runs dry. The longer you stay, the riskier it gets. Survive the chaos, secure your loot, and make it out alive."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25907286975587337"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25436209909392051"}]}, "baseline_offer": {"id": "25436209909392051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772835960, "status": "PUBLISHED", "id": "25436209909392051"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27966615912987756", "version": "2.58"}, "id": "946538341136730", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typenam
439905047352_2523047794082008779_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoeh73v29nUQ7kNvwFBhJkD&_nc_oc=Adq511m9AqU3CVcoXcgUGxSEoPzSOwuV406R4jTc5w-Ea_b4H8Ub-u-a4QCOHycGo7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORxEU98fSFktDyOud9kxfsjLkNI_bxOkwDBluobpwGYA&oe=6ACBAD5E"}, {"file_name": "Screenshot 2026-02-21 180155 (1).png", "id": "1848692629337565", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_1848692632670898_515098417430980052_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bmt3S3_vPsMQ7kNvwGe_QnJ&_nc_oc=AdobOtD_GebH-Q1ZC8uc0mduN6RLEyBJ9UCHd9XcUoXBFLA_F2l_PBZ8Wfytu9d_gXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbRxWOQcpfOUWeEz_U5Roki3erTc082o0LNtlbkhhLbw&oe=6ACB8DBB"}, {"file_name": "Screenshot 2026-02-21 180220 (1).png", "id": "1983975995884371", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_1983975999217704_7500665761677953453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Uhh1HFNN5gQ7kNvwE3cDlD&_nc_oc=Adq7qQCktd-phHNT9xEH0cnU9dtZ35EfDiZEqT8pfgNT1K4GcltCATg_JGRZ0nGfreU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxNbeyi4Gseh7yrW96j2QKkYmIuEb6tujOxKGxHsOR_w&oe=6ACBA331"}, {"file_name": "Screenshot 2026-02-21 180416 (1).png", "id": "1580047669712421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1580047673045754_7197421319484600003_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12YOI1YEUEkQ7kNvwEULsPZ&_nc_oc=Adqa7iOLqo-9vsuTC9GuNyYwPbjB-Gnk5tJN4hknsy_hYzLodpUezfu9BA91g_GQr_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeQZN5QkWUx76suohbsnhz0NzMP2OAhsjHPlkIHih6YQ&oe=6ACBBB0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zuserunners Result (1).png", "id": "1097955252933414", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1097955256266747_7097360964437021635_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM_iZecvmBQQ7kNvwEdulEZ&_nc_oc=AdoXggU9dffYrF8aMnB4jZEtz6RCLDaxMBqBCXcMugWDKwkRwgz3C5UOGiwuXucGXoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQbMTa5sATlHQmB1PVXEy95KzaOQWZg6AYnOuMMq475Q&oe=6ACBA85A"}, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a hardcore VR extraction shooter built for players who thrive under pressure. Every raid drops you into a dangerous environment filled with valuable loot, hostile enemies, and other players fighting to escape.\n\nSearch abandoned locations, collect weapons and equipment, and survive unpredictable encounters. The objective is simple: get in, grab what you can, and make it out alive. If you fall in battle, everything you brought and everything you found is lost.\n\nPlan your loadout carefully, manage your resources, and learn the maps to increase your chances of survival. Every successful extraction strengthens your arsenal and prepares you for the next raid.\n\nApePoint Extraction delivers a tense VR experience where strategy, skill, and quick decision-making determine who survives.\n\nEnter the raid.\nSecure the loot.\nEscape before it\u2019s too late.", "short_description": "ApePoint Extraction is a fast-paced VR extraction shooter. Enter dangerous raids, search for valuable loot, and fight other players to survive. Escape before everything you found is lost forever. Secure your gear, upgrade your equipment, and prepare for the next raid.\n"}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://apepointextraction.com/privacy", "developer_terms_of_service_url": "https://apepointextraction.com/terms", "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://apepointextraction.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758348
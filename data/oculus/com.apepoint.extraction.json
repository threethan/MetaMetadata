JFWFKNgXA&oe=6A37E5BB"}, {"file_name": "Screenshot 2026-02-21 180220 (1).png", "id": "1983975995884371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819859_1983975999217704_7500665761677953453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCTa5JxDUowQ7kNvwEp183R&_nc_oc=Adqe5EH-5w6555acmqFEQlm1I6aMqD4IJ007lIJPJsibOTG6zPCdYRgg4dHYF1n_2jE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wz9eBbtW7QMHqrpLCr6SjOl2ydlkrDAxm3EEDW7H37A&oe=6A37FB31"}, {"file_name": "Screenshot 2026-02-21 180416 (1).png", "id": "1580047669712421", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1580047673045754_7197421319484600003_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeO7m24EqOYQ7kNvwF4KpCd&_nc_oc=Adqaq4ZHMNDm9Wll8zLMtNkoL6UgHvETqVlBOP3dJW7evyIsXjpcsJg_2M290PS6Kds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c0wQapfMWnP3GxwZV4_kt4aD_eyTTLnI767Z9mbCvfg&oe=6A38130A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApePoint Extraction", "keywords": ["Ape", "Monkey", "Extraction", "Gorilla", "Shooter"], "long_description": "ApePoint Extraction is a high-stakes VR raid mode where every run actually matters. You drop into a hostile zone packed with enemies and hidden ApePoint caches scattered around the map. Grab what you can, stay alive, and make it to extraction before the timer runs out.\n\nNo two raids play the same. Loot moves. Patrols shift. Extraction points rotate. Sometimes you get lucky. Sometimes you don\u2019t.\n\nYou\u2019ll fight through AI, outplay other players, and decide how greedy you want to be. Push deeper for more ApePoints and better rewards\u2026 or cut your losses and get out while you still can.\n\nThe more you extract, the stronger your gear gets. Better weapons. Better upgrades. Bigger raids.\n\nIn ApePoint Extraction, it\u2019s simple:\nGo in. Take what you can", "short_description": "In ApePoint Extraction, there\u2019s no respawn safety net. You 
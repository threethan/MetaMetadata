1D2C1"}, {"file_name": "03.png", "id": "648347279131085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003239_648347282464418_6019934143070228906_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTfhlFqTzaAQ7kNvwFggNkg&_nc_oc=Ado_pN3FzjKiBMaBufeKcbuTxNS5_bi8rkzfKHFKUun2v7IM0mAFlWwfEOLuPmk_XOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxQYEwTvVnqqwP7UuMIucLn2GZ_d9IXSpNIX0bU-Dx5g&oe=6B01C8CD"}, {"file_name": "migrated_image.png", "id": "562478181348661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974768_531596267417906_7951198729459990528_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCllw7pYwH8Q7kNvwEfpqcZ&_nc_oc=Adro8TC-CKNhsPXZe87wpah1AB3W8g2ej4_FQQBHuzWCOPI95GvVnMjGL-8T_WTUIQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe4fe1Bp88jvZSCRYmYhQlEGUz18BuSB7t0G649QmBAw&oe=6B01E3A9"}, {"file_name": "migrated_image.png", "id": "518304742435284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75568724_1014379238915726_8587157040944644096_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV34i_HOpEQQ7kNvwGlw7TK&_nc_oc=Adr-yRkH2CN7wt6sMHXefzZIZOHgkjIdmeoXRET3BcxUEEYlsrKaCJLbZSwTPNVsBuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThmYxcxLulxzDla5iLWxaUtzKBVCfFV5Rq6FDSSToLIg&oe=6B01E97D"}, {"file_name": "migrated_image.png", "id": "296674611302151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75322603_2142961146011624_5722942723900571648_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6qASTel7RkQ7kNvwFTQMcR&_nc_oc=Adq00S9vwUnVoLmKs8Qit8VtKi0imH5OkFriBvnPHQwJKP3ZYSafLJDsmuVqhcMk4qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKFfkzZV_kIvkSXGYanz6VVtHzRE7V977RohQeO8QmvQ&oe=6B01DA88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voixtek VR", "keywords": ["singing", "karaoke", "voice", "training", "melody"], "long_description": "We pride ourselves on training great singers and most important of all is that we train you for healthy singing. When you sing with passion and confidence you can make the world better \u201cThe singers approach when they want to become great artists is of extreme significance\u201d add to your talent Voixtek VR And help your body develop your singing in a way you never thought possible.\nIt\u2019s simple, efficient and the best part it\u2019s PROVEN. All top singers know how important it is to train and protect their voices. Without a constant and exclusive structured routine, any artist would sometimes struggle to complete a show. If you don\u2019t train you don\u2019t gain, it\u2019s a simple rule to any craft. If you want to sing to win you can start preparing your voice now.", "short_description": "Become the singing star you always wanted to be with Ron Anderson- Master Vocal Coach to the stars. He brings you his proven training method, in the first-ever VR  vocal training system!\nYou will enjoy a journey through a fun planetary experience, each exercise teaching and training your voice, body, and mind.  \nThe music industry's secrets all revealed.  You'll now learn how to sing like the stars with Ron, Voixgram, and Voixman guiding you. You will sing like never before!"}]}, "developer_name": "Voixtek", "developer_privacy_policy_url": "https://www.voixtek.com/legal/privacy", "developer_terms_of_service_url": "https://www.voixtek.com/legal/termsofuse", "publisher_name": "Voixtek", "support_website_url": "https://voixtek.com/support", "website_url": "https://voixtek.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MUSIC", "RELAXATION_MEDITATION", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null,
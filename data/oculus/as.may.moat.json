1807383283219430", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304162_1807383286552763_2823258421133628704_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN5WBdlRa28Q7kNvwEip2uW&_nc_oc=AdozaHKzkVNHMs9geWWSpd8ZGdVYxy39TKjfCf45PaiLuknwEbQNLe2-yJkZ6JuDMkc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReTjC3lLrNA9mkhCpNMuejouqWK8_N19-o5kowtSa2yg&oe=6B086E94"}, {"file_name": "screenshot2.png", "id": "1199165672097925", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300897_1199165675431258_4100392902861293752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7Wc1AJ-0dYQ7kNvwGJ7789&_nc_oc=AdpOzu8XARDW6RUNAomunGjugMTF4wOnS_avC9O5wI8fWSxYWXsu2JhY9uboo4eJ2Zo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWQe0Kk9N66QfHvttbmPQf85WpdXiraD0J7qS4_dE_zQ&oe=6B083F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Museum of All Things", "keywords": ["museum", "wikipedia", "moat"], "long_description": "A nearly-infinite virtual museum generated from the Wikipedia!\n\nEvery exhibit in the museum corresponds to a Wikipedia article. The walls of the exhibit are covered in images and text from the article, and hallways lead out to other exhibits based on the article's links.\n\nYou can find exhibits on millions of topics, from the Architecture of Liverpool to Zoroastrianism.\n\nSearch for the topic you want to learn about, or just wander from topic to topic as your curiosity dictates!\n\nYou can now visit the Museum of All Things in English, French, German, Spanish, Japanese, Portuguese, and Bengali! Just select your language in the settings menu!", "short_description": "A nearly-infinite virtual museum generated from the Wikipedia!\n\nEvery exhibit in the museum corresponds to a Wikipedia article. The walls of the exhibit are covered in images and text from the article, and hallways lead out to other exhibits based on the article's links.\n\nYou can find exhibits on millions of topics, from the Architecture of Liverpool to Zoroastrianism.\n\nSearch for the topic you want to learn about, or just wander from topic to topic as your curiosity dictates!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://may.as/moat/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Bread Cat Games", "support_website_url": null, "website_url": "https://may.as/moat/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt", "fr", "es", "ja", "de", "bn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25148973171401465"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820208_2032136584242283_3790269419665545651_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtxvPEFWo0QQ7kNvwF4W-PG&_nc_oc=AdrN3ooRWb_CBTLv9x6FdxTNUhvYj7Eelm0CTIwK4Fb8ioM-48y8CgKSIJwPsvudwqs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdfq9a3sA3iaVWep9A0BwpZanrrfvNeR72aG9Iuo90Yg&oe=6B086195"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Museum of All Things", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"to
ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olvs2LzGYt4Q7kNvwGLaIEQ&_nc_oc=Adq2jc0w1rjKrPKzT4x1e7lBrvCrs35TDWh6vvWcem3IGHbgAKGy1jm8LbuIJjDqPss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF1a8A2VVhJ7V7_mcfjbD3tfoedUO4m9Qfb-PpAud34w&oe=6A621B45"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRUOyhSyU3oQ7kNvwE-BX_y&_nc_oc=AdqWknrucJ9Ex8vJzQjgy_u2jlMAIW9Z2tz9_9q2rsSWXN79RLGBsewvCcsg0aCbTWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnNuqrVaYpUVD9pWoKTkdkiYDIiEFf7faUU1jGGiyhyg&oe=6A621FC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK4DrrHKiR4Q7kNvwHg6jHA&_nc_oc=AdpR-1qTphyAqYu6cpQOE-oMkZy8E7qDBfj5VCKrhcC7Y7sQkPJejNnY2ww2bY6HfUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADRouZhYlVNwfgDauQdbLrogQT3M71MJpHmeNU5LUbSQ&oe=6A620CDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
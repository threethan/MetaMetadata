ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTGtYjrG9K8Q7kNvwGq7-04&_nc_oc=AdqCvLdP_zTmcPTlPWw0to34IHZ6wE24diEAMipX7HcjYfWjbJrJiSQtn36VC08LWuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUxkru54VsHRPMTnqQ3s8lHJl9Ti9fnDorPHnevY3V0A&oe=69CA7EC5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z1f66NEGlAQ7kNvwFD6-Aw&_nc_oc=AdpzLHa4O15iIuTDazxOblkedTGiuqN2d3nWqL2l2T6z_-W4IlTNFt-amiKmu46gSf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzX_HfIVJDGMAOVdDWQ29_qjxyyOWLO_XRc5r1wX259Dg&oe=69CA8342"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd3iV_LaN9QQ7kNvwERfzSH&_nc_oc=AdrdVUWdtg18sW_ArGcR2WHzg_cWupOWz-vsHgCSeVUyKw0MCLia4W62id18BzXtTDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0u7f-G0i1oHVZ9pK0xWWhYdz8jw84rtONapkg7rVHqA&oe=69CA705C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
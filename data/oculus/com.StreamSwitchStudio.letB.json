4643584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6_2P55WaIgQ7kNvwHFZk4o&_nc_oc=AdpxUrA0evuHpuxmb23NAatYl5eaHBMjgjZ3VvGx7wOyAqyLdyDyFWNG-GO4c5rhLMg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3xmy56ZzdLA5kVI7W3JXeFDYtsT3s4WGgLlTa_oGdTg&oe=6A8D9CC5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7duSulj_qeEQ7kNvwEdtmKS&_nc_oc=AdqlYtlfRiamF8fiSLHfdjhuGPhCsp0mOImjAg-h6KVVDib8eudVJqVWedVphDJB2I8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeGMZcT-FBYkM3eOlCi61gF58G_t4wOsQzTr5dQC4sHg&oe=6A8D6902"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndH7b3mkGcEQ7kNvwEHWAlC&_nc_oc=AdqUXzV_mpFCPamQKiNkDPlnrhg6ZF4unK0xXC5XAvVI3Jsxd0RGm3FD52UXdBFuFI8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExkxz-4tOwdH_Jvm38ls-rEpOhpFgosyeRfffEJbGcoA&oe=6A8D8E5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]},
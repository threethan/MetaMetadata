ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwHnZEyGsFUQ7kNvwHzqoj5&_nc_oc=AdrQoE0g_cKWmp8lhP1wgBG-OGM4CPSzJCntTBqzbq8MewEsysWYYIIL5rOKD80E54k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrqmPF-V84ZeCe55vWL2hdNgHcZYjovJDIYLChHqU2rg&oe=6AAFE3C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsf3soEX2dEQ7kNvwFO1Dj-&_nc_oc=AdrflZmqMlnCXOZHmWyUHE7s8qdaT3WkaCIebgD2Wvjz46ia3GP9VjNSlicjG8LO1QU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICDElZ6kJJhV3MYW9DliH-Rr8Uv8pxrxUIAeoVMi4TQw&oe=6AAFE842"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REDWlTs1_TwQ7kNvwHcRLYl&_nc_oc=AdoIba0qgc9-cT3soanI_OkSQ7bukn9lSyqIxudJbS0uq2CBCcIIpz1_RHDNoVT4x8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuuj86xMwSy8mrpu7ZnO8_BgNwDnbQ21N-EJ2aXFdKaw&oe=6AAFD55C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
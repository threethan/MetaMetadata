ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNgRLOQlZuoQ7kNvwFW5QQ3&_nc_oc=AdoQU2Qjj3ZNtT5zvp-dHudpnPizFX-0NlbF23YH2hpJymIbBzZoMO6gY2wvO9GstXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p4inixXNmhmEoMlbGOqaSkFAHQ7Qf11bYtWQcDh9wJA&oe=6A2D5F45"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVGsRB0yYjgQ7kNvwHwLdZE&_nc_oc=AdpLmXBrdcedor3NIm0eL9kgB8SVNubFyn2sFCwSY96w_sF4Ld0NEstLADnOWnMWpgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BSt2yDfbzHxPGCwO3-ik2sWrLXqjvhXjp84rI37rbxw&oe=6A2D63C2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sRxj7Sion0Q7kNvwEHrbuy&_nc_oc=Adpte-AtzZgTXR0UdsBv8oucww04MhqKCqkRbESbejTHHdXRA9fYv4u-9yyy20vjoPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P-Pu-MK2Y58qMlzMMrCN8eHPGxLrtKbdzmMpeHDslKQ&oe=6A2D50DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
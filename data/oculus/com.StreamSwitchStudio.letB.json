ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkVU6zZf7roQ7kNvwEFgICq&_nc_oc=AdrAAQIUGpp4GBLexeYzjdOOtFaGLAhW9cRIffZqdvQVlS3HqpFFsR4vD0qDsTCn0qQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kQYIVynEqPTnatLa1eWZ8gmhzo3hvtVL8H_Vc5af_mA&oe=69EF68C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9oxtQMuB9EQ7kNvwHhudMG&_nc_oc=AdoMNti0SlpsI3BXGhfFLW6jT9QftG_NXg0CHfJhd2lIqHSTo-lISIgnrL5yoBeGylM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CEwsZUqXBr4u8n_kbALrDN1C50hldvlwYP9K_yFeBBw&oe=69EF6D42"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KakydXXyvpcQ7kNvwGFxhLi&_nc_oc=AdoLbgimH4A_BxIYnC-23tYe4g5OPVhPe699O8FBF8kRLGCQVabulZTl2ruhSsMYdmw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FYFp7bqz89SvZ8PcVU9-gJS3TxUheFazz8jVUcwOsNA&oe=69EF5A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlTLxyKKbIEQ7kNvwGHcpvM&_nc_oc=AdpeDFxjkqGJd-RpdZA6RVEeccIjKgmLGKvP9MtFh2X0lVObdzUX6y7tX4YmhLLdmKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAa6sOBGlFss-1p48hHCQ0y_p30ZRaX1V9v3MXzaqhkw&oe=6A749045"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YVtFlxVKXYQ7kNvwGjbcQ1&_nc_oc=AdqW5clGTrUTvsu_v5yqVpzzbrebsRUwLSy-k5u4Q9i9wlV81doSXM6Vh3ZQPsFp5FY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuH5m4whF_adYOR7x1wFo2Vx2FCttOgwllNCZVYkduqA&oe=6A7494C2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCYwWiNAV4QQ7kNvwFkIMSe&_nc_oc=Adr3m24B-7WyQfNbmR4huJpZO94i2BJZQqNq24dmmei3U4ajtR2WLnwCyNBh7L951M4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEok01jGhYmlPZ0RBSf8hcICBc3arIVn7XYeFFg5eXxZg&oe=6A7481DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
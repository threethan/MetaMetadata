ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oXVvgQeNJsQ7kNvwFBpufL&_nc_oc=Adqh8eEKkm-paSuO238dlUjQS8T4JkbRLNGZ-CDOp_iXYEeyu1lBXnP53zuXXHrfqsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjcLUTg8BdWXj9R0gyPSTW6V9hjcCscYmpSzZ4BqL0-Q&oe=6A6DF8C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYHms_GSh2UQ7kNvwFkg0SJ&_nc_oc=AdoGDkS3GL873BLtRIBEqACvExV1I-zqY-f33fRI2plxUzihQyplw30H8oyV-Kb27Ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMz7vHZVzWuGAg4C6NWgeBBOPciAlzpO9GzjxiC3y9yQ&oe=6A6DFD42"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjuNdd2tt88Q7kNvwGLjnkg&_nc_oc=Adplc2EtueJCgqssSbokxKdOQvbE5klbxnV_yfd8URk5m_G-Pz0TM1jmE32xR9lm8PM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZstsqSBwOFVqc8OMVOhF4idzLkgXNb02UwP1XYHSHOQ&oe=6A6DEA5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
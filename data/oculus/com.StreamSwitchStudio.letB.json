ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Mfmbkq09MQ7kNvwH6ugZh&_nc_oc=Adpb-nxHUGiurm-VPJ1VECkoDobjhxYoW8pGXYgEdxx6o14i8Uc07BHZ3foqC8WAv8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQBjQG6spPghIIHDL01SSFYfQsvQ3H0GA8h2Un8HkCvw&oe=6AB286C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsf3soEX2dEQ7kNvwHSV1MI&_nc_oc=AdquCczW5QnzbqSBcCsdR-cf1wtfMGr8rCLA4W7j7aqf_asiy2_PiXTchtIhXpO05hE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfv6tcfk4c99Z_CkT3l6x1hMrO4wpMXqyZhpL9r136Yw&oe=6AB28B42"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REDWlTs1_TwQ7kNvwGnUa_5&_nc_oc=AdorhTG03LoX51po8XAH84jwEu4-DssM2whzo75iyqjtPyGiQUYQsjZrlXWRmLSBBfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZhZNvRLG788QQDx4snmiVcjtviOKhyGPw5D9G9AuKgA&oe=6AB2785C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
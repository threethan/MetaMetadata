ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_1_G4rbc3EQ7kNvwGmIe_r&_nc_oc=Adob1WS-l97iVAgqKmNG7V3agWLvUaWCDi_RiW_JXtBxIdzyrL_HKbbcuqzydX0iqI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bFWVMRGhFljiilLoz9TS40oO4FOzq4mWnXHC3VqqYtQ&oe=6A2EB0C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVGsRB0yYjgQ7kNvwHBrmOj&_nc_oc=Adrpw9KQr1Nk5wDC5x1oPQIry-97Z10T7_NXfdeaaEcq5FwMhaZmVRboWNw3S3HuPVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KfSLUMaDqNI-evJzyhoDmlEo3pc2_gjZ1dbgmRoC5Bg&oe=6A2EB542"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sRxj7Sion0Q7kNvwGyXmOr&_nc_oc=AdqXml_Y2SrcPApi0PanB4kFtJDOO0rLpGDbECl0lHJe5u3fFNJ1ELensZM2z2vmbVc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85X3dX4hfaDIfwnmU03W6CRXzGPSE0nvrM3p8dRjWefw&oe=6A2EA25C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
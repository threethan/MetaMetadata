ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzCA4LAosMMQ7kNvwGafn5i&_nc_oc=AdoYzy7Us4eechKOT0FpaXcAX5IPWTKhB5QF5tvcPy3iJ1vsC4UeapgSn-uEkbl9SQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ_LXrJHyxOSm9WF4_1M0tODby7eLqNuWX9Vyr5IFWiw&oe=6AE742C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13oh9e080u8Q7kNvwGpIe43&_nc_oc=AdodCVzSEYpkuMakSWSvoDSbjeiwo-Q8mDl1AyLy_zvng6gpTM58y9cGlrAu-JDNyy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP0m8_MeUj3LQKDJ_SHMjozx1HWBmqDDKDj2WGbl6ojQ&oe=6AE74742"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7heS0E1ri8Q7kNvwGJn-uY&_nc_oc=Ado4rSYzrX0SfbK3PoDxXcEQLI-8gS_eOeX0cedJQ_0KMB4OstS40qSD7bdSnP6l9yU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdBRf6bp4kUZMCo30JzR5lQojzElSK6hcVLq0SbjOzGQ&oe=6AE76C9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
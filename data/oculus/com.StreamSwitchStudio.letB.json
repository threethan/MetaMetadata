ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b391kLvPryoQ7kNvwGeAJFN&_nc_oc=Adr0vdxfsXUG3miy6BqgYBg5VR10t0FEleUHx0vn5Nq57vxFtTI_7rCG1ek1DRzgNmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmzHJAIi2d9rfXsbnTJc6SbGoxILjb6mAckbFQVO-7pQ&oe=6A5CD545"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0Gbskx17bgQ7kNvwG4YQid&_nc_oc=AdobiohKXwlHQYDD9fEhT4qq0OFZXmS4fbLdS1m7H6x17K4GkPH1szR88iTazLrcu5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaM61I7tf6IfmSM2OP9PU4yQcnkkaEM_TF9Ka8tsNHKw&oe=6A5CD9C2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_c0RzDc098Q7kNvwHL7vYC&_nc_oc=AdrLh_EMOyYsdj3QqVfIhMO8lSSR9zJRVhyx6ZG6qHTmIEsCCNHIhquHa9cxnzzuP5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATivhXrNsrLQkFGT16Pl4xUqy7tmNPwUwqwPrsM-_36Q&oe=6A5CC6DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
pp that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.letbvr.com/termsandconditions", "developer_terms_of_service_url": "http://www.letbvr.com/termsandconditions", "publisher_name": "Stream Switch Studio, INC.", "support_website_url": null, "website_url": "http://www.letbvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EXPLORATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "519649332722887"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162813_157209364805401_5818600939891720192_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC2a6cksdEQQ7kNvwHHwerS&_nc_oc=Adqs4P4BGBcRHfSvAQD9XqceZBJ_kJQ2pVm6QA894XhWSrd-KTUGs6gwjPSNpBXGOow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMV3vvGB4wQH1g1SHr1ZSs_sTfIg-l-f-D6zi_D733dQ&oe=6B0C6569"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "letB", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1499379311, "lastRevision": {"nodes": [{"id": "439803496367034", "release_typ
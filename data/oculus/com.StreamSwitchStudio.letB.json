ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdmW2ZYsc4IQ7kNvwGGIZet&_nc_oc=AdpjNP2RLavcLGPBQ2GL9Edqhf3Cl_f4n4cO5atlKV0EN0BHEtLWy1dYf2g5Hz0ycUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMnHxTtOXT365AcAyUIDriSZp7UAStpIctBSvT7fcE5g&oe=6ACB9345"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFU8JTwxdS8Q7kNvwE2epa_&_nc_oc=AdpjJa3z4t7WarwI7ZSq5pA4-VT5F3iiWjwXwEgpvgpkVCSACsJfglaOsMgLnpLqz0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1FFgApDa6ovSwcQYgknOQeRfCBZAogKYAQqjoYRnumA&oe=6ACB97C2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjzkIxRtq0oQ7kNvwFG39LQ&_nc_oc=AdphjFPXaMQwClqXTCXwNAX92IMHZgcViwnZwcZOyEdfzPfu5p6J7RNz-t9t0sC_x_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH9WQA3x2HS66ADhpIAWXC1OYjWlw4YlGY6QAeXUk1-A&oe=6ACBBD1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
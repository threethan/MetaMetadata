ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6SEuNJSF1IQ7kNvwHFCqfU&_nc_oc=AdplROS-vVnqJLzmxDZ6iS2Wv6y-thMvR34KfL9gUcbJEtkmJGYd5iMR0JKWEALyoy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR2Z6gBl4qjf_4n3ufIl7yz5hc--ytba-fmqsmKYLmUQ&oe=6AA557C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I1fpD-YgOMQ7kNvwG9ePZO&_nc_oc=AdpZASb-lW_7WCaF1Z46vHk4Rd_oEtyU6K71cbcPSXEkonwAOmYcylrbznijxAAtrI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-5hzG9UgMIFZ08EbWeBmb8NF_dttL3bu9err0roveCA&oe=6AA55C42"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T2ymz75PJkQ7kNvwEhn2Xf&_nc_oc=Ado0pA-ZnJ6iXiOvfrF0Oabk79q9p3I517tF-ZeGFnkIcnE3ZJh3YsdybFzM1Gw7Ews&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrnwU5PGyHutzY8LTNH24ssxmEG4-qu2TjGX1I4aH7bw&oe=6AA5495C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
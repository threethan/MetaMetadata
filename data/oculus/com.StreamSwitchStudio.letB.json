ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoDbbanbp1sQ7kNvwHlsmRh&_nc_oc=AdpR3TNMfnqsymRJyrNEnY_cMBkZ8FFSXJlPdbXKNbDIYLRMope4i2AAbEyDfRAmMUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A-jc_O9v4jk7Iv8pWGQkR2gtCFo7-rauplf2i2sI9cA&oe=69E38B45"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxriMlO5fskQ7kNvwF75SER&_nc_oc=AdqMo0vwRt8uK2edIkTySS-Z6XCS7IQ9F0YY4y5qNAQ7u3uzk2yalj8VAzt4uk4sL04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24tX_Ot9i6wsan0fZZfYYvRE1CEeaW9vDB6_jYtmzlgA&oe=69E38FC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G817l8sFAtYQ7kNvwE9fcKg&_nc_oc=AdoaZhzs2t2SzUdgR9NSXYw2NpjaMfdaBEuJrY38vJalg0aEJrVLdnwPPcwAyvQxukE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04Rjo0QeSsB87kmPY3mwjSo281BAhYGQ1NrxcwUzPgUw&oe=69E37CDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
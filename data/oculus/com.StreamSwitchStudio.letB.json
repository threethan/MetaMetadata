ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJXLxFaK2nwQ7kNvwFDNhyt&_nc_oc=AdpIL0YhQZVwI5AgqqlBhyOaX-dtL-juSjpMoiCHC52c-btPjQxn1b8sVSMGQWcHlaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wtn5bdDwRUTJVtqjmsmZDRAl6ADN4z1sBAPbUZexnLw&oe=6A05D245"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3Vhjkq2q8AQ7kNvwG-ygCT&_nc_oc=AdpKIk5RzDCljU4THzcXANy0jbHWlVKYT-zyQVW3afaTLE58iMeKmNjAq_tVAT7PVOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V88W36AYs9huaEFnlNK6tkC_kmF6sv4Y0A9wUD0oNcg&oe=6A05D6C2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOwQ3SBTN1UQ7kNvwEku2ko&_nc_oc=AdplwaIead-y8l2yw1i8dxXIRBELnlbnXtIwH5qfKYu0c7lMjp0-3ixmnZ7t3JZqHhY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xHIV8Vq9ZjSNW4WtU4XkCFicZvG3VZJ_QEXsPPk_6FQ&oe=6A05C3DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
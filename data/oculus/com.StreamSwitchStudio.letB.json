ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvgVjBO908wQ7kNvwHQz3GP&_nc_oc=Adq3SmDLIJQECfwCzLygdzvnXD5lSX6vRStDQKGD_Z8Meb1zkR_G4s9MNZqzHqPiAsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pnIxOdopD6yKwn09dPwzKxNEka40K67gYwJRFfAzm7w&oe=6A427745"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDa6z_svUDgQ7kNvwGNL8JL&_nc_oc=AdocPLRyNMRDHcuNru6y3IevBz4MnI6l8s3oLRh6g1raE-66TyOmLz-zu3Ey6ZImJHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aKOKNBTncfTgzVBWZ9xUzHNtbry2wHvocMOzMHkmdBQ&oe=6A427BC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZbQdySIUlIQ7kNvwFmdEP-&_nc_oc=AdoHDTTGTPntD1x5ArahK6Bz3WlzIx_GxGMCtt2G69kXuJYi5Q8FYICx20ovzFCcJSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j0WY2tvPCdV51w3dJ6DpXv_BFZefasnlv0_TtNkpj4g&oe=6A4268DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
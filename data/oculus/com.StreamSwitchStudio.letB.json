ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJEMhHP36HkQ7kNvwFel2AH&_nc_oc=Ado7LYLltIU5KV_kNl4nlzXsDvu52Jr2uv8MJ9sUxvy-9N7TcBQqYzPCMj6fnIkzTlo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNq-9518HfL59bTgAsU7lbG6TY7pIi1U3QUlDSCF0New&oe=6A8AC185"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXGNvSD_P-IQ7kNvwGFdKNK&_nc_oc=AdpDMW3YzcEVGRD7jXCEQbydcM6oPG_JPMW_zOgIQVNfwidTYvJn8hEN03xONaHqxkA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmqKmaMwDH54-MXXAEapptQzNNQr8Qo0i5rNxnt-qC6A&oe=6A8AC602"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Ej475brbUQ7kNvwHUUoDb&_nc_oc=AdqgJORJuUsUDWT1zUzK1Zi5z_LzfBwFXPs0y5WIbd8_LiKEvTRxmQkckoOBmD3CQK4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz8xPxg2K6LPpjrHURLFOeHVHcuBhqJqdDBqaW3ahohQ&oe=6A8AEB5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ5qLglMb0IQ7kNvwF3tgJe&_nc_oc=AdpTRPrYQc1UoP1OcLpIa8wpgkBRpRWTNTYtGGMs65EIwb_SU0LVEyd3U3nJ1-8AP5c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_CpJU4yCq3BBoZFQ_Lxcrw4Ski2KEpPmIklkfW0Nw7Q&oe=6AD0D945"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmjgkvnvniAQ7kNvwHY8e0U&_nc_oc=Adrj1Hzc7gBXLHjW11Xx9aZpGedqnRRsk8BqImSFincE4I2wwwN1DUcgZkK6aTYS0Kk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDbjdVKCTGEqMIu6ytj_stfttArnoDmez-RdTakVBO4w&oe=6AD0DDC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkbgAHtV--wQ7kNvwESGGLZ&_nc_oc=AdqKoQPRrxZUttk4aAIzoK5oR6j67j0DV3t8RntEHe60THmveh2d-flQMOgiFk12v-8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMYVHojCtkX-agwFID5RPDwTHJ94B-ZiEqxT-VO0d3XA&oe=6AD1031C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lRMICnM4YYQ7kNvwG4JX-c&_nc_oc=AdrUJ9FxTRjI95Ue7W0PogATCgW6Zt2o1eu9nFuRl2DWZv2MEC_PJhVSyotaE4b3ezw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Jx32-Me11Vbqtd4H-8D0ne1iiDYYGZ_VYcmSq6Lh6Q&oe=69FB4645"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IOSMtttyZAQ7kNvwFWj-Jg&_nc_oc=Adph5xVJT9z93kuORy4Mjci5VHr9vjmuDMvZT7fhX1y447edtPiJEQIBA0EsifU6_2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7efNnfW0rK8MOmeohiYODVGGhPROHXq_mywbIBaNZOjg&oe=69FB4AC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d40mWDdEEysQ7kNvwFq-Lth&_nc_oc=AdoOcmF8jUGmfEUPXpUaZJE4pn_Djs_u_r3yRAhx5UWaqoBviMHc36BAxAvtyE8j1EA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af534EzVCqvPN7tr06LSNA109ho6g7m6m07dumZ64brCng&oe=69FB37DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
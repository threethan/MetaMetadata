ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yebl3LiUscQ7kNvwEkraWJ&_nc_oc=AdrsDvXAy8qXv_EtH6inRZ9EAX6fpznOEvFeBN95tEXnfgGks7Jdnrwu5XwYvLMg7Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zBrbMalVKeX0U6zpqN0Lo4VrRPEX-qivt_BsY29xCxQ&oe=6A281945"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SqVZ4yrNMwQ7kNvwHrhjol&_nc_oc=Ado2f2YoOOJPmXbucr-1Jk-84f85NQMAiKCDMREqatB2LCX9NLBBlJeRzejGUEVyb5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c1s0DBOp6-6Ri5VVYXcetuIwAZqTHGlPfbPLObCS_YA&oe=6A281DC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVFCww3dgQUQ7kNvwESmQnU&_nc_oc=AdqNeBFYBgchNHdbKeqJpeLSShopbHERLkm70NMMP_YiLcr9OJtgcIi66w6bRuQK4ho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H32os1iZb3e0xDAWD60JdjOJibTGvfC7g8iAUm6T2vw&oe=6A280ADC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
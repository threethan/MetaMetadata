ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORrbRln1XYYQ7kNvwF88p2h&_nc_oc=Adomzxdbxso-VKk0MCB1HP5kJ_4Qr8x1gZPUAppVy2nHWAJKZd_ILqqFKif8xytPGJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rbKOE-s5ay5vctS6osUr-Kj79l9sdk-Npw0hVPnu_ww&oe=6A184745"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxOU7VEvhzoQ7kNvwF4X8Wl&_nc_oc=AdoGYi2BtN4uIk3EZoBh3_oltdxKa3IttLkDksCl4jvpK6r7Mj0N1vPU9oiFNkgIJ_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XCXGXEs__RrwC97o7j7HexHjyibYAfGfgViC_ery3uQ&oe=6A184BC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUHJ8Dg4SUEQ7kNvwF82uAc&_nc_oc=AdohUX9IiK3c_vLNO2QLF3t-HjAuiAuFDYGzZ7bdmuK2vqisWyVr3qmIKbetTvTpteM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54HUQ9NMpaszBU6sV_56aOgSw7wamURUuTGJiy8bwomw&oe=6A1838DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
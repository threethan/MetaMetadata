ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwOjFNh2EYsQ7kNvwFRle67&_nc_oc=Adozkj-X9cYCaL-dj9HMz-dLGTnw_sTiKZhUx0TWhR_zUiOzxFzYgP9NLMarumnS0X4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo3wpml0m7nIPCFsUwYJpVcY6421q1O4VxDYNO4PmFQg&oe=6A9D6EC5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ky2BuSZXFnAQ7kNvwG2RKR_&_nc_oc=Ado3-AXsSoppskFlp0_C52MbAREuGjhooATewyO8xD6BqLiWaqCafeRiO9L4RnQnW2Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEj5RfjI6F4Bp0YchIe9OZxAJSksN-XA19e5RNMwsHUw&oe=6A9D7342"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC8CZtPRckAQ7kNvwF2Remz&_nc_oc=AdrKQOwLlDYkSZvan4O2ZzN1oPnyZnPs9Pqs01hwFYo3IsuQlfEuwfkoIkPQB7xFxck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOQkjnrriF07XNZACx3Qyvcq1d0gR-NWcJzxax53hvgA&oe=6A9D605C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
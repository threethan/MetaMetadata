ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJXLxFaK2nwQ7kNvwHRWFTd&_nc_oc=AdqLCffwAYajHpC7LpvNCFYFhvIIqVACVXJpn2bfcZWaf_GH5XFV0_tL6FKfeaGaC7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K8vrqBr_c2GFRtIC3fsswaYwJaifNGXZa4OwpWwOr5g&oe=6A0480C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3B5sZxgL2UQ7kNvwG-B4YE&_nc_oc=AdpEPirh5JOD9wRbpQ2YPBtIuwYNnrWKeDCDNNkSgAlBgOTi2ae-U7qu35xQcS1cu7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af463hCR_j_0EwcTG-A8RTVUj_5GknQ7FYdMolkGHfZsDw&oe=6A048542"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGwP1Lv6_b8Q7kNvwEslCQb&_nc_oc=Adr3MPLTovp_I1zU8UFQiTzX-yanM07zp9P3EzKYJ5cOkc6ATDn6DrRH3UYvBDN7pnY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rNkOzAjd4KwtPRn4sMq1X-QB0kqoifE720a_w4jOtsg&oe=6A04725C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soj-ZABdx18Q7kNvwE_OQiw&_nc_oc=Adp4lNPwIk0Sa8v-EQ9nzFqqxOL20qZFbqWyQKHUgvFyw9PScJ4zx6EQkh_fToblqd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD35FDal8qo0E4NMxNxJJHPTWhObhmkpKh153TiRzMwYw&oe=6A676145"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iidrUoN7TU0Q7kNvwEBYbCX&_nc_oc=Adr9o6sJ-2-htrSQ9-RAQ1dNsBbq01NGpwE8cvfN6UHJi1z5k19w5Etp-zhrX7w_AlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyZ4hS8SIpEhq84I4jIHd1HspUXbWlVoVy7W6tP9-0bg&oe=6A6765C2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53RjyGNXamgQ7kNvwEw4A5M&_nc_oc=AdoDJcV43pcG02NmGzeu4XpOXuINWYlzwOovM7lyIlO10GYsThxiLR6K3OWSmRCVAdg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8TrpegsDsGRaoWlezkPfHZgf8IG9sQdmejvskxdy2Uw&oe=6A6752DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
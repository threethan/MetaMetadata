ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyS61R6eXY0Q7kNvwEkb7q0&_nc_oc=AdptoXvePnIINDhBRd6Tp0kuiNtPVUmsJhaUd2_SEmdgZfJxN4vQjxovv8dtrEpKSa0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0R9bsgz96CF16i8vTh2QQW-WQW84WWd8auAY7uXtTCA&oe=6A6A0445"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzkP3yeELA4Q7kNvwG1Gzww&_nc_oc=AdqhrfigXb7etI6Gl23a6Bsj8rgES5HdOchanLP924pR6Ryp2I4KcEQ3008PDrSQhkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjnQHz2ImZwkhWUlMTAjkkOWkK5wbmcrYG0o6zDSPI3Q&oe=6A6A08C2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmp3pzSD2XQQ7kNvwETu55c&_nc_oc=AdqMvXDhkCe4kGarOF5b0P_STOtQO_Nt6y9Vi2rhXKhiaP7y1fEcPyrVMou5i0uAxTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe5vTIMEEv2opYthHuuFiMiajGK8fzkj7sRQ1CBZ26sw&oe=6A69F5DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
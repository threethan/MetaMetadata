ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHLUotO2rlAQ7kNvwH7HKyL&_nc_oc=Adr0Za8nfCzh31gmsIF2Cn8bFNSvbzTwoqtrvzp7OMNPwgh6R8YQ2bopnNWOKXLX5_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9uN3Q-489cbGOCuKMv4srIY5qeHCt4WvQP9yqs2QVlw&oe=6A5E26C5"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0Gbskx17bgQ7kNvwHu7yNs&_nc_oc=AdpHEsvS-i1E-E-uerXqO_h4Nz-lYsnWHv1NolGGzla-NljbPM2BTfNuBl6rUbEA_Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABwnm43lvMOkz6YMOvSDcTMwGDwPmj3XFrIvqsp7Q-Xg&oe=6A5E2B42"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_c0RzDc098Q7kNvwGaexch&_nc_oc=AdrnJjWYiG4tDSxtEC9vkddzXVxGKa0O2JZ3MXuYSywkiOY4TvO0E8L1MpLNJDMx9uE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf6UUKslxOl9BX66xhQj4LyOg8qQNjkZW2UmvmSXnMBg&oe=6A5E185C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
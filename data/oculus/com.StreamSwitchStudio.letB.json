ng?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAKOloeJgTgQ7kNvwFS4SJr&_nc_oc=AdpflFUEF7oUGtOYbvWzQ7raP9VNkp2DYOedi-d5KuAWZdXa5l0_5T-2yZR_Xezxu0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rsIH9a4ztFYC6rrrAtQZ7-LMUIcjU7ruaODCygI1Kow&oe=6A0B1845"}, {"file_name": "migrated_image.png", "id": "498949650793261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162762_749959391837951_6903257581460914176_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cgWkrzemy0Q7kNvwFIuSF7&_nc_oc=AdpcNYoH83ZLw01LmMyeF8AZhX4UNqKQqPhBiezOfABiEmZ9CrBpNJg9FsNTABxmv5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H4TeXmdsee3BDkDqbokP42mCKTttG0OBXyqPsjpKrRQ&oe=6A0B1CC2"}, {"file_name": "migrated_image.png", "id": "169785313984085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162777_1685622531744666_5985401956246487040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpK6k43lTXMQ7kNvwH_V-AN&_nc_oc=AdqZn2vcDSFPqVtUF5GEtLkhZP6ch7ilNZ0id2n8dBH1YwLEpmnjbPBFJ5rmwWx59eg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Wz3h-tcb798DLndmgxayHvKOTqwoFOvrKuzURSJxdw&oe=6A0B09DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "letB", "keywords": ["relax", "nature", "explore", "vr", "free"], "long_description": "The letB app lets you enjoy amazing 360 video and sound of a diverse range of locations in North America. This hi-fidelity content can be streamed or downloaded at 4k resolution. By design, the app is simple and straightforward to encourage peace of mind and to focus on the subtleties of uninterrupted and untempered nature.", "short_description": "letB is a simple free app that take's you to amazing isolated places in the world. Explore, appreciate, relax, let be.\n\nOur current library offers a wide variety of 50 locations within North America. Our mission is to create the largest, high-fidelity Virtual Reality library of the natural world as it is today."}]}, "developer_name
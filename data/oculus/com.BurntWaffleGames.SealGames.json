D72C"}, {"file_name": "Untitled design (19).png", "id": "1970709483657256", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_1970709486990589_7915805254584159676_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXfuw6FHz7AQ7kNvwHUAv_u&_nc_oc=AdlmpLlI9z8F8oCFAvd16rFOKWvdhc7uni1qbaOQ0jRE_3E1-Cll2Uzj7XPm8wG7t6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0MYEFtIn051zt7LOSX2twRLDH4_insyynO5KYdf0yXg&oe=69BBD85B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Seal Game\u2019s.png", "id": "2040933626668961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307962_2040933630002294_7610412254699610100_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCzLN53okhgQ7kNvwE115lG&_nc_oc=AdkJnI6MD6loMYnoC1YbxsCUe-S2CD8_T9W6kRX7jd0wVXQg8LwwKmxCCL--7kHLFl8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCbA1oiQOCZ0qBLuihpA0ekd-UwATO3ZY9pvKdlpIkiA&oe=69BBF6B6"}, "display_name": "Seal Game's", "keywords": ["party", "seal", "PvP", "Parkour", "Horror"], "long_description": "Seal Game\u2019s is a fast-paced multiplayer VR party game where you and your friends play as energetic seals in a variety of chaotic and fun game modes. Built for social VR, Seal Game\u2019s is all about movement, laughs, and unforgettable moments with players around the world.\n\nJump between PvP battles, parkour challenges, and party-style modes that test your skill, speed, and teamwork. Feeling brave? Dive into our horror modes, where the mood shifts fast and survival depends on staying calm under pressure. Prefer something lighter? Relax and mess around in casual lobbies designed for pure fun.\n\nWith smooth VR locomotion, expressive seal movement, and constantly expanding content, Seal Game\u2019s is designed to grow over time. New game modes, maps, and surprises are always on the way, keeping every session fresh and exciting.\n\nWhether you\u2019re racing, escaping, battling, or just goofing around, Seal Game\u2019s is the ultimate VR party experience.", "short_description": "Seal Game\u2019s is a fast-paced multiplayer VR party game where you and your friends play as energetic seals in a variety of chaotic and fun game modes."}]}, "developer_name": "Burnt Waffle Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1A5n97UGIHP7NVGleSUUoLhVlQ-x3E7o5fIEN7c2xWDU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Rave03409", "support_website_url": null, "website_url": "https://sites.google.com/view/rave0349/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25338107152519983"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2055829648583048"}]}, "baseline_offer": {"id": "2055829648583048"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767125460, "status": "PUBLISHED", "id": "2055829648583048"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25929991713331521", "version": "123"}, "id": "1198769952221771", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "252075
20f&oh=00_AQPfNI7-1zrKrwWnXqFbGzIO58Pgiylrtn12vEzjul1Xkw&oe=6AE363D6"}, {"file_name": "ss3.png", "id": "1773221079916379", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982478_1773221083249712_6535527144578119243_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1jXwa6BgqwQ7kNvwENQAet&_nc_oc=AdptAhvJ8E94bBS6iZ71VUuiCuh-innT3Sm__62ZSDpiTivlt9pnulNN3iytxOyCPzk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONQhgA0Nw3pDV5DcAkMEMeNglvglibvZvTf3cjMmIizA&oe=6AE35E42"}, {"file_name": "ss4.png", "id": "433855069243351", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974685_433855072576684_2340185511442621748_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa3Z-PKgARcQ7kNvwHzMW4e&_nc_oc=AdpKRrHZJq9qGCA7E4shK0ahFxU2s66CnZ2zieAgiIjbRfbiSXeS9FCK7mZRTX-ANFk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd7fkgpZf3Fy0OIbA3YMUpDbInHVALH2DOj11CGOt1_w&oe=6AE36411"}, {"file_name": "ss5.png", "id": "461973340217178", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035327_461973343550511_6205070325425064320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHqybvRlv3wQ7kNvwFkYg34&_nc_oc=AdrJy-XWsouyO0gVG4XMMg-2q7t4npwRZ2XzriS2axF3nUt0JYntLD82N5GIDkdoMpU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJsv_63VXxdNtLcYU3ct76uKzVuJNS24I_IsWCujWpwg&oe=6AE34A99"}, {"file_name": "ss2.png", "id": "553127020624706", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035391_553127023958039_1128535947407948369_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvCbXLXk6v8Q7kNvwHhJUP1&_nc_oc=AdrugsUNAIgIchOtLPQjX88U7wTGtTyqfOS9wK17M7hcTP8aHisTm7rFh8a8mCTG_RQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBM3chqvOZ7PywGukJ9l_VPB1Y28zmpTWe9NTmdcPElg&oe=6AE35D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss2.png", "id": "1584779142249097", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982448_1584779145582430_8209235675842875346_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=351VI6Eec6sQ7kNvwEGgixN&_nc_oc=Adq4smH-uCQZ2ijqv3H43xfp8dm5pteHw4WC_9gwmilOqs8blvQ7JJULL7har_Avc0s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyEzD2BfDwqtKTyg8cV8rtM-9nVR-1D9UyGDXrB5D7uw&oe=6AE33816"}, "display_name": "Girl Fashion Runner", "keywords": ["runner", "hypercasual", "casual", "comfort", "girls"], "long_description": "Welcome to \"Girl Fashion Runner,\" an exhilarating virtual reality game that blends high fashion with high-speed adventure! Step into a world where your style choices propel you forward through dynamic 3D environments, from trendy urban streets to lush countryside settings. As you dash and dodge, you\u2019ll gather exclusive fashion items that not only score points but also unlock stylish outfits and accessories for your avatar.\n\nIn \"Girl Fashion Runner,\" every level is a runway, and each run is an opportunity to showcase your fashion sense. Customize your character with the latest trends as you challenge yourself with increasingly difficult obstacles. Master the art of swift navigation to avoid barriers and collect valuable fashion pieces that boost your score.\n\nThis game is designed for fashion enthusiasts and VR gamers alike, offering intuitive controls and engaging gameplay. Whether you\u2019re a seasoned runner or a style savant, you\u2019ll find joy in the unique combination of fashion and athleticism. Enjoy the rush of speeding through picturesque settings while dressing up in high-end fashion\u2014where your look is as important as your speed!\n\nWith vibrant graphics and a compelling progression system, \"Girl Fashion Runner\" offers endless hours of fun. Compete against friends, beat high scores, and climb the fashion leaderboards. Embrace the thrill of the chase and become a trendsetter in the virtual world!", "short_description": "Dive into the glamorous world of \"Girl Fashion Runner,\" a thrilling VR experience where style meets speed! Navigate through bustling cityscapes and stunning landscapes, collecting fashion items and avoiding obstacles. Customize your avatar with chic outfits and accessories to enhance your run. Perfect for fashionistas seeking adventure, this game combines immersive environments with heart-pounding action. Join the runway, where every race is a fashion statement!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/girl-fashion-runner", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7932273236876771"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1599300898279176"}, {"status": "PUBLISHED", "id": "2028463981128943"}, {"status": "PUBLISHED", "id": "863522083522148"}, {"status": "PUBLISHED", "id": "1731302167529548"}, {"status": "PUBLISHED", "id": "699564335998268"}, {"status": "PUBLISHED", "id": "10068639046514090"}, {"status": "PUBLISHED", "id": "3106998969459749"}, {"status": "PUBLISHED", "id": "8884330798302315"}, {"status": "PUBLISHED", "id": "1724293885078181"}, {"status": "PUBLISHED", "id": "1305057883795211"}]}, "baseline_offer": {"id": "310699896945974
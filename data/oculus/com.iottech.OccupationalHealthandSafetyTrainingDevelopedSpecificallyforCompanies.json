 cater to the unique requirements of workplaces. Our comprehensive content allows users to learn interactively and develop practical skills. Equipped with the latest VR technology, our training provides participants with an immersive experience. Designed to strengthen workplace safety culture and minimize accidents, this application is an ideal solution for meeting the training needs of personnel in various industries.", "short_description": "Tailored VR training for workplace health and safety. Experience interactive scenarios for effective learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/privacy-occupational_health_and_safety_training_developed_specifically_for_companies.html", "developer_terms_of_service_url": null, "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7260493890708725"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "740821764844887"}, {"status": "PUBLISHED", "id": "1339393023425534"}]}, "baseline_offer": {"id": "1339393023425534"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "740821764844887"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"
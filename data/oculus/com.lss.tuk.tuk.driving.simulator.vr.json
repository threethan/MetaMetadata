e7a0a&_nc_ohc=2YdLZWP0zh4Q7kNvwEPCo8p&_nc_oc=AdpZF8Btla_tFappee8fJOZl_uEa7Nrcd_r5-DxZanNRMrCA127usKO4Y7TSuqNi0kI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ7ije0OFq66N9dVQmaKXDM9jwq0REkpLMZQZKBG-Z4g&oe=6AF5D060"}, {"file_name": "tr7.png", "id": "1625449348932959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827611_1625449355599625_7902145085083300402_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFEs40pZFbsQ7kNvwEOkvqt&_nc_oc=Adq_zcwwrh9NsKpwvMhabkVWrlQ6o1RTwDaxB7NDSXSLAHu_9r0OjAjx4kJiud43lZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7mT1F1eBXZbXwio-yYvwo1J831VTGSMWCnU7Oxr-61Q&oe=6AF5E083"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tuk Tuk Auto  Driving Simulator VR", "keywords": ["TukTukAuto", "AutoDriving", "DrivingSimulato", "TukTukAutoDrivingVR", "SimulatorTukTuk"], "long_description": "Experience a simple and fun Tuk Tuk Auto driving adventure in virtual reality. Take control of your auto rickshaw and complete passenger pick-and-drop missions across three different levels.\n\nEnjoy realistic-style Tuk Tuk Driving Simulator gameplay as you drive through the environment, reach the passenger location, and pick up your passenger. Once the passenger is inside, follow the route and drive to the correct destination.\n\nThis Auto Drive Simulator gives you a simple objective in every level: pick up a passenger from one place and safely drop them at another location. Complete each mission carefully and move forward through all three levels.\n\nWith easy controls and straightforward missions, this Driving Simulator is suitable for players who enjoy simple VR driving experiences. Drive your Tuk Tuk Simulator vehicle, explore the environment, and complete each passenger transportation task.\n\nThe game focuses on Auto Rickshaw driving and passenger transportation. Pick up passengers, drive your Tuk Tuk Auto to the required location, and complete the drop-off objective.\n\nEach level provides a different pick-and-drop task, giving you a simple Tuk Tuk Driving experience in VR. Stay focused, control your vehicle, and make sure the passenger reaches the correct destination.\n\nEnjoy the complete Tuk Tuk Auto Driving Simulator VR experience with three levels, simple gameplay, and fun passenger transportation missions. ", "short_description": "Drive a Tuk Tuk Auto in an immersive VR driving experience. Complete 3 levels, pick up passengers from one location, and drop them safely at their destination. Enjoy simple Tuk Tuk Driving Simulator gameplay with easy pick-and-drop missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lightspeedstudio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Light Speed Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/lightspeedstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275208615686439"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1393177909223836"}, {"status": "PUBLISHED", "id": "1026167180454665"}]}, "baseline_offer": {"id": "1393177909223836"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792425360, "status": "PUBLISHED", "id": "1393177909223836"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidB
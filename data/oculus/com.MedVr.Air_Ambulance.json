ucation", "Medical", "Training", "AirAmbulance"], "long_description": "Thirty-two-year-old Donna was struck by a vehicle on the highway when she was riding her motorcycle. She has suffered abrasions to her face, chest, and extremities. EMS find her in a critical state and request a helicopter to help transfer Donna to a trauma center. En route, the patient is reported to be unresponsive with several injuries.\n\nThis VR simulation open scenario is designed to help learners manage a critically ill trauma case and prepare the patient for an air ambulance transport.", "short_description": "This VR simulation open scenario is designed to help learners manage a critically ill trauma case and prepare the patient for an air ambulance transport."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9340853695926054"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1489385938426075"}]}, "baseline_offer": {"id": "1489385938426075"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733123220, "status": "PUBLISHED", "id": "1489385938426075"}]}, "liveChannel": {"no
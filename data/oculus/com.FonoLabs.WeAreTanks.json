_Afs9Ag-bma0zI4A-BgnJV1Cp_mm3RUGhx2U-BrMAeUMSuQ&oe=699AF5F1"}, {"file_name": "Image Sequence_049_0000.png", "id": "9333818306744567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823270_9333818313411233_8671152487105507948_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wGB4XTCdJ0Q7kNvwHHmOzI&_nc_oc=AdlxdLAqJ-LJm3tbD4PTDuj5JPqyF7RCcxl9MP-68ezUkY-pf8zUPj8saLZBZq7n-RQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afshnd5Su85MTroVu_xmcwJLgYkTLGUT0K4TLcknSci92Q&oe=699B0AAA"}, {"file_name": "Image Sequence_056_0000.png", "id": "1379352933206098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823337_1379352936539431_8793723710007389683_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9x-r9fmELUQ7kNvwEZPDv_&_nc_oc=AdmBbImZOyoWKpBzZx3r8uFFULysYb2ZNU4-bSzIQ1qxVskpC-wHPoM2BnpmFB80JoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuulXg97sYwvwVg0B5uXHYtpDg8DT8E3beqmTd0uZrqGg&oe=699AFAA6"}, {"file_name": "Image Sequence_061_0000.png", "id": "2105248243280035", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823818_2105248249946701_7520079176484815868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmKmUdaV6BkQ7kNvwG6AlRE&_nc_oc=AdmWlgRSrLp6DZO8JFvEJcH2FTq0xWX2ZqMS5ymFVxASgw_YUpWxFkWgojPhdq5uYrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuSb5sAgr9w40iNszHJOpzzU70c2bF2iqTQz9ElsDQN4w&oe=699B0F6E"}, {"file_name": "Image Sequence_058_0000.png", "id": "1193153912596234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821154_1193153919262900_6788473709565815636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob4NOYYVsWgQ7kNvwGssNqe&_nc_oc=Admp1QripEGeTz-0pb1zAOjT42J3U5OuofeNobim6HWq_kXlsXIxPyAe_AD8EkjYFeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftbZhBse4NlibQSsujm9NFmp2Q41bgiO-Xfc9CObaqDjg&oe=699B0EC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Are Tanks", "keywords": ["tanks", "arcade", "synthwave", "retro", "multiplayer"], "long_description": "Welcome to We Are Tanks \u2014 a fast-paced, arcade-style multiplayer VR game where you become a sleek, neon-lit battle tank and fight for one thing: kills.\n\nNo time limits. No complicated rules. Just hop in, blast other players, and climb the scoreboard. It's raw, retro-fueled action in a glowing synthwave arena where every hit matters and style is everything.\n\n\ud83c\udfae Features:\n\n\ud83c\udfaf Kill-based multiplayer mayhem \u2014 rack up the most takedowns\n\n\ud83c\udf0c Retro synthwave aesthetic with glowing grids and thumping beats\n\n\ud83d\udee0\ufe0f Minimalist, low-poly tank design \u2014 smooth and stylish\n\n\ud83d\udc51 Score is king. Outgun your friends and own the arena\n\nNo clock. No breaks. Just you, your tank, and the never-ending hunt for that next explosive hit.\n\nWe Are Tanks. Are you the deadliest?", "short_description": "Simple tanks. Synthwave vibes. Pure multiplayer chaos.\n\nSuit up and roll out in We Are Tanks \u2014 a fast, arcade-style VR multiplayer brawler where you and your friends become sleek retro battle tanks in a neon-lit arena. No tutorials, no fluff \u2014 just raw, synth-soaked mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fonolabs.xyz/wp-content/uploads/2025/04/WAT_PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://www.fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
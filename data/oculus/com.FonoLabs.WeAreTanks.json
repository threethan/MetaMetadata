_AfvlPoGVvLuO2Lr8pTO80hlE8GLj7X0sJFNEl9QkvjHFlw&oe=69A2DEF1"}, {"file_name": "Image Sequence_049_0000.png", "id": "9333818306744567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823270_9333818313411233_8671152487105507948_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te9XxDUbz_wQ7kNvwEGc8I-&_nc_oc=AdmoWH7qjzcnzyEQytkBH5qBFOoU6Vhn0GVI1cN64aY2irFlW_v5qFu7POVEZ5fsb0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftIuq5b4QWxtpwNoLOlt6wI1hJ_ZaHbS7Yq6BCh25s3eQ&oe=69A2F3AA"}, {"file_name": "Image Sequence_056_0000.png", "id": "1379352933206098", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823337_1379352936539431_8793723710007389683_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZthmwfhroX0Q7kNvwHBEq_k&_nc_oc=AdlF-FkhWPlarg6IWQoA2e8RnsBYTn9W1XYw66eYzcoLjpwlYgghv1n7JGjZbKWnb7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsp8F_sbkdDz2aub0shvfb1WB-Y3uj45s9NAyxUYaDBKA&oe=69A2E3A6"}, {"file_name": "Image Sequence_061_0000.png", "id": "2105248243280035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823818_2105248249946701_7520079176484815868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8MvWp3alkoQ7kNvwF2oCso&_nc_oc=AdmJkY6VDEI8jRcP4GIxjr1G_djlZFSv29iVLdB1aLL6729ka4XMBKmicwvhnRKuLo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2GupQlqoUTlCvg3dGp_AgVMbfwyp3hRQa8xe5H6Mjaw&oe=69A2F86E"}, {"file_name": "Image Sequence_058_0000.png", "id": "1193153912596234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821154_1193153919262900_6788473709565815636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpYZmDGQroUQ7kNvwHKblfb&_nc_oc=AdmW3wqD0fMdxM7kAr7AAzvnidrcLpm4-aRKpt-NqZQViq6fYJEI7-7e4Jik0QxAehQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHTu7M91JwWthN8ELDTAWyamVq20mm7eWeEtuMtFw3Bw&oe=69A2F7C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Are Tanks", "keywords": ["tanks", "arcade", "synthwave", "retro", "multiplayer"], "long_description": "Welcome to We Are Tanks \u2014 a fast-paced, arcade-style multiplayer VR game where you become a sleek, neon-lit battle tank and fight for one thing: kills.\n\nNo time limits. No complicated rules. Just hop in, blast other players, and climb the scoreboard. It's raw, retro-fueled action in a glowing synthwave arena where every hit matters and style is everything.\n\n\ud83c\udfae Features:\n\n\ud83c\udfaf Kill-based multiplayer mayhem \u2014 rack up the most takedowns\n\n\ud83c\udf0c Retro synthwave aesthetic with glowing grids and thumping beats\n\n\ud83d\udee0\ufe0f Minimalist, low-poly tank design \u2014 smooth and stylish\n\n\ud83d\udc51 Score is king. Outgun your friends and own the arena\n\nNo clock. No breaks. Just you, your tank, and the never-ending hunt for that next explosive hit.\n\nWe Are Tanks. Are you the deadliest?", "short_description": "Simple tanks. Synthwave vibes. Pure multiplayer chaos.\n\nSuit up and roll out in We Are Tanks \u2014 a fast, arcade-style VR multiplayer brawler where you and your friends become sleek retro battle tanks in a neon-lit arena. No tutorials, no fluff \u2014 just raw, synth-soaked mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fonolabs.xyz/wp-content/uploads/2025/04/WAT_PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://www.fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
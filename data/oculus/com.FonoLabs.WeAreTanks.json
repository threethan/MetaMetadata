luscdn.com&oh=00_AfuulXg97sYwvwVg0B5uXHYtpDg8DT8E3beqmTd0uZrqGg&oe=699AFAA6"}, {"file_name": "Image Sequence_061_0000.png", "id": "2105248243280035", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823818_2105248249946701_7520079176484815868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmKmUdaV6BkQ7kNvwG6AlRE&_nc_oc=AdmWlgRSrLp6DZO8JFvEJcH2FTq0xWX2ZqMS5ymFVxASgw_YUpWxFkWgojPhdq5uYrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuSb5sAgr9w40iNszHJOpzzU70c2bF2iqTQz9ElsDQN4w&oe=699B0F6E"}, {"file_name": "Image Sequence_058_0000.png", "id": "1193153912596234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821154_1193153919262900_6788473709565815636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob4NOYYVsWgQ7kNvwGssNqe&_nc_oc=Admp1QripEGeTz-0pb1zAOjT42J3U5OuofeNobim6HWq_kXlsXIxPyAe_AD8EkjYFeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftbZhBse4NlibQSsujm9NFmp2Q41bgiO-Xfc9CObaqDjg&oe=699B0EC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Are Tanks", "keywords": ["tanks", "arcade", "synthwave", "retro", "multiplayer"], "long_description": "Welcome to We Are Tanks \u2014 a fast-paced, arcade-style multiplayer VR game where you become a sleek, neon-lit battle tank and fight for one thing: kills.\n\nNo time limits. No complicated rules. Just hop in, blast other players, and climb the scoreboard. It's raw, retro-fueled action in a glowing synthwave arena where every hit matters and style is everything.\n\n\ud83c\udfae Features:\n\n\ud83c\udfaf Kill-based multiplayer mayhem \u2014 rack up the most takedowns\n\n\ud83c\udf0c Retro synthwave aesthetic with glowing grids and thumping beats\n\n\ud83d\udee0\ufe0f Minimalist, low-poly tank design \u2014 smooth and stylish\n\n\ud83d\udc51 Score is king. Outgun your friends and own the arena\n\nNo clock. No breaks. Just you, your tank, and the never-ending hunt for that next explosive hit.\n\nWe Are Tanks. Are you the deadliest?", "short_descriptio
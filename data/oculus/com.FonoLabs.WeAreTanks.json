": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823337_1379352936539431_8793723710007389683_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mitB54NerWkQ7kNvwEuwUYP&_nc_oc=AdobuI2CEvF1uuewDXw59dnGuSEAJgW9hrmlx061PS9tyWXIiiHL1oILYWLNeWUoiew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yJijfTg5zygaxRkLPEbODKTQRNhBShDxH5egu10Vo_g&oe=6A357266"}, {"file_name": "Image Sequence_061_0000.png", "id": "2105248243280035", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823818_2105248249946701_7520079176484815868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixqij1gLVIEQ7kNvwEA0-rx&_nc_oc=AdqWd0E1g-2ScUz5gK4o6GaZZxzdjgrMPCf7uzcU7xpT0Thho6GAkXrclprk7SSQXyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85iEbJ8sEf57w_wWjDk1exVGdLngPEdFlo7-hvztSk5A&oe=6A354EEE"}, {"file_name": "Image Sequence_058_0000.png", "id": "1193153912596234", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821154_1193153919262900_6788473709565815636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMPJs5vc3VoQ7kNvwED7OH-&_nc_oc=Adoi-aBpfpshcuB3mvo_n7ruidNQfOfXAl6vgcr9LvPtaNGa_a22kcS-k7ihrTeYDlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9Tx2nKBKzEMK8-JZBkkjxL0zP-qLs1Zx7TwbT1W1nSQ&oe=6A354E43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Are Tanks", "keywords": ["tanks", "arcade", "synthwave", "retro", "multiplayer"], "long_description": "Welcome to We Are Tanks \u2014 a fast-paced, arcade-style multiplayer VR game where you become a sleek, neon-lit battle tank and fight for one thing: kills.\n\nNo time limits. No complicated rules. Just hop in, blast other players, and climb the scoreboard. It's raw, retro-fueled action in a glowing synthwave arena where every hit matters and style is everything.\n\n\ud83c\udfae Features:\n\n\ud83c\udfaf Kill-based multiplayer mayhem \u2014 rack up the most takedowns\n\n\ud83c\udf0c Retro synthwave aesthetic with glowing grids and thumping beats\n\n\ud83d\udee0\ufe0f Minimalist, low-poly tank design \u2014 smooth and stylish\n\n\ud83d\udc51 Score is king. Outgun your friends and own the arena\n\nNo clock. No breaks. Just you, your tank, and the never-ending hunt for that next explosive hit.\n\nWe Are Tanks. Are you the deadliest?", "short_description": "Simple tanks. Synthwave vibes. Pure multiplayer chaos.\n\nSuit up and roll out in We Are Tanks \u2014 a fast, arcade-style VR multiplayer brawler where you and your friends become sleek retro battle tanks in a neon-lit arena. No tutorials, no fluff \u2014 just raw, synth-soaked mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fonolabs.xyz/wp-content/uploads/2025/04/WAT_PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://www.fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9858956874169463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1610739849625778"}]}, "baseline_offer": {"id": "1610739849625778"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744824000, "status": "PUBLISHED", "id": "1610739849625778"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results":
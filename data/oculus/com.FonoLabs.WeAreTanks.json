23710007389683_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH03vr7uZZEQ7kNvwFUcOWC&_nc_oc=Adpt2r_cwpS7_LWQ7WZOW0CB5WCnz7lQY6lsH74x23HqcYl12TaIv5MEUi5Tnd3Qg9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfylzAhIM7LDUaJ_RPAxXQwiwdXpHCC1Ckl9AGtnd_i4Ug&oe=69C13626"}, {"file_name": "Image Sequence_061_0000.png", "id": "2105248243280035", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823818_2105248249946701_7520079176484815868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnSyCP8NUcUQ7kNvwHO70i2&_nc_oc=Adrxui9iduEPA-qF3E-BX5Zv453avxxCfYAcOjjdMaEbIA4ZobIBTE1eFY_y-1Y8c3Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu4eoxyKM85bGaU3kq45VRUBcPgBNuUY9V2G8CZ8jLsA&oe=69C14AEE"}, {"file_name": "Image Sequence_058_0000.png", "id": "1193153912596234", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821154_1193153919262900_6788473709565815636_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PrDTf9T4f8Q7kNvwFlysMZ&_nc_oc=Adqtfe7To8glLrCDt5kIVJJAPlgAZhbxKIoEkrnpRCdxDDOPJJ3ek-Nh1GPJkWosgSg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyq4WU6i9R2FbpcZ7rbJ-_HOSSe9eSXsnUapEHOssnwZg&oe=69C14A43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "We Are Tanks", "keywords": ["tanks", "arcade", "synthwave", "retro", "multiplayer"], "long_description": "Welcome to We Are Tanks \u2014 a fast-paced, arcade-style multiplayer VR game where you become a sleek, neon-lit battle tank and fight for one thing: kills.\n\nNo time limits. No complicated rules. Just hop in, blast other players, and climb the scoreboard. It's raw, retro-fueled action in a glowing synthwave arena where every hit matters and style is everything.\n\n\ud83c\udfae Features:\n\n\ud83c\udfaf Kill-based multiplayer mayhem \u2014 rack up the most takedowns\n\n\ud83c\udf0c Retro synthwave aesthetic with glowing grids and thumping beats\n\n\ud83d\udee0\ufe0f Minimalist, low-poly tank design \u2014 smooth and stylish\n\n\ud83d\udc51 Score is king. Outgun your friends and own the arena\n\nNo clock. No breaks. Just you, your tank, and the never-ending hunt for that next explosive hit.\n\nWe Are Tanks. Are you the deadliest?", "short_description": "Simple tanks. Synthwave vibes. Pure multiplayer chaos.\n\nSuit up and roll out in We Are Tanks \u2014 a fast, arcade-style VR multiplayer brawler where you and your friends become sleek retro battle tanks in a neon-lit arena. No tutorials, no fluff \u2014 just raw, synth-soaked mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fonolabs.xyz/wp-content/uploads/2025/04/WAT_PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "FonoLabs", "support_website_url": null, "website_url": "https://www.fono-labs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9858956874169463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1610739849625778"}]}, "baseline_offer": {"id": "1610739849625778"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744824000, "status": "PUBLISHED", "id": "1610739849625778"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9847404705324680", "version": "0.1"}, "id": "1212528900589639", "channel_name
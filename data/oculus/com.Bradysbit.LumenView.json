friends, or review content in an immersive workspace, **LumenView gives your media a place to shine.**\n", "short_description": "LumenView is an immersive AR media viewer for Quest 3 that brings your photos and short videos to life across five floating screens in your real-world space. Step into a personal gallery powered by passthrough\u2014view, swap, and showcase your memories in a stunning spatial layout."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bradysbit.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bradysbit", "support_website_url": null, "website_url": "https://www.bradysbit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24776311245383980"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "822822377457836"}, {"status": "PUBLISHED", "id": "1581340116552242"}]}, "baseline_offer": {"id": "1581340116552242"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "822822377457836"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24837873185894452", "version": "0.9.0"}, "id": "25066879296301522", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": 
psJfTuPGShujP-kwbOxI0fNkcwyOlt4r8Pten041DAlmvE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuEYmdwyBZU8rJDIEksQGwtBCjjjdGXvk9ykrgGADjZSA&oe=699C4AEA"}, {"file_name": "e4e0916cc9b948bb9f630f6cd8f960a6.png", "id": "1530082024808362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295992_1530082028141695_6103467801687108107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzEADP2P-0AQ7kNvwHaIioV&_nc_oc=Adll-HuPteSwxM0ZYukFkNc3Xfw9DrnCYFF-k9t1XmFoa1HYSIvQ-E69K8NhyPrClFs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu79KrakUC0yUlZeLyatqWOlym2p93IyU5gA4DJMPGYEg&oe=699C3EB5"}, {"file_name": "8f5144a257a24e8ca383092f1b71d947.png", "id": "2379937655791720", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499310893_2379937659125053_7838928929197656148_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R0b-PeDhWEQ7kNvwHvyORx&_nc_oc=AdlUB3MsUN3xCGs6eRGVHSVJA1kg6uu2fL8VlDTLJcCD5lbqr6UxNhBCP0kFoOB2ZhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsOdABGQVGWmOvPbAnAipQgOXcpCxdPY6jhM_wWqXRuxQ&oe=699C67A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LumenView", "keywords": [], "long_description": "**LumenView** is a next-generation AR media experience designed exclusively for Meta Quest 3. It turns your real-world environment into an immersive personal gallery with **five elegant floating screens**\u2014perfect for photos, short videos, travel memories, family moments, creative portfolios, or ambient visual loops.\n\nUsing advanced passthrough, LumenView blends your media seamlessly with your surroundings, creating a mixed-reality viewing experience that feels natural and cinematic. Simply place your images and videos in the Quest\u2019s **Pictures** folder and LumenView instantly displays them across your custom **five-screen layout**.\n\nWhether you want to relax with a slideshow, showcase visuals to friends, or review content in an immersive workspace, **LumenView gives your media a place to shine.**\n", "short_description": "LumenView is an immersive AR media viewer for Quest 3 that brings your photos and short videos to life across five floating screens in your real-world space. Step into a personal gallery powered by passthrough\u2014view, swap, and showcase your memories in a stunning spatial layout."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bradysbit.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bradysbit", "support_website_url": null, "website_url": "https://www.bradysbit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24776311245383980"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "822822377457836"}, {"status": "PUBLISHED", "id": "1581340116552242"}]}, "baseline_offer": {"id": "1581340116552242"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "822822377457836"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24837873185894452", "version": "0.9.0"}, "id": "25066879296301522", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24776311235383981", "is
": "1367912891603940", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293690_1367912894937273_266298604813932729_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0ngW3lt8PQQ7kNvwE0Mhin&_nc_oc=AdqZuYzMsmZ4-hH5kxjM9wpkjX7fnmlnmuvmPVjw2wcdbbY3-kWqUJ_S1xvubdWNF5U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbVf7RxOzBcuwx7xqTGeemlZmz5_7-q5b3yA01M_BFvA&oe=6A5CC5EA"}, {"file_name": "e4e0916cc9b948bb9f630f6cd8f960a6.png", "id": "1530082024808362", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295992_1530082028141695_6103467801687108107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-54isUw_0cQ7kNvwFxZRj_&_nc_oc=AdoZqcu_TtoFL4fpT581itwIZYX42x0I1gVQ_WMkkE__zKQR_t0-kstKz5TQXfi9UgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB967lzi4kwh6662QnJUUvIkyZOiw4czRxCLOb9iEFWxw&oe=6A5CB9B5"}, {"file_name": "8f5144a257a24e8ca383092f1b71d947.png", "id": "2379937655791720", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310893_2379937659125053_7838928929197656148_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLq0A8jnsfEQ7kNvwEKY7eV&_nc_oc=AdqjWQIm274R9df84H3hpYJqOy9gO2-aNJt08-oRyhc_CUeE0anwR6TaW0B8zlal9Ck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfKHdqI_2LwPQmHNshKKREvQPHJ7WuP1Z9XZiUq4K_sA&oe=6A5CE2A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LumenView", "keywords": [], "long_description": "**LumenView** is a next-generation AR media experience designed exclusively for Meta Quest 3. It turns your real-world environment into an immersive personal gallery with **five elegant floating screens**\u2014perfect for photos, short videos, travel memories, family moments, creative portfolios, or ambient visual loops.\n\nUsing advanced passthrough, LumenView blends your media seamlessly with your surroundings, creating a mixed-reality viewing experience that feels natural and cinematic. Simply place your images and videos in the Quest\u2019s **Pictures** folder and LumenView instantly displays them across your custom **five-screen layout**.\n\nWhether you want to relax with a slideshow, showcase visuals to friends, or review content in an immersive workspace, **LumenView gives your media a place to shine.**\n", "short_description": "LumenView is an immersive AR media viewer for Quest 3 that brings your photos and short videos to life across five floating screens in your real-world space. Step into a personal gallery powered by passthrough\u2014view, swap, and showcase your memories in a stunning spatial layout."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bradysbit.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bradysbit", "support_website_url": null, "website_url": "https://www.bradysbit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24776311245383980"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "2081314222420384"}, {"status": "PUBLISHED", "id": "822822377457836"}, {"status": "PUBLISHED", "id": "1581340116552242"}]}, "baseline_offer": {"id": "822822377457836"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2081314222420384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26774962522185499", "version": "0.1.2"}, "id": "25066879296301522", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24776311235383981", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26774962522185499"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25066879296301522"}]}, "change_log": "Bug fixes and general improvements.", "created_date": 1781614557, "id": "26774962522185499", "version": "0.1.2", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24776311235383981", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26774962522185499"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25066879296301522"}]}, "change_log": "This release improves how images and videos are displayed in the Quest 3 headset experience. Media will still appear in a random order, but the app now tracks which files have already been shown so that all available images and videos are displayed before any are repeated.", "created_date": 1781093010, "id": "26699300949751657", "version": "0.1.1", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24776311235383981", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26774962522185499"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25066879296301522"}]}, "change_log": "What's New in This Release\n\n\n\nMute Any Screen Instantly\n\nPoint at a screen and press the side grip to mute or unmute \u2014 only that screen changes.\n\n\n\nBrowse Media Faster\n\nSwitch between Pictures and Downloads right from the menu \u2014 no restart needed.\n\n\n\nFeel the Sound Around You\n\nSpatial 3D audio places sound exactly where each screen is in your space.\n\n\n\nPlay Any Video, Any Size\n\nNo more limits \u2014 enjoy everything from short clips to full-length movies.\n\n\n\nCleaner, Easier Interface\n\nA refreshed dark theme with larger text and simpler controls.\n\n\n\nTrue Multi-Screen Power\n\nEach screen plays independently for video, audio, and performance.\n\n\n\nFaster Start, Smoother Playback\n\nVideos begin in seconds and stream seamlessly, even for large files.", "created_date": 1776629274, "id": "26073899368958488", "version": "0.1.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24776311235383981", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26774962522185499"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25066879296301522"}]}, "change_log": null, "created_date": 1764873442, "id": "24837873185894452", "version": "0.9.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": nu
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjTBiVWT_h4Q7kNvwHhAnUJ&_nc_oc=AdoeAerEWt6rcUciQWdKtlwqWWnPtg1z6tPm6Zuu5LTH20tQzoTea6FlAupMh-1YppE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeXZJqHTXKrabJSUQfncA6dEI6tpKflkKnszQeFq71vA&oe=6A4FC2F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTQxVFMv_U0Q7kNvwHxbCu1&_nc_oc=AdpeUmtNfnEM9OtW5j5MUhE1AGVXBlWxRYCEAau6YzsfhLoFiKmocnNKsN-8nBVmUTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBJdP-Lb0o5y6ik1s_DWDk6SMGv393gV11j0ZT6DGsfA&oe=6A4FBF5F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piu36Yp5locQ7kNvwGEyR3_&_nc_oc=AdqY9wOhiKtI0CpmGf3GjOryX6VLJa9YsD_b2LbG4L1hMh1LJQwOzkTT9wC3QdEtmxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc4gOQKYnnqudtgKOTUItg0shhm2h-1flASLyV7d5Prw&oe=6A4FB43F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEovvQ_LaioQ7kNvwEElHLW&_nc_oc=AdrwRqWmZgqX1PRlU4njwScmqOcB-iV5z4uT76BUtMRq1_DJkm73B3xeWv1LKhzHM_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtpDj9NrgxPawL5EAuVfCLcltnYKNVas4Y5OBL4u3qdQ&oe=6A4FB9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEa-ElL63kIQ7kNvwE9L9R2&_nc_oc=AdoF6oLQCO55_1b3xw5rltQ9AwMNwJ9MAv-kB-seAmU1TghkpA_fr3n5TsAQYuOenlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNEpgwlE5hVPgbWZiJUHBQ1UYDUviBVOJb6ZV2pDtAMQ&oe=6A4FABDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
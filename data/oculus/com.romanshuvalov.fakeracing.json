092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLXduV4qQd0Q7kNvwFEkHSK&_nc_oc=Adoy0yd7hI0NfSJGYQowNt8JuV54tqy_d1_92O7N0N9inlzxn-NPKQfyr3-JiqT7XTs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MG7YseGgpU-B1vquyPRMeIA31h2H5_e4o7HT7uGkoXw&oe=6A26E476"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2iFiHCyPtUQ7kNvwEAq-G9&_nc_oc=AdrDzgejc1PR7ytmzTbVHqI1zb1qpN1HEh4c8vuVarvsV-xvrcu2bSuloEQL4Je86us&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uv6uHyvU0we1P009DwyqD6A6Pe3MTa3Bd-4xUi-ZoDg&oe=6A26E0DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JHzPWrJvMsQ7kNvwF4YChq&_nc_oc=AdoUn28asna33olmqWIuRWTTOG2w43QY7XDzynmYuug-DUuGXI-FkRrWiRKd1_z1cZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OEm4A2a949yMOPZTW5EyFOZveNS86yRyRlyAZ8fGnsw&oe=6A26D5BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbOEOkQZ73MQ7kNvwETdI67&_nc_oc=AdpTpVChSE50ZBHLr5r9deYvTxQ42KQTaD1VLeY2n5WpPKM3InhX-SFHVBiKsl1Zd90&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w98ba9c_UDF-3ncXBgOoOn61U6PXtVr6jjrJdc2jkkg&oe=6A26DB4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnW4E-vaxNMQ7kNvwH0wfwI&_nc_oc=Adp6GF-GzKoqJSaJByQJjQN3OkXvZT66FOztqbG0e9QTPplVCvbzLhccQEjEKW-6oUM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jts8-v2O6bnH3NKFqGeANfYZutg5Nr09P2hVPHjE_XA&oe=6A26CD5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
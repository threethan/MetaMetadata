092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9sfsUXrH2MQ7kNvwGBpHEC&_nc_oc=Adod-T8Qj_kOExSnl_dIhZbJgPfBr-UIMAECvS33qUfBBgfbGREdiPHgwPv-PLABPPE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRntVE2ZApFMQmsS1wKJOXvUGymXIvCODPDlJkGC39zuA&oe=6AF33CF6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeciiIQLoGMQ7kNvwHFzaGA&_nc_oc=AdoQC2qac2FZHouIh61y_q_ZhRirzM_HW9QIzq5V1ABYgMfYDLTn3f4eU0nzwrmqT10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8RK6MBI819TeqInfxFzzq1VOnD3uwlxwh6p_bg42TLw&oe=6AF3395F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8-n3AltNacQ7kNvwFa8BQx&_nc_oc=AdqXZbceE3Uii6-D6910q9zuoQXZ744MdnGsRq4dtK53Sip4DWfpV5dWlSbF4wVpWvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQwI05q2C7JF4y2OHdIo-kRuB4fVcAwbMsB3q8_rmC-Q&oe=6AF32E3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGg5X1CSF1UQ7kNvwFkeVnu&_nc_oc=AdpmLnlA7rAipcjPyveyzYpMg4tkbwfTIFTFHjBw_uZKalHko6kZBWzgys6_C2cfsj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-Kl8LZk3QjOjCc_RCiahPP-SNrN2ipE2uQv2cdsxMRQ&oe=6AF333CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpazinIylNEQ7kNvwGVn6QT&_nc_oc=Ado-RSIBZcxMh6FfwUUfXSEv8vonXvWp9MNkXY-wV3pRZMYUtXA2mgigOu5kfHH6OAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL25sNPWcBxu2bCMVtFja7SRSI8MzVAC4wf8mT-wctxw&oe=6AF325DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
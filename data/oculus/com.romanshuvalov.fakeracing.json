092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHfhjXQzHIoQ7kNvwHaQF23&_nc_oc=AdrU4Hm33h4AmhNgU4xSmuak2ExJL2w8K4j3WYETMbDTlz_kwq2crsuWqc-rSw0rtrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMPD0AjyFFaqOXQmuvtouPWc3TskYU3Z3WTpplwxZ85g&oe=6AB697F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YRL5-1FM4AQ7kNvwHoRbws&_nc_oc=AdrGSLRd8Sg4ZdAcYkBZf8uslgPxSMK4zRzd1rvG3CbW27Qj8KLpEbmsqrMnh-8oF6A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMF_0sPwSvy4LDAr0sFAgTraVnn7WMik6ljTG17TBDlA&oe=6AB6945F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_7vV545kY4Q7kNvwHkLo2w&_nc_oc=Adr2rwPsLkvBf9l90K6FhDd-8-7fy5JscmOdUSV_HX19pW1WRBdjqjvLo3q8iopcA-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2tKGX6uoZiA2ayqHxyt8T1fE_QwNErwjO-Rny2mxBww&oe=6AB6893F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojxPkdG3l3sQ7kNvwGRBv6H&_nc_oc=AdqrFXX86Ivm9SP1dRl0QEbWAADXWO-Q-cXXijm1hKruzd3tg7gH6dJALlRsNIFK8Ik&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZptTBDc3cP6VZzR5bKWXxIg_XCbjmaz5MnpXQbmP1cg&oe=6AB68ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRH04JcPILkQ7kNvwGMgmPj&_nc_oc=AdqQnXQ-jmj5hWKRvVl1tQ7D951zPQEmdjBcnVG5VdnKd83xKyQ46P8moO_WyRBP5cY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2tLIRdnTa7KW4X2iNBdyrvdCbby4Nk7A1ZgHO8ktkxg&oe=6AB680DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
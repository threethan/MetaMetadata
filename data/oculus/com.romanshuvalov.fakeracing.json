aObj&_nc_oc=AdkpySOG5IjdiZauUlsZ9tzxbE_P1bxpppxlbMtpOg8PzJ3bBmmFulqjJfA_8wghFWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDT9osUjAzBxv6yInFSw-ppLdCMiOLHDak6tG-TR0DNw&oe=69A2D636"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWS5Q92TSlwQ7kNvwEhmRX_&_nc_oc=AdlkdjK3fmMpSWL-kDgJjOKvI4UMiLlH5f4tKbWEtZbw1D2OCwTCgCPCgTiLjx0dWZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNbZTmdmr0MSW0rVAHM3n1_pgz6Q_7HnCbt12QImXXng&oe=69A2D29F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1mPWiU7eXoQ7kNvwGZO9aK&_nc_oc=AdlSFVNgqj7gnGCCEgJ5_HdHEwBMTWEm3GL__u_G-lRr_y86hrVmmE_EObcsHhN6VkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvyg93DiQb48tDOr7XyA9ijCnzk_g4ScLLOICOS4lmz9A&oe=69A2C77F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3n-SDRf3dAQ7kNvwFY5-ZB&_nc_oc=Adlh7man2_ddpQM5sldph83LuHARAtE6ddJK0Kc3SVY5M9IZfhG_4qCdLjRjEKVllvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMP6LepZhGPctMLdU5e4T37bRvw01n4zEAyuA0-MQQ9A&oe=69A2CD0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiNZDiA_YB0Q7kNvwEeHl3q&_nc_oc=AdnMfjrM2grdYpDVxTVDyqSp7L0jokQzWpPJUTKchHqpJgCsfzG7wS8WjFALfkQZK-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftz8HdcVGdTnTIrpK3Aj5H_BDhE3ac4mr3Db-U-Gzw9aw&oe=69A2F75A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294245_186479453662653_2289662199946431919_n.png
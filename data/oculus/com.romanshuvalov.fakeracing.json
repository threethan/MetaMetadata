hjKX&_nc_oc=AdmN76C5u0cJT210ZPyeNHM4nO4tV40c0Q-csEnHsf1IN8NJfRVjGuKP6DEZsPb-9BQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsL_Rg8JE0o27ae8dEwbILMwXH31pw_azJB6U_kkgSv0g&oe=69984A36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9ebgRU4DwcQ7kNvwEpcQL3&_nc_oc=Adnh2u0hqP3dkA6-ZSs0wPAJpo6im_5zm48LQQ_N1DQjt7ExlVgS-GlucyRvWmkmKes&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvpTyCA9Ma6sVJyfbFsHGhwhm6nPzyvvooDrmD8Dsvmiw&oe=6998469F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss8OJcnYstoQ7kNvwFwv_8Y&_nc_oc=AdnSyBtprA6nIUL1EB4FuD1B9RU7etjFoJwkk76h8lpbgK1pJg_XFa_-An9j-ahNryo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsxLpbb6CoPrBl4MnDxDvH_LGe0V6lsHZL7Jgb76gs0Gg&oe=69983B7F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch80Y0sNcKAQ7kNvwGv9cew&_nc_oc=AdkFuKjguR_nzKsT5W3om1VXd1emqYWvV9hWShbVtI7UsfS6s2tRFQbNwPdpI7axEQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu-s2U_UwnopXIm7fOPIJ3ULNn7ejePCvg84tv1o1SslA&oe=6998410F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HUHEDXwweEQ7kNvwH3xidg&_nc_oc=AdlylV0b0AKD28u9-PmzZ1pqKzm1tUzunwTA84qbTYYw-jaJTGvoTLTZwppsPp5oqw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfthPJZlMEt7tZxAZoWetRuQKV8kzRjxIr87coxKheBlHA&oe=69986B5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294245_186479453662653_2289662199946431919_n.png
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajdHbFhrxUUQ7kNvwHdL1cO&_nc_oc=Adr4smlM8h5eR57Zts15xvthS6ZojoRkw_F4LvQVCsYjrfb4T3QDZK6bCtvVDO826fQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4Y-juDHfVp5F28vStpgIcebflnxmKwFTdgF2ClFLlpg&oe=6A9418B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQUnLISbUmEQ7kNvwFwIPyM&_nc_oc=AdoNFwXtamMSgd4G3RIYb1_97PCaPxE5kNPjM-_zqssM9rBKgVlZu7Urgw3Z1Qjpwuc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGudzZhXBqaF-FnvdFfVSaNNZVzGp0R2LCFF5YaT3fefw&oe=6A94151F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV4K7NLQzY8Q7kNvwF1v45q&_nc_oc=AdocIvG9y8H_ZtmTYOTAReCQTWvUl1a8FONIsaIavJL4J0It49oGrl9JZFeXrHEI9A4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRAo7K10yrENSm0yp6eTK1XSBKrjU83n65HDEQtF7eTA&oe=6A9409FF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dfK7-n2mBYQ7kNvwHQbd0L&_nc_oc=Adre_ITHCa0FuyeYxvDwvJbRmjDbfAC4PXrsudOoJxRhXcJ6cI3B8B2WvLHz0kh1tNM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB5xtMNZdgZzsXHICD8MsRWrEQsfLRQaImlmpjgRWKMQ&oe=6A940F8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkOoNGaJvMQQ7kNvwEfp1xP&_nc_oc=Ado5sBDsXZaXa9_w843Kd5b1eH5jnU03hf0qL10HUNLLtRo_wkXWxk_Vq_KB8KNTwUs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX9m9Pp6N4eOGpYpASNpJKDtN6u38_tq_cjca51alJ_A&oe=6A94019A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
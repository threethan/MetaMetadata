092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efydXvwntMsQ7kNvwG73LhG&_nc_oc=AdrP4n7dGVm0E99MwcH2AKHAKxGvrZ8wesm4JkAOQDfzVcaVsn_DkB8cDEFVaQjlHUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyQkWiTtgNW48QMmIjPaJQG8b43g7wjJEbbcoImTXElw&oe=6A7474B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qQQB9hHH9AQ7kNvwGucop3&_nc_oc=Adqg2k-zDvC3bZzIN9cimRapIJH1KOn72jEXy13MQTXk-StHQk8ci-TpxqbNsFb-YOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHffVyQPQIgtKUE7mJFlcwmXtZpJnFMzknXPr9Q9FZznA&oe=6A74A95F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqxZH1_1llEQ7kNvwFitvFd&_nc_oc=AdqdfSC3Lr4B7iMmMVSFadBMTuxcfpzGCM8VasSdmyxw_ink1CtDeOrBYENoBEsBZN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeq9RybqvpUeQZqsgNfGE0sL37MvPfO6Z1We0ehM4wVw&oe=6A749E3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GnzWlvCsuYQ7kNvwGLU0TX&_nc_oc=AdrlokeeTpMBT1QGwRwPFJk1zvR8c3K8eIHkIiaijIYsF2jyDMf8pgtx31ozhKLYXKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIVIAxlSqpxH-Qv2FC7KDJ-WzxjVt8uG2hq8xuQFw83A&oe=6A74A3CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0boE9oQEEcEQ7kNvwHKOqaI&_nc_oc=AdpUcuUxU4oaaiiie7lyQ15kgSQO-v_3yfrxzx0YE9395bXgzWZULN74qvU97NTWdR0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVVkGlQevzgdBWByOxeqHk1hxyy7ZBeN7dqw9Sl7slnQ&oe=6A7495DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
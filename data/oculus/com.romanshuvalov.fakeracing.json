092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq2kxC2jDwkQ7kNvwHcAofs&_nc_oc=AdopsF7VIE_8VDKQVnsYPJhxfcN5Qg30Ce5Au7aO-HHzVnam4fuCbcGwn-JeRW9Ni4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95OY7fHMORWw60w0fUSwN9zVbzhO5w87G7oV6wvt__YQ&oe=6A341376"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEYbSBgLduEQ7kNvwHhoVaG&_nc_oc=Adp_M15bWMKesqlLX5ccnKLCXGUyjDqzedQPGp3cd-uhzcFWcJRVOjlBsnWoQcFg1Qo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oDwjxXBtlbmtCHnq-_xUdpuUn2D2kH30oK0-C8WcdiQ&oe=6A340FDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HllZxP8zfEcQ7kNvwE9neDJ&_nc_oc=AdpPIbry7cDfQAzranXegVM4R-_TeXvWRUPKFOY5wFNn5XBFLWRjCb9CRreqIT8Io1Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GQcPe6VZ8U1xxj9nrnfdzo-cKLK2yUkfwx3U4FaTQPw&oe=6A3404BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxeJn9mBdvYQ7kNvwG0RtP-&_nc_oc=AdrBRmjjbCxKSMWVJowgU4YcRrtKdnDrHirvd7SeD10cGebMQboKkyYiwu9NwgWO3Js&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lTuc1KXVCoTbiFepDnSBZQHpAQLrZUAp6SdzyVZmlYw&oe=6A340A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVAc2IXGnmEQ7kNvwE3gT4u&_nc_oc=AdrbwxCa1TRXwR6_p4oN4r4-eJmhawJltNqZhEWMKeqiSUzd6iM1CNQfJfNkQYPSf5A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ox95XWK-ekBQAgXB6vckLxAHVznq1LhjnAFqTcEx47w&oe=6A33FC5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
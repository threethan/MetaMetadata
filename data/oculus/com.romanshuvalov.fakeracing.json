092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JqafHX2vJQQ7kNvwF9u69Q&_nc_oc=AdpAr_rYIzUN0800tlm3yR2azePaemJloOvqpSetT_xSP3w6oHXTcgbqO4bJEihG9zQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5ICdHI32bbl2DaxI2xZkk7jX965Ge90GFSMc-juM9gA&oe=6A244176"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm7DULd4g2wQ7kNvwFWdSBi&_nc_oc=AdoFxNrg4OWDi-U6J7dXrbZ5uW8D5dDziDOk08Q7er2WYULrmOXqhdv8ZrYGz5eQwDg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wLj360FD6M-XfAi3p_CsNDkAd_8G9lxPONM5fN1B-kQ&oe=6A243DDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JHzPWrJvMsQ7kNvwGfhjcG&_nc_oc=AdpGlwSffT4in_WJnUtDvMiLA6LEDid5j0z58wqgv87-ZuC1LJDIPsLJHz4Rg8ngrBg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NTOR811Wk-zt0LaHqBvmVooNaLX6nZZxy4Jn7LQ57Kg&oe=6A2432BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68IIO0nLd8kQ7kNvwHdhhnm&_nc_oc=Adq6-iXxWXLU-A0jwRYM1pV7znmpYVOXCC7IWKjj7_N8wglDCTNO3j3hiDoDmaxQfj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xIfzSU195vFrg2exAMB22bZYfmKWJH5ftN3xtRmRpqw&oe=6A24384F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnW4E-vaxNMQ7kNvwGbiCpQ&_nc_oc=AdoUBTKgTibM0yhAn4IF31Vc8j9hG1Y8cNShl9Usv-WTSBrbDHUtdeposh63SV1g48k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oaxPGt91qJcXJzFvGEe8i1N0B7e6Bqz9MkgZa34zojQ&oe=6A242A5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
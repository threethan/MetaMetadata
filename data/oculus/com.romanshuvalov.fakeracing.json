092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZEJIBhEq2MQ7kNvwF54Otn&_nc_oc=Adp-8S3_myw-LQ4R_n_jKM2d-Pn_9BTLlu-Se0yhiRu61e1zsL2Fu2oZKoFfJAl9M2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90bJz9e5Uxv-V4jFg97qsWLvh_8JgHxaYaDKrmWBwsDg&oe=6A3BFC76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsO1TZn5s3YQ7kNvwGqCghy&_nc_oc=Adr3FIzv5de41ODSf7omPcQEecqknYiEOJpFs3IcbgZhcBZrreZRGxd7MfdB41Ldo10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yoP5UNzb2mlvQCasAXNL4T1LK9mGN_0mf_xTOvY_NiA&oe=6A3BF8DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT_REkyu5DgQ7kNvwHDD4ZR&_nc_oc=AdpAUjVq_wb6sel09JlknBWWnPtSaqzcqOUgUvcZ9Tn1117uAYgaRB6WAbq43GYr19M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_acGxOnliT5XvBBh-XpVSD3t5DcDMTJxp0i_43laGPnw&oe=6A3BEDBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXVM7b6QZggQ7kNvwHHs1qi&_nc_oc=AdruuxdxO2CKXLy_MBoMA1kAQZrp8LRZpyWyD3PmMKkckaw-iKZnoOpsq0Rj7_G5DUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vlZGjF7CuN0GDWvj0jKsmRnxsCGxfBmhF5uk16ZjchQ&oe=6A3BF34F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZC26KkXTDkQ7kNvwEmXq54&_nc_oc=Adpb6C2W5N4_A3EvZ05aaNpVsAkQGPQnQJH2WoVFpdEM22BHp9533r3rDCeeZvE76V4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GDHhTouv1yuJMCrkb24cX_6imOlQ5HSDaiGVDUAtoNQ&oe=6A3BE55A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGdZyT2cn9AQ7kNvwEeywwI&_nc_oc=AdqjvzkNQ-QvT8XNr0pilQB0DQeIjgKbIwR3FUkaV0-RG-FuapP5aM6N-ESdjRfWEuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfythU3I2aqTLkWCDuJu-aQfFse0w9l_dZQEj2vve7G2uQ&oe=69D0FAB6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9kq9XdB7eYQ7kNvwHhCLl3&_nc_oc=AdrGzoIz5JNl3_E1_-omOqZfR5N5OvtZAgib8wHQpqUjDe-cjbJApdAhPqSO7-pEC-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyb76v9J_jAgNNjTuxcMTSmi1vWMosD870mExCVJ51SEw&oe=69D0F71F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A5W2c9Q_6UQ7kNvwE2_q0k&_nc_oc=Adp72tVpGgZnNcUcRQ9V8ygFF8hDXl3GXoTdjqpPI7gdHeTsUdRMZys1bsqhEw5cABo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPiXbJphssv8RQUfPrim9ocLZsa_LB5oFXdVIu6np6Mw&oe=69D1243F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeZeStkkCjEQ7kNvwF5hRq8&_nc_oc=AdrCGosPb6wMlAic42rPxttJsapZfGAam3ThTSMjHjq99vyhIiiUVmp-B1_-ASJA4_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUVMpOzxem2BLOWHaL17NVJ5GvumxIFSGQzLGeC1ufCA&oe=69D0F18F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oayMVdEabiwQ7kNvwERrBgv&_nc_oc=AdrmPhJpsDYicsqHLr88QWKapXnLgmWY3utsL7XgRlI-uoeqvzaoohxTLPRz_TQWh8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiJYd465r5JXN_tJeQV2o57eT5O5AspSUTI-bKxGJX0w&oe=69D11BDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
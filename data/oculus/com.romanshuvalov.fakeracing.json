092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26daPy6C2nAQ7kNvwEOIqhv&_nc_oc=AdqTIC-m_FpeWzP7ZJDhpyaAqE1ix6pKZvKAms3fc3bQxWn9L98eQT8VfBXdXDh8dSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UAVvk8gwHEDCz1janbrdGOOX29zC3Q6pP4HEtfYi7Ig&oe=6A1EFB76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHPHvkDEXVcQ7kNvwHhYiTG&_nc_oc=Adq7vK15Xp_3dXaYlhrreUoY5rxL79vWN8I5MN6_IxHR9u2oxjSbTSgjuH2fKoAg87U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M1MBXv-Mf7V1JxDpIB-GjIIlIduh6uP5ifabPfZEcXw&oe=6A1EF7DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OTEqtGrLZEQ7kNvwG6sByc&_nc_oc=AdrUjYPcnDm8CyLtQNZ1NbVElg1niUCHPYZ2-cUwVPkNSgDhUhmMSPOg_rp6BG4RE6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qAVX2j0QhSLOxKfam7CGPIsTqJE1-A-5JwsK0bFGdkg&oe=6A1EECBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGFeN5ogSlYQ7kNvwH_BpC1&_nc_oc=Adpc9UUCINJuzsEzTZUzPpd5x2yM_GR3VjERbFII5lglh3XPc5xaAGrKMye0Wg_q4GM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PqxWbkELDQa8p7sJhKdTdyr2R6jFD4LuHCgzHUBakxw&oe=6A1EF24F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZrUizNpcXMQ7kNvwH2NcD4&_nc_oc=AdqZ0FPOKeRQw9gJsjsdqxjkF2Ft6jbqw2SYOPJ4Mgdep77jgl6X58pN2TteEREIcH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b_sq5UIxQmmb0FCX_ICL4ZHM-QNwkx-fnGut3xbR61w&oe=6A1EE45A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
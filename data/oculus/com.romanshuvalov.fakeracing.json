092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjKPq5Vy8lkQ7kNvwEEcjwK&_nc_oc=AdpuAbA6FMqiAp-VvUMXfGpi_j-uZOC7Zl88UPL718NdcrB7skfYMVqCHjl4coYyPaI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hQewsvB7xZVoleWaqDNYSQjHi6kr8-3jDxmJ390fK1A&oe=6A107AF6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC9geS2v9VUQ7kNvwFXSc6-&_nc_oc=AdrdHdzmssz34XJxxDGkBp0EMGg5BmkFGsSZe57dIghyAWJZAMot97jB-j0nPzVGmeI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hvLrMQwVQJaJj8pOpYV1E3ovcX_3usuUZMAdAUcNnHg&oe=6A10775F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UNWQxtt_NAQ7kNvwHZzd0O&_nc_oc=AdoxrYwab_0iIGanpJaIPpofghMgpWtEbCUVWCrThUehBrOZeTC-unn6bMQ6KQFmg6s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wtGknQlh1s0QwEP8UnB8JiHNJ6SfBe8i-8K8zuyboOw&oe=6A106C3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GdhipIurSAQ7kNvwGiBTyF&_nc_oc=Ados488SSw3DlV4af6F8hlNsA2ftXrWKT-Hya0tLqwZCbZ2ZkMSFJ1BR-TynB3Lz4mY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pMqDN8Ay2L91GMPW8rYvQFSpB_bUXq5fpzXtB8-ayFQ&oe=6A1071CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaqtlK7KAQ0Q7kNvwGOXOGc&_nc_oc=Adrp47PxGP5DuOTnC1X6Dy45CJ3D_IMR1L55oBQLeS90uGBrjPn5_HS7YBQLl9G8beM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o1OOmAh98eiR8D1KKgVOp0wp9H_pvxpvaTFZNwjwAhg&oe=6A1063DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lsqTXBhvAAQ7kNvwHgclwD&_nc_oc=AdrOsNbcOdFcDjsKrURNwkm4cfNxsX3GF8aZTgLt6VLDG1JzPe59wS8PTmATIiRCmGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ-YFn5K4YGRDWPUVHLHHjqMdgNiO7a_WJkaeC2Ve52w&oe=6AA6C5F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UizHIzpSWgQ7kNvwETgPFq&_nc_oc=AdpvEddm73RuX7SoQ9tnPeuEPt71v0ivaXQZRob59KLrgOsE0bPTAhVxYrl8CDU45CI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBbIN_xZRFMXhhuZn1xiPlKbWAfJ6KgQ-emaC1031Spg&oe=6AA6C25F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AU6WHo7CjWcQ7kNvwGoyzIg&_nc_oc=Adr04h7B4UpWkECq9ta4HQymAw1rXHETG9gmpGV0rgjvX5WrXjzcLz_L4j7otmFl0kA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJim-gfJN3BfNC1pNwcAk8hMXZvDH_D8Ir4OGrZ72uRQ&oe=6AA6B73F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGuoZ6_6xOEQ7kNvwHicGlp&_nc_oc=AdqlOaOgVm8ZC2ZI8QMRHvbxyIxnGPpvhcXeliYk_QLIzD9IlAxx2SMb1oOqYtlhbmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOV4_cifDcP8Byq2sajoGOmQqJSelXgt1Qg0bqspIe8Q&oe=6AA6BCCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JpD48kuh_YQ7kNvwGMxJBF&_nc_oc=AdoTLRvdpH0SzCz36XKeaHBD0CyarVA4YpFPMQUeebqthgh9S92sZbRCpd6gwUJXDbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR0bumdMjbTy3KujN0DLHqrTkA9w6Pq9fdBqyO0qIxig&oe=6AA6AEDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNmizSDU1nsQ7kNvwEgFvMG&_nc_oc=AdpSY5oDthcNj3xDkkotqzEsitF_pOi3P6BqfqWt7CNwETe6pbRntvOaz8lABB_VS48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_rOtcVa2XZwQMqXGu28nIH1U7xszI3j16fiCjaGbpTA&oe=6A6DDD36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pW6hxRta6cQ7kNvwHTQGkv&_nc_oc=AdrSkZ5mvEtlGu6GdPF_nTC9FicnBybeuiL7ny2DxDiKc-VbgUfn8JyIljs6Rx9-eB8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2J9AGzaQ26Og4CQLuuLFb2mRJJlbMDAEvEqyUccEe9A&oe=6A6DD99F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gM3LSGMp6EQ7kNvwGZValg&_nc_oc=Adpbimvl-Pk6Ym70psqWuxxi4suVmldBV9hWtvo_FTYSzVGP4XYr1KrZR-x3vZA3Tgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPGUlPvsYAi5tlUq_ngo73OaD-3UETULEfjXaGwx747g&oe=6A6E06BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVADsuCCncUQ7kNvwFypj7L&_nc_oc=Adq9S0-r5Wfqgk-HSo7nam6ZhxE1wARk-urjAGZlhXAaN3L4-zCqLgwnMmX6YBzHBAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQmA3iP6CSVUfCzMZMPEJS1DvbWOANyBF6kQntwUK_pw&oe=6A6DD40F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNaPGjfyPawQ7kNvwFWpmrv&_nc_oc=AdoiDSNqiUmRiTjzJevZIFyjkWy8kOQJlCe599Is_02bKtl0CS82uRCayMmlJIhInI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDx_exn3HBH7SX0MuIAWjPJnXHtwrL5-qFyzV3mj-MP-Q&oe=6A6DFE5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
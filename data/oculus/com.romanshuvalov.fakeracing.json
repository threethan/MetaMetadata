092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GMaHhPw4BQQ7kNvwHnlYew&_nc_oc=AdrZxl3MWmMQhkAsaRVsi3ixm6wG40XfB-UXEoU3MEf-hub3zWJ5MCIN84LCVPocRFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaqyODYR7drL_XvT6jzn3rGYNoxP69UWTZhCQNyT3rNg&oe=6A5265F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB4NU7cXquIQ7kNvwFc7RDm&_nc_oc=AdrZa71-OYg93OxgsuVLIzeDbmvZChCB6nH44UAGj69bw_HlLeFYs33xavD6XjBGhCM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXHPhmCYLMy1Qx6kT8Kjfjb8VMyo6QWrameKGF0P1lwA&oe=6A52625F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piu36Yp5locQ7kNvwGz8lnE&_nc_oc=AdoWi9gG1PN0VVWr0p0FgQB4oMnOV8y4SVxSCCaWrWLPnlSRTOpD0XoGM4znyG3bRBQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNStrV1sT7CKs_b37lTUZPZJs99dDvVamgy7mIMiATBQ&oe=6A52573F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rBX4-b2vOcQ7kNvwE58OJa&_nc_oc=AdpG7lqMtiGTK1TuzozEq3y48YcnUGRHNtAaB3eh1GnPnpdd-5rTz3hAA6UP3oLbN6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA26pSl4D2rhpBUwlbG0QHkJGA1jmAYw29ZliX2GScVQg&oe=6A525CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEa-ElL63kIQ7kNvwEtJX7y&_nc_oc=AdrKSgejLj5SurFGtWDO7uSBRq_lsVHHvpT7M53jwPrzP4CS-jbVhPwnUlW5iNSPPhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu2quAua15l6iQMqNGOjs9CallEeOb6GCsLGwWqVwFVA&oe=6A524EDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
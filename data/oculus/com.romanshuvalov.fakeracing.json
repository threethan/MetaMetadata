092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MzTHPNVMOcQ7kNvwGKpAn3&_nc_oc=AdrzloluCETCQg8lGV4CXEy8nbFa9n8KDRi1Tv7AZAzDeakhvUEMbezyqQ1S07kuANo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRLhJHJLZgkeRF05ZoSf01-GZYIRyN1kgvsBa8X97Ijg&oe=6A9996F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CVSa1BlpRcQ7kNvwH_arw0&_nc_oc=AdoOuQ1nqSI0aMrRV0RXgE9NAb03mSn6XDAJm-crLQjBJ0ptFr5TFWO1y6KwSmVIrvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICrHsn1_AvYmGO-DYa1Z-q-5-H-MbHp6aiU9XDJ8LnYQ&oe=6A99935F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vk0ClWGtqAQ7kNvwFuo9WX&_nc_oc=AdqqK1Q1zUJefquG1QFny6UFl0vTZPnaROWDxAD3CAPwK1RVolAbLqRyAakx4zUDqdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv7dM_G-PZxARWJFLUkDDlhsTHG6mcs2Xa48P2VHkxQw&oe=6A99883F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOaB2wGVMC0Q7kNvwHs-pS2&_nc_oc=AdrGydrfyXyeGxkCr9LMdVrweCqNFiQLyArf6sybyM0v19N6NA3ml42i7VuXFqjfczE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIazE6cbBnFopSoHDXR3PKSIz8CuaYGkC38BfK4SiTPlg&oe=6A998DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhMEl8J0EFsQ7kNvwEhEgAT&_nc_oc=Adqg04cqfl0e2FOPV37x0mNjyDNlgcrLIYLMpAzhtJfvbiw3kltYf2LRu6wDxy-iABo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsn2SQGnW9hHYJ8l-udMKjjKOR8zAz8IHHpqXn3Y5EvQ&oe=6A997FDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
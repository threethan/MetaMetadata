092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bssIvbdy_d8Q7kNvwGng5QT&_nc_oc=Adp34giu4hdJJIL1j8uHvNeJF4sAlbN6Ng0Q3Iv66tsM9WoA7kqe4z8Quit0qNpkuLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vmEf88hRTAcSWywYdpFc3IAI8EauTrIKyloMNkhRN9Q&oe=69D39DB6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyzd_ob2h3cQ7kNvwH_5Fll&_nc_oc=AdrzgW4xSzO9bp4Gbj_w9s9KpqoBJ2mCcuw9hVwSNH0MfQ-SFfPyAYEBaP_ZAEEC2U8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17WS_l8soU0uc0BRAmj-wZDanMazW382_Y_VJRwrfd4g&oe=69D39A1F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A5W2c9Q_6UQ7kNvwHPnNwq&_nc_oc=AdpR2NyVMfSjvKzqvpDE4aQDkI434VF1uaF3lR1_n-SR2EyuHQfD9iy4VVbT2wKvY28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TUXzwOK-_y_TJb8qieWH2PKQQj7tWX4QiBkeLiXxRXg&oe=69D3C73F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf_JeTLy9g4Q7kNvwGe5VMM&_nc_oc=AdodTHG6xrw1mWzMcFIXhNEnZhx0d3kcQAPjXYHnBzVFE32QIE1pWzzUoUXHz_8hKlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cq-EFVFDHGEsf71mW0c26lii9TbDctIpQ65lQVkA32g&oe=69D3948F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oayMVdEabiwQ7kNvwHOrjLT&_nc_oc=AdrGdzFzIScMsMkMICY8mlmty9o1RVn_8QFC5XcqiP4nHj1LM0Haf6yHOWM2mcNMP7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L3rmbiI6BLzYGgUKgE5RG4V81iToybiuM6t-7TXid9A&oe=69D3BEDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi2qGNrzsXoQ7kNvwE9UrfX&_nc_oc=AdqdrPkczhDVF9HOunBRdiuEr4aMhGRP0ViGsWWwlz2urIhW5XmiNvarf-TkMiY92EI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af158LNVpauLI3sMCJ_OY0zSV74ZUpYfTIwsK7t2AA9bVQ&oe=69DE29B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2qXt-iS5XQQ7kNvwF0PfUw&_nc_oc=Adpq56oJljvAWwC9oTojG6NXTnhS6zE6LG5tjoMXmEGH4E6EnbKs7tnNL3XUj3x4IlU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_txxaQKii6UKHp3BE28EEJaaNNGRTWw7jnicsPKQ0iQ&oe=69DE261F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXiYR41ZlGYQ7kNvwFbAtld&_nc_oc=Adrb7yw0LpCAlUEcM1DTLAbbffXR8KoAx5K7fLEeZN6wp6XGICZV9nGTE_J24zKPAB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nzJGOiFfcbOKZjWbrpjpeYcDzDxxWFBZ1FCmN-EFAWQ&oe=69DE533F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55qNhBT4GhcQ7kNvwHsj2OI&_nc_oc=AdpBbIqqhvBwydYuTXKLHn6_GLssgeGAHC3rEYjzoogG28x98vzuQHZid5QfgbMXBsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aZpSlMySbR7OrwPE7LIMBkfoZHATqpSsMkuLlaRlOUA&oe=69DE208F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR9AaGcHZAwQ7kNvwH6ByBC&_nc_oc=Ado6RxOt6jmfRL3lgoIbdXWDN-whEMQxu5USXxO0GAE1Jcsu_JPm0n5KBn6B9Ublitk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3evtjRodwozl5YWAZ1kkJQ62PKVJaeLywUpGZH0KleZg&oe=69DE4ADA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
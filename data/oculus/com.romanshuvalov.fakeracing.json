659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqpaAT2e8fUQ7kNvwHbswtC&_nc_oc=AdnMOJ-x-ufrSU_oCKhyPItUK0or6_PszC7MqMQGRq18Nl-buzdClY074_Tpc_wiWDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrGH5klwOSiR-XXcmbYze_K-kd1wPVbwZaEUfmgc8-7A&oe=69AD6236"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd-fwP1y5FcQ7kNvwFfmbEG&_nc_oc=Adm8BKkaBZSXp6nwbqUQTMqYVObBsvgQGJmW6Krll89btzZ_6pVRL2943oH9Ps8lUq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvUXiYiCYJfxz8sOTGLXZG1D9iZulkBImC0duRwp9JmA&oe=69AD5E9F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nq0IAjJgMJwQ7kNvwF90sQZ&_nc_oc=AdmGvtIJA2pn9NkvhWy8L_-7QlkcTjEvikGBG3azlvap5ddIDvY07XDDxMmaJXRvtIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQb04ewWrI_uYnK3WUcYltIjT_0zrkGfeq_PHRoQuOeg&oe=69AD537F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRsQFsgODTIQ7kNvwHwWv1o&_nc_oc=AdlqviycDwNTKpwGBeTA8AGxs0E_t1hyiqpziCEdBV3t-AOSUrQxxINCZjXQp9AoVBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDjQoSIwKqh42o4CYiMwhGsFXGvFN9iImRfPEKd4v6Cg&oe=69AD590F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv4JPi8-TyoQ7kNvwFjkPK2&_nc_oc=AdkCsb9DN0dVqkrolSnD3bR2CxFv6rIIYzxc4G96I9ghwNzOIHJineNSnhmOTPJ3yWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdphP56se4I1dJpsEiFhahyRtRxlMl9_9rlsMJAzUe_g&oe=69AD835A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_im
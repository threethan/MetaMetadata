092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Liiqg_K2cQ7kNvwFMkHgh&_nc_oc=AdqEA3ry5kHVk3Ftr8VYm5HTpfOXi6sSEm3DV3rhx830JawFT_qSkeNjGvpbJA8k4KU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DsCjoKkZVGMopvkhPjX2QU3k5RZXwpdZ4en8Wxt-hxA&oe=6A171276"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HooihjS44gQ7kNvwHfP7_D&_nc_oc=Ado0nCJveu5AV0uuWLJjJYi6QA2-LTy7Hul0-kjDGbiHBrqbhYV0pSrjdiRWfcsxCSk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r5RzuNTCRchoy5XFfTwIaqcZ9xuo45bEWdblBOMUIFg&oe=6A170EDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od5TCrNxmJAQ7kNvwGD1G5y&_nc_oc=AdrAAeQFA5T-lENt3s0U-VSotoV1amKkh0VbQPq-F9CK3LsyVVvMmGN9lbmE6tfjR8A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TaL4BFM4n7BDGUQbwpLgkPU9kB2CjVb_hZ5Ci-znEBQ&oe=6A1703BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLVe5M9sBhsQ7kNvwFL2398&_nc_oc=Adq1tQyWUfXJTLGsZR8Kif5aopdttTAtvstKcmATrcjVmFuhDnzjG4HkAPeI4p8fg-0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z_9caCdTnspONDyNMrZbwDZyOIIP9IzHA3aDM6JMs5w&oe=6A17094F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2EBwCnWsh4Q7kNvwEJDBTC&_nc_oc=Adqgrk17-Sq5M-4VcbfrDiZDrMDLa4ND3foOdcpxXL7sXYSPxs2lA_FZjJE66RK5PNg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NqC8b0MoQQb_6pnLc4bl8NvVDfpcEuEulA22KEDsHtA&oe=6A16FB5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
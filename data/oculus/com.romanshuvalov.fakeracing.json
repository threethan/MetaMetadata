659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkyLlfFlKmcQ7kNvwG42WjV&_nc_oc=AdlKahYCnxH24tDpMJSn9HzKVA7dVZIuEDK1iqgX1b4ynB80OtqgWWpsuHURr0V_7bU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsehO0-USL0Rc75EtOFithw_LmOdIDrLZa8OogvPschug&oe=69A81C36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFzu9QcdpmsQ7kNvwGdqJIL&_nc_oc=AdljaHTtx3RX2NiCeGlTjpxes85FzZz_-HBVGYagGq_aBni-l0ML1jrNA1Z11GAM20s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvOI5tuUCeqXoGC96hBcZBtfMlyZVaTla44y6MbDWbS5g&oe=69A8189F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aajPCCfIPlEQ7kNvwG9fKUM&_nc_oc=AdlQhhJE7WoPHyh5LD2xLzZZ0Hq3bOT15nmimgO_CiCAfA3rhX2vEZ2fUmrlWfwl3qo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afshpc-EQLLS8ye_C2hlCukhUwKkuSKWMEQ5NFEQQ9MZDw&oe=69A80D7F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab823_AcUF8Q7kNvwEZsMGk&_nc_oc=AdlTbhqAOR1mTwrSwlbvsZYdtHtAVQutDIl4qcoi4oVqUqGVfVWGzpNUlDY5WNqDqKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfukPGMK7LPizM5lDFaZEGa7ON9Yv6SGrrZIVquvmCEWHQ&oe=69A8130F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLjFP7C15vMQ7kNvwEBsl69&_nc_oc=AdkXhkCLebNhcims1eATcIrk_-FTLkPx-Hg4sFpzlXIHfQ8UNa34muuziWHgH5WdYzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgVGCtZFFVYLd5-cJenYxNEpqDCMdQx0rLc5Lq8zYoxw&oe=69A83D5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_im
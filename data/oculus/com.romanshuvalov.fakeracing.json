092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26daPy6C2nAQ7kNvwG-mGlu&_nc_oc=AdqWL9cyqKAWy4R_omIdTiVts8doAyFSIbrsFuP7UHsjtSo3_Qd4i7tH3bDoCbP3BYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TH8a4pUSHuy7osK-n1jnCrQjOLGHwrfqDkC_6k6kfxA&oe=6A204CF6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHPHvkDEXVcQ7kNvwFRxOO7&_nc_oc=Adp9pCdAy9cjQ_Ef6BUUNUPgUCqivcJ0qlXrNyQV_oFepi_8AzBf_skc0UeFNRqPCfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ZnpDzeYJJZ40Wsg_jspY9-nIuooV7jufXmDH50Ru3A&oe=6A20495F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNiLAGiD904Q7kNvwFFTna7&_nc_oc=AdoGpVuUZHg49Q5pM630FY4hp1OKJusPCLw3q22PYAkY_Er5NQSDx2-m5i81XKS9AiM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tJyfRJbvmqWXGRK-2DKtEnhOxPEOVNX-fNt_t7i_VfA&oe=6A203E3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGFeN5ogSlYQ7kNvwF0-UG_&_nc_oc=AdpoeNxNrAq6z0Q0Md1vsBsKBLt9qR97CfpVPVh0_F2edDIsDFNPgYzcP72TfNmvAno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o5BFkSirEnc0pPZTNcb1w2rMsQCy2vItzqnqjrFMS5A&oe=6A2043CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkNh5yvFpsYQ7kNvwG39yaC&_nc_oc=AdpCIOPXXv6RfhIWN3vcq5BoBjo5TjABOA4PIL7oAZ3BB00TPfm22ytcrh3_we5xgEQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qoGRuTU8KDVsDer5EVLiYa9v0rUJOZB0f_KTnMdAFBQ&oe=6A2035DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
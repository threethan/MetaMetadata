092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PPJMrfRzpAQ7kNvwG3ghKo&_nc_oc=AdrYtTrlNwkjjlzarcU-N12yNr5bJr-M4jKO5zN5JCKwjlLiSIpcSTr0NH7PshYdQGk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXl7vud7aPx9nW2rTe-fliS1p9mlHlMe7ij_S0BKeElA&oe=6AC90CF6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDFFdXr30NgQ7kNvwG_SbBI&_nc_oc=AdpB4Xpc-uf-6lWbRrZkkiwHKGJx058FnGnE2tAvEoRkkGWypq_5XU6ECP6UG7wLA7k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7BNwI-wrsJYvPmkZyIxfe582QMOdHbQabZcD-IqMQQw&oe=6AC9095F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGJFxSH3sfIQ7kNvwG3Uev8&_nc_oc=AdqiALRnFYb4U2NgtY56YQflozfFtxGigP6-9AmcD8wd888m9o1XgEbiBlKblpndijg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7jpSC4e24pvpGBgbwWIMZz3zmwMs2p8_uXSpVZ5sSvg&oe=6AC8FE3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PxIjRIcdBgQ7kNvwFc3lYt&_nc_oc=AdpitAZTbkXgMeiULgMWidH0HSK-cBsWq00BCdy6VyIR_zKZqruqD2pt_Z7_gMh9p3U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHz_yW2LvdyfSwtKyvIvzMmulhvWPFqU0_jtcflx_OQw&oe=6AC903CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PqHrVqqn0EQ7kNvwHrIYh7&_nc_oc=Adql6GbmNpmlxJnKtu-QboacfUCBfMS8yM1TbCcQIanbFunY06NrNKiHtp-JyOoWD2U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiIARz5_UHYLW4_apxrMlgJA6E_UtbfwyjAyKxl3-SXw&oe=6AC8F5DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
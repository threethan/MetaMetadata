092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEek-A7lR0cQ7kNvwGv24Yt&_nc_oc=AdpX5ZrdcOx0zKWCfZ9apwUxz0lYgY5Cw4GAqpqL02pHkofUh8mCsJ_3ngq1RvtPGL8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BZNUpuWf9izPihYZlGGpMJRNoZBUr8athuI71NQrc6g&oe=6A0C8676"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hLcgnP1MXQQ7kNvwG9ukKK&_nc_oc=AdoLMK_GPOdW7VegSqoh2DwlBfggOnaV_5q7RYqxuuv_luUjOgyniveT-AO4KH0Yckk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QXJWFLxoJ6fI_EAvbZF7SZbwLqNcziIOc2ugV01lB-A&oe=6A0C82DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0K_f3c7J9YQ7kNvwE8uz-x&_nc_oc=AdolwS9rQH9MNyHYMelr84eWcW1lXDpiI4j8M9x9rQK6lITCG8amTLE2KvvWY466AsU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66xsFbW9Lwi7g5j1P_Au4WAld2nz1YG1rnw_eMcviW5Q&oe=6A0C77BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FB2F8_ddc1kQ7kNvwG8p0jt&_nc_oc=AdrNL0evf2R9vc--GZ_iBQgW-lHB2XZuCjfvI77VMFyt4yhkaRK8CffYvIV4NW1zYUU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SvMBvLvpM_rGYaNPQyXB3BTnfFM00u2C7bWdVqZj90w&oe=6A0C7D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGyNgU2JZnAQ7kNvwHXmVxJ&_nc_oc=AdqJw4ev_PlNvEL-l4zX4fGzfaWod5kU33SWu8BzH4g5JtAo7mtQxKM9c7Y4A4d5lkE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OoR5j_dcIvYfKeESl-bHyky_78mJ-Durxv1rHcyagnQ&oe=6A0C6F5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
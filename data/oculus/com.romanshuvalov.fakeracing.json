092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zstsWH0jfvgQ7kNvwEhlrPz&_nc_oc=AdqbDq9vRaJoZmJOgTF6Id2m5JPDP5YNa3c5GNa2ZR7p_AexopIx6Fq2mV0ZUBDfwTE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2pIwaXta-DBuLU6kAvCHTHsdxX7xP2z-Lhklk-pMC1A&oe=6AD0F5F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnUhhdqCBacQ7kNvwHPPo7V&_nc_oc=Adp0WPqfOd3Rk0WWcIX4V5k1zBP6F3f9VV-JTnOfarHbatufM7enSLoxurxpN5vYYk8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNtJUkZ75i22IctMQ836poyrwXtutayXhoAysyE_4AIQ&oe=6AD0F25F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbtvhkPYRp0Q7kNvwGD6og5&_nc_oc=Ado46fCq7mpwmgpu6QS785A7yBBMSEBH2ZAufDJ3QGRgMOcvnmwnQF1Z4aveih4nTrI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5gj8UUJK-S0hhMp6poZqzSYWryg519n_kfP7DuZeKGQ&oe=6AD0E73F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFKmxf78ujgQ7kNvwGPlNyo&_nc_oc=AdrNbD0s7xkxKEFz5nH4UGYxLF1VzFks2mopH-51eroTmXyG1befNtiUnqmJgOfA9sE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZEtpV9gFoxoSw_QofH1Qb1vERB3rAEygxvKELwA5sUA&oe=6AD0ECCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33keVsgHRtoQ7kNvwEUcC1c&_nc_oc=AdocjQ_WqPol7F-_Q6lJYAmZFjMxsIbI83JZ_sdTV6d9U3IVGhCL4fZZOEM7qSY1SyU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr9MjXT0cVrmlwfB-oL3Eass7lEO_OVvDfqzpaVm-fZg&oe=6AD0DEDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
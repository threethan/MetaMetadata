092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9715TnymuUQ7kNvwEvH5nq&_nc_oc=AdohjaCLiU3X8sRMmn04nMz5XPMLaSKX7Q__I0OHetkne1rly_4DLn02587O5NFcV88&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqKm3ItLZRQuNix9EufIHaAXqEVU-hOexoqcD3lqh8Aw&oe=6AC7BB76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDFFdXr30NgQ7kNvwHFqC3A&_nc_oc=Adpoi7XUdzGI1A9zlpjjB1r8SqdkMbLo4DO3ymRxocew-2nwqNepso0z7fthr8O27VQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsSrncpUq8L4fQukVX8j8uWiZ-Tah-TsClyOCGvF7azQ&oe=6AC7B7DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGJFxSH3sfIQ7kNvwG8n7zu&_nc_oc=AdoLSCIWp3OANudRF9lmsYzi5UtT2EZBkufGmjegLsTHzPCYsjD4ewQQj40p1uDthWE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrFutX8dbd1LSOte00uEcousNUP8A_s4mmDnreO0KHBQ&oe=6AC7ACBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PxIjRIcdBgQ7kNvwFZw8sZ&_nc_oc=AdrLfEQq5yOg_q3qYbofxLX7Gw3JMa70joCK-B_l9g8WgBXsMRbGzeimu2S79DFrvFU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORXTiwlmy_hczJxGC8jabtSiKUlgb266tV8q_LFg-jvQ&oe=6AC7B24F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PqHrVqqn0EQ7kNvwG-krVm&_nc_oc=AdrycxYG6JGOpvIDAo-Lzy8xk95UoXUd1o-ATowg9EanRODopvUL6jWVz0G0_XYo5iM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEsDNkp0Nin3rFg7exAVt9TPZqy6naW7OZGzJYADeLcQ&oe=6AC7A45A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAZ1B9BdoGIQ7kNvwEiaQOk&_nc_oc=AdqV8TUMA-fjtr2vmeN8XLx5xIZ8U1J7tL-jxtYix1EhR2_qGuScM_32bq_kODkOFA4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysZQ2vUBrPz-EKnLQiEhiprq-OjHithaikHXwp2Mox5g&oe=69C128B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ4cCEW4NjkQ7kNvwGdja8x&_nc_oc=Ado88l4OFkHbTplCoT3p3MtaPrXewp-y79fxFYuKEduzKFWvNgeMxTQxYkRkeC_28qM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS6UYxgzUPTXaZBkG32O_qa8EKlSBllmy5nx8TgY7P5w&oe=69C1251F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNG-OL8JEm0Q7kNvwFd3Yzr&_nc_oc=AdpG-M7DOPqGhc-hUBN69Px_Cdhd1NSb931BfbOEHwRz4YVMIixDXTyDVpfdWxPW6u8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwczNB7tDWPXaSOj3_hkMaH5DYxYP-BCw3luFVUa3Jt4Q&oe=69C1523F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPNzZY5mBFQQ7kNvwGVorD8&_nc_oc=Adqd3jkAul5Z9yNb_KduXFsnxM79u2r66BwqArwMfTq_oikW4-VbmKIdsig4WXupYMc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMzoAIeaNgtJPhchx8L6-_YorxLhUmS_yB6GMoba6l0Q&oe=69C11F8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL1DYZS-fqYQ7kNvwGGoO3t&_nc_oc=AdrEXNsnbM3LWwOEQzar9PLxj7xkX4H6BsmedJymaIuHv4ANIYKAVla9KbQKw5VcaBs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2QTNUw-WrjYosL5CRmd1q1FJs1-nGKdtjZlsgUD1Fuw&oe=69C149DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_im
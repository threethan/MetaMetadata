092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnsXoSpq-R4Q7kNvwGL4eIz&_nc_oc=Adq-j4zlDNldygq8nVUWGs75BAMDFbDXnXBt1Y2baAAnGqscctucOMYfBb6cJ0V_dbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcbFqL0j6_Dal4gM7ewR0BsN85d2Qtw8X0Y6qNaOSNbQ&oe=6A984576"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CVSa1BlpRcQ7kNvwGDx8_U&_nc_oc=AdroHsK6Eexb_01MbZHU4KdQILfedVTDab8K2zxAVkqITJdlRqmp307gZl5RLS34Drw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkxM5Jn2GbAAdWT1VcLHn__ezm-kaPhK89mbybg6aWjg&oe=6A9841DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vk0ClWGtqAQ7kNvwFGF8rv&_nc_oc=AdqWsJ_xXF8LaxskIVTkxQbRHBzq9iT8Gzy3gIbBVjEa22htuDtSVEQZozStw5bE7y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPZX0TNCuBbFzjeTovJfOzm8SRnDUnK1bSaNesGQHvhw&oe=6A9836BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOaB2wGVMC0Q7kNvwE1dsHR&_nc_oc=AdpHIF-VNxCDLpyeyeSdeprmv9hlV-I-jjzF__PeAnUWDrZIbkxTV7bdz7br1uMFToA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvAGI1tfoXaPj3t5S7O-mUrPXsd1v_fyPlCIj6PawiHQ&oe=6A983C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhMEl8J0EFsQ7kNvwHhW7gp&_nc_oc=AdoJHCS-ladf_xjt-MvCw8Yu_jvTWBuH7Ol0sWdtJF8FEmDpoDnNV2UE0D67gE7rQzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4yXqB4T4TQfdp_jhDqiJ4eai0TIgB_IEyMxSy9HO5sQ&oe=6A98669A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
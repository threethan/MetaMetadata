092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgVkVaGjSO4Q7kNvwHiebFY&_nc_oc=Adqr28Qtp2CSOEfXT6W3AVO8exOett3oBeLiEVzrB1Ty2xkbZx78X0ExlkQtx-6bc7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMvhElJqISNOWKOEmc_e1wqqt2VWihPzGWXs6t23YbBw&oe=6AEA0276"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkA5jpn1F94Q7kNvwEXM8BV&_nc_oc=AdobXVj06FWa3BXdr-aYYhuVD_OTCBdiCHnuwYqB_2G3ZrVVJZX53FgsxdRfNsN1ORU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZdCSMJRYatssPF_muOwKDk9OkGB2n9sk-LJP_o_MT0w&oe=6AE9FEDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUBOsoLNsnUQ7kNvwFeUoi-&_nc_oc=Ado_n3fLKNTcxS4tHVNBy-cbxyO3rqKMZm-8t6oyqHSrdEwlcCk2HdAiUJdqhaeJMY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-OFBjru6fA5KlG0qQQaWPO-uiU23d3FKXZ8Ron-vKqg&oe=6AE9F3BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXgIHMJNAwsQ7kNvwFI7LoS&_nc_oc=AdoeoDAYeAPAeuBXeA0oYIe5W_73_PgO15uvV8MYqeD5yBE0V1z5n6Y5x-6gt_NiIw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpyOdf_jWyuMYpqK64EXxjd9GSRroi6BAX6gJCL1zxog&oe=6AE9F94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru7HddaUDK0Q7kNvwFSXDOe&_nc_oc=Adq0QM-b_3RfbV4IDBBjmjXoisOq76N6HsKzbT9q9TDQrASHxyobOqBHQGOwoSj-MSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Q0o2UnYazSIK4VW0NDjt0dvQIVfeTXYdF6-SvnsDKQ&oe=6AE9EB5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
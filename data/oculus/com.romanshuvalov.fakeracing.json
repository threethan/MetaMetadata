092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLx_IhwfdiIQ7kNvwFZFZ0u&_nc_oc=Adq8ZsoEJ2qTdSPhVCVvsPiFAQKTOookBawma1KxFMPwufqfDrnx-B_X9wPs69yEAvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85vOokR8DWazH0k1Db_KM5CBGpE0-EPv3X6qV8JqgeLA&oe=6A3FF0F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80H561fle5wQ7kNvwFw8FPB&_nc_oc=Adrz-B1xL5u3txhAHdOL2yxppE-LxaBQKs1wwYxzhcyrNqXpwVYa0RbdxeTUiDU7KLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oOj2a6ZB1vumBoEVZy3PHMng87Qi_GM5GXM8kq1dOaA&oe=6A3FED5F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvwix503GKQQ7kNvwFre2Bh&_nc_oc=Adq8cVjDohZSt-0D-li9UFsa1xN7er4aSLJmNhnL1eYM1u4PmZFoLEIbB5PXWrfjMOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RB_SDodmA_kFHa-6fJZEgXq0Y7u-yDdwPaLZTart3hQ&oe=6A3FE23F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2dv4nQ6CpoQ7kNvwGPymSW&_nc_oc=Adr3St64QI-6_-eeWtO3p3K8tCYE2xAvsc9u9bTkZCxfub09tH0b7VLU5TziGzOcy1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mgQZ0epxobcSvu1G7T6rV6aU_zRl3j-Kthnbys3rOfA&oe=6A3FE7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHYXkdvkmhQQ7kNvwGx1DKQ&_nc_oc=AdpHb-1ZrMuKiJFXNuxx33cEkI38QAA4qQwBovNCcVz09hwzeVFXps0tM2jxpjQIHSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jG-od1atwAS2NazfuPUzU7NFx2s5p5hg9G-hKqfHPbQ&oe=6A3FD9DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
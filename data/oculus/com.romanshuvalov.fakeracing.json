092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjNnz_R8aMQ7kNvwHGBwox&_nc_oc=Adoo_2bZkouJZh_5WJQdNsTJ6KddCyU_y1j9A_2h_j0TyrxtgT2YmfEv6oBtfHhC2JY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW5PyJweebjkfdI1GiKN8RbPGnwWW8kGpPgwvx6wkmrw&oe=6A6C8BB6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pW6hxRta6cQ7kNvwHBVzUt&_nc_oc=AdrxFvjU5H-zPVItgXKTagPH8xk-pvEgKfdCi55Gkb_t5Z_tC4jdzyq_4KjSrlIijBg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4e1Jg-JzljwDmv5dtSJrDyJl6c2wsDkau-VNoB-kFfg&oe=6A6CC05F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gM3LSGMp6EQ7kNvwFa_QQY&_nc_oc=Adq4Szu-TAD7OX6gV1wwrzP22lUu5HRhaOcYDqjQCMVlQBcOWQ2iDnGsU7cNi0IpirA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1IXE-FkcuK1uNOdmJlupfdoOkh8k1Gvy9rcVGfRUZdQ&oe=6A6CB53F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVADsuCCncUQ7kNvwGjcSXK&_nc_oc=AdqToZKq4j9PTZBM2OvC1T5enaToahA3DGgU4xbmbzTvwCavh9MTOSoFGIapGUBy2uI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE6zHBwuHolRw_kTJBT2APlGuomqWws2Y_1nO_f8NJNA&oe=6A6CBACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNaPGjfyPawQ7kNvwEKHCBI&_nc_oc=AdoNUofUcQU6X40jUwVbquU8JRp2eTLYEDw6TZxmcHuNIp_4QE2E1ceaa5PG-q9OvXo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNQRRxSpPXVS9YxwvGo0A9x7EYXSy-OvdJTdW8hBO11g&oe=6A6CACDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
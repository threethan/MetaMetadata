092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_9ib1tDHgAQ7kNvwE1nfbb&_nc_oc=Adr6B0Q3qNHheQ573GHVK4ZL-H56UsptDdy8JgBFTVAGIqjj8ofkFsaOBD7Osi9XQlQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yi9vhdd7rj0dDOB8giegN2Hg8MMR99ezECUgjjsh6JA&oe=6A1B06F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg-LuXhTnMQQ7kNvwGXJLKK&_nc_oc=Adp7GSnNw_c_pxu7rVw9qYXHulbszP919Okfe_76rozQU8U9ku8m3-0sp5CPmJa6Z2E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60YM9ClO-GEI8ulSBh3Hb4oJWt5LTWfS0tPVd5bVWWLQ&oe=6A1B035F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKa-5Tq-RFoQ7kNvwFBOgjn&_nc_oc=AdqdS8v5oDZNCqSYa1oXUZreJnuZ4gOSSF7UKMSO-JnkJQvhcBpe1uoLIVXg_duGC5Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YO0L9cZ476HoqGsAnE4q0UOQZQLDewnPaxqzELL92Zw&oe=6A1AF83F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL2dF32vJ20Q7kNvwFDq482&_nc_oc=AdokCF88ciMu8rM76MLnW59rmP1E4P3OA8NWSqG045o7H6x4G2VCrkV6ZHJrvFSj32g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PP8uf-v4cxgqyDtAwcYF7dDRV1_aVXWrkBoAWJLOCIQ&oe=6A1AFDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUj-R_Vw1MAQ7kNvwE3kwEa&_nc_oc=Adq5S9lhwM7wO31fMgio-5Jb2cxveWRRho2l3wr3fiarGUtkr9LkY5F4ydwBjQAb2Jw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g25SczMumAl4m7LfDBReeeKew70Jfr79xdqJVzhlY4g&oe=6A1AEFDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
371507_1092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxIhasrzsrYQ7kNvwFxHSc4&_nc_oc=AdplISwzyhin23T0PiXCYMYQMyc8ZBwXFA_yW5WlDY9GXARBKoHz8SNFrkmMpouNkmY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0rvUJkn3XzbQG795fPUL0_idVSMPDj0xLSry4C9du-g&oe=6A8ED2B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYtYj9YoaZsQ7kNvwG_ETJk&_nc_oc=Adqw4GX9v-Db_1s3bwDlejls0O-g1NjucDkYLFAeTvmfdOuso7X5IAg7xwve5EIKkjU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKBlN52Jk4_xTyNFAcmnrpgVgd-9oJNRVHMl63RqmDWQ&oe=6A8ECF1F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LETES2sRUT8Q7kNvwEZARlq&_nc_oc=Adq82YNpom15L0OHxbZBlsgAl6nH1XBVZ4LAnjN2rPV-6SDGONaAwhQgrEKzR0sTfF0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLeSnRmyQBGx29nq87UycXLWLxMfd20uvIIVoiYEDw-g&oe=6A8EC3FF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU5LnwnoRasQ7kNvwGS8u11&_nc_oc=Adphy8jgr_4f4wuvt7569Opf_fSMaILhb2CQQCB7i8GJR97tWgw_vxVtEekNYIwMN3E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWBECJgrBEJjKC7DqTemZ3JNZKgy4serryhKtM7TZV8A&oe=6A8EC98F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNQvwrwdM6QQ7kNvwFa_ADU&_nc_oc=Ado-DhhuAhCilTNZbxVJT2UAYZIUa8rtB8b5teeyqxsNOn30UIVidcnIsQRYJ15lfU4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5tjm33zT9RDwhw5Al4uuZ98ufCRBf6bYNRxjn5fsMJA&oe=6A8EBB9A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
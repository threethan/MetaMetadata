25CO&_nc_oc=Adk8g0fi-H6h-bVQhz2N-bebY4qGtCdIseHUKB9yAmu0Negi0vy91VmdmGwfa8BqyCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsRUkif6DPus-HvNlJVb5IbqJLiw9i8dFk_3cJALtlDAg&oe=69A427B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWS5Q92TSlwQ7kNvwGRECWh&_nc_oc=AdmrdeZij_4vVS-OXtpvNayAf08jEzqTOQT8DGxP28TMBG_9nRhStsgvMvniGeWpfcM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftkHEDs6ri4-tKzTmUWo4AiVPEwZFetI-4-BuWp0hVPTA&oe=69A4241F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1mPWiU7eXoQ7kNvwH9lmRF&_nc_oc=AdmV-NTHKZVLUi_SC4tjRS9qfcHzo6Q2yMNxhdIKIN3lHkRpPlZwmov7U_2-cT0RthY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvs9xi-7f3XOVdw5f5vgUIm1zvulxlDgZ3kjb4MMNTe5A&oe=69A4513F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3n-SDRf3dAQ7kNvwGL-CFU&_nc_oc=AdlgjQY7KvnaZslC1FRQe4RNtPKXbesKBH4bQTUHz0MQjoIAiqvZKCCRn4gh9YjhE4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfusGsh1UdwjRCSL8e9ZYNwk9Asro30dYAUreS0uQ9cQ3Q&oe=69A41E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiNZDiA_YB0Q7kNvwHwfRXu&_nc_oc=AdmIeJr2YNgu_UWPY-m08SVNnSDHvA2b6NsQc5Yle6S27AYeZiCv1EZphfLOl5UZFk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsVKfVeVGyNcYpx_13o87Ytxv36RtWYB0z_S5YVEiRsNg&oe=69A448DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294245_186479453662653_2289662199946431919_n.png
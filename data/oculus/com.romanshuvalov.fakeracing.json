092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpZYRdmK9iwQ7kNvwEdv17y&_nc_oc=AdqmwkVT3qYHnVfoNIcmu5goLnyy42OFK4ucD1Pzend88NogP0omcetmvTwjyE-Sx8M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NoCkgN5WQ2T8xYnu_lTPmKNWVGDlt0pzEbzirZNsFww&oe=6A2AD8F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkiV_WgxI8wQ7kNvwH5fi4s&_nc_oc=AdrtNo-GSQ9Qx-5de00oovXGXb9IZwmWL0o21ycl7bkrYtglxDAG-lw5Yw8-t1VLX4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lbGBhiyKekd0T0U2Wwjj4BWBCNW4PcbR-4sTSEzZjfw&oe=6A2AD55F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCeFT87LqzIQ7kNvwHhwr92&_nc_oc=AdpcTaNhFnMSDc0kGRpk8DZXsBOJLSKM5yseVh8GhfV0zC_30wL2aNxn7xQWfTpV9Lo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XFKxZffk26NAFqg5qso4bA5PzTn-FodTYgnj1hcVsCQ&oe=6A2ACA3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyzQGmHu60YQ7kNvwF8I9VO&_nc_oc=AdqGGQvTJDO25RUFZ6Uyttxe3QEfMSTqCuqNVXzuRAZFMQ0k_14s1LJCN4YdOtCNZ8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oxp4b9B_iiQ8VnRXgC__IfsqMA_f61ZiYDETKbi2w2Q&oe=6A2ACFCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFy1Hpd3M0oQ7kNvwFMdWT1&_nc_oc=AdqTD2WD0-B7s3yiZPHGppojyrhnXXgwDP3j_0sA1-KqhKqY3wQhrdcC_NJRORVHS8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EYGTNraGZ8Jwx_gWoN38ykF1fOMQFHzHBdDB-mo1xpg&oe=6A2AC1DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
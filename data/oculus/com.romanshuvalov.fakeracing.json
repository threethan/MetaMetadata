092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnT0xepDNlYQ7kNvwGyeOIM&_nc_oc=AdpSH9SjRp0HiavkaOQffOeJ2jP6Yp9CHwCpJZrlMjEohvRiYv_T_loguRyoUIa5Vc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8Sis2aPJ-bT00H4LoNy-l-JpWS8i_E-Xsp7hXuYIOGw&oe=6AF48E76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeciiIQLoGMQ7kNvwGsB5zB&_nc_oc=AdqttvYT9r7kIXaXxncaW0tLtCZeoA8ryXAy4I3u5sRhPkykvVmW38Ue5mjOdZxWrz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTyiHzUw1Hvxf0UTLmCNyjqYhGCgLgwr-Aod3sWLWG_Q&oe=6AF48ADF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8-n3AltNacQ7kNvwFBs1rZ&_nc_oc=AdpP5xDOZPDwpSyiIZGImGhwDbdafnvFCELCzNg9hybV1-pOAYmkSI1PpmgAAnL7ORQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWUhM0MSuOePUu9QZmkSoojCSiIMssTGEwHPuuVmqcug&oe=6AF47FBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGg5X1CSF1UQ7kNvwGG8bps&_nc_oc=Adoc_zlZ4PSgowGNjVktr24NFIwMsKN_ukp8JfShPlNkoYoqDa4wiXTdihXHU-phbu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrbRqA6gD-ivcBpVKxWhcRPpsUqnfEDyChtK9SIWVg-g&oe=6AF4854F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpazinIylNEQ7kNvwHUCVlv&_nc_oc=AdoD9aCPKoZevhr1C0mGd4p9JBuYZwMnsjj_gA7SobCkZ2gw-aU1pSf1C2vLVVjyzHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC_wrMc351wwzJ2VOQKaPP8vMZk_BSZovWLtvaqz0FRw&oe=6AF4775A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
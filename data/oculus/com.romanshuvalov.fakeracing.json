092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvUZ8uGX9gIQ7kNvwE9GDI1&_nc_oc=AdpqyH7zZObMyRBlYpF4r1xp73Vekc1S9GjfdbI53LrS6gacgMZtgHwmCKu3q0h2D_w&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Eft2k5UKthWnTjruP_kzPrfeuGbm89FTAIYk1FH2-TA&oe=6A09E376"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hLcgnP1MXQQ7kNvwGtd-d_&_nc_oc=AdqUzTT4fx_QVMFsE0AXpuwUh08KVwZg2__1U4Piz1saVRE3uz3KgJA0CR3wJrxT4rU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lv9VHOOQHTZ6YBq8pPaBEFLwSzaZhmvcN7bMYvVs8zg&oe=6A09DFDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgXDmzLSR2UQ7kNvwFNPUw_&_nc_oc=AdqetLSo9UktJIy3P292RAQ3QSRU5hwAO0iu4s5eSNLKsPhYOyHEBjO2X3aeaqxGTrg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k7L3AEx-wVrDJy1r1nClurhz6PRwXJ7wxza2cZRn4ZA&oe=6A09D4BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FB2F8_ddc1kQ7kNvwF0OEl4&_nc_oc=AdoxyBtATLZDCrbC0e8gXFZxCyLKBFErc4jNVtdjAtW0wY_udBAt4T0PS4tjKCce0Vs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63GX-2z5dAVNAIjFkV-TAPDWPh2Lojg2lAi8_K-j8kNQ&oe=6A09DA4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Emto7Sk0dgMQ7kNvwH9nJ1M&_nc_oc=Adr3jyzwqPNyn7kT62MdSfRBSf9StNfmf_U3kuwJuhJRVL0523SNYEBYJJG8bfYNjJw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kdm9PG80YdJJq6wRVyYbsRDVif-Mz6m-ZrM73LPXdLQ&oe=6A09CC5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
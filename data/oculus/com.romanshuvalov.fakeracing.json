092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjTBiVWT_h4Q7kNvwFswOJL&_nc_oc=AdqWfu3g0mId--2UeEwHkMXk45ZgEh2gsH9oqomv3HzkCxb4UueLa3ybn3BZUAfE_HA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAjvbWMELQldYJKI97E5xeK_g7TNMEFb0fviCMoWSqww&oe=6A4E7176"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTQxVFMv_U0Q7kNvwHXeJlf&_nc_oc=Adq12GcUNArS1slCObus-O2x9BEU-76-XCYHOj0O3wgAJ-vHeP5oUtF3uKaI0GMjuiw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuV8vwxZasvxwTMq57ZuYxgAH7VCZO-qrxnHK_uaLCtg&oe=6A4E6DDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-hrKC2pmfAQ7kNvwFel4ti&_nc_oc=AdpPMXjWak5ybloca58v3dKKFGZLDav-rJC5T5j2lqqIlj6Y0FMLVnxFEuH0zhmrGag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsNIQ-MJbyfLNPmo5EnmtXbouUB5MmUsGlznSeCRJe6A&oe=6A4E62BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEovvQ_LaioQ7kNvwGnOW5k&_nc_oc=AdqmHcXPUMBGorP9KC3ZVAvnyu6SUK_lnQJw8-4d947OmZTFwIhBuYjyWn8MG2qcTgk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmZThPJp5op7A5rUvcM_xGgjIcqsQiwR6JEIr9Jgy4Kg&oe=6A4E684F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shQukt7MP-MQ7kNvwG6Wllw&_nc_oc=AdpVCw-mRRTPbJDRLaIwqnKRdEZSuV8ApKKfsRFgzlVTEf5RfR-n6Q3cvOmiSS-bnd8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZJ-zrZHkqURtaD0Gus8cdrg6qCfelah0AvaOn06blNg&oe=6A4E5A5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
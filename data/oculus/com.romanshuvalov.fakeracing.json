371507_1092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiIzEak7gysQ7kNvwEwaG4k&_nc_oc=AdoZMuP10hsYlJeGPlmoEDe6ynq9nAdbAYiw48XI2J1FMMc9gQueCcUpPcgKtg4IPMY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--CglGSB0oavhS4xO7eicS-xHdT8jtIuFRkThyUuH_9Q&oe=6A468876"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykUYtCj6IPUQ7kNvwHvLdtq&_nc_oc=AdpePUqnP67W3FCOHFdEeypbc8bflUxnLEzGgpgFtLR9zT9cgKul4uld8tZT5gfMhnw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A8TPkshIZq1l-mYcsmpyjFIhViLXJ2QPvffkraL4mjA&oe=6A4684DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w8v82q1JK8Q7kNvwF4lQn9&_nc_oc=AdqlWdsEIcTwmbM2q8K8ZkGxWSIHpggzMCKV0Z8imN9l1mfDuo5MbrMwvxUr3c4E6EE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93jXIKfwo7ftNl8VyrWXU8h_Z75BBL5fVQOjhYnE-TPQ&oe=6A4679BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RbJ1W4l3YQQ7kNvwE61Oy9&_nc_oc=AdqSoGHM73FVfmdoiat5Xzijkh1ZNsR_7SadjD0_Is8ZOVKjg2J1wQnJqEshC2HhD8s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pPhw2wL9vXa1MefwfCz25WsXorKEGZfdHCwe81Nkq6A&oe=6A467F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sym5i0tnqfQQ7kNvwER_8xt&_nc_oc=Adrs3GVi6KwZKXaDQhn0kNqSOQuhi8yNzkZcvuZanvfq6SWSQzrGoehbj5vvU8IGlAQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WIYu48rXGdtbOgCGUjhGwOL2bd4jZtUX2lPmtM4CXJA&oe=6A46715A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Liiqg_K2cQ7kNvwHBu7VE&_nc_oc=AdrionSfh5SDVmUqfryE3787ewAN2eEWWZjEl9k5zDSqJ_gn3pygFYihWIDUQ7-vejc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vt-qtXwH3Su5a7Yidq5wpxcc2Dgd1fhwK9S-pqXLBxQ&oe=6A1863F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HooihjS44gQ7kNvwGUTam0&_nc_oc=AdrvMW_Sk_biBtNyDNgHcfBe7KSRxYJObk3Xw4kFw3aw122KKNz79eHZShPDox-YhJ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nHwgWB5nUG2s0MCg9TrmXqhz4GboxJonM8msOVoTR6Q&oe=6A18605F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKa-5Tq-RFoQ7kNvwEcUlne&_nc_oc=Adp-80SQN7c2DqJTUu5BOVNqcCEppkfZXZ6XR0P5Eomo93bArwL0UpHsH7MotttK0KM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cqCK9a_ZPerhDEyBjuB-PK7y9AUWjZA46AkdGn2vH6A&oe=6A18553F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLVe5M9sBhsQ7kNvwH2BOWT&_nc_oc=AdoW2irY94-ycC-Q72t61nhJt_NUTm3mXwS5JOBbTq48ZHGPNIwt310UpZCxkVM6NrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xzNxppg4wMvequVljpLhq08WvwAb0xKfjJY9xKEj4iw&oe=6A185ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUj-R_Vw1MAQ7kNvwEESfHu&_nc_oc=Adr_qkXPRNRRsClVbVZdYg1NGce-ZXNj2oc1b7nXoMMp93pXTcinarPXPAVkDmN4AGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gxC8xW9EvdnqCsfxn3QQRPSXoDSQ4oMV2QFAeHbaedg&oe=6A184CDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
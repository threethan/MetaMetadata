092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnsXoSpq-R4Q7kNvwH49ElG&_nc_oc=AdrikpcH8cAD2kPQM31ZmpDC8D2Vlwr3tmOJIPISQiK_4Gk4Qs-7RZnIkEDTnH9PWnk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT-gCM1XINIsZ9k3P6PX-JgZB7PW0Sizr4CmSOHJWeHw&oe=6A972C36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQUnLISbUmEQ7kNvwEjdcAi&_nc_oc=AdoYwA8J65UV7VK3y9OGyTmFxgnC0rJgZ_gKryHPCnaPLUp7tUYLbuEds8zRPvIGWIM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcGn5IHvQ7zC2T0fHbCrTdj2wUDu7lkbJKvQKpsaFDMw&oe=6A97289F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vk0ClWGtqAQ7kNvwGQjKE7&_nc_oc=AdpgHfiLIzFQpSQ0VZpXMz1FWZhCtG4wcKCBtZ5GtqEPL4BvlEIaUlFkB9gFs2pJ_CQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUZfy_VM9M9H0h9T2erFTDZQHrloEpTW4Ol6hO73pDLg&oe=6A971D7F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dfK7-n2mBYQ7kNvwGFbz6F&_nc_oc=AdpwnXNCj89qp2oy8Uf9YQdcRxpxJbgNdZC6-8aUE4HO6-JnI08bP5sUqyYvlMUp1zM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9OWS_3fPSJTWYKWxF5MDBAcY-xQA2s2-QBF2UKNXleQ&oe=6A97230F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhMEl8J0EFsQ7kNvwEO1sIA&_nc_oc=Adq9ZNHyHXFLX3KHeA-oK7QO4fVFhRA5QbzJIew1yr0hinyXY-zgrXm7pxLD4a3g_84&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpz0bc34e8SOunk4kfBpf7V2MB2J0oXOrYTUL_72BrFQ&oe=6A974D5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DimWxFOfq4MQ7kNvwFTtyyU&_nc_oc=Adq8TXek_H256hR53jAuh0ok3uf6g5YFf_GukakWVToZrh3Y9L_RSj3MQpJB3UOsnDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqunnM1bL_-0v_8NwAOCAo5bwxHVZ-UVjbcNH2TUsOXA&oe=6ABA8C76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZMYw5XzKzMQ7kNvwG2Fazz&_nc_oc=AdoDLV7d1Ir7n9_Xhmmyoppw8vNZaRj3HLTzmfacYaqZTon1OpXV_ZWm7KMmUeod-5k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGHj56ymIrzQrbts2oOoaMuBCedVbVLE4ofMwu4f3D6g&oe=6ABA88DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4QatETASHwQ7kNvwFdj5jJ&_nc_oc=AdrRtSMc1Yygr12UaOTOWjGXEa836-sb4pkd9RKnR1ucdHFcxnkRPPp8jHJytxSpOao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhX9cQ2azz1PrRcSR29-B4uM4RGOR8eX2V1e1hjuLZ5g&oe=6ABA7DBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFIBbLHUvnEQ7kNvwHqBBv-&_nc_oc=AdoK5GK8PzbwbWsxnm0NP7Plh5S-VoyNAD6B63lMtDKe0GaVovWiznV3QXS5-qn9Ryo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP-9Nc2e82FCqExh9PFLmrGtP0iDzR4dBkj7q7wpGk1w&oe=6ABA834F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QoYTaZeFSoQ7kNvwEBcX9n&_nc_oc=AdotmCSPFXr-XyMwNBs_5hf_R0HYTUZL6JxTDtGpLmWrJMK3Hm72xQeO0o-Cfzc3vqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWAQdiQ9vvUxX3zNGpnrffaCzupmso4717Ns5XteFvww&oe=6ABA755A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
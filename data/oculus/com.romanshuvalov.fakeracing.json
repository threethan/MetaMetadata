092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MsriUSvXGMQ7kNvwEyUeA3&_nc_oc=AdoexSJ-yZso8276pF57jcSyNZIdYG1VMLOGAI5Q6Nxijhqhvkq4Lyl5yVTEglp7JW4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHGO7aKHzIWdpok0eXbAqPgtulPu5sKN1cxGxPqtL6zQ&oe=69CBB4B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y-6ocKWb68Q7kNvwF6if2I&_nc_oc=AdoMWdD1oPREUWKpJkMNoSWEw6qQDVi2TZGNrzpKuETCIzkZU5CJqBq8Gi0qED7foDo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPvS1wdJaYOco2yHca-5ybxIIgpaFzQJ4IMMSWtySNtA&oe=69CBB11F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WbD8wp43BoQ7kNvwEuNnGK&_nc_oc=Adqu_NeGvE7V7zPfxcxGNRf1nijAqFJveWQc1k4IfWZiKbT9tS2xftI4X-ThfsKFJx4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPAd4NdhmSA3ucJVKVRpGh9gErNMLXytgWJDns6F5BKA&oe=69CBDE3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59g_4JrrbPIQ7kNvwEcUhbF&_nc_oc=AdqVIYDAGBf3AD_opNwrXWiAt4WYdlh3sJptAqGvgMfFo6OmI9MFn-cT13UX15oXSHQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM2u0UhFaVUbEtqFpzwk_ETEX-d-GKcre_xHnsqmzO1w&oe=69CBAB8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lqoqAnkfkoQ7kNvwFbBNGY&_nc_oc=Adoc6gBpAENF-1wSJWacs9WtwBH11yi1cGmbwdmJhvTlYbxol8yPrF_I9JO2EidKxtg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEBcaoXNbkwI6q9v_7PgmKjVGaEWYa9DTMeLQm2-18KQ&oe=69CBD5DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1_lvUurE0kQ7kNvwH83tPw&_nc_oc=AdplpjNPg-_W0ewAfxzt4Yni12rJtDLn4N5dQuZOqCYDboPxSCXpYKncNnbzJw_dwLA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfaWFjyOsxe3dsfFc10-Vy3yoTM-pReXsRMM2Bsm9NHw&oe=6A65F436"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6QmS-ep51kQ7kNvwEM1fpL&_nc_oc=AdoUUlQ_9rpm5v_90Q0Ag0BBN8cREsavl7kgGm8Go6WNowHmHcL82SehPz73FKXN2xU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmg99wIml5LUlQY2FxcswZV5Xjm-RX-RmZzzpV2aqdtg&oe=6A6628DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH7PVVQzK2gQ7kNvwEMoq-g&_nc_oc=AdozLBYszh8LcwaIP1gu-e7q5ByofUapkXrHrD_50B18D3fOCU23Ccuh_dQAp-qT5cU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2X4TOYFM-p2_iaRTAbt9MaNYI40EJ4IW5wHVOYaoq9g&oe=6A661DBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xhklDK2TukQ7kNvwGurXXm&_nc_oc=Adpgw29h07-j0AKYnlWUXH-ugdQ-zoFtDQb1ljSy6YlSeT1n1Yxlt5YnDl3Tz6sPqBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1-j_Kiyl2v2AkMSfeeRS6Ne2xpIfWUjtzHs4kcDN2Mw&oe=6A66234F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBPujL0kUYQQ7kNvwHuetQk&_nc_oc=AdpwbtmmT4_iCsoh2ZloQSmKPI9CJUaKOYYFYcmCxKce0BxU2CeWH_CzjlAQK5CY2uM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnjX0RVgrJEJmgqxAUPJs6CNTeJO9AXlCNvi_NFs_u5A&oe=6A66155A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
UO7p&_nc_oc=Adme8Daf8MO27kBJrb92goFjJax1UmUoVSzp_8c5ZmzseoD3G6e-iZ0gH-V-TtgOdBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_3zcfxB6_s83PqRGByDIYzMB0ogTy0keHic3YQ5W3xw&oe=69A6CAB6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFzu9QcdpmsQ7kNvwFggjvt&_nc_oc=AdkVzCc-5SpNuswTSGUg1wFgpJ6fOPd3v55r_0NVcRCq--dYcwyOHmtdgKTKK0mxb0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSW_f4X3QTh9MWAF6fz6OwDk04HJHKuu40BnrH40wZwA&oe=69A6C71F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aajPCCfIPlEQ7kNvwF2d0hi&_nc_oc=AdnXpIxNo2YTTEBvvr4M6tuhs0UYmW_E30x3_euj7EHnw6TM8gqiYcelLUWQ_sBBpi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afto737xwDIwldjKvTmeubng-HGkZMTHH8r-gdOSAuhbBA&oe=69A6BBFF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab823_AcUF8Q7kNvwHpGnmF&_nc_oc=AdlmhMTgKw5ZRLnoxXM8bwagFPP5IKXozhZVgGfj5e-Ue7QzHCe48odD2GJCWq2nJqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsxg_v14aufBcWXWC-NzBkoV7tcgSvWyF0Qgo0IJIomNg&oe=69A6C18F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLjFP7C15vMQ7kNvwGelTI-&_nc_oc=AdlKEAcUyo23vMzTjTC_OKJXo6BnKpdXrM9pOAkIk_xbr7iwRHMKiho8agNh7zdCQ64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCrIih_jYEJbcVkOerV5CYUnmO2AN0M4RuiPe6fZWSdg&oe=69A6EBDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294245_186479453662653_2289662199946431919_n.png
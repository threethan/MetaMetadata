092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajdHbFhrxUUQ7kNvwHVeh8n&_nc_oc=Adrn0LQZsMKe6JBX00DPK7OZFwzXzARglCNLy2fa6ZH_xzXf5EC2MVCug0sw_hajKNE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH79nXvBZR3uiC7Xq6oqa-Wy9x3AoR1fe2SQGcvvMiig&oe=6A92C736"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NFLeJ9lK7cQ7kNvwGG8xbg&_nc_oc=AdqMasI9OoB27wFkM6sIgZNWjij4qbU5SVzwyA7cWjnJzm1lkGje83wXTpYuOW1kw4k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsAxY7ng0vbN3EJEqcNsjrs5K69HjUrhoSus15S_T67Q&oe=6A92C39F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV4K7NLQzY8Q7kNvwFOEJ3c&_nc_oc=Adqf2Epa-sQnKHNeL8f109S2Vs_RTVx0uVVteDDqc2N1E-iFnl8g14fC9zAP8kl2v9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMtmyTc0pE-frolo8BkxByX_qM8C3DlTYBbfRlK1dQJQ&oe=6A92B87F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsdgoJyngdEQ7kNvwHt_Nqq&_nc_oc=Adqoa06jGULwFMn_BHdxX9DEubM_-X7xlrbBsGr0dEQWpkx8wibFmyF_xdB3BWDSBsg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGJ2OvvmMBS82GH6X1Es5F1K3jGlR64Y1h46uy9Yfyog&oe=6A92BE0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkOoNGaJvMQQ7kNvwGw-lwl&_nc_oc=AdoS0d32H3OYoPpfzqIwmOnaoWcSzCI1jiawuEs3yOybzZxCwGQeoA0lhiLP-WePljo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaRSx3Cq-y40BVf1xpiiWGAr6y506bJsObquk2MEJvpg&oe=6A92B01A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
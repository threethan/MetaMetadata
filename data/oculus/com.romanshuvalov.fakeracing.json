kJ9_&_nc_oc=AdkJZZG6AQNKuOEDuiKNxqdUCRNEpq6L9ECjkt242URURafSfAzjUkUZQMGJRvI_zZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afth-HwzsubfSTMjYu7KHA-Rr38ri7EPlXQzrLPgI89xcQ&oe=699AED36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XWg80grQdEQ7kNvwHgMhRT&_nc_oc=Adm7feDe-963TOWlM4uGUjpilSX4SYdSiv-5SaJs1qGsq3TEFSMruyJ5sMAHITtf5Hk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftMlrOBRT2nSBWHWlVDgZEKEbkLDYdS7o3u731b735NOA&oe=699AE99F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i4rDOtK5WcQ7kNvwGrasjB&_nc_oc=Adm5Q-1BYJfqbVqN_5d-4SayMvXZRaWyQ6xvWcczVSlS8k2-efvMw6iZJdPi3u9yvXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNEnzAdWltXhN2VXgDIP2VTRhtBWJAUpoSc3pEhLR80A&oe=699B16BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxjnlq1Fqg4Q7kNvwEasToY&_nc_oc=Adn1JN0WL2iIKYjOmKEE04pnglFYFnh-Em1hBSggKr0CF1LhayHO5he4lLnMuGsvYwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfueKOZcr7pHz2of6BbH_Nx5EXvKHYP5z03P3ABoD1WTFA&oe=699AE40F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25uXQZDWtLsQ7kNvwF3e-5h&_nc_oc=AdmvATtIZW4tkSzwrWmJ-SRhEljDcTcuSDmJCu07qgjLWjAN79tnuXWP4D48l0sbOSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuDyIZ6FjtgNccEWCOH0bxSH8_sBJC6JtP_m3iadEjahA&oe=699B0E5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294245_186479453662653_2289662199946431919_n.png
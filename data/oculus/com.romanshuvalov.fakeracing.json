092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Liiqg_K2cQ7kNvwHpWACq&_nc_oc=AdpA9HPnkm-XCc6W4yKVCwKLqcn6cYKZ9duIZ_aB3ZsfkeOMGpM_poEEh1BmG0EoH5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PMshR0r7VoBFWTIy5ATie3JICqdHu2LutAYqrmoKPiA&oe=6A19B576"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg-LuXhTnMQQ7kNvwEQDbQr&_nc_oc=AdoAEVG8fTqlprEUXh-idqJzu3So27is6wOp1ty_VqdjRRpKdOkpnquPsHwIRp1tGdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b1usBa66vYRPVJsSIIyjy0QROLFwAS13aNC-OkbfnIQ&oe=6A19B1DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKa-5Tq-RFoQ7kNvwHHXtFg&_nc_oc=AdqYK5rI4ZQ-7XKLC7Lf8U1Eg0-8NPEEyZysrHLFKG9P47WGJQbtFP__zoLD1pxDmcM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JRF5FzqyH-sgSZ0NIU1V-M0oiFsxoqieG30ivL9cPYg&oe=6A19A6BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL2dF32vJ20Q7kNvwE6pQWk&_nc_oc=AdqoNeo0wqLJ1PTQxY21Dy_vi22E3TDlidp71NuHmlOoLrTwZ-hNboCgeLGmP_E-fk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ret4xwNBKwuaOe6nouxRYuFvLXGBOfj9d3tUJ3bVWYA&oe=6A19AC4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUj-R_Vw1MAQ7kNvwGEgzav&_nc_oc=AdpaDNGXTx7BnkbZdpkxRqTx6CRreBfj-E6_SkoM899AG03nudURDzWXCOF8WMFj5Fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xEgTzi6mZBXpmMjcsKYpqbCu2lPUaLGQr6eCp8jOLgQ&oe=6A199E5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
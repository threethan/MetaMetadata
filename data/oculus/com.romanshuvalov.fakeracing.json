0xMn&_nc_oc=Admvx4Pf0IlMfvgKmhuDNqGXuqsfOWzHKv53nBNMUAwMI-dPj2072jd1iigKigKP0sw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft87cvqkMXHiKH6Ylp_3OUO7a1Lb0WjqD0uiYyTIJuBpw&oe=69A57936"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWS5Q92TSlwQ7kNvwEoCMqK&_nc_oc=AdkI6R_FyIgfOp7sQC6ehIomXYRRhauQ-sl9oshLYPN-fNJa_HtgO5Ox_qnCrh-e-Sk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvkrReKTJakYqpkiInpbqhtOhMf3-JPqW21C-Nrsa1-Xg&oe=69A5759F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aajPCCfIPlEQ7kNvwGiTcLP&_nc_oc=Adlcza2nAAg1FsPQJPth239qSTAeQUuw8ipoO8Ug_oOBcIKGEltGQv4dKk94zpdfzYk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftEJHTYMWc6Jgmq9EdVZkZ_NFhS-DlC9eUahUYIoZ4vnQ&oe=69A5A2BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3n-SDRf3dAQ7kNvwHvkvi_&_nc_oc=AdlqqsmRL5OsfxC5-T7l_XuDN5rstutjlukYw1l8w5hnQ4geDhMbq5sCCCYeWr657ag&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvquY-S3gDKlFdb5FJlW_DWWxeEVrssbMv8j1FJDrcOlQ&oe=69A5700F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLjFP7C15vMQ7kNvwF776PQ&_nc_oc=AdnGelfEx-1PZEHHJYbsuKqXklI7QsmbqPS0j6d2nYcH-QvdxIfPETCal09hivVUJ6o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftWQ-LM13B4z-F3GnhKkgL7agl8YAo2VQmoIPK16O9YtA&oe=69A59A5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75294245_186479453662653_2289662199946431919_n.png
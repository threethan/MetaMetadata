092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFpp9cjhQ0sQ7kNvwF4JS76&_nc_oc=AdoMI1ZrKGpCcJAVzBiJccVfVVJ3JMTnP-F4rxy1VHVyF0DdAcIdrmjkNa6LR2xM3_4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68DznS98aGpB322DK9w_GqKJ3dQWYputgsSmn4w5tDGQ&oe=69FDCDB6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frwiJaEy3acQ7kNvwEOTaeS&_nc_oc=AdoHcLyaBgG6iK1Aa7m8OahvKQFJQCnBsN4enF2zDIz4vdWigfNAB_N5ynxAyH8l2tc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CSAVxWERK419SQzOBFkU-PGOgxel5PC8mOzzsG3dUYQ&oe=69FE025F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-T1R-fs0scQ7kNvwGdx0Uo&_nc_oc=Adqy_-b8VxX5hGcaF6C3pbE5FmYErRQxLSFu8BWjbksQjrK26hIiyFgC5RkHOwIRxT0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SCGlBiaSwPA0bAAhVk7DTslNE_UGg4uXcG9Yf8WgpKw&oe=69FDF73F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upSeP-P-0okQ7kNvwEzxfOx&_nc_oc=AdqwhX2ojgxz0KhrXPlHcLba3ppEm4D6nZAyO_QRjlK5oy-ibxiZUqd61xtl3VoW0AY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sukJJzFI6u4qEKMdYhBhvGvE0bhDIzCKb3q9iNS-v6A&oe=69FDFCCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-Ptm9uEbMAQ7kNvwH_0Jc8&_nc_oc=AdqVmUA2BqtlZOq7eO9pogk8Uwl2XcaMVLZ_B4djKVYRaev_NCVy0xmar5-lIwKYG7I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69C004cuSg62L0jCFsCcZvUUzgfiKK9XblHTJffxgecQ&oe=69FDEEDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
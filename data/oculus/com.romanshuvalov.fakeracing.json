092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc6L0r3n4ggQ7kNvwHx5wQA&_nc_oc=AdovrrIrv-8YJb_XdbJFAi9HsmgBx4ssJGnEEmmj-WafZFkc5OOZ-gIGYFtMStauoQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWcy-lAXbuu7HD8qmKNZqS-7sv9H-2Y51hvkNposGxBA&oe=6ABFD276"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOf-o65IE_wQ7kNvwHOw4hm&_nc_oc=AdpAz6vA8HCUO54h0YyCws7SPtrrjPWZVC3KXDFaVhkA3hlYNhibBp3K3Hv7fRUsplU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGWW6kvgKhMUeOT6tvAm7c4NiWLwz3cSDV9Bjhn8yoRg&oe=6ABFCEDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHFI5Lrd8NcQ7kNvwFFJ0UI&_nc_oc=Ado8QxcLMo5opIoIdpJHmV9ILKgLPb8jX1nQGSTu3rkj8MLeJe51-2T5xhl_XcQr0nM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv5EHuhUi_grjDDLCD_tdLukfQGCR40oL3FG-l6a89qA&oe=6ABFC3BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WotzF9yxS4IQ7kNvwEjxZfE&_nc_oc=AdoYLTi1KIySF3x4rU09V_EpTCKyI8sSCbBZEzEr0BGL_m-DY-4gqWYb9RWs1mjb60A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGDhH4P9C5RyygQ5yVOin321D4FpKmLM664wkZ7o_Iyg&oe=6ABFC94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkblwk4WOyYQ7kNvwFkEkDz&_nc_oc=AdoL2B-V95e3fJaz3651wsXfYgdig6uRww6qpnIHUWdRrO_rn02jlAX75XVXKOtsgm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVoKyp7YbcEQtKY-HKmvJXdA2uprv0-UWAlHS2_ZoLuA&oe=6ABFBB5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
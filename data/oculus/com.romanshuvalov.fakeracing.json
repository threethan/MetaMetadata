092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLx_IhwfdiIQ7kNvwGLxken&_nc_oc=Adp7LZkcEBqUHJKyNwYvlk92RLB7p7zjYYqyWX32evNgHNQeOQAfPe-b8Bx3M88Kxv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sApcp-2UH-vT4SHxi4gp7TCQbmaQGakekXIaxXoDrGw&oe=6A3E9F76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80H561fle5wQ7kNvwG-to8g&_nc_oc=AdqGUrSHJBruLB0E1-IQx0c6UY6D2cL-eEMxDD4xzNISl5NBLxpDgYaO0WaQjJ3pnIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sAxFrlDTdoUrBdxCXKbHxTz8MoR646Pi16anejVJbfQ&oe=6A3E9BDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT_REkyu5DgQ7kNvwHPZZbp&_nc_oc=AdpT2HCEPXO3kpHx5U86mj4GFmDEM1g4_D3h-sMlaT8sZKum9xN-9PiQnu8Q0zkKMBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WECFNzuAqXWYxW23FOg6jsGp6Dybnr7qzNgj6VFHPLw&oe=6A3E90BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2dv4nQ6CpoQ7kNvwFMmVLx&_nc_oc=AdpZSpjsejqNOzeqO5fCh7AELo8--XVGZ1xCcbHY9OQPAeQMnidenTPQyshnGldSHtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cGNw_S9Rt37k_OVqSLW50I99up7xQtZNYOrWrf4DB2Q&oe=6A3E964F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZC26KkXTDkQ7kNvwEVy0JY&_nc_oc=AdpO4IWHePSZFFeqaHMeI1BVAhVkoSLSBL5fNg-Muxq0vwy-RnAB8BPO7FDT7rI_tF8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-usdL0DTlUWnkz6pI5FK39U0ROr0FQvXHlZ7SMSt4I1g&oe=6A3E885A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
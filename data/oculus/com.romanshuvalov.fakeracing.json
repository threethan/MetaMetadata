092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06juMwY9j_YQ7kNvwFHwYtF&_nc_oc=AdqjtcmyHs3AKLVbN5RAekawujOckWxK6CjoruFue8HsH34_1tHGLbG1nQ69AH0l7gQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESMmza9agehVfWJXgIaFS61Bp_gV-Tjkuj7_CyencoIA&oe=6A8ADE36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVVdfC_EdwsQ7kNvwEd5_8a&_nc_oc=AdrEejeoF5vGoq2JVaRo3JeHCW3g_tFiMhpy42FxcQCyyDOqZ8ZT1cFUSDjzGmSp6R4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb0UXNtkSHRlD3ji3tKwzUTecxlYo43lrI1Ji2ay7-bQ&oe=6A8ADA9F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgqlu96pYdwQ7kNvwGqBJy6&_nc_oc=AdrUEmmA3f5TCmfhIXiBN9rgUTTyR91-ys1PVyWuhTwbkfdocfqC6xBJakItH_nWqjY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENIFj_Y1YIFoAtnII0cEgysKrnLJ288X5aIORoBNHGkg&oe=6A8ACF7F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ_VMm7mwgkQ7kNvwEoVqVZ&_nc_oc=AdofLNmKbsEfSrjmdWyDKc06-64weUXZ7SpZhLPJsZ87mKuN0WXqg9YOjcQZ4vg0ONE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHlMyiiOB4v__4JRNYvyamtVzB-6RiF_0uG1GbdGQl_A&oe=6A8AD50F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XYFBuzTHFcQ7kNvwEA2cfD&_nc_oc=AdoEHBKZogqvydyyhGPklB2EhIJS6XAAYqGCEOqbiMnwtSfs-qor26EO-tmJVwEv1pA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkFI1tfSNhUcF6ZWCF67dJpIJeZm6WQVVtogicPjzcGA&oe=6A8AC71A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
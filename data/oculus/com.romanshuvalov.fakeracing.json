092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNwl75wnrrkQ7kNvwHJOi8X&_nc_oc=AdpWWKhF1M2hWLTCdSeGnPlO3wofKa24AQrZLVUC-1uFsJ2R5Y0lwUdEXgJ_b6pnp-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmmabUw20HJXrPBR8O33XXOt32slgYb-kH7iZMSP57aw&oe=6AC123F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOf-o65IE_wQ7kNvwH1rBmI&_nc_oc=Adr3tJVoqHVVTDOtA7kZkJhoTQHqkf7iiO347Y1vlb5I-nqJMbhxvQ-UBhOeUbSTr1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3dBQsLRtYFgQe1cnwARj8bWY3vgQgTCdLmhVgINeprw&oe=6AC1205F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHFI5Lrd8NcQ7kNvwGbPiAq&_nc_oc=Ado9pIMc57EZ-fqefeadcDNqJzhUcc6WZrTMeg7jU1nDnWjAn_LVfk60Rv884wZ46Ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPByOozBlvm9ZEOMyEN2fW0G0r-N8LaJOvRtZjOzuZPKA&oe=6AC1153F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WotzF9yxS4IQ7kNvwGkz20C&_nc_oc=AdoK_WWtcdJIgbBZEN8aKwUXgAOW1yWCs5ZzHhDUC3PTtE329PP4r0FuFXR7Br4Zj8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON-3UKHZ_W5WcDLqTc8epN44FiVrghXSKH7ryGYaHdGQ&oe=6AC11ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkblwk4WOyYQ7kNvwGHk94q&_nc_oc=Adpw3hmFOh3p7McPzUAKAmonT0yQqn5tNYCKbYhvZF08KGgy8OPrpKh2hbsJLMUzNnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCWO3q2qlXyMU4F3LcMjy1HF_QTMVTg0BDlWWtm2PDcw&oe=6AC10CDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
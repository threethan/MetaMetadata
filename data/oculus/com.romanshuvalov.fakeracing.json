371507_1092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygzSi6HIbY0Q7kNvwGPpP-I&_nc_oc=Adrx6SRjXcS0YiR3IOki-eUwaPqVcOnKg4MWsIoGRL0rGcgMYOwdzwN0Vk3p522pXv4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMHQHrthg40k1yEZEVi_XdtuNHBz3Vsf69vDJmns_bmw&oe=6AA422F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UizHIzpSWgQ7kNvwF6QXhP&_nc_oc=AdobmrLxdUh9IIC6c59LmAzBhPSQ5g0T75tyEuhFcC1nY9RSeCRQO4wDQUITM53qqcs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCxkULEQ2nhlnH2M1EMg2CC03wcjfdmztM_Y-Zfowzsw&oe=6AA41F5F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwhZ2HIGNH0Q7kNvwGw6uDk&_nc_oc=AdqZZA_lmwZ5wg9h_e1_a8LR-AJTYXT4ulN6jWdh2cxiINGqeyVvJ0LL_WiZ6l7mixA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyUirKWlPqnxdNe3aDY5oTp3anAJ9BfEL2VgcS15BHog&oe=6AA4143F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGuoZ6_6xOEQ7kNvwHAQ4bg&_nc_oc=AdpRarwZLWbix1cLqvWbDoUXDQBRR9hPte9jiV43hm3sclZPcIPDfeAuv-sWGasVRT8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG40yjmtvQekpvZlHE9Hy-dIF76dkHKEzcTY7YwmeNvw&oe=6AA419CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRvQj2dM1xcQ7kNvwGFjqWj&_nc_oc=AdrsNk6kZXTrK5650GzN57rCbxCWG6SHJ02-a3DCn_XiJxPBde23XThBAj_UV1EzmN0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGWmgQjyx9GpQjXYkfZf1gWtgc3t8GNsZKasdTJcNf1A&oe=6AA40BDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
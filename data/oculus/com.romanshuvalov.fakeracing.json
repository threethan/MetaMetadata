gZzo&_nc_oc=AdlLIopVrV4C0fV0S7OVLoGS6hBilGaWNvaqbjDQqLUbCMykqCCTtSfIFXQkf19BJuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfufaoVdcr980J3bG7kxfU_1Cx-0CE5sBbAkey5fgA0iFg&oe=699C3EB6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XWg80grQdEQ7kNvwGb08eE&_nc_oc=Adl5YIZkayv7IuPTBiEMfUTDqJLr1saGW_ZN_cpHUGRTICFQ4xgoVI-fFXA9U6-9g3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfviyP_27eF16n5ycyh11FmAbSRMwXY0CPcBcwwFhDFwLw&oe=699C3B1F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i4rDOtK5WcQ7kNvwHlVk2F&_nc_oc=AdmPv8YSKnl-9e3nbQCr1mBqTrAQ4sU54c6cHukgDyvUb6YCpNt84Z2xIztWRgPZSnw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv-4JpF4vqJ0AwOa7BiFrMEFCC-ZOZMqXpmPkWLBEasJA&oe=699C2FFF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxjnlq1Fqg4Q7kNvwEM0Hil&_nc_oc=AdlyAtO8BpN96K9l8ZBbXJ_GIW99O7bulGfr91JWM_SD2juv5P0eSIbzr5fi-holXS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfubSLNgRrtUoBIoI0Y_62bQ8oPFlIQsoN6Nx2vzN0KBvQ&oe=699C358F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25uXQZDWtLsQ7kNvwGB1C2j&_nc_oc=AdkWVEN5G9yci1bp1IdD-m0uWKlSWcDtjzdYPQ9XyZn0AMzNMyDluiop9fDmjkLn9FA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsRpMFID3FRiUA7eLbYK5TC27pECunMHQTSK32ZnKOSUw&oe=699C5FDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294245_186479453662653_2289662199946431919_n.png
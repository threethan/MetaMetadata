f20f&oh=00_AQCBGgMU_59B_T4LXYpoP72Wr-pW6YXTd9SAW4VvlF0dBQ&oe=6A6F2B1F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8y9h2Uil14Q7kNvwHuS8pj&_nc_oc=Adqo-9tYucN5DtqLx4BaiusIeUkl9w9G20J3CryYdD1y3VMLhM8-BconOIAfrUXvWEE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzr38b6giGxWIxoihgIr2ZOS9D8FQIIGk4ByNg8nxpLw&oe=6A6F583F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVADsuCCncUQ7kNvwEgRcM-&_nc_oc=AdpXfPD5bXAzPYWnoQ7dsqvRK8haFESYyNE6n87zumRiMC7Q3D-iNCSAvJJeA8Xv6Mk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC36jLyGamWDt_LXG6JkR49Q3k1M-nMmeAwOzANdcWg0g&oe=6A6F5DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f4qfvHmkzcQ7kNvwGWobAH&_nc_oc=AdrIsp4fGhGO_9TQCr5t_rJffOJCiNtXXXTs-I9y4uDqMeWwPCvLrtNozw26uwDFxWY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjGwqypupMgMnstWrHDGVOOrUa_VEpGtkVxgGU1lpt8A&oe=6A6F4FDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466701591671460"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5209786072437173", "version": "1.3.1"}, "id": "291796266306597", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4701618959920556", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5209786072437173
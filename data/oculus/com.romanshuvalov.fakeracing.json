659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCt7Dk2_me4Q7kNvwGxI83o&_nc_oc=Adn4-2vTqx3gCcKP1UZu1xi4p3oAoDsNpXHz4gg-vr6C7Shfd8_w70rEl8YVnhwpGdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLR6XCTw1YpkPT21ABXtggvEEQ5F__VB6VZ67UhWyyFQ&oe=69B3F9B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmHp7C34GjwQ7kNvwEKHY1c&_nc_oc=AdnS301c4G8eem028dZC-5iJMCdC4wq7Y2R6sT_LLNC3u11jwoQQki8cMbPN0M9u3Cs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRrRUlYHN_bmW8hibLPepFlZ_hYhIFifqNlBkGT5SnUg&oe=69B3F61F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDPflH6_Fu8Q7kNvwHfmN8x&_nc_oc=AdmhsS6hnMhfQjKyrnNBtF-U-cv58b7Fn96kMS1os8xl4PabatYe9bE0lCcfpJWeWKI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxSfWsnpJlaGhLtDvB4kvWLV-ONhQtJGXy14OmHbvGeA&oe=69B4233F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFSaIexRCYYQ7kNvwHhfDId&_nc_oc=AdnpdxfQtiQ2b1yMLTPj_fU4pX5-FnrETj9tmExZ10isuAFm8J9_l89pLBew1uuRzus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkbJENLf5lnjTM9KqWqIqKSgh3_4FJmtGcOEW-rMIP6w&oe=69B3F08F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoQE8bysKksQ7kNvwEwdNbu&_nc_oc=AdmUthqeGwiJHJXCXnx1hJYx_bnvT1nMbf2XPBu3JF62j4uzY6Fr0gGKDRJtBuvnquY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzhsv3RT3vDl6lcc3k5VmOj_W9uOxqpYjWQ7oTitqMfcA&oe=69B41ADA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_im
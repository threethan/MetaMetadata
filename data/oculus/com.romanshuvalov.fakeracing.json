092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjzDzfHsBzcQ7kNvwGjKaoL&_nc_oc=Adq6QEcpnBBjZ9-GCBbTWqW6VLPxZGG8OxhQ469EMZmYiVesDEinWfvUKgsAvAXKTRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNx29ITR5rU6VYNfzdjvkQLDeVDg_ruq6C0jcGQ1_96w&oe=6A7B0C36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0uK0oMaZu0Q7kNvwGMhcf2&_nc_oc=Adqp7d-QBKQZCztIlK753R_rjN88Oy4tQCCeGHlE0MocfYGV8DgcffhJpctqb9T_oWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYwwbA4kJ3ga5u66le-g75hjBIq-V1ZtWIkU7vIxBk2A&oe=6A7B089F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8WIQgLjxsgQ7kNvwHqHWW3&_nc_oc=Adp7ck5KSyKBjtizk9ExdqbTpdDZsHjnPY3--FTUg6v6RdZTbJV9Hv1Fc4qOv0KTKdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-fKR1YVlFvCWO1k0EjWIEynNK7Wa_dKl3PeAFdz1OJw&oe=6A7B35BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbygrZAqcOsQ7kNvwEY3ez3&_nc_oc=Adp9fZHt7MpbwraC3Uy_ZvAHRmGVDlxBlssB26lIN9gzbEy4jz80dQCZ8NkNpF9tqgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_6WO08ztJT97XAKSp661QgjZyc5uxJfCs4JBLbmLRJg&oe=6A7B030F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYk5HbUTuTUQ7kNvwFSJKDJ&_nc_oc=AdpcC4PvHtEqujKJnZVtM3Y6TxfnC1QnN0ltFuQlVU6CUYA-EJstqnUs3GB4IfRf2Qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY_uy6VjSwG1Qt6lNhrIBzIMN6rXREeBahxUMXkPMqWg&oe=6A7B2D5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
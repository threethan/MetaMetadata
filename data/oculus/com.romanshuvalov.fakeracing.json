092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vea1hN8gOtwQ7kNvwGnp1vv&_nc_oc=AdrYczl5mtrtVmf1rHkPyU3Gooc8toDGhV3W1VHaxTn2prqyhbClXWlY8oovmbGYcrI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ87ApkJbmvd38TsN-0VzduFdq-vKvFqfUbNyO09LFoNw&oe=6AF9D476"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M7M34Ci0RAQ7kNvwFVueeX&_nc_oc=AdovvQorfMg7wYC8O7HjP6SIsq9QKheO2G7pgtMrN9UJFt_5Ey3RXBGT6vL-bzlRdl0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj3m-X4p3NOvmoHDIIsxTDSJtGSEeNV7wvJnIIj3xr2g&oe=6AF9D0DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhxTVHDJIwwQ7kNvwHK7LHz&_nc_oc=Adpu2jdrxr-AlSyPCV7_e1iFXp16DFRslsrXwvdI1Mp_y-923BFRfhAqjggOK9Gx2v4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4fZSmpc5vtMpYzPumnY_9EFJSAiWIRmTBsU-IegqzFw&oe=6AF9C5BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DHtKIcW0n8Q7kNvwFt6aos&_nc_oc=AdqIU7p6JOgCjdAWlOYPmRREgERF2Pk_2bYJPgJBPShCdUmQDl8wDSR4Qa5vyDl79N4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgIZ1zY5BbEukJc3K_6eGnVD5FNQN9VLncRoDTDOcOLg&oe=6AF9CB4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn5YfOL2wzAQ7kNvwGDfXdb&_nc_oc=AdoedqS8FA65GxMQUNm8evIVTlT9aiHO5DYpdBSeNfzioMVYBVJQOz9Muh7cgVisY3U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSF4SObgyLna0qkfVJ4KzpVPRV2-vWn2mRdq-lBd1qIg&oe=6AF9BD5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lk5y4oaz5kQ7kNvwHH5835&_nc_oc=AdrbbTWNvj_LcFTvaTR-ObrMjrw4LwYEMZuhVqFcvwe2Nxf5HaSASi-DLYfR6fr7vnE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76fmbvhU5fxV362Yqsy9IjF5dlLzxb-Pmcmm1S3H2mYA&oe=6A131DF6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O4g6HLbF1QQ7kNvwHI9GZg&_nc_oc=AdqJk_IL86r2BipDpwsv4K7hfkAqcjwVw4F-NYT0mGfM__0EjRVStwIUt5Xm1NWLSDQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bFokDIc1moOBvrx54eXjAKra1CCaUHhs11qjXGsGBpA&oe=6A131A5F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UNWQxtt_NAQ7kNvwFgcb7z&_nc_oc=AdrobWkeYEJiLKeN3iERKUpO_CvRO3Y_TMX2UqiWRQsrfTtacVSSRhonk7LnQ_EO5dg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZL1VFJNZXpup8q_8VI2yHEaHmygHSjNMZb0Ncbktw2A&oe=6A130F3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9Y4eM0_2lAQ7kNvwETfcj5&_nc_oc=Adp-ViPI0IrF5ACs1cIj0x8mZZkJL-GbuqrB09XhrnK9Rew1kwoAJwMCACryCYNAzKU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mvRTB7018ateUiGl2mSjsBcBsoawZntLRUb1jgIGYbQ&oe=6A1314CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaqtlK7KAQ0Q7kNvwF9k2KH&_nc_oc=AdobwKqV5chXAngvWLkBEkQUNUzSmuRUUMjthPdWLRnHyprFyVrbGAfo7YSjIkYVvzo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-TWoHVlwUhjPYcNtGb6OWotFqKy3a4KkWs-ZAvNMIuQ&oe=6A1306DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uckq5cTzXcwQ7kNvwFIt4F8&_nc_oc=AdpJ5fQBf2EIu3PZUiPU2ss1KbZ4K65FO1Ro6F8MC6wS6DnRWN0sIHTy9eFPVZbwdUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykICR36ENMnB4He25G3SKn82lThsgeN0eT9m1VcDGAaQ&oe=69C911B6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xy-fyYw5dsQ7kNvwFchpcj&_nc_oc=AdqMLhHuetSKmQqd9ZeFgwP4yBBif7ie0epchA0pwPcNIxClmRdbusSOwJjI7-E4pPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPtLlIyG5psUS8DN6bQkTiKIqyMjE05I5YKExi7ZwhSA&oe=69C90E1F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WbD8wp43BoQ7kNvwFIcmGB&_nc_oc=Adqr11AoseUjL_vRxPZLAY0zuCuHi3DfUZslXEP70F7ns0apFgE6X8a8LrhO5m7hv24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfVM0Ox4AcGV-EHlJByTVxs872T4ErVFnQvuCRCU1RWg&oe=69C902FF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oEwCFz-FSUQ7kNvwG8szRd&_nc_oc=AdoHP1K5GDbdrw8u2AJKL_xdJqF1LtBTR5UoQ2w-pGkOrk_waEwSqF4NK_0O_e385q4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzN4QQDdEVVeVtQmoywfA5cozkUle0ooUpbm3jGOejMcQ&oe=69C9088F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lqoqAnkfkoQ7kNvwEkoK8O&_nc_oc=Adr5XMpByMH0wiVpJLv1bHNqI6nnz71fPnzgRgXydPsM2_aiR8p5v31qZGzbpUMZu0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwToXGYRQqAbd_8X9DvFd2SRycPorVoin9Oo-mxYnX6zg&oe=69C932DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
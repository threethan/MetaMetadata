092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSvJDWDeD40Q7kNvwEJVf6L&_nc_oc=AdoR8YHA7iHBysXsMmq6I0ldOnyBLMDm1i2abUPWqfpyh19M7SAwamNAEgsUKlE1BFg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID9QavBw0qoKwVaYmJNVjxwe3_bhdgMeHYUoT6xUcChg&oe=6AAD5D76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQBEUw1AR4oQ7kNvwH03Dif&_nc_oc=Adp898-Trw5YQVW98IhOYZlz6hpQq-LTX_Pe3vmM1YgMKTFIzUvorrjNk1foO9WJO0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdWXjSO-vXWl9QyJ_W-gY2d8i6dWKIkcLVosp3b69lhA&oe=6AAD59DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfmV0BGrchoQ7kNvwFNb0mQ&_nc_oc=AdrQ8pyW3Dc1RwY1wn8oLjs61xn24wywRnJ9Lp_5AoZDY_ezqVDfH_BkxgZSFUSb5CU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVTjA3YtXqA4OKWejwSqzkKOXBDk4Ek-bp2dK3vahiFQ&oe=6AAD4EBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7QmOgfP62AQ7kNvwGAmBNH&_nc_oc=AdqJJ7MCLI2M_nuvc-S_E5DAgBFGyYPx1j-3a2v5K0wvtaTCTo_X0rCcjSA8K6VunA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU81S-rzLFFah_BUrCAFfWjVGOAIFJuE2rH9VMZP3GTA&oe=6AAD544F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0qsCM4858sQ7kNvwG2REgB&_nc_oc=Adq3wXcZuqxD_vpqQ3eALG6jb-FqP8gnuS9lZrmeEA-zVow0e-i8V1vULVgXVJjtlCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6OmtcH1KPRQ-GavDRR5guByR4rHF2wa9I_yNUX2F7JA&oe=6AAD465A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
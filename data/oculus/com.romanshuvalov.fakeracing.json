092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vCYrPAmpb8Q7kNvwHFYPb6&_nc_oc=Adq85pt8O-ep2lWfLhs-WmvLkhUrhvHbYJpVRzlY0_35Ta_-vEoT5QIjrc3W1sKb3a4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9GLhOm9BLIkMSkhFC0BrTzhUTyket5SJoVX3BvkixKw&oe=6AEDF6F6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmvuTv57lHEQ7kNvwFkZu3l&_nc_oc=AdqdkDhCO0njFvl3Cd8XL7R5De7NpeQGvI08_twVaLw10HLrUwPgeHIhUdqQFanqRkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJTwBoavH6UlxdbmwYXDjqAjRb92JyEaC4p-5blX90pA&oe=6AEDF35F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMxT9eamdg8Q7kNvwFF2JEK&_nc_oc=Adpef6w_biKEMoiCsszRYxxoN4EXbUOTTwU_xLp934DdOmX6y3Q3Pevlt9Va09qPRIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRY0b62Oc_AMV-FHaGpgYXzHZizkZQBKnO177eeldHKQ&oe=6AEDE83F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwXCRgQkJJwQ7kNvwH7xt-7&_nc_oc=Adr50JynKmJQZSHyBiZ-Uu7MU0KiIDbecXDS2j7EfMqUKeCiBzEvRLj0hpRPbfCHztQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsn4A9_kE0NhM-as7YskrJC9bdEHgnbEBHjgk_NeOW2w&oe=6AEDEDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCRUIJmNkh4Q7kNvwEjsphE&_nc_oc=AdrqJ0rtCDEkR-0Yhowrp4wUQpAoQPOW-BbCw3dCcv6tWJIMJZx0JpLEOBJOrybKCzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbLPjYSz8PFAi7RpwFHR_H0ffuySacHrOJK1xXyLGlPQ&oe=6AEDDFDA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
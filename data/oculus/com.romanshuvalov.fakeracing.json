092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdc-PZZzOXMQ7kNvwH3tgqW&_nc_oc=AdqUvHCSEKFZ8cA_nweJSsiVFjOCDSvPYbJCfoidv5dRsZ806TMOiUita7aoHaqid-I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp-rtnV2iGtq_YdcvVeYCczdtaQC-MxSRvDyOriJr-tQ&oe=6A565A76"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0MEPL6iC4sQ7kNvwEW973H&_nc_oc=Ado2RAt-luMvyYC2F-BsCvcs_mSy-Nm_D_pS5XmBDBIMkAZg5LqmOWSfRS2UixsSY2g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2p1ExCpFMHqttLVtDsEugoP0mj6CR5sq7RsngPJO81Q&oe=6A5656DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImdRzv9at64Q7kNvwGw_jYi&_nc_oc=AdrrXwfRZF0HOnI2fU1qb8CFdyezx4NLAg71aYrN5adtMfALFevIbUuD_F969ST3g2g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqv6FG31qyOTzFH8AH7vf1JImYVp22ZjHk2pDDdCDP2g&oe=6A564BBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iiUQoIYuoAQ7kNvwHSG9yj&_nc_oc=AdqV0if6GLhF5T5J38gbOx90lQrQbQQ-qQGqi6QsaW92_0kn-elt9oj5g0GOcTjLzvE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyKRryvNFk4zJIS4gK90Lx17wtwsIxNH8YEZk-RdNv9g&oe=6A56514F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohGtIaaoqzwQ7kNvwFUEvjo&_nc_oc=AdqaQm-dHSaTDyE5t_r4YM2DoyGWlwNUk8j8UUvAQA5AX1a3WYziTeBNLYZhU2t2Y0s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3p9ckbnlH-Sp14Pqxe1hbfY_3Rv8g_VmXYVFgNuXSKA&oe=6A56435A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
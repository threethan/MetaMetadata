092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSvJDWDeD40Q7kNvwGQy5xQ&_nc_oc=AdqS4RUVYunfG5quqz9bChr37J7kxMKgJuKAE9R6dfWqmzufoIaOEXezXQoL7FdwcME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKENdiqy6B76bDItq4KRcJ9LtCWYSx-7ftywC08J-Xp_A&oe=6AB00076"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sid12ibu7gwQ7kNvwHZIAbw&_nc_oc=Ado6srT-s7D3HaDyiwc8t6lU9Clgia31TQzyXxtpQw4AGMVsvgV-P2EkgdjkbEv5_FI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGtQK5wzhphn05VkpH_3prTSOS0cFLn4QjgEefrWp3zA&oe=6AAFFCDF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9DaJORTBesQ7kNvwEmrriL&_nc_oc=AdqNkyeCCS9bZTIx1n2ZzkBwyZAMIa6ENiLwjdKU7BvVXw70Fk9goCzAFkLXRZ7dxW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa8fbtV1MGts53OuYSTGlptKksfKVn8bj5SUFCKIqvTg&oe=6AAFF1BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzl5VcW8MQMQ7kNvwHhxZq4&_nc_oc=AdqxX2pwJEd8hHSP1FAPggDiQG86mkzqmFySHH2jMe3LPPsSRs6SKZwTjeD8bY0V5aM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcpE8bkYuIFGhiMirrXilUzUwIHvSYH8NuNrXpquPyKw&oe=6AAFF74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrKfIHy-jE4Q7kNvwH85GBR&_nc_oc=Adpq4LqCoTn_MsDC1aeuxiTujSNdeMcCWYSi6sMqYdUWCpU8XzSL8ynbobB5Um-bgi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDBE0hfs4HFwwJqen_MiJKc1zoz7CFrTtp5ZbBwueTtQ&oe=6AAFE95A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
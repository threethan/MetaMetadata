092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWOOmBgiDRAQ7kNvwGW8Tpy&_nc_oc=AdoX8Ph07POc59PrJGm25RcGuV1U0Pfx09In0FCvy9-9L3I-wJr4CwuiYeTBtStYSaM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ijz4HtM9PmVA5ql7JtpKTjfAEn53-zgqXsRSd_43wig&oe=69D79236"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v58r0bCWXsgQ7kNvwH5JfeC&_nc_oc=Ado2mj1qw6Ebe1zA175mcqwl60Aqmt_Qh_sf2UwU5TqtvEY3CIIU8lqmDEEb3qJUXkc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28P_wHP1X1RpFVy1gUR345Ptv_CGsfpwgYG9KrSRBBiQ&oe=69D78E9F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkMjOeNL8gMQ7kNvwHmm8AB&_nc_oc=Adqh1Bmq83ZzWT4e2SntxTpPWYrwqZ0TxDGYjBy1VD-hwdgkJ4ruMy4MIiUPzurke6c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05BctTcHCGleGVkJofckLsooIrXcxujghOX2nTZX7AHw&oe=69D7BBBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clv2l-UoUPIQ7kNvwF65D-_&_nc_oc=AdoFEIZ_zQiPxQavX83eLy16_lJhxxLyFzQ07qOGZU0G0_ITe3PEL0Vaw6d-vUBQMSY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eOsUv6N9uvA5zl_XRLKKVFxbDbAou6eYt-9Yrh-gGPA&oe=69D7890F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSKnVWhvUncQ7kNvwHRrCWv&_nc_oc=AdqZGjLIFeWOUqlaNsq5-U1vZPGJL6phI79bwdq8CzR9mLyAU_5PSiBbUhQ7KUgjMsM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_dE5ciOufrMUN1pDhQG68mKQHISNoOw7PxuV76L1fnA&oe=69D7B35A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
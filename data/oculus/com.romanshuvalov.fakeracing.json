092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4ry79mFJ3cQ7kNvwG0sTOw&_nc_oc=Adp2UQQZ_0YQFGAGPfE2u5WGtXzp6prNBGtzG7aj35X5wukMRYkzlDz9EeIoZwol0hc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGE8S656swGmeM-C71XSXMw87BMfOGdkbM7bbFZl2EhA&oe=6AE60DF6"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuPUxa1CGj4Q7kNvwGXvTaM&_nc_oc=AdqwgtGD0gFPce1OOXCGv7BrK5jAV_U7wnHHfntVy8lOQWrE65LIyWdA9SYNqr5w1dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWnk9If83oJic2jYIJsM8aJULkGD88ylSFn83kKmAgVg&oe=6AE60A5F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76jnv2LCdNgQ7kNvwHLomey&_nc_oc=Adoow5oo6KpJtr-Kt6pc7hd0yoFlnFGGq4H-dA_RaWUFu-5-W-PfOg1VglNv9A7Lpig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHwbmYBiHct50Kvv1JvoOn5t2J36t5D9ONE0ngPtJf8g&oe=6AE5FF3F"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkz3ugsBZrAQ7kNvwHSR1Ls&_nc_oc=AdoNG8oGX9YiJjzumA4nuxLGHm6EoPVt6SNupR2WNDzDM9CJaNmbCTMpakDZCZrolx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1nrzdqp6lSM2K7vzPq0S7reYNPVd50fwirYEaQ7L4VA&oe=6AE604CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foJLWNSmFY4Q7kNvwHL5zp4&_nc_oc=AdpmJUXQ1Sp1bAbI2zoxTF9H8JKuVtIJasV13FxCtoSeWxXr1B3501P6-TGSluyGuDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc0QXRa3iHwnqM-mQ7hbnx-_Bbzl4OrkgMeKrcsdiqVg&oe=6AE5F6DA"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
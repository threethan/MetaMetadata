092886928193039_4620138256248405659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFpp9cjhQ0sQ7kNvwHlFtPP&_nc_oc=AdqFEuOa4pQDCzaRGN_tJUDhvfzkbDFes7CwskSPBt9TgD8uvRdsA1hVBRnVKnCUGX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LXIbHw0ChsSavstJTUEOtwW2GMRZkRpyZM4_9dqQsHQ&oe=69FC7C36"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iVxGqIFKUAQ7kNvwGRW3CT&_nc_oc=AdocRM4JmQ8Lhq1UmbgU3xzBhdyUokW4CES5oWc1H0rn0pYWRvDyOseyBWXPyWuqDGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A800rR0vorndlXeiep4bF5GjJ3Tq6c2xLIHWPtRx9og&oe=69FCB0DF"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-T1R-fs0scQ7kNvwHTt1ZN&_nc_oc=Adr6BkDPhVZ65UUwj6-rJVVlLG_Jl0TbLZCRioQI5qdHnz1ZMNULbtZUoSAaVajz1Ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57Lrt-3pLkFjyoMkwgmvP35lkkvmizs7xAM1o96x3e6w&oe=69FCA5BF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcoFBcUhaIsQ7kNvwEE_9K0&_nc_oc=Adr0YjeSCQeu0BRKH278nGbko9YaMQvkHdFW5ZeuYAGklsHWpx9VnsEUTsf-4U3Mkh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cuD5MTEzOTsO_7JkfvFUBmt-NVZCrWCamnZy6RJONWw&oe=69FCAB4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-Ptm9uEbMAQ7kNvwEYUCjm&_nc_oc=AdqvMarr8sEs6M-OnjE41DptlFiT69PFNF_ljtZeU9eTV2E7DSsZ05vCgsUAfE3aIHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P8eGiwIkiS-OvIUk6SzWQ6LSaZ6qQfhjXMD39-OdPIQ&oe=69FC9D5A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173
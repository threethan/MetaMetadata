659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IC2D1Vr5toQ7kNvwGgjXtX&_nc_oc=Adnd1t1ZbzT5Gf6xaHrc_XO11Jd4vBRVyd2XPeMO1EY1s4C-C7ppMYejui0IVfqXO7k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsJ5HHcKUipWpGq0wawqCh7afmehm4RJG8MQid0403rw&oe=69BD3436"}, {"file_name": "s0.png", "id": "877892036238358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86634394_877892039571691_6228032062272308353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PRmzJiMVZUQ7kNvwEFza8T&_nc_oc=AdkRqLx_RUqcEC77_Vo0diIwyMDwkuqTObh4YdL6RejM7gmxxcgUstV3-gLI-AWtUnU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2T0gDE3vxUzYZcBmDBcyt2-yzye1PNWSVxTNeSktvMA&oe=69BD309F"}, {"file_name": "s6.png", "id": "286096096883719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230038_286096100217052_1478435472391227686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWXE15l2ejwQ7kNvwElzw19&_nc_oc=AdlI-iVrzoI2tmC1lH22ccM-KdUdg30Wo2mXRR-KYGMljFOZi2I-XsgBUQP48NlJohU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxxn5kamEQLdXk9GD6dRixkBVvCQW7hb4TC-v3XmoI5VA&oe=69BD5DBF"}, {"file_name": "s7.png", "id": "723704731946394", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580066_723704735279727_1657339152001791804_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je3P7sOREo0Q7kNvwFkMCym&_nc_oc=Adm3egTNBQFIgqAh3O7hLZ2LZp7aa7RfKEzetoJIiyZnguAS7kfOTIYtFZYJ3HQMYcA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzb3Le8tFzeDfyOT0bGCXnlDgjRwjnzT_OYkumuEEHj3A&oe=69BD2B0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-screenshot.png", "id": "342309257413087", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75334061_342309264079753_2615715454138737248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRzhrdDpuR8Q7kNvwF3ywty&_nc_oc=AdkeZPJOHgPyTw4zazJEwtdaZR0g3scc2kY6_14B5g73FD034toszVXIGWdjlceJ3Uc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCqMdIwSj5eP3Od831qsMissD81QYixx3yB1W0GzB5NA&oe=69BD555A"}, "display_name": "Fake Racing", "keywords": [], "long_description": "Fake Racing is an indie racing game with an unusual visual style. \n\nFeatures:\n\n- The monochrome pixelized renderer was created specifically for this game. It uses a custom 3D-dithering shading technique to achieve a retro visual style with one of the three available monochrome palettes. \n- Fake car physics. Non-realistic but fun for casual play.\n- Attack from the Air: compete not only against your opponents, but also against the enemy helicopter. This mode creates an extra challenge for the race leaders, making the race more intense. \n- Four tracks with reverse and mirror options. \n\n\nGame modes:\n\n- Attack from the air;\n- Elimination;\n- Classic race. \n", "short_description": "A retro-style indie racing game with a monochrome pixel graphics and a fake car physics. Features Air Attack and Elimination modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.romanshuvalov.com/fakeracing/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roman Shuvalov", "support_website_url": null, "website_url": "https://www.romanshuvalov.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "ru_UA", "fr", "es", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6598628173552949"}, "review_messages": []}]}, "cover_square_im
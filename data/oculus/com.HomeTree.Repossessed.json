haGXuBVihUdJvvWt7Eahbvq33b8k_qZXSOXnbZfVqkJJ_9HkIbucQD0CA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xFcBxA5aYP1b-DPs4uWl2JWkJWsehbGtlc_NrYhk9zg&oe=6A43D6BB"}, {"file_name": "0086.png", "id": "1772526096633052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823313_1772526099966385_1624786743665672562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzZ6HZiiwxcQ7kNvwEcbOOL&_nc_oc=AdptB-7Aen6V9SuED-UUdttmdq7NVS6uLLmBkLejhdb16JhYBjJWyiwLUdC1Ow9Nw5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9QSInFMsfa22NMXx05_Qk3FpxY9GHUHJCPuyCD4AtRA&oe=6A43CB64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2r9FNF7VbHUQ7kNvwG9f7_l&_nc_oc=AdrYXOC9e7n5b2HWlwbfv8TCd5vDbD3oVksHumSY30A9xWTECbvtIXf5DtG3RIRuTD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WffkOzwr_cMvJL9OmvmMgtcVAt2HvMvXOebaOYwqnAQ&oe=6A43E54A"}, "display_name": "Repossessed", "keywords": ["zombie", "shooter", "multiplayer", "cooperative", "intense"], "long_description": "**Now with Co-Op Multiplayer**\n\nRepossessed is a zombie shooter that has to be seen to be believed. You don't need to keep your distance - with 120fps on the Quest 3 and 90fps on the Quest 2,  experience the terror of the tower up close and personal and become the bullet storm. Just stay agile. Classic zombie rules apply - one bite and you're done.\n\nYou\u2019re working with the last of humanity to clear out the city. \n\nThey thought the world had ended. They thought it was over for humanity. They took almost everything from us. They outnumber us 10,000 to one. But we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm through 32 floors of terror.\n\nNow for wrath.\n", "short_description": "**Now with Co-Op Multiplayer**\n\nRepossessed is a zombie shooter that has to be seen to be believed. With 120fps on the Quest 3 and 90fps on the Quest 2, experience the terror of the tower up close and personal.\n\nYou\u2019re working to clear out these buildings so survivors can have a place to call home. \n\nThey took almost everything from us. They outnumber us 10,000 to one. \n\nBut we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm.\n\nNow for wrath.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "26528440010175721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_1676701586203650_6928268131263644182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA4cJuyfm9kQ7kNvwHryBkb&_nc_oc=Adp9SNvlHiubCCuJBboTtDammgbUYOsyC4Wb3kIMXzykX5MNtVXmlFf8AWyNBUOYplk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97N_KDmVyTDk0SbZd0eas7hI1IYo0IbkSdpRAND8G98A&oe=6A43DD33"}, "is_concept": false, 
905809_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqVe5IRF5jUQ7kNvwGiN4ZI&_nc_oc=AdnqrydYDhT30cwwJCEYEuer21EWCLWo6hBM4ogy5yUrMe6n4VLp6l3vcmCx8-Vc1ZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2WgUsrbYNMH9mYQDR5XVg9k4jUcyyHAhAbpb96_P4WA&oe=69BBD6AC"}, {"file_name": "0005.png", "id": "749418566264453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031418_749418569597786_7260564741490494559_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6swB_ak_qYQ7kNvwHzO_aA&_nc_oc=Adksg9HA3FkRsBS818tmvhFky3qIehZ3XU7Q2OqhaNBKeSmvyiADBdQVnRrOtonwrJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlwxjJn_P4EajEyMJeccd0y4bZSuXzqeDFLxUmlh_wqg&oe=69BC0AF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z9NYS80mYEQ7kNvwFw4wQW&_nc_oc=AdnCkYEMZmDxgi08laV-dRdi6VkMaf2nDjiezKkd4qrITcAFM5ntj5gQSOlOgkbWLvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxD0ceIVSlLd5cG6gazHZGi6uzyLXQ_kUGkm1ydlgGiWA&oe=69BBE28A"}, "display_name": "Repossessed", "keywords": [], "long_description": "I shouldn't be massively surprised that real estate work survived the end of the world.\n\nThat's what this is, right? Real estate? Because it's time to expand back out into the wasteland, to take back the tower blocks that have been overrun with who knows what. I go in, clear the place out, and we flip it for a tidy profit - sell it to some survivors so they can turn it into a new tomorrow.\n\nSure, there's more to it than that. I'm on my own for starters. And there's got to be a reason nobody ever tried to repossess a building this big before. \n\nOh yeah, and that other thing. One bite, that's all it takes. One bite, I'm done. \n\nSo yeah. World ended. Boo hoo. You want to lament something, the fact that the world ended and I'm still stuck in a dead end job. \n\nCould be worse. Repossession agents at least have a chance to make it big.\n\nAnd those hellspawn devils have about a thousand chances to stop us.\n\nReal estate can be hell. ", "short_description": "Real estate is hell in the apocalypse. \n\nWhen the end came, we weren't that surprised. The way things had been going, what kind of difference was the end of the world going to make, right? \n\nBut now we're fighting back, and we've got a foothold. The survivors need need more room to live, to grow food, to... survive. So it's time to serve some eviction notices on the things that go bump in the night. \n\nAs a repossession agent your job is to clear out the building and get it ready. Don't get bit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "383034783811922"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "503519582755810"}, {"status": "PUBLISHED", "id": "430771219225680"}, {"status": "PUBLISHED", "id": "403186255277213"}, {"status": "PUBLISHED", "id": "796506735712876"}, {"status": "PUBLISHED", "id": "286753367194894"}
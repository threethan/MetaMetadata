vwHU8W5X&_nc_oc=AdpsFgGxD6CVbnEY5Y401RQKsuaDQ2ZkXgfRNehtpCM27CoguC65mvApeGGGqwoPR6g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ47W126cb8_CzhpsULjXwsqqg6DnEOalbEoKIzkzboow&oe=6AFB45CB"}, {"file_name": "0004.png", "id": "332396649108147", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982497_332396662441479_465731897806905809_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPUhxsfgiF4Q7kNvwGUIvDD&_nc_oc=Adp-qBZokhVDIlucP9Vtkp6SKsXWM9KzJ1CSFZ3Yz6bW4K2yGZFdrCw9iHCH2Vp-Yow&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJt-95j5MzwkyFpifCS1aD1qMM0G45l_XINyw1YERufg&oe=6AFB19EC"}, {"file_name": "0005.png", "id": "749418566264453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031418_749418569597786_7260564741490494559_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbtbgOdsyYsQ7kNvwGwezOr&_nc_oc=AdoMNaP_B2J0Z3nIzlYDEdi7RJhLzxEYAQgj_7UjCQeUHx6Mw3S3MnlY4OXf4p9-0gw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjLNbf1ZBOFws2HCmkMwJrMvFJ9XdstPUCvAnf1QtRnw&oe=6AFB15F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq0PFSrl9ZkQ7kNvwEALRor&_nc_oc=Adqx1i9ey6YRp1vEBnE9Fc8rKynLCzmiAXOtvw3i5XEH69AJIa0-okr9iQBLI6VYS6s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTerLGbYG9qt-S8xoM6e7g8gRdnYODOJsPTEpBe2Iw9ow&oe=6AFB25CA"}, "display_name": "Repossessed", "keywords": [], "long_description": "I shouldn't be massively surprised that real estate work survived the end of the world.\n\nThat's what this is, right? Real estate? Because it's time to expand back out into the wasteland, to take back the tower blocks that have been overrun with who knows what. I go in, clear the place out, and we flip it for a tidy profit - sell it to some survivors so they can turn it into a new tomorrow.\n\nSure, there's more to it than that. I'm on my own for starters. And there's got to be a reason nobody ever tried to repossess a building this big before. \n\nOh yeah, and that other thing. One bite, that's all it takes. One bite, I'm done. \n\nSo yeah. World ended. Boo hoo. You want to lament something, the fact that the world ended and I'm still stuck in a dead end job. \n\nCould be worse. Repossession agents at least have a chance to make it big.\n\nAnd those hellspawn devils have about a thousand chances to stop us.\n\nReal estate can be hell. ", "short_description": "Real estate is hell in the apocalypse. \n\nWhen the end came, we weren't that surprised. The way things had been going, what kind of difference was the end of the world going to make, right? \n\nBut now we're fighting back, and we've got a foothold. The survivors need need more room to live, to grow food, to... survive. So it's time to serve some eviction notices on the things that go bump in the night. \n\nAs a repossession agent your job is to clear out the building and get it ready. Don't get bit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
file_name": "repossessed_smaller_myversion-cover-landscape.png", "id": "371115894940362", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031501_371115898273695_5578890640714060090_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dc4tuVkupYoQ7kNvwG1nKZi&_nc_oc=Adlz0m6j4h1sWPaAKFAnne5c9MOc2j_YYVl3EWcYlV-AnFQnFVcSsltHXbM5XS196Bo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIl5e_xzCJ1czThBQedOPHGKO62TKaKJi2lxmHaJTIPQ&oe=69BD2D65"}]}, "id": "494520675805795", "locale": "en_US", "screenshots": [{"file_name": "0001.png", "id": "357849273179815", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031458_357849276513148_8324369993422630384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7T4B26oqqEQ7kNvwGyRmjm&_nc_oc=AdljsIcGI46uTmLRnaPr9_cMcCI4cbdM2g3IfS9IzGQ0hTU-3nXXWkuJic_n-00g5mk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlbbpPT4kA19l--TqSdm0DRIHqIbeujbqlU8vzF06dQw&oe=69BD5AF6"}, {"file_name": "0002.png", "id": "3461616784072834", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974892_3461616787406167_6783154251052134895_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Au6gb0KE3oAQ7kNvwGe9zlA&_nc_oc=AdnKyNLjcOYnGwEh90SL8zzfE27S7T927MPMtQzIX7VP8gEPnp0aT4v0oksOmyHeT6Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoJAa8coot3QSvSUJDNGM_fPYpnXP7ivn2vhID7EsEHg&oe=69BD3952"}, {"file_name": "0003.png", "id": "460607305417006", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974457_460607308750339_4245462827521183531_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntI9pChJu28Q7kNvwE7HI_Q&_nc_oc=Adn7xcINGKrDBtrJArF5QORYX7T5_AjohLvEK8It3uEV809EAnthTAZ_wcaMcguALeA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSwwk0m1ubm05ImmSoIFOJRcBXcaMag-gEI7T0tRM-ng&oe=69BD540B"}, {"file_name": "0004.png", "id": "332396649108147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982497_332396662441479_465731897806905809_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqVe5IRF5jUQ7kNvwGXi59X&_nc_oc=AdnmVwYp0DZXZgXwXkDLOzvzd87GIJml_EJXkD2CxMR-N6EDCeaSkhp0mOK-M0V3twU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFFoyO6bnxD9vP-fkhCPO-VmhJ_eMdWuFgi1xq8Zk-Yw&oe=69BD282C"}, {"file_name": "0005.png", "id": "749418566264453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031418_749418569597786_7260564741490494559_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6swB_ak_qYQ7kNvwGvfvA5&_nc_oc=Adn2VotXJAPcyauZpWeCeAOIiwrYt8m0jcQ1e-RTCFr9-3cjUf5ZJHBenoW86EtqKAU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX01rnI3bVYkwEqUvwrBbd9RM8etw2QQc20oh12w7D5g&oe=69BD5C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxZWlsHQhBkQ7kNvwFXOx6h&_nc_oc=AdlYnL3rtANEQi6MTHR3714VuWNyRDnog1fFglvtxKfVUzSrWtquwI8wf8TN30p4iEY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfykTkIii0WERmBSLuiq_don3FVoUIUHWK_YtKQ21y7bdw&oe=69BD340A"}, "display_name": "Repossessed", "keywords": [], "long_description": "I shouldn't be massively surprised that real estate work survived the end of the world.\n\nThat's what this is, right? Real estate? Because it's time to expand back out into the wasteland, to take back the tower blocks that have been overrun with who knows what. I go in, clear the place out, and we flip it for a tidy profit - sell it to some survivors so they can turn it into a new tomorrow.\n\nSure, there's more to it than that. I'm on my own for starters. And there's got to be a reason nobody ever tried to repossess a building this big before. \n\nOh yeah, and that other thing. One bite, that's all it takes. One bite, I'm done. \n\nSo yeah. World ended. Boo hoo. You want to lament something, the fact that the world ended and I'm still stuck in a dead end job. \n\nCould be worse. Repossession agents at least have a chance to make it big.\n\nAnd those hellspawn devils have about a thousand chances to stop us.\n\nReal estate can be hell. ", "short_description": "Real estate is hell in the apocalypse. \n\nWhen the end came, we weren't that surprised. The way things had been going, what kind of difference was the end of the world going to make, right? \n\nBut now we're fighting back, and we've got a foothold. The survivors need need more room to live, to grow food, to... survive. So it's time to serve some eviction notices on the things that go bump in the night. \n\nAs a repossession agent your job is to clear out the building and get it ready. Don't get bit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "383034783811922"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "503519582755810"}, {"status": "PUBLISHED", "id": "430771219225680"}, {"status": "PUBLISHED", "id": "403186255277213"}, {"status": "PUBLISHED", "id": "796506735712876"}, {"status": "PUBLISHED", "id": "286753367194894"}
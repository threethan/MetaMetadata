lCKysKAsDG-6qGUzTX-efnohll-j4MLr9pKed7Z1kTuC4YKoYNNxbgxE7x2RZESyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybTc0SPMExN9EByNGpn70JtNOrmtOoONfxgUBxyucqNg&oe=69B0009D"}, {"file_name": "0079.png", "id": "710070271733823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818885_710070275067156_458200343592169440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rlSsA0rQtAQ7kNvwEUJqm0&_nc_oc=Adn_8uqxWDiZskBpcC1gq-FmyCGVaejwl2RCvH5idCWg_u5Rt6yv41E2xhZanTanD20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyC8VElwnAh5-xa8HeETnr0fJCuwnqnZZ84MOB0o9F7zA&oe=69AFF67B"}, {"file_name": "0086.png", "id": "1772526096633052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823313_1772526099966385_1624786743665672562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qVrWc7cV8wQ7kNvwHTciO2&_nc_oc=Adk8kVwLc5Fr1t_WCju112DEuob02DjY23l8QbCgi06oqVBMxfuC6GsP6prLBBFqynA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzweTJ4RmPQsA517wmR6oaVeJfECp3DncK66US-8PdDA&oe=69B02364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jRtVeZ8q40Q7kNvwGo-JuG&_nc_oc=Adm5VZFp0hFsEH4Ct_4mx9FTLAMoazErtLbins8NZ7tI5zztMuKCfNbirv-98jrzYxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFFvv8oZbUdx2MzlxL-ceSLLVXwnVWnDd-ImQOy3uLWg&oe=69B0050A"}, "display_name": "Repossessed - 120hz Zombie Shooter", "keywords": ["zombie", "shooter", "horror"], "long_description": "Repossessed is a zombie shooter that has to be seen to be believed. You don't need to keep your distance - with 120fps on the Quest 3 and 90fps on the Quest 2,  experience the terror of the tower up close and personal and become the bullet storm. Just stay agile. Classic zombie rules apply - one bite and you're done.\n\nYou\u2019re working with the last of humanity to clear out the city. \n\nThey thought the world had ended. They thought it was over for humanity. They took almost everything from us. They outnumber us 10,000 to one. But we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm through 32 floors of terror.\n\nNow for wrath.\n", "short_description": "Repossessed is a zombie shooter that has to be seen to be believed. With 120fps on the Quest 3 and 90fps on the Quest 2, experience the terror of the tower up close and personal.\n\nYou\u2019re working to clear out these buildings so survivors can have a place to call home. \n\nThey took almost everything from us. They outnumber us 10,000 to one. \n\nBut we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm.\n\nNow for wrath.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10099226356857013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982555_1676701586203650_6928268131263644182_n.png?
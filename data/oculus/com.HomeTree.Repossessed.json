Ies5yuN91KeveWGO1Oj2Qhq9oAhY_sEdI0Yj8RwAIGD8YxoArM4Gb6MyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14LQbLjEoyhcULmerVaRFTSQU-wzgEC94mxpglHUvB-w&oe=69E4EABB"}, {"file_name": "0086.png", "id": "1772526096633052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823313_1772526099966385_1624786743665672562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O41ZfPYFJOcQ7kNvwGH6OTe&_nc_oc=AdpxZFxyq-Yj7haNGLdcmd8n1nEPk6JnMnKzTA99T5f_oHlMOFomTiB-RC8bhLwZvlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NlBotCABIPubof7ld7H3x6Sd3cL6XSGGAq7wTvTlLrg&oe=69E4DF64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUmw7iBdTQsQ7kNvwEqrnmm&_nc_oc=AdoM_P807adlGW7eSXLqV80dwnFZJxbe2ek4JAuhqoZFOgQcqYkJUq49q1wSzqcM6Lw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16dv7gP3zCK3KOsXsSL-cO5RV9K-JulpSwXRetpoRLOQ&oe=69E4C10A"}, "display_name": "Repossessed", "keywords": ["zombie", "shooter", "multiplayer", "cooperative", "intense"], "long_description": "**Now with Co-Op Multiplayer**\n\nRepossessed is a zombie shooter that has to be seen to be believed. You don't need to keep your distance - with 120fps on the Quest 3 and 90fps on the Quest 2,  experience the terror of the tower up close and personal and become the bullet storm. Just stay agile. Classic zombie rules apply - one bite and you're done.\n\nYou\u2019re working with the last of humanity to clear out the city. \n\nThey thought the world had ended. They thought it was over for humanity. They took almost everything from us. They outnumber us 10,000 to one. But we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm through 32 floors of terror.\n\nNow for wrath.\n", "short_description": "**Now with Co-Op Multiplayer**\n\nRepossessed is a zombie shooter that has to be seen to be believed. With 120fps on the Quest 3 and 90fps on the Quest 2, experience the terror of the tower up close and personal.\n\nYou\u2019re working to clear out these buildings so survivors can have a place to call home. \n\nThey took almost everything from us. They outnumber us 10,000 to one. \n\nBut we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm.\n\nNow for wrath.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "26528440010175721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982555_1676701586203650_6928268131263644182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lblkx7XPHoMQ7kNvwGDJFOq&_nc_oc=AdpVUkrbgXoIpduGWlZgO-UVDSbPVX4pB7aUJm94b1idKzCsx9561ZZb2VY33iMU6U8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WdF85S-WBYIPri9pk3nVEWhXXLEfJItr6ECNQJNdJDw&oe=69E4B8F3"}, "is_concept": false, 
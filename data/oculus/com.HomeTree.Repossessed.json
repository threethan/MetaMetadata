vwG9hmAL&_nc_oc=AdqB6vmjeMPo19NYfl5Rh9K2AFuM0JY39a5jV1IyJJ3Gr4A6AMVutVtWsZyv0I-eP18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjBmgwvRruIUynQ2_kDwU8dDmRDIT7ymOO-Yy68kjD9A&oe=6AFDB08B"}, {"file_name": "0004.png", "id": "332396649108147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982497_332396662441479_465731897806905809_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPUhxsfgiF4Q7kNvwFGjKG2&_nc_oc=AdqNlb35la9Xs3nUyQ-k1r5goS-ZFGShiKmDfJ7YEipcYmSX09svZRLTwDqphfIS_DQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnNo_Q5tfncE-lkFLjv1AyGkiaHcGNsw0lhcGczgthPg&oe=6AFDBCEC"}, {"file_name": "0005.png", "id": "749418566264453", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031418_749418569597786_7260564741490494559_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbtbgOdsyYsQ7kNvwHBVuGJ&_nc_oc=Adp5QArLqN-sNNmZVjQdQ44S23M7Ahb55SSBtdWnOy5iXssnlfmYawWCWJB78NgH3VQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpnT7NWIzaNHgYU5ASSi27sgGhXUUZmBZ9Au-3d254Jg&oe=6AFDB8F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq23Q42iwEkQ7kNvwHk1iuA&_nc_oc=AdrUY8LyCD0iGgfQIwDU46xAOJd5_71LCCo4BjhGGUjiZXDydRLFO6GJZ8FmS0nRobU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Q2GQirvbfTG_nxrXfkR0X3ECWTRX3heA8H8fjmS9Kg&oe=6AFDC8CA"}, "display_name": "Repossessed", "keywords": [], "long_description": "I shouldn't be massively surprised that real estate work survived the end of the world.\n\nThat's what this is, right? Real estate? Because it's time to expand back out into the wasteland, to take back the tower blocks that have been overrun with who knows what. I go in, clear the place out, and we flip it for a tidy profit - sell it to some survivors so they can turn it into a new tomorrow.\n\nSure, there's more to it than that. I'm on my own for starters. And there's got to be a reason nobody ever tried to repossess a building this big before. \n\nOh yeah, and that other thing. One bite, that's all it takes. One bite, I'm done. \n\nSo yeah. World ended. Boo hoo. You want to lament something, the fact that the world ended and I'm still stuck in a dead end job. \n\nCould be worse. Repossession agents at least have a chance to make it big.\n\nAnd those hellspawn devils have about a thousand chances to stop us.\n\nReal estate can be hell. ", "short_description": "Real estate is hell in the apocalypse. \n\nWhen the end came, we weren't that surprised. The way things had been going, what kind of difference was the end of the world going to make, right? \n\nBut now we're fighting back, and we've got a foothold. The survivors need need more room to live, to grow food, to... survive. So it's time to serve some eviction notices on the things that go bump in the night. \n\nAs a repossession agent your job is to clear out the building and get it ready. Don't get bit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
kgABv7Tex4XTevNIpVBnQcYxzZZgQHApcX7M6dNLqUXEPqCB0IxV1TBjIqRYqaXBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1OxtLkpmQ8JHqfW5p7jl7HrEQYRsP-tStzRSd8H7oRg&oe=69B93B1D"}, {"file_name": "0079.png", "id": "710070271733823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_710070275067156_458200343592169440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqfmVropW3oQ7kNvwFCkQrP&_nc_oc=Adms2iTxjvV5cq1V0-c-5Ds1e_wQWSqggdZ4AMTOv8d-iDV4zKP2lw3XcjpF9YwOhYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfsKNxaxY9o1-NJ4lW3CG-f09IMAAeHjNbKSKkF9F8tw&oe=69B930FB"}, {"file_name": "0086.png", "id": "1772526096633052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823313_1772526099966385_1624786743665672562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TPGCc8svZEQ7kNvwETd9HP&_nc_oc=AdkmunDUcemwR8yTb8nue8kzwhSpcRl8jUbD7lwd7ePaFsdr0Uyk65sxCmyWP6LxQm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwS5f6Zul4R0u_i5PXZtp0AXZuRRTk6uyw4hUL_njNPlA&oe=69B95DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z9NYS80mYEQ7kNvwERtEYk&_nc_oc=AdkW-_7EuOC2O_VurGb6XQ8yvfzlVARB08fbKWdA2uIZtFaXCpVq_-DN3FZAzyIsL30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzuXHDB07QZbH2tYDZXiyC2zT8thbRKkRrsOuDfEOoOg&oe=69B93F8A"}, "display_name": "Repossessed - 120hz Zombie Shooter", "keywords": ["zombie", "shooter", "horror"], "long_description": "Repossessed is a zombie shooter that has to be seen to be believed. You don't need to keep your distance - with 120fps on the Quest 3 and 90fps on the Quest 2,  experience the terror of the tower up close and personal and become the bullet storm. Just stay agile. Classic zombie rules apply - one bite and you're done.\n\nYou\u2019re working with the last of humanity to clear out the city. \n\nThey thought the world had ended. They thought it was over for humanity. They took almost everything from us. They outnumber us 10,000 to one. But we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm through 32 floors of terror.\n\nNow for wrath.\n", "short_description": "Repossessed is a zombie shooter that has to be seen to be believed. With 120fps on the Quest 3 and 90fps on the Quest 2, experience the terror of the tower up close and personal.\n\nYou\u2019re working to clear out these buildings so survivors can have a place to call home. \n\nThey took almost everything from us. They outnumber us 10,000 to one. \n\nBut we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm.\n\nNow for wrath.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10099226356857013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_1676701586203650_6928268131263644182_n.png?
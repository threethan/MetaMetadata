=scontent-ord5-1.oculuscdn.com&oh=00_Afu1I1TYlWuJ1kD_2xneHvMF0aXH7sfaoIyl-Abv9YQ7AA&oe=699AE89D"}, {"file_name": "0079.png", "id": "710070271733823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_710070275067156_458200343592169440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6LYahFAJiwQ7kNvwGXl_4v&_nc_oc=AdmLiqDSoHaVur54s4Obz1e2pBe10Quoe8GlfGZ7SzC70S--cQb0WGOqGMgTBlIr_os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu96PexKbhTaZvK3PmHB0YFmOb1LezL33Uquq0q8Z8GSw&oe=699ADE7B"}, {"file_name": "0086.png", "id": "1772526096633052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823313_1772526099966385_1624786743665672562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBJTFqA9ktgQ7kNvwEcwmrW&_nc_oc=AdnBb-a1xBNjnv6qjmKDHDCLxh3cuaF8dsYZZ6fbCi_8lxOV7fnChCU0a6Gny6DKBoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu3-qLjEsG3b_avJujN4aQ4Xr8s6VBAhiP0ecG0uVXpvA&oe=699B0B64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miWUPjTrN90Q7kNvwG-XRmo&_nc_oc=AdktIE_gN0cSE4lnOI-POcN1fGnlsNNjiWJYmVqiobnrYMHy5CkRHmgMzAtOy_IkLig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuCf4toG4ZyFbeLhghYLsuoGXLpogZ_MFYhwBPIBWSDjg&oe=699AED0A"}, "display_name": "Repossessed - 120hz Zombie Shooter", "keywords": ["zombie", "shooter", "horror"], "long_description": "Repossessed is a zombie shooter that has to be seen to be believed. You don't need to keep your distance - with 120fps on the Quest 3 and 90fps on the Quest 2,  experience the terror of the tower up close and personal and become the bullet storm. Just stay agile. Classic zombie rules apply - one bite and you're done.\n\nYou\u2019re working with the last of humanity to clear out the city. \n\nThey thought the world had ended. They thought it was over for humanity. They took almost everything from us. They outnumber us 10,000 to one. But we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm through 32 floors of terror.\n\nNow for wrath.\n", "short_description": "Repossessed is a zombie shooter that has to be seen to be believed. With 120fps on the Quest 3 and 90fps on the Quest 2, experience the terror of the tower up close and personal.\n\nYou\u2019re working to clear out these buildings so survivors can have a place to call home. \n\nThey took almost everything from us. They outnumber us 10,000 to one. \n\nBut we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm.\n\nNow for wrath.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10099226356857013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_1676701586203650_6928268131263644182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPVeY68BwWsQ7kNvwFMBiia&_nc_oc=AdnlMcR72vr15clbTTCX_v
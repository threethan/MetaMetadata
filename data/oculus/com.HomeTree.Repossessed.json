=scontent-iad3-1.oculuscdn.com&oh=00_AfsUs4Q_dllmlXR1ro0GOtaRJTO7_LehbnYnYLXNRMS9hA&oe=6999971D"}, {"file_name": "0079.png", "id": "710070271733823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_710070275067156_458200343592169440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6LYahFAJiwQ7kNvwFpcnmP&_nc_oc=AdnU1rzyYsUMRifnrGKEXjHMZL3z0ngC5Rtsb17dOX2l2gWeNtMkA2c-pGPZ4UcESJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJnW_J4lfg6bdR5eyEHhgQoffCZ7E09weO6ujaQ8TecQ&oe=69998CFB"}, {"file_name": "0086.png", "id": "1772526096633052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823313_1772526099966385_1624786743665672562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBJTFqA9ktgQ7kNvwFWzK1v&_nc_oc=AdlaFBTpM8h6X8peLn5IbU3iAZOV-dfD6YfH1CQ7YOSHD1A20KRHUvTgS8SQqkTa-6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQb--saZxr4zPkGSe2TP5xiUoVv26D9y1cjlWiLP1NLQ&oe=6999B9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miWUPjTrN90Q7kNvwHg54Sh&_nc_oc=AdlW6g42qkLQIVmld7kw8nwWMZY3lTrpbiTixcIA8OQodvm13ED-Q4pNyBzE-QB15B0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucyrWO5kCl7iqEzaGoYPUmQ5BmiD5yXz2_nF_cVdSxzg&oe=69999B8A"}, "display_name": "Repossessed - 120hz Zombie Shooter", "keywords": ["zombie", "shooter", "horror"], "long_description": "Repossessed is a zombie shooter that has to be seen to be believed. You don't need to keep your distance - with 120fps on the Quest 3 and 90fps on the Quest 2,  experience the terror of the tower up close and personal and become the bullet storm. Just stay agile. Classic zombie rules apply - one bite and you're done.\n\nYou\u2019re working with the last of humanity to clear out the city. \n\nThey thought the world had ended. They thought it was over for humanity. They took almost everything from us. They outnumber us 10,000 to one. But we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm through 32 floors of terror.\n\nNow for wrath.\n", "short_description": "Repossessed is a zombie shooter that has to be seen to be believed. With 120fps on the Quest 3 and 90fps on the Quest 2, experience the terror of the tower up close and personal.\n\nYou\u2019re working to clear out these buildings so survivors can have a place to call home. \n\nThey took almost everything from us. They outnumber us 10,000 to one. \n\nBut we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm.\n\nNow for wrath.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10099226356857013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982555_1676701586203650_6928268131263644182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLVWA8R_aXQQ7kNvwHxAEy3&_nc_oc=AdknTX53es7hUTlaZf432r
culuscdn.com&_nc_ss=7f20f&oh=00_Af1PE-eZW7kVV_AvVYshjj8lYEx33CYQ956BGGYlkoB8Xw&oe=69F219BB"}, {"file_name": "0086.png", "id": "1772526096633052", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823313_1772526099966385_1624786743665672562_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WjujdYQkLgQ7kNvwGk67tZ&_nc_oc=Adqr8BpYqQRGl-folcGxq8VtSmadEzdw-_UZ9e9zFM-cdsTvWA9UcYrMjnFQRu8V4xM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1hMXhej_mO3iqkNITlYjcft80HYH7UTTEMSGV3BONZPg&oe=69F20E64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aeZqYtwDToQ7kNvwEatjXY&_nc_oc=AdpR4I2NCekyS5Nt1_r8SDm9gdU_vlyEXOTouRs6YnmUW5aaqPPrzHLt6WQRKUt3Pnk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bueeZEtzvMWzTJ2pGNURbeoPzTVuedSdw1_hnQ2XK8g&oe=69F1F00A"}, "display_name": "Repossessed", "keywords": ["zombie", "shooter", "multiplayer", "cooperative", "intense"], "long_description": "**Now with Co-Op Multiplayer**\n\nRepossessed is a zombie shooter that has to be seen to be believed. You don't need to keep your distance - with 120fps on the Quest 3 and 90fps on the Quest 2,  experience the terror of the tower up close and personal and become the bullet storm. Just stay agile. Classic zombie rules apply - one bite and you're done.\n\nYou\u2019re working with the last of humanity to clear out the city. \n\nThey thought the world had ended. They thought it was over for humanity. They took almost everything from us. They outnumber us 10,000 to one. But we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm through 32 floors of terror.\n\nNow for wrath.\n", "short_description": "**Now with Co-Op Multiplayer**\n\nRepossessed is a zombie shooter that has to be seen to be believed. With 120fps on the Quest 3 and 90fps on the Quest 2, experience the terror of the tower up close and personal.\n\nYou\u2019re working to clear out these buildings so survivors can have a place to call home. \n\nThey took almost everything from us. They outnumber us 10,000 to one. \n\nBut we have a plan.\n\nIt\u2019s you.\n\nUpgrade your character, max out your stats and become the bullet storm.\n\nNow for wrath.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "26528440010175721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982555_1676701586203650_6928268131263644182_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qo2hutK31kQ7kNvwFZna7p&_nc_oc=AdrdgmTTl0Vc9J9UlCGV-Pjj93TDBYUmxqy3LLbb0uUKAFvgQ2gtFj8AVnO2CpRZc6w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IR1-HIPfB5ur_4O9JQ6L5ZXRJaFIFt5xsBJ48B5t8jA&oe=69F1E7F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Repossessed", "platform": "ANDROID_6DO
, "screenshots": [{"file_name": "0001.png", "id": "357849273179815", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031458_357849276513148_8324369993422630384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCSLKWD8dkAQ7kNvwErM0Dz&_nc_oc=AdpHVh8QfChp30I5FElxyEjl_D02Pp_BjIDasjEgwY-sQ47RvCQvHUAWchFIKj_3Jmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhtCv8uAtoSz14ldlRAUzwXWyaSrjiVJwCta6nNONn1A&oe=69CA89F6"}, {"file_name": "0002.png", "id": "3461616784072834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974892_3461616787406167_6783154251052134895_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGNS7i07a4QQ7kNvwHXt0s2&_nc_oc=AdqrUnoNTO4V_TulmhR4ww59D5-HpbrmKkrdH2WjGv93evSuU-QKsAk8I0jb81CQsS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiJT5tttM2khviozYiSyn288kUDBt2XVRgwqPU28FfSQ&oe=69CA6852"}, {"file_name": "0003.png", "id": "460607305417006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974457_460607308750339_4245462827521183531_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgtjpOEgTK0Q7kNvwH8dp5X&_nc_oc=Adovf7RfNQdzp6-A3sn9jo1W6xepZYdU92LCFEgA2US2erlR722KeHeh-P2SqSdMmvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvvwxkHjX_jrxDpMkUuWtM4RKwQRY47p7Dlc-sE8JytQ&oe=69CA830B"}, {"file_name": "0004.png", "id": "332396649108147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982497_332396662441479_465731897806905809_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqJF8PX9s5oQ7kNvwHpEtcs&_nc_oc=AdqqozyYwNpw_fuQw3EqNdjgdKSZPqc4C3qEztUZj1uYBFlTw3qXLdf02BZ9770xvwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgDuxQmV5kFDZ-LmGVE0bhBSgb18dzhYYW76fC-ylv3A&oe=69CA572C"}, {"file_name": "0005.png", "id": "749418566264453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031418_749418569597786_7260564741490494559_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK2jf25401IQ7kNvwFb8L_t&_nc_oc=AdrpQcbxrY1lHR7827MA5nzZHgZnW9EBKqeOdRYh5OJiUYPdJJWPabb0_b4sWVgSfrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxju2c1WxdGxrJndFomEkUxrKk4dYdqt_IYROr5uGkrcw&oe=69CA8B74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0006.png", "id": "1242984236510404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974584_1242984239843737_964058233155106386_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3D1tZK0yC8Q7kNvwHUB4IX&_nc_oc=Adqb_8MU_6nm7QJ-iHJAXrFOGWcIT8uctfe9-_bAgpfkYuOuNbI1JSZiVMg1eGz0hsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPjXaL8Rhyyj42vBqdCyg8M2RIevrjZftgpqKk5vzjgA&oe=69CA630A"}, "display_name": "Repossessed", "keywords": [], "long_description": "I shouldn't be massively surprised that real estate work survived the end of the world.\n\nThat's what this is, right? Real estate? Because it's time to expand back out into the wasteland, to take back the tower blocks that have been overrun with who knows what. I go in, clear the place out, and we flip it for a tidy profit - sell it to some survivors so they can turn it into a new tomorrow.\n\nSure, there's more to it than that. I'm on my own for starters. And there's got to be a reason nobody ever tried to repossess a building this big before. \n\nOh yeah, and that other thing. One bite, that's all it takes. One bite, I'm done. \n\nSo yeah. World ended. Boo hoo. You want to lament something, the fact that the world ended and I'm still stuck in a dead end job. \n\nCould be worse. Repossession agents at least have a chance to make it big.\n\nAnd those hellspawn devils have about a thousand chances to stop us.\n\nReal estate can be hell. ", "short_description": "Real estate is hell in the apocalypse. \n\nWhen the end came, we weren't that surprised. The way things had been going, what kind of difference was the end of the world going to make, right? \n\nBut now we're fighting back, and we've got a foothold. The survivors need need more room to live, to grow food, to... survive. So it's time to serve some eviction notices on the things that go bump in the night. \n\nAs a repossession agent your job is to clear out the building and get it ready. Don't get bit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hometreestudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Home Tree Studio Ltd", "support_website_url": null, "website_url": "https://www.hometreestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "383034783811922"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "503519582755810"}, {"status": "PUBLISHED", "id": "430771219225680"}, {"status": "PUBLISHED", "id": "403186255277213"}, {"status": "PUBLISHED", "id": "796506735712876"}, {"status": "PUBLISHED", "id": "286753367194894"}, {"status": "PUBLISHED", "id": "520145233201599"}]}, "baseline_offer": {"id": "503519582755810"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737710460, "status": "PUBLISHED", "id": "503519582755810"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26520041217682267", "version": "1.1.80"}, "id": "583915903089700", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename":
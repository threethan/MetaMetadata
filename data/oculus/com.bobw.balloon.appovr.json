25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dY10o52v6IQ7kNvwENcm29&_nc_oc=Adr_seo96YMUNYbmUZd4DUG95SH_J72KokxPuyTjYAZY5ne_i2Ff8gf7VTzx3lHrfdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYZ55yTmbQ61NHWP1frPMaRAbxF6Nzh9wW22M500ke4g&oe=69C9046A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPbSEp9CGngQ7kNvwHRz-YJ&_nc_oc=AdoC8P3DGkOhS9zB7XyQ0FcKyEpcSP_YAgo46hJEQSeNON755G85uisaT0tbkL7L75Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyE8cCZjz3KWgHQkpA9stZgoOMHCNA2yHexW2RQaCQhw&oe=69C93446"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVTElnZvY4sQ7kNvwHMY6Yo&_nc_oc=AdrSVHdQs_MBXK4WOY3mQZwn8GHtA6haZXmsws2GcoL9AJK1e5-13MYRZhLwhYvVxPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYdSWiTESxFoqoYRjeuyLHMpF55cmGisTlGFfwyphKEA&oe=69C90B6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLIOdD-zIfUQ7kNvwFlWeVc&_nc_oc=AdoiGJ0dy9LVqGi-QwBl_9LiDSwBv-m_GTRv7cti-H9uIbl0rve-mZcXSDhnEz7Fk3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhVNbZh5yytaSqhQN1AR_rwpOT29iSgvkRXuadSXQX2g&oe=69C90BBC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhWnhOJr4DwQ7kNvwFI-ZC-&_nc_oc=AdqJWayjuNLisTMxJwt_ple0xoA1xFhGaiKLI88BLsKLMjTJguQbjmM7c-94Ggw35vI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyuu6z9dvF0tHsUv-wejwS78JA_nJF3rYDUoxGpzpulhw&oe=69C912FF"}, "is_concept": false, "is
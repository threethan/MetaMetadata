25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjPh0cWQX0YQ7kNvwEeXmJH&_nc_oc=Adqzp9akhaWtiDnD78y2K2siS0OPfNTR1oCpA-Lcdrp1fz84OERAaNyXkplKTWmWuIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyisWyAyg-HuzIPoG_Uz8QNLXbEZ5ej_PEbYzKeXrWXkQ&oe=69CFD42A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrUHeYsptFEQ7kNvwEUC5DV&_nc_oc=Adr4TqOec-NAGHTrdMfAcVVL22TZalXmC-hkBJANgJAKtqHKt52XoGmDkYM0ppD5oFw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1k5EjCj5miQSlhWOD_0kbYVQhhdx-ChpvfBKQRJv6NA&oe=69CFCBC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6E-teilBisQ7kNvwE7hPon&_nc_oc=AdqduueQqI_eAxQQGuCzzmqAto5qYOH41Ige0Rb-q6v7t3Kvr4RBZDajd4RiET1FbFM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2lQNdjNKLQZp2qDPSCwpe65HZMbNDUXwdyCMvdI4Qog&oe=69CFA2EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S02nBQ93xfwQ7kNvwGx9DhW&_nc_oc=AdrF2_ukP95UmtjXDx97uMZ3YVJTioLkG9Awp6Tv6UfIVGQbLJPE9wpVF_Xc73JLiac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbbLCTTMzCmY0YEw9YvnxN_qCONmZHKkjMcaAsYQQNEw&oe=69CFA33C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXPeSGZm0JYQ7kNvwHY8VXh&_nc_oc=Ado3SdlIIxmnxx1a_7l3BOz2IZloMA7BBKJxipT2NLhAMTx5aJokrMTpMiuDNCfFfs0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCt-aRXWWKXrSX9VKBL-QDcL70TRwCS8YMNKOG6NxuGQ&oe=69CFAA7F"}, "is_concept": false, "is
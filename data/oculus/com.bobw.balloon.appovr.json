25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA7EpRVC9jgQ7kNvwFwZADE&_nc_oc=Adr1ykr-9Ks6ZDqSBcA49ckZndiLBJBm6CRAzPskPw5YQTqLj0gDFZhh-Z8nHM9SiIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2_ctd3WR_57CK8i5xQtaG11MXTzPR0EPbaCebaTlk7Q&oe=6ABBD0AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huUvms2R64AQ7kNvwF6ecLT&_nc_oc=AdrQs91S6_2Wmyys7PYtt0VVtpZ4FLABabOzsC6hZG8b8k9Bx70mf_EOvOp8H6qSjM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWCWrOKtnUL6xue5MUP-VcGl_xC_eOHBBvfIFu3tHKJA&oe=6ABBC846"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge1e-Zin45cQ7kNvwHGi1sC&_nc_oc=AdrJFt1jvD8f75krVm6sEfpCoIc4VxniV2EsmxkwzdnJ_1emyh9FKcS6PNtsg8X0_BI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdrq9HcfU896-loktfR2XOaJfWYa6D5Qj1PCoQfItGfA&oe=6ABBD7AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHli6h65yVUQ7kNvwFbVQpm&_nc_oc=AdqwXwCcPIsNO9oMhUhvEP9d8sxZdTJBJhge9iF5ecTruq8cad3vR5BdFpqydj5hPcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIKgrzg1FPOUcM4lbWJ1-oQ8duCTZttMoZZp8k2vjt6w&oe=6ABBD7FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTawVrAjn-UQ7kNvwF5lDCQ&_nc_oc=AdpGwOk02e0hXNRRJmJCv2BhdlWcL5hsNcflmw6A1_02wkpayZbu2pvPbzJZ8N-62cA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK97hmfpGy6hYlIXFJY44Z6IbnBkj9mSWlaoBiFsCCNVQ&oe=6ABBDF3F"}, "is_concept": false, "is
31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7MSdICfmGQQ7kNvwEOsYs9&_nc_oc=AdkcAuF0docsBN_rOHmgrVOhv2s0oOa0tlsOmeMQYreDZAg3DZQf25lsIXGk92eHn8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrSdWKNuIp1c2xdfYUtTY6m4iLBD8-b15Y3cvEqgJm2A&oe=69B53DEA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSl8fI64YTIQ7kNvwGuroiO&_nc_oc=AdmIh7tTcKTw1-vyzj_KjypAB1UtKEIamOO3RDCML86h0vdL_hHDn03HsTkYSURvGFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy794irep1WkKUlvVWQ7DiaV9ql-Kc7iWl0AnYFhAE6QQ&oe=69B56DC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRtNmE8GTtEQ7kNvwF7yVwr&_nc_oc=Adk4cOfFAzwelY4WetYXCM2eK9mwR409GE4fyOLqjTJpPMZxGoHPeLiPxMs1BiCk7L0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMKegK4WWvubyM8U-xkfgpG3WLs_oETJFoq4A5PIfdNQ&oe=69B544EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCARqN-ZugQ7kNvwGxQbhQ&_nc_oc=AdmI2-_fszFjzvn0m3SAinJSAV2mHIx8DZDnIDEyUjDN_ib1bcTSwAvOno-meAVKsZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsUz2AUTrNp6AzJqdqRc8Sf8X2-0MBONNIaCsRgasbYw&oe=69B5453C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayMvA2v82k4Q7kNvwHXGBHJ&_nc_oc=AdlekU_ymaXKJwOhkMM41_W8FDm4ofHnHfQR0a_7npvqOEMkSI0Gy0Q9xU-JFSVVPhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFE26USJwY_TFg485iAYvNdpSnULh6fNyGaDiOhg5vZQ&oe=69B54C7F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
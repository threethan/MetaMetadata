25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wy9IoceF90Q7kNvwEIsY4P&_nc_oc=Adrug-nPnVlsMnjr6reRy-qliF5Ihx_u9sWjEd6WGne3emf49Nn8B9S3Qnlw5yn-xK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBzHeubVK6S6-eCgdhw4PeLDawk4VZoqiVdi_YbcMKZA&oe=6AAAAD2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU_K_LfGCfAQ7kNvwEfTsCi&_nc_oc=Ado5Ba-yPPDIpWc92q0DM4Nqi30UDy1N0EGdroLfrCe9NUR7ZD6NmPvJhV3l-NqLYas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgzqvgpYfGAOTtEt2WvsJssrb8T1WIDl6e3ds0_B9h_Q&oe=6AAAA4C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFFOkU6vqoEQ7kNvwFDRSpo&_nc_oc=AdoJ0-vi0CrvQGq7bkq1KcwxC9FN03iKPP3t4kkuIIN0N5o8lVhXnc77qL9nSNNisj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRJ3CH_t9TJZNFlDSVWz7SHH7UHehxC8KfABuUhQtXuw&oe=6AAAB42E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSZ8eGTbOuoQ7kNvwHu3zS-&_nc_oc=AdqMjXfWVJGCg2RzMGEc7UPq_ML4c23bgQ3F-edyJR1VBtHgfJp4LxBkGzJgm4v8mds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpHkrdy9024XnaOLJknxeOcPEASHZx3jt1RtRmXHrkbA&oe=6AAAB47C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuLdluRFpCYQ7kNvwF1FjqG&_nc_oc=AdqG1ZX7NbanjtJEaMQEhUo9yRvctOok_z4-t5OPYFvFsHoyAlrY7_4VTZgFtJW3VBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLouI6pVNce0_jN6GiCkCaGggD-BIlWR0fZnu909NVKdQ&oe=6AAABBBF"}, "is_concept": false, "is
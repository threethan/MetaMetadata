06FD7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_26
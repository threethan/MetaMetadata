31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0FFWHeHknMQ7kNvwETqp-o&_nc_oc=AdoMJ06s1Xqbpmedu9OB3z-kt4DkG5mtXkZRDWXvmU94la5EAYX7fW7SkQUciExZ1lU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxj3vTFnrUTVgAQ-jWUtCVJ4AhZEB-YCHBqH-pQsxoIlA&oe=69C11B6A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGmBeyN_qGwQ7kNvwHnO71t&_nc_oc=Adq4po7sndHkB80kjRDH_t1Q4zFr35WEcV9Q7rMcz062odxu3yXm1P1WRdNX6iVDdk4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfypK8kb5Yk8pxciCGU3nv1F6Yh2SAFYjpczG2-H7yaRSw&oe=69C14B46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xAd411JvOIQ7kNvwH9zc3e&_nc_oc=AdoE6nsLEa0UDCdfWzEvQHnSW0ypC9CNyaqQsSRbGlJhFUZiwVwBFpKZzrK1ZZYwQEM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTyuXqBJ_qRHlo3ukHzixwIjuxi18L14a8VXmnE9hN7g&oe=69C1226E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ORAAwITj94Q7kNvwEbbHR1&_nc_oc=AdruVo056PgwSHjt6KyiUzVb0YrzMLgQOC0UYC7aqxoniFjoDj28ZApWTxbl0ngqUcg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwhy7cSpSsLOID_zlkGn18m1u2Cb7z5L8qSWSfudCYRIg&oe=69C122BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3cTtinXZJsQ7kNvwHEGzml&_nc_oc=AdpW9j38HG2wTUP5B20gonWhoD7RSfyH3kKesC7VWtogR0YCWFG6oMhHXbz19seKBug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWfU2C-dL_i7PhopzH40xdoCR7FQlcp-f3LO99hfOkNQ&oe=69C129FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M0CuPU9ddEQ7kNvwEjvMCq&_nc_oc=AdmP4ANWCpg-BjYvOdxiVdAxDj1VtP8qDL4qDGyord54lYB5WiyalrILNpgZflvhfkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-eX1pAoNDwtm8JE-atbgS9Lv5dEFGyGivVdiQBr7LZQ&oe=69B9326A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-y3zlWfoeUQ7kNvwGEy5r8&_nc_oc=AdkGeyHghOyafyFbdFAz8zuPwsJF0oHepxtnq2GZOSy4SxC_iTDw9aWOrxhexaCgWwA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwEgsGm5Hi_j45UgkNJpeab-W1T4734F_qh_HJpq1-Maw&oe=69B96246"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocqahUi2kgIQ7kNvwHL2ccj&_nc_oc=AdmQJpleN6S9AJ3ldlwRDw3sV-c-bdONPqWGC6tXoj-Tu7swUw_6dCwiRrQep7Y4kxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwj-a1-K2zlz1QauWXCdoaEACMcBQdNWqdcUpPU0BPM_g&oe=69B9396E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhY7aWWE7XAQ7kNvwHYYQS8&_nc_oc=AdmzAWHO_w98gUJfPe_XeZAJqEnp0lh36tYixFTW-45ypCe0yBXeCiSTlD0Fu630_ZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoNiCiiB1V9tJ9k8u5stFzLKOSQa6wBTkpVFpYQkrMJw&oe=69B939BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zczvEhNJ2mYQ7kNvwH0sAx3&_nc_oc=Adng0Jjta2JOHDb6ASP8Z7yKR0mf01wt6YCAWJMz8FhEZy4Xhn9HOWb2_ZSVtt5U3Ws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsztRs4HDWPL44JKd-ie_LC9vxvyJL87fuOJ3nkt57UQ&oe=69B940FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
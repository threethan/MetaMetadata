25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJzl7UoqnOEQ7kNvwHNinin&_nc_oc=AdrUaQ9wlKy_uMTpUqSzV8eYihbdjhj6cTc-LV9F3B5r97deNhSpEbg17hXstnf4RnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88pMI-yb0o7eY9ora9DY37E2CjbZ7uXpqbsmGjQvCuXA&oe=6A3E922A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLBbGM_bqA4Q7kNvwEAxyO6&_nc_oc=AdqRcAu__VpyFEMd_yUqODFYelDyQdq-RC1YE_pe5Vgg_WyUp8_3K9uJSwZYfVRE4cY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PPdOVoY3psRSpJEMxjwbgLodxizZz3KhI3-2Fc6jNKQ&oe=6A3E89C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyYY9d1a8-gQ7kNvwEz2W9d&_nc_oc=AdoxoBERewqFAASBqD7dQM9C4zZpokySAuejFLxKANVv8K0Yd3hT5HemfvMOb9eKDAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af929goCNq2Fn556Pak9itFtzf6sVahU9sxv7CihxQxktw&oe=6A3E992E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZunxSbWJpAQ7kNvwFxq1cZ&_nc_oc=AdrTbGVRQ0Hmn5cAnb9B-wHOnTtyYwJERbf2u5uOcXXWAD_-aKv-JOGu0KTawAmr8Xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XNLewlZOukPqIZuceFZ4AnCLa8XH4LBD2qpXrVKUpKQ&oe=6A3E997C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_bpJhYTSScQ7kNvwG0OB8z&_nc_oc=Adp2D8GPig-y5NQaHw9_gHDlQ38u_grQj6eEXnHnfbJRwRT8NHuSrRmLaq69jf84VcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S3VjnSAH7PpbIgyJVp1I_SLJCTRcaOr-X7PxvB3fe9Q&oe=6A3EA0BF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUohTLnIB5kQ7kNvwFnvnTx&_nc_oc=AdpVLlbS90cf6SMvXCLGoSrZQ1OJPGB6u4DPvjKij5x6sZo82nHcXYJuKxuXYan4npw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrp05UT4gqMYmpa9eMZEGlKDrCaq96Q0_PWmsDhJvABQ&oe=6A4E642A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9MfxV5jFTcQ7kNvwEZvg0t&_nc_oc=Adp9fSxbTPwc3EB803RBp0PT_yw14kZUO9QPA_t6-JI8XmTFhheD0pnzW_uGgOAdK2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBChM0xk1eYv11H-I2l6E5lUpx7KFi3-8XdQVFdgTjAOQ&oe=6A4E5BC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpN8GgkSbjYQ7kNvwHCU4TM&_nc_oc=Adq4MWaG8kN-5UW0r-VZaKe1q_v6y3s_yk4TgRYKXM_GMraTII2VBC7qLbB5Ka-4Or8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8v5z83SzSRlJdp4EaAcfLrtra26rzIa58AhADgqOktw&oe=6A4E6B2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROq2xRXnjyYQ7kNvwFUcedi&_nc_oc=AdpsYXPHD12VQaaFynuHd_10bLao56SAiWn8mbGLeHJFKIrZns55J_sPDlhrxiI4sS4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSUHT10USDC4vDJAYbSVK_RJKw5USlyq-LTo0HSiDOHA&oe=6A4E6B7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ4qKU1DtvUQ7kNvwGMp4Z1&_nc_oc=AdqYJ_lHKcFRgTBqOYoNCa8e7oNpqfUxf7ttLtU5zUPfYKx50Ave1obH9v9e50VAWu0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7p8cl8hVVlm6CUkhc8VsXtKfVJ4ZjozXaPhFgbIFvUg&oe=6A4E3A7F"}, "is_concept": false, "is
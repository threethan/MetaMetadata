25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw4QcwMrGpIQ7kNvwGVkjVt&_nc_oc=AdoS3thGEWMqYSeROpoVbL1TbQSRm2NEbr9LSKuiMvMvcp1CqA_mtXmXqw1IJqT5TRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lF_D4G8bD-GIILWkC0SVrYrfqTGToUvFWf1MRCHVnZg&oe=69D6336A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z20F2uwSPs0Q7kNvwHyzZ4o&_nc_oc=AdoP5TrOLKD7ZIJ6cYgu2ibw-kZKUlqRTXE4ekb-vYTc7CDTjM7wpXNhMxWBcdmuzW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pbcJsBUhzRwSSZLQxiMLFyRQEOnA947tisqdwpKx8wQ&oe=69D66346"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aQXXV_OBZ0Q7kNvwFrdtIR&_nc_oc=AdpqtUppr6B7reWTH6G1-l0DZkpJTF0-m-oWjOPwkH8Xq6DyVnQzyZ71AtBam_Qk3c0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10iKaDGVxLzUOmM88tSxM96qLG9hTSML1dC7eJ6UG8ig&oe=69D63A6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMyURB85EDwQ7kNvwGzGwuV&_nc_oc=AdqXk0_sUAzh6DfdXaiDoiwzxtX6CnAb3eK0lUVIf5NTYs6xjKiTYmjjAI_AAOB660c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Io4vwhNSY_G8OIHjfQ9E8NQLAyND0MjtZrC1LkWE3WQ&oe=69D63ABC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL-DnVTztsUQ7kNvwH44zfK&_nc_oc=AdoMh6YQ5Psp9FHuLYzzHcU07OSHb3SrNMHhv8OKIQ7u30KXmg39mdEfy0-Iv52rpAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N5uHH1zEL9pcWa8EDx5K0Vey4ZkcuAKWMrTa3eazItA&oe=69D641FF"}, "is_concept": false, "is
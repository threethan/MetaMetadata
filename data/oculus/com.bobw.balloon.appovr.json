25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRBSHvSE_aUQ7kNvwGGIaQB&_nc_oc=AdqD-7SwSicnrdOCCMjIw9dKWtwVnGFS49b_dZ3sEhzupR4BwANIAHpI2e3oFQveZxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_rUy9O0yOqxx62VzA198NOY8_i8LRTb6qbBIcjuvGQg&oe=69CCF8EA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQtledB-gjMQ7kNvwFHB88Y&_nc_oc=AdpWN8UrhoNHZLWoHwPqrtuLWlMZrWDJnu45Q-DBVPlcoM6U37qVKJVp-0uKsqRxPoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSx-wuNP_X1JrdIlT0MqriBicpuusJzHSsk6A8XrKToA&oe=69CD28C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWJa4czhaAUQ7kNvwHY6DYd&_nc_oc=AdpuLLzrV5I6p3r6uRmPOIhwtnYJ16766a9MzV_CAzppbakRU9V0M9RK0Ap3OWG70uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1oTJgS7Jf459EPvo4FxfJ8WCitzDeyHXzHC_eUtV5Ew&oe=69CCFFEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkmjnIaw4VcQ7kNvwG9GbMM&_nc_oc=AdqOz25IP_DcdCZfxZTF1YrfHmk6uVE96IMnHA87yy11uq_H9-DaJExCNmri76dKYYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9xGMJE7t5rpRPh7blOHOnCTdwHU4AVnVZBPJIjTn_Wg&oe=69CD003C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXPeSGZm0JYQ7kNvwEVyy4H&_nc_oc=Ado-SmhjAjyV5kg25Jc7GMFLsTisCIJ3FcBma5fMg-S1BEl7OOIIr547jKCpnFkwirM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzsqqch-trP8GBQe9uLaksNGn5rB1iJLTEpF_QFFizyFg&oe=69CD077F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue3vCur1BG4Q7kNvwH5zQLp&_nc_oc=AdpI1ZTaNxsMpNfMEr0vQ2c9kOeSoD0AyqAcuU9jXJ0bp-lY_8Gs5sU1BvpDBrSqTYk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdwuq4Os0ht5mKD03zNEEqn47GYeZnL9adZFSJiOTjhg&oe=6A68C22A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QGnAj4FmsoQ7kNvwEnZNtO&_nc_oc=Adqiy_CtbKiR00XK8potg2f-i9Ak02aIN8D7hOtmCB7WBed86dAWJMa8FCAbh494Z5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwvKbBriffCkquEaVYf4cT2tz8gsy77aqlGtXZKaCbyg&oe=6A68B9C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-cBOcrJChgQ7kNvwFzy2vw&_nc_oc=AdqfyXQjqV2dWoF8wiWHz2VgU9ECVCf6H-ILfq9rftQW2wuhlv2qzAd08LbBItPwJdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASNfi8Dyqf5ayWKWQDEynSfzS-u2cnScaJu30uvZLU9g&oe=6A6890EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y2aQ97LpxcQ7kNvwGtb1cz&_nc_oc=AdquN3yUdZFqzevmiA0JjPJmHYFgeNFKuAFgA_1suDO4ODnT-ush81mllDuvHF4tblg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxsZmFyuvjNCbQNab_SrVYhGLqcRSZ6mvVlyViYXKdCg&oe=6A68913C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dnjaxcrdl8IQ7kNvwGpft-A&_nc_oc=AdoCCaLUHbKVL6UDXq8tMyDA58dWS9t_41t2SoZv8XCvglP8C1_XDk2ZePz5WQbHGY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpkUzZxoAJ-wffCsPshsJ0JUMaQbrTr2CptzDxW_LNdw&oe=6A68987F"}, "is_concept": false, "is
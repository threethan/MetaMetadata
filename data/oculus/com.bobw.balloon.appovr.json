25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ8hcWjnfqQQ7kNvwGgUAK8&_nc_oc=Adr3tCWhJUkDfLqtHOxmTfz3-ClQGlexpvM01gYcWgRZxrqNDUEoWLcz9XkQIjNzPCA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuRPy6idTS3eemKZAtZxfgaV0bj_kwRcTB1kto5iYqyw&oe=6A54FBAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT4DIgHDFo0Q7kNvwFqto4C&_nc_oc=AdrKmo5W7S7mAZ7DzzH03Q1UqOp52PIJPaXkE_8ETxvvf2mYizuv2lryJTg9V8eWnQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP7d4sWrkdcPO29Eo3uUUjEn0YhinmiOr2uiIUZDrU-g&oe=6A54F346"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFATDNvrOjcQ7kNvwHVhq4j&_nc_oc=AdqVEpcqNZLkfmwpCR8d-HSjTEJ7cJJBs_cdIno-7uI6M3xtCoDQSqAzh25VJjxgZNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOsiqHWlLuPtev4k9Z6p5vrFU_ytFp5rRk7GyHUWSVzA&oe=6A5502AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTxqoDmuEnkQ7kNvwHtacS4&_nc_oc=AdoP32alQQ-B7wk3PhRBHXTfbwBGtYt8Ykd-XxjACKByX8htJg4JhzZqObYMi7UoENo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUIpCop6BjVtB9MpO4Z4fnDaJWjPQplCb4IP-L07zjYw&oe=6A5502FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mkdbg_cp4gQ7kNvwE-OXwI&_nc_oc=AdoWXmoTn_y5aejDXIWOsSiPpwTRtDPsL76utEmqaoIlb6lvHXMD7ZO8Le62dJUCe4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpCca4fBQETxrwgWIB0gCVcvXCpEQ6oHEw9YKeJsyvEQ&oe=6A550A3F"}, "is_concept": false, "is
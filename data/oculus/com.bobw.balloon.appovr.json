31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7MSdICfmGQQ7kNvwGCJ_ia&_nc_oc=AdnxFQjj6k02eRkIughH_ktZVVSmj4gBaH-WqnBoyEYAbdVG_l9jwn9eyyTwMHehzvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrQB5VhRjU_uawvxgS3fgzCqZm8QZeZq6B4k9D5gdw7g&oe=69B68F6A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSl8fI64YTIQ7kNvwHI4OOJ&_nc_oc=Adlwrtvbmmi3GP2LollDiGyCUX9xwv9r9RIWMrPt2Qv6cnrjG1irsUvOmL3PbZsIvjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwpXx7vnx-AiRMesA0siy6kExuOAGoAVCJIDu0JDdMwQ&oe=69B6BF46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocqahUi2kgIQ7kNvwE4s2gC&_nc_oc=AdlX5v1qhOTcRZT5OWBBox7Oaz__SY4sMvxpcxxtR_jI0p72XkzwBWFsjCsqyeLg24o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQuG_9qO06Lm5cDxln-tH4YU8ejMekJR30_obswnzlDQ&oe=69B6966E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCARqN-ZugQ7kNvwHcFKxM&_nc_oc=AdlsuCCaIEGJZp9nZ009Aotzl528_JWF-m5Pgh70u7V73mBhBqkayCik3SufDPikX7I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMxnfuLoB0hUCg3v7RDwhRrEQpOmJWc7CYTtnsKjRVLQ&oe=69B696BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayMvA2v82k4Q7kNvwFIIX31&_nc_oc=AdmaqnufgEFMmhPJJtFl7zc3r02VVirk8W5XpszcbyfllwLXeI2mG4BQX9cl-PwGFcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJEUJ7aFg5vDjANC8Y9aOioB-uz4mR76YSaRPZgv-LwQ&oe=69B69DFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
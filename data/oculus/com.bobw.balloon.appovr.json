25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUo8pgJEBIAQ7kNvwH4tAro&_nc_oc=AdrWp-fA7wcJdgD2zHSi8lt9SRr2DFH0r2gk30WbVtV2XTWw22tRyyS7DI-cIEXyDVo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XTEO-Yv0UUTxgp6WGBI3EoabS7Qk8PXa2DYbwWzslWA&oe=6A3011AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lAICCC21MYQ7kNvwHsE5rP&_nc_oc=AdrUd4RmLTejdAftwEhuYpbjRAwPuhurmie1iBPLpAYcC8pbuAKaB2r6r3SHPaF6vKQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TKT38drwKxDpziVPMXz2JznYuhyIZCZcwX1nFsNc8vA&oe=6A300946"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRF6VZ2QyIMQ7kNvwH_ygHu&_nc_oc=AdoZb1C9YbcwiO7uDI8v0XQGoJVot9NUq3WDdGgQnYVsfZUwJBACP7RXN7ujwyijm2E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6yvJ69zxbWc0LI2q01qGXgHn3qqOYlicOQtxgwcRsbA&oe=6A3018AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRa9rljQS-oQ7kNvwF9mGye&_nc_oc=Adozma7CQ0cHcqTu1s3TyXS7IEqaNw9NZ_wxtDdoINDLwuTTrMb_S5BGHHwGqZyL2oc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XkJ34Cff2DDgB0oCDYp1hR7UVBw1Q_tlFWu7KccwgsQ&oe=6A3018FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U30JwPds-04Q7kNvwGlANzS&_nc_oc=Adoxq84pfvPkW4rMyJU2uXNrd7968c-rZ4lLhu0I15dXsXWOHDsT5wYv88Y_fAqfUXI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jUS_SNfMIcM-sbiJ8AQZNHe0vYldDy8Pot34vorBSjg&oe=6A30203F"}, "is_concept": false, "is
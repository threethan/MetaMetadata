25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQlHsh29zY8Q7kNvwGyFDYt&_nc_oc=Adpv0X5gh6HAP1OPvdf4cpkeo36ltnj5BSjsrTt3Tqv1a6YmihKPFfDeOQFKQYbdMe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cXcJmcDyzlT6uZOzl1fsdq4S-w-kOr4GKvInbMZeWQw&oe=69DF6DEA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRu79hnwfmEQ7kNvwFLe1U-&_nc_oc=AdrkCEg80L-Q5AadPHhZK2m4zzhDhMkvT2HgE2Pr5oKqd2jaTSZhJWGFiDVQif1keqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yKtAoVLExTxBN9nMy-K_URDmoI4uZ7Nd9VSZpJn63Mg&oe=69DF9DC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysJvIXjACzEQ7kNvwE3hDZB&_nc_oc=Adq7txpBmDaES4kyojHoiRP6wf_lGwPHAaIHPCwgLFaORzOl-MptJI34qsKeX2fnKN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G8znXAY3b9tpGXdfa-Tz90a8r2SEX0kWFzXDbcPM_BQ&oe=69DF74EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk5nopbEwk0Q7kNvwFt3M1y&_nc_oc=AdphR2nOVdkjtvpBoelL7siI8V-uUgDS8ZV15ve3AD7lkoCaz89nfLJgaA0Fn-XrBNM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WoXTJLbI34EAvBQnHHLqutS3_Tgt6plbdELF642NzmA&oe=69DF753C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4GaDm94qaQQ7kNvwHnFUKS&_nc_oc=AdrF9kS4eS8bLEBPsZJqBDWnh5jAoGBQEoMtuWwOz3H9rX9d0NnX18MRaTpxn9d1g4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nnaxS58KVard2CMqwvm3hutt5DBsQl8xgqGx1j2ayUw&oe=69DF7C7F"}, "is_concept": false, "is
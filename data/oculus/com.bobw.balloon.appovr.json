25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4pYmg7PP4AQ7kNvwHIwH9i&_nc_oc=AdoWKi4-Y2z0HlJRjle0T-glsg6KrHeBqThJb-zfdiU1OVPvdw-IhzqSZV3Cuob2cOY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoaMB0fwoB4imE2WHDPWHSMoNlBYqZyJ5-lyvcLB2lfw&oe=69C5482A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJn04BgN6UEQ7kNvwF6oeQp&_nc_oc=AdrtxX4xMhj9olOc3_l9WwSzeUtD6kIb_XO-2y2QYGXam-EXHTyy7VUEot6w-nU9kZU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwflTGl_Di727rV13CF6PePbsnPacnofZwM6qsRQKHS8g&oe=69C53FC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBXx9AuETH4Q7kNvwHXC17Q&_nc_oc=AdqeelPzsHnmzNETyL9VUXIXGSnIwpvonRbSqaZU_1-wpOdf5SdPfivS8fQ_IAePhAA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwyw7iwjxtj4Cm8_k5DdZaCDCJrKfmXSCyJyIWyzLDJYw&oe=69C516EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7OAMrPqi-IQ7kNvwHc29yJ&_nc_oc=AdrpnFpg37Y3wZ5_k0P9fvWAz6qYn0IZ7vTVmr72KPwMEwEqUZW7HKAACZvcIKknDe8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3r2A73Cw51aM6GrtTvgDrGXhTcSbIGvcu2OcUwcT1VA&oe=69C5173C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6roNv5RJr3wQ7kNvwETYARq&_nc_oc=AdqdEwi-JblRqjFal7ijnWLWmlxHVlMu2oZkpb9_Kns-XdmIK_qPSt-YsN5aSXO5L8g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziXNwsBWBFpfOiiFXRT0DGPq-Na45MnyUVcqcdzdUdHw&oe=69C51E7F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omqAfz8wwfsQ7kNvwGHjCaV&_nc_oc=AdoCFXHP_d25VKEE6CqCk3n0Ylm5jhhOSl68f_6XGSCQYr4Sp7bzduoYPB5RTSbja18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArty3I0vjuw-X5DEHU2l2xQzGSFWnYUGtTzH7MljHJfQ&oe=6A4D12AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkjPiQDpBbkQ7kNvwHCXH-d&_nc_oc=AdrIDHZIrPSktNOyPi9snC2aiNMtAktGD3mEOoBjFnlHyexDjdAkpPHCyMUrl6FSeqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZrpFS8-cIPAvxb-MZKGMIBI4zZr3GcM4rB1mJPpTXBQ&oe=6A4D0A46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpN8GgkSbjYQ7kNvwHHDM8_&_nc_oc=AdoM38NdsDLhjL2s_kG6FExSPyLLJ6l6YX9qVJbz1JfgUQDg8uJ798khnigrW34n34A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZtXCk8eALKRhctBf5vhdkM1oyhDnkxdlvXPS0UH0QiA&oe=6A4D19AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlQzygmNxocQ7kNvwFG14U-&_nc_oc=Adpg2euOpZSnPApVA3EH13eXXWfYe2Ekjo1RzhIDabQIVHT0TxrsHBiGsThpKk4nt6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs5tZQR_ZTtqtDelVZAIyLz-3uu_93PI0J4axVVObi9g&oe=6A4D19FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ4qKU1DtvUQ7kNvwEdjkUU&_nc_oc=AdrqL9NEU5Kwop4djQizxy8tltpb8sg68DmWzvWve-QfRX5_5VkXFKOYZdlTb0qmfJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoFw2jmhqSj0NNvOq-tu5EPsOMBWA7pOVxrjnQQwzB1Q&oe=6A4CE8FF"}, "is_concept": false, "is
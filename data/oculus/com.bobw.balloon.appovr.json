25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOxuTWIj8wMQ7kNvwHsLqHO&_nc_oc=AdqEcuT7JJa_OjtSiaK5x7PbULIyy9CAr9XohY8bcPsL53S5PKb8-QzuoimyhDhuXcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjviU9vyX6BRkU8c607ya9GYCDjrFf5ryULRrLYOnuxA&oe=6ACA512A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxqr_LIcJC4Q7kNvwG_D7Sg&_nc_oc=AdprATp0ZToQTzyk0l-TQCthI6tGp6Xc_-Iz8fVclSJR2dUuNUbUVJGZcbwRwmqUcT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEhQr4nAjvewNWEEWObYyTOjKbtk0tn0a_T731jhYgqA&oe=6ACA48C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRx651cTLB8Q7kNvwG4XtLI&_nc_oc=Adq8RF7XvWdl-bH_ILCTVUbGgNHij_ZStCSPlvLYuY-M4ZEHFquB76i2TSG-QUGmyHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW8gdKTlwwFBSlcWg_dyId6qxd6kGfEa6Rwjkkn2tKNQ&oe=6ACA582E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7bq8biYG1AQ7kNvwGKTQDR&_nc_oc=AdqR2ZduPU00WuERUNANEL1H--d1mTJcv1-twv3zXxe-WcboPvb7YSvPFw7REEV5gnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK0R6cBaXv6PF6M04fhkoWa-DRGXDDUs1t39hkDtFsIw&oe=6ACA587C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9DVqrVfVAEQ7kNvwFTaLQ-&_nc_oc=AdqvC08NEd2EoUlJz8ijhqVyfPA95nJQbO821stuG8p2pFsWz4xiIAjySBYhJ2onuvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCgcgZji087n5KpjkDqmc7HxIdmYYFxl8vX3A196NtiA&oe=6ACA5FBF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Xky6LgDj74Q7kNvwGtVujp&_nc_oc=Adro2EApqW8gk3iPMxAjSTjoop7ojEr1W5q9dd_88G_Pr6vzVMSc5rsGmYEIqdLgiWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoNQTSBD6P2sIlpP9bbZ64a7VgPj4RekkLO-9FApmP1g&oe=6A9ECFAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLs73MQx9XcQ7kNvwHaD5QU&_nc_oc=AdpBvnmeaWImHNPImluVPLWCmr93TwYQCtW6CsMtYHW0tRqlXvfSS-Ep7iV-LJHSdNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsa6mOj-oR4UeEU6xMnFRyOWCV4rCS8-tj8RxeVBlRhA&oe=6A9EC746"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOKnBKFw3SUQ7kNvwFKaGc-&_nc_oc=AdrC4SZ6dLRRDWBxBnNqnRepbsLR8cXDfUaBfgZjeYm7dKXZ00ihJXR6GHBvvyxmvlA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAS6LyuByT-J0ifQMSTM3036SVVBJjrO0LEvB2oMUkLw&oe=6A9ED6AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA9zHjhlIeUQ7kNvwGnL-AZ&_nc_oc=AdqfObI032NWtb9d-YL3owSkS9BSTQZXCjZIQ5_sit5y9xiHIRVRKwTDHkwBjBEMt18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrw95xwfUDtf3b6HJx5O2fm2vBNolOfRZXi96-unBlLA&oe=6A9ED6FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f20dLF0hTrMQ7kNvwFcnh-z&_nc_oc=Adq_sUKV3EvkY2_8lxWBecot8OjSyAhG5pdNzWleU-rQf46_Ozcb-hiwtGoNcpXfQn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiQ0eNgDgeGoofTcVVE33JjakVg0fXzg-QqrIMD4LISg&oe=6A9EDE3F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCZJmW1NwZoQ7kNvwEHc-4n&_nc_oc=AdqQNG9pyv6fBCLDn3C3S88_6iTUvDM-1Bj8bc8AM3xgtmM-BXuKikmqnvxfZ7-evj8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHo446FdUINp_HnwfAP6LLN4qj46yV_UmC-n4NooT2yw&oe=6A92B9EA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKXOqK-gsRgQ7kNvwHg9HPE&_nc_oc=AdqipdPkWEpgQcJdDPOmhHD6yeYdsLC1ORnLBBd7C-bCO6JZKg31JL1v5m66oA7rr5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsM74iOwu1vrZuXdPUSpMqsi6KYVW5cI9MdoR2Lo-gNg&oe=6A92B186"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXXiddtABwYQ7kNvwFG0f04&_nc_oc=AdpLOxTYtIMKH_TaqAc9F9rzAMCelVW53wouMwbyGJuvYoxQtIyqEtivPrG56OLvrLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTON8IO1-YWTtrcVj0xkXo7lQb-h9H79O-gvaBjbhzjw&oe=6A92C0EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH66JcXhJXUQ7kNvwHcATf1&_nc_oc=AdrOkhYatPk1YoiJGvqBcioatV69vP0Y6NdK5uTDf1agj-hg5naWtHk5x5y132sReGs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnRtj1yf-vc9EhOsyFmDoVBHzuEjZpvEk3z2r9o3aQ9A&oe=6A92C13C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpwPWw8cmPQQ7kNvwERyS8i&_nc_oc=AdrZhMF91nwigjOX8Xpk8rZA9D2evRbB7WCq5RCsXvBbu3HfcobUi9B65ke7Ps5fFC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu5M5jYoiAtbsEz-8FWwzPDRuJ5Mwng5Ai3ceRQV-HJQ&oe=6A92C87F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL95R1SB7EEQ7kNvwHWFDNY&_nc_oc=AdqvZbfx4-Nx3fXIlMBvGmcuavGrpksFrsT9Nq70EAZ-NjJaryMFXRECav-rgykoUWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8cOdGRy0F5hujJdH-gt0CTFJVWHyoef1c2Mj2lwZ4Pg&oe=6AE20C2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLTXfBMgnJ4Q7kNvwEKhdzo&_nc_oc=Adplhid7FmhxABG2zsFTFNtnGQDyk0QjyqFxsA6UU7037Q9iXApI1T9rLS55QnTH3UA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTbQ77dXobKPI9CbPgGknHqX5JK8tPYLORr4FWh6zFrA&oe=6AE203C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhRCTsgCC3AQ7kNvwFpNF4r&_nc_oc=AdrniFoZ5zQVNgZTkN82HMudPtHD9i1mOXQJAFfwH5QC9EVUAT3MJxdc8KlOBzxuMHY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxrJnn0L0JOXuCZLjYqUZNdwxsHSo92d0LoMqHVdmIaA&oe=6AE2132E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDrSqmSx2E0Q7kNvwHgg0Aq&_nc_oc=AdoUqpnphJ_jeu-8QVkB26KSGf_GtaMGF1jS20j8NMYaqDHrdGLuPWJEyc21aN5Mc4g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_KZTZtpY62AvIe9wGGSp-4OJv58OzRthwR_W5Kfw-IQ&oe=6AE2137C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb7FzdE1ABoQ7kNvwHbrVaO&_nc_oc=Ado080uy5lcB-8z0Kqj08vvqoThIuW2_i6CHCWDsAFAuIODURYM7ngv8VrlpamotUDA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfL8BcFQAMguHQmgjQQxdn9GoCAPXNLqEWL5c-ZkVAtA&oe=6AE21ABF"}, "is_concept": false, "is
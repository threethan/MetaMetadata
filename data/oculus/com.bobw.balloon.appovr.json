25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt2tngKvj5EQ7kNvwGw9Qx7&_nc_oc=AdoZsAg3ZnTydRdsOzreksJDjR2hg9DMpGJnFWlpA2R9KLop4qKJxhU6mDkpUeucF0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGyPqpa4HslfLDSV0ojGMy5JYp1DupM9vLvXgQwVUD_w&oe=6A6E082A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM5m0ZkSUGAQ7kNvwFbTINE&_nc_oc=AdquLG-iz_sEoilrq5Hb7gJnLq3X-st6doK4ar7-X9fW2V6h9HsK9OnfA0OzCJpgJBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoiqkczwNiCEkxdCZ9pcOgm2zmOFbOPdQctVFhb0789A&oe=6A6DFFC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLs8yV-bQF4Q7kNvwHMryHN&_nc_oc=Adp1LwJaSgUGFf06DERXBJGISFLmcWZA7JKBLihyyPVOHIerQpOxoW5i-oAmx8a2LyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC40yV6B_-SNwhc6fZDJ6q2hjVkBMLTgvO6BBox9SulGA&oe=6A6DD6EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCOnDJVO-8kQ7kNvwGDQvx9&_nc_oc=Adqogh8kGwfNtPzmPAeE46hG67LQ6EcuAQMpdRCL6Ty8RVVYNKEslee_Ek3wYqcdzKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS2fIOdfDz8Y3TiYjHkUpZ5EyJP3OBlduO3QSl3upN0w&oe=6A6DD73C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9hyG8fg3moQ7kNvwEejFPi&_nc_oc=AdqJf7RqY5-GotnjfhpxbANSNg3DN0ZKJuo3BFCESppjDcT3CHSiEEAjosyvQij7Q2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWd2mI7UWZDg-maxZMv8jtvCQekjc_ukDI_yHHg0qH5A&oe=6A6DDE7F"}, "is_concept": false, "is
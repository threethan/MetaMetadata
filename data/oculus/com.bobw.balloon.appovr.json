25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEY6g0PP0AcQ7kNvwHgbIvK&_nc_oc=Ado69h8PH34CqaTsd-unSyKyZeybRd9-nmZQenq1Be3fsfbhhbpWnzWZFPCumSiNAIs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lnI1rC0UkK7RuWpJexoVTq-XuT4qUl2uAuHIpRQWPFw&oe=6A1C4B2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frEZt9r6wrMQ7kNvwEh8lCz&_nc_oc=AdosqHjtOrl-4etqeu7aDtyZTb2ViUAXT6K5nUcR4M7j570aRt0CACF4QRIs8cB6UZM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68mw02MJorhDBngZqpvF5Fxjr7ibnF_zRYfJFqJwRoag&oe=6A1C42C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE-HNm6B1PQQ7kNvwF6BJ4X&_nc_oc=AdpV49dfmcjZ0xn8jBpSa_9gb4GYs95pVul8VQ5x9nj7jGdngCVd5e8_CSJlxJjeaFU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VNsShQl2wZ0ydQZUQFq-y5jojKglPmU3ixlTeNfb-Fw&oe=6A1C522E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH3pQGnBMk8Q7kNvwFkk7yZ&_nc_oc=Adox62pS3M-dKaSw05R4xPwOe7c-uKVlLYfdepAO_iBQD_Il_mpdYU7A3fBs2XGcMRA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77XzagreDGS8p-gEJb6GZ1HCmWBV4A9XPKsqot7yjTkA&oe=6A1C527C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xsx3ejl_SloQ7kNvwHEKPsk&_nc_oc=Adq4lmX95eWB5QeqzoRrxgph8mvX-XjXtZjewlbgMarnQKP6Q7ZIsPvpqhyNE0l0YCQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65S0RL3PA4RXX4kNsw0PMxKoddKOJ9BaR4IfNOoIDpTw&oe=6A1C59BF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK9ky6rFg7gQ7kNvwEPxbXV&_nc_oc=AdoEcywmduNTkAS3A1v4c_bXjSgPPak7Xcy_M3CdtU7ZhWyjGie5-JRHYDeRZd10EK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaTXEwcBNR1uBHWw-8QRUIFEUxZg_Qn9Ypcg5dfbFc6Q&oe=6A5F87AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_16TekMrmIQ7kNvwFX01RB&_nc_oc=AdpJ5GSO7D-TWTp3zhn-UQoWyeaUy06nOYuzobsxl2801gJxdH2R0MBu5ln6MEaFnVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqEYJlutv_ErIqF25Lzwh1_zN1JS_NNJ_5APIAUuwqYw&oe=6A5F7F46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD8FEwQQAPsQ7kNvwGq06EC&_nc_oc=AdpwibrZ8dQgipB1ocOCi4RPjbLq2exFt5zrDu_HIz93e1edAnJnGiNbN99QLE4XH7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrDUuuWaDuGlHfj9iaMwW3JeufxwJmxHVgk-uRUMcBow&oe=6A5F566E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro_IDN032NgQ7kNvwEax5XT&_nc_oc=AdqhecLLocXoAvSMHHT4729zux_AjjYTqhs4WAz4qsCvXkkC5im6UvxMIeHF4P7al90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCnmuN0Bsz-zN3d4vbuf92vuKIpA-KYy6PhMO494fujw&oe=6A5F56BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYZTLWBftGgQ7kNvwHGvH8D&_nc_oc=Adq4xbSC4OtMCRgxupYtaa_HonM6kuQHD30xMT9uI6m07takqp3lQPW5BvkRmLTlN3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2AF_Owik0KrkchPILv5ePGDzwGBIFYpZthCwTHD1qvQ&oe=6A5F5DFF"}, "is_concept": false, "is
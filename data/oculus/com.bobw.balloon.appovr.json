25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFfkVJOGR04Q7kNvwGH0a6W&_nc_oc=AdpypRqcoVJKJNT4EQmVhk5f-ypDSKPx508KRnT9jVDwXCqoXUyzHGiXRNvJ9A3Bcws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUuiyLQDIMTyZqS6fyNYS_DW5PcnVNjgvrNpuIx9cCBQ&oe=6A5B932A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8eg7JVqI4wQ7kNvwGlplKZ&_nc_oc=Ado7MERVoRbiTUhg2gu3hn40U6mCjhMnzKR0Ea5RCfvqG_n-aGodMwwerU__HPMp_1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ-vpW0Q8Vur2fSoP2XNfBBJxxTNlGL_i0o4sTI9u4kA&oe=6A5B8AC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpRehBbz31wQ7kNvwH-jytE&_nc_oc=AdpC69mznhUOI8O679IRg-d6FU60M7EP1jvnQqmisz3JwcRXGbqJVgD_rR5ldgpVi2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNxrVDicrxwdJsPE0RTvKLKgHJOla1qgDg_gAgcVBtPA&oe=6A5B61EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3ttEzY8vNcQ7kNvwEPLCeI&_nc_oc=AdoC8bFwlrjID7PczVonJrPRHO6AiQ9lw963E4qzzV6VuhGEupoOrnIGE6PTpZhaHOY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-qU7JoB2KysxlpQ5lJWuBNzOWFs9UI5WnXJMxZVQtgA&oe=6A5B623C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DDi2XepADEQ7kNvwFERT3G&_nc_oc=Ado4RCnMtOGBTK9CN6r82E7cPkRY8HUH2dErCPJQBc5CGBKEDX_gHIjlh1qV4xZkcBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaaZt-1sbedd_qWtHqqszzGdBE8_GsNoqsMQa3Ew7kEQ&oe=6A5B697F"}, "is_concept": false, "is
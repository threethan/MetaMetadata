31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7MSdICfmGQQ7kNvwH0Ma9E&_nc_oc=Adl4A919N7gVUE_k6fTQfELaO2q2_jJAkHq8f_fswEPEOoBFTDcmRzd0YzBUecbPWZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNw96luLLWJ5CVVyW4wAsa6tN8PgHjZXlD3YXoAijNAg&oe=69B3EC6A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSl8fI64YTIQ7kNvwGlOSJU&_nc_oc=AdmWcnlTcKp6Vop-j1wvHS6NwCWkHU0DXc7JYGHz1o68d_vBkV-MJwxCBa57K3WTktQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPTxVOd4BlK-aLvgCPrwPhFtMW_4p3RfFI0jO4XqdqjQ&oe=69B41C46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRtNmE8GTtEQ7kNvwF-9Z3M&_nc_oc=AdmIa9tKLqnJ7Dvtdp2BnPB_j8O1K2UnaBoAyyZAYuE8RLUibRUAhB0PJGnFC-hF94U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIoEHiVGw7bgULkra0lyxv66GOy0pd4D0zUcKP1JTgwg&oe=69B3F36E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCARqN-ZugQ7kNvwHkVTbJ&_nc_oc=AdnEDIExl8nQRusbO9Xyvc5meuxjHmnWdZ_cMEsooBMrnoCtIJnONzsHczHc6-03if0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyi1x3KT1iHcTfLHWkz924DgJfoN3jqDCKOYfe1cMhOnQ&oe=69B3F3BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNfLM0UmZPIQ7kNvwGpBUxt&_nc_oc=AdkRyv0qktGCeIfO3gvPddv3faXJZSb5CD2FeVfNqgZFi0zVDTOrROc3YsiRc8gKZ3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4B4WNxNy9TbFGi4A2M67WQspBguY0QpDlizSGJ1W6EA&oe=69B3FAFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
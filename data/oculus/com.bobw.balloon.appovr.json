25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-sdko959FoQ7kNvwGMfbdw&_nc_oc=AdpGrs8aQqZMIozLVDda4_HMBu6BK-ElH9tsL04LErGRncxtX2GbnWsXS0Cs3bP1hN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i8G0Xc14jm-6-5ueyOJK3X4yNrL78Kkb6kR2x4UocrQ&oe=6A2828AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZHj8T2is3kQ7kNvwHa7o1b&_nc_oc=Adps1NIDl7zLARbH8dyiZA4EK2ra7z_ZJyq2IWGDLQ6hVYB-5qMrKVmTzQyravveNzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mNqLW0QdAryaT7_-yLPZK88B-x50EBYw56a3Fdv47Cg&oe=6A282046"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAuxMNfuhKgQ7kNvwGxR_Hx&_nc_oc=Adrb6z4cp-io2izOnA-y01imfDERkpUcMckJ7olGE6b9yy_yJOOMOnZ6rClnOpe-oRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9du8Z24E76wo2iq4Jb53eKPv5uWVJL3B9E7oVg8iEjjQ&oe=6A282FAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PxirwldWGMQ7kNvwEL6WTC&_nc_oc=AdrR_JCDROSo_cSuFrhpOC-1mCYVfeKmaPvDMiHlWlETW14RGc-47etu9F6BYLHkuG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZLR7Cyi1mzomsNFPxOA7cplZX0-jzeHaZ60JKpiZSEw&oe=6A282FFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyS85-NLYPgQ7kNvwHAltfV&_nc_oc=AdpaOYOAOhIDYEuRN-YzvpEqFpHOQFWDj3tvEpon63nl97oVRnETg4q6qs_Lq33y0gI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ayilf118_U616iHKHkEzZORcPmV7xkiJgaEnwA4HiNA&oe=6A28373F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TF2GHwt_4cEQ7kNvwHVrKs7&_nc_oc=AdpzYaC-YzQOsWB9AH6egFipl4VaazD2dVj8lCeXZ3RQFH2_vEiqJmYEJxIWanydn7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkx7Xzi0FXofKCU51147yTFqsj_9wNaYPvOqHEIkYvPQ&oe=6A749FAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkSpdbYZk6QQ7kNvwHQyRbP&_nc_oc=AdpGrayz1P_8ceV1zmefaOvnVpSzKc4KOQvsPQMudJJIBIlK_DNZl88MLZ7Sr3AL0vs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1zH_6vFL4gIeNDf6Tnf9izRj3r7KawRuka4fmAnkvAQ&oe=6A749746"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DmktP5jVnIQ7kNvwFXWMbi&_nc_oc=Adqq1pfTZz4xeEDJNiA5UjFJUFTDY00l4vbdyb88b2oqvr_WsqybQAfkwAsWD_RsCqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Nm8mKmoB3npMR5rUHgy7h-OOTU8p3lrtC_1KGl9Klw&oe=6A74A6AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owjKpzY6mHAQ7kNvwFCujFP&_nc_oc=AdoKHr-JVQCYZxk0lFse__7jKmfsBH1xczHzgF-OhDgWfw64m0f2Hw5cz-mNr2WBhcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExjPjOC7KcIkTQWD_eJamaAAJA73gtOhTGbx6TygGOuw&oe=6A74A6FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVn5bKJcy70Q7kNvwGy-cfD&_nc_oc=Adrr37rpiwZn-OiAPW3KHzwMDh1vc_wdSAMJk-PtGTPyV2hFKWfx6Fph3aNbDoVcuCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2sMgO041iNTm5RUecrnmx-6bc4fwfg-nVOxW-o5PQ8Q&oe=6A7475FF"}, "is_concept": false, "is
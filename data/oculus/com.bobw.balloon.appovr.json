25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZX72MebFQ0Q7kNvwH5f1Nu&_nc_oc=AdpIpe8sBYBYQMPCtPWOf-XnsyQjHb1uteeo4RQzDY3M24n5sYHmrZGIbrEX9V9Im38&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ANiNdmgcrYnhH2kfCUQ-PL_A-RVCfCpJBgbLwM_0gHg&oe=69E78F2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H5JFMV6CoQQ7kNvwFpJMJL&_nc_oc=AdpaZ42MbXf9yUqITI4_ZJmx08qEfu8aI54yXkNF9RIvLFuEOzx-7w6zV4gdbc5IDuo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BKnU7_ceUT4TIBL3lIlNuXWPwWzg3GCu-2z-pbJ8-CQ&oe=69E786C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stiaxORyvdEQ7kNvwG3ZdoM&_nc_oc=Adp9jh2PkEq789JYy_WxqK_nIj-c9MJ9lvj6xZYCsLtDjBCiRcCwT6q2bRURcn3esSg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rrGdY8cr1_qsUCTNmPWCzGmxp_6RMXMH-Gy9IAnNqow&oe=69E75DEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nmVJeei894Q7kNvwH9-2NF&_nc_oc=Adrk519UG8QOaqEypdRKFoU7SEv1Q6VxhuTPk7BCxtuzZWet3XCtq7Q9bNE4vhJNgnE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mR8qASAvwmX9_BrvkxRGWJEFphZIwY4XHj3tN8G5q_w&oe=69E75E3C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKAsstY7cYsQ7kNvwECAN2q&_nc_oc=AdrXQXUtmqsTqIvp_QUBXD5E7ojA3g6ldTjFzNwhNy0QehTVg5X3tjIfIMHCXBsEsWE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-6FeUUSEWKsPncXOVGdGX9yTKReRBt4tg664Og8aVhw&oe=69E7657F"}, "is_concept": false, "is
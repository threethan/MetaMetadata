25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ8hcWjnfqQQ7kNvwGVG1kQ&_nc_oc=AdrIs9D6mse2Y7wg-DunNjBwVM1xSFzhK8ozfTc8rLtkPB07ru4hpKQXZKUTVu9rkOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG0rgqYUwfUIuwuJH6nhBXzVp7Eoun0AE2D6ZxyHdqFA&oe=6A5258AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT4DIgHDFo0Q7kNvwENVJjW&_nc_oc=AdoLH1JV1T4-gdUK-Z1wGpcBqifsjzQbBkZZTV5mcBJy-HT_vAcacQdW_aH39nSJCfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwuDZyZK-p0mtx7FR15WEiKAMsHINZVLzAOSNs2XQdmw&oe=6A525046"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBCenAaDkzIQ7kNvwHJ9kEi&_nc_oc=AdoK9s9uog_H_nv1zcQnd6s1ykYxDcECMX3q5pxMAxlTy4AkSqrJC8K500iv8cxzdb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYe8Rcbz14I72ETu5-qsoFuiRthhuPRohbhnDc99n_pQ&oe=6A525FAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTxqoDmuEnkQ7kNvwHqSwxP&_nc_oc=Adq-6X_HEfOHm0qMEiZSL5a-suGAaRT_NUapM8looiWwu3ZZn5HUZYYzfEKwlrD6eF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3wAe0ZXHLyuU5Ahlv2icZTFoyG4WKqTQet8dknNewvA&oe=6A525FFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SknEoAvqyGUQ7kNvwFuLdpf&_nc_oc=AdqJPoJI61YM1rkErwaClUCp1wGxa7Xucsz7LCHZfdtDfBmM_BlklC18-B-qs5mEU-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtg3eg9eVKRNnB5hPr7Q2iSXOG7wsyDclGoB5CSD-rrw&oe=6A52673F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klijVOpSTcEQ7kNvwG_P3mA&_nc_oc=AdoyB49QUgkyoum5YlI1hGwwc4xJK2kiShizCgkEt9AQIKo6TGTJJiDw-wI_3zjUE24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PkAQpbeGelQ6kR--578Fd64UsoRVNtUGHeAmI6BbDCg&oe=69EE26AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWTOTAhjWZIQ7kNvwEY5hxQ&_nc_oc=AdqCUhPTvdvw2TYedtOQEa5eDE3jsszAk7yJgaHWfLxWBJW_tYZKClYaK6ZmwCgZR6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HP7MSPiRovvs00kfQX5urAoHKWGYe3OIs2QXyD-6Ecw&oe=69EE1E46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOYltIg2wdMQ7kNvwFFtNmH&_nc_oc=Adrm1uZqJ09y8zlXVrbhvqL4Kp_1M7BAgV30e3-wKQEPMnd-o2YYhPcoPXkaUShxI3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Umz0QCLTVByBZcKbM48LchFW7mTLRiukPZQ2pcVVnIg&oe=69EDF56E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIzHDNPQNnwQ7kNvwE3SGnn&_nc_oc=AdrIjHgEFWgVaZxeOl_bKGgkGXPqXbcY0m8ZHM-1X2QTz87JlZGCa6_XJQByJJbkruE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10_M2Tg5yat48Tx0oYC2Cuvnki1FV0XBVnWtBbYwsr1Q&oe=69EDF5BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkoa8hP89xMQ7kNvwHGcHEY&_nc_oc=AdpHAr-yYW3xJ8DgsBie2K1f7yxGBt8wKjS0I5-qmF_5NufzIlNqBwtux4cFCPAYbaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NGPac1WDQSVEwz8qto5I4uHSz4n9AOoPqW4EyATERrw&oe=69EDFCFF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA7EpRVC9jgQ7kNvwFOgxOc&_nc_oc=AdqJ6juxI7F4-fz9gFOfWTC9wyd9zGFEl3f9zm3wmqj8lVaVZedBYWXxcNX3Ed6cDn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUCO7SzGiUOsG-h4PQqMMB1c7WkVkOI8LTx3Sq1jYNCQ&oe=6ABD222A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEDGYsBWbLkQ7kNvwHqeEQC&_nc_oc=AdrbDX6vpiwJVbZ1kJQEGUgtWJQipne2sVsMsM_EX1scXl19T1u3TV5WRb8VlRRlE7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw7uEJKCrHKYCzEQsMok0I6UkjFwGX1rcxuOx1tFkf5g&oe=6ABD19C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge1e-Zin45cQ7kNvwGa3X1R&_nc_oc=Adq9KEdrU495D5FzlWzF1sQksE01gc2LCgxnvlQTUiAKBQW3SP3lIHul-oPx4syWRb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6AK9hgLqAscYcjq0nxyeg8hZdi5KA_pO6yRi8vNSFsA&oe=6ABD292E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjTA9dsMA6MQ7kNvwFeBrbr&_nc_oc=AdrAmxUrn7IgH58868_qk44_Ehm24CBPudmIXtPSY7R-SvZFiEf8lRVNA7ge-gIQ2As&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJduvrHwWhuF9wo8kI6TAponPcGNdNxMLdcv8HpOPRnjA&oe=6ABD297C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTawVrAjn-UQ7kNvwG7eJzT&_nc_oc=AdqcpmY5G6nq-Vb7X28MGEFLNMnCeccyR57NJBvkE9cLsnMMYKE_yyB96i0f1W-L4NI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnJ4MGDaEIBuzsLBIscxmBT-arXTJKgEONU2ZYSbqmRg&oe=6ABD30BF"}, "is_concept": false, "is
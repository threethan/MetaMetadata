25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfw0krJFnk8Q7kNvwEgaZ3G&_nc_oc=Adp2sKtSyBsmuKnJi0RGCsFd3oslPrHEsCQDBCvaFtTRN1BVaPMI8drbudwc0DsP3Hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OCSOsPu9ecgj7bfu28rI9s-hyNuTcnDGGwA0yjpgoqQ&oe=6A0DCAAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI4-h_qPemEQ7kNvwHRX8gh&_nc_oc=AdrmE6pI3eu77cX1EW3w59MAO3O7_yKkmhlURYrct_yY_7WIptsLxX1WFGuUfCU1S9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rV3IVyzhKml5xR1NZIsKhtbB6cExujUZYqCroG2mu2A&oe=6A0DC246"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiyF4PmmC4oQ7kNvwG9HgNj&_nc_oc=AdphnuWYnoU3AzI7thh181HRQGF1xtHkxHg-Wbqy6evI0Vjm9USYaqSdYsAZMbhX6rE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TV5th28xRc7nMlexnF4Lo5oD1MkNQ5CPTED7A448ZvQ&oe=6A0DD1AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op9bZFHnb60Q7kNvwElLVEC&_nc_oc=AdohSx00KIPrFuywS0FBvVwU70dIl9y_DAlK6up9EpabHRBz09KdbPoPYetTyBXwABs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65Id2yB6eDraMclm3rxbs35zhboKG8Jx2wjq_zBWqJaw&oe=6A0DD1FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de3UmtRhk-0Q7kNvwEt6SrY&_nc_oc=AdpdkZaMuOakbd43_AqCa57UOdPGlqDn2rtQOJXS24Hata0H04cSaSJZ6R7J3cB0YuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SwzCSRu1rimsPwElFNmB7h4MMoeT5lvsSAVU0B8JRYA&oe=6A0DA0FF"}, "is_concept": false, "is
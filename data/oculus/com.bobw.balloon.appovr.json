25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKyOLXhgeFEQ7kNvwEissKA&_nc_oc=Adp_7fJOgjkPUO_0oeJoTcd8ucNfNBFuVY7MMOmjj-RPAOmuiQXj3KPfs6bRxIXFlXE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14k3rB-b6LJZWzUbVXjgXN_YQXFQkLoVPK9ky_c54acA&oe=69F60FAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWMINdy1bQgQ7kNvwFtN1q4&_nc_oc=AdpkSEs8ldKZTW0YAE9XwOsh5Q0cZmXFGLjjZ-up4PX7trNMAX9e4svWFZZGrmZWK00&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1y7qo55_xFH4AuHduH-0Z4GH1DPvzD5RucSIfN4BWQlg&oe=69F60746"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AsWkhc6LlgQ7kNvwFsap8N&_nc_oc=Adr4JN8Ks4WFqTnP9Rfi6LVinFB6UCjFJOXIR020br9zs22gK8Xy-8D6EaMVoh07KvA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lY6_ttoZx8AdAG0qalAEUPgVbC_xJeJ7x6u5cNIU4rQ&oe=69F616AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWbPWuVnu40Q7kNvwEGSibi&_nc_oc=Adp9dU_-Z6XwWY57i4XjrPN25pHlN954wMdX6qz6q6XFjeWh8BF39lWXH49OOgXaCTE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-WFvnjptE8Vs-82ZFdsRBhwxLdOIEWk_0CsjvffsU7A&oe=69F616FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biQukI954GIQ7kNvwEp_GTv&_nc_oc=Adp0tpdhjfnrfUlCAZ8Co58qASefQXvCO8Yb27aYRDbGpvmFadkHwX_tacmoSypOhO8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kH4N_sshAAzvl9h4YoZrQ8ZacmqlYrok7btizlSJQOQ&oe=69F61E3F"}, "is_concept": false, "is
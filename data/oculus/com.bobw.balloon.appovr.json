25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PQq1i2iJ2oQ7kNvwFxn36d&_nc_oc=Adq-dxvqMjYZCUsDH7A5wrlkm5z5HG_SPWzlXAK7htP6_6eEQj3ungBLtx0NAzE47Cs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16Ws0xETHfSLixteRuSoY6TUjaL5YzmO7ZdHyCk4_vQQ&oe=69DCCAEA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIdVyh2b_KsQ7kNvwG7XfFF&_nc_oc=AdoqlJ70DX7O3KP-RiXY7onePspulH3a_lIeiC7C8GxDWD71sXByiMHmn1bHYM0aPGU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nr_1mbmMbNPzGyesMvZK3uc6z1MNloyzfzKUb_PbVNw&oe=69DCFAC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bebOAa6mx2cQ7kNvwGhYTvz&_nc_oc=AdoIx5BJ58Bq_u_GkAYvAbkg1Bcuc3pNbaqZwkn8t3XxXj3eREvlyGRJI50osY9YZ4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33jVG_34tKkrmfhdBPiS6KOPQ2tkUg-juSGkV1YFkFCA&oe=69DCD1EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9DT9IreEvEQ7kNvwFw32_o&_nc_oc=AdqqAG0zA-3IE1o-avxXp0jMVL-AckRfd8KwciUg7GBz8ZyawyD1tXN6uPMu2ImUWA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T8LUGdvpM0KZxIpWE_871fRijgukE5JLAX4wwHqDDfw&oe=69DCD23C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4GaDm94qaQQ7kNvwGLWiN_&_nc_oc=AdriSaTl5hjJG04K0NeO6wyl94SAGDM8NOaCUmvYoLAowBsdA_w6gHXp6hhVVKBsqHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XMqC-GclfNlDJ09R-tuSd7JQHncL7viEM3OUq0xBP6A&oe=69DCD97F"}, "is_concept": false, "is
31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M0CuPU9ddEQ7kNvwHBj_4U&_nc_oc=AdkMIMSunPhcK5c016tF6vIsF2Zi3NiDxIuLwcjYrQlINdh93xSCowJ9nv9lJ-eLOMc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZ7mH6Wo9sVtXpLgi71M0SR4N_H_X83g6-t7PmdcT_GA&oe=69BA83EA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-y3zlWfoeUQ7kNvwERFH69&_nc_oc=AdmxzpXGMJU12Y7c2qDE7ZyTzuykgxAptWIuJ7CbhvfzVT-qDyGObBLJIl6cFZAEf48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCn4V2HWqCgH60WRjzFzZkEeZbBVMMYMAdfJmqT_hQAg&oe=69BAB3C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6id2Pi5ujMQ7kNvwHYgS2R&_nc_oc=Adn7hoMmMqB2FpphoZ7JKAiosdcUXbf8acjm9ST0GH2xAmRKzVTfgSqRHofjFMXlfF0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx66lakDKON1MXKxvPOq8Ioc2x2koA_2DDXTRO4nG2JFw&oe=69BA8AEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhY7aWWE7XAQ7kNvwGZpVms&_nc_oc=AdmoKuF_XG9laMVYoOkzA-8386EF4wQEPOcuL_JuKavse4bf-n7zZnTMh2f7PUtFyYk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjgOrE7nrrOYFl6VH_BNeXh72lV6EShedVlw3Zoy4PfQ&oe=69BA8B3C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zczvEhNJ2mYQ7kNvwHjessK&_nc_oc=AdnuSbzEQYhMCuFcySbjPdkU84J0M3Z4huNBkqdUR2WSq7uetoJBCRqytLVdAEa87qg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeVC3cVctd-AUNQ2eccOX4lwaPUkNHPJtaFSGbLHmBAg&oe=69BA927F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
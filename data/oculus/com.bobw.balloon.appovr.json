25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TF2GHwt_4cEQ7kNvwHpcQnF&_nc_oc=Adq8Jgz5eNEhpDJxnrY1nznCqMXz9F04gU8YeLBUtkqxllkh1EjWmnItBDQNI5DYe98&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPTnpPFP5es4GOc9NN3J3j-kIrBgYS14Rc3ElmlJyacA&oe=6A71FCAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkSpdbYZk6QQ7kNvwFwiZ7C&_nc_oc=AdqILhnH7Ft86gGDuLUTFtwFRWNc7i0R_8kSo3JtZIszIuHWKDpudbr9X0ei7qmJ5-E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvwL_Z2Bggc97LbHeZ7Zbdel6ake6pUcQCaY8I8PG23A&oe=6A71F446"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9pkv2qxFNwQ7kNvwHhbPHB&_nc_oc=AdoSfr5I9Uo-R_AFX9RyY6qF0qfiuRELZyEUv6haEAwrxTV5gIG3o0hrcm7ZE-XiBAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0RE-kKg3ViNnDUsjSPJbjjNIezbg5YBM-CvmndO_LvA&oe=6A7203AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owjKpzY6mHAQ7kNvwFrqMyX&_nc_oc=AdqjlG6bapaaE7rARzC2CTlQF_GOoS9OcA8rN3rWdpexxG160pPj9zd-LsBNv0So2AQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGlPZE6BnKqolzz68eYnZAWZCWTfhiHxdsyTz2jndCJA&oe=6A7203FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ8Wr5Xj9SkQ7kNvwEq58fi&_nc_oc=AdreJsci0ex3tOWr9CQxn_1_mCIU8uyZVNQ4_1khtkwr7HP0O5I4qyUixvkcesvGC8c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMPAdcBBg1RY7jmkS3ruh8U_r4hUfSsAps5EoHk-tEpg&oe=6A71D2FF"}, "is_concept": false, "is
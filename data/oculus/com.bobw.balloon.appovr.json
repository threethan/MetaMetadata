25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfw0krJFnk8Q7kNvwEyIVzN&_nc_oc=Adq3wknLZmHltQNw0Zwa9tWKaC5YThuDg84nqrXYJ_3KA3LPRhRDgy_kvp1xxB-Yy6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X8nMLBwmMq0s9z3KkS3Yr5_WFqlfJZPxXVHWznobxoA&oe=6A0B27AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI4-h_qPemEQ7kNvwERtf1y&_nc_oc=Adqqpz1ah_HY5XB4PIoHDl_g-LuKA9MOdxiFyHzSb_yraWl7Dppn43yr6d-8tBRs5PM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_euOt3S5XkpefPmPdPOtmYKOnZRnZdph7elcD0f3jhg&oe=6A0B1F46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hXRvyNmb5gQ7kNvwGVeWBo&_nc_oc=AdqnV5qKRBKS298el8rz0BX_UqKgu-Psu5-3xRA36tWEoDHUCVN0SsRR_1_1w94G7fY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V5hRjFuv81yyW4rhhsjaXQKdALfjDVknzfl4pGMjbhg&oe=6A0B2EAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op9bZFHnb60Q7kNvwHpxjeP&_nc_oc=Adp6aDm96coCVCCPTfGdbd4G_E18f6f4o6vghFSApXcsJzCm_llKG5XYwrz3Vo6WB2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S9_D9q0i44l8JdjzlWXvM7RiNKmWkYo0ntrOzlFlWuA&oe=6A0B2EFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt3LP6QvlC4Q7kNvwEZIjKl&_nc_oc=AdrFQXdLTqWcgHa7RABkLaRMArTctRCFIEsmMqw8p42hVnmV-i3l7ecI6x3W4_imBuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YE0hEf0DBOxfRYS3JJDGsHWjvLh1-syG8aLEClsYhNA&oe=6A0B363F"}, "is_concept": false, "is
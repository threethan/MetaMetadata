25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av3rpewGTp0Q7kNvwF2cKqw&_nc_oc=Ado9nfVkEhXA9s5Zo4Tmmv372ezyvHMjVfT_7uKIsWwngsjYg0N86z22oTaOfJqy6c4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZCZF8mws3bBCpawoqAFkkmtSatExSXcNKlTPbCfYEAQ&oe=6ACF972A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lvICPMoihYQ7kNvwGm84mK&_nc_oc=Adoanb0gm4_WGI10qZ1dH1vK5P6rr9Yh8NiG4wfRqiS1p4B1fgqBO8RFgTVdUQn-ehs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-jxVoIQEqSi57PESMnjpsY4wtmtxPw9T9x9i-z0197g&oe=6ACF8EC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtxgSesDAfMQ7kNvwEqKWGU&_nc_oc=Ado3KeOql7VwLcyDgLUQJ0UN-Qpdp6anL-dXE0r7QQaLNyagLID2A2y6JKQsk5uzLNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN7ej4p1tIeG_5U8uQ7kpKvRB6M7ZGKqXfbQk3kqDvtw&oe=6ACF9E2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGYzSzu52joQ7kNvwH0Fo7v&_nc_oc=AdpS7MhtMyyw6qCa7Y1etrtTXfhER5OEmmoDhXqdBVG_XWU2lDRerVrOqlUek30qbOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsHcFW_u3JELcS6YuQlTJb1bPGaXI70WZVRZY0Xod_ig&oe=6ACF9E7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXic2gka254Q7kNvwHx-tHB&_nc_oc=AdoOZk9KqmZklm339mGg1ZpCvoucuOeeug2-o6idmR7GgiQWCcBAqvlK-M-1cmtlD28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP970lpCGHel9y45HihKQmmxQp-ZtC60AT_3FpuYcZeLg&oe=6ACFA5BF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faBPo6kwOWYQ7kNvwG36JBo&_nc_oc=AdpNMJGjf64XPewWHV0CcCzARJXadsyqsgodisqqIQ_2vdRZiweQUL8j4F7yBPWTt1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k09ZvvtLAUPUT6otJbEZMRrdn9kyMp4_OSfVq5qcvWA&oe=6A2D6EAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez-KMxVXi4UQ7kNvwEKfw-F&_nc_oc=AdrhLgE8E4vYFwD5Xr2PYpVmh5JWI6wtuOEe5aeWuTvWnKPJVQG8qyu2wLkwUutIFlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91XpVmlsz_eRZvRPQXmndC5vLBCUbJN8QWyFPPTGMFMQ&oe=6A2D6646"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRF6VZ2QyIMQ7kNvwHeIUa8&_nc_oc=Adp4gKvO-ox-kUf9FZYnB8nP_lSSz9TKrH3_68cOjH6Ozf4dy2wEYhoRDVeOj2p1hgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s7CUxTCG-ZlcJnHQt5MvUgjLiNJ8OTiESsowbyGHm8w&oe=6A2D75AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY2Xce7eAn8Q7kNvwFmMvvz&_nc_oc=Adob5qss3rToN3VBfMAm4nzEGaLVGFfkwEwJNH6PZ2GbGp5ce3SIstpDf9c8S76C9PA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OomZGW5M5zhOWbRH5tduD2ULTUP7wj5VgMHxs72ZLPg&oe=6A2D75FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRDLYLZybXYQ7kNvwFEP57u&_nc_oc=Adpa9cGf0wo_a-2EI2PJbevh7tUHRrpOFeuHSs45I6HsOsL5FxnJuivjR0xPPplPLuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94MjMHc0PqHzxlDDt3vE0XNlVw2RdGkACkEReXH5684Q&oe=6A2D7D3F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goFV5b1BpYoQ7kNvwGQujup&_nc_oc=Adqivkl2yOud4QL10jFVlt26y8LKpsxBCXWRp7mV8vH6FYWqvEfzuMfrv5Cq39-HS80&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9EXAO7khDCSekbWF1gj4j7a8dxPS-tQ0blkyb-LGnzw&oe=6A9016EA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18PhMB27X-MQ7kNvwFs0w6P&_nc_oc=AdozRqpRpFjafOcAm2Qk91yqU0lWsoeiyIMdtONliNQ679eTrUGNgGomJG6bNo0mEyo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbxzH5C7fISr7BQUsaRHK7-61jv5A97fR5N1X3LWe1_g&oe=6A900E86"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXXiddtABwYQ7kNvwFdUtWp&_nc_oc=Adp1Hxv58i0a0gWZp3mAeQI6Z048BJb1n4vRcCfketXFBzrn8MIQDCWg4qEyLhxC67I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKDUFz88QkE9lnTOZx1CWORr5XJWzaeZbpOgZ6Q5nUIw&oe=6A901DEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7-lpap-0_IQ7kNvwEy9O5y&_nc_oc=Adr1k5J5ZtbSWhOx5g_jPnpX4wf6jL6E2YE2ySJmjffMciI8Zb21t1uzG4f3YvIonOI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDYAi5pquEKtfA9KtGKangHtVhiKI_ipTbCNv4G4SHnA&oe=6A901E3C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZrZClvjBgoQ7kNvwGc78Tx&_nc_oc=AdogBrLnI0VYbIB3Px6zPVmFYv9p_CufgI0AW_-7gvEv4cDHOyYU7Qx1OxQmW9_CSgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt8cUE0VAFZS8hZFQ4AqCG5oI1f-pEptjHTNr2QbLV2w&oe=6A90257F"}, "is_concept": false, "is
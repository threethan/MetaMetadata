&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjP7jJoKWq_XEzTvPZCscbdO-96796yF2HEnyLD6dF2g&oe=6B05BDFF"}, {"file_name": "5.png", "id": "1129383820805919", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zi_l0rRmSYQ7kNvwHi0rts&_nc_oc=AdrlvcFYxRMkSPNH6-Vk5PLw0HB43udawGoR4B340aspvxPdhkr6P1C_S_pH_vkIx7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3WQRGhc9NcmJy5RC_5sl63MEBN8-qPz7j998vF4Vmnw&oe=6B05A4AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgjvGcRCmQsQ7kNvwGa8fLm&_nc_oc=AdqRHXP34ZIsieEl35phaCf0Nj8QySHf7nIQjtbFrmjggdcN9aLcpkdRt0dsy3pphBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-8LaCFffUUAQ5FcsLhnZkS-dIs5MleJiAjCSDNJ7dIA&oe=6B05D486"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw4xR3qBSjAQ7kNvwG4Sr1t&_nc_oc=AdpwRPZnLZOK-s4kwMlRoWIG3-hDqOn8_Mmi8M0s9_7tLmAh9-57SpvsUoUj9sSHpW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRACMT2II0NJT1DG6CLvQjKzgxeEK3w1WZlR6RKeQ9vLQ&oe=6B05ABAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5yTO0WodhIQ7kNvwHf_xrD&_nc_oc=AdouV0JuIMUrkZ2ARJT1XQUNKlLcRZJTUcTMFsEUyZ86_ly419_WrDX9mtQECGYveIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgvPCqm86vfr94V0I4XIvVogm1o8YmnILZIZBpt8TfsQ&oe=6B05ABFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_26
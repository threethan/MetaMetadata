&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcAQlOiyrW3pJFAErWRy7_Hg7tmDFD91ptEdIYEJ3FIQ&oe=6AFDD4FF"}, {"file_name": "5.png", "id": "1129383820805919", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNeuUeGUP04Q7kNvwE9lXRw&_nc_oc=AdrGGeniO58sJKWma2QkHEhgT6PNi0B0ZPaAxQNicUfVUYT1C61HS8rBtMXVcXqrBW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDUTSLY1zOTobZ1R4v7E_hNPsQjVAPDZj_-bXxynbIeQ&oe=6AFDBBAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azB-aMttjh0Q7kNvwGbKPlM&_nc_oc=AdrX4cnajLA69z7m4Y6nlkbkeQIE4T1IxUdTlV12Y5xu814-5-zX5Y1aJL6zfV6fogE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN6ugY9xJAZh-NRvjkWpUVXsWHgFrCLbniPzFku2zUbQ&oe=6AFDB346"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHJpqSW8mNgQ7kNvwEHZDs5&_nc_oc=Adq-imTvOlDfGA8uGlU3F4JnBdr1LW3t0HNWtXxndOWD-WEe5wZ9VmLtwedht85zyh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN4f6K0j8bORyF_qaLX7clQd0tml6YmITk_z40tlb1Wg&oe=6AFDC2AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whp6NCjQpHMQ7kNvwHqVuwE&_nc_oc=AdpIiMQBEmSF50YVMmypAYF2ZNPiJeorgCdhRqjTtv6zakITcTOB-58rD4t_PRZwJoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRalSTX-l1RazCC313erAO0cNrZHLDtSCD5DdRy84Cq1Q&oe=6AFDC2FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_26
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt2tngKvj5EQ7kNvwFvLdrl&_nc_oc=Adpt8Vq2CHSR257Aps5A4-gvDtaOp5PlrhKkPICK9TArQ7yZcCLdXsyS0sIeDjC9kIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV_YDweH72Inct0tAW9i4IE-kqKALfZlbLS0TB2Fa2hg&oe=6A6F59AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM5m0ZkSUGAQ7kNvwEZiPh0&_nc_oc=AdqUSFeSraLLGNrLEmW06NMWMY5r79WzSMl_u3IrG5Y_lymPYdRgASXNWyZV6I63-d4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNxUpBkoZFAWIQa10XuZks4U6iZdsGIaKmAaFRwN84uA&oe=6A6F5146"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLs8yV-bQF4Q7kNvwEu9QPI&_nc_oc=Adoaf3j9N8aF16A4R5DlnZuARTHby3JM6xa2d2nCJn2opmWcx9Za1qvhI8R_g5O_yz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmtHrCNr-WFZd27jeTVg4Acr1LWVAJvKZWG2-a3JXXlw&oe=6A6F286E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCOnDJVO-8kQ7kNvwFdLD5w&_nc_oc=AdpExiheIToQrlILglkizk2T-tFiGKEvFMbVg_5SXn8noyYnFHWnu0Gv3QkDRbTp6g4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAti8xLinLnlTm4LKFdX8hErApk_6L9YZ7F2pz1uDqjyw&oe=6A6F28BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ8Wr5Xj9SkQ7kNvwFRBKsC&_nc_oc=AdrefkU_OyRMCkj6iaCIlXPHis1p3dP4Gp093k1pGmVn8pXg2Amt4eQO4ZAqSvhji3M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKEU0P7AyLB7duzZyNibCF6_vZHmcbEmtAItGpdRmeeA&oe=6A6F2FFF"}, "is_concept": false, "is
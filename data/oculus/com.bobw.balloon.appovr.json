25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_AUlI98NE8Q7kNvwEL0hxY&_nc_oc=Adp6XVvapiZJ2PadIsCgFkYDxpbKW2XrLzKFyCPSrouBIykZPqbVIinJb7S9dxTHFKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FOoA_p-VL_f5HS30GQJTOb6YN-qmLkpRV5oYJDFDKoA&oe=6A41352A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLBbGM_bqA4Q7kNvwFfmPtm&_nc_oc=Ado7l_Wn6VapCYPokZ1WtYcSwzhsNKqkFZ5l5Vw1E3eY6OSrEIIcW9iqzYF-ecCEcK0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KNbPMQUj_VD5rDpUZcme8GU0cLyRK8xauehQASoX84g&oe=6A412CC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TbFuvi3npAQ7kNvwFopW97&_nc_oc=AdoYsF8zNfPFYnpaec7l18qoEKnI2zxy7y49rD7UPjbXi3mjAQTkmYv_SmcbmDxK9PM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_AWcmu07uRRNJEx21qLqzyxFLaQHqSDjrgoi19KMp6A&oe=6A413C2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZunxSbWJpAQ7kNvwGnbUHT&_nc_oc=AdrjICNc6JKM6AXYMIwNzbVGq1HVYMWTNPiqBA_RxYUWW6cCqMHX76P45u5v1Ub0CRU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bTv6ZgCaQ-6es2fnjvqdlvJE90ocPoz_Ebth8StCi_Q&oe=6A413C7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8lcxbqqkW0Q7kNvwHuUM44&_nc_oc=Ado9jGx3puFJzaD7P5SzSHdUeInwvyZ9s0rnsIE0neBesDeOHWs4ygzG6627tBdBgPY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qsSHGCPnqQyaa-WRTkxBr-suuIa3cjuyTwCHZ1rE1gw&oe=6A4143BF"}, "is_concept": false, "is
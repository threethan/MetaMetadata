&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7xFa3vA1GL6rFG9h1JBDuFv5CdjMhvRt1yo3J_i_XAw&oe=6B0B3C3F"}, {"file_name": "5.png", "id": "1129383820805919", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5fUfi8tt88Q7kNvwE59f1K&_nc_oc=AdrJojihEtVYAgw4P3G6lM-XG11ACMXjPEWlXj_08stbMm-EcdK8siubPjpLSStaXJA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxf95nA2WLujnGkhsLSSS1fu9aBAqXa4xc-pZu8oNNRw&oe=6B0B22EA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5_a08DmJPsQ7kNvwF4dfwn&_nc_oc=AdqZKj2nc3BwfHtZijcXMFIVnGJDnQg9AMmDMgCjqwBvAL-7-jBa0vUynb2OrQqdeqc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGsBqyIO-BRZ-S25EbQrK3kWvyNr78u6kLQVEwLTFt1g&oe=6B0B1A86"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z567ATvu6oQ7kNvwHt63a-&_nc_oc=AdqRffoBgfUGSkHoFM_ZQIc579uKIcBi8TV3N_uxY7NrRc-1BjVKhNhlRMWFI-gWTAw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEzfTna25qZlzcbkYb66quOtl9wLIUgaX-HZgpznybvg&oe=6B0B29EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydvgSWpJiLUQ7kNvwHrH1hO&_nc_oc=AdoxXYDUushPIcL5KrSMkyZRFhZUszDt7LXu5NptSYvbThvm1QhZGkFC_HTQgoVYxbk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAibLzTxEuosYfh-ODov_fl_AM1Kgevun-yNUAOrOB1A&oe=6B0B2A3C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_26
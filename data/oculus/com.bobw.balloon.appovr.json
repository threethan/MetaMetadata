25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8VuTR_G8yMQ7kNvwG5yGm9&_nc_oc=AdpJ4SFh29gWJ14dPcDPDIRZQ_k6-krVQ_JhMfNtxUCKfgouBexhMQGtlILaPzzN8ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh6g3I6euSdASpzmG7l2Bo82oILQcHuxiDSqlPFpt7Mg&oe=6AB7DC2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQCo3vgyu8cQ7kNvwFhQiRg&_nc_oc=AdqL5Ix-lweoilT7W8g2Mp6Z9gfAzFmI9ZKpUcuNfd1RNMRl7qMT8lUvH-aH_FKV65M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmbdAJTK1kMZIQQr9eOvZFp-38_icKHKfH1JO_PTmLPw&oe=6AB7D3C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VISlKPqVRMQ7kNvwHkTGwG&_nc_oc=Adr4Tp-zINxikFXJGOxu7W3Yvk1Pr0g8GAoGAEKZW-XSGa2mhk-ymcXkgInrex79__U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJGHDco2S4kJzrpIA-cZUTPkAZnec9Jfb697FBzLIhLQ&oe=6AB7E32E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vvi47wV8VMQ7kNvwEXguGF&_nc_oc=AdrsoCxhNoyDsfewH7jrmf1lq-k6FSpij4kCrnCuk47mzkTBF6zaHBJ800Fhauwg4XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6aHUQRM9peKfv-C39xfPYxCUjuFm2E4pvtnn01CHYDg&oe=6AB7E37C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZQM485JEC4Q7kNvwETk_ce&_nc_oc=Adoaut6A59y4vMIvq9rHQDWzLFPiBvHjxxU2G53N3ClydQbmXoSCZyGifWuA1CzlTnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDxV9Bue9vV_ehkIEnENfbpvbtE77R_ryxOLxTFkRLhA&oe=6AB7EABF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzVcqWvwEfgQ7kNvwFGHNIq&_nc_oc=Adre3CB-ss-wQZmJDkh0K5fLz5UDZCG6ujo7ig8WAEQ2aeZphZoCVL9o-YHuqynGgGI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj6J19YtHBXutYbE8fZfI0JByZq8yx1uBMR0Km00H7zA&oe=6ADCC62A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8u_bQTMrvkQ7kNvwEgDkuT&_nc_oc=AdoBNmzvHbubj3tHC7srwahVQW_UZlgv8FYlsua9foBU5hMzBDXepfYkaz8K_kaFtEM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvhMORe-OCmoep-IuWjDUcYxPrRu8d0x_UMbCpDPTbAw&oe=6ADCBDC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfpE87RQGD0Q7kNvwE-5H-W&_nc_oc=Adp2TDGgmWk9Bhr_2kYlmkoif396cYx4FfrsvANJbJSrJGpjIJVn1kcPLS-jVUBQ3OY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSfPUiGYeNlXEdWBfemMK8sQ0NkJhSoghc_XbsAI1y3w&oe=6ADCCD2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWaJu9xlUAwQ7kNvwFA7XlS&_nc_oc=Adr0BIxUapnUro_hpjSPI6oIczZ_EJtcCf_UlpCMQAgg9Q-jH5pMwOSdZuUEYjoDHDE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoZU8gTT1knYwLUgbvVVHzPYcMsUez5ftiZg-R1ku7IA&oe=6ADCCD7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjZoAlbK55MQ7kNvwEe6S8O&_nc_oc=AdrzledOh6dKCEZdbhG3XKzhJ6BNnulAV2Qgpurv-xX0N80ldRo2MzercnWWrGRRgPY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfYckgkDzgHxv0dTqmgTofzA-7Y70R9LXlKORMFN6N_w&oe=6ADCD4BF"}, "is_concept": false, "is
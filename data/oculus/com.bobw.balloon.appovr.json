25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjfDwNS2-YYQ7kNvwEX1QIt&_nc_oc=AdoxDXrF6HlxPGpK78AJ-NIv43AfKVhybl6RcMCxZxyn7iJP2QkO19Qz6KpVaOkcgno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR5vImNAYb7YMSkF5C5LHwn7hZhzL_1mr8ArlA6bdQcA&oe=6ACBA2AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxqr_LIcJC4Q7kNvwECvNcM&_nc_oc=AdpOV5RjRknt2H5_CQ4wPn0MRdeGkfbGySuvxoQLyI6TkOsoJQQ5HQyf0PiuasoRvX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr0qJPO_wGo0FuoRJjUvJInf4dt3m8BxKlDuynDs5eWw&oe=6ACB9A46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meM6MZ1g7CcQ7kNvwEfxaIf&_nc_oc=Adq70sHqe8EnhpFWOmImpQhmFzOdY67e-M4Ug0u-zUuXoraVfGaWPmPagfhoMDw8yCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5OK51UxsZNxYhevPjynv4EgXkSa_mqW0U2FVIaL2Qtw&oe=6ACBA9AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7bq8biYG1AQ7kNvwH5sXU-&_nc_oc=AdpTMkuxaGK4WyYV1B_k6t-kCthqQaf4J_AWsQZJ9W9BV-2jerYULCrnOa_MeYr0Yok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1_7pk2OBufjPNfbyVkjpj9WlQ6_0_f9J-K7KrhE_psQ&oe=6ACBA9FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9DVqrVfVAEQ7kNvwGVEfC0&_nc_oc=AdrVfsbp7bc3gMOh7y7-ks_HpBv9i6RdxWQMwAjM1x4aDbU5cm_7DpwzoSTFAc9MSz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj3U7Fj908ZFfvFe6KVPAi5ip7kwE1TqIoAvstEid1Tg&oe=6ACBB13F"}, "is_concept": false, "is
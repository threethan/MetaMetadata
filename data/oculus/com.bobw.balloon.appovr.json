25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URN5CUkNUacQ7kNvwEzRtxh&_nc_oc=Adp8XeSqXEdF39UKmVBUp4dsqkPGkd8C-1qlB0PU3zRRIMsGUY5UkgvmXdDSxWiTJ0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zYhFTy-Ae5FYjDy0BFGGXxuUyelyTVTc5wopThQw1TQ&oe=6A1856AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0rkbwJTcuYQ7kNvwF_mEr3&_nc_oc=Adrf6Zff27qaH_kIRgnXoqoCXwQJPhDCGo7ixJAhEggAfkz1pX6QH1dtGZzRVedr5zQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eU04jx_kF1BaQknvdJgHCUMaDVZ_cD9yGdwkIZwwdRQ&oe=6A184E46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJeVcFM23r0Q7kNvwF36jq1&_nc_oc=AdpOkuUBctE7EvY8M_3AcU-eyEpeh2RGRKirBGxpJ1UyIdc4uhsbwU2wZqLXbc6o4Bg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46ibGszN6wYY91426tu6IgvUa4rahRbK8YzQLp7uDsTg&oe=6A185DAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XWtWYEjRQ4Q7kNvwFjOsn3&_nc_oc=AdojMR5NYAPbm8f0wE4Y9H1StXrbO1vcS_naGZreuEPBTBsMIFCSXTvVNW4HvVBagSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gu7xO7XIUbff9w8mSPr6mHAXyaVhcKirgfSxgVSNzMw&oe=6A185DFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1eswXUcqMUQ7kNvwHhtLMX&_nc_oc=AdpRmwgmCj4nA5AbbyuxNSlhIOBiWprw2C2MW1BfomExs2wGVk4QX73uF9QBh4G6pHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af746bu25mp-vIdTIHSYw36mRFW5X2ZyAZ05xTpKNfP5Fg&oe=6A18653F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVhtBf8oyGUQ7kNvwH611HP&_nc_oc=Adr36wIVrShTePkx0qM9X0wo6yov-cOHF-Iw0MzfX_U4yu3wZlEdv-HHo-fhbWwVgX0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j8ly3XoPgiGwtSlXn_L-ndG_L2YBlvffE24eR6gT9jQ&oe=6A21912A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpDPiEI1Xb4Q7kNvwEWCy1U&_nc_oc=Adr4cn--N7qWmW7KqD7zES1LZ2gHU7K90Mmh_2jGC2SPwfdXtZQUTjke6yxnPLRK5fI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_84-L1BB8X-q1RGYAtXqwOz_l6o5Eq4WMu33kwyxQzJQ&oe=6A2188C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNxUwfWn4IMQ7kNvwGEjS6k&_nc_oc=AdrdWtjNdbXmOAb6Ewit1cti6Kgt05OktObPtPS28fvGOuYzDtH8Y6LsAD8wHD3ekwE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ebqG11io__QSR-qArhNC9q5gBJpMQ9JEjv_vRlGjEqQ&oe=6A21982E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgZ3WPBqH28Q7kNvwFn3-2_&_nc_oc=AdpKt86s-1xEeUrvc8vEVc54uAJ-cJs5yiNyMPind8tf6wtPKuXVo3EGVUGvBJt36Q0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F5PpIQN39KsXBuq5nHwcBMX5sFUbIrEAKhk6sZEVC0g&oe=6A21987C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-5m1L0jWkAQ7kNvwGmu5Qi&_nc_oc=AdpWVvwKjF1nhWEUTM42vslRFaWlazAcC47fRh9_9whEkGBEuys-Wqzoz5lc6TyX7KI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_urczb_oMwaVdpJh5l5CnPFv1NV8jbwZMRuRBERwY22g&oe=6A219FBF"}, "is_concept": false, "is
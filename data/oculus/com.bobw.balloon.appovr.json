25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L7XcKJdep8Q7kNvwE2RXGU&_nc_oc=AdoNP4A5abL5xAsIKgTgYT0mv1o9CQLHwK6NemCa7qJLdlB-SpxPJzo6FAt1EZSwv30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OGtbQ62qT6jMLI0ugbwcWIXRLYzxm0PjSpb42SkSeuA&oe=6A04902A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NzJTXEMHDsQ7kNvwEC8ICM&_nc_oc=Ador1tfy75J5iV6xzUpaahHy_UKsnGw52T-vJyH0XVNxBWmPsiCpJjJ4tciT6NR2gr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bGQbdZK3_G8qZ2xFTVv3W29T6ZnhzlMFS6jjMqc-w0g&oe=6A0487C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ak3Yxn3qLuUQ7kNvwFHefDw&_nc_oc=AdpRoemef7yR5-gmYbQVamgqRqQUj74ikZfEDUCjAGuHQyAVictjyiD1oQcY4Zck2SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lpIkYabyt4DQZPc7ERCGo0zJ3PyOkKawxkow5fJB2Hg&oe=6A04972E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiG9ja5t2HwQ7kNvwF-Wn5A&_nc_oc=AdqJsLGvSVMJ8STnlloBQ96Imst456V9aSs-UoO3VuURknpOPjX3s5fIqMIVUpfYp0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79LXSS32rkTpZPJQ4jrVQVM8zcTO2IqFcCbdjdP9-PZg&oe=6A04977C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0cqVBkFSiQQ7kNvwH4_51u&_nc_oc=AdrEmzmz7iB0sOfiLm7kCjJtBpQTjwUB_y_AF0fWYboHLGWQ-YPiVezXuX-ihhY5wJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-VB-Av_nyK_ZYFboUcOtudLrpreL-Pfs3S4Y4X_8eZg&oe=6A04667F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQlHsh29zY8Q7kNvwH2bz64&_nc_oc=AdphTctgmVfLUvNv--Cc1QGX4VG4aY_Iw-pYDNDKyUPXAcb2FFyk18wYPZaHk7_K79g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HV7nPiTOBjHny8lgM-GLz2I2y2AQimkUeIFQUhu6PqQ&oe=69E2492A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRu79hnwfmEQ7kNvwH6qj6A&_nc_oc=AdrklKQvGkZIJiIFkwuJVAcug6cCk2m6ZDZ3cghpzM_rksgLl9FMogWAeQXC1WY1tYc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UTL3_tv6KkbxYgJkcW8Dx1CHOPg45wKTIfjdCs39zpw&oe=69E240C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuhFM6Dvl3MQ7kNvwH4Ix5V&_nc_oc=Adplw5cTJyyvviLx1B0DxgO6H7oyPAeipvNCURaVr0D1R4Y2JXocY5O2YC5-8rxXKjM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BLBh0n-VCwov47S4bpTvOZErztj8Go-8YJFiAlN0U0w&oe=69E2502E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk5nopbEwk0Q7kNvwGhM0iL&_nc_oc=Adpa4Q1b-_bGmZ0jGhvS-JuE9dM3MyYUeVa7JXLZwLTIY-MtCz7A0tdvR6z5g5gEULU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31D0N2C6M2mgspCazzHp5Kb_0U8hJPqp8xlrf0eoUnew&oe=69E2507C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh1AwdCiGrMQ7kNvwHEAjzq&_nc_oc=AdoTIGuH4IUL6RxPxlTVeBJcp-H3XPLAgAm_4CDJMvVmZKRUl1Jdu2pc-3yM97wcP6g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kWtAp61R-Jfy8NtAMsd2Jc11IWjgTeDD2nPRMop_A3A&oe=69E21F7F"}, "is_concept": false, "is
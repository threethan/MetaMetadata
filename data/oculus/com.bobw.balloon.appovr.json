25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXTOu_NxF4wQ7kNvwEFRs6R&_nc_oc=AdrTHhRuMmiIRcFnZAsbeUGRsMmaW-NYQuhkjBm4cwq0jZsg72_YofUjgsSjLPJ0kUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3okskiPvnhpMaU95lqyI2rSbPcZC64s6X4dFaRDrY7-w&oe=69F7612A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaotRww1NnIQ7kNvwFLNmWl&_nc_oc=AdrYUtjY6ZJREmDyjUoDzdlg_NSuVMaRNGOkdOUrW4zJ6ifOI6NmY0rwWz6mBYJw1vA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NEXDqFQwuKF0YaOXpfplDvKstAvzVsH_CkjWvL3u7Fw&oe=69F758C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AsWkhc6LlgQ7kNvwEbaQcM&_nc_oc=AdpGusOiI1-7VTmWI4i9KupkI3UxdH2wjSvfIicGpRzKpJeBt_hH8PtpkEGWKTLBtRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1v_NizgyQaAHp6g10iO_mEEys1o45M7uOQ77sedNOqGQ&oe=69F7682E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJinwj1uKLYQ7kNvwFWTx9w&_nc_oc=Adq9VrLAc331X6-O9JST1JbkedbAIGv4tStyPWKXWRwX6EFNL2fmVVpg9Q9UfH3FTjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LYFoXsZ7dz5GLM0ovnslBqhy0ehEWZH1n8lsRyTuW2g&oe=69F7687C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biQukI954GIQ7kNvwGHll6m&_nc_oc=AdqBP5woxtSDn0M5JwGrKHYsyHb8w2JWZYkW-zr2Oa2bRk5lTVlseLfcYBZ0YpU-Lcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KtBwYOB1qQtT1HNLhXHN7lVDgnVrVAXigDJpJnpIlKw&oe=69F7377F"}, "is_concept": false, "is
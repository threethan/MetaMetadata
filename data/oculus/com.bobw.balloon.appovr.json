25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCZJmW1NwZoQ7kNvwG_sV-l&_nc_oc=AdpWhys5OxVvWHNY80SngFzh3Naf_L-xa1QCgdbejzzhskI6eKI9fofU2g3d0KHgwSA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYfTrJx0vgBuVDyXY9Uj-oWYTuYbByhudUmid6_f1zZA&oe=6A91686A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKXOqK-gsRgQ7kNvwFzEg6b&_nc_oc=AdrwXc1IWcGjHTZ8jr8CLQqa7bxwKLh6dFPblcGpTuFxyZJjMJ-rxCHt04O_DtMOKPA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqrp6rVEdZp8mYc45ptNFg97hI9OcQpUhTX4OFUvJT1A&oe=6A916006"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXXiddtABwYQ7kNvwH4j3o7&_nc_oc=AdodK1h4DKOJjRdFwSDT_mSgGHd1hpbueht2152Z0DyGWbr1yohSi83oEP9tYoEHnWk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5SDF0ZkE4r1ZaLtsbmEctPV5CHH-8hOPUhl1z5rgH-g&oe=6A916F6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH66JcXhJXUQ7kNvwETehgf&_nc_oc=Adplp_BpbILSReAnbFzkjozTNu9HtBrXRVDoJ0JyDnl1Cy9a8ikXlioWh-TPwPiT0ow&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHos11_nyUkAMb9HdGS_v9Qcy92aOBqAhwBc4Bd-PiFDA&oe=6A916FBC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZrZClvjBgoQ7kNvwHxA89-&_nc_oc=AdoGLVdnYxs1m89mVraPVVo7_EDokB3nECd2nmM34wtJhpN7xFhLl_hXOqrC9r4PQI0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6btlkAOPdjWMUpSWhPJYaKDrxEGJX6dUyhmZtBLyc1Q&oe=6A9176FF"}, "is_concept": false, "is
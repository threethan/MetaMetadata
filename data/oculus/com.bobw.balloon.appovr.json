25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZX72MebFQ0Q7kNvwGaxRoE&_nc_oc=AdoKbNSIjIqWfDMrxcKVq8gLw66MIi1RtIrrahxpL2Xy0e-yvqzsuSYrr9zjVBjxESY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VFXN8lqT3IRftgYGsvjJSLBuQf9a1cLvqBJ9Peneiww&oe=69E8E0AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H5JFMV6CoQQ7kNvwH9ac7E&_nc_oc=AdomvlGs8aLSgRIYE9WYF8rzZwRwUkAcCjtp3w-BJeOITZNcF3jcyHaDHrQVMpGCgUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PHgrY6g8bUVa6g7uivNmRvcHgKMk9YLHLN-5thNS2cA&oe=69E8D846"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stiaxORyvdEQ7kNvwF2r0n4&_nc_oc=Ado-Of9mQOIGpO1zCbhpSfuotXNR21umZKOHN8VJrMW8i4joISOCTjZiXwBTdnN9he4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2APufpCP6BEuDfhLgdh8T4Rg4neDZDc0zGQA9dQozdsQ&oe=69E8AF6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nmVJeei894Q7kNvwGLyXho&_nc_oc=AdoXa6IffQTpibLuVbVCBUyaeM-X3RNhrdq86mvmH6EkWDbhOZu2c0YApP1WdKgiIUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1chbrIWp5kkqvyS6koMZd_E2vHDdrgKdNY_sPY4Rezjw&oe=69E8AFBC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qZyJkKEmyEQ7kNvwHx-DDK&_nc_oc=Adq3S56tL1D5LUQEYzuHuiHCZT8n7X9Cm5Lz3tYbYl5d1Dmi4tIQ5RV7P-qEocszK48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EvjLcegS8kOgY3p4JV16Sub_9M078hyNY3w08J2HKXA&oe=69E8B6FF"}, "is_concept": false, "is
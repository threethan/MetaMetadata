25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnEmUoeRP_AQ7kNvwE-WK6W&_nc_oc=AdrafOrte1VcQF_ApRL-nHat5C4HlJk9HgImO0VUifYT6kkJ_2XlEWXPB1f4EvUYIkE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIFwMibMcdCal2a1w1Z8fhDUg6TTW2pD34dnYgcJ9iqA&oe=6A882DEA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5p8XZ6pJdQQ7kNvwHaBfIM&_nc_oc=AdqvAzZeoReg6yuvRF_ijtRo0nbF6-l4JRdfyvHIkDa6LJKdyxKE3obnY-REVWXEKSM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE58jvVwdIVmowxu9QZsTi5wrlXEUmXR_jOK5ru3CG7BQ&oe=6A882586"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kx2Tcp10E2AQ7kNvwGmREGr&_nc_oc=AdoF_MlwXAZMAFCeqGANOzYpf141o1MHpiuIfFDVcuJBb18itl1v4EeXwjpEJ_-4Mok&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4OQt3e32htAfOWhJR39ZfiV6RgLaEUWJg1F1Os8iiCQ&oe=6A8834EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_NvHijYrGwQ7kNvwGfGTmH&_nc_oc=AdoXJhS2uSqMicjA0U94_00SYs-GPHDIXxiiCxHJNZMAhLDpYiUBhY9LIsCjKSYGR_k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHf8mQmxc-wtpdpHhHFbMGsJpeuLlT0tRpxiENVZsb8A&oe=6A88353C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NZ360nYV74Q7kNvwEhWf4z&_nc_oc=AdrUhXyyWwwsoG3D-2jloBel6_URgyn0hiNTkhGh5941B_jqCIzkhEcs5yK9gWlC764&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-FB8kzYvsOjXs3GjIpzbjFZARmXnxyAHWPluZe6Syww&oe=6A883C7F"}, "is_concept": false, "is
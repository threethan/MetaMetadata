25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUohTLnIB5kQ7kNvwHGOeSu&_nc_oc=Adq9s92Q-RpKZROVYLHD9xmJaLHq_5IvoMusClsnHOlXs5Phxu0-EuLxVHTC883J2f8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnGZG302HKeIGIic22oZ2LyAL8bacGTW9A9SMiPsSH3Q&oe=6A4FB5AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9MfxV5jFTcQ7kNvwGQ6Ln8&_nc_oc=AdoSdCT6KrFHmk8-Svg7CmbOMGrwYmO8ygcneuXdbnPNXQqikvftfF8AlsoWK13WaZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlbe-vfOUxFLvifPpsQKZ01MlcFTE0juWqDwueqcPnOg&oe=6A4FAD46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpN8GgkSbjYQ7kNvwGTn7QC&_nc_oc=Adrka6DUwC9ni0q7PP_hB7onp-eGx4qQYpqOmJ2Fs1rhvVShZRHcAq4DFbFpKUWPBIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChlY9VUWq6W60r5-62Ez0EmCl8FkuDKzAJOUcyWE-e9A&oe=6A4FBCAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROq2xRXnjyYQ7kNvwH_Uq5D&_nc_oc=AdocgHj1ah0jO7MuE99g_JwkIpJ3LNK9ouflyQMuDvw-aFmFa1qMfc1fpJVHWLn2qr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz8wT1gc1Rys0DXgpW51apKWh5af3VBMvbPWDhdhjsIg&oe=6A4FBCFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SknEoAvqyGUQ7kNvwH5K_Nc&_nc_oc=AdrTCznwtZrheq9JVfG5GJLbT77aHgPYrf9Q_24pCMz-YPi7GraebAUBe45G1PTO0_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcm0JeE3MeKRE0-dGb-9fIlVJkJ5WohOJhE9Fn3GriRQ&oe=6A4FC43F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PQq1i2iJ2oQ7kNvwF0xlYO&_nc_oc=AdrQ-iiz0nN4XdRTY02XE2HNydcqPSkefCTx9mVLla7dzWPmRs2XS31gfo1EAO0S_-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03n090YCpp-oCvKe-NR1NTqyGUZLWGysvXuUdkbq7LAQ&oe=69DBB1AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIdVyh2b_KsQ7kNvwEy8l85&_nc_oc=AdpHDuSnZvFhRF73dhhDcQzp2KnzkB5LqigZkWoyUgjSN2yunAYPc338oB6bLPVEmng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bTS0vmp1yIv-vFopH1k5V-pZSYqeBbVSZe6x4kmaQ0Q&oe=69DBA946"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bebOAa6mx2cQ7kNvwHBulAQ&_nc_oc=AdpQi7erVMgCEa6C3joU6CDPOdnkZ8oAtUmwvFVg8tjH5Z64S1t4tBfIeOWHgQsjo3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TSA0q5PWEMlMCYKAHYXiRBXhFOsdWMNuRnmRfvEBpqQ&oe=69DB806E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9DT9IreEvEQ7kNvwFKWowN&_nc_oc=AdpPQCpzi3nSZUJUiEiBLzy7xMB4URpro8GRGlNFOn2gL9ENQbc2rh2i4_biTY6Wb3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36FvhlPVp3bNrjaSbvunyQzgZ9SHbTA1HMlc1T18KfQg&oe=69DB80BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJv20U_nMvMQ7kNvwF0y09F&_nc_oc=Adok7p2j3uj7N8Vp0-Uf49MQnv2xQsjCsDNRNW1rPCEZ2VtafMYpP1gQQGhK9zEUS5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rijYn82AxdkarrTtnpQ-65VdmamP_MKSXDxlIpz3wew&oe=69DB87FF"}, "is_concept": false, "is
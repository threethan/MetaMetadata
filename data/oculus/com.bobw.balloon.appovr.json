25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klijVOpSTcEQ7kNvwGH0AUr&_nc_oc=Adr-kO_hT-XzGKs2tMyq-FjfcNR8oJkW3o3YoAXsi03N85xDQMxWi-k5ePekqK4tHNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QnPOJfKg7PmfeMmDN0bIQe7sN90B1STQa74PSCx2r4w&oe=69EB83AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWTOTAhjWZIQ7kNvwERx8lE&_nc_oc=AdpnBvKFu3uxos9xUhFYLDmBGehpt3ybqi-nNpasd_75XKQxVvyiLULvB6-oxM31zYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z6o8v4bhcCQmnaCm5wH5WIlhtPI9ihDkE63gM7-_utA&oe=69EB7B46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw4CRhAnACAQ7kNvwG8zLS5&_nc_oc=AdqAuI5YpYmbp5EWuiXmhJh9lOQF8go5CHK-l0cExgr3jO2Vpn_uC43zTVVJomyRKfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_Wts1TqEF8-4gqSoKg9j7BeNEiB48-1P_9ytXeFfnsw&oe=69EB8AAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIzHDNPQNnwQ7kNvwGzem9f&_nc_oc=Adpl6jcdUWd_IHOxbSVg8rku_HjhqS9lgdbhOyf2SBkbx_q-wqi0Qm2MrgVqx0cjTk0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wl5RW-moNEpBIkPiB1vQm0HWqDTiH-Uq4iNzhuSN7rQ&oe=69EB8AFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qZyJkKEmyEQ7kNvwExmtA-&_nc_oc=AdqWkbDHku4tK6Zgu33VJhF1pXxw01DTXMWfZ2DA-WYe5ALk2JqkLeh39OY62tXOhAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LtBs1ZTAaiEcLK4gT2IS2Piao9SI9HIdo5VFzspvmVw&oe=69EB59FF"}, "is_concept": false, "is
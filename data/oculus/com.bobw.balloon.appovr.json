31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xWErIW88WIQ7kNvwGPg16k&_nc_oc=AdlS1h9LLhOJOXhyxFXlYwKKJLFm357gWwjnS0l6Ie66s9kJqTAUVKEgAGSxj0c2KYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz26-OMrUSQ3c66vW9tFyZ-bqgLg2uDv-Bu2xckwcxLng&oe=69B2D32A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rli8kNnf6mgQ7kNvwHdTun5&_nc_oc=AdlWz-EwLDukm2TwbtBNtCOknWMNxE1IJh1IoJ2tOuh3jPvNfR2-ycJLb-IqSHG2d3o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9wFRvaevygJo9pB6dB7wE2HGw04mvqmHSN03tZf3Cww&oe=69B2CAC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRtNmE8GTtEQ7kNvwGw3xs-&_nc_oc=AdkMYFoKYDpPwIZuGZOb0T4hR058QfUJ9gfG-zJjWGRBHXa91-0pENKov5pUKpQ4iik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUsxwHRJ2sVtnsEZrEXie4Tz6bmIBdCnm2SBpbANtccA&oe=69B2A1EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-QwGK3-9ooQ7kNvwHbYdCi&_nc_oc=Adlugl1dF8XdeF_9P47a6xUnVXb2RE4Xapx7qUwZesD8WJfbdZVtzkGJUen8HbvsXDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzj9X0lWUCx12uLFBHC76ksw1uxFCssFW1vaR2Y-ynYXg&oe=69B2A23C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNfLM0UmZPIQ7kNvwGEBfZq&_nc_oc=AdmmSGgPn6zHDa-F-SGNQ63X5wjc3GiDj58Scj1KXwanZVUTHyTcXUd3zbGAuDfxv8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwGXKSMlyI0RIGtrZaFoPU_l9xZLBJUI3U2VeNGeT8aCw&oe=69B2A97F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
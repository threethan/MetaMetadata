31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFnQNqqWHxQQ7kNvwHIWz8F&_nc_oc=AdlGOA0D8N2yYDO16pVqhtnkBL2uAmiFXy2Mx0CLGG7w4HMp-KdVLkScqoQ7Dc3ayJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwN3Z93-KdWpGT5pYrRJSnMxPc-ADUvw9J1bZXMbajILg&oe=69AC036A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9RJ_YTXiCMQ7kNvwEf3QA0&_nc_oc=Adl4iO7UjMKFLEMUbqDMgvJ62SmaRYOp1CUOmDR1PuxUqHt4uMKrDc15ezEkm5I7CQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyynPzfVYTDuxlPzj-albNuF12HJx-tBLTVLcnQq5mbTg&oe=69AC3346"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkxweDdub4sQ7kNvwHGOM1t&_nc_oc=AdmEmRzMS6vKpnHSf4Q9nAuPv-etHXBHbuVuw4jQRZ7F2GfhccG4f2wgkd88yoA56sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyny_nYRp9_gPide1YrFVXTEjMPwr7iVuJA9daQV-l4cg&oe=69AC0A6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wY-ju13aNIQ7kNvwF-gZ0R&_nc_oc=AdmOPtoZggzz5WynSAW2UPjzlH4Zgt9jZHG1XOJoo7nd9-ggQ45xwcrACN1i_WiqZ5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzinVdh2Y03yP6-BkCCDbr_cvb1IESIxIBPlWTyv63YrQ&oe=69AC0ABC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL3qg3swbrUQ7kNvwEyR4vV&_nc_oc=AdkCIfyMZBN9rtnx4ZoHt8DQ6wFGDYWUx3vVZF-zFodguXaaMBtNGXoZgPS5L3waq7I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyqB9I6GMW6Wh7M2Zg1LsJlANerE1rUlXiFnrWihdRzTA&oe=69AC11FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
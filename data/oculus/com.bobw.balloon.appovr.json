25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAx45WoWa28Q7kNvwHyNVAg&_nc_oc=AdodssDptVfSq6XqxWHgxlXL8uRHUtIgNcpjzZNxttlG-Rrs8O0v9aPasxAw8cldscc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uyKXcA76P0Ve4mkwSeO0e6wdPJdGnjh-htfhYhcDP7g&oe=69E4EC2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlnz832Vh4cQ7kNvwHRyKnR&_nc_oc=AdqV09WjXHleCQYGsZV0m28PwTo92B1Z2rgElDvMnFWk_iNWpll_wrlm7pYDgZRG_dY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OhWj9CaKWEDcJuHY6WG6UZYK_XNGz2OzbVG1tGfzR1Q&oe=69E4E3C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuhFM6Dvl3MQ7kNvwG7-IFz&_nc_oc=Ado6xnw8KF3Ix7CZaIeP7dH-tba0bdCEFKfrPHdy8wqcZvEb-i01FIqTOws84Mc9h2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T1wsnbcYf-bKdzA7bel40rYRiE3QpSyukt_Mu_A-QwA&oe=69E4BAEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G747dq3ZVpsQ7kNvwFba0EY&_nc_oc=Adoby2CK05GL0KZ1PAY2RHzBWOdyLLi4C7ZSoq9LAr3mvHMng308jG2LuJNc7k8uUU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hESjZn0JQ6MNU_4K_BUKUW4_iC2KhPTcYW5BLlYLDXQ&oe=69E4BB3C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKAsstY7cYsQ7kNvwF5bqDh&_nc_oc=AdpIVqIYHr42uKuvG7rWAJ8YhGBU9Xsk0sKr2K4PvZKst-EqmLKStpXKi_YQDPghkOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06aAU6jxzR0tcXSh0aVfwha6QH15Mw75B5TrTu2zNPPA&oe=69E4C27F"}, "is_concept": false, "is
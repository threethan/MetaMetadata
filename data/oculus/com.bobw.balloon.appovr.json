25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_CTRfZyRJwQ7kNvwHpbvoO&_nc_oc=Adr0T6xxGMJJGCFhKgWWNrzIcwAf6QSqTjz5Ku6NAvMmm7K9MM8HJTEc83PNmqsiChY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rdEsl_1WrHjJOWqvGlvVXYjZK3JwHJ__laAJkRDMDZw&oe=6A32B4AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65SXhaz7-OUQ7kNvwEma6gg&_nc_oc=Adrh11hPoKCr1THCCL4iPkn5wd5NY8ZAbHkgGzceGKQk-xlCZCuqXq5vnqM-nw9sPzw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ALYHBKl6KOxyie3SGMgYPHMdMkdpzZ9BE-I-JUxkduw&oe=6A32AC46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWsOSIT_CuMQ7kNvwG_wLsI&_nc_oc=AdopWvX07Rt5N4HgZzG35nKWmQ0kwzKvd9DBYYEfBeJDWVjcNCodVxyAPQkA0F_s_FI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l2169dEciwnOe7m1AzdIgWimgqn1GQmafz3KWi2_5Fw&oe=6A32BBAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNkXuLPRGXUQ7kNvwEGw8hv&_nc_oc=Adpc3AfnQnVxk1rJ7lxXsn7AFfpiEFhndsAhGmzoH7-qjARfHSTZ5eP6vptWjvit1qA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RCHbx8REQ3fm0Q8tXdg34l2hUOvmy0TSgZS9Fy-eApw&oe=6A32BBFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U30JwPds-04Q7kNvwHsc19t&_nc_oc=AdpaYx6Un6YM-D5E8ypaJlC1PGkNnS-SlzAtikitCPXBRotUM0qAHIGeKFZiCSI8JnM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fQBvyd8br77p9cCYSBkem7tYOsL7-u_NR0Y2XLHxQtg&oe=6A32C33F"}, "is_concept": false, "is
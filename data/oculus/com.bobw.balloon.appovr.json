25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU3-QvfFiUoQ7kNvwG4MKxn&_nc_oc=AdoBf13Ef79cL1z8Ns9Pv3KPfzsmed_b2Rs--OazPMdwKEdYkdJHV_e263jUsH_oYZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f86guqckRtceNAve2NLoXT7cvREKEtfrWHmU2UyfyYw&oe=69FF4A2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jThGyt34QsQ7kNvwGQs0ks&_nc_oc=Adp_cSy5JHXraRfPJY6TYHy6FHgoPPVtSbJcVkqPSPqg9wNVIASYYxD3hFDr65QLgag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-T8Bk4h7abZCw3lT1maMuwRPjkj-G2H4fYt9EO0Y56w&oe=69FF41C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfO8vcRjA80Q7kNvwF1k5LJ&_nc_oc=Adq7-EiP40D3mYblCl-501xBG3WuZOEK6s7n6idmwouQiG-pUKxZro9DEFQbTv6_KVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qRinquZ7aXUDwzLda9h3tSahRaM2NjtmT04kRTZXcvg&oe=69FF512E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwwkicL5YgAQ7kNvwFzchjM&_nc_oc=AdojFTqoMJa6EqbPCFvUuy_p1L8tNZEhSalBYYtRkpP7GMOqBvQlRGT1-3nD_JyEdig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cQB8_rKBWAVTUls55RMGPvF95nm3DbbtC9WfWgYx_VQ&oe=69FF517C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMTmZoFPRTEQ7kNvwFk3bn3&_nc_oc=AdpZNCB-sLjtSFSQEz6pjU9z1OSA4t7U8hsRMc2E0j0NwUtJV3fbUAicdtVHSmnyhw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51EjedUMUH-ccEpe6GU1jZNpoMorfjDLg2kuTJ66J2uQ&oe=69FF207F"}, "is_concept": false, "is
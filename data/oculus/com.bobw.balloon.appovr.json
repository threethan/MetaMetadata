25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjPh0cWQX0YQ7kNvwFrj-w-&_nc_oc=AdoLkLMQfY5vW5MBevkQLpW4NCigoot27kTUMFp5gM8ggZhECIla6fqo03idXur7uGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4cUQ3mbwCC65Pf2_EEHynmAuH194nSkrb7KA0wM4QUA&oe=69D0ED6A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrUHeYsptFEQ7kNvwGSXRTb&_nc_oc=AdoE1L-MJn4igTveHkN6F4JTTyy0L8HI48m20fF0rW1pe8DXpCvNmnE_FghpJLG5cWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuaYb6NymWgPEsJtAqLw_smn32Pp1y22j2EpSo5J56Rw&oe=69D11D46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6E-teilBisQ7kNvwHaqZTA&_nc_oc=Adrm9b05qhtYq1PCZUGYi1u86R3DvN-AoruIvOm0IaOPm3RDfrqrkxuXfQDwNyRLnnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1L0veyZ5cduit7GKiTJ6ILlv9nyEopudiDIiUq-V8rw&oe=69D0F46E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S02nBQ93xfwQ7kNvwHEGksb&_nc_oc=AdrY17KmtHcjpDpY_5oieeRc4mMpfnyohwBzE7uJaHO7w1EcFlpLyLMSZ82eIqG4rXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwcBhzWnoAD7FyDss4AyLmoFwlExkPQCTaGN0ieajN5A&oe=69D0F4BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEJLYfex3F0Q7kNvwFhV1FP&_nc_oc=Adpj3MqYxHVCmOldo3KUUUU80YDSG4-u49TvDpcI-rW4gOojqUzQrzRzqmmFlNfYKpY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6GiftdHVP6whdAbObxHwcIuxtHSoUHcCYYX0kuenwWg&oe=69D0FBFF"}, "is_concept": false, "is
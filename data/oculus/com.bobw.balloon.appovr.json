25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Xky6LgDj74Q7kNvwGmzN_2&_nc_oc=AdoRIJFGtScxeOM6s7E9-spTi0Joyo6E0qJZLpu5RdtdSr8gz5V14EQtxQWPj4R8zQc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpqx6aANwIOtJ0eEaxjMBGDRjaYJWChADlTTjIMKAjnQ&oe=6AA0212A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLs73MQx9XcQ7kNvwFVW8_D&_nc_oc=Adoo-i2xJFDdB2-gsw3HUYpuuZFQQZhHUSIyHOhUZgtwdNfRAmvfyt_BgPckt9XGkZQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhhNPzdb27aM8e6pzgYsgyr41gx_TAS_7UTYgWyu30JA&oe=6AA018C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbOskMsbLJkQ7kNvwHsoOaO&_nc_oc=Adryhtp_ntGvSZ98YHFOLxUtQiPgMPHOPr4LTLyPwY_6AZ3jvgG0h-JxbIXafRHU1XE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9JI-AA-Jv42qAdHAlOFJufXVcYilA1btRB1ggMVoD-w&oe=6AA0282E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA9zHjhlIeUQ7kNvwHbx8Hk&_nc_oc=AdrcmeDJw2BPCpGDq1ShYqvgRLZ7msZGREfG_cNPo3XnClMmlsgA0S0Eb8_cWuEJ6GE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVhY73VT4DsnvQLZt-revAft8FmZQiWyJPH-OYYDtMKw&oe=6AA0287C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f20dLF0hTrMQ7kNvwHG79QV&_nc_oc=AdqVlQRlubJwZy6G6RlTE1_CKhSIWKpnRkOdUVuQ0hLS6uINVm5uKO0Xaac9qqaI3DE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI16Ks7sLUy_fzM5BCHNzC4B16JJZWbnbqY3hS5NrBPpw&oe=6A9FF77F"}, "is_concept": false, "is
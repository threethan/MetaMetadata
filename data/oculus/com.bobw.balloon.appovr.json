25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYVQOalge9IQ7kNvwGgfBx0&_nc_oc=AdrUFFfGKqws04Prmx9iGe2wYCFy5-4E_wvORajeYXIy-9IOa28IDyAj9xqEmf_HcWA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i7MjkHDDvioc8r_FEPpbzjPssU4FSYrBL5LUQ8GLfTQ&oe=69FDF8AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSJYXaxla2IQ7kNvwGJ8637&_nc_oc=Ado67gC3zoRjB95Y0fQuBoxFwqAzp24eD5JP8K5UU6_yqbw-ojewH6zjhkuoPNCq4as&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XcP_98wAJiApuGQ6LMCCv5gCrpqbz8gsuSN-ASqebow&oe=69FDF046"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfO8vcRjA80Q7kNvwGsfE0Q&_nc_oc=AdrwSqhIKB8-5fL0rOfzjlp_nO92KPFo-dr6EqyC25Uz6HiyIOFfsbog_mEMestcenQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69-SSRxzIblKJVMq_BoVLU_VLmivCa_oOChJM6pmmAJQ&oe=69FDFFAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUaKz8OLSb4Q7kNvwE2v_Tb&_nc_oc=AdqryXCNj9SC_p27QsBXvGTb-9-aTkkW0ANWJHjvS7YRUZ8amvIFC9hSoPsXF_F-n9M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60OBYA8Vm7QqLEeeOqUkxGWZHLH04uxzx4rU6NQU-TsQ&oe=69FDFFFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMTmZoFPRTEQ7kNvwEMDGZV&_nc_oc=AdqKpWZt7d6KFfbI9oS_HjdoQEYj4oxWWsLVkYN7RWpM5ipDuTux1hEjfJj7ZBq5WqY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62HXLtmyVdjcLt8WvAVrKY6cUaG6KN7R_r8OBa96V76g&oe=69FE073F"}, "is_concept": false, "is
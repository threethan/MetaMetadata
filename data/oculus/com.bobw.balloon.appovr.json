25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8BJD5UCwmcQ7kNvwG3EkVo&_nc_oc=AdqBLh2vDbQql_2JfS3YOs3dTgStefOSHcA52ghJdlw3oHYgBeRT9DBXkTKaL19YSY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmJiLvQRmmZ_5G6UtLTzL4WeC7qVzHHdgSVk6GBY_f0w&oe=6AA80A2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBOxzYYFl_wQ7kNvwEaSewJ&_nc_oc=AdoXpV2l2pVewiuPDBtTozF7NViB7xUBIs6pAkwMkQTun-ujr_NnhpPTbxkku9SUg5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ14tF3Wckd8Xv7Ko96P3gKGpgINFRFjLF35I85zZlB9A&oe=6AA801C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFFOkU6vqoEQ7kNvwFC7xga&_nc_oc=AdpuLJrhpAWjjq81e7bZF7H1e5tSjRq4iOH8x-Dz2Ius0gKK-iwju-1zoZ6-cEsTwW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxpwWSzhtSem89QFz5geoE_FKiG-5WMIE82vZ2rhssDA&oe=6AA8112E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F7aqRAzpG4Q7kNvwEG0MJT&_nc_oc=AdrbKVcbLO--LlJcuKQpyMnVqsnSUI8gSUKfnKTms2Sm_UyvRHL4tfpxFbLGaxeoFXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPanEElVgx_JImJtUlwp7eMmnRX2sKVN1yAIORM9e-XQ&oe=6AA8117C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OdFDnyFPsAQ7kNvwGAocxg&_nc_oc=AdqIuwGiwJwlA1tajJo6Xm_5ro6xn6n2h67fwDwVC1s0J5t4mo1--WPdn31Atzt2O00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv2I9RU1qYRW6cSNN6tpddGvRujL5qOQkOISyT3C_-rQ&oe=6AA818BF"}, "is_concept": false, "is
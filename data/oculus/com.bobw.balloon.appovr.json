25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Xky6LgDj74Q7kNvwG_cfWW&_nc_oc=AdokftvV9d3VV4jnA0cW2_wdy-l7HJS93n9OU5tD-pkUh6cx2ZGbAjljCiMF90Yb26Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpM7N-heeV80xSMcXwuG0Z8yZkg9sOKGLdqRUn3p_qgA&oe=6A9C2CAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPRKKfa_UUkQ7kNvwHnwuld&_nc_oc=AdqU1-z16ppG28GqBMq24U2k2gzQEbDHFLFw1he1VNp-4CMOrkbz3k93Ar_lUvGOYUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDJwhL9tOhsC1XLuAjJ11iSw6BDDmNx1ggmjfZLtWcGw&oe=6A9C2446"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOKnBKFw3SUQ7kNvwHGboDU&_nc_oc=AdqXo2zt9s_LgUOBlL9X02_sNP-E5wRxwCo7CWbpchfrkhBVWFAnZE7hI8udwqY4JRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdVe__tmGKNXPG64-sTw0_52xB6jdWmuPz-srcJ8hmyw&oe=6A9C33AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edwf2kP9OFsQ7kNvwHcNSYQ&_nc_oc=AdrYaXx8wDYCl__h12eHGJaa4Mr85ChtM8bMPVZ6YukV5fCeO1YSNeSUWGrOwrOa_lU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjN8KEIwd_GUVpauWVo5y_ylkw-fLEEAfHeFwhqgPvSA&oe=6A9C33FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRCBaew2nXQQ7kNvwF5g93X&_nc_oc=Adq5ICyTJm08K_tl4Oe5PF_XKPJ7bwplSnlEXAd06xNz45-4T0sF1KG106w0bWqlSt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyoWiSxQokwkmYcoun7-ShYcPefbKS047q98xBlZMqBQ&oe=6A9C3B3F"}, "is_concept": false, "is
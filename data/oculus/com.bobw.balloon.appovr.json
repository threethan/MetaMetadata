25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0nfDG5EwicQ7kNvwGa5olE&_nc_oc=Adr-QNOnA6fq5I2KaTnglf4C2tpQpBdZBWNGuKubd9uOtSS6_8avPvHUxy_fNhEBifM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHeczcw9TP0_K_WgBFndFGGKct4SrLnjq52rR0yk0gTA&oe=6AE600AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sqm4h-d4aEQ7kNvwHp7emw&_nc_oc=AdqG2pB-Wqc2qCnvoQzgPhHSTasMTnWr3BfwKDydTTjQAusWGy5jvVdXfWcu1BYwzpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6Cp6AlQ9eDm2CnLkm3HjeM2fb4YyrqvkfxYgLz8zm1g&oe=6AE5F846"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atm33wrkA0sQ7kNvwF0b6xf&_nc_oc=AdrL_m0alPKNrZOMQDSBLsavYJazQcl1bnTNGs3V6T1v9bbD1hMxTk9oLCdjdxV6EtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAPoO-8hL6G87miQiaS_Hkwwlu4elIjJnEka5p57d4OQ&oe=6AE607AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yVgMoowVX8Q7kNvwFFVsnR&_nc_oc=AdoJX0Nh2CNh5KYJv68l4GMcdqHuawgJL3BarTbTsKORtN_KT6A3Xv3zQTNHLqsbdTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXMfouN_ib25fSMgr67_eYrZBSOCEBtGzTqDbj-SBuFQ&oe=6AE607FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf-EFjPGB2AQ7kNvwELuIbw&_nc_oc=Ado8sGMJ5iw8AOhzdlHRWyl2Vq5cQWHiGVZuOKX67xUFTzLYt--1z-vioNy1w5MuqJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO87kZFdOAA8-hzU1ltzsaZFtJpOCRgS3febhPeV3UhEQ&oe=6AE60F3F"}, "is_concept": false, "is
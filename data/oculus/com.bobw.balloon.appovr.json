25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJRnsfBSj7AQ7kNvwEnP8a4&_nc_oc=Ado6Z0GqA6mu1gwEBAL1SUFycya9OI76HsJwB8F2Cz2iLD7fOnnZBdsg2dRFMmN8lTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJao1fVeqIr26jJWmgGl9Ti6oTDqxrsxdONvvfOf9DTA&oe=6AF32FAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFOFy-HDheUQ7kNvwFR5RL3&_nc_oc=AdrtvG8ND4OnOTer5wBX1blPB19SMhyx6pUwUDCuEu83oQU0IlxpqNqRVYK5wA5va1k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFZy_jZJnc3LNzN-rkRHr1xM6KGkc9wZqdIOXDQSRGKQ&oe=6AF32746"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiwQIUM52e8Q7kNvwG9PdH4&_nc_oc=Adr8LwLaNGZCacfhT9U5_sc9_IcT4QLnwyRmu3B5eJltHIia1918pJTr2CWZxMce3_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU06UFxzNDoBLahqnql2I5xr8NbcHlO7EopuBafwcekw&oe=6AF336AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tay4aU0CzXAQ7kNvwHER7Oc&_nc_oc=AdrPSms_2-5BgDrmee94WTw1OLqarvMmrcMmrTb-6Z-XXwlcF-aexVyt_JXyne6XS38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq1CgKLQSXkQLTbA95SSNd2dKfhmVELM4lSqERcQBgBQ&oe=6AF336FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkAcSpvzDUgQ7kNvwHxvuts&_nc_oc=AdruaA8jd3Xxpio0b0xED8-4XL54awiVSjrDXBvNLfPPQfAa2SoPku3rMy41J2mJjmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHE5VoUUDgNbqE3VzxAFrJ72YjPKGdjE3KPntf-md1TQ&oe=6AF33E3F"}, "is_concept": false, "is
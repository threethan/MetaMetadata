25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFyRxyZAalIQ7kNvwFNkt1Q&_nc_oc=AdrZAoiHvWEMckjxqetghErOEjZMwgSS3ByvJ8aPe0ELmJ9qfRdqLSbJfBEF5NBbuDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWbEFyXbUPHr7kc9Ho6dmBNo7ritonNSZLKQri5vZwFQ&oe=6AABFEAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU_K_LfGCfAQ7kNvwE1bm8R&_nc_oc=AdrFiAGaGhqdTniUD3pFYcgM1OKzZcVGqf0dDjN2bPPkvd9Hvv3A_WTmCVTBMwBPimg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwlCdbic9p-Ni-C_xkpXZq420GK3LMyXl_1MlTRF3Czw&oe=6AABF646"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfNXiUwk_JoQ7kNvwEBO_tw&_nc_oc=AdqUCOIMnIbolCrvhWvlYZZGfU9GbD_jrYe3LcGpcds-JwgP_3yHcoq6FE0UU3bnCTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK98ux0MW8Nr8RkPoTVwnWogBv2yaEZjDBnSkzw9xvrmA&oe=6AAC05AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSZ8eGTbOuoQ7kNvwH5Lkoh&_nc_oc=AdqWikUzg7I5jkWiNrn8w06jmrZW2Exwa9kvTnixAHPQ1bMQMpl_4lJVNDVel3BsOTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKidac1G8Q2qz15dwYkUUbPzOLbosSn1bPvqaiyFIEYUw&oe=6AAC05FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuLdluRFpCYQ7kNvwGhaicn&_nc_oc=AdqPUOhAXmIeqTldXrYZsuBDiYY1whg13_vCqk7IkzG7CCjS_au2hlSpq3mwPBaoCu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtusD9Nz_H-UmlIL2pmuCQ-9g8O45QuneLU2xNdZjuwg&oe=6AAC0D3F"}, "is_concept": false, "is
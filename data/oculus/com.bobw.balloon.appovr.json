25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhN3r0UkOfkQ7kNvwGhroEh&_nc_oc=Adoge3kgCqC765N1mlghC5UE7Hhb6SdjMCpA1Pzk0oKrzyhsY6ddrODCEV77gmV-19k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_MhzEVWvy4Fk5iRW6PmOLXSWo5I4bBvpuF6Jrz7UMCw&oe=69D90EAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTo0ZIRcS6EQ7kNvwE4CSL2&_nc_oc=AdpoKxvFpJLQktxe7KMoephT4pHFT3tmFi1Ynu597uDD_NLKubVWzzRzT2ZYQ178Bck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PEps411CMiZIDLGbg5JN7A_wJ4hK4_XhClWoOMD5BLQ&oe=69D90646"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aQXXV_OBZ0Q7kNvwGvnc1c&_nc_oc=AdrmTk1-BAaHUUdTDEF7ZX1_nJRJPq3w2cGZtd5WUh925WPCADl43w71AkL7Bzi2Wj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vvPjuYubCi8OHCNh1Sid9g5u1kdYBV817xlydj6eC_Q&oe=69D8DD6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7r2oTwdcw8Q7kNvwH0K1MZ&_nc_oc=AdpIVIyhx79iwaDU_ZuBpzMcQtFKt4FlUujH9Z1_C_T0nMTYMVl4WKeplTNfOhXOUoE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ugYpbiutpa6mduzYqQj-mTRi7XohF-VBHMdQfRzlY7A&oe=69D8DDBC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJv20U_nMvMQ7kNvwFiYPEd&_nc_oc=AdpOB9rHjPuqa1oTxg92XvKUNQwe9JKqry0S72A4ys_2l__CPJGTjFeJZmHXZpIMKGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UHomLu-TnmVUeNQBuGYu_sEYPbcHfuRD5v1OhGpVyGA&oe=69D8E4FF"}, "is_concept": false, "is
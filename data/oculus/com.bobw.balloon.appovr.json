31547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjdPF9e74YEQ7kNvwHI-d_C&_nc_oc=Admf57n3fI0Icg7AWf4pXdXUqG3qbWAbWgRkHpYyE2RkamGYoHrWTl8GnrYk4BmI9Ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsWXjvRLbvh-jy4JZlcvUcny9YfIFfb3NuysuNG2KIr2w&oe=69A9606A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKyl5YXfTE8Q7kNvwEQrDeZ&_nc_oc=AdlXZB8HKhrIPQhnPmAjSLNRNi6fohlI90oaMNtfAD6DQ8EOQwafHMUGTtinl2eGCJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftMb1PMnLx4xWCn_NjArIfW3O24zwgy5ssnEek82haHfA&oe=69A99046"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j48ctyZRUKQQ7kNvwFfGFCD&_nc_oc=Adn7AuVRlrcv_gbfK-twZJj9OGnb4nMpP-e1LllitfSYhAL_fDCbKp4x93bnYTnJrr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftByw1BVEw_UAbZ9jvCaEqndPiClfGtj_zBrfCTUgK1sA&oe=69A9676E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysU5SLhSSJEQ7kNvwFVJCso&_nc_oc=AdlO0JJ76a97jkO_5jNFkgk8TljQy_pcOBhvliudhse_J9FzwZuqUi1xqiQi45l6N3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsN8moana-JhtsOzSY7CNWGhCQh7_JI0TwMSr73VPqqGg&oe=69A967BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL3qg3swbrUQ7kNvwGgK4XM&_nc_oc=Adl5IhkG6QnMtuZFE9JIA5z9iRf117vHl_1c8wcJ7jWkasW3z8StCAU-s9QUoMwxB-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYlK4-B8h3C9HawC2eKAlR4FotaSFiEoZdvdY9S8abcA&oe=69A96EFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
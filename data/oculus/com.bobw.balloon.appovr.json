25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrELd_Nhpd8Q7kNvwHGa2Wx&_nc_oc=AdoAdp7K8kNcojlBeZQI6iuzA7coRTLOL5N6LMcunt4j76AfOpx8jld_ygwpg6ssXfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIegRC0hZQKd5Yo_wNdGpUWuM1O7y3qZgmlSP9d9O0Nw&oe=6A64CDAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1dWKxxAs4YQ7kNvwFtnIhw&_nc_oc=AdpQ9QvahV8-82ZK2OC6MSCooC7BkpgvCERSzYI8PuHJFdMHEBV35v7pVUyrUkVD85Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbMWrg86c7sPtu8AVAA-scw3Mbj_rdgJlxvzetG7oEiw&oe=6A64C546"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSpI_F1YQeQQ7kNvwE_H_Hq&_nc_oc=AdqlK3XbRltf4dewPmt1WjYPcW3An-DsVJjT5qTLtuOHDc5_BK7rJZT6cEd8G-naj0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBM8osR_rZg466qfmEBweaseJU7ogrrOtgHD6Wbq99Og&oe=6A649C6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImUQ75-tKnYQ7kNvwG7FS6t&_nc_oc=AdozRImirhJokcZNbrfJ02YIbDMr0wtA9Wngy0W8ZW64Mll2oDGmrqgmfJeE_dNK8bQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFdKiyomO4EO0B1-DoEJsiXqKghCN27u-knCAZoYN45w&oe=6A649CBC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTcnT8X_s04Q7kNvwFjTgC4&_nc_oc=AdrKdT06las2hFiRLGfGSD1vpEZWjdqvwZdynNiqzITfaA3nTPcIMu8QT3lEYrBie5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQZu18eOCL25L_M0lzRVMIXmXThmWb_ajCyixT_QYp9w&oe=6A64A3FF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVhtBf8oyGUQ7kNvwHqKZC6&_nc_oc=Ado6NsdWdtLaWAuXlElaV6jDSoI3uAEB6V6vxNlIPBhibvvbJLtgdNR7pylmkPyjtFo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d1B3MsAVjX0bolIw-grurouQmAkoBJ5Y8aab5FYR8Rg&oe=6A24342A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4SmH30zmykQ7kNvwH3Zled&_nc_oc=Adri0BsQaRVeIpPmWW0Uu33UrOiz2QOM9Ib0WcfTu5GILJKw046u05xVZyE1plZnRRU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9kNeRqtUBqe2Kbqe_8GkOJq_PKhFYvEI6uDRCRDj2tw&oe=6A242BC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNxUwfWn4IMQ7kNvwHOSpcO&_nc_oc=Adp4GEuBodvzfE_YJNdPkEYkEC8uuqvZxc9tOdRZypO4uSt0F4BF-9JsLYZV9YKvzyE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y6Ovp33Py0rgEzjiq8EIVcgk3-7LiVA_K4BOZalLBOg&oe=6A243B2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIQ0phTY4okQ7kNvwHjcXpy&_nc_oc=AdqBS8sc7KAkCYTJdMBnbpsrcyZ85fcaaaYhQcIEAx5Qp9iK7GOGr6SlvA7MB8n5eN0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-328RQ5kuWSbW2FotkIHHZsXmZ9OHs41qQ6Oi2WTAjoQ&oe=6A243B7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Apu81C1GkcQ7kNvwEydN1a&_nc_oc=Adris4qdrnkHbYoIZbZvqMYVifq0nEH5HR6kkxGtk5iwn9KqrJh6hprFnFxyU2sj-kU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PwZsmJ7FPhva5EcIgIT-4gkZH-vX2kmzqy_7sWD8JtQ&oe=6A2442BF"}, "is_concept": false, "is
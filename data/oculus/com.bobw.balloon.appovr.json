25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7l0nHZdWa4Q7kNvwHIyZrI&_nc_oc=AdpuxXb-or2XziBM4mXGx2R2xw5ACwPJUXBtYUQaKOMLSq2OHbjEsyWwBADteQFd-NA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmQ2Kzw2gVqqsPMZVO45agZ6w1W9bgUT0AXWEq2S1p6w&oe=6A95CD6A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=525NNJBfRbwQ7kNvwHpfwOF&_nc_oc=AdrnyKZLb5CeujeDF3MHh2uGB9kQVWDrlekB3VoOSx4PJwC5WLobJltk3U8Ws7oPo5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzbU8PHDu3dZc09eRJBwAI47Oshs3z9JlkirsohrmSaQ&oe=6A95C506"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NgTx9QSmZAQ7kNvwGDHjNC&_nc_oc=AdrJOtU4iop3-Bz67jWhHN9SsCHS-S5j7VytAc0MCbrlHzWucM-7HP0DjmchrCwGHJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1A1l00KqL_4proGnoKSaxC-VdgCjIR40Ppl19ZVLCtw&oe=6A95D46E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDxGzwgZ7LYQ7kNvwH1d8Ih&_nc_oc=AdoC7-dj0ImDar1jOL1YJbKCqFCPmyI7MUxfqUnFNxCsnTAmlAvlK2---Y6IsUHJDMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYW9Jehnh4pQ2dJ2eugblOW8vXk2uTX_3PfGMGSCWqkQ&oe=6A95D4BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpwPWw8cmPQQ7kNvwEcpit0&_nc_oc=Ado9r-J8E2dP2e4uImX7ThdCooZ2P8bH54ZllOk6213C1s6pwqi96hCYvhUXVj-KpeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgAKeP_rkLrSFo4c9DmqIBBo4mocP91B6OmQ59ViC5zQ&oe=6A95DBFF"}, "is_concept": false, "is
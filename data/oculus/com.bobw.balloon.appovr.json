25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faBPo6kwOWYQ7kNvwE0evlP&_nc_oc=Adpd1HUpvWLCrBM4vWAmFGM6N2PJ3bqgYxBDJjKKDVwOD8_uFRkGjAIqvnljQB0tfGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xgFminDWQIJR6ey-G6etOZe6ZLYPQ3Pv4y2i7MU099w&oe=6A2ACBAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez-KMxVXi4UQ7kNvwEkXrSV&_nc_oc=AdoBJWU-FWKqTZdkhAcD6UhVI6tCG5wzEsEOnHE1Z6ib_Ib3VX-nqbkk_IhX14rw7OM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lskayrDToJ2uXbRSjIS7FAkzzO5crBTT4WWPvsvdd-w&oe=6A2AC346"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d94sugk3xekQ7kNvwHRNTOm&_nc_oc=Adp2_Osx7mlJFeYnHrVp-W_puvk1ZsxscQH_uVQ6vT-pK08E0cbQ_tbN1MqSNonxrRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rKR50yPZ4nVA8wqHiJsEmg9e8fYb-5YVw9yUZO5Bf3w&oe=6A2AD2AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY2Xce7eAn8Q7kNvwG2iRvc&_nc_oc=AdqKhtP-blV_tEGfoaZUradclJUEbNJncgcH9rNRF6RRgm0LeQEw7IhorLKi-aFf4lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ptasB5y0oYPKuZLl61d_ztAg4Im8vw9qf8258snXqzA&oe=6A2AD2FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyS85-NLYPgQ7kNvwGGsNPJ&_nc_oc=AdoIxsl8rgkozISupKhzWSUFgmxIV2Sl1aK07imXBsS3vI6bz4MSoYNDpsaDclrgxao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A2MPxzf5u5jANNlGcMAghgfY0jf8mKOymut5pJTQigw&oe=6A2ADA3F"}, "is_concept": false, "is
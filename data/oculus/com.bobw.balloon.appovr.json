25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxkRMtaoci8Q7kNvwELD9VN&_nc_oc=AdpFQ3d7psyeP6LPCZY0TtOM7a2_7jW-TalTddHphkaPoWIF8G07Owszd4PDhQYExdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MSvl7YsbAJpoFRBFFioQAKCIDC-2HyJpardoJK_2q9g&oe=6A1EEE2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpDPiEI1Xb4Q7kNvwFmbSC0&_nc_oc=AdoT2NsTQgu7IkRvDEIasrFBTXQSkDQOWfrqN_2YAXLQgqdD3SkXXCM6ZBwaViFe-H8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rvnN_L6Mw0bmgMwtbuaaZh2c01aiqRcWzvn5XqUuvaw&oe=6A1EE5C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj6mKj73E5AQ7kNvwEd9_EZ&_nc_oc=AdrneAJSJfF706bt_YFCM-mMCW_OPPC8XIEFvjqLvTgmiBTf1tFLM2ShR0B4axRxVI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VDunKh7zXb3It9iWs-vZxL7hVZ7Kng3F_68aIc2MAkw&oe=6A1EF52E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgZ3WPBqH28Q7kNvwE4lVtU&_nc_oc=AdrDR8sMr9uNZK_MSylpZWCu0ACuSbz5UakPJVS1nDz9m2uHj_utxgmY9n6rdSUsgkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ngzVrGNJ4cVDdbjT52-pxp_xTBaTn7HR0dURe6auYMQ&oe=6A1EF57C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xsx3ejl_SloQ7kNvwEDjYDh&_nc_oc=Ado0BRwKQsPxoPIxSZET1VXuy-tJJp2jsiT18vWfhnKfEHQ-nQeR91O5obeDaIXh9DA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nPdTTl87UIPnxKsYm6F4RqUwA_pY50HXmwxfYaJYl1Q&oe=6A1EFCBF"}, "is_concept": false, "is
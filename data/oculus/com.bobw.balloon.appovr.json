25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx1L8CdWx6IQ7kNvwErOy26&_nc_oc=AdrAV2WGOd-DhAZpZZii8a-9OBTdCywOneFCvNqDu3_ANP0TPWyZSa9sZmf8pGho1x0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3mkHsTgjqX_kvUzFVah1XM1h6JFgnjGWXn4oaUNIAHA&oe=6AD38BAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEphrQk4n7QQ7kNvwETWtku&_nc_oc=Adp8kgcv74vlgTsTyBQbYmk0GmzW3FC0BbOxKPMSyRO3mjhGnnUOrcbXUVg8lZ0PDW8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfaS970M7U9yck64TG1D20HQYfAdV_FxbWLg6hIgwfpA&oe=6AD3BB86"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1Pt3EMNPHkQ7kNvwGFB3xf&_nc_oc=Adp4Ul4sW_t2B9k1naV8vfGIw2aumenhIOH55jdmiR5l3X37oTAEnZuctlMk4EAFax0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP5FHZzlA_SiM_1p7XEHVz_1D5NXXtPYNKe2aR7IZJ6g&oe=6AD392AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4q18ITCYTocQ7kNvwGMzJVe&_nc_oc=Ado30707IADtV8DlhTYAuYmFblkoKlppMc3trICMa5V0lrVzCMUY5FNv5ts9AtG92F4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2BLq6bAnGu8i4ab2jGCXvq_1GFd0dBXN1yIhD5yKd5w&oe=6AD392FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahenwm5fP1MQ7kNvwEz-XEI&_nc_oc=Ado5MdsGzDl4wHcqmrxMVXDqGVC0GjkZUMwW5jcjnljXvPf2VLUlOTuWL3VeKtVFJR0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGlnI3kBSuDe4VhO0Lz0ePXBBYc0MITkPa2OuH-Hq7hg&oe=6AD39A3F"}, "is_concept": false, "is
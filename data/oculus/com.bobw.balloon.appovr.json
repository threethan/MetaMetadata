25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXlCgu5xvdYQ7kNvwEwzKA9&_nc_oc=AdoQMoQY5nX8YZqY98yqBSLkGqTRSppDSbqq4oXMllkiWw9cWBz4GAfgD0ic3V0IECQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmLSKu6gB28sHjccfeKQHLY4BV_9mJJHFf-ITM8W0Rgg&oe=6A7C506A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjrS5WcdiSAQ7kNvwFgxCd8&_nc_oc=AdotbTFssZqprzqgqBZgUGJQQCFznSZKhYt04O-72lUPL-EUAm9dfh3xG_ELaM4B7MU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA-sQceGXNxwuu1MBFQZN1Xml8hagg_J78lUqDSJcfmQ&oe=6A7C4806"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5QyGcDYIrAQ7kNvwH8Dv4q&_nc_oc=Adq-LjtYSZVbpNuxvoTUkOiqqZxbOuXwyHbhvlm5sASedZaKWrtdpDKgDU3Brrenw64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW01HTCmnIZrEjBTsPxMsD4Y46d0NBnakAia49-TjmcQ&oe=6A7C576E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmUt3If3pQoQ7kNvwGkE9aC&_nc_oc=Adp3j98sRG8980Ob1SWUAOxmuIABAHd2G_ysC_qr8sJbKNJMvWOQmuV6EZpYOSycWuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi6EifEka1pnba7087Z1c09djFMTHDPI1cJUC69a7Z7w&oe=6A7C57BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpwS9nmU-ukQ7kNvwGaGS6x&_nc_oc=Ado71dYelAAvyqEYMWqdWEmXt0uJA8_kMKYbHMDuonsl3MHjWFzMhqs-z4j35yGZPtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtgpRe5ef-Vq9KVBMQ-yQQ5gxIkBqrGlsu8MZp444rng&oe=6A7C5EFF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8VuTR_G8yMQ7kNvwHmWN2r&_nc_oc=Adooq-WdF2qQiBxlNHVMKj-H5-bAmtMQG40YMvA1FPNnYcjgmHT4NMKDIDaU5O3odAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRJZfyq8gD899qrEwSkMXozgqas9ix88cH1y_9vjxGDw&oe=6AB92DAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huUvms2R64AQ7kNvwFWKELj&_nc_oc=AdomLi_ZdUWZHJR64hqGQm4Xcbd57_qZSHhXQhbnnikrEO4l0WAQw-fFHEOE54BmGWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGm2JGMQC2tigrOCspmNxWMWJAcD8rEwdEfZC-usXCpA&oe=6AB92546"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VISlKPqVRMQ7kNvwEr9tMp&_nc_oc=Adp1GaUzWcvO5Jlip8XgSLs5l_JK3-MVenFz6Jmb-LTEYTIvrruJR1Xij4i7KbXz1cc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJji51ITPpRHFvmadta5XYGV_R2z9Nf_zhYmbkGZVRXGw&oe=6AB934AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHli6h65yVUQ7kNvwHSRrSu&_nc_oc=Ado30ox4tZ_DM27bh8yZ0lxamQrNg320sTJ15lVMXUJjea4xoE1Is0iXoYjFivmqPBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5_I0_rldRmwrxwvFqVlz_7yW9otRuWGAODn1_cHOVHw&oe=6AB934FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZQM485JEC4Q7kNvwEPLIRr&_nc_oc=Adrc5BFXMa7sezxuBeTzoU1M9pSFCsAKjjLG_5McHCvqvA8jadAxEvyA9pDChCwIs18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8eaVMDh9vcAeRdkGMMEIOZL4OBSFIIWyLqyk2GaZVww&oe=6AB93C3F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av3rpewGTp0Q7kNvwHaxzZ7&_nc_oc=Adr4EbpgnR8jyKjQBQfe7gZQN1RGf5DQTbvKKe1VXKlbUFp0mXmq3mpAd5KC5AuVaDo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHspFEhMIA-gfR5HYR7pqTQqPupOPn_9hOQFfIQo5iRw&oe=6AD0E8AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEphrQk4n7QQ7kNvwFqvFS1&_nc_oc=AdpLnyQ6I7JD3czW1atpXWsYM_bFZIlLZzSL1ZBoBiMXis5sa8IUxw9Ut6fy9Sse-oc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAEYT8Ns1uLLaB_sUDDzhdkKe1KOjmC8FwHznG8iSOHA&oe=6AD0E046"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtxgSesDAfMQ7kNvwG_PwcV&_nc_oc=AdpefAb5CRRLQMu_vX0eKgNTeYwyloXQvLfNNXdgx1c6Wf6nqYD_G7Mweo92m4s99xw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaAbyd9QXMuFn0byZtVw_5Qn4o1x3d2cyHdKQ3jtLmIA&oe=6AD0EFAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4q18ITCYTocQ7kNvwGCju7_&_nc_oc=AdodRMdseCWNGy2VhC6cI8LkKK6pwrc2FkhYTWOyfVKqqm2BTczCJJNy7iGZYQZmas0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1Tm6aCGOPivcReOG5-NpP4vy3AXfpffGV5osimI_c6w&oe=6AD0EFFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXic2gka254Q7kNvwHo1M8Z&_nc_oc=Adr0Izuh866E2h2JyyCDWko5HwsrOpwoAS7T2tJbNYqFKTrWKQ3hqoPzyhTlM2N9vis&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJEzL3KbI3mXjaRnRhx1gbKnbHsTpn7Fq3fjWESe-SXg&oe=6AD0F73F"}, "is_concept": false, "is
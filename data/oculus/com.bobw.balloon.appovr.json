25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue3vCur1BG4Q7kNvwERv0jP&_nc_oc=AdpPqErnS6R-7mnm67apYWjlgwoFfJq1_K1Dw4EmTiiltIHwm7zY-qR-jussphex8J4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1iFnp-Ss9g9xxiZHQ4H2bQOQpjWBUWenOiLJfl_w5dQ&oe=6A661F2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QGnAj4FmsoQ7kNvwHES2cF&_nc_oc=AdpHmlyDBz5wV_bMnBdEXUSnJa_P47zr6fAqEO8DBdyGxWH7n12kTXtfT8_34EbqCF8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9tQOdGTDam8semLeufqvrBQrCX6kRjYXI906OYU9LVg&oe=6A6616C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSpI_F1YQeQQ7kNvwGifHz2&_nc_oc=AdrI9jXBbty6_jfYGXKw_2ZX9Zfucq_yQBg2FvgYtn3dRUOaSOcDhF8dolGy4A8SYFc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKueDK0dQtaZNP-3Ot3kSUAAO4yDiAobadD-jkUSkkBA&oe=6A66262E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y2aQ97LpxcQ7kNvwEW6L14&_nc_oc=AdoSjdkPgeAQ9LgD3C2EQKXlz1xqzqJ-v2LgK0dAuytn4nTB3ZH_-gavtEz2NUiaJOY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoTYosGv21Mv2yjJCk1nfpn-JXT8ETBMZ87OhP9XJiWA&oe=6A66267C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTcnT8X_s04Q7kNvwGeZNGu&_nc_oc=AdqgDQE1D2xdIM7Z5Q9oFyMjxS6UzWzC3qRFVK9iE3a39asDCS3cJ46ON_CWo6dxXIc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuw4nrdL4jtl9X4WNPEi8wCQLqs6vT9g7GG4i_pn_pLw&oe=6A65F57F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhN3r0UkOfkQ7kNvwETsaRR&_nc_oc=Adp-WDXezqxjzMFl1Fxjdy8Q4cCJU_TaiO2JZEhTDfTyHmZEgKmP0kLeeloD40VOTDE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-PStgw9FDjddegL7CLTEu_JT_bws2zNLDocvyHOG0mw&oe=69D7BD2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTo0ZIRcS6EQ7kNvwGElqlY&_nc_oc=AdpOQNiEA6ckg49qNUb3RZN1ePBcjEpJMkrccfSUCC7_GivbXYeEu7NL9_3rR4MHxkg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33vrion-Vai1g_X_kpIOMPVFifDJZ6b0-MMDTz6p8X8Q&oe=69D7B4C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aQXXV_OBZ0Q7kNvwEbmI_J&_nc_oc=Adoti4yBZMXSfhM6hULDk2InXaW1Xe0EYtltTEsSTNz9unLQtzrq3ZA35fTR1-jBjRo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fbIOMggcXs2LzSxX2mxbc6Y1SJe8S_Hd9GiYEbMpMQw&oe=69D78BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7r2oTwdcw8Q7kNvwE_V3e8&_nc_oc=Adrjnlj72IurJIVCIrh2K2-IhtSpm3RXODQA6DCEurfKrKBrwdEfLIKabFh3uVHbQHU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33g1dxFg4KdOzB3P0jDh10yzKJ0YT7a4xEYVUbx9c3uA&oe=69D78C3C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL-DnVTztsUQ7kNvwH2AmLa&_nc_oc=AdqE_0xn7Ui4yyUmzA228qHzZbh5-5nXxTRkZVK6-SYQufjnC2OO3Nn1Ly7_Nx7Fdv4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OUsSKxAAihMXAgnlDE0HuDGQ5OXysXnjbEAj85Usy1Q&oe=69D7937F"}, "is_concept": false, "is
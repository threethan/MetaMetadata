25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0FFWHeHknMQ7kNvwGJSKne&_nc_oc=Ado7TsKimxdZHk9Wq-Iovhk9dB8V1Xz3Z5DCogh3RzmfITakXfWeZyN1EHnlp_l25jA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyja7TRq8F6ohF6yEPaH0jFwgJDZGSlZ3wPsW6ut5hbWw&oe=69C26CEA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGmBeyN_qGwQ7kNvwGC98i7&_nc_oc=AdrjmOhWlA3uWTCm9TZXpcYc64UQeOghbo44roAvPs0j2Dhk4DSXv4smoxN9nEGnAUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGQmjSRU92vT57Gd0FxCBMXq3RI9IiTvYqEtxjDBACrQ&oe=69C29CC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBXx9AuETH4Q7kNvwH4Ptg1&_nc_oc=AdpWqYe06gUQcofEtwlVYFxVDZ0lJiiCGHe9M7Mfjt9FCFaWUU21ejZ3RF3KnJAvT70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxm-uZUm560d5xL7Uuz6E4vOCxQ0M2mAq0jsNwxZ8pfkA&oe=69C273EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ORAAwITj94Q7kNvwGAEs0g&_nc_oc=AdrcNnZyqCAnVfoxAIy7OaYwHYiD1Vge-fIRqzJqslTV4pG2DoU_A2TZOqE3r7uvTGI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaWGMBaCzbthHp3jIuXhVjo_mwpwx1NvcZinN1-j2DVg&oe=69C2743C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3cTtinXZJsQ7kNvwGg3023&_nc_oc=AdpE4D9oIg7txS2OVb-D_gvZOdstR5cHfNOj512isXSXaG8ESrvMuHtd-2uFidq_Ipw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0KNjaByaUXdiH-WiMpb9-O5d5mc2o6uzuguDJII28aw&oe=69C27B7F"}, "is_concept": false, "is
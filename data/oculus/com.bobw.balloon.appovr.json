25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLA_cLo0lIkQ7kNvwEK4MkT&_nc_oc=Adr5h3Sgs76z6W5W30g11XCXLEtosGBv2EeR_4vQ6dVwrvh6y_u43AhdwWoCYabVT2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b5Z27q7jYG9Cmx5wjMPK3uzlDLrwzhJjI1A75jIUBEg&oe=6A3BEF2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vpxSjYO86MQ7kNvwGSnfkX&_nc_oc=AdrXMAjwNW5UjgZ8a1BnY63FKKZ_GFu3BiYi_JP6DyjjLK1VZpWVHtYbKIAPzim52cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TQ5RPeQlMJRJvSFZUnzVCzGmGjKiX2nPmA0ZfbmQE7w&oe=6A3BE6C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC2twbeDaG0Q7kNvwF8K9ti&_nc_oc=AdrOkn27oYCCSqTSoWsdzUhSljrf7-sRxQtLH0UTbU6ALGJJq7gchk0AB0VPKfCJnZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A1vQ-TPxLrU_u7oJ5SWLp6Nt8MzP9atNc6y2-KS_nZQ&oe=6A3BF62E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHtBRmnB2DUQ7kNvwG9Lo7R&_nc_oc=AdrGs0eW-5FMkie4O86hnrQwbY3YMhGp4UcEIfVSrDnIeqMlqrNOhrbLgtJX1-ZpWDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TiKhzLriHGbjBrbGhoOCM89OroiBYkuRDcMgZ9hf6AQ&oe=6A3BF67C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_bpJhYTSScQ7kNvwHXbIqk&_nc_oc=Adrr-zVZ5CKZF-8Og9-AQIgzMwEs7jBVLN7hUK0ouwGJbMt3q4WXRz5okSnErRC052s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dwEPjB0qXnyu99C6WbB4BbMW6haEUSNrfIDzFwy45pQ&oe=6A3BFDBF"}, "is_concept": false, "is
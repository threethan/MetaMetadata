25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-sdko959FoQ7kNvwEqZpFH&_nc_oc=Adoj5P98WGbTf2Y5bLvz5tuVmdt2ee19TPd7gPJ-UOOoECxLT9p_ZjyaE4Dve-GcV8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91Hl6w8yDGv-pww7z_YZx8rIrWpNQIN1UPLyo5YUuFkg&oe=6A2585AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4SmH30zmykQ7kNvwHCmUD-&_nc_oc=AdrEiH7uhJLGT1gGtEbd32xUqXbs_teAjCYQ5ynElT9xFyzuakGITpvJXytUYxWhtms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PoL9hk-asdX6KrrhXXLAuV12i8Z2q6wjdaFrm63_1Gw&oe=6A257D46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAuxMNfuhKgQ7kNvwE-hjGr&_nc_oc=AdoaJPWncsMjwRyZMAviojZD-Idj2fF6IxpWSj_c0YsiH1FmyrbyE76j233_swROd-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8coXCXpqhDkg1QKuTYXocgSTmfgIKuaY3GNu6JA6V4yw&oe=6A258CAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIQ0phTY4okQ7kNvwHkvCV4&_nc_oc=AdrILdMqh4B5l7DT3e4mfgbm9vPaM5yUkCdRCsbG61RR7CWUktc87tA2tjjLlns7b6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ev3ErHiBKOnCqLdoHmIivXFCEt_gBzKK4XZJscpwjcg&oe=6A258CFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Apu81C1GkcQ7kNvwE1ybTa&_nc_oc=AdrLZgVEfYPbNYPyC5JU1KNDemo9HmR9lgs-iFX3ZkVqptDeGamcCTmhdRSnTPPy2CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iCwzhxWvTKgRO3ro2ly_WcFRDXiLxT4ABJdHQqD1WxA&oe=6A25943F"}, "is_concept": false, "is
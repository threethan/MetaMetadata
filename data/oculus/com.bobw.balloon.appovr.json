25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_AUlI98NE8Q7kNvwG_vcCn&_nc_oc=Adox36H1zcdoLefuDtXe51mQ_WrlPkHbnjEWG5x9ZUXZUvTnFYlhW5Rqp0ph1uJ1L10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pGh01kWOLDnbdjACuVZsceQbp-Z-NPBdc1e23GQ5rgw&oe=6A43D82A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1uaPPQBWdoQ7kNvwHLj8WO&_nc_oc=AdrIff1qaaJ3H-pjHY1Aik-sbClq9VtPPZY1qWlFRhIwEGkX3FBz5csidqUkHBTTkbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qlktvzMYUVn2jSGBvZkqZ-EZU2jf-Q5rGQrx03XgzaA&oe=6A43CFC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TbFuvi3npAQ7kNvwHfpm9p&_nc_oc=AdpmQic10z7-PvHaxHmAk2IbXItGiqlFafh3AuXeY6c_ctvbEt7mAOpWYtxK5tzPxAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8WgPDjMmL5gMK_xQpnHRVZ_59id35cIZIdZ9BnWSnww&oe=6A43DF2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN23NIo567cQ7kNvwHIsW9z&_nc_oc=AdoziCwsJk9jPCyM4kelr1gZVRUHSA2tqcq2mZQwZW6AZSmOcx5M2iIMSukl-F7JPtE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2aRFvD8NanBh80FkQ5f4uK81w-98JGwOif3gVD3J1PA&oe=6A43DF7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN3sWOPTP-wQ7kNvwHBeruz&_nc_oc=AdqpQjjnt39AeIsJu0BKcZC-fkJ1fyPL0oKLDAEs0vIitmmC4jrzTE4o7Q586bFco6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U7xnMtYMCC8ZPFljR52Zz2h48VMx_ZmXHy3Tvk1dixA&oe=6A43E6BF"}, "is_concept": false, "is
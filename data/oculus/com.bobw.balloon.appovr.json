25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akbdd2AEKRkQ7kNvwGTjIfH&_nc_oc=AdrmjC2B9Z3CaSYj5xHQvyEVsHa1AYbvZyrC3GGeuQ5W2auV57De_hdiwslUGFkK29A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aPMEZ4O9XDDPF789-OW6qSkTzB5BRJt-bchsbo4-ECw&oe=6A106DAA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cHmo8WIQ6wQ7kNvwGhQMJK&_nc_oc=AdpWFfK24yFfqA7bIP5vJ4xwOSx2p370URtCaSt8ExLn7T8u_gJlJrX--qwa4HTGY0w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tZJdXBWa7NCRz2_HYArbLLb1Z2exmDQ14_6QC26ENUA&oe=6A106546"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiyF4PmmC4oQ7kNvwF02KS3&_nc_oc=AdrOUKVp3HBRkBds0xdVWCwhpRQvSHVYTymJ_Z5HJlJKhtc5rBqybv9NIgzvsdxXN7g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jtRbJvtVvyltO7-RYPf9ZnDn8We7SbdjVewgvdpi1KQ&oe=6A1074AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlNFCriBAUEQ7kNvwGp28h7&_nc_oc=AdqdAhT4J5jwl3P1e_xfv-yrAXo2rVRTbEm8nGWmGutahiGqw1eXsPCwY3j1EjC4ETI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62w0uVTG28RazbvHuHsr3z7Ns7HBsSvw93u1wYSkXKvQ&oe=6A1074FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PfDIp2O_U0Q7kNvwFKlkB2&_nc_oc=Adp6iSr3XESciexW5_qwGDrghja_bZslLyX8uPLlEUJ4wX80o1jip5vpYEV03-LlR3o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TaJQQ2U1Gn234IemNw0MvlR29GNzwTexSIabsDUp16A&oe=6A107C3F"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krSbIYkCpH4Q7kNvwEBjD5d&_nc_oc=Adq0UY5sF2pSOsMweBdze1oZnTw1JUShusIvbM-7VMPWLtgU5n5UkEmxGxqBI_0zoFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvFK_ct_4mZl2y1UrqI9gzu6Q5yxiO5EA0zH5i-cP3eA&oe=6ABFC52A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEDGYsBWbLkQ7kNvwHhgpzh&_nc_oc=AdpT8pUcT3jUdFXFduLPRDL2X1IFhwiLDqjCYa1GZtt3NonmM2zeWeD9GUx0Aguo0yI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-FBOo_468KRkdoPH1IgI8EEw6nGN60ypqYYrawjdmBQ&oe=6ABFBCC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-JgdxTDAEEQ7kNvwFdFusk&_nc_oc=AdpeVDNJc0LN4svIGPWp74eUxZGzQcftsYMX3CYyRHo7CT-Pjd7J6CYVhrajgRGlVos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIxM5S5NIhxsT1vzH0PAaKKhIwCjPyk-rByQbpX8-RiQ&oe=6ABFCC2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjTA9dsMA6MQ7kNvwH6Fxgv&_nc_oc=AdqQjOFOCb2PQFa4tZhFRKitv1VPszL7OcqN7EAzr6VZlrxMih3QzCqXgej-GGBDmgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6swjS6Wgg-PNcyPRjhjRyH40sWQ1pkwzcRa0BhpbDPQ&oe=6ABFCC7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FllYYxhk-7YQ7kNvwGTCW9H&_nc_oc=Ado3pMrngiOunVCsB93Vl_-yutLr7O32A88LhOMj1hyBSKqO9iQctmDR9250Si8peuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOqMrx0HWALlAtRUBgLb5EFH_3rdfezZyK9ALU7VJ1SQ&oe=6ABFD3BF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFpzNT1TE_kQ7kNvwHyIsMz&_nc_oc=Adppg36TMNDYtab5FgUXC4vVUHo8XNTPivxuZ5wJ2GIqkqMrohWy4hX7FZGIMZLvjXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1UCj2J2RUu0yesLFnMAe1wWTaJ5JHEceRNTC1U-GDSA&oe=6A75F12A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4_CxjUGMQ4Q7kNvwGmxOiu&_nc_oc=Ado4mwUfZoeK8Txeq1cHFgWpJaYT0miCny0p1kV3PMMkLAb9sVLf5sEv642GMHnOnlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsmpp3XT-lmmhwaTetlL1c865qzBr-MFUHbJnH51bgnQ&oe=6A75E8C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DmktP5jVnIQ7kNvwHDoVVy&_nc_oc=AdrclwKPfhoF72TPevfd1kzybfBUTSjHlzEuvY8IcMTS0zKga3G73BhK-16EG_M5M8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4hxkPN9Sh0IwCX3vaGYo3zMIFZFhVu9z7MAuwtgmlKg&oe=6A75F82E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xENOJp9FKbwQ7kNvwGGl98N&_nc_oc=Ado33rQQ3qrZg6Pu_Zs50Xp7prAUfg5eFmJZ5guSTHUqnQIbPpxBa_xqIkczCh8NwtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGua5O1tL51ZVs0-fSBrLXbJrBp4-da96jJeZTgfMR9Q&oe=6A75F87C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVn5bKJcy70Q7kNvwFVGyyB&_nc_oc=Adpe8MUDjrxFQZL7DJgs186-H6p5XjMwrnp4hMyYsfS4l4kCa5romdDYS6NgkkDViIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg-Wh78Bs_Q241sepqXenDpvbv9WmYJv6UdTr37jQNCg&oe=6A75C77F"}, "is_concept": false, "is
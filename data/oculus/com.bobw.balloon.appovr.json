8jA&_nc_oc=AdnZfBFMN570WbLpexU6SiR09U5n8C6Wo-WlnmhUkZzMcMc8P1NQsy5CFXJX1bXCTxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvrUhUgWCkeQx5UMnmp4Xc3qx079v6WrAinABS5Gb_ElA&oe=699ED46A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUGJcalIbJ0Q7kNvwH4k-zK&_nc_oc=AdnhIebqVw1vFxMzIbGyaeDfKoP28IzmmE3IbNPTQabuScOZ4ABF9uhfm0OwWI7M4Ow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQjwrnny1n2wp91lkIy3mrPn2-POB-Mv68yAs4bx1skw&oe=699F0446"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Euxp7rNqC_EQ7kNvwFN1mte&_nc_oc=AdkTISmDjdcLuxboO7h4phVAkpK_pvrwCKT2jC7x1-_m3-3-xAyADzeCmib_9Dfcbd0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftoyACecmBgiAGcYmmOh98DAJb19psxpEyWKUNy5_WVyg&oe=699EDB6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuuGglw4liIQ7kNvwHZDTZi&_nc_oc=Adnsbq5SMsw2T2jnyVWMHlxTbKqqk_imGfb8LI0ywNS8iCt_JUvhpueP6nvJstllkOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu5lwvqkaoFB_C2OgEEQzxA3TQTlxKG56GuiKfguZolQQ&oe=699EDBBC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=creCXsIAQJcQ7kNvwHP_cJr&_nc_oc=AdnRHu7AiU2yHenJLz2gSlYVCnYq6aMHwJ48M91QMh5-kIBXcQEzonPfsJKq4oG2Bqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsjpNiptDHHauP_PYMHCeh91LOWDN6PR8Jn-Ag8UhZL6w&oe=699EE2FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Balloon Gunner", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
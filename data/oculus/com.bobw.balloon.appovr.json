25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faBPo6kwOWYQ7kNvwGmHN7z&_nc_oc=AdpgHXXgs8P7bAzvRqtNjgtS4wi0UNxtBWbzxvpgdKzL8znenqe3mEZDY9-kxZ9AJ5Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1fW5dVWKXiwgNy4ZLEdBXmdDOQF_eiW5mfKozdmhp-A&oe=6A2C1D2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez-KMxVXi4UQ7kNvwHnNF6X&_nc_oc=AdpzsF23iAXDkI5C_LpRG6Q11vA-p6WpZxTelqUwIzxC7RK-TUAR76_hnuPjLHr4LiU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-sExheCTLrQxBG-SFga413bMTt_yHdkMh5mQqB0kIlQ&oe=6A2C14C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d94sugk3xekQ7kNvwGBFVkc&_nc_oc=AdqFsjszXtl8wJwcW7ZjtaBSQ4K6bg4L93hTtSZIZIpyTEk0KPKTH5cCSkXunJUsSeA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7tN121v8WEfzMaskE0jZTPb5vJXF0f2Ac2B6kvWNKKg&oe=6A2C242E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rY2Xce7eAn8Q7kNvwGc9riu&_nc_oc=Adr6clTqDdYqDO9niO6iXwC1DQIW76OaKjUJMwQwKUBkM_OKMzjBqoZfphGDBaI6Nm4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W5c9CnQsmn56UfYfOZjwaX8WPNg_v-vrjXmFEuSF-9w&oe=6A2C247C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRDLYLZybXYQ7kNvwGpJDai&_nc_oc=AdqMaJCaxQiaYMwQvFcMjq0A2NzABdV2gwq-bfEENn2NaE8NN6jHgCztq8nNkpwoQw8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vRWhE-4fQuo181MmyP4nZIXXf2CKpwBeevHT5oIU0mQ&oe=6A2C2BBF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzkkHVpHrKkQ7kNvwFtPnTa&_nc_oc=AdqSRMTq1h3CcuPfMcV2oU13rEsHLLQlKHz4Xb_7s3qZFVdnIC5S7MqP9wsGojoTN4w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUs1BRPGC7l7bHqvXQx-p5PA9QF3Kq2CMII8FPa1c9EQ&oe=6AE8A3AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzhuJjcG54wQ7kNvwGs_dfR&_nc_oc=AdpHsSu1YGhN7CQdqKGmOLGtjGHHr1iL3JORExZQllPp0DlwDcJdcVGbepGgAFBHBJg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsLHaWNJrIagRw93-LZKN3j9OvbA87F86gfhX_j_s4fw&oe=6AE89B46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZTHDCG25yMQ7kNvwH2oI3D&_nc_oc=AdquoACR9IGiR_rF7ojC9V0DqsI_49qenHSd9MHfpV-Lh5hil-3yVRcpHev4aaHSYKU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFaibye3DehnI4sFVU3vVlJHwPl2HtjxYOQQpiUAdx2w&oe=6AE8AAAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQ2WGLnVWrkQ7kNvwHHFbC9&_nc_oc=Ado76-jqI0eoJyYr9DlFb40HbkdFMV_4JrXV7cc5PO0go57wYuqhUJhrym2fO3yZNGM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpvHr_Z-VaQ9rZxeqm3iTleQmwYN31avGZ4EznLfzs0g&oe=6AE8AAFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf-EFjPGB2AQ7kNvwF3Xp6B&_nc_oc=AdrC1eypdb6MBQyKSyigp7VGcPfzkeGbEeIB7WFNLoBiF9Tc_oDx93kK7DAza6vx8ik&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9wBVPSWYlQGVW8gsw99Yl_3mcKwXER5SuEgcziBb1lQ&oe=6AE8B23F"}, "is_concept": false, "is
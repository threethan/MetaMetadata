25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOxuTWIj8wMQ7kNvwHzqZ6Y&_nc_oc=AdqrSi9Zrs1Ueitqr5M0tpv8HXPWKqYHa-jFB2ymLqlThedmZAhiDT1skaqzZi134xs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORAuuUTxtZqs8Ag6-fB8zV5Ha9eWIIncknSl5VcSSoBQ&oe=6AC7AE2A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPbJn4UZp-MQ7kNvwHpcTuT&_nc_oc=AdrOmaeE_AV5nYHC2NudHYBWedjfEsGRbaA-ZLaIJX14MhQH2eQ9r7pliXjS90wd-wU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvFmUHnM71EVCZU04-WyVMhzlIGubu2fDHYJgZ-9t7yw&oe=6AC7A5C6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRx651cTLB8Q7kNvwEl2KKw&_nc_oc=Adr1ub8dNkCkzBeazUc_gY05hfWPFcDA2zmrx7Rb9wkRJN0TjfGtUlxZfXE_SYzYxQ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvL0CVymBrxEMkWuVS4_KW0qDwX2oZdlRWJvdrYRXqnw&oe=6AC7B52E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIy7WHUaOVkQ7kNvwGnsvxH&_nc_oc=Adp0Nat17Z5TjZArN6jzZVNWX15E1bjIDEssYbVqX6yT4IGqirHyw4NVxIdjL_urVRI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-0BWqpjEPq6V5n_oJCoe6YUAOg6Moyz9jL8vPkxX0MA&oe=6AC7B57C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NbYhjO_l6UQ7kNvwH4RHkA&_nc_oc=AdpbALk7uEibzMklxvK5qs5mQ8TOJMohqRppp3fLsOFEtgZJBVBBcg67kV32mUtu4G8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWd9n9fLFU5h2-muJjP4Yi_Wpoc1qm2zaIm5N_aXI3dA&oe=6AC7BCBF"}, "is_concept": false, "is
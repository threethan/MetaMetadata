25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw4QcwMrGpIQ7kNvwFuKAAJ&_nc_oc=Adrsoi0OvWUvVQ5pEXLFToGYTzb6sowLI5QTX-ebz6tG9IVlNgZ5EgRP6g-fHM85fn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tYp4C47ecpXX4ijq9UzC6fGT5UNIDMDC7Qdogsc2J5w&oe=69D3906A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z20F2uwSPs0Q7kNvwF3spzC&_nc_oc=AdrJf_3_8Oc1VLr1KP6v9g9_X8jFm6VWMX0ty9oCn3vOvHS9bP2YoiWUGYwnVjNSnWc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18k4rb6ZwtWKQAxgcDdgEqjKWP0678u2yFGIH8hd_oYw&oe=69D3C046"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaGpKs2OUz8Q7kNvwEmHfRY&_nc_oc=AdrQfUfKA9kh4_FcX-xb5_dsGM4JsG3lgTo4x5rCL4r7V_Y7Bfs6pYlUYMvosa1mAJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qkRuLQJANDftAo2Cu15Rgsn9mKHZys22D7dN2r2Akug&oe=69D3976E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMyURB85EDwQ7kNvwEOyJl3&_nc_oc=AdqbHNZbzoPW6RocH_v4vVeJomVm6mkb3yFZdA9YpCDBttAJXv4Mqdy8GEToPj12_1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35jucDLLP2koUCQH_wQ6ouVMYnWjLgu11pC0MkKMoPJg&oe=69D397BC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEJLYfex3F0Q7kNvwEMA_31&_nc_oc=AdorJkUiNHpMvZCD2FhuPakBf7RnV0xNH_296_YKvrDCbrOMi1totK4t70Oq0s1TP2s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AJJW8gzMJ1s-pSocreDe_z17Wb1xq79zGTfTHYV8gRQ&oe=69D39EFF"}, "is_concept": false, "is
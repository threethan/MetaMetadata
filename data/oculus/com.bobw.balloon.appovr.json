25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2xYwinVtZ0Q7kNvwE7OBW4&_nc_oc=AdoBNXx9_BLUydgP8BwdewqV8q413oBdmUNzHn32B5GT_OMa0mIs2fqD77AeyoRjXHo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLZ4v8D9Vr7Ac4ll1dsm552Sp7vV-FMDdtbb4OqED7uw&oe=6AA172AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mboi46blLG8Q7kNvwGNlqaE&_nc_oc=Adp-1aMaKscvzz3YO0PWBewdHVw6vNfWmoCocJgDg-GHhOgtfoBtNTl99vPeJzKu7mM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYNDReeO8qeHxaDbRSVp74Q3wtCqYWJtJxRhzma6aRRg&oe=6AA16A46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbOskMsbLJkQ7kNvwH3kybt&_nc_oc=Ado_kLex6K5Lx68dua8RCrMGQSPalajHQ1nTnnVioABdVmZX9E7EYUCEeqh1XRLCIZM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIunBxkRjgkQrWE9GxKKYNYGCAvhoIpyk3q3EDxyNP0VQ&oe=6AA179AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVeE7mmIOSIQ7kNvwF9TrbM&_nc_oc=AdrP8eJRZfMdJi_1uIUpZ-YGGpVW7IUPIb2DrA4-pRVLrdAaozjK9GNokrQLSSiFmmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfaQVqG-_U808tsF0VOMnR6oULEpvZDfZzJWwc4JBIGA&oe=6AA179FC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f20dLF0hTrMQ7kNvwE5VbVU&_nc_oc=AdrrteI6yht_N31X30vFitek0Mab1BnnCi2PVe3WaS92BDty6f6mMEhGox1DDpzO6GM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIylzZQ5AcXCZ-YA2uJaVPgVS4LVs7_W-PhZq7gbUJlbQ&oe=6AA148FF"}, "is_concept": false, "is
25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyni6MOkty8Q7kNvwHnER9s&_nc_oc=AdpyxzjF7qhrMeQAPZ_WrC3F0kHEIe3bgz4tZttLbDW5Z4pgdQXWrVThy9-g-9Kd42o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IlMAstwFILrUAY5CovnACMxiNqhRXWWVUe490yPyG_g&oe=6A09D62A"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owgQRapnRYgQ7kNvwEAdhyI&_nc_oc=Adpt2IZqKE5zV71Dccq9LE2uF6JWENQXooGKXcuGEuR6FsYpd9X2Znv3Xd3lI4nvKqA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oLstB5thVNo7DL4-ulVswizWAF1AHl4A_wvNw2catdQ&oe=6A09CDC6"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hXRvyNmb5gQ7kNvwEEeDLT&_nc_oc=AdpOiIuHLHnjcc59-ih6F_qVYihCYoMYI5WdNmE6Xek_7odWuKgvCEIewQebRvuD-4M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fGgsCieSriqDqrBJLNrmc6rZpiwTNBjhK47LV6GKdnQ&oe=6A09DD2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z247Q3fxqs0Q7kNvwEI5RsG&_nc_oc=AdpWYMD0dqVHU0Qm1vAr8sVfj8BO8Aw9CXd8D2pE2YR6nn4PiKMSl0clYZP3RlOWs1g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jQmmoxxINqmdghjWqzswT5wYef2yGsWJwkirMa7HccA&oe=6A09DD7C"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt3LP6QvlC4Q7kNvwFP5QeE&_nc_oc=AdpP6dITbp3R2SIMnDalYvl6jsNJIyvw1PJP3zuiKwdukCLry8J78j4PynttZEjii-U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gkioKS_axU-x3TyMJGzRlqtAsiPazJHo1O2erjSZ_mA&oe=6A09E4BF"}, "is_concept": false, "is
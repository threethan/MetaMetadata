25/39001685_1129383824139252_852196231547688556_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJzl7UoqnOEQ7kNvwH11p7y&_nc_oc=AdoN2oGBAyIEvXNHfpmA-pgB5vq9YBL4ExMxR3VjJ_axKPlfz9ZmZx8g7e4aeNt_R-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vbjGtbF0B_4KfH2tdn0c_XTZKHi0OmGXzSPG2HVGFcA&oe=6A3FE3AA"}, {"file_name": "4.png", "id": "289624362901284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974901_289624366234617_337936578869321897_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLBbGM_bqA4Q7kNvwGBGYrN&_nc_oc=AdrlOR0kAkkwtWz9QMYP6cgLooIykcgJmuY6U8biyce8euGFkicw_3ZoptGG5rO8iA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YgJH-2xUjc84u3YF7fv3-agyNFIvp3h_YVMJjIdrQkQ&oe=6A3FDB46"}, {"file_name": "3.png", "id": "498095798124042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003229_498095801457375_3629357227774897069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyYY9d1a8-gQ7kNvwEKDWS9&_nc_oc=AdqSQb0WOAzBwRm8K2KmkgMJzzWQY9M24TvgjEdr0jnz_GYQWafViyq_LeEK2e0VJwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_60w1LH1j_l7O8J_lpUbVgkF-oiJUuFjIdzHgN0atNmw&oe=6A3FEAAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_2560_1440.png", "id": "457596205652723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395601_457596208986056_7544284973903613144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZunxSbWJpAQ7kNvwFSmKma&_nc_oc=AdoSLfU79sRV4BRJBYGFXtTwI-w2_yLZuRj67GOD2oRhQe3pAdUbFGMafG2P2Lg5j98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t8LxMk_93djHs8QnD0XHdsTKLQroskTaPKvz8wS5TOQ&oe=6A3FEAFC"}, "display_name": "Balloon Gunner", "keywords": [], "long_description": "The islands of your Empire have been invaded, and only you and your war balloon can save them!!\n\nFly your war balloon through an array of different missions and enemies. Use cannons, missiles and bombs to blast and pop your way to victory!\n\nFeatures:\n* Simple, fun, addictive gameplay - just point and shoot!\n* 40 varied and challenging levels.\n* A wide range of enemy/target types, including 10 aerial adversaries.\n* Play seated, standing, or however you like.\n* Tiny file size!\n\nBEFORE YOU PLAY:\n* Note that you steer using the Oculus controller (the right by default), not by turning your head.\n* If you're left-handed, you can switch to the left controller in Options.\n", "short_description": "A fun, retro shoot-'em-up with a steampunk flavor.  Back-to-basics blasting!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "638201004112795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982471_2925810904299136_2610069433355378646_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8lcxbqqkW0Q7kNvwEdteUz&_nc_oc=AdpQ8mCr91eUn5Mf8wX8cgE9H1gPBKmgodG27geO4PjzVRLPbhHC3QDeetaP1a_7zyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bqfa3t3M5lxIfIeqkWJMJAnDX9dv3dViOodBhkzmO3A&oe=6A3FF23F"}, "is_concept": false, "is
eF0WS3-iQ&oe=6ABD071E"}, {"file_name": "44.png", "id": "2108356753434456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507829686_2108356756767789_3722873528786971902_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSbnfAMIOiQQ7kNvwFPskMJ&_nc_oc=AdpV0e_RzQLA5Q1HyCzqwA3ViFb1fWcvisXX8F_GHBsepLpFXZlCgHDig0TtTE3b9fQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtpqq8mSxqdNcY20ZJ61dbPEMUW6_mYD5fGH5LngGruA&oe=6ABD24C4"}, {"file_name": "22.png", "id": "2014341215954592", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307931_2014341219287925_4409174743214520330_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_CS9krOcVAQ7kNvwHMAEvP&_nc_oc=AdpjR8sfQQxkX7H_dWBifx0p4YWt_H3hoIuu5Ct5k2vxSlwaVhMdRbdFo4TxtrlrCrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ0yz-DJk_c3FhJrCRld4naJLWerRrplwmGFtogB6AIg&oe=6ABD1B63"}, {"file_name": "55.png", "id": "4324891214394151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_4324891217727484_8417219863437327099_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmB8Z-IFxHUQ7kNvwFhRa2e&_nc_oc=AdpxC5LA1Ar-34oXpVIkfZ9vcMOStd6pQP2UBTINWEp5yT1yngck9CGd3NHF_ZqWfYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxv07zfG0DpNxbn941giTkUFF8TtWCEc5Bfkndmv0-8A&oe=6ABD2E39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Craft Racing", "keywords": ["block", "craft", "kart", "car", "beach"], "long_description": "Block Craft Racing is a voxel-style, arcade kart racer built for Meta Quest. Race blocky karts through three vibrant worlds \u2013 sunny beach, icy tundra, and fiery lava \u2013 all rendered in charming low-poly, block-style visuals. Collect coins to upgrade and unlock dozens of toy cars, and master drift boosts and tricks on wildly customizable tracks. With simple pick-up-and-play controls and progressively challenging time-trial cups, every player can enjoy Block Craft Racing\u2019s fast-paced fun.\n\n\ud83d\ude80 [CALL TO ACTION: Race now! Jump into the driver\u2019s seat and blast off!] Our physics-based karting engine delivers satisfying drift mechanics and speed boosts. Swerve around corners and launch over ramps: try the Ice Drift Challenge or conquer a volcano loop in the Lava Speedway. With each victory you\u2019ll earn coins to upgrade wheels, engines and skins \u2013 personalize your ride and show off at the finish line!\n\n\ud83c\udfc1 Multiple Modes: Play solo in Time Trial, Cup Racing, and Track Builder modes. (Note: single-player only.) Use the in-game editor to craft your own stunt tracks from modular pieces, then race them right away. Place loops, ramps, and wall-rides anywhere: if you can imagine it, you can drive it! Save and replay your creations or challenge yourself on the built-in courses.\n\n\ud83c\udfae Kid-Friendly Arcade Action: Block Craft Racing features cartoonish block graphics (think LEGO-like scenery, without any branded names). It\u2019s accessible to families and fun-loving gamers alike.", "short_description": "Drift blocky karts through ice, beach & lava tracks \u2013 unlock cars and race!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"],
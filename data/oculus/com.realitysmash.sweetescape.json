culuscdn.com&oh=00_Afvwlonec04e59KJthDEycZK9gZ2UW9nPobIWgFTh80luA&oe=69A6BEF5"}, {"file_name": "sevr_scrn_0003_pic3.png", "id": "351553246973743", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMsiqZOPPo0Q7kNvwE29_eB&_nc_oc=AdkuhHo837swD1eC-ePqKcgtiVlzVH1_UcyrocSPGvcyeWVCo_zAtM4EE_8d1jgojEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshHTDgdcNS_JCU1mx3OjgIsZmHiAqEkjslZYoJwJlGCg&oe=69A6F233"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1BNsU8CWaIQ7kNvwFvQKkG&_nc_oc=AdnP7eBFgC7hbaB2tPLIHwQMF6M-pzTKQc2OCGXx89J8CBmVKqn_youlaprRGCu5q-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftuTBTKb3n1dGApUluz810Uxuf_avlwDrIsU8Dk3vHsdg&oe=69A6DAA1"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Kx2lrVWbc4Q7kNvwH_PZZK&_nc_oc=AdnjU9Epxj8XISgGXOoOvkCP9BhL4eQ0jBukJtuY5rPUd_xcbGFgMenLzs4tQQXJSJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttoFCbXG3yo9UXlUkZArIIpG04oHyxytOWdinN2UGEvA&oe=69A6EAD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mi6W1AUhRd0Q7kNvwFPVk-Q&_nc_oc=AdkATcrmBoLnjMpNkLE3DPzOxYL-Wg4WhB-bXWGFRWP7yYbG5DtXpW_iPZ-H449RNpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUojxeoVIlkkVsA73JlaJLw9gAYz-THjjO5GFhBuTLZg&oe=69A6D609"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9543703155
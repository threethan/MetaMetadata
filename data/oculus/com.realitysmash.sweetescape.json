oc=AdoLSTSPDaSPqB8LOgHad9HsuGR5gwbTjkRlJ9ASMn-zSVG4GUaodi0jIrGh8Gb9bwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbF98_3ODKn_1Ap2rCb7OS3QcMjCNOSVdg8OwqKf3jcA&oe=6A7C51F5"}, {"file_name": "sevr_scrn_0003_pic3.png", "id": "351553246973743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lLgpg46YBoQ7kNvwGc9CQQ&_nc_oc=AdqISv8SH2dvYnPrLgATGVuMVYRIvrgqY4lL8oiDS9iLqLy6wvSrBZXYPjStuY2W5k4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDDJYYAwjZGpGpvwmnr4lWmBYsiP7xYIAEPZKDeIGZgw&oe=6A7C4CF3"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrqysl_NxMIQ7kNvwEt2wKG&_nc_oc=Adow9zTGf8HqPOSpupDF4PmlIHCwnjT8QFU65g01bJcyl8G_61j_J7B1sLikRJDxhxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3UXr9X6tSnoZ0z5ls7qHDcs-zvcqRpARJHtp5hvcCyA&oe=6A7C6DA1"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz8omuoqAHkQ7kNvwEsFsz2&_nc_oc=Adr1OZiW84lVKEGMlfgjx1O2yGVUkndshgfi3vcjXDmV9ahIe3fLCAUNTHf_bKfNj0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMf0IhkMl7vSMoTpPlcMoDVn4nCmBhYJSXiqHyCle-DA&oe=6A7C7DD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5jUSXLFKZYQ7kNvwFGyD4J&_nc_oc=AdpOpQkRz942nLquFP8AuKD_B4y8xE11Dwk-JwPkgFoKcoIvYM7o-XNvk06GeRkCpN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQeGkl32KkERAIm9iPLke4_xYaS65UMQw4segZ2MChiA&oe=6A7C6909"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
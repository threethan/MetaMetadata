oc=Adpv2wdEPHNUECMHgf5tGzNxVsIY4fHdA7cnvlgEhH2TtjVVUae9cAOTLmChdPBQfOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTld83ol9AxbzXkxR0OfGtPffbmu7cfbFFIBapDixGimg&oe=6AF482B5"}, {"file_name": "sevr_scrn_0003_pic3.png", "id": "351553246973743", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWZWFgnace0Q7kNvwEBy5rb&_nc_oc=Adp3nyQ3emf5IU7Lj_dUlbfZTMOuwE4PWI21-IjruSu1OYgu4_amjCAD8ZCw4wbcsUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFEFNLRLdSjKkuavic1-A7K1m6znE-9oT_dFiv7HFI6g&oe=6AF47DB3"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGnRIT-XfqUQ7kNvwHjxgbe&_nc_oc=AdoBxPLl4j2ex7hFOu5pv5QPmu4nzoutKiJLM7LolJETfSvOQ4q20BhTt6vRAcHL0pE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsmebVVIbEx3UX8lPZjhEphK6Spv9ew8CPx1SYXG00SA&oe=6AF49E61"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rMQZ8qJjZ0Q7kNvwGCW8Uv&_nc_oc=AdrUO1Rd8AON-aUbH6iFZDXiPhb83YMx0w3K06aT5O0qbkLl_suFcRkm9L9k6U2TFtU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsWJmq0DaEsU0JOTzgQzsdjBCXima1RnKDpQajQHcK9w&oe=6AF47651"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BMVtXdOw2EQ7kNvwGTH0sK&_nc_oc=Adr97pKU5sdj9wJCQB_VN6K5DOb2HFU9vbVMwLDoq-l6npvOtQDHMv4eU8Fzu3WZ_lU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHPD84W8Kezb2Ag0c8jLhpIJ5LzE6-KXyS4flJRXmw6w&oe=6AF499C9"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
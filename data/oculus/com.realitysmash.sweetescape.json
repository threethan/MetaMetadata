oc=AdoQjxb6PD2uTrZCglZKwSEKhELDSx908TQxnIg8KP-Zmk6q6WTRV-DHUn6FhfxXXJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqfA8qqPbbbOcRTneRgum1ByG0-9nK7qn2v7u_5KArww&oe=6AC11835"}, {"file_name": "sevr_scrn_0003_pic3.png", "id": "351553246973743", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvXz6k_NjZQQ7kNvwHsHKM6&_nc_oc=AdqAqMTySqTUPL5Bk-kJvAl3vj4xiSh_3c-6hoMJe8einn3cmLEkrNpZJlxlc4_rD3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH-cWAAb5WXRm_9uyZezDLPYgZTy7Eg3lb8lku5GrIyw&oe=6AC11333"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cY-jUMBNhk4Q7kNvwErLNiL&_nc_oc=AdpQFHeGHyO60Y_VUJ6ykItutpTebBlkZvZ0FqJEbt7BmvkUKQrQcTp38uDeDFYZtOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq_0bKce4SoMoB8LYm64Y9EdwI9E5Pcm2eY8eFe9oo0A&oe=6AC133E1"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CumrvTEuTdEQ7kNvwG4Rjia&_nc_oc=Ado2VQfPAatwo2khIu6Q5uRzUOxB6j54-HGBqOVnmD2bYEVCPNAC5wqbE9MuxMh986k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnH_5V3u8qV1dpfPGhjCoOIDVsZoZoP8g7qAWY5pRnBg&oe=6AC10BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxWDHKqknPoQ7kNvwEFSbYx&_nc_oc=Adq4Zvez11aUwdNK57ipAFlGEiapBAEbDHYy7_I0VF1QFNtTfkTqTsoDdD0ghyiKIMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeRIlH_7VwBnHSj1T8hl4U6FyRUvRm-TT0MLRBI4UzaA&oe=6AC12F49"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
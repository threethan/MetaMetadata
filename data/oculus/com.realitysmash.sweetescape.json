/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBAcgjqAIMkQ7kNvwEXy7Sd&_nc_oc=AdpB3uWJs5VWRBLScIXRU5BfXFJ_OsqG_SiuPHjhCJVZydzobd3Kh49JX6DAp9YQ68I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rSW9M43AwHFnDsVxg18lYQPObqTbk7ndIu2PfBASieA&oe=69DCFFB3"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTKIZllzLJ0Q7kNvwE0oT6h&_nc_oc=Adpl4dCQ2A0sch6ylNkbFap1hy4ryFJZ-pAPNqBPQQO74Yz06Y7OgsWmzry0T1texg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DWnEq3bCYcr8NaYly0n09d7bdgahzti73O0x9F_2Teg&oe=69DCE821"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8d4gqMJXIYQ7kNvwEMHZoT&_nc_oc=AdqG6-Be0yFxbtvEJZEGmL_D0X2-ljssk7jaQfNdBmaFIZignt8YgkkZ5di3R6CgpdM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eZOa1Tfl18Rg3JsWI71tkXLzwXoXFOU22RUh4yhJ0YQ&oe=69DCF851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc4B-7Q64a8Q7kNvwErQ6Sz&_nc_oc=AdqKni4yXypgdNtl7lswfvQL8HpykPuPT9EcPSoCQ4eYzV5mj0ekK2inJEeszC7dqG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04ls5WrYokFaZxt1_bLC8reUJbeygfRSzQgbUciZXuvw&oe=69DCE389"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "717390992749024"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "501268295009531"}]}, "baseline_offer": {"id": "5012682950095
c_oc=AdrgyztvqsOcPOkTa2u7kAXXfdIA_InMQ3JKhmpS0-kza2fpWfPPY5V0qQKKHi1JCk0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1NU-DRS8f__vSwEJWeX5qjCfUfgIxSFYL-fhI8eLbNA&oe=6A7DA375"}, {"file_name": "sevr_scrn_0003_pic3.png", "id": "351553246973743", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lLgpg46YBoQ7kNvwFpDSLE&_nc_oc=AdpHByTfQ2xMP4o5SvEjT-7sT05jdcSXHXVk7KGbNX3vrhbzJk5w5rV38I8Gi76-iPU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM1w4zIFqDbQA6HPpj9MTvjoPBtCFZrcDE5pQmQWOCVw&oe=6A7D9E73"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrqysl_NxMIQ7kNvwFtFQPv&_nc_oc=Adpj11RMGZCOwNLoHlTHkBEDWi5rNwmf_FvqWujThuCUoWIhpKf2qSZXIimc3BrRnmU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER1tbH8zdMjeZz12RvsACC0U1kXLBJxXRcAyCy6Zt1sg&oe=6A7DBF21"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz8omuoqAHkQ7kNvwFSkpaR&_nc_oc=AdpIaBYH1akxouruVmTNoH_BKLXYFQvdJDyr4yjG-yuKPigO3us4wNtI0AVziUngPEE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwxnfPMeehzy1D_CZN9x1WW59bct3d1AuBd29Uo5ERoA&oe=6A7DCF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5jUSXLFKZYQ7kNvwGnmUgG&_nc_oc=Ado1N5uTy7fxbb2GBkN13T3Cs75zn8dpmORMEHybqA1PK-KKEHHXpT6WQC4SxS7qedY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGak9ZVJ9o8W-Sk3ycygDeb771HcrYxX6swZrhPgHC0ow&oe=6A7DBA89"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
oc=AdoOmoTAWK4pZXRbNeHf0bb5I2UQ2f0DiBHTHZMFRcVw1o4qZGhB2szL0xLD6PTaOtA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fG63DT1SKIW6SCm2iMyw0N5Qco100QQc8ac5Lky9zag&oe=6A258735"}, {"file_name": "sevr_scrn_0003_pic3.png", "id": "351553246973743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7VuNxwZv2MQ7kNvwFgMod8&_nc_oc=AdpOo-p7-CEHZxqp5k1fPdNoZGh_PZGRuFlUujcD7D00Opt6F-kRtrbilOMvo-8peFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8was3muncaTXAnoeY5TCeKx4OKy2vXKqdQOmZR2obBPg&oe=6A258233"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7_50s7cB0EQ7kNvwGOIzpL&_nc_oc=Ado2CZO7mHD9ijEV5UzbQHnTCGRvh4Ohm26LJgnShR05F5pnV8Jl7WsyXS13r9Qxb0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e67StOOU3ypQljuwC1QASfKM4IjRRTR_a06aJgDBC6w&oe=6A25A2E1"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hySE7_yYNiAQ7kNvwHe88CA&_nc_oc=Adq8EuHjID3kciEF2LUW_y_MPVa7yecmQpWAUz1OkDIYbG5vYHZf2RffrT8DONf9LV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rDQJztBSQCOevm8DNSJkc--xRWVdKf_IcdGMCQNa8Kg&oe=6A257AD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIslpjTm9-0Q7kNvwFofmp6&_nc_oc=AdrbyrMtuQYFg2jnQWSoKDhetTOzO0tOQ0I0VZnis3xIk5pHcZqvbvWK8CF6RyWf6CU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EIG81e_CzUNQ-RsX2BIEOMStjv7FsoXD6F3sC16U1HA&oe=6A259E49"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
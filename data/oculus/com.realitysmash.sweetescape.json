oc=Adq5iqYA6EeOd07a4KfR9Vlhdg1ScFNG-_7Uf6iliQvF35rnyTmzW7tAKeKQVFTOSU8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqYKaxtdsebmr1ZEzA8qcKl0y7d7IuQujgoY9ArCDWcQ&oe=6A882F75"}, {"file_name": "sevr_scrn_0003_pic3.png", "id": "351553246973743", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ucGo22h_JEQ7kNvwEC-Vq0&_nc_oc=Adq2lJslnYPKDqNXAyA0zMsCeA2nd9AKo83Z5TNgkDR5TXGt_RlXfyEH3Ld8oQJh-Ew&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElpcDEIkFWD1faf3CfCNCy0xXgG8PAyzBH4WBhuAPTew&oe=6A882A73"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHVtR84a450Q7kNvwEw9f8Y&_nc_oc=AdpoULPD_gREm5wA6dfSEC3VVD7f4-VEm2OIYYpSJJey5xcvcA5cmBv7pIXHEiQS_8k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDFjs4oUSfpQG2UN57yo8fkVyHnh7NLwMLec_L80H0DQ&oe=6A884B21"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yVMpsYmQI8Q7kNvwHMcEpT&_nc_oc=AdoE1cemnOv-Femz-CY0PA7BRDUOEkyOTg4hQTuGCpNyMp-7VrooQ4CSTHSrcd0cVc8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnqAnXOpIOTUcK2TWCI5ElfQu5xyPX2QCiCsyirM_HTA&oe=6A882311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKcFtRm5CRMQ7kNvwHcAu4j&_nc_oc=AdqRAN91HqsloCKMB21HImKO38Uxu9F1WgeedXKLJsWCSbg_u9LETfdWaTxV_dEbd8w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3lpldqy599UMiXM-jg3AA-X4dtvPVJM1gbxu_qAI9WQ&oe=6A884689"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
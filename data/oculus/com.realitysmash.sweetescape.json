/v/t64.5771-25/38974629_351553250307076_2549245020728720751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XJ7rOlRI18Q7kNvwGhH5Sa&_nc_oc=AdrUXi_BfDat0FlIZM8e1hT4q7YmOu_PRHt8HNqtHQhHJfEmrl4dj2ypc3QVAZR7qY8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6ibhDpKPigm-VhuXl62DJEYFFLsS6OCgT2VGGb9bPAw&oe=6A300E33"}, {"file_name": "sevr_scrn_0004_pic2.png", "id": "1347057492477104", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974751_1347057495810437_4355619307576092085_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kALnCbprHAQ7kNvwHPNPeM&_nc_oc=AdokC2Jj642WD-T6Qu9fHjc6cwvzgIbzwyRFHJyMH8mifKk2633YLEvoyHYwwVGONug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dnL-krUKbV_ddUJCYMX-NMpicwEAnWbuiqbypmazHTw&oe=6A2FF6A1"}, {"file_name": "sevr_scrn_0002_pic4.png", "id": "3197392223817536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031484_3197392227150869_6455689560338806111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDSIJM2q5TQQ7kNvwGsSf3N&_nc_oc=Adqnz7W6YU6jj0hApAZPK-SkjIwmouI2vTxW-2TN_ckgQIqGhmS1DGbPpLkqDUg1CX8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NBqfBVyhkkw_NWjOMPBA4_nrLO6HiveGXx0ibEqoSQA&oe=6A3006D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031421_1157411304642245_1954904826581793879_n.png", "id": "1938046916369651", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035380_1938046919702984_3695788427288717242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y187l4ar1k8Q7kNvwEGALlx&_nc_oc=Adrq-hu_IU3FjwST_LOJNHQ-IuFB_WwcfOpcI3E6hMKCVf3jGDFxsmLqJYpMaZo1OQU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zczjTadVnvDNSbI_sezAyi-1KPx03xFMDgAiQv603-A&oe=6A2FF209"}, "display_name": "Sweet Escape", "keywords": [], "long_description": "Race against friends and family around the globe in this psychedelic climbing landscape of candy imagination.  Tick tock, time is not on your side!  Utilize your agility and master your fear of heights as you swing from licorice vines, climb over tricky candybar obstacles, and launch yourself over great distances onto narrow targets.  This delicious race will sling you up to lofy summits, so brace yourself because the sensation of falling from dizzying heights is real!  First one to the finish line wins, but beware: one bad slip could be your end...and you definitely don't want to be last!  Survive to tell the tale and make the ultimate choice - party or death!", "short_description": "You and your friends are fighting to escape this treacherous candy land. Reach the lollipop to win in this active VR game experience. Climb chewy gumdrops, monkeybar over great heights, jump from candy bar to candy bar, and be careful not to lose your grip. Falling to your doom is a real sensation; your survival is in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sweetescapevr.com/privacy", "developer_terms_of_service_url": "https://www.sweetescapevr.com/terms-of-service", "publisher_name": "Reality Smash", "support_website_url": null, "website_url": "http://www.sweetescapevr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "717390992749024"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "501268295009531"}]}, "baseline_offer": {"id": "5012682950095
DaIr7JK2h5Ck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrcpg73Qyl4lpbwRGQm6OEvsfUNdzrWO39YG980ef5MA&oe=6A9FFB01"}, {"file_name": "1.png", "id": "1625841816207709", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303088_1625841819541042_7021605490419568820_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZafCYAhZaqIQ7kNvwEQ9ZcF&_nc_oc=AdrcpmvfOzqLrGijuMEMmgUpWQ68EzIdHY-T1L5XTvc1ZfsrNZmfPOcZ5rl08dBS-fs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg5AjjZ8RKoYVTFcPMSaJa9cdrSCLbYKxb7kq-aAGxtA&oe=6AA02428"}, {"file_name": "2.png", "id": "2239668036784358", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299093_2239668040117691_5915859360929408677_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUAVRdyeW_gQ7kNvwEwlZOr&_nc_oc=AdrunpbeHAyLXnghGBmyxJvB0qDLzWpDeFEg4WsXygRqvIYdQhH_17FDMXTEACc2v90&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTKwQsngZCFqxblcLi6ldHqAtlo4VZBhT7D--ySyaaOA&oe=6AA021C5"}, {"file_name": "5.png", "id": "1058757553279611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308522_1058757556612944_4989102164441196340_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pPMtIASomQQ7kNvwFTBs1a&_nc_oc=Adr1I65gd8Icjmc2LOc1O3rESxB7p4gLG_Z9juE6LvwKJ-Q4U7jZb9MVgJlNzHfdOLE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyqMMljVNxKSrxoSGeeAs8mg9awfyTrQAhMoc1lhR5dw&oe=6A9FFB2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "miniatura.png", "id": "984353717954984", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298329_984353721288317_507333395913168836_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGcnXDArTaQQ7kNvwGagDYi&_nc_oc=AdqvQgOATbHZL4Pj2br0ut3OgM-CrNink44bXvG5lhHT1sYM_qmXhTCFfgPIp2CD0Z8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAL4PMZil0Il15iRaXv9SBIMIejKv9XnZ8NvbJxD4l3g&oe=6AA02DCA"}, "display_name": "P\u00e1sele Joven", "keywords": ["Casual", "Simulaci\u00f3n", "Mexicano", "Cocina", "Comedia"], "long_description": "P\u00e1sele Joven: Taquer\u00eda en VR\n\nPonte el visor y \u00e1monos a armar la taquiza. En P\u00e1sele Joven eres t\u00fa detr\u00e1s de tu propio puesto de tacos mexicano: cortas la carne del trompo, calientas rico la tortillita, mueles la salsa en el molcajete con el tejolote, armas el taquito y lo entregas antes de que al cliente se le vayan las cabras al monte.\n\nTres tacos, dos tipos de tortilla\n\nTaco al pastor \u2014 tortilla de ma\u00edz con carnita al pastor\nTaco de chorizo \u2014 tortilla de ma\u00edz con choricito\nTaco \u00e1rabe \u2014 tortilla de harina para la carnita \u00e1rabe\n\nS\u00ed importa qu\u00e9 tortilla usas. Si sirves un pastor en tortilla de harina, el plato se rechaza al entregarlo, tampoco vayas a olvidar el limoncito pa' que amarre chido si no, no es taquito, a poco no carnal?\n\nEl molcajete y las salsas\n\nEstaci\u00f3n fija de molcajete con tejolote. Le metes los ingredientes al molcajete y mueles moviendo el tejolote con tus manos. Puedes hacer dos tipos de salsita:\n\nSalsa roja: jitomate + chiles + cebolla + ajo + sal\nSalsa verde: tomates verdes + chiles + cebolla + ajo + cilantro + sal\n\nSirve la salsita con la cuchara, t\u00f3mala, ac\u00e9rcala al molcajete y sirve en los taquitos preparados. Si metes ingredientes que no cuadran con ninguna receta, se pierden as\u00ed como tu tiempo manito.\n\nDos modos de juego\n\nModo Infinito: nunca termina. Ideal para meterse a hacer taquitos sin presiones.\n\nModo Vidas \u2014 empiezas con 3 vidas. Cada cliente que se va sin comer te quita una. Al llegar a cero, pierdes mi chavo.\n\n", "short_description": "Prepara esos trompos, en P\u00e1sele Joven eres el taquero de una aut\u00e9ntica taquer\u00eda mexicana en realidad virtual. Corta limoncito, asa chiles pa' la salsita, sirve y muele con el molcajete, atiende clientes cada vez m\u00e1s impacientes antes de que terminen hasta la madre y se vayan. \n\nUn juego VR con coraz\u00f3n y humor mexicano con mec\u00e1nicas que te pondr\u00e1n a parir chayotes. \u00bfAguantar\u00e1s las 30 rondas del modo vidas? No la vayas a regar. \n\n\u00a1P\u00e1sele joven, hasta se le va a antojar! C\u00f3mo fregados no."}, {"images": {"nodes": [{"file_name": "pdp.png", "id": "2233559677442167", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299789_2233559680775500_4145254037594790244_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zrskj-2lM90Q7kNvwEcyzEP&_nc_oc=Adpfz5NAiplqtpk2-5O5zDmKFH015LOcNQh3c1DoIy_vjL-NSJjtkrUHKlDMkvrfKQc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcOkKmJUg-Up8ZOTRjxVKoJqynQp6gubLyJae9f3mxtg&oe=6AA018FA"}, {"file_name": "1008.png", "id": "1657259885349174", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300575_1657259888682507_14085124883098122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o40CG4pSvhcQ7kNvwFVqm7B&_nc_oc=Adr2KRJENzqnGFPbp66h8oBxU-vD7LO4hvo9tWPejB4QRryq8gXEDbuXQZmG8_AewTc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2wsdS4dODadBtmNK0PIvD2b3ccKLo0sTUVPKWmJ90Ig&oe=6AA0035F"}, {"file_name": "logoPaseleJovenFondo.png", "id": "1324704236501951", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499293803_1324704239835284_7402344440573107947_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apTUqEecG1MQ7kNvwH5lC-Y&_nc_oc=Ado621oFTRL_ech0VLaCA6J5ierrZVlRKvogNTtERtrAIAubCRvpP5ATLUPRd-dY6F0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiWIxyVaD1r8fjtl9YSiiwYEiXseecB-pDD96fKXptBg&oe=6AA013A2"}, {"file_name": "1440.png", "id": "1317870543429194", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298451_1317870546762527_5633672816272689729_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjimgVPZY28Q7kNvwHh8ibU&_nc_oc=AdoESCx8_KbH3EaLZ4Ae0MZlDQYoNudoOl8an9f2YiGEsHLJKlPpg
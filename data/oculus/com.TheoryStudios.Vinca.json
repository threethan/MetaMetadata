102558466176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q01uvSuRaLAQ7kNvwFioctG&_nc_oc=AdqsrzJ0IsIRZ2Mof2hm4S2RAcfk3VN2mNqIywDvdIthFlUQZT3CvHuUq_9sgoo1nZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBicaY1yLMtPeQ1TqJJCeZpoOj_zSfWcaMgWTrlla-5A&oe=6AC2719D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J28zQTOUDLsQ7kNvwHl7kBW&_nc_oc=Adrb5oarPXvTBuBp1spSToRYJVPT3GZxn2exPJSptnikWC9i0XYSz2UBce4AMTE5RoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTAXxzYKHnkcpy6q2iYNfJcIq00UR-a4ryXaPUeRdloA&oe=6AC27C3A"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yzq2c0GEwsQ7kNvwHTFYl_&_nc_oc=AdqRKXpp7TpYAFYke73iVVvdZym_J0vM5pa3CN_JT17i0lIJa4or9gjnZhFWCCHi5Ak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs4kZKggUBTJGO9ra9x8RH5qDJ3ZWGLeqGI2MN0ZzuPQ&oe=6AC2513D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "2243816689452785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294650_2243816692786118_4170064839917832017_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcGB2I0h-fUQ7kNvwEiNGCq&_nc_oc=AdojTuGdtn4J8iBHlx-elnNWnAqtkKb81x0v8VbDCkiH-VpaPH7bE2qTz_21z1fnfFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVHkmtuG1lvMcdKfY6GATIF5joFPwtSEXdKgvQsL5biw&oe=6AC27ABD"}, "display_name": "Tend with Friends", "keywords": ["garden", "cozy", "plants", "simulation", "relaxing"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is a welcoming, magical gardening game for the creative and curious, offering a comfortable, seated MR experience where you solve beautiful 5-minute plant puzzles to turn your room into an enchanted garden. \ud83e\udeb4\n\nFeatures:\n- Real-time Animated Plant Growth \ud83e\udd40\n- Unique Needs to Solve for each Flower \ud83e\udde9\n- Multiple Pots for Plants \ud83e\udeb4\n- Crossbreeding to Discover \ud83c\udf38\n- Hand tracking & Controller support \ud83d\udc4b\n- Custom Soundtracks & Hand Painted Backgrounds \ud83c\udfa8\n\nYour garden is awaits."}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24481833244826611"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2289092554910449"}]}, "baseline_offer": {"id": "2289092554910449"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769104800, "status": "PUBLISHED", "id": "2289092554910449"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25060529463623650", "version": "1.1.4"}, "id": "1070114181481322", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7966469973456199", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25060529463623650"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780712929, "id": "26161041050239147"
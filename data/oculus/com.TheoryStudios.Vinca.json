cdn.com&oh=00_AfvjdJ1KNqTzu0Cn-RoLJ5-ZfWC-O5Jk2q5jvSK7qrG7IQ&oe=69A02C66"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T77iZE1OPPgQ7kNvwEEekAN&_nc_oc=AdkYcpQ_qxQnr-tjR2jrd8aKrPhVfAcFyjtxYulStM6YwoQ_n2kpFwvnunEghflaT8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5ivmqzQDaEXk6EDRym6V3APaaTNjVKwjOvTD64OAkoA&oe=69A02F5D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfGOBivNKqYQ7kNvwGKka-l&_nc_oc=Adk4TJP8YNKrhM6ysO1NuQY3bDoqEJ9hNr5rScYutvG3msacYmCIH3kYp2pv_6zcpvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKf4oxm7f7ol6pYkr9i44wiKw5p_lcySPxxCEbTXY4yg&oe=69A039FA"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgHOnT_idJAQ7kNvwF_xtXx&_nc_oc=AdmjadJZmyim9Xt5wRNqTkzuLv8idR-H5xFtVOVdrhFZtVS9L7saTa_I3qxP9j-ejeY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRELy2BJFO7hhJLLiHepoEEFYCoasoLQeFaD8Q4nPbCQ&oe=69A0473D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We6LHYLfSdoQ7kNvwFNYJBn&_nc_oc=AdkyAOkLWwUCKhZV5tYoG9P5izBro-12l-NkvL1_nQkAeFF9ZmrGLRF-wR9nhpwWs-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6qYcP8t_0nNGJ_PHlmz5xbUEVPzPKsTSU7KrX4P1k8w&oe=69A03210"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE
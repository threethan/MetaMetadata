102558466176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVqmSDqCTJgQ7kNvwEN7GZq&_nc_oc=AdohqB-vj56sJ1JBaBa--M914MRCY8E39BJ2iZAiiw81CQ9wPVZGyviJRd8U7ZIMKU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExQk-hJmbbLGYeYRubKmkO3mCPsMaa5QG667clgmb3hA&oe=6A7EFCDD"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdOO4PxpjmcQ7kNvwH6com5&_nc_oc=AdrE0eqbkKCeNd5lyLyHhqHMvTrK0ve_kJOKO-4oliFGBhvL1uOMYmR8YvXJtuSVtRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAQ-3knyxwep2zRGkWfA_X1N8GPnfyyITNGa3N8aO1NA&oe=6A7F077A"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AT_wn_cjQIQ7kNvwFBBAAn&_nc_oc=AdrsHCSR73EKyVnsY3z7s5_5uFS8dsLZLBMod52XMoJGTvrqjr7efHUF9-DkW0sc86s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXpiabSZtxYFoBCQzegQh-ICeEi-mA8JYUnODbH1Ej7Q&oe=6A7F14BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "2243816689452785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294650_2243816692786118_4170064839917832017_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UedfzKyvvAQ7kNvwE98XPt&_nc_oc=AdrmOu13KEOD5ZHS2_rdlJnpEG8POLkZiYpmKgDunsC7sbSMjuuTG2itTqvHW2oTFn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA6ZV5tNTLCq9nmOWwQsMg8sXzWxDKJrzGs3dVafDX0Q&oe=6A7F05FD"}, "display_name": "Tend with Friends", "keywords": ["garden", "cozy", "plants", "simulation", "relaxing"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is a welcoming, magical gardening game for the creative and curious, offering a comfortable, seated MR experience where you solve beautiful 5-minute plant puzzles to turn your room into an enchanted garden. \ud83e\udeb4\n\nFeatures:\n- Real-time Animated Plant Growth \ud83e\udd40\n- Unique Needs to Solve for each Flower \ud83e\udde9\n- Multiple Pots for Plants \ud83e\udeb4\n- Crossbreeding to Discover \ud83c\udf38\n- Hand tracking & Controller support \ud83d\udc4b\n- Custom Soundtracks & Hand Painted Backgrounds \ud83c\udfa8\n\nYour garden is awaits."}]}, "developer_name": "Theory Stud
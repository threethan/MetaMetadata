cdn.com&oh=00_Afu_mIrXMfjIA1Q4df6BqxCFEu394faSTAjTJco7SrlKAA&oe=699EDAE6"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6eVeMFfmigQ7kNvwFRkqZU&_nc_oc=Adn1856p0GGVcYGf73yh16nwb7isVDlv19n_70EhsP3jASNRi8ywZQVcdLIORL0wSl4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsylaK0VcdeQGO6oIsNvQumC_CcT-0p3eIwmfV8_zZtPA&oe=699EDDDD"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jVdWiYfd7sQ7kNvwE5yv1n&_nc_oc=AdmXwli-JaT4VbWucZwBj-YUraKr0ifoBbuZDKUfghEC1ioEWADMH13frBa00KS-DBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afss7ZR2uNDB9Uh6v1nCRk5UgfWZPz9Yo6zrLMgNGP4k8A&oe=699EE87A"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7HLIVTMbREQ7kNvwGlFUWW&_nc_oc=Adk7-xQG7VZRkDOvKjJRVoeNowWi9aMXfiQgX0FnMnIk4XsS-IE6IxypgGCsejB3DIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvXKVfVsvb2m7I6ajS3TdCE9_dyAnHtmhjAcPHgCqZCvA&oe=699EF5BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We6LHYLfSdoQ7kNvwG9CjrN&_nc_oc=AdkwkZ7zu3PTNYFLY_RQC_c6W8UkeVMmTMkFS0XeMXaMO71JaTDE0ZXhSTwCHjYdKtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvzLoDwkspELOV00McKgRRQeSudDrAh6b4kuoZprbJd4A&oe=699EE090"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE
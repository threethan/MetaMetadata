p_rZQC1EnUBnRyWRetjntn3_Y9QIoIMm_RSGgqSVss7gDATeJc3poFbSBnuQiVvAw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00KAUHB2PBy86VQRStF_HlW1wN4Bd3_7x8a-STSuidBQ&oe=69D4E866"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ym1meCTecDMQ7kNvwHU7zFV&_nc_oc=AdoJ1WjqvIC6uVh02LaQDZ6zGhV5zKf53ILLu3EqcJ_2RKyuKewhNF9h3fR8mrFT4n4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qR0SBro__HIgOIpXoDpVDfzlSXeoiRQdEVnZaEEZfog&oe=69D4EB5D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORjUDkyI5MsQ7kNvwEixauN&_nc_oc=AdqDspUi0r1OuXGeCHoY7OC0RyLWH8wWjTE6NAF8vDvM0fxmX8EBaiVG62QDQ1n7AXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KwDquH5Os6-IGpVTt5nXch3ty7ZYkwFdAgM9f0wKHTA&oe=69D4F5FA"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YAKPLyKeK4Q7kNvwH5SV0P&_nc_oc=Adqz35nJQMxQz5BKhe3yWhOw_m6Khie-O3dwxvMvbeSeQ3I0KJDwrcEQX8XOLzOhBVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bk-9JtKtqpeYKPNfaYCUGuv-PPe9QTMltBT6cNgbQSA&oe=69D5033D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSF7NagUV_EQ7kNvwEpu-6e&_nc_oc=Adqriddfa-hm-Z4K6RF2ZM6wS8Me2DvdfNHsdMSxWekCK5pmuJfYcjRdHxYAhBWoy1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y7HeKWtCyrEBOxUBbaNr47rCZKOTNnfAOUUKu9pxWpw&oe=69D4EE10"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24926548797021718"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_883546474425269_5446048422473770913_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgX7y86Zi4YQ7kNvwHORD6J&_nc_oc=AdpdLpkuhhj2cE3KR6FGhzNWiQfSlCAXm5Ci57ulLDignt6pZpMS1KyeccRa6A9tYSw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t5gAg___Ty8tTvJzhDIwca6rYeSpDK9D86XyHgSxVTg&oe=69D4E770"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tend with Friends - Garden Sim", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1769104800, "lastRevision": {"nodes": [{"id": "7966470093456187", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7966469973456199", "is_first
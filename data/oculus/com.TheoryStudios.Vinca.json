pyXPGfuXNJClZMrdS13jpAJ7S1zqAdLUbXAYuxZxZ0TSONY5R7FRXaR_SursFCjLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwT4RLp4Zrr9jeAXacXHq-V9WcHLHJf_Qwjo7KQPS9JeQ&oe=69CCFF66"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0tQKDBKLXIQ7kNvwHu38Xb&_nc_oc=AdpJUn4Ds94iWyPNIZOLoXzudPD_pDy-_rHGCxUXiMJ19nwdgL-QgUMo7z__YuY5z5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy01AbcnH92F9XE5FVyJQGBCCDluIRjQCX6K1DshLzy2g&oe=69CD025D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEPZX-9sgHIQ7kNvwGV-l5Q&_nc_oc=AdqqvSrHx2EQF72jmdZrMRoM-dVgVRjzXFyxryIk29X1BcoIzjx6T54Uvzm_e75aE9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIo8_x-J9j_2EyI8yFmBBcPdZndJS6NaxCSjG01WSf8w&oe=69CD0CFA"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RQ28jNw-14Q7kNvwHeO92b&_nc_oc=AdpX1e5jbXDvNffuljJQmDZ8jjFpo6IpZFllc31-DjrKOWgp5GGGTYRIGePD7QI-ZU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOFrgNCJNe0ZStPenKadJj4GlZdVbdoDKa7iYFyBJteg&oe=69CD1A3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iToJjAPJB5gQ7kNvwEECZOg&_nc_oc=AdpPZiGtPqdmzc5tl9mavxzxIfl2hVC17zTJAD4AEAvyqN4hFunKsUdroDE7oapyW9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDqaA0fc-vN_8sjn6vrnykSMFTVdap6v08FoEyOUUxBQ&oe=69CD0510"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24926548797021718"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619518_883546474425269_5446048422473770913_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wVoR0eYEIkQ7kNvwH33ViZ&_nc_oc=AdoTo8RYu42TZtOF2QIKXsZuiFMB8IkF7Rm1qr_MStWrWLDa0kyRgMaMaVw_OPss16k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz44HNMaUtYUGQ_5QD1TJlZFfmEqB2QSCom6dCsANN1Tw&oe=69CCFE70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tend with Friends - Garden Sim", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1769104800, "lastRevision": {"nodes": [{"id": "7966470093456187", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7966469973456199", "is_first
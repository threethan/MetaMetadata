_nc_ss=7f20f&oh=00_AQFhCUSkiHlDXYRZ70aUZHVxdc5nnwRhBZ7S4cNQC-rBww&oe=6A8442DD"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XDierngdtMQ7kNvwGxBge8&_nc_oc=AdrspNwMh0KN9UzjA2JIrWaMgPoL5pUrsyY5T8gNfyq-qS2MGxK-N_huEyKWW9AUKM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEn8iEmpjFixUuOZnmagTmvaaBlNTQrwPeOyAuewXY_g&oe=6A844D7A"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ZNyORS0WMQ7kNvwEBo8FF&_nc_oc=AdrqWg9Oqx5JqXlArVCCnIzW5wL9S2FCnCcMhnVjnzZt_Jin5naBqPaFPz7OcBN4KKM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOc0YdnKYc8bo24Si8zc-fr0WM_4Qb58GV4nshZO0vqg&oe=6A845ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "826081647249352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302527_826081650582685_3469544336685241289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5t8OMtPJosQ7kNvwFfs1re&_nc_oc=AdqNyqI0eBR3Q3nr9BXhAc3sbo8NzTx4xeQFOqDURDoVFSaSY3DdJPBsMrkWBVaRodg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxK-Lu-o_Eb0Et6G08qBfQcjydoiYamxLlavPbRKi8ZA&oe=6A8445D9"}, "display_name": "Garden Tend", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Garden Tend** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Garden Tend**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Garden Tend is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://gardentendgame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://gardentendgame.com/support", "website_url": "http://gardentendgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
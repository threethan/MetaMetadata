102558466176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0mRbPOqb8MQ7kNvwGAZm-U&_nc_oc=Adpo9aYT7dQu5SxHOr5w91pMSr2qNHxIGtrHteWx4ruhR4OvjwRYDz6JQWwbMpjv2vI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUf5s-xsBWkWK0o4pFP4HfJL4uUifbXQ08FGo0TDj6GA&oe=6ABD2B9D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-CQZQDdvpgQ7kNvwGZOyen&_nc_oc=AdpRsZ6TgA-IB_Z7iNWmzJpX2OwEofKME-AzfYe3Fvnmk_tpz0oWQ2DtfCcIzMJ89p8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfp0MpB7yAcCWFv_hXNQR3Hbh4V74jJbj5vuHGuvc7Gw&oe=6ABD363A"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dse11UWNDBMQ7kNvwH_bBdh&_nc_oc=AdqnxPoCoz_C0UdHJ7uHNqGCF9UsuuLhcIW8zt9aVckJB0h4mzcl3pwZHMA50U32SsY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjVJNW6Cn9C9JrUI4lHfYO6xFF1F89SLIxEbiSVz4byA&oe=6ABD0B3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "2243816689452785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294650_2243816692786118_4170064839917832017_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rF3v6tN44EQ7kNvwECyDCb&_nc_oc=Adq-eAZtB9v5b5zEkTxRqPaBUAXZGA_46XA2qBzABzpxtdlWJ304KIiZjV4vSI15eko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR3poJC-B34Vcj7BFbrZeCa0Mm36YSC5BUGmp_eSCQGA&oe=6ABD34BD"}, "display_name": "Tend with Friends", "keywords": ["garden", "cozy", "plants", "simulation", "relaxing"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is a welcoming, magical gardening game for the creative and curious, offering a comfortable, seated MR experience where you solve beautiful 5-minute plant puzzles to turn your room into an enchanted garden. \ud83e\udeb4\n\nFeatures:\n- Real-time Animated Plant Growth \ud83e\udd40\n- Unique Needs to Solve for each Flower \ud83e\udde9\n- Multiple Pots for Plants \ud83e\udeb4\n- Crossbreeding to Discover \ud83c\udf38\n- Hand tracking & Controller support \ud83d\udc4b\n- Custom Soundtracks & Hand Painted Backgrounds \ud83c\udfa8\n\nYour garden is awaits."}]}, "developer_name": "Theory Stud
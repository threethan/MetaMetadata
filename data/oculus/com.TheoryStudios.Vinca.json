cdn.com&oh=00_AfuqANC6Sf_wqnoNsBr9bQzDW-USTXIoLsMW4DRflXLQqQ&oe=699AE666"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhl61zkd3rMQ7kNvwHdTHnz&_nc_oc=Adkj_mAZOfMkG4APxNWiS3GrZ9UK5O2hHX9kFEzDA9GOL40720v6AeA0r7YplavMlVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftQR0j0j8hZBPo6aJYWeHbfDWI1Sxtr05d3QRwdQdAJpQ&oe=699AE95D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah_LT-GBdkoQ7kNvwF2-CNe&_nc_oc=AdmPk7D7KeJJ4izQX24Ji06DDOG7Irw58gDNdSyQ_R1xBulZtBxk4a1lmA0vPW7NHxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuyOCFDTQbi1WuBESLuMxlHmlmly5KbTYpMsU2bV6RGJg&oe=699AF3FA"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-WYxg5j17UQ7kNvwH6eIdG&_nc_oc=AdmyoyQ01w9FE6Ykgft6z7o6jtenkTet1vd3HlxMCtGT_K_mgMcMsNQ2leXlBHqC0J0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvBjPv8PEwtW4Zr1aw9IBCUL31v0s1G6FH3mMrEPdCPcQ&oe=699B013D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2Ucn4z12o4Q7kNvwGqT-AS&_nc_oc=AdnMf47_LHYgne4IjF8ZPp8YFJckDPtOoD_dT3nRFxX-n6uZXaU-c-8prjaHrSV1oP4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvYSLDwt7K500vQ5OT9gibruzxTpc9gM7NZARnz1FCj5w&oe=699AEC10"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE
_nc_ss=7f20f&oh=00_AQHRQaKspaM23H1v1yES1THzTpBUoOhFVs3ROr7e3nTD7w&oe=6A8C2BDD"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc8ZxA2sMyYQ7kNvwHVxH2R&_nc_oc=AdpLnEEogKdKZ4ZCf7ENIfr7zxkYePxDKO9Hd9MojdVtkME3e0hKBSlidms8_aaweEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs4v6soHh1Ud2Jp1prWXVcUK8RRVDwL2KABYX_mp1U1A&oe=6A8C367A"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muoTAN7JB9QQ7kNvwFJVs0x&_nc_oc=Adp-ybtPFL6pfg6mHaHzqo3hQuJdm4eo7ObKHRLBx2FuIVksyzHWHaKIHuepIrBzL8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNASYvi76U5IGh_YAy5PkVRBLR858U3GUe6KjUDxEqwQ&oe=6A8C43BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "826081647249352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302527_826081650582685_3469544336685241289_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtmGUP4pjmAQ7kNvwFvD6wM&_nc_oc=AdphN-s324ywqfLn10tZjHfyiQnRfZMQcuy8CzRLr6dMmdBujXSfVaXhRu75w3dfSKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFONVJwyPmCNo57TTmZXUAvAnAs41P8VYNMmie90IhrsA&oe=6A8C2ED9"}, "display_name": "Garden Tend", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Garden Tend** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Garden Tend**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Garden Tend is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://gardentendgame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://gardentendgame.com/support", "website_url": "http://gardentendgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
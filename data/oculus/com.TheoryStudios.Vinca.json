_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OsULBr2wLzR8vW1NA-5WKWQLEZGYsnrU81az8QiqDkQ&oe=69F1E966"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnE72eY77MEQ7kNvwGfm6DZ&_nc_oc=Adq8dC3enGIwNfCv1x81i-AarrGj0xhOW9qzFwCS3pqAQIRUetVcR20hsWpxXAOhhEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0E9NmLHLCGnE6NAEAYCrNnd53sKnIda-nCmLqY9JLsig&oe=69F1EC5D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIaaY7D57R0Q7kNvwFFkyqS&_nc_oc=AdonjTna-NCo-BBmYcDlFkBVZdV4s6jzxlsMCGHM1TaN35baVmGZ55QEOPQhqZu4hZ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1zvislzB0H2a7tGE4U5UXoAxzw2wcUP69ZbkN37Uab8w&oe=69F1F6FA"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_5k2tWXzHcQ7kNvwHfavHV&_nc_oc=AdpzQPjAk1odDCbWwV4AUnd32vC5agOhhUgWndReZMYzIKc5AfOIOJQ4gBWaWdRiZwM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3pYKFp9wMnti90X1wH_ffIHiHFK6rQUFdLMg2-Un_MoA&oe=69F2043D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG-NszQx_FMQ7kNvwHzh4O9&_nc_oc=Ado6DEL_eIgZ4jBoyVkzXqeVLsXCcKrtpvvW9zPqq3HI0csJ2CEW3fvAQSMB-iUkrcg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1pqIKmYAnzFoss6OmaDOpQyTDfz6CJwlXHfkdXkwW0Rg&oe=69F1EF10"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category
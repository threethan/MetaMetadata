58466176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7Pd4RQY5tEQ7kNvwFxYx3d&_nc_oc=AdpxzVq8RRODMZqXP4X8Tigyjs9cu9y7MOdd04LXFgBj1zaz0vP8WOabxDtpocRZC-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ9I2CyI4o2u0km6-93Cwi04Q1uB5YZLur14aUIVVMAA&oe=6B01B99D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKMhZ_0aT-sQ7kNvwHeN5YN&_nc_oc=AdruzXWnoKY5HUWXHKlYDMGYD0rsrxnMy92KfzHNL3Xf1Rt1sm-9t7EY8dwFy6fwhz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDKUrmax84gmKGcGD5vSR1oLgBDvqzprmxC1ONkKWTEA&oe=6B01C43A"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Lg-PWJkUogQ7kNvwEePGXy&_nc_oc=Adq_-xcT-R7LIrsgu8vnbTVkOVYpK7B3QZ4-q31JSueCy-afTQ9QPn4H1a62TNSmsAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF0wcnkCDOyRVOS3HYatWoNc6R713L0GVVpBhZacwIkg&oe=6B01D17D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "826081647249352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302527_826081650582685_3469544336685241289_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdaOFhPDdXwQ7kNvwEFA_g8&_nc_oc=AdqlG_L8sTN8dTk3l2o9d92XUZq9JIJtcU09GmuLEvb7H-32ZAn_yfEhl6L-2GEhKPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROKmRRx029hWjNbrZF8W-Uy5ESNBkiCRf9Kjy1H_w64A&oe=6B01BC99"}, "display_name": "Garden Tend", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Garden Tend** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Garden Tend**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Garden Tend is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://gardentendgame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://gardentendgame.com/support", "website_url": "http://gardentendgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
cdn.com&oh=00_AfuTQKMkCuREAxGjuI2mpmtN50kxLfwf6NCqbIs8fH72Tg&oe=69A2CF66"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T77iZE1OPPgQ7kNvwF7Pchv&_nc_oc=AdnvvIjYu_h9OWdh1Cds1LLY0My3YwLOsd0BS9fxXXlbIi8FieYxhgUxI2rhNQ67kIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_O-OhU_iIvymIpnBmPULbhvKpQ4yoU7SkldMNUxlvZQ&oe=69A2D25D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfGOBivNKqYQ7kNvwG3lFYz&_nc_oc=Admnh-h-ZQFMl9Xwp-kPrAER2C5w4g1QJBLvtzERh-pr-XtWAhgJxaLxA3geeKRa85g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLCvYRy7p6ps1zJTVKjPgm6GYjCr2m2HDQV9pvLlVxrQ&oe=69A2DCFA"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgHOnT_idJAQ7kNvwF7vvVB&_nc_oc=AdlsmSMT5R4m5pdBGMBbUxUnwg2Asf0pSW2HLP8sTaNkag0kd-wgr0tRJIizi6qgiNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsnwwmP1yY0WHPJb8EMVdk0pXE94m9idnndR0QLW6IVuw&oe=69A2EA3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4Ieeg3O-ZAQ7kNvwFaLdNj&_nc_oc=AdnSDmmPaIh5ISDh577JHxI32Cq392p_cT8KMll7HslDKe9QMHE0YqvAWM6ZpuaIKYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afszauu3MCQXAt5y4agy5vvu9BMjQ5_xUBsy1uMcO0eiUQ&oe=69A2D510"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE
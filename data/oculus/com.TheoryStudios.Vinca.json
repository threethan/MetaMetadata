cdn.com&oh=00_Afu--0B9EAL7wVL5u8XpnWIsiHiZ84Kb01g-4utpMC4gIA&oe=69A57266"}, {"file_name": "Tend-with-Friends-Screenshots-3.png", "id": "1038102558466176", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619685_1038102561799509_2145509638781487840_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCOym5JgDQ8Q7kNvwFFcLQy&_nc_oc=Adk4mIWxa2LiOrDWB7ouiBk9GZbq1tkJEJJCsUG2D7QD3TXfCdWkExU8BWi8I9XHHV4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftZt_H75ypKxVgnxPDOGVELg3745wMhEhr7gnuwO5ONsw&oe=69A5755D"}, {"file_name": "2026-01 - First Bloom - Screenshot 3.png", "id": "1564701294559251", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821178_1564701297892584_1032540183332829449_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBksmkmcLjMQ7kNvwFmpQsu&_nc_oc=AdloI3i68EbLN2l-SuhwIh3p0wP2H1261iCpnakguAWe1iCfy4iynpZmHHFPtgVe-yY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuy-Cxs0RsVVIMHliGthD5WyWZnAb6ZQVmeIPZLoZTO3Q&oe=69A57FFA"}, {"file_name": "2026-01 - First Bloom - Screenshot 1.png", "id": "1179206614192114", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303140_1179206617525447_6426718312682771437_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwFh3WrPBqMQ7kNvwEfa5O_&_nc_oc=AdlAl6spLc7SMgW5syngjTRjoT7-a_p6HtzuVldvWtb3gY9QDTdUTQIjvo4aZgjlKE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsRvtZeWS6VwL7cu-E9DiQVkv7_CPjCyfDSlYowIWwMrA&oe=69A58D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image B.png", "id": "1427551878968556", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307433_1427551882301889_3826374479952921275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=creyexa_WAAQ7kNvwHF3o3n&_nc_oc=AdmIZF_7a0rH_AsxXOmEQu2q_sV6YetSmjXtdtQK_BbhGi7OGk9MfUHTGkR49vk2TmM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsio_JTU6DU9vqydx6AymXS7Ymv4DHy7lk_AN8TTQSITA&oe=69A57810"}, "display_name": "Tend with Friends - Garden Sim", "keywords": ["garden", "cozy", "plants", "relaxing", "gardening"], "long_description": "**Tend with Friends** is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!\n\n# \ud83c\udf31 Watch Life Unfold\nWitness every leaf unfurl & flower bloom in real-time. Inspired by reality, our artists hand-crafted every frame of growth to make your plants feel truly alive.\n{1818206152197505}\n\n#  \ud83e\udde9  Blooms Take Time, Patience is the Best Fertilizer\nOur core belief is that every plant experience should spark joy. No plants die in **Tend with Friends**, they just might be moodier, shy, or extra demanding!\n{831540516427888}\n\n\n# \ud83d\udc4b Your World, Your Hands\nNo controllers needed. Using just your hands, place virtual pots right on your real coffee table or bookshelf.\n{860635716550743}\n\n\n# \ud83c\udfb6 Find Your Vibe\nCustomize your sanctuary with hand-painted backgrounds and a \"soundbath\" soundtrack to set the right mood.\n{1374563571035503}\n\n\n# \ud83c\udf3cStart Your Garden for Free\nDip your toes in the soil for free, featuring 5 unique plants and a collection of cozy decor.\n{2058767028232934}\n\n\n# \ud83c\udf3a Ready to grow more?\nThe **Founder's Collection** is available for those who want the full botanical experience: unlocking 10+ rare plants, new backgrounds, music, and exclusive designer pots.\n\n# Transform your world, one plant at a time.\n\ud83e\udeb4", "short_description": "Tend with Friends is your new, magical gardening experience. Grow a collection of curious, moody, and beautiful plants that need more than just water, they need you!"}]}, "developer_name": "Theory Studios", "developer_privacy_policy_url": "http://tendwithfriends.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Theory Studios", "support_website_url": "http://tendwithfriends.com/support", "website_url": "http://tendwithfriends.com/", "category": null, "comfort_rating": "COMFORTABLE
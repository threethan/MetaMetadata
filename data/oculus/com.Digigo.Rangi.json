26901256_3853305702894272512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmme4UavmesQ7kNvwEpM1ul&_nc_oc=AdrRyio4r-w9gN3FtP9_2tzS5LqDh40Bt168kb1KZ0Bh9shq9Yoa9dHFpW3TqMlB3Sg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OYnkCQCyMnGm4Y1ocSp9b43gkr1S73yKOJdwKHQ6vbw&oe=6A413DC2"}, {"file_name": "migrated_image.png", "id": "647628986023176", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533772_759549974202443_5710291635737198592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlLa-d4aaNEQ7kNvwHbsU6X&_nc_oc=AdqKBaIbfEr0DsEXtYyYUVdw2ZDcr6KFGwfOo_bD1f6jsD-85YaB61egG3Gsswttb_Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mmIz14lT6zv2MJbUOL3iJahGPZasQ67OuLe___pSzNg&oe=6A412488"}, {"file_name": "migrated_image.png", "id": "497657750916774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139502_243498276086766_5351857798634274816_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N2AfY3Kh-8Q7kNvwFuYC0K&_nc_oc=AdqBsvVWKJZm2sg1WFYKu03lrFZTFINJob-YEaD701sh_fzdlHjYVwMglx2BIDVKjS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jfcIdhWDS0hdi_s2ZgvNovXKKLHDXH43SjNiNBNmzGQ&oe=6A411789"}, {"file_name": "migrated_image.png", "id": "237412004063850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139237_1233433170080666_8191193204083654656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKiMogBoT6IQ7kNvwF8ucel&_nc_oc=AdpoSc6PkpFI3TYNjkKS0Wq8mX5AXv_k28YL8P--MVWnhUphenHttGEGbzlhPAiC6B0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UZ7dlmJPyVVehA1-zLLivlXYNc9yNFWWgAWtBsBmzEQ&oe=6A414128"}, {"file_name": "migrated_image.png", "id": "205346430559684", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12727931_193896257749331_1925621631946850304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8FN5RekeCcQ7kNvwFtWLzf&_nc_oc=AdphLDkGSBB6UbwoGwgmxeNKKjEhuwQSFdpChs2HcBZGk3phwa8s8mZ7KjfHkRIX9Y0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_feofZSD1eimhZwvt278kecPuFc8aiOZGB60T7b-B_ng&oe=6A4132F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_cover_Art01.png", "id": "1881522405423126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139502_1881522408756459_2398586913800847360_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayLuOzw2DPMQ7kNvwEGFYFm&_nc_oc=AdpC4LxBsz4symOptorl1tGIBQUjSszwM5tnRVYBUeaIC5sXEIEkmRgVcec_54Ijv0U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vapiIoE-cptgX2I9tQFFkH67mhMebDKh9-Tj9REuLFw&oe=6A4115C7"}, "display_name": "Rangi", "keywords": ["Puzzle", "adventure", "flight", "music", "africa"], "long_description": "Close your eyes. Find your courage. Search your soul for the path through the doors of the temple. Discover lost secrets, perhaps even your own. Meditate and drift, but do not let the Matata's tricks deceive you. There is danger in their beauty. There is violence in their artifice. You are here to save us from it, and we believe in you.\nLet the Musiki be your guide, my child. Listen to their voices, hear their song, beating like your heart. Hear the resonance of the world in the ombertone of your ancestors, feel the blood of our people flowing like water over stone, wearing it down, making it yours.\nIf you are confused, do not be frustrated, for the world is confusing.\nIf you make mistakes, patiently correct them, for there is no shame in learning from your missteps.\nIf you feel you cannot go on, pause, look around. Perhaps the Musiki are trying to show you something.\nMove like the wind, flow like the water, be as still as the stone beneath your feet, and you will find your way.", "short_description": "Solve complex puzzles, explore hidden temples, escape deadly platforms and revel in the joy of flight as you restore the Musiki's stolen rhythms!\nLong ago, the Musiki's rhythms protected the Nchi. They lived lives of peace and plenty, dancing as one to the world's drumbeat. Now the Music Giants' lifeforce is ensnared by a devious enemy, and you come to set it free.\nInspired by tribal music, art and architecture from across the African continent, Rangi is challenging yet comfortable to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rangigame.com/privacy-policy/", "developer_terms_of_service_url": "http://rangigame.com/terms-and-conditions/", "publisher_name": "Digigo", "support_website_url": null, "website_url": "http://rangigame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "981189599148690"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1376128995813068", "version": "2.0.1"}, "id": "841232939312908", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1179587862133850", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1376128995813068"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "841232939312908"}]}, "change_log": "International support", "created_date": 1495479630, "id": "1376128995813068", "version": "2.0.1", "version_code": 27, "release_status
8534E"}]}, "id": "239078213942045", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "2478794752332972", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12448923_401079726901256_3853305702894272512_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1dqf8D1D8oQ7kNvwGc-n6e&_nc_oc=Adot0nE-gKYURiBUsRUBvBUbiqw4ZxxAEIB_CH3r05bPB82NJaWVK757CGMOHfh3ULo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlIP9CYO3_uxOEf9Hbm5d44xWprkDqSnday0XETPFzXQ&oe=6B085042"}, {"file_name": "migrated_image.png", "id": "647628986023176", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533772_759549974202443_5710291635737198592_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U3jowVBuYAQ7kNvwGXim3t&_nc_oc=AdrBR4yn6pBpyQs3rRx2pTW7NHc3CLjF9eUNjDUbRkoKr_MPHEfumTtOPwY8li4BIQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxmhAfNz-TaYFGAsh49yzZ2L3ysDr5fkv5rqURaR6GLQ&oe=6B086F48"}, {"file_name": "migrated_image.png", "id": "497657750916774", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139502_243498276086766_5351857798634274816_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DokM_CUYfMoQ7kNvwHYXo0N&_nc_oc=Ado28ohmgkqG19bSzK2pLPvoku-PI8SpKeeRZ1LtXMjXdDb5sm19ZRvmFPoZl0--VNc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0FZJWfxgbsy6aWyHt8FmtFEpGZ_XiTiUL9XPD_xW2Lg&oe=6B086249"}, {"file_name": "migrated_image.png", "id": "237412004063850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139237_1233433170080666_8191193204083654656_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi0-epR-N7EQ7kNvwHkZ1K4&_nc_oc=AdpeCl-CRKVo4kEbD-HM9s4UnU9efClnNLxlTkVrnwLNsyS5FZ8ByClD08eh7vRJUPA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8BPMj2tpTOJ_6ErwA70ezw8Eglhj074pVWcIaLooAng&oe=6B0853A8"}, {"file_name": "migrated_image.png", "id": "205346430559684", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12727931_193896257749331_1925621631946850304_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puRiOnib0eIQ7kNvwHjmwKb&_nc_oc=Adp0SeMfPwO-rcsYAr015zmjYiZ1XvMfuxRGXjYHM_ScG9LvJ790b-vWLfrV4rdSgzc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKj3bUVkvAlPB8-_Shl5sU-rxhnMIjkeqoGq1NFhM8Sg&oe=6B084575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_cover_Art01.png", "id": "1881522405423126", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139502_1881522408756459_2398586913800847360_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9tVUqalj4AQ7kNvwFW2-xU&_nc_oc=AdrKnx-dOIBM7n6zwItnuiEZa8vs0qpiL9PdkYdiTCFRxw_COHeOOpg1xOHZsUG33Ho&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVeTZWKUnJJlTYkccZy0jLEr6QpInKlmBPYFvny-ZQSA&oe=6B086087"}, "display_name": "Rangi", "keywords": ["Puzzle", "adventure", "flight", "music", "africa"], "long_description": "Close your eyes. Find your courage. Search your soul for the path through the doors of the temple. Discover lost secrets, perhaps even your own. Meditate and drift, but do not let the Matata's tricks deceive you. There is danger in their beauty. There is violence in their artifice. You are here to save us from it, and we believe in you.\nLet the Musiki be your guide, my child. Listen to their voices, hear their song, beating like your heart. Hear the resonance of the world in the ombertone of your ancestors, feel the blood of our people flowing like water over stone, wearing it down, making it yours.\nIf you are confused, do not be frustrated, for the world is confusing.\nIf you make mistakes, patiently correct them, for there is no shame in learning from your missteps.\nIf you feel you cannot go on, pause, look around. Perhaps the Musiki are trying to show you something.\nMove like the wind, flow like the water, be as still as the stone beneath your feet, and you will find your way.", "short_description": "Solve complex puzzles, explore hidden temples, escape deadly platforms and revel in the joy of flight as you restore the Musiki's stolen rhythms!\nLong ago, the Musiki's rhythms protected the Nchi. They lived lives of peace and plenty, dancing as one to the world's drumbeat. Now the Music Giants' lifeforce is ensnared by a devious enemy, and you come to set it free.\nInspired by tribal music, art and architecture from across the African continent, Rangi is challenging yet comfortable to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rangigame.com/privacy-policy/", "developer_terms_of_service_url": "http://rangigame.com/terms-and-conditions/", "publisher_name": "Digigo", "support_website_url": null, "website_url": "http://rangigame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "981189599148690"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "114157555761085"}, {"status": "PUBLISHED", "id": "374953000019243"}, {"status": "PUBLISHED", "id": "1703495976349208"}, {"status": "PUBLISHED", "id": "1952368571477996"}, {"status": "CANCELLED", "id": "1399874693475016"}, {"status": "PUBLISHED", "id": "465852297523682"}, {"status": "PUBLISHED", "id": "536290880523293"}, {"status": "PUBLISHED", "id": "918066098588218"}, {"status": "PUBLISHED", "id": "810456395803445"}, {"status": "PUBLISHED", "id": "1574360319255192"}, {"status": "PUBL
512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d09pRELjszwQ7kNvwGnrMPM&_nc_oc=AdrctB52ybjS96PkuhVItjaZOUqCi1W4hbrMFxYaWsKh9I4_imz_mxAQnjx7y_Mv7Dw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1GEkjJqyU1J7f1p8tdPWHKacSP1OJUtAKJOV9xVhaf-g&oe=69F1EB82"}, {"file_name": "migrated_image.png", "id": "647628986023176", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533772_759549974202443_5710291635737198592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cHRNmefSf0Q7kNvwG8F6oB&_nc_oc=Adp5jpAnntsLFnc4zDeYtVzPm-ULru7GueDTfZ-r6ZNdF9cBKkIeDssjjmiPtIou3jg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1j-DryRjuKkyslASZ6iCGWLwWcUYLj-Q6OMXDjUKRqRw&oe=69F20A88"}, {"file_name": "migrated_image.png", "id": "497657750916774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139502_243498276086766_5351857798634274816_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_bZ23WN5acQ7kNvwEyftx-&_nc_oc=AdqK03pdlCOIz3PZVI9K84qoQcbrUEpOeX43K6O_iZ822l2goppWruoVB8wwWboDikw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3BBcbj523OafkT0hMrqc3diMbVV4d7k5lLgOSOl5Sf1Q&oe=69F1FD89"}, {"file_name": "migrated_image.png", "id": "237412004063850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12139237_1233433170080666_8191193204083654656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lH3S8kfJKcQ7kNvwFSI121&_nc_oc=AdoBpTkiJCD2d0XPL859GOVHPoM6PWDUVQA4m8t_9kXltoOIFvvJnXirfIzDVji7urk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1flxefOcSovcp1n3UnokUf892PnKBJUAlakNDUxLGjLg&oe=69F1EEE8"}, {"file_name": "migrated_image.png", "id": "205346430559684", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12727931_193896257749331_1925621631946850304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BNLTNZG8JMQ7kNvwEmt0cY&_nc_oc=AdqDkJ4s8ijUyEcFPpk6Qtx_RZ0JMUQTPndlAO3keENEInyyEOwWIItUBHvCG_EcyFo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3PKzhT_4nZeg0vePdh2IbsdkP2sITJsJPoea-1_RfZMA&oe=69F218F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_cover_Art01.png", "id": "1881522405423126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139502_1881522408756459_2398586913800847360_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF79HXWwVx4Q7kNvwGOD914&_nc_oc=AdppVWCYNvRO-rV2MJ8Q7Z_jDioe-xLY2H2VqzH98lT7OZUHPyyLZrW72-XRHG5-AGU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2QK1xJf3E1zDdeW2L8OzTR8Doe9y5ZS8ZsE-R7GGLD9w&oe=69F1FBC7"}, "display_name": "Rangi", "keywords": ["Puzzle", "adventure", "flight", "music", "africa"], "long_description": "Close your eyes. Find your courage. Search your soul for the path through the doors of the temple. Discover lost secrets, perhaps even your own. Meditate and drift, but do not let the Matata's tricks deceive you. There is danger in their beauty. There is violence in their artifice. You are here to save us from it, and we believe in you.\nLet the Musiki be your guide, my child. Listen to their voices, hear their song, beating like your heart. Hear the resonance of the world in the ombertone of your ancestors, feel the blood of our people flowing like water over stone, wearing it down, making it yours.\nIf you are confused, do not be frustrated, for the world is confusing.\nIf you make mistakes, patiently correct them, for there is no shame in learning from your missteps.\nIf you feel you cannot go on, pause, look around. Perhaps the Musiki are trying to show you something.\nMove like the wind, flow like the water, be as still as the stone beneath your feet, and you will find your way.", "short_description": "Solve complex puzzles, explore hidden temples, escape deadly platforms and revel in the joy of flight as you restore the Musiki's stolen rhythms!\nLong ago, the Musiki's rhythms protected the Nchi. They lived lives of peace and plenty, dancing as one to the world's drumbeat. Now the Music Giants' lifeforce is ensnared by a devious enemy, and you come to set it free.\nInspired by tribal music, art and architecture from across the African continent, Rangi is challenging yet comfortable to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rangigame.com/privacy-policy/", "developer_terms_of_service_url": "http://rangigame.com/terms-and-conditions/", "publisher_name": "Digigo", "support_website_url": null, "website_url": "http://rangigame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "981189599148690"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "114157555761085"}, {"status": "PUBLISHED", "id": "374953000019243"}, {"status": "PUBLISHED", "id": "1703495976349208"}, {"status": "PUBLISHED", "id": "1952368571477996"}, {"status": "CANCELLED", "id": "1399874693475016"}, {"status": "PUBLISHED", "id": "465852297523682"}, {"status": "PUBLISHED", "id": "536290880523293"}, {"status": "PUBLISHED", "id": "918066098588218"}, {"status": "PUBLISHED", "id": "810456395803445"}, {"status": "PUBLISHED", "id": "1574360319255192"}, {"status": "PUBLISHED", "id": "1355638014556127"}, {"status": "PUBLISHED", "id": "1946194868942146"}, {"status": "PUBLISHED", "id": "1064132563751525"}, {"status": "PUBLISHED", "id": "2419764028141697"}, {"status": "CANCELLED", "id": "157173978199291"}, {"status": "PUBLISHED", "id": "320607875453200"}, {"status": "CANCELLED", "id": "1647987328573260"}]}, "baseline_offer": {"id": "1946194868942146"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1484812
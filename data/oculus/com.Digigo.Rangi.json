03C4E"}]}, "id": "239078213942045", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "2478794752332972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448923_401079726901256_3853305702894272512_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XwxG99021IQ7kNvwGR-k5e&_nc_oc=AdrCUBS_B3lmt2CdjYnklSdGkDWBoEGP_AmOQVn01A7P8P_3Gf5CRDXdJlbjgemh1Rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVUj7DslIszFGfIkuF8J5p5Xwuj_pxAKcSWD4Kymzq_SA&oe=6B103942"}, {"file_name": "migrated_image.png", "id": "647628986023176", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533772_759549974202443_5710291635737198592_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSbpohrlOz4Q7kNvwEvJQ0O&_nc_oc=AdoJ1-jgsmbX19vEwTwXN2DgUvJmkjRuK6cMQtWLAM8ReVJno3OpdFQpxrwmFiTjmIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGiRFSzvGasVVclS2k1i97Ru6K24kClKTW25L97YYPMA&oe=6B105848"}, {"file_name": "migrated_image.png", "id": "497657750916774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139502_243498276086766_5351857798634274816_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahPq2AwpPDoQ7kNvwE3KLFL&_nc_oc=AdrMyq8KmRRASc35Il88IYtqCHD95JxoNXuogqzwExo0pbj289eBtqHoV4V_Iavpe8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUcSgIcRcUQx53wap69Gpn1M2-iN3N3zL_C5VtYiwaYZQ&oe=6B104B49"}, {"file_name": "migrated_image.png", "id": "237412004063850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139237_1233433170080666_8191193204083654656_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_EuBS5zN_sQ7kNvwEK9Wkj&_nc_oc=Adp09ZJpo1NZmDqtOC_7104e64mYSCGZmb9laKIHbrLagHfuwmmXb1CxDeRPaptZOWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQts_exQk_Da5WVFJkhEXJSWs7OxNki5aX4yxMQDD-4Q&oe=6B103CA8"}, {"file_name": "migrated_image.png", "id": "205346430559684", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727931_193896257749331_1925621631946850304_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf16E7fDYj0Q7kNvwE8A2dM&_nc_oc=Adqtif5BW6PuWoBXQg_8_qWWDeQOLxuXKT-b1PupZihgeZhoZ87sp-h1mK_K6zEVVoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZW2xtmAnaPNE7Qc6cI4piA0CfJy2Igcw9rmr9A9JzlA&oe=6B1066B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_cover_Art01.png", "id": "1881522405423126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139502_1881522408756459_2398586913800847360_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27a-52M2BbEQ7kNvwHWrM2B&_nc_oc=AdpjyUI3RXI14WBpN23JXtIf2QS-c8Pqq9IB7xoWBkTtMPW4iOD7b7X1BwIslb-2bJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpnE5Y5kWAlmm6OLhQQAY5WaFziQHGrD1jmpwFMyCLpw&oe=6B104987"}, "display_name": "Rangi", "keywords": ["Puzzle", "adventure", "flight", "music", "africa"], "long_description": "Close your eyes. Find your courage. Search your soul for the path through the doors of the temple. Discover lost secrets, perhaps even your own. Meditate and drift, but do not let the Matata's tricks deceive you. There is danger in their beauty. There is violence in their artifice. You are here to save us from it, and we believe in you.\nLet the Musiki be your guide, my child. Listen to their voices, hear their song, beating like your heart. Hear the resonance of the world in the ombertone of your ancestors, feel the blood of our people flowing like water over stone, wearing it down, making it yours.\nIf you are confused, do not be frustrated, for the world is confusing.\nIf you make mistakes, patiently correct them, for there is no shame in learning from your missteps.\nIf you feel you cannot go on, pause, look around. Perhaps the Musiki are trying to show you something.\nMove like the wind, flow like the water, be as still as the stone beneath your feet, and you will find your way.", "short_description": "Solve complex puzzles, explore hidden temples, escape deadly platforms and revel in the joy of flight as you restore the Musiki's stolen rhythms!\nLong ago, the Musiki's rhythms protected the Nchi. They lived lives of peace and plenty, dancing as one to the world's drumbeat. Now the Music Giants' lifeforce is ensnared by a devious enemy, and you come to set it free.\nInspired by tribal music, art and architecture from across the African continent, Rangi is challenging yet comfortable to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rangigame.com/privacy-policy/", "developer_terms_of_service_url": "http://rangigame.com/terms-and-conditions/", "publisher_name": "Digigo", "support_website_url": null, "website_url": "http://rangigame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "981189599148690"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "114157555761085"}, {"status": "PUBLISHED", "id": "374953000019243"}, {"status": "PUBLISHED", "id": "1703495976349208"}, {"status": "PUBLISHED", "id": "1952368571477996"}, {"status": "CANCELLED", "id": "1399874693475016"}, {"status": "PUBLISHED", "id": "465852297523682"}, {"status": "PUBLISHED", "id": "536290880523293"}, {"status": "PUBLISHED", "id": "918066098588218"}, {"status": "PUBLISHED", "id": "810456395803445"}, {"status": "PUBLISHED", "id": "1574360319255192"}, {"status": "PUBL
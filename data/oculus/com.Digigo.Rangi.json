726901256_3853305702894272512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d09pRELjszwQ7kNvwGv2AqF&_nc_oc=Adrg8MUtZWxBsoOL5BOunHoT9h_f4_qzVqpStRf5dIz4eiR-ko6J7jZkJ4176G3ZupQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3G2zDdZzTNcljfu45mymUxCfy-w_qWDRa4MjfPB3yXng&oe=69EF80C2"}, {"file_name": "migrated_image.png", "id": "647628986023176", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533772_759549974202443_5710291635737198592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6KCKmZgxWYQ7kNvwEW-hbK&_nc_oc=AdoPzbBiLy2heTSGcu1HRd1SHqvDOt--uQHuZlhZj0XwsZKmRYiakfK2UaIUOkYA078&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GVXV6Ot7Q4oee79VOsZubb-7dKjFw39BDGLEk3aionQ&oe=69EF6788"}, {"file_name": "migrated_image.png", "id": "497657750916774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139502_243498276086766_5351857798634274816_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9ALhnm7poIQ7kNvwGDOgbX&_nc_oc=Adq7WuSAsFsPBCkg2P11DSizAvBu-mfitnpe3RYj7FUrZKy0uPBc63_TOQ8wokiJWOc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-giz2RR_ngUtYMgUds5RU2LP9ZbwC7-NaJjjEDXySXA&oe=69EF5A89"}, {"file_name": "migrated_image.png", "id": "237412004063850", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139237_1233433170080666_8191193204083654656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lH3S8kfJKcQ7kNvwElqUCZ&_nc_oc=Adocn85d_J1fyo8TcVt-JQh5TOCzI3dL7TeFyedX7_x7anYDq1h1oz5nKRvM7_VQcw4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WtUux7uLH9VGZdJL9mcjCDR22_YwJVJS7GV8JBeSTJQ&oe=69EF4BE8"}, {"file_name": "migrated_image.png", "id": "205346430559684", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727931_193896257749331_1925621631946850304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovbulXWoItQQ7kNvwErSq3l&_nc_oc=AdqvQX8W2uAgJujiuRkmTeKxrdx3-RIlOJv9lqlgAtlazL-6-GwgStjW0tjfARehUyE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OB291Zo_9mNVw4GCqeImxxwM_u0dJaVWdaT3V_-JFug&oe=69EF75F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_cover_Art01.png", "id": "1881522405423126", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139502_1881522408756459_2398586913800847360_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q6VUWXiTHEQ7kNvwHh426u&_nc_oc=Ado3mj5E50rV56SY82GIr7A0PRSJXMy3ppv1-gVSiq1X-ikN_ck042z1K558paWxjYc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Wd042gkRSa-rtGQ5O2diAkabQLDBIU26Pz3Ti_pZoSA&oe=69EF58C7"}, "display_name": "Rangi", "keywords": ["Puzzle", "adventure", "flight", "music", "africa"], "long_description": "Close your eyes. Find your courage. Search your soul for the path through the doors of the temple. Discover lost secrets, perhaps even your own. Meditate and drift, but do not let the Matata's tricks deceive you. There is danger in their beauty. There is violence in their artifice. You are here to save us from it, and we believe in you.\nLet the Musiki be your guide, my child. Listen to their voices, hear their song, beating like your heart. Hear the resonance of the world in the ombertone of your ancestors, feel the blood of our people flowing like water over stone, wearing it down, making it yours.\nIf you are confused, do not be frustrated, for the world is confusing.\nIf you make mistakes, patiently correct them, for there is no shame in learning from your missteps.\nIf you feel you cannot go on, pause, look around. Perhaps the Musiki are trying to show you something.\nMove like the wind, flow like the water, be as still as the stone beneath your feet, and you will find your way.", "short_description": "Solve complex puzzles, explore hidden temples, escape deadly platforms and revel in the joy of flight as you restore the Musiki's stolen rhythms!\nLong ago, the Musiki's rhythms protected the Nchi. They lived lives of peace and plenty, dancing as one to the world's drumbeat. Now the Music Giants' lifeforce is ensnared by a devious enemy, and you come to set it free.\nInspired by tribal music, art and architecture from across the African continent, Rangi is challenging yet comfortable to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rangigame.com/privacy-policy/", "developer_terms_of_service_url": "http://rangigame.com/terms-and-conditions/", "publisher_name": "Digigo", "support_website_url": null, "website_url": "http://rangigame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "981189599148690"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "114157555761085"}, {"status": "PUBLISHED", "id": "374953000019243"}, {"status": "PUBLISHED", "id": "1703495976349208"}, {"status": "PUBLISHED", "id": "1952368571477996"}, {"status": "CANCELLED", "id": "1399874693475016"}, {"status": "PUBLISHED", "id": "465852297523682"}, {"status": "PUBLISHED", "id": "536290880523293"}, {"status": "PUBLISHED", "id": "918066098588218"}, {"status": "PUBLISHED", "id": "810456395803445"}, {"status": "PUBLISHED", "id": "1574360319255192"}, {"status": "PUBLISHED", "id": "1355638014556127"}, {"status": "PUBLISHED", "id": "1946194868942146"}, {"status": "PUBLISHED", "id": "1064132563751525"}, {"status": "PUBLISHED", "id": "2419764028141697"}, {"status": "CANCELLED", "id": "157173978199291"}, {"status": "PUBLISHED", "id": "320607875453200"}, {"status": "CANCELLED", "id": "1647987328573260"}]}, "baseline_offer": {"id"
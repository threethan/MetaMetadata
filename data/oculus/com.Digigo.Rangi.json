23_401079726901256_3853305702894272512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j221Xx_xGoQ7kNvwFq1-da&_nc_oc=AdplxiPcZKzlAjULqwdU-mbGriHCtTeAk9kYZdz9xEUK-9chjAwScp2fkLVub5LO8a8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJc8SOoTzfd6oL4LOsRKtjowviebGCSWpBsrffA_zmHQ&oe=6A859382"}, {"file_name": "migrated_image.png", "id": "647628986023176", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12533772_759549974202443_5710291635737198592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3mIsNJ9XZ0Q7kNvwFfKM9G&_nc_oc=Adr_9KkO13dbHOGWjPbbs8a_ShgNb49rlLR7XK3RppxZooqKPqkkwKB94lkzyCy9770&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCgpycBicihB4otd3no0Yw0iU33u3DFElBxidMG2dRKg&oe=6A85B288"}, {"file_name": "migrated_image.png", "id": "497657750916774", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12139502_243498276086766_5351857798634274816_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y06kjvUFfA0Q7kNvwGnEnGi&_nc_oc=Adq9E-JbNl_YjDQIXwNZAJNiU1gWZy1V_ub7w8ip37Y_1rXta6ruZQXVXkFAVzGOnSk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG44FT5IYeKud7RPhF4IHDZPhWKOkcq9yc8hvME5HZBuA&oe=6A85A589"}, {"file_name": "migrated_image.png", "id": "237412004063850", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12139237_1233433170080666_8191193204083654656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPQZ33-XeuAQ7kNvwHLoDlS&_nc_oc=AdrSCwD-jwJrBQWcAYMG2BKe0Lp-NpefLnd4b_0Kx1UqtQBuAo1dW94k0NStuelWLnc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo52QkPfT0AYGojWYK7A2IQZznMV0Zp_UJrP_sTYDAog&oe=6A8596E8"}, {"file_name": "migrated_image.png", "id": "205346430559684", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12727931_193896257749331_1925621631946850304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSa-uAaYYsoQ7kNvwGkVvjL&_nc_oc=AdqqCJWRVzaiT498D-2i-zwCdFAwiGyEpiDUT3v97eD_1VtKWf9FQicoozUxmZpH5Pk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7oUxCDooRjvkcpikgscwSK6k-VZWHhq_m0h7ixHFm0Q&oe=6A8588B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_cover_Art01.png", "id": "1881522405423126", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12139502_1881522408756459_2398586913800847360_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KM0OpqNmOQQ7kNvwF3SmWB&_nc_oc=AdoKLIwu9FDbGhwCGogL-xgWp8AWgEHT3c8-JIjWZCmvMr-2Q6GKBavLSZaKegnXWsw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIu5YnSS-o18_uEAg-Uej7--6NEURBGsIDlpGYSbFIJw&oe=6A85A3C7"}, "display_name": "Rangi", "keywords": ["Puzzle", "adventure", "flight", "music", "africa"], "long_description": "Close your eyes. Find your courage. Search your soul for the path through the doors of the temple. Discover lost secrets, perhaps even your own. Meditate and drift, but do not let the Matata's tricks deceive you. There is danger in their beauty. There is violence in their artifice. You are here to save us from it, and we believe in you.\nLet the Musiki be your guide, my child. Listen to their voices, hear their song, beating like your heart. Hear the resonance of the world in the ombertone of your ancestors, feel the blood of our people flowing like water over stone, wearing it down, making it yours.\nIf you are confused, do not be frustrated, for the world is confusing.\nIf you make mistakes, patiently correct them, for there is no shame in learning from your missteps.\nIf you feel you cannot go on, pause, look around. Perhaps the Musiki are trying to show you something.\nMove like the wind, flow like the water, be as still as the stone beneath your feet, and you will find your way.", "short_description": "Solve complex puzzles, explore hidden temples, escape deadly platforms and revel in the joy of flight as you restore the Musiki's stolen rhythms!\nLong ago, the Musiki's rhythms protected the Nchi. They lived lives of peace and plenty, dancing as one to the world's drumbeat. Now the Music Giants' lifeforce is ensnared by a devious enemy, and you come to set it free.\nInspired by tribal music, art and architecture from across the African continent, Rangi is challenging yet comfortable to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rangigame.com/privacy-policy/", "developer_terms_of_service_url": "http://rangigame.com/terms-and-conditions/", "publisher_name": "Digigo", "support_website_url": null, "website_url": "http://rangigame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "981189599148690"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1376128995813068", "version": "2.0.1"}, "id": "841232939312908", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1179587862133850", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1376128995813068"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "841232939312908"}]}, "change_log": "International support", "created_date": 1495479630, "id": "1376128995813068", "version": "2.0.1", "version_code": 2
26901256_3853305702894272512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyyvKy1dKdEQ7kNvwG1JFpg&_nc_oc=AdrHiQh3XriL9Pmr1u1bVuHngavbmOWrE4sFqZ3zCWXdzT-OULTIyWkcRgY0qjVt7nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVC3GVo-_1wB63qq0n_1_WjLW-mb8R-nMbM0P2K7EbUw&oe=6A6384C2"}, {"file_name": "migrated_image.png", "id": "647628986023176", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533772_759549974202443_5710291635737198592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-XiTiURDUkQ7kNvwF9-W_F&_nc_oc=AdruBmgCUpc5oTuxvqBRQNZ7R4egGIPXJtkn6J93VHkCTQenIi8wgguMycCh5Zr4tO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYnexc-ohyIELZX5rb9uBO-xzsLFN3erNGWg8ihHcVMg&oe=6A636B88"}, {"file_name": "migrated_image.png", "id": "497657750916774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139502_243498276086766_5351857798634274816_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uS16uiZF7kQ7kNvwHIw7K5&_nc_oc=Adr8Djyj1hSMnxvonhBbbwWS_0v8K2TV_D096FZZOY_6Jcvhwkvwp0OM2MNAWfiGaNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5g7gN4rlZeFAiOZPeoF-wk7zqFrfaH_ili1s22lS7EA&oe=6A635E89"}, {"file_name": "migrated_image.png", "id": "237412004063850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139237_1233433170080666_8191193204083654656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_ZZWWzS18AQ7kNvwHsqcn6&_nc_oc=AdrF6hCUJa7kK_9P2GxKFhtAQtmiBlm7DCq_C1RTPSxyuhUAIa7y8urgk_ZajutmlCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAIOcEEaHOYDkDSPnUhcOMjs9xoS2CXGIXVKBr05TAWA&oe=6A634FE8"}, {"file_name": "migrated_image.png", "id": "205346430559684", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12727931_193896257749331_1925621631946850304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8MAKmM6qUoQ7kNvwEkL0T2&_nc_oc=AdriOvC6LhY4ZRCNxuV_2-VjWXhfPV-SU-SoStkMr2vyhHCFPGPQsBPWHSaMOD3Zwjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEsUabI4AbsnIREBCEbrIpmvt7BMeAPUJxzCeUkTJrqg&oe=6A6379F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_cover_Art01.png", "id": "1881522405423126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139502_1881522408756459_2398586913800847360_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12gTm_4aiHAQ7kNvwHhKWlH&_nc_oc=Adq9jCpdXEd4TEKmOHbOOdzv1KBbIL71nLrwCRC82Ynz4d_68X-agfxBqsRr-w4GXIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkHQa9B8KO52_mbc2uAChtP1nPMKlap-n4yqltxrxyUw&oe=6A635CC7"}, "display_name": "Rangi", "keywords": ["Puzzle", "adventure", "flight", "music", "africa"], "long_description": "Close your eyes. Find your courage. Search your soul for the path through the doors of the temple. Discover lost secrets, perhaps even your own. Meditate and drift, but do not let the Matata's tricks deceive you. There is danger in their beauty. There is violence in their artifice. You are here to save us from it, and we believe in you.\nLet the Musiki be your guide, my child. Listen to their voices, hear their song, beating like your heart. Hear the resonance of the world in the ombertone of your ancestors, feel the blood of our people flowing like water over stone, wearing it down, making it yours.\nIf you are confused, do not be frustrated, for the world is confusing.\nIf you make mistakes, patiently correct them, for there is no shame in learning from your missteps.\nIf you feel you cannot go on, pause, look around. Perhaps the Musiki are trying to show you something.\nMove like the wind, flow like the water, be as still as the stone beneath your feet, and you will find your way.", "short_description": "Solve complex puzzles, explore hidden temples, escape deadly platforms and revel in the joy of flight as you restore the Musiki's stolen rhythms!\nLong ago, the Musiki's rhythms protected the Nchi. They lived lives of peace and plenty, dancing as one to the world's drumbeat. Now the Music Giants' lifeforce is ensnared by a devious enemy, and you come to set it free.\nInspired by tribal music, art and architecture from across the African continent, Rangi is challenging yet comfortable to play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://rangigame.com/privacy-policy/", "developer_terms_of_service_url": "http://rangigame.com/terms-and-conditions/", "publisher_name": "Digigo", "support_website_url": null, "website_url": "http://rangigame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "981189599148690"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1376128995813068", "version": "2.0.1"}, "id": "841232939312908", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1179587862133850", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1376128995813068"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "841232939312908"}]}, "change_log": "International support", "created_date": 1495479630, "id": "1376128995813068", "version": "2.0.1", "version_code": 27, "release_status
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faaUCSmva6oQ7kNvwGH-969&_nc_oc=AdqwWBF0SURVMbxf64LKTOq2NMbv4Q4BhlKpdbx5bBTabAdUkZZqAPI9jZvWA-QtEhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJMMyndkzMregSmwNFmCEhERJIAPe4UcswGAiyun7EbQ&oe=6A6CB1A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZ8KnNsalRYQ7kNvwEkzdl4&_nc_oc=Adpuez8VvadwQ7njKO5y6I3yTK9gX-VQKtdOY5Mo4tqpLhx2Fkwa52iCGIuVRBcWKLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgf13zSg4eNPKDAXEr7UiiSOd90qzFjUTkUsQx2HYVQw&oe=6A6CC112"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAa_5lU3DDQQ7kNvwHM8NAK&_nc_oc=Ado_93drPl-f10uINiypOjKZEw7t0qO8SSXIWQP2knlg2TsIru4nyTca6c1NMnJj1_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIjhFJ8Ly0yMdnY6SDCtGfQS_mviphAv8Kn35URDhdNQ&oe=6A6CAB29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWkh19ugfCYQ7kNvwEJyrND&_nc_oc=AdrheGPGI3tzF2pT11TMmZxgNaOrLiaw3kOBxyvv9OMvGVQ_UdDPytoGRJvBfxNn5BI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfbM2Q8wP6SyWptH7g9q61NHTajBDxDLsyDCDHY9Uq4g&oe=6A6CAF9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HW1hHDzrh4Q7kNvwHH6-9r&_nc_oc=AdqIE2WU1m-7HlrZdpMQb-ZfbsAiHTcGzrRqFDn3vkeFFVnmBIoqsLFxHVPBDjcB2bE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLwNTpSNuMfYCDyKEUh6ETpFM_h41I-8j9FtedFdrehg&oe=6A6C8B23"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
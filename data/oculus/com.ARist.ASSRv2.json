71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMVRdY3HzDYQ7kNvwEMPa_c&_nc_oc=AdpDKIDN3NMftqM4v7N1wu34F2H79SlaNG6RSa3rky5cN4eKltPKSt3AyK54S6ujuX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMygQV3lwvE5EY4OdwanUs6lGbB8eVqsHSPipqdl3nHmw&oe=6ACE40A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1RgyvTw63sQ7kNvwEgqFsM&_nc_oc=AdrO4XvIUO_l0-qIyOTm918wONJAcr_ZWeEwTwuvpCvo7R9ug5zR6oljBsQzQN_g31g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPebXzTIMcYFjLmah3ilZX8e3363RzwWI55xsRuPtMuBQ&oe=6ACE5012"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkEp16Ky33IQ7kNvwEMQDkX&_nc_oc=AdoqeGVRU0MiAprxdY6ZK4RJjvCDh5JlR73qqcm2cUr-DCgqWn_oodHtDJGk_7gUQg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxtF-MuUUwD2Gtdh1o6_qItdObKF9JbYw7RjuywxskqQ&oe=6ACE3A29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oPU5kCgy3cQ7kNvwEE3pMa&_nc_oc=Adqc5on47KLupUEB-Mx5B50kC__2VWenzmpUBRpDyf54Yw3KgEhK_qo5_RC-1XcEVdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBsuZ3Dlh48tQDk01cOzgmZduI5xt88gvUOKdCFpOOsQ&oe=6ACE3E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9x66S6-oWQQ7kNvwH2E4nb&_nc_oc=AdpJFq2Ulxa0jgPTZL1ISqJAjy6WnkLjTYYs_PP2N94NRvx8NjJac4AoKuVX9VKyyH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx001L1mlsAj9CpD4chJmLf245jvU4mhM_Tigw0boxgA&oe=6ACE5263"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
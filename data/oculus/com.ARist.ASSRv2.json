71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVdrhr0udukQ7kNvwHAYA6Y&_nc_oc=AdpP6rUJl-JfB7TaX4rMWW3VSkH6PsbLnbQao2lCpg0u_QENRbyYH3Hqt4QnbRQECWc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-fCocJw8nSpJrLF1SwJgRiESZ_rp2n9KUt1FaoXxVjQ&oe=6A0C7427"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfS0S3XOSzoQ7kNvwHVxJva&_nc_oc=AdreMDN2EfgUPEZlBDNJGI8B44D6p6KWVeGqTu25qboqoq8oeLJ1QF6fPRjTlc4M5GA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fcEL-hYg1HDpyA7RbU0KUswUl8H891X-bKNBEiVHNQA&oe=6A0C8392"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk8AGodMs-IQ7kNvwEl8XQq&_nc_oc=AdoyyUBbc9UfWpG2kFYRDLzbY_l-5opTwHK-A3KnASSwRyIXlfU_aAD7ibhIJqKQ2SA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bqw403jACJtwm5qaek5ANF4vDj26BAx2JJICfTzzFZw&oe=6A0C6DA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oibfiE595YQ7kNvwHIylut&_nc_oc=Adqk5zW5eymkpYt6HeimcFmtjtpUbmcDT41HebGqOupAKX8d5pjK54t-A7JziDb3EV8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zhmmukZaS_Sd4RYdMgirp-ei6Z89zW1Vn8gaTp8itbw&oe=6A0C721D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIKtVgGPFJYQ7kNvwH2Rqkk&_nc_oc=Adq7X3diahj9kzOygxqrE7hULYO7S1n9M9ga0cYQbfrT5BpB67QqdTKqO-IVNGW1axs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rTGObmhnik9fgPXFcb8rt0I9JcFOmJYSaRpb-2boBbw&oe=6A0C85E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dygOoCcAseQQ7kNvwF4NlFY&_nc_oc=Ado1tCTd8GJaI9f_3cxqxo8Y0dJNZxO_rSRBe9W-1CzYQnCSckIVbmh4y3F4At5d6_I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA-dHMAw-7k0Bb22XMdTRE7LWMZsInr9-KnA5iDGBgog&oe=6A975227"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gouNVjOIPZ4Q7kNvwHcPQ9n&_nc_oc=AdrEhUKpM1b0F854w2il_9rzrJH-GPA6GNgjdDt4Vdy6MCgpZrxDolvNf1QFV3D2mn8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGNxH28hQCDnt3udmASvCB0m5tNxvs_isBVU6b1RKR_g&oe=6A972952"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oarYBiQ6qlgQ7kNvwEd8hCw&_nc_oc=AdoIsyCXNaehUo6mTcDRWLA0lukVlFPOFoSeB2GV46pK2mupKWF49KiiChoRxOeLFD8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeieLr2si8EXJYweVeOM4aMiwQ8r_lOmgNeKQPCUn8FQ&oe=6A974BA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFVA49LLtUIQ7kNvwEYxGou&_nc_oc=Adp1Enu_jx2q88Bv4ljPSKeRkLVLR6V9Vhbl5cnhbPih6zOkUuV4FXSEMyswLIGnhdI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3ujkdmyTOHiP_op8giqMa_Zaie_X7K0enFaXLZsOnsA&oe=6A97501D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLhfVNBmj38Q7kNvwGp8FtN&_nc_oc=AdosbbcdVLdB3DexNQ6OzpCB0OLemqQ2MzLO6By4kp11rCy3DPI5BDdrU-vq6iNKX6E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkV4ZHr61bbDHvXjCiyP2Ym7hzTt9m859njA2NEn1YLQ&oe=6A972BA3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylLF20wFRMMQ7kNvwHvRfR1&_nc_oc=AdprhqIOZE9xpNtCRJ4D4mrvqRBItSE4ua8TA1GgCW0rAHW5JrpEu3te0d3nCUb_ULw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N3_HUy0Vs9DTc8tO-VOSXdnJX_mxG93Aiw3PuSnLF2Q&oe=6A37F5A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VS3Cu9trtagQ7kNvwHs3qDL&_nc_oc=AdpJ74MYQbu6qht9s3xRhHRfIqZ1BZgSXe9TnF8aXZ62bGSk04Tu2sPaGwYiNhXueFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fe4pHA8NVnoyaESKL4UelIRaMB5rkDtQq6BkqjZpNeg&oe=6A380512"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnMcI7Z9bwgQ7kNvwEuA9YE&_nc_oc=AdrMEVc0KNuHMudd9ItqbwvrCh_4Tsv_6uYTPqU4xS53-w-99DunTUNrmyDTLqQ9hOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nzgeSWjV_GUnUiH_Ub3_R56GXxfEBh2F-0g4MT9wyuQ&oe=6A37EF29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHCeJXFpCTgQ7kNvwEA-icN&_nc_oc=AdqcgKvaJRXhr0VvwwAdYJSFYxttNfTOAeYrPVz3mZX69QcFViqp4H0MWpQcorAfscA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pz-QEExf3lmRf9g6VkyY9xKABNBo9R06-Sc86jKCm9g&oe=6A37F39D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzpBj6YC4VMQ7kNvwEF_f_4&_nc_oc=AdoQNPz0r3DOTFm2InXmEOcbqpsyA-Ay4e6JrD06o-EWJHppGOBRAHh959NDVtQczgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NNIDOQrT4vPtJRRbtPNGr42RrBL-ojxuvZw4qlK7yGA&oe=6A380763"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
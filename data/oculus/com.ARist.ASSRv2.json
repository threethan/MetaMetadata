h=00_Af0hRk8kng2rWTi-gbt4xQowy4GEfTuRlK8P6VQxwXf4sg&oe=69F0C4A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYKQQGuHNcsQ7kNvwGeFWHQ&_nc_oc=AdoszjgMFU1Zk_-Mawc88mef9XBtCYEMbpKOgCl_YISZIvnb4xMHtAfqnc5mjxaYvPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3ZURlfiNXYlx22GNfoDNCQBqbZRfPO8clztCAhhVoBEg&oe=69F09BD2"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-VBosrjvUsQ7kNvwHrpIbs&_nc_oc=AdoowrKg-AZXbgXuYxvjO6bLEGdiIHrMg40OCkQj3FfWS_siPlUef6nVL00EaBWJWH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0L1_pFWyTmDQvnz7oo9bkOaxfIB_fkBnyDvyDyHw8Hlg&oe=69F0BE29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNkqoF1IoWEQ7kNvwHvBo4H&_nc_oc=AdrWvl7P6I1NoCOnqW-5ctwnBFasYhA2mJOy3Qh-2orvUdcJDTABOLaCned6zg9-yzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1zjmF2sgMQGWdDerPOrQ_Qza1Iun7APq6o562mAZRUlg&oe=69F0C29D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZLBpUvyCfQQ7kNvwFrpuXP&_nc_oc=AdorRAKYWKSxJ5-nJp74lEcS666brl9ArzsPUahOWzmiYGx30GxAw3uxeDSNFltLh9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2AoF19Grbuqy2ouh59MZkfDRckJIr9-Ym1fho2wnKfpQ&oe=69F09E23"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_RE
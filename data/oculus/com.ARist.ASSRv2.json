71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtHLPOqCKAkQ7kNvwEgqOXZ&_nc_oc=AdoOze_YFKig_V1g-kw7eEbWeZ0lGgHILO4FImBZcWkGmByVAFlCr9ZPPJwts0aHTxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK5Kf9TwHbpSdsSJ7tDO39W7nJs3NhSNp540MBmnkoGQ&oe=6AF9C227"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yycwDJA-GUQ7kNvwHJ9Nqp&_nc_oc=AdrveeU6g_CXMozpxh5hZBsJsgeKeouW1j-4s36kKu8OO_QHPhn32bQ-eKQBKwwq2BE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4BBP2DB3k_b0Hddzzjxzp9fDLRiNIRcBMd3nl3CM94g&oe=6AF9D192"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpsRG63FEb8Q7kNvwHYqDAQ&_nc_oc=AdpweTNvh86RQ7pM2d8Z-fsOflDzU_lqbKm1Iz533RN6POWSVMBCHQ2vc_Z9HeAC_WU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3o3G--cQkwXY2IyJAjnPbah9xfPCu7eR4IdRd8Hykdg&oe=6AF9BBA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJaqS7paSXUQ7kNvwFfi6BA&_nc_oc=AdpIWVyvAWSj-1NImhUc8JmJGiG2UgazQbfX_qPgpyVZoiSYEIcCWTKuiUTEm6oEM9E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF2cI8_kpI7-tSDH5OvgfNla7w7S9aaK1H6hx54671lA&oe=6AF9C01D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOIym9m717QQ7kNvwEfFmy-&_nc_oc=AdpwpGltHvJAMfNBd0_1hfR6Pc3LUomW6mpCt-4rpA4Pa6VApTUH5oEBsPVYBLrj-zI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-cHhVFVfHPfxyDqGTmx7PEXpdbVk6hQyBYGBdpgFuYg&oe=6AF9D3E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ5AHEJRMR4Q7kNvwFHaGl1&_nc_oc=AdqxGlzO39VP_FmHlZ79FFT3B8B6s6jbDTd4gCFrpGg6HpSX-HehliVHEjYrldTOYhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdksfW7v-NgVO6CdVMDhdxoEOp_lWgFcveK4-hRA67kg&oe=6A5799A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTXw_TIU9ZAQ7kNvwGKCrQR&_nc_oc=AdobvldzJaLqmmiVBdzUh8uwr_sdCIfSYno7N_0UgHF_RyE_R9oiBhl9LcW2XmQCSsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUdC4s1x-ixBxb78dQDg-pLN-aGnt6PFTwMSBX7gBCgQ&oe=6A5770D2"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5u-ztK0GWsQ7kNvwEygtZ5&_nc_oc=AdoCQXLcJIoaZi29X2R3uoStgkYAQWBVRLqVVTVOUTpPBtzUWecpcvztfk41Xow50H8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY6SXl8FjXAbh4iOMSDz6SeiYpVp98FlqNAHDafkTGmw&oe=6A579329"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AG0FhuG_FCAQ7kNvwE7ISTe&_nc_oc=AdpMTX1l5pKSRyIXBXRHDdow4K04uRUjSYmJJKB1qhtXp3P_5S9PU3kVDVbg7HcL2ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7M5KIAjlU201djLkDBOpqOhsBE9biQ6XLuNxA8oV8CQ&oe=6A57979D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXiiuca5PqQQ7kNvwFaWlTB&_nc_oc=AdrWz-BshOr78UvgtMNAbXyQArl5VKK-7ijlWN1guKNwZ5vzwT8gDMKzwXGo_vsHDJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBppvUXARPsPKre--de_nY6IpxDDJ1Mp0x0O8gWL4wqsw&oe=6A577323"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
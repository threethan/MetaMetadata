71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p85W1dbIyXYQ7kNvwEdY6tN&_nc_oc=AdpjDiLNdt7zyhhA4t0xmX0XiZkoVpNhUr41Pqz-qC3aJzNoVtOdytvuQduDDEwLquY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB45-rOGlse_9y-ndUbCRfIqXjXS68bW6NiIjf4mR6OAQ&oe=6A6F54A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Tt0zxe2DGMQ7kNvwEJlkXB&_nc_oc=AdpR-iRw-TgrCokelVC5JO70m_7aYCJgnw89zjHkdcKf_DOJi1-Mb8BozyX9zLkGlQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW5RS45LiDv4NHGV641SaGuHQQggC993efsoHb7wDTVg&oe=6A6F2BD2"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAa_5lU3DDQQ7kNvwH92KJB&_nc_oc=Adp0eRi30KqRP74hF5T7qH9R2Z4ouuC9ZEoEgMhxl6m1050pubs4LyqkoTyoJ6fNVxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYAAgn1Mpa-EC-ZBiiz0e5vH6lTUcmmtCif95aLmP5yg&oe=6A6F4E29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg4_VY4NtToQ7kNvwHaDkPV&_nc_oc=AdqSfz20KqsOvhM8Lq_TcBBHGkQDmPt7Q0Ca-k0dtMB1ukdcTarsTzgva1ayRcqUFIE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1F0V1XNJGhpQt_ionSL86PWtb19-S523f-HT168owMQ&oe=6A6F529D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw7Z_MB0KmgQ7kNvwEsmERN&_nc_oc=AdrAmgfNwP64n4lklevxUfWrYcwFBNWTy7pVO2TIHvW0KoAqvSGPIF4iBKxjXc8j2ss&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHo2DvD-sR_ewLR8p_YsMwv87Tcjh8Oo8qpF54MuK2CA&oe=6A6F2E23"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_YCZY12YSYQ7kNvwHnpo3C&_nc_oc=Ado5FbyINYBD2xoihzjKg2Hm80nlSUhLb8akoNXGd-6w8stqUUDLS3GCBSE1wGpewAU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHMuHHz5KChiTMMkfaUMB7OZtJZS6YIEGp5NtNZFj2Zg&oe=6AA01C27"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNQ4yLtCOP8Q7kNvwGxuQtc&_nc_oc=AdoDgbYQLONHTewLeYhkJH8oXRH5DqNiXyfgSaJgW2RjETYSIb5KkA8LhaMpidJLu_8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICSwVcxh8Zh00PuDT8dG58EOXlahc-GAd2ysoUhAFrcw&oe=6AA02B92"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUOCeYfUSZMQ7kNvwEY6Csj&_nc_oc=AdrEJkVzjS8njTJzQ-pLa3km_GPZQ0ifPGSzh-QTRyr2sR3oIUrJRm_yiic6ocpLjw4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDGXMEuNzvr0rM4T2N7cS7Yp-prOnTRV5N2Lrp2Z6ZUA&oe=6AA015A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2msjdD1kJEQ7kNvwHXqY3p&_nc_oc=Adpd9GTxKGQly8636x7bIbP1PezdawURhoVEk1fm9gVVO9oPJk_osVXr44z-zcSxe28&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfV4UoJ4_sJJqCvV2JLG-EwwMB4lJUcBLfaDqcT2tSNQ&oe=6AA01A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaTT-XGe5wcQ7kNvwG-wyqQ&_nc_oc=AdquRxcTSNxXpP8tx3__WgLxwbmE51Ssiis8NimfUJOsLXzoaBa5RF-jAcqfp1bCLXg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpmiWBhUu1aIxVQ5sLryNRAzBHISYj3SevHLQ3KTOv7Q&oe=6AA02DE3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1ZNyUd2w0gQ7kNvwHXdtlN&_nc_oc=AdokTkVxLAhD7_X4wUSWxcqQHpzfcUtdHotKivZGAIBJhn2U5rlI5ZDrLx5X2nSWWKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhbvr2MqiGRioe_74oVd0gamgWSkfVjIzqqDJ1Kamdhw&oe=6A5CDFA7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXlHrfS2xWgQ7kNvwEC7X3I&_nc_oc=AdqVJs0YCtmIlz7bwvz3mf-SS3wlp_FNtbX4yPByFvopx9XJqKCwAV2UAwdU5qikkt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKWeV3qMusEPVNnztWXwYmhb6lWYcczU7V4aj_rTwg5w&oe=6A5CB6D2"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43oTOTy1PeoQ7kNvwEjrTBM&_nc_oc=AdpBNGCmqh0lskK59SK5_GrZJ9ASRsrnKRfF98oafllJc5g13j_Fjm2gxEoZh8Jn7cc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-sBXgjeT0-p_0imxQJ9FJtOG3FhLUH8kQMIVlQTNrMw&oe=6A5CD929"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpBq81Yj65EQ7kNvwFur8uF&_nc_oc=Adqfw9zeNOqd8zs_ib-jwqVwCJ8NA3jK6f2-TrUSCVGLtmDfr-IEhAbYlRr3XBgWclU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA48dFclGuLtdP2xsgVCzdNGM8zJgG8reQNtimxPtNZkA&oe=6A5CDD9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=780xLp7sDBgQ7kNvwE36CV0&_nc_oc=AdpJt7EGmpjs30G-yk_tpjIoVt15U5wV1n8W3q2j3vzKWeeZaIwwbyf6lFsnFx_0htE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVaYkCmxqYYHi7faThwC71n9BAHtsdVAtwcSvBAZlDdg&oe=6A5CB923"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
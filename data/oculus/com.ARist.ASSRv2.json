71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwWiBAAtdh0Q7kNvwHl2ZWA&_nc_oc=AdpMN17YDcsvDDmMvtHjxuUB4OgC9-sKrF2xYHzw5x96lcsv5z9ZuL70HmM0v9f4ya4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MqijnsQ42ZtDA928tteSrtjFE70ZqK4f0xFRECCyTRQ&oe=6A1068A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GKSz0xMECcQ7kNvwEeOCDA&_nc_oc=AdqS4HEYip5SC-BwS3B9kdOetvAr26JFliUtvSGpUP4Bmh3UlAbCC4ggoGqiOmdwxpU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hY5paRcD9Klg132GUGDYcEfEsjNfrb54q-IwUuZAQ5A&oe=6A107812"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H2YfX5B-hcQ7kNvwEGo5v9&_nc_oc=Adpj-3ltBfPEAQbwMp68ZYI2AtHDghEqNEoDrVY0WUoKu-O-mUaHtqPpqg-h-AvXAAg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-KC6OwCfz25sLJkM6IMN_vyHnYZ4Lp4414VARDv6fzg&oe=6A106229"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vmx1S59oQ0Q7kNvwH3f-ZK&_nc_oc=AdrPqWpLUvgHnPT2Byumvlab8ZBiqH5v3K3twgoCk67m75815TzEKy9cHcGc93cVuvg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LU4niR_zxa4k285HFG2YhGYrbMK2vNbwmRbM6lfxnrA&oe=6A10669D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0rVCTZZ6hYQ7kNvwGKd2Db&_nc_oc=Adrew3rV9skAFtu8GJNCBz7zK9f_25qQEQ2YlVZXN1wOPU5xtoA3RlZST_uSWTnjI9E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52vFTYbj_zT03-YNUK0Z5lA-QvMgiEMpD1qFJrhIxNTA&oe=6A107A63"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
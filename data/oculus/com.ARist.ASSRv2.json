m/v/t64.5771-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zDMgd5oDN0Q7kNvwEVMJC8&_nc_oc=AdrrktREg6KbTOhqPKutb6oGf5LNjt6sWbp1WksptqANvdrWkJxCU-2WzVX5e9ktVJw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1A2SYBHGYQaerMoiCL4CK_no88V6BflsXYr6IhrnEOw&oe=6A7D9CE7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17VeVjUi3w4Q7kNvwG8rzJo&_nc_oc=Adpmwh4yteW1Yz1u27xTck2OzuokWcmFIAgVFPJ1Ds2r_T2chox8RGuJ4i7NI8zugyE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqRGWonL30Vter9TA9I5rDUR9_jCHbcjT5Gs6q_lq6vw&oe=6A7DAC52"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSW1A-GNt1wQ7kNvwGCdQTL&_nc_oc=AdpWDnAoFV8PuCdYABN1ug6cdU_aGgL5TCQsU1BvzbIufnvYv3lCdDFRUIHDTIpF2XY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYjA3a6gKUs5IviXiIWT7xsBIhjuABZfExBUD7I0ZrgA&oe=6A7DCEA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h29ivY5ebVcQ7kNvwGxnFJJ&_nc_oc=AdqjLf2qRlQcsC6O76TZOt5zlX026pvmYQ7sQJGGNKAUvbx-bDoWVEkJ0R5uIgJz8bk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9OMF3TSJcGHUD4_2_xX5f6A62DP71n60L__a9qFswKg&oe=6A7D9ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GduYSbFl6OUQ7kNvwGMMXw_&_nc_oc=AdqSVfDjF5pzrvMscFB2kerXto1oxqaRydGLazSjSFUc-lEDaDgj7bC0ch7b-yp5KAg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvMnI0MjqZCadPMWBX4yz3p03QKvsB07TtjdRp9HgYZQ&oe=6A7DAEA3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAbfCFhfcfEQ7kNvwHyFBWp&_nc_oc=Adr8EnJee_MEA5Z8o_fDxLG2V1izFtOqaWJsd0E4faVDfvN4m6s71efoFUoH9TKMlYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQS72Th7wESeZYvSA29jjVSoubiXasT9aHM401ww2soA&oe=6A897A67"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krbi8yAuIBIQ7kNvwE3CvIn&_nc_oc=AdoedkU0ksmdMudWt1S7B5oAM23uPAiuYCK1a7e7ZG8pyeyviNI8EYKP4hHRIY4YCYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP39SJWrnrSu5wJ4i_yxoE9yFXuniO10gHN64H7dH6iQ&oe=6A8989D2"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu0NDddaXFEQ7kNvwEWm2-G&_nc_oc=AdpEBP7BzHCJru6QlA6MbbKw4PHACwWLonFiRHewdZ1LuRtbWhUombN4hAnnvkyh-pg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG7uvKS1shoOoBYZiOfPtfaBB4p5sFx6akIHHL9uhIDA&oe=6A8973E9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCxX0UyctbcQ7kNvwH3puMA&_nc_oc=AdoSCFy0iZ8xtlTQTbz0MeVNhaMQa_0xDq0JgCoo40AEGkCsJz1IuDfv15LkBgGDanM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF4DndLzMupYnAbpnMnNAVIJq5NjwdSSYCiRJ3sbMm3w&oe=6A89785D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLnDf8LOnJgQ7kNvwGTT7Uu&_nc_oc=AdpD__HhBXEs7WuYhAccEXHaXroGz680UplLUZ0qaLcJCxZmRLSjP1-JqJ9lx8OxsR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDI1klXmAg25PLi9RFgVDS9usS9KAqOoqqVVqR--yzyg&oe=6A898C23"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
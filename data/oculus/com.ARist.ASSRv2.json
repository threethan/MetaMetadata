71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT5D4b7C7XsQ7kNvwF_NiP2&_nc_oc=AdoaR_xUvisINdpngyQ5ame-inz8d6Y7s2X4ty_JrNs47fncp3NBP9T0HCIWPEK_JKo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RvmNExCoADAQouVDRyAe5LQVls8LLjUzGK48EfdMnEA&oe=6A218C27"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yoi6Eq2IzRwQ7kNvwH3uYmI&_nc_oc=AdoN4wcr64g6fU3KfaaQsnsh5cvat9OpbYg07lOewI8XTRLm5JB2cVuGHecanV2TmDE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AlRBDPDI39dnwlGckfZb-0NwmQRmvW6oDqDVwO5m-OQ&oe=6A219B92"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSi_OBP6xD0Q7kNvwHR0CAX&_nc_oc=Adpt2dCHWL3VO5trhaUkfbeUn78cvuMc6RGIGHDMrCKBt904oEGGagX0WlrwXhB2CBg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xns9t7tm_0t07yI_QY3-78TkNde2UzS69QRG6n5SyZQ&oe=6A2185A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZERohdjsGsQ7kNvwFrQOgN&_nc_oc=Ado9NmSYv9OVrzpmZY-6ZnZo3MB9XstfyOgoLya-_9p8BR5VnUDKr9S_oGtQRjD7yDo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CDzYjSyXMoM5zIaqNkF_uhW0Tg9AKmJ5TeG7dOSBRvg&oe=6A218A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJfG3yCl8PkQ7kNvwG6vlMO&_nc_oc=AdpBDVpLppfuZjLsFtMPl0FGDtUYRPdyIKBn92pmSxWyXWUKrILgIcyWqZBXkOxYsvg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DQ4Yzwg3smw1eOGlqQ29kpn7bZde4udfl1Y7CrCzfUw&oe=6A219DE3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
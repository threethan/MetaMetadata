71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2eOcJYn9WEQ7kNvwH81Gdh&_nc_oc=AdoDSYTms5zj3lLn3acVR3z3RjKzP3mEbDNiKFyBhexM-kVe90I4DXxjNG7e_HTjZ4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F8dUaKREuDoAOP-xIwXYrVEtm3P4Kac-xIJBnzxceqA&oe=6A01E827"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlZ3wbywfG0Q7kNvwGEvgDZ&_nc_oc=AdqYobm3xhw_HiRzhiFCBO6TyiK7dJ8X8WC-sRE6Y4l6R9bV_AFUhipvjz6BR__pQn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F7mJYurWnETnBzL6GnQr0UYnV6sEWKaMxy1uoaLLEAA&oe=6A01F792"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7h_BEwNl1cQ7kNvwHxLw6q&_nc_oc=AdrwSZ9Qig1-Jqu9TQ5g7WgVs23NayfnyMA6RFvXcIOv9XhFh0dMhnbkG31aU-CpV2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77LZ2dxeDs9QkZ3eTGpus5eSBnUsf_4P4BCQeDVV7Ueg&oe=6A01E1A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiQHSEi7Bi0Q7kNvwHBMXH6&_nc_oc=AdpOHFKzVAjimFrpXeP4j8uWWQjidLDguTaoQfDjRxuGNAHhZXxP4_Bn3ZoE3pVu6Ts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41wLhHjT619_DVKdQbN9xT7sUxU9p69ZQfBYBoZiUf9g&oe=6A01E61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1osU-4qTd8Q7kNvwEX6-OB&_nc_oc=AdrLg4762RhOMaVNJwAv-ZFoD8hZKDC77CRXPbm25qLgzWz8kTHmiiHIdpxhARXVFOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64dZ0EVQj8Bub14O4TT2HMywMEKMGxLMAmaqtqYNs-xw&oe=6A01C1A3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
PFC25COW0Q7kNvwGgcxcH&_nc_oc=AdrpqrAwHF7KsQlt23MbQfMAxlrDmhq1W_1R_YljOEqwynuQfK1HKrbnWDWh7p7YX1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRpQXMDbZ5hQUwVMZR9cOaD-TNybKTVxm0BD_ftbMyeA&oe=6B04845D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYJS5uGthJkQ7kNvwGouhcS&_nc_oc=AdrTrXAq2JsRzAcnl_I-auIcFuAx2WRRwytIf5LvvvVIICuw-TisckEJAFEO8QMfpNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWGpYLZVcI7q5qls4ULdsRLCvAAUWjqWlP4P7qZpS1Jg&oe=6B045FE3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24549815538034895"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618093_1126890246262773_6022398695282555560_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDNma6OavUYQ7kNvwGZEY__&_nc_oc=AdovAi8z4mxSerNfSYgjY59nchsKUWGbC_WPanx6yaAoshFNHqge-sx9XeWewCPdCqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVFHrQCa87JilsK52NL5OTgPLIopExibC7icCezlXgsA&oe=6B045C3C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ARTIST SLAYER / RUSH", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_t
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAbfCFhfcfEQ7kNvwGU2Lt4&_nc_oc=AdrpxQpUY2omPrg5i91jrqpWJ3-tt3z4NPoWYm_W-_fbP9MhI75O4Shf82XHDNE8oN8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFln1N71hC_0tP33P0OcyEfKTbroIDe25puTjLtG1HRpA&oe=6A8ACBE7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVF3Mf6TERcQ7kNvwH-b8Cu&_nc_oc=AdrFVTjQ06nWHUXgPL2jgZpEfaNi4wSLeVidUJP1icHEG4jBiXap6miftrWdAg22LMU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHid0D5j9wOWBZPkirKCI4S4zg1rjrWG1YC_Cdw8E6Syw&oe=6A8ADB52"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vu0NDddaXFEQ7kNvwExwN0B&_nc_oc=AdpjJKzB21qKOyWIiQuQd2e9KpZjvR-6RevKxT32IgyuO1bDUhuYn_VIy1TFzBTdXEM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9zyLUJaV3Zo7JHXMmXSwoTm8-ADQlrhNQAHJ0M9g0og&oe=6A8AC569"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfN1_q63locQ7kNvwFYRI7J&_nc_oc=Adrcj-8AeDUGrM_aKDI32J407rYLdVYhh5uBM9qOmU8ElCep7Aq8XE-MDOKjx0b4W0U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ9zdTR-nWlDQ9GHCaWfT0p6EUc-lMf16z61zmQxz5Uw&oe=6A8AC9DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLnDf8LOnJgQ7kNvwEYBkjX&_nc_oc=Adp1Qgqr2C-gnrZGD6HqagaEWvWM9tMB_YGoKPR0h17GBwJ4-HygkULngAX2LnAecTA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfTPKcxPTTKWa_kAmhOKB3Ciom_yATkVRvOsdkIwY5Pg&oe=6A8ADDA3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
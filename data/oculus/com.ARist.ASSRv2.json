71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtHLPOqCKAkQ7kNvwHOi5e3&_nc_oc=AdoJ3_aEYf1AVwTLIlT8pdMT011YG8RKbBV4FGDggVW6NUclui68KPtYZ4TqJluippU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqd1G39AVLvfywKydMZozCKXE0vKD__A8dBarcdXDvsQ&oe=6AF8A8E7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETF21guB5UoQ7kNvwHOAOsZ&_nc_oc=AdoRWfqfgX4gf7NTXdXaY20mqJry6XCYyXCNaKchL5TVCf37J0KTMjxXFhRAqrdl6VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtvcBcAZm4QL4ubwYyUFrOMZL7SC781P3dsL6EMWEZkg&oe=6AF88012"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H31s0Lkc8zoQ7kNvwHCEzdE&_nc_oc=Adq2f3W0UW8BbPsFJyRIIlWOiFWmVHoYwiLYi1EbssbToPS1f4Qlj1CUnZEJZ2ds2yI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVTmZaP8c2Z7vnIVBX_rlNd6bAUd5qNRvp60TZ9mW0Yw&oe=6AF8A269"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3Hu_Zt3IQkQ7kNvwG-ieXy&_nc_oc=AdrwQkzIhviBqaPLVWTl32WqdeJJiT2p3Go4lxZQRzV0DF9YyYGQ-nHdY0SaQanbmcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGFa9Su8otl1QtvaljjprHYf3d_VN1eH-3cn-RopKvSw&oe=6AF8A6DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOIym9m717QQ7kNvwE9nbI2&_nc_oc=AdrxhuPHpC6YgPmTu40L9-iLVBHZYLToPW4vTJwFe8Z8aCoWeeHMkGWVM6gnUYqftoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ7ePYPEIrSgAlddQr0cg4FcgsDzLxho4B469G2YrzgQ&oe=6AF88263"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLa32F-tR_oQ7kNvwG1T7SA&_nc_oc=AdqxwkcfW1VrjWAZrhhMHbAqcNa2VjET3mgddqmh5Pv6Yghegyxkjlv3id2R3S41-OY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFCEWLTxM0ubOcBGqecuMGvIKU7uyCtskQA34cT6vumA&oe=6ADE12A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wow_4tij-VQQ7kNvwHM1zUx&_nc_oc=AdrM-eSH0Z6jVNHPzwtlwPfiSKIMbl-OZoPrnptaFsBLGa9_nyW9ZZKB_Pis1N1hdXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODe4FzYm26s8Y3m8FslI5kjECF8chXuz9QYaJrslMyeg&oe=6ADE2212"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Pq4ul8s_EQ7kNvwFeVHCZ&_nc_oc=AdqtGRG77jgICE7LLMmom9nlK61_NistRC8pDHMer146nrx-IXxLx4DHYCO5yxCbCNo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzr49HD6MGj_HdMirQTGhzbHIQfBTGR9AMS8zb5lxKow&oe=6ADE0C29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xIEn4Dd6AsQ7kNvwHFRRzh&_nc_oc=AdpDvj6y2X3-W9TA-Zt68kBf6P3pxNO3pwzfidfhclYlpPleV-5WdPM7W7z38TWn1HQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyEDcxZ_zw_4ZwO9kS8wbNScQKAmQzgJhdjZr3aOMA0w&oe=6ADE109D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOsaDmC-xjgQ7kNvwFbu3Ld&_nc_oc=AdqI42vAFImLC1lCzHbIOFlJSOO7HHAgOWS-6rw5kOzYtBdXKUdMXYXPlRpOyBEvvd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxP0LTW75XEpGgqf9w0AXOk_HDio6iHhy9O1q8R6yHCA&oe=6ADE2463"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
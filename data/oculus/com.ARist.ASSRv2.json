71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ5AHEJRMR4Q7kNvwHueSSO&_nc_oc=AdopKNRy3eevwd9ufQBI7V9SMIlDE3DryIJOzV7xXhdMzPsL7UNfK47juI_VvijWF54&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb7_y6bhXmsb74Sv4aeBM618VIHYFCZmPfrJtIRVKkxg&oe=6A564827"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJlUwuXOfUEQ7kNvwHoKUUd&_nc_oc=AdoIY4QTI7E21Godb3jeJcDmczbiqinsuysTgf2EqGvXt6eYlXZqXDuqxPxeYbkBVlk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADVhMTQZAWpOHa6wciMbhs3lkz0ZraLOdTAMJOxl48cA&oe=6A565792"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5u-ztK0GWsQ7kNvwE4fR2f&_nc_oc=AdplPEvlIYxJ-FyWxX1AgMe8RAM7zDAACahhEHT9RASF2T3VxJj8o84N9gpVIZ4D-k8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5fIqUDJ1uABnUx3wE49zyEiJf5L9GOI-TF8_QeUWtAg&oe=6A5641A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNCdUhsVLfgQ7kNvwEiC6MV&_nc_oc=AdpjOV4F7VccMOtB3qePc3PGMSB2esj17UwpqIPQ0D7bD9Kr0Xy-bvWoIphMEp_2huo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0fD5761LcN5xsmBcWH-84H5iu0C3QT-dKAp-Ivms6ig&oe=6A56461D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXiiuca5PqQQ7kNvwEx2aIo&_nc_oc=Adqt5HA4DSD76qqKmM05tXU-uaERmALPtQXcVxJJIrVz-ODQeIYiBK8CBow3FD8-suY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGwgRtmdhAGA9O_OCsJiLuMkOtGU-1iZBFxY7gaEY4AQ&oe=6A5659E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
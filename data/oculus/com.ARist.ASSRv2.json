71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg69jVJwS84Q7kNvwFMEkNN&_nc_oc=Adq3MkueyUqA8ZDI_eITcZZgUyjHcWgX6O6xRha_ev4L-QUZrdp_FlizBDdycWi0QMA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMozody3eO8KkzEm7F8lHeiMkyKLnjwGTdvMOwgYw_nOA&oe=6AD0E3A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1RgyvTw63sQ7kNvwEtB4eN&_nc_oc=Adpg-kN7t73paDit_Lpo4jk5GthC7B1IUQMaNXpQK1kIEYbJ3ZjV8G0bK3L7OUNvl7k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5Pk7wumGTF15WmIx3kSDeNixAc9pYUjBZlAqRpYhytw&oe=6AD0F312"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkEp16Ky33IQ7kNvwE5FhcK&_nc_oc=Adp742fpRucZz3Ns6CPb5EMOyOGzpgE8iyaaUo-l9mYMpMKVRF5HGqkF3VUJl9J7VZ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk5R8HYtoBIb55gBxE82ixr8o0uC5hS6PR5Jl3op07zA&oe=6AD0DD29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oPU5kCgy3cQ7kNvwHynNDQ&_nc_oc=AdovrCgLmzXqhRu9xF4CGd_LXPeGiAZjrCh4J_gFmIJZpOQvGJx--ixRXMMplxcXzYA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrPXS1Huu2_L2Vqu_fv86BMR-R77zbMYiiM3MjrE4V6A&oe=6AD0E19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A66nlr7X5ZQQ7kNvwHAQWbJ&_nc_oc=AdrviJso-vvk_Ioja2koCBgKvw1D78AZeaXlS7cRQoMWW5koXFVao_eaga892JzU0Co&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNTXf6W_sK4C0vaKI-0aYNjgEc6hvRlVIBN7B_8tkKTg&oe=6AD0F563"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
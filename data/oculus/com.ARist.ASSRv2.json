71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdqp6yA9iYgQ7kNvwEb-o3a&_nc_oc=AdrTnQ0tHspTvpHsCNMwPrf5HnemuIv-4a5ia1Ga4I4e7LHS85vtyRZI04_YIeSJ7FQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyyFGHzPoHu-25E53arWP1LRKtnLhwPm-cq1D_lEm_Og&oe=6AA2BF27"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wELE8v0beKQQ7kNvwGNarj2&_nc_oc=AdouJjm8JjStYFpDlfTf39Y0j4nWp4Aqq6bOYiaZlBFPMoqZvZDjYApAQyEHosjOaYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr4no1aTuD8bvmQIq2O-yiW05kTH1nIfWoejhaFIk16g&oe=6AA2CE92"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUOCeYfUSZMQ7kNvwEJZaJr&_nc_oc=Adpb2eIv66FD_25_z4k0IGKTkz28UJ7JHgze22lJaLxSfWq0KQvj8r_nCGT_TS8ip2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2inHDW9LuczgE8gVTaU4YxhWb1HRKS4Uikuy7VfhQZA&oe=6AA2B8A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LxQ5bB_apEQ7kNvwFfYHNB&_nc_oc=AdpVb43Fzw39HA41I8ycw15--LCs6sCoaF8bgOpCbFySkSSMDRJAJn8VzkZ0ObGdx1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ7-S7gCz9jpRHW4rVmSh3wUWZOSlF_86ouRRuDubiAg&oe=6AA2BD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpfpFiN_Rc0Q7kNvwHeI7yN&_nc_oc=Adpf0mgnQbpOHhIDoZLm7jpFA-X64Lb0JoXqQLYX0A3n2OhI2zOnBeiKe_c83PA3zOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl8pJRMmv2nNIsGQC3073g2J8RC1131NuzRztnO9V5yA&oe=6AA2D0E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
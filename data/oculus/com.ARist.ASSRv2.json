m/v/t64.5771-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icXXu6ipel8Q7kNvwExaqCS&_nc_oc=AdonjoyS1FmUaxjx5hXaY1EO53e9GPQ5dkp1_bMcnLe3fBakbbcjaHeKHnm35zK21_8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5_m4MHiqEElpcnlzeGNqSiGjyBbq2p8VAqhqdoMofYA&oe=6A22DDA7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yoi6Eq2IzRwQ7kNvwHu2cbM&_nc_oc=Adpe8U4R_H39O9rYMA8saPUgZNc0j7_RJ5pRqPeAVp5-u6EGEP7UPzfcOeT8y_4Ssgg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j8_H3w2Ubi0w-CZic2F6pbnsgNxJIVvYb5BrJ3IXIjA&oe=6A22ED12"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSi_OBP6xD0Q7kNvwFCdbL-&_nc_oc=AdrHS9xYnvBNeIl9doqZ4vAob0DsdJMlzP0eGzJwGclk1q0I2plaoqN_I1yb9JFS6fk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Olca0Tjx9RE7Gp_9RQcrDISbNpOTkLjFIARnSXxSsKA&oe=6A22D729"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZERohdjsGsQ7kNvwGg4VZp&_nc_oc=Adr2adrXOVUipO04rt087NNHVZHJ_wRzhiq6UuaWXYWWmSBBnDWMlvIzyQoH6Kvd6OQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hQdHl-krmQoE_D0ZtNKMdWwVrgQNAYZU8lT8iNWVzCg&oe=6A22DB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GANuIuzCbqwQ7kNvwHEmHI8&_nc_oc=AdpZMNnsAiCD6CDSMUbt4nI2tfP7f99ubhtt3TDaKxDwBEw75yz247jw62OF2yd2_UQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97ltE31Q5B34RZn4p0cGn8TTcUTq-Bf5L34G75dggbCQ&oe=6A22EF63"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE
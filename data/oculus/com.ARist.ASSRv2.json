11-1.oculuscdn.com/v/t64.5771-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXrlBqFr9ewQ7kNvwETifjj&_nc_oc=Adp46WIVkH-gS-w55XgAxMHcIBwE6EXKmDuMwOVwFJzAclsaVCtXfBM-2ELYdslztrI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_xQG0K86FJ0mGyW5PDscHrQuWabpHlfqfnnZ6H-Nj4Q&oe=6A8EF8A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8KNuEo8h0QQ7kNvwFSUtnh&_nc_oc=Adrlf__1vsxrJ9XHcgw74tX2F6nuH4hNkap9Bt_i_EAuQG7H6x1mAfzgLYqkevBwfR4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX-p2k9RAXaTAD-mwvf5i06rg_xZXSOuNbjcbeScRuKA&oe=6A8ECFD2"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n-8s42P8e4Q7kNvwFRHIV4&_nc_oc=AdrKbVMkQvTRl0u4pBcJMo2SXBANWI5ZpQlDNuFjAgCDc9NySi5RCz3tvDiaz9NsoV4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvtJWXtv8sH3ZcBSNnZQTY6mcNvPLKd3OuM2yBzXBtlg&oe=6A8EF229"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO2DzelKbzoQ7kNvwEVf4xk&_nc_oc=AdrAjxcNrL1KwGS8JTL5aYqZB80eEAK1QuFWCjkByp-_AQuhlJ5MA1ib_ni6FQhlL6s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjrica4OGSzvwVMNdS8j4LdRG7dnQwbVJTdTwBc5qcIg&oe=6A8EF69D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3cmcMXAm78Q7kNvwETs8DB&_nc_oc=Adop3NuTrDc7DPJBQnUqZzcvwH2cs3Y0o0lb2XH70YT3BqkVbX_VYTuZw25B77sxB7g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw69Q4lmWKzOTrEE6bmEF1MCc2VORMtiFMq80rPnyEnw&oe=6A8ED223"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rat
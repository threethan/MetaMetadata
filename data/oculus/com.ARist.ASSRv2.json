m/v/t64.5771-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwWiBAAtdh0Q7kNvwEqs2dg&_nc_oc=AdrVi2nnQgalzut05o7AONELZYgXoMvrKU4xH8eErqxqEgnrx8PrxwK-4NwS-Lwrz48&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jyaeZOEDBlSgJT9OH45E4C51RB1xdvG9w2SS1kaAT1Q&oe=6A11BA27"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GKSz0xMECcQ7kNvwGX35zw&_nc_oc=AdqoFukAcDGdqgru6rtZ4UL8y0t_nF5aM8w2vKBerK-EnwxOfZT3DeUkxgMxpFiOaDU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b8PZNXrNwzQ6yJkZGKTeCApoc0bEO_kAaQwuX0riHLQ&oe=6A11C992"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nc7Ja-83xAQ7kNvwEDOmnR&_nc_oc=AdobUTdD6bZUhyCroMGsImpjhLNXqWkF1gfCBK7uKMvcqWYRRvteuWSrtJSjPU5QqhE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GoY9uzWWcXWL3SAAxwYchc4tT1d0Iy6vZgxPaF9Rg9w&oe=6A11B3A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vmx1S59oQ0Q7kNvwGJekFX&_nc_oc=AdppGNb5bhyaHxbg1wl97n2Q3LLYkZKeNQiIzU59zLmj1vwdktB2PDJZKWQVabSiLaM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AuVkCfTjnNUmnMsSCGkBMSAzRzKgmFBY1SyND0uPkCA&oe=6A11B81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0rVCTZZ6hYQ7kNvwFtHkYS&_nc_oc=AdrlQ3pmqklQACXiSE7mGejy2G510NFMQimHxH-66A6HhqEljR0xiDjc6ErGdLTjeGs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78R6nlriUCg-nAc42bYVA5l73NUUb_m_205GUAvLt9AQ&oe=6A11CBE3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE
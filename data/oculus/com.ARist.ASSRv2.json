71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlyYEO2s2KwQ7kNvwGdgh1d&_nc_oc=AdpkqCkrmqmZ2vZ81oyfVTJhYsf7VRwLgPMsH0u9d3H-dNqdFkOxJYUpsApvdK7y9qs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOxcaziS4JuBCGhvdzZkXKYZkE2tXzK4mDxrlZzNTC_g&oe=6AAAA827"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U6VI2ZjR9oQ7kNvwH-7wFA&_nc_oc=AdrMOUZmMY9rtYOaPGo4STZwwf8A97tHUY6P1c3wWUt8yjVQE6XRESNdWhz_CTDPEV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2SzbEqK8mfFI-DQQM24bmV0HR0CLwwvyMnhSEL_xH3g&oe=6AAAB792"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXabVIphTVIQ7kNvwFCSxqZ&_nc_oc=AdqctQuExGYLwlc_h4Kg1wnwjRi3xXLYlm1WDNIbTebiMCJyXHc4DbK5leCvUk8wGRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcIreHJxBIrFnmfuO09IWUXu6KKaSoqL4ouKMamXPMLQ&oe=6AAAA1A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKdenPQiDv4Q7kNvwG8UPEc&_nc_oc=AdpGv3QHV_iiB_6cntv8vkEsc-jiPdf8KIULYq3cAz6QrgXdB9gmq5qT1JdKFlJhQE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTS9hu_VaIZvaWyCb5otlz6SIsAVILtg54vWM-_zU_MA&oe=6AAAA61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swHiAiMKNFoQ7kNvwGSW-ni&_nc_oc=AdoGRR3SNeQji0bxYClbmCOVK4BkfjDVhMDDVKKNh-0mPG0-J323sutTmDbdhlUxhz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJr2hdrQIdeKEF6h_cQa8o9G-QK46DwSxctBZhLw4VKw&oe=6AAAB9E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
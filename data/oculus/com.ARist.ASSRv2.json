71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNcLOgEflKEQ7kNvwH6tZ_h&_nc_oc=AdqG04UQDtpty5h7PP9qB6LliqRWHO4F3Xsvgek0ZNzJ4riD3nVTzqB2hY2LTXZ62nw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF13oVNpBZANKkGciQVXRw-_N_SPTQLnQ42ZR8-enbiXQ&oe=6A916367"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8KNuEo8h0QQ7kNvwHiHmGf&_nc_oc=AdqG8pey07zus0yZSPGmQ2LR2CLljHHmvF6bl3udXQBBAuokXE3qPgLwMepAULLIDfI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb1D1OVuDUos2s6LRRGezHgw4Im-UEKL9cqdAlvFVE7A&oe=6A9172D2"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdyxxafnQpAQ7kNvwF_DUVP&_nc_oc=Ado5Pomg46QxG5mk2Q1rWxlsE-OdUTFfAW7lSlc2DuVvbI8-7oXfUdLjPKPAXBCe0ak&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPKLUy_D-DF-S7ZhH_WImWn88XCu_LS_AChGTp2cx88A&oe=6A915CE9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO2DzelKbzoQ7kNvwHldnp9&_nc_oc=AdqO8PjBg2NFEmrHYH7vDmmwzO5F0zZSlaI7qWfYZOyAWHylUTEGbXBwDZhSHrvAxxc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMVC4aMIIChqFTPmkzTIwPVQOpzoRGxvW7BbgDUYLrhw&oe=6A91615D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIonN0YmERYQ7kNvwE9sAuN&_nc_oc=AdqXTUOWqI_Pvo7rXRcwpMpNb2g56WSfz9EB2MMad4QbXcSEw4o32SrX3gLg8ilJwzk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5XLoN3CKYcJ4kLDxjptQ8VP2X037sYcWkwbFL1VG09g&oe=6A917523"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
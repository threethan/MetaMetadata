71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVdrhr0udukQ7kNvwH5SSE7&_nc_oc=Adq4H_3P7sTFG2-O8gvjzqJzV9V-VD3sQpjmeaS8SlxqX5P_vpGVS_nmwlZsvfW4LMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YgQZDaTRpRWRM1UoI85r9IsRXzcEgUYAFUFKZ65_03A&oe=6A0B22A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXXBdjPdJ3AQ7kNvwH4Fwz9&_nc_oc=Adohf28vdamEqx7tiWrzmovm96usz5C7d_O8nZqWunkS-WKuv7wXUao2r0Hi1vWISZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QaMsdDx5diWZ2dg3s4glgu7r4o3Z14FwD0RSQYUZmIw&oe=6A0B3212"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk8AGodMs-IQ7kNvwFpOPR1&_nc_oc=Adpy1Hp7q4sD_ET672ccpo_hw1axShU-sIQZbWx54tnel8AC6q8BrOfAzNsAG2S1WOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a-iFVyMwuh3OwyG3zBQe2o6gHEVDrGoBPTs7ZgaahPQ&oe=6A0B1C29"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhcKAPI15awQ7kNvwHns_j1&_nc_oc=AdrN7YCWPRx8886xmq5jZlrhcY7PVpvtemn-0EVrFzsEwnmcylB9spZzIC_K9IvdNZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44gY9lYvENTI8yQV1ksv5ctE4hNW3wo6Z0qlWkMqlllw&oe=6A0B209D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIKtVgGPFJYQ7kNvwEWWRbY&_nc_oc=Adooi2fE_rsLl5MfZV4RZ6Swev9IaE7Ehpr-GbpHhgiA-TEii1mXWWMjyFpU6Tm7EMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qpxUn4A22mIX9kiWsbtoHBRcn4OfvBldr0LDCuPeCjg&oe=6A0B3463"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
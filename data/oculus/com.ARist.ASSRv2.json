71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc_uSmlYJhYQ7kNvwG4HLQB&_nc_oc=AdqBTzcwL8NKWdvc9SBgDMVJtv_Vk34qjiyebxahS2Jsb5XAmMWcibCd5V-KUpMwwCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY4Dt2_mNx1AcjqWDtcgIx_Cd6LkJIvBOwG5wP7nLPhw&oe=6A54F6A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJlUwuXOfUEQ7kNvwFRNhEs&_nc_oc=AdrSB5JAopf3jA7ovERNCQ0HKuhGe8cw13YjiEjADSA8eIe114atHS2Jh1bWHydJcBQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFwc3BOy6dxk7F1h9vRgffSEKCVv6xb7tWBY7dybtsAA&oe=6A550612"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5u-ztK0GWsQ7kNvwHqO3gp&_nc_oc=AdrTip97liEHUEmAr7maDgdM7DNac4pf1Fgwkrs511jSTWEk5qUMbw3vtz-5vBUNjlg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9YqN0iZPnl3jB1QJQhz3e9az9cioEtAatznBBaRMhOA&oe=6A54F029"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNCdUhsVLfgQ7kNvwGVqi9L&_nc_oc=Adre_IxUA7ua7JOItCyT3GAzcm4MBS835YOx57q_fp1SUBEVtnqRQ3c-7pnGbRBu7nw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC7kPdVV1yQjIByt3uigzGx0dVNo7ucll5JFuwjW7dng&oe=6A54F49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwI717n6ytEQ7kNvwGjAHSI&_nc_oc=Adr8G9lULulJhK1XSurzvoLlqXaLR1EoeEn_69EN3yicsj9SkS409WxgRMPnEUvcsdo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADlTsPh32t2cheQBVwnK9ZEG2BOYY4YhCAg2aOEqWYfQ&oe=6A550863"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12Pm8aNGQn0Q7kNvwHtDApV&_nc_oc=AdreL057mdv4u-OYZqj2nzYtSOjwzXYdmfu6E8L_OVSGNyLc3c_leXf0D1a73jKiW8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrXXzMf5BNxrA2-d_GLkvksuY3qDU8ko3eLKmRtgUq1Q&oe=6AB29127"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E1y4X8zrUIQ7kNvwGnn7GP&_nc_oc=AdqPy75aLhshZVrIW8ohojcU9fnvUITqx079BohxV758Pux0QMRA4TnwLl9CTu0ZRl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr-cR0a2sMQj0Cybepii_1GSNVyevJrLPIw4gp67T4Fw&oe=6AB2A092"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ_8J4f3UBwQ7kNvwF26QtC&_nc_oc=Adpol9RjK6JsaANEIyef-OVdRb_Vbg46joyzjFMzOHR6vACvqPxDhrGgHK9etWUXewo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWR81myd03rweRn0bVSywbxF1d16tIARlhn_xziGU0Og&oe=6AB28AA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzZvaS5yO_IQ7kNvwE2P2H6&_nc_oc=AdrIgQF4FOSIkHBEBGOV1kFrX7qXwarMgdZ_Td61ZZKXD6OkBVkFTbGdAA8gtWFCTdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1AJy_V0K3M0jwhe9v8cJ4CfkT2svnus47dj-rp5UkRQ&oe=6AB28F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUGmN1VixcoQ7kNvwGI64s6&_nc_oc=AdqWrs3qvrzVkdvCJTurkeiQ3Y7IIVZdTzsTAKBC-JwnyG1DziIloWM2-K0RZ2RiVTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQmroelowiQ57EZ7ciDzfJeIU5KnOE0j7H9xAktFXqBg&oe=6AB2A2E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
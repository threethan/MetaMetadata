71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhSOm9Wb2n0Q7kNvwFceXRP&_nc_oc=AdptLi4580nSfGKaZzokubmoeX5ex4lZLa5dN_rWXE05s1w1vBa0z7POxGTYA7a2MJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6507O_7RZp_4doOPVsO9yC_vnmCkJnjbMA6DKIGVsUA&oe=6A4BBC27"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQQAIlXPyoQ7kNvwELjR9y&_nc_oc=AdpPy3sMxk3mvlfdJyFtA1Voq7LSPdAN8Ov2T6Xe0lmqaA6o_KDs-rPw2GvyTVk6P04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFl1pB1jhXosgxysB2zaYslYhAnSbtAl8_ecCXy3Vp8w&oe=6A4BCB92"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8lgDoGwKI0Q7kNvwGcvq3F&_nc_oc=AdoULrCP8YpKaXkVcUe1neL1BH32NwA0YZpyEcjoE8SEH1wmUakO8uKaxOg6OgaacYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT4nhS2IVMjtt4wc8qhivkSPJgbyUEKcrWuKFITxj72g&oe=6A4BB5A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS8SAi1RFt8Q7kNvwFFFjU6&_nc_oc=AdpGUjv9pFMkcZMwJ8S8q-U9c1COYmAnbE9jacIcPypfHifk99AudNy2uPgu9dpRl0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_2pe3a9vgBKTt02TWqdCqmsHQL4x-_iY556iWoOfSFA&oe=6A4BBA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na-uvdfoXPMQ7kNvwEU5lY8&_nc_oc=AdqScvqm4Ng4fd_XiuO3NBZs3zn9iTzDbmNJwa7p0VMQuTGKv2reUc9mE2EOZ16HHhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHA2COKz3fEOqw_wNUdmZZB9b7h0wHO0BgZvU2es6yDg&oe=6A4BCDE3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
m/v/t64.5771-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlyYEO2s2KwQ7kNvwGgWFm1&_nc_oc=Adp6Rzu0rCnZ6hk_v_8mLo7IR9xqltRCtP8xVA6IMYTiOryq2oRMQ0vcxf10pRYib58&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfrF_tp8gn09Q57wzPOQ-f9IQJ-hyJcYXCp9Jtrz4bbw&oe=6AA956A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsZ5oaZ1ecUQ7kNvwFL35na&_nc_oc=AdpCr1Q4MIvukZADeKfKrgVbzvGZml_q2npDKaY7OSDoT70PekpM85UL1tWkuXUpgzk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIw1XxmFq1Go5Ax1WTe5Uu9nzCuTWwxKXUpMavBf-u-w&oe=6AA96612"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXabVIphTVIQ7kNvwH-G3Hj&_nc_oc=Adq5eopsxgkg-MjeOAHc5s9Vn8YtRRxrmrwPSB3xAFVFZQ8j0eggDj3Pn16ChGgXR1E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICt_U7uMHrkoLhDLI6AUVRn8r9gbnWLmWRAcBgjq1aQw&oe=6AA95029"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqbET_0Ki-UQ7kNvwGgteu5&_nc_oc=AdoTfzufCOxapj609Eszfl_MZduRkpNEEwzP-cvTbLLX3o_aPiGm2KLAcgDjQW62KF0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUWIu8Z4VIAsY16O2CqRh2k7wZrAlxywA5Rfs2y1ZsTA&oe=6AA9549D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swHiAiMKNFoQ7kNvwH4Yrlt&_nc_oc=Adrmq6LJzbPoaNGe_kb-3Ydl_jRlXTtmkVu1cM-6XsRB_RC4OUNxtMWUfa81dQMXVsM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfNftOlBqEObRxdQIRu5TOG-G66s7IIauXaqSapq9KUg&oe=6AA96863"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE
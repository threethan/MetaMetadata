m/v/t64.5771-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylLF20wFRMMQ7kNvwH3NbIe&_nc_oc=Adrmroy-dqFcU3uX5N2K01pRUWed4y6HTViCOwa7JaF4qwCeTqET0m3-N2pveehJ8mQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x1yxXRyzaVa634VWt-ACX5oMuLUUUvoufb4IsrIaloA&oe=6A36A427"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAUhNTKvq2IQ7kNvwG81z2R&_nc_oc=AdpPHQNGurq_Tp0h2Olwq8ciJ1AkaWvlBiDC55OBCTDIY4CFU6w3D2FLtfq11AGZJ2s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aDAEeFDVIWKKafXlrScw8MJQZfL-RVUBDXyNUgwV_zA&oe=6A36B392"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnMcI7Z9bwgQ7kNvwGzWmFK&_nc_oc=AdqeHHkq-Px4azwwERkg1sgQ7OKr2ZzZAXvQTjdo4nFt0uADsK3Y-UuF1LxTkUTPoco&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IzgURlPkiBo94ZoYz9ynde8r7mLdgVfIfFkD_RhCVDQ&oe=6A369DA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8PieCXZ1EgQ7kNvwHZOx5K&_nc_oc=AdqUJZcEtXx2uNhFlEMhxKCfNFlNcd991MBfzGA_8GGYeKVbsTZ-dNn8p764hWK7qLE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jgLYP1tAJMzTjgFk1X-RPUksdoTNDM4g1OaHaYUnQ9w&oe=6A36A21D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzpBj6YC4VMQ7kNvwFEukvz&_nc_oc=AdpBimboRWXwQeE2vTVR7xbaxs_sJW53jnlv8C_INZTAH45OghV_R1u8X6XfvPn6yJE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FFXxqElCug5BciigYrMxPAejfPfwNkQWxq992HvDqwA&oe=6A36B5E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbpDxxm4xm4Q7kNvwGPdn8m&_nc_oc=Adr6iLKjnjW2XwByjbG2d-vUK7wCQw7erEWED1W2iuPLEt9jq8rcYJTTkQZ9uL_lV0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJayXAinlT2Mhv3U_ibCCQlKKyyvL_lfyFeeh75V4Lp5Q&oe=6A9C27A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijiQJ1h2XkMQ7kNvwHMiga5&_nc_oc=AdrmAMJxB1joWwcKooRHzxlAMnCpzcvrsg9kge2zllzy-v9bYRQhGbB9AbXbJ7UKBTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGZhQ62Tdqqqtyv72098YBGhNl8Zc0rQduB7iXw16tTw&oe=6A9C3712"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ5EvIaZQ8sQ7kNvwGL-Dju&_nc_oc=AdpdfRbAQlDdjTCobqDd6OVVRvRso8-9BdssVOYLlaaBxB4ur2AGmpSg8P1TnYOXtNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnfyna3ZvLM8etFBGwTYLmEM9PXtsRBVkiv2Hd68zz6g&oe=6A9C2129"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sMrUYOdqMsQ7kNvwHvbXX6&_nc_oc=AdoiBrTESgcAPXM1AWybrlgbpWSFvPDEKHIGa3vPjVh1USi9UygyWLKUM6we36ZQjkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaoijfKJTY8gOYOVb4U8w0y0oky87hdYHg65kqzVmk4Q&oe=6A9C259D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucBgyjm6BsAQ7kNvwHAaph0&_nc_oc=AdrzsA53lrsERAXRVdC3BslXkletlySA99q177c_ZP1QefQ0l1Wf_QDJ7INhrTKlHJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmhzlLlpJHybKuEGMdnYbuaFNEWZcC06X8xx86eOSvBw&oe=6A9C3963"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
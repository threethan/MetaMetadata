71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezNrIzGJAYAQ7kNvwH45cYe&_nc_oc=AdoT1twwtW0G1zKr7MLmlYPQKetrAkTHYtZo0PyXUtWGZI1M_uKpQCWdmjT7RO4A4JI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LKejGlIH98D3Vmid-CeElSY4O1kbSznoGF05b5gygsA&oe=6A1C4627"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTQS2MVSynAQ7kNvwGnW-kk&_nc_oc=AdoOEp3jYSRrDM_yAaaKHhKWuir5e31JB09amQLUhn8l1K_aP-DK8IPEolFFYWCgmbM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l4GlybvuhVxcMqbokiQPdoGQMry6CavE8mVxE4TZsIA&oe=6A1C5592"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2VCVXCwGhMQ7kNvwEBdcYN&_nc_oc=AdpRFdrVahvTRhBTxbwHwcwKyqCoIFFeHZlWhMvCJ9O1bZxSrVm-5XTw66qSa-JHfEk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41U4yumHdyihRnyFdevCfsOURLRQBzHMbH8mQYXJVn8w&oe=6A1C3FA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXtPus9HX0MQ7kNvwGTH-G4&_nc_oc=AdoRGaNqVimMdhiUHiagX_CmeDu1FSXx9o28Z2Jvlf3MFtT4g56ocJPTZaN_hO-0IAs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44PScfKRA47KjEbOICi4exjFUQLtT80WRL61kqpekFRQ&oe=6A1C441D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIdycmPdf0IQ7kNvwFSjOzx&_nc_oc=Adpy5dLW7hJ2DyGdS9op5ZFssZMS-EPvRxs4EtOmDNp9S6w7hL0-3jZ44yoWNrm_vYY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Us12ITOfZ8p2ii_bd_V0DiMa3qMolsh6sIAxcjFyFA&oe=6A1C57E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
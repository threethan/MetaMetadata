71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m61hvFJH0cUQ7kNvwGxxJmv&_nc_oc=AdprP1v0KUkHF_eiTIOyGSeKGnU7tjjnmdV-AHtMKeWg2H8Z889D9S7dm74hjSkAywk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE-9QPr8aITwRiu7FcArAQbnlzkXJH82lad-svmF6Uug&oe=6A7B3227"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17VeVjUi3w4Q7kNvwHY9Kr3&_nc_oc=AdrQCx_qA9cYPHZTvkE8q79RUN8ZojfQzsRqKaNRBrNlMI4b0IMdBNwxP8IjdSPHx_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0eu1Sm-n3h0cQ_rjzSK373kPm60E-GpOk0QE9p1WQTA&oe=6A7B0952"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0mCbASaZRcQ7kNvwFR2OIr&_nc_oc=AdrGSWKXDkxl6Sck4dpjcRJiI3QU-ID1wKkmPzMDyJBI6hPQB4F_1XMPAoT79TWPAd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWkOKyN36cpne-fZB2BpcXNkH83JoYzvhgWDTKULAU8w&oe=6A7B2BA9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h29ivY5ebVcQ7kNvwGD2hmT&_nc_oc=AdoPfPJ7_Oe147HvARVXjf0tByqRTQ61_Ao56wXl-IsIL_57BZNH99sGZXnNOIEDjns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqaM7QCMhE5cGVHTR-Z7mzgmA9HHiJvZEnkCUPT5ORwg&oe=6A7B301D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTDX3LoIGu0Q7kNvwEn-GfY&_nc_oc=Adp8rMhW-VE2lTcxHNBjs6nfJu4MjgGP1IkuPxBPWYMD__JH1pIF1p9QUuKk08Suw6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZhFklEaQ3t7QX9_vKJ1U25PffqCkfUgrgLqSt6PYiWQ&oe=6A7B0BA3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71P4vw1G4K4Q7kNvwHm3o3o&_nc_oc=AdrRALXulJBc_Mx97KUEkXkyqnbWnHnxZflAYxlAQRZ1oEtFaUycdLIRuxnN69tAGqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FYBmmJnpAXQzUhRLhj8Jly61JowJgEjQnT7hOz-JNqg&oe=69F9FF27"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nO8kimcVZ8Q7kNvwHf_gIf&_nc_oc=Ado512x4xdwMwhSeEo35Rl1oA4ku8xIS9zuaAzPf-VKzOLmDHbuaelhIc1fZo77tJuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RwwaEooGHCT7uR_dGZKRlTXf_n-u3FjO4ENVu2YXIzw&oe=69FA0E92"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZrqsw5R5pEQ7kNvwGj63D8&_nc_oc=AdpdwNVSGWgEkxxT-iXjpVBt_ZgybXNLzURJHHM7CncZmnDAwG0XBeNx5Z0EYqmdVFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z9rKTaeJzhzWNt8nuH7E7Yi2QyTS0Ir_XIWcdaBi-6g&oe=69F9F8A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu4SARyd4uUQ7kNvwFSIEep&_nc_oc=AdrT0vsiXo-3WkIH6VLcNOGgp1zpkhRxEt2WPNRxOofNajaFvZ1PbAZjcqFnUUHrRdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NQrfT5yNgFqn0z7tg7ndfHh-q6qJdUWKNi2DM41aDGQ&oe=69F9FD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPmRK2oIcx8Q7kNvwHNuOea&_nc_oc=AdoePXdEglye2DQO8MCilRT-UWbFCRgyNtDZCtgJVRkzfxO0sH7BolVSJb2r1U7UBsY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QqzADJV7M3M3VhkIf4K1gqHiXfbaCN6R_zo5x-DOiaQ&oe=69FA10E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
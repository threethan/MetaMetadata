71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQqWiLIZMbUQ7kNvwE618nO&_nc_oc=Adp7rKTH9D-Qv7IpvaUmXj9lJxn0BNr3YY0z93Qx9KV0ZrE5fMD7TidY_MWyfRWbejE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCQQZ8cOeTTE7g_TPKGdvcrYdG4129e887_bzAdJkuhQ&oe=6AE89EA7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgXaNkPYR4oQ7kNvwGUg-lt&_nc_oc=AdrQ3h7M8LVGTKrMSFb9M91ykeqleDnGYBjukylTwqNGB8jp4NOFnFaa3k3i1TC24wI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZHOOIULg1Hak1-EQCSJT8mdDb9w79OhWgR2vpb_e-Yw&oe=6AE8AE12"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CtDcQInabgQ7kNvwFQhA5C&_nc_oc=Adr7cPnPVuXBaP1-z6YWl9SX07WebKo_K3SD3pR8UMvRHLo3zlDZkJ3lSFO4ljYfvjA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCYD_SkIQTw_OhXsOA4R0FKEGvPy2e9HaUfSHK1NKAlQ&oe=6AE89829"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjxKFnAdMIUQ7kNvwE6nBsq&_nc_oc=AdobQAT-9HkhFD1M9VEGVO1Z-aFcz9buO6rvPTlJha7PxYpC7M8h3vJ_fI1kNDOWNSI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ37K3ECDlAHXOX1Wf6qfVZHzzDbb8O0AVJ4dJKrMNXTQ&oe=6AE89C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx7NDKlsBQEQ7kNvwHXmH4n&_nc_oc=Adraz9IQUCSFzuJfdouDjopOeVUgkoqew4U2JW3yFyorbUNRFZi4Wk8btvnbeE-HrSg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDTuwDMV-QTddhLJd3rKidz2arEihcB7qIL4vsX2R_tQ&oe=6AE8B063"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zi_olMQ45jUQ7kNvwE5D88G&_nc_oc=AdrgiYq03l-AqMxLXs7Sft4IQbG-TiiC2apa6X3XAaMvGNSYljiRvp7llHkZV0aBj-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoPXq2IY1RxtmScBXxH77JNA5mMKkE93LDc3XYvF-6IQ&oe=6AB928A7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmbN_wc2FmMQ7kNvwEZ084G&_nc_oc=AdqZNMBmPKWHXJzhpZ24q2Wks9r5OxalhuxUbOHNJgKsxtxjgOueer9-n6xaOUluJiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV8xCoH0PccV5eDGEGC5KQUeD7NQTcki4hBPEFRFm0yA&oe=6AB93812"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DdSnYPfjY4Q7kNvwGwxxnf&_nc_oc=Adp9jNccViI1vGCJ_ql0ZIa-lLRigvQyrfgAIlSQrqr5os1m4pA0Vtev-_fzb90xQyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-PK8bZN5eLZLH2PLmDrar4Kq1h2zWkLU9XliQ2cMmCw&oe=6AB92229"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggJlvLhI5h8Q7kNvwGoKt_W&_nc_oc=AdomqEvYCfDnVFEpSvA6OteHscXh-rtonmGrbQ17xz2j1Qho8WvbmS-T9IxC8UjO4Cc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4T1p_U90a00hDImogOA_zbenHaqczO7OLvHTRtIoOog&oe=6AB9269D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zObk-7q1GxwQ7kNvwH2Um4K&_nc_oc=AdrRG1nWIdlgGIWes10zWM35yHe6EqMDPmN66MTACL1P2oj_iTWcSwpVXVU2x_oZmQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeJ3XCNJo_esO89V-Qu9srllUT2TgT9eSHx8VXzY3B5Q&oe=6AB93A63"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFSJBD56s1sQ7kNvwE-vlat&_nc_oc=Adp-p1X9aAfAxXIbckXmJxPP9IHhElold2ZEXmtppgb1mQGmqDl7znkuVtHm36C153Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YKIAP-NIJfWd701Dl7GLVmDDi56G0v-evzjwTVXck-A&oe=6A15AEA7"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90BhEiTDwyEQ7kNvwEw0zo2&_nc_oc=AdplQE87f0VB_CgHb-YQ0UOWlNcQ0HKqFgkjKEd7eDcjH0kBD9ICxHqbsLPeUCygCwk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VnBxaPjfoUkT9zHQqRvzxaHxnTcg_Z_7LN_J4OIRAsA&oe=6A15BE12"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3bUq1r6XUAQ7kNvwHbFdec&_nc_oc=AdqUSBchXXojRIwZ3BFnFcSM3XRk4U4d5ppn9dRx7VR2VeP0_TW6fvvuyfy1I74VrGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y0gRNiv9MN6RAHm1dV9VWlQ5QypJ9YeceE-fX7N18ZQ&oe=6A15A829"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdCLTUzINTgQ7kNvwF54Kqu&_nc_oc=AdrjB9Hhi-r3YrsJNbqEk9TNkfYdqLxb28Up2p9h4R43WeeXmhxUObIew0HIpFZmOO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gwPX-eZ5lnFGVCiV9vYyrt7b465X_db12yFCmyEaW5w&oe=6A15AC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp0ZUKqDDW8Q7kNvwEqDiAP&_nc_oc=AdolS5MhWXGB_tDZU3KfftkcapVstzylWfsrvDVk5bFqWd7_9vSM-XPxqMhffU1frNs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MA-0034lDzlt9QwH_95R2WA5_svyYJOH07HcUCmns8g&oe=6A15C063"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS2qp6lBJAIQ7kNvwFmjXE5&_nc_oc=Adoq1xgJBnSCBVBtBJeMz3aLvJk5tTxNxaRiXjwHrJ-LWgwVzTNd67T9OyFXfMj9JQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkAUZKvjAfXNXzVrAEm1ZMCSL9hGoOdljfE_7-zBUtyg&oe=6A68BD27"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r31nBKNWHKcQ7kNvwH64sE1&_nc_oc=AdqyJzD1Uj6g1JYC_CjXkYShBMraGNnVzw7G5UguF780CX_V5k-3z-d7VeJtEwuoSkg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu2vX0xq13wkSDkNPZz0M4Uu3tiDM5V_AqhU730IZKrA&oe=6A689452"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJR__l29UrYQ7kNvwEVO8kZ&_nc_oc=AdpG__HgvHewEcSeJTBVV8xLDawC9JtEnooK6ZINvsDGCraPxAv5D8zDxyEl6iCsYxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFRoBJwenX1XTo08U5W9WKQ_wHqU2fdjmg0Z4C7PATjQ&oe=6A68B6A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oluQOBfOwJcQ7kNvwHs_2Ta&_nc_oc=AdqOX4ZZwx_3wLzV0UwJPxhYUq4bjHRUDMXHLlFC-5ZdayKSJN_eXhMkfTJ8ckjUpbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf8zQtC5a4LPNxAD5ZH_-aI_8owzl30lLRDewD4ABNYQ&oe=6A68BB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWReUA-6T4wQ7kNvwGS1hJd&_nc_oc=AdrsuIXhn6iVFfHpfgtrnkgMolIhnFDS-Cf051b8io_aCioWgXCt-8UX7ldDfk-NRdo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqxRNWOiI4GwKpnw-E_Jb3w8t8h6fHw_fKd1pxe_9POg&oe=6A6896A3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
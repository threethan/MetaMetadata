71-25/499618440_2205898643226714_866145867962728037_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwKdvPqXM6gQ7kNvwGDbmV0&_nc_oc=AdrvMjtJ-3y7O4SUWB1-CchCz7xZCuiwfLpJCkiHJAh-N3DIOsuNGTYPTM-Z7oij_I0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bmyW71YZ5RqxYPJtjIDkseADTjQ8_U5BjS9sgvB0DNg&oe=6A2C1827"}, {"file_name": "SS3.png", "id": "1502134451112399", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619098_1502134454445732_1041709764003280779_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixTwxlpFpsQQ7kNvwHC3mSy&_nc_oc=Adq1-5qGZ0wlvBr8pyLEcbLGeZY7zGD2Hpic2G0X5t_5w8UuUOQT7kZM8-7hAMBX-OU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NuOGh6dHHaP6JlKYoYWyReVNgx-O_s0-xJ1X92qOHDA&oe=6A2C2792"}, {"file_name": "SS4.png", "id": "3963080853982755", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618284_3963080857316088_3890546066629983953_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag0DKxlvWHAQ7kNvwENEmdL&_nc_oc=AdrPtnVC5Ns0hvt3U2MWy4tto96RQd_OoJtbiNEIYUGp1XqFuk0v1luY_ss0aIvxEAE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OKMuoDJnlzVana_Ono7vQ4Dtt7C8HK-qN6Qx6cGrkeg&oe=6A2C11A9"}, {"file_name": "SS5.png", "id": "1151911970368551", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620497_1151911973701884_4381335596328371771_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTtAEubwRZwQ7kNvwE0Y7uR&_nc_oc=AdpWuZ6ljvTjvoaOpIU30jWttpYkAzmyWMPKWQWW4KIdnDcC_wXeATaKEUWUdXUxcQM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JuDIAI1VZZrvHlRiei9PqpprLsmo5T8U2BkuHLyZ79A&oe=6A2C161D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS2.png", "id": "800691572853007", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822737_800691576186340_1154723742766850044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhxVhRny5vEQ7kNvwHvOU6j&_nc_oc=Ado3X95uxo6W4XutU1cFPJVa3m6j8vP7oQVsJbGNbSdqEA_8At_E62EA8TG55CRoNYw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93m_2V3SaZImUY9Loq8G-_cn277nQF6OAbTkkaxM0jRw&oe=6A2C29E3"}, "display_name": "ARTIST SLAYER / RUSH", "keywords": ["artist", "slayer", "slash", "rush", "zombie"], "long_description": "(\u203b)The current version available is the Demo (trial version). In this build, you can challenge up to Stage 1 using the following two weapons:\n\u30fbLethal Blade (Sword): A powerful melee weapon for devastating slashes\n\u30fbHand Cannon (Gun): A revolver-style arm cannon for long-range attacks\nThe full release is planned to feature additional weapons, new stages, special abilities, and a wider variety of enemies.\n\nARTIST SLAYER / RUSH is a stylish VR action game where players take on the role of the SLAYER, SLASH a horde of enemies(RUSH) with speed and precision. Wielding a variety of weapons such as swords and guns, you\u2019ll unleash fast-paced, visceral combat that feels like channeling your inner rage.\n\n\u30fbA technical combat style that blends slashing melee and ranged gunplay\n\u30fbIntuitive controls and immersive action unique to VR\n\u30fbThrilling stages filled with relentless enemy hordes\n\u30fbGrotesque, gory expressions that awaken your inner demon\n\u30fbIntense rock and metal soundtrack combined with realistic sound effects\n\u30fbConcept art exhibition inside the game", "short_description": "The first entry in the ARTIST SLAYER series.\nThrough a VR headset, the player\u2019s soul is transferred into SLASH, a special operative of the Slayer Forces, tasked with cutting down, shooting, and annihilating hordes of rampaging monsters on the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policy-artist-slayer-r/%E3%83%9B%E3%83%BC%E3%83%A0", "developer_terms_of_service_url": null, "publisher_name": "ARTIST SLAYER Project", "support_website_url": null, "website_url": "https://x.com/ARTIST_SLAYER", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "c
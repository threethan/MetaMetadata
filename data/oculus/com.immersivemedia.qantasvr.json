.oculuscdn.com&_nc_ss=8&oh=00_Afyhc9CFLQs9lAwIeR1oDLmgz6QqZg9LZcMZP2IL35u9kg&oe=69BE7993"}, {"file_name": "migrated_image.png", "id": "214566493125373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162800_1133992439947653_1243527999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbwOyd3rb-MQ7kNvwHAIr06&_nc_oc=AdnDXcIDwo83n13ZHbDKeLD3cOWeids60EdwiAuFq_s9-964ro_cQ--wUeEjQqnhOgo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySi5jnx9qACr_RWpaB1aOENKUkVVYPYneoGrZUa5n0UQ&oe=69BE7EF1"}, {"file_name": "migrated_image.png", "id": "661764367914787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162814_938845649512613_1883436868_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0wUAc8nxlUQ7kNvwGF1wzV&_nc_oc=AdnWv6vuB6Rc5HVdPyY4ZZlNo0ZMsSIMV_zfiRo7uCGx6zCDaxkabyuDELOeKzEPlZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzve8zKIPS_XrhjVAichAJsgDMNu7e7fDizdrHcvomrLQ&oe=69BE8B02"}, {"file_name": "migrated_image.png", "id": "832913600518737", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162787_1002569349776061_1824829146_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7WPMLPGJmUQ7kNvwH0zo1k&_nc_oc=AdmEPLYaaBpz-D4G5AtIwaLFiSapxoBqID1vgjyv1hrxvam2OYdKHlATo8pUT8RSNto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGMU3Z4UaUiR5YG0DR1jt654PYnmu0_YJVAUJWiGtgmg&oe=69BE98E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Qantas VR", "keywords": ["VirtualReality", "VR", "Tourism", "Qantas", "Flight"], "long_description": "The Qantas VR app will virtually transport you to Qantas destinations and unique Qantas experiences.\n \nWith Qantas VR you can:\n \n1. Escape to Qantas destinations: scuba dive the Great Barrier Reef, climb the Sydney Harbour Bridge, relax on a sunset river cruise in Kakadu and explore water holes in the Australian outback.\n2. Access unique Qantas experiences: fly with the pilots in the cockpit of a Qantas aircraft and experience the Qantas A380 take-off, approach and land in front of where you stand.\n3. Travel with Qantas: experience flying with Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYiKhs8bs_MQ7kNvwGx9bTa&_nc_oc=Adk8MYfs8E-sp7pYFd2wowUkgyugT88oViL6j0Y0BzOIXnYA2JC9hQLtxBw7M9yLXDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUJbMCvNtlMLXDQJXfhWuOdObMb1jTijXzG1H0qut61g&oe=69BE97C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1438153200, "lastRevision": {"nodes": [{"id": "1025347
h Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmOEIXAXd04Q7kNvwHsjaun&_nc_oc=AdloBgyOOeT-wtfqF_pSeqt56385Zq_uNniv5Z3oZ-6IMcTd4MqkwsoTTCQ8sS1gN6E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftLVcI0e6ppdWANQzq4rey5WZhVHsLXWi4uCRy2TopR9Q&oe=69A58B40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1438153200, "lastRevision": {"nodes": [{"id": "1025347917505283", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
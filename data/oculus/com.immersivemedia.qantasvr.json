99C3293"}, {"file_name": "migrated_image.png", "id": "214566493125373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162800_1133992439947653_1243527999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui4sVOjvuP4Q7kNvwG70NPB&_nc_oc=AdniEcavTPQJ52HKz3Ti_CNmTlfohVMRx-ayVzHsyF9sfqkueo8Ws3HDpV2jM9EVJ3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftldzfWKZ1isQGQJBV_jzndxx96M0WB7L7YGef_-j8njQ&oe=699C37F1"}, {"file_name": "migrated_image.png", "id": "661764367914787", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162814_938845649512613_1883436868_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEyuuZ1FnMwQ7kNvwE3ykg5&_nc_oc=Adl2bOa7zqCG1Ln9x-mVxknWc18ODDD3dT4PK6EkDJpf42NdiheHYm_gtmXTakJqJAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftyEgtxsvhq_w7IT1zPlIOKQurWPjflKmp2IpgexRb6qQ&oe=699C4402"}, {"file_name": "migrated_image.png", "id": "832913600518737", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162787_1002569349776061_1824829146_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d87kel2_0ckQ7kNvwGyTWzN&_nc_oc=Adm53m5jXNNJgEodv2LJxjH5iZYpadsw59h3IeIK1ywuWEjwQzrXwKaSLV1xMA5amQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftpxWWjiWr53kggmz6Ae7wcM6NIXKhyNZkxIrWyqH2hDw&oe=699C51E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Qantas VR", "keywords": ["VirtualReality", "VR", "Tourism", "Qantas", "Flight"], "long_description": "The Qantas VR app will virtually transport you to Qantas destinations and unique Qantas experiences.\n \nWith Qantas VR you can:\n \n1. Escape to Qantas destinations: scuba dive the Great Barrier Reef, climb the Sydney Harbour Bridge, relax on a sunset river cruise in Kakadu and explore water holes in the Australian outback.\n2. Access unique Qantas experiences: fly with the pilots in the cockpit of a Qantas aircraft and experience the Qantas A380 take-off, approach and land in front of where you stand.\n3. Travel with Qantas: experience flying with Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlNaXKOVeRQQ7kNvwE3LNP_&_nc_oc=AdkWjdY2T-9D9zXqb9724ukEALfA1QDIeQRSro1RQSzN0noy-BjstqUKG_JbawcE1-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2zy8q-1hxzg5Qe9GlKexuHQ3QTykSt5EovHBATLysVQ&oe=699C50C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1438153200, "lastRevision": {"nodes": [{"id": "1025347917505283", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defau
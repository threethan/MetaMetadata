.oculuscdn.com&_nc_ss=8&oh=00_AfsYSp2MiqXBu-vq6AxKbOtdVDH1BLRtmmPer4oJsOZjFw&oe=69A81013"}, {"file_name": "migrated_image.png", "id": "214566493125373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162800_1133992439947653_1243527999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swX3cw8JCQAQ7kNvwFLS0mA&_nc_oc=AdnpwY_rFLMJyl7iNNwUIFE6RGO85FMFyvTCJ-lHBwFeW7i3t-ZRaH8HGFZwUWnysvg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvl1BQ-ENDbU2ZwmmhzEwRTq6k94w-Z0-3TGD0lXOOhbw&oe=69A81571"}, {"file_name": "migrated_image.png", "id": "661764367914787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162814_938845649512613_1883436868_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQrc734knNMQ7kNvwGCjOU8&_nc_oc=Adnd5kRPZIQZ5Ued-qIVIdHj_PsbGYm3xHEHWn7HB0AfROw_RSH01sSiAZNZ7ggOZEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvt9NwWkL-ExEwUp7OK9ygYKA-vc9xmxInIfkASuzKqaQ&oe=69A82182"}, {"file_name": "migrated_image.png", "id": "832913600518737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162787_1002569349776061_1824829146_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz1lq9RnqHQQ7kNvwFmLPDu&_nc_oc=AdnQucqxjIHENk7s9-xPQxDq9yxY8Xn61nQIMLU01B4G9WjYbb8Hbv9XjFYcAzoPGXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu8BE2Q-3hjbnYHr5xHmPXb6HUVd1IRLpbdYoGRaMy9CQ&oe=69A82F63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Qantas VR", "keywords": ["VirtualReality", "VR", "Tourism", "Qantas", "Flight"], "long_description": "The Qantas VR app will virtually transport you to Qantas destinations and unique Qantas experiences.\n \nWith Qantas VR you can:\n \n1. Escape to Qantas destinations: scuba dive the Great Barrier Reef, climb the Sydney Harbour Bridge, relax on a sunset river cruise in Kakadu and explore water holes in the Australian outback.\n2. Access unique Qantas experiences: fly with the pilots in the cockpit of a Qantas aircraft and experience the Qantas A380 take-off, approach and land in front of where you stand.\n3. Travel with Qantas: experience flying with Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxKk6d9DRG4Q7kNvwFcYzIu&_nc_oc=AdnFrNXCzHOJoMLLFOWu-jW_FjLHhB1BSREeR9AdE65PhWCpBEBGCJOe50mGr-H9z6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsIO6D3ffwHfJrolzBJra0i2pBIBSyCpeT7luMY8FXdzg&oe=69A82E40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1438153200, "lastRevision": {"nodes": [{"id": "1025347
.oculuscdn.com&_nc_ss=8&oh=00_Afx4xmYzK05A91FE9AJmKM9KTC9tpOYdQ87Swt2ErZXNug&oe=69B14A93"}, {"file_name": "migrated_image.png", "id": "214566493125373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162800_1133992439947653_1243527999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5kJ8g28siwQ7kNvwF2g-Bn&_nc_oc=AdmjkcfyQcITptqm1yoG4WTHeimVHtcqSJ4-m0Y68-afLhdX8MJeX46ySIzm54JsTXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsjDUDZRIcPfHIQhB5uqoKmxH11_okQLqqZxQerbPqtQ&oe=69B14FF1"}, {"file_name": "migrated_image.png", "id": "661764367914787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162814_938845649512613_1883436868_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv9UNC4TwMkQ7kNvwFQz5lY&_nc_oc=AdnvHDZVoJtPEXpGyUp-SsQpu-8jVR3XifKnF9ESeXiL4858ZbUwB-zHhfOjiar5mEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP4p3SmEsQgU0zUnWgOSxgi4keSHOnuq18HLo_Il4csw&oe=69B15C02"}, {"file_name": "migrated_image.png", "id": "832913600518737", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162787_1002569349776061_1824829146_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Nc7oWYPJpcQ7kNvwHJ3CVa&_nc_oc=AdkGapsWMUnUC0TIlnvEopWd7Xoyfbh2CbYYjd_KuDJGxDMD3F8R5hOJwyOOPfiPpCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUMPwJkVjc5EsXo7kkD83ognH2IDf7ozaScjf3TuAaQA&oe=69B169E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Qantas VR", "keywords": ["VirtualReality", "VR", "Tourism", "Qantas", "Flight"], "long_description": "The Qantas VR app will virtually transport you to Qantas destinations and unique Qantas experiences.\n \nWith Qantas VR you can:\n \n1. Escape to Qantas destinations: scuba dive the Great Barrier Reef, climb the Sydney Harbour Bridge, relax on a sunset river cruise in Kakadu and explore water holes in the Australian outback.\n2. Access unique Qantas experiences: fly with the pilots in the cockpit of a Qantas aircraft and experience the Qantas A380 take-off, approach and land in front of where you stand.\n3. Travel with Qantas: experience flying with Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9FomVhnsmQQ7kNvwElTwpZ&_nc_oc=Adlzf3kXQaqBxbkk4Cbfdck8l6mchlvbo1-0kAzSWWT7uIbXoKx4YwBom6fa7Xtf604&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxT_99w-XQKNvXX1gRGOXwO1ZqUFEQ8rsPBKdMMptVn9w&oe=69B168C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1438153200, "lastRevision": {"nodes": [{"id": "1025347
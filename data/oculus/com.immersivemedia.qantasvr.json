-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDLBy8Z5RtzQL2-mcFcj65Zj7iqZxD7F3bvxqyxeOZaA&oe=69AAB313"}, {"file_name": "migrated_image.png", "id": "214566493125373", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162800_1133992439947653_1243527999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swX3cw8JCQAQ7kNvwHOLynn&_nc_oc=AdnlUuhH5c2WZT0vDKZRChPSeM4Mt10RwT0Glf32oIa-7e95_BDzx2YvlKW1Wky-c4o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZfoA3NteyQ1jBZuIPgao2fk61RRO9XVaeDoGsXHC1yQ&oe=69AAB871"}, {"file_name": "migrated_image.png", "id": "661764367914787", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162814_938845649512613_1883436868_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQrc734knNMQ7kNvwGf6Bvz&_nc_oc=AdnZZc686J2nMTxvkNRnG7EpKaBpekln5hVobbuCP6DpwpNiQCDfW_jDuL78L_KDi2Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxb5HSWTnMmny5ALOxO2zTs-Bs-zTNyjK-Y85XaznWOqA&oe=69AAC482"}, {"file_name": "migrated_image.png", "id": "832913600518737", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162787_1002569349776061_1824829146_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz1lq9RnqHQQ7kNvwFGkLHd&_nc_oc=Adn2H4nwnQhPIMh1Rmxe4_D1b5yY_vWwBR2ALCBvUEtrNDiEsff6PAVpsQHb6JdHBpE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0Yq7EpzhrwrHLI3iTK04rzE4_dmwNN-jrJLBzS1khvw&oe=69AAD263"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Qantas VR", "keywords": ["VirtualReality", "VR", "Tourism", "Qantas", "Flight"], "long_description": "The Qantas VR app will virtually transport you to Qantas destinations and unique Qantas experiences.\n \nWith Qantas VR you can:\n \n1. Escape to Qantas destinations: scuba dive the Great Barrier Reef, climb the Sydney Harbour Bridge, relax on a sunset river cruise in Kakadu and explore water holes in the Australian outback.\n2. Access unique Qantas experiences: fly with the pilots in the cockpit of a Qantas aircraft and experience the Qantas A380 take-off, approach and land in front of where you stand.\n3. Travel with Qantas: experience flying with Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdVF7Raol7sQ7kNvwFRCZSj&_nc_oc=AdnaTpnenzmqerDcdcntvMKxkjxICg1Q5gLqE1cE0cXwmauQ0F0oXGJj9BmP_rD-kTs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afwnqu6HVT06kzvE_ttIqy57Ku0-fvjA-COGSFGyVP9W8w&oe=69AAD140"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1438153200, "lastRevision": {"nodes": [{"id": "10253
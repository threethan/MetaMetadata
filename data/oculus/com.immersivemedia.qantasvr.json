.oculuscdn.com&_nc_ss=8&oh=00_AfyksKHD1MHkrEqvOnK7JLUpwPHrE07cBa2hvdGCpfahcw&oe=69AC0493"}, {"file_name": "migrated_image.png", "id": "214566493125373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162800_1133992439947653_1243527999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcgMJzO_0j8Q7kNvwE9EUgt&_nc_oc=AdkaFNqPu7wbL6_XiTkfCIJADCezQmmmbnb6ebFVWgGsKVrmagZQa88LKhKFs858D2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfymJHkVI-Ye98xE_ierRLVonrWQeJvSXDZx1adFdX-sbA&oe=69AC09F1"}, {"file_name": "migrated_image.png", "id": "661764367914787", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162814_938845649512613_1883436868_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0DqP9N-IdYQ7kNvwH4a7r7&_nc_oc=Adnpt-NiBZE8u3GlX3d_FbKzpjpuWKq-jfCOzwqlLqZs7UeKikMJI-HUobVd4vkAUuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfV4izpmABZ6Lg-2Nv4Hw1ZH0e57rzItEhCVCdXVjz0w&oe=69AC1602"}, {"file_name": "migrated_image.png", "id": "832913600518737", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162787_1002569349776061_1824829146_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_zKT-y_dekQ7kNvwEbnVq6&_nc_oc=AdnOroX2tdhtR_cm1tODdMm0YYQELwt_ag3UT0CpmEcwY_cUgRV90OMwSueMQJohNyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMz5Leeju7r__FiGPEBWEO2nJ7yxbvgR2GpqX-8L-4ug&oe=69AC23E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Qantas VR", "keywords": ["VirtualReality", "VR", "Tourism", "Qantas", "Flight"], "long_description": "The Qantas VR app will virtually transport you to Qantas destinations and unique Qantas experiences.\n \nWith Qantas VR you can:\n \n1. Escape to Qantas destinations: scuba dive the Great Barrier Reef, climb the Sydney Harbour Bridge, relax on a sunset river cruise in Kakadu and explore water holes in the Australian outback.\n2. Access unique Qantas experiences: fly with the pilots in the cockpit of a Qantas aircraft and experience the Qantas A380 take-off, approach and land in front of where you stand.\n3. Travel with Qantas: experience flying with Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdVF7Raol7sQ7kNvwHWTioB&_nc_oc=Adkb6oH4MHGNZeS9Pt18N6Rk-4ET4VUo9nZQgL37esTNuTnGEggH9WKbEQnMUFx_z2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSeRjKKssbCNG-mO_5T5yeNfxR1DVsSLVe7rzPwTw6Aw&oe=69AC22C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1438153200, "lastRevision": {"nodes": [{"id": "1025347
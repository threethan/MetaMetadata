pit of a Qantas aircraft and experience the Qantas A380 take-off, approach and land in front of where you stand.\n3. Travel with Qantas: experience flying with Qantas as it lands at Hamilton Island airport and take a tour of the Los Angeles International First Lounge.\n \nStay up-to-date with new content through push notifications.", "short_description": "\t\nEnjoy Qantas destinations and unique Qantas experiences in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.qantas.com/travel/airlines/privacy/global/en", "developer_terms_of_service_url": "http://www.qantas.com/travel/airlines/terms-of-use/global/en", "publisher_name": "Qantas", "support_website_url": null, "website_url": "http://www.qantas.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "494850582093990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12427444_605534879611600_1651179629_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3kXuQt1OHEQ7kNvwH_v_Su&_nc_oc=Adro642EfPcWx4XRNA8GnQlQVrMrqMKu2QJ2VOctggyKiTqeblManji7usxNkdbz7zU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m2PxPFAFHNBm_zE7f7e0S3HkSU4iBHXYDgPGm8tn5nA&oe=6A369040"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Qantas VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 
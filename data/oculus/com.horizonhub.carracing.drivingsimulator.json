kCcrYNn2s-SIHN4esmshM5MKD-O8TOJ3ox7X3k8fdg_JoXVAAQ53iOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3xpVfAs8tQSYLPsvFcVgYkpIAJqN8X9sukubd64H8HA&oe=6B1069BF"}, {"file_name": "Screenshot_3.png", "id": "1477115866978479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619586_1477115870311812_7862236489685790157_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwJRGE7xBngQ7kNvwHukjPr&_nc_oc=AdroCHJiQGAF90l6j-CrwHBT0fZskL4vFhttUEyHoGEq0mF3swSZmLrEjT0y5v6Dyq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuxB2yJf4qLGykcLxGkA7mzI6A40qKQII-qOZAkDY0DQ&oe=6B105693"}, {"file_name": "Screenshot_1.png", "id": "1146405700875094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619534_1146405704208427_6231402920942554817_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNDoHB41tvkQ7kNvwHa6BQ1&_nc_oc=AdoY1v96Tg2oRwvog2S9ioBQRFDoQGSEKiJOeao9gVyDxkpy8DJR8itrFC80fXE6IIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRShoom_FRyvkyysPaYaZ3924BHHKfmUn63bZ3EashfA&oe=6B103658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing & Driving Simulator 3D", "keywords": ["CarDrivingSimulator", "CarRacingGame", "CarSimulator3D", "CarGame", "CarDriver"], "long_description": "Get ready to feel the adrenaline rush in Car Racing & Driving Simulator 3D!\nStep into the driver\u2019s seat of powerful sports cars and take on a variety of thrilling challenges. Whether you\u2019re racing at top speed, drifting through sharp corners, or cruising through a realistic open-world city, every moment delivers heart-pounding excitement.\nWith realistic driving physics, dynamic weather, and stunning 3D graphics, you\u2019ll experience the road like never before. Choose from multiple cars, customize your ride, and push your skills to the limit in different game modes \u2014 from time trials to endless free driving.\nFeatures:\nImmersive 3D graphics and realistic environments\nSmooth and responsive driving controls\nMultiple cars with unique handling\nOpen-world exploration and challenging race tracks\nDrift, speed, and stunt modes for endless fun\nWhether you\u2019re a casual driver or a racing pro, Car Racing & Driving Simulator 3D puts you in control of the ultimate driving experience. Start your engines and rule the roads!", "short_description": "Experience high-speed thrills in Car Racing & Driving Simulator 3D \u2014 race through realistic tracks, master sharp turns, and test your driving skills in stunning 3D environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "es_MX", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325644250445407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_1208384170647026_1047453724582915533_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FquDthu3HNgQ7kNvwE
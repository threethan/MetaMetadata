MYDRQkvpzxPsN3Q7ou37uzJwF1fBT607gYS1gnzAGWR3r5uQws1xSds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRzN3Uj5mG0JLGAFKkKoPl9E65plozTdcPEeOVRrmnFw&oe=6B0DC6BF"}, {"file_name": "Screenshot_3.png", "id": "1477115866978479", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619586_1477115870311812_7862236489685790157_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgaW65KUsDAQ7kNvwHcFfsy&_nc_oc=AdqauPVLSqmUU85HwRHupoVp6OojtqqQSBRVsNMxnRy9I0DCZU3Hp5GOvFtKKJQo7eU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT57nWtSgdA__LcWKvagybU25eMX1SrLNI8vlMhZWmQbQ&oe=6B0DB393"}, {"file_name": "Screenshot_1.png", "id": "1146405700875094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619534_1146405704208427_6231402920942554817_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl-1l9dhhCQQ7kNvwGuz6ev&_nc_oc=Adp54vUjTIBei2paK-eVMlGSwI-Sr0xyPx1jIKbObvnflenknm5yATfLiErx0kGFHY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKCey674hW0UAxfKUG4du2q3r1DgaYV4S4BlY7w_H9wg&oe=6B0DCB98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing & Driving Simulator 3D", "keywords": ["CarDrivingSimulator", "CarRacingGame", "CarSimulator3D", "CarGame", "CarDriver"], "long_description": "Get ready to feel the adrenaline rush in Car Racing & Driving Simulator 3D!\nStep into the driver\u2019s seat of powerful sports cars and take on a variety of thrilling challenges. Whether you\u2019re racing at top speed, drifting through sharp corners, or cruising through a realistic open-world city, every moment delivers heart-pounding excitement.\nWith realistic driving physics, dynamic weather, and stunning 3D graphics, you\u2019ll experience the road like never before. Choose from multiple cars, customize your ride, and push your skills to the limit in different game modes \u2014 from time trials to endless free driving.\nFeatures:\nImmersive 3D graphics and realistic environments\nSmooth and responsive driving controls\nMultiple cars with unique handling\nOpen-world exploration and challenging race tracks\nDrift, speed, and stunt modes for endless fun\nWhether you\u2019re a casual driver or a racing pro, Car Racing & Driving Simulator 3D puts you in control of the ultimate driving experience. Start your engines and rule the roads!", "short_description": "Experience high-speed thrills in Car Racing & Driving Simulator 3D \u2014 race through realistic tracks, master sharp turns, and test your driving skills in stunning 3D environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "es_MX", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325644250445407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_1208384170647026_1047453724582915533_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MrcRFkGf8MQ7kNvwG
C2YBZux0eCM17uXUO9WjBJLFf6ECVlY2ytm_u_otdVKuzC1FecMpduw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR7VV4Vho1GKBwf9cRnrNcfSuG6kXYTclodwIjGLSLfg&oe=6AFF0DFF"}, {"file_name": "Screenshot_3.png", "id": "1477115866978479", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619586_1477115870311812_7862236489685790157_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hyKkE8ApW0Q7kNvwG4Wfq7&_nc_oc=AdogDeaiV6uqgmOg03RJRjHt0tVawZw_Rql6g-8_E6T-Yuma1rlGkknAHouflUu9KRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOyd9GjONWZvDiSlS-30rLWscOJDmroBw8TKAlpexdsQ&oe=6AFF3313"}, {"file_name": "Screenshot_1.png", "id": "1146405700875094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619534_1146405704208427_6231402920942554817_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbjStL6nRzoQ7kNvwFIQ8Gy&_nc_oc=Adr9dRedIL0Ld5rArYj9L0tzSgR92WopR9UNDvJ5p7_UXPL7SXJqwxsczTy0lwvy1MQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpAgy20e1OsOqBrT6MTBcQH75_V7BdQAA89Z1wYPimvQ&oe=6AFF12D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing & Driving Simulator 3D", "keywords": ["CarDrivingSimulator", "CarRacingGame", "CarSimulator3D", "CarGame", "CarDriver"], "long_description": "Get ready to feel the adrenaline rush in Car Racing & Driving Simulator 3D!\nStep into the driver\u2019s seat of powerful sports cars and take on a variety of thrilling challenges. Whether you\u2019re racing at top speed, drifting through sharp corners, or cruising through a realistic open-world city, every moment delivers heart-pounding excitement.\nWith realistic driving physics, dynamic weather, and stunning 3D graphics, you\u2019ll experience the road like never before. Choose from multiple cars, customize your ride, and push your skills to the limit in different game modes \u2014 from time trials to endless free driving.\nFeatures:\nImmersive 3D graphics and realistic environments\nSmooth and responsive driving controls\nMultiple cars with unique handling\nOpen-world exploration and challenging race tracks\nDrift, speed, and stunt modes for endless fun\nWhether you\u2019re a casual driver or a racing pro, Car Racing & Driving Simulator 3D puts you in control of the ultimate driving experience. Start your engines and rule the roads!", "short_description": "Experience high-speed thrills in Car Racing & Driving Simulator 3D \u2014 race through realistic tracks, master sharp turns, and test your driving skills in stunning 3D environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "es_MX", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325644250445407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619098_1208384170647026_1047453724582915533_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OVJDROVBLkQ7kNvwF
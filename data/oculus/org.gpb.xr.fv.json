y historical sources.\n\nThe GPB VR/AR App works on any device, with optional headset support, and brings cross-curricular content to life, making learning engaging and fun.\n\nGet ready to discover, explore, and experience Georgia in ways you\u2019ve never imagined!\"", "short_description": "Explore Georgia through immersive VR field trips and interactive AR lessons that make learning come alive."}]}, "developer_name": "FableVision Studios", "developer_privacy_policy_url": "https://www.gpb.org/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Georgia Public Broadcasting", "support_website_url": "http://www.gpb.org/about/contact", "website_url": "http://www.gpb.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26577121895218215"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_891965409932690_1365964020513703747_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32hjCPajWEYQ7kNvwGpYOsK&_nc_oc=AdrWjsFEFfbT_mvTOHGp2RlHHB5ahvLIrekbH6tR5ut2NE4Jbm7zLWlDhl_3DD2NqnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhxAAyPtIO8nhnCfUnSiRc8uDYExgVVY2Ml08VnRts9Q&oe=6B0F16B9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GPB VR|AR", "platform
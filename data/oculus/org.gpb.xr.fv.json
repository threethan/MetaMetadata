lic Broadcasting.\n\nTransport your students across Georgia, from the Okefenokee Swamp to the Civil Rights Movement, and explore multimodal, standards-aligned content such as 360\u00b0 videos, interactive graphics, AR expansions, and primary historical sources.\n\nThe GPB VR/AR App works on any device, with optional headset support, and brings cross-curricular content to life, making learning engaging and fun.\n\nGet ready to discover, explore, and experience Georgia in ways you\u2019ve never imagined!\"", "short_description": "Explore Georgia through immersive VR field trips and interactive AR lessons that make learning come alive."}]}, "developer_name": "FableVision Studios", "developer_privacy_policy_url": "https://www.gpb.org/about/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Georgia Public Broadcasting", "support_website_url": "http://www.gpb.org/about/contact", "website_url": "http://www.gpb.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26086815077582235"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1581735662845790"}]}, "baseline_offer": {"id": "1581735662845790"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767799980, "status": "PUBLISHED", "id": "1581735662845790"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Andro
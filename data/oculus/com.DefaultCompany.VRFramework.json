ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974653_366715698586486_1889322888996170867_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDtxoI6PDjQQ7kNvwGqF57w&_nc_oc=AdqBzbUXHUbGy6ver3_gzA9sS3iBDEjgIMlkxTsWptOGYKvCGeB287OvWSth4YnMU5Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHX9S68QmhNbO_0bFT6RzqWBBfmtMNTVW-DvEUfMwHyw&oe=6A8AD49F"}, {"file_name": "2a.png", "id": "1152982421899741", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974644_1152982425233074_5934861979058294404_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjWwAQWWAjwQ7kNvwFIp7uk&_nc_oc=AdpXpFdV5sGt_N8nniFW1a_Y9vWUnUMk8RJHo5wq70adfcHlxyG9BEimztTZz7qHEhI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK88XQTeLIldRMVlbv5Il0encmIgUP0EOeAI79YFTAnA&oe=6A8AEB4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5a.png", "id": "486087429501100", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86610709_486087432834433_1989048406849012977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIq1fQjjlcwQ7kNvwHsosvB&_nc_oc=Adpjjvq4qP9HDH6wrZz6zaVR5-5HUmqyJ5MvzJk0lfY8Cc_s05UBjtKJWgPz7f4RHoI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrqZt5kRmnZS_hb16jjyCRNg6a6S20MKNfbOBU9QWTjA&oe=6A8AC7E3"}, "display_name": "Match Blast", "keywords": ["puzzle", "zen", "relax", "shooter", "space"], "long_description": "Match Blast: A Retro-Inspired VR Shooter\n\nInspired by classic '80s games like Tempest and Asteroids, Match Blast brings a zen-like focus and thrilling gameplay to the VR shooter genre. Strap in and get ready to use your mind and trigger fingers to conquer the odds in this immersive experience.\n\nStrategic Shooting: Stay focused and blast targets coming at you from three tunnels.\n\nUnlockable Rewards: Earn gems to unlock new blasters and level designs.\n\nDual-Wield Fun: Equip blasters in both hands or mix and match to suit your style.\n\nMatch Blast is a must-have for any Quest owner, offering a perfect blend of nostalgia and modern VR action.", "short_description": "Match Blast: A Retro-Inspired VR Shooter\n\nInspired by classic '80s games like Tempest and Asteroids, Match Blast brings a zen-like focus and thrilling gameplay to the VR shooter genre. Strap in and get ready to use your mind and trigger fingers to conquer the odds in this immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/match-blast-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9036166563067128"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974816_299544178763452_8893538142341751681_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HpQ_iKoOFkQ7kNvwE24Kmi&_nc_oc=AdoBgbOhXLX4rAM_ReAauB5vHKYDkAFtrboBFa5EvE-cqgy7dWf_0Rm7QnK3hRdhA30&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa_Jo3i0vZ7Rde91axGW_1fwHiP4ETtv8GP_6ROsmaEg&oe=6A8AC8D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Match Blast", "platform": "ANDROID_6DOF", "context_category": 
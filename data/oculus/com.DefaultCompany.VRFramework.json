ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974653_366715698586486_1889322888996170867_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbA5Y5Z1kiEQ7kNvwEIJB92&_nc_oc=AdoH-okm75vLwGgXHcElatm9VG5fWJgCjK-JjTxYxA19aBeQTkIetqLbHY9ESn3_Uwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz6zFD1_EVt7Er2lJzflXVPi5zR2-9zbFff42RLdpbvQ&oe=6AEDED5F"}, {"file_name": "2a.png", "id": "1152982421899741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974644_1152982425233074_5934861979058294404_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNoz_hGsDhwQ7kNvwGGN6jP&_nc_oc=AdpC-UIMru8bLCaq5SQtpnHUHidAAHKTf6I-z7l9zbvqBJlWXyMCuhHBy06A2xqXk14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ5VhKSaXlVHEqIKkhJg0Mtby8z_ePiuXpzzQ8TO9rYg&oe=6AEE040D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5a.png", "id": "486087429501100", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610709_486087432834433_1989048406849012977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqa3JXfdtjwQ7kNvwGhjHQi&_nc_oc=AdoUvVH3yxHhzPkactJvXxoNvwsFPYyLEmnAq84eD3xZgq2ebelXkj0f1FhmzmFaiJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRum-b4mTLlIYKES2LKDUWKKutaf_gl7pngVr-bpTWdrQ&oe=6AEDE0A3"}, "display_name": "Match Blast", "keywords": ["puzzle", "zen", "relax", "shooter", "space"], "long_description": "Match Blast: A Retro-Inspired VR Shooter\n\nInspired by classic '80s games like Tempest and Asteroids, Match Blast brings a zen-like focus and thrilling gameplay to the VR shooter genre. Strap in and get ready to use your mind and trigger fingers to conquer the odds in this immersive experience.\n\nStrategic Shooting: Stay focused and blast targets coming at you from three tunnels.\n\nUnlockable Rewards: Earn gems to unlock new blasters and level designs.\n\nDual-Wield Fun: Equip blasters in both hands or mix and match to suit your style.\n\nMatch Blast is a must-have for any Quest owner, offering a perfect blend of nostalgia and modern VR action.", "short_description": "Match Blast: A Retro-Inspired VR Shooter\n\nInspired by classic '80s games like Tempest and Asteroids, Match Blast brings a zen-like focus and thrilling gameplay to the VR shooter genre. Strap in and get ready to use your mind and trigger fingers to conquer the odds in this immersive experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/match-blast-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9036166563067128"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974816_299544178763452_8893538142341751681_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFFy-58PsqAQ7kNvwFwnKMt&_nc_oc=AdohJG3eb2RR27NMMZqqgK5TOolTwnWsgbiInbO-heh6y26Ya4FyszJJmVF8PiSND_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTclLiQEHIbOBAsVDl6JdCrkPZdNKcsOYRGJfvDHgKCw&oe=6AEDE192"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Match Blast", "platform": "ANDROID_6DOF", "context_category": 
14D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5a.png", "id": "486087429501100", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86610709_486087432834433_1989048406849012977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRhLzpQ4cHgQ7kNvwEAp5cS&_nc_oc=Adlk8qmWaxNwU8EW8iv5DnOXODK0BHKdsJtj6IemFZPQQxyfk5fFTOu6Quer5ZtWtRc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxh1_CBw4lvyIzdHh69JDWxP3cCKh-1yFA3P2gy10DmbQ&oe=69BD5623"}, "display_name": "Match Blast", "keywords": [], "long_description": "Inspired by revered 80's classics like Tempest & Asteroids, Match Blast brings a zen-like focus and fun gameplay to a  first-person shooter style VR game. Strap in and get ready to use your mind and your trigger fingers to beat the odds in Match Blast.\n\n\u2022 Use your wits to stay focused and blast the targets that come at you from the three tunnels before you.\n\u2022 Earn gems to unlock new blasters and level designs.\n\u2022Equip your earned blasters to both hands or mix it up to suit your mood.\n\nMatch Blast is a must have for Quest owners.", "short_description": "Inspired by revered 80's classics like Tempest & Asteroids, Match Blast brings a zen-like focus and fun gameplay to a  first-person shooter style VR game. Strap in and get ready to use your mind and your trigger fingers to beat the odds in Match Blast."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/match-blast-privacy", "developer_terms_of_service_url": null, "publisher_name": "John Ray", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_conn
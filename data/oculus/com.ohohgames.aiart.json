-CHsQ7kNvwGRGAm6&_nc_oc=AdrW-4DZSyxWF2ZTUpgQz7qC729Gi2o9gF0QQ59rFpT4cd6-Bd2lh7vvW7xNImWnlzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FKbS2-w_4mIErFY5VDMoO7aoGQyRXGpVHsZhMrEpq6w&oe=6A283002"}, {"file_name": "image_013_0000.png", "id": "1052433412402221", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982716_1052433415735554_7528727839608164299_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E82MA9dLRdgQ7kNvwGmsbDh&_nc_oc=Adp9bNYfGEfLYFIUM5bFJkAhTqtn9ajh_TG-NPiey4nqurDrbpdVP34264sAHRGphSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eobmOsYuIZvpgbrZElt0AEQTlXzo3nNTBLb8_-JXXzw&oe=6A282355"}, {"file_name": "image_014_0000.png", "id": "184489251126308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982528_184489254459641_3192966843584969676_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0umtFUzXjJEQ7kNvwEsXJ_v&_nc_oc=AdoTgC5a4G8uxQsXcAVT3bu27tfTB0lOtDDk8I8YSsleTAq-CIKhR5qAptCJWqD572U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rHFUFbYt--_QxWi_cW3bNH4RkOZMNXJYyxbrwx3nsXg&oe=6A282D93"}, {"file_name": "image_016_0000.png", "id": "241699644922470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035408_241699648255803_7665033877581367890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-PxJNB_hh0Q7kNvwEa5UIK&_nc_oc=AdrLaJYZ4-dnrnc6a7lXaiD0F1uVTkgZs-OtoXx4NRU8CZAiU-Rc9gUB1z9In3fBUlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZURZwekNoGAhcP5K4SAkL7MfZeIz960gqoJW5X4gwsw&oe=6A28315F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easy Art - AI Text To Image", "keywords": [], "long_description": "Unleash your creativity with Easy Art, the ultimate AI text to image app. With our advanced AI model, you can transform your ideas and concepts into stunning, one-of-a-kind artwork. Simply input your text prompt and let our AI engine do the rest, generating beautiful and highly-detailed images based on your instructions.\n\nOur app comes with a range of features to help you create and save amazing artwork. You can review and reuse your past creations with our history view, and explore a variety of pre-generated samples in the \"Sample Art\" view. Our prompt builder feature guides you on how to construct your text prompt to get the best results from our AI model.\n\nWhether you're an artist, writer, or just looking for a fun way to express yourself, Easy Art has something for everyone. Try it out now and discover the endless possibilities of AI-powered art!\n\n", "short_description": "Turn your ideas into beautiful art with AI text to image. Create, save, and share amazing artwork."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-privacy-policy/c48c1852-34ce-44e9-9850-12ecbe2eaaf1/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-terms-of-use/3de67b51-fdb8-428c-b9d6-3ce5fd947a63/terms", "publisher_name": "OhOhGames", "support_website_url": null, "website_url": "https://www.ohohgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598728588636549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569432_246801957800597_7907717695953400907_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=
LpMUQ7kNvwFwV4z9&_nc_oc=AdpUiyAd9bOM8gWeVWjlGdkdlqJJsizNQ5ZYHvlvog7YMPbQ38yqbagGW-Ny51Ii4-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJouIfSiUChfO6s86QgYv36sHOFgOjJvXs6SJtNT1qLBA&oe=6AB7E382"}, {"file_name": "image_013_0000.png", "id": "1052433412402221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982716_1052433415735554_7528727839608164299_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQdF78Ug3qoQ7kNvwHHPqAl&_nc_oc=AdrXxt9-rzyi3hXajEtzrmCJ7VEDj91M9vG3jE5kWMjnuCyl4yl6wWZBhVE4oJ_vEk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsQdFwn8QKS-eKYYV4Dvs1HBYEfj92hxNc382itRoZNw&oe=6AB7D6D5"}, {"file_name": "image_014_0000.png", "id": "184489251126308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_184489254459641_3192966843584969676_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI2NGiJcvsQQ7kNvwFW0ZyW&_nc_oc=Adqkjj3_1vT7Db2kPHHDHAxEQcgpVba38k5zt4ckwrk3bFwqkJfq44Rh0c26QLdWbOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr6Eoh5Y_Esc2Sg8oYlRYyUeS1aM8kqtHlCbS2oAgCLQ&oe=6AB7E113"}, {"file_name": "image_016_0000.png", "id": "241699644922470", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035408_241699648255803_7665033877581367890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUtkVahVCqIQ7kNvwHZbNHL&_nc_oc=Adp-340Bt0uDIDog9Y6PrtQv52pLCmqmHdmWV3FMCgnnFe5BwAuaJEFe2pHoxWx9gvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPMvEeMTk42HzXIb2pB4BkIgQ5liIQ1l_ufnriJpxM5Q&oe=6AB7E4DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easy Art - AI Text To Image", "keywords": [], "long_description": "Unleash your creativity with Easy Art, the ultimate AI text to image app. With our advanced AI model, you can transform your ideas and concepts into stunning, one-of-a-kind artwork. Simply input your text prompt and let our AI engine do the rest, generating beautiful and highly-detailed images based on your instructions.\n\nOur app comes with a range of features to help you create and save amazing artwork. You can review and reuse your past creations with our history view, and explore a variety of pre-generated samples in the \"Sample Art\" view. Our prompt builder feature guides you on how to construct your text prompt to get the best results from our AI model.\n\nWhether you're an artist, writer, or just looking for a fun way to express yourself, Easy Art has something for everyone. Try it out now and discover the endless possibilities of AI-powered art!\n\n", "short_description": "Turn your ideas into beautiful art with AI text to image. Create, save, and share amazing artwork."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-privacy-policy/c48c1852-34ce-44e9-9850-12ecbe2eaaf1/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-terms-of-use/3de67b51-fdb8-428c-b9d6-3ce5fd947a63/terms", "publisher_name": "OhOhGames", "support_website_url": null, "website_url": "https://www.ohohgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598728588636549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569432_246801957800597_7907717695953400907_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=
2433415735554_7528727839608164299_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PirkaSysSqcQ7kNvwEf7LKx&_nc_oc=AdqCMkNrF0RNh57p8Z4DcAH-O8zleyqezuNrFMS2Wk2oqvCqo0g5t_s98r3QWqRi94c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyTZ-3Apxvp_zbpKAFD6PEytPtuCbYk_6qr0ITfYFyBQ&oe=6B072915"}, {"file_name": "image_014_0000.png", "id": "184489251126308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_184489254459641_3192966843584969676_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ic758o1mLgQ7kNvwExmdkl&_nc_oc=AdqyrwIbXW4F3INGPyHDYviuJ_cfaSDKyaKG5wMD3nBOp1vG9Qtimjli1a6h61kDC6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Wfst2G1eTfUW9rxJiH8pIWi7thuwJsfPw2smSrJHHQ&oe=6B06FB13"}, {"file_name": "image_016_0000.png", "id": "241699644922470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035408_241699648255803_7665033877581367890_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjS5seCUOLsQ7kNvwFjWPN3&_nc_oc=Ado_DroyxZuyer1k3KqM7b7WSo_-Riw7M-4kojtFAOJGQfHnoO0bpT6WjxVMrpz7B5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuYbgNZYNJvhb41sJ4EklpdKmtNHi0D22dCnLCoh-Pxg&oe=6B06FEDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easy Art - AI Text To Image", "keywords": [], "long_description": "Unleash your creativity with Easy Art, the ultimate AI text to image app. With our advanced AI model, you can transform your ideas and concepts into stunning, one-of-a-kind artwork. Simply input your text prompt and let our AI engine do the rest, generating beautiful and highly-detailed images based on your instructions.\n\nOur app comes with a range of features to help you create and save amazing artwork. You can review and reuse your past creations with our history view, and explore a variety of pre-generated samples in the \"Sample Art\" view. Our prompt builder feature guides you on how to construct your text prompt to get the best results from our AI model.\n\nWhether you're an artist, writer, or just looking for a fun way to express yourself, Easy Art has something for everyone. Try it out now and discover the endless possibilities of AI-powered art!\n\n", "short_description": "Turn your ideas into beautiful art with AI text to image. Create, save, and share amazing artwork."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-privacy-policy/c48c1852-34ce-44e9-9850-12ecbe2eaaf1/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-terms-of-use/3de67b51-fdb8-428c-b9d6-3ce5fd947a63/terms", "publisher_name": "OhOhGames", "support_website_url": null, "website_url": "https://www.ohohgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598728588636549"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "538385261568239"}]}, "baseline_offer": {"id": "538385261568239"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681944660, "status": "PUBLISHED", "id": "538385261568239"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6158340950919130", "version": "0.0.1"}, "id": "1384424102411165", "channel
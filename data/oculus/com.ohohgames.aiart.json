2433415735554_7528727839608164299_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Lz5qvTnLyoQ7kNvwHzI0b0&_nc_oc=Adqvx-6HZ9iyZ6ECfC9v6QpHO4Ukx1_VlzicoDzYciNxVRQUxWoXm7jmnCi1KaxsoNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4epNIO5x9it7VKQxopO2w4RM6edEHNSdKNs9pUT-7Vw&oe=6AFDB655"}, {"file_name": "image_014_0000.png", "id": "184489251126308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982528_184489254459641_3192966843584969676_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydXn2jcks3cQ7kNvwHafeVV&_nc_oc=Adq0Q5NpvuHAJR6JX_gYn3JZum80fVoAis21b1vGHPjbZXVNj13hE_tOgxrc7th2Hok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTBFDXieXFPBrPvKk7JdIhChQf6xXXErAn01tFYGLgzg&oe=6AFDC093"}, {"file_name": "image_016_0000.png", "id": "241699644922470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035408_241699648255803_7665033877581367890_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rPQ0dkHW-QQ7kNvwHlo8ej&_nc_oc=AdpBG4FLWOLzsIZz9XXbHJ0xRC9xgOE4XoOokX8ozcvfUSiomtfjIG-gJA8HL9TdMrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzj8tpHws0v9qwK9xGjD1cCwBG1kD5M7OTzGWJ4ceaRA&oe=6AFDC45F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easy Art - AI Text To Image", "keywords": [], "long_description": "Unleash your creativity with Easy Art, the ultimate AI text to image app. With our advanced AI model, you can transform your ideas and concepts into stunning, one-of-a-kind artwork. Simply input your text prompt and let our AI engine do the rest, generating beautiful and highly-detailed images based on your instructions.\n\nOur app comes with a range of features to help you create and save amazing artwork. You can review and reuse your past creations with our history view, and explore a variety of pre-generated samples in the \"Sample Art\" view. Our prompt builder feature guides you on how to construct your text prompt to get the best results from our AI model.\n\nWhether you're an artist, writer, or just looking for a fun way to express yourself, Easy Art has something for everyone. Try it out now and discover the endless possibilities of AI-powered art!\n\n", "short_description": "Turn your ideas into beautiful art with AI text to image. Create, save, and share amazing artwork."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-privacy-policy/c48c1852-34ce-44e9-9850-12ecbe2eaaf1/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-terms-of-use/3de67b51-fdb8-428c-b9d6-3ce5fd947a63/terms", "publisher_name": "OhOhGames", "support_website_url": null, "website_url": "https://www.ohohgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598728588636549"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "538385261568239"}]}, "baseline_offer": {"id": "538385261568239"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1681944660, "status": "PUBLISHED", "id": "538385261568239"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6158340950919130", "version": "0.0.1"}, "id": "1384424102411165", "channel
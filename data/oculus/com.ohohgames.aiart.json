QvhIQ7kNvwFWhA4n&_nc_oc=Adp0FdWVW_fKh6KYDVQC0Lzq_t5qycFRr-atMB_kIJkI14R3YhyGlvPG78oX7Ula_KE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AXGXxSvcdsjBgeHmX4R80V3hah9w8fCcJMn0EYxMkhQ&oe=6A131802"}, {"file_name": "image_013_0000.png", "id": "1052433412402221", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982716_1052433415735554_7528727839608164299_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rkuy3bDrLwQ7kNvwHFM2fK&_nc_oc=Ado6JFGl-sIf9kDokJShqG20VVd9ysdNe6vuf8ZhIvAPSPBW1kjsz5WsYvGmzylG_Lw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i_eXJwe4ykdjDuhEjyP8r5IhbA3mx_eVaBy3G_ORSaA&oe=6A130B55"}, {"file_name": "image_014_0000.png", "id": "184489251126308", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982528_184489254459641_3192966843584969676_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IVw6QfSCyoQ7kNvwECaKRU&_nc_oc=AdprZBViLDRoR9PHqCqgHMfPITTr8DUG8xYE_93xmR-spcs6hjFAr4pBbnE4EFPxWP8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZEw_Mj2WkjdZHVKO7Zoyv7S7fUyxhJVn4TuAmldVOSA&oe=6A131593"}, {"file_name": "image_016_0000.png", "id": "241699644922470", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035408_241699648255803_7665033877581367890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVzOjDdM_swQ7kNvwGV6qF_&_nc_oc=Adp4rMZazjm58CwRNt6s6WqpjncojSgRyAE2YYgJpdvZDWGbLKX_MCfoybXsfo6YAs8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69GBXcbsXqzPy41r3nucoXs1rpdWgv6t1nahxsC_uTXg&oe=6A13195F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easy Art - AI Text To Image", "keywords": [], "long_description": "Unleash your creativity with Easy Art, the ultimate AI text to image app. With our advanced AI model, you can transform your ideas and concepts into stunning, one-of-a-kind artwork. Simply input your text prompt and let our AI engine do the rest, generating beautiful and highly-detailed images based on your instructions.\n\nOur app comes with a range of features to help you create and save amazing artwork. You can review and reuse your past creations with our history view, and explore a variety of pre-generated samples in the \"Sample Art\" view. Our prompt builder feature guides you on how to construct your text prompt to get the best results from our AI model.\n\nWhether you're an artist, writer, or just looking for a fun way to express yourself, Easy Art has something for everyone. Try it out now and discover the endless possibilities of AI-powered art!\n\n", "short_description": "Turn your ideas into beautiful art with AI text to image. Create, save, and share amazing artwork."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-privacy-policy/c48c1852-34ce-44e9-9850-12ecbe2eaaf1/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-terms-of-use/3de67b51-fdb8-428c-b9d6-3ce5fd947a63/terms", "publisher_name": "OhOhGames", "support_website_url": null, "website_url": "https://www.ohohgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598728588636549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569432_246801957800597_7907717695953400907_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=
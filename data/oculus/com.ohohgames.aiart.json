YnEsQ7kNvwGnra58&_nc_oc=AdpREduSMl8P5oKvHvxTstqnwARrSCReTE-k27q3xopcdMKIMEGeeZV6Ou7rffjOcog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlKYFkwNcKFEhjmBpcggxP-5QChpskJ2NE8JxqhOW6jg&oe=69C90BC2"}, {"file_name": "image_013_0000.png", "id": "1052433412402221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982716_1052433415735554_7528727839608164299_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3iE5kTmJg4Q7kNvwEGuxUM&_nc_oc=AdoEnrSD9Lt9kk6qM8QoJAMiNge-jVwGN8cMgDn4Ad-Mzu9MG2FF6tyCjtcGLG7ZlHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afydz0h8RyjyR7ovYQS7HQL3fxPDqo6RFfSgyLPP6pt2fw&oe=69C93755"}, {"file_name": "image_014_0000.png", "id": "184489251126308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_184489254459641_3192966843584969676_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KhazxT3pa4Q7kNvwEXASUE&_nc_oc=AdqJGxJV68HA9Zl7PT-Zjsv1gtEovfw9fQUt88kssoRlS5gtfdtEUainmkpHyNOQAgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOM5Yj1IH7a636He_tF5GNJtwHgVBPc2MEBEyqgJxEBA&oe=69C90953"}, {"file_name": "image_016_0000.png", "id": "241699644922470", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035408_241699648255803_7665033877581367890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dTse3jT2bQQ7kNvwHJ4WXe&_nc_oc=Ado_lXq5FmdIi3oEzp6FGf6pp85GnyWQKJV_I_eL9bvU34GTWfDcTiD3X-U6d1F5Krw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9pMQsyvM9xN19Z6DMwS-DOStRj65xoQDC8eNpwz84-A&oe=69C90D1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easy Art - AI Text To Image", "keywords": [], "long_description": "Unleash your creativity with Easy Art, the ultimate AI text to image app. With our advanced AI model, you can transform your ideas and concepts into stunning, one-of-a-kind artwork. Simply input your text prompt and let our AI engine do the rest, generating beautiful and highly-detailed images based on your instructions.\n\nOur app comes with a range of features to help you create and save amazing artwork. You can review and reuse your past creations with our history view, and explore a variety of pre-generated samples in the \"Sample Art\" view. Our prompt builder feature guides you on how to construct your text prompt to get the best results from our AI model.\n\nWhether you're an artist, writer, or just looking for a fun way to express yourself, Easy Art has something for everyone. Try it out now and discover the endless possibilities of AI-powered art!\n\n", "short_description": "Turn your ideas into beautiful art with AI text to image. Create, save, and share amazing artwork."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-privacy-policy/c48c1852-34ce-44e9-9850-12ecbe2eaaf1/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-terms-of-use/3de67b51-fdb8-428c-b9d6-3ce5fd947a63/terms", "publisher_name": "OhOhGames", "support_website_url": null, "website_url": "https://www.ohohgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598728588636549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569432_246801957800597_7907717695953400907_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=
nwQAQ7kNvwHX4PEG&_nc_oc=Adopoc027BgMAx4jIVHe6XBIswvJWof7-iwl0sW8CxehCPcmFowMRkm3V62aGZMlFJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE218aVV8DpDAw8Hf9PzQP9T3LPtHqTGM5TXrQYqbzxnA&oe=6A8440C2"}, {"file_name": "image_013_0000.png", "id": "1052433412402221", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982716_1052433415735554_7528727839608164299_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7UyiQn2anwQ7kNvwHhKFwe&_nc_oc=AdpJeOhHNt04-OJS9kvdGDFBD1d-sj-QJflpgfcAPATGM6AbpAieZP9dEdIOyAl5ozw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7ZjtK-Vv9ZvJKjgWim9rTj1x0tP5xHTfr5Cp6GLxvXQ&oe=6A843415"}, {"file_name": "image_014_0000.png", "id": "184489251126308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982528_184489254459641_3192966843584969676_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy08bmH9ydgQ7kNvwHKOinP&_nc_oc=AdqBoZwogBUAlRtxfzOGpTJPTYB-B_5t1q1dF2E_n7ExO6qcqfoFhFgmVKrP2PTpmxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFxXfCiO7a6XSZHgpgynnZvGRbh8WUUkye7k-9hW9p7Q&oe=6A843E53"}, {"file_name": "image_016_0000.png", "id": "241699644922470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035408_241699648255803_7665033877581367890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRK_T0--fjQQ7kNvwFq8-hW&_nc_oc=AdqdL2_d79kGb2jOaEAWg4ME2aQI1w9g5UTic3hV2sIumGluZyv9BrehvK9hKMsn-RQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFN4tw3sQHxsSsLlkQ1DhcPunUAqRa8pc2W1YnfP1zCw&oe=6A84421F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Easy Art - AI Text To Image", "keywords": [], "long_description": "Unleash your creativity with Easy Art, the ultimate AI text to image app. With our advanced AI model, you can transform your ideas and concepts into stunning, one-of-a-kind artwork. Simply input your text prompt and let our AI engine do the rest, generating beautiful and highly-detailed images based on your instructions.\n\nOur app comes with a range of features to help you create and save amazing artwork. You can review and reuse your past creations with our history view, and explore a variety of pre-generated samples in the \"Sample Art\" view. Our prompt builder feature guides you on how to construct your text prompt to get the best results from our AI model.\n\nWhether you're an artist, writer, or just looking for a fun way to express yourself, Easy Art has something for everyone. Try it out now and discover the endless possibilities of AI-powered art!\n\n", "short_description": "Turn your ideas into beautiful art with AI text to image. Create, save, and share amazing artwork."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-privacy-policy/c48c1852-34ce-44e9-9850-12ecbe2eaaf1/privacy", "developer_terms_of_service_url": "https://doc-hosting.flycricket.io/easy-art-ai-text-to-image-terms-of-use/3de67b51-fdb8-428c-b9d6-3ce5fd947a63/terms", "publisher_name": "OhOhGames", "support_website_url": null, "website_url": "https://www.ohohgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "598728588636549"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569432_246801957800597_7907717695953400907_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=
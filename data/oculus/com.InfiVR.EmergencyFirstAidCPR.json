nce, and interactive feedback, trainees gain hands-on experience that prepares them to act swiftly and confidently in real-world emergencies.", "short_description": "InfiVR\u2019s CPR Training VR Simulation builds real-life emergency skills through realistic hospital scenarios, guided practice, and instant feedback for confident life-saving action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.infivr.com/privacy-policy", "developer_terms_of_service_url": "https://www.infivr.com/terms-and-conditions", "publisher_name": "InfiVR", "support_website_url": null, "website_url": "https://www.infivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25028486606764598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619829_1337415851155931_1810458893760967635_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNej_ThP1V0Q7kNvwHS7BAv&_nc_oc=AdoDdbfLHda_Hgd1MGjCKrcBw4A8pRgwVZjFH3orvI_ka8CbItvi532CHqWw3Slajqc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCzddCQRvZnd389_Y_Jm5g_LdQpQ4bGe0OLyv3w6WAiw&oe=6B0B3C24"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emergency First Aid & CPR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "con
c_sid=6e7a0a&_nc_ohc=2IidnbQ-rNkQ7kNvwG9suc6&_nc_oc=Adp1eAszXnE_xcBCqKII7tQIvEIhOuslRB6GvMAunDsarrtv10LHrwFpM-98keA1KUs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcjY7-GNxDU1O_0gtq69grKHMnLz28SEwpamzNrlSflg&oe=6AF9B936"}, {"file_name": "05_Cellar.png", "id": "1771406587408626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830822_1771406590741959_177288660088397283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6QCPN0XCKcQ7kNvwGB-Q8Z&_nc_oc=Adrn20ykYs5k-UT9B89eKbLwX8BPag9TAoPXUFZwTiM4g8sN26bDZxFPf2rGAbA4e_I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVu87Lg55myQYOAhShbszeh73bvU7ifsA3TgivMNJM4w&oe=6AF9BE7C"}, {"file_name": "04_Bedroom.png", "id": "29106929672256771", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830904_29106929692256769_5572294963789829916_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkJRPxaruI0Q7kNvwEg8qZi&_nc_oc=Ado21pP-JIF2X49-1FtHgbZTsBpHg77HHYrPhd5dWqcqaCVIxSNLrJbu32eEKWMwFCE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeZQLTlajXgVvLh1pPMhU-0DLW7jwUEKGkYxF9txbYCg&oe=6AF9D64E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Reynolds_House_VR_Cover.png", "id": "1423068763269585", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595129854_1423068766602918_6394018474434868766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BN1qtutir4Q7kNvwGHu4uJ&_nc_oc=AdrY0aXP87pQuugMMEg1bGhwpnPXyMOxhM_5wl-GnRIRT_OknwSsE9osHXvpZ1RRs6U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2-CnFaiDPR7lFDkO1SMBn7OfRew-dTHt8IWSLX8QOvA&oe=6AF9E3E7"}, "display_name": "Reynold's House VR", "keywords": ["Horror", "Psychological", "Survival", "Memories", "House"], "long_description": "Five nights. Thirty memories. One house that refuses to let its past rest.\nThe Reynolds House VR is a psychological horror experience that puts you inside a haunted family home. Explore its rooms by flashlight, search furniture for keys, and collect small glowing photographs to piece together the Reynolds family's story.\nEvery key opens the way deeper into the house. Look closely at tables, chests and shelves, follow the clues around you, and keep track of the memories you uncover in your journal. The large wall portraits offer clues; the smaller glowing photographs are the memories you can collect.\nYour sanity is slipping. A visible HUD bar helps you judge how much time you have left, but finding answers means deciding when to push on and when to retreat. As sanity falls, the house becomes more threatening and hallucinations can give chase. Return to the master bed before your sanity reaches zero to survive the night.\nSome secrets only reveal themselves when you are close to breaking. Search carefully, unlock hidden areas, and choose whether another discovery is worth the risk. How much of the past you recover shapes the ending you receive.\nDesigned for standalone Quest VR, the game offers controller-based interaction, a hand-mounted flashlight, teleport or smooth movement, snap turning, and options to reduce creature and light effects.\nSurvive all five nights, uncover the family's memories, and discover what waits beneath the fear. Will you leave with the whole story?", "short_description": "Step inside The Reynolds House VR, a haunted home where every night tests your sanity. Search for keys, collect forgotten memories, and uncover a family's story across five nights. Keep your flashlight close, watch your sanity, and return to bed before the house claims you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://reynoldsprivacypolicy.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Anarxhy", "support_website_url": null, "website_url": "https://anarxhy.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "6443548731
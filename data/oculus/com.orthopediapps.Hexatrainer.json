71-25/491830822_2309444476542327_5727035702448157203_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBktuHtJYHYQ7kNvwHf53Df&_nc_oc=AdoJBSywuzhltNr3uXJM5T_Yfd5QNHNmoRAqo8_6U4bguVFcTr11iCPBLa5ZNpvi-Ok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwjJuDFohYerk0nXDvqT42qIq-pXfnhbYUeCrCUqMsLA&oe=6AC798E2"}, {"file_name": "Imagen 1.png", "id": "1396432511959143", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595129854_1396432515292476_8858652479021212391_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1q282yq_u0Q7kNvwF-AObI&_nc_oc=AdolF7nq1FJzwA1fsfP2TV6XoScLJK4ZcwCCZdPMlc6E1RQ1TYIka9DgYe3o0bCRnMM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0Fc7ezTbU7Y8TUMadVwG6n9WD_nyE1s-5-VZ-r4tPQQ&oe=6AC7C9F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "28224509947159808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831569_28224509963826473_9002340485282904486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2RXMViB20gQ7kNvwElO3vu&_nc_oc=AdoghqSzDU2xAT2yQ0eR_QD3CcPY0msmoUH-aLsGN3CUAmQrgCo0xNgvW6604s1QdpQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdEWePBc1ZX4LL__ddOytw8A2qd1pUCVtj42lkdsI1HQ&oe=6AC7C788"}, "display_name": "HexaTrainer", "keywords": ["hexapod", "orthopedics", "external", "fixation", "bone"], "long_description": "Hexatrainer is an educational and trainer platform for limb deformity correction procedures using external circular fixation systems. It provides virtual and mixed reality workshops and a special workshop where you can visualize anatomy and practice pinning through safe corridors. \n\nFeatures:\n- Complete hexapod system (Full and rings, foot plates, bolts, blocks, posts, etc...). \n- Lots of example cases. \n- Free assembly sequence (allows premounting). \n- Free positioning of components, osteotomy level and orientation. \n- Frame preassembly. \n- Live strut length information. \n- Deformity manager; Accurately make your corrections. \n- Basic osteosynthesis with plate and screws. \n- DLC system; Downloadable content (new cases, new hardware...). \n- Mixed reality mode, which adds comfort to the experience.\n\nThe app is intended for use by trained surgeons with prior knowledge on specific topics and surgical procedures.", "short_description": "Simulator and trainer for limb deformity correction surgery using hexapod systems. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orthopediapps.com/en/privacy-policy-hexatrainer", "developer_terms_of_service_url": null, "publisher_name": "F. Javier Narbona C\u00e1rceles", "support_website_url": null, "website_url": "https://www.orthopediapps.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38347403978238866"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595129854_4368011706743907_7190017516168895851_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H0klwtgqnQQ7kNvwFSZfho&_nc_oc=AdqrV1YMVi8SUUGgZOHOd-sbp1UPKevRN0HUIW3gRNxMj2Z0WZYMjKgBlWK3uCnyN5E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcpD_YWaxUmwnBv8n5z-kMcH0yi2PGB7UH-tw3Tk6LqQ&oe=6AC7A90E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_nam
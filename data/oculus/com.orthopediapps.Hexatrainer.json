.com/v/t64.5771-25/75210400_891653365967589_3792996722193671593_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYKILEPiTXAQ7kNvwG0hxka&_nc_oc=AdoNBOPz9rtQ50geLFuwMX2JOWm4wuEi0ul6_bOiX2eruhusGFJyi4YJ7Nroorpr67w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaE87LQWsyMT8M8XkbsPLLcfl11bjSdbcMRcRfCKiKPQ&oe=6AE8A786"}, "display_name": "HexaTrainer", "keywords": ["hexapod", "orthopedics", "external", "fixation", "bone"], "long_description": "Hexatrainer is an educational and trainer platform for limb deformity correction procedures using external circular fixation systems. It provides virtual and mixed reality workshops and a special workshop where you can visualize anatomy and practice pinning through safe corridors. \n\nFeatures:\n- Complete hexapod system (Full and rings, foot plates, bolts, blocks, posts, etc...). \n- Lots of example cases. \n- Free assembly sequence (allows premounting). \n- Free positioning of components, osteotomy level and orientation. \n- Frame preassembly. \n- Live strut length information. \n- Deformity manager; Accurately make your corrections. \n- Basic osteosynthesis with plate and screws. \n- DLC system; Downloadable content (new cases, new hardware...). \n- Mixed reality mode, which adds comfort to the experience.\n\nThe app is intended for use by trained surgeons with prior knowledge on specific topics and surgical procedures.", "short_description": "Simulator and trainer for limb deformity correction surgery using hexapod systems. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orthopediapps.com/en/privacy-policy-hexatrainer", "developer_terms_of_service_url": null, "publisher_name": "F. Javier Narbona C\u00e1rceles", "support_website_url": null, "website_url": "https://www.orthopediapps.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1213752112642105"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1442259120970583"}]}, "baseline_offer": {"id": "1442259120970583"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763147040, "status": "PUBLISHED", "id": "1442259120970583"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39046571084988815", "version": "7"}, "id": "183605694593935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39046571084988815"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183605694593935"}]}, "change_log": "\"Virtual ruler now displays the traverse bisector line (CORA line).\\n Solved a bug that made two independent bones connected to the same ring not behaving correctly. \\nSolved a bug that made specific bone models connected to a frame, loaded from a previously saved session and then cut, not retaining connections to rings.\"", "created_date": 1791823197, "id": "39046571084988815", "version": "7", "version_code": 93, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39046571084988815"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183605694593935"}]}, "change_log": "Users can now save their work and continue modifying their builds across sessions.\nSaved builds can be opened in either the VR or MR workshop.\nImproved layout and organization of model and gadget selection.\nImprovements to several tools, including the virtual measuring tool. \n", "created_date": 1789734787, "id": "38446757044970225", "version": "7", "version_code": 92, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39046571084988815"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789148885, "id": "38268578209454777", "version": "7", "version_code": 91, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39046571084988815"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183605694593935"}]}, "change_log": "Fixed bugs on the deformity manager; \n- You should see correctly the axes and CORA markers even on custom cases. \n- Choosing an independent bone fragment fixed to a ring on another bone fragment (i.e calcaneus on a butt frame) now works as expected, avoiding moving the whole frame as a block. \nFixed a bug on tutorial screen where users could not complete struts, rods and hinges tutorials due to rings not accepting pieces. \nAdditions;\n- Added extension plates for adjacent diameters and 3 above. \n- Added 45 deg. extension plate. \n- Removed golden posts. \n\n", "created_date": 1773281718, "id": "34190721697240469", "version": "7", "version_code": 90, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39046571084988815"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183605694593935"}]}, "change_log": "Fixed an important issue where Pins and wires placed on an already fixed ring lost position if an important mismatch between controller real world position and drill position was present. ", "created_date": 1773087619, "id": "34151476134498359", "version": "7", "version_code": 89, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
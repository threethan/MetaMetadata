71-25/491830822_2309444476542327_5727035702448157203_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-XIjKuMTYoQ7kNvwG8JCLf&_nc_oc=AdpsnzXW5o0oGM99dy3_TUK_Iae16TxM5HjP93mS1uk6bmSC_ck5TqYy7nVDjy7Tr5s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYgk3MYvwkl9pOkQe-kQJcffol5qgiHs09uFgF1YcXKQ&oe=6AE88E62"}, {"file_name": "Imagen 1.png", "id": "1396432511959143", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595129854_1396432515292476_8858652479021212391_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB8tK7ghePIQ7kNvwFgiv3h&_nc_oc=AdrVtWPo_mube25-NsTuRJYCVZ3WYWhNq8huFBaX0jMI_M7IgtVB0uqumqS0-09sbNU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvHQAdsVF32C7fjEvTKXOoQWtpmrRLihnWJawouRIJCw&oe=6AE8BF76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "28224509947159808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831569_28224509963826473_9002340485282904486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMECHH5fF34Q7kNvwGzj_oq&_nc_oc=AdqdYqTlTQRaGcjNOu2CK-CX7JVHwks-TsYHbf9jP-IMpB8wvg_8QIWqeao1a1wTFBg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeiiwlXDWzr0MLu1rxwW1kGqAqn89cjNW5P36reRQ_jQ&oe=6AE8BD08"}, "display_name": "HexaTrainer", "keywords": ["hexapod", "orthopedics", "external", "fixation", "bone"], "long_description": "Hexatrainer is an educational and trainer platform for limb deformity correction procedures using external circular fixation systems. It provides virtual and mixed reality workshops and a special workshop where you can visualize anatomy and practice pinning through safe corridors. \n\nFeatures:\n- Complete hexapod system (Full and rings, foot plates, bolts, blocks, posts, etc...). \n- Lots of example cases. \n- Free assembly sequence (allows premounting). \n- Free positioning of components, osteotomy level and orientation. \n- Frame preassembly. \n- Live strut length information. \n- Deformity manager; Accurately make your corrections. \n- Basic osteosynthesis with plate and screws. \n- DLC system; Downloadable content (new cases, new hardware...). \n- Mixed reality mode, which adds comfort to the experience.\n\nThe app is intended for use by trained surgeons with prior knowledge on specific topics and surgical procedures.", "short_description": "Simulator and trainer for limb deformity correction surgery using hexapod systems. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orthopediapps.com/en/privacy-policy-hexatrainer", "developer_terms_of_service_url": null, "publisher_name": "F. Javier Narbona C\u00e1rceles", "support_website_url": null, "website_url": "https://www.orthopediapps.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38347403978238866"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595129854_4368011706743907_7190017516168895851_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIm1UiwzYtsQ7kNvwELvY6y&_nc_oc=AdrkB7R6BBCt9E3r6qy7Xy4RIDUqwN50GyQPPmSRcRm3u7F3Da9TkAIddxekNaeBDGk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLsmjgjuw5e2VWW60G8hErVS_XkNHmCrxkW5QyCuSYsw&oe=6AE89E8E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_nam
content-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4j-rBO1Gc-sCatyFyixDCLCJ7cZ_kUfrsdnc8jPjZaw&oe=69AC0F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada hor.png", "id": "891653362634256", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210400_891653365967589_3792996722193671593_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShCvHUVHzSQQ7kNvwH9rvw_&_nc_oc=AdnEKG5U78jaB-9QB0G4T7U7YKZ5dx8buthjuETP1cte-IsKqfAernqyl7oG7HtAn8I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzM0kyu6yl9ufGHmQDSm46Roo2URxRR7VzZRZs8nRQ0PA&oe=69AC0746"}, "display_name": "HexaTrainer", "keywords": ["hexapod", "orthopedics", "external", "fixation", "bone"], "long_description": "Hexatrainer is an educational and trainer platform for limb deformity correction procedures using external circular fixation systems. It provides virtual and mixed reality workshops and a special workshop where you can visualize anatomy and practice pinning through safe corridors. \n\nFeatures:\n- Complete hexapod system (Full and rings, foot plates, bolts, blocks, posts, etc...). \n- Lots of example cases. \n- Free assembly sequence (allows premounting). \n- Free positioning of components, osteotomy level and orientation. \n- Frame preassembly. \n- Live strut length information. \n- Deformity manager; Accurately make your corrections. \n- Basic osteosynthesis with plate and screws. \n- DLC system; Downloadable content (new cases, new hardware...). \n- Mixed reality mode, which adds comfort to the experience.\n\nThe app is intended for use by trained surgeons with prior knowledge on specific topics and surgical procedures.", "short_description": "Simulator and trainer for limb deformity correction surgery using hexapod systems. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orthopediapps.com/en/privacy-policy-hexatrainer", "developer_terms_of_service_url": null, "publisher_name": "F. Javier Narbona C\u00e1rceles", "support_website_url": null, "website_url": "https://www.orthopediapps.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1213752112642105"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1442259120970583"}]}, "baseline_offer": {"id": "1442259120970583"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763147040, "status": "PUBLISHED", "id": "1442259120970583"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33999713723007935", "version": "7"}, "id": "183605694593935", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33999713723007935"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183605694593935"}]}, "change_log": "Improved handling of several rings in scene causing glitches. \nCorrection of some hole mismatching in foot rings\nIntroduced strut model selector, strut length calculator (convert total length to gradual and acute values)\nSaving some player preferences on app exit (quickload and fastlock preferences). ", "created_date": 1772329092, "id": "33999713723007935", "version": "7", "version_code": 88, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33999713723007935"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183605694593935"}]}, "change_log": "App now retains user selection for QuickLoad and FastLock options (independent for workshop and corridors. Always active on MR workshop).\nSeveral minor QOL bug fixes (instructions on tools and UI unresponsive buttons fix)\nImproved strut versions (now can show/hide color and numbered labels,and added the possibility to introduce new strut models showing accurate length and size readings depending on model.", "created_date": 1771127258, "id": "33760272046952105", "version": "7", "version_code": 87, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9083596471713005", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33999713723007935"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183605694593935"}]}, "change_log": null, "created_date": 1763096406, "id": "32298469876465670", "version": "7", "version_code": 86, "release_status": "RELEASED", "status": "APPROVE
video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada hor.png", "id": "891653362634256", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75210400_891653365967589_3792996722193671593_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFvOcWu4Q9AQ7kNvwHcdTWs&_nc_oc=AdnrPpkMNEdJdX2hJC1ow-yZJ82lhZglUawUnqQ69Je7fqt7diprGlcgEESkMWtYGjk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvjFc2LWrhkb91jsz3w6Mf4lCMFSvkX7jx8Z3vGcbsHvg&oe=69A17B46"}, "display_name": "HexaTrainer", "keywords": ["hexapod", "orthopedics", "external", "fixation", "bone"], "long_description": "Hexatrainer is an educational and trainer platform for limb deformity correction procedures using external circular fixation systems. It provides virtual and mixed reality workshops and a special workshop where you can visualize anatomy and practice pinning through safe corridors. \n\nFeatures:\n- Complete hexapod system (Full and rings, foot plates, bolts, blocks, posts, etc...). \n- Lots of example cases. \n- Free assembly sequence (allows premounting). \n- Free positioning of components, osteotomy level and orientation. \n- Frame preassembly. \n- Live strut length information. \n- Deformity manager; Accurately make your corrections. \n- Basic osteosynthesis with plate and screws. \n- DLC system; Downloadable content (new cases, new hardware...). \n- Mixed reality mode, which adds comfort to the experience.\n\nThe app is intended for use by trained surgeons with prior knowledge on specific topics and surgical procedures.", "short_description": "Simulator and trainer for limb deformity correction surgery using hexapod systems. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orthopediapps.com/en/privacy-policy-hexatrainer", "developer_terms_of_service_url": null, "publisher_name": "F. Javier Narbona C\u00e1rceles", "support_website_url": null, "website_url": "https://www.orthopediapps.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "c
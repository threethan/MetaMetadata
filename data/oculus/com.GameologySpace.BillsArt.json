2980587_76498131329635469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AereCh5E1AMQ7kNvwF09CGH&_nc_oc=AdqYjRqL4SisLbVwt519gzDuXg88NtHIjFLTKhSqU6kCdFbtnwaJfLS82iqGSxULbgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb4wlWWFq8dSyGkwSqlE5ONlAtzCbgJSt_ry42eSm7pA&oe=6A748462"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560.png", "id": "385906257509004", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974873_385906260842337_661889666472840044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajke6Gn98vAQ7kNvwHM5hfN&_nc_oc=AdrhQ_Kuu23yMgCSz0sm-O74w0soeDeqsuGW39jFDWHrHxywj_4MjENAh54wNNM3JAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5YSnR1wERzfgO2DJhBkhpXn9BxIkTZAnjokB1xYEGzQ&oe=6A747EFA"}, "display_name": "Zero Art Garden VR", "keywords": [], "long_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing.", "short_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gameology.space/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gameology Space LLC", "support_website_url": null, "website_url": "https://gameology.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags"
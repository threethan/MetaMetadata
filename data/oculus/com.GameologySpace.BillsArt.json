2980587_76498131329635469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZdshDllCKUQ7kNvwEiyLp0&_nc_oc=Adq-eaZ3k9tsGXPt-VbZrQoCFfnxwM8JDIrmbYCsU1w3ty6MoGJfLRyySREAqDCy8qY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2MMulOkySrybb5l2vTKBF_UiSbGJlx0ruuTKg5ocdLA&oe=6A37DF62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560.png", "id": "385906257509004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_385906260842337_661889666472840044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tqD9oSxg_UQ7kNvwFPLbej&_nc_oc=AdoZOgWBW4W_1e0dyH6R1yHLdhcVUQONLQoIPbSdMn12xkPH3xLLH_OuCpT29pvcjwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7KXlXNglXz1RLQkif7Qv1h_QMPI2Ip13bvvmYn0JgEA&oe=6A38123A"}, "display_name": "Zero Art Garden VR", "keywords": [], "long_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing.", "short_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gameology.space/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gameology Space LLC", "support_website_url": null, "website_url": "https://gameology.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags"
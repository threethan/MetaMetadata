2980587_76498131329635469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9pkjKF4sDoQ7kNvwGAx2nq&_nc_oc=Adqp_UlAfAEjhswLa-Gf34TPCSvItwUHIpLHwk4nYAlFFQ2LzrXp4uuCsxRlsWPpSMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7UJbnOcOxom1WiWZ-4lkYpERHXKvuR4frPJdGvN7AUQ&oe=69CD15E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560.png", "id": "385906257509004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_385906260842337_661889666472840044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt2nvjzbmu0Q7kNvwEoqaUT&_nc_oc=AdqWm7OIr63-y7Bdlp5aa2ZghqoOpT6DddN9Hm1Zg6Jb9hMy2WVHdpqQ8tn1LSvBktc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyySFqslkLdAnz7XqhF7gzDqPs5t8N8BUorjcEQRc2HAg&oe=69CD107A"}, "display_name": "Zero Art Garden VR", "keywords": [], "long_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing.", "short_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gameology.space/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gameology Space LLC", "support_website_url": null, "website_url": "https://gameology.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags"
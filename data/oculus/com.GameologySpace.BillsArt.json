n VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gameology.space/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gameology Space LLC", "support_website_url": null, "website_url": "https://gameology.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6412547528847652"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1340312463353936"}]}, "baseline_offer": {"id": "1340312463353936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710399600, "status": "PUBLISHED", "id": "1340312463353936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6418689764900095", "version": "0.5"}, "id": "936355741290748", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "A
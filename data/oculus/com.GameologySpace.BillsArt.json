2980587_76498131329635469_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMUVYtVRqkkQ7kNvwEOwGQk&_nc_oc=Adq1TPGD0slmtRt7NDxCj1LD4nHp2O9whUno5IFCqaFLt82UNWcER1qMJcAdKqNpFdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WrTHKtynykCvsiiSsmWL-UXnt-ZYiANdhWQQTNGghow&oe=6A1D8162"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560.png", "id": "385906257509004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_385906260842337_661889666472840044_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsT9NWOByvoQ7kNvwHzJZkL&_nc_oc=AdpW7CM1zxaqfBoXuKSZc-R6_jsWt0-XIBAN8xOJwS2zDsn-gcMudqflgc60gqiL9b4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KZirR-bVZ9yIRrRA8ubeoHtmNpGU6-qHFHoipj-iaeg&oe=6A1D7BFA"}, "display_name": "Zero Art Garden VR", "keywords": [], "long_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing.", "short_description": "Zero Art Garden VR enables users to create kinetic sculptures through intuitive hand gestures in a relaxing environment. It offers a seamless blend of technology and creativity.\n\nUser place various blocks into the build area, then those blocks are repeated in a circular pattern that rotates around a larger ring. This app also allows you to export creations into STL files for 3D printing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gameology.space/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gameology Space LLC", "support_website_url": null, "website_url": "https://gameology.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags"
n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WbHHH-bL9IQ7kNvwFZ-Irv&_nc_oc=AdpIN5D5yFZ7KQ9aBZrIa2Yp_V6dLSfIoLqFJAcHc5n0vvYe1ewK2s_UrlvaR6NPJ_U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQjxMhdayn-ZjbaqBpBWFSfXvjcDCRyt2v2aVRzLm1iA&oe=6AFC7A8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SaneSpace: File Manager & Cleaner", "keywords": ["files", "zip", "storage", "cleaner", "explorer"], "long_description": "Your Quest is full again, and you don't know why. SaneSpace shows you in one glance.\n\nKNOW YOUR STORAGE\n\u2022 A live storage map shows where every gigabyte went\n\u2022 Largest files, file types and file age, sorted for you\n\u2022 Browse images, videos, audio, documents, APKs and archives by type\n\nCLEAN UP WITHOUT THE FEAR\n\u2022 One-tap clean for things that are always safe: thumbnail caches, empty folders\n\u2022 Big files you haven't opened in months, flagged for review, never deleted behind your back\n\u2022 Everything you delete goes to a recycle bin first, so mistakes are undone in a click\n\nA REAL FILE MANAGER\n\u2022 Copy, move, rename, share, search and unzip anything\n\u2022 Previews for photos, videos, audio and documents\n\u2022 Built for controllers and hands, with either hand\n\nSANESPACE PRO: ONE PURCHASE, YOURS FOR GOOD\n\u2022 Copy between folders: two folders side by side, tick files and send them across in one press\n\u2022 AI assistant: ask \"why is my headset full?\" in plain words, answered from your real files\n\u2022 Duplicate finder: removes identical copies and keeps the one you choose\n\u2022 Create ZIP archives to share or back up\n\nNo ads. No subscription. No account. Your files never leave your headset unless you share them.", "short_description": "The file manager your Quest has been missing. See exactly what fills your headset, find every video, screenshot, download and APK in seconds, and free up space safely with one tap. Calm, fast, private, and free, with an optional one-time Pro upgrade for copying between two folders side by side, an AI storage assistant, a duplicate finder and ZIP creation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sanebits.com/products/sanespace/privacy", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1418091087166593"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1463645128968079"}]}, "baseline_offer": {"id": "1463645128968079"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793129400, "status": "PUBLISHED", "id": "1463645128968079"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1421958023446566", "version": "1.0.1"}, "id": "1426906062313296", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1418091080499927", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1421958023446566"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "14269060
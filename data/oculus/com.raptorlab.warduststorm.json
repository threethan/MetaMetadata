sid=6e7a0a&_nc_ohc=wac58P4ryscQ7kNvwH2kCOj&_nc_oc=Ado5e4fPXdc_TlrNgqgm4zCKXjEUeH5ruaerI2H-maHlGs5CKfjZDRJxguHUP_i6RsM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlz_T8PqkW1pMu_0gQTIMHtuDxLNH5NnoJ7c9wtuNXTw&oe=6B031592"}, {"file_name": "screenshot4.png", "id": "1616412755945517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001662_1616412759278850_1914247416999098155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEV4YtGw0DAQ7kNvwH4spgQ&_nc_oc=Adr09nC6pWY6Oghnb6r1pmqTSpgS1q9KB1ixQrXLgN4YvmdHIlLzWYldPEepjjngytU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXv-nzT5MV-caRpu_p-zqQFqlOSyrQMqj_AgdG17qRQw&oe=6B03119A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4ea8Pnafu0Q7kNvwETJBM1&_nc_oc=AdrqmsU0RSM58N5jtwu_37YY8Azs9lZI7mlPIWlakMk6fbZAyKotJ0heW5XWqzjazKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuicN_658LoR5TmJPmifQ9ALa-ECcfENNhkxVsWESPHw&oe=6B0327AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCoZ9ExiXzAQ7kNvwH7xQ7C&_nc_oc=Adoyf28HyNFX2Yz8_au0thkXchzELpa_-lImsE58aCxYhYP_-UkVanEuO1BS6wJiyX8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShyirrxorc0MvIQcqMI2XfWJvjKExcsDa8hOJFQc0VGQ&oe=6B031124"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
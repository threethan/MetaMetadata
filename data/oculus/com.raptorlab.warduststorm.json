uD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOjq1RBVwkslQj41rtAyRejJ7NJSJHCMFOq5FTysFEXg&oe=69999E5A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yac2qrBLMP4Q7kNvwFcexkm&_nc_oc=AdmsSlRsAOrS_WwulrhTwqerT7Oj5gWHbRCKPsUOxT5DMPdonuu-bM1JMBmnv9NLcVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWC1_554hpRgFaKWQt-yxTA8sV4mqeMaIHGe8PC99enw&oe=6999B46D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xi71vJ4unkkQ7kNvwFDjQ4b&_nc_oc=AdkhNMvc8sPyKMq30VQ-acSsDiDqeJB2V50_LR7Ebx6QoZc826OlZRjJSiRRzGchJXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5ndxmn9iH6txkkx7qaFI60tupQyNn95RMFZ5gLw8SIA&oe=69999DE4"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8789932111072828"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "24039646809027941"}, {"status": "PUBLISHED", "id": "496187423498359"}, {"status": "PUBLISHED", "id": "2416787055324932"}, {"status": "PUBLISHED", "id": "604730048882147"}]}, "baseline_offer": {"id": "604730048
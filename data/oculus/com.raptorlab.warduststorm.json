616412755945517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001662_1616412759278850_1914247416999098155_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh60DsjxuFQQ7kNvwElx0ea&_nc_oc=AdokVLezUzgGNMKEp2YyFecSyBwSZoOEyo3CVFu3qYPyBqIhTZzAOV8EZ_Fc4Tejzxs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpE5kudat8u5T4JywSUoF5hpI09agaRMZHxGfNYkzocw&oe=6AE8B39A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUN7uMgIyNQQ7kNvwHYcIXw&_nc_oc=AdoSbals0WsgbAh6T7Ax0XzvLK3deEGeVks-TKHmcu35yodGO1rsyEgux8Nzc4652XU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQseMk6j8tCvLeSOQ_tUwwHvBLh3vtWO93YxbPKyWvzfQ&oe=6AE8916D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbe5cl_pkOMQ7kNvwFEgfID&_nc_oc=AdrTtowU2YSnAP2NBooyVqN7feV1cApCZkTkfVAs_stATR0v0C-cbZ5b7Q9ITVmSRxc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQutXDarrdtU1J067uZajd6cH36yXmpk7hyrrNDU1-Lsg&oe=6AE8B324"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": 
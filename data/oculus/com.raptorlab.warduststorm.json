sid=6e7a0a&_nc_ohc=etmAlBTfcBsQ7kNvwE-m1HB&_nc_oc=Adpo_lWogkymw7GQGYRZpya7SzNjSVeWKujflUsIYtvn3TZVy_zcvf0u6USbc6CdrGM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA8JmAB6f0E5g586anLP9QQBYQ5UNRcl4mKVphinaqmQ&oe=6B09AD12"}, {"file_name": "screenshot4.png", "id": "1616412755945517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001662_1616412759278850_1914247416999098155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55hi4qJ-S5kQ7kNvwEfmONV&_nc_oc=AdpuvGGFHX1uzQyVFF-lUDWvLzoWdhyY8-CAXj3cVun8Ups10CAmCSQqo9_7fb1bEEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRUTuMKWgZS_EdqvlBfOVZeoj2iN5gdyFIWaNiwtC9iQ&oe=6B09A91A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghrSREafn6QQ7kNvwHs1EPD&_nc_oc=AdrE9e1XyvfUmtmLlpQeW9ziD3nwrSAHNdpuQAWUMLKo6lRqIDE24daKsy67xI6aBOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKKFNSGlsgLPs5CxlBkD1PJWoN2NR54vzpFoe0454wrg&oe=6B09BF2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFarhsiPKV4Q7kNvwE8U_SI&_nc_oc=AdqoNjowE3sPwnhXKdApzxZXcDV6kiUnY9VpJwRQXvF44klbRAPxCiTT8xnqdB_Cbr8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROC9jMS2OafJjv4sJ4lrWjpqV1pP02DzqaphN82JwS8A&oe=6B09A8A4"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
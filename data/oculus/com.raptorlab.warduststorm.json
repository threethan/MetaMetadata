sid=6e7a0a&_nc_ohc=yvT70lDKxQwQ7kNvwHg_MpI&_nc_oc=Adq8kR1GYEeF-TRETaLDv4FgmPtv6NrxlhKRssdW2_fHnj10m4-tek1tP5590bnWka0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLgS-h5MHedxs3aiDhtJdlFmDzqF4qFjfb_EkoPIN_0g&oe=6B0DA192"}, {"file_name": "screenshot4.png", "id": "1616412755945517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_1616412759278850_1914247416999098155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G9ticTnp1oQ7kNvwF8rcKI&_nc_oc=Adq03HEALKp1g3TB45XwOFt68N82S4B9klGr6qMr4g9OLLyiWt-URQs_uAdAkvAh9nM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQl_aar6s59G5Ub5g3qB6h1adhg2oIhc9eTGuYBBNa66g&oe=6B0D9D9A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKazB8ykfXwQ7kNvwHU4Nh8&_nc_oc=Adrbb-ZrOsw3ps7lLNfLbZSMWxpKPEtlPdNoNVK7yDysgoOueBzbIho1DP3B4gBbT6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWlTlBSejfYMHIxmSj6rUPzlDRNE3-wd7SnnhGW4vVTQ&oe=6B0DB3AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeUSDy6FJvwQ7kNvwHbxHRG&_nc_oc=AdoFYxGoT20PrasT6ymHsR50GL6c2ugeMPpzjXhkx0cuMr2G8GwLM9gmMzeFGa-SBP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXsmJmwExVUT5UMhFPyoCzetBGYZ9tI1pTxu5ei4eu3Q&oe=6B0D9D24"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
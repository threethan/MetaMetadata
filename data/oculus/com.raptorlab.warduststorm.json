sid=6e7a0a&_nc_ohc=etmAlBTfcBsQ7kNvwFaDTK8&_nc_oc=AdqLkd0mNgT4c26yI2XrLHneMUw27UFCQg7ELm1r7-D1fdPuUQtQGAi7gvP7bWUIVng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo6sgm93D4DdxJEemc4txUCPya15tkwf32hMOvpQ5GOw&oe=6B070A12"}, {"file_name": "screenshot4.png", "id": "1616412755945517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001662_1616412759278850_1914247416999098155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_HD4W5-Kr0Q7kNvwG-ogXZ&_nc_oc=Adrk0QJf0kCsBXS694hBiRGGhJ6UGLl8PsCk89uAxV5OMCfpBwFwI5nIv61I-LxkYPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwW58c0WbLrEVjPdulKbmdFCNNHB5zDL8gtV3sndUWIQ&oe=6B07061A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnhZnsLtV0YQ7kNvwH9wHC8&_nc_oc=AdriEAyR6ZTANzzJC6I-Qe9KqZsqkPEGUjRjM42TqXp6PWm6K0Co6F65ICW4Ugy1vtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-QNqhch4UcnT__gqeIYvYzjk1tUz1NqY8i_JuirpSyg&oe=6B071C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFarhsiPKV4Q7kNvwFUh-X5&_nc_oc=Adq81YVBGS_WyUeE1H6h2gnl6Ofaw8Bz8dx1pJdOBL8g-LHJ-iFA4vdOeZdUcPIWgnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRv0rI7aueaF1N-jw2BosXqkAa64BXHoaBv3hKw-jyFw&oe=6B0705A4"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
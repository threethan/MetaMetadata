sid=6e7a0a&_nc_ohc=DCe8qayb6w4Q7kNvwEWT102&_nc_oc=AdoIkFZJi1lLGnZiWEmDvKQIkmxTVRd644c8pY2MFefnQyBEuHn3t6tNRhscmchiEJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxOJ-d5OKk03qLR7JsFyt1Mqw4CQT6c7gDYiYfzNvJOA&oe=6B01C412"}, {"file_name": "screenshot4.png", "id": "1616412755945517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001662_1616412759278850_1914247416999098155_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEV4YtGw0DAQ7kNvwEG9mt6&_nc_oc=Ado1XYIYtn-laikYvlG_S-2gzAbMfwHAV5xw-e7FMklu7bDP1yKTggxW1c23fSwlvy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZl-Ht2jMyKF7wYB12m_BmEHU1Ja0Nfmd3crJQFe5N6Q&oe=6B01C01A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4ea8Pnafu0Q7kNvwEEvd6t&_nc_oc=AdrRYYYmDxom-wv2ssssQQS-ubfV3HxgUJVJHxhPclRGa-RJYEI8sOYyPYqdPBBe0ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT3y5jhshv_QMaCsQaxBNpIHqxRmN6wCks1u7L0oJYxw&oe=6B01D62D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmwiULNhPDsQ7kNvwG96brD&_nc_oc=AdqRkJiS4UkY6PQg_Nc42GujciGrvay3LpC5e_-OKqNstJnsW9GeERsc4NJcIPhTT_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTleofV3sDBq4y669n64C7JUTlHFrZl4EQG_ek3z-AE9w&oe=6B01BFA4"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fFGzvkwz3YQ7kNvwE8-7Fq&_nc_oc=AdpoQHmhdTulfurzmMA8zo7oFKw9FFFc7HEXXBSJoyXKFSaSIuSMzXlS3_oi-5thpbY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X7NvIhBv2hyYJhRltLMPCJfUGQ0M_H5eB7XiD8R04kw&oe=69E8B85A"}, {"file_name": "screenshot5.png", "id": "1207135570357747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974683_1207135577024413_4012824244041521314_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tptgHP-BXeYQ7kNvwFua1Na&_nc_oc=Adp78nbMJ8MZqMEV77dU1o9UGQATu8ERslML-wwSJVSui5dpXyeQu4wI81VJD7T5s0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1980r3qEPfpxsVSBpe8y4MKCIQ1KtWxWfrALjCEgbSsw&oe=69E8CE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerlogo.png", "id": "1114847033541324", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974751_1114847043541323_1171908996478707924_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9VcarOy84cQ7kNvwFyT_AP&_nc_oc=Adr2D4IaiXLezL3Et-EVAIUY_Xv7zZaXzcvnwwIbf-OwugHpoXAwOit8Osv1f2SSDl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iyk8ywC6zmbfeFWICrCA6h-Y9dxzS-hmAQldhHu5BVA&oe=69E8B7E4"}, "display_name": "WarDust Storm", "keywords": [], "long_description": "Get ready to dive into the thrilling world of War Dust VR, a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields, prepare for non-stop excitement and adrenaline-pumping gameplay across expansive battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust VR delivers an immersive battlefield experience that will keep you coming back for more.\n\nJoin forces with players from around the world in massive 32v32 battles across many official maps, with more to come, and a host of player-created maps. Conquer diverse battlefields filled with vehicles and immerse yourself in the dynamic day and night environments. As a community-driven game, War Dust VR's active player base is continuously guiding its development and expansion.\n\nExperience conquest-style gameplay where capturing control points and defeating enemies is key. Progress through an XP system to unlock a vast arsenal of weapons, accessories, skins, and ammunition types. Choose from four distinct classes \u2013 Assault, Engineer, Support, and Scout \u2013 and strategize to dominate the battlefield. War Dust VR offers various vehicles, 15 types of guns, 3 support spawnables, 2 types of grenades, and 80+ weapon skins, ensuring endless customization possibilities.", "short_description": "War Dust Storm is a 32v32 VR military online shooter where infantry and vehicles fight on huge battlefields. With its emphasis on fun, balanced mechanics, and fast-paced action, War Dust Storm delivers an immersive battlefield experience that will keep you coming back for more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raptor-lab.com/elements/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "https://discord.gg/hS4xtjVcwM", "support_website_url": null, "website_url": "https://raptor-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8789932111072828"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "24039646809027941"}, {"stat
hc=SVhjuRltNK4Q7kNvwHYrB4i&_nc_oc=AdqJ58iUHgDf8oypLZP4Ub51hZYyK6L-WjOIHats0ktPYAC5qYd7ddqdb3Xd-pQCo6A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHmclTagT37NGr0DzmpEPIbCy_WgvOTiwlPaOoR9J49w&oe=6A8EC2ED"}, {"file_name": "5.png", "id": "2603779376744141", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499313074_2603779380077474_4666028558694902990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_ornOBU4_EQ7kNvwFFBFyu&_nc_oc=AdqWdlyA3pKtGx6eSmqHXwwLP2M5THPBJ2P1Xcyl0cI3GS4IMS4-BcPI0BbRiKfg94w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNsaSGXcGLzyvmNixYSp5M0t7GutlQYOJrsZtrrSXfBA&oe=6A8EDD83"}, {"file_name": "4.png", "id": "1978053772849249", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499311597_1978053776182582_2907804030611711830_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1awq5rKXYzEQ7kNvwHbulC2&_nc_oc=Adr8d10YB2khdxJHqERxN2EVj8K2Dz4Jm7Y2nP261C1sCX9VSTGEuXfkm97KoloAayA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFekow08Qqx5arr89RYM6iXq8QTLOzWDDNAnCD8hCoWjQ&oe=6A8EF253"}, {"file_name": "cap2.png", "id": "2479962425803629", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499312422_2479962429136962_4316597219347806467_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5LbbCouW58Q7kNvwFiA6C_&_nc_oc=Ado0c7v_7a5uBtSvUaU76MdsRqqyBhPcSAYNlGnEoQYLwMxb6PePVtugdlFkRaulF0w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzJrPZI0GVRYaq1q-UD667fAvDP0bG8HWr5WLUIVkp1w&oe=6A8ECEE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bodyPress", "keywords": [], "long_description": "Your body writes a journal every day \u2014 BodyPress reads it.\n\nBodyPress turns your health data into a daily first-person story. Instead of staring at numbers and charts, you read a warm, insightful narrative written as if your body is speaking to you \u2014 revealing patterns and correlations you'd otherwise miss.\n\n\u26a0\ufe0f HEALTH NOTICE\nBodyPress is a general wellness and self-reflection tool. It is NOT a medical device and does NOT provide medical advice, diagnosis, or treatment. Always consult a qualified healthcare professional for any questions about your health or a medical condition. Never disregard or delay professional medical advice because of anything you read in this app. In an emergency, contact your doctor or emergency services immediately.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\u2728 WHY BODYPRESS\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\nMost health apps show dashboards of disconnected metrics. BodyPress takes a storytelling approach: it gathers data from your sensors, wearables, and environment, then uses AI to weave it into one cohesive narrative. Poor sleep before an elevated resting heart rate? Cleaner-air days with fewer steps? Your body knows \u2014 and now it can tell you.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\ud83c\udfaf KEY FEATURES\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\ud83d\udcd6 AI DAILY JOURNAL\n\u2022 First-person narratives from real sensor data\n\u2022 Headline, mood, summary, and full story\n\n\ud83d\udcca DATA COLLECTION\n\u2022 Health: steps, distance, calories, heart rate, HRV, sleep, workouts\n\u2022 Environment: temperature, air quality (AQI), UV, humidity, weather\n\u2022 Locatio", "short_description": "BodyPress turns your health data into a daily first-person story. Instead of staring at numbers and charts, you read a warm, insightful narrative written as if your body is speaking to you \u2014 revealing patterns and correlations you'd otherwise miss."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.governor-hq.com/privacy/bodypress", "developer_terms_of_service_url": null, "publisher_name": "PiEEG", "support_website_url": "https://www.pieeg.com/contact", "website_url": "https://pieeg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1271355476056086"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2976010982757010"}]}, "baseline_offer": {"id": "2976010982757010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786467120, "status": "PUBLISHED", "id": "2976010982757010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1298294870028813", "version": "1.0.29"}, "id": "1329445532505639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1271355469389420", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1298294870028813"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1329445532505639"}]}, "change_log": "+Coach screen: Athlete mental training interface with real-time biofeedback from live BCI signals \u2014 auto charg
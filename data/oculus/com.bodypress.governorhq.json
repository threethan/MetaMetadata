5519092053102", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673751957_1725519095386435_1771899681139391580_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xfa7CmkXvTwQ7kNvwHQBXZu&_nc_oc=Adp0qgR76LWHex-zLLfI-naREUlJiF225hwkpejfKB-RLb9oIRIWgK20QAYhy9rFsP8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Ldep39IXtwk3hj8sn-axeEKPuA1Wwn14gu8XCF84hw&oe=6AFB162D"}, {"file_name": "5.png", "id": "2603779376744141", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499313074_2603779380077474_4666028558694902990_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwWefh2IL1wQ7kNvwGspezs&_nc_oc=AdrODmpy6KhmA_3-WjL7VPABwFwZ205N_tuzALo8z3AoZza1TCDNo84msjZCR_zcCz0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ob28OXJL5Dvk6ZG8oaDF-FiuZFdgkTfCtkD_Iym-gA&oe=6AFB30C3"}, {"file_name": "4.png", "id": "1978053772849249", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499311597_1978053776182582_2907804030611711830_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NX5osVqKlEQ7kNvwFz6v54&_nc_oc=AdqyRyNPCoe8x8IuUnuKnGyHxlj-ElohTmx7LEOPIcP5Gnc5-K5nTxuREOfR7WZH8tw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxMwdc_ywSpK-KEuc9m8at_KTd_34Z7x9h4qqhCwVsQQ&oe=6AFB4593"}, {"file_name": "cap2.png", "id": "2479962425803629", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312422_2479962429136962_4316597219347806467_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H4UUhuZzU4Q7kNvwECRHtf&_nc_oc=AdqYMDkmk-N0CLdqyQKR-Kc85HXlIB0SqVPv9qISwJsoAil2p7PlFZKJ46G6_zW66qI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAI8bdoVPw0R7-H0RJZtwP_uLRt_ulzgrAEw15qiTefw&oe=6AFB2226"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bodyPress", "keywords": [], "long_description": "Your body writes a journal every day \u2014 BodyPress reads it.\n\nBodyPress turns your health data into a daily first-person story. Instead of staring at numbers and charts, you read a warm, insightful narrative written as if your body is speaking to you \u2014 revealing patterns and correlations you'd otherwise miss.\n\n\u26a0\ufe0f HEALTH NOTICE\nBodyPress is a general wellness and self-reflection tool. It is NOT a medical device and does NOT provide medical advice, diagnosis, or treatment. Always consult a qualified healthcare professional for any questions about your health or a medical condition. Never disregard or delay professional medical advice because of anything you read in this app. In an emergency, contact your doctor or emergency services immediately.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\u2728 WHY BODYPRESS\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\nMost health apps show dashboards of disconnected metrics. BodyPress takes a storytelling approach: it gathers data from your sensors, wearables, and environment, then uses AI to weave it into one cohesive narrative. Poor sleep before an elevated resting heart rate? Cleaner-air days with fewer steps? Your body knows \u2014 and now it can tell you.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\ud83c\udfaf KEY FEATURES\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\ud83d\udcd6 AI DAILY JOURNAL\n\u2022 First-person narratives from real sensor data\n\u2022 Headline, mood, summary, and full story\n\n\ud83d\udcca DATA COLLECTION\n\u2022 Health: steps, distance, calories, heart rate, HRV, sleep, workouts\n\u2022 Environment: temperature, air quality (AQI), UV, humidity, weather\n\u2022 Locatio", "short_description": "BodyPress turns your health data into a daily first-person story. Instead of staring at numbers and charts, you read a warm, insightful narrative written as if your body is speaking to you \u2014 revealing patterns and correlations you'd otherwise miss."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.governor-hq.com/privacy/bodypress", "developer_terms_of_service_url": null, "publisher_name": "PiEEG", "support_website_url": "https://www.pieeg.com/contact", "website_url": "https://pieeg.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1271355476056086"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2976010982757010"}]}, "baseline_offer": {"id": "2976010982757010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786467120, "status": "PUBLISHED", "id": "2976010982757010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1298294870028813", "version": "1.0.29"}, "id": "1329445532505639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1271355469389420", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1
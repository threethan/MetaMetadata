0f&oh=00_AQTpe6f90ckcpojGeVR7Fu0HJJbFKe16yOQ11TJGIev80w&oe=6AF9DA6B"}, {"file_name": "7 (2).png", "id": "1923899465022860", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499292867_1923899468356193_3273462052504359364_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjSR5JKvG5wQ7kNvwGeCSk9&_nc_oc=AdpO8cBKGwxC27KgB5KnSuiSfqk3UCS0Y881ErmfJeg0Z6AyDrnllwFu-VrgKkumlCk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXl5nO97Ey4IbBU0GAZEx1AfgkMFF6VLz7ypsCM5WfhA&oe=6AF9CD61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pop Verse", "keywords": [], "long_description": "PopVerse is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, PopVerse is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Popverse is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/popverse/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nu
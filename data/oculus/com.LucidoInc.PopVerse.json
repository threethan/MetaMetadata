207454428_6265590888723215488_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OdcWACRo6cQ7kNvwExtyWM&_nc_oc=Adp6jTOI48mKqQtmUNvjKD5Mn6PUaOTR1RqKxsmzO1hKbQM_87mkiWdlakHWkmsqMVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZFMT91WRNw6WEuwUlUTXtcod-dyG5EaAr6SX-YDTJFQ&oe=6B04666B"}, {"file_name": "7 (2).png", "id": "1923899465022860", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292867_1923899468356193_3273462052504359364_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLWczk3zOEEQ7kNvwHqrfL5&_nc_oc=AdrV-5HiRIeUrYTEY0ya9EZwiU6b2k0XTjvbMzBVNAM6s8hU1yGx2FpWfpXmij_VSKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKIuJz2iNPVmmSv0GSysD8r7mNQdgTLIdaNR-0wOnj3Q&oe=6B045961"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pop Verse", "keywords": [], "long_description": "PopVerse is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, PopVerse is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Popverse is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/popverse/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
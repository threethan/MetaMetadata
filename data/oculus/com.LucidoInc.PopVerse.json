207454428_6265590888723215488_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OdcWACRo6cQ7kNvwFnxuFX&_nc_oc=AdoEMGtKmoy9lCC-Vy590dJDhp-X_ol_SIWzbC-raqgCEs26ciqvjNVBiWfkMx0No1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRl4HsqrK_9pqHOtWvw4et5jkegMK57hlgV7By7QCTaQ&oe=6B05B7EB"}, {"file_name": "7 (2).png", "id": "1923899465022860", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292867_1923899468356193_3273462052504359364_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLWczk3zOEEQ7kNvwFadYTq&_nc_oc=AdppdZdk96tmsWRVu9dIZyJfbSAy1fv4AiVKdki9p1r47geQedxckNs5DXBF1cJ3ISQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3qYqytooNw5Uo2SFg_n7oKJyxD4FFiNFEhRnv51uqmQ&oe=6B05AAE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pop Verse", "keywords": [], "long_description": "PopVerse is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, PopVerse is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Popverse is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/popverse/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
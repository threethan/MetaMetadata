207454428_6265590888723215488_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkxsoUV6HcMQ7kNvwFxk1qc&_nc_oc=Adrz6PXwGxinXqcBJxHyWKh_rVtSryrBi367ZujVoD4-DNOgI8j0gwPSFghdSJP8Epg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfjNp3mwy9LnL7gc-UavA3EOGnWUttMmUD1GCF3q6kNA&oe=6AFDCEEB"}, {"file_name": "7 (2).png", "id": "1923899465022860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292867_1923899468356193_3273462052504359364_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1lZMDw-p84Q7kNvwE3lBmc&_nc_oc=Adqs4-G9N-1ktHL62XRMEX_4uNmeN4Hm8BzOuCcn3XwbckOv6foEUMush-N_aP5aGZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAOPAatMqnh2upt-Hj_7GrqOz9Auw89OsBoaqzeAka-g&oe=6AFDC1E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pop Verse", "keywords": [], "long_description": "PopVerse is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, PopVerse is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Popverse is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/popverse/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
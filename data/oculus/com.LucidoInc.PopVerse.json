207454428_6265590888723215488_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuKpdx0g6roQ7kNvwE3ZaVW&_nc_oc=Adqc6qsPDwViSoYiWxn6GGIOFgM1uFDEfpj7nUoSw89Btqs-Sbnsvtc9Pc2ACNooBbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVbJ_ZuIFJ_209qSzQCg8HwXVZl_WLDzauWVC9xwAr1g&oe=6B0EF26B"}, {"file_name": "7 (2).png", "id": "1923899465022860", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292867_1923899468356193_3273462052504359364_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNEgfaH7lOsQ7kNvwGIkxG5&_nc_oc=Ado6E_QX5G1A0DqG-peE0QJoqv8D66sX6Kipn4QcpwW3Jc6sV4nRoIOqwHj0ZV15_3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgefYgQfz7Mt6dZnqe__B_Q7F0UQ_sOUG4I5I6029Ghg&oe=6B0F1DA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pop Verse", "keywords": [], "long_description": "PopVerse is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, PopVerse is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Popverse is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/popverse/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
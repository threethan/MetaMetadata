441_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hx_hgdbkwsAQ7kNvwFWQOU3&_nc_oc=AdpH5Db4BDXyNG7nq6bM4_4ggiLPc_LNNs2uNZ63ur9j5063-ppDMB7Je7KtlgLm9_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJNYpqgKycVhXxACFgDlojiqEq5o5eenj6paoLRrNb2A&oe=6B0C75BD"}, {"file_name": "SS-5.png", "id": "1115277467585589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1115277474252255_1365061128541956734_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdckDXRpstIQ7kNvwEiTLZ5&_nc_oc=AdqXE9i4hZ6KgIJl7d4_RfkLR3MH91aDvx20iXoJtmBVHT1AOWDsxh_WdLXhb6PX2DA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyfk__plky263Sd-7vj8xhy0QeIGBuK-alvkZ06TDvqw&oe=6B0C67D0"}, {"file_name": "SS-2.png", "id": "1090720687264895", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1090720690598228_7087408862268619681_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjEapIApH1IQ7kNvwGTQExk&_nc_oc=Ado6l7liRGsrKEophdyQ08N-onGeXIVWjVV-RSaL2FVeOc3KTUUfq0XZ9bPVshwT2Aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2jR6qCIFViDRA05xoJXJx7GLr21L7m9hKutd_Fh_JkA&oe=6B0C696C"}, {"file_name": "SS-4.png", "id": "1787699388972107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831393_1787699392305440_5554880565989659694_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID2NnbZ1Z64Q7kNvwFSssEq&_nc_oc=AdqM3_AGJtkajv44EOqOeTTvsAhZlPVqnB-XKEFRwvSY1Nts7fbha4994G-u6BzZm9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvdCeEzq-TzKlv3pEUk95GfPazPcqhNGuPP02AcEzmUA&oe=6B0C7065"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bike Smash: VR Multiplayer", "keywords": ["multiplayer", "crash", "smash", "destruction", "racing"], "long_description": "# Bike Smash is a VR bike crash game where your goal is simple: ride fast, hit hard and smash everything you can.\n\nHit the throttle, fly off ramps and launch your bike into the air. Ride straight into traffic cars, send wooden boxes flying, knock over cubes and blast through barrels. Every hit counts!\n\n**GAME MODES**\n- **Single Player:** Clear levels and sharpen your skills at your own pace.\n- **Multiplayer:** Jump in with other players and ride and smash together.\n\n**LEVEL TYPES**\n\nFour kinds of targets to take down:\n- Wooden Boxes\n- Cubes\n- Barrels\n- Traffic Cars\n\n**Play levels two ways:**\n- Timed: Smash your targets before the clock runs out.\n- No Timer: No pressure. Just ride and smash.\n\n**RAGDOLL CRASHES**\n\nHit something hard and your rider goes flying with ragdoll physics. Press one button to reset and get back on your bike in seconds.\n\n**TUTORIAL**\n\nNew to the game? The built-in tutorial teaches you the controls and gets you riding in minutes.\n\n**CONTROLS**\n\n- Right Trigger: Accelerate\n- Left Trigger: Brake\n- X Button (Left Controller): Pause\n- B Button (Right Controller): Reset rider after a crash\n- Hold Meta Button (Right Controller): Recenter view\n\nOne bike is available now, with more bikes planned for future updates.\n\nRide. Jump. Crash. Smash. Get on your bike and start smashing!", "short_description": "Hop on your bike and smash everything in your path! Ride into traffic, launch off ramps and crash through wooden boxes, cubes, barrels and cars in this physics-based VR bike game. Play solo or jump into multiplayer, race the clock in timed levels or smash freely with no time limit. Easy to learn with a built-in tutorial, Bike Smash is pure crash-and-smash fun in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metasparkstudio.github.io/company-profile/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "MetaSpark Studio", "support_website_url": null, "website_url": "https://metasparkstudio.github.io/company-profile/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfo
=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXo-TgugXV4Q7kNvwF_eqkH&_nc_oc=Adq1iCcS7U_xKy3V9aDtPvtncpMcepkwt6-_M4D-ZCE6VP0IeVY414NNBmcxeTBquhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqPftEjQPjiE1k3hAwJGJrF-xZyNL0uS9x7--gGrR9mA&oe=6B103710"}, {"file_name": "SS4.png", "id": "773971148690204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830146_773971152023537_4952595974079812572_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKojMTYwuiIQ7kNvwHh7HK2&_nc_oc=AdoJeiabhuxhRMskg3YED1ZMtXZaX9KtHFpsIL88B73id4L7ralmU3qou7yD7dnLDIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXk4P1oToNns2h3LToIcDmz4YX5Axsx9A595Ygvx-YT4w&oe=6B1061FD"}, {"file_name": "SS5.png", "id": "795610070070778", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618884_795610073404111_1590182504707932060_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VVUP7PAey8Q7kNvwEr6YOo&_nc_oc=AdpcFcPQYHWUMo_TAP1h2r91vhe10VhL00MjJN9K34taxXGYDh4rj6qgqBK2G-nmwog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2IeeSgqUHLzYJplEIBQ-TVOcyhKpeuCCqJbGxlOBNrA&oe=6B106B0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StarboundQuest", "keywords": ["Parkour", "Adventure", "Colorful", "Exploration"], "long_description": "Starbound Quest is a vibrant VR platformer that invites players to embark on an exhilarating journey through enchanting, whimsical worlds. In this colorful universe, players will leap across floating islands, navigate through lush landscapes, and dodge imaginative obstacles that challenge their skills and reflexes.\n\nWith intuitive controls and engaging mechanics, Starbound Quest allows you to perform daring jumps, collect hidden treasures, and unlock exciting power-ups as you progress through each level. The beautifully crafted environments are filled with charming characters and delightful surprises, creating an immersive experience that keeps players coming back for more.\n\nWhether you're a seasoned gamer or new to VR, Starbound Quest offers an unforgettable adventure that combines fun, exploration, and creativity. Are you ready to jump into a world where your imagination can run wild?", "short_description": "Starbound Quest is a vibrant VR platformer that invites players to explore whimsical worlds filled with fun challenges. Get ready for an unforgettable adventure in a colorful universe!"}]}, "developer_name": "LuWiGames", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hKR3yMRs169NkKVdSWxBPM91gc5p_rjHxKRUz0lIdIE/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "LuWiGames", "support_website_url": null, "website_url": "https://luwigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28285637701031204"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28260677593527215", "version": "0.1.0"}, "id": "1753810518793328", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "
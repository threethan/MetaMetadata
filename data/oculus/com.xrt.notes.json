1440.png", "id": "4872724046279922", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_4872724049613255_550500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx8hPeXeJUoQ7kNvwEAPadQ&_nc_oc=AdocC9XO0d9lFmS_ei0A01Hsqv3cInH1G_gb1vXxiGX7CRX7EHH_oM3LwWDAdoe5ipQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzDc6KyFXrkWgqsGF08A9UU1U640vmNswRL1muUeecag&oe=6B0C7CB8"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZZzfCiEaDsQ7kNvwEBYQzC&_nc_oc=AdrS4KB_IQu15KZtgwEvDiSfa3FKkHTJn3yw0lay98rRu2oRPi1YEibMA1dnSOOqlcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXMyYPVDWisM1SfTTL2E2LuXleDP-3rb598SRKwmvvVQ&oe=6B0C57BD"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orjqcBUFK_UQ7kNvwEfbKcP&_nc_oc=AdrBhb4VfkGcjzS_loq-DpTi847g9UuvVDReldBH_DA-ZpI-__JLGP718oFb42m1FiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvOOBpyeN4HHLDNEzwyhTRnKkiZsa2AGmLkjo4ufYBLQ&oe=6B0C7447"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Wor
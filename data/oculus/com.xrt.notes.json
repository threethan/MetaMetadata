1440.png", "id": "4872724046279922", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823790_4872724049613255_550500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx8hPeXeJUoQ7kNvwE7xttP&_nc_oc=Adrwl4j2PjHDrvBIlyMmSXj9ZaDFp5TRn9eph1GTF9eirI88i1YKkqfM71HnLLKWguM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfdH6JK9UTyyJ8rjIEooKun-wH4jBK12csswIcTl89qA&oe=6B09A178"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZZzfCiEaDsQ7kNvwH9EQCb&_nc_oc=Adrj7hHpZhgCplBsc87Pxyyt9mgN8jSt1IvfAE_svpdDQLzQR1v4Zg2fUIn6l6Vn-Nw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2uwOnLhJqPIhyrczOsV69PREjN8pg_m9yFCYwPalMXQ&oe=6B09B4BD"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orjqcBUFK_UQ7kNvwFDHXZg&_nc_oc=AdpOAziFOJHQ3toC0hif2HHQ9eQW82s82YcO5NvewCjU5zoJerZXuxUFcCDm0TfQZDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVH7roNXLS4XwK6xc2nsXhrwITX7Tu2ATf3o2un5v6-g&oe=6B09D147"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Wor
50500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmnWIF0vUSIQ7kNvwFOTPVy&_nc_oc=AdpGRCz0AJDBr3Id4MOD4HeceER9gaODfdDvEU5uX--ozuCEV3IpQ0bh-f5ZlIX3d-4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpODdCPcBhtZHxKKlHuev9Ei9wNvdxmbKBgMykK-HlTw&oe=6AFF1578"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJSzUBVcfjIQ7kNvwExVMKO&_nc_oc=AdrxFV7C9MvWcIXVg-EXoE7EYS-SeIcnDY_GHFDbzF9n9chvs7r3ydXwgm5Oiq1Iu_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_fj4PVRGld7nzcPDXpKmG2qPqmw_QT5P9SesCTJQQ6w&oe=6AFF28BD"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViVYhOTgc7QQ7kNvwE_ewWB&_nc_oc=AdoZqt_7-sR-FQ1lkVVHgqewFnKZUddPZsIIyAH-ya2i1k0Df2OkMUUktLCMQTMC-W0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS28rlKd_Dvl7gUw243N2QltgGIJZtyaFHbRQbaxadn6A&oe=6AFF0D07"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system the
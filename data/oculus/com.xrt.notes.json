1440.png", "id": "4872724046279922", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823790_4872724049613255_550500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx8hPeXeJUoQ7kNvwFA9M0T&_nc_oc=Adqz0t3ncFFiz7MMZypcE8F0wFVEaFex_1WGxX2jilhMUCoEw8VyPOHzq9q5yVRNT5s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBrWFWuXGFJ7cw0euIE4sgU1bAoPnJrQrEjYTGPCx6Qw&oe=6B0B2B38"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZZzfCiEaDsQ7kNvwE9OeqN&_nc_oc=AdqoROmUvogKmVA67oZhgUqfUF_C58W6jo4E3j6RfISrunL0_uoscGX71AhHAPKVkhM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3uUIRTZpUDmf5u8Vh6ZGn6Ma75IJsC0I_Zr2qz8pGjg&oe=6B0B3E7D"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orjqcBUFK_UQ7kNvwEWUetn&_nc_oc=AdqP6fU3RcCyw_5OTRcdkWFycFZyZYHRbf9GbZCHltMbbkmgO4yt-Il0hFV8GpDte6w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTq38fNBQNR03OEs4hyThf99vaSgv70KMtBEAjRvV_TQA&oe=6B0B22C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Wor
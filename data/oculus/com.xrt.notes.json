00_AQSzdRIngODam2oICGA3rI4iFREUEvOrdrsjqVlJwnhkVQ&oe=6B0066F8"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJSzUBVcfjIQ7kNvwEqDLrD&_nc_oc=AdqnSKOOET4BhS8hMqaKBnx7Ia0nvgVKbZpdtuEawXIZov3O5r95xn5_wcDcdeiphx4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8s1FE2TiYLifGKRG37qnAlfT4CCGH9GffFabLF2kabA&oe=6B007A3D"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViVYhOTgc7QQ7kNvwHavO4R&_nc_oc=AdqheM1pTskNaaesXrbWFuiCj0dPuNnfscKWOx-6VjvW_m_q6NIdOhsxOTb1f-xyu3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyBjA9hbbZaloQms8APucUCYw8DvZ4sFrBdkoD8ZjW5A&oe=6B005E87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system themes\n- Works fully offline", "short_description": "A fast, private markdown note app. Folders, instant search, live preview, and interactive task lists - all offline, no account needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
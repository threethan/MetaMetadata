ode, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system themes\n- Works fully offline", "short_description": "A fast, private markdown note app. Folders, instant search, live preview, and interactive task lists - all offline, no account needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://savvazaicev.github.io/notes-legal/privacy.html", "developer_terms_of_service_url": "https://savvazaicev.github.io/notes-legal/terms.html", "publisher_name": "Savva", "support_website_url": null, "website_url": "https://savvazaicev.github.io/notes-legal/landing.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1498782613310122"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623512_1073863999023953_3807239122499633736_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_9oYq_kFRkQ7kNvwGEMXLP&_nc_oc=Ado8zzMU8WDe7dZ1j5kbYVENWnF1EZ1VqkwDpYJc-VNNCglYWuRNnIpV2aIeAISsMWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCsAxi3thxqzXfS-dUU7K1RtY9_P2EF7ng9hbEgkXB1A&oe=6B0DAAEB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fal
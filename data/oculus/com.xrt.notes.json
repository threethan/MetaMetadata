00_AQRiMYsL_QmOew6lXVKEwdwxCFCIsINmoelt8aJMWLl64g&oe=6B01B878"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_CMgY-rfjAQ7kNvwHNo-9i&_nc_oc=Adq5yGt3_EKDTeibH2UiLFCSEHylo01LyJRIk5i-hSsPmIyvlzkOtP_ltObP7Z5nX2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRj3Fc_vDW3yuWquIJch9vWMt-QJhxmGJ9b46f0IgvYw&oe=6B01CBBD"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AsD2rcv5OkQ7kNvwH4jyuJ&_nc_oc=AdoxdSVcmSJcQKwdMgKplWhrnYUlaKrEb7iFzvnfYXhdUqE-tAN8lq9KKHEU2I3vB10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy_edO1VsjXzSwtb-FBNJ11m6V4O5Zs1DSMPGrlppgLA&oe=6B01E847"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system themes\n- Works fully offline", "short_description": "A fast, private markdown note app. Folders, instant search, live preview, and interactive task lists - all offline, no account needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
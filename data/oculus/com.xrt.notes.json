0363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHmZ4LkXtvoQ7kNvwEqYReF&_nc_oc=AdqOaSg07I_bNu3jdcKebXfkrxnblviCiUdKvyWkdIXH6jnowmE4160iK6LS5rZcS9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXW3S-XibcuAgVyD-S9xUZw9g7Tl1-umpzSV0mfA2Mfqg&oe=6B0F1FB8"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2uLirlg6uYQ7kNvwFWlEJG&_nc_oc=Adpe3ZzpM1WHcrtQbOy4NRpsXJ1SaGtKjt23qOMqd13k1YBQP1P-Jlc_ANFlYgE_PWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXATrP6K8TaKGHw3tcIngSh0bosuhDJJHiZHka-DdFZLQ&oe=6B0EFABD"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT9kMS8aLzAQ7kNvwFQOxe5&_nc_oc=AdoOXALu4-krtaga4__gBm7YJUAD97L0at87546d1Upao_vi8YeWbP1RogngKpDoG3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOtArMW80wdDpwjt68CCzBH0YW9M2iTmwF3fR7EKybtA&oe=6B0F1747"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system themes\
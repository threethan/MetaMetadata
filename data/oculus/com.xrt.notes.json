1440.png", "id": "4872724046279922", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_4872724049613255_550500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJlcOh66-VAQ7kNvwFYws-A&_nc_oc=AdqEoiVOfjjfb-kc1oiaxO2JfilV4PPiU-f8y25xCqAYM7ChgDAvtj7377OCFmC3hhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0UcSqlcv8Lkoq9gJ38BzaRv5GqnfIuwLRZQmg8dvk2Q&oe=6B06FE78"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc2K3d0tO9wQ7kNvwEDU0VR&_nc_oc=AdobFhLbulDcY6VNyEsAP1dUHEiS5f4ozs4b-m4v5Lf2KkygMfn73U4sKVSZh30s32E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOLlAvFFgZBjLjL4AkImYhVq4-kUMS3OvZisL7CG9zVg&oe=6B0711BD"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbHV6VB8vF8Q7kNvwFVl7d8&_nc_oc=Ado1qz4BGGzUs3RbKa_c7NLaPmiT_AO9fQOprDrsyKL5is9h-6A82SQKSyb6X6lnC_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeobuVPR84Nx_z9DOWfwR3Gx-Muo_YUnAQOUT__ApHYA&oe=6B06F607"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Wor
0363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHmZ4LkXtvoQ7kNvwGI4sZo&_nc_oc=AdqzAOJr3GKrPsuGjTmY5FTeA4x-8_h-yfy0np-HUyjRSmlS8tIrv1ziO4omMjd-XwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoERd5CXjv_IVU7RMUlymWua6np9wiCo7cnVpX_-sgFg&oe=6B0DCE38"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2uLirlg6uYQ7kNvwFnWiq1&_nc_oc=AdpU1m10KdgYT-HA0d0MhcoPzs7cNAlD_cdcYqt4RMeqlkZA4IZ6lTnTsEADjw8diaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-fHIHiKj_4p_ig2Ro6wDfFTqCLGV2uv8-tpnI3UEU5g&oe=6B0DA93D"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT9kMS8aLzAQ7kNvwHvhcgm&_nc_oc=AdpAfeYN7aUkW9WOVyGpke6z1Gz8oIxJgVW_2J20KaGjpIp--eq8FE10lNy4sUpVEMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT86OGSA97XiHWRXMr1Xf6Z2ogLRd-fGjo9Dw-Js_8wXg&oe=6B0DC5C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system themes\
1440.png", "id": "4872724046279922", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823790_4872724049613255_550500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJlcOh66-VAQ7kNvwGxd6MI&_nc_oc=Adr3nU2oPJ7k1ehx75gyeALV96livETde02Y27v9TwwtMASIg_I4qNWIvNuxVvybROI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkGQnX2_Ls_ZuohzKMA_X5EiLUI8qJaVZX2tucf7AKsg&oe=6B084FF8"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lc2K3d0tO9wQ7kNvwH1e9ul&_nc_oc=AdpV1eSjR0llF6-R45nGp19X9Wbki5iQUNWzJ6N62McMOoxXddKikqjAZgWXdTBErSw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvqB0RmMCFhmDf0BdWC98BUOe_obCto4_g3xcPk5_h2w&oe=6B08633D"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbHV6VB8vF8Q7kNvwEspKpy&_nc_oc=AdquMf_kAK4ui0SzRzXj6RYARFEcwAUyF6f83xywEmikGlqIJ9YTOznXZTuToq3goKA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-wBCRdnD7RzvlssHHLKvBzUK9Z2Pc1ysDAk5wmM7x8w&oe=6B084787"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Wor
0363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHmZ4LkXtvoQ7kNvwFr5hfC&_nc_oc=AdoGZsJiOnhdOnWcNKUsefZAUuueTPZS4b5kxA8fImG4M9cKYLt8GYN5LixHj25x6cY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuZ2Mw29ZZ0uyOCPDbdQ66WvrsQVCSnl95M3yb2SeUBw&oe=6B1038F8"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2uLirlg6uYQ7kNvwF3Aews&_nc_oc=AdpXQBwtYz_D97RUahWDFwNvorgVsXOrhSLrc-orsASSEUGB0KMlwnyF3V_ehzkJzpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtbUOkCc2i61erlq_Gp-lGGy6TUqJ4yw-qSH0VEGSnPg&oe=6B104C3D"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT9kMS8aLzAQ7kNvwGgq_ZM&_nc_oc=AdoyySi3p0JW-6v8mS9UNwytFN6DjJw9tXZMUXaaAqrQMaYgZ5CHzE7hllbbJqcpNIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbgSUdbB5crNrEhfdO25oyPbvNnAhRhfd3DaJJX9GP5A&oe=6B1068C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system themes\
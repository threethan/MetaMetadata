50500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzdBAGFiilAQ7kNvwF_RYHg&_nc_oc=Adp3BCiPLkFORrzmvOxWKI4rOuFz1t5_tmAdy15s6ZQj9NsUYcYwD0B_sUH2JRwD9vk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKo3B8gMykIwPhUX0YA5iRUuhfQeSeikBFZh-8WH26RA&oe=6B045B78"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_CMgY-rfjAQ7kNvwFQgorQ&_nc_oc=AdpEtwz33IWT30HhBjN4Fu-HS1pvrJAdkzHJSHz65BefDj66_X4Nlg8fWGxN_YM5jVY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReFkmDrPuh9lUWoSdyHkqOAC_U_9bi42BLImKDtwK2zA&oe=6B046EBD"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AsD2rcv5OkQ7kNvwEBbMFM&_nc_oc=Adr1A3m4J4MHskaWz4Sd-GJhErU3fe4q6TGO1S8QnnLv5jGcZP_-QqYzh47Gvqv0EiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7I0ojBwd-_6JfrvUjczappa-pcyRRQm4avVDw9MQxvg&oe=6B048B47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system the
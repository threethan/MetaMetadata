50500363824655861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzdBAGFiilAQ7kNvwEN3ap8&_nc_oc=Ado1UhE32mBCYGApoMYfSjcT21mc0NOhNsNb8529xzAZypLEEalN4pBcr2powZsVBVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjzTWG3Wvgfmlqj3ReGeBNzZxMC6RuHLVJlYD6DzOn-g&oe=6B0309F8"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1676979227104479", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_1676979230437812_5500761408441858511_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_CMgY-rfjAQ7kNvwE8NXJ5&_nc_oc=AdrDHU9Fm-t0720w-L6rm2Cc5O_IPJEVeayHlA1HmpvOzrpm7fnLuenbpIonl7AL7ZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx71AbklZAIUK4MhVh7S9sPrr4l9dd-yxkOciGNlSaDA&oe=6B031D3D"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1392897662923509", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_1392897666256842_5515804889163531233_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AsD2rcv5OkQ7kNvwHEuapB&_nc_oc=AdovI40kKyVOTicQQu4JTU5mAM_nMhyL4TJhXH8PEXr8lGOYtrmkYt69waWyXpX2Oyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSd3PRUvmMUsC50wNujvX-Dmbn-3-9dZCTu4uKetm3pw&oe=6B030187"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Markdown Notes", "keywords": ["markdown", "notes", "notepad", "journal", "offline"], "long_description": "**Markdown Notes** is a fast, private markdown note app built for Meta Horizon OS.\n\nEverything runs on-device - your notes are plain `.md` files. No account, no cloud, no tracking.\n\n- Live markdown editor with a formatting toolbar\n- Rich preview: headings, lists, task checklists, quotes, code, and inline styles\n- Organize with folders, color labels, and pinned notes\n- Instant search and flexible sorting\n- Word, character, and reading-time stats\n- Export all notes to `.zip` and share any note as `.md`\n- Light, dark, and system the
nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fnhYP_8rcMQ7kNvwGyojM_&_nc_oc=AdoYMf5zfygFtH4LM4BuN1E2kFEYd_TvEYQErgC0T8IN_iH_xqjfPKj6QhYlhqeBkHQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA3Gss1-xRIWmgZo1NqO_zU7WTIo7ps0m2a1ynE5tWkA&oe=6A7DBAAC"}, "display_name": "Balloon", "keywords": [], "long_description": "Balloon delivers a controller-less mixed reality experience that seamlessly integrates virtual elements into your real-world environment.\n\nWe created a full spatial audio identity for Balloon providing 360 degrees of sound that delights with original music, informs people with dynamic and high quality text-to-speech, directs people to objects of importance even if out of view, and adds realism and reinforces people\u2019s actions in surprisingly natural and delightful ways.\n\nThe result is a playful and engaging experience that encourages physical movement and interactivity, all within the comfort of your own room.", "short_description": "Balloon is a mixed-reality experience where you try to keep a virtual balloon in the air while moving through your real space, colliding and interacting with spatial obstacles."}]}, "developer_name": "Afloat Studios", "developer_privacy_policy_url": "https://www.balloongame.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blast XR LLC", "support_website_url": null, "website_url": "https://www.balloongame.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": []
hot.png", "id": "1049437731421813", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831393_1049437734755146_973096814603220319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGegOGKX6f0Q7kNvwFByklJ&_nc_oc=AdqlHapHPQIHesfgqqsIt0gKBd5bMiyFNCeeUDzXeKcSR3i3-rWWuYFblZCeBbC50iA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME5dOSYGabZj2G9e46sd4CbxQ-H5amqRuRgEfezKoAsw&oe=6ADE104D"}, {"file_name": "screenshot range (2).png", "id": "1071570595796285", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596061819_1071570599129618_5602618032705003376_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVhp3Muh7DUQ7kNvwGndn6L&_nc_oc=AdpIZFMBcTGbHmZD0rQI5pkSa-AYy1dXXZf5EzbQ4FYBKFVVf9d6VozLZSCV-4XRDYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRMwtbZzjwWvRzz5rBzShzV3tvMBULtrVBoMCVM6S2Lg&oe=6ADDF8C0"}, {"file_name": "Menu Screenshot (1).png", "id": "1073913888695301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673819499_1073913895361967_3014482049999778900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIC4pImYG6AQ7kNvwEq90qH&_nc_oc=AdpEk4qDzk0BnL2ioZg6ryhgCIY-VlnBba4YQkN8SFnfdAiP__00gpVAm_r8sdvjFfw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV60mOp96Jq4cWB_pUpYBY7uN2VgkDj9wA-ftu9n9eog&oe=6ADDF601"}, {"file_name": "Clubhead Screenshot (1).png", "id": "4714798692095734", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604385997_4714798698762400_2663312010156500639_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4iM3NLOE5kQ7kNvwExt_YW&_nc_oc=AdrKhYYvg1VmHC4lB0txmfAXOdeLCGcY7zAPOrfq1llQP3wk4e5d0pI_dA8aU-S1VjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1VPyCkYvqAKWdedFgjzrR27VNVOEX32nshd9NPTQmfw&oe=6ADDFD73"}, {"file_name": "SwingResult Screenshot (1).png", "id": "1082871341294477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595119480_1082871344627810_9139246640316922927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrZSffqNC8UQ7kNvwEZOSpU&_nc_oc=AdpfLd6excIgSj5RZk5b5YPiEr72Bz-_Oi1BBPJruWyGhPbMpJxP6idCVhzZruLI0sM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGPldmWhiIQd94C87l0VvCbTGtpsXdd8TYOVOf0kb_kQ&oe=6ADE130C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P2 Screenshot.png", "id": "2286679502091180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830576_2286679505424513_6218731566002016744_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHztgPZW9f8Q7kNvwHNK3El&_nc_oc=AdoyP8LcIb6KVVxk4RCIP5XIn5IxfRnEKHev5hX0FT5GjH4NSJnindq4zn6wX6PPL54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNezBQl_zDj89bUWWQCRjtz6AQm_Ep9cB79SmfI-2p1w&oe=6ADE0C5F"}, "display_name": "ProSwing VR Golf", "keywords": ["Golf", "Swing", "Sports", "Train"], "long_description": "We now support golf club attachments. Please let us know if you have any feedback.\n\nStep inside a pro's golf swing and use the newest form of golf training to perfect your swing and get rid of bad habits.\n\nStep directly inside a professional golfer's swing and move through it in full VR\u2014following the exact path, plane, and sequence of a tour-quality motion. Instead of just watching a swing on video, you experience it from within, so your body learns what a great swing actually feels like.\n\nThis is not an AI app where AI tells you what to fix. Instead, you can capture your swing, play it back, and compare it side by side against the pro to see precisely where yours breaks down\u2014your takeaway, the top of your backswing, your transition, or your downswing path.\n\nGuided drills are built in to help you with correct movement and train away bad habits, one rep at a time. It's like having a swing coach and a full-length mirror with you in every session.\n\nWhether you're a weekend player chasing consistency or a serious golfer fine-tuning your mechanics, ProSwing VR Golf helps you build muscle memory the fast way, by feeling the motion, not just reading about it.\n\nPut on your headset, grab your club, and train your body to move like a pro\u2014right from your living room.", "short_description": "We now support golf club attachments. Please let us know if you have any feedback.\nStep inside a professional golf swing. This VR Golf Trainer lets you position yourself right inside a pro golfer to feel the path of a perfect swing. Capture your own swing, play it back, and compare it side by side to see exactly what to fix. Drills and a driving range are included to help you perfect your swing and get rid of bad habits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sidebysideapp/home", "developer_terms_of_service_url": null, "publisher_name": "Norbys", "support_website_url": null, "website_url": "https://sites.google.com/view/sidebysideapp/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1400235869836855"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595119480_1615979993302831_196493320202822816_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1l2nPkoO0MQ7kNvwErqcUs&_nc_oc=Adri-Nr04ghRSkuRU3WVjW6xHkpZtJYHMuOoILt2Oix5e_WahdzqKUigGhD0KkDGdAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Y_GKvdpsvojeVmoAD48-d0UuAD2txaS5bRcoXX2AQQ&oe=6ADE10E2"}, "is_concept": false
cdn.com/v/t64.5771-25/499299808_2616909532028635_2915851896356360342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbGYDJq3h4EQ7kNvwHr8bIq&_nc_oc=AdoOowfGKKzgh86_aFzfbcK_QzUW87j1Fv9rvWJS1UKAsfdjZwzC8AyraLpS_Yjm9II&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7erLEkIDykpD_TLTvWyaNp6ehmP9lTVK6UENRIN64ZaQ&oe=6A11BB6B"}, {"file_name": "ss_cfa0e26168f8e93d07dcff9d28a1f6c078776af5.1920x1080 (1).png", "id": "1553426315905611", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307451_1553426319238944_8411895812293370316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC-RBEtXHl0Q7kNvwHt1NDg&_nc_oc=AdqaOoK2bA67beo7X_ION5Aoo1yYh19DSZUCQpiWY4S2cmNQtc_Eb2-2n7pCKRlA5VM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hI6HOsVxDMDQNA1E8xQ24XHVf_VrxPSCLBFlLdZWAoQ&oe=6A11C8E9"}, {"file_name": "screenshot1.png", "id": "922468497329409", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823366_922468500662742_7104421515487013904_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGiNiYcYfewQ7kNvwF-3D3r&_nc_oc=AdoHbFWSKUK_y_tv4yc2nFdRmHDk_c3vsqLskcu532vgk4XG8i6cW6IEw1XC3FAPrlM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wob8hgx67fPeJPsMY38OCJfd9AakdNr24Mlq1G65v6A&oe=6A11C5FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hotel Remorse", "keywords": ["horror", "scary", "jumpscare", "dark", "survival"], "long_description": "# Story\nYou play as Norman Chambers, a man who has lost his mind due to the death of his one true love. You wake up alone in an old dark hotel room. You must explore the long creepy corridors in search for answers to why you are there and how you can get out. But unfortunately completing this task becomes more difficult as expected, as you face the many horrors in which this hotel holds.\n\n \n# Features\n- Explore the quiet long corridors of a Hotel.\n- Find journal entries revealing answers to your questions.\n- Encounter deadly paranormal events.\n- Avoid death through quick reactions.", "short_description": "Wander long creepy corridors in search for answers in this short and jumpscare filled game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hotelremorsepolicy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "Charlie Behan", "support_website_url": null, "website_url": "https://charliebehan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26244362045244030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823310_930346613154804_727882126150130500_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHCw5GpgzXEQ7kNvwF-EoqX&_nc_oc=AdrGPLPS2UaCtF0eCzm2uSJnZA0W8KF2P42BNsvdIj1Xj9FbQtbqGgrS6jqjRQT6neg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KOaOOBcY2-Z048_7f9HoLoi7FDzA6GnEuY5DIXlxJRw&oe=6A11A13F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hotel Remorse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1776704460, "lastRevision": {"nodes": [{"id": "25309588052054772", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"appl
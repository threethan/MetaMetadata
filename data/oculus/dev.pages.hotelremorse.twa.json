.com/v/t64.5771-25/499299808_2616909532028635_2915851896356360342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgHY4NQdiuoQ7kNvwE8bihM&_nc_oc=AdpxbGZzXTP07YaMKhg4cE5ZECum2ItOqINkDuFi_JdguxsCVPsR9DSvxqos78U5vwc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp0nEc2bkGgrol1cSu6DGItVYWLE1G6BAw4tQBoXjbFA&oe=6A8D702B"}, {"file_name": "ss_cfa0e26168f8e93d07dcff9d28a1f6c078776af5.1920x1080 (1).png", "id": "1553426315905611", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307451_1553426319238944_8411895812293370316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCQYTYB_ExkQ7kNvwGYl-5J&_nc_oc=AdroVqyeV1cx7Kb0rlZ9yVq9_zEdbhcGCmMnvdFJcxWcMibLG2oYKnkZRZLBY0nF884&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbw1nf_wuT4vcAqQxczphNoqrP4tvyk7GsP4P91RIJlQ&oe=6A8D7DA9"}, {"file_name": "screenshot1.png", "id": "922468497329409", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823366_922468500662742_7104421515487013904_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a16oJq9MgNEQ7kNvwG-FxB7&_nc_oc=AdpRQB3bFBzABlg02Y_stHzTg4TpVBm6oaBHkBi74zJ34H3pr0at6oxCoejOXrlO7-k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMkwvtp_bH4HjWudBdM9RX16jqeUAQik2V_dp6gKyZwg&oe=6A8D7ABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hotel Remorse", "keywords": ["horror", "scary", "jumpscare", "dark", "survival"], "long_description": "# Story\nYou play as Norman Chambers, a man who has lost his mind due to the death of his one true love. You wake up alone in an old dark hotel room. You must explore the long creepy corridors in search for answers to why you are there and how you can get out. But unfortunately completing this task becomes more difficult as expected, as you face the many horrors in which this hotel holds.\n\n \n# Features\n- Explore the quiet long corridors of a Hotel.\n- Find journal entries revealing answers to your questions.\n- Encounter deadly paranormal events.\n- Avoid death through quick reactions.", "short_description": "Wander long creepy corridors in search for answers in this short and jumpscare filled game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hotelremorsepolicy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "Charlie Behan", "support_website_url": null, "website_url": "https://charliebehan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26244362045244030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823310_930346613154804_727882126150130500_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SO6hbCmA7i0Q7kNvwG9n3tf&_nc_oc=AdoqqBKhLJuDX33xYQKCGm6fcEm57-E4ZMA1niCp59wwvtjvdAB4Uzx5V1hKien9ylg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxdYL33_tDIgXSMQ5iIOn99BsuD5jTs7krb11EdAtpEA&oe=6A8D8E3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hotel Remorse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1776704460, "lastRevision": {"nodes": [{"id": "25309588052054772", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"appl
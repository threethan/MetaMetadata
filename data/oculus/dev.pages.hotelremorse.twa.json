 you are there and how you can get out. But unfortunately completing this task becomes more difficult as expected, as you face the many horrors in which this hotel holds.\n\n \n# Features\n- Explore the quiet long corridors of a Hotel.\n- Find journal entries revealing answers to your questions.\n- Encounter deadly paranormal events.\n- Avoid death through quick reactions.", "short_description": "Wander long creepy corridors in search for answers in this short and jumpscare filled game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hotelremorsepolicy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "Charlie Behan", "support_website_url": null, "website_url": "https://charliebehan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26244362045244030"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1804056556917666"}]}, "baseline_offer": {"id": "1804056556917666"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776704460, "status": "PUBLISHED", "id": "1804056556917666"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26274333148913586", "version": "10"}, "id": "748229861138932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "
t3Zey5JI5AbBYrz3030wXE6qUQG0Jd-3a7DA&oe=6A75D7CE"}, {"file_name": "MiniHor.png", "id": "1591503161833222", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_1591503165166555_1302322335697551064_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzwcGkDrGuUQ7kNvwHjfrmB&_nc_oc=AdrH-Q2MJq5UmnzaGM0Ar1Xm-D7YInzbinlLTjLDUv_iyxe23El_XlAp8jtpcN0YNVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiRHfxmoy1R9WOQQbQPuYnfgP_t_A-gKJkUKVjtVJf1g&oe=6A75E1D2"}, {"file_name": "MiniHor.png", "id": "1392129285813933", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823324_1392129289147266_592036253530711438_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x7G4jwX_kcQ7kNvwHn4gfK&_nc_oc=Ado3hxZkS9pzdx5Cuvhwp9B01NcLLjSGETalyi4xCGuA1Nnae3OaqKK-ptT0ycC9YR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm9rxqPnx9xl8lwF_ORe_CJV-iTOQzyvNhyg6G4E_PGQ&oe=6A75C466"}, {"file_name": "Portada.png", "id": "838036075357868", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_838036078691201_1065049276748794333_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJp_3Y7jaYUQ7kNvwEJpEKJ&_nc_oc=AdrDIPHZXQjXCKPB4jfPYD5thkM15gL_H5JnWw3YymLrjier2MwleBYVg7lvA80zP6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU-SO9Hlv9WpU7ThypW1jLiNhwl_v89CT1Jl3k98P6rQ&oe=6A75CA74"}]}, "id": "831232856744156", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lunar Chrono", "keywords": [], "long_description": "\u00bfTienes lo que se necesita para dominar los cielos estelares? Lunar Chrono es un juego arcade de realidad virtual que te pone al mando de una nave espacial en fren\u00e9ticas carreras contrarreloj. Tu misi\u00f3n: atravesar cada portal espacial antes de que el cron\u00f3metro llegue a cero.\n\nAdvertencia: Esta es una versi\u00f3n de acceso anticipado. El juego est\u00e1 en desarrollo activo, y algunas actualizaciones futuras podr\u00edan restablecer tu progreso o afectar los datos guardados. Te recomendamos jugar teniendo esto en cuenta.\n\nTu opini\u00f3n importa: Estoy abierto a sugerencias, ideas y comentarios sobre el juego. Si tienes propuestas, \u00a1estar\u00e9 encantado de tenerlas en cuenta!\n\nLas pr\u00f3ximas actualizaciones incluir\u00e1n:\n\nSistema de leaderboard global para registrar los mejores tiempos de cada jugador\n- Nuevos niveles dentro de los escenarios existentes\n- M\u00e1s escenarios con estilos visuales y trazados \u00fanicos\n- Mejoras en la f\u00edsica de vuelo y ajustes de dificultad", "short_description": "Pilota tu nave a toda velocidad en carreras contrarreloj por circuitos gal\u00e1cticos. \u00a1Cruza cada puerta espacial antes de que el tiempo se agote!"}, {"images": {"nodes": [{"file_name": "MiniHor.png", "id": "4093947847531008", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_4093947850864341_3537645828127018651_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt_oqKMxeFwQ7kNvwGbdill&_nc_oc=AdoKZpwYdgZkRQrLy1iPiu123OdHdk3v1f-7rRcH1AgCyQ1jTNlK_8WQshpP97j4wuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYpCfc9bMQdb8mM7MliEIVy0sDJ86wLgmaC4zo_ageWw&oe=6A75F94F"}, {"file_name": "MiniHor.png", "id": "2788006954863840", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_2788006958197173_4163156077055532386_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA3-mF7_r04Q7kNvwERs41Y&_nc_oc=AdpNwzTIamrEEM36jJB7ZouE7pR2ZZ8OxraW7E4WB0Z8WIK06Nag9cpj7-vGY-fvyeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI6H3mlgD54FpBP2XJWx_5ekQAyZ50vb3YAXWIZ-13dQ&oe=6A75EF6E"}, {"file_name": "Portada.png", "id": "1906340120286364", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/49182
24840_5195828547335439837_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TPmEXUppnwQ7kNvwF5gGY7&_nc_oc=Adp6JkDC6AKELrW9ZIxmRmIEsX4613b_7GP7NQ-TlBoF2Jl4gBgY0cBXHZ2Tn3Ytnt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs1NU9HM-s33VBxhy-NnH5VbGtc7v8N8LeDuPgqrSTwg&oe=6A9EB53B"}, {"file_name": "Captura de pantalla 2025-11-03 a las 20.01.01.png", "id": "623424294096258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822550_623424297429591_5675352500656573679_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlwGexCzpeQQ7kNvwFqURWR&_nc_oc=AdrNyyvyAjYDO_VHYYCn19pYjlXhX9EF3_hze8D47QPhu4CIkxmo-R-Q1ocMaJ2I9eM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8WdAc6KeS9JJrbAJFmCX6YDvZvIH-CCp_-VaZVxjfNg&oe=6A9EB0B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BackgroundLunar.png", "id": "713089394568669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821107_713089401235335_3165909134959331195_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GUoPfQzODoQ7kNvwEQBPe7&_nc_oc=AdpOMVbYDXIWlwHRqFDDCwLvNKK3-PJH3dZhIxwnJsVsIKp-lHfX4Dsw3QkIAyrLuWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdS8ABpd4eCC6hVIADztSQIfcy45dfUfIbagwjLWu6nQ&oe=6A9EC2A5"}, "display_name": "Lunar Chrono", "keywords": [], "long_description": "Do you have what it takes to conquer the stellar skies? Lunar Chrono is a fast-paced VR arcade game that puts you in control of a high-speed spacecraft in adrenaline-fueled time-trial races. Your mission: fly through every space gate before the countdown hits zero.\n\nWarning: This is an Early Access version. The game is in active development, and future updates may reset your progress or affect saved data. We recommend playing with this in mind.\n\nYour feedback matters: I'm open to suggestions, ideas, and comments about the game.  If you have proposals, I'd love to hear them!\n\nUpcoming updates will include:\n- A global leaderboard system to record the best player times\n- New levels within existing environments\n- Additional environments with unique visual styles and track layouts\n- Improvements to flight physics and difficulty balancing", "short_description": "Pilot your ship at full speed in thrilling time-trial races across galactic circuits. Cross every space gate before the clock runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lunarchrono/policy", "developer_terms_of_service_url": null, "publisher_name": "Level04", "support_website_url": null, "website_url": "https://sites.google.com/view/lunarchrono", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32577015198611313"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "740820802018474"}, {"status": "PUBLISHED", "id": "1263162888906373"}]}, "baseline_offer": {"id": "740820802018474"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769002560, "status": "PUBLISHED", "id": "740820802018474"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38013509438295168", "version": "1.2.2"}, "id": "698725259484283", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "And
GsMmYrw&oe=6AA011C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09.cover_image.png", "id": "143692782169252", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984467_143692785502585_5089419311181559924_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2WVEgubSN4Q7kNvwHbmDeO&_nc_oc=AdpJejt1XXeQG6Kc8vP2GfkCeuY0SleS5GYSoT1J9RgDpNuRyABzehciMyXcDVAP9DI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUW8toSYauEjRbPm13V05bs-cEbtRA3N0fwrxu-1SuIQ&oe=6AA02A92"}, "display_name": "Detective K - ContentsDa Science Experiment", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
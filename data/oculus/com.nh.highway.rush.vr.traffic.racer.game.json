QVkQ7kNvwHa0eZL&_nc_oc=AdrM_vFAYIAgKnddk2IrFwPIM3kjOM-rfdkr_acU1rvSi681uA_9aN3Jww5EVTGLI-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIqOQU8tgXgfnXYgANCTQW5Ub0L9wFI0x5mJ64tyYGUg&oe=6A635558"}, {"file_name": "4.png", "id": "1002509142260174", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619098_1002509148926840_2935985400796171290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkSzoKNv7HcQ7kNvwGTx6pM&_nc_oc=AdpPORliGFyi26lNzUvx2R85Okvhy5c6FMFN8cMCsao809-e47JNu4hU-6XQ3Roncw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2emeeEWySyjGzczwC5popOelJuHu8m3SApVzJef19kw&oe=6A6356A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highway Rush VR: Traffic Racer", "keywords": ["VRracing", "carracing", "trafficracing", "highwayracing", "drivinggame"], "long_description": "Step into the driver\u2019s seat and experience the ultimate VR racing challenge in Highway Rush VR: Traffic Racer. Dive into intense car racing action across a variety of environments, from busy city racing streets to open highway racing routes filled with fast-moving traffic.\n\nFeel the thrill as you push your limits through different terrains, including harsh desert racing conditions and slippery snow racing roads that test your control and precision. Each environment offers a unique driving experience, keeping every race fresh, challenging, and exciting.\n\nDodge traffic, perform risky overtakes, and survive high-speed runs in immersive VR. Whether you're mastering traffic racing or chasing the perfect run in endless mode, every second counts. Unlock powerful vehicles, upgrade performance, and dominate the road with skill and speed.\n\nWith realistic controls, dynamic environments, and adrenaline-pumping gameplay, Highway Rush VR: Traffic Racer delivers a complete racing experience\u2014from city streets to extreme conditions.\n\nAre you ready to become the ultimate racer?", "short_description": "Experience high-speed thrills in immersive VR as you weave through dense traffic, dodge obstacles, and push your driving skills to the limit. Unlock powerful cars, conquer endless highways, and become the ultimate road racer in this adrenaline-fueled racing adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27790874583835460"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1010983341313690"}, {"status": "PUBLISHED", "id": "4401457073504619"}, {"status": "PUBLISHED", "id": "1313875923446111"}, {"status": "PUBLISHED", "id": "1648865303004967"}]}, "baseline_offer": {"id": "4401457073504619"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1010983341313690"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27801726446083607", "version": "1.0.1"}, "id": "1289400570041469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {
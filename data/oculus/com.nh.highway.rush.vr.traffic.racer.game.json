444_1466563327908629_5113323703665609612_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jydt3T4EHOkQ7kNvwEyDWXy&_nc_oc=AdrmW0NfY5tCiXV1kNfEbvm7VoyCMDU83dZbP_mSUrPntdgJi_FvPPxiFmNwqorOEt4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLhcOL4no2Rczbl4CKLeY8TI-9dWlOme_bcLYfwiKudQ&oe=6A6369B8"}, {"file_name": "4.png", "id": "26151306437875852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618910_26151306444542518_4917433310407039389_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZc1l_rq9m0Q7kNvwEIBa0y&_nc_oc=AdqhaUESMOXFNWpuZxEeiB-xF1B-S5Y61HvlpoSnhAoOlYLT0s298vf_N44N8xgyvm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAChjj1AQwFApUKPrKf4n6FBYLrVMsRCkxjKDfGAtTH9A&oe=6A63701A"}, {"file_name": "1.png", "id": "1316939930396677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623601_1316939933730010_8491814214780713956_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4AdjjgcDEMQ7kNvwE-a_AH&_nc_oc=AdojHepn_jtcz0p3TMAg4PS4MQDvH-okZ7RyWZrCpqGIbv8UYekmmC-rbJzEl_xpETQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4Nk88F4Pn-Cvv8klQ18uk7c_UzuFlC6QjV7QcJgozNw&oe=6A637ED3"}, {"file_name": "3.png", "id": "1428159699328222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622276_1428159702661555_229593857751131820_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE_bBDEcbyIQ7kNvwG8eoYV&_nc_oc=AdoG3_2my_WNKgxX_n3uV43WDzQA0dEm-b5Z-xsP6nQErhKJlXGOA_FSxyYg0Cwxmxo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSPJ2cBlW1LBbs0A4z6gf-d8fTGXYINFFRCROiFcF07Q&oe=6A6372AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SpeedX Highway Rush VR: Traffic Racer", "keywords": ["VRracing", "carracing", "trafficracing", "highwayracing", "drivinggame"], "long_description": "Step into the driver\u2019s seat and experience the ultimate VR racing challenge in Highway Rush VR: Traffic Racer. Dive into intense car racing action across a variety of environments, from busy city racing streets to open highway racing routes filled with fast-moving traffic.\n\nFeel the thrill as you push your limits through different terrains, including harsh desert racing conditions and slippery snow racing roads that test your control and precision. Each environment offers a unique driving experience, keeping every race fresh, challenging, and exciting.\n\nDodge traffic, perform risky overtakes, and survive high-speed runs in immersive VR. Whether you're mastering traffic racing or chasing the perfect run in endless mode, every second counts. Unlock powerful vehicles, upgrade performance, and dominate the road with skill and speed.\n\nWith realistic controls, dynamic environments, and adrenaline-pumping gameplay, Highway Rush VR: Traffic Racer delivers a complete racing experience\u2014from city streets to extreme conditions.\n\nAre you ready to become the ultimate racer?", "short_description": "Experience high-speed thrills in immersive VR as you weave through dense traffic, dodge obstacles, and push your driving skills to the limit. Unlock powerful cars, conquer endless highways, and become the ultimate road racer in this adrenaline-fueled racing adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
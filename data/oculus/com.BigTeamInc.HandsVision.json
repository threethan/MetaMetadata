5507167_1825342281258507_5224724897948747945_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjCHpnUiAMsQ7kNvwG0ibqX&_nc_oc=AdqSqjkPXjf74ZRZ8O4VYOqNOqhjBBZr4Bzk5b7bih43ziAbN7_ivrfas56ji5QsAo4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7bK3Ahj_zYv_BwMqHlugmHuEuHART1Nkh9OdWkZ4sQw&oe=6B085C9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "781098494034898", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982478_781098497368231_7299915863705927477_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pVeznsKupEQ7kNvwHy1f9i&_nc_oc=AdovX1jiFAgeDq-bdo7Wtz7_iap0istJ3Xv6KYlmCXvjV9yf9KHIo1FPPGMiwvxA4xE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9A86CGnH971gwbBbUvcNpX-rq-Hqn5Af6vMqVGl_usw&oe=6B0868D1"}, "display_name": "HandsVision", "keywords": [], "long_description": "HandsVision is a rock-paper-scissors game based on mixed reality. Anyone can enjoy it, regardless of gender or age, and the winner can advance their character.\n- As you overcome numerous levels, a new rock-paper-scissors game opens.\n- If you cannot solve the problem, use a special item to solve the problem.\n- Achieve goals and solve countless levels.\n- New levels are added every week, providing unstoppable fun.\n- Some of the game items require paid payment. Please check the privacy policy at  http://www.bigteam.co.kr/privacy_policy_english.html.", "short_description": "Mixed Reality based Paper-Rock-Scissor Game"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_bigteam.html", "developer_terms_of_service_url": "http://www.bigteam.co.kr/terms_bigteam.html", "publisher_name": "bsh@bigteam.co.kr", "support_website_url": null, "website_url": "http://www.bigteam.co.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
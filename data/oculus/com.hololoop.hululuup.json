ps generated in space. Or fly a little glider. ", "short_description": "This game is all about loops. Fly through as many loops as you can within the time limit. You can also throw orbs through the loops. This game can be relaxing or exhilarating. If you like flying, space or roller coasters, you'll like this game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hululuup.com/privacy_policy", "developer_terms_of_service_url": "http://www.hululuup.com/terms", "publisher_name": "Hololoop Inc", "support_website_url": "http://www.hululuup.com/support", "website_url": "http://www.hululuup.com/game", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ARCADE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "995735904724357"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001700_827778901760930_1236325262723476148_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRNrKMpnwyAQ7kNvwEci9TB&_nc_oc=AdpWzfbPFPXTyNugOMDG54MUat3Ufzu-iUQElmiY0x2BCVjKIxx7vm337g7pEijVJ3U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2tWh7beKJJ6f0TvcJu_jKoRCe1RcByc5d2Xr5CYq6ong&oe=69F1FCCC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hululuup", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_
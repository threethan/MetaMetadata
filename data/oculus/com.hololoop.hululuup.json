y through hoops generated in space. Or fly a little glider. ", "short_description": "This game is all about loops. Fly through as many loops as you can within the time limit. You can also throw orbs through the loops. This game can be relaxing or exhilarating. If you like flying, space or roller coasters, you'll like this game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hululuup.com/privacy_policy", "developer_terms_of_service_url": "http://www.hululuup.com/terms", "publisher_name": "Hololoop Inc", "support_website_url": "http://www.hululuup.com/support", "website_url": "http://www.hululuup.com/game", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ARCADE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "995735904724357"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001700_827778901760930_1236325262723476148_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yam-tvLKg7YQ7kNvwGUbhX-&_nc_oc=AdmZ4gV2Q_nsbYZm_C0TcVT0k41RluHpRxQWL_aOkz9sVMyiX6H-Sr0qgqmmjgTAYrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzz5UjIonVtangKhIDPJ-mUFlVXLOeMGvcvRwVX641VkQ&oe=69B011CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hululuup", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "cont
C0CE"}, "display_name": "Unlimited Bowling", "keywords": [], "long_description": "\u2022Real world dynamic ball hook motions and pin actions make you feel the same satisfaction of hitting a perfect strike as playing bowling in real life!\n\n\u2022In total of 9 challenging oil patterns to bowl on! Bowl like a pro, adapt your game and conquer on any lane conditions!\n\n\u2022Easy and intuitive controls let you bowl in whichever style you like with ease! Stroker, tweener, cranker, straight ball, your choice!\n\n\u2022Engage in Daily Events to clinch the titles and challenge yourself for the best scores!\n\n\u2022Challenging Versus AI mode to test your bowling skills to the limit!", "short_description": "Feel the joy and excitement of real bowling!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/29399437", "developer_terms_of_service_url": null, "publisher_name": "SP Software Productions", "support_website_url": null, "website_url": "https://www.facebook.com/Unlimited-Bowling-VR-109255341414550", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5236434623041784"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1331637967813739"}, {"status": "PUBLISHED", "id": "745833063827168"}, {"status": "PUBLISHED", "id": "275813470976782"}, {"status": "PUBLI
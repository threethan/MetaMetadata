qB5SC6uWmv95ILON1kp4C6Mbtx-VDg-qK4bOp63dSq0LC7wz9tIryRJvXwV2GXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsfLKzSsvPzseGPEQrxfO3MrHKXLhjBEJFRPEiVU0qVw&oe=6B0DB54E"}, "display_name": "Unlimited Bowling", "keywords": ["bowling", "bowl", "sports", "strike", "ball"], "long_description": "Feel the joy and excitement of real bowling!\n\n\u2022Real world dynamic ball hook motions and pin actions make you feel the same satisfaction of hitting a perfect strike as playing bowling in real life!\n\n\u2022In total of 9 challenging oil patterns to bowl on! Bowl like a pro, adapt your game and conquer on any lane conditions!\n\n\u2022Online Free Play mode let's you bowl with your friends and others all around the world the way you want it. You can hold a casual bowling party or you can join together for a thrilling stepladder competition!\n\n\u2022Engage in Daily Events to clinch the titles and challenge yourself for the best scores!\n\n\u2022Challenging Versus AI mode to test your bowling skills to the limit!\n\n\u2022Score 300 points or more easily in an action-packed 100-pin game! But scoring a perfect 3000 points game won't be as easy!", "short_description": "Feel the joy and excitement of real bowling!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://unlimited-bowling.web.app/Privacy%20Policy%20of%20Unlimited%20Bowling%20(VR).html", "developer_terms_of_service_url": null, "publisher_name": "SP Software Productions", "support_website_url": null, "website_url": "https://www.facebook.com/Unlimited-Bowling-VR-109255341414550", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommend
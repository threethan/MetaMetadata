le_name": "screen_2560x1440_2026-08-02_13-36-02.png", "id": "1555194246619365", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619668_1555194253286031_6038383990662036019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlLb_WBYuwIQ7kNvwFFNmra&_nc_oc=AdrrxLiwYay6yd3VRu2Geojk0NJN_IkATEWRp-WeHztdudOSrQ3OTqVkgBgkWQnBAIw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpi19-rm6P6PYGDGhkndcCw2Es6i_beKT3AHZLvGibNA&oe=6AE34F71"}, {"file_name": "screen_2560x1440_2026-08-02_13-34-57.png", "id": "1050250101032204", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298900_1050250104365537_5933195947701893949_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlxWuOPwKbgQ7kNvwF6ec6N&_nc_oc=Adr48-zvIgVmnV3iWoS5mtVAbWy-Pxd0d2nH98H0DSuqGaOuu2SigC3Dw2tuB-rRpok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWa9lVQNMrrssvYDt9tiSa3-Hevsl_t5IOxKVFIuNohg&oe=6AE35AED"}, {"file_name": "screen_2560x1440_2026-08-02_13-37-52.png", "id": "4194209784055786", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299891_4194209787389119_5809795826942979793_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmGQgJMnBksQ7kNvwGN3hVy&_nc_oc=Adohti5ljJQ8O5HL3__2zqTcexcPRPanZFafsLYQDwFaI-0Rm7ypGb_kgg7Kq3MZYMg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmzU-AKAz5ESWQ3ysDXAjBtKrTsVZ6waaF53wrJ3pGzw&oe=6AE362AF"}, {"file_name": "screen_2560x1440_2026-08-02_13-41-02.png", "id": "4420207208245803", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/646443466_4420207211579136_7397823725308844625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qp_AXQvmfE0Q7kNvwFjYguN&_nc_oc=AdqS-lUMIe5JgASKmQdxK2D_Kby69kEZZmPCmqJA5pPZuIBdFOc7CjoqMzt3u6pAjW0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3Xc3EjUz6NsZ1f2TVivpTGMMguNAE0kfRW5biUZAILw&oe=6AE34EF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wigglesworth", "keywords": ["Wigglesworth", "ProjectWigglesworth", "Wiggle", "Scary", "Monke"], "long_description": "Wigglesworth is a multiplayer monke horror game for Meta Quest. Move with your arms like a gorilla: run, jump and climb as fast as your hands can carry you, and get away before something catches you.\n\nGAME MODES\n\u2022 Be the Monster \u2013 One player becomes the monster and hunts everyone else down.\n\u2022 Imposter \u2013 A social deduction mode on a spaceship. Someone in your lobby isn't who they say they are. Find the imposter before they find you.\n\nFEATURES\n\u2022 Gorilla-style arm locomotion\n\u2022 Multiplayer lobbies with voice chat\n\u2022 Mod menus that let you fly away from the monsters\n\u2022 Unlock and collect cosmetics for your monke\n\u2022 Regular updates with new modes, maps and events\n\nFree to play. Join the community Discord to hear about new updates first: https://discord.gg/awp2ubRjZB", "short_description": "Run, climb and hide using monke arm locomotion in this multiplayer horror game. Escape the monster with your friends, become the monster yourself, or find the imposter hiding on the spaceship. Free to play, with voice chat and new cosmetics added regularly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wigglesworthstudios.com/privacy", "developer_terms_of_service_url": "https://wigglesworthstudios.com/terms", "publisher_name": "WigglesworthStudios", "support_website_url": null, "website_url": "https://wigglesworthstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
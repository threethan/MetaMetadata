: "1555194246619365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_1555194253286031_6038383990662036019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64R1ByRA4soQ7kNvwH0TF_f&_nc_oc=Adom5o3-bA8fqnDkyDSh4XeFYOnSKsJG1hYK-ui4_UVCC79PGLnpQ2KzkW7F0qoeqFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa90ujrHcJJQmAtiHNnWf2qXgVKiELC30K3CeGm1dvsQ&oe=6AF20831"}, {"file_name": "screen_2560x1440_2026-08-02_13-34-57.png", "id": "1050250101032204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298900_1050250104365537_5933195947701893949_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD0w0con_ysQ7kNvwHLrtN5&_nc_oc=AdowDST8wzrU7aSPJJLDMECoJoWwtKW3V2IJ1miQtUihSAq1FJCgMNiBLl6sKCsPXNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHjR8mcdI6ZspP3m0A7_DiJZVYdfSCtJmoQlbSHXZFMw&oe=6AF1DB6D"}, {"file_name": "screen_2560x1440_2026-08-02_13-37-52.png", "id": "4194209784055786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_4194209787389119_5809795826942979793_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taIMcgIAv-0Q7kNvwEVMPRX&_nc_oc=AdqeXD1SVlKHYYt1hx_VTG434EOnv_VAZJpvmmqy6EWHWgkQMQxA-xfSv85vlHPq0BQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY3YqqQNAq-dk79Eb8we87lOLTLV3GpoPRxC61ti6-ng&oe=6AF1E32F"}, {"file_name": "screen_2560x1440_2026-08-02_13-41-02.png", "id": "4420207208245803", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646443466_4420207211579136_7397823725308844625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXAtL1nvdOEQ7kNvwEqJUtR&_nc_oc=AdpcZgaCet54pRsRTiKpOFK7b5SJ8mgSBX9qHjGRCNwgHHcytuw-E1ee8a0rJoMkT4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdJvo_qzw2kh1vUdqzpNP9fyXZO5yQkr9p50Yf42974g&oe=6AF207B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wigglesworth", "keywords": ["Wigglesworth", "ProjectWigglesworth", "Wiggle", "Scary", "Monke"], "long_description": "Wigglesworth is a multiplayer monke horror game for Meta Quest. Move with your arms like a gorilla: run, jump and climb as fast as your hands can carry you, and get away before something catches you.\n\nGAME MODES\n\u2022 Be the Monster \u2013 One player becomes the monster and hunts everyone else down.\n\u2022 Imposter \u2013 A social deduction mode on a spaceship. Someone in your lobby isn't who they say they are. Find the imposter before they find you.\n\nFEATURES\n\u2022 Gorilla-style arm locomotion\n\u2022 Multiplayer lobbies with voice chat\n\u2022 Mod menus that let you fly away from the monsters\n\u2022 Unlock and collect cosmetics for your monke\n\u2022 Regular updates with new modes, maps and events\n\nFree to play. Join the community Discord to hear about new updates first: https://discord.gg/awp2ubRjZB", "short_description": "Run, climb and hide using monke arm locomotion in this multiplayer horror game. Escape the monster with your friends, become the monster yourself, or find the imposter hiding on the spaceship. Free to play, with voice chat and new cosmetics added regularly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wigglesworthstudios.com/privacy", "developer_terms_of_service_url": "https://wigglesworthstudios.com/terms", "publisher_name": "WigglesworthStudios", "support_website_url": null, "website_url": "https://wigglesworthstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
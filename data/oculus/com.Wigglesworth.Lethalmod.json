=Zv_Doi2S1t4Q7kNvwFFZlRb&_nc_oc=AdonKBBHWQJWiuy8H0Y3K7VDqWlxejZ1pnzCHDeQsIoBfTeUYrwv7Ek443w_X31YNBs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3h6PGsi0FsNJCrJyBIqwXMPKVSivEP22uQB5SXcLzpQ&oe=6AFDACF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wigglesworth", "keywords": ["Wigglesworth", "ProjectWigglesworth", "Wiggle", "Scary", "Monke"], "long_description": "Wigglesworth is a multiplayer monke horror game for Meta Quest. Move with your arms like a gorilla: run, jump and climb as fast as your hands can carry you, and get away before something catches you.\n\nGAME MODES\n\u2022 Be the Monster \u2013 One player becomes the monster and hunts everyone else down.\n\u2022 Imposter \u2013 A social deduction mode on a spaceship. Someone in your lobby isn't who they say they are. Find the imposter before they find you.\n\nFEATURES\n\u2022 Gorilla-style arm locomotion\n\u2022 Multiplayer lobbies with voice chat\n\u2022 Mod menus that let you fly away from the monsters\n\u2022 Unlock and collect cosmetics for your monke\n\u2022 Regular updates with new modes, maps and events\n\nFree to play. Join the community Discord to hear about new updates first: https://discord.gg/awp2ubRjZB", "short_description": "Run, climb and hide using monke arm locomotion in this multiplayer horror game. Escape the monster with your friends, become the monster yourself, or find the imposter hiding on the spaceship. Free to play, with voice chat and new cosmetics added regularly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wigglesworthstudios.com/privacy", "developer_terms_of_service_url": "https://wigglesworthstudios.com/terms", "publisher_name": "WigglesworthStudios", "support_website_url": null, "website_url": "https://wigglesworthstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
oculuscdn.com/v/t64.5771-25/499293803_2237783760081395_5368468207739261855_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnDJlnhJACoQ7kNvwFViKvx&_nc_oc=Adoo8LyvkCRacOyTLqP_LTHNmIcWHc_PPaV48J65tlV9JQGLo3C8WfXImXgdIzH5N50&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yfgvkeEkVJMa4ZpDEV4yV9x_J8zsI3Ugdq39fY_Dydw&oe=6A393932"}, {"file_name": "screen_2560x1440_2026-03-09_12-05-04.png", "id": "2036998966859837", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/646413489_2036998970193170_3692134058240596724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlVqCG7Bv5MQ7kNvwHBG_nP&_nc_oc=Adp9c98GHcsSh72m_Z4dP_PLuw6bfuLaTzeA0jAyeVE5w4XbNsQp79F1NugW3ksaULI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NuXFAgSIUcX6-lcs-TWSB0mLtcvJBTpZJcKNlwFwYPg&oe=6A392CB2"}, {"file_name": "screen_2560x1440_2026-03-09_12-07-39.png", "id": "914812774692814", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499307505_914812778026147_95686955334429199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnPLklaF960Q7kNvwG6M494&_nc_oc=AdrXr71UFnoUuk6DhEMhj20xuL6hgyShOluFwuoFQ-WReu7ln4nZenenG8girAhZtlg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yuDrcB25iCKnkzYWQLDt3-gQykkx3xpsw8T9CNMchiw&oe=6A394BB6"}, {"file_name": "screen_2560x1440_2026-03-09_12-06-05.png", "id": "2215532399193017", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499312263_2215532402526350_3316773686252033087_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFLgWKpVJXIQ7kNvwFruqrJ&_nc_oc=AdqWLZQZf4DFms8J9n1gGOxavgEd7MCM4fcNg9RHBkVLVMk4VrseFKGn_cGCtFytgxA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nWduMn7WOMDrI-CXIATFnuL7xNhp-BWEN4pDf5sC9mQ&oe=6A3954F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Wigglesworth: Lethal Ape MODS", "keywords": ["Lethalape", "Wigglesworth", "ProjectWigglesworth", "Mods", "MODS"], "long_description": "Swing, launch, and climb your way through a strange, ever-shifting laboratory in Project Wigglesworth: Lethal Ape MODS\u2014a quirky VR adventure powered by fast, Gorilla-style movement. Navigate broken lab equipment, scale towering machinery, and vault through corridors as you explore a place full of surprises and secrets.\n\nThe lab changes around you. Lights flicker, mist drifts through rooms, and the environment subtly shifts as you move, creating a world that feels alive and unpredictable.\n\nPacked with mods that add twists to your adventure, the lab hides experimental devices, cryptic notes, and odd encounters that reward the curious. Exploration is encouraged, and the deeper you go, the more the world surprises you.\n\nFrom leaping between catwalks to uncovering strange little mysteries, Project Wigglesworth: Lethal Ape MODS blends momentum-based movement, playful exploration, and unexpected discoveries into a VR experience that\u2019s weird, dynamic, and endlessly entertaining.", "short_description": "Swing, climb, and launch through a quirky, ever-changing lab in Project Wigglesworth: Lethal Ape MODS. Use momentum-based movement to explore, uncover secrets, and discover playful surprises hidden around every corner. Mods add twists to the adventure, making every run unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10PDpPHOb4G5DBWaARgIFjlZwL9Qvg-dw55T-kEcYmLo", "developer_terms_of_service_url": null, "publisher_name": "WigglesworthStudios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1q3NyXRxo7CC3-wk7Rdrj2sT8QoVMYpOmAY24INjEZGU", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pl
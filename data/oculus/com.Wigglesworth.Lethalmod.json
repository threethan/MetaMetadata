uluscdn.com/v/t64.5771-25/499293803_2237783760081395_5368468207739261855_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nm8HGMxuBkQ7kNvwEGQHce&_nc_oc=AdopSxArXLhDQONS3aLCbEaR_kUNHnuZG8DODTLFNmdzetRekvh8eiHGOAk5yyRF5pI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92TIhoiVoPAXjIUIbHkx3dNIjor1RJbbkfFeDlbnhLRQ&oe=6A2FFEB2"}, {"file_name": "screen_2560x1440_2026-03-09_12-05-04.png", "id": "2036998966859837", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/646413489_2036998970193170_3692134058240596724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XFkRqYYNwoQ7kNvwF2XBF7&_nc_oc=Adp5myaquq4NtQnCymrm-2TRh8cbg-QUej4tebdqGdxTKzDjh4id10nEdZ7ro1dUFS0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0oPBzFn-J7JE13tiKUN8mEgUjwmrlMAYrBhdS-69i7g&oe=6A2FF232"}, {"file_name": "screen_2560x1440_2026-03-09_12-07-39.png", "id": "914812774692814", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307505_914812778026147_95686955334429199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AYyTA4U_U8Q7kNvwHgav6a&_nc_oc=AdpnN8wRFbKKxHCsaWt6pzGmyJt25Nj6kTwp6thcibgH_xDoLV60CEnRC3FmBQ_3b5w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6INWC-brIgldbIB88OxoFoMxe7xTjUXLuH57ge988wA&oe=6A301136"}, {"file_name": "screen_2560x1440_2026-03-09_12-06-05.png", "id": "2215532399193017", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312263_2215532402526350_3316773686252033087_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_xDcpJ7B3QQ7kNvwGBZCBq&_nc_oc=AdrpKlRklH3TeOPatYiYT3t0oMVX2OwYq5lTpSua3KdU6tKzhhPIN98OuhzZ3VPuYpk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9S5oGpj8I3zxRrrZUyd-IkPyHSVdDYbPc4MdfRwkelA&oe=6A301A75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Wigglesworth: Lethal Ape MODS", "keywords": ["Lethalape", "Wigglesworth", "ProjectWigglesworth", "Mods", "MODS"], "long_description": "Swing, launch, and climb your way through a strange, ever-shifting laboratory in Project Wigglesworth: Lethal Ape MODS\u2014a quirky VR adventure powered by fast, Gorilla-style movement. Navigate broken lab equipment, scale towering machinery, and vault through corridors as you explore a place full of surprises and secrets.\n\nThe lab changes around you. Lights flicker, mist drifts through rooms, and the environment subtly shifts as you move, creating a world that feels alive and unpredictable.\n\nPacked with mods that add twists to your adventure, the lab hides experimental devices, cryptic notes, and odd encounters that reward the curious. Exploration is encouraged, and the deeper you go, the more the world surprises you.\n\nFrom leaping between catwalks to uncovering strange little mysteries, Project Wigglesworth: Lethal Ape MODS blends momentum-based movement, playful exploration, and unexpected discoveries into a VR experience that\u2019s weird, dynamic, and endlessly entertaining.", "short_description": "Swing, climb, and launch through a quirky, ever-changing lab in Project Wigglesworth: Lethal Ape MODS. Use momentum-based movement to explore, uncover secrets, and discover playful surprises hidden around every corner. Mods add twists to the adventure, making every run unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10PDpPHOb4G5DBWaARgIFjlZwL9Qvg-dw55T-kEcYmLo", "developer_terms_of_service_url": null, "publisher_name": "WigglesworthStudios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1q3NyXRxo7CC3-wk7Rdrj2sT8QoVMYpOmAY24INjEZGU", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
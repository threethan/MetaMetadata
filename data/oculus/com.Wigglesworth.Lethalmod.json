", "id": "2036998966859837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646413489_2036998970193170_3692134058240596724_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTsklnbK-8kQ7kNvwGrBI9P&_nc_oc=Adq2WE2mfxCbKzpbv43bnqcR0_FWsW6t3NuYi98kQdER2QcnGeWTeLGB5kgijrc5RKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgLbCCPGzz5xfYknOZZvtdL9fpkbl3kVa_v0n8ebgrlw&oe=6AEA0DF2"}, {"file_name": "screen_2560x1440_2026-03-09_12-07-39.png", "id": "914812774692814", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307505_914812778026147_95686955334429199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85swuwlgAbAQ7kNvwFG6T78&_nc_oc=AdrGUydfvlEihFl4Hki4lkdcvhg_4CHhHl5QQp4axSdXKReVBeCzx5hZmhaqE_PFwdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqUblmp2NkOSu8EyQKrd4fgIYv_12FKJ9h__ewPc3ZJw&oe=6AE9F4B6"}, {"file_name": "screen_2560x1440_2026-03-09_12-06-05.png", "id": "2215532399193017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312263_2215532402526350_3316773686252033087_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seZinF6XNPcQ7kNvwHyGTcE&_nc_oc=AdrBZZ9_VZ5QHdhjBi18XeJkJhmAAkncTaILaP1VvZfXd0Qc1IidsptgBEVQYTQ3Q6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0G_kJL264yqy_gQ4guQqFFcUSPTgl1OPSU3pw1MxzQw&oe=6AE9FDF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Wigglesworth: Lethal Ape MODS", "keywords": ["Lethalape", "Wigglesworth", "ProjectWigglesworth", "Mods", "MODS"], "long_description": "Swing, launch, and climb your way through a strange, ever-shifting laboratory in Project Wigglesworth: Lethal Ape MODS\u2014a quirky VR adventure powered by fast, Gorilla-style movement. Navigate broken lab equipment, scale towering machinery, and vault through corridors as you explore a place full of surprises and secrets.\n\nThe lab changes around you. Lights flicker, mist drifts through rooms, and the environment subtly shifts as you move, creating a world that feels alive and unpredictable.\n\nPacked with mods that add twists to your adventure, the lab hides experimental devices, cryptic notes, and odd encounters that reward the curious. Exploration is encouraged, and the deeper you go, the more the world surprises you.\n\nFrom leaping between catwalks to uncovering strange little mysteries, Project Wigglesworth: Lethal Ape MODS blends momentum-based movement, playful exploration, and unexpected discoveries into a VR experience that\u2019s weird, dynamic, and endlessly entertaining.", "short_description": "Swing, climb, and launch through a quirky, ever-changing lab in Project Wigglesworth: Lethal Ape MODS. Use momentum-based movement to explore, uncover secrets, and discover playful surprises hidden around every corner. Mods add twists to the adventure, making every run unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10PDpPHOb4G5DBWaARgIFjlZwL9Qvg-dw55T-kEcYmLo", "developer_terms_of_service_url": null, "publisher_name": "WigglesworthStudios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1q3NyXRxo7CC3-wk7Rdrj2sT8QoVMYpOmAY24INjEZGU", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25830846559931354"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status
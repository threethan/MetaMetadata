72_27035701019447023_6789180445274084035_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0HHg9Y41BcQ7kNvwFoyAno&_nc_oc=AdqZBFJN-5H2AyYVS9HkT0fq8oZVBrjZFj7dYTpUJZTSWwKes2kwRTDZdRL97Hee85k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo3aQ0QcA9oNCQ1L-CExF7sXdN7jwhbw0VnYnXAmSSOA&oe=6AE33899"}, {"file_name": "apretados_en_el_ascensor_2560x1440.png", "id": "2285729335581698", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622334_2285729338915031_3978302452658144244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e2kTKI7RZYQ7kNvwGODkBN&_nc_oc=Adqc_NBVH1TQPh6ELTun0WxjZwznbS0VGywd9SU6VyOyBs3unthpfR1x1jKN__H3XDQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEY-nnh0GXCVR-md6k9QHaW2kLuR7ootz-yCGmmNPK4g&oe=6AE3657E"}, {"file_name": "miniatura_tdah_2560x1440.png", "id": "1553872933451350", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595119480_1553872936784683_4375657679510924502_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3Gp13vANo8Q7kNvwEKKjeb&_nc_oc=Adp3TxrPyv7eJxAWv3UhBd0TvtCgnQEAw8SDV7bExhG9I0ZfN839zTFQBIOkyrFvYIY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdQLICruQpnmq3AbWwjEjkweGH5g8nzbThLe2z_MAz5A&oe=6AE35B3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRET", "keywords": ["exposicion", "relajacion", "bienestar", "inmersion"], "long_description": "VRET es una aplicaci\u00f3n de realidad virtual que recrea entornos inmersivos y realistas para practicar ejercicios de relajaci\u00f3n, concentraci\u00f3n y afrontamiento personal a tu propio ritmo.\n\nLa aplicaci\u00f3n ofrece escenarios virtuales variados en los que puedes exponerte de forma gradual y controlada a distintas situaciones, ayud\u00e1ndote a sentirte m\u00e1s c\u00f3modo y seguro en ellas. Cada experiencia est\u00e1 dise\u00f1ada para que avances paso a paso, eligiendo el nivel y la intensidad que prefieras.\n\nAdem\u00e1s, VRET incluye un sistema de seguimiento que te permite revisar tu progreso a lo largo de las sesiones, observar tu evoluci\u00f3n y mantener la motivaci\u00f3n.\n\nVRET es una herramienta de bienestar general y pr\u00e1ctica personal. No es un dispositivo m\u00e9dico ni sustituye la orientaci\u00f3n de un profesional cualificado.", "short_description": "VRET es una aplicaci\u00f3n de realidad virtual que ofrece entornos inmersivos y graduales para practicar ejercicios de relajaci\u00f3n y afrontamiento personal. Los usuarios pueden explorar escenarios controlados a su propio ritmo y revisar su progreso a lo largo de las sesiones, como apoyo a su bienestar general."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vret.es/legal", "developer_terms_of_service_url": null, "publisher_name": "Vret", "support_website_url": null, "website_url": "https://vret.es/terminos", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1217836388080367"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2262333204308285"}, {"status": "PUBLISHED", "id": "1658094418782446"}]}, "baseline_offer": {"id": "2262333204308285"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792156920, "status": "PUBLISHED", "id": "2262333204308285"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1451777594686244", 
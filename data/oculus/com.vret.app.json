=1-7&_nc_sid=6e7a0a&_nc_ohc=9MsasnzA4rgQ7kNvwG7UkYb&_nc_oc=Adr1TU8APva83A8rlyES-qCBFcAIhNcgodniC0--bOI36_OY8iGgnwz6O9LmTbP66-E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVAJPp3Z1S8m3uGx-eS6DUrvhLvRlKWGyx2MH_crNjnA&oe=6AA964D2"}, {"file_name": "ChatGPT Image 7 jun 2026, 21_03_49.png", "id": "27035701012780357", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499313072_27035701019447023_6789180445274084035_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIvnYFUqb5IQ7kNvwHBEnxV&_nc_oc=Ado7WsgIHVi1KfrdyAeLGubRXvI89E7bpo2TI111rnSxlNLKlZk792fm3M--oFVPtVo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq2De7AQNyHStjAR7iVU6Ind0JEWOronB5vA9mFBlipw&oe=6AA93699"}, {"file_name": "apretados_en_el_ascensor_2560x1440.png", "id": "2285729335581698", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499622334_2285729338915031_3978302452658144244_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0TIqC9YdJ8Q7kNvwFZ4fS1&_nc_oc=AdoMJQM3r_GE215XUV209GyTtg20cDSaZdbKFRii1QDgj6eWlWJ21F-pE52tNBIUS7s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3IR3lZ1ujWuDxZvABmNkZ4sheydiQSE9QHStDV9at2A&oe=6AA9637E"}, {"file_name": "miniatura_tdah_2560x1440.png", "id": "1553872933451350", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/595119480_1553872936784683_4375657679510924502_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3pK4xGMQX8Q7kNvwH5gU_K&_nc_oc=AdqdKTmm4XWLwtiC6nl_QrTncP9ykfHX6A457E9xpuHfzsN6dYN-ylytZsB65xXriHQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_OSNTRqyqUQUI4kbxRMv529opefMmV-yeSveAw0vgzw&oe=6AA9593F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRET", "keywords": ["exposicion", "relajacion", "bienestar", "inmersion"], "long_description": "VRET es una aplicaci\u00f3n de realidad virtual que recrea entornos inmersivos y realistas para practicar ejercicios de relajaci\u00f3n, concentraci\u00f3n y afrontamiento personal a tu propio ritmo.\n\nLa aplicaci\u00f3n ofrece escenarios virtuales variados en los que puedes exponerte de forma gradual y controlada a distintas situaciones, ayud\u00e1ndote a sentirte m\u00e1s c\u00f3modo y seguro en ellas. Cada experiencia est\u00e1 dise\u00f1ada para que avances paso a paso, eligiendo el nivel y la intensidad que prefieras.\n\nAdem\u00e1s, VRET incluye un sistema de seguimiento que te permite revisar tu progreso a lo largo de las sesiones, observar tu evoluci\u00f3n y mantener la motivaci\u00f3n.\n\nVRET es una herramienta de bienestar general y pr\u00e1ctica personal. No es un dispositivo m\u00e9dico ni sustituye la orientaci\u00f3n de un profesional cualificado.", "short_description": "VRET es una aplicaci\u00f3n de realidad virtual que ofrece entornos inmersivos y graduales para practicar ejercicios de relajaci\u00f3n y afrontamiento personal. Los usuarios pueden explorar escenarios controlados a su propio ritmo y revisar su progreso a lo largo de las sesiones, como apoyo a su bienestar general."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vret.es/legal", "developer_terms_of_service_url": null, "publisher_name": "Vret", "support_website_url": null, "website_url": "https://vret.es/terminos", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1217836388080367"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED
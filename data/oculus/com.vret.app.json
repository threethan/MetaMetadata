pn7I1aNRbnoklzXku7qo93DpII9ZukKr8OAoA8LvXg&oe=6AFB21D2"}, {"file_name": "ChatGPT Image 7 jun 2026, 21_03_49.png", "id": "27035701012780357", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313072_27035701019447023_6789180445274084035_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_9Vt1nHqh8Q7kNvwHAdHLi&_nc_oc=AdrnPbbu4x-mGRoxTvLwO9n1dNI_8PUjNlxhgXkmg4UNxuh6o_YvLZ-MzH3MI79yeNY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZzkvfh1DD5xjZdoab-7knabx6XU1OGG0uknijxRIqlA&oe=6AFB2BD9"}, {"file_name": "apretados_en_el_ascensor_2560x1440.png", "id": "2285729335581698", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622334_2285729338915031_3978302452658144244_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW39UQEzYowQ7kNvwE1rNtP&_nc_oc=Adq4uQmHTsSnXoKaI9GbQ4hjwEfXaXhqz-1I8Ext46xK0DkeahjQgfbMlDJDh0_kzK8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlj3_rqEVmr8Ipo47e98u3o6XiEdJAcfeyMyDlAUE5OQ&oe=6AFB207E"}, {"file_name": "miniatura_tdah_2560x1440.png", "id": "1553872933451350", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595119480_1553872936784683_4375657679510924502_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XDGynPhiKgQ7kNvwEiEIZs&_nc_oc=Adqstwu67zKXqgHYYmUANrtcdj7I3PadH1kbLLCzlVsTfCTJ1fRm7D04BHIgFx6skqM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaN6bgFlE5n4zWZh1ysiYETWDjGl8r0Auyz8PCLIWTNA&oe=6AFB163F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRET", "keywords": ["exposicion", "relajacion", "bienestar", "inmersion"], "long_description": "VRET es una aplicaci\u00f3n de realidad virtual que recrea entornos inmersivos y realistas para practicar ejercicios de relajaci\u00f3n, concentraci\u00f3n y afrontamiento personal a tu propio ritmo.\n\nLa aplicaci\u00f3n ofrece escenarios virtuales variados en los que puedes exponerte de forma gradual y controlada a distintas situaciones, ayud\u00e1ndote a sentirte m\u00e1s c\u00f3modo y seguro en ellas. Cada experiencia est\u00e1 dise\u00f1ada para que avances paso a paso, eligiendo el nivel y la intensidad que prefieras.\n\nAdem\u00e1s, VRET incluye un sistema de seguimiento que te permite revisar tu progreso a lo largo de las sesiones, observar tu evoluci\u00f3n y mantener la motivaci\u00f3n.\n\nVRET es una herramienta de bienestar general y pr\u00e1ctica personal. No es un dispositivo m\u00e9dico ni sustituye la orientaci\u00f3n de un profesional cualificado.", "short_description": "VRET es una aplicaci\u00f3n de realidad virtual que ofrece entornos inmersivos y graduales para practicar ejercicios de relajaci\u00f3n y afrontamiento personal. Los usuarios pueden explorar escenarios controlados a su propio ritmo y revisar su progreso a lo largo de las sesiones, como apoyo a su bienestar general."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vret.es/legal", "developer_terms_of_service_url": null, "publisher_name": "Vret", "support_website_url": null, "website_url": "https://vret.es/terminos", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1217836388080367"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2262333204308285"}, {"status": "PUBLISHED", "id": "1658094418782446"}]}, "baseline_offer": {"id": "226233320
64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoJa8YW_XZEQ7kNvwFbsBUa&_nc_oc=Adr-izUSq9LDCOA42l91TQaRHp-UC6CIm0Dot4XCCIPN70rG2oG2is5Zfm6AFZXHj0g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88wDJGVHLVR6zPpARWBA800ak0kQ-tiVA66IP_ZZzv4A&oe=6A2AAB40"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZJbgsIl19AQ7kNvwFzj1pC&_nc_oc=Adr1ZrAonBCieGa0FJ1NcadxjNiwiXiLUeKPHaI_wmDziAsMq3fsK3OfDDc-ZwpMRRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_as1i5aQaCUISdXbG63JE94UeNGUc_AUcY4hOCy8WpSg&oe=6A2AAB55"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtPMfIf9DNoQ7kNvwEBicBV&_nc_oc=AdoVlE6hTSmeqYixc_tYbffZfcPRfb8i_zIC0nHu8UYapPworwbl4ZkX_9s08-MRQu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xAYbusUCtnpIfuHYaxF6dplAPhIRML5BQjfSP6Pjxww&oe=6A2AB7D9"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1Z9iKIGZPEQ7kNvwGohTYS&_nc_oc=AdowJfU3oHT8-5PuF3uOPLRlF8gjyg-GpzmDRjdfA1LSZxfJ2XRApncviExpVVD6HZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HW8QGultIEO2xOo_dRaAD1eFDaOebNbAhU7v9LCnpew&oe=6A2ABFC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6xYpmZWn6kQ7kNvwFsP51W&_nc_oc=AdqSmQj48Z8vdvL3UOP48aL1eCv1qwZui7yKRi4b5uNJ4val1z_cpuF6YEFkfTLA2wo&_nc_zt=3&_nc_ht=scontent-s
64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KfNSQKxCoYQ7kNvwE_XoRZ&_nc_oc=Ados2RQ9q_9TSeVEUEFHJfZpzMB2vj7hLvZFYTTH3RCH341VFm3l8NmmG36iqHdfN2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsiLn-wzYEgEMk39rwpjlpbFk2ZCwZzre5aFTLfgQW_A&oe=6AC3D180"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YV0OJ6KO-MQ7kNvwFfZdg5&_nc_oc=AdpeuVEyM2hIn1E_cjSCr0-IUw2BMnLs5ug1k3FYCdYxej6kOTquRoH7qy1D1OVqfV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ83U-CH8bNdCrQtLD03hxgsxvKLBfxi-ncyXLdxQiBw&oe=6AC3D195"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta4le50qweQQ7kNvwHqhaXK&_nc_oc=Adr5EY4OFOL3Or0jSDTQIy6WbfhdXiYFZvkU7DZfC3XYBxAqse4l-Ul_VolvOUZAizE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC7OSgB4YeO9CYyrOYJWIkCFvLbooawrO4lsq_glUvag&oe=6AC3A5D9"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyzSddiD5QMQ7kNvwE_zi10&_nc_oc=AdrGtFCpnkKUgGEtLrwYSW9Wn-rP9pOp60B4NRqHapD43a7d3G4OAQMul6u1Pf-6yFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8LYBPSLR3IQlSLc8mI9x6Loj8LSFIMZuBzPEB_VXgGA&oe=6AC3ADC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZNWZl7d2r0Q7kNvwFc6tSG&_nc_oc=AdpMiDWYZ3wauuj0eFciue42_gBghyf1Q8EzN3NecQDBe8pnFW6dLJNn9O6a8eFRFCI&_nc_zt=3&_nc_ht=scontent-i
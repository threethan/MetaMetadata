64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EudMaOBR0wYQ7kNvwEK7ERQ&_nc_oc=AdqqDHW17bgwOiQGjb7MQxOLiqVglgijmsecv05Qw-CoQUfirXTeK9kMv3dQLH75Ywg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_LsS3Q13t5GKaouTe8_ABZZVebypeX-L_1TJ60nsABQ&oe=6AA69840"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjgyRrO0LUUQ7kNvwEMX3zi&_nc_oc=AdquTFz5Dr-ba-dXoBjEgFYx-PrnwuCLmj2NqYws7wF5ivrciAcC06j0CQDcCifVYhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Y1jAyoEswyGWSU0-OM4XnjmSNdGfdz3cQqiLeqGHjA&oe=6AA69855"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uagd8l1fJtQQ7kNvwHU6Cuc&_nc_oc=Adp0RZ8XxmCcm9VSFJtZGdMh277YmyiUZt-Xt54CybH9aSL6eFPXwJQpZNYcSblZH3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGTVyUpSmZ2F2Bgatqbz9ORqZoRKpy8DvcTJ7v59yL2g&oe=6AA6A4D9"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owVSGUwMfC0Q7kNvwEtq0Nt&_nc_oc=AdpulhOHkSf4n_-dT4I6EJPVKXeooR-GKXVPJ2azRhE_v0r_l-Zr5_0TjzcNa0GsnQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjoHJD23zkCnfHxaAnOl3iQ8LDSIBw-t7U6y1wnASvQw&oe=6AA6ACC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By9mzKM_H24Q7kNvwFZoKZe&_nc_oc=AdokGWWEJDfEAAr4kEdNglL1AcBaqzy2EpioMMqd_0PwUK-2WOw30epIOlC5OISNRfM&_nc_zt=3&_nc_ht=scontent-o
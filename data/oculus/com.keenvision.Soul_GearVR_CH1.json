64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtKwMr9hWIsQ7kNvwHClfsV&_nc_oc=Adq6gQhovb5fu007KTbVP-27TWejvqtbaaRDv0Vu72A5BOoufFIy9xcHIhI7K5-tuCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eTK9LxO0JjVAxYuAQplhqdmEoYA7EIulTYG-lCOdYtQ&oe=6A426640"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBoKJmERaZsQ7kNvwF9Chfg&_nc_oc=Adp5l5_81LWsf2Trc7jSXrjQYH8G50vfja6egMiu3bwc7rmXDoUMe3C96IZdWTb3WCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jdP_URg7BqGk1ATBbzRker5jWxbSPMI9Mji438SNb6Q&oe=6A426655"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFrPOV_fEKgQ7kNvwFM0Nv8&_nc_oc=AdqzRSE8KBAbZUCoxRbjC7SfvxUd7Vhfv9lLKwQP7qR9OsNcSF7u1L8nv-qTzdcMIVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bUs8HpnKk_2TlXYuP62Ca5qp3NBPCsOsPoGHmxJmaEw&oe=6A4272D9"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LYQ1PX-Q3UQ7kNvwFUjzeV&_nc_oc=AdpxQFxGK2GGRHyKJU0ObJcFO5YA_LZDqn3amEiuOjQrkIRy6f1PHRSvQ_uVtq382bI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E61V1dv9cRMTDgRMvwNTVvuejat-uslY6lw1D0mepCQ&oe=6A427AC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMoX_G9Gr4oQ7kNvwGFibyi&_nc_oc=AdomcsRw5KRUDfAcrg4mdWUZTmgqqCDtvFlsSBapiq7HX506EyDoknuq_fSlUffs7_Y&_nc_zt=3&_nc_ht=scontent-s
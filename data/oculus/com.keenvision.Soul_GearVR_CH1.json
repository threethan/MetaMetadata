in2-2.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEvbCKj6VkwQ7kNvwHwPOsH&_nc_oc=AdqXlUEtrRpu6D-h9vhIQJQsvzN6s37CtugQK4JgIScUJ0fwzTiFUcpIGW6rMw8NfpA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwdH5-Hq6_36T8dOwW7RL92YrYMZ-2M4v1yriaKgbUmg&oe=6AAE95C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
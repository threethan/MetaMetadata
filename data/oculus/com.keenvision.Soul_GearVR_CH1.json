64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsplZ8SyKW8Q7kNvwGwc1Oy&_nc_oc=AdpTVjM9-lSQUZ85cfHPIlS1esZ-yaZg0I8D9i6_ivagMNpXDm1haU0eunFSErH0jw0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt5-5uG7WI1OLcfHwQEvlYRP_KCn3Hg6-B6W5T-sfcKg&oe=6A6C9640"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9K8HKk1JhAQ7kNvwEWKV2W&_nc_oc=Adq21r-Mh-fXtlCNI3YjFQBq7riWGIcmnY2GmOmes8qPqCLxnZEVsTp8sXc7VIr6Y6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK16weVT7jo2r_Qf3JzAVHwOHayw-6ACZftMjvuVKZSA&oe=6A6C9655"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL68KU9zpfwQ7kNvwFBL4eZ&_nc_oc=Adp-0XUnT42pQDveY-c38DA0fl4TB3K1Y6Styxi3dpg5fY1Sgxk7mmr8DzvbGeXdRBE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9U-TcJHdMvtaQXhtUsclA6uMLuo3liRVRqE3jMEYOCg&oe=6A6CA2D9"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHk_gUrnJ8UQ7kNvwHo3e-X&_nc_oc=AdosMjhN_hkhYeAW2vRhQtOA0dWdOKKDcR-wp31JyNJ4dH-wQIMYORbXi_093PeVIqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkCg9B31WrTSpbhkdtpYTc1x-OVRdI6qVB0KbGeUPWDQ&oe=6A6CAAC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEkBPaUpRrYQ7kNvwGZpjqa&_nc_oc=Adrs5-GxIHsPj26olmYwY_kHT3YRuzyucuaLmZGd9SQ4RwjjqqRipgUMcOIKrKIRcdY&_nc_zt=3&_nc_ht=scontent-s
64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0N2Ybyvp4MQ7kNvwEA5Szi&_nc_oc=AdrcIIhENDc-Oqv5N31qCUlW5hzxzEBHANFzvbDPuWk15xgfg5UDe3jQH5QY0vJ_p0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFruMJdqBfi1k0nzDERmcv0w0BZAY3wo-Jc_TPQ_i0VvA&oe=6A82FFC0"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtJ_lU19M8QQ7kNvwFdSBLV&_nc_oc=AdquNS_mMT1KOjYEBw3_2mRouuxp8lP81GpKsX0dvLnkBLrN0q8U0p_yi6gWi9lT1ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPfwoQGDfszuLhTrjnftF-AWjHlaaequh7UHPapYhybQ&oe=6A82FFD5"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KzKeFSOILIQ7kNvwE2TU1n&_nc_oc=AdphHAVzJ_sq0PZMRxrXhja0ekoYjXURR6tHKRExfarb2kIM7vGR51q96dRDYnBouGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQd6ExnnEVKsVfGTczr4bfgXu6-jM6EX7uw1LVDaGj2Q&oe=6A830C59"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mafo5UcAd8Q7kNvwF636Y2&_nc_oc=AdpzQN_20u2Barp_KbxIJDLFonN25RShM7wZZ1E6J4oYnbkrelGF89PxXU18A6sOOC8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO7kqePlhgQl7vJ-6YTBiVMDSrj7MzWxmqvFSVSSERfw&oe=6A831445"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADRXuEqhDR4Q7kNvwF6iqzP&_nc_oc=Adquk2XjlqrQncnyQpRu_fMj410GziXzQLcfo9JZX_vTsPCA44AzW2Gwv6s6iOhTRVc&_nc_zt=3&_nc_ht=scontent-s
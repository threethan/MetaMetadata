64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5mvbig-5IIQ7kNvwG801MD&_nc_oc=AdrmtLzZLfRTNdk2XFn7F7xoNlHW9ga5w5-ul7zUURrTG38cy18RoN7n3DnualrrQF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1VjQ0McdfaHq_GvDc00x5zqATSG4YIShH4vvBbmzzLg&oe=6AE48EC0"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppMnrPGRzCsQ7kNvwHtSLUh&_nc_oc=AdplBrPjbY0sjIvzhW9vbnpwIou3yY0dz4H1OAAEKmXCcGr0rPZmkcm749vPZrSEiLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_okGQZjo75xEc6N0HRWEe_rOyM1aqz9oDIEngX_eJPQ&oe=6AE48ED5"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJ_ynlXZZYUQ7kNvwERgiUd&_nc_oc=AdoKBfn7JtIb0XfweP6SaqpJxpmpyT_Veas1VmJElClbeua2lvY_3-k8XqMv4MOcE8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSkN_LSbhrXg0qD25LYL9-cvOfJF9orFeXSGwNYgTb4Q&oe=6AE49B59"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHOAdj2WIXcQ7kNvwG1V656&_nc_oc=AdrjHW_enjl5R5gXG1B7yVjmDSz7K3S_qaneLBXzNaogxBNU4epVxWNmRWLC0lXnk4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqRZ3uhIGRQSIfg1clJKTejOWc3Wnd_7boznIHQnwXKQ&oe=6AE4A345"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbfEaETqi14Q7kNvwFW0yMl&_nc_oc=AdqE4RF3-eGctE7U9v5RPqAV9XxGsDKc871VU2YI8so9D9SmDxG6cCE0G2lTKf5LFeM&_nc_zt=3&_nc_ht=scontent-i
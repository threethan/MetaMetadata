64.5771-25/11162680_347388639012114_2232435197716987904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcwoTE47cO8Q7kNvwE30Hfh&_nc_oc=AdpThCliL02Nr4Jq4cOQQzKlfn5OhluFfmbEb4cVET7YWalf4LkT-lrhv-Ynj44HoY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVleFCnlM8sbLT_Z3_R3SWXlqiSf-1lxmJAGmVKosFfw&oe=6A675040"}, {"file_name": "migrated_image.png", "id": "240113557034191", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162679_335980066835486_4110072703413649408_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F0yQT2p8wwQ7kNvwHBSOph&_nc_oc=AdoLLxuNzngQIsXevpfzhKf8N3b1iCX4l3XztYiCZRV9_pqrMGZLbbkQ_YZTygyMEuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7nZJsM9ag1ZQfQcqjFDNAT8GPLxVLWw2-MG8vY0kb3w&oe=6A675055"}, {"file_name": "migrated_image.png", "id": "208174097195977", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_732824270237578_7171874392454987776_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj_vxBovigkQ7kNvwEjYIHe&_nc_oc=AdocW4LtNnWQTYRbHutoKdG3lZHVhBKCLNLKvlbz19bqC18DkTdfqmVqfPq-ZCpQW0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2fM-KbXphk-X_uFbhnAqbCJQqj4ob7Yr9EyNoTU2Adg&oe=6A675CD9"}, {"file_name": "migrated_image.png", "id": "2396768680615855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162708_446649005711961_309696455193395200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNYkyowU_wEQ7kNvwFOzoD2&_nc_oc=AdpIAw-_4I3BVrOLaE0w6uxJBXHgsCvZnd05rvsvEig2vRIunuyNxNONGybaSyfwX1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxDa26RB09Qo0b1NJc9q46xzAgqsdhPeZUPJVavFe93Q&oe=6A6764C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soul Dimension", "keywords": ["Soul", "Dimension", "puzzle", "horror", "thriller"], "long_description": "The Soul series game will be six episodes. The player will act as Frank, who has the ability to go across the dream. Frank will rescue deceased daughter Daisy, who was stuck in the dream. In the game, Frank will go through a series of exploration, interaction, collection, fighting and other things. When he is about to rescue Daisy, Frank is stuck in a new large conspiracy. With the game series go further, Frank will face his deceased daughter, wife, and monster. The player will experience the unprecedented thrilling VR game adventure.", "short_description": "The Soul series game is the Keen Vision\u2019s flagship game. Through the designing art, the \u2018Soul\u2019 puzzle game will empower players to enter the thrilling adventure. The adventure will be the mixture of \u2018suspenseful puzzle\u2019 and \u2018drama action game\u2019. Undoubtedly, the players will enjoy the superior interactive game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.keenvision.cn/", "developer_terms_of_service_url": "http://www.keenvision.cn/", "publisher_name": "Keen Vision Internet Technology, Ltd", "support_website_url": null, "website_url": "http://www.keenvision.cn/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "zh_CN", "zh_TW", "zh_HK"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256799533265082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162699_2029226760634280_3953784216516296704_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbBB8eIWPBYQ7kNvwHVgdOv&_nc_oc=AdrXcWqW-OxdGlCjvgvxmA-mBz4OBmLfLOwl8iWgcUqpvP8CwGezVRja4NF-O6sWx4k&_nc_zt=3&_nc_ht=scontent-i
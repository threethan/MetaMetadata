": [{"file_name": "02-hand-menu.png", "id": "1821564962213911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823790_1821564965547244_4567629960857259822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMDMnqUKmg0Q7kNvwH2uYbQ&_nc_oc=Adobi8b4cvZHrhY6P8ZzW8X3faNprCj3YjVxSk8CIXV3NfbGzF37uJgp1j_42fN8nmM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzau6nwWeUPUYY7_A8t3sDBVqMArVDZlfV_XGnqpGgDw&oe=6AF9CEAC"}, {"file_name": "05-ultrasound-3d.png", "id": "1466456718699522", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821704_1466456725366188_6164967628399136361_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-xe6dtHPoAQ7kNvwEsanZj&_nc_oc=AdpXtEIlL5wkd_hpHy_KlBhEofkzlXYrKC24sVXtxXsiM5ZnGh3a42ZbKzs-M9VNQKo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLpR6mDiAllmInymwtBYTOB0cXjtLotBMskD9aF8mCSQ&oe=6AF9C389"}, {"file_name": "04-ecg.png", "id": "902626792844796", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823949_902626796178129_7500749708105494999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCbhdBPtE2kQ7kNvwH3SrFU&_nc_oc=Adp1mqUrlqHI5CJTMVEtv2CycH_IkQKNH8vH7fM_o4vmWqyqbS-TwE7ZErC43W5E0d8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQst2NMkdFb3Z_pmqWFlAraCU6nEtyEYxHng7cu1mwLtQ&oe=6AF9CBC2"}, {"file_name": "06-thermal-camera.png", "id": "2303098130456926", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821796_2303098133790259_647567769579795875_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyEVESe4IpcQ7kNvwFM0mnC&_nc_oc=AdqO-aOEFbts9Q4oaoLzU5upni_DVrRo88cxtJ7ind7xuNDkNvT12bI_1r_UnvYvddQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrQr843Sa1A0EfH40tSoIirdfw_q9WDCmTFM5MmLiLcA&oe=6AF9B8AF"}, {"file_name": "08-spinal-fixation.png", "id": "1118288421124539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824665_1118288424457872_5608090198873152200_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqhhl1I5dvAQ7kNvwGvth-R&_nc_oc=Adp3sRYTPO9mQCHJLuJdjqbGb440wXI9hP8g9EUx__VtKeMZ67wVC5xJmRTVf4TXYd8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8jGI9WGJtFhmhCSNpw67uAc8NFL10y62GGbwz47nADg&oe=6AF9CD70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1gVVisqPpAQ7kNvwF_DoQ6&_nc_oc=AdqNEQLR55-qBKTuwQPP7M4IfwHVKj1QGo1YWhVs6CyVEo99W0ruV9OuGzKCWrPqGj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj0g4ILBzXW2QVmeRatebFy722Ox-ZFDV6M4AleECTbQ&oe=6AF9C0AE"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm.\n\nSENSORS: how each signal is made, then live: ECG, EEG, a pulse oximeter, a thermal breathing camera, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMAGING: X-ray (implants show as metal), CT, MRI, PET-CT and DEXA bone density - each scanner at real size round the body, its picture computed from the atlas's own tissues.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history and alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head. Signals, scans and devices are simulated for teaching; scans show no disease. Adult male model; no inner or middle ear.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors and scanners read it - ECG, EEG, pulse oximetry, ultrasound, X-ray, CT, MRI, PET-CT and DEXA - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428779980318021"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828028_14120
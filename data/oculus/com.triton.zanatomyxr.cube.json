/v/t64.5771-25/491828028_1412005320916223_2885471269118461196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hoMQhiqdrgQ7kNvwFu39zT&_nc_oc=Adr-p59zo8XYYciGpN2MpvCgv7LHnCsJ1SmV7qL5G5E9Sds_lg8evxaif1WN4Ig_9f4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq8l5xEjVFPJteCI5bLW9r_QtstBczBlDmP_ZlZoH6Iw&oe=6AF8818A"}]}, "id": "2061830164498397", "locale": "en_US", "screenshots": [{"file_name": "3-seeing-eye.png", "id": "2342822843133894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_2342822846467227_8446167111981807008_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPqraDXUaOQQ7kNvwGDvIgz&_nc_oc=AdpoKGH7uJuIKHlVxooZ5aamr3vDKnnAxNCMmpjymdCYMOQPolxsGfqZNiaG_hCSj90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiw4c3nwo15WlhNLCx_POkxm83EDfgMm4dHEda6svzxQ&oe=6AF8862B"}, {"file_name": "4-breathing.png", "id": "1098117569656065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1098117572989398_3569065438998971753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I67Mug4qvywQ7kNvwGBWSf6&_nc_oc=Adpl4VSF1GC1R0PZTC_VTrDev_pzQyQMj2HuXmG_UImzHUs4ORhjBTlZpwPTAsf1XRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCwjQcKo72GWiNdyAjJJEnT5So4kSoKRCOPAzfeSxGLA&oe=6AF8A4DA"}, {"file_name": "5-arm-muscle.png", "id": "3073099216361105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_3073099219694438_717288193810178856_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GflZUvUc7EQ7kNvwElVqOP&_nc_oc=AdoJ9lchJrpJ3R-s-QIKFR3_56aZAOftD_k8CWB2SeRquUMDWgXLF8U6x9228F_cbTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBlYppM4jhjG4UaC44kwwrBxhozCNgz4_h_VpsYv-5VA&oe=6AF88DC0"}, {"file_name": "2-heart-close.png", "id": "1133964476169705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_1133964489503037_5171123759215771754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuY3wI4R1KkQ7kNvwGVmECe&_nc_oc=AdqcppwYROQkdyH1SrQbaPvW0oh25N5X0zCdaFKQAo83SVQEW5uh3oz7ANQc0Emy2LY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnUJ1rONWfVUojY74cEyvChxnsKKzNe_FeREPJ__eENw&oe=6AF8808C"}, {"file_name": "1-heartbeat-lungs.png", "id": "1079259535160302", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1079259541826968_5952060383222830183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQlBkXfleQMQ7kNvwHCmWxQ&_nc_oc=AdpD9CZMhCvMY0wnnuLBufi8qwUYAF2X-nGN1H_fgQyNz9QIpPMr1UeneCPmR4-tORg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyhCJ7lJ0NdtFZLfeJj3no7s46Mdg0QGsxOkeZjuq6tQ&oe=6AF88B5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1gVVisqPpAQ7kNvwGRv8-y&_nc_oc=AdpNrQjlRW0EmeVcPo3c7LqoYoNbVBO8mDp7tyLtb-QHO5zVHK8NW8lrsnKCX1pQneg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4UYxCEejNfoxRemmFV1HRkcjc15SOaw0VRS24Fkps0w&oe=6AF8A76E"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, drawing styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm and what a stroke does.\n\nSENSORS: how each signal is made, from the body to the screen, then live: ECG leads, EEG rhythms, a pulse oximeter on the fingertip, a thermal camera reading breath at the nostrils, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history, materials and the non-metal alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, coronary stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head, larger with fewer tissues. Signals and devices are simulated for teaching. Adult male model; the inner and middle ear are not included.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.\n", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors read it - ECG, EEG, pulse oximetry, a thermal breathing camera, ultrasound - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
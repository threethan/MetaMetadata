_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ8aigt5LCIQ7kNvwFEc--t&_nc_oc=Adp2lttEjhVOOWe62udE6IYht-s26ngyvsd0WmsArcYDQmInLZyGH8AXytn9VXBvlLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMpWztAI3YEzikklsXnU5Arkjc7uAi02L2PA3zN8Buhw&oe=6B030D8A"}]}, "id": "2061830164498397", "locale": "en_US", "screenshots": [{"file_name": "3-seeing-eye.png", "id": "2342822843133894", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828050_2342822846467227_8446167111981807008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4Ke56I0KiQQ7kNvwH_IpR7&_nc_oc=AdoPo0UEDQqYyXHHLPUnoXQtDQgyoEcC4obbRhOKTYJ4hffiuw2MeEtE12EZsdy8h30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-RstnnY7BCCl4SXU__P2TYC8NiXqjmufunPEaoZSAhQ&oe=6B03122B"}, {"file_name": "4-breathing.png", "id": "1098117569656065", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_1098117572989398_3569065438998971753_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prbqmfH6IKEQ7kNvwEt5M7h&_nc_oc=AdqqH8j698JOjbnIVP5C_euLS73BD0wL_6fwt6k-x2eU9shU8cZ637NQ10UPoJ3EflE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuN9ZPhsemj_PMFhK_QFJtGUsBp2F2QjpQ1TeM5Jpbjw&oe=6B0330DA"}, {"file_name": "5-arm-muscle.png", "id": "3073099216361105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_3073099219694438_717288193810178856_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tpGesf40jAQ7kNvwEF98iV&_nc_oc=AdqtRwTCKhgcDEG9Pz-1tznsiYKBjB6YteUjIHGaq9eJOBbO5hbZnu4Y5bfW8zPghgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnlZPnWuaE12QbMj1YioguMueGnc-Eyxrnu682nTUV5Q&oe=6B0319C0"}, {"file_name": "2-heart-close.png", "id": "1133964476169705", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825546_1133964489503037_5171123759215771754_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0l_gSEnXxTgQ7kNvwFCUbVo&_nc_oc=AdpsA0D6S4aPUD1pMAS6zmrzZEvMWL3BzJ7hOWGhKnKGcFGLZCjKmxX9pUpMfhyY3hk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS418-HGvZfi8FGaJhKKWcbTsAVVvhpqGevXPNYcgV6pw&oe=6B030C8C"}, {"file_name": "1-heartbeat-lungs.png", "id": "1079259535160302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_1079259541826968_5952060383222830183_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twZpgBH7PDMQ7kNvwFSEgDu&_nc_oc=AdqW_mZQL-CZ2-5KVIcN_MMPSGY2yH8BOKwt5luD9nUMidAlQidnxrGmbhe5iohEgXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIbsoOy5_go0MOfVLz3AuT1CoNMzczvrgj5Mw_lhtLJw&oe=6B03175A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkxMsBF54iAQ7kNvwGrl2fF&_nc_oc=AdrO8Qs9iWNXjbGU0ER_8B2l3EJIBOo7QHoK0mKiSNqZaEeCjQRQxJoYlbQ-3tZCPa4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeW2R6d5kMIBMq9UeISVdcaVGLu3Z5zdWOJLM3hW0CoA&oe=6B03336E"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, drawing styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm and what a stroke does.\n\nSENSORS: how each signal is made, from the body to the screen, then live: ECG leads, EEG rhythms, a pulse oximeter on the fingertip, a thermal camera reading breath at the nostrils, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history, materials and the non-metal alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, coronary stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head, larger with fewer tissues. Signals and devices are simulated for teaching. Adult male model; the inner and middle ear are not included.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.\n", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors read it - ECG, EEG, pulse oximetry, a thermal breathing camera, ultrasound - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommen
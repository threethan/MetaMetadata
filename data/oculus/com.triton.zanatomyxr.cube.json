_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDMwV-3HThsQ7kNvwFnJsla&_nc_oc=Adq4XCS8cqzZHzKbFjbEEFUaLxFH_AfbtsRMU0Nx7TePamZRilKTLjZmGoD9rDipSBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa-WrOl3KnzTMCP3uXmIUw9UONPjH0vA_CYisaiBnsqQ&oe=6B006A8A"}]}, "id": "2061830164498397", "locale": "en_US", "screenshots": [{"file_name": "3-seeing-eye.png", "id": "2342822843133894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828050_2342822846467227_8446167111981807008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ycCS9S9KBIQ7kNvwGRxRyi&_nc_oc=AdoN0rc474BzUF0DkriMilHBfQIGrvdzbT66hD7MHs4FCez5yBMsYuE-i4FnPbi5S5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOprlWbaymnqfKE0yQiRoorP6TzE-ugbHUafDSRcGzLw&oe=6B006F2B"}, {"file_name": "4-breathing.png", "id": "1098117569656065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825462_1098117572989398_3569065438998971753_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prbqmfH6IKEQ7kNvwF9OLsZ&_nc_oc=AdpDI0XHClyw31mW-b1A0CF08qWsMmPUTYufFnSAxk5CVF0t0Fy3m64r5ElDNYvdzSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQWG5p1bZvj-A5zlnVw-K-rILeFzShvC8Ex7VIOWHbyw&oe=6B00559A"}, {"file_name": "5-arm-muscle.png", "id": "3073099216361105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_3073099219694438_717288193810178856_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n81NaWh0tPAQ7kNvwHEZT9H&_nc_oc=AdqYFPylEdppodLOPF9R91OrAhw-nRBY73GcL6gU2SbHs9UBlLIxXuvAUTUh6ONUbNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCVSx3lZKNNqW-QFsxwYyA6AP6HFuONrbQPp3DrKjohQ&oe=6B0076C0"}, {"file_name": "2-heart-close.png", "id": "1133964476169705", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825546_1133964489503037_5171123759215771754_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd1yibHlPusQ7kNvwHjhMuX&_nc_oc=AdobVBEIAEGyIKhT4tSicP236o1IN2nNhFl3ZcgtVfGl4CQrZRUeE0m5zY6gRHS22j8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNCoG2H5M1N9cT3XBKhnLxXYSOJFk4uZjb7l4P5fdcdw&oe=6B00698C"}, {"file_name": "1-heartbeat-lungs.png", "id": "1079259535160302", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1079259541826968_5952060383222830183_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twZpgBH7PDMQ7kNvwF4BBxi&_nc_oc=Adqpaz6CyzGhVscfBrNNCPiaknoDCAh5fh1FvoC0KRFs2foy2p7p5TjQlQ-CQRuyw1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQejDP70X1EIvYjyQDKWSW_ga4CsM4aZ3JQ68CTVBEU_Q&oe=6B00745A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkxMsBF54iAQ7kNvwF0S7YZ&_nc_oc=AdpuwXYcuz4ZR_k8HozTggCnvkD7smBX1TfJXuZ5zCJ2hM3Byi7a9x_adfF4K4aYLsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkKqIrc8DcPNFWsA6isDi9enjj7E0Zr0otq-V4GOr41Q&oe=6B00582E"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, drawing styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm and what a stroke does.\n\nSENSORS: how each signal is made, from the body to the screen, then live: ECG leads, EEG rhythms, a pulse oximeter on the fingertip, a thermal camera reading breath at the nostrils, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history, materials and the non-metal alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, coronary stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head, larger with fewer tissues. Signals and devices are simulated for teaching. Adult male model; the inner and middle ear are not included.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.\n", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors read it - ECG, EEG, pulse oximetry, a thermal breathing camera, ultrasound - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommen
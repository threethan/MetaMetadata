_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDMwV-3HThsQ7kNvwESWTn-&_nc_oc=AdqkDYktsE3q5AuntFib2g0SjT2xLAaXvIO_bcMrk1xXiII2r8DlY0czxfYtaL7tK60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkqcvrU9ZoPIAvec5pecQd_-hdRGw79hblVinkZSpWqg&oe=6B01BC0A"}]}, "id": "2061830164498397", "locale": "en_US", "screenshots": [{"file_name": "3-seeing-eye.png", "id": "2342822843133894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828050_2342822846467227_8446167111981807008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ycCS9S9KBIQ7kNvwEyAqkw&_nc_oc=Adp9l2oudyo1dCRU4zwuAJdTG8LG2V957mX6V4Mb6j4tp4hCXnsiQy_qbNNPeFFLNlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6a15XpaswxzDyi7WV8gJlx5MCg5pHgQZsIyrtI-eLIA&oe=6B01C0AB"}, {"file_name": "4-breathing.png", "id": "1098117569656065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825462_1098117572989398_3569065438998971753_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prbqmfH6IKEQ7kNvwGuZqq1&_nc_oc=AdqRCSwIjRfe0TSsINx3U-wpLnk8oo0uFaLrSHTo4XvQZb1I8C1t-RncVqVD7S7ofdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTttNfgfIYGpblmaDlYOu9mizlrrcvdTv2rf1B2HN_THw&oe=6B01DF5A"}, {"file_name": "5-arm-muscle.png", "id": "3073099216361105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_3073099219694438_717288193810178856_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n81NaWh0tPAQ7kNvwF3NIaa&_nc_oc=AdrFZ_LhMqGVfvRW40n9WphXAH6uz_mta5hqJ_rRCVHcW5HqieN5nakYfuLC--DXfFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKpwNbCMloupO9AoMRcIN3DpRZUD1F4b00zX_M7XY9Yw&oe=6B01C840"}, {"file_name": "2-heart-close.png", "id": "1133964476169705", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825546_1133964489503037_5171123759215771754_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd1yibHlPusQ7kNvwETB3l6&_nc_oc=AdrZdBdS8h-Ft7Y0sHaDhr6Bar7LzGWf4fky9Ff86lAEvbRsk0K3KPehuJ_wIdolEfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk1WTUGlS7qJeV76-2rTELZFdPnLC69ALfjfohkwj80w&oe=6B01BB0C"}, {"file_name": "1-heartbeat-lungs.png", "id": "1079259535160302", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1079259541826968_5952060383222830183_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twZpgBH7PDMQ7kNvwHVFaW1&_nc_oc=AdrMe3Q0fd1oazC8YclZ1BpKV99BitQvnpvBlD1yd11jVbaqRarTPjzIyIrK9lleUUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHXU64HYE5PGJmQNrCmVJ4Iz6FMF7dUaEJsF5im5I5YQ&oe=6B01C5DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkxMsBF54iAQ7kNvwE71vdv&_nc_oc=AdopacYAw0R2St9a2Bll52v-vSso50NKqx6NqmvMFqMkdoVWyMol7G04Uq3MJJxkWzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhDO4ymRJnpdFsvtveOKLREXzQHz74i9lIQ6jkt27nsA&oe=6B01E1EE"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, drawing styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm and what a stroke does.\n\nSENSORS: how each signal is made, from the body to the screen, then live: ECG leads, EEG rhythms, a pulse oximeter on the fingertip, a thermal camera reading breath at the nostrils, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history, materials and the non-metal alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, coronary stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head, larger with fewer tissues. Signals and devices are simulated for teaching. Adult male model; the inner and middle ear are not included.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.\n", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors read it - ECG, EEG, pulse oximetry, a thermal breathing camera, ultrasound - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommen
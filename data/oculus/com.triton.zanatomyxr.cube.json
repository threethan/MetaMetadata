content-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc20tgKtNNCgwmnaokwxedGY9TMQuePuNuiOZQFlFisA&oe=6AFB426F"}, {"file_name": "08-spinal-fixation.png", "id": "1118288421124539", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824665_1118288424457872_5608090198873152200_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyuh83Tg47IQ7kNvwG5kwLn&_nc_oc=AdqS8vRxln9WguGNsa5Mtij5jXvDCkgA4rFOArvVYsSasKDGbiz_5bTW9b5xQFUsu1g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM0RLQi3lgcHjC01LU4qyIvnKyGPa5CJyyAZf0ZvLBpA&oe=6AFB1EF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1gVVisqPpAQ7kNvwEYkYT1&_nc_oc=AdrmsCHtma4ZlUjQodMFGXT9pir_-e4dRsOZJBNm8X8g4y2OCoGg1iwoOpVbXVhZaVk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV1Qv03DNMr-TEpdEW75cHMBaJ4Y3L9LBVlH4Acer7iA&oe=6AFB4A6E"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm.\n\nSENSORS: how each signal is made, then live: ECG, EEG, a pulse oximeter, a thermal breathing camera, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMAGING: X-ray (implants show as metal), CT, MRI, PET-CT and DEXA bone density - each scanner at real size round the body, its picture computed from the atlas's own tissues.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history and alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head. Signals, scans and devices are simulated for teaching; scans show no disease. Adult male model; no inner or middle ear.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors and scanners read it - ECG, EEG, pulse oximetry, ultrasound, X-ray, CT, MRI, PET-CT and DEXA - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
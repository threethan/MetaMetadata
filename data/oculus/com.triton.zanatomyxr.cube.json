7r5xzw&oe=6AF9D7AB"}, {"file_name": "4-breathing.png", "id": "1098117569656065", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825462_1098117572989398_3569065438998971753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I67Mug4qvywQ7kNvwF0JJfX&_nc_oc=Ado2x3rYqvVETx8KaPx5i3kgzBCspsru9PGJVlfcDBR1b2ShSgGD3K2T9It5_G20dZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU2B870tr0D1fdQXIivF8xKAUm3e8XSMW-5G9j6F97Og&oe=6AF9BE1A"}, {"file_name": "5-arm-muscle.png", "id": "3073099216361105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825415_3073099219694438_717288193810178856_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GflZUvUc7EQ7kNvwHjUF8r&_nc_oc=Adoh4SSAhkkmxGvtQ71yGldrzAPPy1DfDdlQdmsb269aBaDr450Krsn-AUkt-zc-r-8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Hstc_YtgSXNRfB-Wk4F6Ynls6ztosrQ6rbwRYVvXhw&oe=6AF9DF40"}, {"file_name": "2-heart-close.png", "id": "1133964476169705", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825546_1133964489503037_5171123759215771754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuY3wI4R1KkQ7kNvwHP2m1y&_nc_oc=AdqbjMd9VCar1d84Tr1nW-0m4Q0EwNkxnxSTx9ItPRR4bgFwPcS2LMnNp9LGzlKG4uM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScoMl1FFciajmnDVzCZ-CX1M5MYJ7DHOBfrjjkKK6ROA&oe=6AF9D20C"}, {"file_name": "1-heartbeat-lungs.png", "id": "1079259535160302", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_1079259541826968_5952060383222830183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQlBkXfleQMQ7kNvwEe5czb&_nc_oc=Adpx9dyy9Wi2PBlv1ASD7yDpdRGuvYV3vSHGA0cqsNRQqCqD_AeRGX6W1v2Q34PZnE0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZSymL8_D9s4cmOJKhXJ2NAB4jUdDizVcYj8GCQgeN2Q&oe=6AF9DCDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1gVVisqPpAQ7kNvwF_DoQ6&_nc_oc=AdqNEQLR55-qBKTuwQPP7M4IfwHVKj1QGo1YWhVs6CyVEo99W0ruV9OuGzKCWrPqGj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj0g4ILBzXW2QVmeRatebFy722Ox-ZFDV6M4AleECTbQ&oe=6AF9C0AE"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, drawing styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm and what a stroke does.\n\nSENSORS: how each signal is made, from the body to the screen, then live: ECG leads, EEG rhythms, a pulse oximeter on the fingertip, a thermal camera reading breath at the nostrils, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history, materials and the non-metal alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, coronary stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head, larger with fewer tissues. Signals and devices are simulated for teaching. Adult male model; the inner and middle ear are not included.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.\n", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors read it - ECG, EEG, pulse oximetry, a thermal breathing camera, ultrasound - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1413278355201517"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1727902849124476"}]}, "baseline_offer": {"id": "1727902849124476"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793986980, "status": "PUBLISHED", "id": "1727902849124476"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1429941813535171", "version": "0.2.50"}, "id": "1662819442013127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andro
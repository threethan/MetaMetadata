_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVLmWyGPlcEQ7kNvwFM5vFT&_nc_oc=Adq1EHrIyWlcTloM2b0_fOBGzOVSA2KYKRTSsOpfF3zEGM7KYoj_8bjyl08mACJ290w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3IB_6BXjUImg5kmhtaDy-2nkEWLjq5o4YJH4FgINxpQ&oe=6AFDC78A"}]}, "id": "2061830164498397", "locale": "en_US", "screenshots": [{"file_name": "3-seeing-eye.png", "id": "2342822843133894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_2342822846467227_8446167111981807008_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2Ypl9zoHxwQ7kNvwHEC0Jq&_nc_oc=Ado7110WiQBbz8mC3yBOl9nA_GtnffLjQzeTMeiXFKh6Tflf9tIRlf2VKbk7NBmSNCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9NIHlbrQK4sr7TnwBV5ZZbHcjJLQIPsX2v4ey-SXdsg&oe=6AFDCC2B"}, {"file_name": "4-breathing.png", "id": "1098117569656065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1098117572989398_3569065438998971753_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=043M0xDjG84Q7kNvwEqxo0E&_nc_oc=AdrqiWPRaV667Ae24LE0NlQALWhuXXrmZIG8Ihg_frF_HAEXbAdFEw6mSV_x06FBic8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm1TFBirxpXz7hWZyvuLJnJvOcZNLrHJpHB7viXzbx-Q&oe=6AFDB29A"}, {"file_name": "5-arm-muscle.png", "id": "3073099216361105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_3073099219694438_717288193810178856_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaVwT3qcH_0Q7kNvwGI8O2B&_nc_oc=AdroqkuhhEBb4wu_aTt19gspYvP-Rzl7tNKuprroj1YayRBJCjzWZ0nomdGLe2gFmaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIVnKQRZzsW1ijdNmysY9D8jgP5y_ospOaWpyff1tOHg&oe=6AFDD3C0"}, {"file_name": "2-heart-close.png", "id": "1133964476169705", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1133964489503037_5171123759215771754_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndSE9TUWcoEQ7kNvwEXjGuF&_nc_oc=Adr-ZCjuSMXMJ0ZBQDftUo5yI0LnXGCK0F-dIeSzUNi1CWabz9iL8fy0e838oVGKec4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQLN062w2d64iyXOcnhvMF3iCuBzzJ7ryaVCi1jCFVGQ&oe=6AFDC68C"}, {"file_name": "1-heartbeat-lungs.png", "id": "1079259535160302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1079259541826968_5952060383222830183_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_AcctPQOusQ7kNvwH97N9T&_nc_oc=Ado8CRuOdpussaFoug7MHydz9FUcHTcZum01mbV0iDi2nrraxj_XK5mtoOcPWKnkxBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4UIhk9yG5v5ImqpAga55O_YHjyjd8lmj5X9e5KCWZ8g&oe=6AFDD15A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCHjP2aCM_kQ7kNvwFSijWD&_nc_oc=AdoX-54Q2IzKsvgMgMlz6OmZLQED_lJUIOIMAB8FH6ZYrSsDRhP1BV6xXzCeTQUCZKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-TT2oVWWI2UD42E4qDCIyfaqmzMVLHjpyn8giY4TmSQ&oe=6AFDB52E"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, drawing styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm and what a stroke does.\n\nSENSORS: how each signal is made, from the body to the screen, then live: ECG leads, EEG rhythms, a pulse oximeter on the fingertip, a thermal camera reading breath at the nostrils, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history, materials and the non-metal alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, coronary stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head, larger with fewer tissues. Signals and devices are simulated for teaching. Adult male model; the inner and middle ear are not included.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.\n", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors read it - ECG, EEG, pulse oximetry, a thermal breathing camera, ultrasound - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommen
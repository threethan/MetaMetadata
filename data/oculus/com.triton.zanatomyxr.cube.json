00&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPqraDXUaOQQ7kNvwG0ShKq&_nc_oc=AdoxqsHJ9PoebLtBK3KY6wAuZ-1eQDxLUWHdqARsQWrEJQe6m_XxFIai4XMMvrfprYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF5eF_xpEAxPKeH08UL0uH2eKPu5i1E92dhTlI_xuayg&oe=6AF734AB"}, {"file_name": "4-breathing.png", "id": "1098117569656065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_1098117572989398_3569065438998971753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pr-2_P0B2YIQ7kNvwFcpr0S&_nc_oc=AdrbJr1I1Jc_1EAk24yu9WmzbGLNFmqXBNN_qyjICKAV_DxjvykuOcbKQI_8xYl13iU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5_o_wn34MzGTZJvmpQ4CNpqltgBKbGNyzPRrCSnAEPQ&oe=6AF71B1A"}, {"file_name": "5-arm-muscle.png", "id": "3073099216361105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_3073099219694438_717288193810178856_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GflZUvUc7EQ7kNvwEWNxCb&_nc_oc=AdoJcIou10z8LHDd3XHwghr3A3-M3ejwuJEsgkFIILUoKq2B8XzGKjggbRvGp0vPTic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAnk1erkRQuUPebW8RaWhNB6sXBXobzUPs5l3_uukZpw&oe=6AF73C40"}, {"file_name": "2-heart-close.png", "id": "1133964476169705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_1133964489503037_5171123759215771754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuY3wI4R1KkQ7kNvwExXJ1e&_nc_oc=AdpfPEkfGGoTUvmDTA3ghwL0ZcC57t9t8vvmHgYXc3_q6_LZvxXE2Z-1ck6OtVRGzKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7_J4vCOSLkvBcRuunrTrvfDmhX2yPFwdD8gzM8_PUGQ&oe=6AF72F0C"}, {"file_name": "1-heartbeat-lungs.png", "id": "1079259535160302", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1079259541826968_5952060383222830183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VWE2FKvmjcQ7kNvwE_l-Sx&_nc_oc=AdrsquH3CVbpCusKNGigngCpv_oBBN6MT1lKKOnOzPHm_AWGgo-k9TaNXiXqYbexCWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-aGi9LFRalA1wW3yTP7Xx8ymt7bEc_iLNRzKJhT4kzQ&oe=6AF739DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "3611590895670981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3611590899004314_3689080381546488398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqhroN3IcMoQ7kNvwEzlmLp&_nc_oc=Adr0OzfoB1EBTYiIN-e2_XHIN6MuI5sa1jwuGozuAYPIEaTcceOwIDyEeTU03FyZg2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs--Pi4-F79aE2gKfVbAQEuZXrOEKbDq1P5qurDJdrNA&oe=6AF71DAE"}, "display_name": "Anatomy Cube", "keywords": ["anatomy", "xr", "human", "atlas", "male"], "long_description": "Anatomy Cube puts a life-size human body in your room, in mixed reality, or in a gallery, under a night sky or at dusk.\n\nThe body is a light glass skeleton. Carry a lens through it: a box, sphere, octahedron, dodecahedron or slice shows the full-detail anatomy inside, from about 3,500 named structures. Choose the tissues, drawing styles and colours.\n\nHOW IT WORKS: narrated sequences on the real anatomy - the senses, the heartbeat, breathing, the blood's round trip, reflexes, swallowing, moving the arm and what a stroke does.\n\nSENSORS: how each signal is made, from the body to the screen, then live: ECG leads, EEG rhythms, a pulse oximeter on the fingertip, a thermal camera reading breath at the nostrils, and an ultrasound probe you move over the skin that builds a 3D picture.\n\nIMPLANTS: placed on the atlas's own bones, vessels and nerves, part by part, with their history, materials and the non-metal alternatives - hip, knee and spine implants, bone healing, an artificial disc, a dental implant, pacemaker, heart pump, coronary stent, cataract lens, deep brain stimulation, a brain-computer interface and an NFC chip.\n\nLimits: the lens is small - about 7-9 cm with every tissue on at the chest or hand, 4 cm in the head, larger with fewer tissues. Signals and devices are simulated for teaching. Adult male model; the inner and middle ear are not included.\n\nEducational use only: not a medical device, not for diagnosis or treatment, not medical advice.\n", "short_description": "Walk around a life-size human body in your room and look inside it through a lens you carry: bone, muscle, vessels, nerves and organs in full detail. Narrated sequences show how the body works, how medical sensors read it - ECG, EEG, pulse oximetry, a thermal breathing camera, ultrasound - and how implants are placed and work, from hip and knee replacements to pacemakers, heart pumps and brain implants.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/anatomy-cube/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/anatomy-cube/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/anatomy-cube/support", "website_url": "https://nebulytic.com/apps/anatomy-cube/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1413278355201517"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1727902849124476"}]}, "baseline_offer": {"id": "1727902849124476"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793986980, "status": "PUBLISHED", "id": "1727902849124476"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
u2022 Trade - Buy and sell ore on the Belt Colony market.\n\u2022 Maintain - Various missions for maintaining the ship.\n\nBelt Miners is a simulation game with the goal of providing a relatively accurate simulation of what it would be like to be an Asteroid Belt miner in the future.\n\nEngage in hours of sci-fi asteroid mining experiences with 50 missions, scanning asteroids, deploying rigs, retrieving ore, trading, and maintaining the main ship.", "short_description": "Welcome to the Utopia Arura mining ship Tau Ceti. Your overall mission is to mine asteroids for usable resources. Your mission commander is the android Pi. She will brief you on all missions and manage your progress."}]}, "developer_name": "GridSky Software A/S", "developer_privacy_policy_url": "http://gridsky.com/privacy-beltminers.html", "developer_terms_of_service_url": "http://gridsky.com/termssoftware.html", "publisher_name": "GridSky Software A/S", "support_website_url": null, "website_url": "http://beltminers.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "EXPLORATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1216284538897552"}}]}, "scheduled_offers": {"count": 80, "nodes": [{"status": "PUBLISHED", "id": "1767943440000320"}, {"status": "PUBLISHED", "id": "216812889047812"}, {"status": "PUBLISHED", "id": "2840951149472433"}, {"status": "PUBLISHED", "id": "1191612454552899"}, {"status": "PUBLISHED", "id": "447467109078224"}, {"status": "PUBLISHED", "id": "1998946983689628"}, {"status": "PUBLISHED", "id": 
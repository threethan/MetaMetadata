Q7kNvwFOh7Rn&_nc_oc=AdpX2Y5h1aMT2AiZa6PlG--iduOFX9mKLKx8M1xU_zbTyIsEGjQdiYPaZ3CYP-tvvL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CUAnUwjoMwq9jC3Rwwrr126S0sF3mNPRZSjmUOdWAZQ&oe=69EE0308"}, {"file_name": "migrated_image.png", "id": "143878293646903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331258_2126097634278627_4326513968228073472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3FGL62klksQ7kNvwHG8B9w&_nc_oc=AdrjwGmK2wJtJ4x5iCBeohQqJVO33phpg9JvMVBuBsYqDgyXJUJxuZ4m7zPsyYhLZh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BMijdy53ruDIrI-ju1dHXZeYTkQDSIjLWbOoW4HYWgQ&oe=69EDFA70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belt Miners", "keywords": ["scifi", "space", "asteroid", "trek", "spaceship"], "long_description": "Welcome to the Utopia Arura mining ship Tau Ceti. Your overall mission is to mine asteroids for usable resources. Your commander is the android Io. She will brief you on missions and manage your progress.\n\nMissions:\n\u2022 Scan - Scan asteroids for valuable resources.\n\u2022 Deploy - Deploy mining rigs on asteroids.\n\u2022 Retrieve - Retrieve ore from asteroids to the ship.\n\u2022 Trade - Buy and sell ore on the market.\n\u2022 Maintain - Maintaining the ship.\n\nBelt Miners is a simulation game with the goal of providing a relatively accurate simulation of what it would be like to be an Asteroid Belt miner in the future.\n\nEngage in hours of sci-fi asteroid mining experiences in space with 70 missions, scanning asteroids, deploying rigs, retrieving ore, trading, and maintaining the spaceship.\n\nMade with Unity. Music by Stellardrone (ref. terms).\n\nTips:\n\u2022 Drag on the touchpad to walk and turn.\n\u2022 Gamepad: Press the A-button for instructions.\n\u2022 Gamepad (ship): Turn your head towards UI buttons to see the dot.", "short_description": "Welcome to the Utopia Arura mining ship Tau Ceti. Your overall mission is to mine asteroids f
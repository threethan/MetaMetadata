uluscdn.com/v/t64.5771-25/11162694_1718437631521608_6094982192763502592_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jx_miFt6rXcQ7kNvwFmQ8Xa&_nc_oc=Adoim2AcXXNMIelpYseUrLp2nlYeyGDwBzbC26CAZOby0V1g3Oyzn-qD4oZ8bZGmOHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbn4CnGEFJbumPfWbzOzeSYIofYnJVv3nyaH1WgLO5UA&oe=6AFDBCC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belt Miners", "keywords": ["scifi", "space", "asteroid"], "long_description": "Welcome to the Utopia Arura mining ship Tau Ceti. Your overall mission is to mine asteroids for usable resources. Your mission commander is the android Pi. She will brief you on all missions and manage your progress.\n\nMissions:\n\u2022 Scan - Scan asteroids for valuable resources.\n\u2022 Deploy - Deploy mining rigs on selected asteroids.\n\u2022 Retrieve - Retrieve ore from asteroids to the main ship.\n\u2022 Trade - Buy and sell ore on the Belt Colony market.\n\u2022 Maintain - Various missions for maintaining the ship.\n\nBelt Miners is a simulation game with the goal of providing a relatively accurate simulation of what it would be like to be an Asteroid Belt miner in the future.\n\nEngage in hours of sci-fi asteroid mining experiences with 50 missions, scanning asteroids, deploying rigs, retrieving ore, trading, and maintaining the main ship.", "short_description": "Welcome to the Utopia Arura mining ship Tau Ceti. Your overall mission is to mine asteroids for usable resources. Your mission commander is the android Pi. She will brief you on all missions and manage your progress."}]}, "developer_name": "GridSky Software A/S", "developer_privacy_policy_url": "http://gridsky.com/privacy-beltminers.html", "developer_terms_of_service_url": "http://gridsky.com/termssoftware.html", "publisher_name": "GridSky Software A/S", "support_website_url": null, "website_url": "http://beltminers.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW
-1.oculuscdn.com&oh=00_Aft53f1EM13ZAbfxYD2OQQuaWCts1ZhwacylfHoA1-yLRQ&oe=69A03A88"}, {"file_name": "migrated_image.png", "id": "143878293646903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331258_2126097634278627_4326513968228073472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szZwPML6uQAQ7kNvwFZZe9Y&_nc_oc=AdnfVQU1chRrr1joG_r13m9BrOe_6ehWnTIaRTm7TXZ4p1aG2FbCqfj7ONfVvHNbyq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft03kgE2a_QOYQtdaxRumExtOMRzZ2TSEuhXxVUWqJOaw&oe=69A031F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Belt Miners", "keywords": ["scifi", "space", "asteroid", "trek", "spaceship"], "long_description": "Welcome to the Utopia Arura mining ship Tau Ceti. Your overall mission is to mine asteroids for usable resources. Your commander is the android Io. She will brief you on missions and manage your progress.\n\nMissions:\n\u2022 Scan - Scan asteroids for valuable resources.\n\u2022 Deploy - Deploy mining rigs on asteroids.\n\u2022 Retrieve - Retrieve ore from asteroids to the ship.\n\u2022 Trade - Buy and sell ore on the market.\n\u2022 Maintain - Maintaining the ship.\n\nBelt Miners is a simulation game with the goal of providing a relatively accurate simulation of what it would be like to be an Asteroid Belt miner in the future.\n\nEngage in hours of sci-fi asteroid mining experiences in space with 70 missions, scanning asteroids, deploying rigs, retrieving ore, trading, and maintaining the spaceship.\n\nMade with Unity. Music by Stellardrone (ref. terms).\n\nTips:\n\u2022 Drag on the touchpad to walk and turn.\n\u2022 Gamepad: Press the A-button for instructions.\n\u2022 Gamepad (ship): Turn your head towards UI buttons to see the dot.", "short_description": "Welcome to the Utopia Arura mining ship Tau Ceti. Your overall mission is to mine asteroids for usable resources. Your commander is the android Io. She will brief you on missions and manage your progress."}]}, "developer_name": "GridSky Software A/S", "developer_privacy_policy_url": "https://gridsky.com/privacy-beltminers.html", "developer_terms_of_service_url": "http://gridsky.com/terms-bm.html", "publisher_name": "GridSky Software A/S", "support_website_url": null, "website_url": "http://beltminers.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26186098011022847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_355831411592393_5856954061542129664_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQDS-4-exw8Q7kNvwFnBC0H&_nc_oc=AdkiOsW7-qLkS104BjKKKATbXJX6Hlwofc-ctapoTcA3_jZhCO1P5wyp92_zvIeIZ8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZJliiTPF84pdVMiShiY6MoioUKvAYLMjNazIkGImEhw&oe=69A03B8B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Belt Miners", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1512523628, "lastRevision": {"nodes": [{"id": "702208913314191", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1625218054204184", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_imag
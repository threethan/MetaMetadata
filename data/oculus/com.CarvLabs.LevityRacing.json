cdn.com&_nc_ss=7f20f&oh=00_AQPlMTV5VDB8vLaCsFAs8c88XXsbosstVRwQezqcNwwwIA&oe=6AC10954"}, {"file_name": "Layer 1screens_00.png", "id": "931093015785073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221322_931093019118406_4800815204972657035_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIcNgVJmOY0Q7kNvwE1nEJP&_nc_oc=Adp6IQwB8jip-YSN9g2KOR0bDCD6GHRTyitTGCkCiuk8UrPXMF1XtKEDtT0_MGRWjDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLZ4c-Kr7hvgexID53HfDCkWfsm21JN6awDHg2C5COZQ&oe=6AC12C8D"}, {"file_name": "Asteroid Track 21 (1)screens_00.png", "id": "1271382473998921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375081_1271382477332254_3999072930617008374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24Sd0odryrYQ7kNvwGWufCV&_nc_oc=AdobcortzDdRQWlgFMhtRWQLy69E0vxalj3Xf3bKSEqgRXTSGCqYl_bAONmqPMz-l70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnI6r6QTbBjrc-xUJMlcNfudtb9NsWa4QCl5rdqI0ACg&oe=6AC11798"}, {"file_name": "screen_shot.png", "id": "928315755618938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86627647_928315758952271_6351302186516638506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnDLRBdr5g4Q7kNvwFSZcRx&_nc_oc=AdqKkK_CnJDme4SQbD33bbKJNqk73JmOo5y7WwPfniT6QFSn7mA_6lkk371XW73EAnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcSyYjyPwdV7d348W6I3DAu_EyKc23HeIUvkF2BWFw9w&oe=6AC12571"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LEVITY Race", "keywords": [], "long_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge other players or your friends in the fastest VR game.\n\nTaking place in the year 2150 after humanity discovered the power of Levitite which has brought hoverboard racing to new heights. Several factions are in control of different parts of Earth.\n\n\nFeaturing high-speed racing on multiple tracks in different styles\nLevy - Your Drone companion will be your support on the tracks\nA variety of weapons that you can use with Levy\nLots of accessibility and comfort options\nSoundtrack created for the game (Streaming allowed)\n\nHang out in your private garage, alone, or with your friends. Some of its Features include:\nChoose different (unlockable) hoverboard deck designs and skins\nCustomize your Avatar or tune your hoverboard controls\nPlay on the arcade machine\nTalk to Levy to learn more about the History of Levity and Levitite\n\nGet on the right track with LEVITY Race and feel the Adrenaline! \n\nWishlist the game to stay up to date with the newest developments. \n\n\nLaunching 2025", "short_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge others in this awesome high speed multi-player VR game.\n"}]}, "developer_name": "CARV Labs", "developer_privacy_policy_url": "https://levityrace.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "LEVRTV LLC", "support_website_url": "https://levityrace.com/", "website_url": "https://levityrace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9397941163570291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001695_359910730516199_7288605531192773239_n.png?s
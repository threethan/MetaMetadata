s_00.png", "id": "931093015785073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221322_931093019118406_4800815204972657035_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xttuNh3GqAQ7kNvwGYotll&_nc_oc=AdmB20ERdaFRJzwbO9YEId5XgsP6M6vEp5qP5DNuLNb1qB5PAhFy74R2hDl1OZSrrXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMEY9yF8TE_X1VcOj44Idk4YakxtsePUeN9YoTyiMpDg&oe=69A4304D"}, {"file_name": "Asteroid Track 21 (1)screens_00.png", "id": "1271382473998921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75375081_1271382477332254_3999072930617008374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCtBWlRGXnYQ7kNvwHwP_V1&_nc_oc=AdlR1ZIt87ZOZVvmjJor3AzSkLuLLjhEinCEk_qoh4XoJZZ-_W8LGLqozTyaiX6JHZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftfCUmtb3A8CK3d4zRGaNK7ETkuXL1admw37EaWEZmzMg&oe=69A41B58"}, {"file_name": "screen_shot.png", "id": "928315755618938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86627647_928315758952271_6351302186516638506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9a1L1xBvjkQ7kNvwE7xkm7&_nc_oc=AdkoddrWvdKRY3j3ed6LDwBI0JHnDVXDscVzXTQFGqeilZLNIB6RSk6mzBT7Clwwszs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvkn1jZ7n0rU9_rYJZtmIohBlaDQ07wJ2Sg-dz7jF3_5w&oe=69A42931"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LEVITY Race", "keywords": [], "long_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge other players or your friends in the fastest VR game.\n\nTaking place in the year 2150 after humanity discovered the power of Levitite which has brought hoverboard racing to new heights. Several factions are in control of different parts of Earth.\n\n\nFeaturing high-speed racing on multiple tracks in different styles\nLevy - Your Drone companion will be your support on the tracks\nA variety of weapons that you can use with Levy\nLots of accessibility and comfort options\nSoundtrack created for the game (Streaming allowed)\n\nHang out in your private garage, alone, or with your friends. Some of its Features include:\nChoose different (unlockable) hoverboard deck designs and skins\nCustomize your Avatar or tune your hoverboard controls\nPlay on the arcade machine\nTalk to Levy to learn more about the History of Levity and Levitite\n\nGet on the right track with LEVITY Race and feel the Adrenaline! \n\nWishlist the game to stay up to date with the newest developments. \n\n\nLaunching 2025", "short_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge others in this awesome high speed multi-player VR game.\n"}]}, "developer_name": "CARV Labs", "developer_privacy_policy_url": "https://levityrace.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "LEVRTV LLC", "support_website_url": "https://levityrace.com/", "website_url": "https://levityrace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9397941163570291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001695_359910730516199_7288605531192773239_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok_o3h97OzMQ7kNvwGF_Abg&_nc_oc=AdkkI3AYDKwWW2IOwQCPiAnnAIQG4Rki9QGMKUQ39RsfboiE9hibaIIMm7dtGE
1_1722322228058920961_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJI2iS1AQ5YQ7kNvwGQNl5D&_nc_oc=Adoj42DlBeFYoFReDadElRXvH5rIPLLdXXl8Ak5CHZZVeFNfH-air2q4kArkIimSS9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwU3tmlCsMvu9olQVtpc00cKufeW3HQlx07DxqdaWcwA&oe=6B09C414"}, {"file_name": "Layer 1screens_00.png", "id": "931093015785073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221322_931093019118406_4800815204972657035_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-I1A6p2ZS4Q7kNvwHKFAA9&_nc_oc=AdqQMirCgt3d6Z66Qi_Cq2fYr-Xf-oFmVPBjgooyW7fTv6iH-AaYzPCtkntM0E6uFm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNVS4N6_nAGdFOIcV0fUnzV4it-Xwvw0O1CfNVXXDW-w&oe=6B09AF0D"}, {"file_name": "Asteroid Track 21 (1)screens_00.png", "id": "1271382473998921", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375081_1271382477332254_3999072930617008374_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OK3VRVHE2QQ7kNvwEbyCz-&_nc_oc=Adq5mD2VKwDMSojknUwlauFlYeWMEtJQ_UP4moqulX-ZeKN4PrVnliDFcVrEgO88GeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAobY0s6bz0BEf5077pxz2XHEAIAnJ0e5AfOcdw02WKA&oe=6B099A18"}, {"file_name": "screen_shot.png", "id": "928315755618938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86627647_928315758952271_6351302186516638506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtJmnUzfHWQQ7kNvwEz39Wh&_nc_oc=AdrzsnWBb6DM9uYrDyEQkiAftuPd_4z-CphdCkahEHbWRmTNPlX5yITyh8YRQg4ETMI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQweD1L5N4fY7wzdz05J5eb9RYC8RmNVw2Tadvnu67Iw&oe=6B09A7F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LEVITY Race", "keywords": [], "long_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge other players or your friends in the fastest VR game.\n\nTaking place in the year 2150 after humanity discovered the power of Levitite which has brought hoverboard racing to new heights. Several factions are in control of different parts of Earth.\n\n\nFeaturing high-speed racing on multiple tracks in different styles\nLevy - Your Drone companion will be your support on the tracks\nA variety of weapons that you can use with Levy\nLots of accessibility and comfort options\nSoundtrack created for the game (Streaming allowed)\n\nHang out in your private garage, alone, or with your friends. Some of its Features include:\nChoose different (unlockable) hoverboard deck designs and skins\nCustomize your Avatar or tune your hoverboard controls\nPlay on the arcade machine\nTalk to Levy to learn more about the History of Levity and Levitite\n\nGet on the right track with LEVITY Race and feel the Adrenaline! \n\nWishlist the game to stay up to date with the newest developments. \n\n\nLaunching 2025", "short_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge others in this awesome high speed multi-player VR game.\n"}]}, "developer_name": "CARV Labs", "developer_privacy_policy_url": "https://levityrace.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "LEVRTV LLC", "support_website_url": "https://levityrace.com/", "website_url": "https://levityrace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
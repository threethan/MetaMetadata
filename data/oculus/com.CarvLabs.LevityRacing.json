cdn.com&_nc_ss=7f20f&oh=00_AQN8SIuy_JerA_CNQaqV0Walj5np8Pwk9PeyOh0Pe-MCIQ&oe=6AE35054"}, {"file_name": "Layer 1screens_00.png", "id": "931093015785073", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221322_931093019118406_4800815204972657035_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xIbUXkC38IQ7kNvwF8Nj6E&_nc_oc=Adov_7z_geSSDdI6LeQvBc1siDFC2bzL-QM26qFhavmz8nL6lqD00vJ-s_gJvRlZIJ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqm42hpDLofCUeobNl2kIfPEklmeoaKJeJ8YIXRAueZA&oe=6AE33B4D"}, {"file_name": "Asteroid Track 21 (1)screens_00.png", "id": "1271382473998921", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75375081_1271382477332254_3999072930617008374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSYrKQ0Nzv0Q7kNvwEml6e-&_nc_oc=AdrX5W4_PMYeinGf-jr-FF4gHyjqvzRDEOXKQMtE0pd0Gf0MHrlS1AZY_D1pUQovH1M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqov2mEYyplMdyf9XZ0QTS_E2nWwsyWdFZbyl1J1gW3Q&oe=6AE35E98"}, {"file_name": "screen_shot.png", "id": "928315755618938", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86627647_928315758952271_6351302186516638506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=he8TZyRx1DEQ7kNvwFzlrT-&_nc_oc=AdqbRIIqEG-jB91VUFm9_9SrDe5Qs8qHr1OPX1Hl9FLkyHFagBMgYOhsumXd5-feXhs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeCE4TapF7-NZEZNf9_BKLOSReeAQ_-jmbq0gD4eGu6g&oe=6AE36C71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LEVITY Race", "keywords": [], "long_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge other players or your friends in the fastest VR game.\n\nTaking place in the year 2150 after humanity discovered the power of Levitite which has brought hoverboard racing to new heights. Several factions are in control of different parts of Earth.\n\n\nFeaturing high-speed racing on multiple tracks in different styles\nLevy - Your Drone companion will be your support on the tracks\nA variety of weapons that you can use with Levy\nLots of accessibility and comfort options\nSoundtrack created for the game (Streaming allowed)\n\nHang out in your private garage, alone, or with your friends. Some of its Features include:\nChoose different (unlockable) hoverboard deck designs and skins\nCustomize your Avatar or tune your hoverboard controls\nPlay on the arcade machine\nTalk to Levy to learn more about the History of Levity and Levitite\n\nGet on the right track with LEVITY Race and feel the Adrenaline! \n\nWishlist the game to stay up to date with the newest developments. \n\n\nLaunching 2025", "short_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge others in this awesome high speed multi-player VR game.\n"}]}, "developer_name": "CARV Labs", "developer_privacy_policy_url": "https://levityrace.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "LEVRTV LLC", "support_website_url": "https://levityrace.com/", "website_url": "https://levityrace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9397941163570291"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001695_359910730516199_7288605531192773239_n.png?s
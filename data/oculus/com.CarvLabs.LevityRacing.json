1_1722322228058920961_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wyuJu7Mj_sQ7kNvwHNtjmH&_nc_oc=AdqGWwXGAzv5b0iAzCF9UjQ5HTqKVp8a_SDbjEt2nILoyv1BYjDzB6SXpfA-1sfJiWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMiLUCbhKe24D1hbjbDBnqpwNL0pXQ1s76I4fqN4T_0Q&oe=6B0F0A14"}, {"file_name": "Layer 1screens_00.png", "id": "931093015785073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221322_931093019118406_4800815204972657035_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAx1a-aLCEsQ7kNvwGqjVNV&_nc_oc=Adpybmg8U2ElzpyXVRgF1atuvK6CHgiNwHECjBj92j4FhSbdJAW2I2eD1Gi_XauYb_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVE_T001yxPff76IOyTAjGSfOjoqzEW9vg92xU4VPpV6A&oe=6B0EF50D"}, {"file_name": "Asteroid Track 21 (1)screens_00.png", "id": "1271382473998921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375081_1271382477332254_3999072930617008374_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2fDlfzBAq4Q7kNvwEZqVJi&_nc_oc=AdrqdVABmpUiBa0873LoVuAaby_Ia66MGFlnZpBaD7aINv9oJgHCTdrqbLjCpmKqKos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVG2-syAm7GPPE-tDhW15UsRpJQzEcDLD9sZKwgsdVNtQ&oe=6B0F1858"}, {"file_name": "screen_shot.png", "id": "928315755618938", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86627647_928315758952271_6351302186516638506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRw6XN88JHgQ7kNvwEGrbqL&_nc_oc=AdqSGbKodrOV83caOJS19eiOVWHxjrXO_aMhfFYgMlpyjWIfatbUFXdwfIiSHRnqFdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNENe3muNIgkqE-c7vmumsRqJthhhHKF35T7vqKgXIGg&oe=6B0EEDF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LEVITY Race", "keywords": [], "long_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge other players or your friends in the fastest VR game.\n\nTaking place in the year 2150 after humanity discovered the power of Levitite which has brought hoverboard racing to new heights. Several factions are in control of different parts of Earth.\n\n\nFeaturing high-speed racing on multiple tracks in different styles\nLevy - Your Drone companion will be your support on the tracks\nA variety of weapons that you can use with Levy\nLots of accessibility and comfort options\nSoundtrack created for the game (Streaming allowed)\n\nHang out in your private garage, alone, or with your friends. Some of its Features include:\nChoose different (unlockable) hoverboard deck designs and skins\nCustomize your Avatar or tune your hoverboard controls\nPlay on the arcade machine\nTalk to Levy to learn more about the History of Levity and Levitite\n\nGet on the right track with LEVITY Race and feel the Adrenaline! \n\nWishlist the game to stay up to date with the newest developments. \n\n\nLaunching 2025", "short_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge others in this awesome high speed multi-player VR game.\n"}]}, "developer_name": "CARV Labs", "developer_privacy_policy_url": "https://levityrace.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "LEVRTV LLC", "support_website_url": "https://levityrace.com/", "website_url": "https://levityrace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
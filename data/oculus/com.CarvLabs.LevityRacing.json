1_1722322228058920961_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO9WoXEaGjUQ7kNvwH9BAfy&_nc_oc=AdraqmpEL587wYxBJonkVf61AowpmpH6EfmH1ifn3Dyhc6oLZ82lYLPVmVuQ2z7Fvi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsEZNa-pLkWjsQSoO2591xvPJRizchKrxVRSECOe15dw&oe=6B0B1594"}, {"file_name": "Layer 1screens_00.png", "id": "931093015785073", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221322_931093019118406_4800815204972657035_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-I1A6p2ZS4Q7kNvwHlaaLu&_nc_oc=AdrJfBdCivjPGtYtT4uu07HX6aaJFz8Wp5jwAosIrcTgeAJivmd-tm67ynllwUVJEcg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyhXZPLiWU9mrAB9h4_zk88LPHhv7jz-pYfiJwxIIEaQ&oe=6B0B38CD"}, {"file_name": "Asteroid Track 21 (1)screens_00.png", "id": "1271382473998921", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375081_1271382477332254_3999072930617008374_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Tuslv3jJ2wQ7kNvwEXlIVS&_nc_oc=AdqI65jXZaKUboh1-ZTzXdW5Q_oS3eDBTUGq-z34RmUGaT0vhrlGr5_Z5oHFf71inYQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7cGM6_tFAKAF8qKgVCImGwuSswT3Egt6V2C75uENvUg&oe=6B0B23D8"}, {"file_name": "screen_shot.png", "id": "928315755618938", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86627647_928315758952271_6351302186516638506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1di3HrjB8HgQ7kNvwF40Tvl&_nc_oc=AdqdpcqstMRdosEbXZEzGkScy1qZRkGEpsKrXQCDGq71PMRagfO3A7Wyh_cR1qiAGf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOF8KJIse4qjrm2PpKvmuu1bcMxhyvAEVOPabQXFp69Q&oe=6B0B31B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LEVITY Race", "keywords": [], "long_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge other players or your friends in the fastest VR game.\n\nTaking place in the year 2150 after humanity discovered the power of Levitite which has brought hoverboard racing to new heights. Several factions are in control of different parts of Earth.\n\n\nFeaturing high-speed racing on multiple tracks in different styles\nLevy - Your Drone companion will be your support on the tracks\nA variety of weapons that you can use with Levy\nLots of accessibility and comfort options\nSoundtrack created for the game (Streaming allowed)\n\nHang out in your private garage, alone, or with your friends. Some of its Features include:\nChoose different (unlockable) hoverboard deck designs and skins\nCustomize your Avatar or tune your hoverboard controls\nPlay on the arcade machine\nTalk to Levy to learn more about the History of Levity and Levitite\n\nGet on the right track with LEVITY Race and feel the Adrenaline! \n\nWishlist the game to stay up to date with the newest developments. \n\n\nLaunching 2025", "short_description": "LEVITY Race is the first full-body hoverboard VR racing game developed for the Meta Quest 2. Challenge others in this awesome high speed multi-player VR game.\n"}]}, "developer_name": "CARV Labs", "developer_privacy_policy_url": "https://levityrace.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "LEVRTV LLC", "support_website_url": "https://levityrace.com/", "website_url": "https://levityrace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
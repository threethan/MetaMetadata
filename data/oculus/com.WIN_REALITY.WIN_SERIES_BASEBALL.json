&oh=00_AQSVG9x3IhDskQIrOfw2ibfLz5Hvo89YzcBb5d8Luq5gmw&oe=6B01DE62"}, {"file_name": "Image03.png", "id": "321330976784411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001719_321330980117744_4999714192660941213_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhn7MoShYQgQ7kNvwGMF2Ml&_nc_oc=Adqx16CXrHq41bKJJ5KJF51vhpI3UnGw3tUCB2RG9RB_sI0v-JruGMts0BQpk4Vjnfw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiL9l7a38vEIGSNeSOKjjUxS8_MpslI6jhD4ExxLDhlA&oe=6B01E618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero_Image.png", "id": "1050974905508240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982492_1050974908841573_1878283795653121637_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pblD0_0jRzsQ7kNvwHrgpS1&_nc_oc=AdojA5_hqu71YcvjemJbAwfB5NFFgkOPWje3NUtQQbFYnj874T-7qdPOrx4XhqAHaBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjGBGs0aBY3eAX0Lr4dIeghAY_TtCsu7Ibr5wQbRC1DQ&oe=6B01E817"}, "display_name": "WIN Reality", "keywords": ["baseball", "training", "softball", "batting", "sports"], "long_description": "Practice like the pros with WIN Reality's fully-immersive VR baseball and softball training system.\n\nWIN Reality lets hitters of all skill levels step into a batter's box anytime, anywhere to see unlimited game-speed pitches. Improve your pitch recognition, timing, and plate discipline with ten training drills designed by pro players. Track performance data and get individual coaching and training plans to take your game to the next level.\n\nTRAINING MODES AND FULL FEATURES INCLUDE:\n- Optional bat attachment - bring your bat into VR\n- Access to 1-on-1 coaching\n- Full Batting Practice\n- Pitch Recognition \n- Release Point Reaction\n- Situational Hitting\n- Library of 600+ pitchers for all velocities, arm angles, and pitch types\n- Performance tracking and feedback\n- Customized training plans \n\nWIN Reality is a key training tool for pro teams, elite college programs, and thousands of aspiring hitters everywhere. Start training with WIN and be ready for real.", "short_description": "Practice like the pros with WIN Reality's fully-immersive VR baseball and softball training system. WIN Reality allows hitters of all skill levels to step into a batter's box anytime, anywhere, and see unlimited game-speed pitches. \n\nFeatures ten training drills\u2014including full batting practice\u2014built to improve your pitch recognition, timing, and plate discipline. Track your progress with performance data and get individual coaching and training plans. Train with WIN and be ready for real."}]}, "developer_name": "WIN Reality", "developer_privacy_policy_url": "https://winreality.com/privacy-policy/", "developer_terms_of_service_url": "https://winreality.com/terms-of-service/", "publisher_name": "WIN Reality", "support_website_url": null, "website_url": "https://winreality.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "548572106725419"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4304125113238458"}, {"status": "CANCELLED", "id": "1009966032990369"}, {"status": "PUBLISHED", "id": "1237368483756310"}]}, "baseline_offer": {"id": "4304125113238458"}, "is_approved": true, "firstOffer": {"node
5G9S1qsacj0gzWracYnJ-iOYmVXSKUKRzTEYcjEkVWJpnZy7Y2HQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl4RQdWHxCc14aaLhpP11siy0XPeP_rzWiaGeAvidYfg&oe=6A52312B"}, {"file_name": "1.png", "id": "1922621854956986", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499293972_1922621858290319_8700646645528879623_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1xkuGDrNHAQ7kNvwFs1dk4&_nc_oc=AdpXgz8SPJeuS8FfvjMyEoB-7fMHtaRuZETyFXJDxUHHs1gXm92qXyFk23Du9Xi6YPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-U-8eqtNhc3USO_j_h3OFX0kwuTVJl2SAV8y92q2Htg&oe=6A524EC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_b4wetgb4wetgb4we.png", "id": "871967465401574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297120_871967468734907_2662833490706599334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RMeE_bE3agQ7kNvwG_xyvE&_nc_oc=AdoGpzQYe-YTVG88U_p0_RtOsiXvgnAKeXn85r1eFV3oaDz9b_9N8Bumj961Exf3oXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8v5I_cXlTe9TArjiyVeoxPc5mvvW4W5CxY_7yUTve0w&oe=6A526126"}, "display_name": "Z CORE", "keywords": ["zombievrshooter", "metaquestzombie", "vrsurvivalshooter", "zombiedefensevr", "vrhorrorshooter"], "long_description": "Z CORE is a high-intensity VR shooter designed exclusively for Meta Quest.\nYour mission is simple: protect the core zone and survive at all costs.\n\nYou are deployed into a ruined facility overrun by infected creatures. There is no escape route. No backup. Just you, your weapons, and the enemies closing in from every direction.\n\n\ud83d\udd2b REALISTIC GUNPLAY IN VR\n\nExperience true weapon handling with manual reloading, responsive aiming, and immersive recoil. Every shot feels physical. Every reload matters.\n\n\ud83e\udddf WAVE-BASED SURVIVAL\n\nSurvive increasingly dangerous waves of infected enemies. Each round brings faster, tougher zombies with unpredictable behavior.\n\n\ud83c\udfaf DEFEND ONE CRITICAL AREA\n\nThis is not a run-and-gun shooter.\nPositioning, timing, and accuracy are key. If the zone falls, humanity follows.\n\n\ud83c\udf06 IMMERSIVE ATMOSPHERE\n\nFight through devastated industrial zones and urban ruins with cinematic lighting and intense sound design that brings every moment to life.\n\n\u26a1 OPTIMIZED FOR META QUEST\n\nBuilt and optimized for smooth performance on Meta Quest platforms.\n\nIf you enjoy intense action, realistic gunplay, and survival pressure \u2014\nZ CORE is your next mission.", "short_description": "Z CORE is an intense VR defense shooter built for Meta Quest where you are ordered to protect a critical zone at all costs. Fight off endless infected enemies using realistic weapons and immersive survival combat mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32538433749105111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_2588775321522440_8507542387376853655_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1
9h9CFKt2qDWX2qB3pWFDsoixoc-liq4x12iEkIv9FWfDRSomddng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqIsublC3LCsr9Pc1s5Z8lDSvxv00KwkLzX_62rPq-sg&oe=6B0B4288"}, {"file_name": "Screenshot_4.png", "id": "1762089214378603", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491829996_1762089217711936_6155696707782892980_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2U_KhDn4b0Q7kNvwEcQvrA&_nc_oc=AdotHtrHQof24PnhH4efB973FxYu_yz7yrDqeRDENiPDOkN5WEjS1SO6lcoC5KRIYLM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSp26s2_p4axMCyqtKMrCPu3Z4nnhQz_f7ObAhSJsgRZg&oe=6B0B228E"}, {"file_name": "Screenshot_1.png", "id": "9502439003216679", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819385_9502439006550012_1566276914293835876_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8ad2-_1FVUQ7kNvwFfpcUI&_nc_oc=AdpOD9DdB8jGxfRAO8h1FaS1fL2Q7kZ96pUBLRCNXJRbkXz6E1H1h4BPi74PV9vyAJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpDYNHArwOzT0eqBdKj0wDxTnGmaeklJBLg3dWcS7puw&oe=6B0B3DC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1058835835758857", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299808_1058835839092190_7370524481922916746_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctYvkXC9j0QQ7kNvwF5eIOx&_nc_oc=AdqWtpez_uAbyEX9lVgA7Cpqpo8Twrf89OhLPQQcyTzAerafpXAjHQeT9Z2L1FWdCzE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbREsH-lO7r3RRImtF3FRoPezAZsd4ZZFTHB-NNS4RAg&oe=6B0B1425"}, "display_name": "VR4Life", "keywords": ["Virtual", "Worlds", "Creative", "Creator", "Social"], "long_description": "Where creativity meets immersion.\n\nStep into a universe of limitless possibilities with VR4Life, the ultimate platform where creators and explorers connect through community-made virtual worlds.\n\nWhether you're a 3D artist, developer, or just someone who loves immersive content, VR4Life lets you upload your own virtual environments made in tools like Blender and share them with the world. Build interactive scenes, games, or artistic spaces and make them accessible to a global audience.\n\nNot a creator? No problem. Dive into a growing library of virtual experiences crafted by the community. Explore unique environments, play in experimental worlds, or simply relax and discover what others have imagined.\n\nKey Features:\n- Upload custom-made VR worlds from Blender and other 3D tools\n- Browse and explore a wide variety of user-generated virtual spaces\n- Personalized creator pages and community feedback\n- Fully immersive and optimized for Meta headsets\n- A creative and social platform for both makers and explorers\n\nVR4Life turns creativity into reality. Explore. Create. Live.", "short_description": "VR4Life is a virtual reality hub where users can explore or publish immersive worlds built with tools like Blender. Create, share, and experience the future of VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.php?s=Vr4Life&u=vr4life.com", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://vr4life.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
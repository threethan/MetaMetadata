v/t64.5771-25/491829996_1762089217711936_6155696707782892980_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItcqKFetxXEQ7kNvwFmK0sK&_nc_oc=Adpw7SWPtRKlCa30MS54kTTuJnIH562TezojfD-Lo5VJXbAOH3B3rT5BsV9iBQ_kGU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c0S89pRvwjr1irCBmj90ZL4eA3-UyZzltIPOUau84sQ&oe=69ECD4CE"}, {"file_name": "Screenshot_1.png", "id": "9502439003216679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819385_9502439006550012_1566276914293835876_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv-bvrgOiZYQ7kNvwG4sy5p&_nc_oc=Adq22j29QUEfd6kOs-MzZQY3xzrDc9GpE920gr7iD89f1NeUqqjUhwjtKrlkyv9e4LE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3URNNF8L-pPeCrskd744hHgX5RSVnTc3h0p6Gm5DT65A&oe=69ECB7C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1058835835758857", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299808_1058835839092190_7370524481922916746_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mOyh1CaqNUQ7kNvwGhSJk6&_nc_oc=AdqPSe4Xm6xuz0KwjZStpEQUCvvMfJ7fNKDZk3xwCdJFcaTDhk1nNeXIXGz3rWTAr8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IRauoDvkctkuwCeHQ2fIhijJfAuZA0iqCUf1OW0xkDQ&oe=69ECC665"}, "display_name": "VR4Life", "keywords": ["Virtual", "Worlds", "Creative", "Creator", "Social"], "long_description": "Where creativity meets immersion.\n\nStep into a universe of limitless possibilities with VR4Life, the ultimate platform where creators and explorers connect through community-made virtual worlds.\n\nWhether you're a 3D artist, developer, or just someone who loves immersive content, VR4Life lets you upload your own virtual environments made in tools like Blender and share them with the world. Build interactive scenes, games, or artistic spaces and make them accessible to a global audience.\n\nNot a creator? No problem. Dive into a growing library of virtual experiences crafted by the community. Explore unique environments, play in experimental worlds, or simply relax and discover what others have imagined.\n\nKey Features:\n- Upload custom-made VR worlds from Blender and other 3D tools\n- Browse and explore a wide variety of user-generated virtual spaces\n- Personalized creator pages and community feedback\n- Fully immersive and optimized for Meta headsets\n- A creative and social platform for both makers and explorers\n\nVR4Life turns creativity into reality. Explore. Create. Live.", "short_description": "VR4Life is a virtual reality hub where users can explore or publish immersive worlds built with tools like Blender. Create, share, and experience the future of VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.php?s=Vr4Life&u=vr4life.com", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://vr4life.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9919524641416607"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2416504295414051"}]}, "baseline_offer": {"id": "2416504295414051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765475580, "status": "PUBLISHED", "id": "2416504295414051"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename
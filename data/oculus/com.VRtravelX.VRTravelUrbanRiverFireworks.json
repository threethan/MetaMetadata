name": "Screen3.png", "id": "947883454383404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_947883461050070_4630467925247213857_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1lPILti28gQ7kNvwHbUBkH&_nc_oc=AdpdgyaZIT2Sqnb6imLiGI1PpiPQ3ftbhAz6OrmR_7A642DAW7T5AHPGbq6A1xSouIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEb3Ie9Mcub0vvnTIBKQUuF2Ys4y7HOylqXs6dDShb4g&oe=6AA2B4AF"}, {"file_name": "Screen2.png", "id": "1440118624794346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1440118631461012_3325050382602057201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH0SJ5-ps8gQ7kNvwFrXo8J&_nc_oc=Adr2jY4zI4fjv_ruqvCbsSABB6TkIO7RSSyuFwqTOloG1W0SzJwImqKMA1T2e40KF2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3SSGkwwiU7liQ5pb7UZxkE5EjNrVMqkuyZ-CB0PhQyA&oe=6AA2BDE6"}, {"file_name": "Screen1.png", "id": "924110737252337", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820923_924110740585670_4190639121202698934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujnl_quUhYUQ7kNvwEVM5S4&_nc_oc=Adpvu0HlVDFtB93yzZiX4HdjJ4LTbgknvao6wBeB7PNibWaza7YGWZXdMMjjqmcEl_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6UZIa8T1ts1V_0Zr2qttWczWyESGjfxRIPHBeXa3bVw&oe=6AA2D1DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Travel Urban River Fireworks", "keywords": ["Vrtravel", "Travel", "fireworks", "Relax", "City"], "long_description": "Experience VRtravelX with a nighttime fireworks show right by the riverbank from a calm yet visually striking perspective. In front of you, bright colors unfold above the water while the lights of the city shape the night around you. There is no need to push through crowds or search for a good spot. Instead, you can enjoy the entire scene from the front row, fully relaxed, and let the moment unfold at its own pace.\n\nAs you slowly look around, the full spatial effect of this setting comes to life. In front of you, fireworks rise above the river. Behind you, the skyline stands tall with its skyscrapers, while reflections and city lights add depth to the night along the waterfront. VRtravelX does not turn this into a hectic event, but into an urban VR experience that combines calmness, openness, and visual intensity in a very special way.\n\nThis freedom to look around is exactly what makes the app so engaging. Every change of direction creates a new impression between the glowing sky, the dark water, and the modern city backdrop. That creates an evening moment you can experience again and again in a different way. VRtravelX brings an urban river fireworks experience into your home that feels relaxing, atmospheric, and spectacular while preserving its own quiet nighttime mood.\n\n#VRtravelX", "short_description": "Experience a nighttime fireworks show right by the riverbank from a striking VR perspective. In front of you, the fireworks light up the sky above the water, while behind you, the skyline rises with its towering skyscrapers. Looking around between the glowing river and the urban night scene lets you enjoy everything calmly, without crowds, and from the front row. VRtravelX turns it into an intense yet relaxing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/VR-Travel-Urban-River-Fireworks", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
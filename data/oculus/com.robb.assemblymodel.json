58537494761434", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/748811223_2158537498094767_6074205393399198997_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5ILouPlFZEQ7kNvwHSXe_K&_nc_oc=Adr4BPFBK5kwAri8si-CluPqCa4dSA0z8WWrGqpwPoGLL0-0EwicuyNaBmK0OZEmvXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTRABronO1MWSDLqqi1uMvlsGx66Grh9D4HSlyh8dw9Q&oe=6AF09831"}, {"file_name": "captura-2-libreria.png", "id": "4510860409187259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/748811223_4510860412520592_7669087265596792732_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Crzp1mYSjhcQ7kNvwFFe39p&_nc_oc=Adr7rhTmMCfPJVZTqPINCwKJeUBjeO9Ki91zxTXuyzhtUiK0bI7l3mVFdkkr0SzAafI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3q5c6qDjUy8oX2vfbOz4ut4TQqupiVnvft8jVTOaO7w&oe=6AF08028"}, {"file_name": "captura-4-grados-de-libertad.png", "id": "2147657672514454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/816087235_2147657675847787_5232202020834097264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5FzXqaX9MEQ7kNvwHqKpID&_nc_oc=Adr3Llr4tZLhrLcJXeF_3SSuC9inBq6xUk44YN5q5JtSaO13PVA2DrbdYcUDgmwTv38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0dj3bA4Ch6VZrZBO7ffcUon4CansLBZS0h8x3OwFp-A&oe=6AF09B59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada-trailer-2560x1440.png", "id": "1107145342113194", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654904853_1107145345446527_2519220769903268179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o978SjRHWysQ7kNvwGyA_wa&_nc_oc=AdqloeFk0eVcQEBoDyFYmPrA_kyZdGmGX2kePoDV-f-oILfKZpnchtSpt_uGTJhRkgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ5zwfsg_jBqjrQ29fUWeOuKDTdCsUztGD0KBlPeCu8Q&oe=6AF0AD5C"}, "display_name": "Assembly Model", "keywords": ["CAD", "engineering", "assembly", "3D", "education"], "long_description": "Assembly Model is a life-size mechanical engineering workshop inside your Meta Quest.\nPARAMETRIC PARTS\nOver 40 generators with standard sizes (ISO, DIN, ANSI): bolts, nuts, washers, gears, racks, sprockets and chains, pulleys, steel cables, winches, bearings, pillow blocks, couplings, shafts, aluminum extrusions, springs and motors. Type the size you need (for example M6 \u00d7 30) and the part is built instantly.\nNATURAL ASSEMBLY\nBring a bolt close to a hole and it seats itself; nuts thread on and shafts stay concentric in their housings. Grab, turn and release parts with your hands on an adjustable workbench.\nMATES AND KINEMATICS\nCoincident, parallel, perpendicular, tangent, concentric, distance, angle, symmetric, limits, hinge, slot, gear, rack and pinion, and screw. Check each part's degrees of freedom and turn on the motors to simulate motion.\nDESIGN AND IMPORT\nCreate parts with sketches, dimensions, extrusions, cuts, revolves and holes. Import STEP, STL, OBJ, 3MF, SLDPRT and SLDASM models.\nDOCUMENT\nSmart dimensions, exploded view, annotation pen and assembly tree. Save your projects and export STL, OBJ and a bill of materials (CSV).\nWork in millimeters or inches, in the virtual workshop or in your own room with passthrough. Everything stays on your headset: no accounts and no internet connection required.\nUser interface in English and Spanish.", "short_description": "Design and assemble real mechanisms in virtual reality. Pick standard parametric parts \u2014 fasteners, gears, bearings, pillow blocks, shafts, aluminum extrusions, springs and motors \u2014 set their sizes and join them with mates just like in professional CAD software. Turn on the motors to watch your mechanism move, dimension it, design your own parts, and work in a virtual workshop or in your own room with passthrough."}, {"images": {"nodes": [{"file_name": "portada-vertical-1008x1440.png", "id": "2926204284413282", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654949474_2926204287746615_54268
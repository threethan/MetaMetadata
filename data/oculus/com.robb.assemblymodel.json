CZQKAj8pg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVfeD6DdJsOyDSJXVKMkZUztS7T4wpPQWQRucjEF_tzw&oe=6AF09AB5"}, {"file_name": "captura-2-libreria.png", "id": "1879900009830905", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654867655_1879900013164238_7212595049719037445_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udtY4GhLpZwQ7kNvwH53bm3&_nc_oc=AdpRvATS--mHRvcWkl4qgQAFN-Fcb1_nHf3Bea0fae5PhofOhmwJuZ68LaCGUbWFa7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzHM-vw3KResPeRH3CP5U-_PK7yUdzN6awumYbTcgsUA&oe=6AF0AD6B"}, {"file_name": "captura-1-motor-y-engrane.png", "id": "1492364756042377", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654956704_1492364759375710_1009528531749042581_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh-rj8aaD44Q7kNvwF9gNiD&_nc_oc=AdovmT2pf_oNV3eyQNYyjLf6EY96epxq-DI7DtcCmSVQIupC5_QDiBRbKYX-NQekPko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_dZv82ZhNtLm-pe3i6r9Yo1UkFHCFxF1vADxlfZyBTA&oe=6AF0961F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada-trailer-2560x1440.png", "id": "1080381998165289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/779277465_1080382001498622_6160759702635347010_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiwPqv6Z4P8Q7kNvwHYT4NX&_nc_oc=Adq9K0OFbubzkFBM5W2XMXsIccy9rAFgkX0zanbCV_F2RmDTZu_1AzjzoBVvvL_U_VE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-7YQcYDyxIgXoRS3_ffOdsNC2VikyEnnaucMuRbQOzQ&oe=6AF0A6CA"}, "display_name": "Assembly Model", "keywords": ["CAD", "Ingenieria", "3D", "Ensamble", "educacion"], "long_description": "Assembly Model es un taller de ingenier\u00eda mec\u00e1nica a escala real dentro de tu Meta Quest.\nPIEZAS PARAM\u00c9TRICAS\nM\u00e1s de 40 generadores con medidas normalizadas (ISO, DIN, ANSI): tornillos, tuercas, rondanas, engranes, cremalleras, catarinas y cadenas, poleas, cables de acero, malacates, baleros, chumaceras, coples, flechas, perfiles de aluminio, resortes y motores. Escribe la medida que necesitas (por ejemplo M6 \u00d7 30) y la pieza se construye al momento.\nENSAMBLE NATURAL\nAcerca un tornillo a un barreno y se asienta solo; las tuercas se roscan y las flechas quedan conc\u00e9ntricas en sus alojamientos. Agarra, gira y suelta las piezas con tus manos sobre una mesa de taller ajustable.\nRELACIONES DE POSICI\u00d3N Y CINEM\u00c1TICA\nCoincidente, paralela, perpendicular, tangente, conc\u00e9ntrica, distancia, \u00e1ngulo, sim\u00e9trica, l\u00edmites, bisagra, ranura, engranaje, pi\u00f1\u00f3n y cremallera, y tornillo. Revisa los grados de libertad de cada pieza y enciende los motores para simular el movimiento.\nDISE\u00d1A E IMPORTA\nCrea piezas con croquis, cotas, extrusiones, cortes, revoluciones y barrenos. Importa modelos STEP, STL, OBJ, 3MF, SLDPRT y SLDASM.\nDOCUMENTA\nCota inteligente, vista explosionada, l\u00e1piz de anotaci\u00f3n y \u00e1rbol del ensamble. Guarda tus proyectos y exporta STL, OBJ y la lista de materiales (CSV).\nTrabaja en mil\u00edmetros o pulgadas, en el taller virtual o en tu propio espacio con passthrough. Todo se guarda en tu visor: sin cuentas y sin conexi\u00f3n a internet.\nInterfaz en espa\u00f1ol e ingl\u00e9s.", "short_description": "Dise\u00f1a y ensambla mecanismos reales en realidad virtual. Elige piezas param\u00e9tricas normalizadas \u2014torniller\u00eda, engranes, baleros, chumaceras, flechas, perfiles, resortes y motores\u2014, ajusta sus medidas y \u00fanelas con relaciones de posici\u00f3n como en un programa de CAD profesional. Enciende los motores para ver c\u00f3mo se mueve tu mecanismo, ac\u00f3talo, crea tus propias piezas y trabaja en un taller virtual o en tu propio espacio con passthrough."}]}, "developer_name": null, "developer_privacy_policy_url": "https://robb-roman.github.io/assembly-model-vr/privacidad.html", "developer_terms_of_service_url": null, "publisher_name": "RoDEVS", "support_website_url": "https://r
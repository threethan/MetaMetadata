2kwg&oe=6A58C41D"}, {"file_name": "Audion_Screenshot4_2560x1440.png", "id": "818684361063234", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619832_818684364396567_7504099015592895087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PWryEZ7TSoQ7kNvwFGL9se&_nc_oc=AdqpHK5qYEERXBcszWc3E1t322_a16EJvKilERunnP8DOA--eL9vy4I5xrBBkCiwHd0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV_81HHt0tMvBGEXxC7RXyB8lcYwFDffdnoeottvEJbQ&oe=6A58D547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AUDION_Logo_2560x1440.png", "id": "604241738423445", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035446_604241741756778_8946456368285989944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwMN0WODIoEQ7kNvwFVj36N&_nc_oc=AdrJZ3YFwaMdyihNeeEjGMUKge7e3zOrWfQ7JaKPP_GotHpCoAo3fTdQz7GSBHFENpg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV6ZmLrdOcApEP2ULJnUYQo2KFB_E8qcF_NXSOHxNwLg&oe=6A58FAE3"}, "display_name": "AUDION", "keywords": ["Music", "Arcade", "Action", "Rez", "Asteroids"], "long_description": "**AUDION** is an abstract, single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. Think Asteroids meets Rez meets Geometry Wars in 3D. \n\nCurrently in **Early Access** and pretty early-on in development, so we're looking for passionate players to help give us feedback so we can improve, tune, debug, and upgrade the game to be as fun as possible. Please join our Discord server to leave feedback and engage with the developers or leave us feedback here.\n{1143321041109619}\n**AUDION** Highlights:\n- Immersive, first-person, physical gameplay\n- Focus on spatial awareness and strategy\n- 4 frenetic levels of increasing difficulty and complexity\n- Powerup load-out feature for strategic gameplay combinations\n- Abstract geometric aesthetic pulse with audio-reactive graphics\n- Electrifying soundtrack by Symbion Project that builds as you play\n\n{1787565561907083}\n\n- Menus and tutorials localized into Japanese\n\n\n{875543641705823}", "short_description": "AUDION is an abstract, single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. With vibes similar to Rez Infinite, Asteroids, and Geometry Wars, Audion features 4 frenetic levels of increasing difficulty and complexity, and a powerup load-out feature for strategic gameplay combinations. Get ready to split, rip, and smash Ions!\n\nCurrently in Early Access so we value your feedback in helping us improve the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/copy-of-audio-services-1", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": "https://discord.gg/QV65cqyJ84", "website_url": "https://www.speedofdarkmusic.com/audion", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32452625491050977"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "852825153922578"}]}, "baseline_offer": {"id": "852825153922578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763607480, "status": "PUBLISHED", "id": "852825153922578"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_
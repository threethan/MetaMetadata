c_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_pSiNqGSpMwtZZLpqTUiX786HQ8KzxElFQVT0vE_SFQ&oe=6AC7A54E"}, {"file_name": "Audion_Screenshot6_2560x1440.png", "id": "2327842374656632", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593853621_2327842377989965_4612588461279707135_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t38afuxQOzkQ7kNvwHJ96L6&_nc_oc=AdqFcbbRlLtWAdSvI9so_x1q482sLrI7vDkN6ngwhLnGQ6WIcTexXFprVXnkeEyUGi4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJwWBmfyvxPW4Wd2zo8qjBQb7l5DddpUB5Y_Fd8BnPcQ&oe=6AC7C52F"}, {"file_name": "Audion_Screenshot3_2560x1440.png", "id": "784308121272032", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618297_784308124605365_8414873254424032828_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgVRxGSm2aAQ7kNvwGuPLnq&_nc_oc=AdrRMguCT0SAX3yscJk_9NdIInpMAgNWtp0QRLY5ReiNhbNA0ozCcNQD0BQ4fJHug0s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfSnkzkEFAf81dYkAR7szx2LtOZkniOwS24SgUX3nQeA&oe=6AC7A49E"}, {"file_name": "Audion_Screenshot4_2560x1440.png", "id": "818684361063234", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619832_818684364396567_7504099015592895087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDp_ViM-La0Q7kNvwEMXowW&_nc_oc=Adp3oqzYD-bgB2dDYfyqBU1Fn4RDL97IwmechQJz4wCFBbaCukpbCnhv-UZIHBHXJ-Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv6X4AWWM0rVcrk7X5jEqSmuiKmWNfrV2e5_wqQ94pqA&oe=6AC7CB87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AUDION_LogoNew_2560x1440.png", "id": "4462388450681517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499624851_4462388454014850_1555981797318123154_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOeU9RSKfgEQ7kNvwE3FQbL&_nc_oc=Adq-Mo1B-CUpyj0Dah-q6037skwYi5QzKsQLGnd61D7YhLDrSBVUwcOPZkWEiDEDAXc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLXE-F2--3piQyDxXZm6FPdnowPdeXFgTU1GXB6fWgFw&oe=6AC7BB51"}, "display_name": "AUDION", "keywords": ["Music", "Arcade", "Action", "Rhythm", "Immersive"], "long_description": "**AUDION** is an abstract, single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. Think Asteroids meets Rez meets Geometry Wars in 3D. \n\nCurrently in **Early Access**, so we're looking for passionate players to help give us feedback so we can improve, tune, debug, and upgrade the game to be as fun as possible. To join as a playtester and get access to the entire game, join our Discord server (link below) to get access. If you enjoyed this demo, please leave us a nice rating/review and wishlist!\n{1143321041109619}\n**AUDION** Highlights:\n- Immersive, first-person, physical gameplay\n- Focus on spatial awareness and strategy\n- 2 frenetic song levels of increasing difficulty and complexity\n- Each level has 3 difficulties and an Infinite game mode\n- Smash or Repel IONs on the musical downbeat for mults\n- Powerup load-out feature for strategic gameplay combinations\n- Abstract geometric aesthetic pulse with audio-reactive graphics\n- Electrifying soundtrack by Symbion Project that builds as you play\n\n{1787565561907083}\n\n- Menus and tutorials localized into both English and Japanese\n\n\n{875543641705823}", "short_description": "AUDION (early access demo) is a single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. With vibes similar to Rez Infinite, Asteroids, and Geometry Wars, AUDION features 2 frenetic levels of increasing difficulty and complexity, and a powerup load-out feature for strategic gameplay combinations. Get ready to split, rip, and smash Ions!\n\nCurrently in Early Access so we value your feedback in helping us improve the game. Join our discord to playtest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/audion-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": "https://discord.gg/2GadZKusT6", "website_url": "https://discord.gg/2GadZKusT6", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38738335729146557"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624656_4427889560765479_5165419284110694097_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ocyi2-ibxUwQ7kNvwGxI-zp&_nc_oc=AdrY8TKQLC64K5_jNRf1JPsUjcq622iyBF-BaYjzTyavSGLb-wLfTM8GCsVclgznyyo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZsw-hf6DSrweVP6wkbF06zNpetlev1e5Hs2MUad2T_Q&oe=6AC7BFFD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AUDION", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1763607480, "lastRevision": {"nodes": [{"id": "1301049783752009", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7337256339681239", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, 
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtcCZbfsZ2kQ7kNvwGtN-hi&_nc_oc=AdoQTqio3tWA9PJjzN4aqwUWxCgGcyPKBQKk_VMpgIvin0yyqd5OFkiMHGXjl5tQNUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHPhV-G00ztz2SuhmCgTQRlHZcxYSM6JY5Wi1ss6ooeQ&oe=6AB7D29E"}, {"file_name": "Audion_Screenshot2_2560x1440.png", "id": "864414156038726", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618938_864414159372059_6448513924766225428_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hc6FAYihLvIQ7kNvwGO4mer&_nc_oc=Adr51YGKJi0hd3zgVGCU79S0JCoLfYTG2MUq_3P5hGLuSvGKf0jH784bIC5g9qZL9gA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfii5VWmZvEoU85hxjZx9f9mMcu0GncF1QX8Z4pshBzg&oe=6AB7D34E"}, {"file_name": "Audion_Screenshot5_2560x1440.png", "id": "1190148653049275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1190148656382608_8458273994403290665_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D_9_ZLv_TUQ7kNvwF3WADS&_nc_oc=AdrueuCxeihY0jYfOvE0c2L5MWHTQgMzcU2uJ7er-sFao5gcOuLnXLyqHRohE38AsMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS1Acb1VSRv1mrXCif57jJhwVFaDb5coor7Z4G5WWEXA&oe=6AB7E85D"}, {"file_name": "Audion_Screenshot4_2560x1440.png", "id": "818684361063234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619832_818684364396567_7504099015592895087_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-SLo-qG-LoQ7kNvwEIhTD8&_nc_oc=Adq1MwYp4gdIZB9QVi7HjUadeK57NvHRneNqXEXm4D4ck2hCftahWiDN1gkJA98PBZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1L6W4362WfsJBTIClQTWJIme8o4chzzA8OuPJXLm22g&oe=6AB7C147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AUDION_Logo_2560x1440.png", "id": "604241738423445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035446_604241741756778_8946456368285989944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cOSdpkS9bcQ7kNvwFFabKn&_nc_oc=Ado55P4CtusdcWKO8lzPSbin-7wiLpK2FsmYG2mmysxNPoppPLVDbBVYMtnwOQV4zYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE-I_GBEouNPqQyU1guBQtSCeAp8CewFaypjLXpLDzdQ&oe=6AB7E6E3"}, "display_name": "AUDION", "keywords": ["Music", "Arcade", "Action", "Rez", "Asteroids"], "long_description": "**AUDION** is an abstract, single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. Think Asteroids meets Rez meets Geometry Wars in 3D. \n\nCurrently in **Early Access** and pretty early-on in development, so we're looking for passionate players to help give us feedback so we can improve, tune, debug, and upgrade the game to be as fun as possible. Please join our Discord server to leave feedback and engage with the developers or leave us feedback here.\n{1143321041109619}\n**AUDION** Highlights:\n- Immersive, first-person, physical gameplay\n- Focus on spatial awareness and strategy\n- 4 frenetic levels of increasing difficulty and complexity\n- Powerup load-out feature for strategic gameplay combinations\n- Abstract geometric aesthetic pulse with audio-reactive graphics\n- Electrifying soundtrack by Symbion Project that builds as you play\n\n{1787565561907083}\n\n- Menus and tutorials localized into Japanese\n\n\n{875543641705823}", "short_description": "AUDION is an abstract, single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. With vibes similar to Rez Infinite, Asteroids, and Geometry Wars, Audion features 4 frenetic levels of increasing difficulty and complexity, and a powerup load-out feature for strategic gameplay combinations. Get ready to split, rip, and smash Ions!\n\nCurrently in Early Access so we value your feedback in helping us improve the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/copy-of-audio-services-1", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": "https://discord.gg/QV65cqyJ84", "website_
tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035446_604241741756778_8946456368285989944_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cOSdpkS9bcQ7kNvwFFabKn&_nc_oc=Ado55P4CtusdcWKO8lzPSbin-7wiLpK2FsmYG2mmysxNPoppPLVDbBVYMtnwOQV4zYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE-I_GBEouNPqQyU1guBQtSCeAp8CewFaypjLXpLDzdQ&oe=6AB7E6E3"}, "display_name": "AUDION", "keywords": ["Music", "Arcade", "Action", "Rez", "Asteroids"], "long_description": "**AUDION** is an abstract, single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. Think Asteroids meets Rez meets Geometry Wars in 3D. \n\nCurrently in **Early Access** and pretty early-on in development, so we're looking for passionate players to help give us feedback so we can improve, tune, debug, and upgrade the game to be as fun as possible. Please join our Discord server to leave feedback and engage with the developers or leave us feedback here.\n{1143321041109619}\n**AUDION** Highlights:\n- Immersive, first-person, physical gameplay\n- Focus on spatial awareness and strategy\n- 4 frenetic levels of increasing difficulty and complexity\n- Powerup load-out feature for strategic gameplay combinations\n- Abstract geometric aesthetic pulse with audio-reactive graphics\n- Electrifying soundtrack by Symbion Project that builds as you play\n\n{1787565561907083}\n\n- Menus and tutorials localized into Japanese\n\n\n{875543641705823}", "short_description": "AUDION is an abstract, single-player arcade-style VR game focused on \u201cspatial strategy\u201d and fast-paced, physical gameplay. With vibes similar to Rez Infinite, Asteroids, and Geometry Wars, Audion features 4 frenetic levels of increasing difficulty and complexity, and a powerup load-out feature for strategic gameplay combinations. Get ready to split, rip, and smash Ions!\n\nCurrently in Early Access so we value your feedback in helping us improve the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speedofdarkmusic.com/copy-of-audio-services-1", "developer_terms_of_service_url": null, "publisher_name": "Speed of Dark Studios", "support_website_url": "https://discord.gg/QV65cqyJ84", "website_url": "https://www.speedofdarkmusic.com/audion", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32452625491050977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618297_1454961772284323_1491730187943079941_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHd_Yx8nhHwQ7kNvwEh203I&_nc_oc=Adq7hvXrG4RkgUquX7cYj_BXWwZzgp29D8Uz0WIEIQeJd8JDZLiTBAiCaFlmvMxh4vM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3Mx993QsaVvulbWvS4yMji33eSnXdvHG9YXcQf2DjuQ&oe=6AB7D848"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AUDION", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1763607480, "lastRevision": {"nodes": [{"id": "1301049783752009", "release_type": "SCHEDULED", "administration_status": "APPROV
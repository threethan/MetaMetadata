3Cl8gdmUfSgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl0UNvuT6_TmBdvxih8taZMp1p_SgJoHMwR2h2C6P-Lw&oe=6AFC8C7D"}, {"file_name": "tapaway-33.png", "id": "1009615348853051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312231_1009615352186384_6597056564921319906_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIixUgHPM0gQ7kNvwE3CelK&_nc_oc=Adp7rndMK_98L0AFCf31-6skO7wnyE0nXKD72Mev3CmlLuYjzMr5FBbWTLVaI_ITtq8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQISwx0rF1ntXrUF8UFfZIjsFzwkDc5uPXvsYtXddPABQ&oe=6AFC945F"}, {"file_name": "hexasort-33.png", "id": "1825866211886029", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313107_1825866215219362_2704809740527675314_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBJkpSu1s-UQ7kNvwHrBinz&_nc_oc=AdoJ8sZZJiQC0eG-vF9-gD8FliW6ijNzsGpr8ms0MnV2-0FvL__C9IU8jY-Tf3lRXHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4thBV-0jpnN5skEjCAEacwTAqRZdzhUtWcnUbZ8r9Ng&oe=6AFC785C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1136995038665399", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623534_1136995041998732_7942304510656708773_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-41inVkd5foQ7kNvwGI5zq4&_nc_oc=Adq_ZjAODV8IqsCu93THfJyN3lAHK-j74JH8h3u8U8bS2pOKHJzmAZHIR8Um6RUukLE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmsQXjalFoxHUHMSXxTwgkbUKycH9KsgUlwfw7HI7Y4A&oe=6AFC71DA"}, "display_name": "Nut Sort VR: Bolt's Workshop", "keywords": ["nuts", "puzzle", "relaxing", "sorting", "robot"], "long_description": "Make room for a little calm in Bolt's workshop.\n\nFIVE WAYS TO PLAY\nSort nuts and hex tiles, slide arrow-marked blocks in Tap Away, free screws and plates in Unscrew Jam, and route crates to matching docks in Box Conveyor. Play 330 levels across five modes, including the original 60 nut-sorting levels and six bonus challenges.\n\nMEET BOLT\nExplore six workshops with living island views. Earn coins, unlock cosmetic nut finishes, and enjoy Bolt's hints and reactions. Play fetch or repair the workshop music box between puzzles.\n\nPLAY YOUR WAY\nAim or tap with Touch controllers. Adjust view height, recenter at the workbench, use snap turning, and customize audio and vibration.\n\nONE PURCHASE\nNo ads, subscriptions, or in-app purchases. Coins and parts are earned by playing.", "short_description": "Solve 330 puzzles across five modes in cozy VR workshops. Sort nuts and hex tiles, free blocks and screws, and route crates with Bolt, your robot companion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nutsort-vr-privacy", "developer_terms_of_service_url": null, "publisher_name": "Extrude Gaming", "support_website_url": "https://raheelswati.github.io/nutsort-vr.html", "website_url": "https://raheelswati.github.io/nutsort-vr.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1092319516960804"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1583715156770298_8760940264978112075_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrKbz20FQDAQ7kNvwE18mRT&_nc_oc=AdpuT
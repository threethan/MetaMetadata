m55s670.png", "id": "3472045229637359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_THAKYGWVvIQ7kNvwHqvuGu&_nc_oc=Adqp9fvd2YxMLlsGJ5Hny960LyuQ4L6xPdkD45gegbpieb_P2Nw7tsH2Wr0aeDSKGds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGc-V6wWPn9ayBbOzjOxqGVWBhG88aUfXtxjuMHYub9w&oe=6A6E09E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GdGJJK49AYQ7kNvwF6pf0g&_nc_oc=Adro0P95udgt808_6V2o1EUREZGU5f1h01y9E-5esy_ZBzdMpvu8aWVi_NmA9xShQtc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMs97EgfGfYvzdN0zss5socGirLvfHqYHeKb9Gf427kg&oe=6A6E019D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys3gLxitqJYQ7kNvwFX2aod&_nc_oc=Adpn2p8lExjcMUwu_PovLYfWYgxtv_Gh7rVpw9gXCq2nT183G0Vh_z4qs8Vt6kZ_yaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT0tp9I005t5ryuTofsrcS6Ub-jixUIeedxgSp51uR4w&oe=6A6DD3DC"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQHhJs9vYdwQ7kNvwGaeUI0&_nc_oc=AdrWnD65E5VMZ-zPXQsvg51yTAvNADkQEqooAHpFy4W4L-B8fJ-7FO4xTVpDCc4tdpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmiCWIrFvB5Q_n9S_XLs3JjtsIbdwAaN095JifdDRLYQ&oe=6A6DFF48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGUftJlSrnIQ7kNvwEKXIkw&_nc_oc=Adqm64Uh3vUoUASZI-rbl2mqDll2s1Da47lpAajOwrczXY6eYcxgmVAyKXYOxj_kzFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8G3OfhGBJHo4TKiQJ2ROtyP13gK6bgwlRQu4fdskykg&oe=6A6DE1CC"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
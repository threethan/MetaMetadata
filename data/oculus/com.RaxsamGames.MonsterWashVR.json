m55s670.png", "id": "3472045229637359", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ASb7O-0_CQQ7kNvwHzUeks&_nc_oc=AdqXAZSkOGAgh4i5Boj71kfnJIHnivv5AOSns_LoyOlQfXNTiUXEVA_5qK-fSqfyd1s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94SfCpMYk9M-26AxtCB_OvUA6AXUZDmZqMVmJSgiuUiw&oe=6A301362"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6Vfs6Sy_nAQ7kNvwHkqnVa&_nc_oc=AdpIgbyE0EtGW2JlEqyMuu2MFhRmRJyXpLlzzTa3EeAP86bhWWieVNXd3E9RltFdPFw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OgMIshFjJiJR0jbv4v8mQOPc0HzQVu0pxfulpVmalAA&oe=6A300B1D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqUEnljRvEIQ7kNvwF77uwm&_nc_oc=AdrFMM9-mK71oGgPpY-UZ003KIVUIj38iaGUwo7GE_nHYCzAqmu9LXoTpzS9frlOuGM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xncUjVOAcRggTftmFP_Lc9mJ2utyjPPdXRIN_oJE5tg&oe=6A30159C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0YLy3zKhDMQ7kNvwGABFzi&_nc_oc=AdqXRzGE14nSrvgSQ0u13fh_tQrws0ldZAfPm6efRp1UeHwBPmWBY3ahYADvdwVaPuU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-1PPedyh7J9h3eZzyNucjRfjO3wr9iTDN4bfwzeqe6g&oe=6A3008C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_JuilplVMEQ7kNvwGNxW9o&_nc_oc=AdobdBKF2s2FLms9j6rGiGvgtzMYexoMUNaWJ_RS2zpdIB82HH2Qgg-y54ZogAdObCU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Px6fPdW0LcXkVQjegp2UvYR5UWR6jtgzsDKLF-eJsTg&oe=6A30238C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
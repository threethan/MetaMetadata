m55s670.png", "id": "3472045229637359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIxitHetWYAQ7kNvwGM7Fjb&_nc_oc=AdpDiwsMsLcHt6XX1LRzArIW1-N3BW9kCXti7M_RIs-YW8y142DlxsGEgF1J8X5-glw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kPDeotJ0h9quh6R-ZsROsSsEDKYlQhVS736_OeaUV6Q&oe=6A43D9E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haUH5Iij7IMQ7kNvwF6m16j&_nc_oc=AdotEd7Nl3qI7RtPLpLRoZpqx0DiQMs8FSD7C6TMz7ta1seJo7PAWHeTEwrXCIdjlSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Hq6ecrA9fXkEh6Mr6DbVLZ3kCDn93bab-O453JO_43w&oe=6A43D19D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VarTin8CYbMQ7kNvwHMjhAn&_nc_oc=Adp1Ab4G7L1X8aIukZ2muZmjr8tMGDWbPZ8miwb99OP2p_SCvboMVz_zFIOSNQb4kfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HDSw9H43eUA-Vn80i4PylY7Y2xl3cKSM0I73_FQeHuQ&oe=6A43DC1C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwmiqUK8yVwQ7kNvwGL5zdC&_nc_oc=Adptvc7qBN79oa8VxesFv-qK7DiIXRdj6EdjFAphsohgwJxVQRsDw8mGvrJBveHtOUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wrfmEZ-4fdJ_HUEVzDm3pm-3CvSr4kmmMjHMIeUh5Aw&oe=6A43CF48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHIeDFwiH6IQ7kNvwEhptdV&_nc_oc=AdpbLTneBnEwu5-4GzfWzaiUyjdKHM2rUQDKRU9KlFD8jsWDb5_VhXgOBugv-j18XVs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oSuR-XsjglvluwOqMTzLmufHUfNGo1we3my9uOQet8A&oe=6A43EA0C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
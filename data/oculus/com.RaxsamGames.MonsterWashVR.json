m55s670.png", "id": "3472045229637359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc5LAq14QqAQ7kNvwGxXI6v&_nc_oc=AdrDDLxK4yW_Wg3Z4uVXheUGnrEvpF6WoFzbmGqhvGB4PglRpc7S6QGm8LwXTnFVhAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWKdOx1Xfd2fbsAF4noecjpraT0SywvMDlZwZCt-DK3w&oe=6A57A062"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1XNG87Cz6UQ7kNvwHy34Vj&_nc_oc=AdrcK6j4tLe1MiPQgH8rPoQHdu3sYSeFhuh1ER0n4_eT2Cj3dTaEMLsI3V7DR-25xCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbYGaY967VhEHJIg1cS2-dpB6apF7AP7hwMLx7odw0kg&oe=6A57981D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNtlqCBdjeAQ7kNvwGy5-qz&_nc_oc=AdpmqDpZMNrbpMhIMkE-o2ZX_Ag-rr9DOZObKrIvmfPsLAqvdznFHw098QAih0ssMSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXjrJ8nolYAPXbsoJYflcDMWzdXHjw59jsNCTsUZatxQ&oe=6A576A5C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRT2iYfVblQQ7kNvwGFTDOI&_nc_oc=Adp9L1K7FMdSfYNKzRhL_Scf5J9hkLhngK3kdo774NiDo8117XibqujlvyOSg7Qzzz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzjpR-nRmjca_f0lQe7pBZ0hrObvwNG0yByV8MMTb2WA&oe=6A5795C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imkf9mBGHvQQ7kNvwFrLLqd&_nc_oc=AdqJG3AFJEzNDC049F9s0rfji76qpXo5rJRzx7afoqgCZZie-UNU0sr5O_YnTmoKf9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkge6bwNBNwXP6i482KIERJ97PB5Bu589KQkrpRbmS_w&oe=6A57784C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
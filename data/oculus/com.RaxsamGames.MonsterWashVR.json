m55s670.png", "id": "3472045229637359", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_THAKYGWVvIQ7kNvwE3d5PA&_nc_oc=AdrpOSN-MZbb9B4UfRpOVwarAxr2yQosGAjw5PY_Cs8-VrnALCKqmf7GoX9yb--jAhU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPzXogCmzTXc7nU_zrfG4cdsDQeTBuylL71Os-101tTQ&oe=6A6F5B62"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GdGJJK49AYQ7kNvwGnmCGE&_nc_oc=AdoJPi6NMLth5j41rEUQzoSFL-FuXvRx10R1h49mKyME5QNvXwGUR1fpr3boMTfv4gs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTqWUTY6iErt5yxsqNRnXDKXXKDASJyCye-Ae0jNLcPw&oe=6A6F531D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhVIxk8DAB8Q7kNvwGFDbDb&_nc_oc=AdpPMCPeZiAU2FrADbJEpqQBF_5FOZ9DlJ-8jun4zvHi4h7ekJGmlny3hN2qe-7Uh8E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVJ_PSkmaZRDrBLBlJy1NQo9EyAJauiG0iKC0-2hxzxQ&oe=6A6F5D9C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQHhJs9vYdwQ7kNvwG8CoGv&_nc_oc=Ado3FuZt2J38bZsCjkH2VKNrxql5DaWr3I730IJC-JSqPQqPkD_0blHzAZEQcAByui8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSBQUKUjDPg9mN2kIO9rRmtm5CWJ4VaNzzaDcfkmHFbg&oe=6A6F50C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGUftJlSrnIQ7kNvwG7Ux3c&_nc_oc=Adr6d7QXfw6NnQlfF_ul0AaHVZfVJwyIlgE-wwHr2O921rn3MrMlcqcvVGRagXysCPU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0BAMNo9Bf1VxzNjJ0eDOOaj1Vea9wqs_jhvfLHr5IIQ&oe=6A6F334C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
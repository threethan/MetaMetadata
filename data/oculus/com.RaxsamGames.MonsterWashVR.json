m55s670.png", "id": "3472045229637359", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eSFKxdQ-9UQ7kNvwF84czO&_nc_oc=AdqEIinQ9Re2z5I4esOLP0Y3nefgw-racZ87n_KcU8C67nfJpK3lx3BClKDzooCf6vI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6SnJDITL1lKtJUI6kNt6aylAwotpSXn7ju5l-jMbCPA&oe=6A54FD62"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1XNG87Cz6UQ7kNvwGKH_91&_nc_oc=Ado20wZFUDDWBk5jlaxiWaaWlbJ5lgZiAHQHCQSKV2yJok4fI7stmgiuTZlQae3E_7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDenoddsU6YCVvae7LAn2j8OU5uzirShg_C1iovXMgT9g&oe=6A54F51D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EtASzc5ek0Q7kNvwH46zOG&_nc_oc=AdqpmqGuNC-OaUIHcu80Wo-9FqJNSkyttK1KFJ1JuzEtsOqYrdE-cqrFwhtU_AVJzAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCasg3q7Pde6yTv3MdjN02UxUhVWDybyCrLkRsTslszZA&oe=6A54FF9C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEWm0qdTgdYQ7kNvwGXYWjj&_nc_oc=AdporWBmhM4GS4tsnLOw7rViVhV4Wi3REHsKqEfVcN0E9-jRoYLqUSp8hlP38DpprX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy0En8b_kEh01H_DEI4EBxhn9hnvx0MI2Jp_-KdzMjug&oe=6A54F2C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRNxDbEP3oIQ7kNvwFzP1XH&_nc_oc=AdobAJqa7K7D1uY8D-MqJFAjjVgECLOuXSVlvFtHhsjh-KKZwkqDhEGAhpXMFKxbpzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKGc8sOdcilNOgr1CmFoDh1dCYdoZ2yZYbC-LmZ7PNjQ&oe=6A54D54C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
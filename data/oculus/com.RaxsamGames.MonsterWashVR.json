m55s670.png", "id": "3472045229637359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fajr39OI0HoQ7kNvwFEzAUU&_nc_oc=Adr54MGaDoiVcdpvYPrAfgdmHi6lO3wBeQtLF1r5DCHNjDpP6Dg4SwjqXlVTvkJI078&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ac1jklXZVwgi7g2dGPn1wU9Uj_vGDLL8Ibp0PFUIGaA&oe=6A355962"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1H9qaIQa7IQ7kNvwEGOpzP&_nc_oc=Adp_J-SQ_mwNsosySTypRYXNXNgaPYK0Uen2uK6I6INVM1Z3D7dBq13VDy89uyah5Jg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-XyTBjtrfZmC758ZFdc7e-_bM_gbCrdTSy9LjPPcHMQ&oe=6A35511D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3nd4Zt8w18Q7kNvwE7c4tI&_nc_oc=AdqUrofp6UZnFEAPPyDQ3zFlLeAxZKmN5qbq64VMA2wMZVkrcpOnIH7plPUrsCb4LnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tpiz1zXhH4OTE5ncLsoB_k0B8PoA0HUC7j0cryqOwWQ&oe=6A355B9C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYmrFwLcxeMQ7kNvwGv_Clf&_nc_oc=AdpWSe-TlWd17yoyHfwbpae5b5KAsD4uQs0CeKRJmC2L5__9IRyUekgNBDobKSwbvjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ia-g4Drv7OELad6EhJLl05H4dsRTKHxRxsDSHz-IE3Q&oe=6A354EC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5kED8WYn1MQ7kNvwEX4vva&_nc_oc=Ado0jYYAyAYCEM8l2T94xXwFtNbeIEs4HYj_1Gppyf4yocoQIEr3h4o7HgnXZw632IA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yMDzogqe55fBVEvgaIAkalpUBiVk8BJKCSVobOPifUQ&oe=6A35698C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
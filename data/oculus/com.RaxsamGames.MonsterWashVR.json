m55s670.png", "id": "3472045229637359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QuQOcZoTFUQ7kNvwHlbIUT&_nc_oc=AdrGHfIjWzcLPOVD_KcE65mkiYqkKPAMmMzK7zRQP6t5JT4kxWq_fKgf409YF0dMVSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw7y2hVNM9yOXHlzmi7AaEkHiT4JnQMovb0_OebMm_2w&oe=6A7C5222"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL4o7GL1ZgAQ7kNvwFnICta&_nc_oc=AdrD930kG85dDQNO5g0uyI-ztVhVg6E1Wg3D1143Buwh1zmMCfkfmE6_GorhvPjutcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqNwby0SFvWg7zr7R95Tyg1Z3hlaE9uzujJD0SbpSPxA&oe=6A7C49DD"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hr5aW_yFTsQ7kNvwGxaCs4&_nc_oc=Adog0SPkmKvFIMLil5SXkwnpAaTZBRYRG72pxOUtt9-w-VI_eBpH6hOLXaLd4uNcvXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbS1ARFL2GM9eEimLq-XmECSiI2dOvzotVYGlJp4Q1rg&oe=6A7C545C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rrbtaqjOEoQ7kNvwEwF2Ip&_nc_oc=AdrUHoaWxGylkd1QL_c6mdx6NmkZnHSRZIg_ZWxldbHeiuH6lereios1ojKL0imNXwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0iBfRCpv0Z0xv3V4ELtFI1kDVqss2ixuJNE14nYXwwQ&oe=6A7C4788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj0i7uRhCZkQ7kNvwGhqzQD&_nc_oc=AdryjNY0PU7Zk6d1cZY__uEWld2mL_RKVwA6MO48xCbWaZB-FgWfPP8KJj6p1mRvEys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0Uul3KzVwxBKGMLxbGG-i2Rgi6xQ3Q7r3S4ULVvDLfA&oe=6A7C624C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
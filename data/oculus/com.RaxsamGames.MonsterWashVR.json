m55s670.png", "id": "3472045229637359", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUL2WB0ZUuQQ7kNvwHrv7_4&_nc_oc=AdosdPy8yMINcDk-Z2DbSNILxzl0klx4jj5kGbXaITYvv3V9DXUuuGUshcbB-bRcioY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxD3PJBb8SC40r_2a1q9d3FKV-zgoQ7wc907eNcK2WJw&oe=6A71FE62"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khkv-h7FFOIQ7kNvwELapCM&_nc_oc=Adp5NdReLlXqqFPmURBSkkhi6JAIOwuW9dL3ZT8Z8BH8j2UKHZCRUoGwfY4QT16ifT8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjugFNGAa-mr6_hUIww0QRgGcIB4AwsWByG0Or4wireQ&oe=6A71F61D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhVIxk8DAB8Q7kNvwGG3RdA&_nc_oc=Ado9Ze3IABn2dkE_JnX-fsdP_de7FwMhy4-LQQt7AYvloAqM8b65mMlFm3c7BHWyFRg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcggNgvrhMTrC3D5FHgb3U08iDoG8ENl-iQiiBHZYR9w&oe=6A72009C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoLIZjOjc4wQ7kNvwGXYAzd&_nc_oc=Adp3aen01hxYA6GWDKFc9YNNH-CjfaUAb0W-kur6LYKdzrma_m3cnaCu3vKYozjk9jI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8xyJUjgN8RFtadbuNjTvd5eQ_PH5AA4dM6eGBFLRiJA&oe=6A71F3C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBFON3TnzTAQ7kNvwHmBN6U&_nc_oc=AdoS_FZD97UW306FgjhSRuKO3dczX2EAoOU5hG5FmaTUXr1Dt8tYGKNO-B0C_WtNn9E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8_WO_fjj7oaRbpYPcV2qTxTnF9hUQdLub93LJmtfHGg&oe=6A71D64C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
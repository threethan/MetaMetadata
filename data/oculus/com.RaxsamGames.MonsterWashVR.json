m55s670.png", "id": "3472045229637359", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nx-xKnUfOsQ7kNvwGYlVJ4&_nc_oc=AdqkTodSL2MXqGd05kz5KA5AloctLPgR4nsG6KhJSLM9Qv1w8jDwINyru0YX5xjixB8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sozWclUERKj16TZpbSTFpaoG0p0HPpLMPPAALmgbISA&oe=6A3D4262"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGbCEvz_khEQ7kNvwFfJEdT&_nc_oc=AdoQSZfzmineGKNVfSlFRcZkGCmXu77b1Jli1hU7suldvmoZGhckELkOvQEWn0Cgmws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aDvoO5qULeEVS349JkFys12JTXngCiA8lMa2eOgbQpQ&oe=6A3D3A1D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6CKEd_e9SgQ7kNvwGAEAHE&_nc_oc=AdrNAKZNjLW3FyggVfa-fX_buJ7YuG16iodnWqg6dbGL0S3dspsegOPjARStTf-GK34&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dNbgXNYv9FpGETmQ9tTe2wCyV-OJP0idY3ke7vH2Aqw&oe=6A3D449C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SciOGvLsVgsQ7kNvwFZ-0Ar&_nc_oc=AdrGiDMyLnxRDn3eCIzypyT81QF_t11-taHEVTymFZys76uHRBQeRqNczqic9-VJ5bo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GEnvZC497MzA0qrxpRuzc5mz9wusyrQUhQy_lSJFHqQ&oe=6A3D37C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcAzuw5GeJsQ7kNvwGFO-ek&_nc_oc=Adobm0PQ_hOPV1VagiJagl8gP-j631-yz3tpLVXvUqdLuvNHGVBfEvug4KirUdD9HDg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c8u3AJiSl9JxOxIAkc09Sn-BCIrE7XFudGTh3inJ6Ag&oe=6A3D528C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
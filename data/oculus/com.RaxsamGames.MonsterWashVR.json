m55s670.png", "id": "3472045229637359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLQdzkoeDkEQ7kNvwHCA1dk&_nc_oc=AdpVWTsmBXnDUYAK6Lg_wl7GcOt0E1KF5pTAoHYPyEqcAMxnrGfc-pxzuoZDhpDpMpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFShez2VgRB2mh_eFJ3nj5a8PcWlzAvkSZwRb2So70r_Q&oe=6A75F2E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzIO2Lu7UnoQ7kNvwGh5AQW&_nc_oc=AdoA0mtHPZRoxF11K-IWow0cJ6drDbm8hpr7I43Yjn4hW-xy2-8ZBy1u5Sz-JCks6bI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa4e-jBnenq9vamhPxTVT3ajxU9z-nqvi250Cmcs2vXw&oe=6A75EA9D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjcpkRfSYPUQ7kNvwFXZ0Xk&_nc_oc=AdqJKESTTXuLKcokl6QluuH-8aV2ZmfJ2zTfX8V55M2KcNfYjj-VDk_2FpBtwHroh-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIWHLo4oSLL3kX1rNOV3TBG_5BhEFgZyVzaR1Boq9bUg&oe=6A75F51C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IsYq6zTbcUQ7kNvwGmt3ZB&_nc_oc=AdqI4EcogFcLNSqIQUri_jd7iZS9dJcO7g9u8iIWlWh3dsgGfVsXs8yBPyjlUP1uZWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErzWVTTQOHyogjtbhFmtyPZ8KnVt8YpGG1y76avILR4Q&oe=6A75E848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJGsUIaapgMQ7kNvwFWWgRk&_nc_oc=Adrjp2K6kMajS3iAkGTfy55RHwRpI7PzowfDGZ4c7hlera_gmg545CBZWYLoXQBK9UM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEUA6wti46ZRg9DE62IX-vdYJPS4uOJYrnEf6cJonYHQ&oe=6A75CACC"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
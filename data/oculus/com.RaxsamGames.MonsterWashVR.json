m55s670.png", "id": "3472045229637359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx5zTOA5-Y8Q7kNvwG-5Wym&_nc_oc=AdoILnUEx5Rb_p6NU_3ukxejLWmOaDbq4jMixPgNtaqwlftyGiA7S4SqV3vU3p3WqX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDZISVEaM9nwO19o05f7cB7cC3niPP2rjlLrZwoWrjKg&oe=6A4A7162"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YguJgyfDDMQ7kNvwH3Vuht&_nc_oc=AdrH4RKL4pRehENoQvzgo6FZUHzoVLxv1GBt4BOIrLAD-4wWaKC5at7hHSVsDTnt2p0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuPof6lQrlo-cxteTxSBw6rs01LJSiDIC6FcUdelCFIw&oe=6A4A691D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeVP0RoolvkQ7kNvwHpEiPJ&_nc_oc=AdoS2xIcOAgsEDKIPGTULXqhLsIiPhClSByoc4h5GIhG21_LCHt7xMhhcGOc3JFIkz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgZ6TdtWyhF98k88tRMWLgUr2USy1NxV4LcjmhFDl52w&oe=6A4A739C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrcKVsFOrHsQ7kNvwHX1N1j&_nc_oc=Adr5oAIS-8OA3RLEEXvtb-ZGUBt7R-wq4YGB24OS9JvzLZrQR8l6fay01UXkGeUUTCs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1c_H8ueNpZ-ZNaqhIShcBFAuF1qqMAQ1OkgJZjhMOQg&oe=6A4A66C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPGx14cyZt8Q7kNvwGt02CX&_nc_oc=AdoKT8dKVCxTLiy5Z_lZEmAGZFVxgJBjftIoyMvLDNJc0ZpZHOHBRx2VyxwKfyz5bAA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnOrJkxDOindXiLQmIGGMts9tX7-HQR3_CFcOFmbk6VA&oe=6A4A818C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
m55s670.png", "id": "3472045229637359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nx-xKnUfOsQ7kNvwGvEtzO&_nc_oc=Adq78qffejaoFdaAWKwQh34wshM22d1fIHVnxo8AGYYYxEkz41gAPH2N6-9S4F_aFpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85V0Ey2cud8pyUsmWEBnuahhtrwrw__iI9n8zLQZrzBw&oe=6A3A9F62"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oePwPB8fGRYQ7kNvwGBIf0m&_nc_oc=Adrx4XDfQGpx2tF1nWYjTy1UEAtEQfK39p6IxwdVzXA1AM8g5NjzGLlAzDPTtnas734&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_19lccLnnD5kQqPQ3OGvJcLjlaLy9YdVKWTKhmuR-isw&oe=6A3A971D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20SwpI1qUO4Q7kNvwGOI-my&_nc_oc=Adry2CfrWLIIpN_64JaDN4kPwiRRLVSxjO_bNgTR2bPBfhtWk76nBybTUz0P3JgrB40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PD4YohdkMBprzRixCoOE2BvjLPHGpuqd8ZriqxgFolA&oe=6A3AA19C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SciOGvLsVgsQ7kNvwFuQ1SG&_nc_oc=AdrfbQGsHMSJrUjnSWMd268m6vTYZGbMNU-hAV7RbunI31hpirjffLKLitDPLOUKGYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KkcFUp4H0j448kE3aGxGfamcM5_10pG34SblWegGw6w&oe=6A3A94C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcAzuw5GeJsQ7kNvwHeECn4&_nc_oc=Ado47ncESPsFRiovIUT45sdnzSy06_gBd-Jw4NPLjEH8-NXF422cllAGts59KGms_mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Rlpk3IDLJLarQj-FwiA1J7CUm0WXqTS_aBf1qO-d-Ow&oe=6A3AAF8C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
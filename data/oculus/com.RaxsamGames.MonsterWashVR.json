m55s670.png", "id": "3472045229637359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dT7EEZnrooQ7kNvwGbhoI2&_nc_oc=AdoylF1pwMAdelZdaJahQ9FGR0aAFXk_eMlf1ojqpaA15uxnX59GY0D3Wh1LbNgf9LQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8QnejKZCPQgVGBjpxy8vmlJGOLs82WfO0jwW3qWcFpw&oe=6A7EF522"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL4o7GL1ZgAQ7kNvwE8vgIc&_nc_oc=AdrVp5u5OEgNJLjvlC4BROm5IlBEm5VkTfW0oKpA586rAe0CKc12__kziYZw6cFyBDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2OaUGno8umjlN8n3Ja3mg_UKdK0zdVCbwV5J8StJWVg&oe=6A7F251D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deW-Ar7rYZoQ7kNvwEAGFlc&_nc_oc=Adr6ZjZ5BIgKm9aS-RlESFwmFu35OSR1HZy5QQGeq-nNKN3Mef46lyNib0z-a-ZndDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL74AVJDb_Gg4vyzPNCmeWyQLhBRIi0MiMNRnb-MbOOQ&oe=6A7EF75C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLtJdeWXeYsQ7kNvwEL88Ql&_nc_oc=AdopQi2nQTnLV4Cxz_t3W7gu9otynGong-ee-si160HNYI6s0dTXvnRDWj_BUGI5eiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo0QVQYp8qC-PnGyYq3eSddk_X-lFeowLKLVH8gjOZ4A&oe=6A7F22C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y4Rm8OE27oQ7kNvwFYFLo-&_nc_oc=AdrcqBJPJW_iwl5eaHnwxYPFIelFz1VpzP6s11tRc8CijlRxitoqcTnwJfpwcrwAqbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkZKQII1uRJ33y_8QU6vbxpCKtTIrT4AQZHw19dnU0TQ&oe=6A7F054C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
m55s670.png", "id": "3472045229637359", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ASb7O-0_CQQ7kNvwH5gUVD&_nc_oc=AdoulHaYpStrCepYgVd5R9rlvShp2WhmwL0H3m23BpEoz9_KQqG3QlHttV4Bh2oyYyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UJ2S3xB2EKAJCgaktWmKS9PLvTC3vp_UvFDMnmDs_HA&oe=6A3164E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Znm-qJbWuC4Q7kNvwFDzVvp&_nc_oc=AdpJ9RlVo8GDQ7MNqSdmU6SUvARQfLcn4KlVCru5KVdOqnaSLFJLVdwren4C0SqdWp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X0i0BhOke-jRrrg9AfxefMUXLflsanDare0KVJWeyiA&oe=6A315C9D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqUEnljRvEIQ7kNvwGrbhc5&_nc_oc=AdqfyQ3WMqEQBRN55S6w_BuKoeBKsakpSA1vWTvNHwdI62Kz7DidtGkWGzvfJBKbrug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tED3yIdLfZwwBgviuFEiI_E6mZQaaX9UMo0fDXBZzGA&oe=6A31671C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0YLy3zKhDMQ7kNvwHzAR94&_nc_oc=Adq58zcDzkDNpNRHrjVkPEsZhuGST6Oee88VXQmwvyNHJ9q8S-w4QJESjTw-m82mjXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bs7qhdOkBdFbyaV8Eb7E_JX1CJtqPpH70fpnrO5grSA&oe=6A315A48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_JuilplVMEQ7kNvwE-bA21&_nc_oc=AdoMs-6RzYZh120M15TczwLmLt-C6dNWhUIKcBFPsS1OleQidcgHIlJ6uHI3n0SPnxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ggLBfdvzetj2v_61DmhLFoV_ZVoKg9gMVOowU3GCNyw&oe=6A31750C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
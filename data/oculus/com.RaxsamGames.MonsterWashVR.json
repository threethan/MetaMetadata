m55s670.png", "id": "3472045229637359", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGHHJZf2XN4Q7kNvwH7mUhe&_nc_oc=Adqjsi-WCh9FqcrKYEqXttvIcn_9tLe_TD92w0A78OnNrDWwAleh8pKWWHFxCVHQYx0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmdMBUyfryiHs_flRLfVk5TD4fo6dBhvpLMLl9FCH9Qw&oe=6A6620E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPODbYVo0fsQ7kNvwFhSS43&_nc_oc=AdpNRbeBAFUp0t8X4JIKasfZIR-Vme79FAfCeYCEoakK_8YnzTuqoT1tHhd0PyeeWY8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXXbjlPXsjhpuO5ZoVceZVr8aOviLothRp1hP0ABMoWw&oe=6A66189D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyBgl2uFFCwQ7kNvwFlUG1z&_nc_oc=Adr7wHKCLLfww4fjbST3Xxbii3o_cqocAYXfySlSVCihPWUGxARLHxKADzLEWh8vj88&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpqY5t5Uo4q6SCk8j_JFmDR1nqcDSfyNS8jsOtXsAJTQ&oe=6A66231C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgzcytAnhfMQ7kNvwFrSHD2&_nc_oc=AdoFDI-D5oeu_rKkTPDb4ROcfWsekpN8ddxCW665yvmIVooPOja-tgQSJFFxTv3jKIU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB9PrGEO1XFXq_i9dmIG3uL8fwhN2DLEm_MPoGzgiv0w&oe=6A661648"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AfmcKRYWREQ7kNvwE8DT_z&_nc_oc=AdrhjGdcQ-b_6Xl7HnqxB3F2Kv3gmgMRrTcf918TfR38tVa0p2EfhvzV9pPL85zBLSA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsTIXoMkQAyuvSYKpehs2tAAB9GZmUMYISBXm1QR8K2A&oe=6A65F8CC"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
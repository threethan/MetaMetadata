m55s670.png", "id": "3472045229637359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUL2WB0ZUuQQ7kNvwEpEtoP&_nc_oc=Adoib-6r22pgeg7r13dykhM4N_Cpydqs1DewaLw-OWXv9AjkJUFq0S7YP6_XeHVGUWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMCl3qnr8OGWvhKEM9imPkN9tHCk5grxAYCqTrYPSE7w&oe=6A74A162"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzIO2Lu7UnoQ7kNvwHL6Gk7&_nc_oc=AdpbvkmvlTw6HDydWKklRsiQ9q_Af0fO7rbnVX9n-_bdz8ceYGYSX6QkUswkrmR_JOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPERtaFGVJlGl8jh5h1EKXaptajLQLGFU9A26JpHYLBg&oe=6A74991D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjcpkRfSYPUQ7kNvwG1yVHq&_nc_oc=AdreNosTjZtvEwamecFcUrLaP3sbx1alR81X5vyrG_pG8fslADDJJtu8qM-sVzE9YIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7nFKNQKqtyC7KwHxsCoB_ZtHD66K5X-2pMttzGg1-RA&oe=6A74A39C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoLIZjOjc4wQ7kNvwEbwWE5&_nc_oc=AdqLU4s_uavakwfDSj-uBhH_k7eL1JgZRfWPQmOKgtBmuRJmEs-AXTNw3RyeNy_Smwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxRLDhP3QJvObFb34AuN41uLVHQBcEVjFy0WaPuFhKiQ&oe=6A7496C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBFON3TnzTAQ7kNvwG_r49H&_nc_oc=AdpzEerZR-Hx0ipaJf4r5i4q8_8ICYdYJf2WweFZcfRKu416NPvWWuqMFQ4at1AKyvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMGUjvHtF9zDK-yD5ZQivX0ZhjOU9v3XhT6i8wsMbAUg&oe=6A74794C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
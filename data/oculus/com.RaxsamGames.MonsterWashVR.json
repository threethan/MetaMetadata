m55s670.png", "id": "3472045229637359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nx-xKnUfOsQ7kNvwFVmFT-&_nc_oc=AdqmRz_FIhy4Nvi2iFW7q8AsIlxEnjYh97FWlcWmG8VkWKdLIQqs-HMglqA0wITjihk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-EB04vxchAGGPY80Ie9A6qBrXLqRH91527xKlSiyzsw&oe=6A3BF0E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oePwPB8fGRYQ7kNvwHpPm9k&_nc_oc=AdqzGWH7uj1OM4d6Z5S2t4b4frcouhhu17MLirOvBjOPuMNHQSk755EWp8o9B1alu0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ncs9Zk468KrbHgnUynfk89yM3AAeWlvzUjwV-wu7T4Q&oe=6A3BE89D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6CKEd_e9SgQ7kNvwFGpCqr&_nc_oc=Ado9o5lv8bFoIa5taxzZDhewq6j--qg7IISlkotqsJ0NbRd4LP9yAEsPLgtXT_TiJco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NO6Z61Omj3XNVGPIzZQ2StgOuXKtZF9A_x9Oun402mg&oe=6A3BF31C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SciOGvLsVgsQ7kNvwF0_Rc6&_nc_oc=AdrF3K8NK9Nbz2ywuLaBYDhBGrbV5tBRivuQIc5yCmFKcCVJjPfegP9yM47CcgiejWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vkR2UqZPXrXyTeL0lie6VUt2FZzhe96kITnwLUtDVZg&oe=6A3BE648"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcAzuw5GeJsQ7kNvwF2fDT1&_nc_oc=Adqzs0qmtQ-n5teIhOnhPWSvhx9FG4Cmog6FCSq7uQO_CG6VPD2UW_6HmDSxUwZGVo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nWo9J2H9SWv4wyYlXw9QrfwYl9NKt57JN9D_K9uCtAw&oe=6A3C010C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
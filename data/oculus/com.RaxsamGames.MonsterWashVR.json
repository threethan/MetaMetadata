m55s670.png", "id": "3472045229637359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwg-eaWm6XEQ7kNvwE6GViY&_nc_oc=AdryTKMT8jZFFxOjDuyRxxgFOKXoAXWWpr6R_JMJkMtyFvxbgLStYTlebJP_f1PdgF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0kHsYdPQ8pvGnI9Ev1cet6_8dQW6nDCj58lSnOwt0xQ&oe=6A5F8962"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj7EWkKCLRIQ7kNvwGsd04h&_nc_oc=AdoGmNS6HQmoDehRjBseu1FVp5cDFSi8mR29SRG4sv3fkPUdwSxQ49vKBJy3geCxoeY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBw42kfODEYks7gmHAJTne8qgDGWpp9wJJmKbVwNhRl_A&oe=6A5F811D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqf2BNyb4fgQ7kNvwHixOuj&_nc_oc=AdodmiXNAcyKcDWfnabjM8QPQIhgSG6p2jL7CQ7Vv-iX5V-3SYLDZ3CGXwKM_3wloQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqIlJh3GJo3pxkyYS3r0GAahd3u9FIr857nxWVMqRUnw&oe=6A5F8B9C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sG6T-a2RLAQ7kNvwG4HYeV&_nc_oc=AdpxbEMvrchOlx5ov5MSnJ5mhgajo-1VO7vzGBYyYrum0NP0f8SDqRstq8Xsp2eSoqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZBF2npaYHiH0fSabhFwEZJ3kaBF6LSbitYnHrlA49sQ&oe=6A5F7EC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix_6jVzvS8kQ7kNvwHWf4qk&_nc_oc=AdrHUbTGfwDuz1h4RuRGptaJAgImlP-bjkarJNroWnim417hx1DWgFCSc5PPyTdkKWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC11BnAjoZrtZv4BFCAk90rOAX34yvTNPQZJYfD0JWdZw&oe=6A5F614C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
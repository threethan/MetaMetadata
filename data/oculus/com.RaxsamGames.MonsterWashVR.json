m55s670.png", "id": "3472045229637359", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Lw635vcKFsQ7kNvwHiiWbQ&_nc_oc=AdqR2d7gV6Y5zJ7bRCAZFtGhyEdD526jgmuExoY44rv5UZEAc4QPzvOvHucslkGNAEQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sBMmS7FhF6n6M5HBg9u4USDFh4IuYGU2CsBGBHF_URg&oe=6A2C1EE2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veYt-cXZ57EQ7kNvwFkWAS8&_nc_oc=AdpwJdb_FQBae7XMletXpVO79JcFwUYnA8LdEUW4H-m-gk8N-5KvkgOexXNVBchKxlA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pDRc87G-97UHgKzzqaOrL_fqbdtsK2cHKBMCCc95aEg&oe=6A2C169D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6mRHGjBmigQ7kNvwGXcZsY&_nc_oc=AdqPMF0ONa77iPSVNj-A_139qLllmK9X4vlVA6hW-tSfW3F_N6V-Lhm6PN3JNGBIJmI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86m6_BTCjJI38D3cdOjMXM4Sleei0QnGVenKmEnFNVww&oe=6A2C211C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCMJpVwVvHkQ7kNvwEBs-Gw&_nc_oc=AdqlpQ0t_9h5LdhI1DOX7PBzgjJ8BGKggFV64DjNjw0bsyCA1SS_Loa5IItTHukRSIM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h92wwO3dqUXAgna6QrSo4Loh_KHSsd_d129gBUb_3UA&oe=6A2C1448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rOiwSNYQq8Q7kNvwHXStRL&_nc_oc=AdpswBCT6GTEvG2EzZEvouxlI41nHEvD3fOK8scL8bmclZQUZ3OBPEXHBZ8vNMdaWKw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fcrd_blj-K5S52FLO2ZU2mjR807ZUY9lCdFqTKllGfg&oe=6A2C2F0C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
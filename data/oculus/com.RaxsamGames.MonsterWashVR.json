m55s670.png", "id": "3472045229637359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLQdzkoeDkEQ7kNvwEUXPJX&_nc_oc=AdqS8CKGaxdcyxPsqdhscYa2dBg7pjnME9gTw0kZiJkQvlPeTLcRQu_g0Tesw36CeZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPqKpJjFOIQvmqnM8BRUt-xwEC3Rixi2Bx4L8jp-O94g&oe=6A7895E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOprgirdRXsQ7kNvwFG2d5X&_nc_oc=Adoz_RJ4GB6XS1EBhQ2nTULtd9gwhy2oXFBQ-jvu9w8fjlflKF9g-r8Ale6LVeG8CSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoI2KuzSvRvWsp5IJos8Ti-McgubdLXcRPf8zU_gMEiA&oe=6A788D9D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ4bC3BdUfsQ7kNvwHBlgqi&_nc_oc=AdrjhQzPU3PVl0rf-9ESnmBlnG5R7EJtQzPlQzHnjZpf3mt114Or73ztsJfhoCq4bl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCVVXamUYgbHNcWu6YPk7gs2-7tbiFaBnaqzGuo0qFTQ&oe=6A785FDC"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IsYq6zTbcUQ7kNvwHINSYC&_nc_oc=AdqQiK_V8-BDSnzGQr7X4rVccyDdFRj3lpvCFinRBWSFXDQgiy2TWAaAfKD2KfRZhQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTRS51Rm-klXXBBQFWUVAtLCDY4tgrP9Xm5LsbsA6Ypw&oe=6A788B48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJGsUIaapgMQ7kNvwEg1ao-&_nc_oc=Adocu6t_skyMz6a_uNxQQyaYtSEcjgOlV0sZ6PmjQhLk3Vzz7WXt3HZLH7U9KXloSgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERIz-zI629dAGfCug7gx_IFL7r_fNBBxS4TsLWqKFhvg&oe=6A786DCC"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
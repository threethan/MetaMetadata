3BlvLaLOFaL1I1gkIr0rODiMMRXGU-d4XWPJMijRk-M7vtDeZBUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ts2F3kqK0ztvySd6ljTkD4hWNfIx51YLt_PAthEm61g&oe=69F1E6DC"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBxglL0z6Y0Q7kNvwH-aEBy&_nc_oc=AdqFko0snbIZkk-4kF7YTyR-us7WphoAqegfhaYybYBf9p_iVEn6_aognMKAAafLO9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PK52-XB-11BhO7uOFYY8dFZOi7ndczuQ3QInY_8ewoA&oe=69F21248"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaqdR1duWgYQ7kNvwHEt4pa&_nc_oc=AdorJRI6nkxvvFlQO2I_v3CP0vppwrZuNznUjtaP7JFUf74SwitBPFCV-eKGwduacXM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BgTi_lz8wunrbGD4eo5f_JWhmzSbkDvg41HLCTRakjQ&oe=69F1F4CC"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://www.raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26303676942602300"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617831_929662172920223_156228019179033583_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUQnl8WjyagQ7kNvwGgP7ZM&_nc_oc=AdpA4uzEKQiofXswgg-OlEciM8YTLFGLoh_jp5GViPAcDB5-r3ZsK65FXBW-YsG_mns&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af201onirdg9lIaiVlorhexm2iPegNM4WAvbanagsYedDA&oe=69F21644"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monster Wash VR", "platform": "ANDROID_6DOF", "context_category": {"context_category
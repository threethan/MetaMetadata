m55s670.png", "id": "3472045229637359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDqvYW2uss4Q7kNvwEOb3qM&_nc_oc=Adrte-3DYbxEMPpS4Aj_9yHripowbOh4BN3XGEwZ7SIEwO7dOZeXl4ZYYvzGtbmapg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zTD5IZSvhyH9A0G3P9bKRRjYV0zMdn2ZojWo0LRGG8Q&oe=6A37FC62"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1H9qaIQa7IQ7kNvwEkfvIC&_nc_oc=AdqOALxcZLiyNe8DkdC98h5pf81bb4Yla0W4z2fOJMngxfYS-CDZ5aCYNhnEWsZzHQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ive93bJgy1jVaPeOxFzEWOnzwRD5UE1BwyBjujMWesg&oe=6A37F41D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20SwpI1qUO4Q7kNvwET5ehs&_nc_oc=AdpdwFcELTIGPQQAoYqJttt9tk2wTSAuNu-d2mi3ZpoMFT49qCPhtCGRJG3zQJYPukQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cIzRvuRbBXoKR-TlTMzuKK6naphyZf5QapQWZSvuT7Q&oe=6A37FE9C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8H0kIQcGxMQ7kNvwHc7xsk&_nc_oc=Adr7mjXo72D3GGIPGBNUTQCSCc5e9lXZ0rO8MaqcXid5gy0yYfMMqm-FBfTdr6fyGOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dR8AqtW6emePw_eoSGRPcY8W5E__SLhzY9WfLQlJg-A&oe=6A37F1C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YZe5KsR-l8Q7kNvwERP1qD&_nc_oc=AdreQxDprnTeokYR3-rgVJ8ddH0j8WINBdXwUhPPnsnaNcMD6aAkQL7h0aA5jpf7TcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b4b4aoXc5UU5fdklqxWnrR3GRzCsE-3TTPMRNKyEFNg&oe=6A380C8C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
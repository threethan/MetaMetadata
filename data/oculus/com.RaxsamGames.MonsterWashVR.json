m55s670.png", "id": "3472045229637359", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_dmcZ_qMroQ7kNvwEEtM5m&_nc_oc=AdpfYzzKntXUkl_JUaM6ieWdwpEt_w8HTXdW9aij3FdkQTQIFZCG_MjF19FQDhGjvAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5WeJiVdiR22oUzKLhRB3afQiCan5GqfrZNJaTUL-tqA&oe=6A5108E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOHbcXgLcVYQ7kNvwHzBBwJ&_nc_oc=AdrT28FMll-9i04QWf0J3ez59573mdaR9X-OafHXEmxpoKBx6wRkTjauxFwGxCGd9h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC55Vfaf6c-gtfJ0E7XeoKf-jIo9BO8JbOLOd0A0LeyUA&oe=6A51009D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkccgDm07vAQ7kNvwGCMpxl&_nc_oc=Adrtd_0rNWULRX8ttIE-ppMC9Pz74Q9aaF9BGXHqZDNbbRWTMCXj76-DvgElPCb1H10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdi7dUuuermuEe198BlDOWzMATZjpRnPA0OpK4c_3pZQ&oe=6A510B1C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAu5zJbO0HQQ7kNvwGFwtGo&_nc_oc=AdrRlfv0ei33fls9QKJvO81nnggFwRnRLdlNXue5MpdoGYHhCPofULQhww3OvBNzyY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjsdQK_WvDfQQeUDsMDXYIoVJvUHNhlsk6Cnmon0Kwkg&oe=6A50FE48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNdvU62vhp0Q7kNvwEXd8Q3&_nc_oc=Adq3PHG6HsDTqUHbyfVRIvbNx8vlncQl5iXmKyV9fSo1jTz9NSB3CKKtsxH0OI1LdOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByYJ5eKxmZDWHplNalaP3PJchp_2MX9VlPUoOdmUZCEQ&oe=6A51190C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
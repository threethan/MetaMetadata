m55s670.png", "id": "3472045229637359", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM4lX6hQfMcQ7kNvwFhllMt&_nc_oc=AdpEafNhahPlVh8LClNy20Y76DCLmk6pbN-LHTj0Q7OkCcI4hQ6LzGADEZZXCADIkOI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9op0Soc6YwJp5L-iT-4OlVKGV_g0MTotzLe0W3bltxdA&oe=6A26D8E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSx0LE32NfwQ7kNvwGawfqt&_nc_oc=AdpaAb7KUWoTrGsphr4MoiJ73REcafP5gNGi4btl63aeeUz0Ht4cGkZzVn6HFS-YsMM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QXEHogEWoG0hl6IY6G9441lWJ4QKk6os-KI67cO84RQ&oe=6A26D09D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQi3EmEqEIsQ7kNvwF5BSaj&_nc_oc=Adp9TGmX9ltCHKKWhAgoc1UzFymvEwQg-9Wy9_hKvKwBpXQ_YyK3dV7goWsmJRN0oxg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N6vCyRwDwjatzrU0Czmx5Ywbv5iU0GWB6fmBTiI8rtA&oe=6A26DB1C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuRad36scAgQ7kNvwElpGjx&_nc_oc=Ado-DiOnB1yA_txlmLyCKqL1OyqRTUyR-opT0P9LZtRVo9ycs50yf4Q-sIoow97Z2gc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a9tsPvp1qE5kiu_F3ZKVljfwvazZsdFynOznqDj6AIg&oe=6A26CE48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2iq_Y-sOY0Q7kNvwFpp1d7&_nc_oc=Adp2bGbhAZwgNYyb-M193DLLfZYVW_JihpmOR6yCxuks9Q6d86n57aZZfJF4WJ_F8-Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q6gEbzuM6enV79g8iknqXHcebCj42Jm70fUXnzaOX_A&oe=6A26E90C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
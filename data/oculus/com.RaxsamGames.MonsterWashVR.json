m55s670.png", "id": "3472045229637359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QuQOcZoTFUQ7kNvwFmw0EU&_nc_oc=AdoU8fBTG7eofmz1icpGDs7JLWg4xoQnGyAj94RwUPo_MjjoSiMkVrDZ2hQRtMwFYaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3xB7O7nhAaWP-ac6Vn71JNEwwe3C5B9XzVtMxu9GByw&oe=6A7B38E2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOprgirdRXsQ7kNvwE3yWrv&_nc_oc=AdpJ6o1Jd_qVEOLWBtY2UlcWBx4ElSVpDSLARVdoVSoXwRW2MBODb2k2y5XeKFrMavA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErG-HQFn1G7EnCeDPXMXC4DOAbg49i7wENTv2Zypa1QQ&oe=6A7B309D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hr5aW_yFTsQ7kNvwG5EGCJ&_nc_oc=Adracx7Te4HyP6LhYNyB93Bkv6Gn2UX3O-9E3KgIfItxr5NncNSsQ1NLY7UJzgJqsck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7AFj0HNIJ-QmncAUx4pr4bgYhXNcBmF9UdBmCi3WKow&oe=6A7B3B1C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rrbtaqjOEoQ7kNvwGwarQ-&_nc_oc=AdpO1-kkixdrlAI1uwMw9qvn8c85oG-D0huV8ieHIwPpbLUGhdGogm9iSqyHXyZfJTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBuaw9ysZHLue0vFLWNoCgFgLOhv7VgCDdpoPhJKOl-A&oe=6A7B2E48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj0i7uRhCZkQ7kNvwG-OnxL&_nc_oc=Adr4KbCRPYjoumzh1CE-89SrQaqnJcDhxN4lmeDJcdtH6kc8AOP6Z0mBbSo6brtL_J0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXXTkqLpYTQ8oQU1UtGpxfMcsh8heSRDoZGqIdea_JjQ&oe=6A7B10CC"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
m55s670.png", "id": "3472045229637359", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM4lX6hQfMcQ7kNvwF7Vbl0&_nc_oc=AdpMmkx6--rn88LIHYZebSbKZuZnpyfCg7QuCM9Oj1QFav52agkFDop32LtxH9S7YcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sZnqAGwuVCtNAyGJrXKphG9HnIfCmRCKq59owCDyHLA&oe=6A297BE2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veYt-cXZ57EQ7kNvwFhOOqE&_nc_oc=AdqA8f9NfmUw5TiRbdtApl8J8betTvA1EvSDe85vALgbNUx5vv-RFAg5KkVCOAZtc8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a88CfMReKtouBOxgq_9HDjZc7sgxSio3zXtptAdfWIg&oe=6A29739D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByGuEaCYUWkQ7kNvwEzhLX0&_nc_oc=AdoISOCg0kNbu1q0spLXvq5jEsNuz5UyZgMv61OkA00hKL26xvObIeBbC3XYZx2zE_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TfecaUrY2t4qBxZiYGH0GKH2aVCB-FCstyQDqqOV7xw&oe=6A297E1C"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuRad36scAgQ7kNvwHDMmm2&_nc_oc=Adr5UFPbr45ccr2x1WBY9yWKWZPRQghZqItL4KzKtckiVzvWygds5fiAOJnbSdAIeNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-egX25WK5RX-tlX-fIIA38aag7xq-LCpbio7fXPbMmkg&oe=6A297148"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2iq_Y-sOY0Q7kNvwEGaNsP&_nc_oc=AdpZAvwEMsjQ2yr6dxmrWdgo0q0BjZ2Na3-wGb29V81BIXrj9A9PYdMxzG7tRMDHpyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af848ucZSfhixRobi8a4VWgWzF3EufI_TtvpvI66taiaDw&oe=6A298C0C"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
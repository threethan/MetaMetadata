m55s670.png", "id": "3472045229637359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_3472045232970692_4524975752000768483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KG8FR7WlDAQ7kNvwEUsrzl&_nc_oc=AdpaR9ta0L6jdAR4NPpVchwmlMt7hJxJ-tAjLcDWjmyqenDAyf_Yo5stAJl4Uqs08WU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD3RdOvC4NWX7e2HyEKtmd95socgouQ_TfB9Gag2mD8A&oe=6A82E9A2"}, {"file_name": "vlcsnap-2026-02-17-04h55m35s344.png", "id": "1649412426236901", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_1649412429570234_8698607694660170609_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGY9ojfV4t4Q7kNvwHGoA99&_nc_oc=Ado8hEGbmXxNlikRb63J6EYOgCFlpSoFKF0MyrO0SeQn5FnjwI2eYH2-E-ucheuwPZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXxjbg3eDcSx34CXyZAgysOChLK2jJb8SQ5C6HNithXA&oe=6A83199D"}, {"file_name": "vlcsnap-2026-02-17-04h57m43s573.png", "id": "931369019843296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_931369023176629_6116301361714178142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MOp4RsFzDIQ7kNvwF6gq-X&_nc_oc=Adp8kLsepcY8vWXTAqIh68OytxV0puAty2XQG430wro_Sd-DjnuF6_jVCcLjbVkejlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMSSu_WVRB16U_WqitsCm_37-bPSVBUzI5vsVCfU97hg&oe=6A82EBDC"}, {"file_name": "vlcsnap-2026-02-17-04h56m34s609.png", "id": "884414481108172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619524_884414484441505_1442925184161706877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Yuk7JiZ5UQ7kNvwE7giFI&_nc_oc=AdopBVcWW3LUvo8gt5bfLakeVPwoqTVJiuJZKR0XbtJ9463TOpMfF2-NMeIHYu5n-5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZA6OIKsi_3TdZcmDfQ_OwMd4g3exC8XAaHX0rJBHtmA&oe=6A831748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb.png", "id": "821731230945861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_821731234279194_2901905117265480120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld59l_QbxB4Q7kNvwHPcHZh&_nc_oc=Ado3BYWp5tVmx19dcmKjB3PW5yoZ3aiJUgaO7O7afIR_DynI5wSO6tG4QtkR2rVvlUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlTX9ZdGxHY0gPoFfuNfKCuU-wazllxJC0tpByIs8RIw&oe=6A82F9CC"}, "display_name": "Monster Wash VR", "keywords": ["Wash", "Washing", "Simulator", "Monster", "Power"], "long_description": "Armed with your specialized water gun, you'll physically blast away layers of grime in satisfying. \n\n-  Satisfying VR Cleaning: **Physically aim, spray, and wash away dirt with intuitive water gun mechanics.**\n \n- Water Supplies : **Your customer has both black goo and mold dirt on their body. You will get both types of water supplies. Buy water supplies through your earned money from the supplier right beside you in the game.**\n\n- Beat the Clock: **Clean your guests before their patience runs out.**\n\n-  Magical Atmosphere: **Relax in a beautiful Japanese bathhouse filled with quirky creatures.**\n{923319990874504}\nYou\u2019ll need to act fast. Each monster has a patience timer. If you take too long to scrub them down, they might just throw a tantrum! It\u2019s a delicate balance of frantic time-management and deeply relaxing cleanup.\n{665062846668878}\nGrab your headset, turn on the water, and become the ultimate monster caretaker today!\n\n\n", "short_description": "Monster Wash VR is the coziest and messiest profession in VR. You run a beautiful Japanese bathhouse for big, cute monsters. Get your water gun and clean up the mess before your guests get angry! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raxsam.horizonforgelimited.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.horizonforgelimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "
25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyetH7OoBmIQ7kNvwEpbyRa&_nc_oc=Admh_TS86mX1CbEF83bopR_ilIgfomu3hwCAI4Z3xmSbLHN4vbmeuy4HaEBxoMwDDvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfufPI2bEzpBBS4gPfUx_KJ0Q46X9yMHekqBviJzxhLBiA&oe=699EDC71"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ5A1X2IFIgQ7kNvwHw1xCX&_nc_oc=Adlp1Q6puI_vGhptogny-DxwUTgpz657qBHKgh2hB1cF6QDCZl5pzOWYrfQTP6SakqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftX7Ck0GtV1-Qy27KfOM4fm0vyblqBpnozCV0YawBr2kw&oe=699EEDAF"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlCwvbySyCAQ7kNvwF5Hh0M&_nc_oc=Adlky_lD3oi5w_eto2K3RGZ1uZHZIgCI8x4BS9oWg3sRbsui0IZg-gU_rr-aFJrwUHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftCwWCdKLWAcNYcVAAWvhdnZIYs2S5-o_W4vwlUhijFvA&oe=699EE47E"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae9tBjpHi04Q7kNvwGYOmEB&_nc_oc=Adku121ugb1dXosOVfp0vXBL2HdUIjjD5AgP7h3U0eXsVCTUN7DASGXp6jVMbFJAl6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvJvuvLOLvoCh8F51YTKhlaKTjv4irwec4SUEIsH4vX7Q&oe=699EFC46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ-PQTnpxiIQ7kNvwFKAcks&_nc_oc=Adn5KUN_3tI739jofLCyPzs23h0raHvpKTuNX2nqAVZxQTcDxaDlv3DLwCmWHPE_KmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs79xyd8vCTw4w22ewA-XdNZqsMxgXDM0d-YI3DmcWP7g&oe=699EFE0C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
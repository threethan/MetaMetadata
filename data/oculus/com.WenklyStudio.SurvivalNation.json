25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBNCrV_0PFsQ7kNvwF935WV&_nc_oc=AdmsK14ZV_MbkPOfZcFHuA_lfhH39fgCQOx94P705xtThYzzGhyktXFNvjmIl3ivE0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsfr6dfTxMzSUyM4w_q8Y4rQnShQ3IIqed4D1xjSIr0Tg&oe=69A2D0F1"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31T1vl5lJ-YQ7kNvwEhVnQx&_nc_oc=AdmqM-PuHyI85sn4JhTam5uTphzvII6JnjaqhAQYQVnX5QzBw9EZaVqOYK2IPxEe5ew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDmgVbp7HJscFgNkdddH31uqwHLk83V-C1PgA6Msgw_w&oe=69A2E22F"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eHcb1o7FUcQ7kNvwFZSSEN&_nc_oc=AdnUF1oA8PmoFbJDQZgFA10p8BHCqwlwnuoJJAjyVekQ0O_oywaKtvqn0alUNUZQHUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuCGAy6XAE5y80pkebB5IQDDjgbtI3ycTJnA1MpOOP1Ow&oe=69A2D8FE"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a02nee5NbqcQ7kNvwGbm1QN&_nc_oc=AdkB5rC3XuQ4X19QT-6cEeUyZVatonIRFlJDSqPq8pd2bOE-LA4YKLtCXjwe_8yltmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvF2bqlDkoL0yXkxnnvnG4oPERif_0pAgAey08yTgB-kg&oe=69A2F0C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydy2U9EYIUgQ7kNvwEigLPx&_nc_oc=AdklSlviwsZvoBC6VSAFFQh-mKl82Pnhm-xZ2fZw-9gdSdUKGSA0QcGxwey55CNNIWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVrwEXFDlokT3sx9EurnRhgEckSMf3yddm3mreBSUKsQ&oe=69A2F28C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
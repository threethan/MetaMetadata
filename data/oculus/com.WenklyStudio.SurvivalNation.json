25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp84q9D5g4AQ7kNvwFljFND&_nc_oc=Adk6WUxdwX1ukI-Bp2ae1kW0vfB2MwyNgN7UIIYSL4mBymXbLVEE5eDMkm7d57y-VUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCm9iixpW2Uec1GfktrAOErCHDMSnm8eULLlb5jyzQzA&oe=69A6C571"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWXd8KtqsAwQ7kNvwGvqUcH&_nc_oc=AdnoKfqGb7oeQqG0S86H3YyrwrQJtzO5dM7LdV3Z17TQpQWJTMiW49qaRb-grP-bbvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afth2WVZEfYkJLE4Wlal3ZmhwEpJXWPH1tWFmGYTUZPHLQ&oe=69A6D6AF"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRWiQ-bsIe4Q7kNvwG7pxdJ&_nc_oc=Adn2m8Ma67NG2xBvJbl2qX1-wFVuLwNpXzzFnKO-MnNikIAg1B1We5K7rFQW2UnbKj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHTWYpPsZGJXpb3f0aWtuzvp_dSHO2-IXMmfg5ore_oQ&oe=69A6CD7E"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9SwkbO3Ys4Q7kNvwG_n8nM&_nc_oc=AdlOtDRQmQUL4i54QnajF76RNDvTr9w_IFyrwlh1nyednjK9RuvyjffB-1-pkVxxV8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftgs3A9SBFFHwpFjGs_s_Rk9TX04bXNc4W6813SrIuL7g&oe=69A6E546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXRyzldrltAQ7kNvwF6BPBW&_nc_oc=AdkgONCkc8dhVzHVtxYsM55kkI1gwsh_2iBs53-rOOJl4gz-m61I4YUq7QosfcMm6Ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusdBHKixSyHl7bxh8ZyK_Tcz_psO6gO_RHvBI_pPBERw&oe=69A6E70C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
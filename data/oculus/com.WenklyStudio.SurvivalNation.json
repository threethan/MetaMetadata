25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyQ9DeDSTYgQ7kNvwFdENYz&_nc_oc=Adlg3I-FHcFv4RGG-nMrOumbZmSDn9zFPD3YO8aazTpirVZN7KnuXXC3GCSMTa37Pkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfucCfSaYrbvmXn2vKg-g9uTT38ZVGU-s1TeSLxZNFINBg&oe=699D8AF1"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ5A1X2IFIgQ7kNvwF3Iab0&_nc_oc=AdnhZENqpZTTEbL3C862FEBykSXg3pQDJDpzvzEQBHGN7Xrpg1IxPLBkIRziOh4nvOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvllRRfFHJ-3bNQdMu6iOCDizBZqYBXKY9eQxRZ9w56Tg&oe=699D9C2F"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzs1a3_5rO0Q7kNvwHzlPvd&_nc_oc=AdkfZ-zhUxRpJ-I0oXMXTZpWZAIuWC1tQeCUQ33t82x19FcPLsYcFoZp-AW8hbqRC6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftLMVf6AI4zF0DMNW9UXa_MULM3I3ieCxAy2lx4y6oC-w&oe=699D92FE"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae9tBjpHi04Q7kNvwHpljPp&_nc_oc=AdlhK9dboVJXgFav8pKNozTQx-KZBPhmWcPZOW1UZb5NMUBatZgyZnVQIIeFHzbSExI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGliu4gLFNsCuoXB587aH-jagjWdEvMwB7ykefHQoMCQ&oe=699DAAC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ-PQTnpxiIQ7kNvwFngkwx&_nc_oc=Admvu9xXsxR5hjOpTikA8ZDGI8WCiZuVwz72O-X-GwALxzLsK-u0xYJwCSjRSegu9Fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmuUIrxxu0h-gB8qZYUikZMzuuI_kRyorDhWj7V1cVnw&oe=699DAC8C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyetH7OoBmIQ7kNvwFBndKe&_nc_oc=AdnKL5reaByfnN_OHdAvUoK1nE-6Ow7s1XEWKSaBDMS2mha_jCHeDh2cN9o9Golo7Bk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTZyuyccn_-3QA8IRHAwD1N0RVc5AcUQWph7hdCtqamg&oe=69A02DF1"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31T1vl5lJ-YQ7kNvwEiwx7l&_nc_oc=Adk7vFZ0jM3jgPez5FcMY6ui8DmKUrNWzfmyoXyrL7eky27lbQDBGffGv0bM0KTghTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftvT0EDNCAiKH1_5DAJAeWW5drWXny2H07zsFJfOjfzsQ&oe=69A03F2F"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlCwvbySyCAQ7kNvwGmoVWb&_nc_oc=Adnf7DVzyKvl6h5DqBdP8vdwkF8EqV7l0WVrFOEKqzB9DUl6D3ZfX7wXsRsVYlhP8-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftuM5aMbWt47iMQiHE_MjHUqdhKkWO1IstvFkJhVHsGzQ&oe=69A035FE"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae9tBjpHi04Q7kNvwEPOBd4&_nc_oc=Adn-3oRn3lPO8iSLtKb6r4keLPQ-pVRO7-SvONTrd8Vli77JiX9bHmR03FUkUqiYbwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft84_mom6AhkcqWhgPif4Msha0yTSNeixy-pvOzaYi5fw&oe=69A04DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydy2U9EYIUgQ7kNvwFnZZdj&_nc_oc=AdnY1N_xL0r852AHduNsk2mW4pm8y-75wfSnYvGEzOwg1tWU4ly8l-WBGYqfMGpIohE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVJiW8TR5cXFRXVN7hltNjSJgOhacBsUXC0o-JfsEcqg&oe=69A04F8C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
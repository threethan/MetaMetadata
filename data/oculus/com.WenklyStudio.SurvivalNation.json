25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyetH7OoBmIQ7kNvwFuJDhG&_nc_oc=AdnhViHSxWyOg_h0o61PmGdDC0K-dOHX5lxzcMBITdGjviNle1CU7VUnrkmgkkuTTvc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft5fZcHnWTza3LHiRsEKI0Kcnr4e400aC55B4Ib9wzaNg&oe=69A17F71"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31T1vl5lJ-YQ7kNvwFFO6Fh&_nc_oc=AdnujnjbfqhwXN4dcUSI2Jd3XRSrArTNQE469lDmTRN5Qpdynf-Aggd3OEDmAVCYDxc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftCC8Xwnl2m-IAJDB4TLn19epnRqHQJQBCD4Yh4XuKaTg&oe=69A190AF"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlCwvbySyCAQ7kNvwHXR425&_nc_oc=AdmSoNMPd-FqV-0K0Me9MtQny447xK5IiB7URKAnJ-f_kldUjmwXsVwVx9bKm0sJPtU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuXRteeZqC6V7XwaRf-wC8h63fO2W4IefB0pVKbZa-cIg&oe=69A1877E"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a02nee5NbqcQ7kNvwG3zX6p&_nc_oc=AdmNidE4Xv926MK7ryUuiBMkQ0FSOaATZvl6W4wRwYHxlRyY0fs-jM_i-Inhh0svTuM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs34eP1wuAXUr5AcM0h58fx4nlAeDQtxVRVKRyrcfPL2g&oe=69A19F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydy2U9EYIUgQ7kNvwEBSzTS&_nc_oc=Adl3f81C0foHvA-JmogjsLRncCmCixQQBFejId4MjEAFw4B1DySzmRJ3aZxCMOXUh9E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftbpMin34YcyLK0GD16pXR42gYwIP_hs1C6AcR3Hbxe-Q&oe=69A1A10C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
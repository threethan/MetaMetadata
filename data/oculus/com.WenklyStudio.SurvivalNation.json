25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBNCrV_0PFsQ7kNvwGg6VWE&_nc_oc=AdlDjUJBqWtOMNd4zXasQQ3iHu63b0WWpQAGpFTZ8rIQ0d8HuJaYxTW5OHCEW4KWE28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsHgUaOiTLkSWvfm2tE3akEkS-Q3i-zx-AjaH4QB4WzPA&oe=69A42271"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWXd8KtqsAwQ7kNvwEnkKgH&_nc_oc=AdmDjCGgKqa1ONeUYk5_eD_yAf5L9wWBLoMED_-8mND14FSIuT0S033QYQYQb0i3cow&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftRI2oxBx0YnTGT1AiBNFNeIF24GMQhlZnGPYHAqP9mHA&oe=69A433AF"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eHcb1o7FUcQ7kNvwFx2oqW&_nc_oc=AdmEHW7jPYL2eFkqtrQsuf2RscNwRVg7Tvwl1aJEJMSyJI2PctCJRM1FetrpQvWmMOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv5bVQo0NAQOUvipxMYQ6JvlhhItkZwzfw-io6J6JCIGQ&oe=69A42A7E"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a02nee5NbqcQ7kNvwHkRdXl&_nc_oc=AdkR9UaCkIqDNwrj0aTYnYmUtA8C46a53QL97vnu0KY_JJVlMK_33pyVkf987_kX2DY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvTkPCgwSNmIpbSPsjZzKtpmQgv85Zsb3ekIZGDhkwy_Q&oe=69A44246"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXRyzldrltAQ7kNvwFIphZ9&_nc_oc=AdntmbX8XkWu8IbQFJLktm3thNDBDeH9GBcRODWUcGy8Z6xNwBvXC8V7zdjIxWkQRs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftHVwi66O12lGL-udCDd8EAWC51F5NjUJGAC0YK4xvcZQ&oe=69A4440C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
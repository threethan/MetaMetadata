25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyQ9DeDSTYgQ7kNvwHymEUE&_nc_oc=AdnHODzaC0xq8bAjyxdto5LYBje7JLONq8jYSLIN6gDW3SUjKA7bdBIxmd4hDFtfs6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv-dSPd4A2yTMsJzPQRn6ypUxJ5RIswfFt_IatqOZi6wA&oe=699AE7F1"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY0QjJ4Ux04Q7kNvwEcPDKv&_nc_oc=AdljHwX_4-_pN7aOsIMEnmXi_epi-Kbb5d9i2PVX2Ttu08liSpxKE-4QQVgoj35mj8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsF0AmfZCuJ8BWrh7ODdpBELv8-tM38nhxIKf42JXLDJQ&oe=699AF92F"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzs1a3_5rO0Q7kNvwHQgAEc&_nc_oc=AdmfqMcd4ZVwi2E5W0WyqxPiXHuTC8nBoM0WGW_2OoIrLQuUCOzEt7E8lezCa8cMmog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftzPkUSyHG9OD3lym3roxpbQe0PuBe63Xjrs5V5lkB1Kg&oe=699AEFFE"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnUvQkZgZioQ7kNvwHNFcGZ&_nc_oc=AdkT-UdzfRjkTh3UI_R0nl2sK6ERzWs_bHyKk8pDWAWFR5L9IyZ-Q8eb7Sna1mSjW8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuCMucdV6eIKOPd3CzgzIDQc3SgkT5Av4YvoVSGwXJUEQ&oe=699B07C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKoRv066eNwQ7kNvwFDVZPS&_nc_oc=Adlg3DVN3LhCce2diC8eNCH2XTJnFVBxCLlYIUulEEGJlD8agjMYAQKCGO1myfWmksw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftW2ASW9T7X4YY2ji4tPwNhyZWs8xZFTqMsvTQO8UJR8A&oe=699B098C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
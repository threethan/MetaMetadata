25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBsJQNvqEIQQ7kNvwHgQ8z_&_nc_oc=AdkFUqPzMSvgt-yCrHEqYmlH-s-7awXFuHVW5_N4wyxNJlaEjGhlUkuYsRZwQdWHYbc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftuEGH3lLWlag-MV4_vz803RpyJ--Bo2TcIP7OozmtzQA&oe=699844F1"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY0QjJ4Ux04Q7kNvwH15txb&_nc_oc=AdmY3eDtmqnKNvlCB2EfYgHFvJxHm44VV1DdkxjGrvDGh0pe5KUweRhSP2koCQqTkBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsvxkshS1wPLDd-b0gE-wye-ncmT66sp_B3MgKilJ4xyg&oe=6998562F"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLnAd0VRQ74Q7kNvwGXBALA&_nc_oc=AdlrdJs4Jdw4WymvUSRa_69QSHgvasNdwM1a8PtbNS5oaZh_k13YkeSII0kImG7R02E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuO6lAxZUlz9ztFdqw0xsw-540AmQMH9FdjUZPWBkei3g&oe=69984CFE"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35e8YcaG1x0Q7kNvwE6OVyN&_nc_oc=AdkcapyiBrIwg49-_r_rLbXDQnlrWfPSZIsFwkZuD9AKMLuSanIOiYfzj22USYzMTkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsV93n1p2x9jMC6VOpmA0JpsTLHoR_0rtQ2L5K4dLGCPw&oe=699864C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKoRv066eNwQ7kNvwG7Tuhy&_nc_oc=AdlNcG_XwwFfzGyGQO4XErNFePXyv-QSfoNj0yV8BwV4CGGqfDSqQe3lo2sAlFWltC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvnlptFM1I2-InvJb3vQMCzGWptxlehfsJ2-o6gF8TnFg&oe=6998668C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
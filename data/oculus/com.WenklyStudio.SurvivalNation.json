25/38974719_886430040357944_5812980164179449555_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBNCrV_0PFsQ7kNvwH-LLhM&_nc_oc=Adn49MHZzq1KtaCqEkIzWGFNQLqA6Drzf5mclk0yeAan1d2JtWDYT3i0UKxCXX2WRw0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuj85KpUBX7HKqq4_AIcbPZxxyk4kZBdgIFad8lAhEpmQ&oe=69A573F1"}, {"file_name": "Mobile Zombies_final.png", "id": "1240236590221612", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974880_1240236593554945_1028188453651503161_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWXd8KtqsAwQ7kNvwHGeHHi&_nc_oc=AdmWqM0Ph4mDMJcGwkZ1l2sBNMA5WA_DSR_w7VNFPhL7b2q8ytFPKr5vdSrcpIuxju8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftfJCbvrCnm02LpquZESldpQTlKgPTazkowN1acPW3l5A&oe=69A5852F"}, {"file_name": "MobileFishing_final.png", "id": "137244869308481", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_137244872641814_5958679507785929342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eHcb1o7FUcQ7kNvwEdJGvI&_nc_oc=AdlgHW-5vzN2bPu1ggML8T7h975po1qne8T9tLdz1wiDmKeAPMk7KduUMCWUoPLJJRg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsCB-jYL0OUKhp0Ys2BN0OkGoABuK04uIF95a5pD9AEQw&oe=69A57BFE"}, {"file_name": "MobileHunting_final.png", "id": "243809111376705", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974719_243809114710038_80950293541711324_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9SwkbO3Ys4Q7kNvwGt2V3d&_nc_oc=AdnBnTQ-dod15FwrelD36dGIMlXVIyMSd5W0oNlLs4OUNuCC_lGdAWaHyKVT2Ipl6hQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvdzxMoN_OtNGiFvF1WrX079dKdTA1GY4mw1YskQOihxQ&oe=69A593C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "1856076978348136", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823366_1856076985014802_8681746829566387880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXRyzldrltAQ7kNvwHfD90X&_nc_oc=AdnBYy5KuAkTe8XuCRBJD2QZ_d5gMIcMawnt9oNtokY72V8b7dkpGg4apLXeE8Olir0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuqo4NENP00-XD5_RA3SEgEWbNUl6r9S0EGiWWgdQMVMA&oe=69A5958C"}, "display_name": "Survival Nation", "keywords": ["RPG", "Multiplayer", "Openworld", "Zombie", "Online"], "long_description": "Survival Nation is an open-world online RPG zombie survival game designed for VR. \n\nSURVIVAL \nTo survive, you need to remember about food and water. \nYou can get food in many ways: by fishing, hunting, gathering, or scouring abandoned houses. \n\nONLINE \nThey say that cooperation is the key. It is no different here. Survival Nation is a game that focuses on multiplayer mode. \nYou can join other players and participate in a joint adventure and exploration of the world. \n\n\nPROGRESSION \nSurvival Nation is not lacking in RPG elements either.\nA whole bunch of missions and side activities are waiting for you. \nYou have at your disposal 3 unique skill trees, which you develop with each level you gain. \n\nACTIVITIES \nIn addition to quests and many forms of food gathering mentioned earlier, there are many other activities. \nYou can search for items with a metal detector, climb on top of various spots, search for treasure using riddles, and much more. \n\nWEAPONS \nSurvival Nation offers a mass of diverse weaponry, starting from pistols and rifles up to bows.\nEach weapon has not only different statistics but also a feeling and a way of reloading. \n\nJoin our Discord server to be updated.\nhttps://discord.gg/survivalnationvr", "short_description": "Survival Nation is an open-world online RPG survival game designed for VR. In this game, you will kill hundreds of zombies, acquire weapons, learn new skills, craft, explore the world, complete quests, and most importantly, fight for survival. Will you join a Survival Nation?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacy-policy-survivalnation", "developer_terms_of_service_url": "https://www.wenklystudio.com/end-user-licence-agreement-survivalnation",
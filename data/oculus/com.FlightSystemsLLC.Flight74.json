899", "locale": "en_US", "screenshots": [{"file_name": "Trees.png", "id": "876081273523944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031512_876081280190610_3954857504188214429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpe78NAb8GMQ7kNvwGVcY1h&_nc_oc=Adnuk--fUTOX_cy272DraaoXIeSb6qCmW-1VBjyHrcNyPj2Itxir7GXzVrNs1ZylHD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLFber2ubGKHniPtmuwJ8orEYFizc4hZQ-6tpOo-hERg&oe=69AD83B4"}, {"file_name": "Airport.png", "id": "548530253852441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974759_548530257185774_3873336191968563335_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tj8Ao_LVY0Q7kNvwFI0cE4&_nc_oc=AdmcnvmQfc3BA_jzCc2A1b1_ZB-uOr6ScjfWjhIplmsPeA4Lhd5KshcOumpG3lIdD50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGg7a4u5G3fXrL_F0AeguPsPl__FuOP-N716YqXilQeQ&oe=69AD8237"}, {"file_name": "water.png", "id": "681223590152886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031565_681223593486219_5916754183577692195_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svXnl9ZY0X0Q7kNvwELM8s8&_nc_oc=Adll6A2fXNS3ozBqGh0S3Vq4IVa56GW2oOkhk27KiKGRUsHMVyImSdm1yUJI6HQkm3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8skRUAcjIZdYmOysFPCq1O1XcbctRNVj99BiwZo3juQ&oe=69AD7A22"}, {"file_name": "Screen.png", "id": "793028973540074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_793028976873407_8983501859714055577_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thl92CvSL8wQ7kNvwEgCUGV&_nc_oc=AdkY9tGCIpCJWJ5OcbmuYyiLiq7hUt1AMsx12Nq9gHco08cGS1C6x2L5V9VtQOI4I8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNeK9djWnXS1ebwuqyveGpdGXb_8haKhYblkADm8-tgA&oe=69AD6939"}, {"file_name": "Drone.png", "id": "518820930051489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_518820933384822_1330063616294728279_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt2Gjbb0cQoQ7kNvwE8pKLE&_nc_oc=AdlIZDYyMIGRHXgJLfzx4oaI1-9ZDJ-XlGUwly6Y-P7Nw2RtyQGTUd346YuOMvz6TdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyydzKtifRNuDxBfZ_xh3ywxoAPK637c1yEReC0DI2OmQ&oe=69AD6F98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1045505907689964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507838910_1045505911023297_488340947037345495_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqN1Njyq3mYQ7kNvwF2BVnY&_nc_oc=AdnB09Jq3nXM82QiczTDJRV_vtEY6d72lmyFwxWMc6OdXPluNlf8TmX0V2zSLIcBPiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc-hEy7NTsy8sYnXce3d19JIOMUOK3gY0TuyKZpHMgKw&oe=69AD62D7"}, "display_name": "Flight 74", "keywords": ["Flight", "Simulator", "Flying", "Airplane", "Sim"], "long_description": "Do you have what it takes to survive and become the ultimate pilot? Fly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest.  Rated one of the Top 50 Games on Quest by Vrelity.\n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel. Your only chance for survival is to work with the cartel and prove your worth.\n\nFeatures:\n- Complex missions that will test your skills\n\n{2750905198401036}\n\n- Hand Tracking! Put down the controller and play with your hands.  Interactive cockpit. Flip switches, press buttons, punch windows, and more!\n\n{849356023396469}\n\n- Multiplayer! Dogfight against your friends! \n\n{574744495234388}\n\n- Quest 3 Graphics Updates and Improvements\n\n{1503648260255664}\n\n- Make use of your belongings in the cockpit including sun glasses, coffee, and guns!\n\n{498783152559639}\n\n- Solve puzzles in a flight game! Movie style campaign and missions!\n\n{1664355374355543}\n\n- Free Flight Mode with 7 Airports and over 2,000 square miles of scenery\n\n{764494538995077}\n\n- Cars, Birds, Cartels, Explosions and more! \n\n{1643006099819731}", "short_description": "Fly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest.  \n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "https://www.tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24074659455542760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824609_9705423732897605_803510412155846807_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24FJKSXk9Z8Q7kNvwET-R7z&_nc_oc=AdnST3LIfyZ2QDmlGAry_TFWvNzpWIc1ortg_4ZJyUBZdje1i4PT80AXm6vVai5LQ9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybgPURTBQqh1gp5KrpMXG1or4WsNRF6ameXxwzyEb4TQ&oe=69AD7CF8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight 74", 
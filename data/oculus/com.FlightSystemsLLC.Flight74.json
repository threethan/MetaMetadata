899", "locale": "en_US", "screenshots": [{"file_name": "Trees.png", "id": "876081273523944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031512_876081280190610_3954857504188214429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA45foGXW1oQ7kNvwGesO8V&_nc_oc=AdmfhV89xwTeNMdWYfXk8sdKIEAjX8tlOaZwPVTukFxFedsxv7rKN0Vxb6NIVT68xC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9xfgYWtourkUzGG_jkH2-9qmvsdJMPxQu1ym9gcHZkw&oe=69BC0434"}, {"file_name": "Airport.png", "id": "548530253852441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974759_548530257185774_3873336191968563335_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVabaDlXKKMQ7kNvwGG2zkD&_nc_oc=Adnt_DMR7bQy6tGtZsKoqUCd96huljSUC5tkwxH-buoF_uSCfLdfY3nFd4yFeePDDkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrzsNXCo9_5ddN7L52J8rEnYMDh07MTQHTt3bxEty4Ug&oe=69BC02B7"}, {"file_name": "water.png", "id": "681223590152886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031565_681223593486219_5916754183577692195_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3uiZwuTRcAQ7kNvwGtHwL3&_nc_oc=Adkn3lHBE-0QRhVVMzW4XWnglHzto9onrbnzkVj0YzmmBpNnqAqVS3Q5eMUp2WmE95A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzg4jLJtfu1gHEfUDHnX_WTCk8sKjVME_ppuqKWBMv7aQ&oe=69BBFAA2"}, {"file_name": "Screen.png", "id": "793028973540074", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_793028976873407_8983501859714055577_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grH7v1MOovkQ7kNvwE22fA3&_nc_oc=AdnY3Xr3ddeqDEURkta6qQgmxDJUQcmrz9U26nJTwSPCbhbOk9JGOsjaMKBrvrhNtpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2SE8F29b8N7IggZT2rowJ_WB2QQr_xdfukD44EavjnQ&oe=69BBE9B9"}, {"file_name": "Drone.png", "id": "518820930051489", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974554_518820933384822_1330063616294728279_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qzJ0guQL1MQ7kNvwH8v09t&_nc_oc=Adlr63u0OrnvJTg-EFKAZtrSbYx_akVLLIchetOSFfKAq-L45Toxx_xLg6eqehXKYrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZon1fA-GJW-Y_Rd50O84ZO7wwaIG6zT4j2KAkOv_WnQ&oe=69BBF018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1045505907689964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507838910_1045505911023297_488340947037345495_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPoKq97qM4IQ7kNvwFuTmqP&_nc_oc=Adk_h9xbejYHRqG5xqyU7ZdSpts0aM_y-7qjRBCe4FmdwJxGKKZjEy8TgpHH9e-Oedo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPCZ-d26nOwzfWm7GtFnPJEMHSLm713GjtlIxkaLDhpw&oe=69BBE357"}, "display_name": "Flight 74", "keywords": ["Flight", "Simulator", "Flying", "Airplane", "Sim"], "long_description": "Do you have what it takes to survive and become the ultimate pilot? Fly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest.  Rated one of the Top 50 Games on Quest by Vrelity.\n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel. Your only chance for survival is to work with the cartel and prove your worth.\n\nFeatures:\n- Complex missions that will test your skills\n\n{2750905198401036}\n\n- Hand Tracking! Put down the controller and play with your hands.  Interactive cockpit. Flip switches, press buttons, punch windows, and more!\n\n{849356023396469}\n\n- Multiplayer! Dogfight against your friends! \n\n{574744495234388}\n\n- Quest 3 Graphics Updates and Improvements\n\n{1503648260255664}\n\n- Make use of your belongings in the cockpit including sun glasses, coffee, and guns!\n\n{498783152559639}\n\n- Solve puzzles in a flight game! Movie style campaign and missions!\n\n{1664355374355543}\n\n- Free Flight Mode with 7 Airports and over 2,000 square miles of scenery\n\n{764494538995077}\n\n- Cars, Birds, Cartels, Explosions and more! \n\n{1643006099819731}", "short_description": "Fly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest.  \n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "https://www.tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24074659455542760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824609_9705423732897605_803510412155846807_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAU9e8YKu10Q7kNvwEiI6MJ&_nc_oc=AdkTRhdZ_rayQcyacy8k0_iQggu22VsxS62FVjkAUvfPqW99AjV5LCVwFMhHBfDY314&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhsjLXOYh6NUX5tTG4R1lcPmJDm_u1sWXOMGMXAXF3Pw&oe=69BBFD78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight 74", 
899", "locale": "en_US", "screenshots": [{"file_name": "Trees.png", "id": "876081273523944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031512_876081280190610_3954857504188214429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJn_mhIpTz8Q7kNvwEQIsCu&_nc_oc=AdmoZvUMIBHbfqKUtWk2-POfNawi-XhJGPoJZFtDJx0K0Anbw71xrtTJq2stdcVmR9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftvYzBcTzthAtVXDGBXALLyHzuJPJnPiBm0yrNerNAX9w&oe=69A83DB4"}, {"file_name": "Airport.png", "id": "548530253852441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974759_548530257185774_3873336191968563335_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFYjixOabJEQ7kNvwH2ANhT&_nc_oc=AdnkLfsWpuDJEbvJ8O35N-18xFxLrMt896L0rmrfkKKDAhrKl8Mefq8JJoG8Hr3MxFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuhZvvN0AUCs2ihsk4EnVJ7z1UGLZOC_xmtmZCJnyLffA&oe=69A83C37"}, {"file_name": "water.png", "id": "681223590152886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031565_681223593486219_5916754183577692195_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2ESBbRjRcoQ7kNvwEnJeTO&_nc_oc=AdmUqKjG1zMgK1Z5h4ss__Ke4xj7XSQFA_UpoBucC18bBpuSgvg5l5gYuZNM7dD5sS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsrpdwdOxwxYXQm4Eu57xCr6pBbGXJC0Z1owff60308Tg&oe=69A83422"}, {"file_name": "Screen.png", "id": "793028973540074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_793028976873407_8983501859714055577_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss8REbRZnyQQ7kNvwHOGkWN&_nc_oc=AdkP79-TaOvWgg_iP9hA5Gc_xwTxWixtIRlscnnMYT-JrcjWnSoiRX5nGGOx-7T-BZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsC_-wdAkv3iVUZcj5BcwCX8jKjanCicMSFsS383KF8Sw&oe=69A82339"}, {"file_name": "Drone.png", "id": "518820930051489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974554_518820933384822_1330063616294728279_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygk129jaNAkQ7kNvwG6kSrZ&_nc_oc=Adk2GuNocorCTibm8SY6ACM6utkI1N_e2dHF2FdbDONaZl5S-ZBam70UVJ5mT6BcNNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_1KCUTQtWJH2wacbgOsGf27UHKl0K5r-GCV0WOJlNwg&oe=69A82998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1045505907689964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507838910_1045505911023297_488340947037345495_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWv3jynTegIQ7kNvwHfW93d&_nc_oc=AdkqE1lzuGA-EJTxAyl-Cb_kXyJ0Mo8SYjGlCMGj9tb7PveTQG6rcInmk8YOQ5tnwgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-5YVzEUrDIttRwlWZQZxpeX9q8BoALsDcLxqRVRCBpQ&oe=69A81CD7"}, "display_name": "Flight 74", "keywords": ["Flight", "Simulator", "Flying", "Airplane", "Sim"], "long_description": "Do you have what it takes to survive and become the ultimate pilot? Fly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest.  Rated one of the Top 50 Games on Quest by Vrelity.\n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel. Your only chance for survival is to work with the cartel and prove your worth.\n\nFeatures:\n- Complex missions that will test your skills\n\n{2750905198401036}\n\n- Hand Tracking! Put down the controller and play with your hands.  Interactive cockpit. Flip switches, press buttons, punch windows, and more!\n\n{849356023396469}\n\n- Multiplayer! Dogfight against your friends! \n\n{574744495234388}\n\n- Quest 3 Graphics Updates and Improvements\n\n{1503648260255664}\n\n- Make use of your belongings in the cockpit including sun glasses, coffee, and guns!\n\n{498783152559639}\n\n- Solve puzzles in a flight game! Movie style campaign and missions!\n\n{1664355374355543}\n\n- Free Flight Mode with 7 Airports and over 2,000 square miles of scenery\n\n{764494538995077}\n\n- Cars, Birds, Cartels, Explosions and more! \n\n{1643006099819731}", "short_description": "Fly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest.  \n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "https://www.tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24074659455542760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824609_9705423732897605_803510412155846807_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb6eq6fnk9QQ7kNvwGZ0u5V&_nc_oc=AdnhdG2JF4bto1bgp8dW4Ay0lCaOICDsgK_D_a8oIEgZPf3WmipZ_j3ebG97hFgUwtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuVSVv2dRQZLXaCkPnWMCX7SKXsCHneR7NbcJZpv3waCQ&oe=69A836F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight 74", 
vv6_T0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IIGooNIB1NH3-1aVKKAe442K2QxcBS_Cd622_k26ORQ&oe=6A145737"}, {"file_name": "Drone.png", "id": "518820930051489", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974554_518820933384822_1330063616294728279_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXi4iY5FuA8Q7kNvwGznSzO&_nc_oc=AdpVJ7PzqK6FqCOHHZOoxfGJOz5G5-1x7MBNFh7GSPdsnvdRKSnGW1LDXdM5AXNUo-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TbS7f-010gr7jzuocLUmxN8RkLlUKFviqNScC2h536A&oe=6A144498"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "558206456169730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984448_558206459503063_3938835359603651822_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=276EnQ6xq9AQ7kNvwGAy7Le&_nc_oc=AdobaWjr_6CgkqO7hr0qFXDBHkQtKQdqPh_cvZdCZ1045f9qsY4AcxN2Z_TscaRAAqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TO3kmPwivOVQr2Tn3Z8UFJRAqXu3w1amtn2L-GllMng&oe=6A144936"}, "display_name": "Flight 74", "keywords": [], "long_description": "Do you have what it takes to survive and become the ultimate pilot?\n\nFly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest.  \n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel. Your only chance for survival is to work with the cartel and prove your worth.\n\nFeatures:\n- Complex missions that will keep you thinking.  \n- Interactive cockpit. Flip switches, press buttons, and manipulate levers with your hand.\n- Make use of your belongings in the cockpit including sun glasses, coffee, and a hand gun.  \n- Solve puzzles in a flight game! \n- Movie style campaign and missions\n- 7 Airports and over 2,000 square miles of scenery\n- Explore vast landscapes ", "short_description": "Do you have what it takes to survive and become the ultimate pilot?\n\nFly missions for the cartel and experience a new genre of VR Flight Simulator, exclusively for the Quest. \n\nYour plane has experienced engine failure and you're forced to land at an unmarked runway off in the distance. Unfortunately for you, the runway is operated by a notoriously dangerous South American Cartel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "https://www.tasappsystems.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "704899683851867"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "983852204524673"}, {"status": "PUBLISHED", "id": "3551563131650770"}, {"status": "PUBLISHED", "id": "1423396126123209"}, {"status": "PUBLISHED", "id": "712828704948182"}, {"status": "PUBLISHED", "id": "1396910821789014"}, {"status": "PUBLISHED", "id": "1332425608527561"}, {"status": "PUBLISHED", "id": "1435265687799160"}, {"status": "PUBLISHED", "id": "1753631642028735"}, {"status": "PUBLISHED", "id": "3890848221177226"}, {"status": "PUBLISHED", "id": "1196911145122128"}, {"status": "PUBLISHED", "id": "1294002565198807"}, {"status": "PUBLISHED", "id": "1794990191314307"}, {"status": "PUBLIS
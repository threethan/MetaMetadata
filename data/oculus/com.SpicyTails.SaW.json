com/v/t64.5771-25/39031407_658680041244802_5284501359834431488_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ie8HTupmwMQ7kNvwGzBJvo&_nc_oc=Adncx01Huv8XW9IiKdnj7j5SiRjapuHTKQ4EHYv4tByPSe0WdWRT8CFAt8lCqyQca8I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftUFK-plJStZ3i8I57KKhs7_Nb5hb_4XazEa4LYz53XAA&oe=69A58DBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/KMNgMe", "id": "789478568120580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974836_789478571453913_7693851358599839744_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlJ1gxpxbS8Q7kNvwHPF4ff&_nc_oc=AdkPloN4DnMvwVFOpoGO91L7cRC7Y9gSqAafiOYGwz1Ebi-jcw7N5OW-0A797Nesvio&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsIK-9OSrlSrIGQ2sO_0e-htVn9ZORgzJes-0XWeHGxYA&oe=69A56AC8"}, "display_name": "Spice & Wolf VR", "keywords": ["VR", "anime", "SpiceAndWolf", "animation", "casual"], "long_description": "In order to achieve our dreams of entering the 2nd dimension, we will be working together with the original creators of Spice and Wolf to create a VR animation.\nAnime will evolve from something that is \u201cseen\u201d to something that is \u201cexperienced\u201d...\n\n-Story-\nKraft Lawrence is a traveling merchant who meets Holo, a beautiful woman who can transform into a wolf. \nAs they travel together they face many hardships, such as having to walk in the rain.\nIn order to avoid the sudden downpour, Holo and Lawrence take shelter in an old, abandoned water mill in the woods.\nThey huddle around a small fire and enjoy a slightly strange but relaxing time together.\nYou are able to share that time together with them.\n\nProduction Staff\nScenario: Isuna Hasekura\nCharacter Design: Ju Ayakura\nHolo\u2019s CV: Ami Koshimizu\nKraft Lawrence\u2019s CV: Jun Fukuyama", "short_description": "In order to achieve our dreams of entering the 2nd dimension, we will be making the popular light novel Spice and Wolf into a VR animation!\nAnime will evolve from something th
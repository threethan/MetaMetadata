qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3qO1paHcJGwhWwwrwTYT7RtYtNDEqpzDhYD3wGH99_g&oe=6A43B935"}, {"file_name": "migrated_image.png", "id": "809494589545435", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003255_712049082580530_942863746605252608_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmcyNPbGBvYQ7kNvwELNmA1&_nc_oc=AdqOzv6OgaLsSIcbCGOVMU589J6ztfxrdGSBIUhq2D3zZyRS0YD0BX2cHkvf90S-rEU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wfUNnWzdzA-lYN89DtD5Cr0aeIA05GRiuHLwqk78tuA&oe=6A43EFBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/gDsle9", "id": "3330150947010868", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974544_3330150950344201_6718744734157766656_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHmtm_zIMyYQ7kNvwGu0Y1v&_nc_oc=AdqBEzvdyVZ9nMFDAjCBOZiMfpo2plVL4pymRD3TJqXalQTgGpJQdI6HGJ7_yUWKjh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-raODdrVJGYB_3q_e-EHVUGTeHgVspQS_K7pw3ljQC7A&oe=6A43E201"}, "display_name": "Spice & Wolf VR", "keywords": ["anime", "animation", "\u72fc\u3068\u9999\u8f9b\u6599", "SpiceandWolf"], "long_description": "In order to achieve our dreams of entering the 2nd dimension, we will be working together with the original creators of Spice and Wolf to create a VR animation.\nAnime will evolve from something that is \u201cseen\u201d to something that is \u201cexperienced\u201d...\n\n-Story-\nKraft Lawrence is a traveling merchant who meets Holo, a beautiful woman who can transform into a wolf. \nAs they travel together they face many hardships, such as having to walk in the rain.\nIn order to avoid the sudden downpour, Holo and Lawrence take shelter in an old, abandoned water mill in the woods.\nThey huddle around a small fire and enjoy a slightly strange but relaxing time together.\nYou are able to share that time together with them.\n\nProduction Staff\nScenario: Isuna Hasekura\nCharacter Design: Ju Ayakura\nHolo\u2019s CV: Ami Koshimizu\nKraft Lawrence\u2019s CV: Jun Fukuyama", "short_description": "In order to achieve our dreams of entering the 2nd dimension, we will be making the popular light novel Spice and Wolf into a VR animation! Anime will evolve from something that is \u201cseen\u201d to something that is \u201cexperienced\u201d..."}]}, "developer_name": "SpicyTails", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "SpicyTails", "support_website_url": null, "website_url": "http://spicy-tails.net/saw-vr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "CASUAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "300358848823013"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1034340560247367"}, {"status": "PUBLISHED", "id": "515405720151523"}]}, "baseline_offer": {"id": "1034340560247367"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1573754480, "status": "PUBLISHED", "id": "1034340560247367"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3254529497897482", "version": "1.04"}, "id": "373283759968622", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBin
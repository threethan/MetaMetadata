ontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzY0bGmZAvcg4RziHYIEako7UeyKXyOUd3SQzisFmnJrA&oe=69BFE335"}, {"file_name": "migrated_image.png", "id": "217566276122551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_712049082580530_942863746605252608_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k98Bqumfja4Q7kNvwEdtJ2t&_nc_oc=AdnyiAUCquIRDwo0foX8UnjsbZx-L03xPSub0KEOwJZDF6C942bky3X3AkxWgD7OKzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDv6K-NUy4UhB-EFRyMQ0uidCwCZwU3bzm0Wo652T-bQ&oe=69BFE17B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spice & Wolf VR", "keywords": ["anime", "animation", "\u72fc\u3068\u9999\u8f9b\u6599", "SpiceandWolf"], "long_description": "Step into the world of Spice and Wolf, recreated in VR by the original creators of the popular anime and light novel series. \nAnime is now not just something you watch\u2014it's something you experience!\n\n# Story\nKraft Lawrence is a traveling merchant in a medieval world, who one day comes across Holo, a wolf deity taking the form of a girl. After a string of adventures, Holo decides to follow Lawrence along.\n\nHolo and Lawrence's journeys were not without troubles; one such case was when they were caught by surprise in a sudden thunderstorm. Running from the rain, the two find shelter in an abandoned water mill in the woods. As they gather around a small fire and wait for the sky to clear, a sweet and curious story unfolds...an all-new story that you will experience firsthand, from Lawrence's point of view.\n\n# Production Staff\nStory by Isuna Hasekura\nCharacter Design by Ju Ayakura\nVoice of Holo by Ami Koshimizu\nVoice of Lawrence by Jun Fukuyama", "short_description": "Step into the world of Spice and Wolf, recreated in VR by the original creators of the popular anime series! Experience an all-new episode of Holo and Lawrence's journey, seen from Lawrence's point of view."}]}, "developer_name": "SpicyTails", "developer_privacy_po
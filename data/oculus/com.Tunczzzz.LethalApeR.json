 strategic thinking, and nerves of steel. "}]}, "developer_name": "Tunczzzz", "developer_privacy_policy_url": "https://sites.google.com/view/lethalaperedux/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tunczzzz", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalaperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29799231189720310"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2312182322501551"}]}, "baseline_offer": {"id": "2312182322501551"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747669380, "status": "PUBLISHED", "id": "2312182322501551"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29859510270359068", "version": "0.1"}, "id": "9810996765645673", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29799231113053651", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29859510270359068"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "9810996765645673"}]}
&oe=6A68A0E8"}, {"file_name": "9.png", "id": "1004204861810720", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822461_1004204868477386_9180280345956124147_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEjUA-uNOsgQ7kNvwHci0SO&_nc_oc=Ado7zBnYFJFkgzlGVE9Q5RJZyEzjRGKwP281nfp51dzz3tEZj-GQb7DBAREiF66__1M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmqnSVUtVeJAr0vYp91zH6I6TCl4D5TyTc72y_Xj2w7w&oe=6A689725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "693000563308912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824592_693000566642245_4541106705637156421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsZqnxbmBBEQ7kNvwH4yhUn&_nc_oc=Adr6eo9PcRn4d3SNMmWXbeLIbKXa9CmrqgH_EtxV93FBdakIwTPKpfD_-GLIPnWjmVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUiHsEmv3-TpaU_kBtf55Tg9QhQa1j5PVRyORKUMOFWw&oe=6A68B683"}, "display_name": "EHS Academy", "keywords": [], "long_description": "Welcome to EHS Academy, the ultimate VR learning platform for professionals and organizations committed to excellence in Environmental, Health, and Safety (EHS) management. Our cutting-edge virtual reality courses offer immersive, hands-on training experiences designed to enhance your knowledge and skills in workplace safety, occupational health, environmental protection, and fire safety.\n\nKey Features:\nComprehensive EHS Training: Access a wide range of courses covering critical topics such as hazard identification, risk assessment, fire safety protocols, environmental regulations, and occupational health standards.\nImmersive VR Experience: Step into realistic scenarios that simulate real-world environments, allowing you to practice and master safety procedures in a controlled, risk-free setting.\nUp-to-Date Content: Stay compliant with the latest industry standards and regulations, with regularly updated courses designed by EHS experts.\nInteractive Learning Modules: Engage with interactive elements and practical exercises that reinforce learning and improve retention.\nCertification and Progress Tracking: Earn certifications upon course completion and track your progress with our intuitive dashboard, perfect for individual learners and corporate training programs.\n\nWhether you're an EHS professional, a business owner, or an employee looking to enhance your safety skills, EHS Academy provides the tools and knowledge you need to create a safer, healthier, and more sustainable workplace.", "short_description": "EHS VR is a platform offering ready-made virtual reality (VR) applications designed to enhance the effectiveness and quality of employee training. Their comprehensive training programs cover occupational health and safety (OHS), fire protection, first aid, and specialized courses. \nEHSVR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skillsive.com/informations/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BHP VR SP. Z O.O.", "support_website_url": null, "website_url": "https://www.ehsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9894462520576705"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1877216699445747"}]}, "baseline_offer": {"id": "1
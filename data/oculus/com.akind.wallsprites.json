3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLyMVaI004lSneVMVBQjMFrXU_L3llXlPEt428wNRGKQ&oe=6AFC8331"}, {"file_name": "02-Bell-levels.png", "id": "3189231547953576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/773875811_3189231551286909_1609600932390412809_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgZccma2HhoQ7kNvwHQ8bGh&_nc_oc=AdrvJuIv3EjIa7EfiqlP5lB6oq_-s-l-TYHcVA3DK6kNFxKc_6K1cGPLCOiu1V-fIbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSWabFTEKCtgK02RvLP0PWnxr8-hOhghJM5eg1Sipp0A&oe=6AFC622F"}, {"file_name": "06-Tic-tac-toe-video.png", "id": "1126333259951952", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604317775_1126333263285285_4133669989403459115_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd_RWNBqJiwQ7kNvwEkuPgE&_nc_oc=AdrbAkSaTz6cZQz6cjAV4dY_MIH7rK9sQop_ne2uCpd8DGQzJ5tKCTXs5QTrpsWueSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9-a7mPYY6cGwyJ4VqW0mjE1kaPKv2pZqQTyIBnCbDXQ&oe=6AFC86A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440-TitleOnly-RGB.png", "id": "1003247369469752", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/654985632_1003247379469751_4821677314097257371_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AAjQAm7VuEQ7kNvwH7VSas&_nc_oc=Adqs5JYp3SANUbIixNlgON_b91UuApmXL2fA5LLGxUDtDrCveSBSBA4PSYNd7sX98-k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVveRARJXkiTeXZrCd-ZEXatgSQ2P1HYz6fS0c-HIyHw&oe=6AFC8595"}, "display_name": "Wall Sprites", "keywords": [], "long_description": "Your room. A little magic. A friend to share it with.\n\nWelcome a glowing sprite into your space. Catch the stars it throws, share a melody or settle into a quiet breathing break. Wall Sprites blends playful challenges and gentle company in a single-player mixed-reality experience.\n\nFIVE GAMES, 100 LEVELS\nStart small and see how far you can go:\n\u2022 Catch a Star: react to faster throws from changing directions, with up to four stars at once.\n\u2022 Firefly Trail: catch glowing lights before they fade.\n\u2022 Star Pairs: match pictures on bigger, more challenging boards.\n\u2022 Follow the Melody: remember longer bell sequences and earn points for your recall.\n\u2022 Tic-tac-toe: take on an increasingly skilful sprite.\nReplay favourites, beat your best scores and unlock the next challenge.\n\nA MOMENT JUST FOR YOU\nPlay three notes and hear your companion answer. Slow down with four gentle breathing guides, choosing a visible room, dim background or black backdrop. Follow at your own comfortable pace, with no breath holds.\n\nMORE LITTLE FRIENDS TO MEET\nTen daily minutes, added across visits, earn a play day. Unlock a companion every seven play days and a rare one every 90. Days use UTC; no streak required.\n\nGames and earnable companions are included. Fixes stay free; future expansion packs are optional purchases.\n\nHand tracking and supported controller interactions; some gestures need hands. Progress is saved locally on your headset. Stay seated for breathing. For relaxation, not medical treatment.", "short_description": "A glowing little friend, right in your room. Catch stars, chase fireflies, match pictures and make music together. Explore 100 levels across five games, then unwind with gentle breathing guides. A playful mixed-reality companion for lively moments and quiet breaks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wall-sprites.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Akindquest3", "support_website_url": "https://wall-sprites.vercel.app/support.html", "website_url": "https://wall-sprites.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291
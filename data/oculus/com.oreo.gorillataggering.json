lowing art installations throughout the game world."}]}, "developer_name": "oreo and system", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-taggeiring/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "oreo and system", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-taggeiring", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8103793783012049"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8219201971471229", "version": "1"}, "id": "2491039034434047", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6875225902535516", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8219201971471229"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2491039034434047"}]}, "change_log": null, "created_date": 1724761783, "id": "8219201971471229", "version": "1", "version_code": 70000, "release_status": "RELEASED", "sta
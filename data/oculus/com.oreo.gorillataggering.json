t8ba2EcT6Ho3uKDmJxwgV-cHWHARpqSn4pA&oe=699C497B"}, {"file_name": "Screenshots_5_Images.png", "id": "980069583869571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035466_980069587202904_3618765923851735267_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq8G5JK2-f8Q7kNvwHBxjM9&_nc_oc=Adkmeqmmgze4VE6HXwtTXLklvkAcNnfLwagDDXRkZ-mLEc1G_XPJlln3IwEVyOntRK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfskNU_hUSovu4oRF08BsGwyLq0AY9yvgU1JK7F2P6i44Q&oe=699C5A26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Taggering", "keywords": [], "long_description": "\"Gorilla Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Gorilla Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world."}]}, "developer_name": "oreo and system", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-taggeiring/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "oreo and system", "support_website_url": null, "website_url": "https://sites.google.com/view/
Sf7rnZnpQO9NUnhuwHon8gZBp7O22wa8G9Q&oe=69A2E0FB"}, {"file_name": "Screenshots_5_Images.png", "id": "980069583869571", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035466_980069587202904_3618765923851735267_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrpajNYNPjcQ7kNvwFGSt7d&_nc_oc=AdnA7GpJEyeaz6NpMn2ozY9g62iUNTFKI7n8UaAehLoI00I9QAy8vQWTjFZYo3ZxXA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsa-YWTmu2dIcMWpgUTCnWNbNj6c3fpgWzFjhExGWSSHQ&oe=69A2F1A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Taggering", "keywords": [], "long_description": "\"Gorilla Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Gorilla Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world."}]}, "developer_name": "oreo and system", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-taggeiring/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "oreo and system", "support_website_url": null, "website_url": "https://sites.google.com/view/
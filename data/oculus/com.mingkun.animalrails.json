gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej1EQBb9oV4Q7kNvwG7mwba&_nc_oc=AdoeOAChHrQ5TBIerbq5RQiWI7WfUnHdPiko0yCk_1y7Y-8KLR2r1gQpa_UYYJsrggo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXHd_zrDSgAyizabirGS-TcHxbRrinIe6_cuQwh6dMIA&oe=6B10668C"}, {"file_name": "260720ar1.png", "id": "1513449583849915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_1513449587183248_2886774431150526370_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fU5Qorh1a8Q7kNvwEtjZVV&_nc_oc=Adrzc5Kdog8_u1muOYt8FtoItWanA-UF1XkPGpRPCWz_W_AV9bskEIjZ_SbnYDgdhJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhcHf8PRtzdSMhVjZUcxkV7em_WBkOrXDUjvolZNkCsg&oe=6B105283"}, {"file_name": "260720ar2.png", "id": "1340151857770024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620965_1340151861103357_3147547027566872818_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVq2-c4qiQ8Q7kNvwEntq7h&_nc_oc=AdpcUDwRSjiJ9npH1e4UzMNZaXblbQ-ssdwYlMoymgL4TQjNJYUAYGRYHzo4tZ3Ct6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUC41GlmoC4AgUX5qDq7_y3whjXTH3W18hlYmbcnLxclw&oe=6B105A6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Animal Rails", "keywords": ["Rails", "Animal", "Monke", "West", "Extraction"], "long_description": "Join Our Amazing Community and Play Before Everyone Else Now!\n\n**https://discord.gg/animalrails**\n\nHop on the WILDEST train ride of your life! \n\nWelcome to an unhinged, alternate Wild West. \n\nAn evil glowing goo called \"Blackblood\" ruined everything. Now the land is full of rock skinned zombies called the Ash Walkers. \n{2156223458291882}\nThey\u2019re drawn to loud noises and heat, and really, really want to eat YOU. \n{1344185204586072}\nYou're trapped inside a massive quarantine zone. Your only way out is that rusty old bucket of bolts. Smash through mutant zombie hordes. \n{1830430721276152}\nOutrun crazy bandit gangs. Trade for gears at secret stations.\n\n{27790948063901074}\n\nYour ultimate goal? Max out your train. Pull the lever. And CRASH straight through the giant iron wall to freedom.\n{1980017259329316}\nKeep surviving. Keep upgrading. Conductors, let\u2019s ROLL! \n\n\n", "short_description": "You will start with a rusty old train and upgrade it into a massive, heavily armored rolling fortress. Smash your way through hordes of mutant zombies, outrun wild bandit gangs, and trade for epic gear at secret stations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mingkstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ming Studio, Gallantry Works", "support_website_url": "https://discord.gg/animalrails", "website_url": "https://www.mingkstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "28044393925186447"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1487711596532169"}]}, "baseline_offer": {"id": "1487711596532169"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793815440, "status": "PUBLISHED", "id": "1487711596532169"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"n
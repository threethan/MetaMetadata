24953269", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620559_1536469128286602_8233412283562232521_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4yoF7fETQsQ7kNvwEqHoaV&_nc_oc=Adrj31wpWMk71Dm2LHIHCEF0yG5ZJR4CMBqCEmYnMfABgKgnMIeSRnLiZ4CK39SyQ0A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrgwFE_IfQ01HC8gmoAUNxJQY9-W6tWOi2bO1mxtsGfg&oe=6AFC5E1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "origin2.png", "id": "4743583502541173", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_4743583505874506_7230381009634251495_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LmKz9yacvQQ7kNvwG-WA8n&_nc_oc=AdoTA_CUXwYaFSeRr21RHCxlQSOmH4HSYKSdu4uYvooGiBO4iVkS_3ZP34Zmfgdc7WM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkPUjeZN_iden1Wrn4B82qE_0qfPflgTAovvB49kau4g&oe=6AFC6507"}, "display_name": "Animal Rails", "keywords": ["Rails", "Animal", "Monke", "West", "Extraction"], "long_description": "Join Our Amazing Community and Play Before Everyone Else Now!\n\n**https://discord.gg/animalrails**\n\nHop on the WILDEST train ride of your life! \n\nWelcome to an unhinged, alternate Wild West. \n\nAn evil glowing goo called \"Blackblood\" ruined everything. Now the land is full of rock skinned zombies called the Ash Walkers. \n{2156223458291882}\nThey\u2019re drawn to loud noises and heat, and really, really want to eat YOU. \n{1344185204586072}\nYou're trapped inside a massive quarantine zone. Your only way out is that rusty old bucket of bolts. Smash through mutant zombie hordes. \n{1830430721276152}\nOutrun crazy bandit gangs. Trade for gears at secret stations.\n\n{27790948063901074}\n\nYour ultimate goal? Max out your train. Pull the lever. And CRASH straight through the giant iron wall to freedom.\n{1980017259329316}\nKeep surviving. Keep upgrading. Conductors, let\u2019s ROLL! \n\n\n", "short_description": "You will start with a rusty old train and upgrade it into a massive, heavily armored rolling fortress. Smash your way through hordes of mutant zombies, outrun wild bandit gangs, and trade for epic gear at secret stations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mingkstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ming Studio, Gallantry Works", "support_website_url": "https://discord.gg/animalrails", "website_url": "https://www.mingkstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "29291794683779692"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620532_2223177331880683_5845739130298248832_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boI1D3Kt1xYQ7kNvwGtj2JH&_nc_oc=AdqKhCIyBaP8VbRPAFPPb-pPZs_or7i7qSMDUlnUI4oTMvHhLX_R3bZ2vluzYToNdMQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFTwPHIXBLxPOSGPBiszNs7f2HDd_u7c_nLovW6_i_Rg&oe=6AFC682F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Animal Rails", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"to
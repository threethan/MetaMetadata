om/v/t64.5771-25/499620921_1513449587183248_2886774431150526370_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8j6OKUubLgQ7kNvwFGYNQz&_nc_oc=AdoForIpjv_3ZUOvdl0Hl2uE6htUg1xOCIbrtWnpNdWe4nSVaNhlwlIRrmgVEmaCAz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROY_gU7VtwIPHlrLpMkXJ3PHgO5keN0dpl9EnGMDU4Cw&oe=6B0DAF83"}, {"file_name": "260720ar2.png", "id": "1340151857770024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620965_1340151861103357_3147547027566872818_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fkpC3UYKDkQ7kNvwGQOspm&_nc_oc=AdogzHPw4qY8qIJhGZ8lMjqWUlTEzodhTmXK8hkX37RlzWdqFNDDULfZ7QpEv42ZSwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCXUvmexsN8wO-zJDZ3fp9w3KuWRf0E-_dWls4Du5pfA&oe=6B0DB76A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Animal Rails", "keywords": ["Rails", "Animal", "Monke", "West", "Extraction"], "long_description": "Join Our Amazing Community and Play Before Everyone Else Now!\n\n**https://discord.gg/animalrails**\n\nHop on the WILDEST train ride of your life! \n\nWelcome to an unhinged, alternate Wild West. \n\nAn evil glowing goo called \"Blackblood\" ruined everything. Now the land is full of rock skinned zombies called the Ash Walkers. \n{2156223458291882}\nThey\u2019re drawn to loud noises and heat, and really, really want to eat YOU. \n{1344185204586072}\nYou're trapped inside a massive quarantine zone. Your only way out is that rusty old bucket of bolts. Smash through mutant zombie hordes. \n{1830430721276152}\nOutrun crazy bandit gangs. Trade for gears at secret stations.\n\n{27790948063901074}\n\nYour ultimate goal? Max out your train. Pull the lever. And CRASH straight through the giant iron wall to freedom.\n{1980017259329316}\nKeep surviving. Keep upgrading. Conductors, let\u2019s ROLL! \n\n\n", "short_description": "You will start with a rusty old train and upgrade it into a massive, heavily armored rolling fortress. Smash your way through hordes of mutant zombies, outrun wild bandit gangs, and trade for epic gear at secret stations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mingkstudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ming Studio, Gallantry Works", "support_website_url": "https://discord.gg/animalrails", "website_url": "https://www.mingkstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "28044393925186447"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1487711596532169"}]}, "baseline_offer": {"id": "1487711596532169"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793815440, "status": "PUBLISHED", "id": "1487711596532169"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29623865707239253", "version": "0.3.29"}, "id": "1309538144471837", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27139353245690524", "is_concept": false, "latest_released_binary": {
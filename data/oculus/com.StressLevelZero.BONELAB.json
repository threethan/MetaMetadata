468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p9hzBA74_wQ7kNvwHhLmaI&_nc_oc=AdqVPn_LOYNUcZtxVbk1iIkmcEkGovj4oW8lP7MCVK0ZW4YEoTlgoC8A6l8A1LypnWI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjBaLVnX8CAJF9DTmhsLeEmjjg6jimZZtKjXLJfRHn7A&oe=6AA54F66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape02.png", "id": "678227726773583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031473_678227730106916_8073633749074926407_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Am1Ua1kV4Q7kNvwHDkX7a&_nc_oc=AdrFUJ46-pXIQ9vCUYcqh7cxKzE8n7teZSTIZmejWYfc9yIC4YW7v9N7RPvIputVkeM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKUEPkF2WxyzHo_KtwLwn8XOwB0l8C65hoUXqw2EqJvA&oe=6AA546C5"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate. Discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n-Physics to the core. Boneworks' realistic physics systems fully improved and polished. Interact with the game world with consistent confidence.\n-Visceral VR combat. Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n-Be anyone you want. Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n-Layered Narrative. After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://stresslevelzero.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Stress Level Zero", "support_website_url": null, "website_url": "http://www.stresslevelzero.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "705177533987367"}}]}, "scheduled_offers": {"count": 43, "nodes": [{"status": "PUBLISHED", "id": "905434952575615"}, {"status": "PUBLISHED", "id": "1604893087233287"}, {"status": "PUBLISHED", "id": "856355793885348"}, {"status": "PUBLISHED", "id": "1337029434735003"}, {"status": "PUBLISHED", "id": "2727290617467902"}, {"status": "PUBLISHED", "id": "1266324011834915"}, {"status": "PUBLISHED", "id": "527264627121639"}, {"status": "PUBLISHED", "id": "1825175771645671"}, {"status": "PUBLISHED", "id": "575979328678217"}, {"status": "PUBLISHED", "id": "819980623448446"}, {"status": "PUBLISHED", "id": "1147344013036940"}, {"status": "PUBLISHED", "id": "974815394185185"}, {"status": "PENDING", "id": "6465859146778623"}, {"status": "PUBLISHED", "id": "254687780232408"}, {"status": "PUBLISHED", "id": "10567
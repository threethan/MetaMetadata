oh=00_Afs4y1xIWWfSPEOWsaGsBziTP9SQnzCyCBZFvuz_5-G_gw&oe=699EF92F"}, {"file_name": "LAB_Stills_Q2_001sg_00003.png", "id": "389127249462025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974460_389127252795358_5040822551071372763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeGa2yjp0L4Q7kNvwEiO0oM&_nc_oc=Admtuvm0Ty85l-aHufGrMV9ZDoihRQBi84KNAuzkQBTxRULiKd8ipalMrZ7gmuBgfy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvUtfWxId0crcbFi7xOxpMwEo4aUOWa3Aidr0nmZPedhA&oe=699EE320"}, {"file_name": "LAB_Stills_Q2_001sg_00000.png", "id": "308755411392186", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982719_308755414725519_1672085077156382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nM9T_JAlSBIQ7kNvwG7FU6U&_nc_oc=Adk_Wb4usAPzLN_FWDCxCep6d5sfZzq6v_9TCTtROzWDh_G-6TbCSZz41LHzm2glLPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfumKmXXcQwbDLxakztGXImh-2crNyjuA9pGZDXdatb_nQ&oe=699ED8EA"}, {"file_name": "LAB_Stills_Q2_001sg_00004.png", "id": "310500637820553", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_310500641153886_7852521238477763029_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9jvIN92qW8Q7kNvwF2DFKs&_nc_oc=AdnGa6_tQtZjq2KgY9DnoUYY3xrNMWekfIirDCLk0BKtXc34LSHo9KOqskfArqzHRAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfscGwRYCSau7UPNOy2G_vBvBAn0H9F-iaToY1kb8Sp0iw&oe=699EE811"}, {"file_name": "LAB_Stills_Q2_001sg_00001.png", "id": "703799244078928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doWFqDxzuGYQ7kNvwGj4Rki&_nc_oc=AdnqYHL4XLhq07MWhSGbmqTyilrI3xZYcfejCDMmmPVzg2GT0zqIS_IfpqcpY-BtTLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft_xCtEm5NDWKU6V6q9p7-VbGEUNSrt51phvydza1BJhw&oe=699EF4E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lab_Quest_Landscape_004.png", "id": "805233717145179", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974736_805233720478512_5465263039459601720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wmi-n65DWHYQ7kNvwGXNpXr&_nc_oc=Admy1fppFFhFvrF91Y8Jn302zlbnnWaV-hTBTypB8Y-R8ADNVctlvah6CdE5sZqksHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftPjwcVRmk3yGeNjFEzexcK3sgRf0OJJrNuv6IHLg5vdQ&oe=699EF031"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate, discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n- Physics to the core: Boneworks' realistic physics systems have been fully improved and polished. Interact with the game world with consistent confidence.\n- Visceral VR combat: Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n- Be anyone you want: Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n- Layered Narrative: After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.\n\nMATURE CONTENT WARNING\n\nPlayer uses physical combat, including firearms, melee weapons, and bare hands, to fight enemies ranging from robots to humans. Enemies will exhibit blood splats on their bodies and the environment around them. Player is able to harm and kill themselves as well as be damaged and killed by their environment.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]},
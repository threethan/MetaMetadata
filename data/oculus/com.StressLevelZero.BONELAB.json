oh=00_AfuXv9yUEV0wvo0gpaC6o_BdHAmif8dAQhQzlXT6PKB-QQ&oe=699DA7AF"}, {"file_name": "LAB_Stills_Q2_001sg_00003.png", "id": "389127249462025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974460_389127252795358_5040822551071372763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGlLdPgI78cQ7kNvwFULCvW&_nc_oc=Adke8eQTlEPUs2TWjsQoItcekxlLbQOc-u5PJWoktblzhUkXrCoz94bEDQhlTyDRTOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-RAH3K08OL2fkLvtczPxjhEw0SRHSPo3NBsljnZkqwQ&oe=699D91A0"}, {"file_name": "LAB_Stills_Q2_001sg_00000.png", "id": "308755411392186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982719_308755414725519_1672085077156382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nM9T_JAlSBIQ7kNvwFGb2-5&_nc_oc=Adnb4GdwBD23Bex1Mf5NbbEVMAiDf54rDc_lca0UQ8LORB6lpXDBAptSdWu7UAVQHNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_MKvpDKw37LqpBERcE0z-PJv9Gi-KhSPdrdhAGAfcBQ&oe=699D876A"}, {"file_name": "LAB_Stills_Q2_001sg_00004.png", "id": "310500637820553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031643_310500641153886_7852521238477763029_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9jvIN92qW8Q7kNvwGgNfcD&_nc_oc=Adm6LRJltmvPtrDzCmV90U4acJ2q6Wo6CmSfRK_CVLdue4nYt2GFJzj6GOB1FlKelcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0XhYN6ThJ_iyMa04xVVQYfuxm9eAQTeWmKh8dSNmBHg&oe=699D9691"}, {"file_name": "LAB_Stills_Q2_001sg_00001.png", "id": "703799244078928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doWFqDxzuGYQ7kNvwGzcs-g&_nc_oc=Adn5YsqdBFZuRbyIeg3-GeeUz6MhcH0mAhiwK4cg8WQe0C1dtF-ErJczhVuCXnwZaWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsG-lnZwB8r2pSYzv2TOZ755hpNodcrejHgj12THVxlzQ&oe=699DA366"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lab_Quest_Landscape_004.png", "id": "805233717145179", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_805233720478512_5465263039459601720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46ke_ZAPaJ4Q7kNvwGD0Cgq&_nc_oc=AdmZvHy_Dgm_fCyhihPuOSEoOnGFEtfOfHBHoIlui0pG4fgYxW7YQDUDREWL8MHHPdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afse69YDPOZ5ZJeQVtweogP5xNxUa_NIYp5ec4zZ8rURvQ&oe=699D9EB1"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate, discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n- Physics to the core: Boneworks' realistic physics systems have been fully improved and polished. Interact with the game world with consistent confidence.\n- Visceral VR combat: Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n- Be anyone you want: Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n- Layered Narrative: After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.\n\nMATURE CONTENT WARNING\n\nPlayer uses physical combat, including firearms, melee weapons, and bare hands, to fight enemies ranging from robots to humans. Enemies will exhibit blood splats on their bodies and the environment around them. Player is able to harm and kill themselves as well as be damaged and killed by their environment.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]},
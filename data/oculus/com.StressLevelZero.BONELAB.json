=00_AfvxaBL-csmAXZCyNSRZ_FfBCSAQfxWyG_l9oWzSo9v7rQ&oe=699861AF"}, {"file_name": "LAB_Stills_Q2_001sg_00003.png", "id": "389127249462025", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974460_389127252795358_5040822551071372763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59r8HS_IZeAQ7kNvwHbS09Y&_nc_oc=AdkwwT2LYulb2BedPC3TZVM-akppS6tmOGpDBkgoLLzBN_5WCPEJZmsDmedGzB9_hpE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afud1HJbwana3JolXFRyf8lMLjHK3k3jQSyIdmg1cqWzLA&oe=69984BA0"}, {"file_name": "LAB_Stills_Q2_001sg_00000.png", "id": "308755411392186", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982719_308755414725519_1672085077156382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMcxm31rAcUQ7kNvwE4XyQy&_nc_oc=AdnytrMhw8PjkeWagZBOncYutMriZ8cWksnpekGyO03GeiHh24eR0lBk-4RAyjmEOD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsnuvf-p9hBadZc3GVPRIOwAjMoLj6itDUy51EOE6oFhw&oe=6998416A"}, {"file_name": "LAB_Stills_Q2_001sg_00004.png", "id": "310500637820553", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_310500641153886_7852521238477763029_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw4OegoHd1cQ7kNvwH1GPXq&_nc_oc=AdkdxQtby1BRm6OQfI-33Nze_kUJrFckf1QAa7JaB6htvfHCZT6AnDFlorhT5gItQJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs5gj7ykL8zRsLWEBAP2E4b12MbEoApV5KBnK259ImyAQ&oe=69985091"}, {"file_name": "LAB_Stills_Q2_001sg_00001.png", "id": "703799244078928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwBB6YL6P8QQ7kNvwG5g7wd&_nc_oc=AdnJ4vZgfBcgNJwTQW5Ba_f5TkXY2l75ZYyIrTyrlDW1r_ZoV3lBs48l3Pa1SfQdS60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvooIdEi9Z3WIy0g6d5U3APR2ynG2hkWFxln3teznfEWw&oe=69985D66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lab_Quest_Landscape_004.png", "id": "805233717145179", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974736_805233720478512_5465263039459601720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHbIT8lp5B8Q7kNvwHezTpJ&_nc_oc=Adk0F-pED5FhPUwe3ZpMxT0iOUG497ir7qfXg_GTOiTC0GdcLnNW8M95sJGh6BTVVXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfviMnb0QQWTp_THCCa58PUOgtABfeV7fxbm7d1D560iyA&oe=699858B1"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate, discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n- Physics to the core: Boneworks' realistic physics systems have been fully improved and polished. Interact with the game world with consistent confidence.\n- Visceral VR combat: Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n- Be anyone you want: Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n- Layered Narrative: After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.\n\nMATURE CONTENT WARNING\n\nPlayer uses physical combat, including firearms, melee weapons, and bare hands, to fight enemies ranging from robots to humans. Enemies will exhibit blood splats on their bodies and the environment around them. Player is able to harm and kill themselves as well as be damaged and killed by their environment.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]}, "
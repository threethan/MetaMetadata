oh=00_AftXIA_xPohPmnnBvxD--Wc7uK6VYmNFIZKBA-JzAde1Ug&oe=69A590AF"}, {"file_name": "LAB_Stills_Q2_001sg_00003.png", "id": "389127249462025", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974460_389127252795358_5040822551071372763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0MjH53syb0Q7kNvwFx5ZV8&_nc_oc=AdlJlwBWZJM-V8Wsmz9IyVqtKP8-gAURbpi35Pzp141VzSabaCmnQGyo9sEkpU6ljm0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsn-tQ_RGImuAzO_DSKk-AZNsVd8jgqHIY8S_uqoeOODA&oe=69A57AA0"}, {"file_name": "LAB_Stills_Q2_001sg_00000.png", "id": "308755411392186", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982719_308755414725519_1672085077156382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uKr9Ev_VncQ7kNvwHAJ3bO&_nc_oc=AdkUSyfiSvphbVL0q5gpyOY14RAmc-Db7nas-KBfjSmNcMBF0YiIknqGh6AxPFYuz0U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs5n69IorWeooSsYBb8edOXeYwPWhTUHQ5cfGVrUgImYw&oe=69A5706A"}, {"file_name": "LAB_Stills_Q2_001sg_00004.png", "id": "310500637820553", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031643_310500641153886_7852521238477763029_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZFAKv9WxzwQ7kNvwG_mNGu&_nc_oc=Adk7GzI4160VYVQCOxuhY31G3E872gRg1HfvXYo8bcfGGtRgrfUC50cEJ7lIDim8sKw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfubD0zHrielgyYfO-wwNA6mCpAi4ZYtpLNjqb_K85r83A&oe=69A57F91"}, {"file_name": "LAB_Stills_Q2_001sg_00001.png", "id": "703799244078928", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul6yRz325WQQ7kNvwEoA-l3&_nc_oc=Adm4hTsf_TVqBIMRuXBJSYf9MC5nWCUwcxXXhz-omuuH6nO_HyHpmoUmvYeTeelmyCY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfswKGBvSFGOerSO5JKU-2JuMPD8HcjBq6CxDTr2U0jHqg&oe=69A58C66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lab_Quest_Landscape_004.png", "id": "805233717145179", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974736_805233720478512_5465263039459601720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK_0IGH2WMIQ7kNvwFm-YdA&_nc_oc=AdmkOUeGRj33MnDDSBUfuZhr7kOExvn6GKqe5EjBFXgptVuoU96oLQoWopdbDwsR3_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afuh2Meq0LMpkKpu9imgis7ClPTEjYUnqidCcS01Rdrr0w&oe=69A587B1"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate, discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n- Physics to the core: Boneworks' realistic physics systems have been fully improved and polished. Interact with the game world with consistent confidence.\n- Visceral VR combat: Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n- Be anyone you want: Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n- Layered Narrative: After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.\n\nMATURE CONTENT WARNING\n\nPlayer uses physical combat, including firearms, melee weapons, and bare hands, to fight enemies ranging from robots to humans. Enemies will exhibit blood splats on their bodies and the environment around them. Player is able to harm and kill themselves as well as be damaged and killed by their environment.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]},
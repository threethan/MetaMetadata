oh=00_AfsLkObYXSkwytg5K96SHMq68gJ-VYYeqqCUq05dIojG2w&oe=69A04AAF"}, {"file_name": "LAB_Stills_Q2_001sg_00003.png", "id": "389127249462025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974460_389127252795358_5040822551071372763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeGa2yjp0L4Q7kNvwFQjZeA&_nc_oc=Adm16HfgHp9c_MUUy9IQrI_8csxeXkNGPympahdsySFYgw518FQgY3PoClVysuQwgD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvCXGVKf0ycya1ktQ-KRqnuN5NAlgNARDYUnK8DTJO4vw&oe=69A034A0"}, {"file_name": "LAB_Stills_Q2_001sg_00000.png", "id": "308755411392186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982719_308755414725519_1672085077156382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sgsm1fyFP0Q7kNvwFbgBpV&_nc_oc=Adm9x11VkzFgSSCs6pjigf746EC6cr51hGZLguSITuBsuOZPyGabyF7FHaEL3n7iEB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlyzncvCgPnM9rjBFZuJc6M3yDgRYajRUpaRSUOJUfig&oe=69A02A6A"}, {"file_name": "LAB_Stills_Q2_001sg_00004.png", "id": "310500637820553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031643_310500641153886_7852521238477763029_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9jvIN92qW8Q7kNvwEcdvpG&_nc_oc=AdkN2zpCP5sLeKqyfInpfWnKHrDzCjNkSePI4cIutggTwHIikjCIS_nQgVLBwc38v4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfubOhMih_evrOr3bFBQ_TdBQKGXvZGP6huiPyjQaCySTQ&oe=69A03991"}, {"file_name": "LAB_Stills_Q2_001sg_00001.png", "id": "703799244078928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doWFqDxzuGYQ7kNvwGN7b9r&_nc_oc=Adm72hSi7uUjBpkDqWB5Cl4P_tUSt8DdN8tGh16hlC8pQ9wxmMtSHHb5zzKmC2uInkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftIEi7QpFZvlJ-LrizumCPpgenpsGEUg_MOc-FvrVSfuA&oe=69A04666"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lab_Quest_Landscape_004.png", "id": "805233717145179", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_805233720478512_5465263039459601720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wmi-n65DWHYQ7kNvwHeYn7e&_nc_oc=AdkGeljYFN7Fhu6bDSFHWpI4mm7YfNQfFNFGTup4sPLzHtu1Ago66B0Yx0hXfdcf5n0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5kEnUW7E6VV6WT5Ty6h8ZpbjBjPVz8YgKNNOcyiMvsA&oe=69A041B1"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate, discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n- Physics to the core: Boneworks' realistic physics systems have been fully improved and polished. Interact with the game world with consistent confidence.\n- Visceral VR combat: Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n- Be anyone you want: Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n- Layered Narrative: After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.\n\nMATURE CONTENT WARNING\n\nPlayer uses physical combat, including firearms, melee weapons, and bare hands, to fight enemies ranging from robots to humans. Enemies will exhibit blood splats on their bodies and the environment around them. Player is able to harm and kill themselves as well as be damaged and killed by their environment.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]},
oh=00_AfthHnh5m3dusvWhGuhodEkax0OKjA96ov1j9VEFJ1bS9Q&oe=69A6E22F"}, {"file_name": "LAB_Stills_Q2_001sg_00003.png", "id": "389127249462025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974460_389127252795358_5040822551071372763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdNl-hrFK68Q7kNvwHIHdWP&_nc_oc=Adknpm5gzD8_zSukMuea-PtIwtT7Q0pzh9SGP-vmNKIYXlzJwZwdE1QVQWw4oYi0LJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4wyHS0OA_hC8hYhoqMFxJBhLrew4lPSgHGOzqumi7Cg&oe=69A6CC20"}, {"file_name": "LAB_Stills_Q2_001sg_00000.png", "id": "308755411392186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982719_308755414725519_1672085077156382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uKr9Ev_VncQ7kNvwG4BDGu&_nc_oc=Adku-gXTSq7JQa8dPzXp7ronHI9bzntheQYZTOpdcA8JOhzLyDxp0hY97Yv1oqRWn9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvM6Fi_YNOmh8OKQr4smPch9L9bIKQ1_0IZm1xleVb0Ag&oe=69A6C1EA"}, {"file_name": "LAB_Stills_Q2_001sg_00004.png", "id": "310500637820553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031643_310500641153886_7852521238477763029_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZFAKv9WxzwQ7kNvwEgHpHx&_nc_oc=AdmkjfnIRkMwvUW3myFTToWC9bY9o3e5BO6tFqklRc8mFeW8CDv8DRwo0bTnOkco20g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQI2pkM3x2QDmCg_VQ4OeOZRCHOWXssEDIPp3_i6w-2Q&oe=69A6D111"}, {"file_name": "LAB_Stills_Q2_001sg_00001.png", "id": "703799244078928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul6yRz325WQQ7kNvwEcO62v&_nc_oc=Adk3qrCGdZlTDwLupUQJlz8eIw3a_XRtX9ZPsTZHjbqgSAs3879dC9LaCRzA-i6riKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5N_IptO9WeEaaAhkXh_O6o1c-zuD6s6u9snuMLeoBcw&oe=69A6DDE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lab_Quest_Landscape_004.png", "id": "805233717145179", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_805233720478512_5465263039459601720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPs6kgE2Z-0Q7kNvwEJ3mIR&_nc_oc=Adnhor-jhPoZC_XKuSMsPDEjgMwSTALp_vssnTf02OL86xKS5o1cUQp7OgxSo9AyPNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtAWGE30ljXeGOh_dre_4l46AOWgp_ACXUUupLcyYvOg&oe=69A6D931"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate, discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n- Physics to the core: Boneworks' realistic physics systems have been fully improved and polished. Interact with the game world with consistent confidence.\n- Visceral VR combat: Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n- Be anyone you want: Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n- Layered Narrative: After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.\n\nMATURE CONTENT WARNING\n\nPlayer uses physical combat, including firearms, melee weapons, and bare hands, to fight enemies ranging from robots to humans. Enemies will exhibit blood splats on their bodies and the environment around them. Player is able to harm and kill themselves as well as be damaged and killed by their environment.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]},
oh=00_Afu6x6g8wqjnFL3g_HirPHtVa_KLb8dPyK7yVGmYhWWoqQ&oe=69A2EDAF"}, {"file_name": "LAB_Stills_Q2_001sg_00003.png", "id": "389127249462025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974460_389127252795358_5040822551071372763_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0MjH53syb0Q7kNvwF-fACB&_nc_oc=AdliG6KIDnVOKdLt5qtb59RXP-86U8lwQVqg4ai9KEyqxMLpxPYSMNzroLhGcA0H2JU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm_2DfMU-7qUeg-pfZ56YSTC1_dLsQVa9fXZ35n6l8ww&oe=69A2D7A0"}, {"file_name": "LAB_Stills_Q2_001sg_00000.png", "id": "308755411392186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982719_308755414725519_1672085077156382453_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sgsm1fyFP0Q7kNvwGByH0V&_nc_oc=Adn_4MFDRzfvr1U1qh0Zeti2PWZ9G4CBlbQLBIuPr9UwxE9FBi4pqUDmMH8_nkx250Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQGzhs1dJpzI9-v5jo9cxJbxSFclPmBwbw6E16afROJQ&oe=69A2CD6A"}, {"file_name": "LAB_Stills_Q2_001sg_00004.png", "id": "310500637820553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031643_310500641153886_7852521238477763029_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7bDIElPlD8Q7kNvwFgpfUP&_nc_oc=AdlweyVgVYVyqXbGoPsoZVHBL68akBwaRm4qz6EWfmDCe-ANVbfRs9_nVwmEunna56A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMPQY2pyJIHx-4qqJzh2HCVFCXd430xL5tY14Edh4Vgw&oe=69A2DC91"}, {"file_name": "LAB_Stills_Q2_001sg_00001.png", "id": "703799244078928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982468_703799247412261_7316423863849915105_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDBYJu_lLVIQ7kNvwHCMk3D&_nc_oc=AdmyEsVdt6m3mJU92jvqS3c9P6Vx0uz_6-I_7uDd6mcptxWCxEOfciG64W-du_02jiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvrsh0PWv2yz9coU2wwLVAzw0IwHWPQYKlGiVB5seBcIw&oe=69A2E966"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lab_Quest_Landscape_004.png", "id": "805233717145179", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_805233720478512_5465263039459601720_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK_0IGH2WMIQ7kNvwGKiUaR&_nc_oc=AdmG4f4byZoMInP7npRnYBtsIYaV5Zy_iTMzyMhHXpu-6_eqckPeWaW2nR333kOfUwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIIt5MKJp75K57OaSk-np_QMvMn614jOpUoffQi_sIew&oe=69A2E4B1"}, "display_name": "BONELAB", "keywords": ["Action", "Adventure", "Physics", "Boneworks", "Shooter"], "long_description": "Sentenced to death, you embody an outcast escaping fate, discovering a pathway to a hidden underground research facility. A series of challenging experiments and discoveries await. A road to the truth calls from the void. \n- Physics to the core: Boneworks' realistic physics systems have been fully improved and polished. Interact with the game world with consistent confidence.\n- Visceral VR combat: Using a variety of ranged, melee, and exotic physics weapons, engage enemy encounters with an entire armory at your disposal.\n- Be anyone you want: Custom avatar importing enables you to play through the game looking however you want, with physical stats to match. \n- Layered Narrative: After discovering an underground lab in MythOS city, you will have access to a variety of game locations including arenas, obstacle courses, tactical trials, sandboxes, experimental modes, and user generated levels. Collecting items, avatars, and clues from these locations enable you to progress through the mysterious story.\n\nMATURE CONTENT WARNING\n\nPlayer uses physical combat, including firearms, melee weapons, and bare hands, to fight enemies ranging from robots to humans. Enemies will exhibit blood splats on their bodies and the environment around them. Player is able to harm and kill themselves as well as be damaged and killed by their environment.", "short_description": "BONELAB is an experimental physics action game. Explore a mysterious lab filled with weapons, enemies, challenges and secrets. Escape your reality, or wreak havoc. No wrong answers. "}]},
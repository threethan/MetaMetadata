v/t64.5771-25/491830027_1456142865892937_7534808950189242754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk44CI8eVLIQ7kNvwG1HEoC&_nc_oc=AdpYiAyRJGkVTIU58bRn076ktILiAxGiLeszgOmvFiL06QqkYcLiy6GACbfL0LeEJO4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH84FJL1-HBGr9U_oD5yO-CgJv1-5BNsc6njuYFzziujQ&oe=6A8052F6"}, {"file_name": "ScreenshotLightning.png", "id": "1340780761435148", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_1340780768101814_559320655353656747_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT6JWPXhFDIQ7kNvwEpfhPF&_nc_oc=AdrTDspB5V2JrnPt1-rRA6EiqEtj0bqETFcVNw8Wf9gYqqzcCIleLq4rKXCwk4KAY4M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcqxXCk3rtXbxjFhF86ZS1P_JDArorQO-RqRv_DDfLSg&oe=6A805807"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ardanian Kingdoms", "keywords": ["strategy", "fantasy", "medieval", "god", "rts"], "long_description": "Ardanian Kingdoms is a medieval fantasy strategy game with indirect control - your heroes have a will of their own.\n\n\ud83c\udff0 Place buildings, let your peasants do the work, and expand your kingdom\n\ud83e\uddd9 Heroes have free will -  they explore, rest, and fight on their own terms\n\ud83d\udc09 Fend off monsters and powerful foes threatening your kingdom\n\ud83d\udcb0 Collect taxes, manage resources, and spend wisely\n\u26a1 Cast spells to tip the balance when your heroes need it most\n\ud83d\uddfa\ufe0f Complete handcrafted levels to expand your rule across the land\n\nThis game will always be completely free to play.\n\nFound a bug or have a suggestion? Drop a comment or join the Ardanian Kingdoms Discord: https://discord.gg/5pJYCZyVRA\n\nThis project is a non-commercial fan tribute inspired by Majesty: The Fantasy Kingdom Sim. Not affiliated with or endorsed by Paradox Interactive. \n\n(\ud83d\udde3\ufe0f Pronounced: ar-DAY-nee-uhn Kingdoms)", "short_description": "Ardanian Kingdoms is a hands-off medieval fantasy strategy game where heroes act on their own. \n\nBuild and upgrade your kingdom, place bounties to guide independent heroes, and defend against monsters threatening the realm. \n\nManage your economy, cast powerful spells, and watch your kingdom grow!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/PolygonEclipse/KingdomsPrivacyPolicy/blob/main/ArdanianKingdomsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Polygon Eclipse", "support_website_url": null, "website_url": "https://ardaniankingdoms.notion.site/Ardanian-Kingdoms-217778598745802b85aed69d7ddd852a", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pl", "nl", "de", "it", "ko", "pt_BR", "ru", "nl_BE", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "de_CH", "pt", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26671945862445644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828050_1943107199706487_1754382418697912332_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ9CRgEsldUQ7kNvwHxFfPK&_nc_oc=AdpforV9PAt_byjU_AcZr7bIFvRz-WB5WXq5VwIPUK0u37NuWOQI546OHP5OPG1PaNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaIQzAa3KT7nfM0
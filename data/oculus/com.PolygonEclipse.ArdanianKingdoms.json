40476755670972206_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moQaO57Kr7kQ7kNvwFwi47f&_nc_oc=AdqbhIAEQnGpAyGXKAGuLoKGwDCgPiNFMpoV8x3690r54YOmjE2wBhuesoUDQttViYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWhmtPKzVcGNgD5Rnfvjvlim8RRqM5v00sEs_DcI-Blg&oe=6B0338CB"}, {"file_name": "NewScreenshot1NoText.png", "id": "4147682198811875", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819407_4147682202145208_7453874202665733283_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfHD-0zmLZgQ7kNvwEEAE9c&_nc_oc=AdpPOhCCCvRJFo_OLQCbkLrP0U6DsmRxdmNiG9ZgDAnYF4wn7yOvtU3RtbGOAw9XuIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRATAz7hCUpYV4vmQS6pbasmy7ECH5xBS2bm_xyJT-Bhw&oe=6B031F95"}, {"file_name": "NewScreenshot6NoText.png", "id": "1093121152736801", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307906_1093121156070134_1222599570996629915_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rgYd0sKkoAQ7kNvwFG3z9K&_nc_oc=AdotdoTpx1Qv4LFXvo_JIeTBHLXPhiD3ndp5GyhoFfdlU8BhzKiEuAxxPesr_1macu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0zheDnED27NY45MetR7PPw9gDz5E41pFa4TpKilnPJQ&oe=6B030905"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ardanian Kingdoms Demo", "keywords": ["strategy", "fantasy", "medieval", "god", "rts"], "long_description": "\ud83d\udc51 Rule your own kingdom in Ardanian Kingdoms!\n\n\ud83c\udff0 Build, Upgrade, and Thrive\nExpand your territory, upgrade buildings, and watch your kingdom flourish under your guidance.\n\n\ud83e\uddd9 Guide Your Heroes\nYour heroes act on their own. Set bounties and rewards to influence their actions as they take on quests and protect your land.\n\n\ud83d\udc09 Defend Your Realm\nFend off monsters and powerful foes. Use rewards to motivate your heroes to defend your kingdom.\n\n\ud83d\udcb0 Manage Your Economy\nCollect taxes, manage resources, and wisely spend to grow and protect your kingdom.\n\n\u26a1 Wield Magic\nCast powerful spells to influence battles and support your heroes.\n\n\ud83c\udf1f Ardanian Kingdoms \u2013 A New Realm of Fantasy\nStep into a fully immersive VR adaptation of Majesty: The Fantasy Kingdom Sim. Build, lead, and protect your kingdom in this unique blend of strategy and simulation, now brought to life in 3D/VR.", "short_description": "\ud83d\udc51 Ardanian Kingdoms is a hands-off VR kingdom sim where heroes act on their own. \n\nBuild and upgrade your realm, place bounties to guide autonomous heroes, and defend against monsters. \n\nManage your economy, cast powerful spells, and watch your kingdom grow!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/PolygonEclipse/KingdomsPrivacyPolicy/blob/main/ArdanianKingdomsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Polygon Eclipse", "support_website_url": null, "website_url": "https://flower-sink-f12.notion.site/Ardanian-Kingdoms-217778598745802b85aed69d7ddd852a", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23990832983890292"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "727493576636619"}]}, "baseline_offer": {"id": "727493576636619"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17504455
ZyVRA\n\nThis project is a non-commercial fan tribute inspired by Majesty: The Fantasy Kingdom Sim. Not affiliated with or endorsed by Paradox Interactive. \n\n(\ud83d\udde3\ufe0f Pronounced: ar-DAY-nee-uhn Kingdoms)", "short_description": "Ardanian Kingdoms is a hands-off medieval fantasy strategy game where heroes act on their own. \n\nBuild and upgrade your kingdom, place bounties to guide independent heroes, and defend against monsters threatening the realm. \n\nManage your economy, cast powerful spells, and watch your kingdom grow!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/PolygonEclipse/KingdomsPrivacyPolicy/blob/main/ArdanianKingdomsPrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Polygon Eclipse", "support_website_url": null, "website_url": "https://ardaniankingdoms.notion.site/Ardanian-Kingdoms-217778598745802b85aed69d7ddd852a", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pl", "nl", "de", "it", "ko", "pt_BR", "ru", "nl_BE", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "de_CH", "pt", "es_VE", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26671945862445644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828050_19
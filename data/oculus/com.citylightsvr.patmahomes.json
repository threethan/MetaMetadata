/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5PjoQlKStMQ7kNvwFcPhBM&_nc_oc=AdqZVdL02EvMi3X7pi7X2A7PughxZ2i5sgogu2IdNhcAGpIpZg4nXal0p9XaJ8Xvpmo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_92KuJeUNNG9uti0pV3Yrbk--T8aCAujZzM5O6HeEbw&oe=69C675B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHKrwr-OvaIQ7kNvwEGPj1_&_nc_oc=AdoQfEMyww1B580fbhsR5tkzZBciY1fpVo6aDXvdW6xJ8mmhrrPitMFblxvhU1jkWng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRfmjuFUU11tlfOjnAf-GN_asuz2_mXj0jsJc7itLDYQ&oe=69C68755"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ4b6jiCOOMQ7kNvwF2nGHR&_nc_oc=Ador9XBSwdIJWPab-Jb9RpJRtdfPOZF-1LxrmREu_hJz53j_vEDochuPSnzJw6AK8ow&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3ubDIl3H91kXAi91K-EGxsc84uHo42YOWtNfnnLTq9Q&oe=69C667F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTHAQHXACtAQ7kNvwGmylfL&_nc_oc=AdqsW3_MRPwRIwvqLHSZTsYOjvoXb40MVonqRu9BmYm9Kz2iSKcIgn0zIhAJWPtT59U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA6zfYOd6IcrImFpEww7q-SUb9ka3xBiMUs8OKz1Yiaw&oe=69C662A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD1FZhVplq0Q7kNvwE0vMyh&_nc_oc=AdpG1CfdrosyeV_9v7ZQGqnV1wOOKxo6CwGsXDy1vwHxEhDAJXmiFXFpFq6IuJXvT6w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySewW9MD6tj-Eb8Ezs1bYUlTcLFom0PMx16Q8OLnNAtA&oe=69C66139"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
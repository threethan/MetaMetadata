/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si6vpmVB4HEQ7kNvwGifwNl&_nc_oc=Adoqftp9WXQTiQmK-rno7RQQdUTplGNo73yQ4ezk_AUqZgEeybi7Iwjt4OtzwHuRc5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3Hud7ZBsQqRDrlDpRI3BhiIccvPtMHd0MKXZUcujlTQ&oe=6A5B6F32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7MXk2DzfjwQ7kNvwEOLL6P&_nc_oc=AdqAbA2e1qM8MFFZ-Vs2ZLDMGxcl-FMTqoIHt7UFk1pAve8D2rrNcJo8pw7Nl5OR43A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa2h-VqsUyvUv2XnJk-YDNQ9APB6mUjSOUldeGG61zyQ&oe=6A5B80D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjSxUE7YOb0Q7kNvwF10-uh&_nc_oc=AdrZk-tajA9P3GEnZ3pLa_yfsNaV4KpNXGmMyPMFxjnNb8Go6_y3JHUeWsmaud6d3NQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgAYl2zyg7SgBRvTYdnJ5F8ZQtLlvyHr0sk4TiXENbYg&oe=6A5B6177"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JvgHGG6xhAQ7kNvwHfpJlz&_nc_oc=AdpZa5DnXLfogzQJw-Lj0hDlHaq0UwGdlpcxZevdoNFmPg7WLwR6afThkt05dxF2EHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-ExnGuQGgMSIDQ-J9yAmKlNKSKvx07lUfsEUCocFkrQ&oe=6A5B5C29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7MFNDCJ3qUQ7kNvwERHhuJ&_nc_oc=Adqz1cqEJz5lApP34OgS_Wqti6LTKBmljBY_CVygpJb6zCEvzTo9x5cwOiE6gBXSu2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD77fnWYVczw0BcrP-BVwVs7GGbsbH45KeJnJHdFE2BsQ&oe=6A5B92F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5g35YJ69E0Q7kNvwHvuYCU&_nc_oc=AdrN6i-brxtSGM41uCJT98XL4Hu3SNVjWb3qwu0l1qhARjhzx9clGgXw7nNXaY-mqXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHSW2W-c9FrJ37MdUBJj_uo8iL-I_MPZbki1pIQJr4_g&oe=6A5F63B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHblJ58pj5IQ7kNvwHMPlEt&_nc_oc=Adob38IhMecwOAndH2Cgeie9iIDkHYvfiHBm7-2OGjaeit9NKC5EYslvmYFfcXBE8FE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbkiJQ1vSoWaLJi3hscwCcc1Zjbt1wKR_Wd3nWss9QJA&oe=6A5F7555"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxsQDXQ5HLcQ7kNvwG6XiJ6&_nc_oc=AdqAo1bwSesq1kP6fwWHZNFYlYlzPUDdawtlr92rYPujCKV1QNkuwY6eYl76mzpi6Q0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2A32yU80iCgU_X1nrwuZN822CijQBfbrvJXTpY2GydA&oe=6A5F55F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUiYg-8uiCIQ7kNvwF8hEMQ&_nc_oc=AdoxuHZJBHdWc0t23e8AG69rbQN45_w5f3zPRPSq9i-BRQNW7WCktgFhmmLWmPWEd3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCet0hYImPsctOWYGWAMZH004n3G-I7jaZ349MU-oAb3g&oe=6A5F88E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zugHSEhM7d4Q7kNvwFcj_il&_nc_oc=Adp339_jGYCNLaeqSHZpvqoWyc6LhpRvFO49773nMeWI7qxdqVuk17-b6uA-Dezci4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEs3dcGG3TZ_t796_Wr0pWAaSBNELnY9F-ud65A5QJAw&oe=6A5F8779"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
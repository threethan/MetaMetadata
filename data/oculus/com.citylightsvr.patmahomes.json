/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uYR0spY824Q7kNvwFljpOa&_nc_oc=Adq5dAZOH2_SoJf3OOfkRqP4Nb360M7p6vOFFk02df578nL7L702zV_IP8I4J1RtC8s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dlv-AGm4LXM5DkdJZ2f5ltpYI_lYXtuu5vbR516Q5Qw&oe=6A1AD5B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1MQq2bZenAQ7kNvwGzV9b6&_nc_oc=Adr-WYMo9091RnLW0MVs3H6iJED6etQ5iGJjxKYfsJZcZHFz3O6Rwr9JqYzkjb-8LMM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74bsAoN5iTX0vToF63mNH5LSBv9xUFYbEaSjHxhhGPVg&oe=6A1AE755"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WcolVYag00Q7kNvwFXPKfG&_nc_oc=Adr7WKm3dX4bb-XsTkp-2oILN352O8LMQKCIZCugQqn-WCFBJ0iI8hovQ73kMaEtUwE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PkeY3szkH6VkQQIOn9Wu6-e2c78SJyzFQQAEawqCWNQ&oe=6A1B0037"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0vDlD8Cd1kQ7kNvwH5ly1j&_nc_oc=AdouXziPXnj4XtFRdMM-JZZc-u1vsS_fqR1YRTlD1mhAvz8rnwbIthky-KPbJ6mbxac&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44cn4YsyzoUfy9uHQapdQp4wIQuMzthYbIepW1RcxTew&oe=6A1AFAE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RpNWrXnMOgQ7kNvwHAZNJ6&_nc_oc=AdqeC8UZhKfAaYBXPYTTjX8d_xTfgRBoB1fH0CqL72HMaKhlTa9L3lA12GQIcRMEvno&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q1uz62U65yFcmplQb9EFMaQk06-XfslgK-O5HvW-wrA&oe=6A1AF979"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jx3DKSE-_tAQ7kNvwFdN5GT&_nc_oc=AdrRY0MUSrs9-YWYYCABzV8qPpurEhcmk7KQvAOMkzAKebvG5qldzd2SI0_TYZ_PgHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAqYAt3H4NedGbii5ZBG6OUtQjBrfo7cLsta7MxyvgIw&oe=6AA694B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSlQf7YMlRsQ7kNvwFfDiTi&_nc_oc=Adrt36bbbzeSIw5J1t3Ti8P1IRYgv4DSEz-SVYVvGZ2-XFJE-G62VdLtonAOgXDyooE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlp2_XLvFip5bM9W-bh1g6657QWb2uH8GYfJhMyITVkg&oe=6AA6A655"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r74OQSQy50gQ7kNvwFOZREe&_nc_oc=Adr78btOwfacnkNVSmIUtLqQZQZCqsqBApC_2orqOosOowyweDb-OFt--mkD5MzK_9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLON5nqpw8pE8fC41NDvxG3O8uj0lV_0_uYLO_2Jzdv1A&oe=6AA6BF37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g1b9_esDTcQ7kNvwFNfruF&_nc_oc=AdqFKhpBllY55flyS8DtsJsVhmnNNDjRryVgLZC6xw20XVchfA8HQGIa1XqLizplsAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi4Yzz1ZbA0U0sYab61Gax3vd-8Sy9wHZhqfd5mFXDNQ&oe=6AA6B9E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuRbrdw6_SQQ7kNvwEvqOdK&_nc_oc=AdqnlVRLT8msU8z57AOjEIlbVNsG39-rvUdR6gDysCdG0QWMvnqQ2loNdaYC54RW9cY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICKdxGo1w0JsCeXb5YPrY7XN_y4452imzvcYoupOnTNA&oe=6AA6B879"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
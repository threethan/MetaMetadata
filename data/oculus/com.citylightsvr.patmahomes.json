E0lDTe5ZEJAjpVrn5-6Ho&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEp8S9kTmhkfO5Vt1nTQlm91b_QPSkBfaktuWPa49A-A&oe=69C7C732"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHKrwr-OvaIQ7kNvwGqGfNX&_nc_oc=AdowjWbsKALPaUqK-DgHCEW5Pc3UB18p9-YXMr73sHa7i0MKWFFJr4hXWl968Z8PYgI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-71_GcE_K-cZ7x4nvIfWus1K4aK5g8ZqTpHoSWAdoXQ&oe=69C7D8D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu87B8HoBFIQ7kNvwGVCbtL&_nc_oc=AdqpncPKNvOk_XlHEHZoVQSYz6CRTvHorfAOohOgf2b44t-vwP4QcZV3rdHv_u4hHMw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPvlunavEfAN2CbEvBgCNekBsFQVwvAPzvmI__wVU1vQ&oe=69C7B977"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTHAQHXACtAQ7kNvwH21msf&_nc_oc=AdrbSTkT2VmXAObNg9Xig-5OWyEVPsZD4j7aO7lzONG4WUfh5xkZBYPWvBeVAitDBdM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0ZT6yvHXGOmirHp088FxmGX_bRRfnpew2ZRlP3K2uLw&oe=69C7B429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD1FZhVplq0Q7kNvwGVIVGq&_nc_oc=Adowr9kYqR2T6lqFMd_FjHqEfDNXxTxqc4jmkBTr2vHJxkcldkvu5DIti7d-sHpBROI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKQuAdvsNqFjlfmhKu3THQI0OS_KQwc5I5PF5CFZ654Q&oe=69C7B2B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
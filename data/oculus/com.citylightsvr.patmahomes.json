/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkuBgEefaPIQ7kNvwHkcJjD&_nc_oc=Adow6PJbQEZeqcPcuITFPhO6i_cKfW6DCBUume7f_MOc3mwAb4tQQSfLr3j8uI_x7hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVqG75qplRWqGTKWRD8rT0X-yEL2AGGQI6ReLtGQPzRQ&oe=6ABFD972"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG3tOGGtxJwQ7kNvwFd3ukg&_nc_oc=AdqleTRcob5QyDcG7YR6Iw8rOizVjYJq7Ab78QvvzV8gKXMfYK1WEFoP_bAqBaggqvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYW101f_Sm33i6HPSNcK5tj2MAKo2HIGMsQw1X1mTBLA&oe=6ABFB2D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAbUZ_kagvEQ7kNvwHek7gL&_nc_oc=Adr6CYODVFYSqjrQcyB8dxi1ZKgE4L4AdBv0sffQfkg6YDl6MdhlJFvTpy5bEcBNYiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM17T1IgqGV3Q1f_pycmsosYarIxvW7FcKII-tbnyJH6Q&oe=6ABFCBB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtpVHrMZO4UQ7kNvwH4_lIG&_nc_oc=AdoyyEmhUhyD3qAs0qNnQfIg-t9FNHVPWZrJZc9aVTCDr0uYyEzp4zrMLjeeGSg6YwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw1j-BM423osSLci_30ec5VhQbrPdtImbQGYc-60b2pw&oe=6ABFC669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqq8xJHMBY4Q7kNvwGRNTZ1&_nc_oc=Adps91p1dY4gZTj4OOPuOIplfaIkGhQFecdlroRMtwGJo07NipLlOZBm8mU5Sb2DPS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPw31JlJ2oZR1_3_QEPBfRLXuyPsE6lqTYaplAdyncRNQ&oe=6ABFC4F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
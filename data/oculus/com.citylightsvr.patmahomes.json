/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R_gVw0B2yoQ7kNvwHWYRlW&_nc_oc=AdqZrJFBAQQpcwOkzU4w29M1n3I7zW0ywx3GvdCwpIrZ6EE_4oGE6LCLKaF-x9MFKzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYFGZ248ROIP44kqQ8FGXLwgbcdPrtv8gV4oa3ZeF3uw&oe=6AA2A032"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGTOT_UHb30Q7kNvwFBeHRh&_nc_oc=AdrzuLdeJxhlggpHVvPAGQRPsHlmHfzUoqttbINzgutijkjYqdz5wtle0Vb-24VdOPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfv8M2ZhOOOKBvSZB3EafqC5Uru_EiNol_yypLOx8Pmg&oe=6AA2B1D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcil63mqYFYQ7kNvwH9qdNq&_nc_oc=Adr27yRbJWDWipMqOdzqmHbyCEOl_HPDDcUEBn_T4NW0L3r7fpo3dcPMmfyhfC9LFyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2qMdhKV83Rf2PADCdc5hFfCiVIaxQtS1LEJB8rg8O-w&oe=6AA2CAB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7mWXLo5oqkQ7kNvwG4KYzf&_nc_oc=AdqaR8mjSBEngPRQdsxpwkw0rbC4m7lLU5AQDr1lS9ZU55fMwM14BXioJWFgtqSFTRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWFdvQyfWamFwamE-N1WpZOsYJJZqzDwWpBxkjQ-ppyQ&oe=6AA2C569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSQhetfDoqgQ7kNvwFdSOX6&_nc_oc=AdrlmkHFLgjCPT6X5cSIVXw87zCXEEe6C5DpNi79prmHQIwMulj5f7WnnlzYpL1_jss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUhR-1Oi-NhQ8r9LEIcPx-OJrezGhMjQtX7eyx-tTi_w&oe=6AA2C3F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qtOkLczRqcQ7kNvwFwW8ST&_nc_oc=AdnXL0UOHmM6snmyFIg3JYhJ0EC4NGDz0Lr2pAywLUfYTZ9iJU2u34w_CUWzZApblDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfygtnaAqwKbYzk7KIUrYcgWLGalAauuk8rZ3fatZPZirQ&oe=69BFDE32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCibHgMre_kQ7kNvwEL4wCJ&_nc_oc=AdlfbJk-u5G5D14XtdhiWOi-e6XaqY-rS-P9H7bMD10Gfm8Ot2HFJjXOAHaOoW-6Eq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5jlhOMG3NLfQNU4UF1sBOxJpWaEZ9o8eV3kga8W8-AA&oe=69BFEFD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxaNR14qw4kQ7kNvwGfgDMX&_nc_oc=AdnVjRNBZZWQoyRpyLHZ9QAtL7q46hHSkAbCcN_WEPXK8GubTASEfMGl_b7RJ-UJpF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqjiXrndC9LIm5UgAQp5CmQm68m__oKn_Bmb0DpOejKw&oe=69BFD077"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=933uE40QDsQQ7kNvwGMdDyL&_nc_oc=AdnW2re3n3-S75pSV2tpDUVbFe4QYRpicwwAYFzshlxwmJM53RQEej7HEbO3WHHelVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxM4L1ZO2iSh5CakDkT7aAdovCNJ7PFkLt6BEgiUqiz1A&oe=69C00369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EbyWafwS8oQ7kNvwFkw5Bb&_nc_oc=Adk7rDt3EZPq967eVLCAXpQZinLKOqpi-MXeB8rX-i5TNfZRROHhnd9yP9ranSdYbO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVBiOqQWGI5TY-U9B-JB6kwHBFGf8NH5r3gWF39-2fRA&oe=69C001F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpSPkvnr5SkQ7kNvwEdy3Tm&_nc_oc=AdpnFehfeofPPmN_xLXCv3M0_QzXb9mbQ8BEr8hNBRT_ps3iRZmfdrhCR5UIN_-VAuA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pR3_jgR412K2yOx19MUkgmwOKN-n2fKHJoaqn3LMyXQ&oe=6A26EB72"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMV3VnE9Gl8Q7kNvwEUL2rU&_nc_oc=AdplPFvwrnieci9v0Z4zpJfpmSMH5TDJQp90yrZW0a2QnwJWlYIwONviD-JZgRiyjZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af823FGvhe8NvXYfEuwJ49gjFsbjkcF9VOCx4XRP4bSFcg&oe=6A26C4D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AorM3FO-CrMQ7kNvwGM3-uF&_nc_oc=AdqSQtoolhHG9-qAL3O9gZvxpP15dAp_Q1QHFT-AIo_nHElbMNLpD7GyNgzPDedZRBM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Aq9c06qnfOI7TBiBIaOO11k26raTF5KYW5kBVa0zLCw&oe=6A26DDB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U5Sde7g53wQ7kNvwF3u_pi&_nc_oc=AdpYJaH6_seW95P8RSRGX_s6rDiOVuqd_0CHErxxdmnzcWJVfw9-ZdpvDHhBFpPcgDc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--NgND6ns_KPcXPydeOBHaZht4zMMF8RoAwGrMY-tHxA&oe=6A26D869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxbBUaLR89wQ7kNvwE2DTwh&_nc_oc=AdoE2Mmn2NLdzPYdSNy9bpO4y05rI7M3fBCTYyj7Vlnz2qr2DVgUYVDBpeqLtdouJFU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hjZQaN1VCRGKlamsOJ0-UrWvzFDUR9DGw6IOw_lCDdQ&oe=6A26D6F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZBY6b8IzLAQ7kNvwFPsrma&_nc_oc=AdqhrpD7D6RZqFgaaPT9wu2-R9exkxKbqBAUFETOwCstHsYgVC_TKlePTrJkABJhVYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83UMumUC2FSrhJRQmTJp6WtfHN-Nu8WRLi7eh3KTVdGQ&oe=6A3AB1F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kf8_-HQZ3AQ7kNvwEYMLdg&_nc_oc=AdpSKbd04s4rmm4kpS4KA9RST0XzwrxCcQavbt0IkR8e6a3hgOGWZ3ZU560HZNZsarA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QedYnG1CFZwVw6mLcDeyxpCAf4zaum6YaZ28eN6PewQ&oe=6A3A8B55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVPkxvgCGW8Q7kNvwEPPyAo&_nc_oc=AdpIiTA4ErIifMdPldgDQcNZNsHp_9pJKZJ0p2jC-VMLQ3UkLVu0FpKFwwsxRviwVMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_50UICUOiXA-6fVJJrWtLGNGn0kzbrvyKAEV4okc39Bg&oe=6A3AA437"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJVzF-LXh9YQ7kNvwFoSMQL&_nc_oc=Adqo3f6V923QZznWzyxTWEqqKUuVM2V_sJrVhF888qNrPi-WuBsGPVThuThdFOpZP_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fTX6KX0X-U40bSejImUa1NqR4LHv9Fv9M75M7Ub1tdQ&oe=6A3A9EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz_TSfj3iP8Q7kNvwHVc5WX&_nc_oc=AdqoV4KNK-b9stlDH_F1fHgYaCJ_iYDOHv7UjYYipbVDxSCo9Xo__SwnZClZPYbKYYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FHBF9boGr9ShX7HpPotaJq_RRY3eRH0JxXz6mcfU_XA&oe=6A3A9D79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
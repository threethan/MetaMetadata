/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hn4nybrQ-oQ7kNvwGDWDPs&_nc_oc=AdprhniE36GgXNgAa3fnTR_3I_bKljI7mA0N1pLk7ooNk4xh-_TyZ76aIKxsIA4AV40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ1iNKK_zEVo7dO9c3XQOeOBQ58wnzDRX-uTAUOlIOXw&oe=6AC12AF2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG3tOGGtxJwQ7kNvwEGDcJY&_nc_oc=AdroSUEAjAvkUACBC5gwaZRDmTZW5Db4UMah80nk4gSdCNQl4KdPUBR-KLa8S-K_qzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyX8axNOewJJJzab4kmEbTCSOr7rNRAOqiEyQ9EqDbDQ&oe=6AC10455"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlKsBU2FEH8Q7kNvwHYDSpg&_nc_oc=Adp4YyHPqFa7PuIAxj8avwO46WmdkGLI6AzNoGrscLKVHEQSADGFZncBD8SYEd_CAOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMByOQg7dWjkx-wyg8I4oYLp46P3a5Gqkp3ioW0MTCODw&oe=6AC11D37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtpVHrMZO4UQ7kNvwEEvcrZ&_nc_oc=Adrb-NX5Z8IWEItlMMMI8cx-ZCEjweJbXiBA8WjDMzdmeGv-loEMla9fR9o99BlZupk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqcwwJtPnAylDcT_kh5i87Wnv4X3SdxfWsdxGJUhv5mA&oe=6AC117E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqq8xJHMBY4Q7kNvwGkeHHD&_nc_oc=AdoDeGX9agi11UL-6hORfDdvzIzYaLkqHy5QYJHogY3TQ9ljjmkNjCuvihRMtkf7nzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-6-6Fei3LuF1gUbddR4mxFHMh4ds6zwjT20iJpnlKFg&oe=6AC11679"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUsQ69it8MsQ7kNvwFdRX9h&_nc_oc=AdrENZrzKFsaZMwmdnULY7k6s-Ou3PKBGMUyl9zqcloIu_8ApY5uLOqkbghEukfi3oM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM-EMB7DxPuL227n-tszCUtfXarsr4ptl0AjA1m7_ELQ&oe=6A6B4132"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prGdyWVqlisQ7kNvwFyFp70&_nc_oc=AdrM5PEDHo8bsTh16OoK2K3J-XOX5PLRHEq6vBaZ-e1AxyMi5FRJxDgcdxJrq5o8RuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdHlPPsinY4SVGPnavhOuAXoz_sA8aQ3yC0DY_spD-YQ&oe=6A6B52D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ddP2SvYewkQ7kNvwFiLx5-&_nc_oc=AdryP2SMVqLVm7qoZV0E3Sok0zyc9wt_PVlHdBw9n6i-KO8k-8ZeapkWQyO4Ltyx9GQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkVuYSP4q_u72VaYLxDl1iRTLLtThebYa0V_PP_Dxhvg&oe=6A6B6BB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq4162G4auUQ7kNvwHcYPR5&_nc_oc=AdrGpVxgmRKARxKWU5rcnieNSA_tJDlVtEh61M1AhG653-MnSIbXIgbJdRu7aejxC6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU46XqR-J1C3bOympgThiSjQXAzhY0Gp9DIhVODYtbgg&oe=6A6B6669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO8y-VVLyUEQ7kNvwHlqLOH&_nc_oc=AdpiFHslKoSgDZOZu-L9DAg03b3VFnEM9bOdi-qb3BLhNE_LWPB6IWM1qEHVm7O8I8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8-QKdsTwpG09jvtyxOmWiI_jmqIwGCIXrOTaVSCc1LA&oe=6A6B64F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
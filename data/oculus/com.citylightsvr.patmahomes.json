/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3nHpD-ywM0Q7kNvwGGe0ds&_nc_oc=Adp-5IxRlQc-2sCgUHFOzcLKg-ZsXUlU_-aOBO0orkpvJu7K_6AjoE34TxDaAsPggNc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6buL4UF2bYgmxi5ozAbAL2E_G586e21oKeKvDt325LBw&oe=6A158FB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obQYet_5aJUQ7kNvwGHMtu6&_nc_oc=AdqEt7PAG4l1J6GofasBABedYf8hilZJWN5AZV6ZleQcA74oJ29CF8F_FB9a4i9VySg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50sks4TpNxqo36p3oSgMLkM5CFvnKl_0LZpNC77fb-qw&oe=6A15A155"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PDKqIaExV8Q7kNvwHmm68D&_nc_oc=AdoE1SxVjxRzmDfXDVltDOYMr5KRuQG23CjUoju9Bhi3izfwVKCiv1iDH9ztrT5KTco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cN_W8UmAx_yKoci4ET4OYZ5Fe16WfgQOwE40KnZ8dlg&oe=6A15BA37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz5EvstmAhQQ7kNvwGahu5X&_nc_oc=AdolNyCjEVsSQaBCeOTS_tJgD1t2-nJOGf9U3RHHbAzj2SgelV9UXxSRX0wpna8dvko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WpLHdjA5tCQvLzBPtzP3RrPpDbhuZCvqu_l705pN9cA&oe=6A15B4E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNl7iFTDDYkQ7kNvwH_gjXN&_nc_oc=AdrxnnHNP1Cm5mlmGbUtFoYRN06ILeR9X64QpiMGhtlGzbAdmjaxgsVMNmNZ11o2kAE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KXBN7Nr3G0F46M-dWrnRzXWot-PsamBWG9aCZUUhorA&oe=6A15B379"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
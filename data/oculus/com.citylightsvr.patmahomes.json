3367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGOt2xd6brEQ7kNvwHW8y1z&_nc_oc=AdmhL8Lj_f0aVoxlXZlnnJLLkhdZbOPZWDiRSpAzEix15eo-R8rfqnFyVkW8B6i08wY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftUDwRRDWgL6NUGBKNKameKXY9b0yltPRjQtaQeOMeLQQ&oe=699EFA55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Avqw6ScCVYYQ7kNvwHEg6lb&_nc_oc=AdnnpmHJTIfX1wCP9VWe9JtbV9TwMr2CjJz10Yh8Wr9DmqJ2ZWqIIc41zRw9X-FTi5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftpP3Zcj7GRQr0aJvXdz2CBGdRcoO6MugV3oqtl_MSwbA&oe=699EDAF7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBE3zOQXuAkQ7kNvwGANHtg&_nc_oc=Adm_fS8bt2MvrsqCqRl2cXPb0M4IMZ_A7tnpfcV-Gwtt-GVPUasfkAENJMTUEOabkA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs-b4OHSXnN651mhmguscTCJwG8tcla6UynpEmMm6kjSg&oe=699ED5A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BobXhFq_o8QQ7kNvwHOAcUo&_nc_oc=AdnFQpRGMs3n--s_XnKS83KhsH9DcAvFwNaKXJJrB6tNOglyQaDdj87wYSKpC84WRQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvrnBvJESEt_cZKmLgPt7G1Ln60Zusj46q6YvS_ZhRnkQ&oe=699ED439"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629246968148671"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "
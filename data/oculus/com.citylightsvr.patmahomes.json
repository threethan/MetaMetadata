_ohc=LhlBZUM4ZaYQ7kNvwGyuKY-&_nc_oc=AdnstC-X7xqTCQBB4uF4eGvC-F1jpI7GHoWZKpV9vhkSTeUasKRc7T0-VzwFsKQwmxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvlkT590QX6QZLROiwoEPfeornKd1DHhBy5-IYIjWkocA&oe=6999A2B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fm9l1Gd9ngMQ7kNvwHW3bvR&_nc_oc=Adn7gwyjdaOcmaLpUe1PKsSM3jMXRvfbM-5_ajdG0rs-1DYcZy-ivTNYjhqFKRQ1HCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftOvuvNaawiKVwq0v4uXRQmH0OS2y_9hpNl0GUhMSuMZw&oe=6999B455"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghznIt8hoK4Q7kNvwGSt-YV&_nc_oc=AdkfD7cW7eSPOtmwtf_tCkN6csZ8mD1Nu2ZyRIMMfD4Lp_fssIGXcfv5ojWlxgSzelg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsMp1OORI76U5eq3MjG2tz6KDjpo3zGg2ywl2TAYeimwA&oe=699994F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pw9gYFSpDVoQ7kNvwEJmALA&_nc_oc=AdkLgnNeNzc9mFIBq9LPkL9afMiaM5yw7nsXCQKhKhkecB6ETL2DKkmMuvLapYqP1fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_2eauPlxUVrMn9RNrhEyvCYd1S8SCcny83G22mish1w&oe=69998FA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNQ-OYpzDnUQ7kNvwHVDgA_&_nc_oc=Adm5Acf80QftNVhaHiWPxZQCtFsEQvAxy4fAw9HUu9mxGihMJzfLB_Ac8-nV3mHnxyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIPIu8-SMlhoO-S2XXgLAv4wE_MfQ0w3-dnZn_cUAOXA&oe=69998E39"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
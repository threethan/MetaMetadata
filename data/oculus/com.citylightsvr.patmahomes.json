bH0hASav5_XtPoHDqi4vZwPg5ZKgar9IIXixabyLYkJKT77NbzbTUQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHtmobUz5l8-lN_ZUGR_18CYVA_VscGC0hAx0tJYcHbQ&oe=6A8ED9B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4wDC_iROxUQ7kNvwGHmr0_&_nc_oc=AdpGTH6BaM1_OIiVNx8vz-HP_s0Ze1PqFEi82kBPpjvLjCz-ikUXdY9nQWo9jGByCwI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9RypD3h8jgTTG9XUg0aPrBC8cd5ZTBQKxItgufWotPg&oe=6A8EEB55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5Fsc8OHDawQ7kNvwESoFqy&_nc_oc=AdocZEdakG7tCQSpUkiDFT98cDut68rTjObIpEMrImeWCuhjXMV2MSMAekBezV_P7gk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-qX96RJ7EDDsj_D3sdrNnTEMzU6ENEJ6qeuwGtws4LQ&oe=6A8ECBF7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7qx5UJEK6IQ7kNvwEmQhDu&_nc_oc=AdrSfHMAFg9NX_uJhacXlNMlxNFI8rVCB5Ecm1f6ljLN2blgAndii8vMOdJjX_qR0iQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdzw7-tSJDm__Wx_uyP7PxtEoCFsmUghLz3xTS9qD8vQ&oe=6A8EC6A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1er4eEsIQTcQ7kNvwE2FUps&_nc_oc=AdrPWrK0FjK0hoqtErDH9bOnKbvvMYtkce6WB42huJRQOWKMNUloagnbqlFg-9MPdPk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjd39yLFIGFPf-ktVzVaXICdLkkwQNnNriSu7mistHLA&oe=6A8EC539"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sw9lgeH1eYQ7kNvwHUg80k&_nc_oc=AdlCkjN4gRSorLS6whcR3EgjvrukxX3VXxDLXoInT1Rojyvw03Gk6zFGT1GogHfDd0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxpc7GuEOHZscUjPj-gBuvpzqrVVn4kPNsRo3EXdMO-JQ&oe=69B00C32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdZLBfKcI4sQ7kNvwGT8EFp&_nc_oc=AdlqR315j7hHqnRgwwBjzCFyIENDd4FsWGkFcPbrwbcQSh4dVUQUW6oeNqvl16qUcT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzR1eh2rOCQbf2LeUKc01Zt66Y0SOI_gayJYaxzGvrw5A&oe=69B01DD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1D0_T4hOqsQ7kNvwGRMOSg&_nc_oc=AdlmC60iAHW8IWHEi4mXLkmBz5f0tasrQ86GJADV9srWcBhVxCphKmQhPIrzvlt-oKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNRC-rXL_ii_TXowxm6Iiq_uRQ79VCubU-LQbvtc6ddg&oe=69AFFE77"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lQXTYsKn54Q7kNvwGS1djs&_nc_oc=Adn-KY_0K2653N4vD37tyQgtkHROsUvv0vXkRi0LZ-UOJWmC_6w3WVp_2U-AmzBOeDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxVP9UzZX_wa3u7AZcvzQQ1wDMbT06X8bQJAX_Aik4tA&oe=69AFF929"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx6i-DWvG9AQ7kNvwEInUKp&_nc_oc=AdnA0e6w5_W0KVChQYUaomUz7wHi0RN2rCx77rjVQc6vr29_y5KWyNMqFBpaYyhHoVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2PYz0Q0i5pTxMlErebRMZWjq08kYnlVx9mk3yEAYgFg&oe=69AFF7B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
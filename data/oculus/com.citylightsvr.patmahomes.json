/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Im_A9nKLu4Q7kNvwEUptc4&_nc_oc=AdqrBWKAM1yE5h1qlnX4zhlpuVBku-9JTTGfOz5-gSUC4T2XlLsPXHTenhz87MS2_Sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE5bAdMDUxZaWI7lY8rLMWybB_b_97HY_dfZw7fjD6gg&oe=6ACBB6F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USPHsF4W5g4Q7kNvwFcK1Z1&_nc_oc=AdqQOHa1AWq87qZXhxLgHMrasc39_SvQybmvUj8mL4BcdlpROAxfWzqyT_T9Komq42M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKqcIb_auI6iSBdq_MA9V53YjmWEWK99mjzpUxB0OqTw&oe=6ACB9055"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TivW28u_wL4Q7kNvwG4BaZQ&_nc_oc=AdoDbCTTWiGbrgPN0p5T82oZnfeA45d0t7pb_dFmeH5roPurBkc7DTR-6mBkImOV1-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQlisPcohbHERznk1F5MUZ2lG3EWxeAf83PmvDJ-W6Aw&oe=6ACBA937"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9UmMSeq4zQQ7kNvwF-b8p4&_nc_oc=Adohgj6omO2vrFQdO-WHErz3lF2KdCPH0MCsuk-k1Y8tvCQGrGSU97QcWZbfc9l_LSY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg93GMXshhTaQ6jqsWcg1Z5CdxcEYqpiiivjWXz4lXDg&oe=6ACBA3E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46fczDE5ZCQQ7kNvwHUaDzF&_nc_oc=AdocCkJNnYM1HiZx9kY0vhcPqRXic9gVP5VIPflzzJWhUdPQcE9x6XPg9IIysBhF2Mc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpWeb8jJUbvLAmrI1WINTyrdZ5o2628Wn2_Nf99Pc6eg&oe=6ACBA279"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
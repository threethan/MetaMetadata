/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46PmwGJQ6NEQ7kNvwFlgKV9&_nc_oc=AdrWJgQctJANpVvuUU1Q-FI7FSKtHy_Uv80HW3nt1b7aCv__YUrFWxk42C3xPW0rGZg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cr8nH5COvzJLQpfV-m2mznmVCc2YXdkRe4X-Jtmzujg&oe=6A21A572"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrvcUkOSxjUQ7kNvwEJ01Px&_nc_oc=Ado4OyI-GecAlhef5sJCBCMKzj3dniR53qeJ6p6V-AC1q3gLIuFxrz3qta0oYeHT8lM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9huOX2Vee3p3RIxiPynX1MUSO-Or5X9GS8W5AqZhRxrQ&oe=6A217ED5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWVeFtRSgWIQ7kNvwHfqaV-&_nc_oc=Adp7ufAzYnOCGBMjtQx4FAX6dgpXMdyWeVLKHmV208UEAu0fDfPqlPPT7u7JxtHlq28&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MEsiNcOzUrqHagEA1MAz0eAUYNHeMoaY9LmRlQbg91w&oe=6A2197B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_YACxzk7UMQ7kNvwFteUOr&_nc_oc=Adpt2W6f1Cm_VEtEWd-iaqcaFhdOEQqQyyF_aemzs7sVvL-PEc5gXlCNT4igB3jAjjs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x0NBXT0qhCpPMcLs4-gjfZwwzo9aD5RA9cdfjiVLQ9Q&oe=6A219269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT8fKSYnZ_wQ7kNvwF9XEb2&_nc_oc=AdrfXqf3APcDYRNJgNhXciqjty9m8mOPMcyEgDbWsFfLKH5xui3MpKcarQtcfWFqBTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82b7jpivsEEWjVF7uYVpfy5-hn_G9WQqsaGFf6xFe0Sw&oe=6A2190F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
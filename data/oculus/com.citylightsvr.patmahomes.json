5620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnRFhqqYZvAQ7kNvwEfUAp_&_nc_oc=AdnWQgJstVfGr54ZMY47eMV-POl1UVeaBgrFBuPFHDpV9KOqpbHTe7Xzy-3JxolooBY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfylyRcqJtarvXtqoOy2miq6ehMFnbxlfTrEN7ShbQvaDw&oe=69AAC632"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJoN1M5PFwIQ7kNvwGexDYX&_nc_oc=Adln8qcx66Y0a69DF1hlMYGkKGlGNGOPghzL-T0bTW8IA5a31v2uobB_0elnO15eu6A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXGb7caOm1YeLeDmhqh7AU3Jgq5tcQJ9KXVEAFuHLRrw&oe=69AAD7D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa4-z2mZS3oQ7kNvwFw5NM-&_nc_oc=AdltD7_7N3Sy_mVE2jO699nVcnCRpybwaavVvktST3bu_OAIx307X2p7IXUEFUJcrYU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCd9FYrHvCUUQqhBtsAwHsH8Y7Icof5S3BVD4jHW-vhw&oe=69AAB877"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tkum_U4x-bsQ7kNvwH_-Q7j&_nc_oc=Adnk8iiByPxikH6Mw8SLBAgEgPo3UAqMicbo03aY1C8vsUr8rNEXAKr1MvhE-0zdnRs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh7QNm0c6r2HhIKy7bard2QFtM3z8xxVuingNE96wVXQ&oe=69AAB329"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T7kt69kTxoQ7kNvwHlQh64&_nc_oc=AdnHAt9lsUQ2Y0y5U7NjlH6QR-8w1ZhYvd49nZwmSLuMtKvu9BwsjqD4kU-ORue53vc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcLKXhZfEIzRlIwNhVT_yN0ibMf53lKHNjUNu67QlOyw&oe=69AAB1B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629246968148671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75322598_995528404629673_769258421700825782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhgbmvekmmEQ7kNvwF7Sy5N&_nc_oc=AdmZOMisBejMEvbGx_JnYoK-OxLn8trMa9UZeZPf07-E67GPjXL4TsrEL1y5FtaD75c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzq8ecpAr4q_jpSKcf-XoILP_3A8Ke_b4nt_v2MTU8s6A&oe=69AAD56B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MVP Football - The Patrick Mahomes Experience", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1634230810, "lastRevision": {"nodes": [{"id": "5339134549445658", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5068085479875775", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "161928689431572"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverImageSafeAreaTemplateHero.png", "id": "299610644983570", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974856_299610648316903_407386913644857198_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Id0kpays4XoQ7kNvwH1MaBp&_nc_oc=AdnDY
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X2E7U-OtFUQ7kNvwG-N0HN&_nc_oc=AdqHAV-jKIBQpyLz7r3boZ-RpKBpB4uzj8vtAIQ_6caTMBqSRN1lm5mdDNT5zqXqyiM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2RuALqTyhMebKyIN3aJTk-Cqx5EusnC5IzdND9XSpXw&oe=6A538632"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQOMNygXtk0Q7kNvwHhADSY&_nc_oc=AdqllDDrb99b2CREqRAKDJabgYYM2aBK3PxxKigMCyuhYyPzE0DVcC-7CFOlXItmnK0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9iBK2Qn-3eoZ4q8nBLymEZN7kDUYgUJdspbnWeVpIxw&oe=6A5397D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHVhVCxZVCYQ7kNvwExyhxB&_nc_oc=Ado0KiiPFyIh-VCHYzi1a4GMMalhTfc-gTycjxMFT2gESYpKSTe6GJ3rvKcnQNAcTss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRfx4SIPkmU89pQrVYOZhq9hPpVrpqa9zj7SEhjF4BJw&oe=6A53B0B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE8WOsDzmlYQ7kNvwG0b2IA&_nc_oc=AdpRGS5SfAAOiiXHQA47PDFONw82sDxXRRBr0Puhc0BGd71DT3LEt7SnczSkHf2XIio&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBimgUJVCibmBCsaG-TqOakaqlCtIQpiCzqkMm1RAN3Xw&oe=6A53AB69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hoCYHYFLM0Q7kNvwEcxhBR&_nc_oc=Adpn5wf5CHsTEcYjISiJMly8p0YDfY01AH3nVPcYp1Kj2whN-AH48yVuTLC2djuPH0U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUREu7xlhU3b8H4JRr1EJayOROXbGNh90UV4w1hfKAsA&oe=6A53A9F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
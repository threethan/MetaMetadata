/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eAfdnfcb6sQ7kNvwEG3Scs&_nc_oc=AdqCJCkq80lzU7sup77AUwzQEyBH_kCSSG8PWJcHHOLW5kGDrrYCMhuXmaYSRx7GKK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpqDgUWY9Wun-wuEK81FvYxopfSFjkSyE3a-lGUyOwwQ&oe=6ADF4532"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akRYvYXDPeYQ7kNvwF-7sVQ&_nc_oc=AdrdqCFBOzL-bm0kEvKTXHnaQaXNqBbS0yPNgIVfAC70wl-NfuiTB7nOZzCc5h0qDeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdEAc4ubLySPZX8FkFM0d34q-8OQBHnCY6i-4exJVF1g&oe=6ADF56D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob8jMcOJvmQQ7kNvwFyGbR2&_nc_oc=AdoGx0boUseaEeC1mo3sH0f7DZsa42of1bvg8W0ftigRrMuaZqmJekvJ6PWI4-EHbGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl725jYyTFDeGo38chN5LwlJh2SB0nfwOn8cUeK9YlQA&oe=6ADF6FB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kURdMSjyr0sQ7kNvwHkXHWd&_nc_oc=AdrM3eqXWNDKjhjCaktxwK8RPUehp-jO5dGRXUJGuJU6aHMwe0rxMs5m_0xuFI2WSdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIRoIhMx4CnKOBTEheQk0k5267qxRM1ghXRFxSDI1tGQ&oe=6ADF6A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueRT1J-56YMQ7kNvwFhRDel&_nc_oc=Adp2ZlKh19x5aDOmh8_rMVvhV3tupYfBD-VCkrTNr_yNv3Py7YDVUDAv5ow2MNmEGp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMejyMABzEgFwXo1pgutok5Snk3FEjSfe-n991BVJ1s7w&oe=6ADF68F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
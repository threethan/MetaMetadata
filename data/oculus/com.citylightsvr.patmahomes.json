/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy0Q9ytzHEAQ7kNvwER5wHq&_nc_oc=Adou7aut7PVLhr5396OoBMRtdBQbC4XoEgFuo20gn8k6pIMJCisQCIXAneLAECUxeas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzp34iRQx1E4F4NcIiRssuGknx4pK7fESmyjyzGi78Mg&oe=6AB3C3B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkKwuKVVagoQ7kNvwGSXji8&_nc_oc=AdqoUuo0JbgoK8GH6Idpx-T_SwL9Zjo-7CgM84fmkG1U-5kuvfDG78SX14B-rJqdwvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUNytbSoBi2fyWZq-ddALvLNm4q5IWsWnYz2L6BYyDJA&oe=6AB3D555"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTHFDJBxVx8Q7kNvwEhq2JB&_nc_oc=AdpWMej5m5SdAQOEwf1jwTHT7V9hxIoTyPEJ0O665B4Iv6R6wmoV0SAA9zU2y8dgvF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITIsKE0NABuEfrTmYzrlkmlFLlQvp8pwX65g1UlLD6vA&oe=6AB3EE37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7GU65foGz8Q7kNvwEsPwj-&_nc_oc=AdpOGXoj9DRIUGOIL0UZ6JwzgHwpWY73i8yTU8B4RarVyQ8OFaeKzfwQ5HASaVI6uvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs0cfS9WXeQzDa5nQFRut-XZz9aaFqPilo5VnRiOi5xQ&oe=6AB3E8E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRMxYExwpCsQ7kNvwEv1VAR&_nc_oc=AdoxZdFG1qccO55lcgurAUJwRWLcfnct4AW1scTalyEpbVeM1_-f3rfPoHWbz93vQ8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRLWCiqAUnxCg25eKupWv_1GTutiOBIfAS4rR94-Lwlg&oe=6AB3E779"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
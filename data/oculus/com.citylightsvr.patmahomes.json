com/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APFxguP5DysQ7kNvwFtq3IV&_nc_oc=AdooZl-hLklZo9Pjl8KfxbkDJBqeHGsVKtAGVGB7VbGjQdnfgrzgUqEkH8GeyOSQZjo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED8eSRDc1YPqKYr0cISzfJBZcSrsD_NqGP0LIqbJcYAg&oe=6A7DB632"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_laci4BjYJsQ7kNvwEi_1SM&_nc_oc=AdoC4WN0FKa0rbM-Kl05UgX_-HWlzn4RdrKkBIiL3Ejn2g1KyVk1bMP3jiCPeGcviwg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED9jJoW4DMAiDxQqePlSnMbBlRNQFOKePrscqJE4eoBw&oe=6A7DC7D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2-8GS8c6QQ7kNvwE_pyRm&_nc_oc=Adr_X57URHfKF559Y9n0p9MgXT9aZs9d0hUbE8yb5S2eLQzIUICzpWiWrVjeaYSkeB8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_FMRxZb4Y5cwBF0Hl2c769qQU2GjkBtVPqtw_mG-JEg&oe=6A7DA877"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVxIhsSgW40Q7kNvwHsyqBA&_nc_oc=Adpm3IhGpclXl75fygdj0ChT8NtRGv7JVoxSZm_rRdxhREvKEStTE4E69egvqMbyXV4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZv7hjonpXNGYOnpVMUINM_5m9Cz5Z7ctmsHXtEFrrDw&oe=6A7DA329"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py2jmVn9ZbkQ7kNvwGsjk2O&_nc_oc=AdqsVsJQoQ4ZrApOUHF3OGMJQTMkz4enAUcnG3Pnc1WP6YK0n5731bdZ-E4Ud-3pw74&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAEQ3BAEAJMHKR0BfkJVugQ1-M1tN42XxDif1Vxs6QIA&oe=6A7DA1B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_su
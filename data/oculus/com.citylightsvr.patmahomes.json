-86SuTgvtDQbCUOj5Sruw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlqh8Uxln454Sn_wY4z6rMjbB3_6AY8BBHKGp6Qootug&oe=6AECAC72"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjLY9FY3pWEQ7kNvwEucWea&_nc_oc=AdpQQ0Le2WVSIgJdw2UzVK9NDjQSdZ4nSOmEiDhdj_gzrR2trc_Y65fuMVeJVD2CH_Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDxGxie8xSnLSgaWymzxWI_nV2qBy3jw992LfK03fyZQ&oe=6AEC85D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U0JhyR_Z8AQ7kNvwGpuo4F&_nc_oc=AdrwjZkh0zHYGJ5Xii-S6dMtmwzJkYOczhWOWvDHJAhc-8RLvoLA210uVnZE5nvS7Io&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvtcakfpdsWSEodPo-2h144n7r83qdUdnTrmDs4M38RA&oe=6AEC9EB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmjMos-DflUQ7kNvwEPED2e&_nc_oc=AdrWwZ5sX--3f1QEeR7Xf4vfgzyor6h3Elx9m5CtG7kDS1CGK6_fNgMgnpBNHstsFJg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiQkblNWtyEfZVd3xuRS0erKi805LlARB87TpDWQqRWw&oe=6AEC9969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAZVOR-nWgwQ7kNvwEZyF_n&_nc_oc=AdpOFJv27TTZTeP4LubCVhL5rQIAEH6_QUby-47ImGR260rd917xU6n0-VUrO8sL_Jc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4pHI8YTzen3VvRwEVJpolLKOaSyegnQxa9HnKwiSRrw&oe=6AEC97F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
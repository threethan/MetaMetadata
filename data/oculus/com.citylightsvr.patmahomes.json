/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQSbRh0m8bUQ7kNvwEUl_sL&_nc_oc=AdpyJ-yMe6PqPPAkCxb7EUgrYpwVQKBot-jYJGVQ2yEw6VF8jpohU_pcON07oknoc2U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHKR-aD61zSN0OxiGdGwib-QMpIMKno22HZf_DWhcF-g&oe=6AE339B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLN9vsbjapoQ7kNvwG5KzV8&_nc_oc=AdpU9EWX0mcBum4FRevaQoyEAsDzBJ1hR3LQMlXW_XlO-3VnOp7pPGG10-BSDbLPKDs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq6Z4s5YSQ7BxJ349vLFHkHBCpRxXEQ8t0nGb9MnTuXg&oe=6AE34B55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiFXfSRfyQoQ7kNvwEVpvWl&_nc_oc=AdqGLZ3dYnhpJuit9ma0vihifj_r43Z6JjTUKs-oKTukd85YR-PdjAyq1US279xXwUE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxrUesH8gkXzJuqtvc8lrXdfD2XOJMaj9IzQOfral7ww&oe=6AE36437"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgIyOdwt6XcQ7kNvwE4MxSC&_nc_oc=AdrR1NnijBBHMo0zHWkU89cbS37JMFqbCE2O7qKf-IaGu_4OwBhgGerzTwNqyervFpk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKLKnNeD4FCBDgJrXvNbati64ZYeU-V9erwUv13zKeDw&oe=6AE35EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPxFKB_-P8oQ7kNvwHW2w0T&_nc_oc=AdqImQP-VPR6RimJ1tzgS5Wy5QK0pcUdDtATN2Qi8NCUlM5X31d_FIC5BiYZrOF3HqE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuX5RxJrENLaZvBt9NbCAW9IP0hLSz3f0lxlX_ayCyEQ&oe=6AE35D79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ2f5wuu0E8Q7kNvwEBCnic&_nc_oc=AdoiXCo_lL0SPwwCXVuqrBhUd7o45acxWjnRiGFuAbnrrsj4a6gGDQ0lRyeeVQaE6iU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DSxd4p5iff_EKNn7mKz83hk2aMe5NslI7PQSiJtTtfQ&oe=6A411132"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGgjkNirARAQ7kNvwFS20mp&_nc_oc=AdoxpaXf78RMgH2WvLQzNG9fkqOIUak_uUpzcsIPA3VzvgzcoZtF-gHeJq-gPGEmf2A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b7Zn_R2fnxW1yD2VE4oJtIZ2Vdjj4xE7CjySPwA9Ptg&oe=6A4122D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJy-446o_EIQ7kNvwHK7SWN&_nc_oc=AdpBiVAXbj6OOP5JHROSKl5leWwwx-Ja7gaFqkB0M8jkLMy0hOlTkjfXEyBwl8ahQSY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a-ZC14Zr80m3GJfWZFTryGPCriFjybnk_vIOYzaiqxA&oe=6A413BB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoMPXL0teaQQ7kNvwGArrw2&_nc_oc=Adp7c8UXGq3EXvtZToAKxqK26S48XpUvF0al8QxQID11ELJMRc9XZY_Ch9pQ7sZzGok&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87xaTJgkPnVjc6XsSnob5ToBf0hsdvoIWliYZupJtn1A&oe=6A413669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-4Izns8wNEQ7kNvwG3sI4i&_nc_oc=AdqwNBIRRyvvi8M4arOyEZ4ruYR6dPXj4y4zcjNaBVcKc1qwikddrDJgthlR9kHJ7LA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eCozkDXwm9TdQKGvKU-niQUagPz8O4PV_yYphAmbiFg&oe=6A4134F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X86zCSdR1QQ7kNvwGZWwBY&_nc_oc=Adr3AFpZHhsVs1ESJknB-EiO4gDCKmJiDkmzeYjBFMWHNuHwZBfI3yxrs7EFQtUZxr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKeMCZZObms2XIjDMg02xb_ptR7KLnbvjrGV4_HsIxeg&oe=6AAFCF32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms9aFTBujIcQ7kNvwE08_gI&_nc_oc=AdoWGiBFwKVgpuOWe9j_rrgr9efplS2Y_AEBmDfrerR88fgNDk-OiSkN177yhAE8oq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItCDZBAcbSCql0QOjOSEqDWq3RR7Q0hjymdtNLjzZeAA&oe=6AAFE0D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qMC42O7vDEQ7kNvwEDHC1T&_nc_oc=AdrU7I311sBy19bon29Aykq0wyihwEaLRdrgeTd4JWrQ_uMDn1yDRfLwZmhRBsmxNZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGRpdKfKeTJ_gOJTQD-WSuV97GKl7_o1T2D_gWMtvz6w&oe=6AAFF9B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4g1Ji_692sQ7kNvwEmU0s0&_nc_oc=Adq4sAj2-2gi-BjPzVUorKnvaD_-XqYCrmf8njyWQXrfMibJQnl5m_yKLKrwkBqCJTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGkLcsrxcgLmwKBYSn5cnZnSEENxrU6OVwzRYVKx2Kuw&oe=6AAFF469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54qlouz-WaUQ7kNvwG5Rz3y&_nc_oc=AdqnIq0lVzkVn7dXDme4slMuw_K1fgnD8J3rN1-wC5_cQ92Kf0jigt60uWh3FdlFKu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrsmnnsCu8P3WGajucylXn0y3i7aovRfxyynYQDxKv4g&oe=6AAFF2F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
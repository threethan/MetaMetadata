/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZBY6b8IzLAQ7kNvwGCDNbH&_nc_oc=AdrKjlZDuzC-X1RR0rJOolyJLq0qGx-MSut2m9SQOen9v10jjvuSS9JtvfYij0C9_zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WBz2Hlgp8QTBW4qzNkH7UR8X9Ch4uVGMnkVW1QRe7Aw&oe=6A3C0372"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyM-hNr3xOoQ7kNvwH0EK21&_nc_oc=Adqk8stYpcALNv0pvU5mx0y1UwA_5WX_hw_PfxWcxR9vOefOiARlR_drYbeq_-Vg79E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MWiP4Ch-LESt-yl6upEmNoh1geK5e3fC0MjRiQbUiCw&oe=6A3BDCD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVPkxvgCGW8Q7kNvwELDSsi&_nc_oc=Ado-OAZtN0jaLDvuQ0JvmrpM3agfhfYIIhJ0kDO3aKkpX32ntsQnk0coDzysTNK6_dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c4erdzC4-xnHAb6xZornRK0n9rkg2GsgKuf92X2TGTw&oe=6A3BF5B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdKU11OSahkQ7kNvwFFnp-z&_nc_oc=AdqbsfM0QINGW83d13upa2wyNKVA2JngMw2FxoyOtVVPlg6-Tjs_1V4zG88Ibo7uQbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6rneUdboaVBQioL5gwz9xt9DrqR9uXSBiVcXaCs_AIg&oe=6A3BF069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz_TSfj3iP8Q7kNvwHMDIrz&_nc_oc=Ado-Fk3XwII53l8m1D2EFuMz-RXqyaTOacmsKMT0Ee_ReFhMeWsCYeu7QPp5aWxdBiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--9SiMCKcXIpI6BWvOI1d9pKdz-k3Pm0TaYTqU9J8UXA&oe=6A3BEEF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
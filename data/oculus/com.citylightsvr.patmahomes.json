/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKdKQWTSJxcQ7kNvwFlNzR-&_nc_oc=AdpcaY_3xYu9UnNi3Nmr7gmVG9N8dtrWsyRT4P_XmsCg6B-dhhzfHNB1QYEERhhIQ1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-raXPovKgAckG9BO-CozkIq0Xmnfe6_eix3m-dm1pdw&oe=69ECB132"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js8UPgQfyD4Q7kNvwFvBU37&_nc_oc=Adpf517th4QglBIgTPAyKokdml5B0P-UN11a2FOSgI1gKYKIzckCypIPDp723FXtXCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tvKHIDHST4lY03G_JXAu3wB4kYooqVuQspc3OItICQg&oe=69ECC2D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0JJ2FaEYeAQ7kNvwFscMNk&_nc_oc=AdoZMuL3dADf13ORxbRoUmd88Qxd83OkbK4kviSi2l-l0mArvxu2b6CiARMGDg0cl2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bju7pyndRYWwdB6O5PGp8Kl6A8V2YNtfOOWHAM24r0g&oe=69ECA377"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdKKd-1KjEAQ7kNvwFRurIB&_nc_oc=AdrwPCbiv5dKoJkL4CgjT8PKI6hdKjBVqNtnQdgq-jLdgUzBx8Es30byEcQZyZEf4mY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HBl-HArJTKOaveuCKBZyF6Loln2tDhrAaoa-2g4yM_Q&oe=69ECD669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8y934_6kuMQ7kNvwGn9ZF6&_nc_oc=AdoHwlhwIirhRmQ8iPDG6Gx1fdLrpvCcFnbJfrORAt_tRPGdEYQDXWMe6YA8G6ruJPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DMnikAwj4rJrwQi4-RJGZhNPuMlOJf1jGR1rj12Jpwg&oe=69ECD4F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg_pCT9NU0kQ7kNvwEYQ9YL&_nc_oc=AdmSLqIGQsdD2RL_FQBNyVqHk8YKDTHM3Mok56ryt19FwWm67ZqFien4bVcrUO-wLR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxANwTSiZQQrer4NOrsIFzoT4Duv04gaVrBa_zGUsN5AA&oe=69B400B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2PEoV13rGAQ7kNvwHOUStd&_nc_oc=Adl0CNA-a_j2kw_bVuv5gAo95THBXw4pkWze6gCbQDxHbxrDX04zoKvLhelmw4Wo66M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyT7_mzrrGurVwVt1Xt624jo6MNEeobnQKWkRsabapf2Q&oe=69B41255"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFrg-_i86I0Q7kNvwH4vwkZ&_nc_oc=AdmzkyYBoccxh92Qm-WqtwiUl2LTxx1EIqyBkRAm_KGZ4ihHhbjahWGzt6M04eTGvq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz9s8HSgNRpaGDEhk6VRSfzr0Bu5Muz0Ggfk6Oj7UGn_A&oe=69B3F2F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA-cx9ENTFoQ7kNvwGScapf&_nc_oc=AdmCim3qgUUTzU7z4R7Emtu9AziJTZ1JOJJe6y_HIvavy2fpqEKefk4F-Az4w4oWAIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjNOEtcBmYpi1u4V9jLcIkOP8v0KC4dp4RUbA6PpPTSA&oe=69B3EDA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCQXE4Tk3VEQ7kNvwGbhXoU&_nc_oc=Adl4SGbayoXegHrLT8Eri8swrX221eHtQvvDLb69KRXmNdmCPGomyx0tTYoaaOWP8I8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ3ctDp7orC9tgt9lZVS8sR1Y9jIpN7jMUdQuS1VwxEw&oe=69B3EC39"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw6RUiof8dcQ7kNvwG4qY02&_nc_oc=Adql99EuLX7_bojoVoYuHPJ0g38ch1dKbLFdWBFnADbAPGFAwuBmX2_Tl9IZAaxZwrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6llny3sjR3HTBkDg5QKQc2_-zbba7rBI_aPJsO2yOpA&oe=6A9C40F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69jrnHnysrMQ7kNvwHeYm37&_nc_oc=AdpZ63k810Oe4DN624LfBgfWqWCq5c2clzPSTjI9EK8pba9ZBMJP4hHyoBVd9fF89mo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK31ozOuP_p-CWeFFvJHDroX2S78uvmWCbogbpvJv3lrw&oe=6A9C1A55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8KdgXaBcLQQ7kNvwHcaRDI&_nc_oc=AdoVPsS-s-vxE_LXti4Yy2bvmVCCq-uCG1j70Tz6x7lCANczLYgpd6TUlSjfa-FNmCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVLp-kIvoeCReHkK5iIg-usEnELlpTHuBLGzbY2K97cQ&oe=6A9C3337"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKkC_IM4LLEQ7kNvwHA1Uyo&_nc_oc=Adog_cZnMkzi4qiIkm2ibCHmXAVL5ANSIYaqz4ZtCcsk6cifIZmTwYdEgh2yjjROWgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyDjzRTdO8P3HtS9VarrupMI8PTp-FQWcs8BAo1FxpjA&oe=6A9C2DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq3cdDoMMRkQ7kNvwHHyWoS&_nc_oc=AdqxGG6-otxLoOFgg5HwMd3gxDIrWfL3qStbI6wS7ZZMXZLN8LGkt2ADzlBDW5EtlF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCB-TmKY6bjL79YVVebtwdKK5poVYwG0Ci7ugQOaODLA&oe=6A9C2C79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5PjoQlKStMQ7kNvwFoeYSA&_nc_oc=AdqoNSXBfXBiEPj3h4tTlS4Lm1zxSUPHjnTLDpq4pcgndwD8D7XN48MdmJcRUW1tF_0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7D64s0P09FdCoZWS4JGlIKkw2PAWokF6NIi0LOegzUg&oe=69C52432"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHKrwr-OvaIQ7kNvwH3igUr&_nc_oc=AdpIGdQWi3b8doc6RG6UVpUORnegSXpBVv9ePpFB0zxcZtdXZ13gp8mc_hrNKd6j8rQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwcwipe0avvrdEYfNDYRjcqlG-aHCkNrU_WfJLZBYY_bQ&oe=69C535D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ4b6jiCOOMQ7kNvwHQMy8s&_nc_oc=AdrfsiNDKHUwD6DVPJpQmi_jabh0uNLavbs1pmIhU7wPrAx7M0bgECDJzZdr1W96z54&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO07jRrPlmqiExK6y6OjG2rcHmOuFGdtlXZCYAGzdM8w&oe=69C51677"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTHAQHXACtAQ7kNvwH3T7yZ&_nc_oc=Adq8W-e1pRwY6oMquVd65eaqRsbWQAZovQVz0jH61joBKdu7Uwb8z2FEtAJl1OZTgDE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwL6oSIAlS-qXOkA_u2fHn2uI1x03UmsxY7hBEFM-FVfA&oe=69C51129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ccj2Zl0HrLYQ7kNvwFx5dKp&_nc_oc=AdoY2NygKRGSpTQGr2w1eWixA4wmrvYzEserCBq6geOQUacOoSxXhWEfCf9pt-wLV98&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIEP1QgizOndilKDm-cRPl8VRqYekDfLRGeSy-0alTng&oe=69C547F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
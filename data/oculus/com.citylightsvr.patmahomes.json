/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7fiYD7ZOAkQ7kNvwGPdBTV&_nc_oc=AdpbSioSx388aGN3Ff8bRpjqWQ6MQ-4C48JZ8GRD4nnopHxqk3osXKm0MkvcGNPTkq4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26VFIfo8c0PxSqXA2C931kKCX_ygr52EaB0C-QRRF3kw&oe=69F348B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiaxB5xTv_8Q7kNvwG04y7t&_nc_oc=AdrCB3ih8i-B4ZKVID3_zOB0yNJ4Cfax0FZ5_nME2L0AqB5FyhO-93nd0iXDpKYFIGE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EJoqe3A1dzi5PyX6qg56DtWUzfWmi_i131JGK85Iq4Q&oe=69F35A55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09SE3glxQeIQ7kNvwHfgWqT&_nc_oc=AdrQIo23J2LJ4YclaXSKBjXsUEdk6oIFqB6T5CSz6-DFPEhZ5Rz-l60V8ai97611npI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1z10TyoN71OEX1DeCOPhKaHRaLIeAhMugofKjiKvMNsQ&oe=69F37337"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgwWs-OXlSoQ7kNvwHgIUZI&_nc_oc=AdpCgWHCidPywWFGqVyXhWy3tHi5CBXJNdiVtfhf7sPfXoS-0vz2NucL6KkFvyacMuw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ytOFhymgeNyxZzXjA4CyrOYfEoHc1DSZYf6vc0Cvclg&oe=69F36DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSsTP0qwcogQ7kNvwGCD60w&_nc_oc=AdoAD4p7G8OF1DkKaE5vQLUrtBlsVwXEKb_0enKDXRT3foVYsG1WNcs3GQg4fc3bteE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uPXhZuvr9S6ILgA74e7M306D25l4By1V-p7dI4xnrvQ&oe=69F36C79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
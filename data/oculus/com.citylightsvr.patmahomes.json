iKXI0T88H8MizNreUiC-an3mtWBqXpW_u3LE5tEBg&oe=69BD3B32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCibHgMre_kQ7kNvwHhFKAv&_nc_oc=AdmI0eu3WM0Xzrqt8bCIdTUPyjbaQxlAUYy8_Jt--cbeq0eYnsR2fgr6PjzQSfuMtW4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPrihF-MSS7KARC-7nQnz55Ry-n7cI0oHgkAFTULz0GA&oe=69BD4CD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTxfB-VryBgQ7kNvwFYxCi4&_nc_oc=AdlamDWsoBbiuESPKDpesr85IDOfrzGPq1UcZxreVJD16xwRBrZLk54aPVcewuFLXpA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwiDc-PNqHD84TPqTF7ENTnTnOnpd7a5zlNM_O49Uxziw&oe=69BD2D77"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=933uE40QDsQQ7kNvwGYlybg&_nc_oc=AdkzvO4Cd3MHyPVrScEHR4ROv6J2lJ7yj0TJZiOupjhZGiVcNquXBm2ehq4V8TjjkGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoRWdqZ0EuL1hJtXfKTzWFl4zFNdH8nn4gcvnyRVuWbw&oe=69BD2829"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaWbXmtyw2cQ7kNvwGi8Qzu&_nc_oc=Adlff7ejIT6CSBPGLO9nZOeSa0zPnPLZdmFXsKJkhsd2QuQYr7wAVJ0mbVG0PZ8Eq7o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxO8CMndFx1fXq5ADmBG6saLTmqgko7AcMATc9Mw_FNfQ&oe=69BD5EF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
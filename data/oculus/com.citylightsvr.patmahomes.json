/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X2E7U-OtFUQ7kNvwEWDc-g&_nc_oc=Adr_-oS5bRzQK69zNYURHxYUKm80MFXx8noHdkCkC3PAdCco2lzSk9ekQ6hu39_6nQg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwFnm1sjmtzcu9J_DkqRTH2t78I051c-QSm5gdRa56dQ&oe=6A54D7B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQOMNygXtk0Q7kNvwGSN7dB&_nc_oc=AdrX_biTzbJk3D9yFq76Ag4ZLK2i5q_N4EshNGwLkzO1nfxjvazFK2Ygl9yZTI1kaNk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTXGHyo0rg5hCmjze7BihKVXZhUxPtlyqQm9yl_OAyXQ&oe=6A54E955"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHVhVCxZVCYQ7kNvwG10Amf&_nc_oc=Adp6AcBxKk1tlIXfMq21IKvEjsMx5lc1Ds47d4oLqn15lbSTpdMJAwRbc52Tp1MYZf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSw7zN95kll5IFmykiHUdG1CpGDqZR1LuMxe7lTdtj2w&oe=6A550237"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE8WOsDzmlYQ7kNvwHmjE_r&_nc_oc=AdpTpSd55S-Pm_gLFYx7yEiKYFGzewzUFA1Dn35bXd5T_a7eGgHfL7aKRaUChnH0FtA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMEfXqp8g7eZiV1Yn_7dY-vyG12MNNOPp7msd1_3-MUA&oe=6A54FCE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga2umuAblGMQ7kNvwG9Lr5U&_nc_oc=AdpwPWDXyC2Z2oPFfipmkuOJDOEriipHVHnLuEZbjU3UA5A6ycTwcth6CbAhxbodmjc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPx-RbCySwZIt_MBQ4nbnDezfhTqlr0JJDVo8JGvqSrA&oe=6A54FB79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
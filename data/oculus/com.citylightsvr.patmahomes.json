0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg_pCT9NU0kQ7kNvwGilwBj&_nc_oc=AdmjyyoLQeFawUJdd3VZ35xdtvJgxyBrdjPuq-QdCPaEC4m8eTZQs1Fd-lgYeY1qBjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyshFeeUiFsaoGiLGxX01KuCIRkICF7xPu660Nijl-5oA&oe=69B6A3B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDaMNgZOJ_gQ7kNvwHpupR_&_nc_oc=AdlnLh8fRxB4Tgl78YHJjP-HTwksZQFhrGpTglpMLx7ZVpLt47RyzEm7_iYY0oIOgVw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7_2cZDzSPJdhvdonwXQ5TEiePvd4LMEG_zENxvYSwZA&oe=69B6B555"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFrg-_i86I0Q7kNvwH0t61R&_nc_oc=Adk3EU9YO187ZQ-c8aO0Em94ZOeeTxUG9JNxgneelehGP5GJj14YxQfl5q3qCt6Lnac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZiZKiWlIJHgBiUvhvuUfyQdNus5Z3FTFHd5XA0B4Eag&oe=69B695F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30omubT0sgYQ7kNvwFkMY_C&_nc_oc=AdlaOXafGUAoUJHUM9YCCRiqItm_OV94Rv1MtBek6Bif5XEQZn38H-P02uPS41uUpVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBZ-A1sYKmtcTmSpcdkxPOnjq_QX_oVO3vANV1OYFopw&oe=69B690A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWnXOImrNuAQ7kNvwESaBHp&_nc_oc=AdlMNMCwrK1U-qhJHjeDC7jHLcqwmVwfjZzQk13IsMfpZmxHlyzAD9JwiCSEGtzo7So&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz90ARazASEhrNwaouo5yDug2T6vLxJmLK4afTxbcmY8Q&oe=69B68F39"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APFxguP5DysQ7kNvwG1aujC&_nc_oc=AdrokhNNrURYKuE96HsL7G0e9H4Dg2UbOhZC7xwKDrMClAkrcSOH4iZzIVGHlMxvOak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz2uZ6g_6eM81qiP95XW2iOt5cfHVM72oxWRd9e8KU1Q&oe=6A7F07B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpBOkDx5VYkQ7kNvwGMU9L7&_nc_oc=AdrxQk03Om1gxj0qx-JbcdREAZ4TCh7B_w2CdbULT73dbmthTcuf5DsSvXZrmzIeZA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCE03YLw7zJijaPzE1ZNDMx37N1QHwm8oKIQ1MdajidA&oe=6A7F1955"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2-8GS8c6QQ7kNvwF1BWeP&_nc_oc=AdpPynLg_ne-4Eq151Fk7cVcDRSlbV_-1aLdI5lmtwIG2BSNK8pO4wzuvc0p4kweyW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf7ldVeVlRMPdBLUKrkU2FroIL3kWQEj4tlnNzUQOqAw&oe=6A7EF9F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxdwf3K9hkgQ7kNvwEeKsh0&_nc_oc=AdobdkImYEvhzsVEzH8b-6sIPrC5zKe0WaW_7WHqxwwnyidY9ruDwdCW17AuOCftGqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvqSmJcRk5EFs6CS4xOr-d2Xucw74eAGlX3GsvyLyd-A&oe=6A7EF4A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py2jmVn9ZbkQ7kNvwFCiNC8&_nc_oc=AdpheiS89zPQfQ3eUGLzyDeTqFUV7Jt_DdfLi1zF5aMCCbhwAT2EJJqxXtdFOnNi-bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGosL7T4Y-YSNJPwqc0WtfYHtSlBeDIWDrO030xKmBBw&oe=6A7EF339"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
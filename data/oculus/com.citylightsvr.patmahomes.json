k2utlmNhDv6XV5y2Fy9nk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIv5od3N_Fmvbj2GbALQF7UCGXmQ95OQglzEDsvokAhw&oe=6A8AE532"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6LUMSXy_uoQ7kNvwHlFqtI&_nc_oc=AdpU3xyRbJ-C0BFyRWaWgAJ0hk49y48Yy_WVc_NFs5YOWhhp2bOhJaA4dkJyT_3crF4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_rS6nb2v-LjJAiHbjzZX6vZnsdwu-sVnghTJzX_-HjQ&oe=6A8AF6D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRhPr3G3WSAQ7kNvwGMOb54&_nc_oc=AdqjIGwnlNIl6NAX9ti_pqiO98UQBalODeJ5JKNY-8q0HhdlFM2G6oP_h1gz-9V265A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKNgiYiG3PNVaYhduHzkfmR6GOj2s2tQ74iyWfn4MQ6g&oe=6A8AD777"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzGNro0rVfIQ7kNvwGlz2Nw&_nc_oc=AdpeLYeJGVkcF7DBLYD9rlMjjLb10a0ktBvynfcBEh7xbJ-VhqmE4l2DgMjbHLj4khg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0q2-y1U_-FmYCOsNcA5KIdxu3T9TWZaOMPq-aA9Pltw&oe=6A8AD229"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpLy2FCfedgQ7kNvwFV21cs&_nc_oc=Adqs3Fhr9_zrf3BvEQvdcETzIb_uCuVz33dWTf5qhU0I8dNntMMizW1S2LyNwwbPozw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESFYJIEu7kxVjJPJv55s_-1Igqnbxr9kzqnxbRNUfZ_g&oe=6A8AD0B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
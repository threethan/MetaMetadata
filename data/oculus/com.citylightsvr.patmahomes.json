/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZBY6b8IzLAQ7kNvwFhTrd0&_nc_oc=AdohBmEYcVq6SKEIgo3u-hemRjSsBwRRbpuDsm-KHV8JXAJfNX4jZnglK9PJAcvYyNY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A3hSsOWWMrJLJtg0DlZSyZEn3n6P7KwpuhIYGFi2g5w&oe=6A3D54F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyM-hNr3xOoQ7kNvwEV0GJH&_nc_oc=AdoA0NViwFKTrqNneMfk3NOLlj7ronoIcyTsFPptcT6VhESytzlt_YcBhvkFSyAW-ks&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9crulx0ARwUhA8G7pgaUOiL_9NfBlwS3mOs6TUCQfk7A&oe=6A3D2E55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVPkxvgCGW8Q7kNvwHdbFS0&_nc_oc=Ado8TSY5S6An6AfIq80tJJ3k4R1aaOvzgko-LZlF6_uQM4-OvlyPSkSEECFzjIvq17o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ItJILX1Gtk7kNWzAG7fq0KuwxshJjWPjBZglEKTGclA&oe=6A3D4737"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdKU11OSahkQ7kNvwEOyGkg&_nc_oc=AdqqYB_Ondge0NIgb8nNLfGGHQVDE0X_3d0OpRCB_jwWTzUfveDzClOxs2d97Iu4NhI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jHIhnoq20XLo7osqh1Nge9T6oFqDQvEF32bE92-XknQ&oe=6A3D41E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPHX74_ReK8Q7kNvwGkY5A8&_nc_oc=AdqIPcvBZJh5FpgLPAnPBRpDXpzEcgokOr-med6lsNNOCVbm-9gTp25Fc1rOhHL1Z_4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af842NSQCbC21P6N_P1QOTJJHpJCIY6VIthRn1IpYZYrnw&oe=6A3D4079"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
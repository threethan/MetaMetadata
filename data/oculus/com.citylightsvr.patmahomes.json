4sP3hjf8jpqG3Hv2IOBSY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx8yze6yA4_LjQIyMytQ8WFPMqpVuWbq0PsP8WKj36eQ&oe=6A941FB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1AjFdjIUREQ7kNvwE9e7mZ&_nc_oc=AdoZwWWd5sIM_BF-VujEHU9lAgoP6jemSRcm23qiNm5YqOJJL-lVS3D23E3a8Xaekvg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP_LnlVwAFZYvfiAsPmU7DNWvIOUf9bfGSgcs4JNShsg&oe=6A943155"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drS-3Ax1mM4Q7kNvwHzs8r3&_nc_oc=AdrPSjowL-PsAgIroVHUG1aAu728XvedOrVqSIWx3yMLA5baqr_hv-XC-eoWdBpC3H4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoaJVBgL6NiUyQAShZHhIFpudx7h3pRnspYX_RAMGOpQ&oe=6A9411F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI94E9f8GGMQ7kNvwHfgNxC&_nc_oc=Adpe7D2GhiuXDXR0hpTDmZq3cfqkbxUIebJQF0dpVrmo9GrmlDGKwqxMBh2i1H4atpw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1NtI-7HJQ7Rap0hipUsxi9O9-KmFgAT9P3Qn-SKrrPg&oe=6A940CA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F0ilI_RsFAQ7kNvwG5IJsY&_nc_oc=Ado0E3A4C-2zdmTdxoambJGLwloPWk-0I7Erncxk_MHs4J2qSg62N_Z5W14YMB1viOA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVqIt6YhpJgZil75ZMgSDneU2ZqS126e0V0VD6UCZASA&oe=6A940B39"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
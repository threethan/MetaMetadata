4WJf6bO22lCGNZAbrQOUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5Z1XxteJ5Lc2XU_MFsag53SSj63zNemDT04FVk3YSsg&oe=6ACA6572"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USPHsF4W5g4Q7kNvwE608LP&_nc_oc=AdoyDUS31zjekQL7fuQxBrtXj5FJ_c3xWQscHjsW1LTUQNGU7MsO9uOKTq8M5vqRs7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxuxNC_NqP0rSv62gGrOmbhavIrrLDqNurbpCrkufuzA&oe=6ACA7715"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TivW28u_wL4Q7kNvwFXy4Fw&_nc_oc=AdrZcZzzwr6VICVQuR5aSkOJTav2ErAzzEyB2b8jEjMkSqRqwMesR__IcRa4xbnhIXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKsrQMyc0xa3iRiG2-Um7s-Pui3-sNd464FROU_VsHrg&oe=6ACA57B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9UmMSeq4zQQ7kNvwEWCoRz&_nc_oc=AdpBYCU6QQ0j4BS9ZWX9eUscOY-tEHNhoDbNMFCeoZihokCXR8m2UB1tLzo4QOOBIy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM21Zwh2kwZwTkRm5AaLucTZx6AMnKFB-PkG61huw5m9g&oe=6ACA5269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmfL5fxqOf4Q7kNvwGLpJGI&_nc_oc=AdpHnE8kSm-SXbfq9XOrnvkjnYgdUrn8p1KUaZmQTeYXacO-wlRxwlnM0vyREzensZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQN5wEW3juHYKY2HmVZ53E2WQQbu-HRHj6K4dq7U8XXA&oe=6ACA50F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
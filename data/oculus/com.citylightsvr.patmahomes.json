0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICI07EZjFBwQ7kNvwFRG7CK&_nc_oc=AdntCt7zmrNCFJl2AwN6Etpq5dFSwJa6X8IH-TAz0RVfTZSbeITIceenSL3VuBgzvGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQaN1XnI8CWXbAJqte1Do44SSvfShCoFpGPLHLYHeAlA&oe=69BE8CB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCibHgMre_kQ7kNvwF3Rwqt&_nc_oc=AdlEe-i8UNvuP62JNny2lCwPFCz2Z3w972ROfTUQXFFQt4h3eTz7-uxv3RIJ3mKP6Ls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwF8iMBmY44JjvUg3UH_MAx94NW_8hVSNhqcLRfdfpBQA&oe=69BE9E55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTxfB-VryBgQ7kNvwFkw5BZ&_nc_oc=Admrttit2fxMTBDGfCT0WZfSQnK8kIy3wIZ55jZZOApMRT17zLwpQVBRRBncl0NaU5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx91VRRFACn59LZtTnED7F01QHUBPOH5j8YSJ454jYQNQ&oe=69BE7EF7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=933uE40QDsQQ7kNvwH1W-hB&_nc_oc=Adm-lDjz5GeE0EZ7y6s1FEgYAZB5VCOpBesFl0lCwfIc_RRU_cT0LLT8Fv7W3K9A2LA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyItFzmGPMFpPrbJwY6BHI0jlqIqlGvCK4LJTVRH5iAyw&oe=69BE79A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EbyWafwS8oQ7kNvwFL0hSm&_nc_oc=AdlJoPkJLY935NDzgf5oQ-L646ldyzwAkgY-zJ4T55xBfbtOXXkZesYy2hfqoESwKpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuZX4pPzAzhcM_gHbgwpRCfrGzextQIwA4D_4MtzUKaA&oe=69BE7839"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
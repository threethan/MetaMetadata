/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5g35YJ69E0Q7kNvwGO0Yt8&_nc_oc=AdrmFMNpGLJOU7cOAzVfBFIry0sTZIChtd2ktRLL71Xzc0wzKcz0Cv0gkiI6uz8MqTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFV48lKaUnxK4oDiEEdU0iDumB4YWnpYbjly1QlgGFEw&oe=6A5E1232"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7MXk2DzfjwQ7kNvwEXnIR_&_nc_oc=AdqfP6N0ktfMBQxIiYSm4nU6PuCtMhKxLmnNuywNo6u8M3o5y6z-_dUy9o5giuCvrIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuKTbvRr2x8RbaqRgDDIViJDOdX5j8Vnx_Zowo9S2Tsg&oe=6A5E23D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxsQDXQ5HLcQ7kNvwFphS7Y&_nc_oc=AdqpfAbfxZC4giYvoXcVseD91AsQ1SSwUwGWpWg5aDxWcKNpa4ds43TRcVm5DiM5Ehg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnXwV814xrHs1hivmBoltexaxQ8UuZofMWBGhZIX6bHg&oe=6A5E0477"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JvgHGG6xhAQ7kNvwGQ8ov8&_nc_oc=Adrcv42xUiIQbr7-1tSAG5P4sIL9Do2UOYv01ZZQ28TqQF93RikCy3gm3n3Rn1cMVYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4pfi4ih7nFoC07xs14ObtIMOlZAks6he0INSjsZCOqA&oe=6A5E3769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zugHSEhM7d4Q7kNvwHJsefy&_nc_oc=AdqIs-OYuzEvl-z2ccPdNM_zzgTCP9kcYIbLRk7RQkuwXP57irlBO8kVVNVwCOq931Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCFxo-F30jXnXO9PHeqrGg1P2luuwtyYRiTNVClrZsRQ&oe=6A5E35F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqWwiCZGWpYQ7kNvwE6bzsW&_nc_oc=Adoo14sSLjEwfR-ncvGMqCfdVBdvwE_ulWyfISfh-8WRU9sSiGUJBF0WJHqKKDQujVk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3SBTcoSLP88YN1Wz5My0H8esdlzpEV_GoN6CkLkz6Ww&oe=6A917CB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4wDC_iROxUQ7kNvwEzuUdT&_nc_oc=AdoZM4Y33-7NfA6mT1Vc4IUdlvtyjbFEDZlz6s2gQhxh0641JOAhpyVGwEOYr_6kbS0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr1qEj3K14pKxqb8K-SyyQQyGiO7-8yDL6ttBqXW3w_Q&oe=6A918E55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drS-3Ax1mM4Q7kNvwFJYWhv&_nc_oc=AdqJ0MvNb9-doDD3ZIUM2UqA70KMmsVVY6aokooELJxyYOKiLy4mOqFo891q8bGju8A&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfNbcJW-2bywaejWPxYoaQk4ovKfDsfnjSsdkFs1jsoQ&oe=6A916EF7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7qx5UJEK6IQ7kNvwHKACsO&_nc_oc=AdpBEI6OXZP5vOTpHE4xupBWSUnyRRyqVZsNHVcvjLWmFwMVDynLd6c1UCR2j6syhEc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXApQGC4XT5XBLsJmNE-UrBefsV1yqLSHItttuTW4sKg&oe=6A9169A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlzKnJAaZOIQ7kNvwHZxTI2&_nc_oc=Adq31fdfDh-MGHe6_cz7p0ybIDBkjsnKr4eegMnzbp-OlDhoVAhpzpWMXVAh7dEb5Qg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF5FcwxdMH39ZpZDdXwXllQlyI7MtBmcFwSWL8jl7pXA&oe=6A916839"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
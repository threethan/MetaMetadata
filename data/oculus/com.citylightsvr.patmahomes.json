/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WAUEuObYn4Q7kNvwGhEyBm&_nc_oc=AdoQPbyPOVbpLRw1ZiQJC6gnys28i0Kfl8im2RHozegZwS1A4x6rVZ8jMMSIsO-qeCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0E1R-XB9ba8AQJ0ntXWaCo8fQYQ8nFLPvuN0lCETBMw&oe=6AD0FCF2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4VP6k8pIhIQ7kNvwGIFMjI&_nc_oc=Ador8FW5Q-Nz0FWQUQ62tmN9-g2FrALO-2Ao9zLe7vHD-Kqp9jvn5MU61LisCJep13o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJKFvCAq4ql1JAw52o4yV8rHsn81NDF0yHdfisEv-3oQ&oe=6AD0D655"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfG0DJzueyEQ7kNvwF50heX&_nc_oc=Ado3qiKQdmOxZJgtkrSqynq11WxBCDHtATu-jTTyJQinoB1x1KsSwYwPYvHJz4LA92w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqdbEOPzx4WCNbDYl5mSUSBCKfeYMl34p555JguTNOxQ&oe=6AD0EF37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf-NypX9gFoQ7kNvwF0aSjo&_nc_oc=AdrN9m_ML1ANbgI-AmbT_JqjcwlKZpmzQ3TahA4fOjeAD-FbpuVndjIahJUfp-VhioQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb9zM31AH52tm4Ro4UjRPGlGpGd9KOyto32lGH3Oinqw&oe=6AD0E9E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRiNBH8A05oQ7kNvwFr_Hju&_nc_oc=AdotXlKJDi_ofe5om25NOtW72amfzHd03deda9EwDSqLC8hEpxmdWbDywytMl-EECvU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfo1Re31eP7U5It6pTcejqKRNFBYc_kuV5phg75cL_ng&oe=6AD0E879"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
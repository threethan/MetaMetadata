/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hl_63wynI6UQ7kNvwFh0YEC&_nc_oc=AdpApGmcOa3ZFObf3JbQFjup31T9PpNwvl4buO2Hcde17d4qKmM1oeMwkRV7sws0kRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkpsuuYWiXQ2KrqhSyZZbyHtz56c4YGFEOtsbkV13puw&oe=6A82FC32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O36RIV4P2IQQ7kNvwEOj-eu&_nc_oc=Adr8D5c5wvX-6LlySMet4YVh-h0bQBOx2E6BHQDBTnd-N1OH4Bn-1dee1_COgNuv-Lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEvMJLtFDjAbt6iK66AZyxlnVh0OwXpjm0OFVfJEd5CQ&oe=6A830DD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyt53rrAGNgQ7kNvwH3uAPM&_nc_oc=AdqFHfws8VMFQpLxh2nYl5OjybYxG1GivMf1oPVGAphs8tPkffHs1sejk6ghAHRoFwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyRmSEk7gMxkJ0aAEFK124tKvxaZjaW0sUL6NszrIB7w&oe=6A82EE77"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iU9VwOlLDMQ7kNvwGneljF&_nc_oc=AdrXeydZeR02krTpwpcR3uujBGTIB19KqAXF4-1Z4C9J7A8fzTu-KUe69ah29K6G9as&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhyb7A9nv-oVuRiXNHkCluH7ETL4JRaMfIHn9Bkceq2Q&oe=6A82E929"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LN1CO_pRuYoQ7kNvwEY3h_q&_nc_oc=AdoB-WSrqpwAyEdXz8xEQDQ3DdzNoTHNGuQ3ynDhdQvaYthBa4lXDb1zfuo5kiaOQ4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEynehwaHIunln4dvRMd_GYuViFua02vUXu6r53o2-BEQ&oe=6A82E7B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
i-sqAYZX-qydyrZqPJRKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeRvy4jddlURioVYO6ihfB0qMy_JBBKCDKiHJPXqKAHg&oe=6ADDF3B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akRYvYXDPeYQ7kNvwFRFmpt&_nc_oc=AdpLBYD-6jU2SzgWmz9tlaUo1ola2--wArLS14bqcwXGl9U9DhT2PbrHVwb1P7uT5h8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3eiFypCFkd7VH0V_jmQVrpiKncLnlsnXWfhle2U9wXQ&oe=6ADE0555"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob8jMcOJvmQQ7kNvwFdLrkZ&_nc_oc=AdrR3sJWVkk5L2YituO1Dv5QiUbjtNT0mtg6u6tDcCvxOndt2IKwfeGBOakzzg15_W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIgXeinVfy3jy7x44GbrVE5CfLwNajIu2MqQCoOhrWuQ&oe=6ADE1E37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kURdMSjyr0sQ7kNvwHmuKYX&_nc_oc=AdpEGzyElv_C6KWWJcQdn0yuR9r_mfo-neBvvgKLukidwzT_S8ptn4rmH6WdBtwAjOU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNarBJhv-zV6K4sKpjIHvZvGy0A7BVl38HwGAjuCdZ2zg&oe=6ADE18E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5VXXRGRxSkQ7kNvwGBD5uJ&_nc_oc=AdpxJAMuVSgSIOiN0GrPaYtreUbfLf3kUL5qEYo82CrmAxLPQBNct5voz3xercHQU6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLwviUaE-9Wva2yJauWME8gwG88WSSKRT26R4En725dQ&oe=6ADE1779"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP4gMJQGwksQ7kNvwH-ttU6&_nc_oc=AdplX3e-qp2RIZolZNkH8CtVjKwODphOaXHaOY4aVjq7fDXWWOlZzFS2k8ZCuRJSufk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5seKoYque4lHPHFlRJTFsCW1caWiZomU4UbfDaKtiVYg&oe=6A01C932"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVBAPc1LexgQ7kNvwEaEjpy&_nc_oc=AdrP_hq6Zx-2ceM8gYWyhmLvmUn3Kw5q5R-kulNBIZugXfMG8rvcMWzjmM3N2aaX7pA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69ACyIxScN1c_QtmD606ZCbVdlNEsDPbH7aPMQXSRc7g&oe=6A01DAD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7S-S4Acq9oQ7kNvwGdT4zN&_nc_oc=AdpWXiNiWuim2v6-iypfEXyHZP_21MtaZ8CD4A1fPf83whM8QcA0fRtVqhn7yMrd9kw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HMFTuwomU0NMmBY-RkKO-DzzAYRumnJFgNExVymP1iw&oe=6A01F3B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LPtyjwNRK0Q7kNvwEBSM0z&_nc_oc=Ado_071ljQ7qDiiqVxbwEJefnDl3qmeguK8fnJT38tPZhD7ly3ZFc4n7N3EdRTc6Hg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TP1dFyZIPAg1M8ksnYH6UQfURZdvZPBT0K7aARs-hYQ&oe=6A01EE69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FimwxRulGa4Q7kNvwHcNGA1&_nc_oc=Adoo63AL3quLShCtYtQmeQPZFG_TVQYvevi86NhvGcQ8QIVnGBRbVDnqROGAwrH8HmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7caN9DMDqlvoViPnug8tjrrr28DWh11fVZlevdGOAu8g&oe=6A01ECF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
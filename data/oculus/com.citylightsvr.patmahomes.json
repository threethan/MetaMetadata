/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpzpljlf980Q7kNvwFYKqsx&_nc_oc=Adrwqt4U9rSc-pkjdo8c6oIiPRrwh-V8YB1BXC9EuYFr3YWTYW6YAzpIMwVq2EtoqBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-IKRRLcpcvCsLp2_tR4KZML0aKwTZHFMzEMklto3zNw&oe=6A7C64B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_laci4BjYJsQ7kNvwHU7HVi&_nc_oc=AdrzDR-xiPvKCZbxm-VoUrbMEWTkZlpdk3qpZSBzl164X8v-kgoDdez1Qd-zwNLsqF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkOKoPnzeONSlkB9MZp_qsuGwEU02s2bdqF82CARRnBg&oe=6A7C7655"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ab6OCUWd6EQ7kNvwES9Amp&_nc_oc=AdpDfzt7R7-W0lcoilwttLUl6sqBsprhfuq6LHuNYznX3ZkyJ7RlIYrYfWVk65rpaBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcm_0eQPLLOQDbf4htDtahXN4GMBfBdOcBbCahmIJNNQ&oe=6A7C56F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVxIhsSgW40Q7kNvwEhUecx&_nc_oc=AdpjBkNBq-C8Ao4c0JB4DhZQ1qNl5-1vJQ5Re7OdRJFgvUBJp9iCxkSB6V5P7J5tgGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFGE94f0EFBtHNmsxzQeTogjCpkPaA951dGYzQ5ig-Uw&oe=6A7C51A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py2jmVn9ZbkQ7kNvwH4W2a0&_nc_oc=Ado9oQ4AgVSAhnD8-1udo0yy5gcG3gbbpbdSPz1SW2eQZ2u4FsFShQxWCRvAUy4N2Dw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSzHLVYdEHlPuQBPTI4zcJxe33CYj-9snwEwpOgZXBjw&oe=6A7C5039"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
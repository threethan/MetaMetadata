ZMgTdw-kGDj07tVQkniGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61RP0amRVR6JXswVsnTylKL9fuhpg9TmzWTPlcCZO4IA&oe=69FB31B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYU4jSVrc1MQ7kNvwGUNHkq&_nc_oc=AdpQkvScQ0raJMCgkQnbAojmkmpz7tAlZZcVznGN27UGVeT26cMIWrx3CYzmzQwIl-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rrFjPAHIUF2KcgKWey5zqYl35cCasLQ2bWPyCFiG9ng&oe=69FB4355"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxYbVMQtaMsQ7kNvwGlzClC&_nc_oc=Adp3dQ0lCembjuj1YAYd7Tt_bbGYeTOCPRTAlqbnzaK8CiYECSbUW27yk75PIGO1cb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ACzbjsghgjRi7ODMLSIOMDnBWVwOJJ4OSK9S4jTiT9Q&oe=69FB5C37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8htn4Ucvc4Q7kNvwEHwW0X&_nc_oc=AdqVmPnLB_FBptzFGkc6b64Lvr5Bbv3OO5PAVAfNVUPNhS4fQMEPjHOm5YdqAPX01ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k0FF4vcWIVIiUO-cQpglBAH8fgSyQRfArSa9yAGJr2A&oe=69FB56E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahXTlWtoa1kQ7kNvwFVT9O2&_nc_oc=AdpaqYZVUTlFnpmeH2Zh1GW0XqGONw9rsu0_wQylm4mA9Mdi3q_6jhsUh25uRaUNoXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z5uaOUYgUewQxcgYssDhGVsDAiIOYWEB5BAxiR0X3gA&oe=69FB5579"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
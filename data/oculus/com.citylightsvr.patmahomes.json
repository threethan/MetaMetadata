/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dohFZhIElSwQ7kNvwHn1AfQ&_nc_oc=Adr-kj_S1-FQh73g-ZfhOgM98b5daTDgzPlRihbcwySksUB4M7LYUCPKI1pDihjQ_1U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLMDUh3Z4RHNrt9eJNWZtS_0AWDPmB_CmgV9VaoQpWVA&oe=6AF0A0F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKccWHpC8CgQ7kNvwFQc8vG&_nc_oc=Adrbtu9QtqtdFv2j0P0bFujyJsYbohmvPOyMyFu-NFGoPj667ZnA4reuDWf1IM7wbhs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-krSoZTytdCNoLjRmbPTvqmriEDAxoESkguDmRqUeMg&oe=6AF0B295"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eFydDqxTFUQ7kNvwFiPS8L&_nc_oc=Adp_DKgN2DRH4zrMFONWtW1cJXGh98CDgEWbaOBZQJ_0lFNRarMjvlTA-AZWUFunsL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeg1uNzNeuXH0a4WfqxqLdRKKAPLPN31vZLQWS-RMvJw&oe=6AF09337"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O412eewukkQ7kNvwEujrAx&_nc_oc=Adq3kYbY9hNJPOJWb3CVUgrrva4U0elYcSe5PLsbdU8AB8ifA4g4tbSbVssJJqPgeiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHh8OF-WiK8pn8evIjzL8YnAz2NOx8KxaP3woKMREG_A&oe=6AF08DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTZtKS4JgB0Q7kNvwHr_eQZ&_nc_oc=AdrEijySkUd_rtCEvUfl_dcXmIg3Vz7lMFaivy05TGQjq0iObLWTuQLg-Ky7SEtr98s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT07HV5FcqVdRWes8dDiMucIArBH9kb6YwTF1SxuNvOKg&oe=6AF08C79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
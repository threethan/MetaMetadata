vOCPo8JUDNhlX5XdDhwEE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeIvNF-q7JDJUdv3ph0vfVW5xfTuD6MhyGbfL53gxjuQ&oe=6A973332"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGcmf2z5uB0Q7kNvwHMKA1m&_nc_oc=AdoUSlDjsFbKjOXXWHAztGurU5d_0hqVNteo962FK2k5NGhR2q6vKgyfBvJ8tL1RhsM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgLr9VbrrHbxcm4AV7nzSeHxFlvcRTU8CFli2Fx95HSw&oe=6A9744D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZByYXuBxc98Q7kNvwHeOitf&_nc_oc=AdoIrCa6lUUtDr1zZm1gAg0MKZauEvOgmD78gnBZb7Iimon7VL-l-IzM4BOz_LPE7sU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyzcsNRAKro8nYj-dvCPNLMsx71W6YuydSo7gMnAFFRg&oe=6A972577"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVn-NGwLk6QQ7kNvwEXjAsb&_nc_oc=Adq_6OHMbSIRUdNiQHHAdGSoNg3yYTrgehitkNmdm8rB7WjPglA8VCY8sPr04Sj1XAI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhWC8Aa18kGZslmvN9Q402nf36SvfmC-dytADovsIUJA&oe=6A972029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3cukDU9-McQ7kNvwED0Geq&_nc_oc=AdqVvDHnLDUjrmHuMPQf0n4FXdiZfNGt6VdC8TF0ccPECeM6_k8dgGHzwSnPPSLAsdk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg51H3eCGSGz7KNmY_xj4bMU-gXboOThfhS8jYWGaTog&oe=6A971EB9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn__yBFLxlQQ7kNvwFpBhz3&_nc_oc=AdrYq9BZrjNEVn7tGYE2OUK7IGbAnGuo_Um-c8yRD-PpFJO7ITu2KClePOnt2FfXarA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEIEn00hoCk8FLCw10ticLet04bx_Dz1pfje2g9EFyyg&oe=6AABDAB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljZHiVWXmEkQ7kNvwF6i26j&_nc_oc=AdrF_oBTf-qzBRzIKv47Am5R83Oe0uGU4SiX_8B9x1yUQlJ-nlNfiOQfOcuILVKnZQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx1VH7u2xBwvp29pF59aUC8TVI6tDY6rVpIVRr9Ghlpw&oe=6AABEC55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X96A9PUBmyYQ7kNvwFizQk7&_nc_oc=Ado8vUrok-kr9QUTskCv0ItKJEuUHAofzlpRqo9zMKMlg4GTuu3F8A_ewQjVrBKJI3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL99umGM4kQnROIPxi2vS-ZZAkRy4FwSSpKY9UFu6DwhQ&oe=6AAC0537"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILIuVtlqLusQ7kNvwFMKZe1&_nc_oc=Adp6JB4D4miNMWVyAFSQ73DILmzZN2w5kIHFexTVf5lGNqvsNjuqjyBhJnut8V2ucXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkZF_3mAV2rN5gwo9KBmnzYxf2TKSmqgo1Kt4g5BoCrg&oe=6AABFFE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjcsyjGghzUQ7kNvwFBeWF9&_nc_oc=AdrCEldGZfdBAINcBCN70XI2qezpiRfrL13mBdyzXLQa2oh3mAFJhHDix8rGl2dD-8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm2u5T4Q2RMUUUHkCYS_xCdrQbZlA7Ud2WP1hyJkNBZA&oe=6AABFE79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
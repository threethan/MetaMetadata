/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IO1VfaMpJA0Q7kNvwGVb9f1&_nc_oc=Ado_hRKRUvoZlIOGwyNppgcqkwfiAwetBUOLMpUG5RL-OLRrGA5Z7Gs9A5qI0XW5GWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2tB_yO36iE_PV-KLHOEse01Q2ENVwLEJOfS2EpyruSg&oe=6AF49572"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYdZY7nnqG4Q7kNvwGoPjR2&_nc_oc=AdrX5shxG7mQ4I_F7vWmbfcwzdCHTovHgIvk1cWR2BVmCoNmB8iLtg-A8Co18Sr-yt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsmf7d1d_I6-jx32zpW91nvlzO_Od6cZR7wPrqNKxwWA&oe=6AF46ED5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q0QK474rlcQ7kNvwE947sC&_nc_oc=Adqe4rje4jbvo2rRyt6n13xw8-H0HtUTsIWQAgmL8ovTU1evprHbnyBtnEobU3hayko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFJHpOhcYejBOFnfIPV_wT3leM-3f0TumtmFbEJgcK0g&oe=6AF487B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n01UStdwg4Q7kNvwGwk8TC&_nc_oc=Adop8-mChk8n6F2EFqLY_aJ285gqlr4z-bia7lvKuXE5YOvovfg7rC8Fyfwe-CjEebU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFHBzdl1ah0MWbLnOWNdhyvQ06jnpU5_DyhtsNAZHbow&oe=6AF48269"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o91zOI1u7xIQ7kNvwEiQ-SC&_nc_oc=AdqsyElaOKT_c8D0sJgDIbhELdvsZ26jSblcksfWGYoJ9G43p8YvtW-c8s-fEAM1er0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSib5Zg7WkNNmVcP1ZTiaHPJycfBojycI_nW84eh4qkg&oe=6AF480F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
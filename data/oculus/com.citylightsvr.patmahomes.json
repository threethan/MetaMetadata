/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oclRW8M8csQ7kNvwEEDC7k&_nc_oc=AdqlleFyhyOLohC5Oy9bNt4iUPyLCPnIz6Tu6lyVTaTGKyTk7ml_QYFlOGpER5IJIzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMYXSByKSkHbA49Udtastr-v8Fj0xBIDoq1KH4TQUymg&oe=6AE76672"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlJD6kZPx94Q7kNvwGjgIhU&_nc_oc=Adr12mpRH44-tDYNdtpqPWhOHRJTZQMxluSDmY7nWD7PKGkVYPfIrKvW13rRYuhmzlc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7x8rUviYZ-rNKSRNMUyUPtIOtXm4Ok0GjHAfSqWWDmQ&oe=6AE73FD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L58iFQj03dYQ7kNvwHmC_m8&_nc_oc=AdpiDTb95Vbuevi2ACz5yujICcfzybNvXnh4MXXl9PV-DYVrAx0hRVQi6ctvFkIrwag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMX9Ekt8i3ojugQjz9-LpEqPKzepa_NZnlSn4YJpVETA&oe=6AE758B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwQI_CM1_w4Q7kNvwE9ujDc&_nc_oc=AdphzWO9VqsSaYf2heWPGq76OHawElTp3tkUfzRg--iSlE0XkKCyUQgZEglYpbn2iI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHwk1-4EHZzAhDwCPZkiqJBgi2n6WsohV5T9LgHZDMKA&oe=6AE75369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8y4UGgbYLAQ7kNvwHy2j66&_nc_oc=AdpPDzLy1MxSgvOkDE9doISrPLmu9MFMeK3VrZ56a8cHJeaN2e2cngZ_pZJda-W_m-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKlg6XRupQgZgP-ZH2hKWpgwyaxQlF1UaZef75J-FbRg&oe=6AE751F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
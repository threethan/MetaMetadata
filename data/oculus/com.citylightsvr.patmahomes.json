/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N0qtC9xAc8Q7kNvwHKSt8Z&_nc_oc=Ados0UT4QqHW5qqbTMwf2sJtv3_v5gz61Sd5YWUJnHyyevP5jv5tpKg7it80sTel6ic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XYK5lSF-WnXUAvHR1bYDN1PPHB646v7MebHppeE9cHQ&oe=6A0C5532"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRhG9ZARjkUQ7kNvwHqYa9L&_nc_oc=Ado5UB6PcZHCdRdHbr4tHxXGTSJnuZNlmoPKW830G_gazFd8RvO3SVDfP-Au7wyBY2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TT7TfNR3C5LfAYxR-bPHBp8NJJeK2l97-iGBRo7fQ_g&oe=6A0C66D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UspQFCXuaMoQ7kNvwFBYaQy&_nc_oc=Adr3-EOAR9Pk6Feg8FM4ndg4d87ktYRY9wD9JpI08v3UEQyriRH0rR66DuqQ7ramFQg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R3XUSPQ2ecyGIdERUXACwcqISTAVQsmQu_9foavH3cA&oe=6A0C7FB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qteCIz2PLewQ7kNvwGrMgyu&_nc_oc=AdrS1skeJPJSLN4A5mokMxsUyTbvoTDNQ73Jnz5S-vv2km8V9qUZ3ZZVv0PZt8X9oDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EaQHysnd7Xjr-5Xo5mQQd5bXX1TSADM4LPiFp74YuAQ&oe=6A0C7A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YFC4Xd7Mg4Q7kNvwF05MNS&_nc_oc=AdpTB7VqMHl5AWMPJpFV5P-WEItnPjEmmfecD8Gx26In8XNjJ7sy30oHAqe5tbvi0iY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yW4rERj9q_lGrqCe0AXp5PBFEqf1BusX_xiqdY2K_eg&oe=6A0C78F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
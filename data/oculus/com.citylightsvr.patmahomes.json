/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5l-1mGIG-UQ7kNvwHwI4Xc&_nc_oc=AdoZPzYw-XksJDBWBQ6bC14lgdT9a1t7SArpxMKkyu0Xoef-9kHiAVCd9POn8Pu067Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQSjpieABDmIREhko3qH2IKcWZrh-mKa6kS_p4upQlyg&oe=6AC7C272"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzBYZctGGPkQ7kNvwGaSjgG&_nc_oc=AdrRn-2eJv4zk4S-NHKIr8L9sjv--7B_AlvK8EqXLWtKz8y7lDJlb-MHXsb0N0vm3As&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHRigY6PHsvZ29HUUEDv4TOwLKgEZPGtS3YLXr5yS5Zw&oe=6AC79BD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvFiDaC21nMQ7kNvwEXpLbP&_nc_oc=Adr__GpwRIHS__8zFFrQyGV6hN77eeTAvwawj0QC0D5WIC63mDpMLoVqmd5wW87M204&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdk6Hb0zPtUMhEp_Po6dWz7_gK2UaJcjhl7gepCOeppg&oe=6AC7B4B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwJAZeyj_G8Q7kNvwGP9sSq&_nc_oc=AdqesuaAoX1c1zsKnYJIVo0RLuBoPERfTon2-dIE5dyBXOu43PxXnwb8M2c7L_124AY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNsHekZxOjMsdPGJq2z0oKTIWxByNpbUPIIPWxOf1oaA&oe=6AC7AF69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmfL5fxqOf4Q7kNvwGAuZ7_&_nc_oc=Adq4DbQYTeBz2mWegC6e9xMCcfXjd1nOaJv6RpwskDsFfXZRN3sHQ2Yd2WfF1HrzlF0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMChfWynTOXEq3ZkE8PHh-_PFDlwI0Xpcg3ONyyKlTyqg&oe=6AC7ADF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
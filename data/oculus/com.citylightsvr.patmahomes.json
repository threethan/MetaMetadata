0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUCfx3upTGAQ7kNvwFdkRFS&_nc_oc=AdkqqsU9DLIpOm6OPT5tMcS3W2Co0C3DHNsvlNmippUlg1ymUCCL3zvP127HY5Zcj3I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afypv_n3GM2gQVhJdKfT9cJ0dTkNHbCQLihmPp8X_5G1Fg&oe=69B7F532"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDaMNgZOJ_gQ7kNvwFgJKnp&_nc_oc=Adn5lfsHbxs7sHhk-sZ_TamUXJWBxAARye4EOi9CF9BT8MyGLZu-T6uNd1V2jU8ll7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4OUU5XpvGJMNk5XuNwFkNuvlGbS_jOwgJM-1n-ktksQ&oe=69B806D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNveHYPruTgQ7kNvwHCppw9&_nc_oc=AdnRaK96VITyt3lgP6GiFBzZOTsi2R3b4hVTM7VeRFEzIIfv2oh56j8fkL8gfLbphls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxm0sf_l2ZYwpxyjHBV97Zay140wWuI5hRCsDymky3l4A&oe=69B7E777"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30omubT0sgYQ7kNvwFi7BzB&_nc_oc=AdnBIVYvw8cchkptn7vzg9jqb9chAVkdEQXt6gomZ2jE8kJ5i0MDilBG0qBYl25sdEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwELxZP7S7Hzv1m79v0PI6GGIvUMXqUak6BQCpK6BPaaw&oe=69B7E229"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWnXOImrNuAQ7kNvwEzMMph&_nc_oc=Adkfvw0yQG6vyOH7ZZ_ffQ45F4w_PCPFYsA_ITlJWslZsPZg3sA2OCcTZ5EXr1sTF-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD417J0d7heJjf-BWh16Gd-5YskJmLpY9BJbhtrCZqSQ&oe=69B7E0B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
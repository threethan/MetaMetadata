0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUCfx3upTGAQ7kNvwEWMPSy&_nc_oc=AdltndoaJV0O8Qbrl5fkBGuxxXwlYgSL_n31oYm8T0Rids_pK4j_K9o7MWKc7i28fUM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwo58bXVaND8f5JbaLpI5XDug3Z9p9f1LVWQuSoMZJrdQ&oe=69BA9832"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0yFjcjQl1gQ7kNvwGD9SPQ&_nc_oc=AdnjhauZl72m8DiasSlxZSpJSpx-HZDUo1dEtunIv8qSFFhtvp2YVaF6Yz5RVdnpHUQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbJL9o2AnkNt6-NpAkoJAcOblvd25ToyY8ZI4iRIqLlA&oe=69BAA9D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNveHYPruTgQ7kNvwGeD8yQ&_nc_oc=AdlX02-q8QUH8XPZK_u47OlehxcmdAf8BUzcG4N7TwhEeheYLS-oqTmV995y9wwXJDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBfGDd59lnQfrDTJ8biVEjGoWqNwKhkLP7Ps8uKv3NhQ&oe=69BA8A77"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7NSxeNyVEYQ7kNvwHuW9sf&_nc_oc=AdnMTrdgtIGJNopi1W_dznU6E45954MvJIMOzyN3L0OZQ0zGnwWej8LzIHfR8qi88Aw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPxC7uJvyQZKXKXH2d7he50u-RqiC7Gl5Xl6wlAjpKHA&oe=69BA8529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaWbXmtyw2cQ7kNvwFn4kOc&_nc_oc=Admj6VktcgTl3BoyDAiEFzakn4qrC9nNsoKXauO6pK_yN8XnwcGqaJ0bLSOW9kZGaG0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzweRsHnLGlVxsGDqCt6-WiRnXtgHIV3m9gwN3caNApbw&oe=69BA83B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-P9xOG3n0gQ7kNvwHE9R6Q&_nc_oc=AdmeTkMjx24vMxi_AsTJfUU3vAjMyudakGkeBWaqSjDdOAX-TMOxwaCe05p0oPzJ5Lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0Ls9lXY01aiBpH5ZKWjSYRzjmkXPU49-3L6TQ0G640Q&oe=69AD6932"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdZLBfKcI4sQ7kNvwED-7Lu&_nc_oc=AdnQV5PCoGDgNGXayY7aNJA8_QsIM75toRN6C7HlSWHBrlg5PxYrWNE4YA2Ztu2PNbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoIksI3BPKBW8RP06FC4t3ATrljl8r2rzyFnRAvBw6qg&oe=69AD7AD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krq7h99xDCIQ7kNvwEBoufP&_nc_oc=Adkdb6AIlp20LEeRFWHhKNGOU2Fr6REioP4AnPXUQx2Rb8YFIrXaQqWvQqrXS0_T-2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1w_MN1WQyJQ0Q46-5mU9tQHjRgxFjX4sJQ1kv_jReKA&oe=69AD5B77"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lQXTYsKn54Q7kNvwGlveYl&_nc_oc=Adk-t6G-vEAMzwMx3l9TRwkkch-BGYWu9jEmiaTVPW30_vY9vvUvKu7febcPUsNnqfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw125XPJHfwmdD8yJNSJpZ7IKN8kMklYKv5k94BWURDLQ&oe=69AD5629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T7kt69kTxoQ7kNvwFlK70n&_nc_oc=Adndx5la2UjJXgH1MyiqOUL9rdPHhRUNLdIL-Vy_ftkGEV54rviYUUtJ-cex308QqsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzT22IRyPTLhPcVb0ezxzyhjdUSUpffMOiN9S2u5Y7JFg&oe=69AD54B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0sTC893Ow8Q7kNvwHo24be&_nc_oc=Adq2LFZUnPWbAQSX6cDRHFZwfIEkgCSoWFzDQ_v9SbUwVQxq9-lRQKHKw5X_CgoQgtw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqy01ppAsbLHB9dKBMktntvudz1vyIWc5BGV4L2xbZPQ&oe=6A71D8B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5Mmw8A_Yt8Q7kNvwGfR5MR&_nc_oc=AdrZU8RsWFzQjUfWaAXUowXdtWzQRrcTWUuVL3GnEa8fjJevz5lVsV38G9tPXulZsE8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYgIplN8Xc_bfq9l3v6A2gHN9Nc7Bbgleo3KHauOCbtg&oe=6A71EA55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9svkIuAVIwQ7kNvwHHg--R&_nc_oc=AdpXqO_9Urt3EpAsL9HjGuFrUXkIMBCMTNRnpGbLv2sSktwZTC4_Zm6Nit7RXKL2JS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-mzscYCNp0VQ7X0gmgTMhBZPVE8PoYydyYhw_rhvZQQ&oe=6A720337"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi6YLkERt38Q7kNvwEDD3A-&_nc_oc=AdpV7Q9QSNh84s5fegQfcZnzMjvczV2uVc588ZdTA81ViltYuRm-9ZO8MydqbKOmLdk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKL9kTPudvUp0ZjdKaRm-h9tdnNHw4r1ERkTZTfUazeA&oe=6A71FDE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2ncmkTTI88Q7kNvwHN5GL8&_nc_oc=AdpssO1AlOx5jVsiMnMJImeBsxpTFEqwXmKV_xi7DtaJY1tE__gbpcxwPx1XOI9PoOg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDlPsQdP-PLznwDjCik102249D0189coag8V9q20iERg&oe=6A71FC79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
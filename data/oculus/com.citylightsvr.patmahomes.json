/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jj2qgnbwwAQ7kNvwF11fUj&_nc_oc=Adr0EitzuNTWo-gzu4hK-6g6yJQ7we6lF3CmUXA-xDuNU7E8vC3TRUpHugH1ngElwNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Uqfbolra8LjjoauNOSRWpvdqwjxTxMfl8u6dJzju-bA&oe=69D25332"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpoF2GCG598Q7kNvwEMeSlr&_nc_oc=Adomjnq2ffx30cZxBB9nQGcMx4BvFT5R6k5DWwFEfQirUH65Y35buGcbDEA32eRLFes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cxGGrVC4REBFY6fb2IGrcfmIDyaiAZdro3GGJtPmoUA&oe=69D264D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_VX0KzL_IgQ7kNvwGW-bzx&_nc_oc=AdqDiC2LAUfxYuBJVuOJ2AmG7qvvDTqNzUAAffjm54wia0Ms9deVyZRrIpDHtNZl8Fc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ccNzCZcZeSIDZ4NFfr1IqVEsDfBynB1GccpflVz1atA&oe=69D27DB7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR42l20X9qMQ7kNvwFhZGfY&_nc_oc=AdpPkEPMqxTm8foiCV9ldf7m2vQMgLPKZuiL88Kb_mPAqksV_GZyPtZ0optAXB42q8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nsL3LXaDkK0meCEkALz3qdwtm1c9z07qaXOt5pTTKCw&oe=69D27869"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JaFIHpv8PsQ7kNvwExi2Vl&_nc_oc=AdodJNxIHKuHM_yk4o72zfL27JGLuS7udhcxNCCMpyUpYYy2gWOGNdp5wXmWczazDnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29ZTxTBt0iztVPK5_067DqR7mPt4XL_mfoXjNrZVii3g&oe=69D276F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQSbRh0m8bUQ7kNvwEfOWBc&_nc_oc=Ador_xLpwGBpM1SNNdGValyCALR8f1Ma_f6eNTI9vfS7h2nMJc0nmRuW4k_cmQj1v2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxJAmtH-biWNNQKpOKe8KoCJ_IWfM--lPuL7rzGtJSzg&oe=6AE096B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akRYvYXDPeYQ7kNvwE2sA9B&_nc_oc=AdrnszpJ75SF-khFDJp7MrFvEPIQZ1f3BJh8QHkbhayRcX0si88oypR7xKdQ0XZHmAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh29gBlCZjm6LeFTFeTb82kpJxbY2eu6tWtS7LCVaJhA&oe=6AE0A855"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiFXfSRfyQoQ7kNvwFussl3&_nc_oc=Ado8sdbcv3petdWotvZtVIIcem_8NvfnbYxTRn3ptZKwIR28MDaxNDr7tWn2chYNacs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ-82_efcqmXFjAcLPWHcSl_ll-ub68q_JnyN1PdOlRw&oe=6AE0C137"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kURdMSjyr0sQ7kNvwFrMpN4&_nc_oc=Adr0jygdyjFkAC-R9CJhGJBH5s0vpOOBOVwV51xGh0j8cE4VDtzSpbGb9Go80fVOvYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyVp1pMnR8zA93uyBbhLk065VxWXzcRCmM1JxWlR2xqg&oe=6AE0BBE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueRT1J-56YMQ7kNvwGQbJlI&_nc_oc=Ado_aWveR5A06_RyoIh8jnXrxv4COJ1HVowhszOCk3BpIfZv9W8HQ4nQEyb5Svf9us8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPp64Yk-tcytjKxA1i5PJd7iyMCGYImOp4YZPoyNcbaw&oe=6AE0BA79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si6vpmVB4HEQ7kNvwF-979A&_nc_oc=AdpW2Bxccq79C4wUIpbk4DNaECv8LRPeWBw_wlHdEvuEEVi5UE_-LC8z5MBowkbV_vI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAWSIMW1Zg6vHU6EB8ago4MnziUc2BYq648G-Cgbq8CA&oe=6A5A1DB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAf9vWR2nKsQ7kNvwFqdMuf&_nc_oc=AdrGGzO4YUHQ13QOmuaeldGdIEUra6KVSIeJMYGZQYLmg7uQSfE-XsEjhxB8QdmObWw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUgwVikB2_88gnF-EcTMVw0mW0ILm5gmISv5jIf2b5aw&oe=6A5A2F55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjSxUE7YOb0Q7kNvwGVRU-l&_nc_oc=Adp0rVzQVfOknvsQg1ZUFelQm8wTaulkP7hG892imIROYj91tep148F8RRfEYQ9aLMs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvWvw-8_9NXuDr6lqPcn7hte7d60yX7W-Y0wO8ZVgDog&oe=6A5A4837"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYdpAQRjJEUQ7kNvwGFW8-O&_nc_oc=AdpoSr0o8hKksBZrXsNL_12M_X17XO9YR3_vCA_CEVByfYNO2XvggbD5MVlPA_DPbOY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZnak61bpl2WEhd4Sk0v4vmNKwzHTpeT80DlwzLf12dg&oe=6A5A42E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7MFNDCJ3qUQ7kNvwGSr1Si&_nc_oc=Adrsc2fruGaMdV3yKCG-0hkI4LTk-WjZ_2qxIwgtK7AOgrGR0M4x2XGD_QLawlePNt8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD79VpgXpoy1Tk2nP3kBYZ3gHL8FMFCoWvTzds-o_JaXQ&oe=6A5A4179"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
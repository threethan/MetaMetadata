/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3nHpD-ywM0Q7kNvwFjfjC9&_nc_oc=AdpspX30XCYFSCKy3g0v0gACLCJhIuQN5gGhR5sELoNsRNMypMoih_wwam49x4deMMM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YqJlmxBCCijcNW2LIALEZF4bRSUWuujFTHrBe1o-Ncg&oe=6A12ECB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7pMZR0Hd-4Q7kNvwHJymBM&_nc_oc=AdpWAtw98IWNzKlpvfeYHNz6FxylMeYCeDukzA32JxlzKSd14IqVti9CbBuvdxMt3ZU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QIcrLgm2J69nNITHkxB2uFjGYd9xicna47bBvI-CPdw&oe=6A12FE55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PDKqIaExV8Q7kNvwHSYb9H&_nc_oc=AdqrjUo7ERHP1_7eXfGqoQBmTYgc_gQOY7_6eDlcRKn11cvJGQQyk0D2rup2hoKMXgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cv3b3g1Fwjdte8s05BrfyY6HlZvKPYOfsl1R--0D0zg&oe=6A131737"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrf9_JjFVTAQ7kNvwGUKSji&_nc_oc=AdptW97Zs2p_Ei1VRwwHxStgini1OObXe9AzM0D_UmjvMKbbkMjNn9RoOLPuhEtiKUY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rDpcUJahLnk4DtsQZn0H0g165eMU-ebmaESb8pTdAWQ&oe=6A1311E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnie0lKbZVYQ7kNvwHuWTbm&_nc_oc=AdomC__Yx_lt3uxHhbJFmG9gZZ4vQQT7XsMTOUKcq7RqFh7mgFxXasX0d7FZASO8fZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e7xfzIl3KbtT3SxQLEFdzYH17-GASgMN1mTn7KV4IRA&oe=6A131079"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
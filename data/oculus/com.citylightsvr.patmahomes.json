/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqWwiCZGWpYQ7kNvwFohDNu&_nc_oc=Adpsp9iKuarE-tmJUgx1tFFyggz9vydwIQkvMyoYdU_AzpmczGglIv5TVvbDCZWt_qc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT-jsTYmkXBkuyT_p5Lol9wAxTR1O-fQLbEHrdB2aNbA&oe=6A92CE32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1AjFdjIUREQ7kNvwHBB8Uh&_nc_oc=Adp7zDLUtCnH3GCe1aeBaUj1yaXf5buNkbmvT6jesd5zbpvIZaeEw5nOMGMbmsyQjLo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSwghC4kMrY7B0eZXvVJWJ_JTVrCQ8eM-r4ClYFg0V4Q&oe=6A92DFD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drS-3Ax1mM4Q7kNvwHFN3kS&_nc_oc=AdpMEKD0Akb4KOWkX8G7mq_6-3I1r0W1HLOLhFehAPUCrgAahKxfEs0_3sl3vNs8NIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5ai4ksyYrJh5oZqCKFe3aYM8uIQ8HiqOWsVor-DJQsw&oe=6A92C077"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI94E9f8GGMQ7kNvwG2EZyl&_nc_oc=AdpcwRj4dRqHpI_h1I8lqA8JNfMEn-IjazSXStpgEG8SbuPkKlNJgl5-8WZOJvpHo0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGijEFdLrQ1iSUjVGUqhpiJafdFEpWWQQYGkBS8YKSs0Q&oe=6A92BB29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlzKnJAaZOIQ7kNvwF36Qbb&_nc_oc=Adouvz_Q-v-V0DRHjL04h26FFsL8i7kabmeJSX7usOo_0hy_BexyJRvGqOgBXxSBTjM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhtV67BqCLc520i9DFs14NXF7OGxm5Y0WL87MHGWCeOg&oe=6A92B9B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKdKQWTSJxcQ7kNvwHMkDqu&_nc_oc=Ado0YKZ74LMX7QGMd57iS6EYg0eyjAXx1JM9I7OGBKfZswdfEqtw_E-N3vCo_KN_808&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16s7NhIzi1OlumcAH83SoZxEYBzwCrik1wxPAnpBOozg&oe=69EB5FB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kELkwWJ1lZ0Q7kNvwEmSwbv&_nc_oc=AdoCzg7CasrRWx_BoRVp0sXlxEnjr2qfbFAD90bOzMcGxYaugAhizh-jPZuHVkV82xs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BUsJl2PPGmhtJd47PZEm5rsF68HIimvSE0mBfxLXhpg&oe=69EB7155"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0JJ2FaEYeAQ7kNvwFhPUq1&_nc_oc=AdpgHo0GogooGik_T4HgrknP7TP9h_OYZMcK-UDw3SkMIFsoxYwPhd49ieRDhoELMl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PwSpgS8xGow3IQLZwrT2sIFBQVSMp3Vy95n2gVCOcpg&oe=69EB8A37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZLWBlXSJpYQ7kNvwGkzEtn&_nc_oc=AdrtIYUfNIlTEVFQH1JK7R4RQCCw7vJ5tvGEJWy_0_g3xU66R7A7E3dof-V1i9GBdeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WjhPvTurFH88RDflgomRQTCen3T1vvDYyQmIsJH4RMw&oe=69EB84E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8y934_6kuMQ7kNvwEzT8r0&_nc_oc=Adpt3JFHnXltYfUpJHAkZYCCwr8UShu2dShGNOeF7Buk4kEhXtqC2tOP_4kxVX5CYW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dbtguda98Xbqk0uxbW-ph9Z7Bs13lyd9CBuvzsMECBg&oe=69EB8379"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkuBgEefaPIQ7kNvwHhKz-B&_nc_oc=AdpQSH0KJ7Yrx8fi_Yskh62QHa9BlC7WvT1-0nHYyuSE5HDAJBA7esTDUUbn-eP0a88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGjq4Da_slBmQQlr_nDMiSrCbs5Kf6Ju2wbaNVMEJ16g&oe=6ABE87F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IG3tOGGtxJwQ7kNvwEjyDKC&_nc_oc=AdrkJxJqFSoqLC_tOVXMuHhGbGXLqx2HxaAOssyan3cVd8JJxElmy50WU4pX5FlAblk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8HWsxh7t4C0h8jgwTQipMJxJibfIXr3iAdm89B533ug&oe=6ABE6155"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAbUZ_kagvEQ7kNvwE-X8Hz&_nc_oc=AdqIfYc59dDwSmHKekTdxNvRz8HcwYJD1uaPpyFAdNHaU0NmkR1xzxncgw6JBqrSmNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8eLR1IZtSvQKxi8QkmD28GdUm8GbyjyMuAfkg-LVaZw&oe=6ABE7A37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtpVHrMZO4UQ7kNvwF-OaXp&_nc_oc=Adq6drfz_BFXxGhhHKfc2TrRrHnZymdhzfDdDanyW65ODA-pYy2jatwm7s-hcuELIOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhXer6mFNtRqEU4xZgsTSqwPLVlKVOF-QujP5Jzv3ZMA&oe=6ABE74E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yp2mbawPD6kQ7kNvwF2ugYv&_nc_oc=AdpdVlgXv_UsilOS2T6_a2ugLUbcAm1MTyAlZAUkU_T_fIPzKXxHBVXlROZlhRWT1N4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII1aQxYnFKH0ZyiQ04JuMKs6yK-3N6GInmFSY4DYI0mQ&oe=6ABE7379"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oclRW8M8csQ7kNvwFjxUwm&_nc_oc=Adqwfh0u17eN3Ivlm7-ZbZlyjvgwBxELmL7TOkqhUkSAqXrP5INDLF3bOX_HwMiMwo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_dkgwKU-Lz2BXql_V2ODD9NDzNZeyFJJO2EOBs-BX_g&oe=6AE48B32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLN9vsbjapoQ7kNvwFv7zAa&_nc_oc=Adqz3juUR_-hCZgMYBaD_5F2sRXu095vKT92bjhU15VqH-9_y6h66vQs0IT2o3VI93I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK8kOR7tcGz1MDeScNwSQ7WFDHY4C6t9o9xZjEIpDf3Q&oe=6AE49CD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L58iFQj03dYQ7kNvwFLhl3L&_nc_oc=AdomwjZlFqT9Eh2SwIGfejaNQJ_2yvk_JTpMgdvuKkLBE12MXhex3l0lz6W97qz9NWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYGYF0d_KlzZ8_mY02df-nHDP_tcOnFO8oMlHUlQIBaw&oe=6AE4B5B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgIyOdwt6XcQ7kNvwHEdthn&_nc_oc=AdraKkudMm3MMqAJilofvOIoNpYS2VCWKnWj5tVW52HFDHTRF6LHekvu1OJGvH425Nc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEER0XT91FyWC3JolfBjp1fMW-aNqm1MKcGx9Mlhe-wA&oe=6AE4B069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPxFKB_-P8oQ7kNvwF7xtrd&_nc_oc=Adodx0x1g49LeqaQR5n4c4EnhRUC_W3NUMV7vPowY0ft-NNhk3LUR0zxHQ1Bgu9ji9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbgxGTbJq-K3YQaN-XdrLJj9N1ihVQ5P7qS-uAvXm-Kw&oe=6AE4AEF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoZOWRsctc8Q7kNvwGbuvef&_nc_oc=AdqHj50igF1cPNlgFW3pqZtbh3sSeGz896kJ1SfC4nGPp-m4mwv03Z9BxvWCiqEQ23w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DApP7Vg9JRqEnx9Zl5R-TAGXrIwEjpSnXV7n3zPPXPg&oe=69EA0E32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kELkwWJ1lZ0Q7kNvwHLSdEF&_nc_oc=AdqD12cDWpeT6djUZQZwWAfgmx1hH17rgBEJ_L7MCsYQqkEmGO-Jgli1nmH05U8zD3M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VkJWxzHNUtxcDYHGllX3kskEddcJunInaL1hSbi7v0A&oe=69EA1FD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoNc0koLED8Q7kNvwGH6ywE&_nc_oc=Adrn06eM9LnElbJIYV1693B8ggkEIaljaCOeeYuQrftqY6jcZ8prWhC-s1fHe5_WNeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NFmMM3BRafYqGUL1b_zs8qYwyexfkgBqmNf8T3TkHVw&oe=69EA38B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZLWBlXSJpYQ7kNvwEUMg3d&_nc_oc=AdoVLc7g6VSAXchg1xrzOpyFVLs_qHMlodHzNnppF62EhVp2XJjyoEhxwKr3signNmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k2qlnWh1aNmsYt_gGeiu4N1nFMz2MPsdiVG-S6VeK4w&oe=69EA3369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8y934_6kuMQ7kNvwFQ10Z3&_nc_oc=AdoBbvf4yZuqIa57R1g0s6qnfJUdKwbphsVnJG6YUwU9kUJdd5LiYXlou-770Qkfunw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bzgAnSqKtQmR5ReStcbbcBp6gXbv_7xVH_2Nnfvsm4g&oe=69EA31F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
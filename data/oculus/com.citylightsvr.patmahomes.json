0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qtOkLczRqcQ7kNvwHHrmI2&_nc_oc=Adou8nZhX3rcmN8FGKyp-x9LZC0QBdbaxboGSGEOd_7peDZCro8sBb2A46RvxhRfvW8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyc91q_FkQXn4aES1II8XFSdvKmD_-kVJb099Q0xrfIXQ&oe=69C12FB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z_mEC7eHdgQ7kNvwEraDGk&_nc_oc=AdqwidcGY1xITDzKr2k4sfNJwzkMnz9QmgpS-TJZysAWn01F43qKfFPDlP2s9LMoWzw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqlv1BVGCYe5piDXmzNGEJ1njUcNl204tvFrY0kIhmlA&oe=69C14155"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxaNR14qw4kQ7kNvwE4XK-g&_nc_oc=AdrQ-z5np2kGgiPo4DiZ1dfLVc1ZzYIYZvD_bNNuG34E1nqeAZdLjD8IhjPf00onnms&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzdnjHZ985GDwPpvVqteQxucne0dt6BNRO5xBJqaRz6Bw&oe=69C121F7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF-CBnt2kXQQ7kNvwEDuEzk&_nc_oc=Adp27ZB6R4HnRC2TjqxKmxB9vWwC39BYd1NLWHmyETdPktCIE0j0MD5hwpVPyK-MLmc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxaVB-sN5gAh-rzi39vQ8pLuvdcjhu2GrBdmejhjcJKBA&oe=69C11CA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EbyWafwS8oQ7kNvwE0lg5P&_nc_oc=AdoCIJ6RZ4F7jsag0yWofQ4Y3iPjsysD_haHstY2WjNZTaJ9lg6gREMG2hun0kTbJgQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUqEEDGax9BlhiYFyK8xfE2qUUCbgR8XYdjJotWkz4wg&oe=69C11B39"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NzE3BqnMPsQ7kNvwGP2YZI&_nc_oc=AdpOXNFhnGZPMzHXkQdzkhijHh-X7VcikKf-ts7UxeVFHt9uqYeZrNtVVVPq7yAXCNM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w-Hj_eVoG3RUYOf8C-aV-jI6aSxJHG3uVNaVI7b13Ww&oe=6A0EF832"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRhG9ZARjkUQ7kNvwHSP2I0&_nc_oc=AdoyBaYpR-XuE-v48lhGWorOpgZEWKpu8dkusy87EfNQaLffTmlbmanzbYWxWW3J8ts&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E_0NZSo8pFzHwyymzbhusxH_7G5zSno6KeCx9yK-6fA&oe=6A0F09D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kswWWmfUlWsQ7kNvwFMj44U&_nc_oc=AdpRWVSAheHZiZTf1MoRem1aNe4XGQwNxKIcrFVY4NEGAboOCPhxqVs__VPRsq71gOU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af598CVacJ_Gw6sK1_V7gxDXJ0w2JGzS8of9ddGVUs1Y1w&oe=6A0F22B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qteCIz2PLewQ7kNvwG2nF_p&_nc_oc=Ado1uE7EUsBwlgUCiuZYoH1a_-dWB4Z_s6-WBAn4sTQ4TJCwwK63FCuYNtoO9jWIp6U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Aa4ePaxM1Nty2D_XbT_1FR4osrf1B_PMfbknTy1S_ZQ&oe=6A0F1D69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEyeoTl5qkMQ7kNvwHlmm9L&_nc_oc=AdoGihMSEAD8IXG1mcIg-Wej5FPgqc0BShsD1jtwByG-ZAXOLXnfgIr4A2Q7pzqt8LU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lt1wAo74Oz9wwgqg8FiLnjoFwAQKexfQ4PycpBC4B8Q&oe=6A0F1BF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5l-1mGIG-UQ7kNvwFha2wF&_nc_oc=AdoRiy2gjtaImR4319FgsIxDgMKuYmaBxzs1Dq12YbyhjWJVPN_CA9KA_y9bPrni9fc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODVDDj9j_dierTas1fHrZGf2yr1XSJ98MCfvn6ciHgSA&oe=6AC51F72"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vsJ9FGlN4QQ7kNvwFpBcIP&_nc_oc=AdqxGD4-zra-zwoiCrGVFzrwDeqtnARmUKT1ur80AFxHoLpdhhINfpelIMtpUFs9e9Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD0a8cnzp5twUc1KV3ojoG-CLtBeNso8MiNk4uUry9Fw&oe=6AC4F8D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvFiDaC21nMQ7kNvwHXXWIJ&_nc_oc=AdqK2cN3MiF_TOzHnGNoiZM8AaEJWC23YUohefFIRDJgIpH9ADVYTudxI2yu8_M4GHA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEFxrjXvzBZe6vSNhCmMtohxKCHLA5J4SivD_xP80eOg&oe=6AC511B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MqtswsYSr8Q7kNvwENdTf1&_nc_oc=Adr1lxTqTB8YX1L41gtSlZ59kGcmbd4wVBuA2RAwy3nOHkmo7R-87o5juJwl-KIQWBc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj9DSDqa7d70t6oOi51phf5gByA13TFj-rThRhfp1hCQ&oe=6AC50C69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY1CPs5AXk0Q7kNvwFpuqb8&_nc_oc=Adojoos14AVWv-0I9sKhG3pjvWruNC0P_H9HKl2gp3lOE81W6vIOvhLAhI97L2SlHgQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIncpDTBUbN8mOLVSzmMJT_vjDj4Dm2zeNke4e5Y_AXw&oe=6AC50AF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
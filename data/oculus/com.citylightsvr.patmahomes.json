/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-bYPjCHfAUQ7kNvwEtiHUF&_nc_oc=Adq4b9XlN805WIQHH8-1QwX2h_AWOd1lraDOvljOnXRt52b9hYLXbGRD7kqx5JaJcVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F8n8RL8aX89g44h6m7Pv_o4Wd4nkxpKYnuHGM9cLmUw&oe=69DF8232"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BG7YJS_rVEQ7kNvwFyXt-M&_nc_oc=AdoCwo3tIl0rkLWS4930JpMMV9U0p42c10B_KiY-YVaUcOIVts8LfazLjvEYpju-y1M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sGPRL8HBG01h1NXFGkLrY71IjI1-eaOmCOEO0Rsg9GA&oe=69DF93D5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMlxDHPfQVYQ7kNvwFVfyxi&_nc_oc=Adq4f8nRbDKl6L5ogjR7IJx8CFYeGzHd_NtibR2JSRX_2Vj5hde4qDFIImT-t2UAGNQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OMOjVu7xpxhLBBbE5A7erHlZJ0O1THyZJ8iBHCPBvJg&oe=69DF7477"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xX6ZIw8q-BUQ7kNvwHaiD3X&_nc_oc=Adq9SfCE__yr22ABGILAqmiqfprd9JX1403J36SeOgLc_6vfDODDiO2zaxNxn33psmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oHjDPa_-JUvr9GR_ZFg3r7dByNjQCI0PNm4rAtIfQeA&oe=69DF6F29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoiJAkdXlwwQ7kNvwH9J53l&_nc_oc=AdoSTjvGxr8zO1JDoXxI6ramDZVe3CGp0PNYIE58lOta1A2vkXx05Y1VX0VJcA14S0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CVkOaU3spwf3jRYuf556kwrdM8Hg0UsHCq1rsrO_H8g&oe=69DFA5F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
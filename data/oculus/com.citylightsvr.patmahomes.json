/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gl4Vkh8jl8Q7kNvwHjCGIl&_nc_oc=AdpYn2wDCpbH7TFhrCKMTAZFGnHIDHMnzopNwD6C9mAfzwBdAP0R11tt2DeG7pqNTuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zX-hAjwVUxNQA0kbCXiLWNTltm8UiXiG_gkanjhQHnw&oe=6A2E9C32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEGV3mfqtJ4Q7kNvwH99Yw2&_nc_oc=AdoFqx_sU6H3ePSKfl0p7dqSXjZwc44L-lmKRpZxuFnPF3bZHoJKGa2x-PUqHGtbTzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7f40dofoElrKDoQr3CPU3EmYty5d4ubC1I_Pk5j2OCA&oe=6A2EADD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7Ynr0II8f0Q7kNvwG5fXPi&_nc_oc=AdqGnFo1N7QMF22hVKKPqF7eDhfraI_mM4kGgsQ2mac05PsKVDrl3MdKBeZMv-Qi948&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bHvNdiDuztfElwHIFR8dCIYldSIkfRl14jvihmVOqpA&oe=6A2EC6B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZB450UsJI4Q7kNvwFa-Z9x&_nc_oc=Adpyx9U1q_62xX6blZgey0bOrVrqR1XJqUU51qV97z62nhb7ub-AR5irRTbwlG6dWVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1uOzmSp5-xiC9bMgkSSPPPhMSS9mfS3qsFT-hW9lRbw&oe=6A2EC169"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqrafvbkFvYQ7kNvwGx3J71&_nc_oc=AdqJTXEnrJIKfalYn1QuYQQ85cG-daG2doZO4YEmeU_FbwtfUStkkSC94WY05Xpkdz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S7jpJB4wD-7KETkkOzTMZ6U6JZ7n9Yt0TE3L4dZdpMQ&oe=6A2EBFF9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkuBgEefaPIQ7kNvwEP6pY-&_nc_oc=AdpJMmx_fG40Usm4JZHE-mKEuEYZD7IKpQX71R505EQC2KMt319poyv-D6cfi-e9NI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1I3pqsjAd2Pr7KgnVmqu2d5mGInwD2XtPgtocSYaj6Q&oe=6ABD3672"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22bn5M6pwmYQ7kNvwHCrzN2&_nc_oc=AdphhztLREj-J2yeJ4gwj8GaciJ8FSlSCC6uEVTdklzQHODrWQL8Tvc3MQT0KPo0Pa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoeT5s_SpnSWb_UZMSNyeUVAC49n80g81SOVJEUOfzaQ&oe=6ABD0FD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAbUZ_kagvEQ7kNvwFwOkUT&_nc_oc=AdrzCWZv3qImP1ppKb1UinfSSSLNuFh5NbNvzYTLegGenLFKggigEI5bUAplH_4kEyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv6GWt9pV5tyimwxik9jOgERb-eVEmvEbnBUUA9a2xVg&oe=6ABD28B7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cdYeBYgxSYQ7kNvwE85BX3&_nc_oc=AdpiNRwQ9lz7_UOF5zzBIb09aIetNa30L-TNWiGcmEvfO49A_00oK_w9KYDKcowVN5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRHxzahPkJrICWwRh76yJ8eSzqkqlOIn5ngFIKtBoM5Q&oe=6ABD2369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yp2mbawPD6kQ7kNvwEMF4-g&_nc_oc=AdpPGvFwPdpUvGJCV_hKarjKJYZrzgcCG3IsVksQXJVgNc8UuouUhOJPQJdErfaI8BU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_7SZNdB74d8NUCKNYL4zidaPFxcR9_oZ4IDhkuVm-cA&oe=6ABD21F9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIlmMWhaHBEQ7kNvwF4Lb1L&_nc_oc=AdoGVqkrvzp9hs7sZmL6o6dVZcpdM4x0CekxlLxVl_6us254Skvcjlk9oZQmcI-jjSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIwzoQxGnD_6hkJKqdzFrFNv4A3u_AE5ARSfpEvXiKUQ&oe=6ABBE4F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22bn5M6pwmYQ7kNvwHB30jz&_nc_oc=AdoUG0oXOeCga2RSJZC35dSmobnH70WcJzj948RLD4BOpNMKn8Z83Wp084bOTmx20QU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdP68aP3NCJarTA5T4C7t2wC_fda_nECX50wvIB_wl4Q&oe=6ABBBE55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L62hwulhbIUQ7kNvwFSq01n&_nc_oc=AdrA76C1Y-_ZEuYwR-NRrg2L3YxjG-VKqdAokzog1WzjFutQM-6fvT-eTckJlwKblVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV8yygTmDVKdaUmuLGUFhMP42szMFnVQnTxUsB-KS6YA&oe=6ABBD737"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cdYeBYgxSYQ7kNvwED-BzG&_nc_oc=Adrbu0wCW9SC-_fr07GGLjH_XFcZ-B6X60ITsbD40u-2nsW5TFUy_LPwskGeDqHxho4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY_-9-_jCJ3shuemx1vnNj8kJuXd-5dcphd8YBfvn5Dw&oe=6ABBD1E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yp2mbawPD6kQ7kNvwFQP3hf&_nc_oc=Ado7TTs3wfaU2HWskoeufqQ182Kt8ja7rgSdmHj-s38akkG_Pha0_3xk2MU77p0R_Gg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzU2DpTQGVx-wg5dUv4Ly8czidXmYf2RASAoQ9tsHWxA&oe=6ABBD079"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
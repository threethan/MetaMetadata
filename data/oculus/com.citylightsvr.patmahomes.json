GTnY7Mn46UpwyVlqs21gk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tLK896YUHbbJiVWE3SEjJJ5TKXLn_RE6is6j2CM2Egw&oe=6A1049B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7pMZR0Hd-4Q7kNvwEQEqV1&_nc_oc=Adqoj831cWEq7gkDQNYobqzKD9FQNwaxmXxorOrzpytNmUBQitPL7caD-p8U4d6ak8M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ADiqAcBg1Nw9Mw_SDpRju4ZMJWjzjSGE88qKei9nasw&oe=6A105B55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kswWWmfUlWsQ7kNvwH4OEHm&_nc_oc=Adp0G1Hl4c4N5rR6CErAVtEgRjCDrXfaVo0_meFGvtMZCMgeu9u_sBkNjp87d4vaGAE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H-0xnORPshttrmOTqzcyMGugX3KE_WNs6kDLGklL8Dg&oe=6A107437"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrf9_JjFVTAQ7kNvwHJ-ZEN&_nc_oc=AdrdzjgDpc3yBlFSGj9jZTzw3Z9P-v_QpZlPfA8Mm0z4lrkAGnDQZB-LXeF7EwCFVxc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W-ivUBGd7UvK1mHmtcOExFd9RhnoB54F_kZGl-k-OSw&oe=6A106EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEyeoTl5qkMQ7kNvwFselPp&_nc_oc=AdptQtbD44j5UfRlWzytEo58UIybrcdbYiVUtEZm3OdcGPTTdHIb4HwhQaE6QTJQL50&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZIEmiyOcHeVdNzLO6kfVmRYGkJmm8vpgERsq2oaWszw&oe=6A106D79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memor
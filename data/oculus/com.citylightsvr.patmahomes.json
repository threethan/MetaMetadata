/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X2E7U-OtFUQ7kNvwGSW3Lj&_nc_oc=AdrmA6vOmtuP9MImDkNJzOHLzfnVxvobWtnqlhqXvkzAUPclKDRyNG3DTCKTffE8rNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8XHsg6gLHtUFqozr3d-hpUZURGkW5dd4Z39dDIGQuOQ&oe=6A5234B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkkF4cCtUuwQ7kNvwFaTfVy&_nc_oc=AdqlMsgaFwlHGB3FDZ-CgbkLagxFdFZWRyM8gxb6YGQ061uhaztE672Sza62SBZmdmo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo-pZLU5lf_l7lmjqLMNtq9dKNoEa1WwE3ALFlymih7g&oe=6A524655"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHVhVCxZVCYQ7kNvwGsK-wC&_nc_oc=AdrVPQC9WIBBII5xO7VMQP_Nc7Mpp3U2jtfmis2V68LWGHIwLIh7O59qsu3KCYMtiyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhAXpHfcr4CHxLxpcLD8JMV-eUK5AWCFv9pVu9adq2ww&oe=6A525F37"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUQ-cMl62lYQ7kNvwFI_b1X&_nc_oc=AdoHabtqTd9Yr4s1tPNvQUofkxKVztQFf4Ro6-TL2Nhk58BsH9SGKFqndI0ObB25LSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJY787d3jlv5cmmDxOsoJXYF7Bh20eNkCJk03qe_GksA&oe=6A5259E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hoCYHYFLM0Q7kNvwH8wSWc&_nc_oc=AdrQ1eMQcIv3QzwlFuy_mVaiIS35fod_Yv7d4ygm2nCUYmfIVXPJ0cuQkDMHR0sRbH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJR1or2wVWbHHo5bxpLv1WEXUtkT0XoCQtLUf--DShcg&oe=6A525879"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
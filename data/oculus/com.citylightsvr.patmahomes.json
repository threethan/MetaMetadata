/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5l-1mGIG-UQ7kNvwFpI6Oq&_nc_oc=Adpd6N5Jn_yA4dMwZcJtD7aADXn2KZ1-4aaQnlSCFE-aQw02z9_05fsk7HkC8tpsJHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh88mE-DrWBcBaUTMdeKr42XGyV4Yee4gIP_BynqMMyA&oe=6AC670F2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzBYZctGGPkQ7kNvwEuD3_D&_nc_oc=Adrgf3Cg7WHTZPVEhepUG6iyQAQffvTygxXGmCLgRdj_0NBcpcXU1c3xDSPDgjSGhZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLF_2Z7gdkH0-u2ElfiNTPRtrBKv9UyQBkqfOLmld4cA&oe=6AC64A55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvFiDaC21nMQ7kNvwGB98rR&_nc_oc=AdptY3VxXPiTPurAMrcsis3lqjzce49fTsr4jYQi6hNAF0TvOBQtrfUCgKgoOxJ1jXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSxWPaAOy5FoM2WVV13778UMTSnoieh12LsY1CqzxwOg&oe=6AC66337"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwJAZeyj_G8Q7kNvwGjE8f_&_nc_oc=AdqfPQIXJkU0Th9RSFVNbUQSqA_Oxma77VuOpWOITh5rvR0X9nCaLmEDtmk_V8GOKMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLkdM8Sq2oQPVbAXseJ2jYiByZgmOufVqlBxv81UI_Zg&oe=6AC65DE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY1CPs5AXk0Q7kNvwEbbeQz&_nc_oc=AdqKYWFQho6aZG_GkKJLJHnCcqRMwwlwMy94oabhHfPe9w7-ZJTUyEwNkzBB2fKHnWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxqplG419AsoF2MN5xB1IqODfUkARBg5Z8UOxjrDlT2A&oe=6AC65C79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjT_uKg-4G4Q7kNvwHUeGIq&_nc_oc=AdoDD6Ak5Pg5tNoe_FnQVIK3FFQ62QyiU5vr8TUtjelNZTRPGg4t_iIP3Ma58zvw4fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8NG6jZzE9h9Tcn2AB9PJm9Q4LFj0XCnl1BcAbl2HiJg&oe=6A64A9B2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8UewCg2oxAQ7kNvwEcB_Bd&_nc_oc=Adrzp0gDlQTym2kjU6kRj9b0KXH8EC22H3ARItrI2eLhtnEeefKDRztCc7XZi-fhd9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9EP1RuPI7pxLY-zdTEkJFGm9KAddLklcVkTctkx9nLA&oe=6A64BB55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVDbq01TUAYQ7kNvwFkKHak&_nc_oc=AdqQvPNdkU9nrNAMoHimj7Hu7TY2APo8hUTuola8BFijnZjcxAPNITpuF2600zyna9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ261XTjJv5YKNk3q_s3_kEfnrOu3Ia3kwn87De7h6oQ&oe=6A64D437"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0ZBW2pJBykQ7kNvwHP0poZ&_nc_oc=Adp9lZqV8iISXbOKPPWx2v9zZtUuDUMpoCuUaAAtiqanXpIq4J1_l5n-fyXPGMZLGcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcRoMAIdWIfQgY1wf96uDC7klPHpy9rWluZgmuqRrTTQ&oe=6A64CEE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSxe-rIfOnEQ7kNvwET7qzK&_nc_oc=AdpMpxqu5LrkcWP3IFxJTGqyt-1QWXkxltCvoPxmiK1s2t7eULuqb96ckxsE2zVJ9sc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKgwLBhPUueT81YnA2x6NY7uCvm9NlAg4fX_sd_SbOWQ&oe=6A64CD79"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
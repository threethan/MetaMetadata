0595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-P9xOG3n0gQ7kNvwE6GTHR&_nc_oc=AdmwVXun91EV4i1jWObFFYC7a1vGGwNw-cf69WXlJfsgCaF3q6fVUiVGuU109XZkcSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afygy7lkzVuTCx5Sdv314-vAC7sBrVRwekAKUC2c5ucfLw&oe=69AEBAB2"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdZLBfKcI4sQ7kNvwF2w9wu&_nc_oc=Admi624qhBcCkjUX4fWIZBXanHPElVGYyn5eXdlMGOlJ2OmZRZT8VNAPmfu4DrJKDbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCzFOdcjQHL0EuBlV-95zdTRAimUvUYKwPpSjaLryrdw&oe=69AECC55"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krq7h99xDCIQ7kNvwEeSlhU&_nc_oc=AdlHR3g9mc46oDWY4-qwgx1pb3ApJ90-DvdcocZyEXD6E62eLzO31Ff45HGFONrDxYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGULToCqYUZKqBQWhEGaUPh1o4mfMy1q18Z0BEmMrEdA&oe=69AEACF7"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lQXTYsKn54Q7kNvwGpUSv1&_nc_oc=Adnp26N5bee4rYgbuZsvG_GeG8Ebgb6Z4c2de3Qy4dKPD9briFFb4a7WxUroXZriTgM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWCaA1mY_G4nLYcskLzfexyMC8R3TdW2dKZT6bN-ZsIw&oe=69AEA7A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx6i-DWvG9AQ7kNvwEKJ95x&_nc_oc=Adk_ArKQ1l0ZuvlAVg3rJK30vxZvV1a_WWGTCE1UXJi3UyLLnCDliiic6XvFCti625g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxmx8vbTbU9HBPyjUXFqDlDBxiAFoHHBfLeLROO3BIe1A&oe=69AEA639"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "h
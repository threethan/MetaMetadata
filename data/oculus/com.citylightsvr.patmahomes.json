/v/t64.5771-25/38974624_637125620595435_7716790434683891070_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiGy9o7hX5oQ7kNvwH2A5K9&_nc_oc=AdrKDamHnhNWhPbGN1yaJzl8Fi_uxDy0FhK5FGhcroa_287sMmDdd2beSx9zeAzGrsg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4wZtMcGWsKBjiPzoxc7yTMSLPcObXkHj2PpbxDzDyoQ&oe=6A902B32"}, {"file_name": "lineupassroutesscreenshot2.png", "id": "383518610033972", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982565_383518613367305_6719964304488347594_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4wDC_iROxUQ7kNvwHvMwYg&_nc_oc=Adq60g6sPB6AiJ98LStoGiFLYwszscyL5_dmPYwwiqISj9uoqz6514gVllAeFUg5rGs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFd29Z3-BrLhwuRcqwGFYPvxfJXWU-PhN15AhMSe9AlQ&oe=6A903CD5"}, {"file_name": "mvptimeopenpassscreenshot.png", "id": "4187114938024085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982645_4187114944690751_3550953097076041571_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5Fsc8OHDawQ7kNvwG9e9yx&_nc_oc=AdqKGoJ69m8J_uTrGs1W2ymxSpp96INTHN_SS-R-q4ESzbIsdw29D3cvZ2quQn1_coU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPDknibXll24Grn6z_asqgUzuWjNQ5OMf8Ex9QDybUHA&oe=6A901D77"}, {"file_name": "fireballscreenshot.png", "id": "567290251284871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982472_567290254618204_8879500614926437157_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7qx5UJEK6IQ7kNvwHT5JRq&_nc_oc=Ado8IE1g_9Zfp1czoHxKcSfrCO4wkn8WPiiwZp8-bkxt5eOXmDJNrfclUtlmffvNQGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfoK0R39K7aW28qUWhFbFzvkPu1ubdRi-UO18OpYIarA&oe=6A901829"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "257375876317440", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195905_257375882984106_2155322319831348121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlzKnJAaZOIQ7kNvwFqyx_D&_nc_oc=AdoIfP5CeDNmeZyJ9wTbIs6Z23hKoZEN-1prAevBrgDQUD7mmQNL3BNYNG4hMOjKmt8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGINmHoIfeqXB1iSfW-OmCWrS5eoYMueSl5ZzlldFDyQ&oe=6A9016B9"}, "display_name": "MVP Football - The Patrick Mahomes Experience", "keywords": [], "long_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play high school, college and pro football games. Call the plays, throw super charged passes, and stiff arm oncoming defenders in slow motion in this high adrenaline VR football game.\n\nFeatures:\n\u2022 Realistic motion controls for throwing the ball to wide receivers, shovel passing to your running back, stiff arming oncoming defenders, calling time-outs and more.\n\u2022 The intense, arcade style action will have you throwing combustible footballs, electrifying your receivers, and dodging in slow motion.\n\u2022 Choose from practice, high school, college, and pro modes.\n\u2022 Review the playbook, craft custom plays, and call the audibles between plays.\n\u2022 Global leaderboards so you can compete with your friends.\n\u2022 Play however best suits you, whether you are standing or sitting.\n", "short_description": "Play as superstar quarterback Patrick Mahomes, and feel like a true MVP, as you play through his career from high school to pro football. Call the plays, throw super charged passes, and escape oncoming defenders in slow-motion in this high adrenaline VR football game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freerangegames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CityLights", "support_website_url": null, "website_url": "https://www.citylightsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscrip
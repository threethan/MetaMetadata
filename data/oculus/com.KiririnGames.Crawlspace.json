uscdn.com&_nc_ss=7f20f&oh=00_AQHeWX8L5XYKhrTJdrseZHEQ4LVoSTILGqoHGkufusSlKQ&oe=6A8EDE2A"}, {"file_name": "ss2.png", "id": "577290526677605", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982512_577290530010938_3656297561629722247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNCEkVsZXrwQ7kNvwEReOKF&_nc_oc=AdpBh4lBZm8nVJ0w6yuAqTmXVzdXeS7SgCemsjcPuPzPsEW1L-gL1igP9_82l1Rdt_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAuJjkiQ2mnllb29SFXVEWFYmYDffkY8V1ifKGlWqOfw&oe=6A8ED289"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "614508186361181", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974469_614508189694514_1518508321980443706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ge_Lmx2SFkQ7kNvwG77-H4&_nc_oc=AdrBRkd1bzUjYxvuwdULzWuoS1rDssr4qGfum4TAMPP0Dl9-ScLS8ui5hqu0uDd3WZQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlXT7KPK8EHMcHUfLN_0VTHlzkfONga2gjTILyo20TvA&oe=6A8ECFB4"}, "display_name": "Crawlspace", "keywords": [], "long_description": "You saw an Ad about someone needing help with an odd job, retrieving his daughters missing dolls. Sounding like easy cash, you leave a message telling him you are interested. but as the nights progress, you realize why nobody else wanted to take this job.\n\n----\n\nMain Objective - Collect and return each missing doll from the crawlspace over 5 nights using a unique VR crawling mechanic.\nFigure out how to stay safe from each doll with different attacks.\nRelax at your home and enjoy some TV.\n\n\nThis game includes jumpscares.", "short_description": "You've been tasked with crawling into a crawlspace to retrieve some dolls. what could go wrong? Made exclusively for VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kiririncontact.wixsite.com/kiririn", "developer_terms_of_service_url": null, "publisher_name": "Kiririn", "support_website_url": null, "website_url": "https://www.youtube.com/chann
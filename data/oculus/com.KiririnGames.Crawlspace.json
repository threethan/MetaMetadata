290526677605", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_577290530010938_3656297561629722247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut8Ihi-NadYQ7kNvwHYJqcb&_nc_oc=Adkc8euILKVyji1uczPnhlDA7aEoDZIvX-M26Jo3V0wj2QbH0QytaoOIy68zvAmpMOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTjcGA-FFc_GK1rv2iO8QhSCPPsS9-dxvbXViZFJvACQ&oe=69B7EE09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "614508186361181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_614508189694514_1518508321980443706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d9d_rgsSbsQ7kNvwGyTpik&_nc_oc=Adlw_-6XdMiFHnNsHgN044CEjy0H_DH_a4ymb9m7trcsJ68DMRmnZ4c6YHiZ4BR5MTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwlxJoS-KTJeGArVINHFb5JaDwOk732CHXww8dDldMJcw&oe=69B7EB34"}, "display_name": "Crawlspace", "keywords": [], "long_description": "You saw an Ad about someone needing help with an odd job, retrieving his daughters missing dolls. Sounding like easy cash, you leave a message telling him you are interested. but as the nights progress, you realize why nobody else wanted to take this job.\n\n----\n\nMain Objective - Collect and return each missing doll from the crawlspace over 5 nights using a unique VR crawling mechanic.\nFigure out how to stay safe from each doll with different attacks.\nRelax at your home and enjoy some TV.\n\n\nThis game includes jumpscares.", "short_description": "You've been tasked with crawling into a crawlspace to retrieve some dolls. what could go wrong? Made exclusively for VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kiririncontact.wixsite.com/kiririn", "developer_terms_of_service_url": null, "publisher_name": "Kiririn", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCy8-N75jPeYWWiAZKwqP-3w", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274332
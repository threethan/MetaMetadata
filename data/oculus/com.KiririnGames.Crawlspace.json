yhGmEtGBTBWIZeK9YGA9KhkObyW7at5xZFBe3HXA9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuq4bVjAkZiex9I-GFeO76YwoYCnUfPx9kxGyc2c2Wt6Q&oe=699AED09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "614508186361181", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_614508189694514_1518508321980443706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMxCRhK6kJcQ7kNvwEbwPGG&_nc_oc=AdlVhwP5FZYdzBbnMm5OH5Jyb8SBgZwRhXYM9JGVzHSaqXHOrCM8m9F2mMFRo8UbW5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu5uT7Rdo_HehFr3wLFTtwYsY-eS5MoBoRi7tRmCOAjaQ&oe=699AEA34"}, "display_name": "Crawlspace", "keywords": [], "long_description": "You saw an Ad about someone needing help with an odd job, retrieving his daughters missing dolls. Sounding like easy cash, you leave a message telling him you are interested. but as the nights progress, you realize why nobody else wanted to take this job.\n\n----\n\nMain Objective - Collect and return each missing doll from the crawlspace over 5 nights using a unique VR crawling mechanic.\nFigure out how to stay safe from each doll with different attacks.\nRelax at your home and enjoy some TV.\n\n\nThis game includes jumpscares.", "short_description": "You've been tasked with crawling into a crawlspace to retrieve some dolls. what could go wrong? Made exclusively for VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kiririncontact.wixsite.com/kiririn", "developer_terms_of_service_url": null, "publisher_name": "Kiririn", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCy8-N75jPeYWWiAZKwqP-3w", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
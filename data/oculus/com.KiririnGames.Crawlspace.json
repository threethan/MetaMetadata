290526677605", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_577290530010938_3656297561629722247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4La5tii_rYQ7kNvwFxPVG0&_nc_oc=AdqTHr_pC7E6BE1ezrDlRiOSOPhrDKfxEpCquscPfyPZGWmi9Wytyow93lSiDpn5iIQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx25MfaF8kLyxjYasniQsHJ6vUIxTw6mx1YopcxjMICMg&oe=69C12889"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "614508186361181", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974469_614508189694514_1518508321980443706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xXc5rrjhj4Q7kNvwHRuMGL&_nc_oc=AdqPge02exvVZBLv7cIKRejGKnIYiM_0WNb54ao-2UcWQIILQ68hSA8hb9civBbcQH8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxj42IHVoJ-DxCoDAxlSEB-kbC-1Ebd_qi4addCb2vb3w&oe=69C125B4"}, "display_name": "Crawlspace", "keywords": [], "long_description": "You saw an Ad about someone needing help with an odd job, retrieving his daughters missing dolls. Sounding like easy cash, you leave a message telling him you are interested. but as the nights progress, you realize why nobody else wanted to take this job.\n\n----\n\nMain Objective - Collect and return each missing doll from the crawlspace over 5 nights using a unique VR crawling mechanic.\nFigure out how to stay safe from each doll with different attacks.\nRelax at your home and enjoy some TV.\n\n\nThis game includes jumpscares.", "short_description": "You've been tasked with crawling into a crawlspace to retrieve some dolls. what could go wrong? Made exclusively for VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kiririncontact.wixsite.com/kiririn", "developer_terms_of_service_url": null, "publisher_name": "Kiririn", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCy8-N75jPeYWWiAZKwqP-3w", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "274332
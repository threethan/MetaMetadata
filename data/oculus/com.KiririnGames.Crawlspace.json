uscdn.com&_nc_ss=7f20f&oh=00_AQFNOrt5iJJ_lHzMinOOMycF_zAglkAUQv03czqelvEcUA&oe=6A85A3AA"}, {"file_name": "ss2.png", "id": "577290526677605", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982512_577290530010938_3656297561629722247_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2SK3kyU0HMQ7kNvwGm_cMD&_nc_oc=AdoY0iEEzWcgm4nEL-iqH54_kcPxHdrpwkn9M_BAWGdLvI-Hrk-9oeZgssEetEdYmZ8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhlj5OeSZAkPIxrxbRgoqSh6wLpF0A6mYGfsQQOMlfvw&oe=6A859809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "614508186361181", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974469_614508189694514_1518508321980443706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcRAiqFFr8oQ7kNvwGbv542&_nc_oc=Adq1m7jVmL-JjpuEDdNEzIVVKa-4_R_2ce2wS0vJjgvhxSf1mHoyArG-rXelKcaS9BQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9Ye0Dn5k32k-bbtFuLMQafltIABu07c-94fnhV9y7Ew&oe=6A859534"}, "display_name": "Crawlspace", "keywords": [], "long_description": "You saw an Ad about someone needing help with an odd job, retrieving his daughters missing dolls. Sounding like easy cash, you leave a message telling him you are interested. but as the nights progress, you realize why nobody else wanted to take this job.\n\n----\n\nMain Objective - Collect and return each missing doll from the crawlspace over 5 nights using a unique VR crawling mechanic.\nFigure out how to stay safe from each doll with different attacks.\nRelax at your home and enjoy some TV.\n\n\nThis game includes jumpscares.", "short_description": "You've been tasked with crawling into a crawlspace to retrieve some dolls. what could go wrong? Made exclusively for VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kiririncontact.wixsite.com/kiririn", "developer_terms_of_service_url": null, "publisher_name": "Kiririn", "support_website_url": null, "website_url": "https://www.youtube.com/chann
bg&oe=6A36A273"}, {"file_name": "49.png", "id": "2257953384651368", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499627036_2257953387984701_6381549793591702907_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSoCUNHiAz0Q7kNvwGxsb5O&_nc_oc=AdpVhmd8Fx61oHBMxLDhhj8Lsq2KzbdAvof0jdZjDmvy_m0AxRxsZTBZhHBf6XspHA8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-abQ4waDCgqblz4DraJyXXPEZmmyJ3choffQVlRWIR7g&oe=6A36A996"}, {"file_name": "48.png", "id": "1450879696145308", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499297283_1450879699478641_4350711935655119657_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sbf2-wfiR0cQ7kNvwHiMusd&_nc_oc=AdrXj0XuYEeymxZRZSLtSSdpAy91WRq_BMohrqJ0QnLxHsSdkWu___5a0DuqlmQQ36g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vf7yEdehsEuoQHJ9aZXUFg6AhRa7dcjtgf_vpJcrZdA&oe=6A36A3AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La Pandora's Box", "keywords": ["360", "music"], "long_description": "Pandora\u2019s Box is a blended world of reality and imagination, where world class artists give next level performances as an entire 360\u00b0 story evolves around the score of music. A 40 minute, fully immersive concert experience, that transports the audience through wildly imaginative worlds and music\u2026 unveiling a neo-classical journey where every note and visual tells a story of creation, chaos, and redemption. Crafted with cutting-edge 360\u00b0 visuals and a stunning original score, Pandora\u2019s Box invites audiences to step into a realm where sound and vision merge, challenging the boundaries of reality and art.\n\nWe have established the very first film in 12K raw true 360\u00b0 VR / AR with the first real live action musicians and performers composited into the imaginative evolving story. Reaching this stage is a remarkable achievement and a historic one, as we push the boundaries of what\u2019s possible in immersive media. We\u2019re thrilled to be at the forefront of this innovation. ", "short_description": "Pandora\u2019s Box is a blended world of reality and imagination, where world class artists give next level performances as an entire 360\u00b0 story evolves around the score of music. A 40 minute, fully immersive concert experience, that transports the audience through wildly imaginative worlds and music\u2026 unveiling a neo-classical journey where every note and visual tells a story of creation, chaos, and redemption. Crafted with cutting-edge 360\u00b0 visuals and a stunning original score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1bwai_OWJxTtwAuz-D1J58cmN369TxekHnsa85db81-U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "La Pandora Distribution, LLC", "support_website_url": null, "website_url": "https://www.cervomediagroupinc.com/pandoras-box", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24541584255468780"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1880064442709984"}]}, "baseline_offer": {"id": "1880064442709984"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779987600, "status": "PUBLISHED", "id": "1880064442709984"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "268266
c_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRExK51DPsTxQifBqpcqVkRnjstGOgEVYxhCPxuSl1idQ&oe=6B0863AE"}, {"file_name": "51.png", "id": "1434597474294413", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296520_1434597477627746_4972208949140313665_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5DGyygad24Q7kNvwGXDII2&_nc_oc=AdpQFdSvDW2rA2Z2_4D9968LxJkNe51ZJBz_1-qNqIoeROwCUdM7tJK8suPu_3rLvO8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxjhXjtswlnUYiN5c5GKuBwPr8y2DKdDr13MAuxxxahg&oe=6B0840F3"}, {"file_name": "49.png", "id": "2257953384651368", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499627036_2257953387984701_6381549793591702907_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPhxH3AOxgAQ7kNvwE4vxNU&_nc_oc=AdpySopA2kL6C9TzFGAwZse1bfHF0ADR9udscdFjNL4xwVzAB1CDNRdZQqnO4XODQUw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1NM1s9frDBYeDJ58LlcP4yR56eQI5H0c8vkEGNw0NGg&oe=6B084816"}, {"file_name": "48.png", "id": "1450879696145308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499297283_1450879699478641_4350711935655119657_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IEOeE21VowQ7kNvwFE-Jri&_nc_oc=AdpAjgxrvbe8YKT7Gpb-ihNsju0gPAtWxYoPeJr1UeEUNK1lrL1vP_qinWM86V688mo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhuamMixOt3AuKyuHCUruwos6HLO7OYVCKche94sj9hw&oe=6B08422C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La Pandora's Box", "keywords": ["360", "music"], "long_description": "Pandora\u2019s Box is a blended world of reality and imagination, where world class artists give next level performances as an entire 360\u00b0 story evolves around the score of music. A 40 minute, fully immersive concert experience, that transports the audience through wildly imaginative worlds and music\u2026 unveiling a neo-classical journey where every note and visual tells a story of creation, chaos, and redemption. Crafted with cutting-edge 360\u00b0 visuals and a stunning original score, Pandora\u2019s Box invites audiences to step into a realm where sound and vision merge, challenging the boundaries of reality and art.\n\nWe have established the very first film in 12K raw true 360\u00b0 VR / AR with the first real live action musicians and performers composited into the imaginative evolving story. Reaching this stage is a remarkable achievement and a historic one, as we push the boundaries of what\u2019s possible in immersive media. We\u2019re thrilled to be at the forefront of this innovation. ", "short_description": "Pandora\u2019s Box is a blended world of reality and imagination, where world class artists give next level performances as an entire 360\u00b0 story evolves around the score of music. A 40 minute, fully immersive concert experience, that transports the audience through wildly imaginative worlds and music\u2026 unveiling a neo-classical journey where every note and visual tells a story of creation, chaos, and redemption. Crafted with cutting-edge 360\u00b0 visuals and a stunning original score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1bwai_OWJxTtwAuz-D1J58cmN369TxekHnsa85db81-U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "La Pandora Distribution, LLC", "support_website_url": null, "website_url": "https://www.cervomediagroupinc.com/pandoras-box", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
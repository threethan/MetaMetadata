HMKR_oP8cg5IVYedfdHd1xw1F_vmHVHw&oe=6AA95B60"}, {"file_name": "51.png", "id": "1434597474294413", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499296520_1434597477627746_4972208949140313665_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4gjvkwlEL0Q7kNvwGXaCZq&_nc_oc=Adq-wBdviR18QsMnEQ2gRL_780fwe1tbFtfcI60PLrqEvuMcTCUY5W9ZuGdc7uUO_mY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMhmThWURLCDPnkWsKKjs7rQrlMBSr1dyi-ui-X_GkFw&oe=6AA954F3"}, {"file_name": "47.png", "id": "1186711626627747", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499293121_1186711636627746_4136351363254792332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGMnnqihea0Q7kNvwE6uzu6&_nc_oc=AdrFJ_SjvmyrTUIUoizeAU5LgZUOJRbiaETXxOW_eDh-EYsi-Wya0Ot8Q6WNqFLhHlo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfqkyVg3HS1wYqFdkOj4wup-TNWlgf1OBOY9THZ-ZQQg&oe=6AA94040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pandoras box-store assets_CA_Landscape_META_2560x1440.png", "id": "1521314532649921", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619518_1521314535983254_1152382314634787329_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGzWz-ElNusQ7kNvwHlFdLP&_nc_oc=AdqR7U8Zh9pJJJi--1yWLmgMD3Ev_xX1M5o8bxgwjzfRwB5rmyRcy-v0dR9izk4ZGQc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXsVnvu-Dkb-eO5Xv7pmGMmZ8yVTOyM9h1Za9RJNI5OA&oe=6AA934D7"}, "display_name": "La Pandora's Box", "keywords": ["360", "music", "concert", "media", "surreal"], "long_description": "La Pandora\u2019s Box surrounds you with music, myth, and live performance in a 43-minute immersive motion-picture concert filmed in 12K RAW, true 360\u00b0 VR.\n\nJourney through a mythic world of creation, temptation, chaos, and redemption, where music becomes environment, performance becomes story, and every visual transition unfolds around you in 360 degrees. \n{1429543775528553}\nGuided by an original cinematic score, La Pandora\u2019s Box places you at the center of a surreal odyssey through cosmic dreamscapes, fractured corridors, crimson sanctuaries, submerged cities, and luminous realms of rebirth.\n\n{27470019562607035}\nCreated by multi-award-winning director, composer, producer, and engineer Nadeem Majdalany, La Pandora\u2019s Box fuses cinematic storytelling, spatial sound design, live musical performance, and surreal world-building into a singular VR experience. Real musicians, dancers, and performers are composited into immersive virtual environments, while narration by Bronson Pinchot and Courtney Friel and immersive audio mixed by 7x Grammy-winning mix engineer Brian Vibberts help shape a concert film that surrounds the viewer rather than unfolding on a distant screen. \n\n{2175049939976750}\nFrom the opening Birth of the Universe sequence to the moment Pandora\u2019s Box fractures the world around you, **La Pandora\u2019s Box** is a cinematic passage through sound, memory, temptation, destruction, and hope. It is a VR experience for music lovers, film audiences, art seekers, and anyone drawn to new forms of immersive storytelling.\n\n\n\n\n\n{970142339330629}\n", "short_description": "Drift through cosmic birth, fractured dreamscapes, and radiant rebirth in a 43-minute immersive motion-picture concert filmed in 12K RAW, true 360\u00b0 VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1bwai_OWJxTtwAuz-D1J58cmN369TxekHnsa85db81-U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "La Pandora Distribution, LLC", "support_website_url": null, "website_url": "https://www.cervomediagroupinc.com/pandoras-box", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
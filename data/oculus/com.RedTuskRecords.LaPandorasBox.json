rlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bdfvrvLl74Q7kNvwEnY9w8&_nc_oc=AdqTqbBswuyqR-2zKBPDBq98d7QMkre2-b9EOEOuOduGBhvBRraaqdVv_iB54qu3ziI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHKDegHPMfpcnKDQRDnRIQGCihylfT7lSYQRXoKXOcEg&oe=6B084760"}, {"file_name": "51.png", "id": "1434597474294413", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296520_1434597477627746_4972208949140313665_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5DGyygad24Q7kNvwGXDII2&_nc_oc=AdpQFdSvDW2rA2Z2_4D9968LxJkNe51ZJBz_1-qNqIoeROwCUdM7tJK8suPu_3rLvO8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxjhXjtswlnUYiN5c5GKuBwPr8y2DKdDr13MAuxxxahg&oe=6B0840F3"}, {"file_name": "47.png", "id": "1186711626627747", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499293121_1186711636627746_4136351363254792332_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICJRKCMypNEQ7kNvwGNyir5&_nc_oc=AdoSqI_sJHQ6BVjmJ8JEuvA6gdMTxLHfDH-R6IuZ6t96JvDQSPDKOFFbxWdWiy6TKg8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl69VHoo5Owl47rnxrvqBWSIi1pRLf8fBXi-ecuHACbw&oe=6B086480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pandoras box-store assets_CA_Landscape_META_2560x1440.png", "id": "1521314532649921", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619518_1521314535983254_1152382314634787329_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvrDoc_-B3gQ7kNvwEVzj4I&_nc_oc=Adq4u69eaVO-F6MCUKD7fXhRWbF8YTQ9dLtq1pT81OEwuEB5Z28VlPKEbI8whXMI7o0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7-8w8kSLNhCHzb8EPbv8hl-ohHBRy24N07TZKvX0ZUA&oe=6B085917"}, "display_name": "La Pandora's Box", "keywords": ["360", "music", "concert", "media", "surreal"], "long_description": "La Pandora\u2019s Box surrounds you with music, myth, and live performance in a 43-minute immersive motion-picture concert filmed in 12K RAW, true 360\u00b0 VR.\n\nJourney through a mythic world of creation, temptation, chaos, and redemption, where music becomes environment, performance becomes story, and every visual transition unfolds around you in 360 degrees. \n{1429543775528553}\nGuided by an original cinematic score, La Pandora\u2019s Box places you at the center of a surreal odyssey through cosmic dreamscapes, fractured corridors, crimson sanctuaries, submerged cities, and luminous realms of rebirth.\n\n{27470019562607035}\nCreated by multi-award-winning director, composer, producer, and engineer Nadeem Majdalany, La Pandora\u2019s Box fuses cinematic storytelling, spatial sound design, live musical performance, and surreal world-building into a singular VR experience. Real musicians, dancers, and performers are composited into immersive virtual environments, while narration by Bronson Pinchot and Courtney Friel and immersive audio mixed by 7x Grammy-winning mix engineer Brian Vibberts help shape a concert film that surrounds the viewer rather than unfolding on a distant screen. \n\n{2175049939976750}\nFrom the opening Birth of the Universe sequence to the moment Pandora\u2019s Box fractures the world around you, **La Pandora\u2019s Box** is a cinematic passage through sound, memory, temptation, destruction, and hope. It is a VR experience for music lovers, film audiences, art seekers, and anyone drawn to new forms of immersive storytelling.\n\n\n\n\n\n{970142339330629}\n", "short_description": "Drift through cosmic birth, fractured dreamscapes, and radiant rebirth in a 43-minute immersive motion-picture concert filmed in 12K RAW, true 360\u00b0 VR. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1bwai_OWJxTtwAuz-D1J58cmN369TxekHnsa85db81-U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "La Pandora Distribution, LLC", "support_website_url": null, "website_url": "https://www.cervomediagroupinc.com/pandoras-box"
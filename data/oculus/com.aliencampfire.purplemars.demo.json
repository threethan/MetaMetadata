761803800802", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624583_1417761807134135_2954793803208514322_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c5riUeOd7MQ7kNvwFROGpc&_nc_oc=AdqDF2PVdvqaDPy1mkVLa0WCZp2KTqZG0X-MzHdYHaGeppFsxB7U_J2V6_HCyDQ4zRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2lxLiXlsuRnwWxgW3BEPu3N3MfrT7xlh5iSgNFY8lAg&oe=6AF3276C"}, {"file_name": "4.png", "id": "1893320078309704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622202_1893320084976370_3291719562959093507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1JTIx7B1zEQ7kNvwFwID7d&_nc_oc=AdpsO3TRBQl6-OMo546o3A3N7nwbGnwqWK38oxZKydjTPwJCRO988UlCfg-oShYaZZQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHf47lsYqr1-09a-IJRtZJkyvrwJcCEqCCxi7sse7rfw&oe=6AF34953"}, {"file_name": "5.png", "id": "2067491287465139", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593767690_2067491294131805_1605614991949646003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfz6k8QI1L8Q7kNvwFAdyjJ&_nc_oc=AdptXrOO6pPbf1CMYvYstioW4fX37cGkOf0DzWGvvECMcpwBS0JHSVr3PaJjWGb2ts0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWwftQ649C3wrQ9zeVQO9l7W-m2lVE1EAHph9mS-bmOA&oe=6AF33936"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape_2560x1440.png", "id": "1119487634362626", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627477_1119487637695959_8974769173452468099_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42W5eZR8r5MQ7kNvwFjmJk1&_nc_oc=Adrn7u5znI4E-Ch2enOmKFBC3RlBPj57MI0kATlsq0bbX1Pd5C4zi1pcJ53Mx1EU9UE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAbbIFwXsGMguqB7chy59iC0j-dUd126VEv_b8tDEudw&oe=6AF3571B"}, "display_name": "Purple Mars - Free Demo", "keywords": ["shooter", "flying", "shmup", "dogfight", "robots"], "long_description": "**Your first four waves are free.**\n\nThis demo gives you the opening of Purple Mars, in runs of up to 4:44, as often as you like. Finish four waves, then see how fast you can do it again. Your best time waits on the title screen.\n\n**Point. Pull. Fly.**\n\nAim your hand where you want to be and squeeze. Feather the trigger to drift; bury it to tear across the sky. No plane to wrestle, no inertia to fight, no altitude you're stuck at.\n\n**Fly among the swarm.**\n\nCube-built robots pace, evade, chase and taunt all around you: above, below and behind. Climb over them, drop beneath them, or hang still and let the swarm come.\n\n**Aggression is power.**\n\nKills, combos and loot feed your momentum, and your weapon answers in kind: one bolt becomes a spreading circle of seven, faster and wilder the harder you push. Coast, and it drains away.\n\n**Fly the bomb as well.**\n\nOne hand holds you in the air; the other steers a live bomb through the swarm. It waits for your grip. Time it right and the shockwave takes the whole gang at once.\n\n**Break beautiful things.**\n\nEvery enemy is built from cubes and dies like it. One clean hit to the eye and the whole thing bursts apart, every block flung with the speed it was carrying. Then chase the wreckage down too, if you can.\n\n**Sixteen waves. One planet. Your best run.**\n\nThe full game takes you through all sixteen waves, all the way to the win. When four waves aren't enough, it's waiting for you.", "short_description": "Point where you want to go. Pull the trigger. Fly.\n\nThis is the free demo of Purple Mars, an arcade shooter built native for VR. Clear the first four waves, then chase your fastest time. Runs last up to 4:44, and you can play as often as you like. No cockpit, no inertia, no arena walls \u2014 just the open sky of an alien planet and swarms of cube-built robots all around you to burst into tumbling wreckage.\n\nMaster the opening. Then take on all sixteen waves in the full game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencampfire.com/privacy.php", "developer_terms_of_servi
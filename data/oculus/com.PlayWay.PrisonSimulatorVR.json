4.5771-25/491823296_1408346360661087_2531570021873997478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo6L2hc7LicQ7kNvwFnrcwA&_nc_oc=Adqc3qGQTv7BUGHUfJCHNq055hAa2oIM0G6fW2FKsRPq92UY_IvuZsvj1TofqqB_FwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2RckYm55B9C6eAL0z2yH_kURLneIpTHMp5c2hAO-gzg&oe=6A4BC1DA"}, {"file_name": "ss5.png", "id": "1184276483198487", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_1184276486531820_4772447638602653256_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAezCRWlHOkQ7kNvwG3KCvf&_nc_oc=AdqNdtzFIZTNnB1dxx1LQF2xMKt6LyrlQbujy39lADk4hfsUuRcsgdal1lve8hPo2IY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8bSAXJsGWEFJD_q62iSejQm9do_EBzabpo2_Ix259lA&oe=6A4BA281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape oculus.png", "id": "1503196798475651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1503196801808984_474496605246942196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU9_8W3evh8Q7kNvwG7tqbh&_nc_oc=Adqhp0kM8Rd5lSUtqpwaPmmemqWMQAfnJ7wS-daNcj0gL_9TyfSQXC90w5NcOPWQx2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5wKPCCtLwdrEDS14veDtiH1d0jka09EXCKbw8WTzh5g&oe=6A4B9EE9"}, "display_name": "Prison Simulator VR", "keywords": ["prison", "simulator", "boss", "fight", "funny"], "long_description": "Don't miss your chance to become a herald of the law or a corrupted mole in cahoots with the prisoners, all from the comfort of your own home! Step into the world of Prison Simulator VR to assume the role of a prison guard, managing the complex inner workings behind bars and uncovering secrets of this cutthroat world. Respect is a gain given only to those with a strong hand, but what kind of a guard you'll be depends only on you!\n\nIn Prison Simulator VR, you become the master of your own experience. There's a freedom in what you do, regardless if it is to be a vigilant watchman of order or turn a blind eye to the prisoners' nefarious deals.\n\nWith a wide variety of different tasks, search prison cells, confiscate illegal items, interact with the seemingly bleak prison environment and its tenants, instilling fear or gaining respect - your choices matter! Each and every character will react to the things you do, but whether you end up with more friends or enemies is entirely up to you.\n\nWatch out! You never know what might happen if you push them a little too hard!\n\nOn top of it all, Prison Simulator VR has two modes available, depending on your preference. You can explore the story mode, following thrilling clues and twists as you uncover what lurks within. For players who prefer a gameplay with less restraints, freeplay mode is a perfect way to live the every day life of a guard without the constraints of a plot.", "short_description": "Step into the world of Prison Simulator VR to assume the role of a prison guard, managing the complex inner workings behind bars and uncovering secrets of this cutthroat world. Respect is a gain given only to those with a strong hand, but what kind of a guard you'll be depends only on you!"}]}, "developer_name": "PlayWay", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/77e94899-6967-4dde-afa3-ae05eeace3f6", "developer_terms_of_service_url": null, "publisher_name": "PlayWay", "support_website_url": null, "website_url": "https://playway.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
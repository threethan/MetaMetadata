_1743189252613386_933501333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toCRQuwcHbcQ7kNvwGXnMBX&_nc_oc=AdkBu_efvuT6nVprX7NhIAWUDKDHCSXVLBfwnkJS5mmvwvyjklEe6xQmtWLz1XrPFTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwfZXc4ur-5ioowAdLc6PJJab24OY1I3o9AdUSWOWYqA&oe=69B93F6A"}, {"file_name": "migrated_image.png", "id": "209584390290922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727995_927009110776262_714146320_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fqwCq9oVxcQ7kNvwE3i_6y&_nc_oc=AdmgXkKPNEXDBXeYt0hr5UZyZJKdSCzNWJrZapm5d0pCGSEmZ3Y7-ORllsoM18vmzJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7U16d-NtwiZT7LqfClIr0M86ruh3X0GxUJpXgYf2XJw&oe=69B94CF3"}, {"file_name": "migrated_image.png", "id": "138783474220522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410239_663716023793582_947964971_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-TveHqXJAEQ7kNvwFPxzKj&_nc_oc=AdmK1jn6X23r8PxajTkKarCPEaVZR2PFMRsSn2Gv0sL3On9RYtlm_9vTXq2-AOwKqqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyR30UKcSNjJDjfI1Nwq6kKxd8iweCdvMheXMoSFLf2XA&oe=69B95323"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Schwein MMU", "keywords": ["Shooter", "Space", "Exploration", "Action"], "long_description": "Schwein Manned Maneuvering Unit, a 6 degrees of freedom shooter using Newtonian flight dynamics.\nPlay in an aggressive or non-aggressive manner.\nHINT: To get used to the controls, try not to be the one to fire the first shot.\nUpgrade ship and customize its behavior based on your play style. \n2 cockpit types, enable in options menu. Complex cockpit lowers visibility but may help with motion sickness.\n\nPlease try the Schwein MMU Demo for free.\n\nStory:\nAn AI has become self aware and  taken over automated stations near Earth, Moon, Mars and Jupiter's orbit. You have been tasked with investigating these space stations and neutralizing the AI if need be.", "short_description": "Schwein Manned Maneuvering Unit, a 6 degrees of freedom shooter using Newtonian flight dynamics. \n\nPlease try the Schwein MMU Demo for free.\n\nStory:\nAn AI has become self aware and  taken over automated stations near Earth, Moon, Mars and Jupiter's orbit. You have been tasked with investigating these space stations and neutralizing the AI if need be."}]}, "developer_name": null, "developer_privacy_policy_url": "http://schweinmmu.weebly.com/", "developer_terms_of_service_url": "http://schweinmmu.weebly.com/", "publisher_name": "Duckie", "support_website_url": null, "website_url": "http://schweinmmu.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "635550224331923"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386360_1383430995019710_1766809714_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_2-ekhTLVIQ7kNvwEIUFfg&_nc_oc=Adlo-MQOMAcVzDzC3Ht5JiPEaYMst-7P3yDPJnnMwsQbhqcNDzdaS56-sN4CJjD1YMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDXIg7AJGrDAZhW4FB9nRNk7gUm8CsSO1oiiGOxf6hzQ&oe=69B93F56"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Schwein MMU", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1475046000, "lastRevision": {"nodes": [{"id": "1798346293774956", "release_type": "SCHEDULED", "administration_status": "APPROV
 \n\nPlease try the Schwein MMU Demo for free.\n\nStory:\nAn AI has become self aware and  taken over automated stations near Earth, Moon, Mars and Jupiter's orbit. You have been tasked with investigating these space stations and neutralizing the AI if need be."}]}, "developer_name": null, "developer_privacy_policy_url": "http://schweinmmu.weebly.com/", "developer_terms_of_service_url": "http://schweinmmu.weebly.com/", "publisher_name": "Duckie", "support_website_url": null, "website_url": "http://schweinmmu.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "635550224331923"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386360_1383430995019710_1766809714_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB-_xOxf9scQ7kNvwHa9ZTr&_nc_oc=AdnVXRkCQNXBKk7O-TPSgCiztDyrS2djE91__qcNXdRcL4SEszMB4_YoLqjgp_BlPG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv4RuZ4M8qMW9O-ni9jJaDG3Y2XDNLwnGIc5JlpPY2a_Q&oe=699849D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Schwein MMU", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1475046000, "lastRevision": {"nodes": [{"id": "1798346293774956", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1193386440728067", "is_first_party": false, "
culuscdn.com/v/t64.5771-25/12482177_1743189252613386_933501333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIWLyqYwEn8Q7kNvwHwQDJ6&_nc_oc=AdqaxO6WZCIHYQIP-0IVV4QQ3A-WfDUy1muxocw4tyXk7TvKLmdQgG1WnqxUayp5zfI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbFB-DYWxhJPFuQODAdGSwJRiX2f0JN9AjEi99Acx56g&oe=6AE8B0AA"}, {"file_name": "migrated_image.png", "id": "209584390290922", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12727995_927009110776262_714146320_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HaMK6OGw0cQ7kNvwHcqXKX&_nc_oc=AdpB80IfvGtPxz3iLZC41fJKJ5ljxzVuqOidF8OkUG4QjIONsg4sDXxk3jR8hIUKKqk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR74QcVfnJpTWIRVYHNlbcGODGLsaHZPbYdf70K0hHvw&oe=6AE8BE33"}, {"file_name": "migrated_image.png", "id": "138783474220522", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410239_663716023793582_947964971_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soMZuitlkpsQ7kNvwEMCpM7&_nc_oc=Adom5eXF1wMHLKD6_QqDvT3hxCDJhoxDjTvVQ8Zc90w3ZPTD3d0Q_CIQMSMjrXwweyo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEz8irGG7I1VYvrECOam0xbH2lhR6ocivrASEynjpSmg&oe=6AE8C463"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Schwein MMU", "keywords": ["Shooter", "Space", "Exploration", "Action"], "long_description": "Schwein Manned Maneuvering Unit, a 6 degrees of freedom shooter using Newtonian flight dynamics.\nPlay in an aggressive or non-aggressive manner.\nHINT: To get used to the controls, try not to be the one to fire the first shot.\nUpgrade ship and customize its behavior based on your play style. \n2 cockpit types, enable in options menu. Complex cockpit lowers visibility but may help with motion sickness.\n\nPlease try the Schwein MMU Demo for free.\n\nStory:\nAn AI has become self aware and  taken over automated stations near Earth, Moon, Mars and Jupiter's orbit. You have been tasked with investigating these space stations and neutralizing the AI if need be.", "short_description": "Schwein Manned Maneuvering Unit, a 6 degrees of freedom shooter using Newtonian flight dynamics. \n\nPlease try the Schwein MMU Demo for free.\n\nStory:\nAn AI has become self aware and  taken over automated stations near Earth, Moon, Mars and Jupiter's orbit. You have been tasked with investigating these space stations and neutralizing the AI if need be."}]}, "developer_name": null, "developer_privacy_policy_url": "http://schweinmmu.weebly.com/", "developer_terms_of_service_url": "http://schweinmmu.weebly.com/", "publisher_name": "Duckie", "support_website_url": null, "website_url": "http://schweinmmu.weebly.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "635550224331923"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386360_1383430995019710_1766809714_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVYBpQ1aubsQ7kNvwEn11Wy&_nc_oc=AdoNIuz31fuQoq6l1SwlP-P9_vp_zyDKYPZSD58ToIDupMZw3GmZN8S_L4yBfv3FcJ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqMMCnJpMfP1cC5ACq23CQZlh-fp7Zcm2mQ4b3lTy3YQ&oe=6AE8B096"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Schwein MMU", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1475046000, "lastRevision": {"nodes": [{"id": "1798346293774956", "release_t
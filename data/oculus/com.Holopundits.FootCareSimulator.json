2152181395212514", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617844_2152181401879180_833186011085540822_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz4XvDCoYFoQ7kNvwH8zajc&_nc_oc=AdrMObQjwCzlLwg70WmxYHBz4nMNsmtpiD0i6T90MI8gqYuWXxXSeAL0RDRgdTw3qWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CcWcNct9TlSjnqRit16x793PwbU1tlsNBjYL0PQ0Sfg&oe=6A071208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_04.png", "id": "1047890286678166", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619189_1047890290011499_2590043766181911554_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nH2AWc-9tUQ7kNvwGQijv3&_nc_oc=AdpVR1nzh-mg1lZv-wn3ay1HUWanjEzlvON2dMXcs5u5UkPSDBYeAmbNQCmGCn2BxCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y-xh5EMimCr3t-WCCoFLI-kjhiFgTFehtLRyQxIKnpA&oe=6A072684"}, "display_name": "Foot Care Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "This VR simulation teaches the critical skill of providing foot care for patients, focusing on hygiene, comfort, and preventing infections. The tutorial includes preparation, proper techniques for cleaning and moisturizing, and ensuring patient safety and dignity.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.\n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n # Key Features:\n - Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners.\n - AI Companion: An interactive assistant that responds to user queries and provides clarifications to meet learning needs. (NOTE: Generative AI is still experimental)\n\n# Learning Objectives:\n- Remember the steps and protocols for providing foot care. \n- Understand the importance of proper foot hygiene in preventing infections and maintaining patient comfort.\n- Apply the correct techniques to clean, dry, and moisturize the feet safely. \n- Analyze the patient's feet for any signs of infection, irritation, or other issues.\n- Evaluate their own technique to ensure it adheres to best practices and safety standards.\n- Create a comfortable and hygienic care environment for patients through proper foot care techniques.\n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with proper care efficientl", "short_description": "Master the essential skill of providing foot care, ensuring cleanliness and comfort for patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "es_MX", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9411167242265671"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23875546025401219", "version": "1.0"}, "id": "1955289825211826", "channel
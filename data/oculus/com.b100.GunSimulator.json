894993600_669680601708040893_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViHwBswv69IQ7kNvwHiWc2F&_nc_oc=Adkd5voWnNnNygVR6MkzqTYFS4gluzVFgyYxxmY5SbCWjtPl8cK55wXRdECL4GlrbTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6QTwYud9xoptDoHg4iZgN7Pn5QmXgI-aUyLRI65vnJg&oe=6999B68E"}, "display_name": "Gun Simulator: ASMR Sound", "keywords": [], "long_description": "\nA gun simulator game offers players a realistic experience of using and handling various firearms in a virtual environment. These games focus on authentic mechanics, including shooting, reloading, and the effects of recoil. Players can engage in target practice, combat scenarios, or military missions. Features often include weapon customization, free-shooting modes, and safety lessons. The emphasis is on creating a highly immersive and educational experience regarding the operation and handling of guns", "short_description": "Gun simulator game: realistic experience of using and handling guns in a virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e134627a-edd0-406d-8f7c-ea7e166a4e11", "developer_terms_of_service_url": null, "publisher_name": "Hung", "support_website_url": null, "website_url": "https://sites.google.com/view/gun-sim-asmr-sound/main", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7911374
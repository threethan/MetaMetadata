rsive and educational experience regarding the operation and handling of guns", "short_description": "Gun simulator game: realistic experience of using and handling guns in a virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e134627a-edd0-406d-8f7c-ea7e166a4e11", "developer_terms_of_service_url": null, "publisher_name": "Hung", "support_website_url": null, "website_url": "https://sites.google.com/view/gun-sim-asmr-sound/main", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7942079989172918"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036692_1901468746992223_689467001239343846_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_tyOPA81XIQ7kNvwGvgGqv&_nc_oc=AdoWgbOZhs2KQTu-ogQKtoPAhGJAHQ9Q5lxsWtjjhzicO801MhslybTa9hToKqm8Ato&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2YEsJvhjvlposEwrweyVmycKH_K9IjFPTiUhsJ-88M1Q&oe=69F2188C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gun Simulator: ASMR Sound", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "releas
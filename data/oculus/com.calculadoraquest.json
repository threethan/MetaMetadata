2_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqzjOik3GdwQ7kNvwF9Q0rN&_nc_oc=AdquYWCoao7Ivyars0HlmpSShSgq9lPpqoX7o2UNnvozH3mevF6IzJ-U9UqlyY-JOrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDugv_lYfC-4EEHlLwPYkjuZc6g7zHqVKXwRdKema3iA&oe=6ABFAE9B"}, {"file_name": "2026_09_25T17_31_55_000Z.png", "id": "1707486833661270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596106838_1707486836994603_4601015344037564365_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXQX2dOEVjkQ7kNvwGTmQ3s&_nc_oc=AdoEidztR6itvRtb-rlRRjMY-U6zk2iUmv5oGQ9uI_-HwrwtZEGk63Q-353lf9XYli0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWNc52B6G_HBpub0-LybeKriUVUP2uS_ynVLksCwdZ5A&oe=6ABFD6E8"}, {"file_name": "2026_09_25T17_32_15_000Z.png", "id": "1775951963689744", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1775951967023077_8116382806867878610_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UH5mZRU37MQ7kNvwFP3RbZ&_nc_oc=AdpfGQBwj525o2S5-PLz3VreHWcT0eB0bs3Ms19JNJOjuMXdW8qi8gjgWBm-BPPVApw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWpIpZl3YzPfp6cfAmQXMHGH6-jOPrLZwe7hStoonizA&oe=6ABFC2F6"}, {"file_name": "2026_09_25T17_31_37_000Z.png", "id": "4463430973803673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604293968_4463430977137006_3494429431305740557_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoZpo5gVz9sQ7kNvwEpma8q&_nc_oc=AdocqSjIuT6RwCNDzsrwRS6yS9Dkd8XQC-MHdEO-9VRET1uh2vtSITj-3foqxNkczrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJYHARstZeWlkjRRFuL9r5Xjrx92giEQGyGl9_bi0HxQ&oe=6ABFD388"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calc", "keywords": ["calculadora", "conversor", "matem\u00e1tica", "produtividade", "offline"], "long_description": "Calc transforma o seu Meta Quest em um espa\u00e7o pr\u00e1tico para calcular, conferir resultados e converter medidas sem sair do ambiente VR.\n\nUse a calculadora b\u00e1sica para opera\u00e7\u00f5es do dia a dia ou ative o modo cient\u00edfico para trabalhar com trigonometria, logaritmos, pot\u00eancias, ra\u00edzes, fatoriais, constantes \u03c0 e e, valor absoluto e a \u00faltima resposta. Escolha entre graus e radianos, acompanhe a express\u00e3o completa e veja uma pr\u00e9via do resultado antes de concluir o c\u00e1lculo.\n\nO hist\u00f3rico local guarda seus c\u00e1lculos recentes para consulta e reutiliza\u00e7\u00e3o. O conversor funciona offline e inclui comprimento, massa, temperatura, \u00e1rea, volume, velocidade, tempo e dados, com convers\u00f5es entre unidades decimais e bin\u00e1rias.\n\nA interface foi criada para o painel 2D do Meta Quest, em orienta\u00e7\u00e3o paisagem e com bot\u00f5es amplos para uso por controles ou m\u00e3os. O layout se adapta a diferentes tamanhos de painel e mant\u00e9m foco visual e boa legibilidade.\n\nSeja para estudar, planejar, conferir n\u00fameros ou resolver tarefas r\u00e1pidas, Nexus Calc re\u00fane ferramentas matem\u00e1ticas essenciais em um painel simples, responsivo e pronto para usar.", "short_description": "Calculadora cient\u00edfica e conversor de unidades para Meta Quest. Fa\u00e7a c\u00e1lculos r\u00e1pidos em um painel 2D, consulte o hist\u00f3rico e trabalhe offline com controles ou m\u00e3os."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bramble-jasper-0d2.notion.site/Pol-tica-de-Privacidade-Calc-2624231770df801fb7d3c1195ba209b9", "developer_terms_of_service_url": null, "publisher_name": "Allyson Athyrson", "support_website_url": null, "website_url": "https://github.com/Allyson1602", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
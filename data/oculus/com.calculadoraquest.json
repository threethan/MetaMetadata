n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIv3vW_u0JQQ7kNvwGOE5q7&_nc_oc=AdqV4dd0E0ouDdygsb8_rRrsl45extfUNOMirHnoufTvOOF-ua7X0wIsRLC1v_KadZk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbNwtyI2cIwcRsEqHi38lVlJvQYvuXnOiKCfd7IhIoIg&oe=6B09BADB"}, {"file_name": "2026_09_25T17_31_55_000Z.png", "id": "1707486833661270", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596106838_1707486836994603_4601015344037564365_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbD3UClE2vYQ7kNvwEoDx96&_nc_oc=AdoE18zx83EtVcij7hXtu3f-vA8nqBh4kDM2wiGBKEnFbNy0KUzA3sFtYk7Exa47wRo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOVJBuYqdKNufYMt-dyPEgcAFQFzPpZnTJJelPOmE3Pg&oe=6B09AAE8"}, {"file_name": "2026_09_25T17_32_15_000Z.png", "id": "1775951963689744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673531334_1775951967023077_8116382806867878610_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zu7OyPliMcQ7kNvwEkp1xk&_nc_oc=AdoUfVWZ-EV1AeO-u7ieqh-3YttdWHMLPGirTVdGHWp6PC-O9OM-H7IxbZBT_zIW8B8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf_eHDQczU8FglrJyVzgDriL-dAIqd7-cCJt4-8OvIzw&oe=6B09CF36"}, {"file_name": "2026_09_25T17_31_37_000Z.png", "id": "4463430973803673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604293968_4463430977137006_3494429431305740557_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PupYlbmD92oQ7kNvwGUOhiC&_nc_oc=AdqZL8Csc_lSTTGblHZnPxjNZhrzd6LJ0EIUciYSxzPENubeE1_urUpyGtWXsiJG88U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw7P4f-CiT3VgOdjpYA7LrdBtXhqmBGtanCNlABcKSLg&oe=6B09A788"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calc", "keywords": ["calculadora", "conversor", "matem\u00e1tica", "produtividade", "offline"], "long_description": "Calc transforma o seu Meta Quest em um espa\u00e7o pr\u00e1tico para calcular, conferir resultados e converter medidas sem sair do ambiente VR.\n\nUse a calculadora b\u00e1sica para opera\u00e7\u00f5es do dia a dia ou ative o modo cient\u00edfico para trabalhar com trigonometria, logaritmos, pot\u00eancias, ra\u00edzes, fatoriais, constantes \u03c0 e e, valor absoluto e a \u00faltima resposta. Escolha entre graus e radianos, acompanhe a express\u00e3o completa e veja uma pr\u00e9via do resultado antes de concluir o c\u00e1lculo.\n\nO hist\u00f3rico local guarda seus c\u00e1lculos recentes para consulta e reutiliza\u00e7\u00e3o. O conversor funciona offline e inclui comprimento, massa, temperatura, \u00e1rea, volume, velocidade, tempo e dados, com convers\u00f5es entre unidades decimais e bin\u00e1rias.\n\nA interface foi criada para o painel 2D do Meta Quest, em orienta\u00e7\u00e3o paisagem e com bot\u00f5es amplos para uso por controles ou m\u00e3os. O layout se adapta a diferentes tamanhos de painel e mant\u00e9m foco visual e boa legibilidade.\n\nSeja para estudar, planejar, conferir n\u00fameros ou resolver tarefas r\u00e1pidas, Nexus Calc re\u00fane ferramentas matem\u00e1ticas essenciais em um painel simples, responsivo e pronto para usar.", "short_description": "Calculadora cient\u00edfica e conversor de unidades para Meta Quest. Fa\u00e7a c\u00e1lculos r\u00e1pidos em um painel 2D, consulte o hist\u00f3rico e trabalhe offline com controles ou m\u00e3os."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bramble-jasper-0d2.notion.site/Pol-tica-de-Privacidade-Calc-2624231770df801fb7d3c1195ba209b9", "developer_terms_of_service_url": null, "publisher_name": "Allyson Athyrson", "support_website_url": null, "website_url": "https://github.com/Allyson1602", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
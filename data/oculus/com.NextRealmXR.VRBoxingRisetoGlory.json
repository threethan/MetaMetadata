E6lvox-PdjQQ7kNvwEt4A8R&_nc_oc=Ado6bHGd8agGeeRjO3KsPoyLVZ0DQEkFg3fCDbzrnmF6tbOWaz7f8k1OLlHkGfHaLX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq4exwq-r5_bzWUQb6sbjqbmC1zBcDO2AW32blNkNfDw&oe=6AFC7014"}, {"file_name": "Render-5.png", "id": "1483591563087950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_1483591569754616_1219858942823009436_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6DYEzOUuaAQ7kNvwE5kRv8&_nc_oc=AdqJpEYCdHAfZbuDUnz59y6x4gm8qeuRIFg3gQ0cNTfWRZKqJfDOSUiem7wZUq99LTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmn0zpS8qhPwmItwo2a6RGiDE9tkZYp17PJUSd4vEtrw&oe=6AFC82BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x 1440x.png", "id": "2115308435789916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624606_2115308445789915_5376960071998797695_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igEA1zPIvY4Q7kNvwGJRZie&_nc_oc=AdqfBqASP0f3JfXTJns-y1FtSDnHNFnodToaUn0m24X_mGKNhMm8lVJx6v2N4HbuxIA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHg8riROCTTtCzbRf3s_3Dp1ooHK9yQX0k3xQ97ea0jw&oe=6AFC8056"}, "display_name": "VR Boxing Rise to Glory", "keywords": ["fighting", "fitness", "rhythm", "zombie", "boxing"], "long_description": "VR Boxing Rise to Glory is a realistic, physics-based VR boxing game for Meta Quest. Every punch follows your real speed and aim, so jabs, hooks and uppercuts land with weight and every knockout is earned.\n\n**CAREER MODE**\n\nStart as an unknown and fight your way to the championship. Every opponent has a unique style and blocks, dodges and counters, so read your opponent and pick your shots.\n\n**TRAINING MODE & GYM**\n\nWarm up in the gym and practice your combos, timing and defense before you step into the ring.\n\n**HAND-TRACKING MUSIC MODE**\n\nPut the controllers down and box with your bare hands. Punch to the beat and smash incoming targets in a rhythm boxing workout.\n\n**ENDLESS ZOMBIE MODE**\n\nHow long can you survive? Knock out wave after wave of zombies with your fists and beat your high score.\n\n**COMING SOON**\n- **Nightclub Mode**: take the fight off the ring into a nightclub brawl\n- **Multiplayer**: box your friends and players worldwide online\n\n**FEATURES**\n- Realistic physics-based punches, blocks and dodges\n- Career Mode against AI fighters with unique styles\n- Training gym for combos and technique\n- Hand-tracking Music Mode, no controllers needed\n- Endless Zombie survival mode\n- Full-body VR boxing workout and cardio\n\nGlove up, step into the ring and rise to glory.\n\nEarly Access: we update the game often based on player feedback. Join our Discord to share ideas and report bugs.\n\n**https://discord.gg/rk8jMVVWpS**\n", "short_description": "Step into the ring in VR Boxing Rise to Glory, a realistic physics-based VR boxing game. Throw real jabs, hooks and uppercuts and land the knockout. Fight to the title in Career Mode, sharpen your combos in the Training Gym, punch to the beat with your bare hands in the hand-tracking Music Mode, or survive Endless Zombie Mode. Coming soon: Nightclub brawls and online Multiplayer. A real boxing workout that makes you sweat."}]}, "developer_name": "Aurevix Solution", "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
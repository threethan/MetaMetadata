3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq4exwq-r5_bzWUQb6sbjqbmC1zBcDO2AW32blNkNfDw&oe=6AFC7014"}, {"file_name": "Render-5.png", "id": "1483591563087950", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_1483591569754616_1219858942823009436_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6DYEzOUuaAQ7kNvwE5kRv8&_nc_oc=AdqJpEYCdHAfZbuDUnz59y6x4gm8qeuRIFg3gQ0cNTfWRZKqJfDOSUiem7wZUq99LTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmn0zpS8qhPwmItwo2a6RGiDE9tkZYp17PJUSd4vEtrw&oe=6AFC82BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x 1440x.png", "id": "1820095692697341", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499310667_1820095696030674_2794923274903254461_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkSU6-oNlPwQ7kNvwHVJCr2&_nc_oc=AdoF0vUArikfMdqbMnQdK2Ybx6IBaVibMMacN3ChZcRwT0VBzYzkYy9I4j6nk08THOs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Dnk0AIH_f4pEcqa7QMiK0mix9cJiLC80Eyu2kJ0uPQ&oe=6AFC80ED"}, "display_name": "VR Boxing Rise to Glory", "keywords": ["Boxing", "Fighting", "Fitness", "Thrilling", "VRBoxing"], "long_description": "Enter the world of professional boxing and fight your way to greatness in VR Boxing Rise to Glory, the ultimate immersive VR boxing experience. Featuring realistic fighters, detailed arenas, physics-based combat, and intense championship battles, this game delivers authentic virtual reality boxing action like never before.\n\nStep into beautifully crafted boxing venues inspired by professional fight arenas and experience every punch, dodge, block, and knockout with realistic movement and responsive controls. Whether you're a casual player looking for exciting VR fitness gameplay or a competitive fighter chasing championship glory, VR Boxing Rise to Glory offers an engaging experience for every boxer.\n\nFeatures:\n\n\u2022 Realistic VR boxing mechanics with immersive hand-tracked combat\n\u2022 Detailed and authentic boxing arenas with dynamic crowd atmosphere\n\u2022 Highly detailed fighters with realistic animations and reactions\n\u2022 Physics-based punches, blocks, dodges, and knockout effects\n\u2022 Challenging AI opponents with unique fighting styles and strategies\n\u2022 Intense one-on-one championship battles\n\u2022 Competitive gameplay designed for both casual and hardcore players\n\u2022 VR fitness-focused gameplay that keeps you active and engaged\n\u2022 Stunning visuals and immersive audio optimized for virtual reality\n\nTrain hard, master your technique, and prove yourself inside the ring. Every victory brings you one step closer to becoming the ultimate champion.\n\nDo you have what it takes to rise from contender to ", "short_description": "Experience the thrill of professional boxing in VR Boxing Rise to Glory. Fight in realistic arenas, master physics-based combat, and challenge powerful opponents on your journey to championship glory. Featuring immersive VR gameplay, realistic fighters, intense knockout action, and authentic boxing mechanics built exclusively for virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NextRealm XR", "support_website_url": null, "website_url": "https://muhammadsufwan.github.io/nextrealmxr-privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
\n- Dino Jungle + T-Rex \ud83e\udd96\n{1466563128145823}\n- Falcons High + Necro Gorgon \ud83c\udfeb\n{1406394327856553}\n- Fun Center + Gorilla Gang \ud83c\udf82\n{660554287120395}\n- Smiler + Backrooms \ud83d\udeaa\n{674874741845817}\n- Scarecrow + Corn Maze \ud83c\udf3d\n{1096838768878140}\n- Minotaur + Labyrinth \ud83d\udc02\n{786089887612482}\n- Stalker + Dark Forest\n- Vents + Banshee \n\n# Play Monsters and Mazes Today! \n{2537963193236292}\n\n", "short_description": "Solve the Puzzles... Escape the Factory... or Become the Toy Monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/monstersandmazes/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc", "support_website_url": "https://discord.gg/dCKnWdMsu3", "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28688149224111261"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628447_914681698097427_7208680056869479527_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJqGgxGennIQ7kNvwE15mMf&_nc_oc=AdrVD1OFhEVr5Rq9IPsn-3EtMkB-YyUIJgpJJ3113OFiS-6xvN1eZDLZV6dJJBSYsLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculus
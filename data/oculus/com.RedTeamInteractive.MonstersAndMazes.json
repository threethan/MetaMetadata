://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673531334_1976774046348637_5996890507065117532_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a13K-bMGDwQ7kNvwHZ72bS&_nc_oc=AdohjV2rsgNjNaNDDZwZOHp7Y9KcKWXJcKBbS0X9LFKUS3ibinGXTTXW7MZgtzWvAsE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXxAvKgdKF6D1AMX4sC69aPSQoGb_lryTxPBXkmYAuqQ&oe=6AFF0D1E"}, {"file_name": "Screenshot 5.png", "id": "1734429697792006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300603_1734429701125339_2739296227236575863_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DeBWFYtSN0Q7kNvwFTd1Zs&_nc_oc=AdqhZ0q28DyDDgyxNHVIwKyU-dOxkdSNZxk0BqiJJQUGwF-V2fuGQ5x1c0HvoXlH2z8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN7u8ouJE9FvTVw0OW6on382FdlZ34476WD0xvzjeH6A&oe=6AFF2FA4"}, {"file_name": "499299789_908484421556469_2830791893361435021_n.png", "id": "1414246190078730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604366035_1414246193412063_5288581021686340190_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnU_rJULUBUQ7kNvwGDh95n&_nc_oc=AdrpMHvv0qfgxli_D0Zt9VJKs3O5CyHKnBCFRZypJEMsL2IZ-nEkrimudEcEzSt3Lv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4mf8QW5fjjOUmGo88hqt7t5dziiqxL628AYUHfXv8AA&oe=6AFF34A3"}, {"file_name": "WeirderThingsSplashEmpty.png", "id": "1769063400985062", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499294603_1769063404318395_8872947988862674946_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBKZKJKSr58Q7kNvwGM8KEs&_nc_oc=AdpCKGtK_NI2LhubtqeshS_oOzv1vwDdMdKphU7ECDgA2zN8ohsX2O8c2prjFRUdRck&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRPe3-BirLJYNboEUPcQePDuMjcYwd5nB4C6m0sptjvQ&oe=6AFF3526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MMPoolroomsArt.png", "id": "963133099849800", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622195_963133103183133_9070864822490958179_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIYnOyHntJAQ7kNvwE7XdG3&_nc_oc=AdoM7rT2uZYKAOJuRgoV0FrBrPrOk5r6_J-VSsUq6e8BxTrNdGHlJK6sIQMd6Lckn7Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLzouXw6ROiC6x2nzVDj2zP7uzTWcyCt5TGo5spdRtzQ&oe=6AFF1DB4"}, "display_name": "Monsters and Mazes Poolrooms", "keywords": ["Monsters", "Monster", "Maze", "Horror", "Backrooms"], "long_description": "Can you escape the maze before the Monster gets you? \ud83d\udc40\n\nMonsters and Mazes is a FREE multiplayer horror game! \n\nOne player is the Monster. Everyone else has to solve the maze and RUN! \ud83c\udfc3\u200d\u2642\ufe0f\ud83d\udca8\n\n\u3164\n\n\ud83d\udd25 Why Players Love Monsters and Mazes\n\n\u3164\n\n\ud83d\udc79 Be the Monster: Hunt your friends as a T-Rex, an Animatronic, Backrooms Smiler, and more!\n\n\ud83c\udfc3 Escape Together: Team up, solve the maze, and find the way out!\n\n\ud83d\uddfa\ufe0f 9 Mazes, 9 Monsters: Jungles, schools, the Backrooms, corn fields, and more!\n\n\ud83c\udd95 New Stuff Every Week: New secrets, new monsters, new skins!\n\n\ud83c\udfa8 Get YOUR Skin in the Game: Win our skin contests and see your design in the game!\n\n\u3164\n\n# \ud83d\uddfa\ufe0f Current Mazes & Monsters :\n- Toy Factory + Monster Toys \ud83e\uddf8\n{1097195279357544}\n- Dino Jungle + T-Rex \ud83e\udd96\n{1466563128145823}\n- Falcons High + Necro Gorgon \ud83c\udfeb\n{1406394327856553}\n- Fun Center + Gorilla Gang \ud83c\udf82\n{1658248062497338}\n- Smiler + Backrooms \ud83d\udeaa\n{674874741845817}\n- Scarecrow + Corn Maze \ud83c\udf3d\n{1432288322334268}\n- Minotaur + Labyrinth \ud83d\udc02\n{786089887612482}\n- Stalker + Dark Forest\n- Vents + Banshee \n\n\ud83d\udc49 Join 400,000+ Players!\n\nJoin our Discord for skin contests and events: https://discord.gg/aFKBDdWmah\n\nPlay FREE today... and Become the Monster! \ud83d\udc7b", "short_description": "FREE multiplayer horror! One player is the Monster. Everyone else must escape the maze! \ud83d\udc79\ud83c\udfc3\u200d\u2642\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/monstersandmazes/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc", "support_website_url": "https://discord.gg/dCKnWdMsu3", "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29727247973534709"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296069_28980299644973608_1648526514211893118_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQJp1Ws_p-0Q7kNvwGBL9Bw&_nc_oc=AdozJSj3kwNCLxEru6i0Krt7cxWKJPaTl6mGoUpbv6fyQDq1KhJtM3oHlTOcKSnZL14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM-Z9A0tMx_nL5rk9bV-N-uUHLrHeSx2cUgwZhU8JDBA&oe=6AFF3370"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monsters and Mazes Poolrooms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_n
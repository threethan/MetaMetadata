IBBTjBYMYgm3My5STJwLamRLLzdxNsDTDKP1NRiyF-l4Ez6q5NHK6XPjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtO19_Nifdz-EzbfbzpDopR9Hf9DiY9Eba_MNcjMmZ0Q&oe=6AEDFA61"}, {"file_name": "491825091_1987273172105332_5717139324666492055_n.png", "id": "1976774043015304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673531334_1976774046348637_5996890507065117532_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJwDSbKRmzUQ7kNvwFE2sYJ&_nc_oc=AdoL906w0lIL6TDsLR7TUZhs8K_4jEBKGSIzTHbnUvCsXQp1AVJhsOyeIToG3PBlkCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXo2XvTy1Cb3OIGpHTyZ1upMV77jjZRJp6ltEPV-aq6A&oe=6AEDE99E"}, {"file_name": "Screenshot 5.png", "id": "1734429697792006", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300603_1734429701125339_2739296227236575863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24TyikYRTpEQ7kNvwHWFq1y&_nc_oc=Adq1hOMa5cVClRoEEB1mrqBWaUTBhtGZoZ_Az6EJaH7qIOr3F4ozZ41pN0sFTfuS_uY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_wJ2khiSIk55RXOa_THRn83_je-7SWF0HJ6JsbxUmQQ&oe=6AEE0C24"}, {"file_name": "WeirderThingsSplashEmpty.png", "id": "1769063400985062", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294603_1769063404318395_8872947988862674946_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhDarIdNprYQ7kNvwFLtUiV&_nc_oc=AdqjcJLidoF7unqKlLVO8Xb7SORYS3C_qUB6lmGTYY2lz8uqzPPshrkw7Ru9ghcjvNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-F4YwxznvUc06vkTtatB9ULFRmQvoBpQvk_VS8tCnOw&oe=6AEDD966"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MMHalloween1.png", "id": "1449488627069601", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623558_1449488630402934_1419861882119834867_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGq__wZ1Lo0Q7kNvwFhT9aY&_nc_oc=AdqSyLtHnS7ztqMBn2U6pflvXfs69TnEWIvmCY1oOn1oia5XgkyHqjD-HPKwVUvOGpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN24IxEHLcvo8-giWFHt8DZTYDSvtfBrbIaj1EqNDZJQ&oe=6AEDEE40"}, "display_name": "Monsters and Mazes Halloween", "keywords": ["Monsters", "Monster", "Maze", "Horror", "Backrooms"], "long_description": "Can you escape the maze before the Monster gets you? \ud83d\udc40\n\nMonsters and Mazes is a FREE multiplayer horror game! \n\nOne player is the Monster. Everyone else has to solve the maze and RUN! \ud83c\udfc3\u200d\u2642\ufe0f\ud83d\udca8\n\n\u3164\n\n\ud83d\udd25 Why Players Love Monsters and Mazes\n\n\u3164\n\n\ud83d\udc79 Be the Monster: Hunt your friends as a T-Rex, an Animatronic, Backrooms Smiler, and more!\n\n\ud83c\udfc3 Escape Together: Team up, solve the maze, and find the way out!\n\n\ud83d\uddfa\ufe0f 9 Mazes, 9 Monsters: Jungles, schools, the Backrooms, corn fields, and more!\n\n\ud83c\udd95 New Stuff Every Week: New secrets, new monsters, new skins!\n\n\ud83c\udfa8 Get YOUR Skin in the Game: Win our skin contests and see your design in the game!\n\n\u3164\n\n# \ud83d\uddfa\ufe0f Current Mazes & Monsters :\n- Toy Factory + Monster Toys \ud83e\uddf8\n{1097195279357544}\n- Dino Jungle + T-Rex \ud83e\udd96\n{1466563128145823}\n- Falcons High + Necro Gorgon \ud83c\udfeb\n{1406394327856553}\n- Fun Center + Gorilla Gang \ud83c\udf82\n{1658248062497338}\n- Smiler + Backrooms \ud83d\udeaa\n{674874741845817}\n- Scarecrow + Corn Maze \ud83c\udf3d\n{1432288322334268}\n- Minotaur + Labyrinth \ud83d\udc02\n{786089887612482}\n- Stalker + Dark Forest\n- Vents + Banshee \n\n\ud83d\udc49 Join 400,000+ Players!\n\nJoin our Discord for skin contests and events: https://discord.gg/aFKBDdWmah\n\nPlay FREE today... and Become the Monster! \ud83d\udc7b", "short_description": "FREE multiplayer horror! One player is the Monster. Everyone else must escape the maze! \ud83d\udc79\ud83c\udfc3\u200d\u2642\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/monstersandmazes/policy", "developer_terms_of_service_url": null, "publisher_name": "Re
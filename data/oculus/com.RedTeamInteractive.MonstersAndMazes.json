963133103183133_9070864822490958179_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_zTe0XLTYQQ7kNvwFlfGaT&_nc_oc=AdrCxe0sWecwcw330Z7A9fgFiZ-4Ne7GvPo9fD3Drb9hHQibV3Z2_ZEEF9gEgMliQHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOGHhP3BzmpERK76uQupxN5_50LJFvv7TSQRptNHKnaQ&oe=6B05B534"}, "display_name": "Monsters and Mazes Poolrooms", "keywords": ["Monsters", "Monster", "Maze", "Horror", "Backrooms"], "long_description": "Can you escape the maze before the Monster gets you? \ud83d\udc40\n\nMonsters and Mazes is a FREE multiplayer horror game! \n\nOne player is the Monster. Everyone else has to solve the maze and RUN! \ud83c\udfc3\u200d\u2642\ufe0f\ud83d\udca8\n\n\u3164\n\n\ud83d\udd25 Why Players Love Monsters and Mazes\n\n\u3164\n\n\ud83d\udc79 Be the Monster: Hunt your friends as a T-Rex, an Animatronic, Backrooms Smiler, and more!\n\n\ud83c\udfc3 Escape Together: Team up, solve the maze, and find the way out!\n\n\ud83d\uddfa\ufe0f 9 Mazes, 9 Monsters: Jungles, schools, the Backrooms, corn fields, and more!\n\n\ud83c\udd95 New Stuff Every Week: New secrets, new monsters, new skins!\n\n\ud83c\udfa8 Get YOUR Skin in the Game: Win our skin contests and see your design in the game!\n\n\u3164\n\n# \ud83d\uddfa\ufe0f Current Mazes & Monsters :\n- Toy Factory + Monster Toys \ud83e\uddf8\n{1097195279357544}\n- Dino Jungle + T-Rex \ud83e\udd96\n{1466563128145823}\n- Falcons High + Necro Gorgon \ud83c\udfeb\n{1406394327856553}\n- Fun Center + Gorilla Gang \ud83c\udf82\n{1658248062497338}\n- Smiler + Backrooms \ud83d\udeaa\n{674874741845817}\n- Scarecrow + Corn Maze \ud83c\udf3d\n{1432288322334268}\n- Minotaur + Labyrinth \ud83d\udc02\n{786089887612482}\n- Stalker + Dark Forest\n- Vents + Banshee \n\n\ud83d\udc49 Join 400,000+ Players!\n\nJoin our Discord for skin contests and events: https://discord.gg/aFKBDdWmah\n\nPlay FREE today... and Become the Monster! \ud83d\udc7b", "short_description": "FREE multiplayer horror! One player is the Monster. Everyone else must escape the maze! \ud83d\udc79\ud83c\udfc3\u200d\u2642\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mystical-mote-389916.web.app/monstersandmazes/policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc", "support_website_url": "https://discord.gg/dCKnWdMsu3", "website_url": "https://mystical-mote-389916.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29889378207321684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839692_1134083135916706_2827301522627987401_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-Oh71b9eokQ7kNvwGFfRr6&_nc_oc=AdqctDZQ7iHn9ZyZXNRoxwJ62hUXVNqyNkBEAHHPHs9_f78MsuONEgMgIdCIoS9IadE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqsfKUJkPDCHlUL1BphO3u00K0YeexuEJ8RMnAZ9bcRA&oe=6B05C7F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monsters and Mazes Poolrooms", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": 
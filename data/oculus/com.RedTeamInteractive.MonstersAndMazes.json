774043015304", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673531334_1976774046348637_5996890507065117532_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf8xGVizZggQ7kNvwE9kBS1&_nc_oc=Ado6HmdUqpzUYrUDufESd1jF9REw59Rq240NP-VyXEycIWtI0bN7F9OQ2ay0jn5rzGI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0iJA19Diw7s1bDE-eLK7c-UjBYKEnFlEikEfmUslufQ&oe=6B09D15E"}, {"file_name": "Screenshot 5.png", "id": "1734429697792006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300603_1734429701125339_2739296227236575863_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noQKx6oeajYQ7kNvwGNvmip&_nc_oc=AdqFhMHDauqC1M15Vsn0mweg-b_4nfMHuxAEyVf-98-hvcSQxUtxwHQZP_Kk2yOPzgI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbmvCIAylsJB1x1_57orlB4yyT23olqVuDnP9JA0drBQ&oe=6B09BBA4"}, {"file_name": "499299789_908484421556469_2830791893361435021_n.png", "id": "1414246190078730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604366035_1414246193412063_5288581021686340190_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eoZs8cOE58Q7kNvwFF4uSb&_nc_oc=AdqhY12k03CpDHPc-_tBuk2G3npYcAxx9Dwg8KggbCwPeQHWjmg2WEFiKEo4bCaz5Jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn6H_okZCgd8MsyexWFlpgiBjSO13btGYonvhuPotmIA&oe=6B09C0A3"}, {"file_name": "WeirderThingsSplashEmpty.png", "id": "1769063400985062", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499294603_1769063404318395_8872947988862674946_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDjejvYuH_YQ7kNvwERokiW&_nc_oc=AdoMoevQnfXNzK5cr-xorHsC8ehF8zbOjV4pzGREPJbx_kpJs7maO86rKe4a7GXom2Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrLv18lcICh8JBEFshd8UXEKvWYN8EQLDoTJaouVPlsA&oe=6B09C126"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MMPoolroomsArt.png", "id": "963133099849800", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499622195_963133103183133_9070864822490958179_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40OyY10frkQQ7kNvwFGH5xX&_nc_oc=Adq3LqeAxTuO63iAsn5wFktJ79jU9W2WlQPviaUtyAfGRDk-e0oWV-3fFZyGkjgFMmc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtyOfyxPmUkwTw2loiaCRHJa1seCuXOWAhkPbSSL8iUg&oe=6B09A9B4"}, "display_name": "Monsters and Mazes Poolrooms", "keywords": ["Monsters", "Monster", "Maze", "Horror", "Backrooms"], "long_description": "Can you escape the maze before the Monster gets you? \ud83d\udc40\n\nMonsters and Mazes is a FREE multiplayer horror game! \n\nOne player is the Monster. Everyone else has to solve the maze and RUN! \ud83c\udfc3\u200d\u2642\ufe0f\ud83d\udca8\n\n\u3164\n\n\ud83d\udd25 Why Players Love Monsters and Mazes\n\n\u3164\n\n\ud83d\udc79 Be the Monster: Hunt your friends as a T-Rex, an Animatronic, Backrooms Smiler, and more!\n\n\ud83c\udfc3 Escape Together: Team up, solve the maze, and find the way out!\n\n\ud83d\uddfa\ufe0f 9 Mazes, 9 Monsters: Jungles, schools, the Backrooms, corn fields, and more!\n\n\ud83c\udd95 New Stuff Every Week: New secrets, new monsters, new skins!\n\n\ud83c\udfa8 Get YOUR Skin in the Game: Win our skin contests and see your design in the game!\n\n\u3164\n\n# \ud83d\uddfa\ufe0f Current Mazes & Monsters :\n- Toy Factory + Monster Toys \ud83e\uddf8\n{1097195279357544}\n- Dino Jungle + T-Rex \ud83e\udd96\n{1466563128145823}\n- Falcons High + Necro Gorgon \ud83c\udfeb\n{1406394327856553}\n- Fun Center + Gorilla Gang \ud83c\udf82\n{1658248062497338}\n- Smiler + Backrooms \ud83d\udeaa\n{674874741845817}\n- Scarecrow + Corn Maze \ud83c\udf3d\n{1432288322334268}\n- Minotaur + Labyrinth \ud83d\udc02\n{786089887612482}\n- Stalker + Dark Forest\n- Vents + Banshee \n\n\ud83d\udc49 Join 400,000+ Players!\n\nJoin our Discord for skin contests and events: https://discord.gg/aFKBDdWmah\n\nPlay FREE today... and Become the Monster! \ud83d\udc7b"
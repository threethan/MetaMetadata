XQPS4MHfITOTrULsfm8uXCbSiTrrX0zkjkyspw&oe=6B00622C"}, {"file_name": "Capture1.png", "id": "711656780743121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036679_711656784076454_7809860984699052088_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O61PWsm72D8Q7kNvwHDJAWL&_nc_oc=AdowQQ5XxF0aFlis0JEPhcUINQGCnCIHcQU6YhV-DrgurEd0tzJNhLtTseFFdDA4W68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdV3HxnP2Bi18B1BSLEJcfQfLI0ADt6RxM9IC9OAmglg&oe=6B00777E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BrromMagicMayhem_logo_2560x1440.png", "id": "2487098151440393", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_2487098154773726_7912334706141546580_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaRIe1UGR58Q7kNvwEmQqp2&_nc_oc=AdpioylxuXp8ZYLzrAX4Ews08-ybaOI-keo53rFvyz_jq0SrmnxY0453mmoIlyIL6ow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUP5A5CV0yTMcuoNzWdUXYNULx62Lo6IARJz5lbnj5eA&oe=6B007023"}, "display_name": "Broom Magic Mayhem", "keywords": [], "long_description": "Broom Magic Mayhem is a Virtual Reality thrill ride through a magical wizarding world. \n\nIn Broom Magic Mayhem, you can take on the role of a broom-riding wizard and compete online against your friends in a fast-paced thrill ride through a world of fantasy and magic. \n\nCompete with friends as you speed through forests, fly through the clouds, and collect spells and power-ups while trying to capture quick-witted Ghosts in this Virtual Reality Wizarding adventure. \n", "short_description": "A high-flying virtual thrill ride through a magical Wizarding world of adventure. Grab your broom, take flight, and compete online in a fast-paced thrill ride through a world of fantasy and magic. Speed through forests, fly through the clouds, and compete with your friends to capture quick-witted Ghosts in this Virtual Reality Wizarding adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://broommagicmayhem.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TinyByte Studios", "support_website_url": null, "website_url": "https://broommagicmayhem.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1286100085320620"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "633313286498280"}, {"status": "PUBLISHED", "id": "713862107734511"}, {"status": "PUBLISHED", "id": "1954226381981740"}, {"status": "PUBLISHED", "id": "1282059492383389"}]}, "baseline_offer": {"id": "713862107734511"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756144800, "status": "PUBLISHED", "id": "633313286498280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9835395359815163", "version": "1.1.2"}, "id": "660413042067791", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4968854313135983", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9835395359815163"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "660413042067791"}]}, "change_log": "Hey all,\n\nWe've released some bug fixes to resolve issues with some of the newer Meta devices. We've also added some other improvements as well.\n\nBug Fixes:\n* Fixes a bug where users would get stuck on loading screen\n* Fixes a bug where host changes would spawn multiple brooms in lobby\n* Fixes a bug where ghost amount would always be 1 in some cases\n* Smooths out glitches in ghost movement for non-host players\n\nFeatures:\n* Adds visualization for menu access on left hand\n* Adds compass to right hand when holding ghost that points to where to score\n* Add effect on goal where player needs to score their ghost to avoid confusion\n* Added ability to hit ghosts with power up shots:\n    * Yellow shot stuns the ghost\n    * Blue shot grabs the ghost toward the player. If the ghost collides with the player during the grab, it's automatically picked up by them\n    * AI will now use this feature\n\nMisc:\n* Updated stun visuals on players\n* Lower size and increase travel length of blue power up shot\n\nEnjoy :)", "created_date": 1745260098, "id": "9835395359815163", "version": "1.1.2", "version_code": 156, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4968854313135983", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9835395359815163"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "660413042067791"}]}, "change_log": null, "created_date": 1745022593, "id": "9817700214918011", "version": "1.1.1", "version_code": 150, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_file
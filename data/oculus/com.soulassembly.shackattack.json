, "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031503_1083155753219989_8190336259835542925_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_QPaNU-C2kQ7kNvwFgkiS1&_nc_oc=AdmW23sQFK4NWLc7hNLCw-kINVfqCatA1tAKkwpo99WepchFBdBTN4-PL5GCbe8Mx6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu9Kg6tnrLTNLzdtxrAbqgK1dpg6XGKYCwOfxMoiv4R3A&oe=69A42DE3"}, {"file_name": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nY1ZTF01wQ0Q7kNvwHSBPbE&_nc_oc=Adnc4kIdgjlwSAcXycZTLQ-L26ZcdB63rmCEJldMJQ_aKjoZFhH5ks5L_afJVwar0kQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfscZtuhPfpOXb5tRMuEjb4QwhwMzQ2BNO8Y9eIZYC3iOg&oe=69A44556"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqMAEzMZzXwQ7kNvwGf31RI&_nc_oc=AdklnW9Szq7fU2MO8aGbDWzfpJJqsxNpVSYxZHvcay9jPEjYQg0wEqRLjkFsVRqzN7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfueZWCqsJ7Hnv-ZH_Odk4hWNJaf25QLbajQRB0U1jXtig&oe=69A42B73"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq-dMgOqHxIQ7kNvwFcbQ6s&_nc_oc=Adn2G8IdTW5LNL8lMYj1lebTxLmcoh1ZFbdUw_-bWlPSFMl5j2QjpWb2-jbeTXg6NtA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsy7kWKhHfrSaEGC4n3fdKVzTv1NblCTDO5jpI1DWjMMw&oe=69A42DE3"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRadYm9HE0UQ7kNvwFFJOBl&_nc_oc=AdmCRt1Z4j0EcExjGZS7IL-p9x7h5BfJHEaKTt4WLV3k-kEow7ZkAw8nLPWYB26P0yE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfssNiFzGi_eRSRui2w801tImNln9yfNihg9q73rwlwqcw&oe=69A440A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-CoverLandscape-2560x1440.png", "id": "492253277220424", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569421_492253280553757_5457198748604993976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr3sDUB0HYwQ7kNvwHyPEwX&_nc_oc=Adl03GcR8FgjjRGgCbk-ozxzOhJQ7DJqfeQUNl3-wA6ZiMzCZAhlwri80vn1GjkNylM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuzlxa_qjvol5JyeNmDBSLVrf3mjHhWcGP90aVSUlN7yA&oe=69A43DCF"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28584238771223150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003231_913749444281828_42325476791
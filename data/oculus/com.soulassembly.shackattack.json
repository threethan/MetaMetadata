"}, {"file_name": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEGTLtOf5nkQ7kNvwG99CEN&_nc_oc=Adr3kBCA3KKQoH7HxzV0CEj4b3q7toJVyp0lI_qVuzliZo_sfNbTKzIrPrxrQESrLXo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f_QQwAXs_j9xkprYIw_8p5zaIgk2eB7rnBd7tNPN9ZA&oe=6A369BD6"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhZzogUNmuUQ7kNvwHoJoJu&_nc_oc=Adozirhe2jMz7F4DyiS9X8NbuY2md8SmYsI9ZmLeU8gOvHOKLyM1VLq23bekpobfBSg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ltdwUxMUcvEq2936DRHCvHlTHGSwXtbXLLdXz2JlqaA&oe=6A36BA33"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGQqp9VRG7wQ7kNvwGnbeGE&_nc_oc=Adr4w6mt9VtIQMUaqR9z3KaMKR71c3rJS5w_JLzajh40sAowI-yteMsQ7QRHOt3SuLQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YA63vg00OtMfSBKC-qnXJtWbo5J6UyNGZvJmvZ9wiFQ&oe=6A36BCA3"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_0eciQ6pfsQ7kNvwEJARox&_nc_oc=AdrF4lILMDc18WRT8BefgDJamZ2ytOYU3W8tbkD738dMwmVKh4OH-BDmpGG9oYgejcc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FWRMgAUbXhc43tE5FVCUn7x0Kua3KAK3qImmi5D3SxQ&oe=6A369728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-A-2560x1440.png", "id": "893408993670981", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818885_893408997004314_1108771822119082208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWg4Gunk0NIQ7kNvwG1Yxf2&_nc_oc=AdqZS-CS-3QRu7rLMB14PKS1WYeoexa4WAPshDHdkdU15O_KvfnPgk9MXoAiY6xIxRg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yaRtNgtiYV5sTJVnJ40tqkRMa4ofwhln2DLnejexfbg&oe=6A3698A1"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34148410054805966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823366_1816447392644720_7150529406627719559_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFLPLaPFq9cQ7kNvwFMBIyE&_nc_oc=AdqjJzrWKn_-0AFS1-gyX09DXtFwugQ03w7QNNqqs0G3Bs3fUWJy7tiCSeDW4qZAEYw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dnlaxEabryC9x3jaqDsVyYVQLIwjNc5XcQhaf6zSAaw&oe=6A369540"}, "is_
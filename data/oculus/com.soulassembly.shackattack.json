077487730238632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBQ6vrs4I9cQ7kNvwFe7WLc&_nc_oc=Adns5e_rOx52jiY3orJUqJcBi8tIdEMhmFHJv09M-nlX7fF90OMVDRbk_SLzCCDSKCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzvy62Z2bpgSEWti4943mcdf3L3-nRXqcPVW6mP1Y6csw&oe=69B568D6"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrXiZQgsHCwQ7kNvwH98YUs&_nc_oc=AdmrBDE7p_2iya_a1tg3594yYWhR3H38MK3Ee51bzP923TEUqvIhQnufhosvnrgm-eI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJMLDAx4H8LQwhrymlCdT7VaGXJ380FcotISi2x3xG4g&oe=69B54EF3"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQOFzoodxMAQ7kNvwHQkjp7&_nc_oc=AdlCtMYrlQpaTpxLESNUOPj43LfzqL9kMwZMzGfue2LzLDggI3YFwOpbo_6t8Jfaqps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzW-0TzaFVQlGE8kQ287631bbGXDU_rcJ3lo5zEA_oprA&oe=69B55163"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Sy3Rdfxz_AQ7kNvwHV6JCm&_nc_oc=AdnZw0cTVJuUlQPqvZ0UxKCwRt_BDSNRckrb5I_KixXILnCMzc5oueqrmYd8MOMotNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfygdI62VUO0vdMgQ1ivRmeVPCuO4sq7RXQg10NjbG5gzQ&oe=69B56428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-CoverLandscape-2560x1440.png", "id": "492253277220424", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569421_492253280553757_5457198748604993976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEIN8sXQY14Q7kNvwECtuCH&_nc_oc=Adkte9iLAUQDd1MOusWPXdhCJuqNdFSPnf4PEtspbFCBwqnpWmj7t-8Y8ghZjmwjuN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzntV0bucZWS1i3QxSEkASKZLCS-5D-uU70F1Daqj7Ztg&oe=69B5614F"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33897186963261611"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_890259400446784_4059278082877247523_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXyXRszzamsQ7kNvwEHq-ek&_nc_oc=AdkyLR21FZaMWssmrjyhQHTeNoo1gOPX1sM6yCogaVuNAUJ-P3lrtRCRJokSU9AlYl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0dwbWAErUL37pAIptYNx3Q3B3BJ59SyXWuT8CDaeFtg&oe=69B551AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
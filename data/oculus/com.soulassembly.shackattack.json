i": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031503_1083155753219989_8190336259835542925_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS6vnqrzJTgQ7kNvwFUCJWc&_nc_oc=AdrEtHHYWr7nh4fMA8iNiW8nkuIEmz4sYbH3H6ylaMJSiWZTziat_IqDCFrTqc73msU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSEe4Y4jwu3IFk6qIzdCJ65R3wa7_5El_iGGocV91N6w&oe=6B09ACA3"}, {"file_name": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7NjDh2MpAEQ7kNvwGjO_1c&_nc_oc=AdpMLpdC6tv0w1NxrRpniLUMQP9JzKdHsULYJq8kOM7xwk7DsCh9clTAVUfJnsjEhn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx351eiRZ1_j4ytpf0YHG-2EBCosPBzmvtDWmvskhYpg&oe=6B09C416"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gop4CmFHhsUQ7kNvwEd-BOz&_nc_oc=AdqmBxzyeQP4gCChyWoY8tlrJv9-nOgLJGUN8bL1RYu9VldwiR2zH1c9SuHk2bPYcoY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu9etWL49VI8V-6K7iJcUJA9m649BImsqDlsG4kRb0Fg&oe=6B09AA33"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU6MD3Km0_wQ7kNvwGMiZz7&_nc_oc=AdqX2Lz3-_9db2JA-tpxjLrIYOxlVDg6A8SslWsbNXzzlxI2tMfjpOUmujZlgWLBrAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxwaJvGyBSp3a-m-f5tEp3KY2lMzxWrjzXc9I8ZqO5eg&oe=6B09ACA3"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh2fcSva94UQ7kNvwE7FF6D&_nc_oc=AdoId-DhhBA3JlJS99dTidCHGZQqWwg4HgxRijcVtHFCal6kUPbDsop6goGC5CEd5-4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnmqBQfFNob05IsgP9oxDVqjeCs8jSviURJa96rjwvfg&oe=6B09BF68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-A-2560x1440.png", "id": "893408993670981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_893408997004314_1108771822119082208_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b5iLLFCZUUQ7kNvwFxpXMB&_nc_oc=AdpiwL3KS-UQxnRzcimi0Un-kPnC-GvCudJsEijKOmrgRIzkLvhPVBY5GEmvd9Fk8Ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ245q-BUAQYpVy6t1s9yJC4qwP_rjwGSN1IJVyN9WmDg&oe=6B09C0E1"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interac
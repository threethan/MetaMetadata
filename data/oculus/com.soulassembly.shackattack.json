ame": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a7aZi7DRxEQ7kNvwEr09B2&_nc_oc=Adq0ywJbu4Pw8zYf6KnnNoFTvLf5xBn5usTjJQQlOdmPsOFlPRZRJm1j_wiHi8cHlu0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjxweY87txxvfApGs7unqj5OAfPFxy94fsDcIJ8EXG8Q&oe=6A93FE16"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpJ1OrFCdLsQ7kNvwF_NqSu&_nc_oc=AdqEcaHZdF2n2JvdSMP-4tMidYGyKWDj5AepEfLOFC98XaDGcnwP-10heN2C0lRJ8OE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGTV_as0eUNftpBsA-DySKfZnKvVY-AZReSE_PxRk4EA&oe=6A941C73"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef5g9IbbShgQ7kNvwHbuwN7&_nc_oc=AdqM5HbjlWjC89d7hfKdmvKOyXUJGvRbUwWyCYc1ug9STiBIxP0Xo2HjjrZNtL7cW4o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQL_6xawP0LrQqOeaQtd8E3o0f5bJlw6rE332YfVMlEw&oe=6A941EE3"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAtPuMLnG2QQ7kNvwFuwd-x&_nc_oc=AdqDEOtZPy5SIhqz9QiaEjy-ammvBzLQ0axmHmUXZv1aWGW9R2303LNiO1Ae13Sb0T0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYGc-6FRTByNdGbmWNO9-uHi_2jJcI8fIXuJLA81ff9Q&oe=6A9431A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-A-2560x1440.png", "id": "893408993670981", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818885_893408997004314_1108771822119082208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y57jYrKH-akQ7kNvwGhBaYC&_nc_oc=Adrqe65O5f-JJokJiL-UDbMCWv8aGkNK6vgFQUxZ49MYq9UqAweTt4ALQA4mCcFCNbE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtNShlRg_LhxGD3e8LzFSFQbetC58BRuoJ82DM6YwUsA&oe=6A93FAE1"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34148410054805966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823366_1816447392644720_7150529406627719559_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dp85Y4lRD8Q7kNvwEFZ5q2&_nc_oc=Adqq2tM6lu8Wh4TIQMllSyWBLdCxcoF45DwmqrgoO_DJqhgT71cpTvPzIGB9mSDKNvc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG9dDsSYzVJRAbrhSKEVXQHYMQyY8COHoe1xCstiVJPA&oe=6A942FC0"}, "is_concept": fals
, "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031503_1083155753219989_8190336259835542925_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n52fl01nhGcQ7kNvwGuFsal&_nc_oc=AdkSgd6HHgF6WegZt9p9yRCUrTWiDnsyQC0ntVbV019P132ymUtoaJHaBI9ZhQnn8Y0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvayB7ryBNU5lqwyl1dhtpj5r-BgO5fpfSb4NELzcMKTg&oe=69A6D0E3"}, {"file_name": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O42RgzFi00Q7kNvwF8iPlH&_nc_oc=AdlKm8wPO3fAK8H8AeiQvo_vgMMbFTJqs4lhPGfkoUVOcvYj-dUW_old-yyseRN-nnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfslC6CYG3MFa-ssxUwMB5rMSz2kraBMNuhgABLtuvnEsg&oe=69A6E856"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqMAEzMZzXwQ7kNvwG3ecBX&_nc_oc=AdktFRItZZq43Iks1MdB8tYiDIQ1XwlAPQlSuvf2841F2e_-ayfUujrrMck3i9-DU1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAuYCdRnsxiy8bLlSZOt0TAg1oJXGR1KnN25HnfGDKow&oe=69A6CE73"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq-dMgOqHxIQ7kNvwFnt_GC&_nc_oc=Adk_iGbaayuM1ULEXFn-3U6-Nh1OPozlbpyiqzcDBm9pJwckGu9VCorXz3kJ4Rk65rU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfssMYHMBzsM3o4PtqwSy6SWGFG6ReqAgx038q9j_H4P5A&oe=69A6D0E3"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiDq5Eeg-ysQ7kNvwGb-DXz&_nc_oc=Adm1XfXyJWSAS6pWTJc8vXav89_DjZcak3y2yMvdB8q-GVYEXdCOhHjQlwP3EfQNO_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftggV4I-GZ4KZGM7SskAAkhohcKYv4Y0z6Z9ZbsfkYY2A&oe=69A6E3A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-CoverLandscape-2560x1440.png", "id": "492253277220424", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569421_492253280553757_5457198748604993976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7Jq8cltIS8Q7kNvwHThCg6&_nc_oc=Adkmz6Cwu8U4W8xKamO0hmQPmc9fe85EWMKtV2Ji8WBFdXN3XpgC9HXoPPIMFSs1NPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuwfqDYJQkIl_oUpkllHu9tyu8pJfN-VLfOKPTI2wcfqQ&oe=69A6E0CF"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28584238771223150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003231_913749444281828_42325476791
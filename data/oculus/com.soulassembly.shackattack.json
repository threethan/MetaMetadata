i": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031503_1083155753219989_8190336259835542925_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90NJsyCk5EgQ7kNvwF6jMAZ&_nc_oc=AdouKmXbWCC9fgQOYdFauqvJ1_HFqQfxl2fVkA7BshAWkIkfvMw1ui8DPGF3lcksBAM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_SC4UpelIqMh4Z67KfWfy9v-J1AawMmErdtR5rVB3KA&oe=6B085B23"}, {"file_name": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0hNUL_hesEQ7kNvwH7OpjZ&_nc_oc=AdodQZg821Xg8gCHiZiyDRQKoJkJAzRdKmMDyH2w1e5gK1watzgtVLWbzzc850-1gJA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlbFsy2M1fObG6E-v0HqiAkvihYR_dMAy60BTww3qoYA&oe=6B087296"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gop4CmFHhsUQ7kNvwGanxWa&_nc_oc=Ado63uokhe8HSZHt9tkwPOUd8b3IblIK8-TmLmVKRSNK8FTgD61HEq8tSR7FZ4GNpGE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlTYouIl1OgfxWDGmswVBFnwBqZWY7CDN9CYvgKdsf4w&oe=6B0858B3"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU6MD3Km0_wQ7kNvwG3XtYc&_nc_oc=AdpUk53KMTn0Mb0-FWVUy7vScuQN0-1AQ2lUgr00ryZkq1NqFdwu3Obi6TViC68yjyQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTb7aAbwB3lXiLRelS2aXUVUMJhAKRI2kwoH0xfE976w&oe=6B085B23"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh2fcSva94UQ7kNvwFd0DyB&_nc_oc=AdqCsDJ3pvt1tIzxZfi8Ze9WPPUiymSFtDxsgkrlm8QBuFb9XzAgEWCaNKLQMxgUx2U&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxNflXd4ApqHTNJOckcXiFpU7YlAKyaMVwSvSOYLnHBQ&oe=6B086DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-A-2560x1440.png", "id": "893408993670981", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818885_893408997004314_1108771822119082208_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b5iLLFCZUUQ7kNvwH7G-fv&_nc_oc=AdrCy7iVyykjmQjf1LdphTv3GwavAH-eMfYsUZbuDh7DeWigcUWJrCXmAkloEC_h2qE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpVixeVxw4zKNGmiL7BwIid54lLO3iPJ6pzsDQheslpg&oe=6B086F61"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interac
, "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031503_1083155753219989_8190336259835542925_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Mm23rBZnuAQ7kNvwFN4teX&_nc_oc=AdknEtePtr6VKACXeB1WGBfbU65ogADVpBxelqzYPLUwoR-p8jJUcR-XxHIEJB-wvKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv09U-0EvqxYQYttBf6W8LnW-1-CEuRVkpkM2Zd-DUgyQ&oe=699AF363"}, {"file_name": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM8PG5VXRAIQ7kNvwGLirWR&_nc_oc=AdkeEkLFyN_eR2ZasDLGywR_MsuYXJhRbeB9h5ninJPzHd6zlHo2VzgWX5e3mYszELs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftR0pRFdSF9tC6CAUb6dNq811qHR846eRC3ZwM-JkLZ6w&oe=699B0AD6"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5VCGMlavDUQ7kNvwHGmUWH&_nc_oc=Adlx_lcmi4Ez3ofBdrmsDCr64JmdcMU11kmLl1ltU_p4wybbKnY_w93l-b9lWEPXRfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftCyAFtAMNgIoG_QZoFopNyr37P49Ray3pgE9bB9weZTg&oe=699AF0F3"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8vAkr22oncQ7kNvwHuZDz5&_nc_oc=Adlwbu6AkWFaPiE97T7osDW5b-lSdJ-SJoqV4-cuIr6UJ_hz5q2lhE7_DDZW7EMjj1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuLRpgVyKB_G2jkfEzdsXCdczBDJbnF7ULeOt0p3wZXcw&oe=699AF363"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98iBGLcYcOwQ7kNvwE4gLLs&_nc_oc=AdmH3WyJRjGha33KKMuQCVRDXd6ZLKbj_mXmq7fbUy1s47PVm1EO7YzlcaJ92iiSmqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvEkPrapHmpgkWBZrGcqTLsFUYZdkAl4IksMoJmG4cmnQ&oe=699B0628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-CoverLandscape-2560x1440.png", "id": "492253277220424", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569421_492253280553757_5457198748604993976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_PQWJf0I8gQ7kNvwHTnX2r&_nc_oc=AdnZB-mCUqkJH1s60lbkuOBt8QGM00lN0MCO64K_IRFG4ZBNhvMTJBxABdsXaNETKnc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvpEMK0wPV_EUJ5lFD9_1to-vbWikewSwK3iFE5JySH4w&oe=699B034F"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28584238771223150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828028_912064138137963_6066961762
ame": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRDBmmKnQO4Q7kNvwHUrY9I&_nc_oc=Adqa9ln1rTRSklioOepDSI8QjwjSITuTUB3oqtxPB5p1wg-gZ90VoFZ8T7aTEQEkCww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dPWJqOW9PRyo00xCK3MG54kjBmv4D0wwDUM3E6a9lhQ&oe=6A451C56"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CQ7qKGe728Q7kNvwEL5AH4&_nc_oc=Adq4dhifBIcv-NpP3YJbB-8TvlwDg75QH-tuS_54EtWAsdmPn_ipacZ_w60xvTJLLvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eDbNn3lD4kIR5ZxluAlWQhvl7OKraYvbKsNFgFodXHg&oe=6A450273"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo5Q0gS9LngQ7kNvwG1p81P&_nc_oc=AdqIdDfbnemeHeSdYbYgfiDvfeglnGHsaX3ZUFCMGCn46m5FRVEOe3133C8dIArcEZk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A0S_lKtnznZMMdRdwAXcsqsyVTGHpZpBQDSKUASnFWQ&oe=6A4504E3"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG53lV_uzCkQ7kNvwG-mMkU&_nc_oc=AdpSiVLBBNcpF-Aq51j6M9K_EBiTcKRM2PL9OgTzycF9HdbYbLOanNlsIF2MD2ah4qY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yFQV1iskyAtNiSWzNiv637Ko0qdEq4epX928ta0laNw&oe=6A4517A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-A-2560x1440.png", "id": "893408993670981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_893408997004314_1108771822119082208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXab_GEyhjEQ7kNvwHTSloZ&_nc_oc=AdpkElQTPo0_gSX6XvVuUF-rZ71fZ_iWiALPj12x04meeQXi6Do6ftRFXgMFN-NP8-c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tmqdqsG86Ra_Em4OnQGXYzpHyS_XuDfczT4k69nifaw&oe=6A451921"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34148410054805966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1816447392644720_7150529406627719559_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ebgUlTUCbMQ7kNvwH-iFT2&_nc_oc=Adpvo1254A_-WmLCkzDY5eKPyydMZZdr8aDfmyLrxoMSz2HSCK1FvFWP6jO1q3kKk4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dq8DSs3HnDPykz00vMz5CXw3gVBoPKpI0b-Kg4bxAWA&oe=6A4515C0"}, "is_concept": fals
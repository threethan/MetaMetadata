bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMOLcSRKhwwQ7kNvwEZpcyo&_nc_oc=Adoilf1GxLqit1b_vJi8cwe6YnwW9VAiuuRlbSHehK1RWjEQWjQlytcZyuUGa03Az7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStXPg8fa__WFiFm1ZrL0DnoLAoi6mn-1RNUgdiR8CqIw&oe=6B0DCBB5"}, {"file_name": "SA-LS-Launch-Meta-Screenshot-2560x1440-B.png", "id": "518199367649623", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035315_518199370982956_3030587656090885372_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sps0JMqe4kQ7kNvwHL8WUT&_nc_oc=Adp1_cskQMlb2GUbOD1vufTe7WC6uYX32hBCS-AXNHE8YXFWuKqMtUz8wWRlbVuAV6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2kJhFMMqc6UMuKaJIv8TC1OzRd47jgNlSV2lr2MEhWw&oe=6B0DB2CD"}, {"file_name": "SA-LS-Launch-Meta-Screenshot-2560x1440-C.png", "id": "905966224922640", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974900_905966228255973_5130841505886610815_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K2bAGSNiWcQ7kNvwHwyIa1&_nc_oc=AdoYOD1o2OWslN6jyiwUIV7rCP5PCQwElLZcv5xfSRAM4T6qthwEF9-r6GAuLUAIdxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1k7-FHMz5lsvZS-g-DIefn352KQ0j8wWo6p4IxG1ATA&oe=6B0DB98B"}, {"file_name": "SA-LS-Launch-Meta-Screenshot-2560x1440-G.png", "id": "523141100328151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031339_523141106994817_8586809118821300384_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmfBc24r5ikQ7kNvwHlID0q&_nc_oc=Adryg5LxY3676Owyi7-_bvYCCQG-GWZzZ7C_FX1n9yGQQ-tIhtVUcsP2EvE7zQ72cUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkn4JPbcrEjNktdGaVHjmRph1v6cLKHbYqp_dS6anEnQ&oe=6B0D9A35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-VideoCover-2560x1440.png", "id": "8770630689667401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_8770630713000732_6259191283680804636_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=710kig7T3IUQ7kNvwF1IEio&_nc_oc=AdqGNzRSYBYFLX567P-yk7xQ3eNljkpHvAtTlKUmHbvroQPY__qtpZkYxX2keoVr6qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQ8NZgfza6ST_ykMPupuzuDXS94JITzM9eTxa1HeYeEA&oe=6B0DABE8"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "Step into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Step into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24613461644967569"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "909567998150113"}, {"status": "PUBLISHED", "id": "1195544885542474"}, {"status": "PUBLISHED", "id": "1429281444835511"}, {"status": "PUBLISHED", "id": "679103431204316"}, {"status": "PUBLISHED", "id": "2299860073742508"}, {"status": "PUBLISHED", "id": "645951388432386"}, {"status": "PUBLISHED", "id": "3463172840658181"}, {"status": "PUBLISHED", "id": "1145005583725333"}, {"status": "PUBLISHED", "id": "560892123222944"}, {"status": "PUBLISHED", "id": "563960119563944"}, {"status": "PUBLISHED", "id": "8495327620588762"}, {"status": "PUBLISHED", "id": "1235565814217464"}]}, "ba
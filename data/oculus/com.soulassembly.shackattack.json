VYQ&oe=69C7B8B5"}, {"file_name": "SA-LS-Launch-Meta-Screenshot-2560x1440-B.png", "id": "518199367649623", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035315_518199370982956_3030587656090885372_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRu96vM71tUQ7kNvwHg2YuV&_nc_oc=Adq6BvQnEtLkGnyxgJb8Lw6QmeqWjPvrjU5tmUZbeGQIo9h9ndyXRGrsj1yCZkTgV5g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMfOqbjroG54NJZkl5qlaQQw60G-gwv7lSDJkqR8vP9A&oe=69C7D80D"}, {"file_name": "SA-LS-Launch-Meta-Screenshot-2560x1440-C.png", "id": "905966224922640", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974900_905966228255973_5130841505886610815_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-qX2Z4T5VoQ7kNvwHYgE7J&_nc_oc=AdrpjrXfVP2B5xDLavFdN05okOm4es1ydWR69VLceaA68RV5jIZpcgKa34uMYgo9QD4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMbmX14tuWDkiTTU2pVB5A4CM_QV0YgoBSjXiij8pEgQ&oe=69C7DECB"}, {"file_name": "SA-LS-Launch-Meta-Screenshot-2560x1440-G.png", "id": "523141100328151", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031339_523141106994817_8586809118821300384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td195l11UNkQ7kNvwF6y_Ob&_nc_oc=Adr5pnKt7ItXxNY0wZc7Nuta3mtE6-u1wFWHpfGcFKa3YEkdBNfRwSdTLvI2bEQKY_E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_88VE1Lir2vjuCm5cfzCbtn5Qhxp2OFN-Tha8fw0Lvw&oe=69C7BF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-VideoCover-2560x1440.png", "id": "8770630689667401", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982555_8770630713000732_6259191283680804636_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=3foEUDiA6IsQ7kNvwFIrpTb&_nc_oc=AdpeuumGaXg0iyh1Ze0AbUNmSd6Q66er5QnuG7CTRAs2V-LoFBkruG5tY03RvWCOQoY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrjhObUKB2WVv7QihXNdMLGa7l0KzOUdrtck66XIALjA&oe=69C7D128"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "Step into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Step into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "
ame": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJDyJRHnRygQ7kNvwGun59H&_nc_oc=AdrsLCmpL5wggEnWtdmZm5rQ8leK-wMSyhcClqVpegIhw3DETYF-oGyo93cG-ipgEM8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfx6Rq4tT2Ccb1GbpWqIwRf196jPE9w2euqUCGpQdnZA&oe=6A8312D6"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXWWZqaHrgYQ7kNvwEfEUcg&_nc_oc=Adp9mHYm2YcXfxnLi2pL4EbLNcnyTyXxfJTLbfZ5scY4VVRqwLSSBWB8VaGHvTLvERk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqXhmGKwb71XZ29DDkaP-DpGeNGxt4gfEMkSmmYTuHew&oe=6A82F8F3"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ8FIpV3PJIQ7kNvwHpbPc0&_nc_oc=AdoIu-zMQzrVmlgmLG5RIUsIPrND9R7HkSB2k_YbYkn9YcLvWTwSAEjm4R_ihNw1hy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGexfborhPZ4-gFiwvUHLoMWvgYd6eb6GT5E841euktw&oe=6A82FB63"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPamG3JLaS0Q7kNvwElSR_V&_nc_oc=AdolINOP5T6z3gk9q_1aGvB3SnmhckEKDr0VaohgfigjgfvGi82lT-N2VyJmBcxQ19A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSBqNrmRHSJKwvg-D_vyRbMemMfv4BYXJ0Ttt3ohbeFw&oe=6A830E28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-A-2560x1440.png", "id": "893408993670981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_893408997004314_1108771822119082208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq0fPSBj63EQ7kNvwFpGvgY&_nc_oc=AdqIsMHt_MncHePvF0L0Hy_I5GyBzloJLRHKF1thg09S1GXGezOsF8y3Uo98KoQ1CR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsxT0plJhR_dArGezqaRPyM2MxZvrJSpPnJz1LWh_3Rg&oe=6A830FA1"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34148410054805966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1816447392644720_7150529406627719559_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKd_akhiEMoQ7kNvwEjPUyk&_nc_oc=AdoCGscDwIbI7ydqg_qmuZEuPG8-BD-K5Id9uBCs9B250v0IuaAcnSaqN_rR3im3ghw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhnKxQBGAuo94WnMbiat7mEZMxZGB2-qWjqgnNkrJEBQ&oe=6A830C40"}, "is_concept": fals
, "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031503_1083155753219989_8190336259835542925_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMWCn95EUtkQ7kNvwHiNBO2&_nc_oc=AdnxWZx8zduVHyNyRW5C3v3bsbXR9dU92iltN4AlAMd4F3LZPupJ92jvt9KMLrYtkQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvqyKnpf_R2aM_Z2FBbG6RWKowvkEzOY86pFRFpdabgHQ&oe=69985063"}, {"file_name": "image (15).png", "id": "1077487730238632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031362_1077487733571965_6364630121927163930_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1etdThQQRIQ7kNvwFv_vHk&_nc_oc=AdkyhL5U-LqebFV0tAnT4D3riW7jquyNZxbd4mKge0_sFr0C2XoOCp2HIzcqw8BXxDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuS22pK2h0EOuI3JWhMOhAUT1PwDAqMfEd2oW5-OkM49w&oe=699867D6"}, {"file_name": "image (16).png", "id": "1080548026849616", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982555_1080548030182949_8157035036598259185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5VCGMlavDUQ7kNvwETFaMc&_nc_oc=AdnSMb1OSCNhZ2FeeMFCDtPXwplsoQt8thbK5neTbS7FqZAdQaG2zOXw-MbF8tRb3Ag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftuuuNNJX8etimO3uy-xEFxAao_86tH7c-KN1ouLKYOlg&oe=69984DF3"}, {"file_name": "image (18).png", "id": "785975770302690", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031490_785975773636023_5774077651952433056_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8vAkr22oncQ7kNvwEAf_hF&_nc_oc=AdkXErFhymC-SPube3CYbW2eB4OBqxOdFwQZS9861Y61B9IGi7QmJuNOL507GoAFXV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsh7zO8gB_W-3k19dhlO3JvEvsISdAnXfWsgpyNX8oUag&oe=69985063"}, {"file_name": "image (17).png", "id": "28478207675111592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003244_28478207685111591_905859814148920282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfoH5ym7VbsQ7kNvwEGYz7e&_nc_oc=Adn-DjI-FP5YOT7S3pakW43YKzLb49tCiqNrPheSeXa3NiiYFI83kH6FEJiJGddkupY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu86fQ-KDfCYmgCmv_NOrpcBx4DttbqWIZGdSTJt14G9A&oe=69986328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SA-LS-Meta-CoverLandscape-2560x1440.png", "id": "492253277220424", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569421_492253280553757_5457198748604993976_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thXzOHP5Tm8Q7kNvwGqurPf&_nc_oc=Adng4hEALurMO0_CoNWLHbFopbt-SkNCiD6hKMt-UAhqxdL1OEJgp0oq_XHkVwJ-C3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuuBr4r7vLL7A3FWoQMSlKwqu8kPaK17jzNT1LHf4fm8w&oe=6998604F"}, "display_name": "Last Stand", "keywords": ["pvp", "shoot", "horror", "action", "duel"], "long_description": "**Get Last Stand now for a special introductory early access price\u2014available for a limited time only!**\n\nThis is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully immersive combat zone.\n\n{1067517198339345}\n\n**1v1 Mixed Reality PvP Combat**\n\nBattle opponents from anywhere\u2014each player fights from their own home. Turn your living room into a battlefield, outsmarting rivals with real-world strategy.\n\n{1232934048025689}\n\n**Precision Full-Body Tracking**\n\nDodge bullets like in The Matrix or land headshots like John Wick! Our full-body tracking ensures every movement feels accurate and responsive, immersing you deeply in the action.\n\n{428700763582659}\n\n**Your Room, Your Advantage**\n\nTransform your living room from a Netflix haven into a tactical stronghold. Your couch becomes a fortress; your table, a shield. Outsmart and outmaneuver\u2014your home is part of the fight!\n\n{1127967098666563}\n\n**Cinematic Shootouts at Home**\n\nExperience intense gunfights and explosive combat, with dynamic destruction shaping every encounter. With dynamic destruction, every round is as intense as a blockbuster.\n\n{556217970668528}\n\n**Play Solo**\n\nTake on the Horde Solo in our brand new single player experience.\n\n**Last Stand is an early access title pushing the boundaries of mixed reality. Join our community on Discord to share feedback and help us shape the future of the game.**\n\nVisit **LastStandXR.com** to learn more and join the discord.", "short_description": "Get Last Stand now for a special introductory early access price\u2014available for a limited time only!\n\nStep into the future of mixed reality with Last Stand, from the makers of Drop Dead: The Cabin. This is the world\u2019s first multi-location mixed reality PvP shootout. Your living room becomes a battlefield as you eliminate your opponent while fending off a relentless zombie invasion. Move, dodge, and take cover in a fully interactive, immersive combat zone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soulassembly.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Soul Assembly", "support_website_url": "https://Laststandxr.com/", "website_url": "https://Laststandxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28584238771223150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_912064138137963_6066961762
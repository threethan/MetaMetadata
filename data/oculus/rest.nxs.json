_sid=6e7a0a&_nc_ohc=Mj1x_cHrp0cQ7kNvwGnwmQl&_nc_oc=AdqkiJ92SCcOP9ItBdNcLK8zqt_Tg1oErRia6LuFxjpuMgP30rt1nt1HLbyF5i7xpkM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORM02rLiZNkSHl8Mtp552xBPSGygBqjDr3c-BO_G3bHg&oe=6AC7BD7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Parano!a", "keywords": ["osc", "paranoia", "chatbox", "vrc", "design"], "long_description": "Parano!a brings a clean, Quest-friendly VRChat chatbox controller directly into VR. The app lets you create and send custom OSC chatbox messages, use live placeholders like time, date, battery, RAM, max RAM, ping, uptime, and AFK time, and rotate between multiple saved messages automatically.\nYou can enable or disable individual features, choose which messages are included in rotation, create a dedicated AFK message with an AFK timer, and customize the look of the app with built-in themes or your own custom colors.\nParano!a also includes local settings saving and optional settings sharing, so users can upload selected settings, receive a 6-digit code, and import shared settings later. Spotify media support exists in the app code but is currently hidden from the main sidebar.\nDesigned for Meta Quest 3 and Quest 3S, the interface is large, dark, minimal, and easy to use in VR.", "short_description": "Parano!a is a native Quest app for VRChat users that sends customizable OSC chatbox messages with live placeholders, message rotation, AFK mode, themes, and easy settings sharing."}]}, "developer_name": "Paranoia Development", "developer_privacy_policy_url": "https://paranoia.help/legal/privacy", "developer_terms_of_service_url": "https://paranoia.help/legal/tos", "publisher_name": "Paranoia, Inc.", "support_website_url": "https://paranoia.help/", "website_url": "https://paranoia.help/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id"
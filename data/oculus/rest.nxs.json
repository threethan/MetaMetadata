91823812_1308572994408758_783258319779777277_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl58dT-QyKMQ7kNvwF3vZn2&_nc_oc=AdqPr4yNvEYWpQm_sP82soqTy_5T7wNtDZsB_pUkstYsc6Z_jZLljwZ8Zzcfl44ZQXI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTG5rY0L99YeYMyj6NMdep3azu0HquNU4dbHwKTsdikw&oe=6AC7CAE4"}, {"file_name": "03-format.png", "id": "1023743930129826", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825257_1023743933463159_7004948658204618246_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVcOUhpxfHkQ7kNvwFK-AUu&_nc_oc=AdqYNv5Zd2KB48c0FjALxh-MgnGiUrw-aVOdD4j89rIo-iB6kBeS6oBzX68EbmG2da8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB6Kq29JSbjKCbu0T4sBxWo86Y5pyny0GvNBQpNxUJ0w&oe=6AC7AC64"}, {"file_name": "04-afk.png", "id": "1025381323219400", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823279_1025381326552733_1730069339802175330_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr18KYjwjp4Q7kNvwEUEmVI&_nc_oc=AdouknoJKWvfHZAexcUMPSxjwl6_hAq8aCYOkwiSZeL8iZ0Xwn7fsYtuioDkPG30VHs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX2y7RPWfjKm9Q93C6OOP0dzNFIkWvvA_8ogrwFjXAgw&oe=6AC7AA45"}, {"file_name": "05-settings.png", "id": "1266067642099467", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825257_1266067645432800_9189213010414126676_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mj1x_cHrp0cQ7kNvwGnwmQl&_nc_oc=AdqkiJ92SCcOP9ItBdNcLK8zqt_Tg1oErRia6LuFxjpuMgP30rt1nt1HLbyF5i7xpkM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORM02rLiZNkSHl8Mtp552xBPSGygBqjDr3c-BO_G3bHg&oe=6AC7BD7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Parano!a", "keywords": ["osc", "paranoia", "chatbox", "vrc", "design"], "long_description": "Parano!a brings a clean, Quest-friendly VRChat chatbox controller directly into VR. The app lets you create and send custom OSC chatbox messages, use live placeholders like time, date, battery, RAM, max RAM, ping, uptime, and AFK time, and rotate between multiple saved messages automatically.\nYou can enable or disable individual features, choose which messages are included in rotation, create a dedicated AFK message with an AFK timer, and customize the look of the app with built-in themes or your own custom colors.\nParano!a also includes local settings saving and optional settings sharing, so users can upload selected settings, receive a 6-digit code, and import shared settings later. Spotify media support exists in the app code but is currently hidden from the main sidebar.\nDesigned for Meta Quest 3 and Quest 3S, the interface is large, dark, minimal, and easy to use in VR.", "short_description": "Parano!a is a native Quest app for VRChat users that sends customizable OSC chatbox messages with live placeholders, message rotation, AFK mode, themes, and easy settings sharing."}, {"images": {"nodes": []}, "id": "971573855249983", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia Quest", "keywords": ["paranoia", "osc", "vrchat", "vrc", "chatbox"], "long_description": "Parano!a bringt eine \u00fcbersichtliche, Quest-freundliche VRChat-Chatbox-Steuerung direkt auf deine Meta Quest. Du kannst eigene OSC-Chatbox-Nachrichten erstellen, sofort senden oder automatisch rotieren lassen.\nDie App unterst\u00fctzt praktische Platzhalter wie Uhrzeit, Datum, Akku, RAM, Max-RAM, Ping, Uptime und AFK-Zeit. Einzelne Features und Nachrichten k\u00f6nnen aktiviert oder deaktiviert werden, sodass nur das angezeigt wird, was du wirklich nutzen m\u00f6chtest.\nZus\u00e4tzlich gibt es einen eigenen AFK-Bereich mit AFK-Nachricht, AFK-Timer und automatischem AFK-Modus. Das Design kann \u00fcber verschiedene Themes angepasst werden, inklusive eigener Custom-Farben.\nDeine Einstellungen werden lokal gespeichert. Optional kannst du ausgew\u00e4hlte Settings hochladen, einen 6-stelligen Code erhalten und Settings sp\u00e4ter \u00fcber diesen Code wieder importieren.\nDie App ist f\u00fcr Meta Quest 3 und Quest 3S optimiert und setzt auf ein dunkles, klares und gro\u00dfes Interface, das in VR einfach zu bedienen ist.", "short_description": "Parano!a ist eine native Quest-App f\u00fcr VRChat, mit der du anpassbare OSC-Chatbox-Nachrichten mit Platzhaltern, Rotation, AFK-Modus, Themes und Settings-Sharing direkt in VR nutzen kannst."}]}, "developer_name": "Paranoia Development", "developer_privacy_policy_url": "https://paranoia.help/legal/privacy", "developer_terms_of_service_url": "https://paranoia.help/legal/tos", "publisher_name": "Paranoia, Inc.", "support_website_url": "https://paranoia.help/", "website_url": "https://paranoia.help/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1299231049945140"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823790_1698788127951898_6945003933976346583_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkOF4fKbq6kQ7kNvwGE4J-I&_nc_oc=Adqv_fiJyBOPDseTgiPpaqy4_fxyWDh_hRFOVgRfA-GGiTarAcJMMYn6DNpM1ffQng0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3vZGIKaFAhdexZZjQU-37cxFvu3y8fQMv-qtd9sqvUw&oe=6AC7A4AA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Parano!a", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1784228700, "lastRevision": {"nodes": [{"id": "1148546345013612", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1148546311680282", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2518486731956225"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2147156669175821", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paranoia Quest", "keywords": ["paranoia", "osc", "vrchat", "vrc", "chatbox"], "long_description": "Parano!a bringt eine \u00fcbersichtliche, Quest-freundliche VRChat-Chatbox-Steuerung direkt auf deine Meta Quest. Du kannst eigene OSC-Chatbox-Nachrichten erstellen, sofort senden oder automatisch rotieren lassen.\nDie App unterst\u00fctzt praktische Platzhalter wie Uhrzeit, Datum, Akku, RAM, Max-RAM, Ping, Uptime und AFK-Zeit. Einzelne Features und Nachrichten k\u00f6nnen aktiviert oder deaktiviert werden, sodass nur das angezeigt wird, was du wirklich nutzen m\u00f6chtest.\nZus\u00e4tzlich gibt es einen eigenen AFK-Bereich mit AFK-Nachricht, AFK-Timer und automatischem AFK-Modus. Das Design kann \u00fcber verschiedene Themes angepasst werden, inklusive eigener Custom-Farben.\nDeine Einstellungen werden lokal gespeichert. Optional kannst du ausgew\u00e4hlte Settings hochladen, einen 6-stelligen Code erhalten und Settings sp\u00e4ter \u00fcber diesen Code wieder importieren.\nDie App ist f\u00fcr Meta Quest 3 und Quest 3S optimiert und setzt auf ein dunkles, klares und gro\u00dfes Interface, das in VR einfach zu bedienen ist.", "short_description": "Parano!a ist eine native Quest-App f\u00fcr VRChat, mit der du anpassbare OSC-Chatbox-Nachrichten mit Platzhaltern, Rotation, AFK-Modus, Themes und Settings-Sharing direkt in VR nutzen kannst."}, {"images": {"nodes": [{"file_name": "logo.png", "id": "2676799786051048", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823949_2676799789384381_1734866370915923393_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfYdU1n5yrYQ7kNvwE4c3Si&_nc_oc=Adp2PxfeFzRkyZ3crvjoCoPaXlnvYhfrdWjrBEaWhvNxWpLrr4Or1eRP73MKkWtzxSM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZF1KiRhoBB-2WLzVnxD-A0g86tZ-E4wrOzmN4YhaoPQ&oe=6AC7CEE2"}, {"file_name": "Unbenannt.png", "id": "2263594214457867", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823949_2263594217791200_4214449150645882632_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NS2DLljbjQ4Q7kNvwGsL-1j&_nc_oc=Adp0IRQ0R-6XjALXbvw0Dtuh-l_yk__r-N0KJUSHjUjM2RN7XsbEDnf9XsfxDbJJD0I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQX3H8ZyE_p8lTgvu4CdkKrCUhykEcxEKkNO2HVtK_5A&oe=6AC79E3D"}, {"file_name": "paranoia_hero.png", "id": "1938947916808967", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825345_1938947920142300_5815390015146545013_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grVImKkHudEQ7kNvwEpbZym&_nc_oc=AdrT4H-q3L0y0oIJ8vmQwTIAdT50MOnzpQAz68CYjNMOv-GKvQHHDvuo5-R72R-Ekag&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYVg6KXYmxNKDsqpCn_I0YnbRiahUyWCRLofMzNgSsYQ&oe=6AC79F68"}, {"file_name": "main_banner.png", "id": "1778991909752168", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_1778991913085501_1567416350107914796_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYVL6_X0bw0Q7kNvwErMudy&_nc_oc=AdqrxnUgJLu1hCPy6iOX38X9fpKdVN2glMhKBbwLnUzjwynxbgCZStjAbIvN-f7q1Y8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Os
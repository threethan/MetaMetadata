046_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TcQLzQ6lT8Q7kNvwEvNpiL&_nc_oc=AdpRlY86uBiWXzw_PwQVEXXrb7eav_MLksj4U1H3HyZTYtDsgud9jkrnMmHu1Mar0lE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcL0XBTY3aM257yg_civjaU-dH5he7MY3ixOYwSRKmbA&oe=6B0DB159"}, {"file_name": "AprilsVRLab_2 Kopie.png", "id": "1607663863958695", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307444_1607663870625361_2771889752545003438_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aav8p7DDbkQQ7kNvwHPjqKI&_nc_oc=AdqmVPKRC71KO9foEqhR-T3WyHNXviSiRM_mcCShk7FZPXnvAxv4K1tCHu7zPTTBx94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgdO0f2eGOuEb5sR-T_lOLBldOtgTpDrzlISMlhdnBFA&oe=6B0DCB57"}, {"file_name": "AprilsVRLab_0 Kopie.png", "id": "1778435043233896", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303976_1778435046567229_7006662329076017919_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IohzHkAm9RAQ7kNvwFra117&_nc_oc=AdqW9lzKyp7R8Rd04zM0Tw93KEeWkjU4BdOxNukuJhYJeim7YQLk0v6LEyeVn0O2HT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWe8Q1Z-PgrMdj8GaKTxGhAc-zkPXJM7AkqZk1Z23Ctw&oe=6B0DA136"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "April's VR Lab", "keywords": [], "long_description": "This experience has been developed in the context of the XR for Value Creation in Businesses course delivered through ETH Zurich, ETH Heilbronn, TUM and TUM Campus Heilbronn, first taught in fall 2026. This experience has been funded by the ETH Campus Heilbronn / Dieter Schwarz Stiftung.\n\n# Using the app\n\n1. Sit down and ensure you have sufficient space around you to move your hands freely before putting on the headset and picking up the controllers.\n2. Open the April's VR Lab app in the App Library.\n3.  You can activate buttons by looking at them for a moment. You will also need the controllers to interact for some sections in the app.\n4. During the opening scene you will be asked to opt in to share anonymous usage data. This is optional but I encourage you to opt in to help improve virtual teaching at ETH Zurich and TUM.\n5. A tutorial will then guide you through the experience. The whole experience will take 10-15 minutes.\n6. You can pause the experience at any stage by selecting the pause button or taking off the headset. Please take off your headset immediately if you feel nauseous.\n\n# Troubleshooting\n\n* If you don't see the app on your headset, check that the headset is connected to the internet and that the account you used to accept the invitation is the same as the account on your headset. Then check the \"Not installed\" filter in the App Library, or restart the headset.", "short_description": "This experience has been developed in the context of the XR for Value Creation in Businesses course delivered through ETH Zurich, ETH Heilbronn, TUM and TUM Campus Heilbronn, first taught in fall 2026. This experience has been funded by the ETH Campus Heilbronn / Dieter Schwarz Stiftung."}]}, "developer_name": "Media&Methods Lab", "developer_privacy_policy_url": "https://www.mediamethodslab.ethz.ch/vrteaching/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Media&Methods Lab", "support_website_url": null, "website_url": "https://www.mediamethodslab.ethz.ch/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_
uco Safari, Marco das Tr\u00eas Fontreiras, Bird Park, Po\u00e7o Preto Trail.", "short_description": "This app shows the attractions of the tourist destination of Foz do Igua\u00e7u, in Brazil, through an exclusive and innovative experience.\n\nThe user begins the experience with the illustrated map of the tri-border region of Brazil, Paraguay and Argentina. On the map the user has the option to select and have access to 360\u00ba videos of seven attractions of the region: Iguassu Falls, Helisul Helicopter Flight, Itaipu Binacional, Macuco Safari, Marco das Tr\u00eas Fontreiras, Bird Park, Po\u00e7o Preto Trail."}]}, "developer_name": "Imersys", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.imersys.com/legal", "publisher_name": "Itaipu Binacional", "support_website_url": null, "website_url": "https://www.imersys.com/en", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "pt"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466472044928880"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2495398637199866", "version": "1.7"}, "id": "283517198926943", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
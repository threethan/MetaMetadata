bg5Yo6Tiyn-Cd7aKMdN-C42nvOUb68yavUkWhc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAuSiEn-QP-N2uxj0n01msK3MaUltL7HK3B8asqkoCww&oe=6AA401E6"}, "display_name": "Foz 360", "keywords": ["foz", "igua\u00e7u", "iguazu", "tourism", "cataratas"], "long_description": "This app shows the attractions of the tourist destination of Foz do Igua\u00e7u, in Brazil, through an exclusive and innovative experience.\n\nThe user begins the experience with the illustrated map of the tri-border region of Brazil, Paraguay and Argentina. On the map the user has the option to select and have access to 360\u00ba videos of seven attractions of the region: Iguassu Falls, Helisul Helicopter Flight, Itaipu Binacional, Macuco Safari, Marco das Tr\u00eas Fontreiras, Bird Park, Po\u00e7o Preto Trail.", "short_description": "This app shows the attractions of the tourist destination of Foz do Igua\u00e7u, in Brazil, through an exclusive and innovative experience.\n\nThe user begins the experience with the illustrated map of the tri-border region of Brazil, Paraguay and Argentina. On the map the user has the option to select and have access to 360\u00ba videos of seven attractions of the region: Iguassu Falls, Helisul Helicopter Flight, Itaipu Binacional, Macuco Safari, Marco das Tr\u00eas Fontreiras, Bird Park, Po\u00e7o Preto Trail."}]}, "developer_name": "Imersys", "developer_privacy_policy_url": "https://www.imersys.com/politica-privacidade", "developer_terms_of_service_url": "https://www.imersys.com/legal", "publisher_name": "Itaipu Binacional", "support_website_url": null, "website_url": "https://www.imersys.com/en", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_mem
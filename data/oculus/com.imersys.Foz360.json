": null, "video_trailer_thumbnail": {"file_name": "/tmp/6Ch3D6", "id": "2191160854467200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_2191160857800533_3344336371622871040_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ps4YF19bM68Q7kNvwGN_7uy&_nc_oc=AdqZHnpmf8BEda2_X8RDY3Ept-PaxgCYQjq39WISEwLeytF0gql1CM_wpnV1PUwsgRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTCTN62DM17yySwOjNRPg6zbhP3PCTdlw_pLhC34hDUw&oe=6B008326"}, "display_name": "Foz 360", "keywords": ["foz", "igua\u00e7u", "iguazu", "tourism", "cataratas"], "long_description": "This app shows the attractions of the tourist destination of Foz do Igua\u00e7u, in Brazil, through an exclusive and innovative experience.\n\nThe user begins the experience with the illustrated map of the tri-border region of Brazil, Paraguay and Argentina. On the map the user has the option to select and have access to 360\u00ba videos of seven attractions of the region: Iguassu Falls, Helisul Helicopter Flight, Itaipu Binacional, Macuco Safari, Marco das Tr\u00eas Fontreiras, Bird Park, Po\u00e7o Preto Trail.", "short_description": "This app shows the attractions of the tourist destination of Foz do Igua\u00e7u, in Brazil, through an exclusive and innovative experience.\n\nThe user begins the experience with the illustrated map of the tri-border region of Brazil, Paraguay and Argentina. On the map the user has the option to select and have access to 360\u00ba videos of seven attractions of the region: Iguassu Falls, Helisul Helicopter Flight, Itaipu Binacional, Macuco Safari, Marco das Tr\u00eas Fontreiras, Bird Park, Po\u00e7o Preto Trail."}]}, "developer_name": "Imersys", "developer_privacy_policy_url": "https://www.imersys.com/politica-privacidade", "developer_terms_of_service_url": "https://www.imersys.com/legal", "publisher_name": "Itaipu Binacional", "support_website_url": null, "website_url": "https://www.imersys.com/en", "category": "APPS", "comfort_r
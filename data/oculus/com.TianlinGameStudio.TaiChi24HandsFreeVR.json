nc_ss=7f20f&oh=00_AQExP9NIy68tLVrepLYjlx1kZE_sJ3aH_P1zfhgnY5Od4g&oe=6A8D8EE5"}, {"file_name": "s7.png", "id": "1335362928119991", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499294603_1335362931453324_4723711431183149087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGTQJJPxsLoQ7kNvwHZDw2c&_nc_oc=Adq27gAwOS4NRwnfyh4Uc3f0dHstzpI8Exf95l1rmhfTB0rWUOv9g-kcw1_UrrwCRXI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH8i07HQyFgZ1kMzcJCh_ZxE02ptbSFaIRvbfreveZpw&oe=6A8D6A4F"}, {"file_name": "s3.png", "id": "1492900375166433", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830620_1492900378499766_4957348922682467153_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCFOh88RhaIQ7kNvwHiu7u6&_nc_oc=AdqmHlYpFzZUJfyn7ak-gi4cH3DYBD7nRe8iL4c8Mlcguyfh7kniR1rJJKJ1TUHvAn8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS6JZ1MQ-kGOAiBzhXh-US96bRq7iIsY15smAlN53ORg&oe=6A8D81FC"}, {"file_name": "s4.png", "id": "1347467503670724", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824532_1347467507004057_1423431758875377970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcvrdYW0H60Q7kNvwEA0TDt&_nc_oc=AdqzVjw26E6ZCXwrxVqVIxfIouCJX4Ol8l3YJAySe7HyFo0KJaD3wwV0oH6Y0UlUo8g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7OhxXCFj4WJpht3TW_ImHbbCctudKLx7REUGsL0eCyA&oe=6A8D9930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerStart.png", "id": "24892153937067462", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827038_24892153960400793_5134972555505502421_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGMt6cF_UxgQ7kNvwFnUUih&_nc_oc=AdrmSkNRyDMpksFncxRN6fP-8-h5c0QxBnOjjji5xXR0BYTBcIIOM4anH4PnHkikYjA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz2ooqVXdnfFblEBwHLiFVM52UOz4i9z28QFZGgyIIpg&oe=6A8D8502"}, "display_name": "Tai Chi 24 Hands Free VR", "keywords": [], "long_description": "\ud83c\udf3f Tai Chi 24 Hands Free VR\n\nTrain, relax, and energize with the world\u2019s most popular Tai Chi form \u2014 no controllers required. Move freely with your own hands and experience Tai Chi in a whole new way.\n\nWhy Tai Chi 24 Hands Free VR?\n\nThe 24-Form Tai Chi is the most widely practiced sequence worldwide, known for improving balance, strength, and mindfulness. Whether you\u2019re brand new or already experienced, this app is your personal guide to mastering all 24 movements in an immersive VR environment.\n\n\u2728 Key Features\n\n\ud83d\udc40 Interactive 3D Instructor\nRotate your AI instructor to any angle with a simple finger swipe. Watch every detail from the perfect perspective \u2014 just like training with a personal tutor.\n\n\ud83d\udc3c Slow Motion Replay\nTap the Panda button to replay movements in slow motion. Adjust the speed to learn at your own pace and refine each technique step by step.\n\n\u23e9 Fast Forward & Rewind\nJump directly to any form with easy navigation controls. Focus on specific movements without starting over.\n\n\ud83c\udf04 Immersive Environments & Music\nChoose from over 20 calming backgrounds \u2014 mountains, rivers, oceans, grasslands, and more. Each environment is paired with relaxing music to keep you centered and motivated. Switch instantly with just one tap.\n\n\ud83c\udf1f Train Freely. Move Naturally.\n\nWith Tai Chi 24 Hands Free VR, your hands are free to move just like real Tai Chi. No controllers. No barriers. Just you, the forms, and the flow.", "short_description": "\ud83c\udf3f Tai Chi 24 Hands Free VR lets you master the world\u2019s most popular Tai Chi form \u2014 no controllers required. Move naturally with free hands as you follow a 3D instructor, replay movements in slow motion, and train at your own pace. With immersive backgrounds, calming music, and intuitive tools to refine every form, it\u2019s like having your own Tai Chi tutor in VR."}]}, "developer_name": "Tianlin Zhang", "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "https://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25116452291282262"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1596928352130839"}, {"status": "PUBLISHED", "id": "1002996365651044"}, {"status": "PUBLISHED", "id": "1552708033190790"}, {"status": "PUBLISHED", "id": "26678680501766724"}, {"status": "PUBLISHED", "id": "1281012983360378"}, {"status": "PUBLISHED", "id": "1983903855878351"}, {"status": "PUBLISHED", "id": "26039445035742594"}, {"status": "PUBLISHED", "id": "1278427277643593"}, {"status": "PUBLISHED", "id": "1939846403629542"}, {"status": "PUBLISHED", "id": "828017613029383"}, {"status": "PUBLISHED", "id": "2373301766406051"}]}, "baseline_offer": {"id": "2373301766406051"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1596928352130839"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27436364382624363", "version": "2.1"}, "id": "658395433991338", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bi
": "01.png", "id": "1436432154877175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_1436432158210508_6966710487867193970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoZfWQOsbmEQ7kNvwFMuI8E&_nc_oc=AdpPCzhmDHai9bKct6OA4-rqwQLPsSlhIBCFVB6FPDeXiIptUCUPuDNq2oIVN8qGd2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGjZNUKwvOnT4xBHBu-URv-grRbOAxzk1cxyX1-WZv6w&oe=6AEB5F56"}, {"file_name": "02.png", "id": "1687511892408933", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_1687511895742266_4458418142154631305_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8IgR39lAy8Q7kNvwF9EsR7&_nc_oc=Adrg-BscwBsb1AS-VlPWj2WuXYEJSPdzkuB0qhM1sO-nGIoSgugKI9kiAAeBthJL7VQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJP-wz4nHUnIgAAwa9AKuNca85uIpZjC7Yc0bWFQAjoQ&oe=6AEB3595"}, {"file_name": "03..png", "id": "1572806447160018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_1572806450493351_1015786706127495597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbLfYEWeRdIQ7kNvwEqQP2I&_nc_oc=AdoY6n2K7uHE1ODlK8GG9GbOzAzpGcQPW0QT5M9Hl32Y50hv0uzGv-j1ijZLZLPXqmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZa7gVy5t89RGS-M1AhPbxInbN6v3WaAOBVhyMgQCeqA&oe=6AEB4603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\uac00\ub85c \ubc29\ud5a5 \uc774\ubbf8\uc9c0 2560x1440.png", "id": "1963497884522825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821089_1963497891189491_6894475180918567576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm8Np15EaUoQ7kNvwEd4DVd&_nc_oc=AdoEdm3UYvsxJDH8rF5v0Bc3SStc1xk0LeumXg9vCLWORLP4cABPPou8dWoJe4gZUy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd4CDUoyZ30UQR7AIvaB5ylez12XjPZATuiNyGfklp7A&oe=6AEB439D"}, "display_name": "NLCY Debate Club Part3", "keywords": [], "long_description": "2022\ub144 \uccab \uc120\uc744 \ubcf4\uc600\ub358 \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc758  VR \ud65c\uc6a9 \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8 <VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860 \ucea0\ud504>\uac00 2026\ub144, \uc0c8\ub86d\uac8c \ud655\uc7a5\ub418\uc5b4 \ub3cc\uc544\uc654\uc2b5\ub2c8\ub2e4!\n\n\n\uae30\uc874\uc758 \ud658\uacbd \ubc0f \uacfc\ud559 \ubd84\uc57c\uc5d0 \uc774\uc5b4, \uc0c8\ub86d\uac8c \ucd94\uac00\ub41c '\ubbfc\uc8fc\uc2dc\ubbfc\uad50\uc721' \ubd84\uc57c\uc758 \uc5d0\ud53c\uc18c\ub4dc 3\uc885\uc744 \uc9c0\uae08 \ubc14\ub85c \ub9cc\ub098\ubcf4\uc138\uc694.\n\n\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740 \uc5b4\ub9b0\uc774\u00b7\uccad\uc18c\ub144\ub4e4\uc758 \uc758\uc0ac\uc18c\ud1b5 \ub2a5\ub825\uacfc \ub17c\ub9ac\ub825\uc744 \uae30\ub974\uace0, \uc62c\ubc14\ub978 \uac00\uce58\uad00 \uc815\ub9bd\uc744 \ub3d5\uae30 \uc704\ud574 \uae30\ud68d\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\ub2e8\uc21c\ud55c \uac8c\uc784\uc744 \ub118\uc5b4, \ubcf8\uaca9\uc801\uc778 \ub3c5\uc11c\ud1a0\ub860\uc758 \ud654\ub450\ub97c \ub358\uc9c0\ub294 \ub9e4\ub825\uc801\uc778 \ub3c4\uc785 \ucf58\ud150\uce20\ub85c \uc0ac\uc6a9\ub429\ub2c8\ub2e4.\n\ubbf8\uc158\ub2f9 5~10\ubd84 \ub0b4\uc678\uc758 \uac15\ub82c\ud558\uace0 \ubab0\uc785\uac10 \ub118\uce58\ub294 VR \uacbd\ud5d8\uc740, \uc5b4\ub9b0\uc774\u00b7\uccad\uc18c\ub144\ub4e4\uc774 \uc2a4\uc2a4\ub85c \ucc38\uc5ec\ud558\uba70 \ud65c\ubc1c\ud558\uac8c \ud1a0\ub860\ud558\ub3c4\ub85d \uc774\ub04c \uac83\uc785\ub2c8\ub2e4.\n\n\ud604\uc2dc\ub300\ub97c \uc0b4\uc544\uac00\ub294 \uccad\uc18c\ub144\ub4e4\uc774 \ubc18\ub4dc\uc2dc \uace0\ubbfc\ud558\uace0, \uc0dd\uac01\uc744 \ub098\ub20c \uc218 \uc788\ub294 \ub2e4\uc591\ud55c \uc8fc\uc81c\ub4e4! \ud55c\uce35 \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c VR\ub85c \uc0dd\uc0dd\ud558\uac8c \uccb4\ud5d8\ud574 \ubcf4\uc138\uc694.\n\n\ub2e4\ub8e8\ub294 \ub0b4\uc6a9\uacfc \uc8fc\uc81c\ub294 \uc544\ub798\uc640 \uac19\uc2b5\ub2c8\ub2e4.\n\nEP1: \ud658\uacbd\uc0dd\ud0dc\ud559\uc790 \ubbf8\uc158 (\uc624\ub791\uc6b0\ud0c4 \uad6c\uc870) - \uacf5\uc0dd\nEP2: \ud658\uacbd\ud53c\ud574\uc5ed\ud559\uc870\uc0ac\uad00 \ubbf8\uc158 (\uc568\ubc84\ud2b8\ub85c\uc2a4 \uc8fd\uc74c\uc758 \uc6d0\uc778\uc870\uc0ac) - \ud574\uc591\uc624\uc5fc\nEP3: \ud658\uacbd\ud65c\ub3d9\uac00 \ubbf8\uc158 (\ubd88\ubc95 \uc0c1\uc5b4 \ud3ec\ud68d \uac10\uc2dc) - \uc0dd\uba85 \uc874\uc5c4\uc131\nEP4: \ud504\ub791\ucf04\uc288\ud0c0\uc7781 (\uad34\ubb3c \ud0c4\uc0dd) - \uacfc\ud559\uc790\uc758 \uc724\ub9ac\uc640 \ucc45\uc784\nEP5: \ud504\ub791\ucf04\uc288\ud0c0\uc7782 (\uc5d8\ub9ac\uc790\ubca0\uc2a4\uc758 \ubd80\ud0c1) - \uc548\ub77d\uc0ac\nEP6: \ud504\ub791\ucf04\uc288\ud0c0\uc7783 (\uc774\uace0\ub974\uc758 \uc704\ud5d8\ud55c \uc2e4\ud5d8) - \uc720\uc804\uc790 \ud3b8\uc9d1 \uae30\uc220\n\nNEW!\nEP7: \uc18c\uc778\uad6d(\ub9b4\ub9ac\ud37c\ud2b8) - \uc18c\uc778\uad6d \uac04\uc758 \uc804\uc7c1 \ucc38\uc804\nEP8: \uac70\uc778\uad6d(\ube0c\ub86d\ub529\ub0b4\uadf8) - \uac70\uc778 \ub18d\ubd80\uc640\uc758 \uc778\uad8c \ub17c\uc7c1\nEP9: \ucc9c\uc0c1\uad6d(\ub77c\ud4e8\ud0c0) - \uacf5\ub3d9\uccb4\uc758 \uc774\uc775\uacfc \uacfc\ud559 \uc5f0\uad6c\n\n* VR\uc774 \ub9e4\ub825\uc801\uc774\uc5c8\ub2e4\uba74, \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc5d0 \ubb38\uc758\ud558\uc138\uc694.\n\uc2e4\uc81c \ud1a0\ub860 \uc218\uc5c5\uae4c\uc9c0 \uacb0\ud569\ub41c, VR \ud65c\uc6a9 \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8 <VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860 \ucea0\ud504>\uac00  \uc5ec\ub7ec\ubd84\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. \n\n* \ubcf8 \ucf58\ud150\uce20\ub294 \uacf5\uc775\uc801 \ubaa9\uc801\uc73c\ub85c \uc81c\uc791\ub41c \uc790\ub8cc\ub85c\uc11c, \ud65c\uc6a9 \uc2dc \ucd9c\ucc98\ub97c \ubc18\ub4dc\uc2dc \uba85\uc2dc\ud558\uc5ec\uc57c \ud569\ub2c8\ub2e4.\n\n* \uc0c1\uc5c5\uc801 \ubaa9\uc801(\uc720\ub8cc \uac15\uc758 \ub4f1)\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc0ac\uc804 \uc0ac\uc6a9 \ud5c8\ub77d\uc744 \ubc1b\uc544\uc57c \ud558\uba70, \ubb34\ub2e8 \ud65c\uc6a9\uc744 \uae08\ud569\ub2c8\ub2e4. ", "short_description": "VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860\ucea0\ud504 - \uc911\uae09\uacfc\uc815 '\ubbfc\uc8fc\uc2dc\ubbfc\uad50\uc721'\nVR Reading Discussion Camp (Intermediate Level) - Democratic Citizenship"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-450102982986-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com/NLCY_DebateClub/personalInfo.html", "developer_terms_of_service_url": null, "publisher_name": "\uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00(National Library for Children and Young Adults) ", "support_website_url": null, "website_url": "https://www.nlcy.go.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27037202959230626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618069_1437985644482852_1144837472418787383_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL6-lt5KGvcQ7kNvwHzyUtr&_nc_oc=AdrOj7m4RjqzWAU5VS9lDIWL0zs77t86FdgLSPOw7UsPADj-p94XUS4wfcJWCVirdM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZgckPCbwFZGcdZIRpuVUACFCFfSNSQl23FABz6eFLbw&oe=6AEB5D4D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NLCY Debate Club Part3", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "3
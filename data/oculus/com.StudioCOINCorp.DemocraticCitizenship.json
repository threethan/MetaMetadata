=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NGTukpuPnv55BDtmWPtW3X-flUx3QezUX8gqtlAuBKQ&oe=6A3D2EA3"}, {"file_name": "00.png", "id": "2700477580338475", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619174_2700477583671808_3990636760275200554_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6Decozg6BgQ7kNvwHLjJAI&_nc_oc=AdoFc1fs_YCmvQ1_8TBuvXoIp52SYilxnfohYlPWdJT9hXD-JmlnVsPAYv7WX9M0gTU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bRwkNGYuNO-m8H4XlKDdG2K_rrRNh6R_M8Fb31osxAA&oe=6A3D37EF"}, {"file_name": "01.png", "id": "1436432154877175", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618274_1436432158210508_6966710487867193970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1d0DtLTOSoQ7kNvwHg3m4J&_nc_oc=AdpSPsqmHxg8Kl5M_k3w3JQ7NXTIrncyAptfhIuBM3xn1XnwBBlHXl5F8syThE3nJjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h1ZIwClPzyJmVl8SEaO0xlBKLzyF3a6ZDggUOtmL04A&oe=6A3D5956"}, {"file_name": "02.png", "id": "1687511892408933", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617729_1687511895742266_4458418142154631305_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPH6SOLRJTsQ7kNvwGejC3p&_nc_oc=AdobUqNfzET76XCKXOvcuCKkC0uu90GguDGYv89NGY35_Bgnbx4MxL7wUAN0GYEYMH4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lghXlpF2CEmBoLB6X8V3LW20vcGW6b3tHV0EhGjCi1A&oe=6A3D2F95"}, {"file_name": "03..png", "id": "1572806447160018", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_1572806450493351_1015786706127495597_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRKB1buQfLYQ7kNvwFgwlR0&_nc_oc=AdogPSAZjpdL4_hEaC7qbhcCVGg_Wl08wBKtPPx-H-s2LHQ3gLsEso2ZwqbOToJJ52w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fe5ztMkZ893_0H_p6-Cc5ww3wr3ve_-R2eKziWKn46Q&oe=6A3D4003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\uac00\ub85c \ubc29\ud5a5 \uc774\ubbf8\uc9c0 2560x1440.png", "id": "1963497884522825", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821089_1963497891189491_6894475180918567576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Landwk2ek_0Q7kNvwGWYK2C&_nc_oc=Adrbq9i5YV6UgpqIZD8tftGpd43KgwRzCw-Ff57o5XML-XHkrQrpYdSnwlRaN3DbCks&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9asyawzYKFuBAtEf5WdKdkFUUJruEtDPUdGeUr3rKP7Q&oe=6A3D3D9D"}, "display_name": "NLCY Debate Club Part3", "keywords": [], "long_description": "2022\ub144 \uccab \uc120\uc744 \ubcf4\uc600\ub358 \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc758  VR \ud65c\uc6a9 \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8 <VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860 \ucea0\ud504>\uac00 2025\ub144, \uc0c8\ub86d\uac8c \ud655\uc7a5\ub418\uc5b4 \ub3cc\uc544\uc654\uc2b5\ub2c8\ub2e4!\n\n\n\uae30\uc874\uc758 \ud658\uacbd \ubc0f \uacfc\ud559 \ubd84\uc57c\uc5d0 \uc774\uc5b4, \uc0c8\ub86d\uac8c \ucd94\uac00\ub41c '\ubbfc\uc8fc\uc2dc\ubbfc\uad50\uc721' \ubd84\uc57c\uc758 \uc5d0\ud53c\uc18c\ub4dc 3\uc885\uc744 \uc9c0\uae08 \ubc14\ub85c \ub9cc\ub098\ubcf4\uc138\uc694.\n\n\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740 \uc5b4\ub9b0\uc774\u00b7\uccad\uc18c\ub144\ub4e4\uc758 \uc758\uc0ac\uc18c\ud1b5 \ub2a5\ub825\uacfc \ub17c\ub9ac\ub825\uc744 \uae30\ub974\uace0, \uc62c\ubc14\ub978 \uac00\uce58\uad00 \uc815\ub9bd\uc744 \ub3d5\uae30 \uc704\ud574 \uae30\ud68d\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\ub2e8\uc21c\ud55c \uac8c\uc784\uc744 \ub118\uc5b4, \ubcf8\uaca9\uc801\uc778 \ub3c5\uc11c\ud1a0\ub860\uc758 \ud654\ub450\ub97c \ub358\uc9c0\ub294 \ub9e4\ub825\uc801\uc778 \ub3c4\uc785 \ucf58\ud150\uce20\ub85c \uc0ac\uc6a9\ub429\ub2c8\ub2e4.\n\ubbf8\uc158\ub2f9 5~10\ubd84 \ub0b4\uc678\uc758 \uac15\ub82c\ud558\uace0 \ubab0\uc785\uac10 \ub118\uce58\ub294 VR \uacbd\ud5d8\uc740, \uc5b4\ub9b0\uc774\u00b7\uccad\uc18c\ub144\ub4e4\uc774 \uc2a4\uc2a4\ub85c \ucc38\uc5ec\ud558\uba70 \ud65c\ubc1c\ud558\uac8c \ud1a0\ub860\ud558\ub3c4\ub85d \uc774\ub04c \uac83\uc785\ub2c8\ub2e4.\n\n\ud604\uc2dc\ub300\ub97c \uc0b4\uc544\uac00\ub294 \uccad\uc18c\ub144\ub4e4\uc774 \ubc18\ub4dc\uc2dc \uace0\ubbfc\ud558\uace0, \uc0dd\uac01\uc744 \ub098\ub20c \uc218 \uc788\ub294 \ub2e4\uc591\ud55c \uc8fc\uc81c\ub4e4! \ud55c\uce35 \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c VR\ub85c \uc0dd\uc0dd\ud558\uac8c \uccb4\ud5d8\ud574 \ubcf4\uc138\uc694.\n\n\ub2e4\ub8e8\ub294 \ub0b4\uc6a9\uacfc \uc8fc\uc81c\ub294 \uc544\ub798\uc640 \uac19\uc2b5\ub2c8\ub2e4.\n\nEP1: \ud658\uacbd\uc0dd\ud0dc\ud559\uc790 \ubbf8\uc158 (\uc624\ub791\uc6b0\ud0c4 \uad6c\uc870) - \uacf5\uc0dd\nEP2: \ud658\uacbd\ud53c\ud574\uc5ed\ud559\uc870\uc0ac\uad00 \ubbf8\uc158 (\uc568\ubc84\ud2b8\ub85c\uc2a4 \uc8fd\uc74c\uc758 \uc6d0\uc778\uc870\uc0ac) - \ud574\uc591\uc624\uc5fc\nEP3: \ud658\uacbd\ud65c\ub3d9\uac00 \ubbf8\uc158 (\ubd88\ubc95 \uc0c1\uc5b4 \ud3ec\ud68d \uac10\uc2dc) - \uc0dd\uba85 \uc874\uc5c4\uc131\nEP4: \ud504\ub791\ucf04\uc288\ud0c0\uc7781 (\uad34\ubb3c \ud0c4\uc0dd) - \uacfc\ud559\uc790\uc758 \uc724\ub9ac\uc640 \ucc45\uc784\nEP5: \ud504\ub791\ucf04\uc288\ud0c0\uc7782 (\uc5d8\ub9ac\uc790\ubca0\uc2a4\uc758 \ubd80\ud0c1) - \uc548\ub77d\uc0ac\nEP6: \ud504\ub791\ucf04\uc288\ud0c0\uc7783 (\uc774\uace0\ub974\uc758 \uc704\ud5d8\ud55c \uc2e4\ud5d8) - \uc720\uc804\uc790 \ud3b8\uc9d1 \uae30\uc220\n\nNEW!\nEP7: \uc18c\uc778\uad6d(\ub9b4\ub9ac\ud37c\ud2b8) - \uc18c\uc778\uad6d \uac04\uc758 \uc804\uc7c1 \ucc38\uc804\nEP8: \uac70\uc778\uad6d(\ube0c\ub86d\ub529\ub0b4\uadf8) - \uac70\uc778 \ub18d\ubd80\uc640\uc758 \uc778\uad8c \ub17c\uc7c1\nEP9: \ucc9c\uc0c1\uad6d(\ub77c\ud4e8\ud0c0) - \uacf5\ub3d9\uccb4\uc758 \uc774\uc775\uacfc \uacfc\ud559 \uc5f0\uad6c\n\n* VR\uc774 \ub9e4\ub825\uc801\uc774\uc5c8\ub2e4\uba74, \uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00\uc5d0 \ubb38\uc758\ud558\uc138\uc694.\n\uc2e4\uc81c \ud1a0\ub860 \uc218\uc5c5\uae4c\uc9c0 \uacb0\ud569\ub41c, VR \ud65c\uc6a9 \ub3c5\uc11c\ud1a0\ub860 \ud504\ub85c\uadf8\ub7a8 <VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860 \ucea0\ud504>\uac00  \uc5ec\ub7ec\ubd84\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. ", "short_description": "VR\ub85c \ub5a0\ub098\ub294 \ud1a0\ub860\ucea0\ud504 - \uc911\uae09\uacfc\uc815 '\ubbfc\uc8fc\uc2dc\ubbfc\uad50\uc721'\nVR Reading Discussion Camp (Intermediate Level) - Democratic Citizenship"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy-450102982986-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com/NLCY_DebateClub/personalInfo.html", "developer_terms_of_service_url": null, "publisher_name": "\uad6d\ub9bd\uc5b4\ub9b0\uc774\uccad\uc18c\ub144\ub3c4\uc11c\uad00(National Library for Children and Young Adults) ", "support_website_url": null, "website_url": "https://www.nlcy.go.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26982485588035697"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "744449725269782"}]}, "baseline_offer": {"id": "744449725269782"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774489620, "status": "PUBLISHED", "id": "744449725269782"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26931137973170459", "version": "0.1.0"}, "id": "1867962317218869", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "
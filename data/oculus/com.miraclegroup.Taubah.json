: "2115452082552201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820496_2115452085885534_1119563477806996989_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJTrgZSZfn0Q7kNvwFe-Xs3&_nc_oc=AdqJapmmP4xhl-rX3lIba6k1pDFd-A46f_m9iGeh2wmfLJH95kf6yJvQuqfox7P1z60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGIdBJBjoKmM5poy8vakigpmIVLGk8eJ05ZS11e597Ow&oe=6B0320D5"}, {"file_name": "ss 2.png", "id": "1996601747881035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1996601751214368_7378217604967948195_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vra7q2zH8gUQ7kNvwHU6Ta4&_nc_oc=AdqqWFGO5U63n0uqwkNQy8h4m4MC3Xk1qdlT_iK0h1qD3bZEFk6Rouv1JE2Pd2qmE_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhgGEqM1AWfygYvS7U-lbmpAPpIlGoEzvE-utfvu8WXw&oe=6B03367A"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm3p1wpO9xoQ7kNvwH92WSq&_nc_oc=AdogmZAD8Pqq4N4DzuvNpvN4pw1IStcxUSY-EQIeRcncwYhzVbr6ec_wwo6veiFqrdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSwZC3E7UY77hMh4Xtg_AjEVJ6jhCZatiZKR-YgW3tew&oe=6B0316BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26615344644756884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_2020523101828072_5100793827575115692_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrp2pLEoSccQ7kNvwF8AlTt&_nc_oc=Adrq9oA-jPnyA0SikmLAVGUtdb0ZCh4s0Wc5u6VzH3pOz3rnod_BRibj_Z7tUqa18yY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNlmu0cIKkUjVURNJcNrOhX_uxXmqarEsP62akUm1izg&oe=6B03030B"}, "is_concept": false, "is_test": false, "is_trial_offer
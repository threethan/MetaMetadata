: "2115452082552201", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820496_2115452085885534_1119563477806996989_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Aee2unCIkQ7kNvwENbt45&_nc_oc=Adriopcfyua_FU2XwOrmauqGeI67Js8iFEQhGSWLlccJkqgyo5hAUIPnDVCDq8_xKPQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0iJ7YoTjvA7qhgSj_xHpsSsZ1zLJQjPPILe-gJEtktw&oe=6B0B4215"}, {"file_name": "ss 2.png", "id": "1996601747881035", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1996601751214368_7378217604967948195_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iPurcGplHcQ7kNvwENlLS3&_nc_oc=AdroK8yizJv2RM8MU7HE29HWw_Mdl7VGZhNsXGGXQSZA-iJS96CQyhumHzlPH3H0-8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTp9IPYzJtbHXKITfRMO6LaSFzlvzph9CekwsEOe3-zsA&oe=6B0B1F7A"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TdHX-vSlhoQ7kNvwEVeDLo&_nc_oc=AdpXlCDC58fKRM9RHLeMOEieo60KwPhs-4CeySd_OwTgjdwq7EIGsIFd_1dn3paGmmU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCziGfgquUeUq6UK4kueaTxH4T80IY1p4niXGaWpbPQA&oe=6B0B37FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26615344644756884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827601_2020523101828072_5100793827575115692_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhGM16y-fDUQ7kNvwEhPFHB&_nc_oc=Ado1DRgdxA9rSFU_nd90XpJtihmdO5UKiZ_f-SxF3FcAlffhpyA-9lWUta7jFdp668g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTI_Bi9lRKO1pINlTtZZHVFrZMOLI15t6arXHJczDF3BA&oe=6B0B244B"}, "is_concept": false, "is_test": false, "is_trial_offer
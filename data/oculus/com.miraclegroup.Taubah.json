: "2115452082552201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_2115452085885534_1119563477806996989_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJTrgZSZfn0Q7kNvwG4r1Vx&_nc_oc=AdpMEv_2x35I_lSgJVV1suJUGd6iqdkR1eeVIgHEgLBJlB-pTgYCF4uG3-bCF6w4E9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvvnjINEhtuHawPf5rUEq8USzZsRmwJsuopx0SVMjY-g&oe=6B05C3D5"}, {"file_name": "ss 2.png", "id": "1996601747881035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1996601751214368_7378217604967948195_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGUAwZCtwGIQ7kNvwHFCHHB&_nc_oc=AdqDbBJplR_dWaFTclsMXZmP8_Jn1pbl_7GUIthRC032DhiTkZd-sCFGq3b-K4DoIBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROOwa6cB3zcSNNYCDvdMG9F_KD21nGwORhGPCkQwXeCw&oe=6B05D97A"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm3p1wpO9xoQ7kNvwHwV_Xd&_nc_oc=Adoc1h7VHbrZ0grreiY44cgbvdOCcClbxIQesF4i6fdT2P3HpZ5co9dCy4C9kMtisfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaGxH6CHkW7pMnhLwJi-RIIj5Q22qIPvjT9RATZkaTQg&oe=6B05B9BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26615344644756884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827601_2020523101828072_5100793827575115692_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrp2pLEoSccQ7kNvwFd0X9Q&_nc_oc=Adqb4QgFhXwHz0vBzuXF-5X6W-su7Kb5EoZ4hcvtAJ1_D4JYQAEvVEiJG-Q2IMfX2Es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBLkp3ciAYVB3mUfqjsaUbgjEAOLvmq0ElNeu8GY1vmw&oe=6B05A60B"}, "is_concept": false, "is_test": false, "is_trial_offer
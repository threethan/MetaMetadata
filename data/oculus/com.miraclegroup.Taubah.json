qkZ2fVsQ7kNvwFRpHqt&_nc_oc=AdothDgdW1JyfS4omlPQB914uGIx_Rk-fi_iLuvJ2uPXDQyYxaiOtRCwC6vpliE-EqI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WV-SKr0tc1gEFnNIH_j5p-2IQ28pthwd32mFU3UEXEQ&oe=69F35395"}, {"file_name": "ss 2.png", "id": "1996601747881035", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821099_1996601751214368_7378217604967948195_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ykv-hA9B0PAQ7kNvwEFObqG&_nc_oc=AdpE1BUnJgbiiuUHPiIshDSKotwCkWOFXjbSxn_6V5Et_VR7kuZ86h1YNqUGulvoE5U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OGuWzDP_Kotu-D9Yucw4aeBCnN2x4iMaB2UeKF3u_EA&oe=69F3693A"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCA9wwA9SZoQ7kNvwGsuYZh&_nc_oc=Adqr-7rhJt1Qh_-hzqrb5b6Un-2UrZ5vAHh9nT4YsAFf-EjumWv3HIIIivYVQ09lGdY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EJPOVj0oVaayFlOKLK4EucF2mVm6nAlrTZ7B63s6Vag&oe=69F3497A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26615344644756884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827601_2020523101828072_5100793827575115692_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhRPJM-Jrt8Q7kNvwGmtzdC&_nc_oc=AdpVBwQh8ESpRAWvmi_Zkimrt4hF4Lg1oPhFyFgYe27TKk2LZAWjq51BBPN44VXY-4Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mdWWNBxsPrs9X4Zr2BB7qAexUFh0YWVf_UlpcJcMDHA&oe=69F36E0B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah At-Tawbah", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release
: "2115452082552201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_2115452085885534_1119563477806996989_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Aee2unCIkQ7kNvwH6l9Na&_nc_oc=AdoNpzxlkP9v2UzQpjCaDx0-0CJXi8MbidfyoR_cQSM7vdGDJBsIgzaguhfSDYnM5lU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6Y9Vw8Cax2grAEGSBAshH4swHM2ZXN1kkPSFh5_mTyg&oe=6B0C5B55"}, {"file_name": "ss 2.png", "id": "1996601747881035", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1996601751214368_7378217604967948195_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iPurcGplHcQ7kNvwEHffoe&_nc_oc=AdrSJwsEVSxTQk8Q88KoTRgeDbAbeAHeSBNWGu6f8B9iE849Nu9aeC_EKGucN74zgeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-QCG1cbPsRPGpw1TEn0caPutQOzf-U266OMA7TyEkVw&oe=6B0C70FA"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TdHX-vSlhoQ7kNvwFVynFD&_nc_oc=AdqTKPyZTr01ig7Y52j_IVdzZ6uVqNgChOV6JLg967PS8sHTyNqJCkuRtcLRJc-iSlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRUuChOM2MDPxX-kM2Fna_HxYLuB8j8HvKhgKWFz17Sg&oe=6B0C513A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26615344644756884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827601_2020523101828072_5100793827575115692_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhGM16y-fDUQ7kNvwHHkIVt&_nc_oc=AdqrRJtgocYHvFY0Ri9y_bDRaW1hmuj1bjQ_XXpWN5XIUVp_deSHrTtWoxcLLAqWFXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDhF-5Ujo-UOUKIVj4_oySUe2J6reRFHFa3tx--3OcGw&oe=6B0C75CB"}, "is_concept": false, "is_test": false, "is_trial_offer
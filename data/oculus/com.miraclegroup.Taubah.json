195_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9CQbplXfCIQ7kNvwGbooBW&_nc_oc=AdqHA5xOe7Ua8wHHqhxH2jsmhTrU_aH4hkB2QkNGEZW8haDa5F5vX3WdYdykMJBcJnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSk6VJ3a4mk9gMnglZZZicWBiFGiy8KKEQHuqoiik5gw&oe=69D1223A"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKzbTTcuZ8IQ7kNvwG1tqKV&_nc_oc=Adq19T0ZqnOleXdpyFwMC47XvFd2wFr09k-tDrndKFmxc1xGel8qAToFxzOmoJ60PWU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxe8p8g3ADjBlJRFbGfzvlMKUIwqTdEDk44sqzpM27NjQ&oe=69D1027A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publi
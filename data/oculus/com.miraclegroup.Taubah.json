195_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCddJO_LzGkQ7kNvwHGTRrT&_nc_oc=AdrWGB8C4mcWqg_Oo44G1yIXzMNo6ir40uUgvaPmbvdaPxpvkG0G_f_SaQRWgEuwD4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZm-85Bw_KcXXaSOi9KFfIXRZ8AbikNtBqI5kPbx9mGA&oe=69CBDC3A"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MencIPX8BrYQ7kNvwFt3kjy&_nc_oc=Adqm1iXbJgeySuBUBmhNV0p8JmNTJpBkUMI25k2AO8z-RhM47r8NO8_U8CpNlDeA1qM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUYMXG_4mNcZePSKGUj7U-PxQvbYlEGLNHqgo13TgsPg&oe=69CBBC7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publi
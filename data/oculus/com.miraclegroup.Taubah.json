gQzbOPgQ7kNvwHi97ga&_nc_oc=Ado487COqXtL4Z10Cn-L2uEnUQIS_1B91Fgt3JFj8nKE9eB4GVgporyaKWUguNUvNNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0gUTRpGVfdqV9Ws6uYVZFkRcdjVOvMaa6P6EwO75c5Q&oe=6A5B7A15"}, {"file_name": "ss 2.png", "id": "1996601747881035", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821099_1996601751214368_7378217604967948195_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um5jmc0voYAQ7kNvwGVnnSn&_nc_oc=AdpT2qn2HdMqRUf4SNCz8RZSzQpD7cdg2gF7Aa7apZ33Y8y1ZG4PMI9A51Egaaat-ww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5O1A2S2mkZDdXtf185SUMEPDZvwoGcK5NI63E7pPUNg&oe=6A5B8FBA"}, {"file_name": "ss 3.png", "id": "4295412127407578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820496_4295412130740911_4040745341330376279_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXJ8wIET-vcQ7kNvwGBWnhc&_nc_oc=Adr9F2zat6k7IRz9cKI3YKiY_LF66_GYceLDU6YMoojvJKktc22QHh8nqNfG3PTheOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlh1_ix5x_bdQn1Bi1vh6MuqyzTAmiWfO8JqtVtb56MA&oe=6A5B6FFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah At-Tawbah", "keywords": [], "long_description": "Surah At-Tawbah \u2013 VR Experience\n\nExperience the recitation of Surah At-Tawbah, the ninth chapter of the Holy Quran, through a deeply immersive virtual reality experience designed for Meta Quest.\n\nThis VR experience provides a calm and focused environment where you can listen to and reflect on the verses of Surah At-Tawbah. The carefully designed virtual setting and high-quality audio allow you to engage with the Quran in a peaceful and distraction-free space.\n\nSurah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah.", "short_description": "Surah At-Tawbah highlights themes of sincerity in faith, repentance, accountability, and the importance of remaining true to the path of Allah. It provides guidance for believers on honesty, commitment, and strengthening their relationship with Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26615344644756884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827601_2020523101828072_5100793827575115692_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJRZEsx3u5cQ7kNvwHtuFmS&_nc_oc=AdooDfScPHB_UWsKVcwuju6SgACbNpRQQxR2CZJl9uhgSfj64rrFHunJH_L0QRRz3BI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFW_4tSdWCXzZ-ulhUCth39o8hpLClFoIcf8MmegGRDQ&oe=6A5B948B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah At-Tawbah", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release
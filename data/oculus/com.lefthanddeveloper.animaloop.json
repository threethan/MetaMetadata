doBiZRHX762AutuJNmpgfpb6qRyEJIx2ESsXavF3GVU49YfWKe8E4GizWw1kol0fmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPUeUT7mMD5dpycw5rnxxV9DZo9-yVw3m7LbHxXeAF2A&oe=6AFDB705"}, {"file_name": "screenshot_3.png", "id": "1418030346959685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626806_1418030350293018_8560369253267234198_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e9wH87KdIEQ7kNvwEgLqGC&_nc_oc=AdpHT1vp4dEUjESWo_7gLzDlWXOs7YWfRN5kxln4eaT0qGjZ-K1g5SiyxpyeqElLQr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQmasbAR2HsD0qGRm0x28drXvRgi_MgBx1UvJMS7A_8A&oe=6AFDE23B"}, {"file_name": "screenshot_4.png", "id": "940800278669270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593727470_940800282002603_3736787979517602879_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAZnFnMZHbMQ7kNvwEmrGnv&_nc_oc=AdqWEa_o2jcbily8baA_rqSj-QVSg5jRxUt61TMMbPfrN9MmkiQ6izCJWYN5pJns18A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwhhi5bf1g0cbb4V0Q5ZMe8r9P2dpElB1JPJoWAGuI8w&oe=6AFDCA44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Animaloop_CoverArt.png", "id": "1098195063169860", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622162_1098195066503193_6984754774299491072_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUeyRD2k-i0Q7kNvwG5h1pT&_nc_oc=AdqU1jR1fKyCMsMoPBnRdZJC4h-wLYux4GFpkl7uu3WG4J3_0szKt2OSmC2M7tgLmuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbteX9hltU1RZIKs3KEKQF2SixACPESnB2G5--xy2Aqg&oe=6AFDE493"}, "display_name": "Animaloop", "keywords": ["music", "sandbox", "animals", "loops", "instruments"], "long_description": "A meow becomes a melody. A moo joins the groove. Welcome to Animaloop, a playful music sandbox where animal sounds become your instruments.\n\n**BUILD YOUR ANIMAL BAND**\n\nGrab animal cubes and place them on a track to create a repeating loop.\n{2030502777659146}\nMix different animals, stack cubes to play chords, and layer tracks to turn a simple pattern into your own wonderfully silly tune. Change the tempo and experiment with different combinations.\n\n\n\n**PLAY IT YOUR WAY**\n\n{2224427604955601}\n\nTap cubes to hear them sing. Arrange them around you and play melodies by hand, or improvise over the loops you've built. Make something catchy, something strange, or something that simply makes you smile.\n\n**ADD YOUR OWN VOICE**\n\n{3743754889111806}\n\nRecord your voice or a sound around you and let a parrot cube play it back. Add it to a loop or tap it as you play. Your animal band just got a new member!\n\nNo musical experience needed. No scores, stages, or unlocks. Just a space to explore sounds, make music, and have fun.\n\nGrab, place, and play. What will your animal band sound like?\n\n\n", "short_description": "Turn animal sounds into music! Animaloop is a playful music sandbox where you place animal cubes to build loops and tap them to play your own melodies. Layer loops, stack cubes for chords, and record your voice to join the animal band. No musical experience needed. Just grab, place, and play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/animaloop-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "lefthanddeveloper", "support_website_url": null, "website_url": "https://lefthanddeveloper.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
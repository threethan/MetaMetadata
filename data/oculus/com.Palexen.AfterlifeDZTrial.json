-1.oculuscdn.com/v/t64.5771-25/499299876_587544957786685_973522941051400952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1GXyqgjxocQ7kNvwHzs0ib&_nc_oc=AdmxHQkRrRBcK9hNhcj-TG7omp7pbB-n7TdgxqX_yEWG-1d6Mibgj1UEjcgxCeO-2pI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshaBn_6s6aGe-HgJ0fwQmcSMKJCV7eveVQIg1x0vzv8A&oe=69A6F171"}, {"file_name": "ss1.png", "id": "2387139718388251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823876_2387139721721584_8078740659056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8wRBKcJ1UQQ7kNvwHn_5rD&_nc_oc=Adne5EL_8VAmDsKZmXOwf7WlHzFEEu0N7NyyEcbBD18DbOdcH9aq3AFUVx_85plcMIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuX8wpSYSXgqQAmyUK1-eys8RlFO3lpz8z8Ys5Rz4BGXQ&oe=69A6BE28"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6KJlBTNTEAQ7kNvwEEQBl1&_nc_oc=Adm8iXn6XMcNBgiX4XnNPAuAP2CIBeB2GOlrMCLMOE2IPtxwj2EbxmtDbqgY7Ur6p14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGNeLZady0npb-wjJJoWPw_eO6BPluq-K1tnSuaRXDYA&oe=69A6C4D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5uMkNFQ-IoQ7kNvwEHaX0D&_nc_oc=Adm0R5vKZlTLMqwsQrS3vbB0qRmID4r_lbV8RPl87djh0zYkSrfXo4wY2q21r4EC6rc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXBFZl-yZ7ly9wfKn9T1etgaFRqQfpWEk1E7SWdpVwGQ&oe=69A6C6AA"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34025285087070605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292712_1803503063663415_8373701016445922040_n.png?stp=dst-png_s360x360&_nc_
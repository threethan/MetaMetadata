Af2lNTIiGFULYisPS1mrTBJOY6S0eFexnltqCQ8q18TFUQ&oe=69DBAD71"}, {"file_name": "ss1.png", "id": "2387139718388251", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823876_2387139721721584_8078740659056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4o_PMAHK-ioQ7kNvwEH6kdD&_nc_oc=Adp3ww8yTWW_DvgItatILYzq0y0IdW3UyPJ-iomXeFZprUm333rY8WZStQaUlLQsv8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06R0FJ-zKSIBLnCNmkISJeC05iD0EgsbDUB_ecY9EHFw&oe=69DBB268"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iFvQMg908oQ7kNvwGs8wdg&_nc_oc=Adp72Dvt971ltyBUX0j075gnXdFwJ82cqAAJfMJQFQ2J86pManloXUvaVNC-5rBsheg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mmjmmE9SCNd_NpQ7EM7Vd2tGi8Z38eHpaeX2AQRETDg&oe=69DB80D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBWosPi3LnEQ7kNvwHwyeOQ&_nc_oc=Adq9giUhXx0BLdVAw-0HLXs02uySpuv2Yr6YlW1AbA4WQ0ZJcwIHB_1uRr6Fuh94_QU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hKsyVHti7wfV-5pD84D9LwMz_gQGtMomZfjXwqGdmvA&oe=69DB82AA"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/palexen/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://sites.google.com/view/palexen/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35656653643933733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292712_1803503063663415_8373701016445922040_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Pu6lDJQUlIQ7kNvwH6_hRE&_nc_oc=AdozsJsv8duH-lb9j8m6uQI195OLsOJa7X-BqgVvHvI6nb28dAMl9Ph7jo9Rugv1OE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af
Fglh_ecjianb-QfPo1-q90hpde9rnhDRT_GZizZwCvfO0K-DQuvtFSKEeHwg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38BvCvwtdQ4PqTfyx8bV21THCTIk3S06qZpAy7jlUEfQ&oe=69EA2DF1"}, {"file_name": "ss1.png", "id": "2387139718388251", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823876_2387139721721584_8078740659056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1x7lirflTEQ7kNvwGCGCSB&_nc_oc=AdpKM28Jh27BgawkNcaPzkrQxF-6lFHUPIkpZ5zint344nzppxp2VokMlVAaCc2KhCk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KYvz6WfSmxPj7mpZ3n1tlXchLJyfMkA-x9A0_vtHbow&oe=69EA32E8"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLB7LLE-lfEQ7kNvwGXgK4N&_nc_oc=AdrN_vR8iel9AzXFyiD25a6uIfaSNe6SQ14cUbgWY7LpIJKpNGoMnjCVHM55nj8XP1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PM2dTA4qoKbbBQR6soJ5rJhtgAeqa6LHlLYFUPiqPCQ&oe=69EA3994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS6-Vn2RDUoQ7kNvwE1nW8q&_nc_oc=AdrRfZ6xT6DjtPly3ZuBVmQFGA_fRUG56s2gRM2MIQmXLN1ovVut1XyjPUiYVmtJkAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dlk4B57PQSs9s836hUyC7hf7a4FYdJU-wBmKibbpj-g&oe=69EA032A"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/palexen/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://sites.google.com/view/palexen/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35656653643933733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292712_1803503063663415_8373701016445922040_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_eJEdIBb8gQ7kNvwEOldrL&_nc_oc=Adp-p4xXi
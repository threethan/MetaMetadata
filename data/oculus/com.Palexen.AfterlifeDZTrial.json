-1.oculuscdn.com/v/t64.5771-25/499299876_587544957786685_973522941051400952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f5NbXfwjXMQ7kNvwEBs9H0&_nc_oc=AdlAkgg-prOxUHo-x8YNxXz3F-nG4hhKPXqnnA_AvNbkBEOg893E-QkwtiakFI0DroY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDa78rv_Fj37EoD5xAaRKezUcs41AlMVIcj2vtgkrmCg&oe=699DB6F1"}, {"file_name": "ss1.png", "id": "2387139718388251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823876_2387139721721584_8078740659056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNA2OjYZXm8Q7kNvwED1dA_&_nc_oc=AdnKvx-ghRjJ9TuX3jLM4W7VFHqVE0FveSmuGLhM1h7pqUB6YuyRDdh3MW17k86A0G4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXZFolqjhpcWMC0UEmiH0GAteYuYm3mx53qTIFMvSqfA&oe=699D83A8"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5_SYI1RMT8Q7kNvwEDj4Kj&_nc_oc=Adm0HSWe5_qU_eAw7h7hrbyqFHLSHto3c0wMTUufgfGU4ZI4GQmL4i7amGni9DbJ29c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvgYOioleOuQ6whwjldwVzirs9swkBmHvqlNiJ8KOWDTQ&oe=699D8A54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q1b1XJc-OkQ7kNvwEQ6mqs&_nc_oc=AdlgCROp0SJq8G2Z7oL18uPvoCy3hlFdSpqk13OLeA2klAwerxn320KkzIi5oDdTxv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurbHT7tF39fSxWrHq75mrLt_d1Dewjx3FG9AtmryH6UQ&oe=699D8C2A"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34025285087070605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292712_1803503063663415_8373701016445922040_n.png?stp=dst-png_s360x360&_nc_
-3.oculuscdn.com/v/t64.5771-25/499299876_587544957786685_973522941051400952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FPw8GP_v9oQ7kNvwGl74Rh&_nc_oc=Adn9-mBiZ63xgCwGfPu2Za2ZOiG4JGTFjsrn0ffPH4DQx4vyUwf6j1HoInWV-e8YLgY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftSboCGd2R4qyiywPq9jXhFHmipnoVc0Z0eci6phPYr3A&oe=699C6571"}, {"file_name": "ss1.png", "id": "2387139718388251", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823876_2387139721721584_8078740659056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNA2OjYZXm8Q7kNvwGJ5cGt&_nc_oc=AdluN2vbIbX-LmLxUqYomzJHun9g3w8lec5hrXoeWWH_qAZc5hgiv_9TfQB-NtDmTnE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afut-Q-qHzT888NzoeCoO_iiEYZvlmgbsocEsTkPWVoTIA&oe=699C3228"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5_SYI1RMT8Q7kNvwHvFUpj&_nc_oc=AdkwQv5oyj70l3kSB5KRE5WlY3e1cCUuyiAhZ-VvHC45vJ4o_OXy6Togj-KHAEWm1FE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfudMr206-lkb50y0Mq1iQbvh9evLJ8roVdIfs_hsvOxnw&oe=699C38D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhLWtO2LrnMQ7kNvwEavq1p&_nc_oc=AdkDqmpcJM2y-17fUD89Gq8XmmthPrI0YKCiAf8o3i3YIB_7r21jFb19f7Ls5K_EgtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftzSeiANa0dUqtfVkc9SKWUy1xgfq-qb-A5SnfLHYzaIA&oe=699C3AAA"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34025285087070605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292712_1803503063663415_8373701016445922040_n.png?stp=dst-png_s360x360&_nc_
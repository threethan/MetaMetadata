-1.oculuscdn.com/v/t64.5771-25/499299876_587544957786685_973522941051400952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f5NbXfwjXMQ7kNvwFpSj-A&_nc_oc=AdnK2irsoTb9Ai8EtLu8YmmqKW27CbbKJaAIXlJ8f4c5XQfUVIcGjPBt7GSUEILFGac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu6QCypgLVn5t1rz8yCrmHPT8Ah6oh659hOhC67tatiNQ&oe=699F0871"}, {"file_name": "ss1.png", "id": "2387139718388251", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823876_2387139721721584_8078740659056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r7bPmDTBqEQ7kNvwGPKViH&_nc_oc=AdngESXUnfOggAZMVxo7erIoNy6ddE7Ohms29lo05_ji5ZdPquIytSKH-LrVIpBCarU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afta9tgnHdAG9xHnmQ8P40WwJfzTWfjfx_bmEWTEJUREHg&oe=699ED528"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5_SYI1RMT8Q7kNvwEtx9ej&_nc_oc=Adn0MVymp8PQIgyCtlgsQGiKh0A1kYZ19-7Xm_eY_oT_vby7rNJeFxhjEs5pE-lBBJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftTf5bCmNa7vM2rfLjWMKP-RweuUY-D2Gl4_8ywcmmSQQ&oe=699EDBD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q1b1XJc-OkQ7kNvwGpj2-h&_nc_oc=AdnYfplSzdsElij11KyuV_Exnc4gHQaytx7QThWt7G-snggNzLVv0VnKuH63-Xw244I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuYpeCMKR2vYlsXPkVJzacOyQ_zW3z81hPnIxn0n_yJBA&oe=699EDDAA"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34025285087070605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292712_1803503063663415_8373701016445922040_n.png?stp=dst-png_s360x360&_nc_
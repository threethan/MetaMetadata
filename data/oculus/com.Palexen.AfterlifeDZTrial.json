59056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iChN5eJDvzYQ7kNvwGnL9EH&_nc_oc=AdpwPgFgIS2uz_oD-oU_-Aisi9m-0rAtrEnTZEC4lsYGCDRTetMB1pixQzNEiYz3ZVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuHCSJ2b_VtqHIFKxJ7iV8mvbA2TWrSyZIhPI2l5o_Qg&oe=6A95CE28"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgoO49uR68oQ7kNvwFtReuv&_nc_oc=Adotk1wkOzriR0ZEfJSLfsId5jXTSn2Fuw8JEmJtPUQw4x7XpFzGQh32OWrm4Dp5A7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExhWGYy8TRGeyrJyu61N8WaxZ56-vU1vwVHcRR-0Xz_A&oe=6A95D4D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-SSQ4iwBdUQ7kNvwG7NQF7&_nc_oc=AdoozBfZ8zYYOnhBruzAECPQm-EDH4C4fvI3kEw79lmjagw1bRFGpI7qUE0MyNpr1DY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHongL69wO3mX62UzJrfbYmo6i6OusnVNbPRPFAWyVQOg&oe=6A95D6AA"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34025285087070605"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "728095950340766"}]}, "baseline_offer": {"id": "728095950340766"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767376740, "status": "PUBLISHED", "id": "728095950340766"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36710090641923356", "version": "1.1"}, "id": "771210152660303", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_appl
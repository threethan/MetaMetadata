SMsHhl23bK5XghwbdcU0bjEztkPL3aktYfYqzC59MilRAcsByA6fHFjFnN5w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vN4qMmnrd3UhxsBeBpkJAXxkbFBmQag5qGP5hR4yIGQ&oe=6A09D1F1"}, {"file_name": "ss1.png", "id": "2387139718388251", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823876_2387139721721584_8078740659056084051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1u9fk30g8oQ7kNvwF7FoBm&_nc_oc=AdqNiZ2eW6o1vD11rrm_k0cwv6PFkGtha8D4gdX_iIGLtjJ3PzhefRC4XeaV3pEEXNc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dsm2U-3_O4l0EGkuN5y33SSSrn-rYH5aFKF1YaNmn0w&oe=6A09D6E8"}, {"file_name": "ss6.png", "id": "1428593229271696", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499303391_1428593232605029_5938411435250090577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuJbeOAYlfgQ7kNvwGsOxP3&_nc_oc=Ado8y6gSPcj8rbiIlerfq9sz9Sn_WWwa3dVoD5OpNXxAj0fC2LykWtdGvt5C-sjUMmw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HQWkr9d_cVo0KhPhGHxp1sXuS6QTUM_NblS76cpAVxg&oe=6A09DD94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait_trial.png", "id": "1960118271247357", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499292712_1960118274580690_8087766755488103280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts4KVdElvgoQ7kNvwEFbJk2&_nc_oc=AdpEl0gMCQ850IBNV60dViaYDShnm5ACWPUvUUNUAwxPQO561l_eKmtdFkZVT5uNiV0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wuXGb1U6s5o-Gt0plAWDzpH4SxDKf0Xjel3vRESeE5w&oe=6A09DF6A"}, "display_name": "Afterlife: Dead Zone Trial", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/palexen/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://sites.google.com/view/palexen/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35656653643933733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499292712_1803503063663415_8373701016445922040_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0YcJHkkQk8Q7kNvwHoVvbd&_nc_oc=AdoV4CE7j
RtYltmaFp0bhQ&oe=699DAE62"}, {"file_name": "mindMines_promotionalVideo_1080p_Japanese_oneFrame_2560_1440_4.png", "id": "691386823599896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394311_691386826933229_3789312818386651442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6akAt13gcEcQ7kNvwEcO4sL&_nc_oc=AdlSSmp7Lpr3hbcg3cz534hY0hMfAZSwn7LaBrAPcnl0_AqzqufDLkr9Aj0dyYlWsmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFr6XFqfdvaGNGjeFoh-u_fS7xlPFh4qPinpCO_GZL_w&oe=699D99B1"}, {"file_name": "mindMines_promotionalVideo_1080p_Japanese_oneFrame_2560_1440_3.png", "id": "1372531587417832", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393355_1372531590751165_7725477649691187250_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftz2Ot3EjTwQ7kNvwGXsMhQ&_nc_oc=AdmBQberdzpy4k8qroljqWzOfP0LMZXQ1Xqyy6Ks2nQbi5m_L6PcgmwdhE5VGtY5j_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu4j6_vkNGnST0KKwn2DD6Clz3sg0LfEmsicwK4FHtvlw&oe=699D9863"}, {"file_name": "mindMines_promotionalVideo_1080p_Japanese_oneFrame_2560_1440_2.png", "id": "1176183250953636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391855_1176183254286969_3223224147021911710_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHNHoTtBWFYQ7kNvwHAKCAJ&_nc_oc=AdnLDbaY02Goo9vC1V5exBqD3sif5zAReFFE1ANVN6BUb2a0k_bJL-HykzKY6MIv1XI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuIpcSBTmCmnacGmpjTr2ICWa6R-jDmhs7n_q13e3K5Wg&oe=699D8664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mindMines_promotionalVideo_1080p_English_oneFrame_2560_1440.png", "id": "2472894716384228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394150_2472894719717561_1349350748395277380_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuSCQZZIVawQ7kNvwFLQhsh&_nc_oc=AdnRb76Dsh02x0M7Q8ObtZS3KQSjnZ8eWjn3Yyrvr2Xq3wE2awjjY2R1XHU4HwuBEtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftpOpdtzjg3-q7hPYUtw8OExcPrjPQ6Z1itcrSuaBB4tQ&oe=699DA601"}, "display_name": "Mind Mines", "keywords": ["art", "halo", "jigsaw", "puzzles", "minesweeper"], "long_description": "Mind Mines is a pioneering jigsaw puzzle game that transforms over 190 pieces of artwork into interactive jigsaw challenges\u2014each infused with strategic mine detection and logical decision-making.\n\nThis isn\u2019t just about fitting pieces together. Every move tests your reasoning: uncover hidden traps, avoid mistakes, and mine your way to  completion. Carefully observe and place\u2014but beware: too many wrong moves could trigger mines and end your session.\n\nUse intuitive hand gestures to navigate between solving, scanning, and neutralizing threats. Each puzzle offers a unique interplay between visual intuition and logical problem-solving\u2014merging artistic appreciation with cognitive challenge.\n\nStep into Mind Mines\u2014and challenge both sides of your brain.", "short_description": "A jigsaw puzzle game where art meets logic. Explore 190+ artworks while solving strategic jigsaw puzzles with hidden traps. Mine with your mind\u2014one piece at a time."}, {"images": {"nodes": []}, "id": "991603876464073", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30de\u30a4\u30f3\u30c9\u30fb\u30de\u30a4\u30f3\u30ba", "keywords": ["\u30a2\u30fc\u30c8", "\u7d75\u753b", "\u30d8\u30a4\u30ed\u30fc", "\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb", "\u30de\u30a4\u30f3\u30b9\u30a4\u30fc\u30d1\u30fc"], "long_description": "Mind Mines\uff08\u30de\u30a4\u30f3\u30c9\u30fb\u30de\u30a4\u30f3\u30ba\uff09\u306f\u3001190\u70b9\u4ee5\u4e0a\u306e\u30a2\u30fc\u30c8\u4f5c\u54c1\u3092\u30a4\u30f3\u30bf\u30e9\u30af\u30c6\u30a3\u30d6\u306a\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb\u3078\u3068\u5909\u63db\u3057\u305f\u3001\u5148\u99c6\u7684\u306a\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u305f\u3060\u30d4\u30fc\u30b9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3
JGIOJof9LHYQ7kNvwG9VRXM&_nc_oc=Adrw3kdzj3BIOBmY3_eKsdCKIMJyFTeqsocgBRmhP1Bd_5SZcLYizUSW1d9dJY23weM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WCu7G0QOAjaRlQvkDV1aFmGIN82FXPRRG-rpl45YO9A&oe=6A47C8E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mind Mines", "keywords": ["jigaw", "puzzles", "mines", "minesweeper", "strategy"], "long_description": "A pioneering interactive puzzle game that fuses jigsaw-solving with strategic mine detection and removal mechanics. Solve puzzles by mining while minding mines. Solve puzzles by mining while minding mines\u2014every move challenges your logic and decision-making. Carefully place pieces, uncover hidden dangers, and defuse traps to maximize your score. But beware\u2014trigger too many mines, and your session could end early!\n\nWith intuitive hand gestures, seamlessly transition between puzzle-solving, clearing hazards, and even casting magic. Will you conquer the traps and complete the puzzle, or will the mines get the best of you?\n\nStep into Mind Mines and put your skills to the test!", "short_description": "A pioneering interactive puzzle game that fuses jigsaw-solving with strategic mine detection and removal mechanics. Solve puzzles by mining while minding mines."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e2KjI6-UTttNQvWISO9ozCVq8ka0xCkDzxyVMZVcoe4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "tanPebble", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1e2KjI6-UTttNQvWISO9ozCVq8ka0xCkDzxyVMZVcoe4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
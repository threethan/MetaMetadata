zzles", "mines", "minesweeper", "strategy"], "long_description": "A pioneering interactive puzzle game that fuses jigsaw-solving with strategic mine detection and removal mechanics. Solve puzzles by mining while minding mines. Solve puzzles by mining while minding mines\u2014every move challenges your logic and decision-making. Carefully place pieces, uncover hidden dangers, and defuse traps to maximize your score. But beware\u2014trigger too many mines, and your session could end early!\n\nWith intuitive hand gestures, seamlessly transition between puzzle-solving, clearing hazards, and even casting magic. Will you conquer the traps and complete the puzzle, or will the mines get the best of you?\n\nStep into Mind Mines and put your skills to the test!", "short_description": "A pioneering interactive puzzle game that fuses jigsaw-solving with strategic mine detection and removal mechanics. Solve puzzles by mining while minding mines."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1e2KjI6-UTttNQvWISO9ozCVq8ka0xCkDzxyVMZVcoe4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "tanPebble", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1e2KjI6-UTttNQvWISO9ozCVq8ka0xCkDzxyVMZVcoe4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "u
NztaH4IFw7kjw&oe=69A59762"}, {"file_name": "mindMines_promotionalVideo_1080p_Japanese_oneFrame_2560_1440_4.png", "id": "691386823599896", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394311_691386826933229_3789312818386651442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zagZKLT0NF8Q7kNvwH_MftD&_nc_oc=AdkHHlNnxH3A5bVY7IopB_H-nUjM-AhVqXD_LexVd9y-fCLvrURm_eOQShbDvA8Xh6g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvcrHzjujw-vtaycrGDpDGyZCKj0NyIhTJPA2Tg42xdtg&oe=69A582B1"}, {"file_name": "mindMines_promotionalVideo_1080p_Japanese_oneFrame_2560_1440_3.png", "id": "1372531587417832", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393355_1372531590751165_7725477649691187250_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOMiUdDVPCYQ7kNvwHjPaOW&_nc_oc=AdkIQUlgUPWg4fj1tbuxk7g6dm6jf64uSRi3gzXRoQLqEilSAcbF2r2dIVFla4YHCYY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftS1ddQ_qAgK611SLenGn85aY0nIw58cFOPt_G4yxxUbg&oe=69A58163"}, {"file_name": "mindMines_promotionalVideo_1080p_Japanese_oneFrame_2560_1440_2.png", "id": "1176183250953636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391855_1176183254286969_3223224147021911710_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seqOpuaDPIkQ7kNvwHgqKsF&_nc_oc=Adnjcq6Ns74T_36vLBo36eteJq6gFUtIEwNEWcakBQ14ObBfPlOKnBnhwWkp_WpNcWA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftICGZ2NgL5I7HgbtD4l59vtLF_lTE48Mlj4t8dt5uR5Q&oe=69A56F64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mindMines_promotionalVideo_1080p_English_oneFrame_2560_1440.png", "id": "2472894716384228", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394150_2472894719717561_1349350748395277380_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sa0P5timZPAQ7kNvwHINdIZ&_nc_oc=AdmKGIrvV1S9DSrC_JouGv94p7A-Ac1ecdHC-FiJoJTeTpOB39xHh5dkhq1Am-afrCk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aftq-NjlDLl2ZNMHSYYXmWocvZ7c90vih7iI05lYsX6dHA&oe=69A58F01"}, "display_name": "Mind Mines", "keywords": ["art", "halo", "jigsaw", "puzzles", "minesweeper"], "long_description": "Mind Mines is a pioneering jigsaw puzzle game that transforms over 190 pieces of artwork into interactive jigsaw challenges\u2014each infused with strategic mine detection and logical decision-making.\n\nThis isn\u2019t just about fitting pieces together. Every move tests your reasoning: uncover hidden traps, avoid mistakes, and mine your way to  completion. Carefully observe and place\u2014but beware: too many wrong moves could trigger mines and end your session.\n\nUse intuitive hand gestures to navigate between solving, scanning, and neutralizing threats. Each puzzle offers a unique interplay between visual intuition and logical problem-solving\u2014merging artistic appreciation with cognitive challenge.\n\nStep into Mind Mines\u2014and challenge both sides of your brain.", "short_description": "A jigsaw puzzle game where art meets logic. Explore 190+ artworks while solving strategic jigsaw puzzles with hidden traps. Mine with your mind\u2014one piece at a time."}, {"images": {"nodes": []}, "id": "991603876464073", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30de\u30a4\u30f3\u30c9\u30fb\u30de\u30a4\u30f3\u30ba", "keywords": ["\u30a2\u30fc\u30c8", "\u7d75\u753b", "\u30d8\u30a4\u30ed\u30fc", "\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb", "\u30de\u30a4\u30f3\u30b9\u30a4\u30fc\u30d1\u30fc"], "long_description": "Mind Mines\uff08\u30de\u30a4\u30f3\u30c9\u30fb\u30de\u30a4\u30f3\u30ba\uff09\u306f\u3001190\u70b9\u4ee5\u4e0a\u306e\u30a2\u30fc\u30c8\u4f5c\u54c1\u3092\u30a4\u30f3\u30bf\u30e9\u30af\u30c6\u30a3\u30d6\u306a\u30b8\u30b0\u30bd\u30fc\u30d1\u30ba\u30eb\u3078\u3068\u5909\u63db\u3057\u305f\u3001\u5148\u99c6\u7684\u306a\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u305f\u3060\u30d4\u30fc\u30b9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3
i": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974909_1665266960339745_7446919878184925287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFwPkEknE00Q7kNvwFFoprR&_nc_oc=Adqmy2xGdi7-iZcAXmVR7FXuhRMxziSAeoAIMvyCebDYc4Ds_epQQGxWX_8swzjInRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHAONVFgTzMW_TQ_5XHvOn1AAFehZ65Fb-ou81Re4zxg&oe=6A60AEB8"}, {"file_name": "3.png", "id": "345059557068571", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974613_345059563735237_7918039820258445865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9WVgLtDCnkQ7kNvwHe6Qw3&_nc_oc=AdqBWHDOTqHvWflf-SK1J8ICuUFC0RJNM4QcyPMfXG76cMVqSveAY5Ma75EJlUiIDFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGX7GJz4_jbqq4-OuU9Vx5A46PiE9HHvONvYHOjPn5Ug&oe=6A60BF3D"}, {"file_name": "5.png", "id": "2037415839741387", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974745_2037415843074720_1060134719188228752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJGYzFDzCdsQ7kNvwFD4sdl&_nc_oc=AdqBDADoK59KBLA7R_uQZsb0qhB_8ETwxcYRbHFRbr-o3gLAzwYO8WGAwQAiqVB_8AU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDASvGFgBK5Ijb4za5YtmZ1pU-MwYy2jq0YggoeFwKhCw&oe=6A60AC0F"}, {"file_name": "4.png", "id": "212670217300945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_212670223967611_7043830744742493088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9_rjfW022oQ7kNvwG9TkRf&_nc_oc=Adqyn9-7zLcYvbLwEdzPH2q1eONcKE8IeeXTZXlFmOo37kxG9JWLmkja2UR5rPZqO-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP94z_xSauq0ksl0DXjoMylSHS50pN_-cPrDN7DM1a4Q&oe=6A60B819"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Labyrinth deLux - A Crusoe Quest", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2910783819212743"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1197965038799488"}, {"status": "PUBLISHED", "id": "970801684964646
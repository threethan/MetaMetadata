i": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974909_1665266960339745_7446919878184925287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5RB6nXn8IsQ7kNvwEuzadc&_nc_oc=AdquOSO6CGm66PCLAXWi5X_3dx1LMr02PpwIHkUeZbbSchCBEFNGL32WbJcmaFKf1R4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2MnpF45wzs9HPAya9AELCCvELybKkUH19iK_2hR0WPg&oe=6AD39978"}, {"file_name": "3.png", "id": "345059557068571", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974613_345059563735237_7918039820258445865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH6uzdDmt8MQ7kNvwHojOSg&_nc_oc=AdoIeQIghqwFLfn1CTurMRLQfIJhxKVp6AiRq7skmnC3PlmV3_OKfeewgy8AF-CC_P0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaXKq-K1j1bRA4IN0OHYLtmlxTL-DBQCCWU0bN7vXpyQ&oe=6AD3A9FD"}, {"file_name": "5.png", "id": "2037415839741387", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974745_2037415843074720_1060134719188228752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE9jlOlP6RUQ7kNvwF8aqMz&_nc_oc=Adpi_hw1MHn8VWru8PtIubp_MUQNFZhj2M3WJNHcXZNd5dlqpWsUNiQlQJFIEz2WlGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWTbKdXQUJVaK88P9MRHZnsy4l2BLkVbQ7I1U7C-U0Ew&oe=6AD396CF"}, {"file_name": "4.png", "id": "212670217300945", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982586_212670223967611_7043830744742493088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y0zlju5NgYQ7kNvwG70eoF&_nc_oc=AdouXsHzIBy0y5NIePuXcyA0uIRh3WXn0tBa1hb53OAokYHF8AlCeyeBWxka49aJOYM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvwizSKB9143MbSkMhwZfp2lzCjYd6NJMjI2ql-X9P1w&oe=6AD3A2D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Labyrinth deLux - A Crusoe Quest", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2910783819212743"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1197965038799488"}, {"status": "PUBLISHED", "id": "970801684964646
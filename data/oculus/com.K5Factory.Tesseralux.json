i": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974909_1665266960339745_7446919878184925287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zsgUMcZ9hMQ7kNvwEZBFt9&_nc_oc=Adqrg2GD57xugbgkvnHGDIeC1DT8JYt9_hyoPFf3gSQXo5R2Pavozt7FwmyPAKlmHiM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPryZQw0Yxw8ks_8eQTWffgsTCqfqP6XzLw63uY1IV_qw&oe=6AC7BBF8"}, {"file_name": "3.png", "id": "345059557068571", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974613_345059563735237_7918039820258445865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYzSEjX20tYQ7kNvwFWSFWE&_nc_oc=AdqhFy3LAjYTcC2xp6fGJ61FwsPBS4tvkLP-bgW_hG-qkZIqaT2Gtqf8oDVLSzsTGZ4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjDj5KqhWFmYQJ5sutSLqyFXuTMm2ResdI53B6BHASyQ&oe=6AC7CC7D"}, {"file_name": "5.png", "id": "2037415839741387", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974745_2037415843074720_1060134719188228752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An3fCjahqPkQ7kNvwE9pVGW&_nc_oc=Adqdl-KNT4z7_0gSIlD7dCyOhDeEoqPR1GoNQZS0jIybNWGUe5tJ0yoTv9H9NHydKiw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfHPrh9fndFobwU9U8MhpL8fexiGWTso5HQFus3yqNPA&oe=6AC7B94F"}, {"file_name": "4.png", "id": "212670217300945", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982586_212670223967611_7043830744742493088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eka4ZMzg6noQ7kNvwGVXvyM&_nc_oc=Adqpw5vmO_9a0P2AzodnFvkGrE2NYnMuTiDAD9TlFntN9QifSr-QfXbkKy9xGjzXc1U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQWah9tS07GqeZCThwMiI6k8cO1FoO7N3ixcHY8iuGeA&oe=6AC7C559"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Labyrinth deLux - A Crusoe Quest", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2910783819212743"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1197965038799488"}, {"status": "PUBLISHED", "id": "970801684964646
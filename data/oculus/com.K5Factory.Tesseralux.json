i": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974909_1665266960339745_7446919878184925287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_FGz32_VKYQ7kNvwE6L5_6&_nc_oc=Adpuoo0yXs4e2YuZFXylKS8vh0UGheBCuh77XaLW9Kc91fK-jJZqWaaYGz8ltEhCzB0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xHy51n-ppHPT7iPy5h4r6if3oUru9qr9zXGuFClaImg&oe=6A0C86F8"}, {"file_name": "3.png", "id": "345059557068571", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974613_345059563735237_7918039820258445865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5gPJ-S2VQUQ7kNvwFgqr6n&_nc_oc=Adrc20dVGpM6i0ZwuIMpOopJN10RecrQA5ZjrdZFMqLNfb_x_13Sj5wZCU_JHbud8vg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zy_A2HN1NzK-Lg-aY-u_p-WSEdgG3LGf3pxlKsy0BCw&oe=6A0C5F3D"}, {"file_name": "5.png", "id": "2037415839741387", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974745_2037415843074720_1060134719188228752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox_s3kHQwDQQ7kNvwHX009J&_nc_oc=Adqj9uWnEgc8oDWXmMALq72lOyzJN9Bz3pbK4lwnSJgE3eipqEr3UvidpQkW9kfEMm8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WWoRRQmojWUdG0rNsroIpKGY3AuMvQPpo1gigodR6eA&oe=6A0C844F"}, {"file_name": "4.png", "id": "212670217300945", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982586_212670223967611_7043830744742493088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypR7N3Fjur0Q7kNvwE6WJ1B&_nc_oc=AdpzWQ7QtZ8RL4pPGGGg39fpxoMdfmw0NGLnNfX-FbSDgetdGn0kL4egRyTpYXAlH3Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xz1paOv0a2X70lV_E8efvrp1EjQMYodq59FxQSwTMZg&oe=6A0C5819"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Labyrinth deLux - A Crusoe Quest", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2910783819212743"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1197965038799488"}, {"status": "PUBLISHED", "id": "970801684964646
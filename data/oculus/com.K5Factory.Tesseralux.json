i": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974909_1665266960339745_7446919878184925287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkhORVcjrrsQ7kNvwE6aMLp&_nc_oc=AdoRRgByV_u-XTIPSfPkhGimckkj08EiP46T89j0iw4TVK3d2QeyI9NAtZtImsycryI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GpRXHbh5MqFNRVXsKl9gTz_f8-E_AFHvUyVLD6Q6m1Q&oe=69EA07B8"}, {"file_name": "3.png", "id": "345059557068571", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974613_345059563735237_7918039820258445865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzXpSv000LIQ7kNvwHppyz6&_nc_oc=Adrtu1HA2Dj8c7ib0PzMVSLzz5NXL-otnKqVpGdbCcw7hAiTV85H2b30fqI81QbUHnE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xhXaemheG0LB0qhuMGw8SOcecjio-gt_7zQZuWSz-yQ&oe=69EA183D"}, {"file_name": "5.png", "id": "2037415839741387", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974745_2037415843074720_1060134719188228752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyOhWAII0YkQ7kNvwFsvhLL&_nc_oc=AdqtmjgFZlGuD0vNwYJZXO3gF4V_jWUgRyFzijsPlTwBdPdyMkndy-dvUDuMEOn4SuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-VN72xkQK3n_L2JcUcEmG0qIoDqfD4Mj1BuVV9e5F-A&oe=69EA050F"}, {"file_name": "4.png", "id": "212670217300945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982586_212670223967611_7043830744742493088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1nOOrSPE9gQ7kNvwGIW_q5&_nc_oc=Adq0vlVzNwkgpvuDY16NFonb8MWld4FdjIfYB2KZIueqN0e2Spl3ATtPmdfSOoCX_Qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22FkeXI4NH7EHCifLWzw2els7UOoZhU3ndlEdx6nKETw&oe=69EA1119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Labyrinth deLux - A Crusoe Quest", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2910783819212743"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1197965038799488"}, {"status": "PUBLISHED", "id": "970801684964646
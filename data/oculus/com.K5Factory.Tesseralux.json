i": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974909_1665266960339745_7446919878184925287_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zuy7S-KzX74Q7kNvwHnyEky&_nc_oc=AdpjmZymXLAoiBv8YAAPlL_uWCKDbMd5-cLGiOvi4a876nDEgDhW9ECRuoyUwKGrDjQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9ayj8qe5HtXXR5vz78hD_VZ1f-nVTBsYjJOiJ0hSgjA&oe=6A5A1738"}, {"file_name": "3.png", "id": "345059557068571", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974613_345059563735237_7918039820258445865_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3Dc5HzilJYQ7kNvwFZkRbw&_nc_oc=AdrB7izyyJnS5fYV-4Ki4mK8AdSOg8NN_k0wY-zv320UQFLRLn-8NRvKknrIaM5Utpc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJWpSChiH91I5f7KP7XxoGDO4rZFi4G1lxu8F-AJMSfQ&oe=6A5A27BD"}, {"file_name": "5.png", "id": "2037415839741387", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974745_2037415843074720_1060134719188228752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLWJQIxqhWUQ7kNvwFxI_g6&_nc_oc=AdqJi_tbvordKOK6T8h4TR5bakIC_6Rb54KOa_EeWDdN2eaxOC_8rgClNc07qYW3P2I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuAARWWCke4avD6ELGay6E5lOWIsCOJl-1DReFbVSr2w&oe=6A5A148F"}, {"file_name": "4.png", "id": "212670217300945", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982586_212670223967611_7043830744742493088_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPKL8Np-6fgQ7kNvwGzCxFh&_nc_oc=Adq7-VmGUTrKZMudHe9a_PvD5Zj3RCkjXuwa8ZYZ1NUyK727ZuEoR2egkGaX2EkvRTM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIjHSe8B7PGQEsjy7R9lgjAOsXd3T5KutjcsqIFoaECA&oe=6A5A2099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Labyrinth deLux - A Crusoe Quest", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://k5mediagroup.com/games-projekte/labyrinth-delux/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2910783819212743"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1197965038799488"}, {"status": "PUBLISHED", "id": "970801684964646
-mJtZuJhO6Z3dbc6Bs-dmuUXw&oe=6AFF13DE"}, {"file_name": "10.png", "id": "679430656754997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982552_679430663421663_4974525742923759387_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8av_Ss0O3SAQ7kNvwFkYzD6&_nc_oc=AdpILI0Gfc2tl4xY0IvzzSwEyRGJ-gnLOO4iN0PToqp6wJhj_fKxC8hwei1LyP8k2fc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCisAxMYsAJvtExJe9eAb7pnQHRAflkdKdOckAiOEP7g&oe=6AFF10B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "444093537199144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572948_444093540532477_5622037174639662630_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaxpunBtaKgQ7kNvwHu7dzd&_nc_oc=Adpmx5kh96s7ILt1pYZApeuCJYlrXpA4iGxSz2Y-ShJkmwZHodFAelM4ptmnqk1h2qU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-UZDdUrgAzGAxAaFXP6yTwdCMk-p2tAeZ6p3Ew9-UPA&oe=6AFF2EF6"}, "display_name": "Labyrinth deLux - A Crusoe Quest", "keywords": [], "long_description": "In Labyrinth deLux - A Crusoe Quest you are space trucker Robin on your way back to planet Earth. By your side - your ever helpful virtual assistant Friday. \n\nWhen caught in a time-loop you happen to wake up in a temple-like space.\n\nThe only way out of this cube and to the safety of your space truck is to (re)align the laser and point at mirrors, prisms and other reflective surfaces to open the doors and perhaps find answers to your questions or to a truth beyond your imagination.\n", "short_description": "Help, up is down and down is up! Where am I? Why am I all alone here? How do I get out of here? Friday, help!\n\nLabyrinth deLux - A Crusoe Quest is a first person optics puzzle game set in a zero gravity alien space station. Complete the mind-boggling levels with a little help from you supersmart AI-Assistant Friday.\n\nBy guiding a laser beam past obstacles by pointing at any reflective surface you\u2018ll be able to open doors and enter the next challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://k5mediagroup.com/terms-of-service-and-privacy-policy-ldl/", "developer_terms_of_service_url": null, "publisher_name": "K5 Factory GmbH", "support_website_url": null, "website_url": "https://labyrinthdelux.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "442984268049009"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982535_243971984420114_8778648322213560633_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3kX5CENcvgQ7kNvwGueHbY&_nc_oc=AdpA-qw4xu54-7Th3kWiqxdmYw2EUehoay2Z87L-p2dMpXMp06HoEPdgGMQx9j_FNZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY-peAojDV0JxQtfuNxihkoMfJnA4o2Ryty1leAIy40g&oe=6AFF0B44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Labyrinth deLux - A Crusoe Quest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Survival", "id"
G-dBj5ZxZ3NUDP9W9XCYf59MljUhv_Q&oe=6A3D2CF1"}, {"file_name": "1_2560x1440.png", "id": "1881978885699388", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619774_1881978889032721_7074307334593883848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufgEPl-dIN8Q7kNvwGEAR3q&_nc_oc=AdoiXyJhbKchbrE8fe3HyjVoAYlkh2hKDz-pKXZS8CEzdiWlGsiapUKgNjNHhhEdyf8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FT_3Jqoelj6lliTTjCJfHBjLuj9_V4CaSpYnMdHmMEg&oe=6A3D4BB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rootie Tootie Western Shootie", "keywords": [], "long_description": "**Rootie Tootie Western Shootie**  \nStep into the boots of a sharp-shooting cowboy in *Rootie Tootie Western Shootie*, a fast-paced and action-packed VR experience. Test your skills in the Wild West as you engage in thrilling shootouts across 10 playable maps.\n\n**Key Features:**\n- **Solo and Team Modes**: Take on the challenge alone or team up for an intense multiplayer showdown.\n- **Authentic Western Combat**: Experience dynamic shootouts that bring the spirit of the Old West to life.\n\nWhether you're looking to prove you're the fastest gunslinger or just enjoy some arcade-style fun, *Rootie Tootie Western Shootie* offers a unique and immersive take on the Western genre.\n\nGrab your revolver, partner. It's time to ride into the sunset!\n", "short_description": "Fast paced western shooter! Play solo or with teams against other players in old school western combat."}]}, "developer_name": "Virtual Axolotl", "developer_privacy_policy_url": "https://virtualaxolotl.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Virtual Axolotl", "support_website_url": null, "website_url": "https://virtualaxolotl.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id":
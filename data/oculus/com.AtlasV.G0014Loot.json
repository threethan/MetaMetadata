zkp2S7jfE_Ym3A4XpXQ&oe=6AFC702C"}, {"file_name": "LOOT_Screenshots_4.png", "id": "1419129896753574", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831964_1419129900086907_3025592053615814940_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nI8GrZYxwIQ7kNvwEbLxmL&_nc_oc=AdodhofoCoaW4TDibIs25GcZkqG9YeokB7_nVmR27vHPf4tHU9xlP22W5hhpjlJp4UY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpEDaaJffu_jyHNOLkFb1jkT-sYEYwUxWmzPTf0vXu2g&oe=6AFC8A57"}, {"file_name": "LOOT_Screenshots_5.png", "id": "1714529097042134", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1714529100375467_5003321330287390530_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qQC5DHA3gwQ7kNvwHs_H3g&_nc_oc=AdprkEhajHs_C03YZ3fGQDu-qs_QKSEXLeiR0Lnxn0P0rdDBCHBYtJXatrUjoA_otg8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2L7FOuciij4A13dUoS0-FKMN9hBzA-rZANmgmYgFOvw&oe=6AFC705A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LOOT_KeyArt_Landscape.png", "id": "28949141044675861", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828008_28949141081342524_3338612277384494824_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgLdfHN2begQ7kNvwGbJQaU&_nc_oc=Adq9RqUFj2FYbkVl9fySP8b5-_tiyYbymGNmaNyk7wZhHJ9PMW4d9D_qByIbNdEc0IY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq0UPTLAMUxD2poxFoUufBAQax-jeYEwVkqygna3k3oQ&oe=6AFC717A"}, "display_name": "LOOT", "keywords": ["multiplayer", "mining", "exploration", "survival", "extraction"], "long_description": "# **WELCOME TO L.O.O.T** \nCongratulations, recruit. You have been selected to join the Logistical Outworld Operational Team, also known as L.O.O.T.\n\n# Join the content creator program & help us build the game!\n{1317072348153270}\n Join here \u2192 https://discord.gg/YqBs4JVrbW\n\n**Your mission is simple:**\n- Explore dark temples\n- Find shiny things\n- Bring them home\n- ESCAPE before time is running out\n- Spend your resource to gather more gear and level up\n\n{1379979817600951}\n\n#  Explore the unknown with up to 4 players\n\nExplore faster, carry more resources and help each other survive dangerous situations.\nTraps, mines, maybe even hidden enemies ? Be careful and just don't be the last goober left trying to find the exit. \nThe timer is always ticking.\n\n{1591993175964805}\n\n#  The more you explore, the greater the rewards.\n\n- Break mineral deposits, collect rare materials and fill your backpack with everything you can carry.\n- Each level contains specific resources that can be used to unlock new equipment, cosmetics and upgrades.\n\n{1594451095605577}\n\n#  Risk everything for more LOOT\ud83d\udc8e\n\nEvery run is a gamble. \n- **Avoid deadly traps**: The caves are full of hazards. Watch your step, stay alert and learn to navigate increasingly dangerous environments.\n- **Find safe zones**: Hidden zones can temporarily protect your team and extend your run. Use them wisely to continue looting and uncover greater rewards.\n\n{4029931060470509}\n\n#  Upgrade your skills\n- Better mining tools \u26cf\ufe0f\n- Larger backpack \ud83d\udcb0\n- Unique cosmetics \u2728\n\nIt's just the beginning!\n", "short_description": "Mine shiny rocks. Dodge stupid traps. Escape before time runs out. Solo or with up to 4 friends, every run is procedurally generated and every bad decision will have consequences. \nBRING BACK THE LOOT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/loot-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "45978150
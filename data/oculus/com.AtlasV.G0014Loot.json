luscdn.com&_nc_ss=7f20f&oh=00_AQN9dlN9hCnHwg5CVnKEi0Cmr7wGjSDkzh2dcj5K1U2NrQ&oe=6AC659AD"}, {"file_name": "Screenshot 4.png", "id": "826138013770138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310734_826138017103471_1122152661442292605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuVQm2-Zk7AQ7kNvwEYMS6-&_nc_oc=AdrCPRbPW8O8Rm6n7B5HaETT-FefyulM45jCzettBj6RUbUeSbg2NI-YaM5x9pNYtio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP7bQlTD2bYHQi0snxotZT44MBH_9oQkR1axgfnWvpag&oe=6AC65470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LOOT", "keywords": ["multiplayer", "mining", "exploration", "survival", "extraction"], "long_description": "**WELCOME TO L.O.O.T** \n\nCongratulations, recruit. You have been selected to join the Logistical Outworld Operational Team, also known as L.O.O.T. \n\n**Your mission is simple:**\n- Explore\n- Find shiny things\n- Bring them home\n- Escape before time is running out\n- Spend your resource to gather more gear and level up\n\n#  Explore the unknown with up to 4 players\n\nExplore faster, carry more resources and help each other survive dangerous situations.\nJust don't be the last Zgoub left trying to find the exit. \nThe timer is always ticking.\n\n#  The more you explore, the greater the rewards.\n\n- Break mineral deposits, collect rare materials and fill your backpack with everything you can carry.\n- Each level contains specific resources that can be used to unlock new equipment, cosmetics and upgrades.\n\n#  Risk everything for more LOOT\ud83d\udc8e\n\nEvery run is a gamble. \n- **Avoid deadly traps**: The caves are full of hazards. Watch your step, stay alert and learn to navigate increasingly dangerous environments.\n- **Find safe zones**: Hidden zones can temporarily protect your team and extend your run. Use them wisely to continue looting and uncover greater rewards.\n\n#  Upgrade your skills\n- Better mining tools \u26cf\ufe0f\n- Larger backpack \ud83d\udcb0\n- Unique cosmetics \u2728\n\n# Want to play the game pre-release, become a playtester and give us feedback ?\n# Join our Discord and play before everyone else!!\nhttps://discord.gg/c9ExCHy43", "short_description": "Mine shiny rocks. Dodge stupid traps. Escape before time runs out. Solo or with up to 4 friends, every run is procedurally generated and every bad decision will have consequences. \nBRING BACK THE LOOT."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/loot-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "35024660350512918"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1032645463099229"}]}, "baseline_offer": {"id": "1032645463099229"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788363720, "status": "PUBLISHED", "id": "1032645463099229"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38470934669218785", "version": "0.3.254"}, "id": "1677217996619123", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [
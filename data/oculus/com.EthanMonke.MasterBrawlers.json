uscdn.com/v/t64.5771-25/75236137_285150174174562_6643552473724958685_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOm2K0gb29YQ7kNvwFVfjyB&_nc_oc=AdoTWaPEYsawI6EdoeZO0PsAMfCZHS9g6WhDfDXwCby7kE7e0v0wZW1dA4hIB_IDJH8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_1cEWi0_ct4kOMypDc6Zw62ts9IvUmZQQ7_rFc-pHqQ&oe=6A36A851"}, "display_name": "MasterBrawlers", "keywords": [], "long_description": "Welcome to the MasterBrawlers Page! MasterBrawlers (apart of the MasterRunners Saga) is a game based around PVP of which where you can buy any type of Kick hammer from the shop. Everyone loves kick hammers and now you can have one! The more you grind gamemodes, the more you get currency and the more you get currency, the higher hammer rank you can have. The more powerful your hammer is, the more bigger and cooler it is. Play with your friends, grind your way to success, and brawl out until victory is achieved! ", "short_description": "Brawl your way up to victory!"}]}, "developer_name": "EMVRGames", "developer_privacy_policy_url": "https://www.masterrunnersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EthanMonke", "support_website_url": null, "website_url": "https://www.masterrunnersvr.com/masterbrawlers", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6807580679295759"}, "review_messages": []}]}, "cover_square_image": {
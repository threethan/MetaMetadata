ps://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_911824424662569_4905279978337774493_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=463DSlnpmQoQ7kNvwFsXrXU&_nc_oc=Adp_2S5TRM5wjx8wdNwFoTmu2v3tlcVM-vuHBP83npjzHXy78bafZzqEsvakJ7Fam4w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uTjnvGQJ48hGHXyHhSghtIIEkGoolocHFdwe2c2gwoQ&oe=6A170D6E"}, {"file_name": "3.png", "id": "1165938995451044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818890_1165938998784377_1801251895487769321_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3osrRohAFMQ7kNvwEMezE0&_nc_oc=AdpxgDbicytl4hJmXbGmapFVOu_K0oK5vTRpXdwNz1jWguHvzmaDx0XfJGecgQnZG14&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZrUWmfg1DEPiL7Q10uP8GGkrskfPLyFpho5KMKT5kVw&oe=6A16E548"}, {"file_name": "5.png", "id": "1426488009063430", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593845024_1426488012396763_7131242674793270315_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=856lXsJ0Bz4Q7kNvwGDLUrS&_nc_oc=Adqdns6rBhBE2RY6PLkI5z-88PLO9Q7cP4WJEsNTlTbJmvXHoUh9SGsioPzo2d0S3Xc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45Ly1oWHT4lm0-H04fATeF_1MxzDG_YA1Nl7DpMun8VA&oe=6A16EBED"}, {"file_name": "4.png", "id": "1546863556393803", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823286_1546863559727136_2324320528830419281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ-A2OGW4VcQ7kNvwG2FMxq&_nc_oc=AdqqBafQ-NjXXWYQLkmP21nBCRSB04CyAvdHqiC0CCsBOKAJ-x-ggbVf17YYkUfQMsg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ScA_o6rlK9Xcjh8xYypymoae34cy-W7S0lAMZKcVkeQ&oe=6A16E7F1"}, {"file_name": "2.png", "id": "2469791283535391", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823296_2469791286868724_2493724359226594904_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_l9i64CtVoQ7kNvwG8r7w6&_nc_oc=AdrwJPu6DgK49I991gFULDHUBKQNH7cmV3ccIOFTKXuI8SE1ztcaDG1eD9cpQSekNqY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-9E-DqHBOzqsq2Gkb-tomg3ShNgWvJX0n92Gng48pCA&oe=6A170DD9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermarket Simulator \u2013 Store Management", "keywords": ["Store", "Supermarket", "Shop", "Simulator", "Management"], "long_description": "Supermarket Simulator \u2013 Store Management VR lets you experience the daily life of a supermarket owner in full virtual reality. Designed for Meta Quest, the game combines realistic store operations with engaging, hands-on gameplay.\n\nStock shelves with products, organize aisles, manage inventory, and serve customers efficiently. Every task requires attention and planning as you keep the store running smoothly. From restocking items to managing customer flow, the game delivers a realistic and satisfying simulation experience.\n\nWith intuitive VR controls and interactive environments, Supermarket Simulator makes you feel truly inside your store. As gameplay progresses, challenges increase, testing your time management and organizational skills.\n\nPerfect for fans of simulator games, management gameplay, and VR life simulations, Supermarket Simulator offers a relaxing yet engaging virtual experience where every decision matters.\n\nOpen your store, serve your customers, and build the perfect supermarket.\n\n\ud83d\udd11 Key Features\n\ud83d\uded2 Realistic Supermarket Management Gameplay\n\ud83d\udce6 Stock Shelves & Manage Inventory\n\ud83e\uddfe Handle Customers & Store Operations\n\ud83d\udd79\ufe0f Smooth & Comfortable VR Controls (Meta Quest Optimized)\n\ud83c\udfea Interactive Store Environment\n\u23f1\ufe0f Time & Task Management Challenges\n\ud83c\udfae Easy to Learn, Relaxing Simulator Experience", "short_description": "Run your own virtual store in Supermarket Simulator \u2013 Store Management VR. Stock shelves, manage products, handle customers, and operate your supermarket in immersive virtual reality. Built for Meta Quest, this simulator offers smooth controls, realistic interactions, and hands-on store management gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27126157243654169"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819323_1847689789216784_2283453781025846792_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eYTpAM70skQ7kNvwGtrvRg&_nc_oc=Adr3R1a0snmRSwMvBECkUgXVialim3CJiUSl4m-nh1mlAueuciFmNEcnS1sqxmfUzg8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iyG0p__oLThe9xL1de5yybHnxUV5fJZpqLaQtxN1HWg&oe=6A16F95E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Supermarket Simulator \u2013 Store Management", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1771009500, "lastRevision": {"nodes": [{"id": "27126157306987496", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"app
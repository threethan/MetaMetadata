e8-2YTv61jsgvQLiXd_qg&oe=69A6DDC9"}, {"file_name": "Shot 3.png", "id": "1323891262452962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824592_1323891265786295_6894955731568607064_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR11XmL5Ne0Q7kNvwGVcMmB&_nc_oc=Adlpv_O4dh81TLKWeEkrxqHHZ3KK0uA6alqYThylLSDPwZty48Q8F0A6JhT9eNSVfJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIxHq7eLpbCG2JSpjv0fFZkKL9EePGN-Bfz8qOMsadww&oe=69A6CCB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Document scanner: DXScanner", "keywords": [], "long_description": "Needs to send documents? No problem, scan photos and documents, convert in PDF and share it.\n\nTransform your Meta Quest device into a document scanner and converter!\n\n- Scan any document, photo, or page using your Meta Quest camera;\n- Create PDF from your scans;\n- Easily export your files in digital format.\n\n# Key Features:\n\n- Scanner for documents and photos\n- Quick image-to-PDF conversion\n- Simple file export to cloud or via email\n- Intuitive interface for easy document management\n\nWhether you're a student, professional, or simply someone who needs to digitize documents, DXScanner is the perfect tool for you. Download now and carry the power of a professional scanner and document converter with you at all times!", "short_description": "Scan photos and documents, convert in PDF and Share it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dxscanner.dimix.it/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Flutter - Native Android", "support_website_url": null, "website_url": "https://dxscanner.dimix.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
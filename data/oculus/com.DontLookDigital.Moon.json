png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2RFz5BRYo8Q7kNvwHiYD0G&_nc_oc=AdqeeYX9QueNF8ozeFTrCYr6zuDHvibZxBJvSsakk-JgZL_DcYC5TvF27ZyRkOMi_Wc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1EppOoJybkdSE5__H-KRcuOtUmy9_PoYDScjdD8RG9g&oe=6AD399FB"}, "display_name": "MOON", "keywords": [], "long_description": "Experience MOON - a gripping musical journey through the unknowable cosmos. Built from the ground up, this VR experience will take you through eerie celestial environments guided by spatial audio and a surround sound adventure you won\u2019t forget. \n\n-Fully rendered real-time environments\n-Spatialized environment audio combined with ambisonic surround music\n-7 minutes of a gritty and psychedelic sci-fi journey\n-Sinister story of what happens when humanity attempts to know the unknowable\n\nCredits:\nCode/Art - Jeff Bull Jr\nArt - Trey Stimpson\nAudio - Dara Crawford\n\nMusic Credits:\nComposition/Production - Dara Crawford\nVocals - Zamm Kenoby\nDrums - Darren Doherty\nGuitars - Jeff Bull Jr\n\nSpecial Thanks\nHand Rigging - Jeremy Wynn", "short_description": "Experience MOON - a gripping musical journey through the unknowable cosmos. Built from the ground up, this VR experience will take you through eerie celestial environments guided by spatial audio and a surround sound adventure you won\u2019t forget. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1irUW7njChPPFH8sAcFzEr-ji7RzGh050kHOh_vM44Yw/edit", "developer_terms_of_service_url": null, "publisher_name": "Don't Look Digital", "support_website_url": null, "website_url": "https://dontlook.digital/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SPACE_UNIVERSE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet
=6e7a0a&_nc_ohc=K3P6welFZmcQ7kNvwHu18Fc&_nc_oc=Adp56hETbzNe5pCiJUUnbOc3TPUPKqdFpgjaqPNGVrwQ-37iCny7_s8voIROH4S_t7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2avz1A6yq3q9_5UVTbN3pItqLMXotl8jnsujEJzBLAyQ&oe=69D26459"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SKLKMqJhl8Q7kNvwEt8ZaU&_nc_oc=AdojrvRE5Ce-F7TBl44NI-64nBFMoivKWyDnfZQE2Bmq0xx4j92Wn9MXRkV04ZMhc50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KEkCBLsW61BTPQU6y070Bx_TskCZajAMImsYgpMoXxA&oe=69D27D3C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgj2svr63nUQ7kNvwFdvYrm&_nc_oc=AdqKBVQePPs1K-qmYxlgnZBcGmIqKyR4iQf0uDmaJUKjbSCaO-9WP3HG9V5OJrk9GfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LuNg_T6COOtBVz6X4LTffOJiTmV96VY9_WARaUUhEOA&oe=69D260EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape14b.png", "id": "1599564441030925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_1599564444364258_4606855648034192110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J60ZeGrkoo4Q7kNvwGEOdyJ&_nc_oc=AdpVgdyYW0uM8DmD0CYiG_-l7Rj047fyHqVWDyUrx7F9XTunPcJ1yK72CmTUuFa7P-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NRbzQCwzjKo3E1AlrCjmCg3COtTctWv2arH45lwtDbg&oe=69D24F16"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
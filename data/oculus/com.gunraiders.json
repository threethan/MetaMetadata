2_5120678057506923811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t13Kd5URB6gQ7kNvwHHYZ7P&_nc_oc=AdoBi8J4g4zEV1CU3KoTCZ2wlasO2Fj4WXeF-WwRHtlELbhMscQFalt232YUn_514Mc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T4BvwxWc7UFFVlDgPc5MozzINtAkliM9sJzs0Dif6dw&oe=69E38D49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "455588845861093", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031545_455588849194426_9104926709184244002_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeBZ_XAbQEgQ7kNvwHwshAe&_nc_oc=AdrbikcuojrdO-tsNaZ6jZq1OSCfx0I3FMnN1ylay5p6pgWpGNzyHJE5XBZCPs5ujqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29INmjV41v-zw_5DadL7mBMFI8T92_pUS550UzKO99NA&oe=69E38C65"}, "display_name": "Gun Raiders", "keywords": [], "long_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics.\n\nEscape Game Mode\nIt's a mad dash to reach the end zone. Escapers must use their skill and cunning to sneak or dash through enemy lines. Defenders must stop the escapers from reaching their goal at all cost.\n\nControl Game Mode\nTeams face off to control the capture point in this fast-paced dogfight gameplay. Players fight for every inch as they move into the zone to capture and set up their defending positions.\n\nTeam Death Match\nLess thinking and more action. No competitive shooter would be complete without the simplicity of dominating the other team.", "short_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy.html", "deve
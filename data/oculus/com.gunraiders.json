=6e7a0a&_nc_ohc=gkaFp9OxgUcQ7kNvwH3QmSk&_nc_oc=AdqlqmK7pY7QZK53YqCIEfXPKqXIrqAbbVTWlTWlnKOghr8H_MACorPa8RtVJJBDNPI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbINMvdYZVVV4IvsMRj-OP0s_RCw4hbEdl9wBX__OJ0w&oe=69C53559"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpGRP40MNUAQ7kNvwGizEkc&_nc_oc=AdpRTjIDUmdeuDDFCELpAVCNn4TUF1I3uhrt2tKgNNC40VpSYHI98tnSYbm4RkGQ6XA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqQVY6iNvLCjbe4v7SRHUtjetGWi64vQsAlMj5sYzwgw&oe=69C515FC"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWCSyukGC2QQ7kNvwEsED__&_nc_oc=AdpoMH516_frnpPH0Z9kD_rBrFtHTgDZIPM_qplKYRCRwfXiLajUMHKax7BZAVaDzyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_h8EYJhqUuZpAoFrZcJfHZqMqKPGxa4ss1g4ahw56Lg&oe=69C531EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape14b.png", "id": "1599564441030925", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619113_1599564444364258_4606855648034192110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCnVIbjMzxgQ7kNvwGCgViz&_nc_oc=AdrLt01b2r3XJZdskfIledgopOFaCtCnYwzimO8UqWL_JgtK-zys9tMjZ4LqO3TLX1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymRgjj8UUF0Meb2u_w14z_eKloMJPDTsfDAr7NJTRwRw&oe=69C52016"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
=6e7a0a&_nc_ohc=gkaFp9OxgUcQ7kNvwGEUbIw&_nc_oc=AdpdrzHa8p3EpgjxyECy41K6WlVFPxfQKKUEmP3lOcnqCeqvr-KvH0giALqANo2Zsm4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMlsHSWDhjFzgqq8aSFooWDSoBcjtyo5vsEgzdpQNV9w&oe=69C29259"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cen3oH8HUJ8Q7kNvwET_f2L&_nc_oc=AdruVA1O2-DdEH7PorJmnHfP0nrpbNHTNzmJEPnQYfOIGBKe9MIysi7rsLG9Hzlv3S4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzl-aBjdToNudntMmlays54r2GzRmz3QIgXPl1W5y0mfQ&oe=69C272FC"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-2eQHG_tf8Q7kNvwF5GkKg&_nc_oc=AdpxICNM9GxxRn8aCUOU1Aoek1hmPK5TgRGP3QRIRFmcEIlunT-XAEO7wjcWVz-1OK0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsDhpl_pdPY_3IRrLjK1M8596Ufm9JDp3M8UGADa5CcQ&oe=69C28EEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape14b.png", "id": "1599564441030925", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619113_1599564444364258_4606855648034192110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCnVIbjMzxgQ7kNvwGx2vPD&_nc_oc=AdoTTGp4iLVkLhqTAQyCfZQC6QXSmyuMDzN4VWzg58CtM__9JbPqUMMXpiz7a4rC-9k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAL4HiGbJfKEGSPY4fXY5u_BwdzADgW5KlXR5KTkgu1A&oe=69C27D16"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
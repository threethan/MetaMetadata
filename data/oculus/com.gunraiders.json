2_5120678057506923811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edVoMX78QIMQ7kNvwGsTG4e&_nc_oc=AdqU7d2UHT-FrBVeG8oSkYP1xwmUHXHkQNx386ICWiG8-ghf74eYLGKOjcnqgG51tiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jviVWHDNFPVbxQIDbE9zTN4-rvoLugpsCYi2k40n1Rg&oe=69DF98C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "455588845861093", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031545_455588849194426_9104926709184244002_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfaP8kXJMBYQ7kNvwE7hNdN&_nc_oc=AdqbVli0OD68AYwoqW8Hrv6Ds5q39TSeduYoZ8yYh2B165hIAJKeLXCd2sbV6tI5ZeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bD5wpsHt39yd-d_HOwR1M2WboTSVOLd8Mlndf6T8Ogw&oe=69DF97E5"}, "display_name": "Gun Raiders", "keywords": [], "long_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics.\n\nEscape Game Mode\nIt's a mad dash to reach the end zone. Escapers must use their skill and cunning to sneak or dash through enemy lines. Defenders must stop the escapers from reaching their goal at all cost.\n\nControl Game Mode\nTeams face off to control the capture point in this fast-paced dogfight gameplay. Players fight for every inch as they move into the zone to capture and set up their defending positions.\n\nTeam Death Match\nLess thinking and more action. No competitive shooter would be complete without the simplicity of dominating the other team.", "short_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy.html", "deve
c_ohc=MjQ7of7_SLwQ7kNvwGe_NR9&_nc_oc=AdqpxmwPT_bMJcXO95Cz0edkhgZG47V9fZ5Dvl5QfCdW0eQVUcVr2OV_gFn0DnU-kfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAbFrb57D3uu35R9yeqzBP1rxwGGm2byTOt3Gxip7bUA&oe=6A6A0565"}, "display_name": "Gun Raiders", "keywords": [], "long_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics.\n\nEscape Game Mode\nIt's a mad dash to reach the end zone. Escapers must use their skill and cunning to sneak or dash through enemy lines. Defenders must stop the escapers from reaching their goal at all cost.\n\nControl Game Mode\nTeams face off to control the capture point in this fast-paced dogfight gameplay. Players fight for every inch as they move into the zone to capture and set up their defending positions.\n\nTeam Death Match\nLess thinking and more action. No competitive shooter would be complete without the simplicity of dominating the other team.", "short_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gun Raiders", "support_website_url": null, "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
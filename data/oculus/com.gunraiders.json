//scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOcrSl5SjH0Q7kNvwE7CW6R&_nc_oc=Adqpx3rC41OrPvqDob1wMtwPGBlQllr2GzeRBRpzQ3Onb10eGseBojZNAKaBrnUJ7go&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7FTV6nx2J10mJcf3QbUT8BarZTst25oii31Fj_GzxmQ&oe=6A9AC859"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWEAAO7AsXIQ7kNvwGKottv&_nc_oc=AdpOSQ-Zs13aGqKFtJ1yUL9YduxiBZc40R246jByidtb3FE08PRKg3JOxfLQfPX0rbE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8IYsq8gxYywNpKCcFINfoCHJfL8fmFTkF_0R8rDUblw&oe=6A9AE13C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1VY79gHrMUQ7kNvwEcFpu3&_nc_oc=Adp8hiUDGEer-UUFBNEo5CA4FxMCSdIqjAEonuUzn2oO4hW4OHvjISBqxwLEGuuVUlY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBYEBWWkFFN0VDDZ7FEOCpD2qsA-fuLTWjbUUHlDJTHQ&oe=6A9AC4EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0CTegajlEUQ7kNvwGCoqbL&_nc_oc=Ado9WViAPks9gavXjvZhR3qM8u-BS78xWaNWY9xkOYXMWxE43j-9cVnDwTDQk2vauO8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8y7VZfyKKYTU2i8yYT6sMMOyO-qeR2P7IsCOfxZ423Q&oe=6A9AE7A4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
//scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvWPsa66Rs4Q7kNvwGWtuWg&_nc_oc=AdrQy_IqHjT1Gn0B_bOG8oM5KhCQU3CIOESMmBao1ghkNsn2scLekp7bEqH1wwJFyks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiR2_-sZ_lMpB3hoqKMc8phqkhwJ__IREp8546uC_YAA&oe=6A8701D9"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt8C_5KLA8MQ7kNvwFlpdpT&_nc_oc=AdrmrwNFdHYvbdZNdlu2xrueJVGsqJtH2zxGu5LyrJQQv0psh56Qury8Ux74K2WIGzc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEQLtPyhuY3RLIT44XlzP1CrzHoSAAzH5vhFOaaeK1xg&oe=6A86E27C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WCL7YQyuZAQ7kNvwHTMXWn&_nc_oc=AdpOKkkpUbAHBh56S2whJ6x7QxOcUolUY7pRNblgoQ1u9sqPl4qcT7WVFSr256FsvCY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRb0711LzlCjRaRz6iWLLFGu9crqsLfke1k-8TSxHKyw&oe=6A86FE6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-yjmbG86xIQ7kNvwHeo9Hw&_nc_oc=Adp7g0jsdxP-ULBzdKGF4jhZpDb7yptEJok7mrSITBGDUEyNjyno9z2wrK4rThPF9ng&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF80OgbiXjS4F1RnYQO_iFqYJqeDTLI7mnyBgHZ8VXSzA&oe=6A86E8E4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
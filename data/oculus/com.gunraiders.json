https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Uw88tHbrWUQ7kNvwHtuoeO&_nc_oc=Adoz9PLOKMjjLkALAA9FQYAlvIWMMf1vPzf4WqY040wWn6FRdRGQs6LHu_yl39ws-zc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqAEmZUB8dKDoaxM6U2qiYSzOl6AxYEGxw3hekC-M_dA&oe=6AE5EDD9"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohVcMnEwVWIQ7kNvwGguYHG&_nc_oc=AdqcNNRL92NgTaoUvxMCiYsQyHH7HF0-piXdN1TWv6jZfByT5LNbI9r20wKFo6IW3g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO81GgPux0m5S6nLBL0v4Oe3B4X_VALNkdmbIOGEU1TTw&oe=6AE606BC"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRkuUklq66QQ7kNvwG7_OJX&_nc_oc=AdrmyExGa9R4g81fmPTVtKI4jMt20k-xnQFwpU1_67-PEnXu5LzGQZIn-goXzS5QeeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzikOwY_GZD4MQRuh0RbNxWN8hzrRZYCbM9CruDXR6cA&oe=6AE5EA6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape16-4.png", "id": "966137819376987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622192_966137822710320_6874748722881026702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXNtlyLuqxoQ7kNvwGx5Uaq&_nc_oc=AdpJ6HX-42FfyC3fqcoV9JjJnAg1eYeJQ9_QNR3YBhUHs3_nvVfSloGPZGdXpalDKfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRTbERMFkKWAlUSJ5lKKz9hkcKxG1HKoROXWBie9uIQw&oe=6AE5F4E2"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE
//scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rEcVrO7HEwQ7kNvwGwmmPx&_nc_oc=AdplO0OGACB8p0Qazmni8b3XS4ye5Ff25LidySFr9DbtYKMvZ0gqRPKIfo8l-OmAEiA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvEX8cB8SdCVkEIfRhP41Jf9AetXrgKdnWE9lGQ8f6sA&oe=6AC79B59"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4qi1dje2LAQ7kNvwEsAdBJ&_nc_oc=AdqejkHlujqjvxC1tP2B9GFddqQimAFaCfYdthw-DGolIT54PUH7x8X_4IiebNqI_Nc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-16l9fP8nBEr34OOJO_FTet6BA8orWPNwgf6j3HCwcQ&oe=6AC7B43C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtbk0Z5iBIQQ7kNvwEWHGaa&_nc_oc=AdpheMYjRrstGQytcGyPtcYbGgIqj1-mQVUhKUsG2GzlzUgHBbrF61nKCb7K1ey2Stk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUjQ9yd0duiCqGG17mUORZun2dyzWTMDBtcBNU8owiHg&oe=6AC797EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ8ifW20HpUQ7kNvwEhpiBO&_nc_oc=Ado79Jm7Br8vqasVwX9TLWLkcf9vuzC6P17Csur-0zQeE0FXPTpkd0T_9-gd0rFDs9k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3WyxRPJs3-zMF0VYsQzg-x8JhIatoxneEM1g-MwE94A&oe=6AC7BAA4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
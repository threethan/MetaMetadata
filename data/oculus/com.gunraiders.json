//scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1eD5swBWw0Q7kNvwF5o3ec&_nc_oc=AdoDsjTOm4gjj2k1HE9D0Ck7cSE9euVGNeZM1GLiNySnqPQVYaU7spI6-LsmxMScmN4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2ZtmDy2tmUiHfhqx4W54grqArwSViqu43RAMv4IUmmA&oe=6A974459"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVEjTjuDRTYQ7kNvwFquMg-&_nc_oc=AdrrsqdCYkMjii8xh6L0EB24T0ucw1qYohI29O2xY6kZmAOYs2WsRgwnRmYWT73hnak&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3TgyBdZw4YrLdq7ZLGE8mPK-BllQVipeug8uX5GwgeA&oe=6A9724FC"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtD97J2wkRIQ7kNvwF9Wmuf&_nc_oc=AdqFfS0RSF1UxnI7jGJH5mmK_E5Mp2XOlrUo8gaLhV2Uaf5LZpAbWMjHGqmyAv4GZjE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE8soRSBiOfhYKU6PFOrv5gs8LUw3VH45uHHqBHcQpBw&oe=6A9740EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C3h3lJ9ai8Q7kNvwGOgG8D&_nc_oc=AdqvkEo-5J6dbKHWcCxEU1VHmnbGHsm146Tt-Z3tDYX5s9wyDe4VA-iLKAn2fBIw1Rs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnjN83b9svbm0Up9VrjB7L8kxjS9SoToqKOLzd-7MO_g&oe=6A972B64"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
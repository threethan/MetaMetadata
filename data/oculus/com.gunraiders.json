96351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031478_541348203429684_4653371359682447989_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZghmHTgoSMkQ7kNvwH3R9zj&_nc_oc=Adr-7kj5bXl0RyJIbPIXYKv5AJ9w_prD3EKNNwEKMm1ezmBT9HRaLQ1ApWQPhDXd_kI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTP0oK-5Un3jr2GAx84m4HP014uggz2d-9O29CE4p67XA&oe=6B0C5862"}, {"file_name": "Avatars-Screenshot-2560x1440---final.png", "id": "254814509564016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031391_254814516230682_5120678057506923811_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glC4rM3Xy5wQ7kNvwFMreFI&_nc_oc=AdpuXTIlT7beu33jHCdD-hLOAlAGcd6HFctMD-CTt1qAmDVQ5b4N34gV0YuknHyDnuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1O268eNDjtoO_A54EiM3Bc7c13r-oD1G1EtF2QNfwNQ&oe=6B0C6709"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "455588845861093", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031545_455588849194426_9104926709184244002_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WJPqBkW6Z0Q7kNvwHuOeIw&_nc_oc=AdpTdiN0doz0x-06dT-buDaSszMPQAB9Q7LwzX3Rn7FDukz42LM_-g6tvLUJoz8btWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0ie4BTp3IQfmvwowiC96B_-0yX6F6o-tmFHO5P6oCRw&oe=6B0C6625"}, "display_name": "Gun Raiders", "keywords": [], "long_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics.\n\nEscape Game Mode\nIt's a mad dash to reach the end zone. Escapers must use their skill and cunning to sneak or dash through enemy lines. Defenders must stop the escapers from reaching their goal at all cost.\n\nControl Game Mode\nTeams face off to control the capture point in this fast-paced dogfight gameplay. Players fight for every inch as they move into the zone to capture and set up their defending positions.\n\nTeam Death Match\nLess thinking and more action. No competitive shooter would be complete without the simplicity of dominating the other team.", "short_description": "Gun Raiders brings competitive skill-based team shooters to VR. Players of all skill levels quickly matchmake into online pickup battles up to 4v4 and play multiple familiar game modes with easy-to-learn VR mechanics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Gun Raiders", "support_website_url": null, "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "313695437388589"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2253844468148194"}, {"status": "CANCELLED", "id": "341444213920768"}, {"status": "PUBLISHED", "id": "1750397385348393"}]}, "baseline_offer": {"id": "2253844468148194"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690857000, "status": "PUBLISHED", "id": "2253844468148194"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": 
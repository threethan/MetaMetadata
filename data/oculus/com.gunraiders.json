=6e7a0a&_nc_ohc=D4Iv687-kagQ7kNvwEIWjCM&_nc_oc=AdoNE0ebcoupuxDo3C2ewWFeDf4uv9bnk0ogit3izJ5FnqjWqFUX53uabyPh0oRTTeo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4gUwKB2NzexABlxZPya2g0ZbEJo8NxB1QebzTips0zg&oe=69CBCCD9"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEFNOytpQGMQ7kNvwHMFe2l&_nc_oc=AdqHGi_aNse-FHjpI-XSq8XPLntL0t2G78_iNskodqmq36P9xvzq4JsFksQeXB7BMOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBfsepuUEqACsuTNwPnfTsH9AQM8i_iyvzHpivpbHwTw&oe=69CBAD7C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c181hvm77J0Q7kNvwGG--xa&_nc_oc=AdpEjUeu-RjIipyozTh1IxjY9NvYjxRIz7FBXJsHgX5PgjXa7kzEiKyEBXBsjJgsSJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9S86uV8x_JIjGPBoFTblIkN5gNeJYKSFiqQr63wpuAw&oe=69CBC96E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape14b.png", "id": "1599564441030925", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619113_1599564444364258_4606855648034192110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ4skwKqUS0Q7kNvwEtlPue&_nc_oc=Adqp6M4-c5sdJG4AGa6hJQuw6hb03gid4zTYm-anGxbQ7a9mJIBvaxtD8QCjYZV8pRQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcUVGDiAClTQi1xtAs7R5MH_gsgaKDcewM-IGHUD_auQ&oe=69CBB796"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
=6e7a0a&_nc_ohc=vth0OA90W1YQ7kNvwFYEWFD&_nc_oc=AdoHTv-7OoUSfk8l_EHLtPRzr86KJ2ZOrV6-mU5RtMsvckRKTpYnyJBEI6VBtsmedwQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSVZu4mBHXvgNxeVBQAHIMYAPEyRWLo6I6W80oaZ_xrQ&oe=69D112D9"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SKLKMqJhl8Q7kNvwEBEf3E&_nc_oc=AdodZoziT4xl-IY6olp7uYcEc42-2_FEkgQqiN1Ti9xZ9LoHH6oPVteNQPX4Hc-TYv8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7FmqzO-_AUwp3X7WrEOaOA93JYcY2OeIATFeGJtDerA&oe=69D0F37C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgj2svr63nUQ7kNvwG7EP4f&_nc_oc=AdrxngqvzsVTlWrO9dG5ulQvLfRU30JiiqPtcDXnN5GCMIiVsSyT4nnHFkQ_V6joUfE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8-qnYCm3VM-QeMbAH2I3K-EkXriGIjIOBdjhurLwmbg&oe=69D10F6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape14b.png", "id": "1599564441030925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_1599564444364258_4606855648034192110_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ckr5J7V6FxcQ7kNvwEz8Fu6&_nc_oc=Adpo9ySpfz8JMsmIlCfsmErfAM7-6oFgSOhU7eqD0x379g6RgEiAmn50XOeOfMz6t_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtQM-ht-5rpmQBGq0q33_Zwmmtoi2dfg1II3Lh6dj4Gw&oe=69D0FD96"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 14: Neonight Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
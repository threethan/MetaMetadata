//scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFskuqZ1UakQ7kNvwFUCUve&_nc_oc=Adqt90IBkkc0FOtL8mVcNNDFiGc1YfY8dXaMvP2GAm_eMPNCD0d-R1YP8z_4OPUDdWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcx3Km25ZidiGob8WJrh5FeS1XrJRFKRr4kMGOEBcpRg&oe=6ABFB259"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbvQFHc9AJwQ7kNvwE3n2dC&_nc_oc=AdovSoXVnt_C5XinZ5Rst37GvOCqJxlkA15nNz5qtbX2ifeexo4J-iDlWYKHRACnFWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFC2oiYvmmWM69WNZqoj-cL4oJ1dvlq5uiaQn_wZftaA&oe=6ABFCB3C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD_7PIhfXbsQ7kNvwFjy7-v&_nc_oc=AdrnTq77milszhIopVzG_-m17d6VoCEpFGZ9kulvivr1OQGErQzz3pPgqZD11YVFOrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYGEM5cj3H-Tc4XcTsM3Lv2ICH5E1tLrJs-i_axyj0xA&oe=6ABFAEEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aXoWMQhdAMQ7kNvwFojO-s&_nc_oc=AdplHdAXWD4YcEfxeUnwSxraHwvwdKFyOB17polMTkG1fnPtHEhsNc47dJ-SFO1yXeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFC5w4jiIzyRpzOtTbJSRoLQKZP-LKQvRhnrZgbUkdIA&oe=6ABFD1A4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
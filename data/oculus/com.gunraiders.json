cb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAlv_mJ4NOkQ7kNvwFV6lTF&_nc_oc=Ado0VyieTcSNjtrRHOvML3wywmXbxTVO0UuedPA0C4HA54aeMz-tre3pIogJMOZ8BW4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lxfC9QAMSEFS_lsyW4L03X0myq2ag_8r8PQwCP3U6ng&oe=6A369659"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iba8HqqG-T8Q7kNvwGy2cE0&_nc_oc=Adoh6RisoXAV0P8anmSqA5XSe6VE7Wk-003jbajxeztmGsOADY6Ih-JIuMAvn7HR_dU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BoxlaO8PiRzUKUTljRnpobBBvyoym6iiAbL43n7oYUg&oe=6A36AF3C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9ECELLCOTwQ7kNvwHFLkhR&_nc_oc=AdpZjxKnUK6bxWuLF4XuaUYQVwGaET3buEwWVN_T8fNIVNi6rrC3zxnyB8EIkqXOll0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xUaanDzYzsz4Flf_EnvWlPUphPtEWJfXt159ooH0Ubg&oe=6A3692EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOEbc3yYNfYQ7kNvwEFqkpk&_nc_oc=AdrplmTH6bEaz0U1_AzuETfC0F2O00l6-3_pvykmES-Fb02ySyvrrfrcRjKE9Qz69Ks&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Uf9eza-R6de7UnmeENDELTnCg8HMqUFUlwh6DUN4sw&oe=6A36B5A4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "con
//scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1eD5swBWw0Q7kNvwGkuBFO&_nc_oc=AdrAakHR2L_hZnsA42J2_UvtZ28NtWO45j4Nk6HSyAybBLCIFtq2u7mqUfAVfThYGac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhWIR1PKwvRlOl0IeK6lgezsd6tumdOKyakCFdooCWvQ&oe=6A95BA99"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVEjTjuDRTYQ7kNvwHFuzHZ&_nc_oc=Adqv9D_Cqdc315oE9fj5KZX4gHcCmbKwi_n7nCZl6C9FHG4llQgRWbEOF2bMHjrHQFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ6IrH637kHjcIMS94qsFYZVD1SRpW8XzQyIlY6yRC7g&oe=6A95D37C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtD97J2wkRIQ7kNvwExPc7U&_nc_oc=Adpy2FczqMCwsyy1xMT3rKF7X0YeHtjEqSF3kCC_cIntIku15HdaOyFH0KygiwRkY5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2HAZ0Y-8qozix0rHi4UQs4vlN3N03nUQTATHVYNJoQA&oe=6A95B72E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C3h3lJ9ai8Q7kNvwEOkCDi&_nc_oc=AdqmzffcvP5qmT7wAu_jMZbXjDFLOu46ANiPCJpxsln97NIbf68ngWI8hRtb4xm83uw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXluJaJ2_D6zIqx1k135Op75beO1ANV2QIQlZEdchsHg&oe=6A95D9E4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
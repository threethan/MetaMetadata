//scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdtLgq6vNKYQ7kNvwFGrJHD&_nc_oc=Adrk0ynieEvS-2AY5Bdx9cqSmOViVb7zCcMGYYAGe4sasu7eGlfcuOsHh5yIov93zTU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNPXsJOMtm_9VynS_a9-1THYXi96Z0Ndan4Bl-4Kfq3Q&oe=6A660C59"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2v3gmUfQsEQ7kNvwGmpZmu&_nc_oc=AdrnVgx5svh1F_Pdf6s6m8ldZBdh578hg0WfFew2Xwl8SgPbAUgzHcyJowWQk1sMqio&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzRGNIFYdeeNwEC8Lhm5qj6tP_9R2AZYcm-XqSiQtIrw&oe=6A66253C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ZUKSil2uwQ7kNvwGBMYPv&_nc_oc=AdoRUhqGLNvV1CEt0MSLMWjxHcY4KBWy94PGCp_a6XZhelFPf1zMSxqLJOw8NV9gxB8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUWhbWl0WSmTEhkMaaZQdgpdGSjtjJ0qq-BVpnEPI39A&oe=6A6608EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py6OIBO2FsYQ7kNvwFSQPz2&_nc_oc=AdrFPoicqCGhPTxHSLVPH7G2ar4q56NiDIJ0xqQHQ30JD2nCS8X_lclQaPfMi9zaTMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzdW8ucAY58cI-bR6uqx9cl6kz7hPWMtLbmN6Aefs5Bg&oe=6A65F364"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTw2goQLQawQ7kNvwFNCJCL&_nc_oc=AdoNrCGKS-FT2DK9xb3SzTmEPI7yawYkSN9cYPoLdXH5znkmRQJmNE_w1UV973dJH_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGUcZvhgZkNAHmBDi-mbDbzIUV7XhvJmYlNvcwpjIT-Q&oe=6AE73F59"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohVcMnEwVWIQ7kNvwGGV6kk&_nc_oc=AdqbofmXDuSbMfWvb1N_t4V5q9QKjCn5SJpKYaervXa9qCRJ72NpVF6RwxchsUC6el8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSajdd0mSDIV-1CqOtQjyO_DH5pOzFcyp-89vIlg4vhIw&oe=6AE7583C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRkuUklq66QQ7kNvwFHR6Xb&_nc_oc=AdppXuonBvrzfLdCQfxV8pxldYhQnvQeaksZcNEX3oeDCTQ8vTuhmnTsHYD_kh2ASx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6KyplICVIIuxBDsQBR1Asaisuqide71b7axzSMj_1LA&oe=6AE73BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape16-4.png", "id": "966137819376987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622192_966137822710320_6874748722881026702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfwUtB5lh-kQ7kNvwE5F2Zp&_nc_oc=Adqc--F3oKGCSfEha8ttZkCkBQd1MPikTRiOIDXObHSW22CyJ3Omt-bogrsCVmdi0uM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcd3oY_o-KDM9ViJyG0kGrr1aHvimj1H6RLH7cExcc7A&oe=6AE74662"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE
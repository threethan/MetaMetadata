c_oc=Adqv3HbrnQRGh6vdc8Fn-_OMuasWtvwqorc1Zd5STY9wNgq2_tVLmD1q-SmMMUGu0dE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyo03wmUesQiZTQGTD3bDsq_SmXhMMRqz2WGdSFDZDBg&oe=6AF9D982"}, {"file_name": "3.png", "id": "628545225778699", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s71AOuebWooQ7kNvwEw7cWk&_nc_oc=Adp57R427M-NScCvMG6SFfNA6KHOX_ehLRgrF95RAMzr5mk_VHQ0mNXXLpySqIRBerI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTebnMj-RR1KVX0BQ5y5THuNVL4BqJWYaJAQmwhw9OUiA&oe=6AF9EC99"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ElBO6MCwioQ7kNvwGd1D9G&_nc_oc=AdqjyYcKDGkatFuXuAdJ42qHI3Yn0nDMxAJ5v5IECbrPNzhxwbB7wek8MgsEMeQazX0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9WP8fSTms1768T8AQgwV6Mm8ccQKx-4oKsWjAlcIz_w&oe=6AF9CD3C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48pR8hKUivoQ7kNvwFCM2H-&_nc_oc=AdpqjNtQsF3zK_poTI8VjfZ7Rda7YOD90TESB--QJ2EtDuXpkKCh7UhLCJ5yGtnxtpA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSPZ-JptIcdRMuNd-bCJrzd8hFldmKwW08ypsAmVwEeg&oe=6AF9E92E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape16-4.png", "id": "966137819376987", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622192_966137822710320_6874748722881026702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kh2BW-TlgvYQ7kNvwFdg1aY&_nc_oc=AdrRyrPpW9hBChcfdej5YYGe7PGho3KClpC7OwjKGOS6LoQENhKczjFVWljSNCm8M28&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfG7eoSLjmY7MScNFmUFLuM-0hqkx7UhrdOFCeITHOBQ&oe=6AF9BB62"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_servic
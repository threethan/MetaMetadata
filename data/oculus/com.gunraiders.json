//scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YGhWnIkm4QQ7kNvwFcDx2o&_nc_oc=Adr0g1ayZjz2gT1JwkSanzCK3DScB8Zp9jJH7HFmlqR9YgvpKHhr_V6Fqtt-_tCRJ_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-a1UCwR9ODIw83uWzD8hNejL68e9R6qlfRqGHclGWeg&oe=6AD22759"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXsLNqR0724Q7kNvwFkYa6n&_nc_oc=AdrAOUK3KbwYU2kYvGRbJdEDpzH3OIJYIuzR6BKcKjZlDooVfGxhPtb2AjN9Xbm_e9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvYxEuNPCZttUHsGkyhO96AIsmUlJ442i3Eyae-5Zw_g&oe=6AD2403C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W32cjEAS0RYQ7kNvwG-9J4s&_nc_oc=AdpmUYrq1xb19bTO89ql8pIR-wyVjuciM3-xdIR8MylK4QmS-f2xWJvftx3JOZ-K9Cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIbzP3oUxOsRm5GEGJ4BKvsYkO6EkmvoKbYqiGR0aSZQ&oe=6AD25C2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljpsqO52N1gQ7kNvwH_Qkw1&_nc_oc=AdogFv69p1hB6CGqd40khMywOe_C3EkotTRLI5efUV8ztbgCHuJi6ZxScWxsRdVbHTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyiHQM5COdAtKfj2F4KMbexbSp8rK2_UPu8M6NdAPAyQ&oe=6AD246A4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
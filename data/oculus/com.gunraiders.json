//scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48trg8aDuO0Q7kNvwFZ-co1&_nc_oc=AdpxpAzqykQbRHAk04iaYEmbx-Bg2E8OrVrHjbQcY0hAWBc5noIk2mB1ogSFRuzPcK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA35A6KY5lUSFunSoyg5M-RZ0OKgTQ9kB6fNU5FtTW1aw&oe=6A6DF559"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JcI3vs0YUoQ7kNvwEnYxLl&_nc_oc=Adp6TIJkLWOrFE8VrjIvcDeFvYE-sRW-WK1MAQwQdT_Lc_O0s-96Xn36vmKZNs3a04U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpaLaEOpWGNpMN_U1L640iu4iUg3ip4e2fn0gIIX9uoQ&oe=6A6DD5FC"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRuygFHp8msQ7kNvwFPJFQy&_nc_oc=Adq9lvDT0Nk85gAuRVQKO58MxchIR5OIliyx_LIcdF9lybMyHPsUNd7pEJ3-hUd8bqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDccYSW1X3127G8Zm-cVa0DfAv50Ec6YMLV-HhpE4hy9w&oe=6A6DF1EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqYW31jvWBsQ7kNvwGhWppk&_nc_oc=AdofvxjaIYH-GBFyVZimfi_fZ7_s6cH6T0MkncgZw9QrhUeQ7rQ4YOUR3LGg2HXr5lY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-fr40oIJy61T5bz4zD9r_kJSvkI5dHPdPcSSVYCC5LA&oe=6A6DDC64"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
//scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmh3N6tRy9YQ7kNvwE4IhoC&_nc_oc=Ado2Y7Lc-n7wbUAm4zjpcyLWzT7k392j_Pnvinhz3iOMi6q25ASjhUluGNmXZr5Egvo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFul0oJgMYxgunOuNLr28s4FBFZfqZPADhrUmyuWSOzQ&oe=6A8ABE19"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx1E1ovPmDkQ7kNvwH_fdBg&_nc_oc=Adqy5-y0yzmn8uQxPwbHnpJNn6DRyyF1_4UMr2j-afyt2HvKuq3JeISWCs3YiAyNLBY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEp_nBsZ04fMP8rV5rmLZueHNzFJ_Fxtur0dPISvvcGg&oe=6A8AD6FC"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C56QOWUJqD4Q7kNvwGPjZ4Z&_nc_oc=AdpQH9mJvM4XCqzE5bBFBAPrpuVdsHrF06sVjxGv9wZe9S-K0btX7uMNfDKUTyN-73w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMGJzyJfwylzgvIXmzzJzVhbWrd1KJQmFQXOA4txwD7Q&oe=6A8AF2EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnnKGTv4V0cQ7kNvwF0wktN&_nc_oc=AdqsT06GzQYXJqSdIBM3OQTRHxyqevRIfihVland2lwHbh7db3i0V5GbjuFGzXDyL9c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK9Q0ISHG4nQvR6X1tbYIJ6y4XVawsIxMiURqjlDQgBQ&oe=6A8ADD64"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
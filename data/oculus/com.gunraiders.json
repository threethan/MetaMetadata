3kL_aLuGfC9yEIjbt42c62ur7j4PGH8E5w&oe=6B0C5E2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape16-4.png", "id": "966137819376987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_966137822710320_6874748722881026702_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsFTOOzp3zMQ7kNvwFFDu0U&_nc_oc=AdpF4c5vABNVwcU5bgOMnxroeDoytYSaUfZ_ODtQgRww7U1oFF7OvRFeQKpiY8rcCVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5lJIiw9z-Yxy3akKYUqena2qHa-rNYUQw-IG5l8Y2dw&oe=6B0C68A2"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "29336773699242447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619059_2140943039870003_3629979103416844621_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwl4AF8jehgQ7kNvwFXHRDg&_nc_oc=AdphinS35sa7g2Aki8qLeQNabOZ7zh5UNElNnmch9qcLGTXDjxKOi-2Vc-PbHg9tX70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeVMp9Ae42cmNsbHsOrGuEu5RT2wxYEPIK6rQ6yDrIkQ&oe=6B0C5188"
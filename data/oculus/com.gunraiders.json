//scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NBJG7yqvQ8Q7kNvwEZRDSB&_nc_oc=AdqTk0ilrQW2PqUXMvpFo1YLrQIU1zxDhZR4GwY5-ZGD0nEQBNpJ1ONoKs0_rbzj8og&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKUD2_5q5CBMCkpjUlnYl4DkkME5iqhGAfPvfbUmOEOQ&oe=6AA00E59"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hivlLLOdinEQ7kNvwFZvVqn&_nc_oc=Adq9KvKCI132pcIECPeyNsVr1XFGp6eDw6RcHIsIh_7vEYzszbyTOiq6oGTmWgYvTBk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKsWIUCQvhBhmqwv2DKgyHp4S8Qx2hD77agmd_ro0liA&oe=6AA0273C"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GApUn-s5CxkQ7kNvwHrYRbC&_nc_oc=AdokRfczRWjRp8lmWQvgJhNm_T1jCklpJgGsW4HFSjj1U-kUJ5cUodOhaCabxgCoLac&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1vSBBROluxiEC-0ioMIalsCq_PY6B82TZ5YSfqn56BQ&oe=6AA00AEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRlOVOi5kMYQ7kNvwEs86a5&_nc_oc=AdpTXz4mFzt3QRaUCMO5HgwPiC6lRSm0FKVaF0YGBonsZUs1gJVZ_MypU2uwOwwO2Xo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3V3Fb7jl6OqGi_pIcNC_tOjmaM6slzr3dqTdEwLiHDg&oe=6AA02DA4"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
//scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982502_628545229112032_59372796920943955_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIeutJatiX8Q7kNvwHOcoCI&_nc_oc=AdqCuzI0fkMv_I6kgczeOBmr6mBUUZg64yK0CzN221k8URIB2U4p9Hh-UN-lmYP6vgw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI33I5PnLh_2tPIKZGsDcfD2Gspv-7jBs7F8Vj0TM35Iw&oe=6A9C19D9"}, {"file_name": "screenshot_03.png", "id": "1425291524551710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_1425291527885043_1485679938715144816_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWEAAO7AsXIQ7kNvwGwYePx&_nc_oc=AdqI2frq_lMsYIxo63-gvC0pDcY1vdvPaTNbfARBkdcWgl3YLqP9hNRpiYZ57yG1nng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkye7KssoS47mPQVs7UMZhd2rcJNEopE1V-dY5UUda_Q&oe=6A9C32BC"}, {"file_name": "screenshot_02.png", "id": "664198874849692", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001687_664198878183025_4490375612060554755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1VY79gHrMUQ7kNvwE9b4f8&_nc_oc=AdpqLIqIKbb61aYcaYilMyzFe-kbixtTNtVqTh394jkDzPMpJvQE3HFyhXxOUUQpU3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF9mkIOU1wN4bvbq26vOxKFAt1J_0QZo1p0II91F6c8w&oe=6A9C166E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape15.png", "id": "1792914992113709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297283_1792914998780375_7658070507670402724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0CTegajlEUQ7kNvwHdZB5P&_nc_oc=Adq3K0ON253xu9QiHtYD4rvFDQXn-uTy6cdhrqLmt4iXow9YvJimZUUz-2L4jh2u-74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMJURQP7lo9Fpua3uKmhTYMncDnnwrd4cGt79bFydYCA&oe=6A9C3924"}, "display_name": "Gun Raiders", "keywords": ["fly", "fps", "multiplayer", "shooter", "climb"], "long_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins in the Item Shop. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, free Raider Coins, talk with the developers, hang with the community, or become a beta tester!\n\nBattle Royale\nCan you survive and outlive your opponents?  Test your worth in our newest and highly requested game mode.\n\nHub & Chill\nFor those looking for something slower pace, hang out in the hub with other players and make new friends.\n\nAssault\nRaid the enemy base and defend your own to score points for your team.\n\nControl\nTeams face off to capture and control the point in this fast-paced dogfight gameplay.\n\nFree For All\nThe go-to arena mode for instant action and a great way to show off your skills.\n\nTeam Deathmatch\nLess thinking and more action. The team with the highest points wins.", "short_description": "Gun Raiders is a free-to-play VR shooter! Chat with friends while mowing down enemies in multiple game modes while jetpacking through the air or climbing from wall to wall monkey-style! Race to the top of the leaderboards while customizing yourself with crazy meme skins. Now with Battle Royale and mobile cross play!\n\nPlay through 100 levels of loot in our newest Season 15: Beyond Battle Pass and earn up to 500 Raider Coins free. Join our Discord for tournament info, giveaways, and more!"}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_S
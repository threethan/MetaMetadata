a0a&_nc_ohc=iDnfUHsYgy4Q7kNvwGWf_2J&_nc_oc=AdoIhBaPdLOWLRWAurz_pyCkxl5vZ86MjEq5-7Rxut9WnnMp-0Fu_kH0K50bgha8PQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZvuw_rv3XNTI6gO4krHFtRek7HzRCMsHENAMjkl0osw&oe=6B0EFC2F"}, {"file_name": "SS2.png", "id": "1068208392582448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619369_1068208395915781_3401898572056878693_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UuRqJEM1QsQ7kNvwHkFFA_&_nc_oc=AdrMF78ef8d4AmaW_D8bDg7_vv0k02fPnXYK6pw8bon2nN4teKjTPnpIN77EA3lgcfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbHwb8Q_IWID8F4_ddfBbUxry2zgSpp2A3spPOyaDA2A&oe=6B0EEC5F"}, {"file_name": "SS3.png", "id": "1964484587588367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595112037_1964484590921700_5800905513001130474_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gB4bGWj13cQ7kNvwFZjWmd&_nc_oc=AdpprQ9lUnRrrI5jDLkrF0WUbedN7FgIWPfD4Qz2YfwX82qPfxHenTow-s0WY4tDs_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWN3fQG_m21UJpUc9fRhRwjh810Lv_pNlDHw64sKj0SUw&oe=6B0F146D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lakes Of Mongolia", "keywords": ["lakes", "mongolia", "nature", "tour", "discover"], "long_description": "Journey across Mongolia and experience 23 of its remarkable lakes in immersive virtual reality.\n\n23 Lakes of Mongolia VR brings you closer to some of the country\u2019s most beautiful and remote natural landscapes\u2014from vast open steppe and dramatic mountains to crystal-clear waters and peaceful shorelines.\n\nExplore each destination in VR and experience the scale, atmosphere, and natural beauty of Mongolia as if you were there. Travel between lakes, look around freely, and discover places that many people may never have the opportunity to visit in person.\n\nCreated as a virtual tourism experience, 23 Lakes of Mongolia VR offers a new way to explore Mongolia\u2019s landscapes, learn about its natural destinations, and experience the peaceful character of its lakes.\n\nWhether you are interested in Mongolia, nature, travel, geography, or simply want to escape into beautiful landscapes, 23 Lakes of Mongolia VR invites you on a virtual journey through one of the world\u2019s most distinctive countries.\n\n", "short_description": "Explore 23 breathtaking lakes across Mongolia in immersive VR. Discover remote landscapes, pristine waters, and the natural beauty of Mongolia from anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1665095135225250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595143057_935229646287346_1961418877279203735_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm4Qq8eMG7kQ7kNvwFfE1Uq&_nc_oc=AdpW7MaV81lp9F-ZxloJ8Lm_QZB-9WFk9IibnRrzQzJBkhkyZDDo5d1CkFKFIUBbktQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4wPt0RoX3OeJuDrIia_3oimxObub-zqEN741ujAnrsA&oe=6B0
F2PPmZE6IZKxkg&oe=6AA005EF"}, {"file_name": "SS2.png", "id": "1068208392582448", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619369_1068208395915781_3401898572056878693_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGuoEgywFlUQ7kNvwFSuRyL&_nc_oc=AdpSqyDG54wPPD7JFxiQAnxeiUcQSCpOw5--bpdZqQGEVCkBbHp7vFiB0YAEzPDK4gA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6uxDB6aVzpfzp8oearrw_qwLKWXmr9T5s_mXEPySb5A&oe=6AA02E5F"}, {"file_name": "SS3.png", "id": "1964484587588367", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1964484590921700_5800905513001130474_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMm10qAyqg0Q7kNvwGgrXYo&_nc_oc=Ado8TX8dP-rzDhB5P3-3b2XSUCR_UW1-pp5kz8pOEN3o-4J1q4S8l-agI4OlpF-4viw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFnvShnLLgeQuWSAApRI4EX8_FUWMPw32UTze8od29bg&oe=6AA01E2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lakes Of Mongolia", "keywords": ["lakes", "mongolia", "nature", "tour", "discover"], "long_description": "Journey across Mongolia and experience 23 of its remarkable lakes in immersive virtual reality.\n\n23 Lakes of Mongolia VR brings you closer to some of the country\u2019s most beautiful and remote natural landscapes\u2014from vast open steppe and dramatic mountains to crystal-clear waters and peaceful shorelines.\n\nExplore each destination in VR and experience the scale, atmosphere, and natural beauty of Mongolia as if you were there. Travel between lakes, look around freely, and discover places that many people may never have the opportunity to visit in person.\n\nCreated as a virtual tourism experience, 23 Lakes of Mongolia VR offers a new way to explore Mongolia\u2019s landscapes, learn about its natural destinations, and experience the peaceful character of its lakes.\n\nWhether you are interested in Mongolia, nature, travel, geography, or simply want to escape into beautiful landscapes, 23 Lakes of Mongol
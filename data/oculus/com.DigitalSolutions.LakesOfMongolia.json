a0a&_nc_ohc=l5NWEx6_ymYQ7kNvwHAMrH5&_nc_oc=Adr-osoYoKBQcYl9l0JBWKVcPVoFlahU7pueBwYGgltUYMBktfkre6EO1y42-Kaegh8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRr1TxU7xpfRGlcvOQ2MSC77Y3hRQ6i0alE_plWSb8qrQ&oe=6B0B3FEF"}, {"file_name": "SS2.png", "id": "1068208392582448", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619369_1068208395915781_3401898572056878693_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uuhz5-3TEVYQ7kNvwGjsWHm&_nc_oc=AdoQLmhmQ1SFYpAKtOvI-kmUbrrXG9Pf3qqaScEpD53DPw6RRMRCQddtyCqWuvvM2F0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoqM5f6iUFueebBI1awNVBdwOY1yoD9813T7cjtuJWuQ&oe=6B0B301F"}, {"file_name": "SS3.png", "id": "1964484587588367", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595112037_1964484590921700_5800905513001130474_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Qatt7UQhz8Q7kNvwGDAnCm&_nc_oc=Ado7PF6ivhm49E-zRyQlANJSYSqjOTbPeLwNNuHzQqOh0QkhNlA7BkJxc_JmSzSS-Uw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeeTLq6r5p7yEDSIyoJXpZlaGdKc5B57dwOAJi3jmrFA&oe=6B0B1FED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lakes Of Mongolia", "keywords": ["lakes", "mongolia", "nature", "tour", "discover"], "long_description": "Journey across Mongolia and experience 23 of its remarkable lakes in immersive virtual reality.\n\n23 Lakes of Mongolia VR brings you closer to some of the country\u2019s most beautiful and remote natural landscapes\u2014from vast open steppe and dramatic mountains to crystal-clear waters and peaceful shorelines.\n\nExplore each destination in VR and experience the scale, atmosphere, and natural beauty of Mongolia as if you were there. Travel between lakes, look around freely, and discover places that many people may never have the opportunity to visit in person.\n\nCreated as a virtual tourism experience, 23 Lakes of Mongolia VR offers a new way to explor
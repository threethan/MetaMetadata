a0a&_nc_ohc=0WyGmdbcCH0Q7kNvwFAETGf&_nc_oc=AdqQhw0nuYBr9v-bNGoyzjgC--FM8lyJld-PC2GTShKKehofJoTaiBbP7swgxVecOwg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEGPcvUU9TEiw2SXAxvz4_d1HZuFw9qHOMCm-lTAPUQg&oe=6AFC872F"}, {"file_name": "SS2.png", "id": "1068208392582448", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_1068208395915781_3401898572056878693_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_cdslc54WoQ7kNvwES7inm&_nc_oc=AdrmdXsipluZ3BvMEtOUKQt4-Ss_N4bIQR1FtQzt75nC2XK9BwlBenIytoAnlx9HlMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV8AriAxNj3WCpWIvmxgLGM7t_luA_iHgK-7CYvRL2pg&oe=6AFC775F"}, {"file_name": "SS3.png", "id": "1964484587588367", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/595112037_1964484590921700_5800905513001130474_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCJ2IJrS1t0Q7kNvwEgRIbp&_nc_oc=AdrkETKmCa1bq5vFOovJwZZ8hLOLhKQ3LVY0FuPS65NrJXiPfFKhuerQP6b3IZUO8zw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqWiY0FRZDFzv3eVPxjoNaUjLhSQ4IJKUX2O0Ab60kWA&oe=6AFC672D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lakes Of Mongolia", "keywords": ["lakes", "mongolia", "nature", "tour", "discover"], "long_description": "Journey across Mongolia and experience 23 of its remarkable lakes in immersive virtual reality.\n\n23 Lakes of Mongolia VR brings you closer to some of the country\u2019s most beautiful and remote natural landscapes\u2014from vast open steppe and dramatic mountains to crystal-clear waters and peaceful shorelines.\n\nExplore each destination in VR and experience the scale, atmosphere, and natural beauty of Mongolia as if you were there. Travel between lakes, look around freely, and discover places that many people may never have the opportunity to visit in person.\n\nCreated as a virtual tourism experience, 23 Lakes of Mongolia VR offers a new way to explor
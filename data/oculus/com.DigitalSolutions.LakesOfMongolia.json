a0a&_nc_ohc=kFOU9-EeIwAQ7kNvwGDuWii&_nc_oc=Adq80KSiucVB6HQU25xat5TrmDoC2bG7I92btlqGb7s_SK_dvgomC1A-FqbNx-ShKZ4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVB-zF6zxphQvxsW8NT3JvTeGi3p9RsHV_Nc764opRVw&oe=6B0864AF"}, {"file_name": "SS2.png", "id": "1068208392582448", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619369_1068208395915781_3401898572056878693_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XtZjbzO8AwQ7kNvwEkk-__&_nc_oc=AdpHI-2-5fcGgvZ4xzDOuaZlSqAxiEwbGgSA_srRvZAU8zhyEjaEk8ZamBWFW1FwVck&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcVckag8ToghesegR7rolikcW2sMmK8AM8iVtHZeINvw&oe=6B0854DF"}, {"file_name": "SS3.png", "id": "1964484587588367", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595112037_1964484590921700_5800905513001130474_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln_AqN2_DRQQ7kNvwFwzl4z&_nc_oc=AdoHMrCnzvj3i8uRC4dWLrdM5qeY_rro-L3NfAJb1-io7VXSkM8SWuGh5IB1f6UzQe0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH_RYl6lsJvioW7ikz8YTYa0DnT9HS_AewAbt2HmwmjA&oe=6B0844AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lakes Of Mongolia", "keywords": ["lakes", "mongolia", "nature", "tour", "discover"], "long_description": "Journey across Mongolia and experience 23 of its remarkable lakes in immersive virtual reality.\n\n23 Lakes of Mongolia VR brings you closer to some of the country\u2019s most beautiful and remote natural landscapes\u2014from vast open steppe and dramatic mountains to crystal-clear waters and peaceful shorelines.\n\nExplore each destination in VR and experience the scale, atmosphere, and natural beauty of Mongolia as if you were there. Travel between lakes, look around freely, and discover places that many people may never have the opportunity to visit in person.\n\nCreated as a virtual tourism experience, 23 Lakes of Mongolia VR offers a new way to explore Mongolia\u2019s landscapes, learn about its natural destinations, and experience the peaceful character of its lakes.\n\nWhether you are interested in Mongolia, nature, travel, geography, or simply want to escape into beautiful landscapes, 23 Lakes of Mongolia VR invites you on a virtual journey through one of the world\u2019s most distinctive countries.\n\n", "short_description": "Explore 23 breathtaking lakes across Mongolia in immersive VR. Discover remote landscapes, pristine waters, and the natural beauty of Mongolia from anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1665095135225250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595143057_935229646287346_1961418877279203735_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07wQUVCxhnwQ7kNvwGPyr1d&_nc_oc=Adrad6x3xfLJ8sm9vyy3LJqLzmZ1RbekBRniZngqq0DnhGFlap4TuTaeHdu7Z8kgsm4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR984A9Pk-2dKimKKBwSPTT5vaazRoPMNWHcdhKTrhpLg&oe=6B0
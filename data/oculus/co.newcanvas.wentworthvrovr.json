ile_name": "Wentworth-STOREAsset3.png", "id": "784763014481822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830613_784763017815155_6861328911373021194_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlPQWlvCwX4Q7kNvwHDTKSS&_nc_oc=Adk6NcY4xzyCKW1bCuqwOHYPtuWAwH1oZbKSxp8cDplgrYaCf4DHdswW0eLuktQHNgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuvLsDxgPOai6TvJ-n5qw8w1nu4GZUptWpQLW-rYq6K8w&oe=69984927"}, {"file_name": "WENTWORTH-STORE-assets-oculusGALLERY-art1.png", "id": "1152619913284123", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391887_1152619916617456_8498551135927771169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSosIHukz-8Q7kNvwHVS0dD&_nc_oc=AdnHRZjfj-Wlnm5QGu3uAM-ECBTGdEnVZmBaOXX4BriTGrPHLnMUnLxsvvraASSfTs4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsAhMLejNbEZ_zNfV65Bb5NOBzPXbujHbEapRPw5cpCqQ&oe=69985FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974824_841811656184108_5873806791657127936_n.png", "id": "1264775731875614", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393406_1264775738542280_7685677201830759202_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvwXcIohifMQ7kNvwEeCcj6&_nc_oc=AdnNu-B4XiJepC6TyA9KZCmm3oWsu7_Mff9j-gJVkWJUkLDQV_2kzaICltaIrFQ6MBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsn_tnDr4Ld8nXj8_Lg_5vHSjtoJnCFhfLNUFB4x0CDGQ&oe=6998441A"}, "display_name": "Wentworth VR", "keywords": ["Drama", "Wentworth", "Fremantle", "Prison", "narrative"], "long_description": "Wentworth VR is a ground breaking interactive cinematic virtual reality experience. It\u2019s the official extension of the award winning TV series Wentworth.\n\nAs a new prisoner at Wentworth, you must find your feet and figure out who to trust in this dangerous new environment. The previous occupant of your cell committed suicide in mysterious circumstances, and the J-Block crew are on the warpath about stolen gear. \n\nWhile trying to navigate complex prison politics, you must also try to piece together your own past - and what you did to get put in Wentworth.  Featuring known actors from the series and shot on the same location as the series - this is a must for fans of Wentworth.\n\nThis immersive experience includes 2 episodes (approx 15 mins total runtime).\n\n**Are you ready to be locked up?**", "short_description": "The official immersive app for the hit TV series Wentworth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6bf4c228-12ec-404c-b6e5-afe33ab0b513", "developer_terms_of_service_url": null, "publisher_name": "New Canvas", "support_website_url": null, "website_url": "https://newcanvas.co/project/wentworth_vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24024867330518386"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "3617172975089500"}, {"status": "PUBLISHED", "id": "1996939104431062"}, {"status": "PUBLISHED", "id": "1308396114265551"}, {"status": "PUBLISHED", "id": "1925696784833562"}]}, "baseline_offer": {"id": "1925696784833562"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "3617172975089500"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24936831582655285", "version": "1.5.0"}, "id
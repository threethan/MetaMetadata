6-1.oculuscdn.com/v/t64.5771-25/473393406_1264775738542280_7685677201830759202_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvCcllyP5lwQ7kNvwFhiw3s&_nc_oc=AdpWLsmuFxqEfrPO1Vp_XrzR07qRV9pvk8ZbRkKsX4XmT3g36KMzkwkX-QXWAkdtcNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8FnGDEjEx0Hd85OcpRdYsgOPr7OvHYjZH8reG3EGWbw&oe=6B0308DA"}, "display_name": "Wentworth VR", "keywords": ["Drama", "Wentworth", "Fremantle", "Prison", "narrative"], "long_description": "Wentworth VR is a ground breaking interactive cinematic virtual reality experience. It\u2019s the official extension of the award winning TV series Wentworth.\n\nAs a new prisoner at Wentworth, you must find your feet and figure out who to trust in this dangerous new environment. The previous occupant of your cell committed suicide in mysterious circumstances, and the J-Block crew are on the warpath about stolen gear. \n\nWhile trying to navigate complex prison politics, you must also try to piece together your own past - and what you did to get put in Wentworth.  Featuring known actors from the series and shot on the same location as the series - this is a must for fans of Wentworth.\n\nThis immersive experience includes 2 episodes (approx 15 mins total runtime).\n\n**Are you ready to be locked up?**", "short_description": "The official immersive app for the hit TV series Wentworth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/6bf4c228-12ec-404c-b6e5-afe33ab0b513", "developer_terms_of_service_url": null, "publisher_name": "New Canvas", "support_website_url": null, "website_url": "https://newcanvas.co/project/wentworth_vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connectio
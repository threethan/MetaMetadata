luscdn.com/v/t64.5771-25/75269159_454014050086195_4901195069234922602_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQMiGIjN76gQ7kNvwH7fX6O&_nc_oc=AdoHgMTvP_QThhqONs8nxtfj6bMZjvLc529wEqS4f-_n4p4TBHBt2ufsnq2Kw285ihg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7zBNaw7OVvfNj9F0gSUehL6uX-zxsG36VeAV0tKKGbw&oe=6AFC89B8"}, "display_name": "flybye", "keywords": [], "long_description": "Forget about buttons and joysticks. With the Quest 2, you can control a spiderweb using hand tracking! \n\nHelp your spider friend on a quest to eat as many flies as possible, but be careful - bees rip the web apart! \n\nThe web is sticky but fragile. Manoeuvre it. Stretch it. Fix it.\n\nPS. For the best arcade experience, enable hand tracking. Touch controller gameplay is less satisfyingly tactile.", "short_description": "Forget about buttons and joysticks. With the Quest 2, you can control a spiderweb using hand tracking! \n\nHelp your spider friend on a quest to eat as many flies as possible, but be careful - bees rip the web apart! \n\nThe web is sticky but fragile. Manoeuvre it. Stretch it. Fix it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://studioselectricity.github.io/privacypolicy", "developer_terms_of_service_url": "https://studioselectricity.github.io/terms", "publisher_name": "Electricity Studios", "support_website_url": null, "website_url": "https://studioselectricity.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
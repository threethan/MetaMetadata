sh_B6KgYcJ8RB-BoQ&oe=69CD1878"}, "display_name": "flybye", "keywords": [], "long_description": "Forget about buttons and joysticks. With the Quest 2, you can control a spiderweb using hand tracking! \n\nHelp your spider friend on a quest to eat as many flies as possible, but be careful - bees rip the web apart! \n\nThe web is sticky but fragile. Manoeuvre it. Stretch it. Fix it.\n\nPS. For the best arcade experience, enable hand tracking. Touch controller gameplay is less satisfyingly tactile.", "short_description": "Forget about buttons and joysticks. With the Quest 2, you can control a spiderweb using hand tracking! \n\nHelp your spider friend on a quest to eat as many flies as possible, but be careful - bees rip the web apart! \n\nThe web is sticky but fragile. Manoeuvre it. Stretch it. Fix it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://studioselectricity.github.io/privacypolicy", "developer_terms_of_service_url": "https://studioselectricity.github.io/terms", "publisher_name": "Electricity Studios", "support_website_url": null, "website_url": "https://studioselectricity.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2152574794923159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251818_3507693338
a0a&_nc_ohc=VIVKWqkbRR4Q7kNvwGPDfvP&_nc_oc=AdpSJ16mK5Wgzr-fyAuqCQtWzc-eXM8ctCGrEA-GP3J6vwzRTn1ZN_S409smxuQmQhM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg17gRrdjGOw72No9UBQpr-1q-i0Vd9G-8o1e0iMzDRQ&oe=6AA3F0C3"}, {"file_name": "\u4e94\u56fe-3.png", "id": "1220393037814760", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619808_1220393041148093_2014269959186670310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcW-iZRqVmwQ7kNvwEUC6Dd&_nc_oc=AdrXlDSDjbDmHgyQNPCXi3xj9NM5llkTZAhRW37HI9AcD1_-U2u1QhT0i1j1Hv2E6fs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg_dwrGlypVZ9Z-61ivKDkkq5Gw83_CASIebMBrIWPbQ&oe=6AA41605"}, {"file_name": "\u4e94\u56fe-4.png", "id": "1340198591394944", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620856_1340198594728277_2293004820206353383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9wetVkm-BsQ7kNvwF7JwNd&_nc_oc=AdqfK4jlURwSJRmzwx--pzLIBeWOurmKGA9nY_-v-dDhFaCLRPgS1nYFStmxnzUNvC4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc5WNtFwKO9hFL_erC2rYzBvEOmkf1f1J0RN4X9B8KAw&oe=6AA401F1"}, {"file_name": "\u4e94\u56fe-5.png", "id": "1641607013808215", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620875_1641607017141548_3029424313347048196_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_z48mLf3UgQ7kNvwEmKbOO&_nc_oc=AdpClLCYSw6K6ZcqT8JVAyIYCXEdOUVQJizANuYelH2ha6rPQqqj_mDmarSK4hBZ9oc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIOtmhnv38vICICiKXAMns0xRIUAJDkU4Bew1e1dxEQg&oe=6AA3FD39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1478392696833414", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619677_1478392700166747_8691469167511298160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM5ZkwBYKuMQ7kNvwH8C92P&_nc_oc=Adpo5Bh10q8Ne9vZr8uMbNesEs3KEBu66uCHh-EB_5EJ8ZN_h60O6K4zO24woUaZOpw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHfzgyNtVg2R4S4m8UrW6GImBy86__91mA5ebMa882Fw&oe=6AA41286"}, "display_name": "ZG: Zombie Garden Defense Demo", "keywords": ["zombie", "shooter", "plants", "survival", "fps"], "long_description": "PLANT. SHOOT. SURVIVE.\n\nZG is a VR plant defense game against zombie waves. But this time\u2026 you fight too.\n\n\ud83c\udf31 Strategic Plant Defense\n\nGrow powerful plants and combine different abilities to stop massive zombie waves. \n{1897489697616756}\n\n\ud83e\udeb4 Rip Plants to Fight\n\nThings getting out of control? Grab plants straight from the ground and use them in combat. Your defense becomes your weapon. \n{27152109014399031}\n\ud83d\udd2b You Are the Defense\n\nYou don't just build it, you stand in it. Blast through huge zombie hordes in intense first-person battles. \n{1670386994104974}\n\n\ud83e\udddf Boss: Toilet Zombie\n\nA massive Toilet Zombie with earth-shaking attacks and chaotic patterns. Your plants won't be enough, every bullet matters. \n{1698736204367815}\n\nFree demo with 7 playable levels! Try the full version to unlock more plants, stronger weapons, and harder challenges.\n\nThe invasion never stops growing.\n\nYour garden is under siege.\n\nSurvive it.\n", "short_description": "ZG is a VR plant defense game against zombie waves.\nBut this time\u2026 you fight too."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digi-eden.com/page/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "DigiEden Studio", "support_website_url": null, "website_url": "https://www.digi-eden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memo
 {"file_name": "Screenshot 4.png", "id": "1285488195628014", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001702_1285488198961347_1463935504192130845_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stlsgUyHuQ4Q7kNvwGis9Nx&_nc_oc=AdpNNs8aKhRQg3cZypf1cNwaNg-M8cRpiKfiS0RJ1b_njPKiPbzuJq1CfGzSEupzdtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSae9nxMeC7thAZ-6B0ttNf7i_IFqfFyobTT3s3U09PCw&oe=6B0714AF"}, {"file_name": "Screenshot 5.png", "id": "6149333165086295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036614_6149333168419628_5707770024458962449_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nlrz_Jb8vQQ7kNvwG-xo-B&_nc_oc=AdpsOa4kQDYKy6-fvn_qk5R-5qgkDC2u4clIzQT4gPIy-cQZY9frxDJmWtOQah4dhd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-pb4nFbr6M_nku2PvInLImh38cQyNwKkI1mSvzgvH5Q&oe=6B072479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-11-23-16h49m59s936.png", "id": "834806667829493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001667_834806671162826_3450923485843449062_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9GKVmT3YBQQ7kNvwHf6ofE&_nc_oc=Adrsm25lS3wKtVYd9Khq42CDCGVzO-pfXQn2GOkLJJe9TbLnZkKOmH_H_3YYoWgidys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP1qBVqCBb0H6D5ESnyYQZWJz3tvavlfPoAIRUGgQZiQ&oe=6B06FA54"}, "display_name": "VRflow DA40 Demo", "keywords": ["da40", "diamond"], "long_description": "This is the free demo version of VRflow DA40.\n\nVRflow DA40 is the interactive cockpit procedure trainer for pilots training and flying on the DA40 NG. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, and much more.\n\nThis demo version only includes the Engine Start procedure.\n\nBuy the full version for access to a total of 8 normal procedures and 5 emergency/abnormal procedures. Explore Mode, where you can explore the cockpit and learn about systems, is also included in the full version.", "short_description": "This demo version contains one procedure and does not have the Explore Mode feature.\n\nVRflow DA40 Demo is the interactive cockpit procedure trainer for pilots, used by airlines worldwide. VRflow incorporates advanced VR learning technologies, providing an extremely efficient learning tool for pilots doing their flight training.\n\nAll purchases of VRflow will be upgraded as we add more procedures, fix bugs and make VRflow better."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": "https://vrpilot.aero/contact/", "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26087921200829544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974748_482044990573341_666333309935223
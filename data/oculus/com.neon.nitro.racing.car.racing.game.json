_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5aykS7DWA2q-VpVZFmO0Kl_485DoB9bDw3hQWfhYmDg&oe=6A9AD5F3"}, {"file_name": "2.png", "id": "1357469546521392", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824307_1357469549854725_5909669035307350777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ncg0OFBCuooQ7kNvwFAU_E5&_nc_oc=AdrlRiVU10VaYeGXk1fqhCE8PjZUxCkYC8UwQYhkvKT9NURE3qyr3OxhNoemQIuUMDM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo-heOFcuhPKe1PhEtrjTFjD4u6SNsiKBxVqySzqHJiQ&oe=6A9ACE40"}, {"file_name": "8.png", "id": "1355538282821733", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824307_1355538286155066_8100756003754710080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GfPrixhdLYQ7kNvwHeGWg8&_nc_oc=AdreMk7cds8y5vHkUQC5v9KRvdpxFFx5JSyGWR22ZJ6q7aWM6hSU3Xkga7-g6nwo8cE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgGveGBPgGvF_feMr2nHPY-klydcoG0ZejMLiWrJkBPw&oe=6A9AF385"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Car Racing Drift Legends", "keywords": ["car", "racing", "driving", "simulation", "race"], "long_description": "Get ready to ignite your passion for speed in Ultimate Car Racing Drift Legends! Race through exciting tracks, drift around sharp corners, and prove your driving skills in an action-packed racing experience.\n\nChoose from a collection of high-performance sports cars, each offering unique handling and performance. Master realistic driving physics, perfect your drifting techniques, and compete across a variety of beautifully designed environments. Whether you're chasing the fastest lap or pulling off spectacular drifts, every race delivers adrenaline-pumping excitement.\n\nUnlock new vehicles, improve your driving skills, and conquer increasingly challenging races. From smooth highways to technical circuits, every track offers a new challenge for racing enthusiasts.\n\nFeatures\n\n\ud83c\udfce\ufe0f High-performance sports cars\n\ud83d\udd25 Smooth and realistic drifting mechanics\n\ud83c\udfc1 Exciting racing tracks and environments\n\ud83c\udfae Responsive and easy-to-learn controls\n\ud83d\ude97 Multiple camera views for immersive gameplay\n\ud83c\udf0d Beautiful graphics with dynamic environments\n\u2b50 Challenging races and rewarding progression\n\ud83c\udfc6 Become the ultimate racing and drifting legend\n\nStart your engines, push your limits, and dominate every race. Ultimate Car Racing Drift Legends delivers the perfect combination of speed, skill, and excitement for every racing fan.", "short_description": "Experience the ultimate thrill of high-speed racing and precision drifting. Drive powerful sports cars, master challenging tracks, perform epic drifts, and become the ultimate racing legend in Ultimate Car Racing Drift Legends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27999626183005472"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823802_21191822686
&_nc_ss=7f20f&oh=00_AQDNMixx7ULpu91qoFg910z8rRPTxEqQ11icP96r5njulQ&oe=6A579D03"}, {"file_name": "1.png", "id": "1907231593486030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1907231596819363_7585039450547963626_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9ulo3h9PUoQ7kNvwFYrRTR&_nc_oc=AdoBs8z0434iHENqt9MBWpX_5BvhG5jdVJs8U6iGpSpUk_1zL_hCkDWcjzRQ2oWtLh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi1A9bjDTnn2sR8y3gJELYaaE6gEMo3xANhBkoQmlmqA&oe=6A579409"}, {"file_name": "3.png", "id": "2209137382949088", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_2209137386282421_2450194528708257634_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELto_sjz8LYQ7kNvwHmUMvS&_nc_oc=Ado62tv7LWU_fcM0cMEgSj3lby522qxigVmgcntu0zQNo06r4eI-Mz2SsEhK2LHu3H0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKJiEiG5_QPv958WnIPfdg7ELlO3TDtuZb-8_VTDm4gA&oe=6A578B7C"}, {"file_name": "4.png", "id": "4577791655822116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_4577791659155449_4649776658302678396_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZa0EBByY3gQ7kNvwHjuSUN&_nc_oc=Adr1UOeaD2b-hJYtqscyx0uVTY7fWANIM8xvipmv85plPw6c6U9tl6h4J9C3GHdfJIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJllD-cHs9qL2DB_R3M2qwy3eIDAG4x-nGUfLs_EMALg&oe=6A576DCF"}, {"file_name": "5.png", "id": "1202422525389236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1202422528722569_3730458932549813408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8LK9IFBNiIQ7kNvwG5veRf&_nc_oc=Adq2ImSnYvsAQMruPybY8ujBci8Uw1FMZJUUOa8-KaGzwuEayQVxVtn0tbhA-vUFLbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0kXDI5PajibeDHchpEpgC6qcq9twejjghTmOjvbHTWQ&oe=6A57937D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nitro Racing - Car Racing Game", "keywords": ["car", "racing", "driving", "simulation", "race"], "long_description": "Get ready to experience high-speed adrenaline racing in VR with Nitro Racing \u2013 Car Racing Game. Step into the driver\u2019s seat and feel the thrill of realistic car racing like never before.\n\nRace through exciting tracks, compete against skilled AI opponents, and push your driving skills to the limit. Activate powerful nitro boosts, drift around sharp corners, and reach extreme speeds to become the ultimate racing champion.\n\nDesigned specifically for VR, Nitro Racing delivers immersive visuals, smooth controls, and heart-pounding gameplay that makes you feel like you're truly inside the race.\n\nWhether you're a casual player or a racing enthusiast, this game offers endless excitement, challenges, and high-speed fun.\n\nKey Features\n- Realistic VR car racing experience\n- Nitro boost system for high-speed action\n- Multiple race tracks and environments\n- Smooth and immersive VR controls\n- Challenging AI opponents\n- Detailed environments and visuals\n- Easy to learn gameplay with skill-based progression", "short_description": "Experience the thrill of high-speed racing in immersive virtual reality. Nitro Racing puts you behind the wheel of powerful cars where you can race across dynamic tracks, compete against smart AI opponents, and push your driving skills to the limit. Use nitro boosts to reach extreme speeds, drift through sharp turns, and dominate every race. With smooth VR controls, realistic environments, and intense gameplay, this game delivers an exciting and engaging racing experience for all players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
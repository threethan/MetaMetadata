1-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeeCq0qb-fUQ7kNvwFnCmwC&_nc_oc=AdqMPfeWlHinemfgC7ckGetx1t_Y1c80yiEY0or9AtPQqXfwPz4DR6rY9dVcHOJksMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn3zCLX3tdvIaQ237WsszHe5ZzPK2J--VDZuJN5cqL5Q&oe=6A79E365"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87caVG-C9hYQ7kNvwFW5fp2&_nc_oc=Adr_Xbijgrk2LJebBl_sWEBs584cSjqpViQL43Ly87Ev7NHYLo8Bi9uYMFQX8OTh3us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElMUK6TgO2lsL34yxh-VZJzaJSGF_zVcZoUifENDSSqg&oe=6A79CB0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qokxSbTPOGMQ7kNvwFJyfP9&_nc_oc=AdoD_9r1vDenTy-w5Bg2x4abAvN0eMIjCUR4ZU3IbsCZgoadswXSA6-zRvHkGK3WY4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDEtD54IkQPghMXDdAbd9_KKk-MXrijx2EGbO8f5ZdZA&oe=6A79D9F0"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruIlW5Es_MEQ7kNvwGF0gGa&_nc_oc=AdrwZtJsxWGdOTSDg_3MiKGTg-iAmFNnZeCo8SN3K1Q7rjM0cf1jZ_mqg5AzUvBFxjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP2ImC6wxiQakx84Nm1CIRDVbERP6RMD3JizpQ4Uhfvg&oe=6A79C88B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoboRoyale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
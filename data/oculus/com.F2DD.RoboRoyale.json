1-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWpPHcN5w9UQ7kNvwHqKaDi&_nc_oc=AdpGzxfMGM_VnyOm2h8D7LhsRX4qg6-oZ1fefBlTTJIyGCWAIgmY8Tyr_daxbffyIWg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnaTySfwnq7CK6xU_nQDSqg6Ux0jZyu0oWKBBmHL7wSw&oe=6AEC95E5"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9NN-fnwAKYQ7kNvwHPoMoa&_nc_oc=AdrwTVhEQzVQyX3V5KI3h6MP3L4WOS8FY1Zz9F61VZvSJdZP6ACBSOym0aejLOl0x3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJNcC6pwaOF-Ej33O6j8klhZBRpyX1R-B-L1mbWUOQDw&oe=6AECB5CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hTnRMSIWu0Q7kNvwH4zcnQ&_nc_oc=AdqPGJCN0X-Ff46I_eEf26q6tfT300hkstrSbgaDTrObjJTUvOAaNATKTFI9621AYMI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwsgrN0jlAwQrW2fUegBR5cQrJzxYTWQ0OZR3weoEkIw&oe=6AEC8C70"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KOD2iC9mW4Q7kNvwEd-Qka&_nc_oc=AdruP2U9oTBrFXh3Mj4d9L7lID77rHH4sHwVk6J5Phw2uowCs1AkUnvViaFS3aQzhvA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp-G2w-OLo25C2fib5d5I5snsVF9C7Nrcn5Ry4AWn90g&oe=6AECB34B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoboRoyale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
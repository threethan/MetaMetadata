303E"}, {"file_name": "RoboRoyaleIcon.png", "id": "633909066050941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392031_633909072717607_2751836384870853208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYBaAtUVcV0Q7kNvwHwXwlQ&_nc_oc=Adrdc-XMe86kJ8fk3kaYgQctBCrm7iHcSlfAZlbrmXwDLlMUt_YRqQF3tgceteRACPA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8AUStcwM1DrSVlamY_UAyMEfeRZzlTcBLOTh8q-rODA&oe=6A564E8E"}]}, "id": "1136553238681347", "locale": "en_US", "screenshots": [{"file_name": "LobbyChillWithFriendsImage.png", "id": "26457827890563080", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312236_26457827900563079_8518984896958443442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZD1l-b0VxIQ7kNvwHBiSEg&_nc_oc=AdqgFtGgmvxum6dPRENo4gprSOow5l7cjAzgs-u8v4ggdry4qut7Dma-tgh3rklz_kE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHcy1J6jPpcfsJ8b6qcV6mIOyyjW4OrIpUCX5q8pcYgg&oe=6A564F1C"}, {"file_name": "BattleRoyaleSS.png", "id": "962123036623669", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311597_962123039957002_5288689711294873987_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQBcacJv3TIQ7kNvwHdDpGa&_nc_oc=Adp9pkD5zy8AoCRqljLvc9_CaKai8WQauumdzcAo1MlDwB5kXufb42JOXDx9Y2uYN0A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcgkE1O3Ss9mnuX8SoYwQ6upIMahS7b9b4BshfcKa8cA&oe=6A56381A"}, {"file_name": "MindKraftSS.png", "id": "2542355812883533", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499310731_2542355816216866_1240032728346430856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSY7AQHEm8QQ7kNvwHUvuc2&_nc_oc=AdrbuDr77Jt60MSIlT5pWdqhprZ3iwp2qnH8fCOsudDJLjAPNUTNiH3Zs-yu9JAEGmA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6OhZq-M3glz0n694jyUjvhV9QIlkIn28689at7KU-yQ&oe=6A564FF6"}, {"file_name": "StumbleBotsSS.png", "id": "2010322106524070", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yegKEx7CjMQQ7kNvwECAfpN&_nc_oc=AdoLPCkhPf3UfaI0C6Ho9JOthJBU1yjtxtOgJfAB-rXIZQArMj-Hgs_3uUQXdc2xZVw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALlmxUrau_DwGSEoAgkTAby1MLNcVNSVgktFN52pef8g&oe=6A564AE5"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrB54KpHHVwQ7kNvwG0P6NC&_nc_oc=AdrpPuIgzRIiChVffjkiV5j6siC3AAt8qsc6Yyj1BpjEPjysLSL3iJotPq1dj-bRnKk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCshsJYx-x47G3F_fQhpKhnq3nwWiQDCKaBLYuzFZMYVA&oe=6A56328A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVLNEqEY6NYQ7kNvwH6W4ua&_nc_oc=AdroatECKXa5KQ4nUdVyhPuG1mAsvKl292ZnWcfSbgAWHzfD6LjMmagAbVo_kv5WGP0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl1QnQFbYz5WFpsbiq7B20onoQHw_Q6e7pjkVw_HjoMg&oe=6A564170"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqy2MmswePcQ7kNvwE_NukU&_nc_oc=Adqw1FVW5rklfyChk4ZnjgXU1ucBve3hlHi_Qm4zN-R62-haAq45mlqhVRWgynRl6C4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-dwI_JeCNObMmeYgOWD1kX8eji2fi44ZnUMweM84rfA&oe=6A56300B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoboRoyale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
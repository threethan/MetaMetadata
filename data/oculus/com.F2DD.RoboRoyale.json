903E"}, {"file_name": "RoboRoyaleIcon.png", "id": "633909066050941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392031_633909072717607_2751836384870853208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2FkQ6dY1RYQ7kNvwEfnB_E&_nc_oc=AdoAJYscMJle6VAX9D9pnm5l-UPQ42vF2OctfmEcjY1f-RPSPHo4UFNHeGC2mOlPVYE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5x3LHVfuW1NeAEYZW1DKXjuykcz5Uf0fnTrg_9CEwtg&oe=6AAAAE8E"}]}, "id": "1136553238681347", "locale": "en_US", "screenshots": [{"file_name": "LobbyChillWithFriendsImage.png", "id": "26457827890563080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_26457827900563079_8518984896958443442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFMlGOvy7CsQ7kNvwEat1Rx&_nc_oc=AdoSAPXTtpmvfiucYfqnXAbYjyDr8Q0mOVT5wmDnrZDfK5v6rfpPPknwDzLPkqPDgzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKArWBuqVBxrXBNPU01aitrvQc4uBJZyFEeLTgfWZLejw&oe=6AAAAF1C"}, {"file_name": "BattleRoyaleSS.png", "id": "962123036623669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_962123039957002_5288689711294873987_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIYoSns9-6YQ7kNvwF-MB5q&_nc_oc=Adr6m8KOrxLF1GCNHiHPtwqypzZjtRuUj__l6h1TpjqsvHsDJQKNCP4XyYlIpNd2kSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw_oa27zhrERSbnVGZAvcDMVIsPiiEJLQMQENBuAuoeg&oe=6AAA981A"}, {"file_name": "MindKraftSS.png", "id": "2542355812883533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_2542355816216866_1240032728346430856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlIeF9HhD5YQ7kNvwFym1fp&_nc_oc=AdqSWoND4Gc7A4VDZC45yKz4FJ9xW-0nSOyj-EnwyeeIvhq-FltfxKaiBxy9RR4UJYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1mwF0yCT9L9bdq1a9p6wMLPcNZNMWAGj3GU3KYqQqDw&oe=6AAAAFF6"}, {"file_name": "StumbleBotsSS.png", "id": "2010322106524070", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyRa8SLliJ8Q7kNvwHU3_9C&_nc_oc=AdpDC62uDw8Qj6wegF64XNmYYnAaaIBxn5HekdMXZg3cKsly9PeJWU6Zk8de_QhIjH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-I238KbojQ9FaUPxW_QGNYtAmz3sXzd_OBtWOaXfByQ&oe=6AAAAAE5"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfMfEgW_cDwQ7kNvwEDqMbi&_nc_oc=AdqgElY1vF9Bb0NuBTWTph_oaGjG1Rk_e_KYbFQTu8gF-XgBFJf8ZFYoNvVTChTBd4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJImVLh5-XgBrhqtYoLywRAMh3nrs3uuMLja4eYoY1TQ&oe=6AAA928A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt8TorqKmkkQ7kNvwH0JI9s&_nc_oc=Ado6jo6EBhv_F8YyRGfev6iihLG7deP1szix3nLVW5pJuqIL_7NL5ZIC8cXNINTzMoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr24Mc-jOYIaKyOOE4_egItdGQR2q36BtNahnvCGdJlQ&oe=6AAAA170"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhRpWovSyVAQ7kNvwHTXFFa&_nc_oc=AdqbrUUSO22qZ4W5yAGZrkDPUGfp64rkwWDwUhf0vqlblt1jFYZ6V2OsYRlyGBrzu00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwamnBrMkkzzCzTQv3yPEPj9qsLAJ-SUZgvWQTfRpbng&oe=6AAA900B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoboRoyale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
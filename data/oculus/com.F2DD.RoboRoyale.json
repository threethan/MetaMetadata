_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzvF2JKcZAAbINEOGX7mwnddSG4KZAhu0I5LtIJzJFZQ&oe=6B0F1A36"}, {"file_name": "StumbleBotsSS.png", "id": "2010322106524070", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7D59L-6e1gQ7kNvwFG9hSq&_nc_oc=Adrh50djmExoXCN1DNAY-onwq6XxMGhzqJMb1RS5GUudUuXM00BblJa6z5K8REABjnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUQUSMh6BkUXzKFeIZjblUjHRpcHX6sUrwiuWhSJA0Ng&oe=6B0F1525"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwGWA0qxcIgQ7kNvwHEySKu&_nc_oc=AdpgQIbJrWY6bd5a5LOn-QmTaFgBlS_ipq_DijauCq0tqxSJK_7pSQRblTelxlOwNt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAzkAkd-cXmLa9FtxR1s8O4xMjvjt80ZQkOXmETxhupw&oe=6B0EFCCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SpcsbGPu1sQ7kNvwF4_H6N&_nc_oc=AdrllCItofzZ12SPCyeEZVKJ1m6IvfYfe-5I6M8vc9WGxQeLikL0gR2lEkjHPdZDNUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuHrXWbFjunJvoU24iuNnYuH8DI9KLJEOik91RXOEsDg&oe=6B0F0BB0"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei9rrpmutkEQ7kNvwHxLeEa&_nc_oc=AdqM4Nf7zxmiRNcL7MfLeLOZUHcNaZOqUlb9Ars
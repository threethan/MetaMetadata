72FE"}, {"file_name": "RoboRoyaleIcon.png", "id": "633909066050941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392031_633909072717607_2751836384870853208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FAtroeK4lcQ7kNvwEEq25M&_nc_oc=AdqJ-io6cYZJEguimIyFsnQr1cSTIAjjNMO857WGMgIHOn3xbBJhwZ6xgWeTxu899Dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BYqi73gvzVhIS-oCAMRvMix6UAX-l2fUharFIA0dNsA&oe=6A35590E"}]}, "id": "1136553238681347", "locale": "en_US", "screenshots": [{"file_name": "LobbyChillWithFriendsImage.png", "id": "26457827890563080", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_26457827900563079_8518984896958443442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlewHxIXiu4Q7kNvwEBE_RW&_nc_oc=AdoHxIahBPi3N8kG9xZiSI_2K49J72XYtqP1yxbsrlzwhtXrkEduwBC3oyITl_F90BQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xu7LBEgf2Qr7RW6rVcM5BpQZGIpNuKhsTR5Hgn3oX6w&oe=6A35599C"}, {"file_name": "BattleRoyaleSS.png", "id": "962123036623669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311597_962123039957002_5288689711294873987_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpUmAtBF29EQ7kNvwGhHzXU&_nc_oc=Adqvkt0bzrnUgbnCy4j12sGZIsBAqDal-WaqcLoR6nSTv37eFrig5B4EBB6aZRCOS3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pr1PesFAeUCl5nnaUehy6euiZSnxS0MjRvOAzO1b0xw&oe=6A35429A"}, {"file_name": "MindKraftSS.png", "id": "2542355812883533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_2542355816216866_1240032728346430856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDJ-mZIoFoAQ7kNvwEirYJC&_nc_oc=AdrskF0BVckSIV6r-uZYEwngFk6DXtukjEBcOS-H7WFKPC7AYq-PSM72wcdge1mATd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S8h9aZmT1Ip90T4PzJ_kwL63gDsBeFuj6SPBaU1Hn1g&oe=6A355A76"}, {"file_name": "StumbleBotsSS.png", "id": "2010322106524070", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WCsrS6M8BUQ7kNvwEo-qc6&_nc_oc=AdqnXUvpxZr4ls8ZxwV8mULoSplJ6vaEn-IKosu7zSUedI3JzfgitcpmA3wGkBdkmzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gjz9SVp9q5oPVgFRpq-4jbb8gEp84opLS_R7Lj219jg&oe=6A355565"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFHqpQ98DV0Q7kNvwFwpKAT&_nc_oc=AdoQlKv4U5rtnM-ZQJoJg_lM6fBm4zW6atWjI49lloTl9kvIW8EFpCbn1GVXAH-RSkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KCqXovWFkFlH-_xRMgd2VEBr2wI1GU42IgbafDAiAHw&oe=6A353D0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMGxnM2WAOgQ7kNvwHJaxjO&_nc_oc=AdoR1HgrViY6yn0e8TutMfIMIbojfOgoBZ7RJ9O7_mqREZtxW1GqeXWkzUZpEIhESbA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bOd8WdAWcRfcyAvOt-wmZl7uvHfJqsb02h0LHV7Q1RA&oe=6A354BF0"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h6pFrbI8sIQ7kNvwEhRKfn&_nc_oc=AdpfRqWV6S4SkXq-IJUT9M6yg2NBlx-gv_0V-ISXrSfR40HM1rXl2MKoekTuKCmEbXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hf41dLDYt1D4QgXO15ddWyqxskzzUbYCWYhoPYMX26Q&oe=6A3572CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoboRoyale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
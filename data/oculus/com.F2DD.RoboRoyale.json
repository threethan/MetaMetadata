493E"}, {"file_name": "RoboRoyaleIcon.png", "id": "633909066050941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392031_633909072717607_2751836384870853208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqp9mIlfVfEQ7kNvwFOGyYn&_nc_oc=Adoqq7y-p5ZLnr79sY-BLuig3SmWI-jMu8sRxV1LylqcTtNVqBhAHTlVkk2F8GdEQGc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsVT5PbyFmmnqtBl_HQED16K3MFtQnlJzuXQSJKV1BXA&oe=6A882F4E"}]}, "id": "1136553238681347", "locale": "en_US", "screenshots": [{"file_name": "LobbyChillWithFriendsImage.png", "id": "26457827890563080", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312236_26457827900563079_8518984896958443442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgzW7je8E-YQ7kNvwEw0UEU&_nc_oc=AdoL5S9ZsAxNxWT-r5JVve-3DzgUY0wWkxFjYxQ4IbYjGMuMu-7AV5IKtcGxfBjxKcM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4-bAW5vgaSQLNdJhPxtrenBa2xXXolTi6c2FspC737A&oe=6A882FDC"}, {"file_name": "BattleRoyaleSS.png", "id": "962123036623669", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311597_962123039957002_5288689711294873987_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANqfBUVaZIoQ7kNvwHcsnlC&_nc_oc=AdpoblPTm-AME3iyGu2jyokkZghreyvXT68KwI456xRTTas2AsHTcph9B8PbFLVlOE0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgck3WCf8lanA4wwfx7_NZAfuKhkXo25bQwfQVqRp6Ug&oe=6A88511A"}, {"file_name": "MindKraftSS.png", "id": "2542355812883533", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499310731_2542355816216866_1240032728346430856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-lH58-Jpd8Q7kNvwEBhNrN&_nc_oc=Adr2c9CqabD3f4kRldNi8f6odlvw8GUw8gJ4VdSJ9sBucFlF_S0mj2hlDs6fm_jJ-mU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjIBL4h4-EY_hgMVCHdH4kiHeixjyp69rjApUZ_KD6zA&oe=6A8830B6"}, {"file_name": "StumbleBotsSS.png", "id": "2010322106524070", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaTLxAXNKw4Q7kNvwEpLILD&_nc_oc=AdpmkSLDYKP5et9SrqIp3oLEY2e-ENb_MUICgrSg9faEhdIHmLKVKkv6-UGDAaUYih8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlpocYDuxWIGK1gQTE6SlHAQcFkaz3MEHr35ua0UhgTg&oe=6A882BA5"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzwJewPZ1ZcQ7kNvwEypiLY&_nc_oc=Adod8IA5YnRtjHNwhyOrAzfCgXb1ML_hnpKVDLRuVARQFbaJz5SkZumnHDZkUwAD8rg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXBGE1nCbt3koMu4cPMZEL3isOdo9oZCokG19UbbbujQ&oe=6A884B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkyTXISI7lQQ7kNvwH3AWfy&_nc_oc=AdrFPXu2WXqF4fmCEuBiJRVrTuSaJnPCU6t-RroqfVxG1ISkXyvAbsClIbtEtIIOekE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmVrTDO85fiGvW54acUOpGJpv0ndmv29v8XEYOl71a-w&oe=6A882230"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8z2Q4Yhot4Q7kNvwGp9jNd&_nc_oc=Adq6KwuVxBiMTYyboPUXZvhoRiogtpHlVcfv396gAgLvJ8uOW0ZZUfYhcH0m9MZ63IY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH28jj-PZQ0VvZ7PcbsBKa7MwbIJeYlsoI1RziSB2_i6g&oe=6A88490B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoboRoyale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
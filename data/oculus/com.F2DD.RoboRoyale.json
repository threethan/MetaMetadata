323E"}, {"file_name": "RoboRoyaleIcon.png", "id": "633909066050941", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392031_633909072717607_2751836384870853208_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXZsvGcbhG4Q7kNvwEvlb6O&_nc_oc=AdqB9Ukrhvu92I-td5F_lm-Q26HFLa6H5YkOijGSihObdRSI4fmUWG9-gdVVgyEQTts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcID8Ez0477BmQXnZfI9UgzEsxQT5z49sXPxYWQQXZtw&oe=6A90184E"}]}, "id": "1136553238681347", "locale": "en_US", "screenshots": [{"file_name": "LobbyChillWithFriendsImage.png", "id": "26457827890563080", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312236_26457827900563079_8518984896958443442_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn7iPerNqTUQ7kNvwExh8QR&_nc_oc=Adr-JYKdDzV6FGzdEqWP1WGJCU3LRvqtF8SnwA2VMD4facDpxwZAoZwk1Lc4gXbgnIg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAgfUaN81ifHKhWFqygl-_nLoDMYHyV7ZAP0UEBFkjsw&oe=6A9018DC"}, {"file_name": "BattleRoyaleSS.png", "id": "962123036623669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_962123039957002_5288689711294873987_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx-qjeCDPLkQ7kNvwE6ltZ3&_nc_oc=AdpibitiAfdnONC5zqSqHdcaEqMqThHFE-W9LbQAMUL2X9WzCEfc_rHPFwkHjDttipA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkB8CuidBXSNjI02mwK_eTXWCxWRTliQc6ts0TLrQkAg&oe=6A903A1A"}, {"file_name": "MindKraftSS.png", "id": "2542355812883533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310731_2542355816216866_1240032728346430856_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqHwYKQ8NMkQ7kNvwH3p32y&_nc_oc=AdrJ3ld0ukOfF65lv_oZg-ZEAZ5-2wSINRx-zM5TQ05pm7sviCTDwG5ZPyzTJFKseHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBSlwCqsxq0FkO8FwHKf2uv4A6-_R147diitfw2zvKyw&oe=6A9019B6"}, {"file_name": "StumbleBotsSS.png", "id": "2010322106524070", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_2010322109857403_8107123477830967554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVKI4g5MIQgQ7kNvwEmD705&_nc_oc=Adp5n-4KavIUpTBKXTQEPaOeUyXgAQlZjIoEPXZs15JXIUueBXAYnVR0Fbhz4AjRNWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCjHWCUQULUmJ_24Cr2IJlwPw1dCRrx-5gtFGMNKM5cg&oe=6A9014A5"}, {"file_name": "LobbyOwnerSS.png", "id": "965184539832498", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499313063_965184543165831_3719882970501703718_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iku-vLLtqGAQ7kNvwEzjuR7&_nc_oc=AdoXnTIJFgChWxnC7kk4sbO4G1vMlOafemqtIg-2xMAmZKlhZyg4ppXuar3CvHKFjAU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1IaxczuFNezMyAAXhaX5WsOeoBUdsxxV51REWS6lGFA&oe=6A90348A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LobbyViewOurGameModesImage.png", "id": "2853606948312861", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_2853606951646194_4731729325234630702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F0RLJpuhSkQ7kNvwH0MI1K&_nc_oc=AdqfMhZO0-5rHhOrBmiCt4lOiGDb_ExN9QheDzTuYOiy2PreQJLgQT_TAXAD0Nfmx00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER2mqCRuJMdPA0FIANpQVBh4tlWiezq4lwKa04BxrOLw&oe=6A900B30"}, "display_name": "RoboRoyale", "keywords": [], "long_description": "In Lobby choose your free cosmetics, hangout at the campfire, or create clones of yourself.  In MindKraft building with single blocks, lines of blocks, or flood fill areas.  Shrink down to try out your creations.  Spawn a soccer ball to play inside your creations.  In Battle Royale you start in the middle of a war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.  For StumbleBots we have a few maps ranks in difficulty and the maps are added and switched out weekly.", "short_description": "Have fun hanging out in the lobby, shooting your friends in battle royale, building in MindKraft or seeing who's the fastest in our StumbleBots parkour maps.  All using gorilla style locomotion or ZeroG."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27014485701566669"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507829686_2199836027446006_931250672033081329_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60IFgcEN0X8Q7kNvwFBjLZR&_nc_oc=AdrLHp5eASSeObmsQctpMHBylthww2Pc-dkG0BVTCzUge69rbb7zN9Gb_rUfcQoTKss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp8b-jyesfyvVJY7s8zDSMgS6hGy87QjGGUdB3rdpBvA&oe=6A90320B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoboRoyale", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
n.com/v/t64.5771-25/499618277_1474247787100004_8154079429248091877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnMdcRiODJoQ7kNvwFOlrB_&_nc_oc=AdpTNZ8lPwCXiFT3fMy6L64xW-Blrugrb_BCtqU9cEXf1xjWqDPHp5Flkgw-E0veJY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n9RH0eBuBoVSCI9fUka3aLAYjyaUr9xA11DcEd9HbrQ&oe=6A087375"}, {"file_name": "GoldenGrenadeScreenShot5B.png", "id": "749358301327304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617786_749358304660637_3117348023950238461_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lElwYEgcb8Q7kNvwFo0bU5&_nc_oc=AdqPqVZZdXSTrELqU0WKCOqrnO5y06YrUC0_67FNVduME7Z4Gvx_Yx32_Ppk4LbckVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BT5L16ijvRza4Q5R24T-ZTergrqBfrgDXVE-WjUj4PA&oe=6A088151"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RoboRoyale", "keywords": [], "long_description": "Start in the middle of a battle royale war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.", "short_description": "Have fun  in a fast paced shooter battle royale.  Hop around in a gorilla style locomotion.  Fly to where you want to go.  Try to pick up the golden grenade.  A 5 minute timer will keep track of who held the grenade the longest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "374404007
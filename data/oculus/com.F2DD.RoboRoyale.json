n.com/v/t64.5771-25/499618277_1474247787100004_8154079429248091877_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hf8BJ2FQgvEQ7kNvwGSM7Jo&_nc_oc=Adpag59Lha7otEu54zV9u-l5yym8rAqATZult8zfSn9j57GfTZVIxL_oHSghixXH6r4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aFCAKKlXYtqAj88g9U19YdxNaOrYI51942yzNlkLhOg&oe=69ECC3F5"}, {"file_name": "GoldenGrenadeScreenShot5B.png", "id": "749358301327304", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617786_749358304660637_3117348023950238461_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ_KQPzrsNUQ7kNvwFcYTL2&_nc_oc=AdpzNTfP6wyOzYwacnXXG_HxlR15MqkT1l8b5DHJazsU1MHInWe2M0jSR24W2PWSj78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IimRI_2T-kjqj-cXdW7nyl27yqyFJFx0SqTndBhh-Rw&oe=69ECD1D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RoboRoyale", "keywords": [], "long_description": "Start in the middle of a battle royale war zone.  You have 5 minutes to see who can hold the golden grenade the longest.  Use guns and grenades to eliminate your oppoinents.  The war zone will shrink for 4 minutes then you have only the smallest area to play for the final death match minute.  You only have so many bullets and grenades before you have to refill at one of the labeled buildings.", "short_description": "Have fun  in a fast paced shooter battle royale.  Hop around in a gorilla style locomotion.  Fly to where you want to go.  Try to pick up the golden grenade.  A 5 minute timer will keep track of who held the grenade the longest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.f2dd.com/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "F2DD", "support_website_url": null, "website_url": "https://www.f2dd.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "374404007
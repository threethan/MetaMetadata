t-sjc6-1.oculuscdn.com/v/t64.5771-25/38974792_254587594152695_1738346399201797423_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1_DmPREEjoQ7kNvwFB_6hT&_nc_oc=AdoJqBvmDAvzNtenGbJ-jQZNYZv1UXsZzrFNtLG2vA6Prn8zPrXs9_pLlT04LsfFjXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2321HIkTEGLwh-w5xAXrSC9Mg3YWstmVkUi3jxWVAnpg&oe=69E8BA55"}]}, "id": "958464555241762", "locale": "en_US", "screenshots": [{"file_name": "20220921_114213.png", "id": "776606900928105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982548_776606904261438_5672696720928444159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiY1gV1kk2oQ7kNvwHMFFKO&_nc_oc=Adqmam-GsyBweYNp78MbYOa0kWROB0UFsksbtgcF-6JlTvqD3kFpnoWIcHpiFDMMce4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10F52y3pV4r7tFLhX_jj2CZCGw3c5B22oBzsVm-NtW3Q&oe=69E8D1E5"}, {"file_name": "20220921_130340.png", "id": "3569591079987575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269597_3569591083320908_1829107050064273010_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86LcIZ73BrIQ7kNvwFB2vjA&_nc_oc=AdprbL2SHC4hizeC6j1Z5eoY8AK30ebaaWahuBo8YIngwP9rmYKQt9hwnd__YBzESWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bEdEVYUUbx2SvDPaMS20OE3NJsJe5MGi2GWZYv-T67A&oe=69E8B7E3"}, {"file_name": "20220921_115722.png", "id": "812601670358730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982501_812601673692063_4888023167364672866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85kYdDvsPtcQ7kNvwFIArHj&_nc_oc=Adpvu-d3BfA-n9ufx0Iq01a0vgFu8InBY2ct2KQiiOBHGPA_B1DgMgvLFPNFeND1hLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XKKHb2wQxf6d-qt3CJWcNeBYixYa1R7NJNBcTpkjl1A&oe=69E8D28D"}, {"file_name": "20220921_124143.png", "id": "2946687445462416", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_2946687452129082_8823392805038975644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY-pD-hyIVgQ7kNvwHBL6AJ&_nc_oc=Adrjo86W77Lu0Hvs1JnV-rrMMBBZFvIeZ8n22CfoyqHvetmb1X6F0zwO_c6vBN8bDLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qBSbysUWHX4QikhHMBg9SMpEGmspDaBmiOAEu-hd5sw&oe=69E8E083"}, {"file_name": "20220921_134536.png", "id": "959926015118349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974792_959926018451682_7454046409305224501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1cY8SpBZAcQ7kNvwFp_wc4&_nc_oc=AdoM0jFaBuUNzTmZpDP4wdat68G-vTtk3wOx3HIZyeTDrTBjbIW_5AJ3eSkJoyMQ1_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39UsWESHaovAveiol0XgvxXPyQc1P9xGcSKTD98vB83w&oe=69E8BD2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oktoberfest", "keywords": [], "long_description": "This VR Experience is a real visit to the German Octoberfest in Munich in Virtual Reality.\nWolfgang Brehm the official city guide of Munich accompanies you around the Octoberfest and explains you everything.\n\nThere are no simulation all is real. It is a real visit.\n\nYou have never seen this before. \nThis is the ultimate VR Experience ... frameless. \n\nYou get a unique impression of the biggest folk festival in the world. It has been held annually since 1810 on the Theresienwiese in Munich. Experience the most important beer tents (also from inside), the Bavaria (incl. ascent to the head), the Oide Wiesn (traditional festival and shoe platters) and many attractions such as a round trip on the ferris wheel. Let yourself be carried away into the world of Bavarian traditions, Dirndl & Lederhosen, beer tents, Munich\u2019s beer, Bavarian music, beer mugs, shoe platters, chain carousel, giant wheel and many more. The tour starts at the main entrance and shows all the top sights. \n\nSome examples: \n- Along the Wirtsbudenstra\u00dfe with many large beer tents\n- Tent Fischer-Vroni (how\u201dfish on a stick\u201d is made) \n- Hofbr\u00e4u tent (the largest beer tent at the Oktoberfest with space for approx. 10,000 guests) \n- Augustiner-Festhalle (here you can buy beer from the wooden barrel) - Visit of Bavaria (ascent to the head of Bavaria) - K\u00e4fer Wies\u2019n Sch\u00e4nke (where you can meet the celebrities) \n- Oide Wiesn / Traditional festival (shoe platters) \n- Ride with the ferris wheel (great view of the Octoberfest)", "short_description": "Join Wolfgang Brehm - the official city guide of Munich - in a real Virtual Reality tour through the Octoberfest in Munich, Germany. It is a real visit.\nWolfgang accompanies you around the Octoberfest and explains you everything.\n\nYou will have 4 hours to see everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/oktoberfest", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/oktoberfest", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "827501475629850"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "916475314656418"}, {"status": "PUBLISHED", "id": "4269328263351936"}, {"status": "PUBLISHED", "id": "2621029108275287"}, {"status": "PUBLISHED", "id": "1083420133803997"}, {"status": "PUBLISHED", "id": "1499528407955731"}, {"status": "PUBLISHED", "id": "1465004411316619"}, {"status": "PUBLISHED", "id": "1399045344567838"}, {"status": "PUBLISHED", "id": "5282558233312
file_name": "20220921_124143.png", "id": "2946687445462416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_2946687452129082_8823392805038975644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKU8u8Gnxs0Q7kNvwFqAhO8&_nc_oc=Adr6ulZqvZBXg7yOw-BkAvFXG6SSZn2RobOJF3aMTutjz91aEdi3QwpfYLa7A6zLnmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_ID4DjMcKmz3LmHZJlawtsf1mknqAxxsRK_Zta8KRDA&oe=6ABBD083"}, {"file_name": "20220921_134536.png", "id": "959926015118349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974792_959926018451682_7454046409305224501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buVyeNyBzgQQ7kNvwHONlPJ&_nc_oc=Ado2nNc20vrckRhCab4mGrcTi5Nz5w6DQhDFPR25NAnjXiYfgWlvCXm6ua2LS9fUlKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUNxkbPPB0ia4rTKEElPiDPNYaNQ2shnFZ8WSEew-9mA&oe=6ABBAD2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oktoberfest", "keywords": [], "long_description": "This VR Experience is a real visit to the German Octoberfest in Munich in Virtual Reality.\nWolfgang Brehm the official city guide of Munich accompanies you around the Octoberfest and explains you everything.\n\nThere are no simulation all is real. It is a real visit.\n\nYou have never seen this before. \nThis is the ultimate VR Experience ... frameless. \n\nYou get a unique impression of the biggest folk festival in the world. It has been held annually since 1810 on the Theresienwiese in Munich. Experience the most important beer tents (also from inside), the Bavaria (incl. ascent to the head), the Oide Wiesn (traditional festival and shoe platters) and many attractions such as a round trip on the ferris wheel. Let yourself be carried away into the world of Bavarian traditions, Dirndl & Lederhosen, beer tents, Munich\u2019s beer, Bavarian music, beer mugs, shoe platters, chain carousel, giant wheel and many more. The tour starts at the main entrance and shows all the top sights. \n\nSome examples: \n- Along the Wirtsbudenstra\u00dfe with many large beer tents\n- Tent Fischer-Vroni (how\u201dfish on a stick\u201d is made) \n- Hofbr\u00e4u tent (the largest beer tent at the Oktoberfest with space for approx. 10,000 guests) \n- Augustiner-Festhalle (here you can buy beer from the wooden barrel) - Visit of Bavaria (ascent to the head of Bavaria) - K\u00e4fer Wies\u2019n Sch\u00e4nke (where you can meet the celebrities) \n- Oide Wiesn / Traditional festival (shoe platters) \n- Ride with the ferris wheel (great view of the Octoberfest)", "short_description": "Join Wolfgang Brehm - the official city guide of Munich - in a real Virtual Reality tour through the Octoberfest in Munich, Germany. It is a real visit.\nWolfgang accompanies you around the Octoberfest and explains you everything.\n\nYou will have 4 hours to see everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/oktoberfest", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/oktoberfest", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "827501475629850"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "4535346776745839"}, {"status": "PUBLISHED", "id": "1957878224916831"}, {"status": "PUBLISHED", "id": "1510555203876320
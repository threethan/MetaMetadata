t-sjc6-1.oculuscdn.com/v/t64.5771-25/38974792_254587594152695_1738346399201797423_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlZReGCO5C0Q7kNvwGt-r-p&_nc_oc=Adp24oqfxc37Ps_cfRKRe2nWhhNvHr0osjkRclilzhtMNQnO-_xTwijqXChp_YMpHyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ENDWr4yuWcYTY23-Irax8yIoZ84vgEK6yzx_7Y2-lLg&oe=6A3AAF95"}]}, "id": "958464555241762", "locale": "en_US", "screenshots": [{"file_name": "20220921_114213.png", "id": "776606900928105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982548_776606904261438_5672696720928444159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7DFXoDgCkQQ7kNvwF5xKU_&_nc_oc=AdodvbmAOgrGXGH4vKwvA1sEtH_qJIp9UCctovpG1c_WDmZv2ANtdR4XS3uoWgKq-eU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96TtlDaQXE_HVbWGrFq-IEJMzK0rMUxwLyeNvsOSzU7Q&oe=6A3A8EE5"}, {"file_name": "20220921_130340.png", "id": "3569591079987575", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269597_3569591083320908_1829107050064273010_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNmP6I44_W0Q7kNvwGmenmJ&_nc_oc=Adqubpf9R7ivg9mGAoJOca2yjTEDpQZPAUQbbQMd3ARNdEgPyOcC1FKRiD9yGBnZvIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O5M9JioL0Kyc7NWMS2gSjnl_STAxaTufP_WuFVIqeBA&oe=6A3AAD23"}, {"file_name": "20220921_115722.png", "id": "812601670358730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982501_812601673692063_4888023167364672866_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDy1P9lmN5wQ7kNvwGQ6Eq3&_nc_oc=Adpfk5dwuslLzxMnyvrwETJZ6ynRc7ucSpGiwvwA3TMPTpPFw3zcjsBiv7Zyp1QhhgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qjR7vMwEzSGDYG88QfNojK53HHtxCWhnUb2HczC3D1A&oe=6A3A8F8D"}, {"file_name": "20220921_124143.png", "id": "2946687445462416", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_2946687452129082_8823392805038975644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_98QaiLtzEcQ7kNvwEH2zsq&_nc_oc=AdqcvBrDHv23MGGjTCNuM4JeKkbjl6DLMpIOZgIABnpAB7xPEvCI5uGag5Zkbutq_nA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nPHzWwBDI2TwVwd-BsKutLOioJJlmlrIt49iuOWKMCw&oe=6A3A9D83"}, {"file_name": "20220921_134536.png", "id": "959926015118349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974792_959926018451682_7454046409305224501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbhyTOO7ldMQ7kNvwGgPd1q&_nc_oc=Ado692E-QMlEMK_Z5lRvxQjAb8QnCjeO3W_EAMM6Iy8JVNQvkhUT8_SKyQYg17OU4BU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XkbFAOcnFqu8Jm673OlLwrbBBURbsj-OnDrnkuxeYxg&oe=6A3AB26A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oktoberfest", "keywords": [], "long_description": "This VR Experience is a real visit to the German Octoberfest in Munich in Virtual Reality.\nWolfgang Brehm the official city guide of Munich accompanies you around the Octoberfest and explains you everything.\n\nThere are no simulation all is real. It is a real visit.\n\nYou have never seen this before. \nThis is the ultimate VR Experience ... frameless. \n\nYou get a unique impression of the biggest folk festival in the world. It has been held annually since 1810 on the Theresienwiese in Munich. Experience the most important beer tents (also from inside), the Bavaria (incl. ascent to the head), the Oide Wiesn (traditional festival and shoe platters) and many attractions such as a round trip on the ferris wheel. Let yourself be carried away into the world of Bavarian traditions, Dirndl & Lederhosen, beer tents, Munich\u2019s beer, Bavarian music, beer mugs, shoe platters, chain carousel, giant wheel and many more. The tour starts at the main entrance and shows all the top sights. \n\nSome examples: \n- Along the Wirtsbudenstra\u00dfe with many large beer tents\n- Tent Fischer-Vroni (how\u201dfish on a stick\u201d is made) \n- Hofbr\u00e4u tent (the largest beer tent at the Oktoberfest with space for approx. 10,000 guests) \n- Augustiner-Festhalle (here you can buy beer from the wooden barrel) - Visit of Bavaria (ascent to the head of Bavaria) - K\u00e4fer Wies\u2019n Sch\u00e4nke (where you can meet the celebrities) \n- Oide Wiesn / Traditional festival (shoe platters) \n- Ride with the ferris wheel (great view of the Octoberfest)", "short_description": "Join Wolfgang Brehm - the official city guide of Munich - in a real Virtual Reality tour through the Octoberfest in Munich, Germany. It is a real visit.\nWolfgang accompanies you around the Octoberfest and explains you everything.\n\nYou will have 4 hours to see everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/oktoberfest", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/oktoberfest", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "827501475629850"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "867148323094806"}, {"status": "PUBLISHED", "id": "916475314656418"}, {"status": "PUBLISHED", "id": "4269328263351936"}, {"status": "PUBLISHED", "id": "2621029108275287"}, {"status": "PUBLISHED", "id": "1083420133803997"}, {"status": "PUBLISHED", "id": "1499528407955731"}, {"status": "PUBLISHED", "id": "1465004411316619"}, {"status": "PUBLISHED", "id": "13990453445678
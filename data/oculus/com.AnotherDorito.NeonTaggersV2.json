KBOlUvSVe2ct6DvKXWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu4jP4XcbQlQ8vvuYlhOVViKOczpsC_TkD2SPr-rZhCw&oe=6ACCEC25"}, {"file_name": "Screenshot #5.png", "id": "1315214570400897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593858738_1315214573734230_212995213216564280_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHCzXiw7ro4Q7kNvwEsVwKF&_nc_oc=AdozifwNb4QsV73xepJmBnwdfjjMtoE3FqIFnAMEbROSBC3Gn9ynrPDGxyUoVCWGMqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqFc6J79RGUOUZu81Jk50xZFKG6uhsAYlKLm5j0zlXfw&oe=6ACD00DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neon Taggers V2", "keywords": [], "long_description": "Our app delivers an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical movement mechanics to navigate the environment, creating a unique sense of freedom while rewarding practice, precision, and creativity. Every jump, climb, and push forward is entirely controlled by the player, making progression feel satisfying as movement skills improve over time.\n\nAt the heart of the experience is a custom-designed parkour map built to challenge players of all skill levels. Beginners can learn the basics of locomotion, while experienced players can refine advanced movement techniques through carefully designed obstacles, precise jumps, and creative traversal routes. The environment encourages exploration and experimentation, allowing players to discover faster paths and improve their efficiency with every run.\n\nPlayers can also personalize their in-game appearance through a cosmetic system featuring a variety of customization options. Whether choosing a simple style or a more eye-catching look, players can express their personality and make their experience feel unique. By combining immersive locomotion, rewarding parkour challenges, and meaningful customization, our app creates an experience that encourages players to keep improving, exploring, and having fun every time they play.", "short_description": "Our app uses Gorilla Tag\u2013style locomotion to create a fun and immersive experience centered around movement and creativity. Players can explore a custom-built parkour map designed to challenge their agility, timing, and skill. The unique locomotion system allows for fluid climbing, jumping, and traversal, making every movement feel engaging and rewarding. In addition to gameplay, the app features a variety of cosmetics that let players customize their appearance and stand out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neontaggersv2pp/inicio", "developer_terms_of_service_url": null, "publisher_name": "Mart\u00edn Fernandez", "support_website_url": null, "website_url": "https://sites.google.com/view/neontaggersv2/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1301632023027121"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1325246053999051", "version": "1
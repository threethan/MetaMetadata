zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbkGmaiJ4UgAKf4ad4lS--hM3okgJQv0zOXlt9IXEq2Q&oe=6B09A947"}, {"file_name": "SCREEN_5.png", "id": "1132088471356761", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031350_1132088474690094_2513089939497492850_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4VtWKkWDf4Q7kNvwHd0Fkz&_nc_oc=AdoFaU8Mo4L_WgdwuiZlaMc_fWroWj0JSfvYlK6F5D1XioaTz9Vfwh5L_myQ5SnRs78&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQvRij_L8b39_KaXP68IG1IrLLToz09eA5k5yyMak30w&oe=6B09B76D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1465584857472922", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974500_1465584860806255_7766854712898267653_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etEAebVjhBAQ7kNvwHZ1sB7&_nc_oc=AdppgBTU0Ec4B4k3xmPMqnxirM769xIcQwM3BHi-FVrLaH2ZqyW2cfP5VwIutKwA8Dc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPG63iMtpg-Q0JK-5GC38V1HgTch0uxvyvKRYCdwasuw&oe=6B09D201"}, "display_name": "FortiCasa", "keywords": [], "long_description": "Immerse yourself in a unique strategic defense adventure with FortiCasa: AR Robot Defense for Oculus Quest! This game brings the tower defense genre to your living space using augmented reality. Transform your room into a futuristic battlefield and defend your base from waves of hostile robots.\n\nIn FortiCasa, your mission is to protect your base from relentless robotic attacks. Strategically place powerful turrets around your play area to create a fortress. Utilize your real-world environment to enhance your defenses and adapt to the evolving threats posed by different types of robotic enemies.\n\nKey Features:\n\n- Augmented Reality Immersion: Your room becomes the battlefield, with robots seamlessly blending into the real world.\n- Strategic Depth: Choose and place turrets, each with unique abilities and upgrade paths, to optimize your defense.\n- Varied Arsenal: Access a selection of defensive turrets, including rapid-fire cannons, laser beams, and explosive launchers. Upgrade them to increase their effectiveness.\n- Dynamic Challenges: Face increasingly difficult waves of enemies with varying strengths and attack patterns. Adapt your strategy to counter different robotic foes.\n\nGear up and defend your base with precision and strategy. Can you withstand the robotic onslaught and become the ultimate defender in FortiCasa: AR Robot Defense? Your fortress awaits!", "short_description": "\nImmerse yourself in an unparalleled strategic defense experience with FortiCasa for Oculus Quest 3! Transform your room into a futuristic battlefield using augmented reality and defend your base from relentless waves of hostile robots. Plan your strategy, place defensive turrets around your play area, and utilize your real environment to create an invincible fortress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eyeliensheroes.com/documents/privacy_forti.html", "developer_terms_of_service_url": null, "publisher_name": "Floaty S.r.l.", "support_website_url": null, "website_url": "https://floaty.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8596502950382194"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baselin
/39035430_1647335829381289_2263322871571288497_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IorAL99rQssQ7kNvwFpgfgI&_nc_oc=AdorI11_M-TS-KRmYUVIXQ3HHzTknojOf8-c8uodjJwMLDXTZ1H3gwTs-sb7cp-LFNg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EXHkaMYDFmTVMw68qO0dSR07--7dc_zHldRUlXzVh-A&oe=69F1E76D"}, {"file_name": "SCREEN_2.png", "id": "991061998991291", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572953_991062002324624_2438135491551864254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx1j2Da03QUQ7kNvwFrcX9V&_nc_oc=AdpxjYfg2s2asVAL922o7bxQ42Q78_pkOHmsD0StC5LDKOFa-xJ861XsXr7zeDR0KvA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0WO4RJ1eP6qga-vgrrF34iGhrnsCVmUStDFKoOSDS75A&oe=69F1E5C6"}, {"file_name": "SCREEN_3.png", "id": "2695344147327953", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86636486_2695344150661286_8929751713226599295_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSl_Rk4ZoN0Q7kNvwGRL0Vl&_nc_oc=Adq3I-YfC_qEI83UYrKec1Rmch95MeHf8ibi58tWh0FIjcnFrr4rCA9ZyUX_A-pOfQw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3781osfddxss1qR3kNWmoZwVwPJXidJJWpoDXO45i3UA&oe=69F217FD"}, {"file_name": "SCREEN_4.png", "id": "814968403674639", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982568_814968407007972_8019743597048671869_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8T94GyhJH-sQ7kNvwERJ7k6&_nc_oc=Ado2lsrv_Lj8E5QdD2zq7lDVJ13FaKETxDpDRcDTgeUgBz6sR813LSKZhRfHmMRHBjA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0Dkmj4DTipWR2uf5L9wgdkWMgdViQDSPLx0ggvIPaKyw&oe=69F1F307"}, {"file_name": "SCREEN_5.png", "id": "1132088471356761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031350_1132088474690094_2513089939497492850_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yoa8WwROMMQ7kNvwG9PACb&_nc_oc=AdoVEbXh2WMKzHbbbejrg1Jpc7if5rmftCZgsolTf8twDU3anoKtp8LdRzLvjPe7f-8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aclIq06z2tWH5cJDizUyPI0hjpCJblWnN1uWLlx2PTg&oe=69F2012D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1465584857472922", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974500_1465584860806255_7766854712898267653_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoY5b0sZCBcQ7kNvwHqMkDX&_nc_oc=AdqGl3fUHqr4RZW3LZoOM9CQfLyJz5jqq59RDXAwn8LtDfk4V0e3lnAV0ReTRna95zc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3wc_YIhtu-awOtOa6nkpxMRTf2IttL55fjs_pOBGgfJw&oe=69F21BC1"}, "display_name": "FortiCasa", "keywords": [], "long_description": "Immerse yourself in a unique strategic defense adventure with FortiCasa: AR Robot Defense for Oculus Quest! This game brings the tower defense genre to your living space using augmented reality. Transform your room into a futuristic battlefield and defend your base from waves of hostile robots.\n\nIn FortiCasa, your mission is to protect your base from relentless robotic attacks. Strategically place powerful turrets around your play area to create a fortress. Utilize your real-world environment to enhance your defenses and adapt to the evolving threats posed by different types of robotic enemies.\n\nKey Features:\n\n- Augmented Reality Immersion: Your room becomes the battlefield, with robots seamlessly blending into the real world.\n- Strategic Depth: Choose and place turrets, each with unique abilities and upgrade paths, to optimize your defense.\n- Varied Arsenal: Access a selection of defensive turrets, including rapid-fire cannons, laser beams, and explosive launchers. Upgrade them to increase their effectiveness.\n- Dynamic Challenges: Face increasingly difficult waves of enemies with varying strengths and attack patterns. Adapt your strategy to counter different robotic foes.\n\nGear up and defend your base with precision and strategy. Can you withstand the robotic onslaught and become the ultimate defender in FortiCasa: AR Robot Defense? Your fortress awaits!", "short_description": "\nImmerse yourself in an unparalleled strategic defense experience with FortiCasa for Oculus Quest 3! Transform your room into a futuristic battlefield using augmented reality and defend your base from relentless waves of hostile robots. Plan your strategy, place defensive turrets around your play area, and utilize your real environment to create an invincible fortress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eyeliensheroes.com/documents/privacy_forti.html", "developer_terms_of_service_url": null, "publisher_name": "Floaty S.r.l.", "support_website_url": null, "website_url": "https://floaty.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8596502950382194"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1511828486855894"}, {"status": "PUBLISHED", "id": "1045169634386859"}, {"status": "PUBLISHED", "id": "1367508594290396"}, {"status": "PUBLISHED", "id": "599664452683476"}, {"status": "PUBLISHED", "id": "897405722362739"}, {"status": "PUBLISHED", "id": "478302615109296"}, {"status": "PUBLISHED", "id": "1204884953865490"}]}, "baseline_offer": {"id": "1204884953865490"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1761325200, "status": "PUBLISHED", "id": "1511828486855894"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "
": "1647335826047956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035430_1647335829381289_2263322871571288497_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTm6QgP1xdoQ7kNvwF1YGsN&_nc_oc=AdopKnZxMGYD8Wly_rpREWT3RhdX-ETbUuqrM8zimEt59qx5MLyDOHm8U7LvTSWfAlE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-oOPD_j2c3hgyuJUr0fsr_ZBWJTrNE5pXR55-LYubIw&oe=6AA9602D"}, {"file_name": "SCREEN_2.png", "id": "991061998991291", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57572953_991062002324624_2438135491551864254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3r1uozbwRswQ7kNvwHM_OXF&_nc_oc=AdonmANxnaoEhwAmSzjpzvnjrSg2hn0nX95xMFeWhZO0pyMrlbRILV5Lp22YinEqBrg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYtqD08-y2JhtJcFBMzkKihAxtZfMdcuQ1occvPlNckg&oe=6AA95E86"}, {"file_name": "SCREEN_3.png", "id": "2695344147327953", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86636486_2695344150661286_8929751713226599295_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoUQ9dRKt1cQ7kNvwFHnV6y&_nc_oc=AdoiujD2p9HZsGT_L-x7B1lWwIre9FUzFNHm4Xf8ua72AIx0OhGuhdc9eeyCb0DIscI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhne1N9nHCAB2to7sH46wESEYVecUaAl_XcUTa7xeX5g&oe=6AA9587D"}, {"file_name": "SCREEN_4.png", "id": "814968403674639", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982568_814968407007972_8019743597048671869_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi_ObrTEGGUQ7kNvwExu2f0&_nc_oc=Adq-cSW5ecgv2KzFwTB5ErX5v4GC0DGy_Y0o01UGLwaZKqcYzW9RwBaNLzBo_CI4Z8I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlW0kYCJJQHZTohHnIPO7wvwKV8TM2_JJmbritAFlmtQ&oe=6AA93387"}, {"file_name": "SCREEN_5.png", "id": "1132088471356761", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031350_1132088474690094_2513089939497492850_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cej0M7VTCmsQ7kNvwE0wmIq&_nc_oc=Adp04FJNKAHdncQquepISwUWhr0_R1iA7rUHDFEloQwUc4qfrKN7kg_zfoNGRmcc23Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRvCHx3GFgP4OCx7Tvxq5pvsuE0kmyjDoWR-0Bsjt-CA&oe=6AA941AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1465584857472922", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974500_1465584860806255_7766854712898267653_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8El4YJpsoQQ7kNvwEaJdRf&_nc_oc=AdqYsqN_luAzl1aNmtG06cfNOHlHkv4KSG6k3bXbjgzFPHUEzorPPjCimd3-l8q-sxI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGBCQFZJEG3YGcaHpc4knlC9uddhwP8xbZ5PdBm5bpMQ&oe=6AA95C41"}, "display_name": "FortiCasa", "keywords": [], "long_description": "Immerse yourself in a unique strategic defense adventure with FortiCasa: AR Robot Defense for Oculus Quest! This game brings the tower defense genre to your living space using augmented reality. Transform your room into a futuristic battlefield and defend your base from waves of hostile robots.\n\nIn FortiCasa, your mission is to protect your base from relentless robotic attacks. Strategically place powerful turrets around your play area to create a fortress. Utilize your real-world environment to enhance your defenses and adapt to the evolving threats posed by different types of robotic enemies.\n\nKey Features:\n\n- Augmented Reality Immersion: Your room becomes the battlefield, with robots seamlessly blending into the real world.\n- Strategic Depth: Choose and place turrets, each with unique abilities and upgrade paths, to optimize your defense.\n- Varied Arsenal: Access a selection of defensive turrets, including rapid-fire cannons, laser beams, and explosive launchers. Upgrade them to increase their effectiveness.\n- Dynamic Challenges: Face increasingly difficult waves of enemies with varying strengths and attack patterns. Adapt your strategy to counter different robotic foes.\n\nGear up and defend your base with precision and strategy. Can you withstand the robotic onslaught and become the ultimate defender in FortiCasa: AR Robot Defense? Your fortress awaits!", "short_description": "\nImmerse yourself in an unparalleled strategic defense experience with FortiCasa for Oculus Quest 3! Transform your room into a futuristic battlefield using augmented reality and defend your base from relentless waves of hostile robots. Plan your strategy, place defensive turrets around your play area, and utilize your real environment to create an invincible fortress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eyeliensheroes.com/documents/privacy_forti.html", "developer_terms_of_service_url": null, "publisher_name": "Floaty S.r.l.", "support_website_url": null, "website_url": "https://floaty.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8596502950382194"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9874306892601787", "version": "1.6"}, "id": "3770996529846025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appli
": "1647335826047956", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035430_1647335829381289_2263322871571288497_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hIXE7qA8pcQ7kNvwFA2N1-&_nc_oc=AdrcBwSzBRSlwZNTe6-7_uXDD2GDncxUr4kBPWbA6bTxQU46yJsZrBjAt0rvBrhpiQo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ieuXbyEdmY3RsBwmJlUuslQtyaI92RiE5gvGh5KQmcQ&oe=6A467FAD"}, {"file_name": "SCREEN_2.png", "id": "991061998991291", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57572953_991062002324624_2438135491551864254_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuWyws5SJOoQ7kNvwFH32Io&_nc_oc=AdolldFBIlxyISCYQ7e0V89eUKN6LillEGKIjLDLk2Q2NPHRl-kTieLD0eeMFH5X44c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gbuCnhfnXGwdnvF9exfL9GufayE7Gr28Wj89JaiQzPA&oe=6A467E06"}, {"file_name": "SCREEN_3.png", "id": "2695344147327953", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86636486_2695344150661286_8929751713226599295_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xn3bXieQcvcQ7kNvwFMr-x2&_nc_oc=Adpvu0AxPlV0Zy8hTq7Po44c5UlZ686M5nwJWmbpaB5mKPssM3W92PzM2aM6ZhwXKcA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-69bIEaRM1z04STT4uUMuD3cFt5l_5g5lfNFQHAJ27uA&oe=6A4677FD"}, {"file_name": "SCREEN_4.png", "id": "814968403674639", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982568_814968407007972_8019743597048671869_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thKRdPzSu3EQ7kNvwHA8RnZ&_nc_oc=Ado2qwD7hoMPYcQYg3gFUGo5YglUIG1PfwgkjMD9lzHil0nTsbDWFEF8qoqaYQp9-w4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81ED1D1t0loV6sair-XAZqPW1zUVg6NA02PNTWag_npQ&oe=6A468B47"}, {"file_name": "SCREEN_5.png", "id": "1132088471356761", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031350_1132088474690094_2513089939497492850_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c8oFUAFipgQ7kNvwEcwgFt&_nc_oc=AdrdbXMvdCkz4LOGmXViEooEwVAnU3KfF1EDsL3KUMgZPmcdw3LvLrq3_jjIoSzDcN8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TW9pTlWsXxj08hqmmXmVuw9mPN2X7Vtvk1vnRJIBZgw&oe=6A46612D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1465584857472922", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974500_1465584860806255_7766854712898267653_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw6M-4P3t2EQ7kNvwHgwXYw&_nc_oc=Ado5B9uMIL3tuPlvhIaL_hTaD6i_Qkhnr1m30vFvLbnc5UtV7TcZTOLsS6ROQYClaks&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T3EspZKYEgFHHn2k90W3UPzLEDX9OpW-F1pU8DlaiAg&oe=6A467BC1"}, "display_name": "FortiCasa", "keywords": [], "long_description": "Immerse yourself in a unique strategic defense adventure with FortiCasa: AR Robot Defense for Oculus Quest! This game brings the tower defense genre to your living space using augmented reality. Transform your room into a futuristic battlefield and defend your base from waves of hostile robots.\n\nIn FortiCasa, your mission is to protect your base from relentless robotic attacks. Strategically place powerful turrets around your play area to create a fortress. Utilize your real-world environment to enhance your defenses and adapt to the evolving threats posed by different types of robotic enemies.\n\nKey Features:\n\n- Augmented Reality Immersion: Your room becomes the battlefield, with robots seamlessly blending into the real world.\n- Strategic Depth: Choose and place turrets, each with unique abilities and upgrade paths, to optimize your defense.\n- Varied Arsenal: Access a selection of defensive turrets, including rapid-fire cannons, laser beams, and explosive launchers. Upgrade them to increase their effectiveness.\n- Dynamic Challenges: Face increasingly difficult waves of enemies with varying strengths and attack patterns. Adapt your strategy to counter different robotic foes.\n\nGear up and defend your base with precision and strategy. Can you withstand the robotic onslaught and become the ultimate defender in FortiCasa: AR Robot Defense? Your fortress awaits!", "short_description": "\nImmerse yourself in an unparalleled strategic defense experience with FortiCasa for Oculus Quest 3! Transform your room into a futuristic battlefield using augmented reality and defend your base from relentless waves of hostile robots. Plan your strategy, place defensive turrets around your play area, and utilize your real environment to create an invincible fortress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eyeliensheroes.com/documents/privacy_forti.html", "developer_terms_of_service_url": null, "publisher_name": "Floaty S.r.l.", "support_website_url": null, "website_url": "https://floaty.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8596502950382194"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9874306892601787", "version": "1.6"}, "id": "3770996529846025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appli
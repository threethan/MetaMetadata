h=00_AQQBVmFJl8YmE8e6tgcCHIbyPu4Gb9ut8iSa0SabENH0ww&oe=6AECB076"}, {"file_name": "Screen main stage.png", "id": "1054744022879043", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974446_1054744026212376_1612213388341339050_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9uj01zI9MMQ7kNvwH4AxOQ&_nc_oc=AdqZmjic8CExhWTEL3gRsQYuCywptw2SLa_j3zCSI1gdclx0SRz6r4molewanbvb7tc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhwF6rb5IyyqY0uhSCLS_dcA8qTf2qKdJSC9RmPZWW1g&oe=6AEC9B91"}, {"file_name": "2.png", "id": "1048770456425391", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974745_1048770459758724_596666010182558140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGH8yvycL_4Q7kNvwFFch6z&_nc_oc=Adr9oH-tzEuuMP_1ASJ-yuqiVZOz-bNaG_ufEt6kt-aI02eszuE1eAVxjyHX9Mzf6Mw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_9i-f9CrEv80unYGi-Z73zH3oooH6vfsmyl6lwYy6VA&oe=6AEC9DD1"}, {"file_name": "1.png", "id": "829802755911108", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031427_829802759244441_6854566838419245248_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iwtlcPKTukQ7kNvwEfXF7r&_nc_oc=Adrm8Q4s1Yo6HvSVaEcY6YWBz6sm094SF0F3yZYcEljgV4Mvj_Ek-H561n94JLOdY98&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLIs-EzAgEdhU9ajFVxaqYB4tSaSdPwqlNdz59_f21lQ&oe=6AECA257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "qhd2560.png", "id": "2254036368265473", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974809_2254036371598806_3599825504354969670_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMFqyAts0LAQ7kNvwHaX4Jj&_nc_oc=Ado9yRi09JSd0oZGZpnxlkIvP6wxF1CUnlz8rJdIoshznLTe-keQSkWq_6kZ2B2o7zQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv1DviQVMJ90K-L9vs8vBSEC2XicfvXYDlFN2R3Cpywg&oe=6AECB280"}, "display_name": "VR Club Live: Tripica", "keywords": ["Social", "Club", "Party", "Dance", "vrclub"], "long_description": "# 24/7 VR Music Festival\nJoin an endless music festival like no other. Connect with friends and fellow music lovers worldwide. Experience concerts and parties in a whole new dimension!\n\n# \ud83c\udfdd\ufe0f Explore an Exotic Paradise\n{1687514935350897}\nEscape to a tropical island oasis where music and nature intertwine. Discover two mesmerizing music scenes:\n\n- **Pier Scene:** Dance above crystal-clear waters with a stunning sunset backdrop.\n- **Volcano Caves:** Feel the heat and energy in caves beneath an erupting volcano.\n\n# \ud83c\udfb6 Revolutionary Music Experience\n{753455103458959}\nImmerse yourself in our cutting-edge sound-reactive environments where every beat comes alive:\n\n- **Dynamic Playlists:** Enjoy a constantly evolving musical journey.\n- **VJ Spot:** Create visual spectacles for others and become a part of the show.\n- **Haptic Feedback:** Feel the music with enhanced sensory feedback.\n\n# \ud83e\udd1d Interactive Features & Games\n{379958421473523}\nSocialize and play with music enthusiasts from around the globe. Dive into fun activities that keep the excitement going:\n\n- **Dance Games:** Challenge your rhythm and coordination with exciting dance games.\n- **Social games:** Enjoy endless laughter and fun with games like \u201cNever Have I Ever...\u201d.\n\n# Join the Future of Music Festivals!\nDon\u2019t miss out on the ultimate VR music festival experience. Download VR Club Live: Tripica now and be part of a revolutionary way to enjoy music, socialize, and play. With our state-of-the-art technology and mesmerizing environments, **you'll never want to leave!**", "short_description": "\ud83c\udfb6Endless Music Festival Like No Other\nStep into a revolutionary VR experience where music and technology come alive. Connect with friends and fellow music lovers from around the world, and experience concerts and parties in a whole new dimension!\n\n\ud83e\udd1dJoin the Future of Music Festivals!\nDon't miss out on the ultimate VR music festival experience. Download VR Club Live: Tripica \ud83c\udfdd\ufe0fnow and become part of a revolutionary way to enjoy music, socialize, and play.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrclub.live/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRCOO", "support_website_url": null, "website_url": "https://vrclub.live/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8509070032537016"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974796_1783814455719830_1554891625959797831_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qxvOk0uOzYQ7kNvwFlVSCA&_nc_oc=AdqdnOIfGq34N56BtW56qan4mmixIRbwQ031_I20QIS4zvDnKnoupC12k4zHSI6CbuI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQILQ5qZUNjgt4vd0tl4re-nr9F13VFZ4jErmFazzDMjA&oe=6AEC9F12"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Club Live: Tripica", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 172
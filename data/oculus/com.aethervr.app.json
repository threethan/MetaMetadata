": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_4501020733490492_559389947930125473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71Zzpw1HRIMQ7kNvwESppw_&_nc_oc=Adrrm7x-5KssOLJTBJ687Ob9Qx5AW96Pk4lGQ1SbIY-9t3Q0OBs7Z4dgtt26IXlZfnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8WO6ACzUEdq90DUL23qrd-u196ZDvSK25VKrk1DG6CQ&oe=6AEA0272"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "2364170464117253", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2364170467450586_4474229378585466878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuA7awJt-fQQ7kNvwEh53ap&_nc_oc=AdrmB4CYVUlagAmLmXyhq89yDHxzjIcNxmXw1bP9Y_vLWgoYer3c51bm0O50rq-lRzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMHPwaJuHn2L_BVB1wp3SSZp4XNHYC1yRTDErMpvPpCw&oe=6AE9E8F8"}]}, "id": "1792561178542897", "locale": "en_US", "screenshots": [{"file_name": "01_accueil.png", "id": "1048887481248873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1048887484582206_6346522421245518439_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a8bGTLPXY4Q7kNvwGN3Zhm&_nc_oc=AdoGIJ1JEgNAznSH6avVem1SsuZNHUNWqQJwtu_LVp9Yz2vOM9dpIulTl8fKCWzDEvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmCGGVbTmNqMv35S77LFu9E9h7tSWEcThgNSDMJqa4xg&oe=6AE9E52A"}, {"file_name": "02_decouvrir.png", "id": "947420398407018", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_947420401740351_621219732488264316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vdz1KOzFY10Q7kNvwF6XMDU&_nc_oc=AdqDniUbMWJ9hF3AtNZ5qm9e1BR6CA_qVAt2tGdPWg_R-jfFbByAb24NqmcwcCzteYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVvOCdw_dhCJGdol0y8bUv9XrU5zKwCZfcTkXuIoT2WA&oe=6AEA0930"}, {"file_name": "03_avatars.png", "id": "2171514510092915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_2171514513426248_6427843950098420566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXiBMdtm_GkQ7kNvwEMT8Vh&_nc_oc=AdqhMpQNCTpRGEe0HP15jC52bWsUb40sPXRRYOwnIRLu6tyKDLPH6I-AUOoi4tsppfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjd3A8Hf26DwT9BMJ8YRfDVbgcFqNrl7XjSgbmkaDu0w&oe=6AE9EC3C"}, {"file_name": "04_profil.png", "id": "1597545348638618", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1597545351971951_1735308775829175113_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VIKP699mqgQ7kNvwHnppBy&_nc_oc=Adr8HfHb1DByfSoaUm_z4jTCss41j0Z7OdJ_RP8p2gH2JCU-L3rm_Xr_pLxzs4_m6sE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn1VnsNioJGhn47BS2KT2z4Thk4ziSKttGayvgTnXCeA&oe=6AE9F5EC"}, {"file_name": "05_parametres.png", "id": "1461631792519472", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1461631795852805_769357511860802845_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4bjhRf7YtgQ7kNvwEKyimN&_nc_oc=Adp4YAEvFaENcs2ks1azPI1HAVBaxA74dPb1w4E7Zu_MTenZu19C039xw_ZY7cVy0eU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqQajyLnK9luB-O29WYwWfmxYhs9MIbe-rpibkVpr8DA&oe=6AEA0424"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RDK VRC", "keywords": ["vrchat", "osc", "chatbox", "vr", "compagnon"], "long_description": "RDK VRC est une application compagnon non officielle pour VRChat, pens\u00e9e pour rester ouverte pendant que tu joues sur ton casque Quest.\n\nConnecte-toi directement avec ton compte VRChat (avec support de la double authentification) pour acc\u00e9der \u00e0 tes informations et tes avatars.\n\nMagic Chatbox envoie automatiquement des informations utiles dans ton chatbox VRChat pendant que tu es en jeu : l'heure, la musique en cours de lecture, le niveau de batterie de ton casque, ou tes propres textes personnalis\u00e9s. Le tout continue de fonctionner m\u00eame quand l'application est minimis\u00e9e derri\u00e8re VRChat, gr\u00e2ce \u00e0 un service en arri\u00e8re-plan. Plusieurs styles de mise en forme sont propos\u00e9s pour personnaliser l'affichage du message.\n\nLa page OSC permet de configurer la connexion utilis\u00e9e pour envoyer les messages vers VRChat.\n\nRDK VRC n'est pas affili\u00e9 \u00e0 VRChat Inc. Aucune donn\u00e9e de connexion n'est stock\u00e9e par l'application : elle sert uniquement \u00e0 te connecter directement \u00e0 VRChat.", "short_description": "Compagnon non officiel pour VRChat sur Quest. Connecte-toi \u00e0 ton compte, g\u00e8re ton chatbox avec Magic Chatbox (heure, musique en cours, batterie du casque envoy\u00e9es automatiquement en jeu), configure l'OSC et retrouve tes avatars, le tout sans quitter ta session VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdkvrc.fun/#confidentialite", "developer_terms_of_service_url": null, "publisher_name": "Ruskov Corp", "support_website_url": null, "website_url": "https://rdkvrc.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1351675204695839"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1780227992999213"}]}, "baseline_offer": {"id": "1780227992999213"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788548220, "status": "PUBLISHED", "id": "1780227992999213"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Android
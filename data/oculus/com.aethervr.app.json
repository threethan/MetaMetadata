NLlMpgJEK_07YGbyNml7FftHh_K5K7Edyq5-yFgSwCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPQiUOjJ2IQlh4Cj30aY4VHZpj8cck9X115qzKkvOoiw&oe=6AFDCFB0"}, {"file_name": "03_avatars.png", "id": "2171514510092915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_2171514513426248_6427843950098420566_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8Q9OWX2hHMQ7kNvwGoWeA0&_nc_oc=Adonr4gh8lV5fmNWSMs65u7Adh0nS723b15qK284XV6lj2n5ojP5RezmZSA5E_zvM18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF_bVSsMuJ-WXzJQplh4A5tWAS-XNNfU-XgsrwtI6SgQ&oe=6AFDB2BC"}, {"file_name": "04_profil.png", "id": "1597545348638618", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1597545351971951_1735308775829175113_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYZ88t3Xz64Q7kNvwEAROQM&_nc_oc=Adq-5FDpkeyeSiu4n6Je1yPfoZjNrDU58C_eQ6XdrTUpx7oXYUPRY0shWX6G5yI9TJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQul53z5Z4KXx2YYgMUrf-pE2SWsn--pVDt-zgw-pox0g&oe=6AFDBC6C"}, {"file_name": "05_parametres.png", "id": "1461631792519472", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1461631795852805_769357511860802845_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABXKI82GeF4Q7kNvwEelbdN&_nc_oc=AdqcrbZn9LOjr99D-dWc5WvSPm3L9v1IPX2NF-SQjm69BRQeGu4TrCsqOc8drvJdzw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtUIvCyDiocLgQOTTqLd4Zv77tmQfX8Ju-NMujgcnp1A&oe=6AFDCAA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RDK VRC", "keywords": ["vrchat", "osc", "chatbox", "vr", "compagnon"], "long_description": "RDK VRC est une application compagnon non officielle pour VRChat, pens\u00e9e pour rester ouverte pendant que tu joues sur ton casque Quest.\n\nConnecte-toi directement avec ton compte VRChat (avec support de la double authentification) pour acc\u00e9der \u00e0 tes informations et tes avatars.\n\nMagic Chatbox envoie automatiquement des informations utiles dans ton chatbox VRChat pendant que tu es en jeu : l'heure, la musique en cours de lecture, le niveau de batterie de ton casque, ou tes propres textes personnalis\u00e9s. Le tout continue de fonctionner m\u00eame quand l'application est minimis\u00e9e derri\u00e8re VRChat, gr\u00e2ce \u00e0 un service en arri\u00e8re-plan. Plusieurs styles de mise en forme sont propos\u00e9s pour personnaliser l'affichage du message.\n\nLa page OSC permet de configurer la connexion utilis\u00e9e pour envoyer les messages vers VRChat.\n\nRDK VRC n'est pas affili\u00e9 \u00e0 VRChat Inc. Aucune donn\u00e9e de connexion n'est stock\u00e9e par l'application : elle sert uniquement \u00e0 te connecter directement \u00e0 VRChat.", "short_description": "Compagnon non officiel pour VRChat sur Quest. Connecte-toi \u00e0 ton compte, g\u00e8re ton chatbox avec Magic Chatbox (heure, musique en cours, batterie du casque envoy\u00e9es automatiquement en jeu), configure l'OSC et retrouve tes avatars, le tout sans quitter ta session VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdkvrc.fun/#confidentialite", "developer_terms_of_service_url": null, "publisher_name": "Ruskov Corp", "support_website_url": null, "website_url": "https://rdkvrc.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_trac
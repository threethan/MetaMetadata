3Ybi1IlgkkFS1hQ-pcQxR00OzV-akEqs1EVF_nCAhjtP1ScAlAgtY2NY27BE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCatG8Gqp-cbva3BaclHhawRF5mOv4UMw-yZWgmpdzlA&oe=6ABBD16C"}, {"file_name": "05_parametres.png", "id": "1461631792519472", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1461631795852805_769357511860802845_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGDGYPdDWs4Q7kNvwGbqgmd&_nc_oc=AdpStrqW2McsZm628Slt9RM8eAvdgDj7F0C01F9BrTVhNoEdEDuRAHMxh_PBmAcJChI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7C5DlMo8fTuB5TSFfveW659tPc1g-RBq5suqdkm4kSw&oe=6ABBDFA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RDK VRC", "keywords": ["vrchat", "osc", "chatbox", "vr", "compagnon"], "long_description": "RDK VRC est une application compagnon non officielle pour VRChat, pens\u00e9e pour rester ouverte pendant que tu joues sur ton casque Quest.\n\nConnecte-toi directement avec ton compte VRChat (avec support de la double authentification) pour acc\u00e9der \u00e0 tes informations et tes avatars.\n\nMagic Chatbox envoie automatiquement des informations utiles dans ton chatbox VRChat pendant que tu es en jeu : l'heure, la musique en cours de lecture, le niveau de batterie de ton casque, ou tes propres textes personnalis\u00e9s. Le tout continue de fonctionner m\u00eame quand l'application est minimis\u00e9e derri\u00e8re VRChat, gr\u00e2ce \u00e0 un service en arri\u00e8re-plan. Plusieurs styles de mise en forme sont propos\u00e9s pour personnaliser l'affichage du message.\n\nLa page OSC permet de configurer la connexion utilis\u00e9e pour envoyer les messages vers VRChat.\n\nRDK VRC n'est pas affili\u00e9 \u00e0 VRChat Inc. Aucune donn\u00e9e de connexion n'est stock\u00e9e par l'application : elle sert uniquement \u00e0 te connecter directement \u00e0 VRChat.", "short_description": "Compagnon non officiel pour VRChat sur Quest. Connecte-toi \u00e0 ton compte, g\u00e8re ton chatbox avec Magic Chatbox (heure, musique en cours, batterie du casque envoy\u00e9es automatiquement en jeu), configure l'OSC et retrouve tes avatars, le tout sans quitter ta session VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdkvrc.fun/#confidentialite", "developer_terms_of_service_url": null, "publisher_name": "Ruskov Corp", "support_website_url": null, "website_url": "https://rdkvrc.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1351675204695839"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_4550450481906685_2176566322006449891_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vkp0tZCo_AQ7kNvwGP8q1U&_nc_oc=AdonJ-mH2OxPbnfAWnQLKG_3euepTVWYK_yC8LGQQP9B4M9YIv9ajAvNgENUupjKMRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHhaZZ9Qv2duNjd81N69g2-Vr72dZ-LLyvlk_H6KAvNQ&oe=6ABBE0D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RDK VRC", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Community", "id": "1228796255027646"}], "release_date"
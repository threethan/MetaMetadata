": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_4501020733490492_559389947930125473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTLRrfe5yjUQ7kNvwH031Rb&_nc_oc=AdomeHymY4JBIhUSxO_RnMex_RsEYV5d7VwR6NBFAB77AxXQ_y_3KUakyMb4UIcPIYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYrnlrwd1rzUImRAfadDwirHts2Kphaf-7_yTEtDeMoA&oe=6AE75F72"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "2364170464117253", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2364170467450586_4474229378585466878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP908ie6y7kQ7kNvwEqGKW2&_nc_oc=AdrvFmBA2IxwKOyDReAWhUa7a-DQm9x0K7PlpV2KIk34MEZpElJVwLV-1hDVJyeoJ9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF-BFcsQlBzYilyrj6P30C0uSt8DuZ3hWPtRFhem9e_w&oe=6AE745F8"}]}, "id": "1792561178542897", "locale": "en_US", "screenshots": [{"file_name": "01_accueil.png", "id": "1048887481248873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_1048887484582206_6346522421245518439_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0TMzRKdepcQ7kNvwGG-bN_&_nc_oc=AdqLA4Ku-V71x8Cf3xC7YUHqw7WGUMexS4Z7doBVC38_lzuTx9z5-ur0RBEQNmP6d9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQybbks59GkuYbY3dsmJYor4ZTEyjXY3wmTZzHzOh91CQ&oe=6AE7422A"}, {"file_name": "02_decouvrir.png", "id": "947420398407018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_947420401740351_621219732488264316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=419fcQhJo1MQ7kNvwFxXMbd&_nc_oc=AdpUQkSuckgALsyK41tNDBPU6n8Mx8Rl4c8VYBsRnriQK5eGWLjLxVtAqJo88T8bN1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp8EKKc_2GiJFanSS9qAvEfrGeQZdSWtZLCZ6PEl2TlA&oe=6AE76630"}, {"file_name": "03_avatars.png", "id": "2171514510092915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673645340_2171514513426248_6427843950098420566_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImndGBeaWU4Q7kNvwGGnVTy&_nc_oc=AdpDBT4e6Gk47WuFiPBkSrSAbbKd59HKT-D3bkB3WMIAzfjlCzj0xrf6X5Gy0aEncwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQZ9_Mi_hviFP2Cn5AvohLC61Juw1f3w1OSQMzY9YA-w&oe=6AE7493C"}, {"file_name": "04_profil.png", "id": "1597545348638618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1597545351971951_1735308775829175113_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObNaZco5ViUQ7kNvwEJzoz1&_nc_oc=Adreh0jcz9VTzg6nggdFTCWM026DPAHV62dBuz5IyDHkDV-yCpIlpTIHq595LFdWmSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHo1Iq8-8CxBmt_dp0BnTJS35uwt6ZMvTkwGKsJrBRYA&oe=6AE752EC"}, {"file_name": "05_parametres.png", "id": "1461631792519472", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1461631795852805_769357511860802845_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1cldyzdMm8Q7kNvwFOep5x&_nc_oc=AdoewcDUcTWTYeJ82JErnfbL6wE0OSZ1tdeAhFYre50Sir9XfA59TvgO2ljZpMVrDws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkjxdyyxLEQUxN20tBEwGalV97KOM-vkFaS9l3BFVECg&oe=6AE76124"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RDK VRC", "keywords": ["vrchat", "osc", "chatbox", "vr", "compagnon"], "long_description": "RDK VRC est une application compagnon non officielle pour VRChat, pens\u00e9e pour rester ouverte pendant que tu joues sur ton casque Quest.\n\nConnecte-toi directement avec ton compte VRChat (avec support de la double authentification) pour acc\u00e9der \u00e0 tes informations et tes avatars.\n\nMagic Chatbox envoie automatiquement des informations utiles dans ton chatbox VRChat pendant que tu es en jeu : l'heure, la musique en cours de lecture, le niveau de batterie de ton casque, ou tes propres textes personnalis\u00e9s. Le tout continue de fonctionner m\u00eame quand l'application est minimis\u00e9e derri\u00e8re VRChat, gr\u00e2ce \u00e0 un service en arri\u00e8re-plan. Plusieurs styles de mise en forme sont propos\u00e9s pour personnaliser l'affichage du message.\n\nLa page OSC permet de configurer la connexion utilis\u00e9e pour envoyer les messages vers VRChat.\n\nRDK VRC n'est pas affili\u00e9 \u00e0 VRChat Inc. Aucune donn\u00e9e de connexion n'est stock\u00e9e par l'application : elle sert uniquement \u00e0 te connecter directement \u00e0 VRChat.", "short_description": "Compagnon non officiel pour VRChat sur Quest. Connecte-toi \u00e0 ton compte, g\u00e8re ton chatbox avec Magic Chatbox (heure, musique en cours, batterie du casque envoy\u00e9es automatiquement en jeu), configure l'OSC et retrouve tes avatars, le tout sans quitter ta session VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdkvrc.fun/#confidentialite", "developer_terms_of_service_url": null, "publisher_name": "Ruskov Corp", "support_website_url": null, "website_url": "https://rdkvrc.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1351675204695839"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1780227992999213"}]}, "baseline_offer": {"id": "1780227992999213"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788548220, "status": "PUBLISHED", "id": "1780227992999213"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Android
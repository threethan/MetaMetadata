ntent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPBuYeG5Btr0BCXfIvGyiQ5UkhuhjW1zzgMjE6JjfH1Q&oe=6AFDAF78"}]}, "id": "985149387270020", "locale": "en_US", "screenshots": [{"file_name": "01_accueil.png", "id": "1048887481248873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1048887484582206_6346522421245518439_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A1WzazCtrQQ7kNvwH3gSbJ&_nc_oc=Adq9G2ZYC16ZWzomsCFsuoTTMf7EqqMV5pZIf6izvm6xCfpfZg76QpLKt1X2WSSzEw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwZkwnC6wGH0-h72ZPaH-p5ASMR7vBty6Goi5fCloBYg&oe=6AFDE3EA"}, {"file_name": "02_decouvrir.png", "id": "947420398407018", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_947420401740351_621219732488264316_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5lQ_v9BcdcQ7kNvwFAWNFy&_nc_oc=AdrGu3Z1VW2rtigm__-5cdEONLlMpgJEK_07YGbyNml7FftHh_K5K7Edyq5-yFgSwCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPQiUOjJ2IQlh4Cj30aY4VHZpj8cck9X115qzKkvOoiw&oe=6AFDCFB0"}, {"file_name": "03_avatars.png", "id": "2171514510092915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_2171514513426248_6427843950098420566_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8Q9OWX2hHMQ7kNvwGoWeA0&_nc_oc=Adonr4gh8lV5fmNWSMs65u7Adh0nS723b15qK284XV6lj2n5ojP5RezmZSA5E_zvM18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF_bVSsMuJ-WXzJQplh4A5tWAS-XNNfU-XgsrwtI6SgQ&oe=6AFDB2BC"}, {"file_name": "04_profil.png", "id": "1597545348638618", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1597545351971951_1735308775829175113_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYZ88t3Xz64Q7kNvwEAROQM&_nc_oc=Adq-5FDpkeyeSiu4n6Je1yPfoZjNrDU58C_eQ6XdrTUpx7oXYUPRY0shWX6G5yI9TJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQul53z5Z4KXx2YYgMUrf-pE2SWsn--pVDt-zgw-pox0g&oe=6AFDBC6C"}, {"file_name": "05_parametres.png", "id": "1461631792519472", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1461631795852805_769357511860802845_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABXKI82GeF4Q7kNvwEelbdN&_nc_oc=AdqcrbZn9LOjr99D-dWc5WvSPm3L9v1IPX2NF-SQjm69BRQeGu4TrCsqOc8drvJdzw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtUIvCyDiocLgQOTTqLd4Zv77tmQfX8Ju-NMujgcnp1A&oe=6AFDCAA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RDK VRC", "keywords": ["vrchat", "osc", "chatbox", "vr", "compagnon"], "long_description": "RDK VRC est une application compagnon non officielle pour VRChat\n\nConnecte-toi directement avec ton compte VRChat pour retrouver tes amis, ton profil et tes avatars.\n\nL'accueil te montre en un coup d'\u0153il quels amis sont en ligne et dans quel monde. Le profil de chaque joueur affiche ses informations, ses groupes, les mondes qu'il a publi\u00e9s et vos amis en commun. Tu peux aussi y \u00e9crire une note personnelle, synchronis\u00e9e avec ton compte VRChat.\n\nLa page Instance te montre en direct qui est avec toi, depuis combien de temps, qui arrive, qui part et qui change d'avatar. Elle se souvient aussi des joueurs que tu as d\u00e9j\u00e0 crois\u00e9s.\n\nRDK Chatbox envoie automatiquement des informations utiles dans ta chatbox VRChat pendant que tu es en jeu: l'heure, la musique en cours de lecture avec les paroles, le niveau de batterie de ton casque, la m\u00e9t\u00e9o, ton temps de jeu ou tes propres textes personnalis\u00e9s. Tu peux enregistrer tes configurations en presets et passer de l'une \u00e0 l'autre en un clic.\n\nPour ta s\u00e9curit\u00e9, l'\u00e9quipe RDK VRC tient une liste de comptes signal\u00e9s et v\u00e9rifi\u00e9s, comme les crashers ou les comptes spam. Si l'un d'eux rejoint ton instance, l'application te pr\u00e9vient.\n\nRDK VRC n'est pas affili\u00e9 \u00e0 VRChat Inc. Ton mot de passe n'est jamais enregistr\u00e9 et ta session reste uniquement sur ton casque: elle sert seulement \u00e0 te connecter directement \u00e0 VRChat.", "short_description": "Compagnon non officiel pour VRChat sur Quest. Connecte-toi \u00e0 ton compte, retrouve tes amis en ligne et leurs profils, vois qui rejoint ton instance et anime ton chatbox avec RDK Chatbox (heure, musique, batterie et plus, envoy\u00e9s automatiquement en jeu), le tout sans quitter ta session VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdkvrc.fun/confidentialite.php", "developer_terms_of_service_url": null, "publisher_name": "Ruskov Corp", "support_website_url": null, "website_url": "https://rdkvrc.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1447966128400079"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_4550450481906685_2176566322006449891_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-P8T-IpzecQ7kNvwHuAGQu&_nc_oc=AdrlThuCUZCc_bKYzxqorT8jycxFWOqD_4oIN0F3FfFWG5KWm0U39E9jt0nufj4iRX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhps-WgQjCcRPdgev3CTUtZCUvcawED3VSQOUK_55prg&oe=6AFDCBD9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RDK VRC", "platform": "ANDROID_6D
-2.oculuscdn.com/v/t64.5771-25/499299789_1604246234233378_3790584665273325205_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n0cAkWoHKYQ7kNvwGJ6zUg&_nc_oc=Adpw_jpqxoWSdCAUed2zC8981g_dqZB2u04azhwo08FewuwmhJRoEkJiAPoi_TU0SUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVR673QTHjdwVipvBrmffQ455-u9XeEQNKkT_fr-XG1zQ&oe=6B0F116B"}, {"file_name": "5 (2).png", "id": "1666743155156949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308046_1666743158490282_1971700930004286917_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd6Xs5QJkNoQ7kNvwF52V3l&_nc_oc=AdpVUH8XVsPNlqhRnRdRf0RLbvrOpmCTRiVY4OOOpiVS_uwSxjdmie9eajGAqXXdtwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWNQztHvolO-EzQMObCo80y0z5LXYKE37GUPlASOAMPCQ&oe=6B0EFBC3"}, {"file_name": "1 (2).png", "id": "1080667988299976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292712_1080667991633309_5066439895611613017_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iI5k2Mno0YQ7kNvwEK1FUI&_nc_oc=Adqa0dTyuEATwmkN69W5loS9bM_c0E9wmRtTJoMhBDPqxv0viK0_8bofWE9onbnilck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcm6PpAI6VGLd-v964aHIaonCKs3xnZkFUrW3GsUhiBw&oe=6B0EFDEF"}, {"file_name": "2 (2).png", "id": "1887651972604871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308043_1887651975938204_6405702472636233943_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ormZ_Wm_qP4Q7kNvwFlqIvn&_nc_oc=Adphx_cFqK41tJJcFHclWB7UvRn_eiX3njaMRwAp0PlD1CsvZet8lv1hbizJWicqLfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDIKycSu9bzKmftCmv5aPZ7BevsOHi7nZ5G-aJ0qNLmA&oe=6B0F1B8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bus Simulator - City Bus Driving Game", "keywords": ["bus", "driving", "simulator", "city", "coach"], "long_description": "Take the driver's seat and experience the world of bus driving in Bus Simulator! Get behind the wheel, navigate different roads and take on the responsibility of driving a bus while completing exciting transportation challenges.\n\nDrive through various routes, transport passengers and test your driving abilities in different situations. Control your bus, manage turns, navigate traffic and focus on reaching your destinations safely.\n\n**Game Features**\n\n- **Bus Driving Experience:** Get behind the wheel and enjoy an engaging bus driving experience.\n- **Passenger Transportation:** Take passengers on their journeys and complete transportation tasks.\n- **Different Driving Routes:** Explore various roads and experience different driving challenges.\n- **Realistic Bus Controls:** Control your bus and test your steering, braking and driving skills.\n- **Driving Challenges:** Navigate roads, handle turns and complete your driving objectives.\n- **Bus Simulation:** Experience the challenges of operating and driving a bus.\n\nWhether you enjoy vehicle simulation or driving games, Bus Simulator offers an engaging opportunity to experience life behind the wheel of a bus.\n\nStart your engine, take the driver's seat and begin your bus driving journey!", "short_description": "Get behind the wheel and experience the excitement of bus driving in Bus Simulator! Drive through different routes, transport passengers and take on challenging driving tasks. Control your bus, navigate roads, handle turns and put your driving skills to the test. Explore the driving experience, complete your journeys and enjoy the challenges of operating a bus. Start your engine, take the driver's seat and experience an engaging bus driving adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/next-bit-games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Next_Bit", "support_website_url": null, "website_url": "https://sites.google.com/view/next-bit-games/home", "cate
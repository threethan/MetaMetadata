nt-iad3-2.oculuscdn.com/v/t64.5771-25/473391888_1091232596023592_644115734549421554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoQFGy1n-dIQ7kNvwGTSwk1&_nc_oc=Admcv93r3lUs2BKOo_g-Y_isnHT0U74Hrwl1av9FjHM2ADXWolMwHZZmOpH00bP4FJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfulNVWxGY-rVIE64lum6sclgaut6Rm5mvaI4o09T4GJfg&oe=69A9971A"}, {"file_name": "HighresScreenshot00009.png", "id": "545956708597661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_545956711930994_1669564098275678102_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHvoL1NkG6gQ7kNvwFmbRS6&_nc_oc=AdnMbfUNF5_MC63SkXPUPLVKMg_6R9irupkZfyWHe_T_QqSMIIwNB5rf7ONK26zqMNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftjLGd7yJ5KnQVhde8surQhgt9wUefPX6n4dk7Iq4_mlQ&oe=69A97D40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.al
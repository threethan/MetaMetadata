"}, {"file_name": "HighresScreenshot00010.png", "id": "1091232592690259", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391888_1091232596023592_644115734549421554_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJMvCyY52Z0Q7kNvwFXulFD&_nc_oc=AdqYqI4NhEyaGme3-KuT0yOE_55pDJNwI4TXV6GMxFWvIeiFkHGLzU7CvuLuCWM9Mz0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0a_fINVUm9lAwKUepU1IvRxqSwXVTHebNxPRBkjSFgaQ&oe=69EF769A"}, {"file_name": "HighresScreenshot00009.png", "id": "545956708597661", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391904_545956711930994_1669564098275678102_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNNUjsRVRacQ7kNvwFXpV_0&_nc_oc=Ado36TrUS3aE7DomzXgVhFBZoUznPhXKRdAbYt6BSyzjcubw5WMoHY0bLaHgRJxeMns&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cveTMkAEnP4b93ekMkE9JFc6BXobEVV9Dd03QpTTtaA&oe=69EF5CC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8682686935193202"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8734760263319202", "version": "20. texture size was reduced, r.Streaming.PoolSize=3000, r.MipMapLODBias=1, added a ballroom"}, "id": "870341168357317", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8595520060576557", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8734760263319202"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "870341168357317"}]}, "change_log": null, "created_date": 1738406816, "id": "8734760263319202", "version": "20. texture size was reduced, r.Streaming.PoolSize=3000, r.
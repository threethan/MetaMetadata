ar4bw&oe=6ADF6903"}, {"file_name": "HighresScreenshot00024.png", "id": "2238697263182335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP326egvBY0Q7kNvwEE4hwk&_nc_oc=AdrVlBQdD4n-RkaFX4WSqxtCPedEa4CHF1gJXsgR7DNP55RMfkUzgzydC8VwnQ_iTno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHaqkXmIO_kv_xzxKqjSFWuwXYYaKGm_Bc0wkb-ZYD_w&oe=6ADF5C1B"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tD5OPZIWxcQ7kNvwHxLqGk&_nc_oc=Adqara74E0qAoToCgLU6efwYVf6O2U8RSvbnCsB3t4XpeKfDJeW1y6EvA3xDmxS2xB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYLunlpdDct1a12OGpfk1cMfqYMvKSj80Uy3uYSGzrKA&oe=6ADF70CE"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6PgJwoQ0kYQ7kNvwHNc6kY&_nc_oc=AdpY0INA8bRMvQDH83VB2zYa0Ru6NucP98Tk0lqbFMeXrTFz4Mwi4PoG3ViGSwD9log&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgWDQ8NoONOJkQwmZP2syXyJHQ7UKWNszzkD6B_qjVYw&oe=6ADF448B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYJAsSfXXTkQ7kNvwGo2_bK&_nc_oc=AdoyqvXeXRYRLCMuOPFCgoMTKjhbkeAurwlYpsWpygTQR3DgIE5GM9beZHFwsi0umn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNviEHFdXytxIhvwhN-_tQyAX_X6gdkRy1sLpMz2-DF8A&oe=6ADF6337"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8746194352175793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5
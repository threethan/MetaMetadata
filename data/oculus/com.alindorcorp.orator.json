m458CgeM_J6D1KM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1WNLZLWzSfgwwI6CrI2B-yF1f5OEoSpyR8WLM9o2Ww4w&oe=69F0C81A"}, {"file_name": "HighresScreenshot00009.png", "id": "545956708597661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_545956711930994_1669564098275678102_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYrkZCqZdAQQ7kNvwHzW40e&_nc_oc=Adq8UA0ZuTyqNFwtxgeTdlEfz6pUwBOK87PXpE0q68pu6dkthh_l3Ivgc8aQDFIo72w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3uMf9vgo54O0R4bMLiXm8optfzubULqhgR01LRpNCjow&oe=69F0AE40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_ta
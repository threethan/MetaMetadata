ad3-2.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL7dDfpN7RgQ7kNvwGAubSl&_nc_oc=Adq1dv5kIuZ5GESQEHC2opRpYRI-R1nrBhfdxHuRSy7cBuJe3XMrDtUQbopbAJzrgtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1iQxEkWgk50VLFcJTILP9m-wZfxtv5D6ooXqMcjF7laA&oe=69F0BC9B"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7XZEMRDe3MQ7kNvwEm6B28&_nc_oc=AdrZdLmp6JFOkjsHj2hkmjhyMnkZDeGApguMVHINdketxaYKECuc8yw9PbJMkSRpoYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3R6AcKAk3U6EQ4AB7-mdoS1hXPPHlPGpettuzrxlKtew&oe=69F0D14E"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1faMqql9OcQ7kNvwELpKnV&_nc_oc=AdplQCHF7u9Y3wUeyevsWbPQKgl31MzYiY5EpzupVDCpMnXo20OVWdJgioTgTCABFuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1b3eMTZi2YZR-REhUQ0Tzk3ULzpVNCk9hUhIlhvqnIug&oe=69F0A50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFGwviRKGAgQ7kNvwHDhvuR&_nc_oc=AdofGPzIoITF4OYWBsuP-AwMM-2Ut_UBYn5Yy03Dg5jmgKOIVdvTdi3OmSosReO40qY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0H7Lg1hYiQVPVFqT2ywCsXdmEUnT-w5H0O3ZqIUh2DPQ&oe=69F0C3B7"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8746194352175793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392200_1585700019489930_450210215990967689_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxsWXpELEUEQ7kNvwE-0KH
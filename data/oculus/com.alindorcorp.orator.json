b=1-7&_nc_sid=6e7a0a&_nc_ohc=8p46pVdC6csQ7kNvwHOq145&_nc_oc=AdonHXcOfW8LKry77JU245Ngb_-G0EXZKvpNWrzUXVPrdyP2UYAWoKR9e_dzyyj02Kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyPiemx8GKuNGTAOOtu9VW81G_GJlzPVxgEVaLpVEcLw&oe=6B005E83"}, {"file_name": "HighresScreenshot00024.png", "id": "2238697263182335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VJagXOZXEYQ7kNvwHIdMGq&_nc_oc=Adqs3s796AsJHDY1wWwKSJLdiY-aI4kvVbaxbWBLn08rP1dbwFQXoXw2EpI_tWN2Llo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNEIvIF832XAb7YPZEKHiBc2SMjLOSy5XntWFJ4vT9kg&oe=6B00519B"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JG6N78LLHEQ7kNvwHDPkuT&_nc_oc=Adrp0PtgHZuwOo36OT1X2DtEC6twGBpDoAvmiANSW3uKghmrHElkFZxSsQuqXUmKJCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLHdvEbMkEqorYl8THzfBbSPt7Vk14IfxseXA5gOaqCg&oe=6B00664E"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gptn8OQb6kQ7kNvwGhbWY8&_nc_oc=Ado1b3WGvU00ME6v1EjsqyO8ymg9Avl4O37JsJ1bAxza3-F-GD4Jb_Sel0la_gIAip4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5N_Zni_kboVDnl6jQs-mQ7CQan_AKLhobCiV7zeOsfg&oe=6B00724B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN2p1xsW_jIQ7kNvwFP4V83&_nc_oc=AdrnnSxTSvQA_0bBp_d5Yo2MevTbvzaJaeNhgLoAGSJO50dBq-JaSYDO28cfmK9c2Q4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQjUkZGGBOJTw3l1DSJyk7WXjAPPDw0UC83nLI42QRSg&oe=6B0058B7"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
b=1-7&_nc_sid=6e7a0a&_nc_ohc=6ibcBiF9ozcQ7kNvwGhRNMo&_nc_oc=Adp-o2AruPZ7xtvI4y7chBuHpJRtfzoFrPMQbAzrCwK-HFggDWV1dOiwao9eDDA7yzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxTmh-7uYw4vuHkumERHhKHAacSTy_RtHoUHvkNjx0Vg&oe=6B0C7443"}, {"file_name": "HighresScreenshot00024.png", "id": "2238697263182335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS2QugCR070Q7kNvwFJYeC-&_nc_oc=Adqjoel8wfwviVqq14C9in6NmqBaCEC_TXWATU4KpJ5YC1L7Hk49jjuIJdwA-x5naws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6SA2ahdE8Xnzma-8vot2DNWg8ThobqEVwwoevCrwSew&oe=6B0C675B"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJI4tr0CuZsQ7kNvwEByzIu&_nc_oc=AdrA2FGrQcCgH81wBcTO2bPEG1uzcRMimg74CvkZL5GAVGJYBm-MWjC7BjFqVm07tyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQprETuZVZlT-Wqgt0Wcnf2b3WK5Mng6qbIIE6Ax6GhsA&oe=6B0C7C0E"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzxtVpsbSKwQ7kNvwGV2h9i&_nc_oc=Adr4dh0OadDDV1W9zUq7Du9QJQAwAwPAn5NxBVRBgcFCjH47R26NIx3jwU1gsrQ7XV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxC_I9fBCmIB0-DypSRDmj3LV_Kv730vq8d7pT2hMMdw&oe=6B0C4FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEbAs3TWCW4Q7kNvwGHR1f6&_nc_oc=Adr8HtfNq3Q3dpKrAREcL088IhOksRYKxqet_OX_JUJr5YQtbapX8EPTOKkFVHRobCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0t1HWCYHC9zz4rSlatLBUsvSh909tiEgcY695LdZFrQ&oe=6B0C6E77"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
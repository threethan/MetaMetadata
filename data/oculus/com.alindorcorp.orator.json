GrQ2Q&oe=6AD38B83"}, {"file_name": "HighresScreenshot00024.png", "id": "2238697263182335", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyrK6tMFLSgQ7kNvwGkPa67&_nc_oc=AdpNVeDTzlc2C_jkBTEH17U86fZz14SBlaemXjIIZPhLX7ZPAeRljLp2UuyO6cHZluA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwR7NkSq2R8TECEVRD2Lgcosb9rFLhoqUCy99LRFOmxw&oe=6AD3B6DB"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA5OnvP_UwMQ7kNvwFK5ffW&_nc_oc=AdotnJRJOTrpQwVXGlDBib2p5VsQJf18R-09w8RDgc5dqqv4d6fgw0mn-xwagG3kGfk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfhQuBOSU5d5Ubiwl1y33ft8Gy3uZPuSKBpSk_dzri8g&oe=6AD3934E"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1C0Eg3I1MtEQ7kNvwG9v86S&_nc_oc=AdqrKlgVEOm75wGXqKyzhJjfhz51Z1tKyLkxTy4g31OMJsA8-6h_qsFfyk5ExmdQfDs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN75TiKfm1LLBuBS2WCUan2wlYQ2p0VJ9hcGnZOWjvkYw&oe=6AD39F4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paXpUUM7EhgQ7kNvwHAd4l8&_nc_oc=AdpYoZfAPRRyb499IzcT3WGz82vnjYbMR7LfPSaEb2b6yROWgYqmTEre2LA6TR_Sg60&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxqnba1rJNUk-q3K2KA8g0lOs3VGGAXdG3MXPGy8rOMw&oe=6AD385B7"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8746194352175793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6
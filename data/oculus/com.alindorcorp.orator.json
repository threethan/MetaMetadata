zTzdg&oe=69EA3203"}, {"file_name": "HighresScreenshot00024.png", "id": "2238697263182335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnmnqIpL4coQ7kNvwEl12MK&_nc_oc=AdpDM6VTWSFD-EzBFza3bzqoab2uOxU5CVPrEoeocvDOlhHyvbFcG2OxGewFtzRITMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I9uarw0IIIoCarvjLIRQPMok8OFUyAkNk-ekdxWTaOg&oe=69EA251B"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1Df-3R1s5EQ7kNvwHjHLtF&_nc_oc=AdrGL7INIhUilLB5cA8ridOW4kOn0ateodgLuC-k7zt3whXQ8TNZqO28oIb_5twc9Qg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39jcsadfE3S9TsLG6sC-uKIZ0qVDvcy7smZ-60Yc1p1A&oe=69EA018E"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfj2HtO5FYYQ7kNvwHZndHl&_nc_oc=AdpRpNxAK8u7BcJ86TejZJqWo0R0pHs3yHQC3nI31mTIIvRpOMGiTZCk5sqisA6P0NA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L1q0GbGqQSmgCw7B29BOxandZtFUmXo4IWPz0SOLU5w&oe=69EA0D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOeFvtcWUV8Q7kNvwGBpU50&_nc_oc=Adp-pnSAIzuwJ1J9bRlGcQ-zq1RE9Bk23du6OJtT25M09gdjqlWxcxdYEWmAQEqNE9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O6Blr8hyh2P97VXny6vzRRbq1SwZhIR9qwZ4pOvocKA&oe=69EA2C37"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8746194352175793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5
b=1-7&_nc_sid=6e7a0a&_nc_ohc=NEjQcV6bq50Q7kNvwEoB1y9&_nc_oc=AdpM39Q5ZPaRgZ4FruzcyABzCBp0YawGsBBlMzM-3AVgYZTRDW3iLICRdx2jYQR4Qwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR43wtYQ6KiXRRW6G2V3Qoo3YUmblj0McZ3dg7hDwBL3w&oe=6AFDBB83"}, {"file_name": "HighresScreenshot00024.png", "id": "2238697263182335", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VJagXOZXEYQ7kNvwFPI-hR&_nc_oc=AdorbrCXi1kp_F-DiR5tpEKzkFOZ5xAMTsumC_HMmVKNY8NKyVe9-9kVvKAF5ytnQVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAUlzDLlPhEfgT7NWImdurpXlJgApx2JLU_9uWOG8owQ&oe=6AFDAE9B"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imvAoFT18moQ7kNvwHZgBG7&_nc_oc=AdqvFbsqsw2YRKJSvzZpJJZrRGmWrF3yFj0_Q3DInIkKCisKkW5dFvHz52ypz-6FQvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj7C2Y847gBtW4nyXEasdkXbs17HRp8ZdW0OIZ_2Qsig&oe=6AFDC34E"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjUARR_vxeMQ7kNvwHe8Lok&_nc_oc=AdpVgRlF3gbhkjEd06w-A_yAaP2Y20LIEN5FAytn-pUOF1wXF2S3rb9x9XN94-3EVdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz_Akx8cujuznTO6Sf4FQGUehxX-Adf7-egV6EMvrKrg&oe=6AFDCF4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN2p1xsW_jIQ7kNvwG3T2aw&_nc_oc=AdprpdV62oZTwAXEEOfoUFrLBxyjuscRZBuusSBAemX0wnGlN8UcTCJ-4oVoYn7FdCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKqulDDbAuYF9jPVkyjx1WnFSoXYU4pHOEZ00cyLbirA&oe=6AFDB5B7"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
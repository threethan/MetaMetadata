9KI_g&oe=69C90443"}, {"file_name": "HighresScreenshot00024.png", "id": "2238697263182335", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393491_2238697266515668_2268127339560459937_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEev5N6xZEUQ7kNvwHe9l9l&_nc_oc=AdoqKzUWfn8820nfK27a9lv2VoYeDDbjIBVBTn0J5Ht0oS8XWA6NZEV8CbOwe8NIUcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZP1guMchBK4RWDMEXFZ6j1W9x92TL1rNIXBp8swGJMQ&oe=69C92F9B"}, {"file_name": "HighresScreenshot00027.png", "id": "614788954821849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391949_614788958155182_3987038816110943535_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHvK_hlyJnoQ7kNvwF2a_tB&_nc_oc=AdofH7ua3Ob5vc2Dn1NzF9Q1IkZjKOrhp9j4ndz8OOQS449Bi35uUiv4fLWuUzVdpVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaUtbiFw7aX5UNesZadD4An7vTOXPtgeB4CbDoLzeynQ&oe=69C90C0E"}, {"file_name": "HighresScreenshot00025.png", "id": "1836355953803350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391937_1836355957136683_3154112071709883025_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoIWDU2jjfcQ7kNvwGdgZvx&_nc_oc=AdqjcRUpaV6oCSJVHyVpiD3JtR38MjKFJx50iFqEajNJrvgNnlBnFPDM8p-qRT_RujY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoIDFswKiPmER9lCsb60pEw5gwXYCtKKhB-zCBdd--QQ&oe=69C9180B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighresScreenshot00033.png", "id": "1123960572373804", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_1123960575707137_1389458767209131430_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEqsbOEV6z0Q7kNvwHutp2_&_nc_oc=Adq83Rcpl1esD0df6Wxyhs1SrYnT-JswUKeh_513zUpU244E9QK14EB6-zVXl3RcWcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9ef6MuC1hszFutJPLJUjxC5J21yNf7_9AzOvGbDHrvQ&oe=69C936B7"}, "display_name": "Orator", "keywords": ["Communication", "Skills", "Speech", "Presentation", "Simulator"], "long_description": "Orator is a public speaking simulator designed for anyone preparing for speeches, presentations, job interviews, or looking to overcome the fear of public speaking. It helps users develop confidence and communicate effectively in any situation.\n\nKey Features:\n- The moment you launch the app, you'll find yourself in an immersive office setting with several lifelike metahumans attentively watching you.\n- Speak freely while the metahumans listen, providing a realistic practice experience.\n- The highly detailed office environment makes the experience feel as close to real-life conversations as possible.", "short_description": "Orator enhances public speaking skills by providing a realistic and immersive environment with a human audience. As soon as you launch the app, you'll find yourself in front of an audience, attentively watching and listening to you. Speak on any topic you like\u2014they will remain present, without judgment or distraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alindor.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "Alindor", "support_website_url": null, "website_url": "https://www.alindor.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8746194352175793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6
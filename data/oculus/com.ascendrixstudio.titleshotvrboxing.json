834", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_28842737552015832_9115798086143743958_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTjHgj7H5QUQ7kNvwG_SIS2&_nc_oc=AdqG-Bp1WEkw3IpuHNxMbaGrjegHxVBfvPp3eQo3JlJBvtWesMcB3IbTKXcDs64FYKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTioPB6cey_myG33g9i20pz3zJ4tm5JoS8LaZSeMgtQGQ&oe=6B0C5453"}, {"file_name": "SS 2.png", "id": "1789628765678986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_1789628769012319_1855441779314406859_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl21lbcx0pcQ7kNvwFNTc1Y&_nc_oc=AdroM-GgzIzzmzQgupyfXtQcixmMBRaU6nrE2zJJxO-CR6EsW-IReayvfpveivF4fxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYICwX1xH6PAAlnPLcgWv9szmXCsmyUzc0rubuO9yNHA&oe=6B0C784F"}, {"file_name": "SS 5.png", "id": "2579059382579559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_2579059385912892_2047988986158212480_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHAPaCkyqSMQ7kNvwHNh-i3&_nc_oc=Adp8cZuCQgBrxj5mQ78MazGBQ-DQ1vtcTCvmTAYSysmwxvJFIuiBcVl3nNw2WtHBGsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMKnQIF6nqNjzjdBdI5ZfErjHYPTHUZbjTe_glDJYiuw&oe=6B0C6D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x 1440x.png", "id": "1604247801717639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1604247805050972_1993127835019426701_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqkCNEBpuekQ7kNvwGUhg4j&_nc_oc=AdqnLRk2AD_wVwdJBLg5JqfYijggeIHTFpfVfC5KhU5vFOgdXamvNKcl0SUFl1QkyoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhhmqG0DIcESV6NIpkKRzD0IK8C0cOO1mKCuLtCtCbcA&oe=6B0C4E4E"}, "display_name": "Title Shot: VR Boxing", "keywords": ["boxing", "fighting", "sports", "fitness", "career"], "long_description": "Every champion started somewhere. Yours starts at midnight in Dawson's Boxing Club.\n\nTHE CAREER\nCoach Ray Dawson has seen a hundred kids come through his door. He sees something in you. Six chapters, six opponents, one title. Train in his gym, walk out to a packed arena and fight your way from club brawler to the undefeated heavyweight champion of the world. Lose, and you come back stronger.\n\nTRAIN LIKE A FIGHTER\nHeavy bag, speed bag, double-end bag, body dummy and jump rope. Your coach runs every camp: he calls the drills, pushes your pace and tells you when you're ready.\n\nFIGHT FOR REAL\n\n- Physics-driven opponents who block, slip, counter and throw fast   combinations\n- Every punch counts: speed, power and placement decide the  fight\n- Real knockdowns: fighters drop, the referee counts, and some beat the count\n- A referee in the ring who introduces the fighters, gives instructions, steps in on a clinch and raises the winner's hand\n- Take a big shot and feel it: your heart pounds, your vision blurs, your ears ring\n- Bruises build up on your opponent as the rounds go on\n- A live arena crowd that roars on every knockdown\n\nMORE WAYS TO FIGHT\nQuick Fight against a random opponent, Survival against endless challengers, and Fitness mode that counts your punches and calories.\n\nPut your gloves on. Your title shot is waiting.", "short_description": "From a nobody in a back-street gym to the heavyweight championship of the world. Title Shot is a realistic VR boxing career: train with Coach Ray Dawson, then fight your way through six opponents who hit hard and fight smart. Real physics, real knockdowns, a referee who counts you out, and a crowd that rises with every punch. Every fight is a war. Earn your shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ascendrixstudio.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://ascendrixstudio.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1861232504891380"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1872884797358991"}, {"status": "PUBLISHED", "id": "29633560786236253"}, {"status": "PUBLISHED", "id": "1171897561951514"}, {"status": "PUBLISHED", "id": "2336244367198821"}]}, "baseline_offer": {"id": "1872884797358991"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794689460, "status": "PUBLISHED", "id": "1872884797358991"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1861237994890831", "version": "1.0.1"}, "id": "3014025528937973", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1861232494891381", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1861237994890831"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3014025528937973"}]}, "change_log": null, "created_date": 1794261631, "id": "1861237994890831", "version": "1.0.1", "version_code": 1, "release_status": "RELEASE
nc_oc=Ado15GEW90XldcOQ2Gw6nqfQHREmb04ILaJJ5W4q74K8QccvenaH_4k28jTa4caslq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbG6MJX4Znj4XD30DRCduTynzR3l1oZlFQYNTEgngfBA&oe=6B0C7AC1"}, "display_name": "Title Shot: VR Boxing", "keywords": ["VRBoxing", "Boxing", "Fighting", "Fitness", "Physics"], "long_description": "Every champion started somewhere. Yours starts at midnight in Dawson's Boxing Club.\n\nTHE CAREER\nCoach Ray Dawson has seen a hundred kids come through his door. He sees something in you. Six chapters, six opponents, one title. Train in his gym, walk out to a packed arena and fight your way from club brawler to the undefeated heavyweight champion of the world. Lose, and you come back stronger.\n\nTRAIN LIKE A FIGHTER\nHeavy bag, speed bag, double-end bag, body dummy and jump rope. Your coach runs every camp: he calls the drills, pushes your pace and tells you when you're ready.\n\nFIGHT FOR REAL\n\n- Physics-driven opponents who block, slip, counter and throw fast   combinations\n- Every punch counts: speed, power and placement decide the  fight\n- Real knockdowns: fighters drop, the referee counts, and some beat the count\n- A referee in the ring who introduces the fighters, gives instructions, steps in on a clinch and raises the winner's hand\n- Take a big shot and feel it: your heart pounds, your vision blurs, your ears ring\n- Bruises build up on your opponent as the rounds go on\n- A live arena crowd that roars on every knockdown\n\nMORE WAYS TO FIGHT\nQuick Fight against a random opponent, Survival against endless challengers, and Fitness mode that counts your punches and calories.\n\nPut your gloves on. Your title shot is waiting.", "short_description": "From a nobody in a back-street gym to the heavyweight championship of the world. Title Shot is a realistic VR boxing career: train with Coach Ray Dawson, then fight your way through six opponents who hit hard and fight smart. Real physics, real knockdowns, a referee who counts you out, and a crowd that rises with every punch. Every fight is a war. Earn your shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ascendrixstudio.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://ascendrixstudio.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1874111116936852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771272_1586490950173088_91225563019944369_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3UoSvtM-oAQ7kNvwFQdBq-&_nc_oc=AdqFLwHBGOMXJ8vHdnTSEgGWbBeDq8E6-cKG0hzGkMaACt8AAaI7w1cKblzd_YZQYtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqNoh9emsz9zxzdGDNwl83AriOlcXmzTfJOyJ0z3vOlQ&oe=6B0C8124"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Title Shot: VR Boxing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "rele
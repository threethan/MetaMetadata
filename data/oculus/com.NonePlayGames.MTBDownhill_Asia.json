0309419}\n**Perfect for MTB Downhill fans or anyone looking for an authentic Asia-themed game!**\n\n\n\n", "short_description": "Mountains, trails, forests\u2026 the pleasure of riding a bike in nature."}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25911572538481053"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1014756985020448"}, {"status": "PUBLISHED", "id": "4592063961022060"}, {"status": "PUBLISHED", "id": "915683008071697"}, {"status": "PUBLISHED", "id": "4571844946438175"}, {"status": "PUBLISHED", "id": "2843881609299952"}, {"status": "PUBLISHED", "id": "778367538559876"}, {"status": "PUBLISHED", "id": "1669646074057754"}, {"status": "PUBLISHED", "id": "1564874091465319"}, {"status": "PUBLISHED", "id": "2636577783395316"}]}, "baseline_offer": {"id": "1014756985020448"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795685640, "status": "PUBLISHED", "id": "1014756985020448"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26472093949095573", "versi
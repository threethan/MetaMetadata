F-O-twf1MTANyw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnxizuyRDmIxAz0WO95XKhk9bKCIXf8aL6ifYCkt9hjQ&oe=6A8D8391"}, "display_name": "Mountain Bike Downhill - Asia", "keywords": ["racing", "bike", "race", "offroad", "bicycle"], "long_description": "**A new Mountain Bike Downhill game set in Asia, bringing the full Asian atmosphere right in front of you.**\n\nWith 4 different game modes, this experience offers variety and excitement:\n\n- **Free Riding:** Freely explore and discover the environment.\n{923303806699167}\n- **Race:** Enjoy thrilling races against AI opponents.\n{891269079951779}\n- **Stunt:** Asia-inspired time-trial courses with unique challenges.\n{2399366353846507}\n- **Cargo:** Try to deliver the assigned object before time runs out.\n{1608880980309419}\n**Perfect for MTB Downhill fans or anyone looking for an authentic Asia-themed game!**\n\n\n\n", "short_description": "Mountains, trails, forests\u2026 the pleasure of riding a bike in nature."}]}, "developer_name": "None Play Games", "developer_privacy_policy_url": "https://noneplaygames.com.tr/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "None Play Games", "support_website_url": null, "website_url": "https://noneplaygames.com.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27001892872782342"}, "review_messages": []}]}, "cov
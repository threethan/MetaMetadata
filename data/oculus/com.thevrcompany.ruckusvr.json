=1-7&_nc_sid=6e7a0a&_nc_ohc=rvpD-mvJgdsQ7kNvwEVeUMX&_nc_oc=Adrro4Ip59-Z90lOezEeTSGelNEYca_fkaGrCZJxzA9cFWhlNC3zF62m6-jr3r0gDno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlmi8SBhbjSt-EZ-aCVMFPfKXHg0H-_qBAQ08V1hrVwA&oe=6AB542D2"}, {"file_name": "migrated_image.png", "id": "195263755099652", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_1297907176995014_366968912077651968_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubmAZjc364MQ7kNvwEHJgAX&_nc_oc=Adpf8qC2Y740EiYb-IbQoGqTNs13LtVgkeV25YHoIt3z07TLb8pra7zbL3RccsbIrFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEU1p2HgLpe9m-oLwR9CMu-bB964KfVsAlixFvOjX-1Q&oe=6AB5470C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer thumbnail.png", "id": "1373656182681163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_1373656186014496_5169794628878073856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zu0ReUg_H4Q7kNvwG_T8fI&_nc_oc=AdrqE46CCWFoqvXt5nqPBbKtf8szXfoLTRP70ga2uVm4yHUOZwOybPTB8eHjlSYKYyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoV8ugQxLrKs0It3aHe_2SlhVVdwM6a2JR9xT5h0hnoQ&oe=6AB5452C"}, "display_name": "Raising A Rukus", "keywords": ["Animated", "Kids", "Dog", "Dinosaur", "Film"], "long_description": "Twins Amy and Jonas just found a dog- or did he find them? Either way, Rukus has a magical secret \u2013 he\u2019s about to take them to a whole new world. \n\nEqual parts thrilling, breathtaking, and inspiring, Raising a Rukus is an animated adventure like no other. With cutting edge \u201cbranching narratives,\u201d choose which character\u2019s journey you want to follow by a simple gaze with your eyes. \n\nJump right into magical, rollercoaster journey through a prehistoric world! Come along for the ride with Jonas and Amy as the river propels you, dinosaurs chase you, and Rukus delights you!\n\nRaising a Rukus is the first episode of the groundbreaking new franchise from the Academy Award Winning Production Designer of Avatar and the Director of Maleficent.", "short_description": "Ride along with twins Amy and Jonas as they chase their mischievous pet dog, Rukus, through an amazing adventure into a prehistoric world. \n\nWith cutting edge \u201cbranching narratives,\u201d choose which character to follow and discover a different path with a simple gaze of your eyes!\n\nA new animated experience from Oscar-winner Robert Stromberg and The Virtual Reality Company."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thevrcompany.com/privacy-policy", "developer_terms_of_service_url": "https://www.thevrcompany.com/terms-of-use", "publisher_name": "The Virtual Reality Company", "support_website_url": null, "website_url": "http://www.thevrcompany.com/raising-a-rukus", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ACTION", "EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "692712931896342"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1211057642334343", "version": "1.0.5f1"}, "id": "417819818582681", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "App
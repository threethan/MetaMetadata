=-zxoOckYWNgQ7kNvwEwOGz5&_nc_oc=Adpwe_CiS1CE0Bli14ZNj0Hr3PFpcXzc-8C9KstUtzgyRZup4LVIujy6IOh13lLV0mQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQbZJKjhvA0H0MFKLS8Gj9E8qz3tX36gPL81P_dMcrhw&oe=6AF7320C"}, {"file_name": "migrated_image.png", "id": "511791449511251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162711_217098705454116_3705581251936124928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29Jq45NWA5AQ7kNvwEbualC&_nc_oc=AdrepgnVnuPwq3XWASs0ArTYwAyyqBKnzAAZjgFlIPZ7Os53x1IpPB7qbNoS6l14pYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpN5YkYuk01aPQXi5mb4HNf24bM4eOqMLpj8ATihe3tQ&oe=6AF72DD2"}, {"file_name": "migrated_image.png", "id": "259948371672574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_1539544386096939_7248369185925890048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujrXrGWbJioQ7kNvwHt_Gj1&_nc_oc=Adqpo358jSv_nMwxqdjYPhf3JD82pnXWn1DulnmX7Xr3PWOXefYVVJSt_uFk-bazpgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPbNP7_58gP2rOhX5uhGmiVcaqoXTdFKz2e4Gh6NpCLQ&oe=6AF737D4"}, {"file_name": "migrated_image.png", "id": "246754393025091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162788_1159088237569028_8479258378613293056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSz_AB8GecUQ7kNvwGGDCig&_nc_oc=AdrRGTdrXufWsWRjEyKtRwhjFYPHDhGZrxwgVjOmHS_yi9RIMp3DBU4OQS8Dp_m47vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGm-jVSX_d91GUbxrj1mJtvgPXjl3Wtd2qvB0HA1rHGw&oe=6AF71CA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raising A Rukus", "keywords": ["Animated", "Kids", "Dog", "Dinosaur", "Film"], "long_description": "This adventure requires 2.6 GB total.\n\nTwins Amy and Jonas just found a dog- or did he find them? Either way, Rukus has a magical secret \u2013 he\u2019s about to take them to a whole new world. \n\nEqual parts thrilling, breathtaking, and inspiring, Raising a Rukus is an animated adventure like no other. With cutting edge \u201cbranching narratives,\u201d choose which character\u2019s journey you want to follow by a simple gaze with your eyes. \n\nJump right into magical, rollercoaster journey through a prehistoric world! Come along for the ride with Jonas and Amy as the river propels you, dinosaurs chase you, and Rukus delights you!\n\nRaising a Rukus is the first episode of the groundbreaking new franchise from the Academy Award Winning Production Designer of Avatar and the Director of Maleficent.", "short_description": "This adventure requires 2.6 GB total.\n\nRide along with twins Amy and Jonas as they chase their mischievous pet dog, Rukus, through an amazing adventure into a prehistoric world. \n\nWith cutting edge \u201cbranching narratives,\u201d choose which character to follow and discover a different path with a simple gaze of your eyes!\n\nA new animated experience from Oscar-winner Robert Stromberg and The Virtual Reality Company."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thevrcompany.com/privacy-policy", "developer_terms_of_service_url": "https://www.thevrcompany.com/terms-of-use", "publisher_name": "The Virtual Reality Company", "support_website_url": null, "website_url": "http://www.thevrcompany.com/raising-a-rukus", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1527313400983886"}, "review_m
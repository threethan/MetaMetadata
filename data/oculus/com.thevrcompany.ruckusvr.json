_name": "migrated_image.png", "id": "521747488525667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_1297907176995014_366968912077651968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64YhMS0XkkEQ7kNvwGQlXvm&_nc_oc=Ado-x3li7HM-1_BTQAsNsjAM4FGfcBJ3LWRFBYw6PZwJ4nO1MaEb2gUexK8BZXjT-5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOtOfKuBN01kgVSLXv6uuxv8c1_URs8-D4d_KQLyf-rQ&oe=6B07040C"}, {"file_name": "migrated_image.png", "id": "511791449511251", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162711_217098705454116_3705581251936124928_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtjGJ-byUHEQ7kNvwFaY7OI&_nc_oc=AdrAv77jnXPPobrHIsSToEy67OTtFKTPQBgyh1YBBV8BWUn-40oSFV_8OJpgNZ_2v2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL38juu7wIl2aNmWFDLfpeqFeAJtGFYIUO3m01ue86xA&oe=6B06FFD2"}, {"file_name": "migrated_image.png", "id": "259948371672574", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_1539544386096939_7248369185925890048_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNW7YE1ekfEQ7kNvwEDxFSO&_nc_oc=AdpDnwn5WQf4Eg7jSeVe683BtJL45Hx5O72AMUTAphXINl1wTHV_FBLeB7q54SOVIMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR802B-dVbfSDV4ITbBoIi3WZa1w19IFeb-ptyc8lgYjQ&oe=6B0709D4"}, {"file_name": "migrated_image.png", "id": "246754393025091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_1159088237569028_8479258378613293056_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wqnpQ2SRcQQ7kNvwEwglQ0&_nc_oc=Adpv3fuvxxukktzAv2WUi3Z5-_Hp35_QeYS5A8xD6MorR7JaznUqogRg-3KCUQvWZ0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDN394txxvSyXbk8nyP3RoIo3sT3Q21zwTv46vb43YQQ&oe=6B0726E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raising A Rukus", "keywords": ["Animated", "Kids", "Dog", "Dinosaur", "Film"], "long_description": "This adventure requires 2.6 GB total.\n\nTwins Amy and Jonas just found a dog- or did he find them? Either way, Rukus has a magical secret \u2013 he\u2019s about to take them to a whole new world. \n\nEqual parts thrilling, breathtaking, and inspiring, Raising a Rukus is an animated adventure like no other. With cutting edge \u201cbranching narratives,\u201d choose which character\u2019s journey you want to follow by a simple gaze with your eyes. \n\nJump right into magical, rollercoaster journey through a prehistoric world! Come along for the ride with Jonas and Amy as the river propels you, dinosaurs chase you, and Rukus delights you!\n\nRaising a Rukus is the first episode of the groundbreaking new franchise from the Academy Award Winning Production Designer of Avatar and the Director of Maleficent.", "short_description": "This adventure requires 2.6 GB total.\n\nRide along with twins Amy and Jonas as they chase their mischievous pet dog, Rukus, through an amazing adventure into a prehistoric world. \n\nWith cutting edge \u201cbranching narratives,\u201d choose which character to follow and discover a different path with a simple gaze of your eyes!\n\nA new animated experience from Oscar-winner Robert Stromberg and The Virtual Reality Company."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thevrcompany.com/privacy-policy", "developer_terms_of_service_url": "https://www.thevrcompany.com/terms-of-use", "publisher_name": "The Virtual Reality Company", "support_website_url": null, "website_url": "http://www.thevrcompany.com/raising-a-rukus", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "
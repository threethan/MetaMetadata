_name": "migrated_image.png", "id": "521747488525667", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_1297907176995014_366968912077651968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjQ2uICeFigQ7kNvwHcxYyM&_nc_oc=AdpX-SdO8Vp0iOTi2Eh_b_xmzNVKukvfE0W2XTzqmOW0l3DOhW0bNIYgW8Q4Aj17s9E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiZqbSkDEFajilI1P62AN-CUrtoc2PbPtbOx0_T9JWtQ&oe=6AFB268C"}, {"file_name": "migrated_image.png", "id": "511791449511251", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162711_217098705454116_3705581251936124928_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCF6vjwifVsQ7kNvwFt2PnG&_nc_oc=AdrRLcEoI0ahoYDDWNdzMinKPo2bmvEeOPrgek_FMqej8H9jmabvj3YHCo1SV_a0JcE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXL4-eT57xBg5-Jf9D2eq8PzbY_9QqX-_1MzitZXyY8Q&oe=6AFB2252"}, {"file_name": "migrated_image.png", "id": "259948371672574", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162716_1539544386096939_7248369185925890048_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFH6d9hrb1cQ7kNvwH_r4-r&_nc_oc=AdrYtFtMc15zgf27IHhVLe_g2nhLu_uUvcH6wOyISK1tKyUwYh-kvLIMDdTetwv_eE8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo9kPBAti02xl4fbGuzGJhW27ScTUrSKd7zW8aGMVnjA&oe=6AFB2C54"}, {"file_name": "migrated_image.png", "id": "246754393025091", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162788_1159088237569028_8479258378613293056_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4dQWKMSEPQQ7kNvwHDXr25&_nc_oc=AdqbrHyN3e81WlUL4V8o-FnUW1r1DEv0p6FRvaewK54S7nu8hCge3xrug63BxaR8f04&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5nPcgePOoe5HFISCilp2IVZW-6EykifDMzdUM4cQHkQ&oe=6AFB4966"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raising A Rukus", "keywords": ["Animated", "Kids", "Dog", "Dinosaur", "Film"], "long_description": "This adventure requires 2.6 GB total.\n\nTwins Amy and Jonas just found a dog- or did he find them? Either way, Rukus has a magical secret \u2013 he\u2019s about to take them to a whole new world. \n\nEqual parts thrilling, breathtaking, and inspiring, Raising a Rukus is an animated adventure like no other. With cutting edge \u201cbranching narratives,\u201d choose which character\u2019s journey you want to follow by a simple gaze with your eyes. \n\nJump right into magical, rollercoaster journey through a prehistoric world! Come along for the ride with Jonas and Amy as the river propels you, dinosaurs chase you, and Rukus delights you!\n\nRaising a Rukus is the first episode of the groundbreaking new franchise from the Academy Award Winning Production Designer of Avatar and the Director of Maleficent.", "short_description": "This adventure requires 2.6 GB total.\n\nRide along with twins Amy and Jonas as they chase their mischievous pet dog, Rukus, through an amazing adventure into a prehistoric world. \n\nWith cutting edge \u201cbranching narratives,\u201d choose which character to follow and discover a different path with a simple gaze of your eyes!\n\nA new animated experience from Oscar-winner Robert Stromberg and The Virtual Reality Company."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thevrcompany.com/privacy-policy", "developer_terms_of_service_url": "https://www.thevrcompany.com/terms-of-use", "publisher_name": "The Virtual Reality Company", "support_website_url": null, "website_url": "http://www.thevrcompany.com/raising-a-rukus", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "
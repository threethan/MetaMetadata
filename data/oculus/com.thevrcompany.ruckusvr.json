=R0h77etij_8Q7kNvwHPE_qB&_nc_oc=Adqo8A-5_HoFKUjUmswWlH35jE69oeDBZk4eiQZzLsH03uzQ6hGCt-Sr1M90s0kEc10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRnvZPpxAdKPOJH9Urw-7iWLmmPZipPriEeN4jZf9oLA&oe=6AA5750C"}, {"file_name": "migrated_image.png", "id": "511791449511251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162711_217098705454116_3705581251936124928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzqEI980QRYQ7kNvwHhkhiZ&_nc_oc=Ado5hQ5oSD4sajHKZv1vXy5tPoLrXlNkqghFCBQlemKusLMRcHDefoY27qCKvsgJmQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXzbtMbUZL1Vhq4iZU04GAdgDdxM-LOVOKvOeYAYg_8A&oe=6AA570D2"}, {"file_name": "migrated_image.png", "id": "259948371672574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162716_1539544386096939_7248369185925890048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8UyI8mcveEQ7kNvwGf9SOd&_nc_oc=AdpwEV0QJsh6DLaS6qvPO89PnFCGN7WB7qAHBm9rRApEgB9TVUSUcl-cmmHLRdZLdcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRCxJKZ04jOHAKwYMV47FfmM4NmaPQU7VwhW2pDe9IEg&oe=6AA54294"}, {"file_name": "migrated_image.png", "id": "246754393025091", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162788_1159088237569028_8479258378613293056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHj35Gw9T00Q7kNvwFgf6qc&_nc_oc=Adpb4asQ8e9tAICoYCosmbToIOxaAmC7gS23aZuizA6W3xv8d-2-Um_Hm3QrdP5AKaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLTKIjUW7YB0PAHJyp4adpOuw8vcT_4EIw4eRzZKc4Aw&oe=6AA55FA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raising A Rukus", "keywords": ["Animated", "Kids", "Dog", "Dinosaur", "Film"], "long_description": "This adventure requires 2.6 GB total.\n\nTwins Amy and Jonas just found a dog- or did he find them? Either way, Rukus has a magical secret \u2013 he\u2019s about to take them to a whole new world. \n\nEqual parts thrilling, breathtaking, and inspiring, Raising a Rukus is an animated adventure like no other. With cutting edge \u201cbranching narratives,\u201d choose which character\u2019s journey you want to follow by a simple gaze with your eyes. \n\nJump right into magical, rollercoaster journey through a prehistoric world! Come along for the ride with Jonas and Amy as the river propels you, dinosaurs chase you, and Rukus delights you!\n\nRaising a Rukus is the first episode of the groundbreaking new franchise from the Academy Award Winning Production Designer of Avatar and the Director of Maleficent.", "short_description": "This adventure requires 2.6 GB total.\n\nRide along with twins Amy and Jonas as they chase their mischievous pet dog, Rukus, through an amazing adventure into a prehistoric world. \n\nWith cutting edge \u201cbranching narratives,\u201d choose which character to follow and discover a different path with a simple gaze of your eyes!\n\nA new animated experience from Oscar-winner Robert Stromberg and The Virtual Reality Company."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thevrcompany.com/privacy-policy", "developer_terms_of_service_url": "https://www.thevrcompany.com/terms-of-use", "publisher_name": "The Virtual Reality Company", "support_website_url": null, "website_url": "http://www.thevrcompany.com/raising-a-rukus", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1527313400983886"}, "review_m
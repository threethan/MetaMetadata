=0kosUmZZJWEQ7kNvwHnvpAk&_nc_oc=AdqVUfOqVDn62dFURoRzgY_vyxMY7dzAE3Zc5VauJo15fdqTzFOgvF8yguc5r4U6GLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6EGZ7-reQszIEMmSbfgmc7rKxONBkq2ZbqMHyxshw8w&oe=6AF33D8C"}, {"file_name": "migrated_image.png", "id": "511791449511251", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162711_217098705454116_3705581251936124928_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVY_g3y1h_kQ7kNvwHCQnvg&_nc_oc=AdoOvEGy77Pu84fP_xzIpH3N3k_LamjX3eATTQ5TYoMwTMO4vlTtq2MOLD9J7s9rtDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBmQFvt9ufA1-DEv5BNj95DRjFQaMtZ01GOAJOSN3o4w&oe=6AF33952"}, {"file_name": "migrated_image.png", "id": "259948371672574", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_1539544386096939_7248369185925890048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnDlvufA11MQ7kNvwHqVy7z&_nc_oc=AdrPd001biy1eBxJaHNOFHEyh4WDFwZhzsGjXIodAT4zfdFKnbzfxkPfbqJfCMXd6rw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0xuGb2oRXz6PzE5HLdNG84divZ0L3gQJBiUgGtBFAWQ&oe=6AF34354"}, {"file_name": "migrated_image.png", "id": "246754393025091", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162788_1159088237569028_8479258378613293056_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RJ-7Gq3VdcQ7kNvwEgoA4B&_nc_oc=AdrmdfzaeBOeH_4FKCRbH1deNqNVppd3OZrCbQK6Nh9xNkfRuggjClcz-joU0ExAdpg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP0WwwSaxFP5uHjJS_B_95JRe_PzGamB_QbxtZuvUZ9g&oe=6AF32826"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raising A Rukus", "keywords": ["Animated", "Kids", "Dog", "Dinosaur", "Film"], "long_description": "This adventure requires 2.6 GB total.\n\nTwins Amy and Jonas just found a dog- or did he find them? Either way, Rukus has a magical secret \u2013 he\u2019s about to take them to a whole new world. \n\nEqual parts thrilling, breathtaking, and inspiring, Raising a Rukus is an animated adventure like no other. With cutting edge \u201cbranching narratives,\u201d choose which character\u2019s journey you want to follow by a simple gaze with your eyes. \n\nJump right into magical, rollercoaster journey through a prehistoric world! Come along for the ride with Jonas and Amy as the river propels you, dinosaurs chase you, and Rukus delights you!\n\nRaising a Rukus is the first episode of the groundbreaking new franchise from the Academy Award Winning Production Designer of Avatar and the Director of Maleficent.", "short_description": "This adventure requires 2.6 GB total.\n\nRide along with twins Amy and Jonas as they chase their mischievous pet dog, Rukus, through an amazing adventure into a prehistoric world. \n\nWith cutting edge \u201cbranching narratives,\u201d choose which character to follow and discover a different path with a simple gaze of your eyes!\n\nA new animated experience from Oscar-winner Robert Stromberg and The Virtual Reality Company."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thevrcompany.com/privacy-policy", "developer_terms_of_service_url": "https://www.thevrcompany.com/terms-of-use", "publisher_name": "The Virtual Reality Company", "support_website_url": null, "website_url": "http://www.thevrcompany.com/raising-a-rukus", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1527313400983886"}, "review_m
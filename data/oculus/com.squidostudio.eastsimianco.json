u9TEmTPHq_1g1fsfQ5fsNv66afI0ul1V6yGtTT8jAMy5mc9Lzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONo5qyjUPWFEx-ehaEQ3mvB57m8SjlTDK2JbdirJWLPQ&oe=6ACBA37A"}, {"file_name": "30bb6cdd0eb8ac14850a8c1b627e5a33_optimized.png", "id": "24769714332621979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824082_24769714355955310_8635401667898193995_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTtyELNbqQ0Q7kNvwFPL52g&_nc_oc=AdoAZMyg4-qXvTSMwTbdscb8FuWanKZNhPRAzMXXCwZXSRQi283jxyqskeq-518srPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNanNkzgUKJWOlSDGPySBhkS9VGNJbuP8QKaJ8MyKbxYQ&oe=6ACBBE04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CaveBound_KeyArt_Landscape.png", "id": "1699661487216680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627193_1699661493883346_4264959065553211145_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvJ_1ZMxNRIQ7kNvwGbsj67&_nc_oc=AdrgOPz0_V7Z21QGO03RRfx5lcLdy42yHvBpvGT6PZynhd72rQTAw6VqTL0f7S6exbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9ZcWTKPcv8nZj19X2CfNIExc3olx05oMutNYQ7D0lpg&oe=6ACBA9FD"}, "display_name": "Cavebound VR", "keywords": ["Casual", "Exploration", "Social", "Funny", "Colorful"], "long_description": "Cavebound is a charming, casual social adventure where players team up to explore a whimsical underground world, mine glittering crystals, and uncover hidden treasures. Dive into cozy, vibrant caves alongside your goofy mole companions\u2014or meet new friends along the way\u2014as you dig deep and reveal the secrets buried below.\n\nWith its colorful, inviting art style and relaxing gameplay, Cavebound offers a stress-free escape perfect for players of all ages. Work together to gather resources, discover rare gems, or just relax in the colorful environments. Explore with friends, mine or find colorful treasures, or simply enjoy the serene beauty of the underground\u2014there\u2019s no pressure, just pure, laid-back fun!\n\nWhether you're playing solo or teaming up for cooperative mining expeditions, Cavebound blends light exploration, social interaction, and satisfying collection mechanics into a delightful experience. Unearth ancient relics and uncover the mysteries hidden beneath the surface. Will you strike it rich with a legendary crystal? Or will you focus on creating the most stylish mole in the underground? The choice is yours!\n\nPerfect for short play sessions or longer, leisurely adventures, Cavebound is a heartwarming game about friendship, discovery, and the joy of digging just a little deeper. Grab your drills, rally your mole pals, and let\u2019s explore!", "short_description": "Cavebound is a charming, casual social game where players team up to explore vibrant caves, mine precious crystals, and uncover hidden treasures. Work together with your goofy mole friends or meet new adventurers as you dig deep, and uncover the secrets hidden below. With colorful visuals, relaxing gameplay, and lighthearted social interactions, Cavebound offers a delightful escape for players of all ages. Collect treasure, find secrets, or just enjoy the serene underground world together!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": "https://discord.gg/3eszghUZjj", "website_url": "https://www.squidostudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
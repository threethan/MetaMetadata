=6e7a0a&_nc_ohc=un4UAqERqN0Q7kNvwHsple5&_nc_oc=AdrIAxiFlT53gOaUmQttQPO-jDREx3Q7jYGkXp3JyvmDLBVcPNCK7XhGXhWslkDB6Bw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe8mdAt_CqM2EPVbRihJOuPNujlU_eaBuHS2ypB-8ICg&oe=6AF9CCBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER_LANDSCAPE NEW 32 (1).png", "id": "2275748496277605", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491831968_2275748499610938_6671905025032731661_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoGiG0sLjU4Q7kNvwGu2NxI&_nc_oc=Adrh79FLm-jifuykGqQY3gkFPUKKLwBeC9L6AH3hnqU6lMSh6NqtBDUT8dTmzbf4p0w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Xr0wYJBMXGXZ5oxeTxUfNkdujQ8zKbt2Jnm_X59pSw&oe=6AF9D4B8"}, "display_name": "Realize Music: Sing", "keywords": ["singing", "karaoke", "mindfulness", "artistic"], "long_description": "Karaoke lovers and music enthusiasts will discover a whole new way to enjoy music in Realize Music: Sing VR. If you love singing along to your favorite artists, this immersive VR singing experience turns every song into a dynamic performance.\n\nPut on your headset, pick a track, and sing in VR while lyrics appear clearly in front of you and vibrant environments react to your voice with color, light, and motion.\n\n**Try for free, subscribe to access over a million songs, or purchase just your favorite songs.** Explore a massive music catalog featuring tracks across genres\u2014including songs often unavailable in traditional karaoke settings.\n\n\n{1317517246867401}\n\nBrowse a huge and diverse music library with new songs added regularly.\n\n{1446401080312688}\n\n**Key Features**\n\n- **Sing in VR** \u2013 Perform your favorite songs in immersive, voice-reactive environments.\n- **Song Hero Mode** \u2013 Test your vocals in a rhythm challenge with scores and leaderboards\n- **Singadelic Mode** \u2013 A relaxing, non-scoring way to experience music visually\n- **Massive Music Catalog** \u2013 Access over a million licensed songs across genres\n- **Interactive Tools** \u2013 Drum along, paint glowing 3D light, and search songs with your voice\n\n{1239795531073311}", "short_description": "Karaoke lovers and music enthusiasts will feel right at home in Realize Music: Sing VR. Sing in VR with immersive worlds that react to your voice with color, light, and motion. Explore a massive music catalog of original master recordings from the world\u2019s biggest artists\u2014never karaoke-style covers\u2014and enhance every session with creative tools like drumming, voice search, and 3D light painting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.realizemusic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Realize Music Inc", "support_website_url": null, "website_url": "https://www.realizemusic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1672577396871977"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26441479402140584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499300738_4260856747565676_4870956402839011870_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7OCsgWAh_AQ7kNvwFfKi7f&_nc_oc=AdoqxkGd7Ldb4ciL2b4LZ8o88peqU78QywXBZq8m2II023HF8thiobF5j5Niby6EWgA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQne6zDxsN7mE5EhzxB
s=7f20f&oh=00_AQSmM8FY7E_zkhwJsa1msxAALIBi8DOxaiifeRUHQRagOg&oe=6AF9CDB1"}, {"file_name": "56.png", "id": "805719002442488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303391_805719005775821_624560298031330345_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkO9u65BdAUQ7kNvwFMFr2z&_nc_oc=Adr21i5FcB_Io6Q1ckK0UwgsMPFeCY7C6K8dllocnvLiihdvPPkXcey4Br3h2aYf_as&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-np0g4vJaB9XhVxz_CKlTlf1b880rqZJCL7EXBAK-_A&oe=6AF9E75D"}, {"file_name": "58.png", "id": "1161293755370950", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499294616_1161293758704283_6705549104118189693_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4pdcSOPq6AQ7kNvwE57_f6&_nc_oc=Adp1uuOXZo3pepXj6kWuZTDD0DCn5T6iXBVWhIwVOM1EKHmI6y3k0H_sOT0yfkH9XjE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPMiFrm2SaQmPpIdGWdw_bBM1TJMp307lHKMic0OFlsg&oe=6AF9EC10"}, {"file_name": "52.png", "id": "3870654023224975", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299772_3870654026558308_7581762192057153266_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un4UAqERqN0Q7kNvwHsple5&_nc_oc=AdrIAxiFlT53gOaUmQttQPO-jDREx3Q7jYGkXp3JyvmDLBVcPNCK7XhGXhWslkDB6Bw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe8mdAt_CqM2EPVbRihJOuPNujlU_eaBuHS2ypB-8ICg&oe=6AF9CCBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape meta (3).png", "id": "833047392549118", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300619_833047395882451_6779868891491558604_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJO6N8WK0WcQ7kNvwF3iKMU&_nc_oc=AdprsRyAHDPP-Fbr-wOKAUBGQeiKH-XLS-Dt7POq8PGISuYgxSqQCnrsIxdS5YeK9SA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxp4pVmuxAS7coyUX9M0KciPiqjCgYPNoWesLgAOT1qQ&oe=6AF9E1A2"}, "display_name": "Realize Music: Sing", "keywords": ["singing", "karaoke", "mindfulness", "artistic"], "long_description": "Whether you sing every day or think you can\u2019t carry a tune, Realize Music: Sing is for everyone!\n\nSimply grab the headset, pick a song from the catalog, and the stage is yours. Lyrics float clearly in front of you in one of a dozen immersive worlds, as the world bends and shifts with your voice.  Every chorus fills the space with motion, light, and the feeling of a world alive to your voice.\n\n{1642333513395644}\n\nIt isn\u2019t only about singing. With your controllers you can pound on virtual drums in rhythm, paint streaks of 3D light through the air, search the massive catalog with your voice, or even play fully reclined. However you use it, Sing turns your voice and popular music into play.\n\n{25497233713201853}\n\n**Key Features**\n\n- Sing in VR \u2013 Step into dynamic, reactive worlds that respond to your voice with color, light, and motion.\n\n- Song Hero Mode \u2013 Compete for scores and leaderboards in a rhythm-game challenge for vocals.\n\n- Singadelic Mode \u2013 A non-scoring mode that turns every track into a freeform, expressive wellness experience.\n\n- Play Beyond Singing \u2013 Use controllers to drum, paint streaks of light, search with your voice, and even play while dancing or while fully reclined.\n\n- Record-Breaking Catalog \u2013 The largest licensed music library ever featured in a video game, spanning genres and eras, with new tracks added weekly.\n\n- Judgment-Free Design \u2013 Sing for the way it makes you feel, without scores or leaderboards. Sing for yourself!\n\n- Social Options \u2013 Sing privately or cast performances to a TV so friends can join in.", "short_description": "Experience the future of music. Explore a vast catalogue of songs from the world's biggest artists in stunning, voice-responsive environments that change as you sing. With interactive tools like 3D painting and drumming, each session becomes a personalized journey with creativity shaping the experience. Whether singing solo or sharing playlists with friends, Realize Music: Sing offers a deeply immersive, interactive, and ever-evolving world of discovery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.realizemusic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Realize Music Inc", "support_website_url": null, "website_url": "https://www.realizemusic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1700921480735423"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9346126895435768"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27367658379522677", "version": "1.0.1.2919"}, "id": "1630234914288520", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9346126882102436", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27367658379522677"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784050737, "id": "27644056211882891", "version": "1.0.1.2936", "version_code": 12499, "release_status": "RELEASED", "status": "AP
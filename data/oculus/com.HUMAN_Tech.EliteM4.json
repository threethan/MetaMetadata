20f&oh=00_AQDOq1eq95RDsJdtH84ZFSgMAW8JqM6jJ8f0m70AdbYvFQ&oe=6A6604F4"}, {"file_name": "Screenshot3.png", "id": "1046117807341796", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391949_1046117814008462_8582169690262058300_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ricqLvi_04Q7kNvwEDtkYl&_nc_oc=AdoHhK67lYJT-PC8ha30JzCmcVKa-sgFXLVQkpYIHc-awW2Ztz0O-nY3y6b5Stq5KK0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPMmggwTzShF6T6nONvSfScj2jGP0cWt9ZkhwneA4jHw&oe=6A65FFD2"}, {"file_name": "Screenshot5.png", "id": "1009675274367433", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391959_1009675277700766_5844326197119749667_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lctNfOCCb8wQ7kNvwFI0FPT&_nc_oc=Adq42Xp4oOCjcaGygHACWl0al68HsFa6XSNkmQ2cxWzuagltI-BA7uVakGDEIt3jPYw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcvWaDVVkO0mpvGmkKkjqTv8m_Gs9H84alkVZGLsBdNQ&oe=6A65F280"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M4", "keywords": ["acci\u00f3n", "ELITE"], "long_description": "Bienvenido a la oficina\u2026 \u00bfo al campo de batalla?\nEn esta experiencia inmersiva para Quest, vivir\u00e1s una ma\u00f1ana de trabajo en la que tendr\u00e1s que enfrentarte a tus compa\u00f1eros de oficina. Cada uno traer\u00e1 desaf\u00edos \u00fanicos que pondr\u00e1n a prueba tu paciencia, habilidades de comunicaci\u00f3n y toma de decisiones.\n\ud83d\udd39 Interacciones realistas y divertidas con personajes din\u00e1micos.\n\ud83d\udd39 Dilemas inesperados que cambiar\u00e1n el rumbo de tu jornada.\n\ud83d\udd39 Decisiones con consecuencias: elige sabiamente c\u00f3mo manejar cada situaci\u00f3n.\n\n\u00bfSobrevivir\u00e1s a la ma\u00f1ana sin perder la cabeza? \u00a1Ponte el visor y desc\u00fabrelo!", "short_description": "Sobrevive a una ma\u00f1ana en la oficina en esta experiencia inmersiva para Quest.  Interact\u00faa con compa\u00f1eros de trabajo \u00fanicos, resuelve si
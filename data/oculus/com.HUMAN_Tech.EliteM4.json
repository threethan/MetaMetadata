om&_nc_ss=7f20f&oh=00_Af9vWQ07NUubWxYZYRg2Ack1jHUO_l9lBNeHM633vueUxw&oe=6A22C874"}, {"file_name": "Screenshot3.png", "id": "1046117807341796", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391949_1046117814008462_8582169690262058300_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1EC9CrQ4csQ7kNvwHR8a7U&_nc_oc=AdoOQk6a24eKEyGa-MQvFyLHr1uR4cpHJED8l3M8pdRUzkxlDqYYF0vivpN0oyM2AuA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af991omlfIJ0c5uYU-lAh_58JV3BZWa163ZYMAbEPMhQvA&oe=6A22FB92"}, {"file_name": "Screenshot5.png", "id": "1009675274367433", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391959_1009675277700766_5844326197119749667_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPJa4QeJVcwQ7kNvwGk95OT&_nc_oc=Ado1zTgNv3Osl1mGvrFLuowWnMcNhtzLYXEyXMPWxlVkU1mMgmUJDeW_EtsZkqJUt0o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8quwk2iqKsdlooI4T1KYvkgEPlQaC2HdAKzr-lDhvhCw&oe=6A22EE40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M4", "keywords": ["acci\u00f3n", "ELITE"], "long_description": "Bienvenido a la oficina\u2026 \u00bfo al campo de batalla?\nEn esta experiencia inmersiva para Quest, vivir\u00e1s una ma\u00f1ana de trabajo en la que tendr\u00e1s que enfrentarte a tus compa\u00f1eros de oficina. Cada uno traer\u00e1 desaf\u00edos \u00fanicos que pondr\u00e1n a prueba tu paciencia, habilidades de comunicaci\u00f3n y toma de decisiones.\n\ud83d\udd39 Interacciones realistas y divertidas con personajes din\u00e1micos.\n\ud83d\udd39 Dilemas inesperados que cambiar\u00e1n el rumbo de tu jornada.\n\ud83d\udd39 Decisiones con consecuencias: elige sabiamente c\u00f3mo manejar cada situaci\u00f3n.\n\n\u00bfSobrevivir\u00e1s a la ma\u00f1ana sin perder la cabeza? \u00a1Ponte el visor y desc\u00fabrelo!", "short_description": "Sobrevive a una ma\u00f1ana en la oficina en esta experiencia inmersiva para Quest.  Interact\u00faa con compa\u00f1eros de trabajo \u00fanicos, resuelve situaciones inesperadas y descubre si tienes lo que se necesita para salir ileso de una jornada laboral. \u00bfListo para el reto?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9449086155160877"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2759655294219034"}]}, "baseline_offer": {"id": "2759655294219034"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744026480, "status": "PUBLISHED", "id": "2759655294219034"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26014098291566402", "version": "1.21"}, "id": "907458910852065", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8537135003022668", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26014098291566402"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "9074589108520
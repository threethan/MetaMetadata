&_nc_oc=AdojwA1mQ4HZ9hjWKi9NnVLrTwkiSiU_FSU4Q9zSRorgBtBINOofVeLb8XGziFYb_5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK4MQA3P5FVq7w1K39vMMZAsbMi5m4HHj7Rybbj7XbzQ&oe=6AFDD514"}, {"file_name": "Screenshot1.png", "id": "9244168659010428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_9244168662343761_8072347485128096120_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNTesOzRLdsQ7kNvwEkjTNI&_nc_oc=AdoKIT2tHivfjpPtjTJSqJVICtzT0Oeo-lF1lj1RwSAe9H_aXcH0m0Cg74qKvGwbRPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0bjkC-2eCn2OHVpCb-leaWAs68wUvO-H_Agv_zRvcJQ&oe=6AFDD9B4"}, {"file_name": "Screenshot3.png", "id": "1046117807341796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1046117814008462_8582169690262058300_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EekvMKRb5n0Q7kNvwG3Cgct&_nc_oc=Ado3bS2c-hdSZvR1iS8JLrvjG00DFwsFANkQSaCNFLb2DXj75PcHkAO1iNz5tkrTugk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzyZOnP_Re8qsddEWhB48CD13-yUynoCJKMnXzfV2XWg&oe=6AFDD492"}, {"file_name": "Screenshot5.png", "id": "1009675274367433", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1009675277700766_5844326197119749667_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqy7wZ18SUMQ7kNvwFRqFsr&_nc_oc=Adp0PWoFxW0rN3VJmNnlUFK2bp1RCtbE5arAkz8AXg4_jW69To6EL7jWYuLWoakt2R8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqm4it7PeD6UNv2RIyqjlolM8ZL9iCxo3C1PdcIOe6fw&oe=6AFDC740"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M4", "keywords": ["acci\u00f3n", "ELITE"], "long_description": "Bienvenido a la oficina\u2026 \u00bfo al campo de batalla?\nEn esta experiencia inmersiva para Quest, vivir\u00e1s una ma\u00f1ana de trabajo en la que tendr\u00e1s que enfrentarte a tus compa\u00f1eros de oficina. Cada uno traer\u00e1 desaf\u00edos \u00fanicos que pondr\u00e1n a prueba tu paciencia, habilidades de comunicaci\u00f3n y toma de decisiones.\n\ud83d\udd39 Interacciones realistas y divertidas con personajes din\u00e1micos.\n\ud83d\udd39 Dilemas inesperados que cambiar\u00e1n el rumbo de tu jornada.\n\ud83d\udd39 Decisiones con consecuencias: elige sabiamente c\u00f3mo manejar cada situaci\u00f3n.\n\n\u00bfSobrevivir\u00e1s a la ma\u00f1ana sin perder la cabeza? \u00a1Ponte el visor y desc\u00fabrelo!", "short_description": "Sobrevive a una ma\u00f1ana en la oficina en esta experiencia inmersiva para Quest.  Interact\u00faa con compa\u00f1eros de trabajo \u00fanicos, resuelve situaciones inesperadas y descubre si tienes lo que se necesita para salir ileso de una jornada laboral. \u00bfListo para el reto?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9449086155160877"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2759655294219034"}]}, "baseline_offer": {"id": "2759655294219034"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744026480, "status": "PUBLISHED", "id": "2759655294219034"}]}, "liveChannel": {"
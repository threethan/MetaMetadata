14254_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vat-JfE17bgQ7kNvwEMcVwN&_nc_oc=AdooxiJY0uR6A3aqc2t3UFDcMaInCZrVOxKCoJBebl2QRB53CdPsnkLJc5RuhjNcEHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0PmOt7znvrSoXHUTPhGiA3EBUvFuuS82ACkwFXb54MA&oe=6AC63FBD"}, {"file_name": "Screenshot4.png", "id": "1193067742155000", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_1193067745488333_2710538528861986461_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZEhqpBqHEoQ7kNvwFTE_d0&_nc_oc=Adq6iS83ODrqbfwqs4ON268aAOfFczw86vNR1FquEw0vmDfFQ64WJXtl7FZdRSgctsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1URBWSdDxfdhv5PE4yj_rewUgaMkFHiu9-hUkhNim4g&oe=6AC67614"}, {"file_name": "Screenshot1.png", "id": "9244168659010428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393325_9244168662343761_8072347485128096120_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEwA3q9Q1QcQ7kNvwEbNmy8&_nc_oc=Adri-iDRJDEqxob_dmOaBnivO_WPRG1EAWJXF8siyW_uxiciMZ-xKiblIGnC1Ot1l8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_pkl6D-lD15qDVMbOB2kAZKTSU2b-Dg7TpJIheWIJhg&oe=6AC64274"}, {"file_name": "Screenshot3.png", "id": "1046117807341796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391949_1046117814008462_8582169690262058300_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is6U46g6kDgQ7kNvwGkL38C&_nc_oc=AdowCoA0Nfi8OIM51UEpW5JWZuS1elWz0kG49v90l2qSIORkPjHVXPgZhsxKR9hfmiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN112HBknHEMaVPpnwYqLLgvAQsdCNswfPYbHTUnWHn5Q&oe=6AC67592"}, {"file_name": "Screenshot5.png", "id": "1009675274367433", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391959_1009675277700766_5844326197119749667_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=848goOi-0MYQ7kNvwEPuMNg&_nc_oc=AdopIFy9aoyos59fuMBS91cd11lqNGVGI1nwKqh2Kyws7fodTgUP8OkX-7A3gBpsXVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHngEfjr4we1uaVUi6-LZ3XxSSLnBo80-PxcLCk0n_zg&oe=6AC66840"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M4", "keywords": ["acci\u00f3n", "ELITE"], "long_description": "Bienvenido a la oficina\u2026 \u00bfo al campo de batalla?\nEn esta experiencia inmersiva para Quest, vivir\u00e1s una ma\u00f1ana de trabajo en la que tendr\u00e1s que enfrentarte a tus compa\u00f1eros de oficina. Cada uno traer\u00e1 desaf\u00edos \u00fanicos que pondr\u00e1n a prueba tu paciencia, habilidades de comunicaci\u00f3n y toma de decisiones.\n\ud83d\udd39 Interacciones realistas y divertidas con personajes din\u00e1micos.\n\ud83d\udd39 Dilemas inesperados que cambiar\u00e1n el rumbo de tu jornada.\n\ud83d\udd39 Decisiones con consecuencias: elige sabiamente c\u00f3mo manejar cada situaci\u00f3n.\n\n\u00bfSobrevivir\u00e1s a la ma\u00f1ana sin perder la cabeza? \u00a1Ponte el visor y desc\u00fabrelo!", "short_description": "Sobrevive a una ma\u00f1ana en la oficina en esta experiencia inmersiva para Quest.  Interact\u00faa con compa\u00f1eros de trabajo \u00fanicos, resuelve situaciones inesperadas y descubre si tienes lo que se necesita para salir ileso de una jornada laboral. \u00bfListo para el reto?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH",
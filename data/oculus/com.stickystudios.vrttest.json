null, "video_trailer_thumbnail": null, "display_name": "MOCA: Kerry James Marshall", "keywords": ["MOCA", "Museum", "Art", "VR", "Contemporary"], "long_description": "Enjoy one of the most celebrated contemporary art museum exhibitions of the past decade in VR! Kerry James Marshall: Mastry ended its run on July 3, 2017 at the Museum of Contemporary Art (MOCA) Los Angeles, but is now available in its entirety for all to view and enjoy. Flawlessly captured with laser scanning and volumetric photogrammetry, the experience enables you to walk the halls of MOCA as if you were actually there.", "short_description": "Enjoy one of the most celebrated contemporary art museum exhibitions of the past decade in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrtventures.art/", "developer_terms_of_service_url": "http://www.vrtventures.art/", "publisher_name": "VRt Ventures", "support_website_url": null, "website_url": "http://www.vrtventures.art/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4896812350400280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162707_143329993077117_1903075965630676992_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EEb91WYlWoQ7kNvwFDBYjE&_nc_oc=AdrHSdwhnukb5iFSl-DOoXNHT1mhNNM3QJn9tYYfMFzbs1ahH335uONqPNcPx1O2rp4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2EpRJYuItDr9jgQaEAdSzsK
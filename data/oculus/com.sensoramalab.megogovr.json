e2AzbDq9mWUAU0wg&oe=6ACD0FA0"}, {"file_name": "screen_2560x1440_4.png", "id": "1207507513816858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395600_1207507517150191_1637305848782642509_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIwL6wKxZgUQ7kNvwG1UJ6m&_nc_oc=AdpQQ0OBt1GNdmd61ECnqov7p2c63MTymvJSz0zr4d5wMVSr3e4McUk6jcYj6wasv5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOojCYRrHKx-Sqjdno3Q0veWEbrMb6A9a-hzIUlqIJgeA&oe=6ACCE1B0"}, {"file_name": "screen_2560x1440_5.png", "id": "356793867398122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982693_356793870731455_5713479648218928983_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPwtiZbOTtMQ7kNvwF0Kr-i&_nc_oc=AdqAeEHK_rCjUGf2_WkzCZNGbmmYOFTDgAZMSSMC4mBqykMTs1eCkc9h5DxGKTG4FtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGinM8ZQ_YJ4Hs1R0BQ4gtyeJPQH6mG1pwKfmPYUBUxA&oe=6ACD176A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MEGOGO VR", "keywords": [], "long_description": "**Virtual reality is cooler with MEGOGO TV and Movies**\n\nWith our application, you can find yourself in the center of the top stories \u2014 whether it's a thrilling movie, a bright cartoon story, or an unusual adventure. Ready to become a part of a fantastic world while staying at home? Then we're on our way!\n\nNow your evenings will be even more exciting and memorable because thousands of movies, series, and cartoons are waiting for you on our media service. And, of course, don't forget about TV. Here you will find your favorite channels and feel like you are a part of a screenplay.\n\n**Download the app and erase the boundaries of reality**\n\nTo start your journey with MEGOGO, all you need to do is download the app on your VR device. \n\nVirtual reality is closer than ever, and now everyone can experience the magic of this amazing world \u2014 download and enjoy a borderless experience with us!\n", "short_description": "Make your journey into the world of virtual reality even more exciting \u2014 download the MEGOGO TV and Movies app \ud83d\udda5\ufe0f\n\nWatch your favorite TV channels and choose from a collection of top movies, cartoons, and series \u2014 there is enough content for a long time! Download, connect your VR device, erase the boundaries of reality, and enjoy the special atmosphere with us."}]}, "developer_name": null, "developer_privacy_policy_url": "http://megogo.net/ru/rules", "developer_terms_of_service_url": "http://megogo.net/ru/rules", "publisher_name": "MEGOGO LLC", "support_website_url": "https://megogohelp.userecho.com/", "website_url": "https://megogo.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8449760058378681"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1706922386722876"}]}, "baseline_offer": {"id": "1706922386722876"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727168820, "status": "PUBLISHED", "id": "1706922386722876"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8845715092116507", "version": "2.3.1"}, "id": "2103664403362130", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "
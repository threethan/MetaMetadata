v/t64.5771-25/499307435_1470527348004909_321640374484070938_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyVEXcvXTUAQ7kNvwFTxxPE&_nc_oc=AdqXmuhtvr-Q4o-AVJHKsKXEIlCzUSytZLkDeJfecc0OV3ybRmT41uQMAchY8p5Kb7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU2S-14_WP7tUzH2wV2e4KNvgiYzOMZ_afsvJBX1D3-w&oe=6AC3A390"}, {"file_name": "screenshot3_stretched_2560x1440.png", "id": "26350487817893805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_26350487827893804_2175727466209704829_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d2pg1VGRUEQ7kNvwF-k96w&_nc_oc=AdqiFVkuZs8dDIWmPEZgLImT06V8QKzZicE2Y090iSRN9dUikdXq8vByohDEemzGwCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCEWqmu4FwWkDHPYAf_xg8yiouYxKTDmUYTB3OqC_n5Q&oe=6AC3B8F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Felix: Reawakened", "keywords": [], "long_description": "Set in a series of beautifully crafted landscapes ranging from dense jungles to urban playgrounds, players must navigate obstacles, hide behind structures, and utilize their surroundings to outsmart opponents. The game encourages players to think strategically about their movements while providing the freedom to express their physicality. \n\nWith easy-to-learn controls, players can leap, swing, and sprint, creating an adrenaline-pumping experience that feels as if they\u2019re truly in the game. Multiplayer modes enable friends to team up or compete against each other, adding layers of excitement and camaraderie. Players can customize their characters and unlock unique abilities, enhancing their gameplay and offering a personal touch to their tagger persona.\n\nWhether you\u2019re strategizing with teammates or plotting your next move as the tagger, **Project Felix* combines the thrill of physical competition with the immersive power of virtual reality, making every session a unique adventure. Get ready to dive into a world where movement is your greatest weapon, and the chase is just the beginning!", "short_description": "Set in a series of beautifully crafted landscapes ranging from dense jungles to urban playgrounds, players must navigate obstacles, hide behind structures, and utilize their surroundings to outsmart opponents. The game encourages players to think strategically about their movements while providing the freedom to express their physicality. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1K6BaE9chKs3dTzZ5wdhMYkpcOfv4acD99WNuIPzxhMQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Vfx Corp", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1PJED5LWTiZt6mj06Me6n41WCN11PaZ_5QBmLHo76lUo/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26794649286785868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295272_1970365080183893_6764611458351198190_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rs4oKkjQriUQ7kNvwEoXEPU&_nc_oc=AdoALS6tPRY8Rwh9IZ0ytLlgNd8V-cIi_sGBI1rll5kh7mTqeaJ_GfUUwgvh-3jnKVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJspKlAHMyYlGOLyfoT0u6ciiuKifEO3YCoAjIOV5B7g&oe=6AC3C476"}, "is_co
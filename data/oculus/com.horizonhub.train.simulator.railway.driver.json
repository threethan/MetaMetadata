nshot_1.png", "id": "1497714224483277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619524_1497714227816610_6253105658809501486_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeVRcYduRw0Q7kNvwG2pstC&_nc_oc=AdlsJtX5WymhBZJlK4oZx8pwLVnnI2olWnqmAKREv28o_3JYJ-9w0zqkU_SMgC4cGSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5Y01G1cUADgle8YDPKqZjPiOVUgEQYSn1O1qg27A0VA&oe=69B937E2"}, {"file_name": "Screenshot_5.png", "id": "1119210369615855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831393_1119210372949188_4805312957544639689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ11h1yEz6kQ7kNvwGCoGyM&_nc_oc=AdmIkHJf__hVRB13eyb25K0rqOFh0uULvQk-th_Zf9uSJmWKRZaAmZ-Q0iP1KshXzV0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxiwsJsL8XgnuExs_eUdQAIuRil3XN5a5xXAc_KHc4X7Q&oe=69B957B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Train Simulator : Railway Driver", "keywords": ["TrainSimulator", "TrainGame", "RailwayDriver", "TrainDrivingGame"], "long_description": "Step into the driver\u2019s seat and take control of powerful city trains in this immersive VR railway simulator.\nFollow signals, manage your speed, and transport passengers safely across detailed city routes. With realistic controls, lifelike environments, and true-to-life railway systems, every ride feels like the real thing.\nMaster different train models, stop precisely at stations, and prove your skills as a professional railway driver. Whether you\u2019re a beginner or a simulator enthusiast, this experience delivers the thrill of operating trains in virtual reality.\n\ud83d\ude86 Features:\nRealistic train driving physics and controls\nImmersive city environments and railway tracks\nPassenger pickup and drop-off challenges\nMultiple train models to drive\nDesigned for VR immersion on Meta Quest\nBecome the ultimate Railway Driver and experience the most authentic train simulator in VR.", "short_description": "Experience realistic city railway driving in this immersive train simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trainsimulator-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25457044030624105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_1091814382928786_3016540593505933405_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXpZCGCDYRMQ7kNvwHeJuSb&_nc_oc=AdlvFOiRXTo4P9IiMrlwXi6qwSdZvFUQpUhEghj1gGDyWC0y2nFphLqlBvKh-MLjQkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvyEcNdlmzYDQvF52vndT21mnLTYQ6YBGWaSLUfVuveQ&oe=69B9460E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Train Simulator : Railway Driver", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1757011620, "lastRevision": {"nodes": [{"id": "24359394723722380", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application
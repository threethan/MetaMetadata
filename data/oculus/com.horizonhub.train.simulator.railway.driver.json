t=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvMmGKOMyMbYFhp8lyCyu5zUt95K0wKkImkW1Afc08SuQ&oe=69A81289"}, {"file_name": "Screenshot_2.png", "id": "4044861485826972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297237_4044861489160305_8630932379037916611_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPAKTWtFASAQ7kNvwFwJ7W1&_nc_oc=AdlP4iX6CN0vdDSOXfd_-1K9Rr9_IpgaOmsBDTMkUq8vhy5Lygd-NMAhVKOVCxM6fdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfskR3gtVKA7h2Bp0eS8fr2rPb3EACtbPh6zYT5rsIMFsg&oe=69A80D0E"}, {"file_name": "Screenshot_5.png", "id": "936427695355873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620451_936427698689206_3897576184422410072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B9yFVcBvXcQ7kNvwGsSH46&_nc_oc=Adl-D4C4hr5YSH61FqSvXC2Hpruvux67pABS9rw3lWHKVCO4isS8BRvx5-BIiIhHacw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvOnkVfMn9Tv-fT-S_SVDaC2JI3vhd3PDzuZlmRnp1Hyw&oe=69A80A2C"}, {"file_name": "Screenshot_1.png", "id": "1985607152196886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301397_1985607155530219_4267537579185757194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT2svLxJmEkQ7kNvwE0qmhz&_nc_oc=Adkj8Nb1Z9FcU92-fda_7IC6vJ8Mti3Is2GqdVWmq_WKOcpAtNlrt-NzbJB1283NH1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsKLlA2k-QYiuIkClAq7JGqrimN6Au3-TCfcf8mgiHTTQ&oe=69A8393D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Train Simulator : Railway Driver", "keywords": ["TrainSimulator", "TrainGame", "RailwayDriver", "TrainDrivingGame"], "long_description": "Step into the driver\u2019s seat and take control of powerful city trains in this immersive VR railway simulator.\nFollow signals, manage your speed, and transport passengers safely across detailed city routes. With realistic controls, lifelike environments, and true-to-life railway systems, every ride feels like the real thing.\nMaster different train models, stop precisely at stations, and prove your skills as a professional railway driver. Whether you\u2019re a beginner or a simulator enthusiast, this experience delivers the thrill of operating trains in virtual reality.\n\ud83d\ude86 Features:\nRealistic train driving physics and controls\nImmersive city environments and railway tracks\nPassenger pickup and drop-off challenges\nMultiple train models to drive\nDesigned for VR immersion on Meta Quest\nBecome the ultimate Railway Driver and experience the most authentic train simulator in VR.", "short_description": "Experience realistic city railway driving in this immersive train simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trainsimulator-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24404677405860778"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1635871480749053"}, {"status": "PUBLISHED", "id": "2301280413682330"}, {"status": "PUBLISHED", "id": "4069486133315245"}, {"status": "PUBLISHED", "id": "2626584101037158"}, {"status": "PUBLISHED", "id": "3154274918085311"}, {"status": "PUBLISHED", "id": "800192752490634"}, {"s
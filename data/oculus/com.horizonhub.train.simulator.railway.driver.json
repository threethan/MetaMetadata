kxIBQ&oe=6AC7C550"}, {"file_name": "Screenshot_4.png", "id": "966795459372893", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618515_966795462706226_612677622459311723_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EuyZLd19gsQ7kNvwFr3JBy&_nc_oc=AdobmlPqxo31xdYeeKu3P61Ohq8xSnlseKVf9UgmA2e-K10ohe80H7EniCoiu9OpoUU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2r3cNkjJXgEkYH-BLnUyYs1y9MY20Pva3KfGi17yEjA&oe=6AC7A66E"}, {"file_name": "Screenshot_3.png", "id": "2480171069078040", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499297259_2480171082411372_8817923375650711080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxm8GE--PKwQ7kNvwH5ND_Q&_nc_oc=AdrBFnvaK0hnNdhBGWLKqsuHnKZHiGPPS61nISJrim_-jIqbvjk8AwVAOiIhPLuxjEE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7e4xqBWcxUKEb-7c7R90QV3s5eLV_vrpifc3vA_JtMg&oe=6AC7B150"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Train Simulator : Railway Driver", "keywords": ["TrainSimulator", "TrainGame", "RailwayDriver", "TrainDrivingGame"], "long_description": "Step into the driver\u2019s seat \ud83d\ude86 and take control of powerful city trains in this immersive VR railway simulator. Experience the daily routine of a railway driver as you navigate detailed urban routes \ud83c\udf06, follow signals \ud83d\udea6, and manage speed to ensure smooth and safe journeys for your passengers \ud83d\udc65.\n\nOperate trains with realistic controls \ud83c\udfae that require attention, timing, and precision. Adjust acceleration, braking, and stopping distance carefully as you approach stations \ud83c\udfe2. Each route presents different challenges, encouraging you to stay focused and improve your driving skills over time \ud83c\udfaf.\n\nExplore immersive city environments \ud83c\udf07 with railway tracks, stations, and surrounding details designed to create a believable setting. Transport passengers from one stop to another \ud83d\ude89 while maintaining schedules \u23f1\ufe0f and ensuring consistent performance during each trip.\n\nPractice with multiple train models \ud83d\ude84, each offering a slightly different driving experience. Learn how to handle them effectively, refine your techniques, and improve your consistency across different routes and conditions.\n\n\u2728 Features:\n\ud83d\ude86 Realistic train driving controls and physics\n\ud83c\udf06 Detailed city environments and railway tracks\n\ud83d\ude89 Passenger pickup and drop-off challenges\n\ud83d\ude84 Multiple train models to operate\n\ud83c\udfae Smooth controls designed for VR interaction\n\ud83d\udea6 Signal-based navigation and speed management\n\nDesigned for VR immersion \ud83d\udd76\ufe0f, this simulator offers a structured and engaging railway driving experience.", "short_description": "Drive through detailed city railways \ud83d\ude86 in this immersive train simulator. Control speed, manage stops, and handle signals \ud83d\udea6 while navigating busy urban routes \ud83c\udf06. Experience smooth controls \ud83c\udfae, realistic train movement, and dynamic environments as you transport passengers safely. Improve your driving skills \ud83c\udfaf, follow schedules \u23f1\ufe0f, and enjoy a structured railway experience designed for steady progression and engaging gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trainsimulator-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
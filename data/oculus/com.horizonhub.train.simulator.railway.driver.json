i": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620451_936427698689206_3897576184422410072_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_otppHpe8IQ7kNvwEJdLsV&_nc_oc=Ado2kCpP97DJogD0dwd7mvEbKbLkzexJbV4X6ph6iOEHd1JkW1OaK2-3LQK9xvWJQ-Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2C85eU3wcZbihNLWadawsyH9-cOFE0Ft2yA7qazCc8g&oe=6AC7A96C"}, {"file_name": "Screenshot_1.png", "id": "1985607152196886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499301397_1985607155530219_4267537579185757194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9mg_MeT8AwQ7kNvwFzbFg4&_nc_oc=AdqOHw7Uu0sUWicFeZqEB8uXbPbbMPfsgSsVwcMYVkrqGKaNWAy9X1Mt4QrpZxVd3Yg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6iNo_Zrr3lWqV8-Acovt4ncHrcOazpRb_BxEzeNbxow&oe=6AC7A03D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Train Simulator : Railway Driver", "keywords": ["TrainSimulator", "TrainGame", "RailwayDriver", "TrainDrivingGame"], "long_description": "Step into the driver\u2019s seat and take control of powerful city trains in this immersive VR railway simulator.\nFollow signals, manage your speed, and transport passengers safely across detailed city routes. With realistic controls, lifelike environments, and true-to-life railway systems, every ride feels like the real thing.\nMaster different train models, stop precisely at stations, and prove your skills as a professional railway driver. Whether you\u2019re a beginner or a simulator enthusiast, this experience delivers the thrill of operating trains in virtual reality.\n\ud83d\ude86 Features:\nRealistic train driving physics and controls\nImmersive city environments and railway tracks\nPassenger pickup and drop-off challenges\nMultiple train models to drive\nDesigned for VR immersion on Meta Quest\nBecome the ultimate Railway Driver and experience the most authentic train simulator in VR.", "short_description": "Experience realistic city railway driving in this immersive train simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trainsimulator-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24404677405860778"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1077557321918287"}, {"status": "PUBLISHED", "id": "918468934647520"}, {"status": "PUBLISHED", "id": "1695962241483580"}, {"status": "PUBLISHED", "id": "2215455515972074"}, {"status": "PUBLISHED", "id": "1594852631602277"}, {"status": "PUBLISHED", "id": "25944763315202047"}, {"status": "CANCELLED", "id": "1641889493627963"}, {"status": "PUBLISHED", "id": "1635871480749053"}, {"status": "PUBLISHED", "id": "2301280413682330"}, {"status": "PUBLISHED", "id": "4069486133315245"}, {"status": "PUBLISHED", "id": "2626584101037158"}, {"status": "PUBLISHED", "id": "3154274918085311"}, {"status": "PUBLISHED", "id": "800192752490634"}, {"status": "PUBLISHED", "id": "24228008033487923"}]}, "baseline_offer": {"id": "1594852631602277"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1077557321918287"}]}, "liveChannel": {"nodes": [{"la
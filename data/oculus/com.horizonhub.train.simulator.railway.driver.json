g&oe=69F76F1C"}, {"file_name": "Screenshot_1.png", "id": "1497714224483277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619524_1497714227816610_6253105658809501486_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNq0fMMJa4oQ7kNvwFn3sDo&_nc_oc=AdoGTmDhlQq4ovQGk3hQVeUHnxttSFkR1gMEMINYxwKEeE8DH5eV3mTN-knEDP0GCQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SQ_a4CYIrsUwIPw4fmgrS3Q4ufG8wwdGUVug_Vkrpfw&oe=69F766A2"}, {"file_name": "Screenshot_5.png", "id": "1119210369615855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831393_1119210372949188_4805312957544639689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84pC6HkSapYQ7kNvwHsOTFE&_nc_oc=AdpFZXNAw_DMIysb_sJ7tBo301uK8_hsGlqdKMnCeblUwd02Na-WCymQEi1yiRB-jn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21mb08iQEmfmA5OwyIoEtfHEE9GZgeqYGmvrm-LFuNxg&oe=69F74E32"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Train Simulator : Railway Driver", "keywords": ["TrainSimulator", "TrainGame", "RailwayDriver", "TrainDrivingGame"], "long_description": "Step into the driver\u2019s seat and take control of powerful city trains in this immersive VR railway simulator.\nFollow signals, manage your speed, and transport passengers safely across detailed city routes. With realistic controls, lifelike environments, and true-to-life railway systems, every ride feels like the real thing.\nMaster different train models, stop precisely at stations, and prove your skills as a professional railway driver. Whether you\u2019re a beginner or a simulator enthusiast, this experience delivers the thrill of operating trains in virtual reality.\n\ud83d\ude86 Features:\nRealistic train driving physics and controls\nImmersive city environments and railway tracks\nPassenger pickup and drop-off challenges\nMultiple train models to drive\nDesigned for VR immersion on Meta Quest\nBecome the ultimate Railway Driver and experience the most authentic train simulator in VR.", "short_description": "Experience realistic city railway driving in this immersive train simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trainsimulator-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25457044030624105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_1091814382928786_3016540593505933405_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAsQosTZ5PQQ7kNvwF2tEE7&_nc_oc=AdqPcSMkX8fxrWHqlZ-yj4fbXxJnKm0eXryE-KkxYSRuKq9LMy2jrcPswGXLzpc9t08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SJ8YSuwbFQdsitU6B7zCoZPqfLKRYNNyaU89ITlzrMA&oe=69F73C8E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Train Simulator : Railway Driver", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1757011620, "lastRevision": {"nodes": [{"id": "24359394723722380", "release_type": "SCHEDULED", "administration_s
&oe=69EF4DDC"}, {"file_name": "Screenshot_1.png", "id": "1497714224483277", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619524_1497714227816610_6253105658809501486_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRBBcqu_V-oQ7kNvwGGRnNF&_nc_oc=Adq7XpoT_bJzLNNwgSpteonTdN98OHL7vLttV69i5criJmNpkQXt0IEZrKOyr_bzWLE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UnbFT9Gg2iunKBDfG8GglvMbuwu1bLaQPjX5HCjj4Yg&oe=69EF7DA2"}, {"file_name": "Screenshot_5.png", "id": "1119210369615855", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831393_1119210372949188_4805312957544639689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maDPApv-CsAQ7kNvwGSVr9R&_nc_oc=AdqHbMpgJk-B7CXcv3eUn0Txix7XWdHxlFI53OZas3jIG__h0JWftToo6YlTuHSQ9Q0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3S08feGHx8xNcvSqMa05FKdmVU3eydOYkOGlh-yoDY-g&oe=69EF6532"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Train Simulator : Railway Driver", "keywords": ["TrainSimulator", "TrainGame", "RailwayDriver", "TrainDrivingGame"], "long_description": "Step into the driver\u2019s seat and take control of powerful city trains in this immersive VR railway simulator.\nFollow signals, manage your speed, and transport passengers safely across detailed city routes. With realistic controls, lifelike environments, and true-to-life railway systems, every ride feels like the real thing.\nMaster different train models, stop precisely at stations, and prove your skills as a professional railway driver. Whether you\u2019re a beginner or a simulator enthusiast, this experience delivers the thrill of operating trains in virtual reality.\n\ud83d\ude86 Features:\nRealistic train driving physics and controls\nImmersive city environments and railway tracks\nPassenger pickup and drop-off challenges\nMultiple train models to drive\nDesigned for VR immersion on Meta Quest\nBecome the ultimate Railway Driver and experience the most authentic train simulator in VR.", "short_description": "Experience realistic city railway driving in this immersive train simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trainsimulator-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25457044030624105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618264_1091814382928786_3016540593505933405_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98YbMvkJcn0Q7kNvwFQXSWd&_nc_oc=AdomIJD6pixstfIypF8xpWnz4BDRujkrj15lXmNFw4fgoQr5R09Pga4HWJv04NqgqXw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01F1wK1s4OoM7bGXXI6vRU14S0V7WuGvQOLaqT23Kipg&oe=69EF538E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Train Simulator : Railway Driver", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1757011620, "lastRevision": {"nodes": [{"id": "24359394723722380", "release_type": "SCHEDULED", "administration_st
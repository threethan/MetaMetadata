9_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbsrkLLSuZ0Q7kNvwGwZxup&_nc_oc=AdlSgD8eAlXDxYLQZRMxU9m0ut0lWj0fqXR93hAB6ncOcmZUG9Ccl-IILFnuBCcSqH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyecLElC5YHIrk1Z0YISdZpCFNiJ2c8vac4EFWp00ta8Q&oe=69B96131"}, "display_name": "Monkey Runners", "keywords": [], "long_description": "In this VR game, you get to take on the role monkey, and play with other monkeys, you can buy hats and items in the shop or run from the monster in horror, or even climb to the top of parkour for a reward, log on every day to receive your free 100 oranges. ", "short_description": "A fun social game where you run around and swing on vines with other monkeys"}]}, "developer_name": "SharkVR", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-runners/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SharkVR", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCOJiQEAY0I2eB3r1aIZH0Jw", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1315540665836110"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035330_283534520930295_2321513519071044594_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP6ILFrj7a0Q7kNvwGxBCXq&_nc_oc=AdkMLAkWc72PuUhl5fxBy9qFuN7Roy6rF1IykjIgcVj6JKaoAt84fQRnzNiL1K6O1ao&_nc_zt=3&_nc_ht=
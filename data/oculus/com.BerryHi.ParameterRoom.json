nzY9x3v0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z86pOyMZxr6an5UzZ4-XWKs2N3qd9KKhWTo9TJ97YGA&oe=6A451EAB"}, {"file_name": "ingame5.png", "id": "2005053430059779", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618284_2005053433393112_6190407981189298886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rycFENAe1ywQ7kNvwGXuEpD&_nc_oc=AdroXCKuVegbfEGSfAi0i3KzLqDgYIrh2s1ueG5bSAD6lG8tTpXuEK3sBBiw0u-AQFE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YcF1sgZ-c9iK-WDr9o_oG5UwxRJ7L3mS_r7o16kcQ5Q&oe=6A451B7B"}, {"file_name": "ingame1.png", "id": "794333413474747", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618440_794333416808080_5724071060507227845_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR9j0BfvbuYQ7kNvwHFw6p0&_nc_oc=AdrKSRIWIj58HDYIGKSmZRCJsEomEwBY251PFKcrhPD7Hd5jk40hushUNKWcoQb0DVQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hy8z4SoLU0JaTDB2wM1BU9JvvBpkcUdjYE0zhXGtzLQ&oe=6A453247"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maincover1_revised.png", "id": "4182678325319122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623370_4182678328652455_8097312879023856265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9UG8j3khu8Q7kNvwHtmKVB&_nc_oc=Adr9MuZa9Mak_4E_5fyUWHoe7PQefnVt4OenLumv1FjtCfCV96LfIgM9uYB7sQKply8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QiM4ULBo9O64pma3gOc-q52MlF0xEynfTARDp-KXSrw&oe=6A4530DD"}, "display_name": "ParameterRoom", "keywords": ["MixedReality", "VirtualReality", "SocialPlatform", "RoomSharing", "MakingFriend"], "long_description": "\n\n# ParameterRoom: XR Social Platform Based on Real Space\n\nParameterRoom is built on **BerryHi\u2019s 'Real-Space Fusion Technology,'** offering a new social experience that clearly differentiates it from existing VR platforms.\n\n{1160966002805324}\n---\n\n## \u2728 Key Features\n\n### 1. Virtualization of Real Space\n* **Automatic Room Creation:** Scans your actual room and instantly converts it into a virtual room. Experience a vivid sense of presence, as if others are right there in your space.\n\n### 2. Connecting Space-to-Space\n* **Organic Arrangement:** Multiple user rooms are arranged and combined to create a single XR social space.\n* **Novel Social Experience:** The **'Connection of Rooms'** itself acts as the unit of interaction, allowing seamless connection across physical barriers.\n\n### 3. Sharing and Expression\n* **Share Room Photos:** Snap and share photos of your actual room with other users to exchange glimpses of daily life.\n\n---\n\n## \ud83d\udca1 Why ParameterRoom?\n* **Differentiation:** Provides both reality-based connection and immersive presence simultaneously.\n* **Market Leader:** Poised to lead the next-generation XR social market during the early adoption of high-performance MR HMDs.\n\n### \ud83d\udce2 Coming Soon!\nLook forward to more engaging social experiences! Easily **customize your room with diverse assets** to show off your personality, and use **private room creation and search** features to meet **more privately** with friends.\n\n**\ud83d\udc49 Transform your room into the new Social Universe today!**\n", "short_description": "Beyond VR: Your actual space becomes the new social universe. The next-generation XR community platform, powered by BerryHi\u2019s innovative \u2018Real-Space Fusion Technology.\u2019"}]}, "developer_name": "BerryHi Inc.", "developer_privacy_policy_url": "https://www.berryhi.com/group/parameter-room-announcements/discussion/f2981197-a492-41c0-8c25-b0bdb179d754", "developer_terms_of_service_url": null, "publisher_name": "BerryHi Inc.", "support_website_url": null, "website_url": "https://www.berryhi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24634761606226887"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1322251219592379"}]}, "baseline_offer": {"id": "1322251219592379"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762242540, "status": "PUBLISHED", "id": "1322251219592379"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24732301959806184", "version": "0.1.8"}, "id": "695204420268532", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022141334169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24732301959806184"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "695204420268532"}]}, "change_log": "Mixed Reality Camera Updates: Captured images now properly respect space dividing lines. Images now auto-delete after 20 seconds.", "created_date": 1765357445, "id": "24971245845911793", "version": "0.1.10", "version_code": 6, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022
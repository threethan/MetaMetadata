g4ykMOE0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VxvJUojKu_KXY30XLF6_jTYhl8KelYfOYV6olmocqpQ&oe=69D50F2B"}, {"file_name": "ingame5.png", "id": "2005053430059779", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_2005053433393112_6190407981189298886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB50OwOe0MQQ7kNvwHv2gq1&_nc_oc=AdogB-gSBXyixC8TzDavi_D3GlGtA6zim9PolRu9aQTFibcENY-n6Zg-mITe57-Wd0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gINckDa4UvPfLjEI6Rm8-X44f3DfY0E0V2TSKnpIv_w&oe=69D50BFB"}, {"file_name": "ingame1.png", "id": "794333413474747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618440_794333416808080_5724071060507227845_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gdjo7xHicUkQ7kNvwE1hz19&_nc_oc=AdpksBeAu3DqeggR9cQD00D9IPTVCUauvxxVE6yX1wwt4HLuMuOx_NawEy3Xn4uALqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KDc56kz18wB8_CFi9Xpy7v2f3LhjpZB1zORnh-CoibQ&oe=69D4EA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maincover1_revised.png", "id": "4182678325319122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623370_4182678328652455_8097312879023856265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pQfGe-N1KkQ7kNvwElSXWi&_nc_oc=AdrYPY8yMgKvsiGO3-ZqDHUcKNRVaBkWSWrOEIR4cclJZu65EXVSpQeUFuOPPS4uGSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RGmcfYJlM-_bFzgECkSznLdPokL1a7ReksfAoCbBsFQ&oe=69D4E91D"}, "display_name": "ParameterRoom", "keywords": ["MixedReality", "VirtualReality", "SocialPlatform", "RoomSharing", "MakingFriend"], "long_description": "\n\n# ParameterRoom: XR Social Platform Based on Real Space\n\nParameterRoom is built on **BerryHi\u2019s 'Real-Space Fusion Technology,'** offering a new social experience that clearly differentiates it from existing VR platforms.\n\n{1160966002805324}\n---\n\n## \u2728 Key Features\n\n### 1. Virtualization of Real Space\n* **Automatic Room Creation:** Scans your actual room and instantly converts it into a virtual room. Experience a vivid sense of presence, as if others are right there in your space.\n\n### 2. Connecting Space-to-Space\n* **Organic Arrangement:** Multiple user rooms are arranged and combined to create a single XR social space.\n* **Novel Social Experience:** The **'Connection of Rooms'** itself acts as the unit of interaction, allowing seamless connection across physical barriers.\n\n### 3. Sharing and Expression\n* **Share Room Photos:** Snap and share photos of your actual room with other users to exchange glimpses of daily life.\n\n---\n\n## \ud83d\udca1 Why ParameterRoom?\n* **Differentiation:** Provides both reality-based connection and immersive presence simultaneously.\n* **Market Leader:** Poised to lead the next-generation XR social market during the early adoption of high-performance MR HMDs.\n\n### \ud83d\udce2 Coming Soon!\nLook forward to more engaging social experiences! Easily **customize your room with diverse assets** to show off your personality, and use **private room creation and search** features to meet **more privately** with friends.\n\n**\ud83d\udc49 Transform your room into the new Social Universe today!**\n", "short_description": "Beyond VR: Your actual space becomes the new social universe. The next-generation XR community platform, powered by BerryHi\u2019s innovative \u2018Real-Space Fusion Technology.\u2019"}]}, "developer_name": "BerryHi Inc.", "developer_privacy_policy_url": "https://www.berryhi.com/group/parameter-room-announcements/discussion/f2981197-a492-41c0-8c25-b0bdb179d754", "developer_terms_of_service_url": null, "publisher_name": "BerryHi Inc.", "support_website_url": null, "website_url": "https://www.berryhi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24634761606226887"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1322251219592379"}]}, "baseline_offer": {"id": "1322251219592379"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762242540, "status": "PUBLISHED", "id": "1322251219592379"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24732301959806184", "version": "0.1.8"}, "id": "695204420268532", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022141334169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24732301959806184"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "695204420268532"}]}, "change_log": "Mixed Reality Camera Updates: Captured images now properly respect space dividing lines. Images now auto-delete after 20 seconds.", "created_date": 1765357445, "id": "24971245845911793", "version": "0.1.10", "version_code": 6, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022
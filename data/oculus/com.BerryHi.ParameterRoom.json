ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JhXYtu48DoQ7kNvwHj8vpu&_nc_oc=AdqOhIrMvC91bMBezCH8Xwx-sz9n8Feok-Tu_syurgWIM5VM9iC-_g8XibYCr5Jsnoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ54i_mvsJdMfxUBFt8BF7Qjzm8IFVay3VmhURBkZ-3g&oe=6AF5C7AB"}, {"file_name": "ingame5.png", "id": "2005053430059779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618284_2005053433393112_6190407981189298886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJl7ZllLYzcQ7kNvwEfK1oF&_nc_oc=Adr3sF7JHTUTZLZ5KxfVkjntSfe6ref_1_3htwbvJ_Eeez_MgUbjbzgDJG5uU1QfVmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3yW2ruqG2WaUyMgUPA_b1Ips75ziutnYrtuvbh-dMAQ&oe=6AF5C47B"}, {"file_name": "ingame1.png", "id": "794333413474747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_794333416808080_5724071060507227845_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKUfzmwyLR0Q7kNvwFm-uh8&_nc_oc=AdqtglertPiVT2rqz3vZDkiOUungfjQZ6fDbJthKt0SmjrFdNcuxWPEJTRzcD7J4KZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtoizn4ytkEWe06ciWKMXpLU3rjoMvLZEt5H5NClN69g&oe=6AF5DB47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maincover1_revised.png", "id": "4182678325319122", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623370_4182678328652455_8097312879023856265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_I51MPS1tcQ7kNvwGFsSr7&_nc_oc=AdrVwMcEPctqOwWO4FBOR7Gfa-hVqVPTiJ2q3U0enqHDG55b-yY4mJZst-gP4Jv2Jp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbFI-vqs5pGAc0FkXVsFJ5Rp9s9mMZcf5_9D_SwKoYwA&oe=6AF5D9DD"}, "display_name": "ParameterRoom", "keywords": ["MixedReality", "VirtualReality", "SocialPlatform", "RoomSharing", "MakingFriend"], "long_description": "\n\n# ParameterRoom: XR Social Platform Based on Real Space\n\nParameterRoom is built on **BerryHi\u2019s 'Real-Space Fusion Technology,'** offering a new social experience that clearly differentiates it from existing VR platforms.\n\n{1160966002805324}\n---\n\n## \u2728 Key Features\n\n### 1. Virtualization of Real Space\n* **Automatic Room Creation:** Scans your actual room and instantly converts it into a virtual room. Experience a vivid sense of presence, as if others are right there in your space.\n\n### 2. Connecting Space-to-Space\n* **Organic Arrangement:** Multiple user rooms are arranged and combined to create a single XR social space.\n* **Novel Social Experience:** The **'Connection of Rooms'** itself acts as the unit of interaction, allowing seamless connection across physical barriers.\n\n### 3. Sharing and Expression\n* **Share Room Photos:** Snap and share photos of your actual room with other users to exchange glimpses of daily life.\n\n---\n\n## \ud83d\udca1 Why ParameterRoom?\n* **Differentiation:** Provides both reality-based connection and immersive presence simultaneously.\n* **Market Leader:** Poised to lead the next-generation XR social market during the early adoption of high-performance MR HMDs.\n\n### \ud83d\udce2 Coming Soon!\nLook forward to more engaging social experiences! Easily **customize your room with diverse assets** to show off your personality, and use **private room creation and search** features to meet **more privately** with friends.\n\n**\ud83d\udc49 Transform your room into the new Social Universe today!**\n", "short_description": "Beyond VR: Your actual space becomes the new social universe. The next-generation XR community platform, powered by BerryHi\u2019s innovative \u2018Real-Space Fusion Technology.\u2019"}]}, "developer_name": "BerryHi Inc.", "developer_privacy_policy_url": "https://www.berryhi.com/group/parameter-room-announcements/discussion/f2981197-a492-41c0-8c25-b0bdb179d754", "developer_terms_of_service_url": null, "publisher_name": "BerryHi Inc.", "support_website_url": null, "website_url": "https://www.berryhi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_cat
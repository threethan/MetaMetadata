sid=6e7a0a&_nc_ohc=RrtXfzWQfO8Q7kNvwFx5NWT&_nc_oc=AdqoPwn9c3okQoXK1OgDtkCq7-JHiaFBI_6Y0gty0WL5jdQPIC3SDLjDWFT4nr62mxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgm_5ApjULB87nTlhs2nT19MSuiaq41ZeC2FA9OybjKw&oe=6B105895"}, {"file_name": "ingame4.png", "id": "1879124242997469", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617729_1879124246330802_7661374814674841120_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqTbMFycLeAQ7kNvwFkuTWK&_nc_oc=AdpAiMiQpvL84BNACS-fS0TBMIr6ec3KW9ULCP-DIlevJ-bUJP-KaljXN6r1A6UVlF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_VL1btzKMMgfv4CwAVkm-uWcZjE_-Y5PFqaaFLcuJgQ&oe=6B105DEB"}, {"file_name": "ingame5.png", "id": "2005053430059779", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_2005053433393112_6190407981189298886_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIrHlvP6ctAQ7kNvwF3HYuu&_nc_oc=AdqKdjbvgBUZNCFbiYk3SwW4vQJ4lphLEHdfiVbqzQoPN1PI7qJQtHURRQmGmCBD2w0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYWelZ4oBOrQ5RX3JqYNEdm1fmF_6dJSex7DwJtd7H2g&oe=6B105ABB"}, {"file_name": "ingame1.png", "id": "794333413474747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618440_794333416808080_5724071060507227845_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niYM1fqauI4Q7kNvwGFbmiG&_nc_oc=Adrhndg3AO5IMGK2EPLorlyJvL9dUAmdp7eaACxFlpLALblIGTkJJ8SfD_QcPhS2RFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhGZeYUWBnq1_beuUyNDpprSAabd_IUxqiCqj8LW69Zw&oe=6B103947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maincover1_revised.png", "id": "4182678325319122", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623370_4182678328652455_8097312879023856265_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTvxBl_0qAUQ7kNvwFFOFrl&_nc_oc=AdpHZxY7wDh7D2_tg-9TFAhywBgBZR1sy3eIs7dsA4p0IssdDMtcRdQzEOrowDvMhlk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoV5K2LEPXbNMYH6a9EVJ8WzbDtItuj3zaqqYpkW7zbw&oe=6B1037DD"}, "display_name": "ParameterRoom", "keywords": ["MixedReality", "VirtualReality", "SocialPlatform", "RoomSharing", "MakingFriend"], "long_description": "\n\n# ParameterRoom: XR Social Platform Based on Real Space\n\nParameterRoom is built on **BerryHi\u2019s 'Real-Space Fusion Technology,'** offering a new social experience that clearly differentiates it from existing VR platforms.\n\n{1160966002805324}\n---\n\n## \u2728 Key Features\n\n### 1. Virtualization of Real Space\n* **Automatic Room Creation:** Scans your actual room and instantly converts it into a virtual room. Experience a vivid sense of presence, as if others are right there in your space.\n\n### 2. Connecting Space-to-Space\n* **Organic Arrangement:** Multiple user rooms are arranged and combined to create a single XR social space.\n* **Novel Social Experience:** The **'Connection of Rooms'** itself acts as the unit of interaction, allowing seamless connection across physical barriers.\n\n### 3. Sharing and Expression\n* **Share Room Photos:** Snap and share photos of your actual room with other users to exchange glimpses of daily life.\n\n---\n\n## \ud83d\udca1 Why ParameterRoom?\n* **Differentiation:** Provides both reality-based connection and immersive presence simultaneously.\n* **Market Leader:** Poised to lead the next-generation XR social market during the early adoption of high-performance MR HMDs.\n\n### \ud83d\udce2 Coming Soon!\nLook forward to more engaging social experiences! Easily **customize your room with diverse assets** to show off your personality, and use **private room creation and search** features to meet **more privately** with friends.\n\n**\ud83d\udc49 Transform your room into the new Social Universe today!**\n", "short_description": "Beyond VR: Your actual space becomes the new social universe. The next-generation XR community platform, powered by BerryHi\u2019s innovative \u2018Real-Space Fusion Technology.\u2019"}]}, "developer_name": "BerryHi Inc.", "developer_privacy_policy_url": "https://www.berryhi.com/group/parameter-room-announcements/discussion/f2981197-a492-41c0-8c25-b0bdb179d754", "developer_terms_of_service_url": null, "publisher_name": "BerryHi Inc.", "support_website_url": null, "website_url": "https://www.berryhi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24634761606226887"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24732301959806184", "version": "0.1.8"}, "id": "695204420268532", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022141334169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24732301959806184"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "695204420268532"}]}, "change_log": "Mixed Reality Camera Updates: Captured images now properly respect space dividing lines. Images now auto-delete after 20 seconds.", "created_date": 1765357445, "id": "24971245845911793", "version": "0.1.10", "version_code": 6, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022141334169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24732301959806184"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "695204420268532"}]}, "change_log": "Mixed Reality Camera Updates: Captured images now properly respect space dividing lines. Images now auto-delete after 20 seconds. ", "created_date": 1764748046, "id": "24913719268331118", "version": "0.1.9", "version_code": 5, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022141334169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24732301959806184"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "695204420268532"}]}, "change_log": "This build includes the Single Mode Hive.\nSingle Mode Hive (Demo): This mode allows users to experience the space integration demonstration without any real participants.", "created_date": 1762835711, "id": "24732301959806184", "version": "0.1.8", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022141334169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24732301959806184"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "695204420268532"}]}, "change_log": "This build includes the core user flow and main features required for launch:\n\n- Multiplayer Core: Lobby, room creation, and joining (via Photon Fusion).\n\n- Meta Space (Scene) Integration: The core experience requires users to scan and use their Meta Space data (Scene API), allowing them to share a virtual representation of their physical room.\n\n- Mixed Reality (MR) Features:\n\n-- A hand-activated UI (the \"Hive\" menu) allows users to toggle a private Mixed Reality (Passthrough) Mode.\n\n-- A unique \"Mixed Reality Camera\" feature enables users to capture their real-world view and share it as a static image with others in the session.\n\n- Synchronized Exit: A \"Ready to Leave\" system ensures all users in a session agree before returning to the lobby.\n\n- User Reporting Functionality (VRC.Content.3 Compliance): A user reporting system has been integrated, allowing users to notify the developer about conduct that violates the Code of Conduct for Virtual Experiences. This form is accessible from in-app actions.\n\n- User Stuck (VRC.Quest.Functional.3): The system now performs more robust checks on space data status and provides users with real-time status information through a loading screen within the Hive scene.", "created_date": 1761921691, "id": "24634689662900748", "version": "0.1.6", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24417022141334169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24732301959806184"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "695204420268532"}]}, "change_log": "Early Access (Build v0.1.0)\n\n\n\nThis build includes the core user flow and main features required for launch:\n\n- Multiplayer Core: Lobby, room creation, and joining (via Photon Fusion).\n\n- Meta Space (Scene) Integration: The core experience requires users to scan and use their Meta Space data (Scene API), allowing them to share a virtual representation of their physical room.\n\n- Mixed Reality (MR) Features: \n\n-- A hand-activated UI (the \"Hive\" menu) allows users to toggle a private Mixed Reality (Passthrough) Mode.\n\n-- A unique \"Mixed Reality Camera\" feature enables users to capture their real-world view and share it as a static image with others in the session.\n\n- Synchronized Exit: A \"Ready to Leave\" system ensures all users in a session agree before returning to the lobby.\n\n- User Reporting Functionality (VRC.Content.3 Compliance): A user reporting system has been integrated, allowing users to notify the developer about conduct that violates the Code of Conduct for Virtual Experiences. This form is accessible from in-app actions.", "created_date": 1761754377, "id": "24617362487966799", "version": "0.1.5", "version_code": 2, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
e7a0a&_nc_ohc=EMJWNl-0soYQ7kNvwH6myNW&_nc_oc=Adl5iHYb5XC-hHgku_tR3eLXMsKqcvlnH7C05cELUfuTSd4VxyuYXJPjBfU13qJuo1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv5zishg6hhiHdwMT3xDsjFGUHQndUc6jo8STJMZ0welg&oe=69A83C2B"}, {"file_name": "ingame5.png", "id": "2005053430059779", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618284_2005053433393112_6190407981189298886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ykyAwzQrnkQ7kNvwHA5OOw&_nc_oc=AdkleIigjh-IP8ELjwImuayzGyY-vbRh1u4TiflaAQI5Y3HTBAqngs07b5epqQ1mSYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfseY2mJX62w2DS2SRqj23f0arpafKFA69Asuzxxue-mDQ&oe=69A838FB"}, {"file_name": "ingame1.png", "id": "794333413474747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618440_794333416808080_5724071060507227845_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-cIcoa3OhUQ7kNvwH48Bmb&_nc_oc=AdkT3Cs09nQ0ZIs3CF3TShfbSMX0VxzO6fhsInq_NiK1tTZkWeRRYTJk3gn6HYwbZow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCylKODrEGWxrF4ZjUujq5IFzDQlWv8lBnNl-tjqeNAQ&oe=69A81787"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maincover1_revised.png", "id": "4182678325319122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623370_4182678328652455_8097312879023856265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bogvzs1AMkcQ7kNvwEZlO7d&_nc_oc=AdlzbEM64H2BW_xEMK9QpXdwd8WOd2ZwFsTx_kJywvQItH-nycOYdVl0RY28s88VtTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsjl4W-3LUzd5XvYPa-Saald5WrUXtaBxf5ii6Q7rMOqA&oe=69A8161D"}, "display_name": "ParameterRoom", "keywords": ["MixedReality", "VirtualReality", "SocialPlatform", "RoomSharing", "MakingFriend"], "long_description": "\n\n# ParameterRoom: XR Social Platform Based on Real Space\n\nParameterRoom is built on **BerryHi\u2019s 'Real-Space Fusion Technology,'** offering a new social experience that clearly differentiates it from existing VR platforms.\n\n{1160966002805324}\n---\n\n## \u2728 Key Features\n\n### 1. Virtualization of Real Space\n* **Automatic Room Creation:** Scans your actual room and instantly converts it into a virtual room. Experience a vivid sense of presence, as if others are right there in your space.\n\n### 2. Connecting Space-to-Space\n* **Organic Arrangement:** Multiple user rooms are arranged and combined to create a single XR social space.\n* **Novel Social Experience:** The **'Connection of Rooms'** itself acts as the unit of interaction, allowing seamless connection across physical barriers.\n\n### 3. Sharing and Expression\n* **Share Room Photos:** Snap and share photos of your actual room with other users to exchange glimpses of daily life.\n\n---\n\n## \ud83d\udca1 Why ParameterRoom?\n* **Differentiation:** Provides both reality-based connection and immersive presence simultaneously.\n* **Market Leader:** Poised to lead the next-generation XR social market during the early adoption of high-performance MR HMDs.\n\n### \ud83d\udce2 Coming Soon!\nLook forward to more engaging social experiences! Easily **customize your room with diverse assets** to show off your personality, and use **private room creation and search** features to meet **more privately** with friends.\n\n**\ud83d\udc49 Transform your room into the new Social Universe today!**\n", "short_description": "Beyond VR: Your actual space becomes the new social universe. The next-generation XR community platform, powered by BerryHi\u2019s innovative \u2018Real-Space Fusion Technology.\u2019"}]}, "developer_name": "BerryHi Inc.", "developer_privacy_policy_url": "https://www.berryhi.com/group/parameter-room-announcements/discussion/f2981197-a492-41c0-8c25-b0bdb179d754", "developer_terms_of_service_url": null, "publisher_name": "BerryHi Inc.", "support_website_url": null, "website_url": "https://www.berryhi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_categ
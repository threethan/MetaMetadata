e7a0a&_nc_ohc=Y1xrPh3wNuUQ7kNvwEl8A5p&_nc_oc=Adl-WEhWB_sJtRuoUgGe3AmSsAY5aeGPXOPkHM8LMBhryUdasmUDxjScpFJ8LvjGtOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwI4mFanofTv-0FgA7prueFrkGGaz8UNbGvOJYG6gWZMA&oe=69B6BCAB"}, {"file_name": "ingame5.png", "id": "2005053430059779", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_2005053433393112_6190407981189298886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2dgZHBGYfwQ7kNvwFO3joN&_nc_oc=Adncqz8cY-HlejoJBdamqNWXG9EDiAmWdRC6aHwQs3WigaJwWmvK61b9WcK9dNaafUE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFUDmzSMZTq3qygzuQzpo-Uyv5iIkwKZ1Bm9EpclxtHQ&oe=69B6B97B"}, {"file_name": "ingame1.png", "id": "794333413474747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618440_794333416808080_5724071060507227845_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LFJD_ZcEPoQ7kNvwEJElHy&_nc_oc=AdlCbFPFemJJJOTGJ5AXxnPZcWtBxl-McxWDcG1F3kFmqi6fNuVXGWMDYGV9DAuAnns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzn8Sz5kUqdAHB_m4ZUgvKQUWoe2Ygujplk5JDftXfk8g&oe=69B69807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maincover1_revised.png", "id": "4182678325319122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_4182678328652455_8097312879023856265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dflxb4qV35YQ7kNvwFnWo_M&_nc_oc=AdlN2H52jBlSOlTg_plB7Ragyw9vC_osGoJrveSZn9VBrdlWuci1_I_EEdZM5OYhpp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZYS2IM-qqNf4VhmExCVv5USBGiu2-0i8FXfSHqPGKtQ&oe=69B6969D"}, "display_name": "ParameterRoom", "keywords": ["MixedReality", "VirtualReality", "SocialPlatform", "RoomSharing", "MakingFriend"], "long_description": "\n\n# ParameterRoom: XR Social Platform Based on Real Space\n\nParameterRoom is built on **BerryHi\u2019s 'Real-Space Fusion Technology,'** offering a new social experience that clearly differentiates it from existing VR platforms.\n\n{1160966002805324}\n---\n\n## \u2728 Key Features\n\n### 1. Virtualization of Real Space\n* **Automatic Room Creation:** Scans your actual room and instantly converts it into a virtual room. Experience a vivid sense of presence, as if others are right there in your space.\n\n### 2. Connecting Space-to-Space\n* **Organic Arrangement:** Multiple user rooms are arranged and combined to create a single XR social space.\n* **Novel Social Experience:** The **'Connection of Rooms'** itself acts as the unit of interaction, allowing seamless connection across physical barriers.\n\n### 3. Sharing and Expression\n* **Share Room Photos:** Snap and share photos of your actual room with other users to exchange glimpses of daily life.\n\n---\n\n## \ud83d\udca1 Why ParameterRoom?\n* **Differentiation:** Provides both reality-based connection and immersive presence simultaneously.\n* **Market Leader:** Poised to lead the next-generation XR social market during the early adoption of high-performance MR HMDs.\n\n### \ud83d\udce2 Coming Soon!\nLook forward to more engaging social experiences! Easily **customize your room with diverse assets** to show off your personality, and use **private room creation and search** features to meet **more privately** with friends.\n\n**\ud83d\udc49 Transform your room into the new Social Universe today!**\n", "short_description": "Beyond VR: Your actual space becomes the new social universe. The next-generation XR community platform, powered by BerryHi\u2019s innovative \u2018Real-Space Fusion Technology.\u2019"}]}, "developer_name": "BerryHi Inc.", "developer_privacy_policy_url": "https://www.berryhi.com/group/parameter-room-announcements/discussion/f2981197-a492-41c0-8c25-b0bdb179d754", "developer_terms_of_service_url": null, "publisher_name": "BerryHi Inc.", "support_website_url": null, "website_url": "https://www.berryhi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_categ
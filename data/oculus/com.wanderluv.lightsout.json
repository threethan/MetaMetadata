_oc=AdpZKeZ4EJ7GsgKnZTI137yQ7Vm2QJ_Wx8nEkESpZGgYVR_UklTlijv32oLAPLH6kTk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr632l2KgVbRADNphEUZcX7Ax-DAjMGpX3Vz52QynykQ&oe=6B0305C8"}, {"file_name": "shot-2.png", "id": "1116050354402362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604375581_1116050357735695_4957585897587697314_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNrYsH2zQpQQ7kNvwFM3ObB&_nc_oc=Adpcgq0b-zoh0kbm3mydk3k95FWsobxXvGagozT5p2RCMo8kMWKgA7IxygrTANfWZI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaHZenxNEeA715_bUQbSPi1W442oYlZXaJ_0zSNkWqDw&oe=6B03208A"}, {"file_name": "shot-1.png", "id": "1122869706767226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596168449_1122869710100559_8109717014040361792_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhn2JAW64QkQ7kNvwHBjBlW&_nc_oc=AdoypJrwkod_m3UowGzmNFNbcGSfNOY-BFZdgqw-WizTTVPq4D-x4fMZCSi-LKvGzsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlNDenNaqjyI5f9t-6vZqJl9jCPlLLaZbPm2Pow83DNA&oe=6B03111E"}, {"file_name": "shot-4.png", "id": "1463787502523067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831964_1463787505856400_8940136862232582818_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT5n3zqr5wEQ7kNvwHPyoB4&_nc_oc=AdquR6w0BXfzmDSaMP6JepWZBXiQGJcpjcwo6BnvozyZMASlNwo4jyYGY2BJzSDkbrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUZpggBWVFZIJ4fWVW-pzwRXb8Z_lDCRc7Meb6yg-D8A&oe=6B030D87"}, {"file_name": "shot-3.png", "id": "39454389577539842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831964_39454389597539840_7360521218255814477_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLWAREe9H08Q7kNvwGQnyLv&_nc_oc=AdrW2wPxPbHyUXwY3Zi8pzJq5-hk1FuNIzJkY4A1g5GUDWaFeOhglsGVQ3l9jevZyr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4BtNwElknbSQapbCFGVCMoHVDKyWEjr-iYDYJBjo-6g&oe=6B03225A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lights Out", "keywords": ["horror", "survival", "multiplayer", "coop"], "long_description": "The lights are out and something is hunting you.\n\nLights Out is a round-based co-op survival horror game. Work with up to 8 players to restore power at terminals scattered around a dark facility. Every terminal you hack cuts time off the clock. When it hits zero the exit opens, and anyone who doesn't reach it in time doesn't make it out.\n\nFEATURES\n- A different monster hunts you each round, from towering stilt-limbed giants to statues that only move when unseen. Learn what each one senses, then juke it, hide from it or stun it.\n- Seven terminal puzzles. Fail one and the alarm gives you away.\n- Four maps, including procedurally generated catacombs, warehouses and hospital wings, plus six game modes and four difficulty levels.\n- Caught players have 30 seconds to be revived. Power-ups like EMP charges, shields and noise makers help the team.\n- Proximity voice chat. Your voice is also noise the monster can hear.\n- Built for VR: grab-and-climb movement, jumping, smooth or snap turning, a comfort vignette, seated height offset and reduced flashing options.\n- Host a room and share a four-letter code, or join a friend's. No account needed.\n\nContains horror themes, sudden jump scares and flashing lights.", "short_description": "Survive the monster. Restore the power. Don't leave anyone behind. A co-op horror game for you and your friends: hack terminals, dodge a relentless creature, revive downed teammates and escape the facility before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://survive-the-bear.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TezJr", "support_website_url": null, "website_url": "https://survive-the-bear.vercel.app/", "category": null, "comfort_rating": "COM
_oc=AdrX4Je_vd0sqV2rlWevSJPBjc-LyHIYSQYjFew5Ht_RRiqMt3TuswDXCN-t7rbYpkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROR9Zv1EAnbO_i73llVQ4RQfKMz0YevoGd3IpQfPx8uw&oe=6B01EC88"}, {"file_name": "shot-2.png", "id": "1116050354402362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604375581_1116050357735695_4957585897587697314_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNrYsH2zQpQQ7kNvwGM8x9B&_nc_oc=Adq7pU_rLKaLr2oFkIKmW-m_TftQ8Pk7MKkCnl88gcxqsTXYS4mt9b3EjWdMG2GG7rQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnIFcvYoLUuq91TN0Ij1pfB4TLx7vFqzcEElGM_hYScw&oe=6B01CF0A"}, {"file_name": "shot-1.png", "id": "1122869706767226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_1122869710100559_8109717014040361792_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2FRAOtjKtgQ7kNvwHrjDIc&_nc_oc=AdoFnZRm3hFGCuITMhfgwVMJeDZ4-WbSaQVE9AHa4ONHhM5HzYdh-kZ9qSSyiBxNmso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwAgL8J_NRAvAO-4JbDxYRBksrQvSATeGxsaqH_qZI-g&oe=6B01BF9E"}, {"file_name": "shot-4.png", "id": "1463787502523067", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_1463787505856400_8940136862232582818_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT5n3zqr5wEQ7kNvwFhpL6C&_nc_oc=Ado7foEI01OB9BnqdKo0ADj5QGygki6YYQLtJksxJK-07-n80U8hBZjfTfDapODT9pw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHUIvOwbuKtfgv4K2RA7xjvx54Mjy1zKHoq2C2P2AUrw&oe=6B01BC07"}, {"file_name": "shot-3.png", "id": "39454389577539842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831964_39454389597539840_7360521218255814477_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLWAREe9H08Q7kNvwFBih-b&_nc_oc=AdoF7nB5iP4FxPPO68QEX6_YUjylv4paJ5OyM9T9Bgyw-2xD_SNrs27J8zIV7M6NQQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhZYjQf95-w4yegz2KMALecsaKCrZKH7vtd-x5mkvd5w&oe=6B01D0DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lights Out", "keywords": ["horror", "survival", "multiplayer", "coop"], "long_description": "The lights are out and something is hunting you.\n\nLights Out is a round-based co-op survival horror game. Work with up to 8 players to restore power at terminals scattered around a dark facility. Every terminal you hack cuts time off the clock. When it hits zero the exit opens, and anyone who doesn't reach it in time doesn't make it out.\n\nFEATURES\n- A different monster hunts you each round, from towering stilt-limbed giants to statues that only move when unseen. Learn what each one senses, then juke it, hide from it or stun it.\n- Seven terminal puzzles. Fail one and the alarm gives you away.\n- Four maps, including procedurally generated catacombs, warehouses and hospital wings, plus six game modes and four difficulty levels.\n- Caught players have 30 seconds to be revived. Power-ups like EMP charges, shields and noise makers help the team.\n- Proximity voice chat. Your voice is also noise the monster can hear.\n- Built for VR: grab-and-climb movement, jumping, smooth or snap turning, a comfort vignette, seated height offset and reduced flashing options.\n- Host a room and share a four-letter code, or join a friend's. No account needed.\n\nContains horror themes, sudden jump scares and flashing lights.", "short_description": "Survive the monster. Restore the power. Don't leave anyone behind. A co-op horror game for you and your friends: hack terminals, dodge a relentless creature, revive downed teammates and escape the facility before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://survive-the-bear.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TezJr", "support_website_url": null, "website_url": "https://survive-the-bear.vercel.app/", "category": null, "comfort_rating": "COM
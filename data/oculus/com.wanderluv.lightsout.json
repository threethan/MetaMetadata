_oc=Ado8S2NgPJytebdilqMV6mkN7488dCFiImOLITvfL9yfGWcDBk21HfP91aqfMv-SZSs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ06k4IJoqBglVBsVRKMA1Kljac2sb-ZGyVliVBLRWKFw&oe=6B0B2708"}, {"file_name": "shot-2.png", "id": "1116050354402362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604375581_1116050357735695_4957585897587697314_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvgrKxn3YRMQ7kNvwGZWjv4&_nc_oc=AdoVTaIx2yvmcs3ijTytg6LgzPsCxwL76xo-wG33Vol6AbywUqikteZEF04gZJrlxmc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgFqX_GTHKEQDlZFWPweX20ehp7ObSMsWIokNAld3JZg&oe=6B0B41CA"}, {"file_name": "shot-1.png", "id": "1122869706767226", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/596168449_1122869710100559_8109717014040361792_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia-DoZ0I3EgQ7kNvwHRdo5p&_nc_oc=Adpc33kofRZdfzkW6013h3MF9uEjBQTj0hXj2QVF4AZUZGtEnPlF16vzqFRfPbwT0r4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpkjFkTL6MnnLMjRgVYhaZma-CvkjKfrR31_57ZqqAOw&oe=6B0B325E"}, {"file_name": "shot-4.png", "id": "1463787502523067", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831964_1463787505856400_8940136862232582818_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YA89WNk7eEQ7kNvwGqIJil&_nc_oc=Adot-BoSW9ie2q3dKz_jq-djJ20o8iNW2YjVESVN7rPZTrZmV0hH-D2Vd3jjsZdsBKE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4y6Mo0kouMC8wzQEXOgs5mQanRRF7Hb4MMieH5T8WLA&oe=6B0B2EC7"}, {"file_name": "shot-3.png", "id": "39454389577539842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831964_39454389597539840_7360521218255814477_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ_vT8C1FJgQ7kNvwFxyMDj&_nc_oc=Adq-dPVfZLRkKss6f6IogrXylw_RlWd70vAY34-OFt19YFn4nTvwrjxPog_ww_iHhHE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbIirdVKJzkN-FJkchUfX9sDbe1n9MZmfLRMw-L1PdoQ&oe=6B0B439A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lights Out", "keywords": ["horror", "survival", "multiplayer", "coop"], "long_description": "The lights are out and something is hunting you.\n\nLights Out is a round-based co-op survival horror game. Work with up to 8 players to restore power at terminals scattered around a dark facility. Every terminal you hack cuts time off the clock. When it hits zero the exit opens, and anyone who doesn't reach it in time doesn't make it out.\n\nFEATURES\n- A different monster hunts you each round, from towering stilt-limbed giants to statues that only move when unseen. Learn what each one senses, then juke it, hide from it or stun it.\n- Seven terminal puzzles. Fail one and the alarm gives you away.\n- Four maps, including procedurally generated catacombs, warehouses and hospital wings, plus six game modes and four difficulty levels.\n- Caught players have 30 seconds to be revived. Power-ups like EMP charges, shields and noise makers help the team.\n- Proximity voice chat. Your voice is also noise the monster can hear.\n- Built for VR: grab-and-climb movement, jumping, smooth or snap turning, a comfort vignette, seated height offset and reduced flashing options.\n- Host a room and share a four-letter code, or join a friend's. No account needed.\n\nContains horror themes, sudden jump scares and flashing lights.", "short_description": "Survive the monster. Restore the power. Don't leave anyone behind. A co-op horror game for you and your friends: hack terminals, dodge a relentless creature, revive downed teammates and escape the facility before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://survive-the-bear.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TezJr", "support_website_url": null, "website_url": "https://survive-the-bear.vercel.app/", "category": null, "comfort_rating": "COM
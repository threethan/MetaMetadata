.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr-TKz05tO0Q7kNvwG_Oai1&_nc_oc=Ado6Vif3aeKX3Kg9y7e0esSdCdc3ToQNkxof-8A6wPMP8KRCva8NrLZAhgD1ncwoefg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LbktU-Kw5Kda_9eiEHsS8UWpHegkAqRYG-lOoV-qMLQ&oe=6A3157B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udWRtLOkMKwQ7kNvwHeO4NV&_nc_oc=Adq6-v5nZjyctkgKUR30yt6JEj4K0uS7x8OLOLaEUb0nNmp9z9WF8eGeb3-TOBNqVtI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eyuTQa9rNSqJ7Dkqpqt4NDf1Pxup2Kdng0ZLj36Rquw&oe=6A3158B3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHufY0j6vu0Q7kNvwHt_-or&_nc_oc=AdomvmSIriCiCb_BHdZacNMhscGCnsUTK6A3KMCTqhKS30e0V3w-tBytvNmCcTJUSto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q38WsccueLrCBRZrAEYq30NR6baDeavU0PxOmU5hVuQ&oe=6A3176F9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js3SRgRIxPsQ7kNvwG4CyPJ&_nc_oc=AdoLDxXdH1QiN4OFvjmW5oEgSwvSJGUGYHIXdtmBa7CBA5tKuCA_iXLEEKqwM2OjeoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qWu1rt4P2GgKaS1OwTKTBNFc1bNFq_7oji3z2yqcIJA&oe=6A315CE7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGV-YI1Mb9wQ7kNvwESq05I&_nc_oc=AdrMNSqJEbUtw_QZLW3VIjczE2Lif8oNSFrVkUSbsoKonzEKf8iU6nn84mb0TcGmtc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95Dcfnwd5VNKyjHXf97VD-KxQakhHVmS6MdssGmrrAJQ&oe=6A3176DB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_LfpqqadtwQ7kNvwEy_uWb&_nc_oc=Adq3wVe69SSdIjbP62v-45URwjflBX6gPzkXgGjgL3Ym47_AQZty1pFeeEzNp9PbhLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gNgwUNKRqldXRQUm9ug7Tj_2NEyvpp43zt9GqcJSaKA&oe=6A314FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhtOjtyv40AQ7kNvwGXZPuK&_nc_oc=AdpWWI616-FnZ_JufUJdXim7ZdIGBTsncLp_lLf_F8PpaKLwzfrblQoJ6PhwsL0mwxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B1p9LHlYNIuQolaXtIUAjg60cWxys3WEFvhjFMB6Pcw&oe=6A315380"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
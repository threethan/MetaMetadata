.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lssa2vDZ3UQ7kNvwH7vPht&_nc_oc=AdrslgiDaiJazCfQ1vVxjyVgKfE0D7BPeWhqmzBjWbbGA4phHea6KEIArFsEJ8wi8lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zgmKJYX-JK1gysu6EaIyQ15HUK2aXxeaDNW3vIwdYTA&oe=6A0DBF37"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7CDdcOnXyMQ7kNvwF9E63-&_nc_oc=AdqkKKM4WQKRY2EawkBr0zcJ2bclq6TScEJXvkfh9R-0qdHZGGUH4efF8uXnesHbkTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f4sJ9jXytlDCHtpwuOmMfHrovIOUkA1vNB5VSG3aymQ&oe=6A0DC033"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kLX_VapkgoQ7kNvwEHPjHL&_nc_oc=AdpEorCwNUAi9SlhKrLsJ8gHy1K3dI7xU3AI64mE-BIPHeLgBFwaOQuztqJx0mlGYuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eJhWkcfdiNhuxiFLU8EeALdmq9y_TtstSMl5IaiepMQ&oe=6A0DA639"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOsRm5BXBJMQ7kNvwGLy7sc&_nc_oc=AdrJBm2uopCCGrwctqGEgJRP1BT-ex_vZaFUwEPNO731nBH0LpOIN0PCijpLh4hVxAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qt7vKGBXLVKMF5b3DzJXBQV1nVQq9vVQiFY8FMe8ksQ&oe=6A0DC467"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7KqDgb5VioQ7kNvwF1Fz6f&_nc_oc=AdopwdUvbAbPLL15duxt10Bx2S9zDw7gpVMsWhp6rqr9Rd5aIKHxhU2M9y4shhS-vLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IlxQ-ohjJeHglw9WJ0o-cH2baxOoktZAGzeilzeSSGg&oe=6A0DA61B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrFzVQdMlzIQ7kNvwF45WbO&_nc_oc=AdobhKBlZTFIrXoEMzUI_EKLQgFYeiHtgkzkswztGRCENfa8Qn0olIWTrvryO9Avqbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QXQf1TkpzStz_kwwz3u5CRCJC-qUZUtqCA-JRMaq9dQ&oe=6A0DB738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOGGow0xDcQQ7kNvwHi0ldn&_nc_oc=AdpXMx36BCVVQ70FHyAwIjomgB98jTzOzSySNu1ncaEpJZXCl97I_k6BiS9yRJAMV3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G_ahYL2cCRGukaYBJZ82uxsxCApos6TXJS5TBR8Q_OA&oe=6A0DBB00"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
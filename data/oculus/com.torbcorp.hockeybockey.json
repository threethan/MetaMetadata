.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wl6Ypfbin-kQ7kNvwHVSQ1D&_nc_oc=AdqSAiFbB7xS0fB_iwI9nGvW2vV1aR-0YMYJ7BD30kWkiI56N3hwQLXYNfnpyjWgPkY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gwmE2CEAUX6OV90s5coCEROs8udnpAsDJOhpydMv5RQ&oe=6A16F9B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMo2uALBShkQ7kNvwHxwZTe&_nc_oc=AdpNxr7JL4tbBai-TOuxfV0ZQWpVxhr0GzZYfLtrpwXa75lYNU3TNvAcKTaQ6s2hVcI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FHVdGQc39X84UgdhYSoWSCJIc27OrHliM3aQmJtXwFQ&oe=6A16FAB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJhHDVdVl9sQ7kNvwHNgpM9&_nc_oc=AdpBPrNtZubIWf0SIJW7fQ9A4uZE6wNtMb2eC0MiMp09Ps9HV2RUYUU9v5Ibjs_hD40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bGQ7WSS-mOFdrdqF-5pv8xnJqUFIEDd-nz4EerppAfQ&oe=6A16E0B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x8qfEihGBQQ7kNvwFS6f6s&_nc_oc=AdryXfOxRc1DjKx_R9kxaipy44WdNllA_-Xrfk7ULKH7t5wIJP3PoJ5ykk2_SN40pg4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XC3IDAhTwReHbd3N1ZkuY35utR8Q4oWoxi2r3hcJKlA&oe=6A16FEE7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrC6S-CDaTEQ7kNvwE6wGWh&_nc_oc=AdoweukZI2XpWD0082rmylYVMk-HUTdEMZ7_qnl2i8VRSIeABgmkcGHmhmj1koZg5bk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aF3lOFJh2rl6Ye7V84e1xad-fdguFHDtj0dzBiDcWFQ&oe=6A16E09B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRYhX1LWR1kQ7kNvwGjnk1x&_nc_oc=AdrfPUz3Ow19UdqFI_gJOtwYRePbTt1XIHymTwhd6uA_7B7bQ7bdFLpYOYveCGSLmww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rZTkq2bvBjsYOTZA4D_73XpwDpsa9ntSnnk_gmTg8GQ&oe=6A16F1B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18XMq5t8B9gQ7kNvwF7wS4X&_nc_oc=Adq6kCKistoBB7L7gj2SeQefnS-dQb6CGzuxCeLPBMmHRf7O5VmVaPIws739UTg7w88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AsXYWXXafN2C-mYvBxM9apYKvBbBw8l1bCz4NpAyw8w&oe=6A16F580"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
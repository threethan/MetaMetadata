.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie1DcFxsFjcQ7kNvwF1NAN6&_nc_oc=Adr-PG_RQvlsD5u86REJME70CN7uxtIGiDbYkK4uBvrSP59O_-lWTx0bpUstht63HFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N4Qe2wTRtirzzbjLKG0Lkmmm7HmlzmcBX2YV1Egz6Bw&oe=69FC9BB7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDfhXO4wagEQ7kNvwFF9T0W&_nc_oc=Adr-hdEMmHf-p-EI6swHB1SdIvjxfmXEb3EH1eP0K_-28Zule51RWAkYzyaoOEJ0JDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k3V7k2EjwO-wMYxQyoVqIJTIgNfuqYeCNRqvYCFMHKQ&oe=69FC9CB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsyK8JMCrwIQ7kNvwEy203x&_nc_oc=Adp9FTDFiZdQacmaGXK6v4L0_gHZei5PMaaCpJFvlmMUalACqHdAryKrBzKL_XXdlL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DY4VXU1wvCAk9yo4rjLOZ8_kXEMxownxBYrFrOjWh1A&oe=69FC82B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0aZtz9raYUQ7kNvwEdurx_&_nc_oc=AdpdadsCoKwPLSelbrcvCf2lOkNHh8lrpmxhFbcWHAKdcfxp-LJN-kDKMblkqXlctFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uPWYq0XLf2oNoX6CLuiK4pqCHOfY2WZfz_igfYHDClA&oe=69FCA0E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC0SsWHc0YwQ7kNvwF2els5&_nc_oc=AdrKqrA33RrVsIDsUcB26eNx2DpGepwCL_ylnst_5P1ya8IyCc1qAW-FbIZm3ETzC_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s2U1lRYNtAMZfFm_Y08d4HrVt1Pcts_V37l4x5hLr2Q&oe=69FC829B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6onsVWwdMgQ7kNvwG0kffF&_nc_oc=AdrL82-87T0ANYVIFoJgaQa0VkUvA-LnmuybzSUcHQjMHUI9hCMO0kbYmchCGglcuBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Kp7AlE6MK8xirvR4mOVrUs7P6HHtbjv6Ui0wliIgOKg&oe=69FC93B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3uSTsPtZGYQ7kNvwH7ibqE&_nc_oc=AdolAUADTabrdtQQwUlEzNj5HzbKQPIGWOXLVeX-hW6iQhnJeoTcJHFTd19McBumpSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6doT0g3bletOkcrOojcE8eP2FCf3DXgRfxmCaS_f7wtA&oe=69FC9780"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJdeZS8qaAgQ7kNvwHgbfcD&_nc_oc=AdokDX9GCYwWQlA72UPh-tj0GnvfSDQcHN1jTyof0tVaEpvUu5Iufw9CyXGWs-6EdiM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94I-Gf-WmjtpybVkINXSuCVCkom3DgpNCt_N8bt3QxfQ&oe=6A2C11B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES4lKd_4T_QQ7kNvwGfzLgF&_nc_oc=AdpIA9toZ7pBrapiFINluMSaVwnucJicVMH5w6Y3TuLiKpLJSK14aCdKWmZlYsS69WI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GNG1By_8nCOnm6a2jOVOP96Vp-K1d9456wrUtaDIJJw&oe=6A2C12B3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26630VeuSFUQ7kNvwFhvtUM&_nc_oc=Ado9vQUHxk7dVEiQlK-VioadAg8Etbp6GoFJ4mgwGAEAHqp6FUgn8rGgE31Lu4wmfy8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tsMw_fem8754L1BR6jj2ZSZ5zT8HwLkuwHqGXklxFMA&oe=6A2C30F9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDTR45q3dLwQ7kNvwEr0xYr&_nc_oc=AdrcF7YcvMZ7oClD16LXnXTUni8kBvF_clsHGjeJ4x3hvM5XXBRaUQIaRfzvZKrPVGc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kewEcAFqKEIrR-_EXrQE_Snh_ILPIF_LbOAoNn07yHA&oe=6A2C16E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPdy_ulfb94Q7kNvwHxQtjS&_nc_oc=Adr40LYZuDr9APmljtshDZcByz8-8NWtO2H-2sq2u5ljXD8BrI4mphlLiZ3GEGtuujM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bLvi9pmO3c_TiHEy72z4PmaxknzJTeNrnQEY9Pc0Tvw&oe=6A2C30DB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DEkXGKPDwYQ7kNvwE7T8Ta&_nc_oc=AdqdY4S2FmM38fyrZm8XLyb2VltNh6mCXM4vo_YHZtlT_aOh5dPu76uquOcUphZ8M3E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hi8YyIY2yKgVXgP3TswITv094fKCzuHhK_DNIAtGi5g&oe=6A2C09B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJjshHMDYbUQ7kNvwHv0laG&_nc_oc=Adrz4w7g5ZJHZgK92Ye2Ir_ej0ssNwMARaezaoHoUwZa6ZszDne11y1FOF3eU52wsf4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PhIZs7TDgf6OO_h4c2ZPP9dHlvLyisgDuMI3h-n3daQ&oe=6A2C0D80"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
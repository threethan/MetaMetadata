.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuZ0A01ShuYQ7kNvwFdidqy&_nc_oc=AdrLnjrwwVV0Ogm8fdCw4KzBO4tUdgxaM3awCkxxnEfWc1SUgCzsTYSsPevYi8gJI8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCkDUPJ8IQNt401Bzy4fSaLTUECKdkYwOv6ge5dzlDtg&oe=6A60CDB7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6_XmlrSeFsQ7kNvwGXhpy3&_nc_oc=AdoPKjle-AIxXb8K0jXoY3N317LLXD3yPhRu8BJMTVlSDPGqWmQe_z1kj8c0zisNrFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDURzvtw9raKiEJvycFq5gvNRd8XLOZo3ZxyX_zBBd13Q&oe=6A60CEB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_lcRYtjAaoQ7kNvwHsNRbL&_nc_oc=Adr6ZB0C7EaxIar3A6LOT9zvcZBTJl8ZyOzFdoyURyNf6D07h5WXt-4d4eI2q0gF6rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGQJTdw5h9IE70Yo0_HEIP1lp4fGd0swhVHfAvRgTBfw&oe=6A60B4B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZI1r7KY7nUgQ7kNvwH-34dH&_nc_oc=AdoKZBoL_MXSiEtGij7EThGdo1hqhlZ_kH4lbRmX0zKp6A2mfpF9QlAeBkVrBSUj9Ig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkNQg5JB9Ye4ZUcBm-ktnmg01vBPB0gb_PldQL6E84Sw&oe=6A60D2E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-iNTWmBYZQQ7kNvwE0yjEe&_nc_oc=AdpGRV6d1bzyppRv8s_G3xmr48hN9IEwaTZOaeDW_JEGEyTYFITQpK3OoOAFnbJJEZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVnNKA1Z7GWNmwEQTrQxUxqQQZlOBuoJO2tkXKz1BcAA&oe=6A60B49B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2k4wKuQPAYQ7kNvwHxnaDl&_nc_oc=AdpXWqL1Ie_FQXMCTdMhMJ_YnUDqpuCDzxgJ_jAdnk68l5hF-o8axQxF2Q_SSndpP74&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO00HkWyTciza14Tg9cDSFNfBDAOFCd_-W5BX4gECE6Q&oe=6A60C5B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjb2ACM2nX0Q7kNvwHkAfhm&_nc_oc=AdrVDBgXx86UiL7LlO0nsdGBBA2MQTQj1n7WqIDTvZMp2zzzTFulIET9_pj8eIFQhBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQSmaY-nyX18OXkFPvNi98ec9XnlEPTqqr5oghUMM2hQ&oe=6A60C980"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
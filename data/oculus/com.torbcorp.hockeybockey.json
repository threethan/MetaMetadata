.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Ok2pDTLhoQ7kNvwFAcRmS&_nc_oc=AdqmAxvP0JbTjgD-WtI0ftdUPB3Eeiu5tyuh7O4QHYWxU9NYc8oNzSTY6pGFn1SAG5c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ymQd5dlnP5okQTmaaQhdk_CyJT_5NnrXOYNAmOgQCTg&oe=6A130537"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jhgyb2b6cJ0Q7kNvwH-kmz1&_nc_oc=AdockI2d9sbpx8rLGgvmBlwPfD0kEHUHHWRz5ZMaZzyzMRrHg9jPJs6JVN5udSNkphI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VX2P-PNwSS4P3OxhrJ30h7trhEnoLhLymcNyi3p9fkg&oe=6A130633"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pamo3kuYQi0Q7kNvwEDklF6&_nc_oc=Adoi6L34aonQtyvMTL4y5dO5YagkdDYBAzQZhMMAO9Z43BXfaVGJzzO4BCInC_0XEa4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Cj0quKteW0WmFXMo7Reo-FKYBTBXAAGPapuzjRp04eQ&oe=6A12EC39"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8VZgg-nNGQQ7kNvwF0mHIE&_nc_oc=AdpvQcD7TB4FrQH6dwq8K9mbOvcLu3byTUQOucLpmFAOnjzJBoNUMMnGl2ud4F-Uft4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4be323vmLnf4VroeeCg4ZnVBqGH5K6GT8R0iaMtfvCjg&oe=6A130A67"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF1RFvy032oQ7kNvwGKi0u4&_nc_oc=Ado3seJHKlYV5jSjrLTjKYqeqG7NSQXtOMW_8F4a7OJXT-TW6O4EmQG5hxrDfE_j5Dc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QL-dm4BlgP969GYi_y46VBOZbymBNwlgOsCpAtngAqQ&oe=6A12EC1B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMBdIIDCHicQ7kNvwH1msou&_nc_oc=Adr4-aB7BENMXoyxIn-nLQKnYTofUSNvKAkJUBpHxTR2DlHdLDXfmr1swY3CLPOi8ZI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ki-bWktQWOam4xjmvnir-loqC37Ai1E6SOJXrDpkSHg&oe=6A12FD38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtK_Z4knkZMQ7kNvwGWJKgX&_nc_oc=Ado1sssGDMUt_J1RFHOXKWrAb0oabEbrYthk3ucvIBmzD5FoZ0-AfW1jpiAxHEjZCh8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LGfGK_LsnvDvvt35z-9Is5ozXdJVLxaOPPNRmfK4gSw&oe=6A130100"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
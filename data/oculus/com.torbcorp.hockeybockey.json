n.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHOiL-Ks2XcQ7kNvwGfb-Nn&_nc_oc=AdoUp2jpg5IgS8gA0Ea4ojN937FyHkzFp9JUCxq-_Tt90Pj-Qg3QaDavdbHXU_O4QE4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcWf5DzYFVMAz4l5h0WUg-nvMB_i3PkfT6fSBXFyF9tw&oe=6A54F567"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GfHCyEXcz4Q7kNvwFGXlAw&_nc_oc=AdqDsbTCA4TxSr6E4qSwF7LhAkMHN8DBmOTqsrTTvmrzg2rHrVvYvMouL6XUuuHcyj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9zpGx915r17PUa1kFiOirZzg-sc16pSvKpuHII7CAZg&oe=6A54D71B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHdrkoQwTRcQ7kNvwEX0450&_nc_oc=AdpazZ4ZygHtSxZ4DyduzFf9O-NgiYd7hsBAUt54x0ivLo-YXNKauCKP5Ufdhn4sAoM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkETSacb8jT9IeCPoQD6rmWsKjygcN76022Au7zhoNKw&oe=6A54E838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kOYYTjxp3EQ7kNvwEX8oIU&_nc_oc=Adov5fBu7Vm6xlELWilxtBXx4tIc7gco3z_qCouANXpdg2SKjSj4Rt1QmWEp_7Mu99U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX-FsETWkGjbWDbWJDSCP0-tF7eUWZkYqf96YK5SDtlw&oe=6A54EC00"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://torbcorp.bigcartel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "772431210778389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75195905_211003350983031_5749559701408537037_n.png
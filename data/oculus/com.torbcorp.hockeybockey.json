CYOzaXKJcKHcgF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo_wCrI8E3ttvH_a-zg8Bc4fHlCmMZXUcN0mTKGi_WyA&oe=6B0709F9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H6c7OYFBo0Q7kNvwH7rOkP&_nc_oc=AdpotS-FUl4yDfJyWyNGxF-wapwmTzTCTQMWXOJwADOQildTHRT1lX4bdrUIIZoowqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2BeE6rJULg3Ias71lXSaujzvDNV5e1XIzi4EeTLWnEg&oe=6B072827"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sdvfuBlokwQ7kNvwHYDbqK&_nc_oc=AdqlKbFl2q9ZRDBSU2Jbi1cKAMst1ToMTM2HxX4HwmYzQo9bohZ_2W6UxT2FFSCOrFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw6pIQu9hpyXFrwCtbkgs0xnxFa_-Ub6a0L2kSpbjUkQ&oe=6B0709DB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kef9OHRlEssQ7kNvwFucas1&_nc_oc=AdoyPHLWWUTSr0nNuWVF7v_FhOZNjQi6tGNyDPgd0cCS7SX2aJIXp3-CLTRBjpTLYsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWY1si04R7kmEMMT9UVO1por5TkLQbjp29A2l2gRVGIQ&oe=6B071AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i49qYWJhkqoQ7kNvwEgDWLp&_nc_oc=AdpEI-_2gSl0FwnKhj9L1f_O9VdMhbRN-ktGK4kHsmBesPyAtSgLu-fTVfC6PNhnstA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZi2J4fKbfNLVUmDF1PQfe9ubP0BIHI9SyCNhPxzSiSg&oe=6B071EC0"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://torbcorp.bigcartel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
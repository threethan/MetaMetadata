.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whIdnEzD9_EQ7kNvwFOQG2O&_nc_oc=Adqzn5iimEPB60dj5ub0eclbzyhGWdudHW8jgMB4jYusSSs8Z25mA7983MNobuqFx7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLO1l6VVM_QpQlAhSY2M9LJNy_OEk67J67NZMN8oMhMA&oe=6A621F37"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6_XmlrSeFsQ7kNvwHlVPLQ&_nc_oc=Adowiknmkwo2wZ8I-4MNzdO3FYX_Q8HYbrXm4UvpQSWkH1NbAo4v81QhEBDYj0jRogk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpQ7XcGQ__tIVomwapfJ5tGTlzMAnm2V2NDE5eDKHUXQ&oe=6A622033"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_lcRYtjAaoQ7kNvwE0nyVx&_nc_oc=Adq0aZCPlPDJiLHVpGn6q226eoUxw0pQOfpjEZ0TM-1GQ7NI8HU3zklgC3eUpmhfUN8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSyUZpNGhNLKWihPB7KPoVIM5OHyLViQAJFUP41baIdA&oe=6A620639"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWZWFy1kX-cQ7kNvwFmNj5Q&_nc_oc=AdqtQap7yAqixi-SIi-fUfLLuj3F8M0dvti8dbi3Q0j6gn-C5bW6nAURf3iPlP9ax-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZVusQ7Oc2w6O4jZAMdbEvjKlLFI9ER8WABi7R99qE4g&oe=6A622467"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-iNTWmBYZQQ7kNvwHk6MyZ&_nc_oc=AdpVWL-PSga-br13UKYTTIfaiq6UHzggWcSjz2aXkLJm_My3w5jGLA7j2dQn8R_2SCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcrP1tfsDf6DkWNsvjS5iGMxJavS_QWGI1PyXt0djd5A&oe=6A62061B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2k4wKuQPAYQ7kNvwH-x38-&_nc_oc=AdpKQUI8_v23b0xw7dMs4tM4qrG3FKPTH7nJZ7LnQGDWt1FlkQTD0GLZse_oF63dolk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbpXWyKi70RFTsiONpZasQv9ElhvDKBbuQquwDaWsrlQ&oe=6A621738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daYJCZAXJl0Q7kNvwGhmvce&_nc_oc=Adpz0UOBj5M7JXJ9ys76UTvK3uSD7NicwhcmyN0SHhFjKHG3xMOdmNFSiam9-WIQmc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNY1fS6oimjVp_tmk8srvOxN9bBYD8clysILtQkq0DBA&oe=6A621B00"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
oqoIg2TUQ7kNvwGjX0DT&_nc_oc=Adk9DyQutFZ00B79JEWuQWDlayM_oDB7JxSHxt3QE-cYwzFKISAyp5q2Nyzf8eLQT4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvXm6ad2UwgFITsFRiXMFoJsB0zbaKyw6qskgsTww2o8g&oe=699F0667"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMMbkp8n_yUQ7kNvwF_Pn2a&_nc_oc=AdkNyazxibF9dmT2Hw36gXGaOP6pW5sDWnaiHETTE7BDLnzFBYBuzwETh_c5ZlzKml4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsCNoNqaM1GdUmLddERBy9iVD_IRQ-0soWX4Q7s_lD5Ag&oe=699EE81B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn3LpDvtsNMQ7kNvwGkjHBM&_nc_oc=AdmE-9jTgviHhiZ55UvLBv0ZSTSK3KKKYysFDmjpIY5M5tQRXqDrDzhQLeRnRksQnwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsfO8Mpo_rMtbt9Y2jvaTDWurU5T7zNG6ILsEQjP95R3Q&oe=699EF938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UfH5Yh-x-oQ7kNvwGmVdpu&_nc_oc=AdnxsnbgVrR2GsNlCvpi_bdbfhyc1GGyF-b0iARLYGe9nHF_qi2OjYpc4ZkTrgvliWE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftr_en11latZwPxfuMHRcEsBt0mPZ_8V6oH5C8ecRIt2g&oe=699EFD00"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://torbcorp.bigcartel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "772431210778389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195905_211003350983031_5749559701408537037_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E28i96L_GBgQ7kNvwHYVNHW&_nc_oc=AdkGs-K_Gl6V6If8mPtVTHcSqNpTnnfncu-n984ciRI6omaHZN1jL38AOFHWP_z2aSg&_nc_z
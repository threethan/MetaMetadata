.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gvQd4MjWlkQ7kNvwFZwd9F&_nc_oc=AdrSVHfK_52AeoaZ6SFQZR5JUV7nNnDDckdKLvb_j9FcgfMGwQZ6Sm6HxkqHlPHgW4w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzz2rWkCLScVCuaULJYjRAoCLwil4A-t2NViUeTIx475g&oe=69CBD437"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVhoC-_ti4EQ7kNvwGkf6Sa&_nc_oc=AdooJmJM6b7NWp1MDz-C8SUEaQJMcZx4_s3mBoC9ZrXLv9REpAlzxiIk03U3gv2fH2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw80_bmbRfdmsi_rjmn8y9yJ8Xb0njyzgCTH_YUM-xmiw&oe=69CBD533"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z79bF6qTeaEQ7kNvwHToUkA&_nc_oc=AdqtNILccoiVRUaaoxdZJMRf-_LzniOdmvqAzoP3SsMEkr-XIkBgE5OVg_BWblnVP0c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4qJaCgqqFU2W3S-KitxGn7iOeiIb3vEL4l48WcQovvg&oe=69CBBB39"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SpcYL3ayHUQ7kNvwGBRqjy&_nc_oc=AdrrnGxdXCM1X2xbCUM5KB9VOapKNaCjnHShNG6wHi2RP__RqDtDYFYjk8cKZR0d9ik&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqU4xVLwy_u3YvlZl3Jm_ZeIWlCahcbAHmHvjM9a130w&oe=69CBD967"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJ9N4VwVxfwQ7kNvwEAJBIi&_nc_oc=AdrvJZIsHXChZZWQlYp6q1gcMR7c8lU0zeaXKNY8Uf3or6I0Td5gX97LUel8Qcsx43A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyutNcld-S8X010ajjVDh7118d8hLffjea7Qhw7165gbg&oe=69CBBB1B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKpUIhTvQLUQ7kNvwFVID6e&_nc_oc=AdrzbO9fjM3cBJ8WwnE409NKAu2uFyowV5QSHS8ZxJF0YSSjTm1VWnllp6OltfnJ940&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyv_pOZqOzXdW9zu06rDHHGhhs_ON5NFAp-djwsLWaecQ&oe=69CBCC38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=958zz1GAXtQQ7kNvwFmnGlY&_nc_oc=AdqUuUwi2gw7bgg8wtOUDNHcLTDJD6fhywcG1VF5kn02IkkSrmJEBe92Y7LtGO05__I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1cGG3lPtWEi5ziYt6bEactcxK8UGjH96xw3bLwapehw&oe=69CBD000"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
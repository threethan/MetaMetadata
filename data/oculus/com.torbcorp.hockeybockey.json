e_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H6c7OYFBo0Q7kNvwEsy5He&_nc_oc=AdqSIU4Fh5vV0JOUfDmHvtEKeag_vauY8JvR7v-8YsuL1Q5N3pPa0WhixVogcVnvL3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSijx73qegOyGom_srLpS2KRAu0mVa2q5sFWjh2vXXqTA&oe=6B05D6A7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqltSOdipbIQ7kNvwH0wGoZ&_nc_oc=AdqeEn3rSmibrbKbXiRXd8fOYLTCtOgEtzS5TbJoqRgmOszxd-7b_VbaXMJObaLFr5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQnywTbPDWPX5m8w6-wZfM90dOgecStsbSov4kE4rECg&oe=6B05B85B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kef9OHRlEssQ7kNvwEFqBT4&_nc_oc=Adp9AoMpuHJkgN1neJniS-Kpo92MLHajiwCHxXZAacsCMiFfBjJ4JsxxruIW6Fm2XWQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPCXSEzu82oFE-zWkjI9XzIFoLevwb8t7rPFsfPgHiAw&oe=6B05C978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i49qYWJhkqoQ7kNvwENRhEF&_nc_oc=AdriorILkKFmsPOHkVT0GvVFcl765j9-nLLfcQf9GiDY7DZJTH-jYUWrUF2OXmre7lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZmkxdUSv4DOxoJs2sivLtDdY93yNL-8k1NE6zENP-Pw&oe=6B05CD40"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_U
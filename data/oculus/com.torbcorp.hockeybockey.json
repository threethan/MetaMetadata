.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTbVbTd1Om0Q7kNvwEEjFoD&_nc_oc=Adp528FSDLrLUqMCYEeVRnXhqxoMfY7KWi8gU1Xt2LQLT4tbgtOH2OIfUoXjITPHpwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOypHbR8PsWyHHsxzb9Kc4aBfOo9QUvSTFXXMPJ8TME9g&oe=6AE200B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5brT4zCOAk4Q7kNvwFTvoCF&_nc_oc=Adr0K4aviUGpcp6qxuINRScMWwpmYyoQv07QtnHdOwBf_t80AcNmFFhVRH3gxKOpYM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7c2qajv7pCO7-fW5iw13nZYOHA3ltkzwRTSlPN_L6zw&oe=6AE201B3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGS8wT2SRN8Q7kNvwG6SbNW&_nc_oc=AdpSm5UHtcDX_QV-sdxma6xUKcrIQzeKKwVI8qtVw_IE2T164JVHU_Q9kqw0FaD0sEE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfj4TBsF4_S6cnPgHWcano0agUyLFlbGf0N_jzsEU6xA&oe=6AE1E7B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVAPcnF4PCIQ7kNvwHWLnSJ&_nc_oc=Ado6yKxPCrGS98cnjOxe60XeQ2tFZGuO6HcUz08iZkpxGtwOloUKcMxL2ane9LJWhd8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFv2c6fLFXBvzvICXVxg-GQ14EPA8c5JhTCaWtBRra4A&oe=6AE205E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbgYal7w5xIQ7kNvwH6v_eT&_nc_oc=Adq2RkyYN78cfSkw7JqDabPz1Zj-fEr0I7ecNIzuJZweg56DsvEiz78S8MA6vrdjtFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1frAAjlKEmw7Rs8NZ8HXIJWODOBce9o4Vqffny4Q6_g&oe=6AE1E79B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cL52znpzCkQ7kNvwGY_TvN&_nc_oc=Adq0iV5sJCFj2U-d_TSQs1-6LTThFQGn9Dlby-E2f7OfX12QyVR0boUA3ZXaNp7En-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeuLRFkLkF1TW-EQdG0OZkJYf5GbDuviOO2iLHPJEc6A&oe=6AE1F8B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFR1GUqXZ1MQ7kNvwHptWvt&_nc_oc=Adp1wYA4-sgKu1na6HdvPmWdZ8kip0aPv1FQVzBBxMJOTL4oSSBdTb4Slt3nS42CK4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPERk69clnYbUqdmLpn9o1tBjXHZg1SEtFanU5gJIG9tw&oe=6AE1FC80"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
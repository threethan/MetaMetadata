.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLquP7FZ76gQ7kNvwGCRD_g&_nc_oc=Ado9bxFOu3GFlkBgiP1ZvwqIXuUE2L9V49AGzm3o-3BiKsAE8lyWmR3M0svXf7JROd4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a8wy4m6vzFiW0WORquHgbwMNubAWZYBZOWqvnlD-eKw&oe=6A2428B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlgD5BHOjSEQ7kNvwGsIvG4&_nc_oc=AdrJwlt3sMf7HRY2V7qFG7wWAlJ2ratc9vrHlmt7GQ3bAjE1xyU8oPKdZ7jBZl8nvQY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3O4I95H0D4FmERmLzJK68V95dKIdAWp6Uw2NGsGkIQw&oe=6A2429B3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6o198aMq_KYQ7kNvwFxyPPt&_nc_oc=Adqqsntb2EbcX1Z3zaGDLdrT8kQGRGRoq4HX5unlXbr55fpJruw5207dmHDCtrijhXg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89ASJwHlFiE9PnaTR9ygttPFbTZpoBegKK6wtGxvpNQg&oe=6A2447F9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITEKj6Mkz2MQ7kNvwHdrN2M&_nc_oc=AdpDD78cCRU7oJTuS1KKtSsqgI82Bkq99zvmuFj6en7wEsxjpem_MUycfFWYPyy4ev0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UEX85hmxRrB3TxkjA3sRuTTpYvRWQn-7Dm6e7749Qzg&oe=6A242DE7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZcWzKct_MoQ7kNvwFhAe_p&_nc_oc=AdpqFgWjAWd4NHA3Z8gXztjYs1vHZW9FL0SBVmLmO6o-UK9EgBuDG4bZr8aUo75hPRM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d5FywbFGoUrWzmLsmnVe3VLJr0yQzyH6ydhBn18pk1Q&oe=6A2447DB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSjWiqXbTUEQ7kNvwGXVkii&_nc_oc=Adrj6Gwu4o0Dka79WJxe7AxQ9HVie05_Bcc-G98Rt0h3oiaGdreIZNlizqG8jnPBh9E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-42BZVmlQNn7SUPFgjubSuCTsY1zYcVeAeZe51vqVJA&oe=6A2420B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOI3_ZVsNywQ7kNvwGBxKvJ&_nc_oc=AdrxTMIYi9oqjO615NF9SVrqaz4asDimxTQTIsND7YUZORIB8KwX4-Hu7L5ybQlK9NM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Eiq0cyLOlLm3qkGBdpy3mBoypUlnwZV7hBjpw4sPpRQ&oe=6A242480"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
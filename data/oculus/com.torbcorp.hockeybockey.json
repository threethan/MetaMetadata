.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr-TKz05tO0Q7kNvwEEyHmv&_nc_oc=AdqtvaQUHfWccb8YHw3kyCVmKWLzw_VU4F7c54GV1x4gmp7FF0J8tugHIkKQ4hJE7gk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QIDIvTkG3veRC3HEiBKdUdTZZA6kGxUufSwKish3XDw&oe=6A2EB4B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zASMvFYlBEYQ7kNvwGmUiDW&_nc_oc=Adowi3XvFIGcn4U9HI_VV2omHYBavxfTbBWyExLR4Vfu_t2p1PCK-I2NDbektjvqxc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3YFCAmwq1FwmG782PaGGjxkZ0oa7XeafAfLb--zxTvA&oe=6A2EB5B3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26630VeuSFUQ7kNvwGu49IW&_nc_oc=AdoowwGCeFz-VjOmSx0M1Y5YaG5kgV5U1G_F5pScSf0rbi21EXZ5Fz1BotB1vuQyzBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WuVQB-qzr6_XvQ_9e86SLlbPatwbJYjYi0d5IKUNXTQ&oe=6A2ED3F9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js3SRgRIxPsQ7kNvwF2MAra&_nc_oc=Adpf4QwghYWFcmJ0vAwT7yz1bqprfVoaWe9j6RMP7fmWK4pzmK3NGLjwq1VAGrqqvi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9opLos6TFHEJp8wsdtJGUiqQz9s_aks7p0tlLGNW6b2A&oe=6A2EB9E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PjSBjo_-xIQ7kNvwGzqPWZ&_nc_oc=AdqYOoE73IDCQUiDQFiVMpa2MX9YsdQt72_-QyyA_PfC-2mF0P8wb2xymjMP-KfOSjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_apmHEwgfw94QB0wAA0PBwZAr6mBYSFqYdg0zgAKDUfA&oe=6A2ED3DB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DEkXGKPDwYQ7kNvwHteP-D&_nc_oc=AdorkRREpvZa_TeWs6KJ7rFbAb9TqiJUGuskVGvbiiV9q_X3h1mJN_Jf5lXJm0pTrKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0fO1-E586AxcQIgcKB4UjQjtV1IfrCbRc_R74raflzQ&oe=6A2EACB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhtOjtyv40AQ7kNvwFCNcBa&_nc_oc=Adozirgeq7SsBGLcsu3pJpsT83scL4OG2QQqtllxj3aCFc5rOzzSir3rA29upilqi28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Eooy5pRVloEVbwC7UPpHwCic1fnpN8KFEJlcD5D_1Vw&oe=6A2EB080"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
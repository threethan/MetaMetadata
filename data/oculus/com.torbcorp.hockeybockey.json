.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5Qmb4dDa5EQ7kNvwELp_El&_nc_oc=AdpZdhQI_MeEPRQlriqiJELhqIdysosevQ5_UhBHXXPtrHlI6PU7F0iJzNkEMwwoHbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8Syeyr3EkZ2ftFkGVLJwrAKZqjWOYin4xiFdqpaQbEA&oe=6ACF8BB7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU72tTdqzSQQ7kNvwEq6z3d&_nc_oc=AdrVxSNMZc-cIMB5j9775zcAsU3anRJ60SoT71WRj9ZX50mMqTTObeMoh4r2Z9WiZNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNSHYYq4ONUymlx9I-qXnWRIorHoo8fr9wMvA8pdCOkg&oe=6ACF8CB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idKJOEaRDFYQ7kNvwF5krFB&_nc_oc=AdpVjAeK71vFP0VD6PO-RpF_g2ozJTSxHIfc_VfaI_NKy91xJJ-7UAUuiKym5YcnACc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOasg0aF64jvKm420y-O6SEDojJtAPeAb4o2_T2K3ZXWA&oe=6ACFAAF9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQR91XbHbPkQ7kNvwHY5Fwe&_nc_oc=AdojLiYTW7MqpMxHWq9OmdaxbkBbtPi_VRIJ5p7NWzmUVEMXA3Mf4JBN6Jp87NwEPgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCiRY7EPla2OAi206EHrdGoqgDszA5UaJcLqdD8t7OHw&oe=6ACF90E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9eaH_bsSJUQ7kNvwGTf97V&_nc_oc=AdqzF50GvDtVE-re957P-qPD_9FkwpjhLZAgjzptkV5A0cJsD8q3dS2aliuXVxgKvLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4ZRiMFmeIDwUvI5sOt_CgqHPlibSHm-I8hAFzqfJrfA&oe=6ACFAADB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIQzws7Dwt8Q7kNvwFtupN_&_nc_oc=Adr8LTAoEBh9gIUe0AyQ57av8v9mR_7Jx11lX9ipL_pRKnm33ROZiMEfyV-9sfsaJNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVKj4QpLI5f6aguk99EJ9v9SWzkzqHu2LFC6GHwW99hw&oe=6ACF83B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaD7uHy7OiQQ7kNvwE9yfPC&_nc_oc=AdpUq5HXWmv-YZBcznDEiijxTnd2ZRRVCLGDdVfLcHYrB-cZ7IOPNLZ1JBGS2rkSwGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKPmnLO5Ua73yZYR6CqQhTDW0PMg3C5hagiV4q6LXM9A&oe=6ACF8780"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
sN7tP0oAQ7kNvwH0n6W3&_nc_oc=Adl9t5Foc4AOiZVDhk259C_elmBJ81LOURmY-lErEjhd1ugUwesh4KGHEB_-8KPaqd0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvhS1yksnPWIooam-SnoZGglAzenW7OW9ut9SFEaqVLQg&oe=69A1A967"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMMbkp8n_yUQ7kNvwGz6iPq&_nc_oc=AdlyK9e2iCG4ly4p9s4JXIwIdudpuNFrLeXUG04_pxCwsB7tNwUsS9UX6WBuN2HkY6I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsUw17HAyKapTUYD5i8TuQluJjsx3KYCyThUQod6luLxQ&oe=69A18B1B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teI69Z5BYqEQ7kNvwEgv_qh&_nc_oc=AdnR3ypzUjQm08YUW2C3VWO3iKlb-57LyDDHBnrmWwAb6leTGAHpArKqJG_RD9Ny-ew&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftC0HgjQjcomF109s2H5gNGK07sY1onhu-kV6HSMhqa8g&oe=69A19C38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83YQX1HRlaYQ7kNvwHKpU80&_nc_oc=AdnUUWAWUMVRgJfyzaE6ZlcrWxDgzm9KFd_uziXG5PHIiLJPj67F0q_RpAkKVtI2e4w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsS3-IQtEOPkg5Q1FFUNGahyo1Cqdgx5sva9gTOr-xj9A&oe=69A1A000"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://torbcorp.bigcartel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "772431210778389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75195905_211003350983031_5749559701408537037_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E28i96L_GBgQ7kNvwEQbQbG&_nc_oc=AdmsryM3MM1RVA3bRFQ2KVDKh1Dc3kliZEuuqKR4L5RWwE2bINxgRfn-D4kT15Y3zYM&_nc_z
.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7NaP5RR2lUQ7kNvwFLD5TD&_nc_oc=AdocnZMrtWe_1_ls5vhJO15SJxcJjzhno746E2iXSUD-QeFQQ4s2Shg6z7I9Uy0_FhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6fF2hPkv_yxMGQnb2wGN2dYquK3YyR2VDqhM2jsxkUQ&oe=6A773737"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj-zxaXYYeIQ7kNvwEg1FoR&_nc_oc=Adol-UFPaNnX4D_cKRdOLL22soZrEPxUGzZwW9H5l4UCn7Q0Er78SfElzv8bXLEv78E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdLsotORjWraI598z3EFBG1QetuAjgZOPT4nW_yuCEZQ&oe=6A773833"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niH7zqoXqo0Q7kNvwGSCdUm&_nc_oc=Ado_-PCrNGB7RseXk48op0wXQuu46uF90GteVpp4TiFXR-hvmgYbl8a8hrzqVuY8Ouw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDWI0c-HUJfTYaMBBOaNJFe0wCt1Ru1ADKADI-MQXBpw&oe=6A771E39"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StzE88qvqlQQ7kNvwEnZI7n&_nc_oc=AdqkyizAanGWrtXLEyl5H_JO__99up6d2UCx7Jb2znkhG9UB9jijQYryqwH7FflL4J8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtyvX8w5EOoBI8rQ0C-615vAP8v7gdhaIKH-U9lI6V4A&oe=6A773C67"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hOoIKKIp3oQ7kNvwGashl5&_nc_oc=AdpDY0TlyqbY3UrHDf3VMrJNn88yfZq15CVxaiGhhUVIeEE6lvDnNhn2mIgwFcLQXyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGxcSZ6hPE4i5JfU2yl1dqGJ-gB1Vs5du_z0DIq__4Iw&oe=6A771E1B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcUYq5jJ4_MQ7kNvwEW6Ncr&_nc_oc=Adozh9ffutwzbUls5UV5xqGTJ6MhvInPldFV_uqDx1DsthkDG39jFyb8uAvuzjViPJg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5-NXTiAR0H7IhDtKY9CQ0jyLph1CrePfn_8cAANowTA&oe=6A772F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foV97tpvbGIQ7kNvwGdfLMd&_nc_oc=Ado0Ku_9lepAmN9yB1Nu8HEVMKXUpFdMOB2Cwn7mED0cqLQ3f8JldsCzLOCsCN0nHvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuGiEzgyYRomNRwvLfm2YE7cB3zT8ZHU6yIzi87K1QHA&oe=6A773300"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
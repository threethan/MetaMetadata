.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3tgnUhNSTwQ7kNvwGFTho-&_nc_oc=AdreF8i-bNZBobcQB0oYlDwoZiNHIEbOk7UH_lgt5Bp4S03r9Gm4TRNptyJpn4nB3Lg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa6ruE61YZC27qL76pepaeVz7IgCvySKLBVDosNqYn8Q&oe=6A7B2BB7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOi91mcYBBwQ7kNvwFZ5TMY&_nc_oc=Ado7DbZ3mvmwGKe2T_U0ZzHTDVlWHyfwKscK4ycmkaOabdDFLl9WUMjxJjFEu_5hxYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoUmLfte2Bl-7Ms6J7601LVu_mdCQQqrJWxtP34lBNSg&oe=6A7B2CB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxlX2-DYnukQ7kNvwH05CMN&_nc_oc=AdopJ5DZr2bOo0LSaJiReGQlfsa98WCCfV9S19RnHcMymrvThkXnxLdZfqM5RSGQ1es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4o5nkR48IO1lbeq-rmn650H3GK-RNOLOZXos0jXh9AQ&oe=6A7B12B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7voK0XJwiQQ7kNvwF6rBwF&_nc_oc=Adr-XB3173DzWVOeLgFyuJbTFIzZmAyrNLp3afG78AxH32GA2RZTyRpxUSA7uEK0Gbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOfLJDyTcySjXRcZjIzbTFr_76Ud6LgoTgv6JwWA75nQ&oe=6A7B30E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FPqmtsrjVsQ7kNvwHC4XxC&_nc_oc=AdpY_gkj6HZKrPUKO6W8PzjJdHzXlFi6Z0iB_vdmLTwlQ4maH5oR3_MhHmtnmJLjCzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq4cCdzmNGrvM9rW3ZVO1KjDwY4lxn-cL6TVyo38qSXQ&oe=6A7B129B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWXFVadSL5UQ7kNvwEBH1ph&_nc_oc=Adrva4VTq4-navpGi1J5gBxpVLmretgD4pBw1QohkPniiKvxbou9IYx6duNJujZqVKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGyjPekxzw4xnvKvo_d-LIhl84n3NOVnCJ3KZpSwvnuQ&oe=6A7B23B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsUIl-I8bVIQ7kNvwHz2i8H&_nc_oc=Adr03dzwQSqgdojUKKTjAF1lkKQnvUSQ5ZR_sbHb1SEuVk6NQMoWPBpDVkj46_pBxpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY1SZpo1vduK8fn8l1Pxzy0IrR8LleCD9zpxPqBTwJAQ&oe=6A7B2780"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
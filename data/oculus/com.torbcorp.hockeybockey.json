.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HigcsGTBNg8Q7kNvwHa8xHA&_nc_oc=Adr7y6DQjMOYW1WwD4-pepCEhS8XvsYdBLHHQyW3NfFJVyKVJwF8TxQ1R34mzJVuUbo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk-F5eeMMvvPJMUlU7qAUaBV1MB41IaZt7myHVKAohuQ&oe=6A5A3637"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7fXvabmYuUQ7kNvwHFd7W9&_nc_oc=AdpTmPbXof8My8_-OKBCkE5mmogKAs0s4FQ2OIdz7mTfoLKkJtnRCQxRisx7X8Ii3pg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBET0QrU9F013VJ1Bi7HwqRgzAjAPYJmG6fn9pR5z-e1A&oe=6A5A3733"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJBJhjZQjpYQ7kNvwEYtGdv&_nc_oc=AdrDJnhG-bldReMGExobZqgmV0Lzm0OJEQj6I7I2W6PdR1V2o2_eGbDdn6i-QVAI79M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfeNgpALU63NmykSCPdr_o9ilxwqyc0KJjUyUj8kE8FQ&oe=6A5A1D39"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpsIHRkNAVEQ7kNvwHgIXqR&_nc_oc=AdpPbcln27qNMhvM5aButOSqK5qrscQkLITcRyVQnc-nQMvz7cy_-6TujBO4v7_xWGk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKry-ytG97I7MYtrrgpHM_GuJIb2OI6rHvYGKOkUGoxQ&oe=6A5A3B67"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iokkmUDS3bMQ7kNvwFdMWiX&_nc_oc=AdqxKEvPd6kUkbszK-VU-An2Om9VuHtGS5pkjpRbM9pAjt7cd_0s1_sXlwmBue3Wb2U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsZWGX_BqHxosSpu8RHuI9Hk19FmZpsc5IRZhoRcTuXQ&oe=6A5A1D1B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYeLYd0taSIQ7kNvwGe0vqu&_nc_oc=AdowzvfIBUJT8e4WhUZ4AMJN2h2YWcwQeLucuYI8SIiqFSVFo83AdjQyCG8DUv10imE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfFE3TZDnNqJ58huBzg8uzBaWV36XCdjVv2yCSkY78Kw&oe=6A5A2E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMElt2ipTD0Q7kNvwGGCc23&_nc_oc=AdrijmW2z4GDAU0r3HutJrMqZLObLjAHzHc19WgymG_92Ozf6F3waL__VPiDG1DEKF8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9zy-h0V7a4oD1Tve7Nici3s54X7i2-mv_4aWCKA2kYw&oe=6A5A3200"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
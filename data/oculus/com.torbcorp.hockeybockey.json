n.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KePJ3-9yZiwQ7kNvwEgSt3N&_nc_oc=AdojSuPlOQiDF4PkyuVuGL1tCK5NVFpAoL5dfFuQ1HfssTYwHtY3npeKGUf8n-m1HKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9EvAeJF4ejUfwfc7m-TqJyka9k2WivyY9LF-Gkfc5zQ&oe=6AEDE367"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2USxb8Pp-AQ7kNvwHoQmUk&_nc_oc=Adp3FBeAJPCfm30NfRlECKnFqyco9s_NtYCjLuRm3AcXEa53EezzgsmuGwvGH6Drg1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSibRgiLwkHhGPHCwrUaG-HpPq-AbIH63OGWPdILegvPQ&oe=6AEDFD5B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqZFxnVUiA8Q7kNvwFBt-yl&_nc_oc=Adr6iZOPCwY9VUGpvHfwq9EM8N2IzKvXeWMj3NgRYSsITgipC6hVQSA0mBQRizzmmCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc_gMYfC6zBCkcLG9aD1ThaACrDW9n-8g7Id076AIOFQ&oe=6AEDD638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8DWiaioz1gQ7kNvwHaIHoR&_nc_oc=AdrHLTyBzE9PvdVTNicQcqto-MZuzgsrpngAaGi9ajLh18fBjl8zdkLfJ3eQJ195JfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_YeMce61chELb5kD9nVs225TA4Sa7gTQ7XqK5SHMv5Q&oe=6AEDDA00"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://torbcorp.bigcartel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "772431210778389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195905_211003350983031_5749559701408537037_n.png
.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbVG9WN4oIsQ7kNvwEhARY_&_nc_oc=AdpCRhNBLiFBFcJZ_jtA3GAqBm1A2weoLOKCiPkAQuSgrfzaR8MCCJT4P8VbZpG_4NM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2axzqSKpO3yxkC3eTXULfKGmetMfMOdQbfQTu0fOFM0Q&oe=69DF9AB7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w7TJURnftQQ7kNvwFT6qJs&_nc_oc=Adq1I9uNkpZdogKuv0cNLYFCBvgOh2qDCthxDseTpKu8669AX8G0rzJy8_ZbStqr-c0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01ur2IM6KOuaA6kc24XL-Q8DpLdP8izqAiIS1EmVnXUA&oe=69DF9BB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIJCabbg18cQ7kNvwHvllMj&_nc_oc=Adp6KFBD05qEy8NrGL46wBYVRQM3-m2C1MIjcFK9PAWOKAtKOaxqQlG0e_4oZFI9UYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hNKLFkirC6lgfNfgnVxLwUVyKX1LfUIhGKD7qPubyMA&oe=69DF81B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgVyMta8gMAQ7kNvwHk6CbS&_nc_oc=AdrDy_T0QAY6E0Ugra8BzmFprLI4MM3ffzViytY4SN8dw8C2j4JSkbZcCR4NSFdPdE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nmocpRZ21kHpiItkvvy2CYBr_H7QbnzqHKbHgJK0B5g&oe=69DF9FE7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTVTXfmCRYgQ7kNvwF9Ivuq&_nc_oc=Adp4cytRl-I7tYA0CM4N0uLZfoEo3sbk7---xD3O3cTsnaWUs3Lh-ba9_g0v1x-ReWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oMQLmgS7Auhsex-lpRVtVJg9rbx0zDrtIMWkzISnICg&oe=69DF819B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbooK9UJRlQQ7kNvwF8bre-&_nc_oc=AdrVVQxkR0EGvdcS-KxWVaHOtMlN5Jo_5c8gMeb1xj82paf_MDkYvd_ei5iNIaQQWo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u7f6ZgwtEl5MHEknLJCsP71XCNdhDGbLUn90aa46_Mw&oe=69DF92B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-psRhr3JykQ7kNvwEPS7Sg&_nc_oc=Adry7gerptImC4yNHLn-1LyzzOEOWS_BdjAIzTnjF2oE7tKHrm8nhoYoQtsTaaUyCvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U0tEiKy9VfASpF8fhLxaJtE2jYa2wK0BtaAwgAbHorQ&oe=69DF9680"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzHvG_TfqrwQ7kNvwGqtw2z&_nc_oc=AdrGy7rgkBqmdvy7Xn3qkcwmTfhzTnyd1IJXlmTBCutTRS6yHjxmJsCDP5w9z1gApQk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE7uOSJRjaJKIS7DL95BEdd4P3YaRU2mYLv-RAxbXANg&oe=69C3EB37"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3IT11fQzJMQ7kNvwHi1U6K&_nc_oc=AdoZJNJNg1b398zqZ84OVUv0jO7TBfhTfA_61fiQubCo0TFOJDBOoFSCaSXI2d1lacM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm_8jmTM3RaRkj3xz_jBoVzz5K16_CevCRSop36K87fQ&oe=69C3EC33"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwzkesIo_L8Q7kNvwFjmseF&_nc_oc=Adot6artrJfqjDfkX-w_mDM-vumKOf6YUMMY3WoxGS0FvEtHEjJeCTKuba5b8lcjdkY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdZNhqqEgZdFH3Mjv54poH5v5mLcp1zILh0YsOLkZ5OA&oe=69C3D239"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ7EICWHUOAQ7kNvwHMSIG8&_nc_oc=AdplVKi69E_Dl1cqC9knqotqVHZcaXJKzek1fzIjd0NBi4h33oT2bb63z65TQk19-BM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvKIDIx3IXnB_VNGd5OBtB9lcIEqOQdcx_KfAtUgtotA&oe=69C3F067"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyI7g4ekr4gQ7kNvwHS75qZ&_nc_oc=Adq5p7oSy_Nd9hHoKmM8soxcRWUPQnetXoLwEwQoVx2ymPCbBoyc1Mis2KJadacY7eo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6iMIyUOlFsWOyFOedg2mkCpFxbE1CGNzgemLj516PyA&oe=69C3D21B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3Xw3UcIbfMQ7kNvwHR7iQY&_nc_oc=AdokXge6R-NDzrAr78RwX7amQwZN0iNvrmulClixj7XjdE7Dd_A7JuNbVtjJb1yNgwk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhICbhYYuJlM9I5cLp9d4VGdyXKkSW-HyU5Pt5zmRz0A&oe=69C3E338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOqWiSgyET0Q7kNvwGBRplR&_nc_oc=Adp6HAqCwOt8gK77zpi1ko_D_XsnnRXX-54wV1XM0Dh5POKqqZz3ld2VvF9Fxt4liK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNpgE4_yHFz0q14d3SKR1kH8ru04hrVzBuAJJHLmJKzA&oe=69C3E700"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
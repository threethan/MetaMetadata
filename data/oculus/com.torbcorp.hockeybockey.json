n.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js3SRgRIxPsQ7kNvwF2MAra&_nc_oc=Adpf4QwghYWFcmJ0vAwT7yz1bqprfVoaWe9j6RMP7fmWK4pzmK3NGLjwq1VAGrqqvi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9opLos6TFHEJp8wsdtJGUiqQz9s_aks7p0tlLGNW6b2A&oe=6A2EB9E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PjSBjo_-xIQ7kNvwGzqPWZ&_nc_oc=AdqYOoE73IDCQUiDQFiVMpa2MX9YsdQt72_-QyyA_PfC-2mF0P8wb2xymjMP-KfOSjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_apmHEwgfw94QB0wAA0PBwZAr6mBYSFqYdg0zgAKDUfA&oe=6A2ED3DB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DEkXGKPDwYQ7kNvwHteP-D&_nc_oc=AdorkRREpvZa_TeWs6KJ7rFbAb9TqiJUGuskVGvbiiV9q_X3h1mJN_Jf5lXJm0pTrKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0fO1-E586AxcQIgcKB4UjQjtV1IfrCbRc_R74raflzQ&oe=6A2EACB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhtOjtyv40AQ7kNvwFCNcBa&_nc_oc=Adozirgeq7SsBGLcsu3pJpsT83scL4OG2QQqtllxj3aCFc5rOzzSir3rA29upilqi28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Eooy5pRVloEVbwC7UPpHwCic1fnpN8KFEJlcD5D_1Vw&oe=6A2EB080"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://torbcorp.bigcartel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "772431210778389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195905_211003350983031_5749559701408537037_n.png
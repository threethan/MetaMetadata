.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8A69bwn5RQQ7kNvwHapULY&_nc_oc=AdoHsn6zNxkiYRo3dxE2S17rx93Tq7Wds4mAN-wFWPtCsaxyRNDqhb28ntMwpx1vk6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuXBxG5_ojRl1TCKeQ4jwAuTY3GH3mkpnmZCZjZnLwMg&oe=69C299B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3IT11fQzJMQ7kNvwFwi3jk&_nc_oc=AdqLzP6jNloql8QIzX_ifAf1mA7BJcdVwBco88V_M9_hsNG6bgFTElnlJ7MjH4Mobtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsivG7wnyFQNM_1-lsQi6NAnjwWgMDAdhjDZAO9hOXIA&oe=69C29AB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwzkesIo_L8Q7kNvwHxpKJ1&_nc_oc=AdplstbwTFwFWP9Xy1GZ_F2aEIWTZbZDvvt76YNEHaCXxVUeS9L0gY7ynUsZ9sfBJc0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxpl6eYJs92mTxxeLZq5UmoyZjohIdV0RXN5m2cG1bCeA&oe=69C280B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx9sA0dV5ycQ7kNvwHjFrq3&_nc_oc=Ado9IrpVDza7H4vpzSnKJ8YvUL8z6cvoNssB9-tfFWJs1w6-1u80ApJawbRuULZobqU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyd_ItqhUkkMbI3lxlRL-GuVRzxs-GAkLG-Q9w-Pp_1pA&oe=69C29EE7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyI7g4ekr4gQ7kNvwHaVavm&_nc_oc=Adr5RLDyX3WKqNct1zjomK8Q-6B2TuGZaWYZuaZio2mATWwqFjHEoWoh_3CBe-SC9TU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzD0VmBAmLZPSSUO2RgsZ3VDxOTuan9bpICE5W5smSg1g&oe=69C2809B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3Xw3UcIbfMQ7kNvwG4lCIN&_nc_oc=Adqw9kQ5tmY09s7SEQh-lfc7xwV0vLHPnS9JnJdZQc91QguUFi9Zv1pjxFxsHu-Zyb0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCYZA-kNdWjvd_29RqHcVjaNPYo3IxPVVJP1wWNkpskQ&oe=69C291B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_6FmQ4ipQgQ7kNvwH3EVFa&_nc_oc=AdoHoKryC-jGaaOtUE89vpzWjWQa6dnV93V4nvc6q_2ahXfDs794_RP_z_RhqwOo7Zs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOte2Vc2w5ky22ov5VbBMTcwzjrQwNQxKqCQ5nD4msRQ&oe=69C29580"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
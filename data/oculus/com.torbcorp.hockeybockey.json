.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3KddA91bR0Q7kNvwFec7zs&_nc_oc=AdpK-ub-2ZWyhTqA8vtOfH_h5yYoNzl-lCukspMGp5lijkDe-ku12UdUE6lWiizeYQE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIduuXdMEaN59sMxIPA_tJCXH0At0HEKI2MegZpMW7yMA&oe=6AA16737"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKe3gxVvTvMQ7kNvwGkLaTA&_nc_oc=Adq3WhRQhBjdPHkR2AsoCfrvVRi_BfHlQwDI2WlD9siBA_d-vwHALrpd0v_JTLGv3nQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDcgr9TrCnTxTSqp22fjFmlohhc3GIH20c9zr5bMck7w&oe=6AA16833"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10scrFzcT_QQ7kNvwG7Bfu-&_nc_oc=AdoqPNMpWd2hkTogZS7ea33-n2r8C7bVAE_SnuBj_71iVQkT9yI2ydLuGnyfBVww0BM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGhKHNydReAFAQ2lZ01yCr3FMEkM9O0B6HJ2tWVGBd1w&oe=6AA14E39"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5LnGP1UXq8Q7kNvwE-RiQA&_nc_oc=Adp2XOlweFThZsUpazJ590ixinro09DHWNrrRQKp5g5Fm4MAODR-C9FW3DdG_fIl0bs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEhN61Ma2gc7ccCjZOzuxdHweAlxp8FMIL26D0MXI3kQ&oe=6AA16C67"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJp6vxr0uBEQ7kNvwFWnauj&_nc_oc=Adqjdf_JkcQMtR7FYzXCnzKTIdirValei8XfDDb4rR5ApLneSMIsFkpi8-ovqfSnqfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkwxcMqXYmTgEBM808qdwZ6wYEAdvAjg0TggPwbxOyRg&oe=6AA14E1B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShPCoV1zMhQQ7kNvwFCq6pX&_nc_oc=AdoMHZkubyHZ2qEDUAyFs9XltWLuHeSv0qFnkclQU3nWeVRZ9n9SUX3xpilRe61sYww&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMKOfamM80WBl4g05lIzkGHPPYLUSmQRsBBwAMAb5-yA&oe=6AA15F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNhdnYBPNksQ7kNvwFx6f7j&_nc_oc=AdpsFrBfg-alflY0tHjLJZ4sDcXCsCLhNDhB63w7-O6p-S42Unf0azjPNjtzU7fr7Hk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH4cxHmoQD4bzEYVAhkMAD0vkG6PvmMFTaXkEuTte3fw&oe=6AA16300"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
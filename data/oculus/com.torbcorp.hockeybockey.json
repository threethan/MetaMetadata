.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwDotanY6HkQ7kNvwGzHokv&_nc_oc=AdrsrgwZxdBZ74_kyNzc_CC_g9R200XjzOLopQrRKfIfnU8O4xo8FibB9_anic1cb24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ykWc6kBDpbAeho6L03xYNgFtR6wNJNAp5uXBGbtk0PQ&oe=6A3E86B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4cz3ao1KOcQ7kNvwGtXi5T&_nc_oc=AdoOJdNvR6cya1tdQxpaBPPPNWP6jRWYpFJIELjzxeFWS6mHUkmwxlQ37VOKCGOJr1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97S21irG9a17NPUOd5TFAOQSxXeKOXg-wRmFArEB-QZQ&oe=6A3E87B3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsLMzp8BuGMQ7kNvwEiIYQT&_nc_oc=AdpxhoNCToUHG9odFOkWT74WxiXXVUecih6AWx3uA3q_mZjtQ7yThWwJOwPZkzmOHSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B39NyewiFZAbhYLu93oC9pR-VI9Ztb5X3jkclt3cNXA&oe=6A3EA5F9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BfyhQfgSAsQ7kNvwFbrHyE&_nc_oc=AdqXVbOtzCC6tCv8557L7mfegqNT-F1idImRRa1I2jPAh6sHt848hoMtIFfVf5MPOfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94lSQiZ0RG5rDidgg5Qn16xVHh-0k1dJnekoiF_mxe2A&oe=6A3E8BE7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDLcEgx6ZIoQ7kNvwFghecP&_nc_oc=Adr-wz1tLfEKcJ1MIKM6oef7icDqsmymSmh9_sZaZ4j5I2Xd5nKg7F7PV-ILPqagWwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-H-fZIuL-Itsa_g31yPvUTnS_pDzcdNOKQjEvCGZfJw&oe=6A3EA5DB"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3WD8B8GIs4Q7kNvwEi_SKy&_nc_oc=AdpvR8giR6Z_p3WHP0zqCwLpgKZBFkDL308NXYnIQT-DMxGCdLYNxSQS8t_tkCceAJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M21mCmwMF7uEkXOqyakveseX3gpQWst1a1PDCwHuUJg&oe=6A3E7EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7GAUM7C7AAQ7kNvwHbBs5b&_nc_oc=Adp-D95wig6l8IQmN-pdvLd9c4wqAMBIYTh2MjkUy2cq1f_082AFixC8UI7-1oBl7bM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98NLnV7aOB2UG__Tu2-bSt4W8FkDMSci7s5m-cULrKBA&oe=6A3E8280"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj35W2RSiGEQ7kNvwGCuFwl&_nc_oc=Adr8FxqYkiveYK29KpTM_7LpCCHEBtVqNYyHa3Jkt-TrJEAQhsix2Iww2LJkWwn-EMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3n4hSbf9fxZX3aCadNzROSOVLKi3j02KdTW9nyCN6nkw&oe=69F8A737"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46p_T12DnbEQ7kNvwEY3ZPQ&_nc_oc=AdqwkT_fcrrHGVxA8HB73hyH3bNgz3estob8ZGrh0RtorOsQYMfb54oAWw6ftHVjgNo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29yks_6a_4HRkFGvVpteAUWjfDrKbZ2toGNVK6fgCHBw&oe=69F8A833"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y73XDQ7OjoEQ7kNvwHB_Jgt&_nc_oc=AdrwUcjB6-XkvH5VaSgw12SZQFxRJIxyYisJ-Ba1z505xO-cahQ_wqx1MjuBhL0R5pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wH_L8HgTvdIeJwKcgSZb7wM5bFgFjgzyp1xAivAzjYA&oe=69F88E39"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1sWphmrybQQ7kNvwFB9lKR&_nc_oc=Adru9mH0TnN3ygkMF3wN3mDl7D5alggjXSU2TZZFjrwS8IwOowp9587kaV7XyM5Mi3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36LcoLtYvKeIRj-ep_K0yUzeVxl-jqrlQzZtSOfHC1dg&oe=69F8AC67"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klZ-VCthHYsQ7kNvwE7BGbT&_nc_oc=Adr3lpkcsw57zde_rc_96lLwOeL7Dg_PrQ41tMXAYuEMCIDKewEIWwJY3uuhwsLFhJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RnF1GWj76I1jaAQIr--7e0fkeDrP5knXJl7uekIwmEg&oe=69F88E1B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArXOm3fbgvcQ7kNvwHF7CRC&_nc_oc=AdrdJ2Kjw-J48bUVlfwI1QJoNKhRPpvKXy0697iSE-YslG2b_nfW8B-iMporrsaRp9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Q9tEvJ_dkISeI7zwBrVK4HSBAddj3jt6yxr9FpsKKyg&oe=69F89F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qZU15hhKSIQ7kNvwHPNlFY&_nc_oc=AdrJXVQ1IsfRjO75e2eLuYBfuSphPGxQWb57uD3CMnZhrqpgPoW8MQGsqoN2Md53gus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2U8LGHGIQNWzarAX86UrPb4w_wNZEwFkK6moAlVa720g&oe=69F8A300"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
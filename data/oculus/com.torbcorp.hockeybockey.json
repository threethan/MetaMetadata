luscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQhXUjc7ckYQ7kNvwEzKc1-&_nc_oc=Adpm9l8ItVa4FBTCb26ng--jXjx-b8x820VLBCu2xqk84dzTWMpmh2cqx4DCnsP421g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tmW3g2_FJNCvZ0XG5Q_j6dGVe14-KLmkRH65_YaxpWQ&oe=6A11B8E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF1RFvy032oQ7kNvwE7woqV&_nc_oc=AdpQye_OikY72d51vciL3BDc_kF7OhRaxCgjcayY945D85pFXXByM790S12naV_O5c8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nQHGdTZteVSuYLbjvqwd3FSzM8UgC18bXZ39N_h8BeQ&oe=6A119A9B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMBdIIDCHicQ7kNvwEcrPTi&_nc_oc=AdoEjRXtutoeZeAwZF6tHRGRlg3Wbvnn3J9UDb29xQGNg2Ev0QXKMTxsHttR-PEKXfI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YGzAwNSQt6GgtSrpdh0u2tJcTFAxrTakzTT5pCPLnxQ&oe=6A11ABB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90ptFJTi9lMQ7kNvwHkI_Ir&_nc_oc=Ado5Ez-u9mVAyPu7mj2Mfy9YY3Q_vljJM0MiZvnJ73GeiLFkuSIS8lGM25PghlifOG0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6syL_mYdLBdvp_lFt-Yt1gf2VxfJPLhdZKBdrbmsPAuA&oe=6A11AF80"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://torbcorp.bigcartel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "772431210778389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75195905_211003350983031_57495597014085370
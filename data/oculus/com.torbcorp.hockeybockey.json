.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEu1ayA1tXAQ7kNvwGJ8aT6&_nc_oc=AdpzDWBM0F43GZfMCoGMcd0O40wZ4U_lQobs18SBx4sKDQCYtwgyGFEM6NMyFOZYeyM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSMQOV4sYrscs3qvnUb5WEbhDrhkSWu22jo5PVsqDrow&oe=69CFC8B7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNb2vePzgsIQ7kNvwGYMPPb&_nc_oc=Adpa7xPyTUlwnf253sA3Wjk2KSQG8okEcq0Xzc1K8ZstQ6XTtbRfKRNsMGwj5VgybTw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwC8Hs3qry1MdlM0cvUaRq2Xx0ewOvd1kAW3u7uLh_rWw&oe=69CFC9B3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFqS0ctc1TAQ7kNvwHMxkRW&_nc_oc=AdrMVDpdRCZo8yGtlYS_dCLpiuRe7KbxcNSlzFzLh6FuqaniLOTx6MbJnJPrWcr3Kh4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJJ-a07bi0qhXp3xASSvR50MPa02qxWj91LynTxqN7hw&oe=69CFAFB9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Kq4C-13M8Q7kNvwFrT4as&_nc_oc=AdpGg5tNKCDRw06ZQCaxAY5QSLDkRD3mD78oP71afCaX2-qixk-2-U1H25LagDBr9qE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL6rL5WuCsuqkDOuIkTYCFODFD8VC3dOakFkYsmbg7LQ&oe=69CFCDE7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLtCJkQ-OiUQ7kNvwH9coP2&_nc_oc=Adouy35LygDBzpVgu1stEyPUkl2LseRl7BvLLfqo_BJtnFbya0fJuBg2tZmzf_YiXmg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZVu3OsEeSaPGjgnA9-kYMfODV5ci-8sppfE5ftTByNQ&oe=69CFAF9B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyF1q6Xg7yAQ7kNvwGfF0S2&_nc_oc=AdqivMo5Zx820QB8f6emodN32eI7oHJBEvgHw0ZABjpUtpgv4_dTZtBZ59-pzqRfeSY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrtMdo8QJLzzF4WwQ1ThEDNGEJ-gdTH0Rhha1yJnabBw&oe=69CFC0B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXrCxCps8tMQ7kNvwGCJnVC&_nc_oc=AdoWDMISwThHnpAX1eEYTw3ghIIg8pYvctoHxY7eRQjlMyxVtdmrwgCNLu12YQxnRL4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVM6WqTZ_ehKva_-lMhtX7TZz467JnNvCamnZSUb_jSA&oe=69CFC480"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
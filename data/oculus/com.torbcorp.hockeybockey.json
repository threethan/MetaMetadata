.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qtPU1sQ3q4Q7kNvwHp1YEo&_nc_oc=Adr0-EmBfDlkRRiP9DPWHTuTB9wKSv7Iuj24XRVkvbi7tZwshAlSllx9AmkkbGTwBek&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrLauz2cxoMhBVCKgfSL58y_GNZdS5YspnncfRhrnGeg&oe=6A539EB7"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB770hia5BcQ7kNvwFCvHIb&_nc_oc=Adoga7UyLFu3I-DiwilMV1QYKzEHDDJvnEHVNUU_JYcu7qi2SYqtjders0rpjOhQHN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbixGLbxCGr9SmOreHRu2MmmhTcpRV6COQXq4PigkW8g&oe=6A539FB3"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0AvpHYsPMIQ7kNvwF5WXI-&_nc_oc=Adqn5PL7EpGWLMwYwHwX4xRDXPeh26cV17qy2JoeNXY8TMZwMusveeWS28i5NGGMvGQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqOwtu5-nKBsAPRQVattnuOG878_PZRGI4DhBaHKUj5A&oe=6A5385B9"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHOiL-Ks2XcQ7kNvwFl84g2&_nc_oc=Adr1JSm6gyKB7ZxRc5aIpAHyU53BBihFaaxw9qPqHlRtDxvr1dbk7Zyfq9gWrsgF6Mg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDg1bTweZOEHT3I_lkPTwVYYCz2MXVGsYt2enwxWD9fxQ&oe=6A53A3E7"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC2heNGBiMEQ7kNvwFLM7ut&_nc_oc=AdqPv9rypeQhHWqcZ7qAPcqJjv3DWGP_Jn2C7MoKKYE64sjZ3UxgLgh6Om9xdmB14zU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVrCYQMc7rTXRfyXn-q-Di8rglE84yEdiHv7BrHL7YDQ&oe=6A53859B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHdrkoQwTRcQ7kNvwE2isjL&_nc_oc=AdoXrj0oEgTHEpc5_cr82fiIOaZfEC8BqUHovhuz2QOmDCyozukGg6uoe9nbYUVtNqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZHw80wXH3iGsD0xRxct6d7Do-7m2UZ_jBFOm0oiWw5w&oe=6A5396B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kOYYTjxp3EQ7kNvwFtj40u&_nc_oc=AdqFl21mlWuiAQgWm6yLTYdIxea6smU1rG2dwh7Wf8e42GakqXSs0eN01LKooRVejSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_IxCKiaautkDJdezlwPDxv4venDEfKKEt7YrDTIa1ZQ&oe=6A539A80"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
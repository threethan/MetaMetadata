.png", "id": "303649964845949", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974783_303649968179282_8654976638570249300_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI7ItgKR6O4Q7kNvwHcEQ1K&_nc_oc=AdpF0pLYMcn4JrTK81DVemBidJJIxrgc3DmoNZZUZG4HSkDW68SnlBvAqUOTgsX2tk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNTpsJRrHaB_NI4maxUqbxncGcHXsllW9AofQXFy86oA&oe=6AB92237"}]}, "id": "521146039113072", "locale": "en_US", "screenshots": [{"file_name": "shootpassskate.png", "id": "3064098410539260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_3064098417205926_6790402535255392038_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XxiQ4W68q0Q7kNvwGNh5l-&_nc_oc=AdrqvkRajZwuX5M3zBhW1Ht33U0BU0dZMJXz3D1vo9uJufvEn4JxLux2ffFILNgacU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaSD1dsiuZU5wNDHUQGxvgPd0tmtoCiMeE5ip5Vo8MqQ&oe=6AB92333"}, {"file_name": "multiplayer.png", "id": "246648547467655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036689_246648550800988_6981919437889330585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubPTv5EOvsQQ7kNvwGAxTnm&_nc_oc=Adq5eZF0G8P98aJv2kk2tp1f3p3n2eOtRS-oV84VsbpARdgn_SwmZzgSaDJPcYt9o_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnJuSLnWSq1-0Ydltb_hIu0QioO7RFnPBOQQG2YkfmXg&oe=6AB90939"}, {"file_name": "bots.png", "id": "452256255947781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982459_452256259281114_8059256188420868716_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38SFcZBTh9MQ7kNvwGgH80i&_nc_oc=AdpI63WTt9NB6gBafa3Fk8rU1CadT9XL024-VRB7pUzi5SNCaqkapVslTZqRM6eE06Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc3ZcHLj_7Vgy96GRZVBKxkM_ErxdArysWf0j8Ke4A-g&oe=6AB92767"}, {"file_name": "customize.png", "id": "976837239545038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294243_976837242878371_1564667106018058366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmuA1fFY3zsQ7kNvwHIcdQY&_nc_oc=AdqM1MR1YpnPnFxZ7lWIJU8RZlxqm9i0pKsTrcVJq25NBkxq5OUvuPvFuMCm2YYEMnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwjwbITGC36dauuWLq-sjMfkJJdPSEoMI5d4XkTwQCvg&oe=6AB9091B"}, {"file_name": "curved_walls.png", "id": "573951296971980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984440_573951300305313_7063127277047755046_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL_vorNtQcwQ7kNvwHVnBxR&_nc_oc=AdqedMYtQFIfHRenIseowbBVbFQib1XQ0bnOqcRDO9_e4GX0CrvsPQogc8Liap5TdB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlsfk0Eeq7GoeehWkFokcPgXBFN7vxtDIXChVRycYFSQ&oe=6AB91A38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hockeybockeyCOVER.png", "id": "1194531554292049", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974517_1194531557625382_2309043283139476511_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3g3AJbs4CooQ7kNvwFRS0t8&_nc_oc=AdpdvUEJXLby1jrYik4Ha0g8eMCvQwl9_920o6Dgr7iESsxrnha6HLE3JtFy8jRN4dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmug7v82iyqM3_DIQ2_WAmqInfL1HCpB37lYDTho5PAg&oe=6AB91E00"}, "display_name": "Hockey Bockey", "keywords": [], "long_description": "Hockey Bockey is a fluid and fun VR Sport played on a seamless rink with curved boards. Every aspect of the arena is designed to keep the play moving and to allow the players to make spectacular moves and plays with their friends. AI bots are there to insure you never have an empty game, even when you are playing alone!\n\nFeatures:\n- Features 3v3, 2v2, and 1v1 full multiplayer game modes\n- Dynamic AI Bots that can pass, shoot and check will make sure you always have a full game \n- AI goalies that keep the ball moving and out of your net \n- Curved arena walls allow for astounding trick passes and moves\n- Matches are easy to start and join \n- Practice your moves on a goalie in your private practice rink\n- Customize your player, helmet, pads and stick", "short_description": "Welcome to Hockey Bockey...where hockey is MAGIC!  \n\nSkate, pass, shoot, deflect, block, steal, and deke like a pro! Full online multiplayer with 3 game modes! Never have an empty game with full bot support. Your own skill is your only limit!"}]}, "developer_name": "Jason Rosenstock", "developer_privacy_policy_url": "https://sites.google.com/view/hockeybockey-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Jason Rosenstock", "support_website_url": null, "website_url": "https://sites.google.com/view/hockeybockey", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1095032438016867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "153236747023740"}, {"status": "PUBLISHED", "id": "1114467619424710"}]}, "baseline_offer": {"id": "1114467619424710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633970340, "status": "PUBLISHED", "id": "153236747023740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24762164400141371", "version": "1.4.0"}, "id": "610091653313288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
b2Lu1XJe8Fk-LG4uemE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MnXcIU4tfhL5e2RHdzoL-K81bR70K1SF19ow1yKYIqQ&oe=6A3012A1"}, {"file_name": "memoryonvr3_2560x1440.png", "id": "1083770296972140", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828793_1083770300305473_2717869386903713851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psQGIbOQxZwQ7kNvwEwRFcK&_nc_oc=AdqqxEXrNKS7mrS3JJVi01YDzMyQ8QwB_mKyiDpjGfuPRQo20PcRRpBa0RhQGizsoAw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4nj9mKJimC8A-RZE7m-_gwtX_JMfb2FKZKgsdFu-cig&oe=6A3004F9"}, {"file_name": "memoryonvr4_2560x1440.png", "id": "1461411961701967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819923_1461411965035300_1103047209948016065_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J9BNiF5czgQ7kNvwFL4Fi3&_nc_oc=Adpv9yAGXd68mVGFKHN3VceIRiGp6-RvHwa6m8f1hlYjxd9WnKhfadlxFHvwYfYkbTw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92yrvNESOVwBqHk4WUF95e2XgwHVyny7z5oJnUsuVLAQ&oe=6A300429"}, {"file_name": "memoryonvr5_2560x1440.png", "id": "1243661873967185", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830016_1243661877300518_3282026229341957204_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27JNQFGrJhkQ7kNvwGAppIN&_nc_oc=AdoQEpohCJJkNisL7hFYbvDDuPhjM1LHyK9Kgr6POpmTQXEhM0CLt-b78ptNon3e7wY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D-q8Iipoq7JA7kq759AGGcz8U4xV8CvGwuQAjdXqnEg&oe=6A2FFA27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["MemoryGame", "Sound", "MemoryON", "Hearing", "CasualGame"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqwZTBw-lMQQ7kNvwHbNo-k&_nc_oc=AdodyCBjiT9tBIyveXzaES543ezzWv46fYa3u6ipXAqYZ5ZiCeIrl7O3LKvWEQgxn0s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T6_Lkba2q8ob9h4PP1Ub4tPDNZBXJqJkJkZxY0IeGXA&oe=6A3012C0"}, {"file_name": "VRLog
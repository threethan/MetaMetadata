ENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392057_512077475230061_1434959953262899320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5Vl8V1fQ1cQ7kNvwEqkS3a&_nc_oc=AdpfmDEXGqXWJS1VYhNhNCUjHmcq8nTM06XP6OM6EtgNWNlre2uFnsdS0GEoQ9eio-U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcZDhY4OHPUc06u7v5iyaJSoDu1TUk8ynnBAIAtzzgsQ&oe=6AA95307"}]}, "id": "1588977285366757", "locale": "en_US", "screenshots": [{"file_name": "MemoryON_Image01.png", "id": "635017992443115", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391860_635017995776448_2579134807153890108_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbrNcdgB5IUQ7kNvwEq8sWq&_nc_oc=AdqwIfJe7PrNFKgu5tBGTs8yMUmPp0JB6M_z77mG0SPukkkatjkQxLNrafHZYEG2iIw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjbAAo1m3CuGL29d5vZqQ4boAl5oiZwNsHddnQoc8cNg&oe=6AA95400"}, {"file_name": "MemoryON_Image02.png", "id": "1349524126232746", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392104_1349524129566079_6199212429804637360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k80wsL8h5sMQ7kNvwEve4Ym&_nc_oc=Adp40eI3t0XpvOtCmEEcEIF_2mLi4kKQ3LslkiEqrdoNnvFvMWuYRzx8rBqK17_CUtE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8tcrKGcJOQqX8T_MTwxbHc79wRAgf8KvWxrz-3WmBmA&oe=6AA93B79"}, {"file_name": "MemoryON_Image10.png", "id": "2011591802584545", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392167_2011591805917878_3075890120299961108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L8KeSoisCYQ7kNvwHMrzCR&_nc_oc=AdpJOByaUjt4Lg_yegT6oKONjmJ5FWrhq9dcnNioJW0sc0zhuMP7kxTbQhkg1QcxKac&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2C_ow9xNRnrXFoMCKFpuVqQwBoV87IAjAWz_Q3Zh8CQ&oe=6AA937FA"}, {"file_name": "MemoryON_Image12.png", "id": "1160942959018552", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392129_1160942962351885_2785998564477031950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR8FJpG5P-kQ7kNvwHRHb61&_nc_oc=AdrrQMqcjKv8pMcy_pIxg-PEJqS_-Ez5zQuU2RdGupDeTGE-hHwUwDILP4ZLnfCL7jE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIdvKGzfhoBKQn9KCLTbMK0drRKxIodZ7ev2RyVEjFpw&oe=6AA946CE"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCfUkM7MjU4Q7kNvwECULO6&_nc_oc=AdrPeJbrAIEQ0uLkdV_NJz7ZCvNO6gQyR9NkS1s419KxsBo55CaxdEm5_MwHwqSG9zs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKQ66UEIC3TznrVmBBjZOrp_2SilU7VsvO0kktq1osFw&oe=6AA9489D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i1RM8jXUM4Q7kNvwGd-vpK&_nc_oc=AdoAohSd7G1Iti83wDqXoqyFf1VRWQHa1C_yX6e0xZFzTvFwj-YF6z76zStVSHmok9I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzt3Hr2wNqrVoGNgFZq6R1_30emBUugVCCsEm9SWhhcw&oe=6AA95CC0"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vw6kwnp2TToQ7kNvwEBYEaz&_nc_oc=AdpHVRHUbS-nVR8uj5c4xvqXyfIImpt9QfQ1JNTIRjmDYE5iHeJ8JmHirIUZW7x8_Ko&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItTM_YvIIUKEqr-k7oU84QEeTOMkEbiKBHfsziC-vUSA&oe=6AA9626E"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lSKxEyuMjQQ7kNvwEOJqzL&_nc_oc=Adq8TAYG9bGB06q_tlJ20TZxoGfMoUI3fg
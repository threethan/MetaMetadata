_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392057_512077475230061_1434959953262899320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTrCZImVRIEQ7kNvwGTJdrt&_nc_oc=Adq7ff1uPMRGBacOcyZsgyF3ezrCX8oTsqMmHQXRRmVQ6YXA0c4OucMKiz64KDhzv0U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIKx_ejIrYvIQA-oyCzWMWJIIlAPhRU7jL5mno2eLxUA&oe=6A8EF507"}]}, "id": "1588977285366757", "locale": "en_US", "screenshots": [{"file_name": "MemoryON_Image01.png", "id": "635017992443115", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391860_635017995776448_2579134807153890108_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpeFua722R4Q7kNvwFoovlA&_nc_oc=AdrVM_8fy7QihMj59YlhaFbvKutXOTXbuXLjm3r5XA-iVspRFa_DZGj1spJePQ2hmEM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgaRH0Et7WjBvI7p-VXO5FGstSlvs9UvPKYv9MmYguqQ&oe=6A8EBDC0"}, {"file_name": "MemoryON_Image02.png", "id": "1349524126232746", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392104_1349524129566079_6199212429804637360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YTIbjksX9UQ7kNvwHR4B9s&_nc_oc=AdphZXwoWXI_VE1s_B_JxOba_ZN5TP3kHT7EHaSKKldrv0cwhiOb-rHkgBL6nY-rp54&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEABaViVPAHl0qzJyDdEca9_VdtDbTmjwygcn03UYn9_g&oe=6A8EDD79"}, {"file_name": "MemoryON_Image10.png", "id": "2011591802584545", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392167_2011591805917878_3075890120299961108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNImkbZYW3kQ7kNvwFcDgHu&_nc_oc=Ado4UCA7JAzZ_V5i0ctnv2zOwqOhgMCy9L4S86tAeup28H00SI8RbpwVh6o_rDbFuSQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqXkdA2EyORp-H9Ev9zedL4a0aRjKFpInJFaxNVl6cFA&oe=6A8ED9FA"}, {"file_name": "MemoryON_Image12.png", "id": "1160942959018552", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392129_1160942962351885_2785998564477031950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVa1SiQ57soQ7kNvwExMTgY&_nc_oc=AdptQdWxbTdQaQ99rjF6jIWfa7uyfZBGC5_DDdxG_fVyKMXpzZI7BWCRkb5zyVXbcLg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp-4rmvrcwFjl1KTik5c3QftGrPGslru5l_kyyzy6lxQ&oe=6A8EE8CE"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azqVfWBqkk0Q7kNvwEMvGgF&_nc_oc=AdrYpVmFD34TsWp-X3yU2pCC14eauJ9Y1169H7JIdIi1sOAL2S8CWgagRqeXodZnrPE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa-zHqxMTieyHusHJx0PopoTyCOI9_YrHw2E_uM3bGnQ&oe=6A8EEA9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhVQfHpZPuIQ7kNvwHut4Po&_nc_oc=AdrcB-6d0RQLPAvYE5JcyfBBUVQsrjt0uO7MO0lc2INaPzQMff1HE024bYBaXso8JaE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5V8svg2YoRJIecWfiOs-xTIqKU3kRbX-oEoXSOXDJmQ&oe=6A8EC680"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny-uH2v0T1EQ7kNvwH8lXkX&_nc_oc=AdrbM1qKGSE-ybK6MyrkPzFTSMEdKy_MVVL8RRUN3MRMhXb1qR4er8ElvXatkE16AE4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhY1NASlFQj-O9_EYqiwY6bcdJ8vTLyEnqYFdtTPw7lA&oe=6A8ECC2E"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm-oXDBU8xMQ7kNvwEdcl9m&_nc_oc=AdrfWfpadLL-Tyl
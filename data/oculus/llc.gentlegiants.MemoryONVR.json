GxwVfDbYl0gq8w&oe=6B0B3AF9"}, {"file_name": "MemoryON_Image10.png", "id": "2011591802584545", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392167_2011591805917878_3075890120299961108_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgewOvLavkUQ7kNvwHexHWh&_nc_oc=AdrQI2tz9DVlCIxwYiHhqUfvQRHtnQC-vFTXEjU8XLUjxTHd-GLJRtNl9Tz80fTeqNQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSL0SyZO5u7vVkDnyf09LPrK593sTKGBz6U4cDYWSn8ug&oe=6B0B377A"}, {"file_name": "MemoryON_Image12.png", "id": "1160942959018552", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392129_1160942962351885_2785998564477031950_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGtwqA6chmYQ7kNvwG9tQoq&_nc_oc=Ado-_9HEfkEzhVpGuSXhMiJt2iSnYKlAgF8zxxkVKMvrD2_X5pfdMNs6KeppGCV_pQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKNYvLDDOTGdEyww9I2kbusRLEaPpcOlk42x5HnB_jMg&oe=6B0B0E0E"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsIhtczLIjgQ7kNvwGdd6Ps&_nc_oc=AdrLV6gkgnTHmTh3cmuwJ-vL7jl6w_-qEiEntixYjfDUBpSGs3q4Gar4oEUSOhJ9iB8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTiFKN_2DJdIQd5jJ0pxr5e9j8tnFdijUo3l_2QncPJow&oe=6B0B0FDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnkOqHP97DUQ7kNvwEZdzvT&_nc_oc=AdrCmwh6sU5SGk4gviaJwO3bKkyNYXT2zBeu55upp6NbZdBr6q_benW4IO4HsW7kmmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_BdOvsnUxUoFoqkYE6cMrs-trZFx8RfgjdjrbX7nGIQ&oe=6B0B2400"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type
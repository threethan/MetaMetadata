ntent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfydWL2HkbO5ZJor2QICpZENekJ05Ui7FiaW19XncS3WKQ&oe=69B16CCE"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MTmKPZWenEQ7kNvwF06sy4&_nc_oc=AdlJe8mz3Wu6gRvYrwLbsJ0Jdg6p1ZOMUc6-UK9xsc3yBMwLwEs2GCdDEkrG9Hu1mzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4hiVTw60r8i2p9SxlAYdTL4mnTUxxtadOzaHb0NSYXQ&oe=69B16E9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKqdlIxmTdwQ7kNvwFdWFd7&_nc_oc=Adm6dV3xK_wCkgsVJdC0KwcYyA2VeOkEDQsT9d1dWR7B5gyl1rcyox0VwWI1DR9gb50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFgdRohRjtCvJ9VBSqfDfFfx9wZGOpLcQ79yK8lY7OcA&oe=69B14A80"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXL1LN5veIcQ7kNvwFZ_IWy&_nc_oc=Adn3UBxlDoYRWh-Weag8DaQRCPy-U3gqjF4XccNCMadURqUxT2J04urNnxyvvF5R0Zc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOCf-U7mZREEXxQwZL61kH7QTTjErz0ACfpQLGOmjX0g&oe=69B1502E"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cioJCYN4fYwQ7kNvwH22nDO&_nc_oc=AdmuLq1wK0Oj0rDwLekTct_u0jnUhhq2IirrLKXbKEi05NY8XZ6VWYQTwad7jCx1zIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXo9YWj-UqeEMlmuAX6QyF2MHpvW_rVoraIsdzHsR_7g&oe
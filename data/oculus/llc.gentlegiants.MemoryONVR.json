ntent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDbIloLj_Q-WkYwu46o6o0UKgvrbSU_5REWU-a6jZkVg&oe=69B8044E"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaHLGNmm_EcQ7kNvwEGfbuf&_nc_oc=Adm1ODuoZH6dEVPPIkn1IAZJuIV6Wr5HRUHefnFnGTrha4aaBcS2hraVZZO4oyRr_xk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5u25kL8obuiy7qP9LswTP0bbsbgncXb4Vp0VROCqzaw&oe=69B8061D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr3jPMnKMMQQ7kNvwHf_kBx&_nc_oc=AdndDsqZg6988Gc0oQQDBXGKWM9sv9e3_K3ZXkGoGbKu4t8YM6zK7s3PsmS57_8I6ZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxsw1U7Cy3PO_CAiH0iMA5qKuOB5uoNVZWVJpIOtnYQSA&oe=69B7E200"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So8R14GMB3MQ7kNvwEiIHEy&_nc_oc=AdnGNngy31gDEF4qAjvDQ-K1kVT_srpjaFWgV3GMw-pXYj-pWqxnOEvMyt2BQFR2R5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3_8f6CtuoWL24WOparrUUFOY0iXSB1FMsQ0BPsEImWw&oe=69B7E7AE"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltK1aXoldY0Q7kNvwGyFaiK&_nc_oc=AdkCwv3GcyaU8mKhBg-FiX1dqU0sdLNAgGs1h6kLmkkaSg9uV-ZFcvJaP1zuCoPfnMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHHoyT3Ia89iD3tVsqnMRjJoolI1v7xL5Des7LP11Gog&oe
BhoEohyYowZ560nN34Y6-cD2bbizK0eq-w&oe=6999BE07"}]}, "id": "1588977285366757", "locale": "en_US", "screenshots": [{"file_name": "MemoryON_Image01.png", "id": "635017992443115", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_635017995776448_2579134807153890108_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLtLhUtnw2kQ7kNvwGl0BLP&_nc_oc=Adk1XYW0w4Vj0imbl_XNhKtW3nKmuiV4PLyOqwsSA5zsSfEUc6Oaw0siWaBA2atkBy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMwEhTMHcjEC5EkgTyVjoEtVpRpVlBaasCSGpOFSGVSw&oe=6999BF00"}, {"file_name": "MemoryON_Image02.png", "id": "1349524126232746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392104_1349524129566079_6199212429804637360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97VCuCCi0RwQ7kNvwFDu1gi&_nc_oc=AdlDArt__KZ9FbYR32Ue-iYKL31Yq5wJOs2Rx0qAs_QX-FJAQdqya_tQUYV40COi8UM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqrdZ7qFX9NWktYk9GLS78bhzI8Oi76bIqrW0sqTweDQ&oe=6999A679"}, {"file_name": "MemoryON_Image10.png", "id": "2011591802584545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392167_2011591805917878_3075890120299961108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRxxmveWXbEQ7kNvwExIEzT&_nc_oc=AdmFjbxnGQkcyYiz6Lx-WYuFkNSos7Cg5sWzQQEBXhaXG_jfGc4YW6JbQraKp2Zxr9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvW9mKQV2RQZLz5M7w-ggE6LFG7KsPQFoJu3WdXUAL8Zw&oe=6999A2FA"}, {"file_name": "MemoryON_Image12.png", "id": "1160942959018552", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392129_1160942962351885_2785998564477031950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf2y1yLF1FcQ7kNvwFClAQN&_nc_oc=Adn7lrtkeHeqYBlgQEiuf7uU21FQk7L1vpHIItHNnAnSi5qk6gvA_TkFk85o-2UJSvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqC4nj3cY8km79lqH1gaEnBMeB3Jbs28ttLsdz4_lZHw&oe=6999B1CE"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHDD-qrHmQgQ7kNvwGioaRH&_nc_oc=Adl3cawKc-Nk5DA6DJJ4muJ5_NTTZcn_QiqGuyY8Prs8bQzPvcmgnTo_4QmB3e6qhuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZ82TDPECUCerpl7-23pvBH0tyTmS7njNyHrB6CzpELQ&oe=6999B39D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WWBYmEenlIQ7kNvwEWqhyE&_nc_oc=Adlo_-gYo0hBIw7_zPBI20Jj0nnqHpbPiJ8isMvqicH5b5aAxNPz3C5CkZZZ25eGQzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNYWd_tvdfYEcKMfwAGJ-qNJ7_f2Nge4i25vxsptN-sg&oe=69998F80"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld8aeSAujkUQ7kNvwFGP7v9&_nc_oc=AdmtqudZ56X-EZ_wInF_MFXkO_0F1IG2cK_bgGLtXExHuls-xuVpI5mBHGt4NENlpHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIKqomjZtxA4fhyhS1bGKUnjWyV2qFdM5KUjXg9yrt1A&oe=6999952E"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ce0F4T_e_8Q7kNvwFBPdWV&_nc_oc=AdnGtZhwbFcp4tjLms2Qbsu8ipBW0OaaLSlywkY3c6ygomEWslRcSIoE8S2QH9CoR18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1q4KrW2fi-HfJPUoYrTtplYE_OzlkYficAK3fnCyaqw&oe=69999FA8"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc2560x1440_\u669701\u4fee\u6b63.png", "id": "1213016317492467", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391864_1213016320825800_6917027570590540268_n.png?_nc_cat=111&cc
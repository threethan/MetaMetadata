q2xvt2MipalrDAG6-JY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sO-uh-vglf0YGVRru9QvE-u-iEc540H4I3Ab27SVnCw&oe=69EA3321"}, {"file_name": "memoryonvr3_2560x1440.png", "id": "1083770296972140", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828793_1083770300305473_2717869386903713851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dnc9b6u59TQQ7kNvwFEtd1V&_nc_oc=Ado8KHKmO-l7Jm43h5iGe3bG2O4bQqKNlKSTJ_WPRgLcmSXWD46HSOVIHlkFwcvKUHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YWulOh5ZVSqaG1vtbdGmtKvcXQKimAL1hF2SIJvy3hw&oe=69EA2579"}, {"file_name": "memoryonvr4_2560x1440.png", "id": "1461411961701967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819923_1461411965035300_1103047209948016065_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCHVuLCO1FcQ7kNvwF-zfUy&_nc_oc=Adp-okYCoXGAnCcgJej1ksQLpClp05zJBHsuzXX6ooobuyEaHbrnILN52L6dyCiWnSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Tq4huXtde9gscSv78YF6qWMC3eV2X3a37eplAjUoHfg&oe=69EA24A9"}, {"file_name": "memoryonvr5_2560x1440.png", "id": "1243661873967185", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830016_1243661877300518_3282026229341957204_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCBoRXH8xi0Q7kNvwFe_KDg&_nc_oc=Adov2C4lJQeGJt7yKeWRkIRGxUXcN8JYUQC-HHdrIQSQMrhmqQEHUvVCwmu6bAFKZK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DzActHYNKfnh_yYjcKIlfkWW4cKunFZGesNdmffEavA&oe=69EA1AA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["MemoryGame", "Sound", "MemoryON", "Hearing", "CasualGame"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQTzl05DpgwQ7kNvwHMo6uQ&_nc_oc=Adp_OFNAGPD4McH3RjN7JANxByRDK7BHZeK08BeuijtP2Wuit9aW-dkE98VzRQDoHZc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r-Q4lxGN8DcLV4aU0Lsc6_AJl05-3YRcTh3MX4plImA&oe=69EA3340"}, {"file_name": "VRLog
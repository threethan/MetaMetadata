mky102eWGGnM-4hRmY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGHjQba16_cDT99osChWsOzHYZ_OT7ECPt5GNe8As5QQ&oe=6AC26921"}, {"file_name": "memoryonvr3_2560x1440.png", "id": "1083770296972140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1083770300305473_2717869386903713851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr-sG7912NgQ7kNvwFPyaX-&_nc_oc=AdolmB5o1sXTjGAyBRsR9nlDK0hqTadBNTvulMEUiKb8rz7QVyyeDJpdc88WaE9hRJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRO-xYIu4xrm2ehUMRk8fBTiMvjiPSSYkqAxFL-Y0i7w&oe=6AC25B79"}, {"file_name": "memoryonvr4_2560x1440.png", "id": "1461411961701967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819923_1461411965035300_1103047209948016065_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYmCtF3hNi4Q7kNvwHweoSl&_nc_oc=Adrw_vFuE_Kn3YfUSeINNbRrksaJ3OE0QLYcBIYY277zQM4IfZceeKEliXF80Gl6exM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt6iXBlIzQmskQfn5TIFX3gFTw_rtcqgE0jn-1V38QqA&oe=6AC25AA9"}, {"file_name": "memoryonvr5_2560x1440.png", "id": "1243661873967185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830016_1243661877300518_3282026229341957204_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIKq6GKptHwQ7kNvwGA4b2T&_nc_oc=AdpwwBS2TEL_31pR_v-kuwBA39Uj2iTZcw7sx_GpC9ZsHmRoxkH5XwLJKaEj2H4ve5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuH4Spz3Anw1w4-V8H5DM2bvlTbiOo1XM_jvd6PPPrdw&oe=6AC250A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["MemoryGame", "Sound", "MemoryON", "Hearing", "CasualGame"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4V2Oo-7ssAQ7kNvwEnUgit&_nc_oc=AdqGbIu6QtjprliQBlvcRd9F3CzibIQoDdQzFW7Sm8SnBnHIyVTvzo1-2EA65IZMPmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4X874Nqa3ld9C5ts-AaL1jl3-mkp84ZLd7RRrWrD0sg&oe=6AC26940"}, {"file_name": "VRLog
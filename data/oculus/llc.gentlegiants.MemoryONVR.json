ENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392057_512077475230061_1434959953262899320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti1WsWMXLmIQ7kNvwGasMug&_nc_oc=AdrT9rjjHaLqYuH-kvCi7YCE_qXK8yK7Ug9WaurvfNeDGybrNL0I8MZNEJRQCWNp0pc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zw0mcslieRMD_GCl7fOMrCUuKA_r1-ku7tQd6U6dFRA&oe=6A394387"}]}, "id": "1588977285366757", "locale": "en_US", "screenshots": [{"file_name": "MemoryON_Image01.png", "id": "635017992443115", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391860_635017995776448_2579134807153890108_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pt0vYfdCr6MQ7kNvwFtIgQ0&_nc_oc=AdqPR3za_kLw1yYUK1_9HeUjXNmJvYj6qp9LrMi9oPn6zl2OYBff49RGaaWH9wKDFLo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qHF3ecdtbdnaQ8v9x-zvyOlcFpV5SNdxATgzBxDBhZg&oe=6A394480"}, {"file_name": "MemoryON_Image02.png", "id": "1349524126232746", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392104_1349524129566079_6199212429804637360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5eSdHpYcXQQ7kNvwHXyX_F&_nc_oc=AdpHpnY3Qb7hP9xoPT-hbgOIZhjpAf6jktzL67aLWQ-k637pEl-puKu1n63jDXdqMNw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cS46Ad5oPiK3nFA8pGPiideC0QYrKK-56b59tNRdyCA&oe=6A392BF9"}, {"file_name": "MemoryON_Image10.png", "id": "2011591802584545", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392167_2011591805917878_3075890120299961108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaPmRB7gS0UQ7kNvwHOMiVA&_nc_oc=Adri1uhXf3_oIRYFFnsEqTGNf4FtO7QKP8RpSQDxNcIHoM9cJViZyh5J2NKiRoW4rlU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BAq3v7LBl1q75ewXlFnlbx5dRg0nISo52DyrDVJxIMw&oe=6A3960BA"}, {"file_name": "MemoryON_Image12.png", "id": "1160942959018552", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392129_1160942962351885_2785998564477031950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0D8taGVp0IQ7kNvwGoAR_F&_nc_oc=AdpjdGfzFdLkRiuXNubES6QZAbzczafzouN6Rj3iaHul1pVUZw8211yyThRdtUlC49E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TpqZmaLFlDV7WVOqanrUvdZK4mOoEDRntNg1n_379xA&oe=6A39374E"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKi65Xzpk8EQ7kNvwHPnWTm&_nc_oc=Adpt-2TOr83wZl0arrMCxiEbHPKWNV29-DqxaBHXaD-lwph4Amwpxr_Gf4_bUoWSJUE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HuyTv7UVZae4zwtuylvhRQlIvGx6sa2SvVnB7uxqVgw&oe=6A39391D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj9mEl13KboQ7kNvwG6fBmn&_nc_oc=Adpta_UunD7aHfekIAt2f2jiDG6AAGDSO8_HFuPglWkikfqeinIrQwldDJ4Oi9Taue8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QccsngPRfkwyynleyT0uWGOUEeunn8eKQnJadEtKNpA&oe=6A394D40"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYT4yoky5qkQ7kNvwF1mO1S&_nc_oc=AdoqN99p8--w-UzpMbdUSPu0g9b8j1GbAgtTezXXZ45mZVuSzqZ6vU_mGPFWRoA9loU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YXK-jCTspsPJIdHudWncUkB2nEUWGH8MNeDP8PqJANQ&oe=6A3952EE"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3NLDsH3ksQ7kNvwGV70rf&_nc_oc=AdoZqTKFPGFyKJi_gxze9mbUKYy-uf7raa
gG1MHTEn5hwGnb_UpWTzBTYKAb-pudDlDg&oe=699DB287"}]}, "id": "1588977285366757", "locale": "en_US", "screenshots": [{"file_name": "MemoryON_Image01.png", "id": "635017992443115", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_635017995776448_2579134807153890108_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIda1KTN9rcQ7kNvwG5VmYN&_nc_oc=AdnpZ_6t9XJlHYK746-1iie7MukH-MP8zJ9kBgSNroFeKRAJ1x_0Qzi7waZrLUOne78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfubS0PY1_F513FvWUNr7ziwFRebJof88B6FbGPYvgDCCg&oe=699DB380"}, {"file_name": "MemoryON_Image02.png", "id": "1349524126232746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392104_1349524129566079_6199212429804637360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97VCuCCi0RwQ7kNvwGYSmGs&_nc_oc=AdnFur7oM38Fad4qZs9z2BwW_WzCrpTzzh3HYtNAzvWilPEgiyAZajrhbFqfAp09WUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLZJFt3IFOCe-BMJcxB11VnJCfMsZn-GDGJsCqgelqCg&oe=699D9AF9"}, {"file_name": "MemoryON_Image10.png", "id": "2011591802584545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392167_2011591805917878_3075890120299961108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLOm7NKLZoAQ7kNvwG9pd0s&_nc_oc=Admg5jzLzxzbk9dHW7BKsd-z4wOUbCEOIfqNgn2qwNN3magd4e7oIiRbThn61UhgajI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5-9Y7sOqLcppNQsbpH8eUM4JtJNtYM10Fv7us_sQzVA&oe=699D977A"}, {"file_name": "MemoryON_Image12.png", "id": "1160942959018552", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392129_1160942962351885_2785998564477031950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY_eAB-fptIQ7kNvwG5YV1L&_nc_oc=Adk8-Q7W9olC-8vWnP9kDS5iE3T_DKwxfVVUXUALZW92qYNbrRCbbpet51H8_GRNrlw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftaxXiqB8Mmybu-MBuze8lDG2ZuZMjb_w3P-yxZ2K14ag&oe=699DA64E"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx78c7cFNRUQ7kNvwGbi0KE&_nc_oc=AdmvGMSQiRGdGVbzTdxS-a9xUWdpUEIaBoud7dI_-02ecVrWrlrNXKeGXpCumE2O2IM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftoO7KXYTtwL7XgVXljlBAZbFdG5v1wZ_vdKBigj9lrYA&oe=699DA81D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV9Kw40LxH0Q7kNvwE2pyFf&_nc_oc=Admm2-x7DRfe9XB1Tq-zkqf-oHY7osuS8exil4yU7Xc2ykvy0kidroj48LqMSINg6bQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAtl3iJ31442GVnhUqt8Jmj05sErvQm8X7uTr5e1Lcpg&oe=699D8400"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1_b3QOAmlYQ7kNvwFdV7tQ&_nc_oc=AdmADxCNuVwLqjwl0wdNwtJVpe3JKL8JPoNKaBQrC4ZeIlH6Shu0VduxEdMFR5s0aEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuyJ-6vreM6o3tsm9dQ7h024zHGftnozZpoORZoUfc26w&oe=699D89AE"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARf2nu33r8UQ7kNvwECEjw9&_nc_oc=AdntdA9_ISRNrCzGuQ0YJP4G07PnBRn2ouxOBIH_xqm4uNHaStX-ORo2BSesVHhYOzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuu4S7ekg-vbOkCLA4HAqNI8NjKqrH3IBwiWdbmk3Zqmg&oe=699D9428"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc2560x1440_\u669701\u4fee\u6b63.png", "id": "1213016317492467", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391864_1213016320825800_6917027570590540268_n.png?_nc_cat=111&cc
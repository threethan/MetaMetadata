ZO_DbPfc9TV461WfCc-iOU07TdFbyzCy0A&oe=69986C87"}]}, "id": "1588977285366757", "locale": "en_US", "screenshots": [{"file_name": "MemoryON_Image01.png", "id": "635017992443115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391860_635017995776448_2579134807153890108_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLtLhUtnw2kQ7kNvwEDAkMm&_nc_oc=Adm67UmBZuj16_d-_w5kOdN-vq6vkcAKCBPrI5brxwVxjMX2zXUvqjy28pAEQatCtLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftanPxkLN1lH2U3EeQird4BRpwkF90APHPOlGf6Ffmcug&oe=69986D80"}, {"file_name": "MemoryON_Image02.png", "id": "1349524126232746", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392104_1349524129566079_6199212429804637360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry3zY9gK9ZAQ7kNvwGWbsYL&_nc_oc=AdmNzKjYgHFFV3OZHdl0K6xF0trq108wdIhAuxjvAQ0iLT0k7RlHQAw2nYjYxrgYyV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvbck413vKUIkWYWQ4LgdLqRtHbLpmcGFDRQ8oyBv_16A&oe=699854F9"}, {"file_name": "MemoryON_Image10.png", "id": "2011591802584545", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392167_2011591805917878_3075890120299961108_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRxxmveWXbEQ7kNvwEcHdkV&_nc_oc=AdkDCFv9UhA59CR3M8HpwNblEfVavqRxe5oDjjj6U0csqH2HNPC1afbAYJR5eE5xZT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft_PwUmGZSbvgkNtSvbhpTD0ct0V_fqvey9aQVH3JEcWA&oe=6998517A"}, {"file_name": "MemoryON_Image12.png", "id": "1160942959018552", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392129_1160942962351885_2785998564477031950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8c3wYwjKKAQ7kNvwGS72lp&_nc_oc=Adn_7XF8IvK04aOZ2u68o7ug3eSxu80xWIrkAkIt7noZe4Lb9MPdKeGj-i3jteKnakE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvynPUrgcVVe4CrwXqQr0HxUZS_1L9AGJlaO48WJIWdbQ&oe=6998604E"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHDD-qrHmQgQ7kNvwEnQhR7&_nc_oc=AdnVWjnPa1gqR0yQNPFmEtH90wM94W2fHjvCfpaYRN-6annqb1_LxK93nHkOeM9EvB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvTlPZtmvCXuv_Ct7TvQD7tfQ9Q9JZlX50uDjS_9_cOQw&oe=6998621D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WWBYmEenlIQ7kNvwF6c0qP&_nc_oc=AdmcfLmx5aUCOTU-o8085aB9MRujGB9_c_yrluR-iUjv0cSDbkCF_yuDdlxfxdjJa9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afsank0uReuMWMDXCjdtwvbR3rz_cvuJK52l0cyLudLuCg&oe=69983E00"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gY7UEkAySeEQ7kNvwEk1ADx&_nc_oc=AdlZw7RsXFmFA2VGKVG5OAZfFpDqrDoyZgSFQ6y5SIeIgYh0Mmw_QUwGmyRillhpsgk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft7ttzTUuNjFRoP4obIQKYSFtA5ap2MPzfCKQV2oqlyAA&oe=699843AE"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ce0F4T_e_8Q7kNvwGjBteP&_nc_oc=Adkc2yX9zs5Rb8hbfinuYM207rdFLy3yqQp2FZGS3CpXd4C0pP1yR3PEMWShN1-0tOY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsfnddlNyGqEnYFY3dHTHi2g_L7KXCzzhWLGuo-rPGwxw&oe=69984E28"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc2560x1440_\u669701\u4fee\u6b63.png", "id": "1213016317492467", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391864_1213016320825800_6917027570590540268_n.png?_nc_cat=111&cc
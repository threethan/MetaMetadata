l5e-wQ7kNvwEjAJGv&_nc_oc=AdrACYfjaMY1b2i-FV9z4mDHrb5x3rhjhkUH8-ilgwL8G3P4kxehffhK8-bjVSNHxEU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2Fkeow40hjhEmPhotldrFMm2HGaN8tU2V4XpJNpzBTA&oe=6A6F44CE"}, {"file_name": "MemoryON_Image08.png", "id": "1812287026229417", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393759_1812287029562750_3038311046055852227_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_y0DKWDNFrMQ7kNvwHSykGm&_nc_oc=AdrA8Bp1hGE3iIgqRkT69FzDWkElhH6wkowkRmS6mybaTZDt-Ielue2Vmh82aNijGXc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgJcC0lJU1pDzMLQOo2PDBt8qSXYzAjgz2swoTv75ZaA&oe=6A6F469D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["puzzle", "memory", "sound", "sphere"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Izjsd9BDjb4Q7kNvwGBqLjx&_nc_oc=AdpCIV1e-08hJDEpeVxan52Xyj0TvUjmjy8dtXFB4lbnRW9KE-xwz0FrS0qGY4XeJKU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA10fxwZqKK9NChkZgK9D7WSiQLB8JOuXm4IgYbx7N84w&oe=6A6F5AC0"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393415_3986661201614202_2417986485656763484_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdpzuck7R-4Q7kNvwFwupqu&_nc_oc=AdoDHlcOOvDOoRaMWA8z9-zpc6A9ddT_rkuwvNkewkwjzQOmh4vfQ_MxBu4zT04VwbE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZIDo--y6Tyu3z74usfrM5AJcTcRYKZkPU7SaDnfBhhg&oe=6A6F282E"}, {"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1008x1440_\u669701\u4fee\u6b63.png", "id": "1313444073179691", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392200_1313444076513024_3513542889851104553_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qmr4gVfif5YQ7kNvwEnt_dC&_nc_oc=AdqSNMa-7d0BZ-wxe3VCC2z1ge0iQMBPW1Z6vihP9qghxd0nel
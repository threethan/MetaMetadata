ZwNU89qoejQEg_YesVg32eb_d6g&oe=69998F61"}, {"file_name": "memoryonvr3_2560x1440.png", "id": "1083770296972140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828793_1083770300305473_2717869386903713851_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WdmiD8AWW4Q7kNvwGOIoyE&_nc_oc=AdmcZIpcAjBjbYrbxtrW4v8ZEKyefAd50sAPA0RlKhzsNPm13EnvfH8hJM05QZGZlic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRdpgJFFOgC5-qqHne6apaVSfDUKq6v7gSxZj92G-I8w&oe=6999B9F9"}, {"file_name": "memoryonvr4_2560x1440.png", "id": "1461411961701967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819923_1461411965035300_1103047209948016065_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejCDAO3pFXUQ7kNvwHNCJrC&_nc_oc=AdnJ20i03MPKBFB2QG1JdmqL68j_r_gmcrqvaDoGBW9-4LOxOb5NgIUqj3L1FTFe-a0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNDBcFxmpkHj32g5OgwtUNs1K56Exv_Khg0mEfuUVAeg&oe=6999B929"}, {"file_name": "memoryonvr5_2560x1440.png", "id": "1243661873967185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830016_1243661877300518_3282026229341957204_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id6_UrDchtkQ7kNvwFUhvAn&_nc_oc=Adlv22uhAZx6vzh6K0G-0yl-2wb2dLcGqy4vjT9YHrw-5xUnstmgW20_VWKf_lcT_vw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv4UgK_-cFC1-E-aSCd7IsZk-SIt8zJNVJWpj21OjSQGA&oe=6999AF27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoryON", "keywords": ["MemoryGame", "Sound", "MemoryON", "Hearing", "CasualGame"], "long_description": "MemoryON is a sound-based memory game.\nAccess the floating spheres in space, listen to their sounds, and try to remember them. Find the spheres that produce matching sounds to form pairs and clear them from the field.\nWhen you hear a sound you've encountered before, it will resonate, revealing its location through audio cues.\nBe cautious\u2014if you make a mistake, the spheres will start to deteriorate. Aim to complete the game with as few accesses as possible.\n\nSharpen your hearing, clear all the spheres, and strive for perfection!\n\nGame Rules\n- Match pairs of spheres that produce the same sound to clear them from the space.\n- In a single turn, the player can access two spheres.\n- If the accessed spheres produce the same sound, the pair will disappear.\n- The game is cleared when all the spheres in the space are removed.\n\nSphere Features\n- When you access a sphere that you\u2019ve heard before, it will resonate and reveal the location of its matching pair when the first sphere is accessed.\n- Making an incorrect match causes the spheres to deteriorate, and repeated mistakes will result in the spheres collapsing.\n- You can replay the sound of a sphere, but only on the first move of your turn.", "short_description": "MemoryON is a sound-based memory game where players match pairs of floating spheres that produce the same sound.\nAccess spheres to listen and remember their sounds, then find and clear matching pairs.\nPreviously heard sounds resonate, revealing their location with audio cues.\nMistakes cause spheres to deteriorate, so accuracy is key.\nClear all spheres with minimal accesses to complete the game.\n\nSharpen your hearing, aim for perfection, and enjoy this unique auditory challenge!"}, {"images": {"nodes": [{"file_name": "MO\u30a2\u30fc\u30c8\u30ab\u30d0\u30fc1440x1440_\u669701\u4fee\u6b63.png", "id": "8933961496700913", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392202_8933961506700912_8571304788327845200_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WWBYmEenlIQ7kNvwEWqhyE&_nc_oc=Adlo_-gYo0hBIw7_zPBI20Jj0nnqHpbPiJ8isMvqicH5b5aAxNPz3C5CkZZZ25eGQzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNYWd_tvdfYEcKMfwAGJ-qNJ7_f2Nge4i25vxsptN-sg&oe=69998F80"}, {"file_name": "VRLogo_006.png", "id": "3986661198280869", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393415_398666
, "id": "3817305201923588", "locale": "en_US", "screenshots": [{"file_name": "52.png", "id": "840576764176714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982523_840576767510047_1233626511000937194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIFO2y8HRbIQ7kNvwGQkPyC&_nc_oc=AdqgQX4EbtohWH2xqy97rV-dDDerCx8re_3Ls9iAEtBwH7L6OFG9iQCYl7qEpL5fTA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVa74VCxaTDA99MVdWs1gdpZonscH7WpAVVEvOSUPJug&oe=6AB918F6"}, {"file_name": "53.png", "id": "1014783093604503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65396053_1014783096937836_7138644658079463934_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSaLy0H1ozgQ7kNvwGsDM05&_nc_oc=Adpdx6Ykx7DhcbOrLioAj5O5LstxfIM8sBkbqUXjGbmpd9BjQ4iZeGdDmRTHoGbC1sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0fjx0B4BD3I-EdZ-XKiAaIHT8pVfJr6tfJupJeIhigQ&oe=6AB922E6"}, {"file_name": "54.png", "id": "475448185068453", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_475448188401786_8607710737873502594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHmaRHIPjEIQ7kNvwGdwWk4&_nc_oc=AdoHK3aQNn5b_vM3Dt6YxFiKL2SbdT3AWB1eN7RawQj1soYImGC9WBLgPmWaGRs0kfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCWI5DT0FUxtaOFd2qy3CqGmk0UY17_Ew6_QpZl1tGBw&oe=6AB91E58"}, {"file_name": "55.png", "id": "1433280507226574", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_1433280510559907_4862969394570270898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXI9sv5E9dcQ7kNvwEn8usW&_nc_oc=AdqkdKUtJxS9aWXsJRtYC3jZjFOyUUV36b-gtJMya8_VuGNVkv2ieXcGahP1QN8dP4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIIARdOwUIsdKYOiORaMjfb34a_7ZIvhNrAIfkr8qGTw&oe=6AB92F8E"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2024-08-11 103818.png", "id": "2826183650885015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974697_2826183654218348_5603628300704503615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BUKztC_r-0Q7kNvwEL-z2U&_nc_oc=AdogEJImt8aNyhAeg1MEdmOtjazHDCtEvr7LlZJj7n0lblyIgmWp7mHqjJim4kB5hig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnMfLm4xUe_E8o4s9kIBqXRYQecKX5OMSLV0_Z_-wgzw&oe=6AB92F4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tj66.png", "id": "1132452351147732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035443_1132452354481065_4487249092464197512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DWXUvPaIvEQ7kNvwHB8EI7&_nc_oc=AdqK9_R9gdDtn_prfl5PBXwxLTERZzX6P8lVC86k89Uncpjm5pVc5U1GBtwf9qow6zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmMXcTCc0HDWR2FKHGueGo1SYwPvKut5wUJY-oaQekCw&oe=6AB9135F"}, "display_name": "MyPup", "keywords": [], "long_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, train it, and interact with it, all from the comfort of your home. Each feeding and interaction strengthens your bond, making your puppy smarter and more obedient over time.\n\nKey Features:\n\nAdopt and Name: Choose your favorite puppy and give your new friend the perfect name.\nInteractive Feeding: Play with your puppy using toys like balls and frisbees, and feed it with treats like chicken legs and roast chicken. The better the food, the smarter and more obedient your puppy becomes, deepening your bond.\nBuild a Strong Bond: Train your puppy with voice commands anytime. The more you care for your puppy, the closer your relationship becomes.\nSocial Fun: Invite friends to join and walk and play with their puppies, just like in real life.\nImmersive Experience: Feel the joy and responsibility of pet ownership through realistic VR interactions.\nWhether you are an experienced dog owner or dreaming of having your first virtual pet, \"My Puppy\" offers an immersive experience of virtual dog ownership, allowing you to enjoy the warmth and joy of raising a puppy in a virtual world.\n\nDownload \"My Puppy\" now and enjoy wonderful moments with your furry friend!", "short_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, and interact with it anytime. The more you feed your dog, the smarter and more obedient it becomes, strengthening your bond. You can also walk, feed, and play with your friends' dogs, just like raising a dog in real life. This game immerses you in the joy of personally taking care of, feeding, playing with, and interacting with your pet dog."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/94d5925a-0032-44ea-99f7-076c37405a02", "developer_terms_of_service_url": null, "publisher_name": "Unity3D", "support_website_url": null, "website_url": "http://Game.lvcn.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7838915506205991"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": "850351191218592"}, {"status": "PUBLISHED", "id": "1781729425779790"}, {"status": "PUBLISHED", "id": "764502166150258"}, {"status": "PUBLISHED", "id": "557482484066339"}, {"status": "PUBLISHED", "id": "648583241249429"}, {"status": "PUBLISHED", "id": "1335061350938328"}, {"status": "PUBLISHED", "id": "1523204911896420"}, {"status": "PUBLISHED", "id": "8245027205
, "id": "3817305201923588", "locale": "en_US", "screenshots": [{"file_name": "52.png", "id": "840576764176714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_840576767510047_1233626511000937194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh3z5wcuQlUQ7kNvwHol_CI&_nc_oc=AdpOSw_ILLLDDUtkQQ-rLmyKsetL4kM55pruNN1G--DL52meXYj7YD719D8maMkx7Qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxxA5zgPyrFWfGvPyHohV5ZE0UY0AmKYH9DPk8H2_zXQ&oe=6AF5BDF6"}, {"file_name": "53.png", "id": "1014783093604503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65396053_1014783096937836_7138644658079463934_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCdA6DTGFJoQ7kNvwGnQQBJ&_nc_oc=AdoAIATz6Mcn3Edt5_jLPwBSRKnh6sJt1I2Kcg0YokO7XxvfJ0Jmh80tz-MrODnWlsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHp8agOb_7VkY0RpcYt-FbHdyojm4Ffpn3EeLkCQtkaA&oe=6AF5C7E6"}, {"file_name": "54.png", "id": "475448185068453", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031311_475448188401786_8607710737873502594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv5PKsD1AqcQ7kNvwH7wHpa&_nc_oc=AdpEjFkSOBb9mseCnH4gL0Pkdwr5WQzLRi827T9ywytirqHrRxme1_ftqQJhldRFbhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVjQTYS9nKT8KeWJMZW-JvEyC3DLT1ANCYItNa-iJjRw&oe=6AF5C358"}, {"file_name": "55.png", "id": "1433280507226574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982671_1433280510559907_4862969394570270898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8v6pz-woXEQ7kNvwHJhnXP&_nc_oc=AdpHeA3FkwZgKRRHNpl1UyiKnWtNXYanJIM4cfw4aocjYBdKBWwAAaZreYRVuel_J5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhV5mEQgr722raw94zqPb33FZij2QYrSNq8z4xsERZFg&oe=6AF5D48E"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2024-08-11 103818.png", "id": "2826183650885015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974697_2826183654218348_5603628300704503615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXGzj-hYpn4Q7kNvwGYXO9W&_nc_oc=Ado0wcO7vU7xShkyk51wbn5afHAcNVboBPD9uSxAcZ2b5N1IedXFSAg105p64Ex2laM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAnRVqB2XrHtP_hVk2MU1gj-QvgdgJNXbykyC9yVKrKg&oe=6AF5D44C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tj66.png", "id": "1132452351147732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035443_1132452354481065_4487249092464197512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLZ2Yk-_9aYQ7kNvwEFTwIE&_nc_oc=AdorqiMCLXWGw4FoNEgP-BFMPwa3Ja3F8q7UlsxIfkwchf-AyBpWZZLfnAUNAuER-iY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWy4HEPmSde6VVUlu2GSu6_1n68ZnKPRPjIjepAfhMFA&oe=6AF5F09F"}, "display_name": "MyPup", "keywords": [], "long_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, train it, and interact with it, all from the comfort of your home. Each feeding and interaction strengthens your bond, making your puppy smarter and more obedient over time.\n\nKey Features:\n\nAdopt and Name: Choose your favorite puppy and give your new friend the perfect name.\nInteractive Feeding: Play with your puppy using toys like balls and frisbees, and feed it with treats like chicken legs and roast chicken. The better the food, the smarter and more obedient your puppy becomes, deepening your bond.\nBuild a Strong Bond: Train your puppy with voice commands anytime. The more you care for your puppy, the closer your relationship becomes.\nSocial Fun: Invite friends to join and walk and play with their puppies, just like in real life.\nImmersive Experience: Feel the joy and responsibility of pet ownership through realistic VR interactions.\nWhether you are an experienced dog owner or dreaming of having your first virtual pet, \"My Puppy\" offers an immersive experience of virtual dog ownership, allowing you to enjoy the warmth and joy of raising a puppy in a virtual world.\n\nDownload \"My Puppy\" now and enjoy wonderful moments with your furry friend!", "short_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, and interact with it anytime. The more you feed your dog, the smarter and more obedient it becomes, strengthening your bond. You can also walk, feed, and play with your friends' dogs, just like raising a dog in real life. This game immerses you in the joy of personally taking care of, feeding, playing with, and interacting with your pet dog."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/94d5925a-0032-44ea-99f7-076c37405a02", "developer_terms_of_service_url": null, "publisher_name": "Unity3D", "support_website_url": null, "website_url": "http://Game.lvcn.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7838915506205991"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": "850351191218592"}, {"status": "PUBLISHED", "id": "1781729425779790"}, {"status": "PUBLISHED", "id": "764502166150258"}, {"status": "PUBLISHED", "id": "557482484066339"}, {"status": "PUBLISHED", "id": "648583241249429"}, {"status": "PUBLISHED", "id": "1335061350938328"}, {"status": "PUBLISHED", "id": "1523204911896420"}, {"status": "PUBLISHED", "id": "8245027205
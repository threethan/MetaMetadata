oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOWzYoDzbFhdlFNodvu8Aiijbpl_ajmYtm9LtSJQut6g&oe=6B08498E"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2024-08-11 103818.png", "id": "2826183650885015", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974697_2826183654218348_5603628300704503615_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxycaS8bPGIQ7kNvwGNBYW7&_nc_oc=Adq1Rtuv1LD7DknbV8TVPDQMTo50K2H3KpGBU_0I0S5Mq01HuhS1Jdgt4erm5qjiPAk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGMYdKjwcrNByC3UkXrnqpfO2o7WFfZOYtuek4iXt6Fw&oe=6B08494C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tj66.png", "id": "1132452351147732", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035443_1132452354481065_4487249092464197512_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTLOA2P6Kl0Q7kNvwHvj79V&_nc_oc=Adoxoc66IorU9fw5VOY3bpvhsLVS8kKXVjtOTO0eJ1pWnVQZqx4SsIKL4mDIzndeV2A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThqFf6NvRid6iWjq28BvsD3dJmTame60a5rSC-c_TCOA&oe=6B08659F"}, "display_name": "MyPup", "keywords": [], "long_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, train it, and interact with it, all from the comfort of your home. Each feeding and interaction strengthens your bond, making your puppy smarter and more obedient over time.\n\nKey Features:\n\nAdopt and Name: Choose your favorite puppy and give your new friend the perfect name.\nInteractive Feeding: Play with your puppy using toys like balls and frisbees, and feed it with treats like chicken legs and roast chicken. The better the food, the smarter and more obedient your puppy becomes, deepening your bond.\nBuild a Strong Bond: Train your puppy with voice commands anytime. The more you care for your puppy, the closer your relationship becomes.\nSocial Fun: Invite friends to join and walk and play with their puppies, just like in real life.\nImmersive Experience: Feel the joy and responsibility of pet ownership through realistic VR interactions.\nWhether you are an experienced dog owner or dreaming of having your first virtual pet, \"My Puppy\" offers an immersive experience of virtual dog ownership, allowing you to enjoy the warmth and joy of raising a puppy in a virtual world.\n\nDownload \"My Puppy\" now and enjoy wonderful moments with your furry friend!", "short_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, and interact with it anytime. The more you feed your dog, the smarter and more obedient it becomes, strengthening your bond. You can also walk, feed, and play with your friends' dogs, just like raising a dog in real life. This game immerses you in the joy of personally taking care of, feeding, playing with, and interacting with your pet dog."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/94d5925a-0032-44ea-99f7-076c37405a02", "developer_terms_of_service_url": null, "publisher_name": "Unity3D", "support_website_url": null, "website_url": "http://Game.lvcn.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7838915506205991"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": 
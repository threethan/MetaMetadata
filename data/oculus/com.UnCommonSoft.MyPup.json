, "id": "3817305201923588", "locale": "en_US", "screenshots": [{"file_name": "52.png", "id": "840576764176714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_840576767510047_1233626511000937194_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6X7BjFLG54Q7kNvwGYBVhY&_nc_oc=AdpDP4HLdw5D-jUWARYTqKMBZGRXUmsf1ycejOo_Y5qA1LgnLQPzMS-oy0jgS2jfG6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnv3He9iKC6nFRE4V9pIl45wXac3jfiBbYRVD4eWK3nQ&oe=6AABE9F6"}, {"file_name": "53.png", "id": "1014783093604503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/65396053_1014783096937836_7138644658079463934_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG-hhoqF5vEQ7kNvwE68lFK&_nc_oc=AdoRD1gkGH8w8AuJkj0kdPMQ7BkQrSXtl_6UziBGSmf02-vQ-smt-YnPeQT2LvPi3tE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJypUN9vI1huQDlan_1OMjAQY-Td3K3tRiMI5dxef07GA&oe=6AABF3E6"}, {"file_name": "54.png", "id": "475448185068453", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031311_475448188401786_8607710737873502594_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNx9y5g3Yg8Q7kNvwFs0gaf&_nc_oc=AdpelZaT32IoaKcHUubSbTQDinUlLoL3S0YNkpzudQrlZ8jyzKe2oNA9NcAvb3LeLd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBwEZVIDyqbNfIfTbyvfX6rYL2Xl2G0SZrIvIACwfbYQ&oe=6AABEF58"}, {"file_name": "55.png", "id": "1433280507226574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982671_1433280510559907_4862969394570270898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG6YKAAV-JIQ7kNvwFITAAf&_nc_oc=Adq0SkWDpCNusA9I1uuvyv2BoVEv1Ncw16lFYuK1d-2MG2xtaZ31hyyZj_ZgG_CRQ-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjxeKZoli3lZhVcVhjVWLEHqyrR7VfyLkcL30QJqgZqw&oe=6AAC008E"}, {"file_name": "\u5c4f\u5e55\u622a\u56fe 2024-08-11 103818.png", "id": "2826183650885015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974697_2826183654218348_5603628300704503615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjOf77tF5VgQ7kNvwHlALAi&_nc_oc=AdrdMV2S55X7VNm-dVJHPSRymaJOP2D8k56FepcepHFhif96AVLqMKmNk733XfCfU54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh7z9sSuyh_37Uh2RVtLzDF6zGzYDO6CVZWRapYYep8w&oe=6AAC004C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tj66.png", "id": "1132452351147732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035443_1132452354481065_4487249092464197512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDgYvKPppQwQ7kNvwHAEpPO&_nc_oc=AdrhikMV-37DlPIauXh2Ji6cwxtmTyUmnik2h7vM0_jYDrwtgR9AR7TXVno6JkEkXrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2yobxSw5xFjDNY8gA8lENjwxGliSJhTohVTGLP90Y0A&oe=6AABE45F"}, "display_name": "MyPup", "keywords": [], "long_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, train it, and interact with it, all from the comfort of your home. Each feeding and interaction strengthens your bond, making your puppy smarter and more obedient over time.\n\nKey Features:\n\nAdopt and Name: Choose your favorite puppy and give your new friend the perfect name.\nInteractive Feeding: Play with your puppy using toys like balls and frisbees, and feed it with treats like chicken legs and roast chicken. The better the food, the smarter and more obedient your puppy becomes, deepening your bond.\nBuild a Strong Bond: Train your puppy with voice commands anytime. The more you care for your puppy, the closer your relationship becomes.\nSocial Fun: Invite friends to join and walk and play with their puppies, just like in real life.\nImmersive Experience: Feel the joy and responsibility of pet ownership through realistic VR interactions.\nWhether you are an experienced dog owner or dreaming of having your first virtual pet, \"My Puppy\" offers an immersive experience of virtual dog ownership, allowing you to enjoy the warmth and joy of raising a puppy in a virtual world.\n\nDownload \"My Puppy\" now and enjoy wonderful moments with your furry friend!", "short_description": "\"My Puppy\" is a unique virtual reality dog-raising game where you can adopt a puppy, name it, feed it, and interact with it anytime. The more you feed your dog, the smarter and more obedient it becomes, strengthening your bond. You can also walk, feed, and play with your friends' dogs, just like raising a dog in real life. This game immerses you in the joy of personally taking care of, feeding, playing with, and interacting with your pet dog."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/94d5925a-0032-44ea-99f7-076c37405a02", "developer_terms_of_service_url": null, "publisher_name": "Unity3D", "support_website_url": null, "website_url": "http://Game.lvcn.net/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7838915506205991"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": "850351191218592"}, {"status": "PUBLISHED", "id": "1781729425779790"}, {"status": "PUBLISHED", "id": "764502166150258"}, {"status": "PUBLISHED", "id": "557482484066339"}, {"status": "PUBLISHED", "id": "648583241249429"}, {"status": "PUBLISHED", "id": "1335061350938328"}, {"status": "PUBLISHED", "id": "1523204911896420"}, {"status": "PUBLISHED", "id": "8245027205
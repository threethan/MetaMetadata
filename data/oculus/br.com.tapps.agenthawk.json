G5isNl&_nc_oc=AdrmTNc52HEK1p3gb96pUUk6oz8y3-HIA5-FJX6KtE8vvrpaTkBGLMS6eqRnOativ1s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6LrecqTbAGFXF1x48IRkJvImc8T0sBtf8KWWKe_fbyQ&oe=6AFC73E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Agent Hawk", "keywords": ["Hidden", "Object", "Exploration", "Spy", "Mystery"], "long_description": "Join a secret international intelligence agency and help uncover a worldwide conspiracy as renowned Agent Hawk.\n\nImmersive Environments - Realistic and interactive locations.\nFreedom to Explore - Move around using a comfortable teleportation system.\nClassic Gameplay - The beloved hidden object gameplay from a whole new perspective.\nGreat Replayability - A different list of items every time you play.\nThrilling Atmosphere - Locations and music that transport you to an exciting world of intrigue and espionage.", "short_description": "Investigate locations around the world as an infiltrated agent and uncover hidden intel in this immersive and challenging VR hidden object game."}, {"images": {"nodes": []}, "id": "138497170920634", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Agent Hawk", "keywords": ["Explora\u00e7\u00e3o", "Espionagem", "Mist\u00e9rio", "Espi\u00e3o", "Suspense"], "long_description": "Fa\u00e7a parte de uma ag\u00eancia de intelig\u00eancia internacional e ajude a desvendar uma conspira\u00e7\u00e3o mundial como o renomado Agente Hawk.\n\nAMBIENTES IMERSIVOS - Locais realistas e interativos.\n\nLIBERDADE PARA EXPLORAR - Mova-se usando um confort\u00e1vel sistema de teleporte.\n\nGAMEPLAY CL\u00c1SSICO - A consagrada jogabilidade de objetos escondidos com uma nova perspectiva.\n\nJOGUE E REJOGUE - Uma lista de itens diferente toda vez que voc\u00ea joga.\n\nSUSPENSE - Ambiente e m\u00fasica que v\u00e3o te transportar para um emocionante mundo de intriga e espionagem.", "short_description": "Investigue locais ao redor do mundo como um agente infiltrado nesse imersivo e desafiador jogo de objetos escondidos em VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "zh_CN"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1034620757269207"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162788_1317729141647695_8854365562227130368_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuhmLJqIktsQ7kNvwGhJLDC&_nc_oc=AdoXnev93mjLCiVaDWwsCD7dgOWSVUQualCi69yxaD_XM3PRTS-rhiIOiocWKGszBqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJmkDRVjs4Bib-UZwKvgVVZx6XizwUZm9iyHhFHCcq3w&oe=6AFC9014"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Agent Hawk", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1494992156, "lastRevision": {"nodes": [{"id": "734333466734137", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "637999199658181", "is_first_party": false, "enables_in_app_ads": false
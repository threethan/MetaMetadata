81_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=493mMCQvuD4Q7kNvwH4CzWU&_nc_oc=AdolhgkDUQZMDUKhdV0lOy01nQnihsrB_sU77gLCxuIRiwyHPE5ibLosuozjrHo7BLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9R51Tjoouxi__Ut74LeZYXlgK8R1I0xMKY3uDnvWEbg&oe=6A6B6474"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GAME_ART_2560x1440.png", "id": "839386272300838", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820470_839386275634171_2041471509454028981_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR2FUTi_aIAQ7kNvwEbuKxf&_nc_oc=AdowSEEnPe4YW37lyQE7KYaoe_vTrwATWHwYhCOQkEnjd0spTCLStrf2lBg_U9DM7LA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEAemfZHlzOwTzkXJMosGxkrp7F5WAs0ZHQeTO34SUHQ&oe=6A6B393E"}, "display_name": "TOTALLY BASEBALL", "keywords": ["baseball", "sports", "simulation", "fun", "multiplayer"], "long_description": "TOTALLY BASEBALL: After having the most popular VR Baseball game since 2021 there was only one thing left to do. MAKE IT EVEN BETTER! Updated Avatars and Graphics for newer Quest headsets! Improved Multiplayer gameplay and lots of new customizer items! Enjoy playing in our small fields or huge stadiums!  From 1v1 all the way up to 20 people in FREE PLAY mode!\n\"One of the best sports games on Oculus Quest.\" - ScreenRant\n\"Totally Baseball is the complete baseball experience in virtual reality, and there's no other game that compares to it.\" - GameRant\n\"Is it good? Heck yes, it's good!\" - BMFVR\nFeatures:\n-REALISTIC throwing and batting physics\n-MULTIPLE GAME MODES (1v1 or Free Roam with up to 20+ people at once!)\n-SPECIAL PITCHES! Add curve balls, slowballs, splitters to your options\n-PRO BATTING MODE, after you master \"classic\" batting try the new \"PRO\" option for more of a challenge!\n-Practice and tutorial modes for new players to find their pitching/batting sweet spot!\n-Multiple teams/venues to choose from (and play against)\n-Comfort settings and hand position settings that can be fine-tuned to your liking\n-Fun seasonal updates (Check out new fields and new items throughout the year)\n-Large community of people to play with or get tips from (See our Discord)", "short_description": "Play the full sport of Baseball (every position) on your own or in Multiplayer with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viewerready.com/totally-privacy", "developer_terms_of_service_url": null, "publisher_name": "VIEWER READY", "support_website_url": "https://discord.gg/totallybaseball", "website_url": "https://viewerready.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26831514716467503"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830003_843465305482967_5852506965241961113_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuL0nNrifhAQ7kNvwEaJNbr&_nc_oc=AdqNRgn6Bc5qNGts_LH5rG99x-fV-jb99QbEohttukfMVLbOov4iXt8YhAV0zIBwUxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXc3F3wDHMER5PAWAqAisa5UGmmqmEQBCOFrYp2lQRKA&oe=6A6B67DD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TOTALLY BASEBALL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id
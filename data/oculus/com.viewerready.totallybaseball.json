74608_558373931813134_2752953515118249281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fvImCJuqMoQ7kNvwFCLXH1&_nc_oc=Adp8L7znCESTIcko5su0vWcGg0kyiPgpAqaC0iUDQmPD8R7IKdcfUirIUNp-vZ-TvZg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zKCrLzRhxW3_I3tCy_fjTQYiMdeCyLupIBGxOQIkfnA&oe=6A0C8509"}, {"file_name": "qs12.png", "id": "176934120940778", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974860_176934124274111_8600060491308648842_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syn7AG3nzQUQ7kNvwFhTN6l&_nc_oc=AdqaTcoNhPB2RshYZu1HNJqtAyTkxczR3nzkj-zMKFc4DHgSnL-z95h6ba7Za_Q-A6Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wGlDrl5BWu5bfzu1aIfm2WN1pszwqZk4WnqeyAPfQ4g&oe=6A0C7A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "plate_2560X1440.png", "id": "341824033979297", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/10000000_341824043979296_8556433505336198245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To-yjYlxqq4Q7kNvwEzS-Bi&_nc_oc=Ado8aUI4C1Aj8F2kpSMyxFdIAikeJfjhshnbkW4TbCEx6SV2yMWzssDV80qWv1zpRqk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7as8TBtZ-3MLKaYyMVjnr5v-d8jTFyJqU4TXh6GrMipg&oe=6A0C6528"}, "display_name": "TOTALLY BASEBALL", "keywords": ["baseball", "sports", "simulation", "fun", "tournament"], "long_description": "TOTALLY BASEBALL is the only VR Baseball Game that lets you play the full sport of Baseball! Throw a strike but if the batter hits it to the outfield...BOOM! Now you're an outfielder and now have to run over and catch it!  You'll be amazed at how realistic our throwing feels! Start with easy mode and throwing assist set to high, get better over time and play with less assistance for more of a challenge!  \n\n-Multiple throwing options\n-Multiple venues to choose\n-Multiple locomotion methods\n-Customizable comfort settings\n-Customizable characters\n-Practice and Tutorial modes\n-Multiplayer COMING SOON!\n\nHave trouble with throwing/aiming but still want to play the game?  Don't worry we made a hand cannon option just for you!", "short_description": "Run the bases, throw a strike, catch a pop fly and even make a double play!  TOTALLY BASEBALL is the only VR Baseball game that lets you play the full sport of Baseball!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viewerready.com/totally-privacy", "developer_terms_of_service_url": null, "publisher_name": "VIEWER READY", "support_website_url": null, "website_url": "https://viewerready.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "624207972026092"}}]}, "scheduled_offers": {"count": 67, "nodes": [{"status": "PUBLISHED", "id": "940645888395723"}, {"status": "PUBLISHED", "id": "1855736635820531"}, {"status": "PUBLISHED", "id": "1296356198838459"}, {"status": "PUBLISHED", "id": "800945435763371"}, {"status": "PUBLISHED", "id": "3803325386466782"}, {"status": "PUBLISHED", "id": "1269677408014352"}, {"status": "PUBLISHED", "id": "521212377451817"}, {"status": "PUBLISHED", "id": "630428216319213"}, {"status": "PUBLISHED", "id": "1854573528409602"}, {"status": "PUBLISHED", "id": "8631836613560727"}, {"status": "PUBLISHED", "id": "1036077981640797"}, {"status": "PUBLISHED", "id": "1220742932431604"}, {"status": "PENDING", "id": "296571469487556"}, {"st
3918564455"}, {"status": "PUBLISHED", "id": "285298710913999"}, {"status": "PUBLISHED", "id": "876608962974486"}, {"status": "PUBLISHED", "id": "1027738135212489"}, {"status": "PUBLISHED", "id": "875704520247578"}, {"status": "PENDING", "id": "1284067689042332"}, {"status": "PUBLISHED", "id": "363204935663867"}, {"status": "PUBLISHED", "id": "128328017021847"}, {"status": "PUBLISHED", "id": "614515489610093"}, {"status": "PENDING", "id": "3081625921980785"}, {"status": "PUBLISHED", "id": "998461861221280"}, {"status": "PUBLISHED", "id": "633127898174884"}, {"status": "PUBLISHED", "id": "1293440828275873"}, {"status": "PUBLISHED", "id": "1217611322269078"}]}, "baseline_offer": {"id": "800945435763371"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "940645888395723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26833922199560088", "version": "2.5876"}, "id": "3208127792574896", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3256881337690839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26833922199560088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3208127792574896"}]}, "change_log": "Patch Notes (Live v2.5876):\nBug Fixes:\nResolved an engine security vulnerability.\nResolved an issue that would sometimes cause AI batters to spawn with a human batter in 1v1.\nGreatly improved runner list synchronization in 1v1.\nResolved an issue that would sometimes cause multiplayer 1v1 to get stuck after batting a homerun.\nIncreased ball position accuracy across clients in Multiplayer.\nThe ball no longer floats in the air when a player leaves free roam with the ball in their hand.\nThe hand calibration menu now correctly displays the saved yaw and roll values when opened.\nFixed multiple issues that would cause the catcher to get stuck with the ball in 1v1.\nResolved an issue that caused one client to be missing runners when returned to home plate.\nLeaving a Free Roam while batting no longer prevents other players from gaining a bat in the batter zone.\nThe remote bat angle no longer snaps to an incorrect angle when resetting as a batter in 1v1.\nClosing the calibration menu in multiplayer now properly reflects the calibrated angle to other players.\nBacking out of the host options menu restarts the check for hosted games on the lobby browser.\nJoining a 1v1 match between innings no longer makes both players set to the same side.\nFixed a flaw in the microphone reset button in multiplayer.\nResolved several internal errors, vastly improving game stability.\nThe ball no longer stops moving and falls out of the air if a player throws it then leaves a multiplayer match.\nThe shadow now shows on the ground when set to sitting mode.\nThe game now more accurately determines when the pitcher is on the pitcher\u2019s mound with ball in hand in 1v1.\nCorrected some base ring logic in 1v1.\nAI runners in 1v1 now stand closer to the center for popflies.\nFixed an issue that prevented the ball from returning to the field if thrown out of the park in Free Roam.\nBacking out of a multiplayer lobby with smooth locomotion no longer locks the player in place.\nResolved some errors that prevented players from completing their walk during a walk or overthrow.\nFixed an issue causing runners to be forced forward when no runner is directly behind them in 1v1.\nHuman batter-runners that stand on home plate when an AI gets the ball at first base are now properly forced out when they leave home plate in 1v1.\nCorrected some AI running logic on foul balls in 1v1.\nFixed an issue with AI runners not properly being outed when forced forward in 1v1.\nWhen the host leaves a multiplayer match, the new host now has the option to return everybody to the locker room lobby.\nFixed another case of the ball being stuck in the air when a player leaves a free roam match with the ball in their hand.\nImprovements:\nThe bat in the intro menu no longer swaps skins and now maintains a good contrast with the menu background.\nA description of the two batting modes has been added to the intro batting menu.", "created_date": 1778795104, "id": "26833922199560088", "version": "2.5876", "version_code": 5876, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26833914482894193"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3256881337690839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26833922199560088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778273245, "id": "26759456767006632", "version": "2.5875", "version_code": 5875, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26759450887007220"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3256881337690839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26833922199560088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3208127792574896"}]}, "change_log": "Patch Notes (Live v2.5874):\nBug Fixes:\n- Fixed an issue causing the menu to be missing when returning to the locker room in Free Roam.\n- Resolved an issue preventing players from changing venues if they host a game after backing out of a multiplayer game as a joined player.\n- The player can no longer use trickery to equip unowned jerseys.\n- Fixed an issue causing players to sometimes appear as wearing the wrong jersey when loading into Free Roam.\n- Left handed remote players should no longer be missing a hand when joining a Free Roam game that is already on the field.\n- Fixed an issue causing an infinite loading screen when joining a game fails.\n- The loading screen no longer displays on top of the lobby browser when joining a multiplayer game.\n- Resolved an issue causing AI runners to spawn on a base with a bat in 1v1 if a player joins midgame.\n- Becoming the next batter while standing on 3rd base no longer scores in solo 1v1.\n- The ball correctly returns to the field when throwing an overthrow in 1v1.\n- Corrected an issue causing a desync in the scoreboard when joining mid-game in 1v1.\n- The player is now returned to the locker room in 1v1 if they are a spectator when the other player leaves the game.\n- Corrected a guardian orientation issue when manually choosing a position.\n- The ball no longer maintains its velocity and rolls away from the player when a high velocity ball is caught by the AI pitcher and the player repossesses them in 1v1.\n- The player is no longer able to get more than 3 outs in an inning and cause a desync in 1v1.\n- Manually teleporting into the pitcher no longer causes the AI runners to steal a base in 1v1.\n- Players now see leading off runners in their correct positions when joining a 1v1 match that is already on the field.\n- Dropping the ball on the mound no longer counts as a pitch attempt in 1v1.\n- The Quest Roster now properly updates when players join a match while on the field in multiplayer.\n- The player no longer resets and sees the screen fade when playing a fielding position and remain within their at pitch zone in single player.\n- Fixed an issue causing Quick Menu buttons to be difficult to click in the Koshien booth.\n- Resolved another infinite loading screen issue when hosting a game in multiplayer.\n- There is no longer a gap in the single player opponent selection menu if you don\u2019t own the Bats team.\n- Getting hit by a pitch in the batting tutorial no longer allows you to run around.\n- Fixed an issue causing the pitcher to get stuck if they caught a batted ball when there are no additional runners in 1v1.\n- Joining a 1v1 match that is already on the field now properly syncs the innings and frames.\n- Fixed an issue causing the catcher in a solo 1v1 match to throw to first base when a runner is stealing toward second base.\n- Resolved several stuck states caused by joining a 1v1 match during specific events.\n- The player\u2019s jerseys are now the correct team if the host leaves a 1v1 match and a new player joins in their stead.\n- Fixed an issue causing players to have batting gloves in the booth in 1v1.\n- The player is no longer ignored as a passing target for base defense when playing solo 1v1.\n- Resolved some issues causing seemingly random extra outs to occur in 1v1.\n- The catcher now properly returns the ball to the pitcher instead of throwing it to random fielders in 1v1.\n- AI fielders will now put their hands down when somebody else catches a ball they were planning to catch in 1v1.\n- Players now see the correct bat skin on other players when joining midgame in multiplayer.\n- Corrected some base stealing logic in 1v1.\n- Fixed an issue causing the AI to become confused about who is who when a player joins a 1v1 match after the host has changed positions.\n- Runners now correctly spawn on base if a walk is given immediately following a caught out with batter runner on base in 1v1.\n- Base rings now properly disappear when a runner is outed while touching a base in 1v1.\n- Fixed some issues causing additional AI batters to spawn when a player is batting in 1v1.\n- The player\u2019s mitt no longer shows in the pitcher\u2019s mound when joining a 1v1 match that is already on the field.\n- Spectators will no longer see the batter with a mitt when they join a 1v1 match while the host is batting.\n- The bat now plays the correct sound effect, graphics, and vibration when holding it very still for a bunt in 1v1.\n- Joining a 1v1 match mid-game no longer interferes with the host\u2019s game events.\n- Corrected an issue causing the bat angle to change remotely in multiplayer when refreshing a batter.\nImprovements:\n- Improved roster synchronization on Quest version.\n- The skip lever now disappears until the joining player is fully loaded when they join a 1v1 match during a booth sequence.\n- Joining players are no longer able to return everybody to the locker room in Free Roam.\n- Improved the synchronization process when going to the booth after a player has joined midgame in 1v1.", "created_date": 1769705460, "id": "25737760692509583", "version": "2.5874", "version_code": 5874, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25737757232509929"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3256881337690839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26833922199560088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1769206037, "id": "25683656261253360", "version": "2.5873", "version_code": 5873, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25683653147920338"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3256881337690839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26833922199560088"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1767994874, "id": "25561889906763330", "version": "2.5872", "version_code": 5872, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25561887323430255"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
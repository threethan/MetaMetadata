idBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3256881337690839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27263413923277578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783721487, "id": "27524832663802368", "version": "2.5881", "version_code": 5881, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27524817807137187"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3256881337690839", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27263413923277578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3208127792574896"}]}, "change_log": "Patch Notes (Live v2.5880):\nBug Fixes:\nFixed the scoreboard homerun animation playing for a really long time\nFixed the team mascot spazzing out on a homerun\nFixed an issue causing joined players in a 1v1 multiplayer lobby to be able to select both their team and the host's team\nFixed an issue on the SteamVR version of the game that caused players to be unable to close the quick menu in multiplayer 1v1 once they opened it\nFixed AI batters running in place with a bat in their hand in solo 1v1 when they return to home plate after a foul\nFixed players being able to walk out of the booth on the Sandlot field and Koshien Stadium if they\u2019re tall enough\nFixed the full tutorial getting into a stuck state if the player grabs the ball off the field during the end of the batting portion\nFixed an issue causing venues in the multiplayer venue selection menu to go partially off screen and look cut off\nFixed an issue causing teams on the singleplayer opponent selection menu to show up with a lock icon and a green 0 if those teams hadn\u2019t been unlocked\nFixed players no longer being able to throw the microphone out of the booth on Koshien Stadium and Sandlot Field\nFixed the singleplayer venue selection menu having a gap between Koshien Stadium and the Coming Soon Stadium if the player doesn\u2019t own the Twilight Field\nFixed players sometimes being unable to load their customizer on the Quest version of the game despite having an internet connection\nFixed players sometimes seeing their fields locked on the multiplayer venue selection menu when coming back to the locker room after a multiplayer game\nFixed an issue causing players to be able to round bases on a walk in multiplayer 1v1 instead of being auto locked to their next base when it\u2019s reached\nFixed the full tutorial not showing the pick your throwing type or ending congratulations tutorial cards\nFixed the customizer failing to load on the SteamVR version of the game after returning to the locker room twice\nFixed an issue causing the AI vs AI game in announcer mode to sometimes get stuck on a side switchover\nFixed an issue causing human catchers in multiplayer to be able to yank batted balls away from the batter\nFixed an issue in multiplayer 1v1 that completely messes up position selection when a player picks a static fielding position, leaves the game, then rejoins the same game\nFixed an issue in multiplayer 1v1 that occasionally causes players to end up on the same side (both fielders or both batters) after an inning changeover\nImprovements:\nMade the ball stop sitting on the ground while the catcher waits to throw it back to the pitcher in multiplayer 1v1\nMade AI fielders more reactive on fumbles in multiplayer 1v1", "created_date": 1781731219, "id": "27263413923277578", "version": "2.5880", "version_code": 5880, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": 
tyXEQ7kNvwEzFV8-&_nc_oc=AdpkyytV1FgaKE3PqFvc4KFY4LpEjV4jazLWxvcgE2lKt8DyB6JOyaV34OEt1QbGPXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOueQLIjjUg_dP3wL7Xy7Vu-L9lLqYX7Zcc0OPRmV_Y4Q&oe=6AC2699D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "plate_2560X1440.png", "id": "341824033979297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/10000000_341824043979296_8556433505336198245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfSFyheJVEEQ7kNvwEFIdIZ&_nc_oc=AdoAHfPCEYr9fXQerZiXFpFsGm8DWHoRtoygB2Hq5tIpl-m0-b2RvIGglLryo25utK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcGhBSNaImusIB4XaLN4IrPGbxkTiKF-C9dY1JqU1YzA&oe=6AC25428"}, "display_name": "TOTALLY BASEBALL", "keywords": ["baseball", "sports", "simulation", "fun", "tournament"], "long_description": "TOTALLY BASEBALL is the only VR Baseball Game that lets you play the full sport of Baseball! Throw a strike but if the batter hits it to the outfield...BOOM! Now you're an outfielder and now have to run over and catch it!  You'll be amazed at how realistic our throwing feels! Start with easy mode and throwing assist set to high, get better over time and play with less assistance for more of a challenge!  \n\n-Multiple throwing options\n-Multiple venues to choose\n-Multiple locomotion methods\n-Customizable comfort settings\n-Customizable characters\n-Practice and Tutorial modes\n-Multiplayer COMING SOON!\n\nHave trouble with throwing/aiming but still want to play the game?  Don't worry we made a hand cannon option just for you!", "short_description": "Run the bases, throw a strike, catch a pop fly and even make a double play!  TOTALLY BASEBALL is the only VR Baseball game that lets you play the full sport of Baseball!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://viewerready.com/totally-privacy", "developer_terms_of_service_url": null, "publisher_name": "VIEWER READY", "support_website_url": null, "website_url": "https
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vAhGoYVRE0Q7kNvwFm7ubh&_nc_oc=AdquSy6c99264NpzqkSEiSNpgZuF1OzWkhmge57T9-iVO3Hj7Up803zl4ZGQwjMtO-E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84jsBhHiAP5Kwm84FR7TS4x-ns-H5b34ddhIBPcWTa6Q&oe=6A466C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tiny terrors 1440.png", "id": "1000814297993741", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75375748_1000814301327074_55304521364100595_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VACAGHX1moMQ7kNvwHPFRQN&_nc_oc=AdqP7MM6GUxtU0LgqK3U67F1sjUN0RE0rziiXy4Tn9nY2Yhi1du7w5mLut-Wq6mJFO0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nNzY22gj7RYiaFA3N6QWltWdGKYV06l_zlLqycRo_cQ&oe=6A466548"}, "display_name": "Tiny Terrors", "keywords": [], "long_description": "Tiny Terrors is an immersive locomotion based horror game where you play as a small primate navigating a dark, eerie environment. Evade monstrous creatures, solve spine-chilling puzzles, and uncover the secrets of a forgotten world. Every move counts as you run, climb, and swing through terrifying landscapes. Can you outsmart the horrors lurking in the shadows and escape the nightmare?", "short_description": "Tiny Terrors is an immersive locomotion based horror game where you play as a small primate navigating a dark, eerie environment. Evade monstrous creatures, solve spine-chilling puzzles, and uncover the secrets of a forgotten world. Every move counts as you run, climb, and swing through terrifying landscapes. Can you outsmart the horrors lurking in the shadows and escape the nightmare?"}]}, "developer_name": "[TBG]GoofyVR", "developer_privacy_policy_url": "https://sites.google.com/view/terror-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/terror-privacy-policy/home", "category": null, "comfort_rating": null, "comfort_tag
4_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmeJxvXCWiMQ7kNvwHUx7Pm&_nc_oc=AdoMj3V-HXLgAl2n9W1KAmMQOpgWgc-8F5PU_TMgpS_AdIaSoTAS7QrIxqEfNSkViL8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo2JOefg36j5jDqCpgVawoBNSchtEykb1rY5m8e2_8bw&oe=6A8D654B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tiny terrors 1440.png", "id": "1000814297993741", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75375748_1000814301327074_55304521364100595_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJk6n5uhUncQ7kNvwHFvQGB&_nc_oc=Adr3c59Ts8-b9WtjapeeFmOB8B4CR3scNergqATCamSC1Z-6cm9cJNsWW2BB8qB4dnc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdWHhb_6E3_eoJTVBraS2k928V_Vh7v-p-L0zplKAsrg&oe=6A8D9648"}, "display_name": "Tiny Terrors", "keywords": [], "long_description": "Tiny Terrors is an immersive locomotion based horror game where you play as a small primate navigating a dark, eerie environment. Evade monstrous creatures, solve spine-chilling puzzles, and uncover the secrets of a forgotten world. Every move counts as you run, climb, and swing through terrifying landscapes. Can you outsmart the horrors lurking in the shadows and escape the nightmare?", "short_description": "Tiny Terrors is an immersive locomotion based horror game where you play as a small primate navigating a dark, eerie environment. Evade monstrous creatures, solve spine-chilling puzzles, and uncover the secrets of a forgotten world. Every move counts as you run, climb, and swing through terrifying landscapes. Can you outsmart the horrors lurking in the shadows and escape the nightmare?"}]}, "developer_name": "[TBG]GoofyVR", "developer_privacy_policy_url": "https://sites.google.com/view/terror-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Fancier", "support_website_url": null, "website_url": "https://sites.google.com/view/terror-privacy-policy/home", "category": null, "comfort_rating": null, "comfort
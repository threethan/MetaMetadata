iler_thumbnail": null, "display_name": "Monke Swingers", "keywords": [], "long_description": "In monke swingers, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, monke swingers offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets monke swingers apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to monke swingers, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become monke swingers, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": "Playdough&Hydra.org", "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/home", "developer_terms_of_service_url": null, "publisher_name": "Playdough & Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeswingerswebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
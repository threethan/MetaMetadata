}, {"file_name": "com.oculus.vrshell-20250524-143405-2560x1440 (1).png", "id": "9658478344261386", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822821_9658478357594718_1511181760698034475_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVTc8sqFMNUQ7kNvwFbxkFs&_nc_oc=AdoodAbUUj_kQGzjwHCOvAvsUbbAfs9627siG0kqsKHtPpqS4cDhPBFP3jSJ6ap13wg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBinsiLAT_E0Eq5TIm_hW9V-FMuso0PTw7PjHe3sO96Pg&oe=6A5A38C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Swingers", "keywords": [], "long_description": "In monke swingers, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, monke swingers offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets monke swingers apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to monke swingers, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become monke swingers, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name": "Playdough&Hydra.org", "developer_privacy_policy_url": "https://sites.google.com/view/hydrataggings/home", "developer_terms_of_service_url": null, "publisher_name": "Playdough & Hydra", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeswingerswebsite/home", "category": null, "com
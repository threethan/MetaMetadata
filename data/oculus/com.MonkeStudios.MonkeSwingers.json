t=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLN4yDAFc5wQ7kNvwF1Ed4W&_nc_oc=AdpGnnPQDWLAqdR4azyGGINromLSbd4lrp0UhbStbEv0-sne7wEWu5dImysHLxdK6UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh_CIM_-XT3h3nGC1J5Tw_9PkIht6xYnVMp49XCYLhYA&oe=6B0712AE"}, {"file_name": "com.oculus.vrshell-20250524-143405-2560x1440 (1).png", "id": "9658478344261386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822821_9658478357594718_1511181760698034475_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6B9DN92C7EQ7kNvwEny3YU&_nc_oc=AdpRzSi5dU36Ob3X_iBXs-wlgW7peA7D6OuKkG99pPzAevlRPrJfEpvFUzSfK16CuvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Jj7a3sqoBmEMYNrBIyPMbApdL6-_NH4itzCqhpvOLw&oe=6B072584"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Swingers", "keywords": [], "long_description": "In monke swingers, you'll find yourself immersed in heart-pounding gameplay that's easy to learn but challenging to master. Run, jump, and dash through intricately designed arenas, showcasing your agility and strategic prowess. Engage in thrilling tag matches where swift movements and clever tactics determine the ultimate victor.\n\nWith its intuitive controls and dynamic gameplay, monke swingers offers an adrenaline-fueled adventure suitable for players of all skill levels. Whether you're a seasoned gamer or new to the world of tag games, the accessible gameplay mechanics ensure an enjoyable experience for everyone.\n\nBut what sets monke swingers apart? This game is not just about tagging opponents; it's ", "short_description": "Welcome to monke swingers, an exhilarating and immersive gaming experience that brings the excitement of chasing and tagging to a whole new level! Step into a futuristic world where players become monke swingers, navigating through captivating environments while using their wit and speed to outrun other opponents."}]}, "developer_name":
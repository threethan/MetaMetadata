BQWz2kYR2vMUxkUdNN7OKmOHHy0IA3Z1wrjuw-JCWzA&oe=6AA00BA3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNBgHJB0V8IQ7kNvwHrp_fg&_nc_oc=AdpP4XVC5hInPPVYAm1jLIswc-n51ZmVa0k82qx_qbq5uCFAcoztLnVjjnpfTwV82FA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmOI9LJlz4sWrlpOS_OeWK15gPu4eNuSakNBTv-mAq9A&oe=6AA00AB0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTs0C3ORUToQ7kNvwHQYspe&_nc_oc=AdrhWRXK6-Ovu6EOMZ5wj0PH0GO6_zEEAM3V31ftf7AALmZAySgn6QX8CWDpyuyCidc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdLrFc71ES4mu-iDowKam9RFTCgyayll5mK4XwtHwTzQ&oe=6AA0096D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
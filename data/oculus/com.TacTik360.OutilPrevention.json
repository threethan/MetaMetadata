G-o8YLc-_mzVRLX2UoydMyDhI25hHvwMyercAgwfBRw&oe=69CBCA23"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cvi1iU6WAhIQ7kNvwFsKPU2&_nc_oc=AdoT-PsgWaCO1Wx0YHMttKvYIsOJRbJLOdDoOsrKLspSqzZ8n6-aB6m7bPYb4eOkDSY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWTLpnmi4y3f6dgikwIK5r7ETialYHNNZlb0Y7VNIC0A&oe=69CBC930"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBp-6PSZvxgQ7kNvwHCvqPG&_nc_oc=AdqRJ3UrEUfwB86gjTalYnzcld-aSN4piT-qLMGsRQCnJ--sQVVguBcgq03N2CcP0vk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwukEXMfoum-glt8yRP-iKhPq4srXlRlEdWnAnVLDcP9g&oe=69CBC7ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
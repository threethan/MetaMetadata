xLhQKxlkv5KBmSZNOPkKr9f3N-HUP5dO7QGepGaWFeg&oe=6A329F23"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl-vZEnImI4Q7kNvwHsZGoh&_nc_oc=Adr-68nj78XDAD1R395MrItZ4V2_Wen8BzjTGF8X6XjCNtsJvWPIwb0W-1S5UIzABSQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9107WsT6qNiSrRU-O1JViX16OMPMqKtG8J5AbGFWiuXA&oe=6A329E30"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umgSngqXjR8Q7kNvwFWKysk&_nc_oc=Adq_8rXcZDQtA56tMsCtinIor42ch17Iu6GbHxAqhO-cbWn8BGJeu7JDKtNEaB8Eilw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q0DuPp7Gh_Hkg2R4CS5hoTc1ky4dWE8ic_thqGNztMg&oe=6A329CED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
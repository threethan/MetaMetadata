h4wuiXEnPW8ERzOjcBwJNCj1fwgvKptqQ2JQ768jxGQ&oe=6A281323"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APtqAUY1xo4Q7kNvwFry2pt&_nc_oc=AdpyJ6eXpvrCbzifH6DoKEtDCo4rVRgroOr4rA7awa59QlZzKs7w0tKJXVZkeq0GGgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iISONan6w23X8hbi4iNT-UjzXEcEaQvDU-OX3vag1mw&oe=6A281230"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZDjorAa584Q7kNvwF6N2IV&_nc_oc=Adp5ZJ_WBI6P6Q0kY4eQ_0QjYcw5JJZJkIjlgUPXOnCJPIIyNoucQqXK2lFYBvjat4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9szpVwWVTx57Uxp9jqxF0Whq_kjfPy9mplkt8WNzpwGw&oe=6A2810ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
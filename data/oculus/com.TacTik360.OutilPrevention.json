0Rb8WaN48yoJ59LRB0WnENN2fLJyiJTlQ_iPkArdZWg&oe=6A54E623"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBoxXI3QdjEQ7kNvwGwrSXG&_nc_oc=AdqCtOix7m8t18ysp2wEyKgLoJyw4H7aVXEr4zlS7LmFBySF_PPXQM0YHRY-HdwFln8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDezsl797gzEEr6C3GVDe3mXKY6Ism9dF0biB39-FfnmQ&oe=6A54E530"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWXJSZ5xgPwQ7kNvwG9Zb6i&_nc_oc=AdrKdVRilxj2ZYRcfHO9KLyAvLvnZ7QDlSqbWD3D_OJqyqVe9Oxpq9NtsnNsGl0tcBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqA_p2P5LOV61uxx9insJbkn0xQo6B50gJY7RD3lss_w&oe=6A54E3ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
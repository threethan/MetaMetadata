K-WcPwhALrkga6IQxtagUki1byYb6PxoGRm_QHUfX3w&oe=6ACE6863"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCNpkg_Ag5YQ7kNvwGxXqGX&_nc_oc=AdoCSocVjS4Bf-7GHM-Z8fvsN2dj-4O3on4c6FfuWTkY65f5KfBrlVLJRMg-AQdDEcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq7evXjpIim3cAJvi3XaxbdMC9dL5qLT0tn9hHJb3CTw&oe=6ACE6770"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5l2H0AGkXwQ7kNvwEFA183&_nc_oc=AdoevTa3h-VB4y9foLb_TJtqjnIhEA1VzUSeA_U0qWR2LCwHFvwRVCLZLv6ZwUIfoIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWs4NfdrhfvsmS7bSjo3s0VKzJXcZuop4MumswbKv25Q&oe=6ACE662D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
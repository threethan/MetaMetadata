WJN15tkuDW-YJvcybw_Nz-HIPmVtXnJogzVYH7IU4Gw&oe=6A47B723"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eRrXhrQbxgQ7kNvwFPOfkY&_nc_oc=AdrgNz3f0VB5GmrUh-FMJ5ePo14V09KyP4Thdfq7o2_1SlgfYnU1O9h1sVVruZuGCMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AZo52AxRbLdV3ZxkPrnVr8zG73OdfH6-4K9-RE7BSaQ&oe=6A47B630"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0NRN5YNz7oQ7kNvwEbaqT5&_nc_oc=AdpFcsz8p3wbLhCvQQ3U9g_cT1JTdIva5APvS1UOFJC4N1k7Afo4aijlF4FhRMdVO5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93aFl4_IakLYW66vWOF9nVdjE4DS8IKicC95HuFDwbNA&oe=6A47B4ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
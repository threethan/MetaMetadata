68rT0I8-QLaUgnau-naiFbVbpM0tc7a-dHtmEWaoOXw&oe=69C92723"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g2QaqSgIyQQ7kNvwEotr5x&_nc_oc=AdqZkUiTXY3UmqY9QXMgSuZx2koCsjzWZWdKZHD1i2qGiT7wADvnsjq9fphRPsuI71w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZih1-GkIiY-5zx3f4QdoM5KGpFxWTIrHg5AWIbiappA&oe=69C92630"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD3kRCpIniQQ7kNvwHn07UC&_nc_oc=AdrEuD4SPMJHCsFW9S3LQ7UmlO34E8VsGMg7zRYKApt9Ak9QygsO_uaw_kZ2Z1KZjTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytceJyi7IprOeJW8O2ad8h4-AfuVet2FxWAveWKAxkNA&oe=69C924ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
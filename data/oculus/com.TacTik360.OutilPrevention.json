aTWGlSjoXeXKY7PNUUVvxb6trrfqeNPZiJn7hykjBcQ&oe=6A5637A3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBoxXI3QdjEQ7kNvwH0k_kA&_nc_oc=AdoYeLLcFR5E3By7hBF0Qh0YMBCN9cxo2NBHvPa6sR2iO8GTRUx0T11L7k846g3ZLy4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsVN8pnzDJClnQliYp6UREk9UiixTXT3iaXEYiOmjwWA&oe=6A5636B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWXJSZ5xgPwQ7kNvwG8ze94&_nc_oc=Adp3ei7sKGx08yDWXpAIyN3WmDoniaJDNUV_bblTQQY6MhP3oQwtiZ-baW-vcXSdWgQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIL6_k43QrF-7be_sEYW84oMUdXsU73376_VEAl_vNgg&oe=6A56356D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
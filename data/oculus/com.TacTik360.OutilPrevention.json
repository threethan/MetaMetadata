R_tW7JeHv3hbn3rfZI2wEVzm_2UrQ0qf36sDm29leuw&oe=6A50F1A3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcceKpZfgM8Q7kNvwE1GKqR&_nc_oc=AdpJhcAzo7kdGHaJ6jQYxBRRUb1Us5oVDG2UR5A0ChZYHizijTPAlR-oJqt5zPDqDxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMJWu-qQsxAGfBA6b6B8bKUGSZcEZSRMSiLKAh-V56JA&oe=6A50F0B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RxMtfCvZSAQ7kNvwFdiiQA&_nc_oc=AdpgSvjZX0RYAq6Khw_9x1-aPXGUSuyV1MUOdgYAV0-PSbs7LJVw3Sa6iuffZNJMiYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATb4C1QS0W8yiZfN3eovO972um1jPoNpmJorHIpfSlOA&oe=6A50EF6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POUauSlKWMUQ7kNvwH6PzdF&_nc_oc=AdlCTd2aUt7inbKlJyXOMDeLI1oHWtAr63SQfuMckkIoqJVBMYndjgphPCkJugbEoNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxudMdXVUMxT5zLhRpUVMMtn78mP4ADHr9zG4swzNH3A&oe=69B6B130"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YqPbm6VPzYQ7kNvwH1H8qf&_nc_oc=AdkLsFtEzILSpJ4foj0-w_wjfMOtrVtOkWta9GRm_nqnZZzJ5zbuxaNyelPmKRVfSMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKPWPhX7CVlrUHezG0ZVsrqVSPx37hGicZGrieZUtXjw&oe=69B6AFED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"
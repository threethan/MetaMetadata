f20f&oh=00_AQGt5qFaOqrynRvD2gIQuC4zT0oJpFFmaJJETk9vVJSHeQ&oe=6A85ADA3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at8kQIrtxu8Q7kNvwEQDepX&_nc_oc=AdrDW3L115J25hFThbxuQ5Vmt_zII7bWSKnxaq3qibXduEtq1sqnyUeuGKafuo09JK0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU5WUVcmzZk3YwDJHAN2-HJdeCn0a3l15K7Fog54NLTA&oe=6A85ACB0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgB1jvxo0x8Q7kNvwGirHd3&_nc_oc=Adq3fNK1BL2_faAUeNL9-EBHez0y7xNh_zDdVceZAAN1Io0f0xlIumtbIgCwt1K5Vbo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFhfAGxzICvoQpHiRJW_p1Q1cRfUa_eDA-bxmtvwReXQ&oe=6A85AB6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "c
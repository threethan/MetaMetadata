zUDCM0s2WcgOOz-j27y6pEX8Wxv7JMMduqQrHTCp4cg&oe=69D11023"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVqcuWiX6dgQ7kNvwHuifJn&_nc_oc=AdoqZRI_HuPPaw6fyJLOapZQ-Hh-oxCsy4pj2TxAiGJCm4oA7vIyY93EJH22Y21O7uw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5Nh9t6zt0S4OWI5FbxBh81aWPFSDvxGvCx2BQEQ3Dmw&oe=69D10F30"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6IIEDZ84GMQ7kNvwFprsY9&_nc_oc=AdrADzSpDZwlj_ETu0ZqQ64WkiyJr1N9-Z7-JORJQ2mousv58PMWFNnFxh1OcYsBunU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxswPFn5xrbocYdXbSaSUKm_9_xE9JOl_3u8eyDFDVgGQ&oe=69D10DED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
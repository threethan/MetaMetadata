4UodXCBGyP6O2sCErl_3Yd-nZs_b_AkxlEcLw0i2dow&oe=6AB67523"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99KyH5wJYTUQ7kNvwHcPyF0&_nc_oc=AdoUaH2zHWeHv-fROQbd459DqIxI651N7lu007nZorktS1WV742t4_vyGP7loMoZ8hc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSLuuDp_7kc-GGI7qYPxEy2Ljh1GaTfLVAiaAXdZdj4w&oe=6AB67430"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q6l5iAo1y0Q7kNvwHAULMY&_nc_oc=AdoqwMYyo8Xv8OmCih3AMWm_czUXuGf6NzBf5z5ZKhzHZGF05YTqQGWsRfiW_SEWcRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRE00d7sl83BkTm1fHC-a_Q3WX0pJ-1xCRpVLuAC--gA&oe=6AB672ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
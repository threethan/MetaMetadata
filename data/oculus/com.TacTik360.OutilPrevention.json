I-MSc0fWLSZPFUxfYmVoLqTrZ3iqMWZ-XIStL-_f9bg&oe=6A008623"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NbC1HmBRcsQ7kNvwEHf7U8&_nc_oc=AdoqxLNABtr_ICxIkAHeVN1lBTi0cGbCDsE2PW_uSMVm5MrbWhT8fkTeEh-25vBsN8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ftWxTg08-k0kuahRfO96x0S0-s2NXMkRLG8NAuPLJvA&oe=6A008530"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmyWkndUBR4Q7kNvwHrFWVh&_nc_oc=AdpqSgRs2f4RUOgpbeQkL6FxD8YEWQo_3ZyRGo4qSexCtBBQ9hcy0cvlt4od7-7eJQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_urIENsboChf4Mhp9gHUK1OW7IuG8AS7i4r932dTv_A&oe=6A0083ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
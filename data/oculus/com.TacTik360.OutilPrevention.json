h1zbVEEYFZvxMS2h-FeoyJhjiwo6aRi65s3C89p_kmQ&oe=69D7A7A3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCGNrTrc5HwQ7kNvwGQ5cRb&_nc_oc=AdoTaf3bO00g-LNB_aGRPUg8ZX_i9t53G8Lbat1taj_WKgLZ7leKTdOuv-TAYhg7jWE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17Qoc4C7TgLbA0dPIZscYqSChiCSPc7nb6XZnvyI0DMA&oe=69D7A6B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=di4_dKj75iAQ7kNvwHh_wDm&_nc_oc=AdqGN6hy2DMMQ7vatiSz5jKAa9kZD72n_glfAZulZ_dcSJYKxwx1vq3ncqF_C8EEZVk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pTMQq6Oh0m1EWOXl7wKq6SyCr6c_xCb-awLF05PDrsQ&oe=69D7A56D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
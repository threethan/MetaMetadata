se86IzXiE2YBqWiguh77MeQ87vWfogOGieonq5bNdRg&oe=6A0B1223"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBE58r8U3LcQ7kNvwEj41Wm&_nc_oc=AdrbvjJKU14Qpp9DJzlN1s4-DolxeeQExYM8kYAjaPAruBDonEWe8h2ON9UeeBE2e4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ihpm6SE117p5f0tXhmZ8CwA55uTLiD4pqzCU3NqE2Sg&oe=6A0B1130"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O7ZCrjYYO8Q7kNvwFTJNNI&_nc_oc=Adr6duuJ6KbBOXG2rL1MPpPaLDDPOh3PhjMkuX2bb6FStNDAnx-YSkwZj2lBiyBnHmM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cnvNV5qrVQtz4Bv98_udHbcqwURZgLprBpvJnuH8y4Q&oe=6A0B0FED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
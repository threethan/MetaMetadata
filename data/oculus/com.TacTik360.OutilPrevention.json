LBATbA0aFJnl6gxWFiZ8lc77ZCUpUNKnFW4bN7BSDSg&oe=69C532A3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faoTqqHUlR4Q7kNvwF-f-gM&_nc_oc=AdqrZyUvykjPr2-qY1F6kj4wSvQZ_rNfGQ6nIGpL66OaiOYYFDt59t0rjY4MOBRxc5w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBHHT3GfmkYfMXrCSFTa0dykxQHmmcm2YcjJ6k42_J3A&oe=69C531B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoX5ztughHUQ7kNvwFWbngR&_nc_oc=AdosFMltcTh2yPF5OQvgTVTFWZ26XxYI5S7Z6EPOf-Q-Z_SrlK8AbtbYFwiWh97-i68&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGiUAXUWfmPkpoCinisYD6qhjz-5GO_6lTvTSErshW4Q&oe=69C5306D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiXekUkvk6wQ7kNvwHT9uRp&_nc_oc=Adkv0JfdpzzFxP4t2KoYHVeaUOu1oHDEqnsTuiTMSCFemR_MRwrblwHnm3fiv7E1lNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu8TPVB2vo78w2OLKyc2WHdUWfv3_h1p1SFF9-3HGRDZQ&oe=69A830B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oPr4NvWnCIQ7kNvwHVeKhw&_nc_oc=AdlLGKmXiE7_Tc7yWXpp8ippqeYnoeMHmScId9kAqVrg-D5QsiUIQedGaaWfTDILBpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvW4kYOfK8OMfbMZlE_CUpnNnclmkPiefPsDa0DEAr02Q&oe=69A82F6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"
HBywmc2xQ6ibHZXL2kxIgtOB3qqdLqt6JhBSP-DqaQA&oe=6A6B4FA3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0ku72quZqgQ7kNvwE1EvNM&_nc_oc=AdqbPuTwFtvl5-nYmgszYLmSXK1o6zEyQmkmvkPeWEnKF4xQbw7hBlRoKJVeNvMdZyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY1bJiqmt7aNiY6B-nnjJwBoCFYot58MhFprbtz10HSA&oe=6A6B4EB0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIq2YCwQJuQQ7kNvwG_lTdM&_nc_oc=AdpT_IuJHXmGgp19nz1Iglh5PIXc0VFYiaRiJxO0FWtcSpVPr6TG_JhJjS8eE9-ty4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4Inh1tan6MS-Y3bZhKbURDzvldl7LUa5sEC9FsfseIA&oe=6A6B4D6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
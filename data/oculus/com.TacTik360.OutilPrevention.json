DGPUv33_74W6u5DtaXFVBcO1opPMmN1Kr-J8Esy99cA&oe=6ACD16E3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCNpkg_Ag5YQ7kNvwEqH78e&_nc_oc=AdqkkPDvHHhTXxBh9Qxi5D8Tvg1i7afiWBoA9E0uOkkwdfQbbNqfoXchRTIaidOpyig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO-6gjsjq2KrPztOOKWnfa3zToWDHbvVRvLOtx3vzQhg&oe=6ACD15F0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5l2H0AGkXwQ7kNvwHHuGqm&_nc_oc=Adre0bnw5DU6rP7WqDNATwAMSkVUwP1G7XG01uWRTBkppRfrzpW73S20z5r7n8Y2DN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiOT1hv2mjLTjbMKKXamsLjXsuovI9lfKJ45PIGDybeA&oe=6ACD14AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
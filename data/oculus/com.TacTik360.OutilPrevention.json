d0ds-1kcqIeItbzDITWGVu23TsN5FN66oRHan5ncFag&oe=69E38523"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdGl9MtG0LIQ7kNvwGS0N6t&_nc_oc=Adr9kICQzU-iRX8Ek0d8zQk6dECqzUI8y5Gv-V5_bZsx-HkvMuTX3HYHGawRKGwkg9E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nf6LP_4WvFM80qvoE2BERl8oPsIKJcgzSvGJB1JtYqw&oe=69E38430"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lUP5QAh3R0Q7kNvwEforDJ&_nc_oc=AdrCS333SjPVWzZzfPRVKNayKYCHFWRYmRY2cgX_ZkGILU-cVfXuVdZXOytiV8TwOCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tL9DM4Y6LZzecXetZ_01eCTftAqVwyF7TGxiK2d7J4w&oe=69E382ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
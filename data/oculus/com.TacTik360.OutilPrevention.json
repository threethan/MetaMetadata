o15ZrmtNerrDVAhGSFF4p4cO3v77ZB-bQ-5d3y1kOpA&oe=6A9AC5A3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7-vKTyD0QQQ7kNvwHb8aNY&_nc_oc=Adq4nqbISl6gYXvBOi_7s4bRzEoS7LerRpXpX2RiWXZvxDnciTpe1gPktxGDglfdHGg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX5x7Z6QEx-qxZXBpQsTu75maFwoGVGSMoPDE9BcPzfw&oe=6A9AC4B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myYQ2f8EgtIQ7kNvwERiDEw&_nc_oc=AdrQ8lMuUdoHdkmklEHxBZ9K2ZA11HL4lQ1Uc1yJwxsBTjttnrvve3WFssIAVX1VVdA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfIAq5Eu_vDS0VqFpfZLMe6NB7Aej1r2X-Bv_yQixLrQ&oe=6A9AC36D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
GK36AWhYRmbxHA13XHoxuV36v16G3_HgdlqeOB9blrg&oe=6A217BA3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNx4PzL7A8QQ7kNvwGAJb1r&_nc_oc=AdqHGZt_ssFzNFUAYD-orhP6mZwOJnohucFEUWmJZIKEoMwXCLnEpZDRSQNsFrUqAUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MI5f20UA-f0k1UIFoYD4RNzyqRBvxPAh5rtl5vDd33Q&oe=6A217AB0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Obkwoaq5uMYQ7kNvwHtxLd1&_nc_oc=AdrI5oxpwHWTaH24oh5q-6ee2Vil_AtCIqY_ohptKbhLPFA2qOS3vMWeFBkP6IfsUoM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NQxyX5fJVU1eWlAla4uEiuOV8s5JbMlh9I93VkXYI4Q&oe=6A21796D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
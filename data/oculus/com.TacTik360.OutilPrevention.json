pDmulx-tqKdsjLa3NtadrvYXitP9DtzNprTNxlqM0cg&oe=6A772D23"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSS03jIApu8Q7kNvwEh5eOu&_nc_oc=Ado_zX7q0I9i4XbZGTLhFtxu6REZkCCOEsPyhV6c7G_mYNkJPiJCJmQI2XL0BXanwKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6BIwIkTeW1PecUI_ul2Rf0nFZgpBJkHUiX6L1Z0n3Tg&oe=6A772C30"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNTn2C9AzHgQ7kNvwFDlaXw&_nc_oc=AdrYxZRRTVu9YO_JlxUraVkXmi9CYBHkHZo-lyGkb6dc3qEVFnO4ROA3FduGqF2h-_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_uM6V6RqUdmL6nHGLEWaygoqVpmdGy0a10Q9cUpIpXA&oe=6A772AED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
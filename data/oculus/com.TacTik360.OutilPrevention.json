q0q3t4TgyEYxnzyzNN7m3_-TmOz17oCYP62gh6_yn5w&oe=69FDE323"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NbC1HmBRcsQ7kNvwEQooqi&_nc_oc=Adp1tDNiln0vsNVLiuZRR3y5OsWeWv8mkg0CIlVV2tFl26A67Wkv780BEhRKTGTPj6E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mgUmNWUWqEu2rIyWmep1JzBe7w-gxsjjThmQZswi_mw&oe=69FDE230"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmyWkndUBR4Q7kNvwGLwge7&_nc_oc=AdpZ3sguufgXiJ-JIm_GpvOj99RD38IY-SeIWJUa3F8uBxLWP2gyeQmg2_qIdfB1Z7o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Srzek_FGWznMvWrP5SlL-jGA5kokloEvMbZjBgZeUSg&oe=69FDE0ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
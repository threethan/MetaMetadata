A02iJki3wICaeqY_sRavE1ubpjNS_mMHUyyIB69zcGg&oe=6A675B23"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzxC1-3XO5IQ7kNvwF0Mu5U&_nc_oc=AdqVS4-21015I1qYkP3XtvDNdFa6oEQNTcwoU-4IO_O-t3TOYdX3pBQzFhHztC83-fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpYc3PihssBtnXbOwmC1n783AjjKeGIhbKcsAAFZUOZg&oe=6A675A30"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Yl308kvcdkQ7kNvwH96EzF&_nc_oc=AdoHWJpq1wyZp2WHsTXYBB8rHNh5RZP0QjuBX2q3t6s3JQeAkYNMNwxsVeGx1bfk7nU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIWyGLhJqyEiT3YFDBTu4pvtBL53g51M6uBz0ueSGR4Q&oe=6A6758ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
DqOpJSnqtnMT6IAHFcDD07iZFyrcFmt9LUdI-VJYazQ&oe=6A9C1723"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnNlPvbgJasQ7kNvwH5j0y7&_nc_oc=Ado-VwVXqWu7nu8nYWe7HDmHa2qJSvRFgraPGk-fqZZgLSH4XCUdJmXp6WB5fNS_wWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGJHUAfBSa7I28eKQkqI_ioj_NMk9dVtXupWyi2JaCiw&oe=6A9C1630"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrIyQS-ytVUQ7kNvwEyCv0T&_nc_oc=AdrICQvZim-AgneJE_HRGXhneJ7Zmyj1rSUCEN7N8BTRdQyrE7qpwgOhU4LcN6e0o7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPLW5E4SDWx03TnVaP7XOJwqaVzBTK4In3UUvZ2qnw9A&oe=6A9C14ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
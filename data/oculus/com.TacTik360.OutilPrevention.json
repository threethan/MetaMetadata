gItlP4dAOJ4cCaihzSg8bXLrXLoHHEnP0HKk3x7YQdA&oe=6A105823"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4uQOE3YyQgQ7kNvwFOvIJ3&_nc_oc=Adoot6YE06d1DEKSmf2kNQY7-o2oOGfIMrKG6J2GiyFMVF-kX8A3nZsp9Hhiuj7Zy0I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BPFx-I3AIIdnquwJTE5P-zQZ6Bd3n3fNDK2mpbBFVdA&oe=6A105730"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACYjdWJr5XsQ7kNvwFpXe4h&_nc_oc=Adp69bcYNYScyT52CYrN8suD6J_eY1pMuYpZqkh5hDJA3R2RThVCX2sLtYz6Rd0xp0o&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zxhBXUmq-g6vi8kvqxsnSQSJpJYSSHJJNlvBmmCHPKw&oe=6A1055ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
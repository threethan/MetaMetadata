KC3_NTZdvcm9Q-6QEXX7idCj6sSmxNq5kIq-jBmXc6Q&oe=6A58DAA3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyuD-0TjW8cQ7kNvwHHn7eG&_nc_oc=AdrVl0wMlIcAWDUpDT9eTtvbn-3AwYtj67CVbpQo3X4ATbbJUxcXZHBiCSYDVTFvbA8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0Wu_5HyvMX3mRK6kb9uGEE0roL8xcsOgC9MK4AKxZnw&oe=6A58D9B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNXRuZXVvr8Q7kNvwETPooa&_nc_oc=Adp-22pIUsDy1PXkLfAp73lttnt-z-FBa7AYaqz2PXAgTlOxjcgbh8c9ud0aiaIn9B4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQTEQLEmKmmAAb1U5bFSjVb4P-wR7UziFVVrheC5yT1A&oe=6A58D86D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
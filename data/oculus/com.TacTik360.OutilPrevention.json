ULyVokED3qcRyIvFK8iW50G68dKbxTzbS0a4jEi1r5A&oe=69DF90A3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC5e96ZsZh0Q7kNvwFxGCiR&_nc_oc=Ado8roWkpwuVIiYbi0x4Pl3s9VhdF5g9cW0gRVG_1jDkWH9BbBKfI55RiygBvbS9kjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dK6Dr6QqiubqPO0fVrfXpekMW9sVLIObrz1dVbH0V3w&oe=69DF8FB0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWop2QnpSp8Q7kNvwFtGDfY&_nc_oc=Adrkb24CeqfTVv12CzlRFbrR7Truh7dpKkiyOYiNxGkl_9ukAKyvGDWDVec_A66Ovlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2G-NuLr6I7RizMpj4zCPyo4h2vwocO-2ZZLqSGDeZDDQ&oe=69DF8E6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
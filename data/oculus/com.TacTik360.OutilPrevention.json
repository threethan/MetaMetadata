pfFQotaTtHQkWg9IMFvvnMwWZJoQhDbznrh8bLHM-mA&oe=6A6609A3"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzxC1-3XO5IQ7kNvwFOfmLV&_nc_oc=AdqJ6Zn4GuaBw0JStNNcWH062AftGH3-imjszaUQt_nDzfAV4yjdjVRdi5Z22uMr_NQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmdAPRDhrQDqwZC9QEyH8r21AI-CaETen8YpF_Vx27UA&oe=6A6608B0"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Yl308kvcdkQ7kNvwFKHcyX&_nc_oc=AdocEMzJzJZs4PLMzlBQpqwKn-SnkhdvOPOhyQyuWZtJE77OhwJnPgk6JG9cT2Kjf4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjNYxa5PGUfCooCzPlKfEqCs9RwF8_aw0d2s3rBcYsuQ&oe=6A66076D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
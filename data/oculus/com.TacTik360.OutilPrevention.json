SrCHlLb7DetEj-8nPFhFB1eKabdyEOpJl1rJ49HbYrA&oe=69D8F923"}, {"file_name": "image4.png", "id": "1479678613042418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300750_1479678616375751_6997581480530838541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCGNrTrc5HwQ7kNvwGa9IPl&_nc_oc=AdrGc9FZ5cQcfMx_aJ6a0nKbRONgaSn_CvSJNRI-1Z2d0lUGjqrzstFcMTgW-80L6x4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P0KiXRkcQo9ifpf7pfF54kKjiQ7iYjSmvS1xRerHu5w&oe=69D8F830"}, {"file_name": "image5.png", "id": "1245528793651676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499349371_1245528796985009_3447873084062975841_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=di4_dKj75iAQ7kNvwE3njY-&_nc_oc=Ado4xlKCvQ5dc6O3vCCdOoW0-r1l_c-7KUYw4GilZCxTOGKKM-SnbP3c7akB-emQZtE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bQ8rJ7xgAgZjCkGv7xRzZW9KT38F9SAygPxpAOTy7og&oe=69D8F6ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hero360", "keywords": [], "long_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present. The name \u201cHERO\u201d reflects the purpose of the app: to empower users to become their own hero by learning life-saving reflexes and making the right decisions in a high-risk situation. Surviving a fire starts with knowledge and preparation\u2014HERO 360 gives users the chance to practice that before it\u2019s real.", "short_description": "HERO 360 is a virtual reality training tool designed to teach people how to evacuate a house safely during a fire\u2014whether or not a smoke alarm is present."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tactik360.com/politique-de-confidentialite/", "developer_terms_of_service_url": null, "publisher_name": "Tactik 360", "support_website_url": null, "website_url": "http://www.tactik360.com/", "category": null, "c
dM_QwQsgV89vff6cw&oe=6AFDB233"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Twobit", "keywords": ["platform", "puzzle", "twobit"], "long_description": "Twobit is a really unique VR puzzle-platform game. Only using your gaze or the VR Controller, guide a little robot in strange rooms and help him solve problems and puzzles. Twobit awakens in a dark and mysterious place. But he is not alone. He sees you. You are his guide. When he asks for direction, look around and find a location for him to explore. When he finds a button, nod you head in agreement to activate it. Need to see what lurks in the dark? Activate the Twobit Vision and see the world through his eyes. But who is Twobit and, most importantly, who are you? Are you a figment of his imagination? Can you and Twobit find a way to escape this pending doom and ultimately unravel the mysteries of this dark and enigmatic place? Twobit is a demo of Twobit Odyssey now available in the Oculus Store!", "short_description": "Twobit is a really unique VR puzzle-platform game. Only using your gaze or the VR Controller, guide a little robot in strange rooms and help him solve problems and puzzles, and ultimately unravel the mysteries of his origin. Twobit is a demo of Twobit Odyssey now available in the Oculus Store!"}]}, "developer_name": "Squidbeam Games", "developer_privacy_policy_url": "http://www.squidbeamgames.com/", "developer_terms_of_service_url": "http://www.squidbeamgames.com/", "publisher_name": "Squidbeam Games", "support_website_url": null, "website_url": "http://www.squidbeamgames.com/twobit", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "PUZZLE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
t2 and handtracking to record precise upperbody animation.\nPerfect for standing, conversations NPC animations with rich body language.\n(Free demo limited by 100 frames of animation)\nJust press Start to record, and Stop to finish. Done!\nYour animation is ready to download form:\nQuest/Android/data/com.Demo.Mocap4All/files/\nYou can also use Blender to open .BVH, cleanup, export to .FBX and use everywhere!\n", "short_description": "Motion Capture for every Quest user. (Free Demo) Record animation an the fly! Quick and hassle-free workflow. Anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mocap4all.wordpress.com/privacy-notice/", "developer_terms_of_service_url": null, "publisher_name": "Motionman", "support_website_url": null, "website_url": "https://mocap4all.wordpress.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "535673401348331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974538_1049469385865371_6218076066739735106_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JT6WRGr25u8Q7kNvwGt_vqe&_nc_oc=AdrTgfurz6GND0FALRN1zNr3RTnCugHspVu7XBqi_W2L2TId8lbwBz6x0Z87x3vHx1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi9OF0Oe-zWqr5pWpmLlNDvgMs6IUuZnJf5oJnD3qWfA&oe=69D0F9CE"}, "is_concept": false
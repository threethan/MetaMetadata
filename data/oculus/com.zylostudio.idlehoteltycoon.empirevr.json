: "1340883271429333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1340883274762666_8251438186545099728_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QkEeDQyZqwQ7kNvwFYKyIE&_nc_oc=AdpIL4tOmKNi823JoPf6BYI_meBrXNEn4-w52lAQeeIS-7wjttK56di6wzobH44Uhkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASe_pQYnOFqFIGGj4eLRg7ObFBcIz5BCYmHbXxCczurg&oe=6A4BA145"}, {"file_name": "4.png", "id": "1350057693933747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1350057697267080_5541996545532607378_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxaU0SxrmhoQ7kNvwEYR3nA&_nc_oc=AdqY4RTO8gLQIfDsMVJSdIIG5ts4nE09GUlLpti3jzNjW7w7EbwkDjC17GuEcpMNrPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGZiCyTfZrMcsQnJUAle9NgX0mNw3n8aeJ9hYXAdZmMw&oe=6A4BA14F"}, {"file_name": "5.png", "id": "4180575492078607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823905_4180575498745273_3817655374263420975_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IX7weh744QMQ7kNvwGEj7k-&_nc_oc=Adoytb8VUD3iWpBPo65n3W3JHOcDfdjrSmaw30Xz_9GahGi8QaRgNfUUP0KBNwxCPFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3CsiteFg1dieQ2RV-MQXEsdcJoQOni1RNFFknNc779w&oe=6A4BAD4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Idle Hotel Tycoon Empire VR", "keywords": ["idlehotelgame", "hoteltycoon\t", "hotelempire\t", "businesssimulator\t", "idlesimulation\t"], "long_description": "Build your dream hotel empire from the ground up in this addictive idle tycoon VR simulation!\n\nStart with a small hotel and turn it into a world-class luxury empire. Manage rooms, upgrade facilities, serve guests, and expand your business across multiple floors and locations. Every decision helps your hotel grow bigger, better, and more profitable!\n\n\ud83c\udf1f Game Features\n\n\ud83c\udfe8 Build Your Hotel Empire\nStart small and expand into a massive luxury hotel chain.\n\n\ud83d\udcb0 Idle Income System\nEarn money even when you're offline and keep growing your empire.\n\n\ud83d\udecf\ufe0f Upgrade Everything\nImprove rooms, lobby, services, and staff to increase profits.\n\n\ud83d\udc68\u200d\ud83d\udcbc Hotel Management Gameplay\nHire staff, manage guests, and keep your hotel running smoothly.\n\n\ud83c\udf0d Expand Your Business\nUnlock new areas, floors, and hotels as you become a true tycoon.\n\n\ud83e\udd7d Immersive VR Experience\nEnjoy a fun and relaxing virtual reality hotel simulation.\n\n\u26a1 Easy to Play, Hard to Master\nSimple controls with deep progression and strategy.\n\n\ud83c\udfae Become the Ultimate Hotel Tycoon\n\nTurn a small hotel into a global empire. Optimize your earnings, upgrade faster, and build the most successful hotel chain in the world!\n\nCan you become the richest hotel tycoon?", "short_description": "Build, manage, and grow your hotel empire in this addictive idle tycoon VR simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zylostudio/privacy-policymeta-quest", "developer_terms_of_service_url": null, "publisher_name": "ZYLO Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/zylostudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "de", "fr", "it", "ko", "pt", "es", "tr", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interacti
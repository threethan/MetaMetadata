C62jsUzdBT5_qow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXjpjbdP2_Vhr_W62kpoie9jyUPYBW_eZmm8nHx0eQhw&oe=6B0F083B"}, {"file_name": "Neon Night at the Carousel of Souls.png", "id": "1379254911948809", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835815_1379254915282142_855977099255514688_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qnxmNF6ItwQ7kNvwEncwVk&_nc_oc=AdoPwlKVio1knzxm3YZPwxBn-M2GQTPf-M5uldduAQITO6pO7VPBxGx-ogZGZF_GMQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUGSSRC90Uva2rsdFiSwBpQk1kSLcWLWFPOdHQxHMhkg&oe=6B0F07AF"}, {"file_name": "Neon Night Roller Coaster Ride.png", "id": "2094534791385646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835825_2094534794718979_4665334599606330391_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq20YHm-AOQQ7kNvwHbFXjI&_nc_oc=AdoTWuNAkVMy8_rrmHhPLucuaBusZmXg0Sl6ROMUk6fGyW6TFtkNILQj55JdP8W7c_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5gLEmhFGWlWEfWNZQUmSTFk0Q7LXHJxbs0IhuE42RHA&oe=6B0F0CA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Night Mare Rails - Roller Coaster", "keywords": ["VRHorror", "RollerCoaster", "GhostShooter", "EndlessSurvival", "HauntedCarnival"], "long_description": "The park closed in 1987... but the rides never stopped.\nStrap in for NIGHTMARE RAILS, a VR horror rollercoaster where YOU fight back. Glide through a moonlit, abandoned carnival as glowing ghosts rise from the Graveyard, the Rotten Bridge and the pitch-black Ghost Tunnel. Grab your flashlight, aim with your hand, and banish every spirit before it reaches you.\nENDLESS SURVIVAL\nEvery lap is faster, with more ghosts and deadlier hazards. Blast haunted barricades off the rails, brake before broken track, and physically DUCK under low beams. Grab repair kits to save your cart's hearts. Lose them all and the coaster goes down. How many laps can you last?\nFIRE OR ICE?\nEarn Soul Coins every ride and unlock upgrades in the Soul Shop:\n\u2022\tInferno Fire Gun: a flamethrower that burns ghosts and barricades\n\u2022\tCryo Ice Gun: freeze ghosts solid, then shatter them\n\u2022\tPhoenix Feather, Spirit Shield, Harrow's Pocket Watch, Iron-Clad Cart and more\nEverything is unlocked by playing: no paywalls, no real-money purchases.\nYOUR RIDE, YOUR PACE\n\u2022\tYou control the speed with the throttle lever, and choose your path at track junctions\n\u2022\tPhotograph secret golden spirits with your Spirit Camera\n\u2022\tCollect golden tickets hidden around the park\n\u2022\tA full hands-on tutorial teaches every move", "short_description": "Ride a haunted rollercoaster through an abandoned 1987 carnival. Blast ghosts with fire and ice, dodge deadly hazards, and survive as many laps as you can."}]}, "developer_name": "Abstron", "developer_privacy_policy_url": "https://gooodygames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Gooody Games", "support_website_url": null, "website_url": "https://gooodygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1466389319886083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771284_1936219887784634_3246649921733500619_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketle
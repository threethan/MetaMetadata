LGfZdNT111iwA&oe=6AF1F970"}]}, "id": "1838813837301067", "locale": "it_IT", "screenshots": [{"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39y1QDNqLoIQ7kNvwGRK6Sr&_nc_oc=AdqQYGme2YkbA8Vcgwos6RGQWCzTnk_48DP1LnDfJDiPvd7V3ziYzRMzx2lwoqZj3JE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYQWIUOEVQnJxlWyJDNLQR1P0O41TDgtnq3nuF1uJmSA&oe=6AF1F913"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoGz6jSfN8kQ7kNvwGEOakj&_nc_oc=AdpNkmzGyANjfFcIV8S1TqM6RKgaXS7phQKH3RzWBOvGzh2UCQnVgICKgfgs7oTOCaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9puImxEjsvhzZO0l4cAwY-T5Qww8FBTmMPMY3PYBQGQ&oe=6AF1ED5F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKHYZSrUnikQ7kNvwEFKevS&_nc_oc=Adq4Vi4_eRsT4MSTl2HgU_kQOo2fvAZwd3iclbxetQNJl6V892HY18rd5xDAkgcGQ5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMU_sZVgJljd4AKu4WYv0tnS5n8f2zKFb1JAJf6ZtvbA&oe=6AF208F7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdoQWELiOU0Q7kNvwEjVxUB&_nc_oc=AdrfNqbAgrE0-b9qFY0v7n8Uz5wo7REA94voViAHNe9xicZf9O3sIqqhjzSnutOnEk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxYRKPcoUTxZQNTI0JpoBB0NFguALmvNktNHIcpZVgpA&oe=6AF1DF54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVTmglTwRIcQ7kNvwEf5VsB&_nc_oc=AdqGsnxWbZPuUS_yXKLDGDmR9jhCyft74g5vRvGncgUXtbukoYk5BPWArpGstC9-B7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbzuh2LJEKO2PwjEOYxfpeQynd1FDjZiHxbkNUL2qGMA&oe=6AF1F499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVdD19n2hxEQ7kNvwFTwL41&_nc_oc=Adresqv4WM7GVwuiYXJ7P5sLP2GdTW8yNrkSZvCv-1V3Ci0a1te28jmtepcIqTWxclU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUL-_teohKoY1Jp50jYKHADo6TIl1GFOR2C13mkr0HbA&oe=6AF1E490"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZv5p6idQ5AQ7kNvwFPJO2C&_nc_oc=AdphjKGlsgLu11_1KtQ59MkrlxTb6SnZTJnG7QCTyJUh6dLhVkkV15ZS5Qwyd7CJvG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpYHpJrAKdouo9EdaOrsXIGudn0jB3PLglkBgan9YCWQ&oe=6AF1F93C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBDZw4DOtrMQ7kNvwHVhxV1&_nc_oc=AdrXT4oux1dVF6665UMWM-pD_a_guEuSkj_ZfyCaLu2iPoA_EkQfSJfLkTJoatGLtF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtkMJX_kGwaiaFl7_jFLkNz6UzK1yzJXikI00g67M_ug&oe=6AF1DB81"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zeo4v2Pq1wkQ7kNvwFMN_2b&_nc_oc=AdoPKPpmiZgqjPoLrPz2zWRmhu1Zs80JjqoUZ12JoF1GFH-d2n3gpyPd0ZZYAKoWWGE&_nc_zt=3&_nc_ht=scontent-iad6-1
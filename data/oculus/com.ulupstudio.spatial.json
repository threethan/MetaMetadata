9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMS-1eMUd0QQ7kNvwEcFUk-&_nc_oc=AdoP9JXThzQ6vRYKnzeE5EKCFe3aTl7YV0lLru1w1Hgr4oJfF6WjjiBhyj1QX_n5dWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI3pZrfeEsb-u4TwP6Srkn--C2-diStRJxs2dBYCDm3A&oe=6AE1EA59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWpnYJTjSbkQ7kNvwHINJ2F&_nc_oc=AdrCD6Nl0iwJIZCNPZzuj-HKZKOVlwfNwAO8EoS5IMx3iEzEhF_RzmMJ6Rdg-kvasn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgKdnDBGyXWqsssBnVng-tc-a2NNbWmJ-YRg7HoxD0aw&oe=6AE21290"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddYcsTiqnPAQ7kNvwHsLWtE&_nc_oc=AdoNPVowU8--n9YoYlCcV65vzljI5T1fAxUqHmReVROlAWnhBi4KDudgydGU4XzoGjE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQkxrag5xzgOI-nu-ElgDmX4UoZvFU4cEd3I0ZgSfxrA&oe=6AE1EEFC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71CB2Qxc_r0Q7kNvwExFNxi&_nc_oc=AdrL5RltVdLC6cami94ovmoh-4LMydQs6xVS_7x6L52tdgMULq45XttWWRcIgbthHxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvu6lIBKrVAODnh8airVExyq896ABGtNliVG-hiferRA&oe=6AE20981"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qHuPJYUxqwQ7kNvwE6ux5i&_nc_oc=AdoQRmLeVO1fTIgSHLjIcEyeUYqIsHwyYNNPBEPYAhRYBy4_BDvyyP0xcDEe-QAppl0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOrX9_dW1bwrunsRHHikMCxwVnrOaEDPxzRvzvwp7_iA&oe=6AE1E765"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm4uJS0GC1gQ7kNvwHGp72P&_nc_oc=AdoLTENS-M8i68PIZiuaAY0PEYI-r_hQ3l7gjeIgGOreE63izt2AGQ-M97d5DOpFzxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo_XC7BebDqunX0XvirErZt4glQ6DpehgX_QEfPIjk6Q&oe=6AE2145E"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaGkG7Hoyo4Q7kNvwE7mSCZ&_nc_oc=AdqU3d0j406f2iezOqadHZWhmT7b8GPS4PWs_0mqtfIeIxPT6i_ibTI8uMItb-Dej5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6DVrDmzTAWsyXi_PpWLlj1vwDSjsktCEn_j9jJSKrcg&oe=6AE1F929"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vq8BjMJjx9QQ7kNvwHpFcEa&_nc_oc=AdqdcMv-8-cAS4TReJnnWy2nR8sXYuf3dM4lTKD1Jbn_tVznCRhTirXdJLO8kp0hH9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_zuCeSqiuJ9ZtPk8c6bIVzitxbuiF1_923FFnw4Bjyg&oe=6AE1EC77"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0iPL5DS_bUQ7kNvwF2BGXZ&_nc_oc=AdoMewkvPfLxVxtz_tOx2ELJbl0PDhUIzrMHmdX3z4fEMlbDujR-IUnsvR4asXBBgcM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWyDAGx8TB9JrOkO4cQBvrnFjofLJOS3fACMzTfaZQlw&oe=6AE1FBAD"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBRaWxFjadYQ7kNvwFxbOX4&_nc_oc=AdqNXxRdEzw0O46bxcxlvGjLPdh6oQUGmVj6ws9hTvk5sMEsTMJs-XV_tX-p_dIJyQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD0D_k3DD2DiSEyttSWIebqmfrxQj331hJUth2rWj6PQ&oe=6AE1E9DF"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-Gtik_z9HsQ7kNvwGsLUWM&_nc_oc=AdqGaZOK90ZrffKUGBdJhB1PexfB6KAdxqAzHBfkaD5bGOAE-2ynXKHfTw_ElhumZ5o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5NWXpNhjePE0wZEtmXyDE-7P1ZJbTzBHenLUIoohVHw&oe=6AE21644"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFTBks9EswAQ7kNvwE2D_3O&_nc_oc=AdpLB9z-9A19V1ZeL_ev28g1AnCukVOUzE4CY-6G5rWS7bjoQvk1qFZI9CEv76q8xzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL3morzS4w4QGg7P-NK2olCyomMqw6-Fd32C9_q9B_wA&oe=6AE205D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NYbJlEIBbQQ7kNvwGR9gHH&_nc_oc=AdrhBGN2NFt5h9QtBmoQ-8eqwY82RtxtWdLsoZftyaAl-Y4gp_w02RvRHy9xwXHM6D8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2SjLLAohMVm9ujUW_E9pZVvVZkHITzLnwnQd9G-iNOw&oe=6AE1F7E8"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910
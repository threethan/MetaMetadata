kXWd93KAC7jF3hfAfyqqJEsFJtrwHs8l7ZTz9lJO4vyyGGJVbFVsphY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqA0MI8C04rDppRTpC72EaxWHZQN-TemcbhuxgnrU3-w&oe=6ADCA8D3"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg8i1_Gh3KkQ7kNvwHLsUhE&_nc_oc=Adq6kWDh2f_nkp8js3DeZ97cjOxHI1F3pNrebN05SoH5kB7On53zn7wrst5OsjF0DcA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbhvfKdmDUiEDb0v_8f057gPvXTAsVlIh09nOZ6NbAfQ&oe=6ADCD55F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVe0QieQtwIQ7kNvwEsU-N0&_nc_oc=Adrfbf6P6ro35m9Tfc223HElFRhw8dcMUeAAZWNnWr_r3KMU66y_HVZ_4d3_7_Kwna8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZq6uQYCtvxCWjw1PPSBTkcEHNps8FagUhwFVa0-f2Pw&oe=6ADCB8B7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7ZxICQNGksQ7kNvwEgoNw1&_nc_oc=AdpzlJPKwkDQFdxvDysxELKv4PTqVz9ktDIGt7e_Dt0V-zW4Z9z8I0zsFnw_n3rf_H4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnmrPhpJBJ7UNV28wcTQHuZBRrUX2tk3jrhruwznHOzw&oe=6ADCC754"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdXhwcMKpHoQ7kNvwH0Nf_0&_nc_oc=AdpqMT2k5p2kbzmP_9iZBOpj0AWRS1VKg3bxtOfzYsB-f9vTud6Ge3Wg3dWqkMu78cs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3lfZYm_S2QhoAHQ4SQvOXBX18rXJktfX_3b2ahgXR_A&oe=6ADCA459"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwssyfLYvswQ7kNvwHUkGDn&_nc_oc=AdptidTP6_jewTpbNwBzSWKjldAytUw7ffPGk5DpaGh8-x6dhHr4JHHPMlI83fmlG8g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdEltZwQOLlYTbn1PowSXq1zPkNN144W0vVQS4g75l9w&oe=6ADCCC90"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBaNFtBJHioQ7kNvwHaxVeJ&_nc_oc=AdqN1W0hKF7bNIpi105woXMxq4A4reT4nfQbin4Nm-9pOoJ-BHrhCQyWQvojCebSZOE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOegrx7qpMypWeWsMG0yXVm74EyeY-wuiotj8nmCwyBHA&oe=6ADCA8FC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq9glxqiAekQ7kNvwE1XklF&_nc_oc=AdpFrx9BbXtgHnwshstMHKVkp8PcahJB4V7tAnH7oBbLHkUwKvOzX9tGT0Gcws9w758&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCsHopx44NDPUTRbomWQUf7T5xkW7_aKTJq6YP5twd1w&oe=6ADCC381"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVKd_iR_QScQ7kNvwG9MkuL&_nc_oc=AdpYWv9wOGwyHdfIU7fkm7kbe8QW8XobjtTaLRkqQvshBO-pcBqN-SfSh2jd1BLvsXw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTMPGWvJtvrJa9tOAFrjoWU60Vndqg6NloU4UAV63ldA&oe=6ADCD9A5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbhq0gqDE04Q7kNvwE7mhtT&
ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sygCshhKSYQ7kNvwFG_HTR&_nc_oc=Ado5XvedWYmszk5cSxd3yWiIbw5Xw77vVa5iWsISARX3elVHfUlNXWHurpb-KCvbDMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyedMHgjGLsGTXZjBfG3B4qVdjQz9wd8cQhIZWldavMA&oe=6B0B1577"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEcIbBnD_nIQ7kNvwGwBJje&_nc_oc=AdouL10H-E2JtuGUpSl87886hsagoe2oNuIDqQK6qKs6C1EQS8obyYzV2oRd34ls5LY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRP75Yv56PdEiu_G2GSa1VWcy0IXg-bVitXeu63Qmzb9g&oe=6B0B2414"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-A2HGDV69XsQ7kNvwGYw3o8&_nc_oc=AdpC9AxD5ywJ7YBpIhS6YGjs5gHsQBsIdvYSkYAy9ECbp_YGnkeUhPcdtx_JX0mcmi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSs3Y4pUFSIbbBDmpohCb7DDZNt93LJPYURjsbY7YDVgw&oe=6B0B3959"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9flCSWyDlcQ7kNvwHyZZdn&_nc_oc=Adoefj3BI4VsS6SwHvGOdRYK0EeAarFzEbz6OuLYsepKoJn4Hzlz8to7skKo3XsSLQ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_clnn94KIXZz4byqSPGbUvj_-_Tq50-coMaMZNm-ieQ&oe=6B0B2950"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FNP7-YgHVAQ7kNvwF87Y4t&_nc_oc=Adp3poMwX5ftM-DuDdLBZqg78oEjrQHEK3Ga0Eh4EKoWWbgeAVy-V-LiXvC1efazjG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlNgBBspgS4RhlD_qRX3-BZmNGoYfWsWpwrtIYR7BBWw&oe=6B0B3DFC"}, {"file_name":
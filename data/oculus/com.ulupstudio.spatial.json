99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oh_w5GgiHEQQ7kNvwFA7E1s&_nc_oc=AdrB0xCAwwVF74STtkBQ6fEnA7SU33zDh-gn-EdwQxlpTb8ddC2NcSbWXIC3bTXTPx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQEe33ESsniHLxPLLKEVp7Lm_fRzcb1RBiMDnj0s3vVQ&oe=6AEB6193"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsX8ivr03zMQ7kNvwHuOrM9&_nc_oc=AdrAdN52nDpatV3OfEc4L2vspYECE7xswb80e7fvfa6oOJtsI8IS2rtmNbzBrcuZUY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEyuOYzOZzKGJZ0kb0JGTeUd8QXdJmYuVhI98kgyRw9w&oe=6AEB55DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trRagYRKwWkQ7kNvwGsJT4L&_nc_oc=Adq4h27JW4zzmScj7x2_6xDYNexoW_mu7w5xxvEQ7nEjqKspDOIETUQGUS1LD-VCTZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-MGJGUdtV4s3NaPrU3D3oHR7sEYCfz4hucCkg0aywxw&oe=6AEB3937"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2as_T1sC7QQ7kNvwHECOZY&_nc_oc=AdoNQMpndG241JqcB2UtE_BrBt8e5aCjDlYw1Ct6vyYZjXvH3Yc81yvg_mtnQ9MCJXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVRrx_WmU--dx3YJ3YKOrdX8W5EODCUYfyMCVY1AzVzQ&oe=6AEB47D4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJc0ly8wbWMQ7kNvwFu_4Yq&_nc_oc=AdoYLbHMT2KltNpKQHkhfLcaEb5wzNBRuqE2KwmHV3ArFQ-FnjyPmLh6TXuSxW0PKwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfXHTxq_Dgiqzi52rym-Qc69MqjSj55NjHFR56tNkWOg&oe=6AEB5D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP-ij-qVGWgQ7kNvwGvsmQt&_nc_oc=AdpVcpo4quKWowG_WQYXMgusA904qJG3UkWB_vkKLnAA5ieSdd315wNAcVMzsgRw59w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkoGQWWvw8M6xJDYD5r8-qMDkFJ0XXRaAgN2Dn441DmQ&oe=6AEB4D10"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16nFdSQkAk4Q7kNvwGnYJ47&_nc_oc=AdpybnAoJdYVCCKJ90XNmI3AwEfxz6vr_YknCAFdRy7FBaKL7QmlFzfYnS-Nff4eQI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjurqc8ie8ulUIbW9mPyifyyrO3DzLNAO1TQRgaESx6Q&oe=6AEB61BC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmnZD7O_CKwQ7kNvwEFxLuv&_nc_oc=AdqugEWyufCWXM6PttfgzypoK7KIXQvDWi5fChv_OVR0Sg5QQoO7f2jG1t8DqMR8e_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW0n705TuALzs3ZTwjdpatUXjOW4RGeR_LMhlpKcgNTw&oe=6AEB4401"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOLJVsLTuPsQ7kNvwGpAPlK&_nc_oc=Adr_AX1xN7OeS83fw7ssLp1lDKzGrIBkxOKaOer521HkbQ540ptpaiQVQ3fe-iTBuME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx8OJbfyq_-fR7yD5SYneukuXKjxBgyhMOpBZnn9sSiQ&oe=6AEB5A25"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bndwYMg1aG8Q7kNvwGr5Yyz&_nc_oc=AdoedjTHbkMoV_vbFFiyUeY37XKxV7LDDCkxbA8tXZm8L4rDDyqzVaXg2hPxycLBtek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST3PzkyOc30Z0O1NmR8TJoHFHtIDUbblwZKJReoTEuJA&oe=6AEB4EDE"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGgJI5QT9hUQ7kNvwHmTc2X&_nc_oc=Adq2t4SmbrSTOhDe0ayqsSiSvSDLP3HFkI9D4bQQnOP7iKyLv4D7KiFjpaecJMB9fcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH-Gt-R4wEke0OALuSAVbXt9_71KE9SG0vjt09Imx2ag&oe=6AEB33A9"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cc1d8-6p11oQ7kNvwEwwM_h&_nc_oc=AdqQWlm5wi2Or8mpwRt4cgq3bLGOofnhfnMo30gM0hcOHV0uY7Q6aJ93yM45sRuktuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvb6KN2R47bLTFEDRGbNZXvhjynmE7yD1Kql_ewPYqZw&oe=6AEB5F37"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8liQyAotBcQ7kNvwF1VjgJ&_nc_oc=AdoA8YIHjvbMq-hyxxF9DSUPPasyn43F1eQfJoHBz9OlIaj-67FLePrKzxJJXD7P4ZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8YLk7tWpwUT0PnsK-22VrFgcf9_6O1mz3DxuhbCW-XQ&oe=6AEB362D"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuTAp3gUVaEQ7kNvwFPyblr&_nc_oc=AdrUSccEkMjT35BhvtYi0yx-gSFZdsk_Im7RWKGxSOWB3ipSSBApI1XK1Gj-ugIVsSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS30O97gmpfAazD-A6HtFmxQUCWpsinbp1Fv7nYUaf63A&oe=6AEB5C9F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMSRb8hE4_gQ7kNvwFjZpid&_nc_oc=AdqVMcnFgn0GOMII8mbaNSDxSTrOenon3NKNsOQtbaS3yjEcNK522ykZhCo3uKNm0mQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfC73kNeSjwJPHjGNr6dR8E0ICHYmacJ08nTeOzT7pNQ&oe=6AEB50C4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDAlfXujmz0Q7kNvwGMitL5&_nc_oc=AdpfPxtN_-ZqNvquj4hYDwIIRRbUQN5QkBHTItODbwP2pOi5EnqgYO11irQa0ftQLIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDpC-6fAgAyLcCWUxGgM6QI_8lDCoJcFqHQv0ObzBHdA&oe=6AEB4056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jIfJHGALTsQ7kNvwHdz2fn&_nc_oc=AdrrsgbTJjKTxPVbd5RpCyLh1Cia41Gh_6nA6JQQZOm1vjnxZ0LwhY_bMRkRSmQYfzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8gurhknuHJIjwllz3--Sbmar-ACQt-D35481lryRnqQ&oe=6AEB3268"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
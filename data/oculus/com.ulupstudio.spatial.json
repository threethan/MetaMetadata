99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39y1QDNqLoIQ7kNvwG5fHEi&_nc_oc=Adro1ZtP-jXJGvfZ6qmHfAtu2lRy4Zo6fXdUTJYBuzntkytsA39fjJ3kXxjR8Y0fc4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkxFtCRHyjx1ruvYaLYaH2D-S-ZaMcQArPAjI7Hedb9g&oe=6AF34A93"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoGz6jSfN8kQ7kNvwEQv0Fd&_nc_oc=Adr7ogNpWAwevhMsUP25FYgekwcy5KjANH09R-VlOXAC9pCjCMmQa4qdRbYBvz0If5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMvTsmA7mDtXie8tWj_ntnDi3ZGKgrw55bG6E5qUEAhg&oe=6AF33EDF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKHYZSrUnikQ7kNvwHBtLm_&_nc_oc=AdrrKz8rHIpZYvFE7_BIqKm4ZUHEr54MzlA5rLzzXvbVZ8LnCg_M--4fpjDd8Iijbog&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkvcnmos8DNrv25DRG4C-dfqpmXXWJUAQCC3SgTSP0sg&oe=6AF35A77"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdoQWELiOU0Q7kNvwFdahAc&_nc_oc=AdoJR3HdSs2c6t-6SyQTLDMXBgYR34mCFCO7yOGLzJRAZ_M-9wMDB9q_W0-C-gC_E_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJxNFKF2g3EZJKjhRqY_HBpOY1ZZeOwHDM-tKp02A1hg&oe=6AF330D4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVTmglTwRIcQ7kNvwGWX2Xf&_nc_oc=Adp0QMtUPvrJRynBF7fLfs55GltLrsEs8miDNNI2Q5ebeu0OVxpB7sgEZsb-fb31NCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS95wB-ZY9Nmb03eHZ6m8dYw8i45lb8kHz1BYfZDFj3Xw&oe=6AF34619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVdD19n2hxEQ7kNvwHHgrWY&_nc_oc=AdomfmPwS9y6pHQy_5sm9ls07zlGyqfW9A6ILjsHtLAZYwRfjb69q0nBLIGy8d5JOKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7GyjeeNrKsOW4MUQgd5tyPD6Z1tMmeoiNybywE4HpAw&oe=6AF33610"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZv5p6idQ5AQ7kNvwF9wya8&_nc_oc=AdpM2lnd07WmMNl91tFaa_4jdf-0mzm6szTGPC0svGF1Gnie2iTy21HwGQ1n7gfRVNk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTLDzkw1eohFZXQCEf6L7BZkFycXdP5APr82Je0OGlQQ&oe=6AF34ABC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBDZw4DOtrMQ7kNvwGZRxxo&_nc_oc=AdpxW8y63kn5PCpjFjcbfeDP6JeorbGzt9HFKK36Sjs6z8JZQd9WjmXpA_KT3RdHxjk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCzIvo9uQ_6WPjKwYLhQYN9zWmN7k3Roh2QFmGWTKFJQ&oe=6AF32D01"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zeo4v2Pq1wkQ7kNvwGiccCA&_nc_oc=AdrYD40Zbs3RV3qBYE4bNqzax8gvTuSbs6_xkjfuLLRpg0I-IYdsks5FsIYKsc0IVCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE12t-klJ-VvrZGSU4w9VME09vFVqs5G4S14In7h1Khg&oe=6AF34325"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771
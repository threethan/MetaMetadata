ost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_OnoahGreIQ7kNvwGndvcd&_nc_oc=AdqjLhVG0a2lK7eIf7bN_Vze4T43J9EgDdchinv5PMZkW3dO58B2laTYW7Hw8zUb9IY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUJYU9--ApVMLOo9uY9sbIz15wLRLyJbONiqTzzPlYkQ&oe=6ACFB213"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YjdC2xW9CkQ7kNvwHavvAw&_nc_oc=AdqthhGiTdeFfOyixxGJjSz0r992Z5wR59nFeWqqdLsgEYTlvstOoA-o2JntD8i3--8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhdwaCgnncM7sVumNQc-kw1JjzeKyqLZ_T96T0OxS7pQ&oe=6ACFA65F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPiSMXuPZ6kQ7kNvwG8aHJA&_nc_oc=AdqgEq1P9eZxeTxcnwjgk0Rp6O5yGe9wY_RHflkU7GZo8DRGN_Kxw7fk63yWCP_8w1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkZLp5EY7ozd1P33HLGHfLMX3ujNoyHx3yhRwONgFXsg&oe=6ACF89B7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3MhOjRDgiEQ7kNvwEiTSWo&_nc_oc=Adr-WMyOaws3bL3mGnsDqZjSp2tawo9hudBSYn3PQl7rhrEHmGCN2LAp90wuHUyQmC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSBmqpQag14JI6T79tyFLckatqkEVR2U2mBXbZl0QJQg&oe=6ACF9854"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0Ao7JPGPDsQ7kNvwHmgqz4&_nc_oc=AdrZ4dENpbhEJGXUnKoexLMJdP-M7LyD3weLEL_4oaJU1ImrSiZJLnpeKZuvXmN0cPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ7CjrxHe_MLrrEVzEAKbHXFQUihmQngi9fobA7jo5RA&oe=6ACFAD99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCm4c0uiisMQ7kNvwHUF8Cz&_nc_oc=Ado45FsSrxE5FbFVLRq7qd1wrmTkoc0SnlmbJgQKHXBw-JFUnsqKJ2ZtQNXg6f7I6Ow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6SEEEGqpEvDlP40PtIoE-HApeYDEorviaEkc5fj1lsA&oe=6ACF9D90"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipFsD2W0tdoQ7kNvwHsMYZT&_nc_oc=AdpARomiT7DmGyU4M_BbhtQ0Q-93PMm5Dzc62AD9qI16aVSpaqSpg4MGFWhjC7eFnS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOURSblC7RFHTRmCnJN3_em3N7yDOu7AYCRnU18E9uSMw&oe=6ACFB23C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yEmXlJhfhAQ7kNvwFmjvP-&_nc_oc=AdrOLgnjTtvFTNO_oZetTphjIxu9i89wLGYXmesyECGs2mFotICbI7tSf-E5noDy2qE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkizNU4GOop31RkQSj8nVrkqkOv3KcEhacJVhUmjMsmQ&oe=6ACF9481"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XDnF7Svj-gQ7kNvwE-hyhC&_nc_oc=AdqyS6N6arhtfO2_qPnzQrYdbpQ_Hwu9r3vdwMOMtNOD-fZnfKXwlo6FZ8hOATmcGDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp1aSP_LQLP5otRgLnWtvu0lPRsOHFFbYMq2mPD2WBVQ&oe=6ACFAAA5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_xtljdBN3kQ7kNvwGrf3ua&_nc_oc=AdpQix9p02o1Jt5i7ozDmy55hqBxyp03gKLi4w_9pFW7m6hIHRQeQmiBprmaQdwl2RM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOLyeZwg1xTt45TlI4uhsMGw8C88O_bcfJbCNBY4juXw&oe=6ACF9F5E"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAgqAfh9SMsQ7kNvwHm4F_8&_nc_oc=AdqKwzCT3AhgUSYMkc7QXNMZ-ArfIV7LBpCeoRUzvDHLJLixLwBrflIIZQDnvDB6m58&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCYsP-WpfAp0rktqLfaFo_lMnB6EBamNAJKdIm2M7FnA&oe=6ACF8429"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKaYU7EA0lQQ7kNvwEsq4Az&_nc_oc=AdrqQgD-SsS9lz4H2aNMIxNTwwESz6Udl3YD8dEc7NVa_WKwNRhp-Ou2slW_BkgU720&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqij7Mxwd9M9hxyo39sYUhaY-GgxAs_efRE4QLhE973w&oe=6ACFAFB7"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUqmBizIDMYQ7kNvwF3fWGo&_nc_oc=AdrsvOZfbOnBlR6TZ3QPrS8MVlzC89TQWXSwZUVgQSHQQRgD0IlRwUOu_0de_xpDAUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS4uym4W_GxAsDirAVc-xwI8gasiCdKMcgwk4U8-T8Rw&oe=6ACF86AD"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_so542TT7wQ7kNvwHhV1vy&_nc_oc=Adq9zE9IOTzYK4soyzaWoE_reLUPotpNWWQLj447quck1mVzOAHX7BntMyNPxPP7UXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0Y0amIVfa2A8bzKswQpq15bS_EN-OyG0y0HIAlc0HtQ&oe=6ACFAD1F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFM02V_pqFMQ7kNvwGbGXuG&_nc_oc=AdqmHI85Hb0yJvaCBauW7YuTkjvIWuUGlSF2lp8rJcXi02xBifavSkRIZ9J2htEXzWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5seGWKPH-cpR1VZThqabRh9HiGDc8DI6PNOsvZG5L8Q&oe=6ACFA144"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9sC10x67HAQ7kNvwGK0z_Z&_nc_oc=AdoZVyugUn-WyBR-98mBxZVFI-c8DNxMq13swq9mKf2uJvAqJQrgJKTfc0qPgQfM7Iw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8vL_IZN92HH83hcjdDiT1V8awyBa5vLtJFvEC45qSew&oe=6ACF90D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSIN5i4puekQ7kNvwEH_Q5k&_nc_oc=Ado3_c6SFaY6IqzoP-qVwMxt1ImbD8qiMzYO3Dx2T3xLiEMsh2_itYM-nXkUc_kQxTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy0hsi5hbLSVs_eZx7QIp6gymLr6Sev6x2IdkmGzxarw&oe=6ACF82E8"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_a
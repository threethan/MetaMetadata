j8C0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ76XCAKZkIT1LFtB75PZixIpwux6AXzIAmgZaJPwtSwA&oe=6B046E70"}]}, "id": "1838813837301067", "locale": "it_IT", "screenshots": [{"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0KktS30EawQ7kNvwHlP9Cv&_nc_oc=AdpeE5sVLvYC_qvvcHBQp1BfuAkAqccwMtu8X65SzR-Ipl2OVNDk1ISJCgXSTbmjFnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVReOwaPlwQ_0wpdRFiu2UG4_djV8N6ePYug5JsRNQpw&oe=6B046E13"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbajWI4nZFgQ7kNvwHKaLc4&_nc_oc=AdrwNvPN6Qm0kyv0C6r0sSsND1ctStzNDBQEvuAigoLblcT9yUGp5VFTNVX5aqvOWNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz4V_p_4IfmesguGJFAeJEGvlGne508v5R07OQeJh8vw&oe=6B04625F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ia2OPTsfuwQ7kNvwFFcIPT&_nc_oc=Ado8qBGQGNvXEjAe1S8YAwerFuqh1hnfS2Az0Pt_1m9jMM9_8OokhRxYa8Ig0I69SiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREFqYp9Rw0pm1cS_sIRek01Wxnhc0eb_qzN3GVnt6ehw&oe=6B047DF7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2vFM_BaP5AQ7kNvwEV-SUM&_nc_oc=Ado7IbHA2cQSgp6IX6yeV3RZsHMqbl0IXO-WEIkPfhXYo1-RmRGSld5Fav72TBoUIQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGLyGn1m6frhCFeliaKCg3mn916P7GlHdrsEJ0f_VT-w&oe=6B045454"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_EOnsL6O6cQ7kNvwEHNZyY&_nc_oc=AdpQrOctP1ZXHUh8KEZgHu25WTWUjNaXEWFpr01msSRT68ywZ2x9zFuxuayVlP3ijU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_F00EYa7yEe0Nv1xsNTQXr4egV87MXCakLfMsqlEBHA&oe=6B046999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5jbCzQZ5CkQ7kNvwF514jT&_nc_oc=AdqM1B5f_UtLG6EI07X6ncz5nOYG0qZKjHyM_L8tePlZy5Ju_9IyiprYaXgFfkwV2l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM94wD-LGnyvkjrXqiej4Bkpyj5-qYyoR4_Z5-Zeeiiw&oe=6B045990"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-DO_hBKVMUQ7kNvwFUTUoH&_nc_oc=AdoaCJqL0EGAu5SZXzPOX1FSNgdNBQRbd9hoTZJomCZ-1WPrYW-Av9RcOdTRzNFivZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM9H8uOtmhLCRFwZ_Jl4uCUwNTrYGyYBnvJef0_r-whQ&oe=6B046E3C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QZmWVo3GLoQ7kNvwEtEyJ8&_nc_oc=Adr6Cdyl_W-CFepvmXTcCSgAcqAifUxxTS8juqJCfcvcNXcNPu1bcCtNibKn3wvTtuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmS-ZWZrDqXtDQQOQoZOEEaOH7LMNuuT2bA5rzcLPhbQ&oe=6B0488C1"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": 
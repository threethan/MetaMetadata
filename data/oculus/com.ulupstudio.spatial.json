99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39y1QDNqLoIQ7kNvwGRK6Sr&_nc_oc=AdqQYGme2YkbA8Vcgwos6RGQWCzTnk_48DP1LnDfJDiPvd7V3ziYzRMzx2lwoqZj3JE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYQWIUOEVQnJxlWyJDNLQR1P0O41TDgtnq3nuF1uJmSA&oe=6AF1F913"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoGz6jSfN8kQ7kNvwGEOakj&_nc_oc=AdpNkmzGyANjfFcIV8S1TqM6RKgaXS7phQKH3RzWBOvGzh2UCQnVgICKgfgs7oTOCaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9puImxEjsvhzZO0l4cAwY-T5Qww8FBTmMPMY3PYBQGQ&oe=6AF1ED5F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKHYZSrUnikQ7kNvwEFKevS&_nc_oc=Adq4Vi4_eRsT4MSTl2HgU_kQOo2fvAZwd3iclbxetQNJl6V892HY18rd5xDAkgcGQ5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMU_sZVgJljd4AKu4WYv0tnS5n8f2zKFb1JAJf6ZtvbA&oe=6AF208F7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdoQWELiOU0Q7kNvwEjVxUB&_nc_oc=AdrfNqbAgrE0-b9qFY0v7n8Uz5wo7REA94voViAHNe9xicZf9O3sIqqhjzSnutOnEk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxYRKPcoUTxZQNTI0JpoBB0NFguALmvNktNHIcpZVgpA&oe=6AF1DF54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVTmglTwRIcQ7kNvwEf5VsB&_nc_oc=AdqGsnxWbZPuUS_yXKLDGDmR9jhCyft74g5vRvGncgUXtbukoYk5BPWArpGstC9-B7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbzuh2LJEKO2PwjEOYxfpeQynd1FDjZiHxbkNUL2qGMA&oe=6AF1F499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVdD19n2hxEQ7kNvwFTwL41&_nc_oc=Adresqv4WM7GVwuiYXJ7P5sLP2GdTW8yNrkSZvCv-1V3Ci0a1te28jmtepcIqTWxclU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUL-_teohKoY1Jp50jYKHADo6TIl1GFOR2C13mkr0HbA&oe=6AF1E490"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZv5p6idQ5AQ7kNvwFPJO2C&_nc_oc=AdphjKGlsgLu11_1KtQ59MkrlxTb6SnZTJnG7QCTyJUh6dLhVkkV15ZS5Qwyd7CJvG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpYHpJrAKdouo9EdaOrsXIGudn0jB3PLglkBgan9YCWQ&oe=6AF1F93C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBDZw4DOtrMQ7kNvwHVhxV1&_nc_oc=AdrXT4oux1dVF6665UMWM-pD_a_guEuSkj_ZfyCaLu2iPoA_EkQfSJfLkTJoatGLtF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtkMJX_kGwaiaFl7_jFLkNz6UzK1yzJXikI00g67M_ug&oe=6AF1DB81"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zeo4v2Pq1wkQ7kNvwFMN_2b&_nc_oc=AdoPKPpmiZgqjPoLrPz2zWRmhu1Zs80JjqoUZ12JoF1GFH-d2n3gpyPd0ZZYAKoWWGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxaH9Z-zHCop_pVLVNXjEYICL-zX7KEfVOcZpZIcgF0A&oe=6AF1F1A5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTyYoWwsa0wQ7kNvwG93n1y&_nc_oc=AdoPbLQva1vVUNIQRwU-UPacp_yFfHUDWDsyMtRnuoeltvHttZG6gkd2z5-akQTMQ7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkMABf7X1gyc5uiZNjS34V1w4_sijwIptVzaqpRHbUrw&oe=6AF1E65E"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8OfRaeDLK8Q7kNvwHwrKQQ&_nc_oc=Adq2qJnnsDy9bC40bl2rNfesj7aMQ1rKu33VZxe5QeLNtrbyNcVzs_gfZ23rNj0ZVEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQemQbBYGEVI1JzZEe66dsdMjewZBjZhRbZvI7xEXxXiQ&oe=6AF20369"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVJRwm5ctZIQ7kNvwFp03WK&_nc_oc=AdrF1x15RnUa-s_zVnuu39ENZXIP_EOOEKNfUXK5WM0Px7k0thzPEQHIx-VhkTqH-Rg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCFTlFitAYvs2o9_dj9KVTOX685susehEks-PbGoKQSA&oe=6AF1F6B7"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Mv2fPOBi9oQ7kNvwGsVrh5&_nc_oc=Adr6I9Q4dglCCQAz1Fmf-zXnFxyvSUshNUcb1xwpiBeefl_JDhUx9iiBCp6GN2D4lV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnnK2_Lo43srNKBmbJpz1DO1LbU4Pzu2NwesZXn8kpFQ&oe=6AF205ED"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxGcwLqQM9cQ7kNvwEKGzo_&_nc_oc=AdpPFoxBuKGP1rzP7wX62L5lRphV6xtGnBXdF1CULLw0BTWdMxqPFjDxm8F5lphJUsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqf-VXa2rD4sOE8XMuJgmtjUj3MRYmWSHnSn7UJRJZ2g&oe=6AF1F41F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk39CYDs-DYQ7kNvwHJ8M-X&_nc_oc=AdpupxAn0HkSlWgl3hrIT4F2E0ZDlD0vCWe9S8aWwB5ofCGc5bwfQa5N8TDPdldYWVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3vzEGgtIf5B8UHyJYMTEDM-vZYJBvzFDm1S1qblpNYg&oe=6AF1E844"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyPJPrF7hB0Q7kNvwFdxGoL&_nc_oc=AdofBSP14e-TTufoJAt_xFzDjibaJHt-FO8YeEHYSzGaJdBmUOqtOsNtG5GC2-NYgU0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShpXKK9VKKYCkaGsImlNk9sAFSfluFTLBXYmkS52988A&oe=6AF1D7D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9p78FMGli0Q7kNvwGa8iQX&_nc_oc=AdpURu5Sd6U0IGUXiDcPwjoSc5Cw_A4vW6t1wXbtuvNYSjcjVP2_y6vNGr1j-6w2zAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK144GHsVLoloVgtEfjvavjurl4sdOs2gxawoCxldGCQ&oe=6AF20228"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
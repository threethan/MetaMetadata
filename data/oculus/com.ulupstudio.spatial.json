ost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD-WYo3cOYkQ7kNvwFsfHtp&_nc_oc=AdpA8OovV5Pz30pKqp3OkXaEYoM8n-zHGdGyepV3g60H97s2yIzg7zowSA09rKT3z5o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxYaQlvpNXItAievo3BtrTVAWK6-OdmrZuib9wZhwnqg&oe=6AD10393"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YjdC2xW9CkQ7kNvwFPUXIj&_nc_oc=AdqufW4DoUVlrwqmVUFYyG8jY8WvHQheH3Dxy78WianI_m19Iix3ADT5h_tuR1FxFX8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4WR_N-aMbZWFFbUqWxWFrMxxmnKlcNHtXn1HapmHiAQ&oe=6AD0F7DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NldVZCp6CEQ7kNvwHCzyJ-&_nc_oc=AdoVQAHluAU7i4aQbDOhvcMkkqsJpYzpLtwVK75Tj1Zwcu2a0SeKUk3NF1P1ZNi5kXM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo3U_X3DRZGjobU_7I0IMAQde81B4N6vKVshfP922J8w&oe=6AD0DB37"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3MhOjRDgiEQ7kNvwFC1oZW&_nc_oc=AdqnAV35VLwvE9jg82CSTOIFgEqpb4OUnGP9QsUrjd82K9nYd-Qw8pngfzEiJdhleCk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRIXAcpW8dOCFwlwpt1WAFZLR_OaMSSFU9_5O8k1ELgw&oe=6AD0E9D4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ5lbyIIEFwQ7kNvwEyO4QN&_nc_oc=AdrMatoqryOLWuIPrYbdusYE_5HlTGj7l8vBvmKLXyBBPqvEkViXta89hn6o0KSkVx4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMjnccs38Cmvi9M4H5VI_8Bf1G13To52Dn1L1VUGBCxg&oe=6AD0FF19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCm4c0uiisMQ7kNvwFdqJ5v&_nc_oc=AdotdsaiXcAiLoSZf10oWBTX97nwVEacCb6bTxJV5zEa_oZ1-EeVYl3gOPjQKkJ6PI0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKdhIe-SYMX5ANjYCP7jORfndNmmM90Y_FblrqjZuTqQ&oe=6AD0EF10"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipFsD2W0tdoQ7kNvwHE7VDd&_nc_oc=AdqBJehzv9meJJxRn4U8AURwkf5k435TkcWiaJanQzDFWzKgDkY5lalx6-3qH9zziVc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv34UXNUiLv9_MDDBLDO7rceB5BsGxnbLck_QhXjIolw&oe=6AD103BC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yEmXlJhfhAQ7kNvwH_-1MR&_nc_oc=Adqd_WvTA49YEuZqbty221zZC2htZCw42HRTTUgL-pekYOikKERtSEDJgM30AeK3HDM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUzLPxWA-oGfS2qLGLvc75eS5zYaNQExv0lk_x3qfNSQ&oe=6AD0E601"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2pWSHef1z0Q7kNvwEpc52J&_nc_oc=AdpHI0XNSA3XIlvRyS8HwgCiSsheEBWQ_hFRGRMZ6wdP5zEUg3bObtM_ZTGA9q6aXbc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbYg-rNhOWL8bySFGtmzG2jk_V5XYeMY_0T35p_5rseg&oe=6AD0FC25"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njyHH16vfkQ7kNvwGZE5rM&_nc_oc=Adro46H9muhEiAw3y-cGtmVVTAf7lBLBCHxuMd4XVZv124SlmtgcTmfuTVI6nr-xO1M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHA2t0LyJdrWJt9RN4Tu3z7pOBbJEEXpo6zPtNjPBgAA&oe=6AD0F0DE"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAgqAfh9SMsQ7kNvwHfpAKN&_nc_oc=AdoWKZZs1cH0xRvdpumjNMSxPyHZFJjJCkOin5MPF4xcgww51QMnIpTlTYuVsq5Q-Tg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW_8D0JHuWrXmMj4vRLn-VjwZhyloeIBhQBJhFfcI1eQ&oe=6AD0D5A9"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKaYU7EA0lQQ7kNvwHgp_BQ&_nc_oc=AdqF5zUQY-_XKyK2cxUHG0fMPiNmo3heDAJyQRZodOClwdCfm2G4HxbYZPF-bfSsw2s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFE-TqIIwka7bH0jZmtgCMsOqrybpp3aUBysggOJIa4g&oe=6AD10137"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUqmBizIDMYQ7kNvwGGSctX&_nc_oc=Adr5PK-3AWmnuw2NOd0oPLNSxYumJbHIuCAM49HWDppS1SQo-cDoF7Sb4H2QQy-i6iI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs1QTJsEQ2AkJOMX9HAHBDggUjHgjkFiYzC_I5prZ3dQ&oe=6AD0D82D"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_so542TT7wQ7kNvwG_BrSc&_nc_oc=AdrhKqKsHtTMa1Us7W0c_JDit6RflW2bbBZCYpk_jPvzJdXE_x7Sz27aZqOLMnLUnM0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyuOgiHrNwn5xxCuhGSLZONCRSR3vKQORgyrwuf7hcFw&oe=6AD0FE9F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFM02V_pqFMQ7kNvwEI3_f3&_nc_oc=AdoOW7v8xDMD6vCWHcdWeZoXgRrFYUxUb0JYp1P3-zrt9RVyVg5n9k6rslVeUX6S2hA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7zeLd9iytD0je8icHLhXsi1I_p4yZ4nA1bnPCzXZRKg&oe=6AD0F2C4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Dg1gOFuSmgQ7kNvwEmt4A2&_nc_oc=Ado4bqSy-9JkW1eOhmvEHcBdmbwVVHeD6NHQFoMSx1nY7F_cnBP6S05umB3b6Jyqaq0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAUI_6G4FLuyeB9OETBJ1jrBgdNzavGighk8UfHgO8VQ&oe=6AD0E256"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSIN5i4puekQ7kNvwE11eCx&_nc_oc=AdqbyaDhc3USx9pIQ1gVLjKgPIZkBi7gxP0OuJn8fH0ePf8GTTcyPLMFB6DUbP5aekY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGmLvU7wzTcww9SAC85pW4IfmpJwR9DD4NgeC3-dxxwQ&oe=6AD0D468"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_a
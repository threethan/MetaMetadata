99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIbkedRQpZUQ7kNvwEPBKRu&_nc_oc=AdrdiIBUEr2welm6ezkE81_gvGyY5R25njdf68456PHfASlYxbJwUg9ygPu695Gu42s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXFVISl9Wh58UnJGTRH4jFfxWFzpRB3A5af5KetMqerQ&oe=6AF5ED93"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6chRGKOAh3QQ7kNvwG0M8Bs&_nc_oc=Ado6QUsTC3SXRypUOGav155Pz1s-NYx-euRAieTYV_9sOlU0lOzwtE1DXT8_60fSN5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuglPhxIWvXyNr5mYY1lT9VH8uFPxNpX8w6NeWa3yUlg&oe=6AF5E1DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcAj-KZvgvYQ7kNvwHIN2gu&_nc_oc=Adrl2B95LEjjIcNR2QNDTl9HUUaARdc6dip6jzrX-fkbSkVdHdJ516qUanA9kIFwPE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeKwXwFHMfb70SOCVQVPjZO4xJKG2rKwBBeP6t7-0iww&oe=6AF5C537"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11cxDY7xA10Q7kNvwH6zwGl&_nc_oc=AdqV95CdV-JHXRZRaFY3KSu1OrxUeTwzf55sfKQ9eTXuJCtFew5o836O5bX5bmz2hwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTPkVwiz60Xx5gkE8yRe-vudu1ahSD3yWbjrhhSIh0dg&oe=6AF5D3D4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESzWaZhREAcQ7kNvwGBChoU&_nc_oc=Ado3BjtDSTHuYMQLb3uD5gkHCVZGQuJiI4V5RwBt_7kL56LHuziIAxTxNVlYFeAPhYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNW5JMcXe4_T1PmmGsFmF3RIO2SqvsaWmLBJezHkHIzw&oe=6AF5E919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-3umz_ak3gQ7kNvwE0V6XV&_nc_oc=AdoMqaYR_5EA5vzwNeIDvu8dn5EoI3KGVM20A9uUMM3dv19hmKSDTr9hpzVlILZ_FDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmUFUkvuPAUNnuKu597Yz42FiyMQj3SiXc2qp8NnZL2A&oe=6AF5D910"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UYzxOlpOIcQ7kNvwFzMso2&_nc_oc=AdoIrC9MIVd8E9b_Y4LRjyrRTBikXWoBwB0bqhRfi1aFCzlOCpFMYjjvJ4wv7bpcUOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJU0FOt3BcrI_Nokq0ePpOMxAdc7VnKwQ2vXZ4m_eokQ&oe=6AF5EDBC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09vPMPj4Dv0Q7kNvwGGhVG1&_nc_oc=AdqLhuOsEaLeSMqxQUX9cCxxSDvvwc-cAg74uCB222P0o2kYCenv42RPwn4PblG-_-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk9S7bFJ4imN_wj28D4jg9OQ8NjrlGmXk1BsdvcEXZtw&oe=6AF5D001"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzfWfr4epasQ7kNvwENJYPi&_nc_oc=AdrGIlx3XFxvSXnCIDsif2DAyzDoUWssSCKbw0CkxIXHOfoI2CWph8dkOi74pTqNFbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCY9o_yAo0C7nw9AyXJLLMbPB1er4c4wfuCUbELSCe4Q&oe=6AF5E625"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771
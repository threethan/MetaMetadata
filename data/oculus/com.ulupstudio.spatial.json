&oh=00_AQQ6fil9laycwKRl0kxr5OoenYmvLJVy7A9KUuYcbQKAHw&oe=6AF0B46D"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u87ZwD3nm8MQ7kNvwECqZl6&_nc_oc=Adokdgz4GVCx0sMsM7Pd3Yylxg_sggwlpmbC1Z-QREZSVmwtyaD1nMQxs-8bkZGl4sg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkcLIKoZGXi29VHMXxCd4DEH7aniLlWCbMsyCY6a0Osg&oe=6AF0A29F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk39CYDs-DYQ7kNvwEMhUGj&_nc_oc=AdqVVCApCuEBVl6apUUHtRUJYFqZ0bl9csYDtG58O3fcVyaHo01BAmfdBEIeolxhvYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJTGRr9lRGSTRqw9h4zxY35j7YmQIVbeDlI_gmY5XjWg&oe=6AF096C4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyPJPrF7hB0Q7kNvwFK_WCA&_nc_oc=AdoSA-dznpHFdblr5kc9A4AKVeKRN7QiUSFR_mVcid9o0gSjTwszjqa7o7VyaJLjw5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJPcWdMJZYOPcO2jyj59a0ILfne-RrzCvHn2DRzH_fJw&oe=6AF08656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC81d7yjEIwQ7kNvwFdQgr_&_nc_oc=Adp3vUiGVfDUu8DLStPVYvU6PY1AXP3j3Vwi4J2vwgpubF4GNbuZusgalptsxrVt2Lc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5fFaeSPB1dO7WOG5HzDZrFul1sBibfEyWPEPyP1b8gg&oe=6AF0B0A8"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910
2_1677074720447703_5618519853673493455_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlSH1zrnDC8Q7kNvwFSRHHK&_nc_oc=Adrs_F8MKUsOT4IDLnAUjndoJVBk2b1du9vT655UpdU2Tukp8zk8FCmh-zNXIZUFwrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi94JTidshrrkqsMlv45odGxsTm1tkhF-WNbnO8XQs5w&oe=6B05BD37"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch9t8qECc1cQ7kNvwEDHrgK&_nc_oc=AdpoiinaBTd_Yvi1vpOMxUZjs867IOU1QTa9gkzGGJiJ5DLkPcpqeu_zQjckz4yC2vM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHbn7LNvGu-eUXuOUHDWsWAllKH76pvd2GMtJUnTtllA&oe=6B05CC6D"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUlanLW5IkAQ7kNvwHojLWD&_nc_oc=Adpw-Dwj_sfwf6pB0rr8C2UlyvxvxX7U26hs-zPU_IQIfxO8AoG2-WiNwoPRiPUjKwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNNN6rOAAJZo9wxMdxHLInQCY-JGaJ3mJZ9AE359wQ8A&oe=6B05BA9F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB8D9UL302cQ7kNvwG34Xpq&_nc_oc=AdqO1G0l-ZPUuTf2K1r3BrODSaLf-E_Z_QRm9RDWf4e9bNM9_qcZtmrwXjDpotWjo-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaMRIS4sJlVVObuIOsj_rZVejTcndrv9sdfX13CjJ89Q&oe=6B05AEC4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycOmjv_xaXIQ7kNvwEtUrbA&_nc_oc=AdqjKvjlhY9MZ8Px1FMp21ZgBcxK7MTntPIJaBnzTxJbBG8rdSM0GoXODPp9k3mgRYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVl5Nao0I2OLEowlztF17t8Z-lep1HrArCsY37BWGDnA&oe=6B05D696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5GB_gXM4SgQ7kNvwFRl1p9&_nc_oc=AdpTiHXcqmLpihZSboi1hXiWfl4E979fx7Uq5MAyWYMEZq0ISFqnYsX4znMlvy-WTJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh_AK2V4hM23HgXpnpo7xRmX7bQ0bIKdrzyG3eav_nIA&oe=6B05C8A8"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1312951618571452"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "29080363611555150"}]}, "baseline_offer": {"id": "29080363611555150"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790978760, "status": "PUBLISHED", "id": "29080363611555150"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1316917364841544", "version": "1.0.0"}, "id": "1873772173589839", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typenam
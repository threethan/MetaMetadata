HxFNRQUXUfh8A&oe=6AEF5670"}]}, "id": "1838813837301067", "locale": "it_IT", "screenshots": [{"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ1BW1BhvWEQ7kNvwEIRg57&_nc_oc=Adr-lXBsaBmaGtFLuZ2GJlD9quVBlzxzAZ90KtHR5nvh457ZBkZxV_1v_JgBdIOLeAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl1WIOQORaCwAVOJeVzqx6Od8U6ITJpNB12Fupy1ncug&oe=6AEF5613"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfVFgWbc5uYQ7kNvwE1-KbH&_nc_oc=AdpwLwWWyy3vB8u0zB6GyEOeWFo3BmYEOcQ34aZdUP5P76PmmXVSZreQyEFnuK_Pl6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfUVtABGSVq7CQdlPkc7rYn3SrWwDTuq1PLyjxLdGyTQ&oe=6AEF4A5F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG8iKcEL-I0Q7kNvwEdWi-R&_nc_oc=AdrB4aaJLht_Km6i9MFNRzhxnTm8ArXmhQPYBzDReElypyv0_2jB7s3KFAV0qPmyBsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRQtYtiQ1Y8s110qRUAwSbxZlbZvrWRkVwYNPLhkWcrw&oe=6AEF65F7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjX4byBHYeUQ7kNvwG9L9bZ&_nc_oc=Adr-B8bxZYIb8XifroPeuVExXyHaoBz262xlQey-mwqwW8IbfqH3ymrHfB4DFmTqwlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOh_k3-0ibshCbRQ2PC73jexdMBZnnLIkF_jH2yRwwUQ&oe=6AEF3C54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpNlQZ8jQRUQ7kNvwH-7uho&_nc_oc=AdrFUATMULJBuRfEECaRaFI9Eio1hWGvc2mEqBYWp_4vf_A423k5BMHafLeqg3ffs_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR7gA3j-UQ97zazsq_HCC1NzGFvruUuy0vs6KqQAZf5w&oe=6AEF5199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq1aLm621o0Q7kNvwE6gL7D&_nc_oc=AdrT-09u3SlX6r17tdyIxuTpt1EFEvXQrCZQ_s4JaXjCrw1tWDUSEJ09SmolfTOCcMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4gPgBR3_HMSgtKmjBByeLP7yQZhYl93qGFPX8nVajmQ&oe=6AEF4190"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKMrDPHMtO4Q7kNvwHQBsrD&_nc_oc=Adqe-dEhYXB3Ee8G6w4iyW7SaNOfKdqw0zQdolnJaV9B_fOCd0DTdML8CifjU_lhFG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRINiT_Mr5PwgKS4R793YCOOJfo2SA4am47yUdPVYKKDw&oe=6AEF563C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKiDa3IIuUcQ7kNvwH1F1nR&_nc_oc=AdruU2R_Yurx1umY5NPTO7IfqdAI-3anBlvvh6QMSilG8JHZLmF6--pQJnWGtywDPrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_91lwDtDzq5tBU1RLbavGsrJqUxnCebiPXyS4LteW0w&oe=6AEF3881"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohNxgCanRHYQ7kNvwHpqGwy&_nc_oc=AdqpClwDuhWgE0x33M7G-coYGykQlHl_zrHxtr0FwrpbbSUskGQ6i6-Iw0L0YEiIj68&_nc_zt=3&_nc_ht=scontent-ord5-2
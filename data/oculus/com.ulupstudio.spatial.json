-fq849FR6_RAQ&oe=6AE09DB0"}]}, "id": "1838813837301067", "locale": "it_IT", "screenshots": [{"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeZVkq2RSKMQ7kNvwE_dYMH&_nc_oc=AdrKfVQW_LU0yqPY2-NjlIX0eOqiDEf9bwLaujNp-F9BjNcUIZ85_DKOEt1pjtw924g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9yDnYiS9R2P6bH71C2J7q1sepf3ZWBQEl6jSx-EcuKw&oe=6AE09D53"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqJubjHjwRkQ7kNvwFKdxf-&_nc_oc=AdryWyk1VdeqHTR9_FROO7Oy3QSnd0RVAEAqeC0SJtBTUWGJzdsVJGzqgUENs5_h0Vw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA-Mpjyz_tRVzTcyl8EfzVHED1-MGZNUi3O7gZIf8cAg&oe=6AE0C9DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTtfYL5pWoUQ7kNvwE85cP7&_nc_oc=AdoyKkKF3MhJlVW1NAB7yVaNM1t9BRdtVSbUHMmnwvGBJfnHSflOBMMyBP_OA5YNkzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8yygv1qjZoCBtUYRynA0z_WnyZvCGR2FSWYzcX1c2Nw&oe=6AE0AD37"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VVBRZbY76wQ7kNvwGoT83X&_nc_oc=AdqdW-P9cpzn8dMnXMdoYRbLzHtmX9suFvoT_4qM5_C6MNswzX3U3pdHLGx__Z0_AGA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZyFYluebU3FFBtM58xrxMxQibshjcEfylbXgpp5ZgCw&oe=6AE0BBD4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMS-1eMUd0QQ7kNvwF0_Rvp&_nc_oc=AdoDajUcVI6GcwElYOpa1IQPMqMNASHVZ2qYmLF6TE92AjQpdfbQW2qUCCO4UtasjTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWEqTVz5RkZJGX2_9pWIUFo1x-WQsqt03cka38EYdS6Q&oe=6AE098D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne-CVrBWZvUQ7kNvwEoi-pg&_nc_oc=AdoIyJF-pJTXB4huyoZXnEf09FOAoQmJXxZDaGxUzIgdtwM6vrVYisKfKN4KzqbPNd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJsI0irZvgn-athHYd9ko_lu1b1pm9_jTBe0Ap1zTSSw&oe=6AE0C110"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OikAnj_Ap9gQ7kNvwHrzfuT&_nc_oc=AdqXBHeQakK1fo9DOpPFsufoztUHo_NXRuCWOmGfzIDlEuYB2K4w4ScVBY5S_xWExz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9U0IgoYnznkwQ12wqdLLrwb7LqUYmQC12_9qPsBFpvg&oe=6AE09D7C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCqIzHezbfgQ7kNvwHjX_iE&_nc_oc=AdpZDtkDwWeU_B372rznv7gjoEaqWOsiTz687OUCX6cyQFZS4B87RMQ-J12V8P15Pw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXMafAQczx7-oYaH7IIl-RqFu89cKU_aO4CC45XwBOWQ&oe=6AE0B801"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qHuPJYUxqwQ7kNvwHQAMZZ&_nc_oc=AdqsfJWCT8t82QRD2VPYtWSbQHDBkJO9lwceGZt7aCCJlS2t6NyYVJ9uDEOY4zjolm0&_nc_zt=3&_nc_ht=scontent-sjc6-1
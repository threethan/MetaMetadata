chx_5NsQu8wsV9TEfE1hiRzVOpBg7cc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPel1N756JBzDd3rz0cPzZ4GNRi8V-GeorZLFmuIcRvLA&oe=6ADDF55F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wW5SpU406sQ7kNvwE0GUtx&_nc_oc=Adpz5l9e-TcbGU4LDsRIY9JBxJzCU98cKz8o3bT4mrUXyccC2EA9c4UQREM88iEyl0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiFUmo6IW5LZoJMCyZ4XJmoiw5HvE3320olDmBPblW8g&oe=6ADE21C4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmVOQ5TnEKAQ7kNvwEpJJH5&_nc_oc=AdoRBksf8diHdxWbrCqj82vFvl2U8b8Fr48qQNG-mnrY13OL4obJo_6UIX6W7xhmC2Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq62x83BGiVvUaWlu-8x_0ZMJkxvkaAkbFl055uIFIJQ&oe=6ADE1156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNxHv2BuEfcQ7kNvwF1O5ad&_nc_oc=Adqh59QIZBxHVQa7aCz35OduPRiSBwchDpMWGGlWDqTSQLZUQZYPiXvhnINT24y4Tqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkMYiI6i29_0Peo4xrwenx1P3m6PUyMN2r_nKbl-ArKg&oe=6ADE0368"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1312951618571452"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "29080363611555150"}]}, "baseline_offer": {"id": "29080363611555150"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790978760, "status": "PUBLISHED", "id": "29080363611555150"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1316917364841544", "version": "1.0.0"}, "id": "1873772173589839", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1312951608571453", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1316917364841544"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792339390, "id": "1351307284735885", "version": "4", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1312951608571453", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1316917364841544"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1873772173589839"}]}, "change_log": null, "created_date": 1790869450, "id": "1316917364841544", "version": "1.0.0", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_fil
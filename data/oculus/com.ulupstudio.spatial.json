99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeZVkq2RSKMQ7kNvwHxbYd2&_nc_oc=AdrL-AjxGFS_oZZBsDze9HuLt5BNPdBVt60haiH4N3tQOS6q2ZRrR_9ZcdxhQ7XkZ6M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2AZ0yrmqtk5FPr5mA3X1c7bYeP4ZnmdsY3n-a3rssxw&oe=6AE34053"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeekQQtZDLIQ7kNvwFZwDAh&_nc_oc=AdoYJbJpuJzySlVZBC2SPmdRwRIdUf6c9cVYPnYbF-odCvmvcXgxFXN-0P0ClF7uZbI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKD76AFLnwe9krBYtRRAg0wYur4PLAMmC_PmRuAjZiQg&oe=6AE36CDF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTtfYL5pWoUQ7kNvwFkpsFw&_nc_oc=AdoCv15HVC7E_ZkbaZkoN2OA9H7SUjKH8W6x8F5cQ9nILXyuaF0btTKkNyKPv_DJj3g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsbs33n2ZI088u4Lx7COksFjruFEePDzvIuDzBqSDmYw&oe=6AE35037"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BjSpUBUmKQQ7kNvwF_Gtk-&_nc_oc=AdobTZqhRzMuK72SsacXDbrceZMb19guMe3uXUyF5iB7u330s0H1LnlGil8T0Yj4oio&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHddYAPKafzTvGwclzNSnZCtbjfULcN41YxlZ6cO1V9A&oe=6AE35ED4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMS-1eMUd0QQ7kNvwETapPj&_nc_oc=AdrSQTef3ENgvxI-JDeyXxOahXt328yEv5nBmoAvinvYE53KKtONCLQyFfXO7a8U0_Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOARdQTNKIZqSdJVppKkwbN5WJHHlKKjtQPACdMJS91gQ&oe=6AE33BD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWpnYJTjSbkQ7kNvwHP__cw&_nc_oc=Ado92B5fm_00HATsJ9EaBD0vVmRr4ueonIvTBReJq_Hc8kLfFS6bqbzgDCJyuGuQPmo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfvc_tHzupos0NqY32RXjY0lC6A6BrY7snXjVB4O6V5Q&oe=6AE36410"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddYcsTiqnPAQ7kNvwHzmgaX&_nc_oc=AdqT3OptaOZ9Reo9w10eJXa7vcWexrfiMcejmU5TtqwIkvl5bVriHhHC-hesUWVl_gE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-m4pyLS3nDiIc2GO-dlcKWeAl9JQY2panhAnxQBNDyQ&oe=6AE3407C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71CB2Qxc_r0Q7kNvwF8oAFf&_nc_oc=AdpC6rIMKhMcqhXkpHiKi2nYgCpxL5ryE-Hcy3URROL9QjdlovVkqNxKbFt6XHEs1ig&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_WXkA8B-GiDbvXOz_Zbd_AavIZvU-mMGr0BrZchoB1Q&oe=6AE35B01"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qHuPJYUxqwQ7kNvwEg9byA&_nc_oc=AdovB6NlnTdtFMwYpF_DkJuyL3V68bQ-mabjZWZs1PaRb8tcsz5DA24_4gbdmqOUjj0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPVyE2Wrl1iaj5vQFhXF75dVwtZexzlahfb24o1tQJ-g&oe=6AE338E5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm4uJS0GC1gQ7kNvwG2yR8W&_nc_oc=AdpvRRdqGsTwwWGhkdxo2U8cqCKQzKBOw8tEzmgLeqQUs5W-Lc9mRsLiSfmxVdP9GJo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDbPHrnVQSIPfgT8z0IdwDJgN--PA2sFt5mNFOKhJTow&oe=6AE365DE"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLlkK3i3zgUQ7kNvwEi0ejP&_nc_oc=AdoidTa3Oxo8SBHSunHZdSr8HbYGZsKhYJlbFLqEsaslI1tHQj0MU4ryi4sT-9YksBQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnVPOD-0-VYBoWIAJtHaus7o63gOMTVKlrHtqS-nNOxw&oe=6AE34AA9"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vq8BjMJjx9QQ7kNvwGTbAxV&_nc_oc=AdpqYAjwCifPk0RjU5pxkF02NweRjaRnvXVZoYKfjGtCSiv-mqrNdkPV9H5yFlFUtIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkU30OLvxrV1toFEFoEifVbF1pCc4wEdlP1OstgGzq4w&oe=6AE33DF7"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlACCfsWaZ0Q7kNvwEt1var&_nc_oc=Adq8YtpJSsH0moiMzrVKAosI-v59cM32TJe0-3sATaJETqyC5F94eoJeNQ8FOOI2dPg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe22zN1XCPLazaLU2qFX0PGZTs1Wsb9Uel8LLXtMf-Vg&oe=6AE34D2D"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBRaWxFjadYQ7kNvwEsttz0&_nc_oc=Adrrp3aDaKveSs3MgUif16dzEIhEJNjSX-pyY1tcgiF30IZtQkqRYgHs9GvwLJ64YfU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWkc4wZzrkjtIVnPB_zIXh8b-2AehRJGzI1O8KFZvWYQ&oe=6AE33B5F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAcSRVpinxEQ7kNvwGhSXRW&_nc_oc=AdqqSg6178txhOP9Q7A1VGOPAMxIC4th6UShnyIHLMUlxMG65rY2GsCtGv-90ptcf1g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOp1nIGVcEsGY2Ge0WYJ1s_fTzVFKMC_k03RGigOdZOA&oe=6AE367C4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFTBks9EswAQ7kNvwGatK9J&_nc_oc=Adqdv7v6IFN-MXoq-WmfMgCS1cwlp0At58EIFoAQm_Ng2W-tbfO50Lv6sRO2eUq0Ws8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONG5Pe0dgtMz7ZIC-JGCP6LdDbAVLPbI1XOaNC28ksGw&oe=6AE35756"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NYbJlEIBbQQ7kNvwHa0iH3&_nc_oc=AdqX0vM6_gx93p3wCyvWsbUqig9M4UGuzf8dCApjniCfiMVx2hT2YiHjrITvN440lLM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNELA649Iw71SA_3fNnSgNXGrEaWldeeH21Edhwgw-Yug&oe=6AE34968"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
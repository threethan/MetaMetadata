ost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_OnoahGreIQ7kNvwGddQ54&_nc_oc=AdoXatGCW56ojgKpQi_oBvJGRiU00YqUTGwAJCi-l7CFYTIADH82OaXNt_k95oFCsYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0cFISl0Kb6--hHav1AeLZx8xZq1CjE_R9oCspkVA3ww&oe=6ACD0F13"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6n0NCUvql8Q7kNvwE6xLn3&_nc_oc=AdqX0Lrgmkz7IVsRo_NoOV-sCoJBXePV2KzlYKEPFhw7Ah7WrFJ5q4mSRaAyiYQ7tXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr847Bm7W6S1FrvOIAcOWBN-AI5bQmswx684R7j9SBNw&oe=6ACD035F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPiSMXuPZ6kQ7kNvwE8w7EP&_nc_oc=AdqqYDnrlqNLySuSb2BVGGtsgINVwa5DBmoPuO1_3a9Adf_lic3hJb8BtPo3zb86Qhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpX2Ht5ylRleAtkKJDukl9MB0URmrhWGxeX_4FUfsxUQ&oe=6ACCE6B7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntgo6CDDfJIQ7kNvwFKVqXf&_nc_oc=AdrHKJMHIH_DVHVF9biRfLEh5hNF7EuUFmSwj4Fb43Nub57vi5cniYdoMI0o7AnGsuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM63AHWnImouD01HERO1bnZzwwaVQoezEnuvmiBI8Ki4g&oe=6ACCF554"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0Ao7JPGPDsQ7kNvwGneYYU&_nc_oc=AdoDoZIt3lZ-0uIv_K5o4pOqY_YORn-UHPMbL4k7LWJX1270PMzaW29ZtON4jUVNsHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgZStxJPv9Tpx3pH7n_QFMtlBL8AdKA3E2aoVUzs7FuQ&oe=6ACD0A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlmRN7Xmw_AQ7kNvwEDA7nR&_nc_oc=Adrr5XzAk5ddUUJ5Siu-iwF1iMhaiyUW0TiVUpiHvPnjOVuOZVdHYUAhWRkhW0ma0OM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9ihlHFzmToiVdNp5OS0_8rb93qbDyzEqx6uEbAf4jYw&oe=6ACCFA90"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmNa9E7eUIcQ7kNvwEFq0f1&_nc_oc=Adp6PiprOKPs4AQrK1azn28PjAtk9ZpfLgs0pR6XEUbzflxhu8LO241xB0kFOm4utfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpKR9s7NNiLtDgZWSOY8QqJKhwR1Kwbr4FwSKheTX3hA&oe=6ACD0F3C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFchspphudgQ7kNvwGat8Qd&_nc_oc=Adoqw2HEE6P5wyV7tegCJElvFK-GPY8oUetJji9u26To1Mb9ncLiHXRcxyM35Cn7rTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMzkmZOwpOWrf1TFAhk2z7eeRq01lixn2tB84W74LP9Q&oe=6ACCF181"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XDnF7Svj-gQ7kNvwEVPI8Q&_nc_oc=AdqP0dt0J7WAA96PJ_g3NK7v1Zo_4oIvLPSsf8qe-TcsjD8feYaQqQBoL2P_kgaVlsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWip89TyXfyqa7D7h-k_k3KvnZo2ARKfmWfG-ONlbZIw&oe=6ACD07A5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_xtljdBN3kQ7kNvwGCm4bD&_nc_oc=AdoeQMrCfNFg-QS-XVkWHhgUE9u8YTfjWfB2aAjd1ncY1fZ6hDwHJFoPPO-X8eIqsGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOesWC-JVpn__K3a9DW0mHoF9yZfQpP1SD3TulNAdil_w&oe=6ACCFC5E"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R72KHTIl8xMQ7kNvwHpWFSZ&_nc_oc=AdoKgUX9h-BG5ryHjEa0KtNsvQHgrcM7-AN-9KuMYtRXqNz62hgVciFCNccrBNyehIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH-GWIMSLrmpTZEnW_skRuutUYqTdYP78yRdSqx8J7Ig&oe=6ACD1969"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4qcp1f7q2MQ7kNvwHotOQy&_nc_oc=Adqim9EVClY0b-MGVupa1lJ9Ku9_pOCwOcVtO5muAzv9vZ6FsuxoYHY7qNqCTK7DG3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhDcfu_AvX0pJnjCTv1tdL4A6C7wB5A3S8BbdMuOxl9Q&oe=6ACD0CB7"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-vPP8kdWJkQ7kNvwGnlcyc&_nc_oc=AdrAYUSdqSl5lq0R8UOH-jlNycql-KGnypqiFNqjxbzqNmZuiulL-4cwb5XxyNRltnY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZKGlitfUHPUQmw2Y0D7wn-KVYL9LcIDUVhHPPeBZRWw&oe=6ACCE3AD"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV88amE3svIQ7kNvwF7lTra&_nc_oc=AdrZS2J4MhTU_m6MCw-oRenD6qcKTvTomUNfj9cgQWS3rtNoKGNErmpGw2n2PKn79VY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDg9o6zr1ZJ8X-VoSPIy0g_gNL23XKdZYdb3sV2zSd6Q&oe=6ACD0A1F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNi-JccCw_kQ7kNvwFnaL0M&_nc_oc=AdopkqENAUNXGyB9mzd3CU_LxWwxAdH3EYuU2HD4X0p_KN9b0-gf1dXS4Bjpi4Qj4E8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJwbdrldPD-tyWvmlqoCYOISIQAgKuxiKe08JMS3zdfQ&oe=6ACCFE44"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9sC10x67HAQ7kNvwG5K3eF&_nc_oc=Ado9HQmZKbmZ6giLPLYecnDEgUIlFcgrtdcTpUQzwHDY_hsjY1bwcXAMY5RJrZxvMvg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvRRyShaRLa4ST_snFr3RdDtvBy9b5yXHHOM6AmiPPLg&oe=6ACCEDD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SdhCg3WusQQ7kNvwEc0JPl&_nc_oc=Adp8WwLVWrNJGjbGbvk8cqOcQNpunki8uy4umzCfyhXWmHn_bkfdtjiovS_9dhXnmW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfp6-jTNq0ukQjP4vvd4ifUnlGcGX4oK6FLRWobA9SFw&oe=6ACD1828"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_a
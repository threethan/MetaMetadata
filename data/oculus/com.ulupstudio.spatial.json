ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sygCshhKSYQ7kNvwFK8G53&_nc_oc=AdrnsT1d69qGTJ0AFAhIf-IdVQ5KAvNpkm3cxE0QeILG9xx0EFeroxJ-3wSKdY_CK8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTViOWmvZu5b61KWGpATqhDiNbSZxDUonMGt4mEqfrbw&oe=6B09C3F7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEcIbBnD_nIQ7kNvwFv0jDQ&_nc_oc=Adqr5U7xBOZ17akLDh1arfalf9TtmQ-qmKMd-VwrvYGWlD2jlF_4WdWUseWQDDb7HLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ60InCTIDARTxnA82UfdA7R5FZUSw3ZHv_5KxMpLDYFw&oe=6B099A54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-A2HGDV69XsQ7kNvwEZHgx_&_nc_oc=Adqs28GACRDJpvNi3f_a7UPRX4OyyEmtyQXGetyvZyiazAiRgZsg1fr9c2BjpA-zjzE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREaxroTA4LubAsXWpsUq0d2cav-iUoDE2BYgEHv7BgXg&oe=6B09AF99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9flCSWyDlcQ7kNvwFUyZDR&_nc_oc=Adpb9hLxX6zY7v552NMj0nbVgPUKO7ILubdIeJ-Ff73ZkaaM4_Xd1TzZ8pOrMRmj530&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvEpcdrQSsQLoZOpm7smX_WefPStUnBGI-OjYBai0gSA&oe=6B099F90"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FNP7-YgHVAQ7kNvwH1yZo_&_nc_oc=Adot1mfyNKHng3aywy8ijMDpHf183YZA-_RLo9DfRhj1p6wcx_70DBNfQ4TTwZCC-u4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Y3FPeAYa_PJXQFVWO69tz6jPzSgktyiyRFmAYj3paA&oe=6B09B43C"}, {"file_name":
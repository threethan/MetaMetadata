99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ1BW1BhvWEQ7kNvwGQKw7b&_nc_oc=Adrjv7Kd38fDZcJpWppIiGYBxkoMNZ1t7zjZTpNXsJ3f8y3mSc4tQ1zSgpRrOLsTpIw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS21j1LCfylG8HLkXA4cVIwVthaZJpK07G97kIXGlTtaw&oe=6AECB313"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsX8ivr03zMQ7kNvwHSEpau&_nc_oc=AdoGG92zCmYGHfg8phMmV7tIKPYg9E2P1v36lKxMnQwks4algUpDm_qfA20okUnFKd0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp5dFc_5e4Cd_41gQET99l2wQlbyYXNZku2GLNT_LqIg&oe=6AECA75F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG8iKcEL-I0Q7kNvwEOI73i&_nc_oc=AdpgzAvTEUdnQFl0zlDvwVOcIZbuC5vtdC_bxVhin00lha9WXxRc9Lz3gd78TZMrzlA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMiNQVoPYwKj47KLFfe7V7BOGCqOoXx2iFM_tHZJFRig&oe=6AEC8AB7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2as_T1sC7QQ7kNvwFlkUr2&_nc_oc=AdoYdtxe8nZnJBvUrIeMYcNG6TflIt3uI2QY-OrIssn9t0QehryXqpCpyNwL4nk7HDA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFJ8UDV9mqB4d5QahbU9FLyuUa2_Y82NhkUEJrUSr-gQ&oe=6AEC9954"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpNlQZ8jQRUQ7kNvwFtswvf&_nc_oc=Adrzu6Tyw1AEKRvaZmtVLAfTTOVUeOSm-wAj3GLmOCpiud3qwmBgczSPUB2e1ghd8do&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuKGAoem6_W7rWnPEUTZKj5s5qYoXnEjp4BPcCX_kjWQ&oe=6AECAE99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP-ij-qVGWgQ7kNvwEr3YwB&_nc_oc=Ado8D1c8M1JsnWg3vZqbLObu3RffRqWrFILzdVGWbEiqD8oqSodPLCNvhd0qzk2_De8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ODls6Bl7lrLKRhkuy7HXxrZ6Q9YhQxpbQAsomlBqKA&oe=6AEC9E90"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16nFdSQkAk4Q7kNvwFFiVEi&_nc_oc=Adp7Id34tH7zcEJAEEX0rUn2cjc9kdeYE7lTZQwPy2pLBdBxB3tgSSpqTUUEw7uGGxo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeGvumqrt55nxVcaxyIrjWXHNAuz_LKPxzG2-wmcb5aQ&oe=6AECB33C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmnZD7O_CKwQ7kNvwGCFwCa&_nc_oc=AdrNAqeZKP42jPnPAyKFblm5tCOt51MzsZTktPYB95bNNfign4htAOdA9AECo9WS8SE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTdnDP5DwSMIBKcIPZdiz5yL_ZMqyUftPZvH5K72mW7g&oe=6AEC9581"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohNxgCanRHYQ7kNvwFvDtYM&_nc_oc=AdoWVlI5EESFTHYyYcFlduoBgieotBc6xZCIt4Bh3IRFJd5uhfOxs3qDw-DnnmY0fs4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbA5Uzqr0nweE8whi0sDrl7RbFtNHQK0UVW6_LGShf7A&oe=6AECABA5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJNf-Y9w4-IQ7kNvwEnxEhD&_nc_oc=AdpT41c0QfaKbMg8GXLakfGjAkZ08QTRoPapTHGiZxpnoP5d9Cf32M05tp_XOYi_hC8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTklHlZACbPXn2umcMKBUj8bnLNo3KUqPFIApChAl8bTA&oe=6AECA05E"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGgJI5QT9hUQ7kNvwHYc2Ni&_nc_oc=Adqs7Ccud4yirRRiafglZEcBDfEF3lqA4Dl4It4ZOCzdst4AtbdoQqV0DPxS4mNt1tw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTHfGrDmhFvBzhXdyw92YbE4S9_OM9Hu0BtKgQXQUkUg&oe=6AEC8529"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cc1d8-6p11oQ7kNvwFTsW_B&_nc_oc=AdoZaMzaGDo2hJueckh5EcoZEfYBOWGwWsTHJ1Ov4YJv7G7U5iASATrVzp1gxzUIaC4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmAnbb31XaMUEnfziMCHLYN2wPY4OVrFek_xT1Ul8G3w&oe=6AECB0B7"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8liQyAotBcQ7kNvwFGfpm-&_nc_oc=AdpB-x-0XLq5A1jnWPnv2B-ZTentMIBxf7ZnrxgutM1xWrTLNXeeC8aijQ9y9j59gpA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0VftBD2NVF9tV_m5bJGctKEvRMevGDV_M2VOKpJZvYg&oe=6AEC87AD"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuTAp3gUVaEQ7kNvwHeI_FX&_nc_oc=AdoMgi-HDPbg7Ibuql6f6cF8VdUN86fPOMlgGZi8b_VrNWNCzd6GsgjuQM8wFMgLXrc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnxtdDBVlo4Zbm2XubG5RNY_23LuTXzUm2ir5lmKq7Dw&oe=6AECAE1F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMSRb8hE4_gQ7kNvwF5t_h1&_nc_oc=Adq8uCVdzZOK1AxSBsYkf-IElLqvnl37ySHnAz6C1V30p7rDOW408qjiY6xdnyQHNGE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUy9U5tXSfnNnQpVo-UtfvSlLljSjg6w7yKZONlAZGXw&oe=6AECA244"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ikTEySvTb0Q7kNvwG2d21k&_nc_oc=Adqf2dG-4bBY_x3zMKZPsBOnxrytlkVbyhluyy9Vfjg3kSB5-po1-hsFFSKXSdo_O58&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7LSkym6Mpd9IZWvuog6LdbSY6BWhRcyZ53hcaLuZhEA&oe=6AEC91D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jIfJHGALTsQ7kNvwEdklGF&_nc_oc=AdpheZ4f7vPSln4zObmQkv96cqWKd-_Vrc1V5X4oGm_6Drae4AjIC7-8s4GIy_XexfI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL6Ia7iXuKVzpJBI_w0WXiFJJD6--nOAgfb78eKoqQKA&oe=6AECBC28"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
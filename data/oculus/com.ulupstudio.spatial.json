30pKqp3OkXaEYoM8n-zHGdGyepV3g60H97s2yIzg7zowSA09rKT3z5o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxYaQlvpNXItAievo3BtrTVAWK6-OdmrZuib9wZhwnqg&oe=6AD10393"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YjdC2xW9CkQ7kNvwFPUXIj&_nc_oc=AdqufW4DoUVlrwqmVUFYyG8jY8WvHQheH3Dxy78WianI_m19Iix3ADT5h_tuR1FxFX8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4WR_N-aMbZWFFbUqWxWFrMxxmnKlcNHtXn1HapmHiAQ&oe=6AD0F7DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NldVZCp6CEQ7kNvwHCzyJ-&_nc_oc=AdoVQAHluAU7i4aQbDOhvcMkkqsJpYzpLtwVK75Tj1Zwcu2a0SeKUk3NF1P1ZNi5kXM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo3U_X3DRZGjobU_7I0IMAQde81B4N6vKVshfP922J8w&oe=6AD0DB37"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3MhOjRDgiEQ7kNvwFC1oZW&_nc_oc=AdqnAV35VLwvE9jg82CSTOIFgEqpb4OUnGP9QsUrjd82K9nYd-Qw8pngfzEiJdhleCk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRIXAcpW8dOCFwlwpt1WAFZLR_OaMSSFU9_5O8k1ELgw&oe=6AD0E9D4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ5lbyIIEFwQ7kNvwEyO4QN&_nc_oc=AdrMatoqryOLWuIPrYbdusYE_5HlTGj7l8vBvmKLXyBBPqvEkViXta89hn6o0KSkVx4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMjnccs38Cmvi9M4H5VI_8Bf1G13To52Dn1L1VUGBCxg&oe=6AD0FF19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCm4c0uiisMQ7kNvwFdqJ5v&_nc_oc=AdotdsaiXcAiLoSZf10oWBTX97nwVEacCb6bTxJV5zEa_oZ1-EeVYl3gOPjQKkJ6PI0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKdhIe-SYMX5ANjYCP7jORfndNmmM90Y_FblrqjZuTqQ&oe=6AD0EF10"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipFsD2W0tdoQ7kNvwHE7VDd&_nc_oc=AdqBJehzv9meJJxRn4U8AURwkf5k435TkcWiaJanQzDFWzKgDkY5lalx6-3qH9zziVc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv34UXNUiLv9_MDDBLDO7rceB5BsGxnbLck_QhXjIolw&oe=6AD103BC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yEmXlJhfhAQ7kNvwH_-1MR&_nc_oc=Adqd_WvTA49YEuZqbty221zZC2htZCw42HRTTUgL-pekYOikKERtSEDJgM30AeK3HDM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUzLPxWA-oGfS2qLGLvc75eS5zYaNQExv0lk_x3qfNSQ&oe=6AD0E601"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2pWSHef1z0Q7kNvwEpc52J&_nc_oc=AdpHI0XNSA3XIlvRyS8HwgCiSsheEBWQ_hFRGRMZ6wdP5zEUg3bObtM_ZTGA9q6aXbc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbYg-rNhOWL8bySFGtmzG2jk_V5XYeMY_0T35p_5rseg&oe=6AD0FC25"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njyHH16vfkQ7kNvwGZE5rM&
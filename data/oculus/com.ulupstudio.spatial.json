99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIbkedRQpZUQ7kNvwFwRGid&_nc_oc=AdrbRRTT0RRPaf6W20tYUObRBsVNgt4S9J2n_mBH2oBXOsppmqRyCe9qE1FGrHOC4bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThYTZr8n7ZjwNmeJq1VfhZR74-kaY6PWiXod0n4hdxBA&oe=6AF49C13"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoGz6jSfN8kQ7kNvwFqq2Ok&_nc_oc=AdrkK-U4JvfdP9OY1ZZJ7IKpuCmIYTRbBF7L0wtd_jTj_5eXd58sZ0MYpWKCjz1UlrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQALH_dSYEHFsmLVJmM1KIOxE6layy_xe7yqnNGYVPDzw&oe=6AF4905F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcAj-KZvgvYQ7kNvwFvPN7T&_nc_oc=AdqgJHTSf7wjpUn9i9IoWQ3yiVNqor1y7gzW4O6fW5t6qGD8TIs_azxAAsM6d_mIAns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgZSTKV6A656KOMa50bAB-AoetzaSI7Lt6P0gnxsuCJA&oe=6AF473B7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdoQWELiOU0Q7kNvwFh42rc&_nc_oc=AdrOPi1o-DYV9g2LlJLvbIDTtXM1cVcLScsFfLuke5UZjvXFLpOciKWJ6VN932OPklg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnP6TBbMKCevvhbMSBXOiXBWYQ5N_5hZTfR8QWmHLl2Q&oe=6AF48254"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESzWaZhREAcQ7kNvwGxVzw6&_nc_oc=AdrN7uBMQXKI8_0l9urpMcx1YBtsgM_SktWMA4am3P7fnQaVnfvgmsjEmssmzVkerRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxwvEi1Cgi64AWu8hTJSySToyYq8rmW1qqTwxewiRWVQ&oe=6AF49799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVdD19n2hxEQ7kNvwEXx4LB&_nc_oc=Adp6CZWyFNkTN2jh1jz9ZHYYiuPsIhjqdBIZs2osNtN-Il03DBbkWvQxeWmbwXq36Fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1_Q9v_r2IvIDJ0XwnnexYNN2EkddZEQrYzwxhB9Afow&oe=6AF48790"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZv5p6idQ5AQ7kNvwH9hg40&_nc_oc=AdqNRUzdmsPm8lIZSsWMo_h7AMEfMl5BGs8Z8atC9P6YO6Icr6KIIpnL3Edtop7EgJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHmvUQWIF2Ae5lDt4YfHJPkQ5NjxR7SSARmJMPtDfUkA&oe=6AF49C3C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBDZw4DOtrMQ7kNvwHyEugI&_nc_oc=AdpLWRYzlezDXmL2spMZR451BoU_YnIi6sTmo2rFGr38RpuDrlUFj6RO8i5dlYcHGWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUcNg3DlgwbDBpfbkUg5mdyaYlxs7J5QNIBLVxLbeQeA&oe=6AF47E81"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzfWfr4epasQ7kNvwE_i7Qd&_nc_oc=AdqNaC64qB6QpxS9vwihu1cTUNXCzbq1JMzYkEUW13h_JigHHe3c20-4I-A1TWP57Zg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgV6F6YyLGBPDS4hzWMnI9YE38EF4ifkg3Rv6DzjZqtg&oe=6AF494A5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771
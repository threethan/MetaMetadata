M9HMmZq2YygSMgRvqlpNso-18khsubZkl3kosazKvu8owguqrDT5ezc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5yvu5VE2vCwP0latej5YU-gH9KqilYt1aDpIxVBXnqw&oe=6AD3A693"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq7AtJzkud0Q7kNvwGn5Val&_nc_oc=Adr6pRkOJLaR8rRms8C4F3E95sY4GJ381RpLhVHQR7E1ryGXXMbDW91kOHXYiYT3OJA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgH1bp430G7MnHv-Un0jtLHxMOBtZY_mGWojCwEVSp_g&oe=6AD39ADF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NldVZCp6CEQ7kNvwGPwidd&_nc_oc=AdqVkgDdQZHmo8mgHC6c34PbibgFX9JtXmRYtEPjP6R1JrvmUN3IsTNhjKzpYOzz5-A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIBOgQ_XekieqzH46B1fqtrSU8ecBNKv8Fo_nQ6X_7Tg&oe=6AD3B677"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5SrqfHCub4Q7kNvwHDW3OM&_nc_oc=Adox6NsxlZeFjfVm2PpsO9VwbsYxU8OfGKH-OrYp4Bx56VJP7UOlK2WNPPUCZvXJCf4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ86n_jFbS32SW8XXwlx6UGIqOa0VSQ3ky5mgBtDrOtw&oe=6AD38CD4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ5lbyIIEFwQ7kNvwFMCquR&_nc_oc=AdqraCESh9nK0TFGi4uJQTxFz4g31jPgA6ByelICBmQz2tjhLy7xwzOwPhFGKv-LI34&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-vaYHzglsoJpR-Y0Qq7_8KyAGxvzmF5DdqOyqNpfr9g&oe=6AD3A219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2Uf-YKhhwwQ7kNvwG8e9Wo&_nc_oc=AdpHnD3tTJ4e045Oar-30C-oGcBfnl4T1dcAZdXDLP7_xFCjbP9XpYSbpT_hPa3wQzQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPajgzfGpgP2AqjTvr0CXC3Z8rvfzPTa72VsVHxjMmH9g&oe=6AD39210"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy8X-0JuU0IQ7kNvwEGTdhr&_nc_oc=AdoM48gQ48W9xzya5DMdGx9WlJ-yOlVlDblxHO_HXpk6SslAterVNvECZiJf6j1cnKE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4z00ALE3Gm-HX8SIRZ8MruUlPDHOiKISBvirJ_kGrtg&oe=6AD3A6BC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRC_-rsopSQQ7kNvwF_9QE3&_nc_oc=Adqhdsv6PeG7pdy0nQd41MXK67psumGQMlLvsIg-MstHECzWmLcvADrY3_WjfMh7XGs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqgpuvL0a6mN3Vi4eJF8RQPgDEy-4snnrs3hKzpP3BFQ&oe=6AD38901"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2pWSHef1z0Q7kNvwHvZA9c&_nc_oc=AdrRomRJghF6mfSqTkgCxApS9E2njzeo7tdMuAH_D9dNJDWwx5eXR-OCPvhUdXRPF4g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqjl8je2_TLqs73G_D3HEdl355H9hkf8ir70JHLT82iw&oe=6AD39F25"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njyHH16vfkQ7kNvwEVGhFo&
99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeZVkq2RSKMQ7kNvwGyDYz9&_nc_oc=AdodVVT_bFe48qJk2rXsN7IQZiZvIEeZSoM8Roojji1v-TRydQPz_jx8TyJDB5AQFzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6JOF4nVT2QBH7vL5U7uuvapY01ooTxy8vsq3Pi50Xkw&oe=6AE1EED3"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeekQQtZDLIQ7kNvwEz-Cm_&_nc_oc=AdowADzuje1hBsTLK5UQNZZE28ayHAtNKpkbRv9Ls0rMDqZRSmJZKpx2_lt9dgh-LAk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv6fb7QoYTbNvVojlKcv5zrBMGQamLqMm51mrU2x8ciA&oe=6AE21B5F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTtfYL5pWoUQ7kNvwF-uCz9&_nc_oc=Adpgny2kYvLFPcpdjBevziju_m7Su4ZiCcy-zEyq7PMQ7rntCKAxGjIIEsyz1KbLjm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwG9Y2RamDsgHntnJmAsyUVjYVry0R4go82elg8IiOnw&oe=6AE1FEB7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BjSpUBUmKQQ7kNvwGQojrM&_nc_oc=Adov4EwthxmC-H4tMWOOGnHqGOB4CwaHPr3VFYWAJXQ-E77gxaYlPk3ZykDaCed-ar8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkLt1bVOjbFT99KngFD1FS9kIA7D9vWnmfy6_kHUxRBg&oe=6AE20D54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMS-1eMUd0QQ7kNvwEcFUk-&_nc_oc=AdoP9JXThzQ6vRYKnzeE5EKCFe3aTl7YV0lLru1w1Hgr4oJfF6WjjiBhyj1QX_n5dWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI3pZrfeEsb-u4TwP6Srkn--C2-diStRJxs2dBYCDm3A&oe=6AE1EA59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWpnYJTjSbkQ7kNvwHINJ2F&_nc_oc=AdrCD6Nl0iwJIZCNPZzuj-HKZKOVlwfNwAO8EoS5IMx3iEzEhF_RzmMJ6Rdg-kvasn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgKdnDBGyXWqsssBnVng-tc-a2NNbWmJ-YRg7HoxD0aw&oe=6AE21290"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddYcsTiqnPAQ7kNvwHsLWtE&_nc_oc=AdoNPVowU8--n9YoYlCcV65vzljI5T1fAxUqHmReVROlAWnhBi4KDudgydGU4XzoGjE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQkxrag5xzgOI-nu-ElgDmX4UoZvFU4cEd3I0ZgSfxrA&oe=6AE1EEFC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71CB2Qxc_r0Q7kNvwExFNxi&_nc_oc=AdrL5RltVdLC6cami94ovmoh-4LMydQs6xVS_7x6L52tdgMULq45XttWWRcIgbthHxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvu6lIBKrVAODnh8airVExyq896ABGtNliVG-hiferRA&oe=6AE20981"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qHuPJYUxqwQ7kNvwE6ux5i&_nc_oc=AdoQRmLeVO1fTIgSHLjIcEyeUYqIsHwyYNNPBEPYAhRYBy4_BDvyyP0xcDEe-QAppl0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOrX9_dW1bwrunsRHHikMCxwVnrOaEDPxzRvzvwp7_iA&oe=6AE1E765"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771
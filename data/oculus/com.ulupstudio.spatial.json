ost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSloLfBjPTYQ7kNvwEyluLq&_nc_oc=Ado9o1BTtwuhazYGgmMDYE51ZU4xwWxLe-q2Q0Y9NVov-g0a2TZjsi6__lZQJYkwBCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX4BDjprfxMRt_1v7mk4i156BkQxC2zsMhTfxm8wQ-aQ&oe=6ADF4BD3"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqJubjHjwRkQ7kNvwF3n0Cm&_nc_oc=Adpnfv1VH-Al_sJvrt6WkqVw72QPXq0XbuYgTVlZOduGOdtMKUBDa7JeGtOw1q1PNaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV7tIF5xRfLSLpP4Ll68EZXrraO1LhE1ieEqLBmXBlhw&oe=6ADF785F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVe0QieQtwIQ7kNvwEgn9i1&_nc_oc=Adouo4tI95Ly20TOWoALKtt9bRruXVROAGiRYU1-ULjQ3M5oWZxsthPoES97eAZpGnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKqP-Gm0xodCQzqvoyOnW0vPWp1-JVeFv17dq9Ko3nhA&oe=6ADF5BB7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VVBRZbY76wQ7kNvwFjGpbo&_nc_oc=AdpK72rXYttCHDpGA6KR7xG6iRTS7H4ABbUSnlRzWjOkiEG5XbhAKbXIhNpA3MsNc1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUSFnJQWRG003EcLCIHT3Qv6EBIhCJIL5Yc9eafVM3nA&oe=6ADF6A54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdXhwcMKpHoQ7kNvwHnUdWj&_nc_oc=AdpNe6Rb9nQbvaw8UrnFYktrCCTsun1ROz6iNNLXAYfrzzLfPKzPy8UtUpqDwS0iCNE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWD-bokSma7XJdLU2o6m3zFz8pBiopXwKBNOJC1D2Ilw&oe=6ADF4759"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne-CVrBWZvUQ7kNvwGEOCBs&_nc_oc=AdqdIZ6rBx8tGeDm1E0hYAQoPnXkhoHcgiEOscY6UevhPwzgBDcn0Z8GnkAbdPDf1T4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSSfdchbw6joMJiRN7zyZAvXyTU59RgPf9cypw4MSmww&oe=6ADF6F90"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OikAnj_Ap9gQ7kNvwE63vX9&_nc_oc=AdoRRitECqDpoLCKopEMmYg4pb2e5mLiKBYOFmTViCEsYodsSAILz0rar5TSqJdJwsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8ZnylVWJ-4OMiY3mpU0jhwkdSAyrCltAxhNR3TbZ-Gw&oe=6ADF4BFC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCqIzHezbfgQ7kNvwEjbYbf&_nc_oc=Adrhg9iDxdlrJIXGV8gBZVFVPIUS4qPTNaLXO9CLqdgqDZ6ovLSgwVBJPmPiKKLal6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiVmc0t7UYsIG-MQ884dxHYC8bZQsMKOtfNJNKG_JhwQ&oe=6ADF6681"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVKd_iR_QScQ7kNvwHH3QhL&_nc_oc=AdqayjcHJOd7uQgbTHWv6Eg5LcYlh0FCEibQYs1_eHfyru0oIdfSKCd-LjeGDE29g0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOANtoT7VQvbdvczL-IvjxEb7AFPiEmSIbVaWY8wAEAxw&oe=6ADF4465"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbhq0gqDE04Q7kNvwEmT7hq&_nc_oc=Adrg9gZfRDvIB8UQiVhxHPf6OhqBnkeLrs-KL4Jxx0ApVwr92hZmr04b5WcnfjH9RnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiwZvSIoI8cPVTMipskhni9Mxwog_qC1pL_kljj5Q3Fw&oe=6ADF715E"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaGkG7Hoyo4Q7kNvwESdnq-&_nc_oc=AdpySv0CtYX5qYvIO0fS58lX5E57quVWwOm72OCztIwrC--gmQGcoQpV3nWJ2WCBzH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBK2eu9QpADAqWlAmELd6WLf493d_Nl_GY1psQ6DdwtA&oe=6ADF5629"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNPd-B5zUhsQ7kNvwGm83h_&_nc_oc=AdovY55ieVnmDVev_ahy0zf7-1OmglFp6445wXXkAnIGv2JbWjyxm97AKNnxwi5NZvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODHVjhUMr_hy_WjJLXEUgq4nnGQa3Dfu2bF4jHzY8Z-w&oe=6ADF4977"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0iPL5DS_bUQ7kNvwFh0lnz&_nc_oc=AdpSVSVgkAB3hchxvGNKnuQRNCtGZAXP9_A7QasLk6rGSi10SVEqm_kVz_WC1ahv97c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6ov-Mtjn62AENXDbh9CCmJBiUliYSUIWXTaKmFMyMUA&oe=6ADF58AD"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_CzCEsjEDcQ7kNvwFs_yxE&_nc_oc=Adp6zLbMYo51RuYWEUhYLzEBZo0TKd5Wid6wgvhfBNP2bhRbOCaVFOFAmlxrKR6bJa0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5U_S_rmjuAuHJZKiFoelKWKGY8vuB647ALcFjc290SA&oe=6ADF46DF"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-Gtik_z9HsQ7kNvwGQfwDY&_nc_oc=AdpkbT3fcUD67IvWZYrhMe2MOdJAGcScUkOpQNt0YLAb1f7J8nwf2tPIeR58nKMHz-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2-2tZbErDlSgh3yJfuL8dp5OvyjiruBZaxxbsVkGYzg&oe=6ADF7344"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmVOQ5TnEKAQ7kNvwGzh8rO&_nc_oc=Adq3S9jZkFMbvvXnvRKZ-f5PtNqIF-xvpsyvZ_nKhZBL1a5N1sHEBp1e8ONEeBd9kyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjaOllmNx-BZYVNeHeJF0Qybvjxbd5oUFGg0AAloBLHw&oe=6ADF62D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNxHv2BuEfcQ7kNvwGVJ09a&_nc_oc=AdoLYe2tvO83GcamlDPmWsBEmulrKEbR9e_0OoZ883hKWwAPbJWJSKKsgngkW7fdOdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrE9eQDPM9ccuMYpBXyJ2bjGxUChN0yZ8o9zSXTbYFNw&oe=6ADF54E8"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_a
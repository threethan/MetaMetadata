jgKpQi_oBvJGRiU00YqUTGwAJCi-l7CFYTIADH82OaXNt_k95oFCsYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0cFISl0Kb6--hHav1AeLZx8xZq1CjE_R9oCspkVA3ww&oe=6ACD0F13"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6n0NCUvql8Q7kNvwE6xLn3&_nc_oc=AdqX0Lrgmkz7IVsRo_NoOV-sCoJBXePV2KzlYKEPFhw7Ah7WrFJ5q4mSRaAyiYQ7tXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr847Bm7W6S1FrvOIAcOWBN-AI5bQmswx684R7j9SBNw&oe=6ACD035F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPiSMXuPZ6kQ7kNvwE8w7EP&_nc_oc=AdqqYDnrlqNLySuSb2BVGGtsgINVwa5DBmoPuO1_3a9Adf_lic3hJb8BtPo3zb86Qhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpX2Ht5ylRleAtkKJDukl9MB0URmrhWGxeX_4FUfsxUQ&oe=6ACCE6B7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntgo6CDDfJIQ7kNvwFKVqXf&_nc_oc=AdrHKJMHIH_DVHVF9biRfLEh5hNF7EuUFmSwj4Fb43Nub57vi5cniYdoMI0o7AnGsuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM63AHWnImouD01HERO1bnZzwwaVQoezEnuvmiBI8Ki4g&oe=6ACCF554"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0Ao7JPGPDsQ7kNvwGneYYU&_nc_oc=AdoDoZIt3lZ-0uIv_K5o4pOqY_YORn-UHPMbL4k7LWJX1270PMzaW29ZtON4jUVNsHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgZStxJPv9Tpx3pH7n_QFMtlBL8AdKA3E2aoVUzs7FuQ&oe=6ACD0A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlmRN7Xmw_AQ7kNvwEDA7nR&_nc_oc=Adrr5XzAk5ddUUJ5Siu-iwF1iMhaiyUW0TiVUpiHvPnjOVuOZVdHYUAhWRkhW0ma0OM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9ihlHFzmToiVdNp5OS0_8rb93qbDyzEqx6uEbAf4jYw&oe=6ACCFA90"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmNa9E7eUIcQ7kNvwEFq0f1&_nc_oc=Adp6PiprOKPs4AQrK1azn28PjAtk9ZpfLgs0pR6XEUbzflxhu8LO241xB0kFOm4utfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpKR9s7NNiLtDgZWSOY8QqJKhwR1Kwbr4FwSKheTX3hA&oe=6ACD0F3C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFchspphudgQ7kNvwGat8Qd&_nc_oc=Adoqw2HEE6P5wyV7tegCJElvFK-GPY8oUetJji9u26To1Mb9ncLiHXRcxyM35Cn7rTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMzkmZOwpOWrf1TFAhk2z7eeRq01lixn2tB84W74LP9Q&oe=6ACCF181"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XDnF7Svj-gQ7kNvwEVPI8Q&_nc_oc=AdqP0dt0J7WAA96PJ_g3NK7v1Zo_4oIvLPSsf8qe-TcsjD8feYaQqQBoL2P_kgaVlsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWip89TyXfyqa7D7h-k_k3KvnZo2ARKfmWfG-ONlbZIw&oe=6ACD07A5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_xtljdBN3kQ7kNvwGCm4bD&
x-ClI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9WBmXNqBj_xQS9UCuqRblwm75L1_nvnsYw1QnWDtEzg&oe=6AFC8570"}]}, "id": "1838813837301067", "locale": "it_IT", "screenshots": [{"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns7uDxTpy-UQ7kNvwEwRdW_&_nc_oc=AdrhUll1q_HqMXGGbdJBggweY-zNu6mVhVL_5zAlUdqkO5sSvRrL-OdcCF8Lrvf4UQ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSziaDbJ3DXKC1A9sJ7NupOENyBkef3kENepdRvhfWRWg&oe=6AFC8513"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsLyHFAcv3IQ7kNvwHNCZca&_nc_oc=AdoRmwP2bVZZ5B_1h1IrzBOJqu4b58mFIWLNuzZkkFJ1GIJSi-mk8c-i2_WzDBWLo8A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3lD058akgqXlIoITOi9UeoCFmM89ZDmaxp4n2Zse_sw&oe=6AFC795F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWgcMRWMV5oQ7kNvwGoNbyo&_nc_oc=AdoJIOzmTzEaYS6hs_2Ws8JZoAlvo18PNpaAc-YdrWaozUPE-IDMIWYmnQ0PVQFgyHQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5jnetrGhilXwBZKgAOKQlmuPLbdDlQC4HYOzABRFBfA&oe=6AFC94F7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfdDTzypoS8Q7kNvwFYgNVC&_nc_oc=AdqFU5NraFKuyyezE29LWteGttwQVUIjaLcsP2pBdmyC9Z3w_S-qzuvTx_SIXAHvssM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkTr6hcSji1eF_t94341NdQqFb87QbPrr39vwv4H45Cg&oe=6AFC6B54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W65wG7YyezgQ7kNvwGxcVWg&_nc_oc=AdqLvHAs4aDsj_B6-g313k5BMt8P-hrSJ8SgeL58VYnqN_W-qJsUn1mWYG01EsLsJ9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2DuX-2_7FdPtTbaCZIKBSUzu9cmU4FFFlD8nhCCOYoQ&oe=6AFC8099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPUgLe7Tr4sQ7kNvwFWFeil&_nc_oc=Adonrh67TE71gAydyrEGxCn8fQbyUyDfeGPpwtACLR9btlqwy4OWeteJX8pAsBDNLP8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0jbRm8vYvDh-BCEXwVILkbexwavqdp5VaaTAde4x5IA&oe=6AFC7090"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuoWj7JQqJMQ7kNvwF4XfHh&_nc_oc=AdpxyZKNpv2Mg3GLFKEilGVTAmVlAofyPJ5AgQpDQ6mqrXInAgO_eFNaAVCZY-P38gM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkFkW-2gYsi_PZw-XuiVDQbHRXFvooDKnoV_-qXKgMJQ&oe=6AFC853C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2i2zb6NQikQ7kNvwFBXQk4&_nc_oc=Adpm08V0nSoFE4-cOFT4u10ThTSpoY6V4-j99Xoro8Xsp9sEvI_cKNIhaCNbNclM8As&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkEG_nBiCHPUs7db3zhO3u5sorJi_riyojFoygAG53ng&oe=6AFC6781"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": 
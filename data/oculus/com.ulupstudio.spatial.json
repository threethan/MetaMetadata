0BjuWogYXMiE5VIlz_psQ3hTKVluedtNT7JFaFuh2OYPfNIJQ9ndU2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEK2espld1To3yue1dyKxhgGFeVNxNY9XLXqeBkm8WeQ&oe=6ADDFA53"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqJubjHjwRkQ7kNvwER0rNZ&_nc_oc=Adp71ycGUS-8q2_bnJR4SE1duPTvhiM3y-lvgtOxGQk04uXDS7r4dm7Dpq-8vHk_6a4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6FunRud3-QCFkGbJ4szk5GuWo2JSWoaRUbenuPG0RSw&oe=6ADE26DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVe0QieQtwIQ7kNvwEPZAjM&_nc_oc=Adq1m3flQNwwrzzLQ7b1TQNuyrX3WcMZ6ewHYYZM5xDk_7ezWnuM2Dl8OFzvWik1rYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWgEHUJurDHVyt77ufFXiDd4CzuPnxKxJB_tTKAhqTGg&oe=6ADE0A37"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VVBRZbY76wQ7kNvwHeLL38&_nc_oc=AdoPW7B8wBKa4phC3pZKsgapG1mSSJNkp2lLwwLN0y_luWQW3EjYFOQsEB-sNOpGrRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYbDVPzjSc7tG7qO001yX1YKPaXMTWsD-tcEHcPHzRuQ&oe=6ADE18D4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdXhwcMKpHoQ7kNvwGUyrRy&_nc_oc=AdrsLjz-7BFrYyqhaPobElDTohWU4Qa7JC9EL4ZFlr3gQR76jrYtMEPtGMOBbbZK7aA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM00nc62uSu6yCIAd-CLl0kE8f3hEfkvcA2LANv61FBXQ&oe=6ADDF5D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne-CVrBWZvUQ7kNvwHCAibf&_nc_oc=AdoFSGbgqDmd15HN0er1ihcYtARYIXxMfUL2KSH-ZCS49hU-d-iYZCr2pNH6tMgf4DU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBCRD3_XxyHSx0ql_8mbFQ1GMtwmO_-di1jmDl4485Bw&oe=6ADE1E10"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OikAnj_Ap9gQ7kNvwFpJKkC&_nc_oc=AdqyrTElt99KFnbJkkDHhFT0OIBePo3QRP3eEv82362laZXEVTTpKGFJ3KC6re-JaLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIJH8bm9rT1lUaeyqaEq39hf6sDTuwRjEIXH2LoD2hYQ&oe=6ADDFA7C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCqIzHezbfgQ7kNvwG3Av0t&_nc_oc=AdoWT-77Jh3xxil3vJa50YdkCUIktRUgc0vUfiWS7YuxlvuY1qYdfgJ4Cz7adf2awbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE-8veoq479AtQZC5OwVgHdBQ9Daeg9Y_bD6sAXAabYQ&oe=6ADE1501"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVKd_iR_QScQ7kNvwHKAPxe&_nc_oc=Adoh_1hQ8iHDFVrwZVPvTdlotyvXhnDqkh2vvDtoIeyTyVO9klU5RSd5XttWSSjcXCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE6HLHC7cd6Te1BQHCgx3RpnPSViQsmy-TV-CUiziP8g&oe=6ADDF2E5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbhq0gqDE04Q7kNvwEtYKN7&
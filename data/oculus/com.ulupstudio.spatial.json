MIIPazempv7Mj6ZTcaeAQ1OCFn59vSb5Av3LIQ4cJiM5jXJYIPwDE0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMimlG8XiX_Kj20XnLRGyiUii9XPICqKi5YwVWdD9c8Ag&oe=6AD25513"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq7AtJzkud0Q7kNvwH871pV&_nc_oc=Ado311ArbBXegI5RuBirXQ42KttyZk0uU5fI2ojQex-zTqqhT8gYkgK0_pS1yanbeFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaQjnoL_adiWEijfokrLFT1FsarFTYZV02CNM7hOJn1Q&oe=6AD2495F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NldVZCp6CEQ7kNvwFFlJ9X&_nc_oc=Adrh78GVKVy9vgkUBIIE7GaJZJpNz_H7Sw1pcJIK8auAr9e7ylBt6NY4HkB8zd6z5Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNocxfPZ16QQRhoPNdttotHM3nSuMtXbxzQxEz6qtF2qw&oe=6AD22CB7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5SrqfHCub4Q7kNvwEfB1V6&_nc_oc=AdomOu6op-apMDQjBITi2tk7HhB-BkZlC_bx_gevwsTPV-MTjoWej-ou35R_t0uDgKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI5WTszPkn5-zP0yMz6m6jH119CxHYGUrf_ioUs2q5sw&oe=6AD23B54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ5lbyIIEFwQ7kNvwEKHUIF&_nc_oc=AdrG80SRHoHmeSzVAB0-1bjfSgPvHkhTfXMQ4iaoP1owfXxQiiq3fayQLLg58bE7G6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhkhjQzHylACGYnIlcl3anVcpHRAlCqJqmodrTOMFVDQ&oe=6AD25099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2Uf-YKhhwwQ7kNvwH-3rHu&_nc_oc=Adp-luKm3GGm5IigoY-c9t9NZMKvFdDZ_7FViC4SL1XPtntaNxdclllu0RRAgHVjw88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVRTcIhYDncQlu188sVjHtSSVpqfSfY4X59z79PbTNIw&oe=6AD24090"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy8X-0JuU0IQ7kNvwHGL0DS&_nc_oc=AdpuyInK1BbCcfiXamhm0og6SwwfsRtEKfcvUerVdmv2gwJqxNByZz7QYGte63eJaPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhllH87uSpLBayiogFh0bLT4_NNqjxKJmrhgX9ugqFEQ&oe=6AD2553C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRC_-rsopSQQ7kNvwGX-udH&_nc_oc=Adq2G43BovMP112nwQqHiQehMhhbNtbFByy9Kq4QHqdIObWQO3JgPnZefJzxjP2tGI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU_u8j5inc8JFOqOotRZEWiPRZIBIrvOT2C4pD2DqcRg&oe=6AD23781"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2pWSHef1z0Q7kNvwEasNVz&_nc_oc=AdokOq_zGnIlIZVhOx7baAmiEwBsbmcFwq2fDDZtc__GC042wqWJiWYnw7KzpC4JcfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBiwLCftA70JIZxznBQb4PUm5vlf_tWuVA0TTLNv1u9Q&oe=6AD24DA5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njyHH16vfkQ7kNvwFZaQfe&
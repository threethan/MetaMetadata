99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ1BW1BhvWEQ7kNvwF1dYal&_nc_oc=AdpBHnCW9fXO514ELPdQ69yzTxTZaCaWIaP9GtP4-_FtOngc2a6iN3erRRo7NMhU99Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCZdcFMLGw2EXlkXJE8sKMb5rYoqJFgEkqDArC6SJ2iA&oe=6AEE0493"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfVFgWbc5uYQ7kNvwHqFzmb&_nc_oc=Adqaa192H_B3csg_FJYvNHMVRa8WATyrNb5UzgQu7m4PJ83aIfn6D1JcqcZ8PhLpu9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGNGpba44qFzeQKaEbrXSaeifCLhbQOrdrfZYD3d9J4g&oe=6AEDF8DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG8iKcEL-I0Q7kNvwG1sI-8&_nc_oc=AdoOd-lsEqHinFy6dF8k5ZeatBdYEF6-13VTI3Kasfr08nAjRAzo1dbC54GycGquzEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHjEvrJCa2rCYmBSNKz8wDCIvpxHlB4y_9BJIAyMxDXg&oe=6AEDDC37"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjX4byBHYeUQ7kNvwFkhIZW&_nc_oc=AdoLrdwHSSVUvJ0fkrkC8nrn1HzOlCgGmEw_WEsJXt2wugdqX14IZGGJJuOJ0yeaU44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH1iT7qGCmQSMJ5MwmZfHhvgc6V_qnrCnISAKhM1WLRA&oe=6AEDEAD4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpNlQZ8jQRUQ7kNvwEkIagk&_nc_oc=AdrH4OkX0pMw2bcnhh-SlQCdMM693kq8e9Eyr3vOSHI5bqRDxjEasXP2k7KvT8KXJjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2AfD6aGbvRZNJN_RU6ah3-xlOI0zvr2ZWAlLqNGnk4g&oe=6AEE0019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq1aLm621o0Q7kNvwHQPvuG&_nc_oc=Ado9ap026z-W2egszFlaTIOw7A3f0ATMVYcwTnQ94KYUbXQitLDyjHf7AdHaCHBQclA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXKVP6d3p9ZievJ3kQkP2-bBO_6A4hDCfByw0llQDb8g&oe=6AEDF010"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKMrDPHMtO4Q7kNvwF8csL4&_nc_oc=AdpZJl4jWACQJwjm8rVNmOCJqyPN2DJ_MLrkJRR40YresAYFos7_lqZ_u_VP88Y7m0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd5p4ar9rjkZbdkbadMQ9gJEASRXuiSHxc6wMeRpIfig&oe=6AEE04BC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKiDa3IIuUcQ7kNvwFtGGL-&_nc_oc=AdrHyiVsDVZ78vQ_AcISDC840nrEf5s_tKhLK7r0uF9watBGgQUjgnTL4Q70casgd10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGrpF00sIykGKl_u4wdRsmsBJt2T6xBl6AqpJxpdNvkA&oe=6AEDE701"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohNxgCanRHYQ7kNvwGQm9li&_nc_oc=AdpLYV0ymFqQYovkMPVfMDYpH3LAoJJeEcVX_p4-YUYBEtW9-7Ezt_9eX7_svOj3pTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB7jTRUSOHIsNXJTyeRdiQUax_hyq7bhnpf-ge_rtGLg&oe=6AEDFD25"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJNf-Y9w4-IQ7kNvwEHPEGW&_nc_oc=Ado-1XHxmEBdIxlb2aEFEr7C6SIsCA4qi5cc6Bu1cJX3r93FNXUe_iNhEdGUClyHYnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdDgTzriOG3Fcn0wjj1fFkyR1sQKmq9WDiImd6LohJBA&oe=6AEDF1DE"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGgJI5QT9hUQ7kNvwFPn1r2&_nc_oc=AdpM4vCg9nccMTEW_V0rHitu84NgcQLpZEj29wkJK_RwpJCprQfwBvDEwWQug77BuFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlczmYFW7NvgQaALhSpWSk9xgBcW86LxQRNjTm6ykwgw&oe=6AEDD6A9"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMpITjaCWFUQ7kNvwGeRyhM&_nc_oc=Adq5cGuWuHMQW-BsnfsujAd1tNdSUweIfVL-bTUyanMl0lnIxOvOza079IXovUyHZso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzaKFVpCBeNPabnIDjT8dO-jLg5aPACkYawTp-HE40Qg&oe=6AEE0237"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8liQyAotBcQ7kNvwHg-lH6&_nc_oc=AdrufZzwQz8sOvvhLXIW0DYZ77-ENm7JVmFqMFNFeOxAT0udRFvxl53w0RjD8hLZdy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwMjGjEOzmKdqG6zjrPAhUY--1IMaiN8jbmvj2pPbwWw&oe=6AEDD92D"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u87ZwD3nm8MQ7kNvwGfzzBb&_nc_oc=AdoFxfxxR2mSnkRia20KGF-cd3EuMUQMye_aq72Np3ctb3HkaXYxO9oerYyujYxlbKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvVXWVS9bw6_o5mrw_8DMhbzMrl3IiaVPhE7Z7061HTQ&oe=6AEDFF9F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMSRb8hE4_gQ7kNvwF5qHRa&_nc_oc=Adp9xp7UPfpq8-xdgeQKgO_G1kXSdrWbM-saDidYdC72ttmjRZjsBHoujulOdyUcSQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTObi6IMbAVS-AYGFc3RBG7JhEnCdd-zDkaogRG125wuQ&oe=6AEDF3C4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ikTEySvTb0Q7kNvwEYQKjC&_nc_oc=Adp9A0zeqiSSFt6kRC965DbGBRsWij7SCWwVbFXjIEOkgxJ3OKEiL0tsDyamZuyg2AE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaqHJhqquOxIdgpATxOYowRzxiUWS5aGgIkAjfYb2WlA&oe=6AEDE356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC81d7yjEIwQ7kNvwEm0GLe&_nc_oc=AdoDwswKCAKXRUmHNKZAp45Sl0zXMwCPLNvMCJTclHObwN8-ubxbQ-dxZ5oAElz7K3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQWYmgCkEkS-E7T8oQl6P7ikZe5XYlD5u3KOwtPbAS1g&oe=6AEDD568"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
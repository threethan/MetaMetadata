99522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS8QE_JVS_YQ7kNvwH-Ept_&_nc_oc=AdqhBnTsTRmqDiyIHYlB_5n9BjDNy_neqjwsPtFEcVIzgYtsOWEVVNsl8Pe4SIGBA6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqOuCPd3HaY9d8ETR2dUB61y7xJIdbgUrSBLOB6XkoQQ&oe=6AF89093"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6chRGKOAh3QQ7kNvwHV9X2v&_nc_oc=AdqF2CfyQknLT6Y3pq0e6XUul9F7NzM5jex6BcvZmCRiFRIjloq5JUBuiH4wNa0qk5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSihLe9rWlOd3tGdJ56wqMznadOQW5ptinjzcXeIeyi9g&oe=6AF884DF"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E_41FgIJlcQ7kNvwFBB2ec&_nc_oc=AdoLw2BTX7YmptGit0ssvQAkcRtY_qLCiKcb3bORV1TYookzTxJWKu85mEKo4LzSUPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwgBv68Z3pvH1KMWygX6P2IyXt3er3PNjZlivBVLqEXA&oe=6AF8A077"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11cxDY7xA10Q7kNvwGY2J1n&_nc_oc=Adpa_aE8i_ySMS-FUIqOJ2wn5UVa-CuoR40FBrZlplmMXBhOxHdQKKNaYtmcwydTOfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR10HRrm5z2TlnhTAmTzCTGtpLcbYxYtnoYmzicPvVhEQ&oe=6AF876D4"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYyM7JI4G8QQ7kNvwHMx8Iq&_nc_oc=Adp2i-pnSpG_jvwA58lLo7XZ0mvIaiNXZQ63palgLaqjqpS8wxp4w2rJhKH4v3qTfSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiaeziQ5arpXzcG-iEOPbyvfsSloDKQ_Q0cIK_2FjnvA&oe=6AF88C19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-3umz_ak3gQ7kNvwHKrSFO&_nc_oc=AdpX0Wi_BJrRH8eEpnXoxnzkM3oTG09wrd6g1Edlhjt0bg-MhR1n_2Ch7S0Tf0L4rHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDMefn9KOfPbgtSS-HQ8KHCfRm8YZ9ZWQPiCygTcKpJg&oe=6AF87C10"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UYzxOlpOIcQ7kNvwH-xeax&_nc_oc=AdqFpDbJDStq6DYopxyAPlwWsZG-QqOMGwNr1iNC4QkZABDF8pKGbZDK7qs89KvXVHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRszhDpHFNkqOKAApnEaSMFTMobOXQhn44ma-h145r4uw&oe=6AF890BC"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09vPMPj4Dv0Q7kNvwHqhOBk&_nc_oc=Ado1k1YGwK0z1qocjuJrzg2Xz1ogvfeVZf4xXpyuQj4Ev1uB1wkom5AFb--ktkAAeVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoI1ZshrbNWqH8gl5TLEPLPn2HTCuUlRyrE8rGCHORCw&oe=6AF8AB41"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_zYGexzQOIQ7kNvwFmB--6&_nc_oc=AdqGbE4f0E6eNCrepiPIFG6TR8Wu3NZ-kboF32-sLy_hz49WBaCtKhEkzqmsBwChBv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-F-Ia_IEdwPduJHm81--KVDmNKmjVAYC8FDsYSWf-lg&oe=6AF88925"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771
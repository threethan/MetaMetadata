ost_w2gA8rmjnH_16x9.png", "id": "1818699519278915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1818699522612248_4533455245099816290_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VD-WYo3cOYkQ7kNvwHkYavk&_nc_oc=AdqEhococXH_MIIPazempv7Mj6ZTcaeAQ1OCFn59vSb5Av3LIQ4cJiM5jXJYIPwDE0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMimlG8XiX_Kj20XnLRGyiUii9XPICqKi5YwVWdD9c8Ag&oe=6AD25513"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1645264790487635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1645264793820968_1481936203299324057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq7AtJzkud0Q7kNvwH871pV&_nc_oc=Ado311ArbBXegI5RuBirXQ42KttyZk0uU5fI2ojQex-zTqqhT8gYkgK0_pS1yanbeFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaQjnoL_adiWEijfokrLFT1FsarFTYZV02CNM7hOJn1Q&oe=6AD2495F"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1027026563684693", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1027026567018026_1660229937269981496_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NldVZCp6CEQ7kNvwFFlJ9X&_nc_oc=Adrh78GVKVy9vgkUBIIE7GaJZJpNz_H7Sw1pcJIK8auAr9e7ylBt6NY4HkB8zd6z5Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNocxfPZ16QQRhoPNdttotHM3nSuMtXbxzQxEz6qtF2qw&oe=6AD22CB7"}, {"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "2153270322262940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673652249_2153270325596273_2707198577192042918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5SrqfHCub4Q7kNvwEfB1V6&_nc_oc=AdomOu6op-apMDQjBITi2tk7HhB-BkZlC_bx_gevwsTPV-MTjoWej-ou35R_t0uDgKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI5WTszPkn5-zP0yMz6m6jH119CxHYGUrf_ioUs2q5sw&oe=6AD23B54"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1067058546131316", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1067058549464649_85759188282202320_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ5lbyIIEFwQ7kNvwEKHUIF&_nc_oc=AdrG80SRHoHmeSzVAB0-1bjfSgPvHkhTfXMQ4iaoP1owfXxQiiq3fayQLLg58bE7G6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhkhjQzHylACGYnIlcl3anVcpHRAlCqJqmodrTOMFVDQ&oe=6AD25099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "2685734508548045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2685734511881378_3839269232491950372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2Uf-YKhhwwQ7kNvwH-3rHu&_nc_oc=Adp-luKm3GGm5IigoY-c9t9NZMKvFdDZ_7FViC4SL1XPtntaNxdclllu0RRAgHVjw88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVRTcIhYDncQlu188sVjHtSSVpqfSfY4X59z79PbTNIw&oe=6AD24090"}, "display_name": "UluP Spatial", "keywords": ["produttivit\u00e0", "realt\u00e0mista", "progetti", "mani", "collaborazione"], "long_description": "UluP Spatial porta la mappa dei tuoi progetti UluP Spaces nella realt\u00e0 mista su Quest. Invece di una tela piatta su uno schermo, i nodi del tuo progetto fluttuano intorno a te come veri oggetti 3D che puoi afferrare, spostare e collegare con le tue mani.\n\n**Cosa puoi fare:**\n- Vedi i tuoi progetti e nodi reali, sincronizzati in tempo reale dal tuo account UluP Spaces\n- Afferra e riposiziona i nodi con hand tracking o controller\n- Apri un nodo per vedere e completare i task, aggiungine di nuovi a voce o con la tastiera virtuale\n- Disegna collegamenti tra i nodi per mappare come le tue idee si relazionano\n- Concentrati su un singolo task con note e un timer integrato\n- Visualizza allegati immagine e file direttamente nella scena\n- Lavora sullo stesso progetto insieme a un collaboratore, in tempo reale \u2014 vedi chi \u00e8 online e cosa sta facendo\n- Passa da AR (passthrough, la tua stanza reale) a VR completa\n\nUluP Spatial usa lo stesso account e gli stessi progetti di UluP Spaces (web/desktop) \u2014 niente da configurare due volte, niente di duplicato. Accedi e i tuoi progetti sono gi\u00e0 l\u00ec, incluse eventuali automazioni create con UluP SDK Studio (costruiscine una tu, o importa un template pronto dalla libreria della community \u2014 basta parlare con Claude per crearne una via MCP).", "short_description": "La mappa del tuo progetto, in realt\u00e0 mista. Afferra i nodi, collega le idee, gestisci i task con le mani \u2014 sincronizzata in tempo reale con il tuo account UluP Spaces."}, {"images": {"nodes": [{"file_name": "spatial-banner (1).png", "id": "2382445852525002", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2382445855858335_7138643287115300965_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy8X-0JuU0IQ7kNvwHGL0DS&_nc_oc=AdpuyInK1BbCcfiXamhm0og6SwwfsRtEKfcvUerVdmv2gwJqxNByZz7QYGte63eJaPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhllH87uSpLBayiogFh0bLT4_NNqjxKJmrhgX9ugqFEQ&oe=6AD2553C"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1608104100808199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_1608104107474865_7754736957045553453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRC_-rsopSQQ7kNvwGX-udH&_nc_oc=Adq2G43BovMP112nwQqHiQehMhhbNtbFByy9Kq4QHqdIObWQO3JgPnZefJzxjP2tGI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU_u8j5inc8JFOqOotRZEWiPRZIBIrvOT2C4pD2DqcRg&oe=6AD23781"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1593351859005122", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1593351865671788_2270217285466024058_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2pWSHef1z0Q7kNvwEasNVz&_nc_oc=AdokOq_zGnIlIZVhOx7baAmiEwBsbmcFwq2fDDZtc__GC042wqWJiWYnw7KzpC4JcfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBiwLCftA70JIZxznBQb4PUm5vlf_tWuVA0TTLNv1u9Q&oe=6AD24DA5"}, {"file_name": "ulup-spatial-logo (1).png", "id": "1090972580309949", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1090972583643282_4131135753565673900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njyHH16vfkQ7kNvwFZaQfe&_nc_oc=AdqpNJrpiTFxitpzBRkGBf5X8ogNvFQiowxRTn5JLC3wGCqRLUmdl_UPr34NJI2w1Qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNhUtKRfIMvHvCepZKjJqBqdAxQLDwbkJCQSulE6xWQQ&oe=6AD2425E"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1090636453800314", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1090636457133647_6442307859406608571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAgqAfh9SMsQ7kNvwFlWZ0P&_nc_oc=Adrv6X5vB03sBOSdJVqtxKI0cdrtXjCMybMgzFaNq2YJaTdjiGXkLWsU_tr0um6igNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgqpyG9t73damfj4zzFSvt7BxZ6aIhQHjZEewLZ4vozA&oe=6AD22729"}]}, "id": "995602590224627", "locale": "en_US", "screenshots": [{"file_name": "ApplicationFrameHost_X6a0Oh3mYa_16x9.png", "id": "1677074717114370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_1677074720447703_5618519853673493455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLqzFKqYzgoQ7kNvwF2XmQJ&_nc_oc=AdorPtBt5qocBqDJZX998gW2NS9cyieUODPhk2ucgjmIclzskgqsIZgl1FxO-t3kdjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv_eQfvkxLtmtSru-mTGw9yYTkdjw2o6Tgn2eAABlkqg&oe=6AD252B7"}, {"file_name": "ApplicationFrameHost_2JYnPdfHG9_16x9.png", "id": "1621134649514967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1621134652848300_1490796086755638049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUqmBizIDMYQ7kNvwEXZ4jP&_nc_oc=AdqCL17_Talyu5yBjlinahkedR0seZK9eUAt5cl-9UGp0lp8WbDNIvvKRvZQmlrDOj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD0Vw8WxmH6DE8SxuaDU18N5WgA8Xrcb8lmBR3mUKTCg&oe=6AD229AD"}, {"file_name": "ApplicationFrameHost_w2gA8rmjnH_16x9.png", "id": "1076269148371312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_1076269155037978_773783658790453776_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLJvqB7ZPq4Q7kNvwHXVjOM&_nc_oc=AdosBBeU1t7ACcXPwDAq1E5ful_6-aIDmQCtyukr-T20Kp-eka9vMiMYfy-ahUdNhhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxA4APtHJ1S88vJMUKI-tYA0rbDaom1xld4eikHTdI9g&oe=6AD2501F"}, {"file_name": "ApplicationFrameHost_WJg5wom5YU_16x9.png", "id": "1839101883739871", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1839101887073204_1369626186002792851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFM02V_pqFMQ7kNvwFA9RwS&_nc_oc=Ado26SBnLNYA8Atg98o1i4OPkKwm1n1l1Lln-ypDm_f3I9-z8POpUPZmOUS2l5ZNgd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDRWFVhXyghc5YXqAit96HfSupcND-XMiCzIh7K2XD_g&oe=6AD24444"}, {"file_name": "ApplicationFrameHost_ho5YNaQE9r_16x9 (1).png", "id": "1627886348715787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_1627886352049120_8054576045411958904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Dg1gOFuSmgQ7kNvwGq_B3s&_nc_oc=AdrqkoRF8xQiBsh0MCTh0SV5dWKePRQSi2s-CYcKywwKOf76DRxaOQaoH860Ykq06c8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs-PrTmt8Kx8r76dGfFXDkPBwg2BWvdTJdxf9DRkPYLw&oe=6AD233D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "officialtrailer (1).png", "id": "1410773183811260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_1410773187144593_6502129704163225488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmF1eK4yThYQ7kNvwGArWWx&_nc_oc=Ado4PRqcJ6McRwmeDrikn692ENYUubL29xRJC8BdpHrfLCavGnyPX_h2Q6SeFi26C4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFScRX1jxpW_mrZWLx02cTb3TDodwKszhbqLdl8EHrgA&oe=6AD225E8"}, "display_name": "UluP Spatial", "keywords": ["productivity", "projects", "mixedreality", "handtracking", "collaboration"], "long_description": "UluP Spatial brings your UluP Spaces project map into mixed reality on Quest. Instead of a flat canvas on a screen, your project's nodes float around you as real 3D objects you grab, move and connect with your own hands.\n\n**What you can do:**\n- See your real projects and nodes, synced live from your UluP Spaces account\n- Grab and reposition nodes with hand tracking or controllers\n- Open a node to view and check off tasks, add new ones by voice or virtual keyboard\n- Draw connections between nodes to map how your ideas relate\n- Focus on a single task with notes and a built-in timer\n- View image and file attachments directly in the scene\n- Work on the same project together with a collaborator, in real time \u2014 see who's online and what they're working on\n- Switch between AR (passthrough, your real room) and full VR\n\nUluP Spatial uses the same account and the same projects as UluP Spaces (web/desktop) \u2014 nothing to set up twice, nothing duplicated. Sign in and your projects are already there, including any automation you've built with UluP SDK Studio (build one yourself, or import a ready-made one from the community template library \u2014 just talk to Claude to create one via MCP).", "short_description": "Your project map, in mixed reality. Grab nodes, connect ideas, manage tasks with your hands \u2014 synced live with your UluP Spaces account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ulupstudio.com/privacy", "developer_terms_of_service_url": "https://www.ulupstudio.com/privacy", "publisher_name": "UluP Studio", "support_website_url": "https://www.ulupstudio.com/support", "website_url": "https://www.ulupstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_a
th guided lessons, quizzes, and realistic environments, STiXR transforms traditional education into an exciting, interactive journey.", "short_description": "STiXR is an immersive learning app that transforms complex subjects into interactive 3D experiences. Explore science, history, and technology through virtual labs, realistic environments, and engaging simulations. Perfect for students and teachers, the app makes learning visual, hands-on, and unforgettable. Step into a new world where education becomes exploration."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VB Group", "support_website_url": null, "website_url": "https://vbmetaverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27317205534615595"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617775_871075329209126_2405311718905242024_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2qqExhtNbkQ7kNvwG7gpPK&_nc_oc=AdoM5t1tVj88fMGo5Ra7j38hjHRmmH7lfbRKU1YfNk-72z4Dr7FQHu4LNcLlk0d3OFc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm_8OcnCyL932zE8YfsLj9kAd1QuAmxI7T3tU1kGS51Q&oe=6A8D870C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "STiXR", "platform": "ANDROID_6DOF", "contex
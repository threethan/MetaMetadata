4_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuYS4ZWvf7YQ7kNvwHQ9tn2&_nc_oc=AdqTyHhdy0LEsT-Oe7eGO20VF-oHBx5xpRcwbP_ecxbo-5JtKhIZn0grWGijvC0CJuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSowMARLA0N2lw2fJrktIYN-ZK_Ex_efTNxH_CrDMiBtw&oe=6AEDEFA0"}, {"file_name": "ContentExample015.png", "id": "1210714003561040", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974686_1210714006894373_1031619434407243093_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBHp7jf5p9oQ7kNvwEzDRKT&_nc_oc=AdqsKV1ZmT50eFiOVu1bkW2zXmlJSwaO6faX89nI8xrCJkD6ak1M4W9Am9WZeZbqTnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1MHue7Kd4lpkEBbBBbsxFmKSMZpAZ8N9QAYh051fl3g&oe=6AEDE5C2"}, {"file_name": "ContentExample013.png", "id": "1264196284721723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031628_1264196288055056_6856923822938331989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3wqYIGsBvEQ7kNvwETLiuG&_nc_oc=AdpHp2JebA-Vme6dcLQ0mTl1fJuDmMAyEkUo7be86fwVTXt1XHndV9CmroRfy42we1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkzDYeEcG3AKa1DLZI9T5yrhViVXMQdT2ypjY75TWUPQ&oe=6AEE0B90"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ILLUMINATION STYLE VIEWER", "keywords": ["ILLUMINATION", "DecorativeLights", "StringLights", "ChristmasLights", "Lighting"], "long_description": "\"ILLUMINATION STYLE VIEWER is a VR illumination viewing app that allows you to easily appreciate meticulously recreated illumination items in a realistic manner anytime, anywhere.\n\nItems that replicate the same size and radiance as the real ones are recreated in the VR space, allowing you to carefully examine even the parts that were difficult to discern in photos and videos from all angles in 360 degrees.\n\nWith features like the presence or absence of a floor and day-night switching, you can also simulate different viewing environments. Please take a look at the immersive illumination items recreated in the VR space.\"\n\n# \u3010Update History\u3011\n- Version 1.1 : Added 11 items and modified parts of the operation menu. (October 2024) ", "short_description": "\"ILLUMINATION STYLE VIEWER is a VR illumination viewing app that allows you to easily appreciate meticulously recreated illumination items in a realistic manner anytime, anywhere.\n"}, {"images": {"nodes": []}, "id": "1061702245441325", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30a4\u30eb\u30df\u30cd\u30fc\u30b7\u30e7\u30f3\u30b9\u30bf\u30a4\u30eb\u30d3\u30e5\u30fc\u30a2", "keywords": ["\u30a4\u30eb\u30df\u30cd\u30fc\u30b7\u30e7\u30f3"], "long_description": "ILLUMINATION STYLE VIEWER\uff08\u30a4\u30eb\u30df\u30cd\u30fc\u30b7\u30e7\u30f3\u30b9\u30bf\u30a4\u30eb\u30d3\u30e5\u30fc\u30a2\uff09\u306f\u3001\u7d30\u90e8\u307e\u3067\u30ea\u30a2\u30eb\u306b\u518d\u73fe\u3055\u308c\u305f\u30a4\u30eb\u30df\u30cd\u30fc\u30b7\u30e7\u30f3\u30a2\u30a4\u30c6\u30e0\u3092\u3044\u3064\u3067\u3082\u3069\u3053\u3067\u3082\u624b\u8efd\u306b\u9451\u8cde\u3067\u304d\u308bVR\u30a4\u30eb\u30df\u30cd\u30fc\u30b7\u30e7\u30f3\u9451\u8cde\u30a2\u30d7\u30ea\u3067\u3059\u3002\n\n\u672c\u7269\u3068\u540c\u3058\u30b5\u30a4\u30ba\u611f\u3068\u8f1d\u304d\u65b9\u3092\u3059\u308b\u30a2\u30a4\u30c6\u30e0\u3092VR\u7a7a\u9593\u306b\u518d\u73fe\u3055\u308c\u3001\u5199\u771f\u3084\u52d5\u753b\u3060\u3051\u3067\u306f\u5206\u304b\u308a\u8f9b\u304b\u3063\u305f\u90e8\u5206\u3082360\u5ea6\u81ea\u7531\u306b\u3058\u3063\u304f\u308a\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u5e8a\u9762\u306e\u6709\u7121\u3084\u663c\u591c\u306e\u5207\u308a\u66ff\u3048\u6a5f\u80fd\u306b\u3088\u308a\u3001\u898b\u3048\u65b9\u304c\u7570\u306a\u308b\u74b0\u5883\u306e\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u3082\u53ef\u80fd\u3067\u3059\u3002\n\u662f\u975eVR\u7a7a\u9593\u3067\u518d\u73fe\u3055\u308c\u305f\u81e8\u5834\u611f\u306e\u3042\u308b\u30a4\u30eb\u30df\u30cd\u30fc\u30b7\
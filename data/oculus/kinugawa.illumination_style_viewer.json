ntent-iad3-2.oculuscdn.com&oh=00_Af0tYM2oS0utoJnKeWAe7fjvRWlqM5v6svvo37gxpOe6Iw&oe=69F0CFA0"}, {"file_name": "ContentExample015.png", "id": "1210714003561040", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974686_1210714006894373_1031619434407243093_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsOcq_1nVAYQ7kNvwEhIg3N&_nc_oc=AdomSEKdxq4BFh_n8LJdt9eN71ou0ojNudwcqfiNztWNRGN8bZfBnSB_9vdB0bnmtIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3p4RwvFTBMV09ePU-BvQ6xaVssjiW6TGT2yr1Oxm3Zcw&oe=69F0C5C2"}, {"file_name": "ContentExample013.png", "id": "1264196284721723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031628_1264196288055056_6856923822938331989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKqevAlg178Q7kNvwGNq_Gm&_nc_oc=AdrsSfttLE_Nz7obqaFKF9_PvMbz8ImXUMVJ5S6zDXd0gJPvmLlB3Lb3W_x7Ya3hqbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3epcIvPOVAKcgsl1qpPKvZbTxBe6o0zGBRmiJ3RvmfHA&oe=69F0B350"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ILLUMINATION STYLE VIEWER", "keywords": ["ILLUMINATION", "DecorativeLights", "StringLights", "ChristmasLights", "Lighting"], "long_description": "\"ILLUMINATION STYLE VIEWER is a VR illumination viewing app that allows you to easily appreciate meticulously recreated illumination items in a realistic manner anytime, anywhere.\n\nItems that replicate the same size and radiance as the real ones are recreated in the VR space, allowing you to carefully examine even the parts that were difficult to discern in photos and videos from all angles in 360 degrees.\n\nWith features like the presence or absence of a floor and day-night switching, you can also simulate different viewing environments. Please take a look at the immersive illumination items recreated in the VR space.\"\n\n# \u3010Update History\u3011\n- Version 1.1 : Added 11 items and modified parts of the operation menu. (October 2024) ", "short_description": "\"ILLUMINATION STYLE VIEWER is a VR illu
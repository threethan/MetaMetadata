wEbzOdN&_nc_oc=Adrk3Va8gemBbIe4zCtIgFJhsTmiOEOXqOMMrhLlHtnkICwnm7GeVk5gtIqhQ3Kht7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPulA4iIFiJ6xBinaWmp0Nkvf4S1yXT1t6BxZIuDacBng&oe=6AE4A921"}, {"file_name": "Screenshot 2026-02-27 125621.png", "id": "1458299112320788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618440_1458299115654121_8308032465221254578_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCCjehx8Ms0Q7kNvwEuOS_l&_nc_oc=Adpz6f_l4ifrta3ipP8sbTjwm_kWcZqzK1cGGV8OZ9cWBAYlEGrEwKz1Yd0ZRrnb1rY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDPW8H3TZH66xD00Y2qk42GbIhCEqq8mBMuo5nKL36uw&oe=6AE498E8"}, {"file_name": "Screenshot 2026-02-27 124817.png", "id": "1592079355394485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_1592079362061151_3043427980051703216_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehtircMEBZoQ7kNvwFvliXM&_nc_oc=AdrwdO2GC6YTmdcvgoXuApHqF0xK6Ah_gAFLjLUMUnzGUoDACn63IiHdXFHpixCRdao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6oiHMsLNytoEdziK0XaeVXLcOPPDXGUr33c9WbWc0Wg&oe=6AE4C002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1323519499607950", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_1323519502941283_8433415486568333601_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_LfmyA99q0Q7kNvwEbfbuZ&_nc_oc=AdrfLhdT0ySPKRNKZNZLvr8XKHwgykjrzfRDSMh4Qt2ULgoKNweYf8OeLHXjZur5-cE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJzIcTUWbZPp0oDWDd5SkBGb9XrjgCcI0Wf4Sgo82tbA&oe=6AE4BD52"}, "display_name": "Venkateshwara Temple", "keywords": ["HinduTempleVR", "VenkateshwaraDarshan", "SpiritualMeditationVR", "IndianTempleExperience", "AartiVRExperience"], "long_description": "Experience the Divine Like Never Before\n\nEnter the sacred world of Lord Venkateshwara in a fully immersive Virtual Reality temple experience designed to bring devotion closer to you.\n\nStand inside the sanctum (Garbhagriha) as the eternal aarti unfolds before your eyes. Hear the powerful temple bells, sacred chants, and the rhythmic claps of devotees around you. Every detail \u2014 from the glowing lamps to the spiritual ambiance \u2014 has been carefully crafted to recreate the feeling of a real temple visit.\n\nThis is not just a virtual tour.\nThis is a living, breathing spiritual experience.\n\nWhat You Can Do\n\nParticipate in Aarti \u2013 Experience continuous divine worship inside the temple.\nOffer Prayers \u2013 Immerse yourself in a deeply devotional environment.\nFeel the Atmosphere \u2013 Authentic temple sounds and sacred chants enhance realism.\nExplore Sacred Architecture \u2013 Inspired by traditional South Indian temple design.\n\nDesigned for Peace & Devotion\n\nWhether you are seeking meditation, emotional calm, or a moment of spiritual connection, this VR experience allows you to reconnect with your faith anytime, from anywhere in the world.\n\nPerfect for:\n\nDaily darshan from home\n\nSpiritual relaxation\n\nCultural connection\n\nIntroducing the next generation to temple traditions\n\nOptimized for Meta Quest\n\nBuilt specifically for VR with smooth performance, intuitive controls, and immersive spatial design to ensure a comfortable and meaningful experience.", "short_description": "Step into the sacred presence of Venkateshwara in this immersive VR temple experience. Witness eternal aarti, offer prayers, and feel the divine atmosphere of a living South Indian temple \u2014 anytime, anywhere."}]}, "developer_name": "Metagod Creator", "developer_privacy_policy_url": "https://metagodcreator.com/page/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Metagod Creator", "support_website_url": null, "website_url": "https://www.metagodcreator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_top
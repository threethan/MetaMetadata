834255589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Frw5JUN7i2cQ7kNvwF6dwvT&_nc_oc=AdreAWULpJyCA71gDkutWNDKQPV2w3eMzKSmfp_3WtUTQa-8gPcnpKwqtwIphFVJCuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbGSRn2mkpP1G4jFybReNK39MiKcWC4bOCCDSLI7EjCg&oe=6AC254BD"}, {"file_name": "FlyingBirdVR-Screenshot-03-Third-Person-Flight.png", "id": "1321193514399593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_1321193517732926_6111774050495770042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbeXWrXFRIQQ7kNvwGF8LLv&_nc_oc=AdoIjAHy8tNwM7H4tZ4b0b-OF0IWSAV6VrabBOXgBW8ZXLOO2IqWdrepPERhm-ixyJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrXRDE-jdD_R2MZgsrwW324FL7-N9VmaJ13jRUhy823g&oe=6AC254A2"}, {"file_name": "FlyingBirdVR-Screenshot-04-First-Person-Flight.png", "id": "2267892033976685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_2267892037310018_7709981063935109158_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzhi65JcR_8Q7kNvwFPH_Ez&_nc_oc=AdoB08PVaECHOzfnHnTebcIi5TZgsdDTrNr4ziu0c0-_5jEOUqDNs-YGsRZKnI4KCkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvL21HgIA097FA0OOI3j1ySo0cCxA7SJ0ikgXNsoWqGQ&oe=6AC25B24"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=al-xgvo6clsQ7kNvwEDwBIF&_nc_oc=AdrXKDhqL5p1VVxfynQN6tcPi8l665IMm0LjmJCeX16Ijfo5_YdDby6YmrFGwE4-Tz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvRFMahvYKILFOs0EZReD2tYd_U0ntCIWCCN9YWEJZSA&oe=6AC24D8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT0dckqjo6gQ7kNvwETGSco&_nc_oc=Adqx9eLlQB69JtE4Iq40mbsEMh1yKbcdNdggYWpn-byBxV4_twCuHD0BRfQQyvX0eGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8n0bxpQ0YjyEhobEC1sEmYbBNYo1Xl6PUsdziQdCh4g&oe=6AC26ABE"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/flying-bird-vr-sky-challenge-privacy-policy.html", "developer_terms_of_service_
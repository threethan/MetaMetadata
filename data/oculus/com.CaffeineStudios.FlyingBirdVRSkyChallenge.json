91UEItCBQLrQXLpN4OM5UFylkFZzwjWmYUHq1VMu1y1ETqaF_YXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXbshXqLBTmpFGw6XdOmvjHO_UGcIvD6DnEQu2cwcyIg&oe=6AB13122"}, {"file_name": "FlyingBirdVR-Screenshot-04-First-Person-Flight.png", "id": "2267892033976685", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_2267892037310018_7709981063935109158_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9LJoqJwb9gQ7kNvwHxFPPE&_nc_oc=AdqhZX0Mt_g02WLc5bwxhqzh268Yx5cU6mvs_e0tGG0M0D0I-Xx325XB9vAT_4mXYPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMXiRxisoBPIHwc2UEdwgDTFL1xGpYioBvEwY5ozvZoQ&oe=6AB137A4"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMaGVd_DY7YQ7kNvwEFIeo2&_nc_oc=AdpUFb41f12-Av6Bj3sLJQHvTHXHoAVd5QaLO00jqrSYl-dfUx1HzitGlTe7YeAGmCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITJjq81hvb6rphl8ftOkEjZB6AB5V6fR-k2WYG_pK8fw&oe=6AB12A0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ynrZODDBaEQ7kNvwFCYw4p&_nc_oc=Adq7eQ5X_LFWDzI0ren_y39QGBXyN--hPDOk1-vXerqi8SMfwvIcsn6zNtGtxunWYM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiMfkupE5f3rVMbRUnwyUylTR6FqwCKVj_WBamIVOrCg&oe=6AB1473E"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/flying-bird-vr-sky-challenge-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
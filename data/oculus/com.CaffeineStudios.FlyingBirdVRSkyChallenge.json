, "id": "1395997219109862", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824665_1395997222443195_1038820630834255589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTSnle46HY8Q7kNvwG1-EXo&_nc_oc=Ado1bvCMrvthom1JscM04Id0m4LxPCaON1gX2MR55D8GCoe3JFqH72gKE7Xd9TAZW3g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3CqwqgJ-CaxaTSrClEMKIH-QPoR7CDi_6WexnZBu6Jg&oe=6AC8EC3D"}, {"file_name": "FlyingBirdVR-Screenshot-03-Third-Person-Flight.png", "id": "1321193514399593", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604310912_1321193517732926_6111774050495770042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5Z7cOlt7R8Q7kNvwGoJmkI&_nc_oc=Ado9WbNwn6zaCw-WhxooqniePyXZWywLnb-6g2LWN8ANIdBWMQGBCHQwlAm41plmJiA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8xxNyiAeH1gZcrw0dwl6gHl7Y55KyOfqndzFEfnsViQ&oe=6AC8EC22"}, {"file_name": "FlyingBirdVR-Screenshot-04-First-Person-Flight.png", "id": "2267892033976685", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_2267892037310018_7709981063935109158_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6em4Yj_cAAQ7kNvwFA6J2O&_nc_oc=AdqClPexsMIpjvSiCdkmboh-U0NYzoUgBeH83lHMeiJc9nEGw1849KxeZHhYQe6_tNE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj4T3ke5-fF_2jdFteH8--JlqLBA5y1CLzJg1kTEi-Og&oe=6AC8F2A4"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtJrxds-GFIQ7kNvwHT6DAY&_nc_oc=AdoOwTLgsOv4BjlV2tlh1v76K5tgX7PMUP0dY-w0uDoyI1HBCVQjdjpnXCB370D9niw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZcM1gR0R51Cl9_czaJGrn2qbfkRH9kUrtEASIWkE-Zg&oe=6AC8E50F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aqqkCiIne0Q7kNvwFg5YX9&_nc_oc=AdoGbLBYBKXugrw6wbqt9nkdTaoD1VYedG4OJ2GnyMMaPZ8UI28eHyb6C-5PKIM8VkQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN54ctTFuJcL1y6x-mfy0F02WvoQZ7yWHNGq-4fMyLvFg&oe=6AC9023E"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
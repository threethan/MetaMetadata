2PJdXTlBVQnSdpuiDUWo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_wuA6jbweZXxHRx2E5-HiwiaMhLnCQYk-hVM6pPv_jA&oe=6B0872E4"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B87R3m_F_KQQ7kNvwFVBLOq&_nc_oc=AdpGX-mvbsNcLDfEkCWSIPY67CVkfV6YCgaLmfrzHQrcopHDx2g8hhotRIo7xmx4pzk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPk74X7D_mGPzRVm7h3f1EPqrhpz3AugXta6w5SHObjw&oe=6B08654F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8PNaxspjkIQ7kNvwFyGPYk&_nc_oc=AdrADGE5k56LH5Hrbb5SyJcy76CyKhEaUx_wbpj5RGAmA2Umgl_UPETe4H6KJ4uuhgs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfdcHa22amrjSJMlgUQAF6i-V_jgzphsZI84N0MIh-5Q&oe=6B084A3E"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/flying-bird-vr-sky-challenge-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1281438181718125"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2964084440650690"}, {"status": "PUBLISHED", "id": "1093782603145998"}, {"status": "PU
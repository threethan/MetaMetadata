, "id": "1395997219109862", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_1395997222443195_1038820630834255589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jhICAbZmKMQ7kNvwF_7W4p&_nc_oc=AdpF1S1XNcpfbdlLxzAStsVyKygeExbynHinjrG15jNEqbyBnatf8YmWHi1ve-yd7ik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUjtSJ_C2V52V67Mvti9Swp8K66DQGATOi48YEEQixnA&oe=6ACF83BD"}, {"file_name": "FlyingBirdVR-Screenshot-03-Third-Person-Flight.png", "id": "1321193514399593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604310912_1321193517732926_6111774050495770042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOM1vrif_kQQ7kNvwFvhmHR&_nc_oc=AdpXbOHVHvFXeoa14jDNWcrAx9u1-2zdUJ3rf050r0mfek7ddqLbtApoRDD-fSpWc74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsRyHN1g4kspML65P7mgYDL1poQp5OnaL0K2NCDO2k8Q&oe=6ACF83A2"}, {"file_name": "FlyingBirdVR-Screenshot-04-First-Person-Flight.png", "id": "2267892033976685", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_2267892037310018_7709981063935109158_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXGMLQelp_AQ7kNvwHM4eev&_nc_oc=AdqEVVx_XRW2G0s-m10QKt1kU0YcxPiY9ioMGQtLheWyVt81cA4evk9HT_p6ef_aGS0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdWH4RyNFk7YVEln6h3RPZZJy_-s5KDpV4MCUGqoIu7Q&oe=6ACF8A24"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K26xjw5sidgQ7kNvwFdXfUF&_nc_oc=AdrPUz5P_BftH97-AaOn-3jLGv_8_65JQ6n2mgQKwQ6n5y83iNOFUIZR2I_bCnHJYzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI7DPePQJ4arN7gDSrcbz2ClU7NOgSdBCPAXd-1OPBoA&oe=6ACFB4CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVT7UOesm_MQ7kNvwEq7605&_nc_oc=Adq4UYTf2KOPu9WhQsV-EJaZTFjRo_NcBX7NCktLlQy4foQBGsh_uQEjxncZ1UBHFxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0r2Etbboi7AbkaOJ5FmAUp9r2VPRisfwjaPtfZNODbg&oe=6ACF99BE"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
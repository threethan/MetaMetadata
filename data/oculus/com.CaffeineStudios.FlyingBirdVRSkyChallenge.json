, "id": "1395997219109862", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824665_1395997222443195_1038820630834255589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTSnle46HY8Q7kNvwHMy54K&_nc_oc=Adoh4VE6yRqFOrt3l7vRhCBurgpExPp_G3EZ3qKDGD9rfykOoYFeYq3TqtJsMOKrm5o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Bm7Xa9gbn9U9YwhU9GcA9TPwUiMd0eRdKvy39tea5w&oe=6AC79ABD"}, {"file_name": "FlyingBirdVR-Screenshot-03-Third-Person-Flight.png", "id": "1321193514399593", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604310912_1321193517732926_6111774050495770042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyOo4FOBtVwQ7kNvwGbP4go&_nc_oc=AdoxfbM064W73I-u4vuQbH2oKJT_b5UCBn8Y304B2uP12LHcymoJXkwcAJNKPrzHjOc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUH_H15eUfz5CmpduT72sD67kJ-tDRg3YK0XdRxoYfHQ&oe=6AC79AA2"}, {"file_name": "FlyingBirdVR-Screenshot-04-First-Person-Flight.png", "id": "2267892033976685", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_2267892037310018_7709981063935109158_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcbCu5mB1BQQ7kNvwFJozUA&_nc_oc=AdpVBERq169ckUKH4sHTzWFEjNwWmYcnB1t9Em9S5hEnFMg5OLhO1AI7xj97P40LSlU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_fBLkdR901Qv-g_lQcD7hRxzBMiCyZ_A8DJe-3Dj-VA&oe=6AC7A124"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtJrxds-GFIQ7kNvwEgZhke&_nc_oc=AdoDuU1BBaN8ipnjCXyOEfWNRvyVRBNXivhaYkyb9DQwmzmhjRjXLv7CeG8A_UbDfXU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl-NK5sdzHX7HFg5W40toGTY_3uq0eGv0mH5ziUG6_mA&oe=6AC7CBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aqqkCiIne0Q7kNvwH4yc1u&_nc_oc=Adp0Khe-qAb6ISROjfbtfIoHpY8l08Khrl_42WaE8BWZLALEAzJV2qExUboNxfNs6l4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpC620y7zJs5hwBlSWlmFzEgjLtylkgL7WZnGaoVrieA&oe=6AC7B0BE"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
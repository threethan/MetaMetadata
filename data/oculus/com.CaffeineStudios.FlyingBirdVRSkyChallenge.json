, "id": "1395997219109862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_1395997222443195_1038820630834255589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jhICAbZmKMQ7kNvwE_LOcM&_nc_oc=Ado0bw9NtPdwXhWyh95nR609bNtGHfeYAnWHqW5c6QiJbgSqN0VnHndlNPOT3LMtucc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqyl8yEpvDCrXMdINBAdeP32wL8z2n9YGVLMR-7UVOzw&oe=6AD226BD"}, {"file_name": "FlyingBirdVR-Screenshot-03-Third-Person-Flight.png", "id": "1321193514399593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_1321193517732926_6111774050495770042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPTEo2nhk7UQ7kNvwGhy4Yh&_nc_oc=AdraOOwyAmnrjNATCQlsQJ9DOK9ithXP2-drSkbA1TpnP80mS-EM215vTXboMwB-71o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrhGzSggpq-mLAo6tBmKDjCbWXBtErNLhsYChjoYh0OQ&oe=6AD226A2"}, {"file_name": "FlyingBirdVR-Screenshot-04-First-Person-Flight.png", "id": "2267892033976685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_2267892037310018_7709981063935109158_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDxvuE0fX_AQ7kNvwEhG_e2&_nc_oc=AdrXZanBCH5ItWtTvc6zLwInmLkz-8ULujOOXiK9t09P9a48PUV9rSpyEdS-SK_w5gA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQI7bcNbaPTOZz9kOKYtU_-RDQb5kCTTrG1MPv0De3rg&oe=6AD22D24"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K26xjw5sidgQ7kNvwHFPINo&_nc_oc=Adq2S30_vktLW2KUtymWSEb7N9dme97YifRlMCrTwE_wEeFKZb9KXtjlQNUGWPYpsCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrSexku4CH_otBZnKlyBgcGwTQkJZUA_WzqC95NfwsVA&oe=6AD257CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVT7UOesm_MQ7kNvwFAfG57&_nc_oc=AdpjjTb6veXg0nQ1Zc2LC8w2zENRl-oqqZxf1bhssg1LPhHQ-K7sD4DiCKNkcWfziMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiGVhtAGj1VEngDbufvvVgmNBp2zOM4UOTi01_8xvrDA&oe=6AD23CBE"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
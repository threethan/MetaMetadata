, "id": "1395997219109862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_1395997222443195_1038820630834255589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iaacCg22-4Q7kNvwECPB6v&_nc_oc=AdrTW5FoA-Z93a-ZDFi7n5AQaAjXUhIA6VBEpKvazXKrX10Wk2hIsvZwBz-fh2eFnQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJNwphij5psHaJDMvSQsV3YSrFQ9Gwv7gfvDF6KF2KOg&oe=6AC3A63D"}, {"file_name": "FlyingBirdVR-Screenshot-03-Third-Person-Flight.png", "id": "1321193514399593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_1321193517732926_6111774050495770042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbeXWrXFRIQQ7kNvwEZ50BC&_nc_oc=AdoEecV42y2OtRyGOiNkXx2qpf4NzRR3WPucMH0SRi2k4FCU87x5jifEoaFTRZmPyTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO07eH3lEiqDC8P292Vb__aIYesBbFLtxwQIIVr_In3Lg&oe=6AC3A622"}, {"file_name": "FlyingBirdVR-Screenshot-04-First-Person-Flight.png", "id": "2267892033976685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_2267892037310018_7709981063935109158_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzhi65JcR_8Q7kNvwHc8kRK&_nc_oc=AdqmP2ej0U1Gr0LuNyOgDaVwCaaxO9sDtLzZbLjWA19FbcwJpdN7P8Ldd9giltPiKhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhCF6pWzMZbsIVSDHipy8rD5Acvzc-qpQvbcDTaUI7dA&oe=6AC3ACA4"}, {"file_name": "FlyingBirdVR-Screenshot-05-First-Person-Challenge.png", "id": "1616579926648409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_1616579929981742_999354017721019880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srLXz3U5Y2EQ7kNvwEh_zdH&_nc_oc=AdrIQwV8kQfVHUIWyCYMn1ycFgYpbBaeDCRIZIem7Oe4QPL1wdNWNy9pGMCQz2SW2JU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzCSOxCpoglGSbOURXAOoaaJxPZ4PYwZH9gehrbQqSHg&oe=6AC3D74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FlyingBirdVR-Cover-Landscape-2560x1440.png", "id": "1528943941727495", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1528943945060828_5100794444602784718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXz3ZeIy7mcQ7kNvwE5WnMA&_nc_oc=Ado0dWW5RK6_Mt51YkyrKSW-fw6hKWTfWPL8W_bxhgZAKWvsUYOtuVToH52_KfZ62tw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAUzSYtJUAj-ZVBFJJzl-xwPgXUYg4xSjZ6qLHaR3frQ&oe=6AC3BC3E"}, "display_name": "Flying Bird VR: Sky Challenge", "keywords": ["bird", "FlappyBird", "flying", "endless", "arcade"], "long_description": "Take flight as the bird in Flying Bird VR: Sky Challenge, a fast, cheerful arcade experience built for quick VR sessions and one-more-run excitement.\n\nGravity is always pulling you down. Press A, B, X, Y, or either trigger to flap upward, then thread the gap between glossy green sky obstacles. Every clean pass adds a point, and the course keeps coming until one mistimed flap ends the run. Restart in seconds and try to beat the best score saved locally on your headset.\n\nChoose First Person to become the bird and fly directly through the course, or switch to Third Person for a clear chase view of every flap and near miss. The single endless mode keeps the challenge focused: learn the rhythm, hold your line, and see how far you can go.\n\nPlay seated or standing with Meta Quest Touch controllers. Pause or resume with either thumbstick, then jump straight back into the action. Bright original low-poly visuals, responsive haptics, synthesized sound effects, and a breezy sky atmosphere make every attempt lively.\n\nCore gameplay works completely offline. No account or internet connection is required to play.", "short_description": "Become the bird in a bright VR sky challenge.\n\nFlap through endless 3D obstacle gaps in First Person or switch to a clear Third Person chase view, beat the best score saved locally on your headset, and restart in seconds. Easy to learn, hard to master, and completely playable offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
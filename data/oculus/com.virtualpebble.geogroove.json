xAiVhzEuRlQzaEwHZ8BDVODiInW7a1SRozmoHMQl1GKxrfS4L_oNMnQYA-N_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3UKuG9mYod5w6auDuBAjCZf_4zj87yYem4G0skXBKdg&oe=6AF8A1FE"}, {"file_name": "upscaled_image2_3072x1728.png", "id": "988444860238929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296125_988444863572262_7276099911795686078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IugsVl_sKzsQ7kNvwG8bg87&_nc_oc=Adqll4E3mfkos55a_5zvhJbbJTAI2XrD8jSmnh4iWEwxeh5TrJ3oKIKZAhVawyZNQw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVho6fLdoP6m-RTITnNYKwMGJfre3U27qVEnrkDyHKHQ&oe=6AF88826"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Geogroove", "keywords": ["interactive", "surreal", "theremin", "sound", "meditative"], "long_description": "# What is it?\nThis audiovisual experience transforms the room around you into a dynamic landscape of shapes and sculptures. Virtually touching these objects generates movement, sounds, and patterns, leading to an experience that evolves with your exploration.\n\n# Inspiration\nGeogroove evolved from a series of experiments building unique instruments in virtual reality. I wanted to explore music creation and performance in VR, while bringing that same experience into the 'real world'. This has been shown in live settings, where 1-2 people perform together using this virtual instrument.\n\n# Exhibitions\n\n**Filmgate Interactive 2024 (Miami, FL)**\n\n**Bumbershoot Arts and Music Festival 2024 (Seattle, WA)**\n\n{2400696887097528}", "short_description": "An abstract audiovisual experience in mixed reality. In this 5 minute looping experience, a series of 4 different instruments enter and exit the space around you."}]}, "developer_name": "Virtual Pebble Studio", "developer_privacy_policy_url": "https://www.virtualpebble.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Pebble Studio", "support_website_url": null, "website_url"
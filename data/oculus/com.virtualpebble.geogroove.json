c_sid=6e7a0a&_nc_ohc=0uNew4K0cSYQ7kNvwFsOKgG&_nc_oc=AdroXcarfl3kLXeZdj_Lwe6Lay2ecVGJyJg5thTwFRAwLmRm7YLvpbSPFAa_NdUw7IU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x7m8SIE99wTyCRO3XaCTAK0FYoNK8oF8WFgUG7PKq3Q&oe=6A4665CE"}, {"file_name": "upscaled_2560x1440_ready.png", "id": "2167352440705376", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308046_2167352447372042_4360267257279975344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v5aEFLEerMQ7kNvwHHbuN5&_nc_oc=Adoaii1xBWMuSbK9kQ1oxABi3p9YGctBgQimvPtjj-Z8D15ZLRD7gWJlLvoA1sv6uTY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GT1MIk_4ommAkZclUTSFADHoE1syYXnt43CGsI9ZHIg&oe=6A4683E6"}, {"file_name": "upscaled_image1_2560x1440_ready.png", "id": "1377280034424667", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499300738_1377280037758000_8814092937996038283_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K1w_1L8Au4Q7kNvwFq53u4&_nc_oc=AdpG_CX5ODup1qf1Gv4axP8cs9GUO6uA43CQVJt67SJqaizd7Je6gh4iEdmjRaL7TVw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tNi4I4iCsbGGLANyqyyJe8y2yrUl5ykjgayUWATx4bw&oe=6A466F3E"}, {"file_name": "upscaled_image2_3072x1728.png", "id": "988444860238929", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499296125_988444863572262_7276099911795686078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2Evga3OmccQ7kNvwG0x1J6&_nc_oc=Ado9F-jjjmb6OVSWapsyZx-UPqAmpqsgsVg1IlTNI0NwdEhMHA4gEu6dda0ORkPKusQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DqSKVH_2TkqK8Ltb7rc3YumCopIZ38spvxtAL-Lx9Sg&oe=6A468DA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Geogroove", "keywords": ["interactive", "surreal", "theremin", "sound", "meditative"], "long_description": "# What is it?\nThis audiovisual experience transforms the room around you into a dynamic landscape of shapes and sculptures. Virtually touching these objects generates movement, sounds, and patterns, leading to an experience that evolves with your exploration.\n\n# Inspiration\nGeogroove evolved from a series of experiments building unique instruments in virtual reality. I wanted to explore music creation and performance in VR, while bringing that same experience into the 'real world'. This has been shown in live settings, where 1-2 people perform together using this virtual instrument.\n\n# Exhibitions\n\n**Filmgate Interactive 2024 (Miami, FL)**\n\n**Bumbershoot Arts and Music Festival 2024 (Seattle, WA)**\n\n{2400696887097528}", "short_description": "An abstract audiovisual experience in mixed reality. In this 5 minute looping experience, a series of 4 different instruments enter and exit the space around you."}]}, "developer_name": "Virtual Pebble Studio", "developer_privacy_policy_url": "https://www.virtualpebble.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Pebble Studio", "support_website_url": null, "website_url": "https://www.virtualpebble.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26934401239516242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/604298355_1303018462040194_4555055009411741612_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jGq6Pr0Ud0Q7kNvwFPa9yP&_nc_oc=Adq-f
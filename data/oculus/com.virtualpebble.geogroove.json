sid=6e7a0a&_nc_ohc=9Ai7YKhxn4kQ7kNvwE0JxfH&_nc_oc=AdpEyGIezwMEJ-nenJ8pzVnSsdtTtUwzjPi3SDI8qLB8Fv2_jeNNhIiQhO3sP9xN9UE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MFT-Xj-JfBdSbJ8CnpNWfDYT-YJFAHISDVyWFXg1ElQ&oe=6A26C1CE"}, {"file_name": "upscaled_2560x1440_ready.png", "id": "2167352440705376", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308046_2167352447372042_4360267257279975344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lysa2_uYjhAQ7kNvwENMSSE&_nc_oc=Adpy9VTcpKcvq6Hoa9CdXQArdCDrQKwqrDLSf7W0kI8cI5SN-9da3XyQmtBx6owacqM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZV8ZSRIOOYhdR88nxstLOqzWDvrcF9oMkedKcrWJmtA&oe=6A26DFE6"}, {"file_name": "upscaled_image1_2560x1440_ready.png", "id": "1377280034424667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499300738_1377280037758000_8814092937996038283_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxefJZn0sGwQ7kNvwFc0XcC&_nc_oc=AdpgHH_xBwrULW-Myk90p2JN6J7K7ihbhg9rK9MVCifjLNp4cu-xqKIvvCMT2QFXVcc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90EsdLZ6O_Nmosr6zm62RFY4OGJjOK1SETFuStUNSl2A&oe=6A26CB3E"}, {"file_name": "upscaled_image2_3072x1728.png", "id": "988444860238929", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296125_988444863572262_7276099911795686078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jXOp_8S1i8Q7kNvwFb2PxJ&_nc_oc=AdrqKfFv3OcTmdBJTjb-C6Xd3JrNrYt9gro4pH7Zbo8PckGEkDbzk5yftZGp4fBpn60&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2b9ZM9FTq-Bh7vfNE8eJ9jN0y-MaMpQqc-VyFOOfidQ&oe=6A26E9A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Geogroove", "keywords": ["interactive", "surreal", "theremin", "sound", "meditative"], "long_description": "# What is it?\nThis audiovisual experience transforms the room around you into a dynamic landscape of shapes and sculptures. Virtually touching these objects generates movement, sounds, and patterns, leading to an experience that evolves with your exploration.\n\n# Inspiration\nGeogroove evolved from a series of experiments building unique instruments in virtual reality. I wanted to explore music creation and performance in VR, while bringing that same experience into the 'real world'. This has been shown in live settings, where 1-2 people perform together using this virtual instrument.\n\n# Exhibitions\n\n**Filmgate Interactive 2024 (Miami, FL)**\n\n**Bumbershoot Arts and Music Festival 2024 (Seattle, WA)**\n\n{2400696887097528}", "short_description": "An abstract audiovisual experience in mixed reality. In this 5 minute looping experience, a series of 4 different instruments enter and exit the space around you."}]}, "developer_name": "Virtual Pebble Studio", "developer_privacy_policy_url": "https://www.virtualpebble.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Pebble Studio", "support_website_url": null, "website_url": "https://www.virtualpebble.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26934401239516242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604298355_1303018462040194_4555055009411741612_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBSNPNoS5m4Q7kNvwEyp5cm&_nc_oc=AdoX-aHhg
sid=6e7a0a&_nc_ohc=t7St7V6a_OoQ7kNvwHpAcIU&_nc_oc=AdpS2ekPjGo_rw75ANolIoqNfQwYEUdAjBaGLvUztVbezkl3wgGQjlJQ3frZedlGJwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzIDiPNL7PxVoPjZMmxIgTVr7lA7Lup5z16RFni7dTew&oe=6A6DF2CE"}, {"file_name": "upscaled_2560x1440_ready.png", "id": "2167352440705376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308046_2167352447372042_4360267257279975344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_7sep_DBU4Q7kNvwHGKs-m&_nc_oc=Adr_8mUfkOlj5b2q3xqDiUw5_SBFQ27_uP27Lnl9bF1CI5BYaa7uoqxJazw9ucHRET8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkKxTm2CdjWYMkgnahQvDgqHeXFeW7C1-24zU2Aotx1Q&oe=6A6DD8A6"}, {"file_name": "upscaled_image1_2560x1440_ready.png", "id": "1377280034424667", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300738_1377280037758000_8814092937996038283_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_tozvFYMbkQ7kNvwEO4Nmf&_nc_oc=Adq5nm4LTPs4DdLFgwM6BoTVY4BoQQAguiD_clOp0ns_mBWWZADL8mjyUw1Nxax4KqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqCjl11l_h7lxOHzyyf598Xs1-zTk0I6OeRIyu7oVgZQ&oe=6A6DFC3E"}, {"file_name": "upscaled_image2_3072x1728.png", "id": "988444860238929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296125_988444863572262_7276099911795686078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWvC2Lc9mncQ7kNvwEf7BgH&_nc_oc=AdpWRpDGpu-hZSj-NuJisn_z2lXStRDpR6pYv5SEBbivybhfDUU_E026KwAXACq9jRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANHnjNbMao-6Y7nhFKmC5jKUr7VXfDPvUdgK4LO5VcCQ&oe=6A6DE266"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Geogroove", "keywords": ["interactive", "surreal", "theremin", "sound", "meditative"], "long_description": "# What is it?\nThis audiovisual experience transforms the room around you into a dynamic landscape of shapes and sculptures. Virtually touching these objects generates movement, sounds, and patterns, leading to an experience that evolves with your exploration.\n\n# Inspiration\nGeogroove evolved from a series of experiments building unique instruments in virtual reality. I wanted to explore music creation and performance in VR, while bringing that same experience into the 'real world'. This has been shown in live settings, where 1-2 people perform together using this virtual instrument.\n\n# Exhibitions\n\n**Filmgate Interactive 2024 (Miami, FL)**\n\n**Bumbershoot Arts and Music Festival 2024 (Seattle, WA)**\n\n{2400696887097528}", "short_description": "An abstract audiovisual experience in mixed reality. In this 5 minute looping experience, a series of 4 different instruments enter and exit the space around you."}]}, "developer_name": "Virtual Pebble Studio", "developer_privacy_policy_url": "https://www.virtualpebble.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Pebble Studio", "support_website_url": null, "website_url": "https://www.virtualpebble.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26934401239516242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604298355_1303018462040194_4555055009411741612_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3SFPYnjdIoQ7kNvwHyuiOl&_nc_oc=AdouaXsJU
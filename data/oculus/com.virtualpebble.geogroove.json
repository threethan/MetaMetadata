sid=6e7a0a&_nc_ohc=9Ai7YKhxn4kQ7kNvwFNj0CO&_nc_oc=Adq4fYNOEJ8b30wQ-53nvXWZWVNNv3MXDSF8aJshaLuldOeBg141nnYfKEaq7rLOSJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uv3g0T4J9rhSHPgOuvswSPjuKQUrJ4MTIXlEPH7zklw&oe=6A2964CE"}, {"file_name": "upscaled_2560x1440_ready.png", "id": "2167352440705376", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308046_2167352447372042_4360267257279975344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czPhuXFZvvgQ7kNvwGfbZ98&_nc_oc=AdrDLTurwFTfciorqrLXamr4D6Bl1cKQInAOMb74nJcZ0vF0Hk1vd_bLEWLTTvwpRYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i3_dw1218wOYBWS7RhLvGd4dV3xdxLce1SRv-imWh5w&oe=6A2982E6"}, {"file_name": "upscaled_image1_2560x1440_ready.png", "id": "1377280034424667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300738_1377280037758000_8814092937996038283_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhl048DuwjEQ7kNvwFT-orm&_nc_oc=Adp5gv8SahBiDXKJ2_v9NymP-Wr5VMMc9yvH1IFSVy83jm5QdqL8K3WBB2Bdq9_4rI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83W8aboJ2Hodtsyc97rZ6LVaxz1asJdedXaDcqf91t2A&oe=6A296E3E"}, {"file_name": "upscaled_image2_3072x1728.png", "id": "988444860238929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296125_988444863572262_7276099911795686078_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGBmc-vaMgAQ7kNvwFk2GE0&_nc_oc=AdoiDAR5sS8aNH3fxtsErK1tOPYgmXRwLrqJM3cOnuliRojPXLKknRPaekhXgGuGMmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WrTKs65oMi8_qYuYHpaDx3w6-G1ghHagdoi6rF2lg3A&oe=6A295466"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Geogroove", "keywords": ["interactive", "surreal", "theremin", "sound", "meditative"], "long_description": "# What is it?\nThis audiovisual experience transforms the room around you into a dynamic landscape of shapes and sculptures. Virtually touching these objects generates movement, sounds, and patterns, leading to an experience that evolves with your exploration.\n\n# Inspiration\nGeogroove evolved from a series of experiments building unique instruments in virtual reality. I wanted to explore music creation and performance in VR, while bringing that same experience into the 'real world'. This has been shown in live settings, where 1-2 people perform together using this virtual instrument.\n\n# Exhibitions\n\n**Filmgate Interactive 2024 (Miami, FL)**\n\n**Bumbershoot Arts and Music Festival 2024 (Seattle, WA)**\n\n{2400696887097528}", "short_description": "An abstract audiovisual experience in mixed reality. In this 5 minute looping experience, a series of 4 different instruments enter and exit the space around you."}]}, "developer_name": "Virtual Pebble Studio", "developer_privacy_policy_url": "https://www.virtualpebble.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Pebble Studio", "support_website_url": null, "website_url": "https://www.virtualpebble.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26934401239516242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/604298355_1303018462040194_4555055009411741612_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBSNPNoS5m4Q7kNvwHXCn_A&_nc_oc=AdrXKZxgf
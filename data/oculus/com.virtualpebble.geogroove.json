2042_4360267257279975344_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55OUGD97kAkQ7kNvwH5cwEA&_nc_oc=AdoYN6zvUspSKWZ7F8yAXuAAvQrHypsN7yjIapQW9VT6jsQ17NVsGBTF904IFNAVkkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5PQZ3aRgCrAbFBB0w6UuBKkBXnwa8jo-sAG8hdBPLHg&oe=6AFDC466"}, {"file_name": "upscaled_image1_2560x1440_ready.png", "id": "1377280034424667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300738_1377280037758000_8814092937996038283_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31pKXGUxblcQ7kNvwErWQ6Y&_nc_oc=AdpxU9BVjDPAX2_bsUo1CNimHYdUKpMzEDbxDFGm17hh2XCrISUN0ei6Z-h5Ny1Whs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvDHe4PUS4eC1zHfja2E-5K2_0zD_aAcfO70br1XWm6w&oe=6AFDAFBE"}, {"file_name": "upscaled_image2_3072x1728.png", "id": "988444860238929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296125_988444863572262_7276099911795686078_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiQJtetOcIkQ7kNvwFOcgy_&_nc_oc=AdqjO7iKGPayMSCQcUlvfMqYCdjsndrhDngxu3KyAe83E_iECC1JtfNEJyenXCdpNwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxW9uURVUnajFPlCF-n93_xFRZYjDSUdKqXO-Zry_8Wg&oe=6AFDCE26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Geogroove", "keywords": ["interactive", "surreal", "theremin", "sound", "meditative"], "long_description": "# What is it?\nThis audiovisual experience transforms the room around you into a dynamic landscape of shapes and sculptures. Virtually touching these objects generates movement, sounds, and patterns, leading to an experience that evolves with your exploration.\n\n# Inspiration\nGeogroove evolved from a series of experiments building unique instruments in virtual reality. I wanted to explore music creation and performance in VR, while bringing that same experience into the 'real world'. This has been shown in live settings, where 1-2 people perform together using this virtual instrument.\n\n# Exhibitions\n\n**Filmgate Interactive 2024 (Miami, FL)**\n\n**Bumbershoot Arts and Music Festival 2024 (Seattle, WA)**\n\n{2400696887097528}", "short_description": "An abstract audiovisual experience in mixed reality. In this 5 minute looping experience, a series of 4 different instruments enter and exit the space around you."}]}, "developer_name": "Virtual Pebble Studio", "developer_privacy_policy_url": "https://www.virtualpebble.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Pebble Studio", "support_website_url": null, "website_url": "https://www.virtualpebble.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26934401239516242"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "998726692835190"}]}, "baseline_offer": {"id": "998726692835190"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779716280, "status": "PUBLISHED", "id": "998726692835190"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26922201094069590", "version": "1.1.3"}, "id": "3831717513802193", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary"
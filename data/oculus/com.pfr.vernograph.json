/499620414_1087577637191955_5911510275090170522_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FU8MlwFfloQ7kNvwGF766Z&_nc_oc=AdqsOSgm0eXj7R5TkrD4TvWh2VrAmo1I79Jj_W1_0QvYphj2q7rUQ1qcnkJH-A_WONY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK996hVV2MYlgahxJ-98lvs-ZhQ5bwCGUzL0rqlmmgDHQ&oe=6AB69B40"}, {"file_name": "Store_1000.png", "id": "1984329762281197", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-ATlXDptRkQ7kNvwF7ddDa&_nc_oc=AdqCuc7R9fAt00qPNIkR8DQ8WF2nUXtDu2pwj98pjg_jCMho39w1JsOhyzLIksKtaB8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUvqxLGeL09Ik13mlFfg67EUPZeMXUJxxWlvKiW_U16g&oe=6AB66B8A"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6_bbzNTt2QQ7kNvwFd-X-u&_nc_oc=AdqWU2q8ogsJk2MRjnmDbSE7gRfmAbjNcoaZH31LtZk7wY2pHNd8TEl0tTsKhzwFi5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5poSDXcu2nc_rD0EAx-WIGLZAC2gwClQqkkmwG7zG1Q&oe=6AB671A9"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_QhHB4akGMQ7kNvwHHHRlZ&_nc_oc=AdqwQ0_ib1xjX8-JRh0wNIee6UgIXDqXgvPLYMw1_PDxpvQ7byhNoeGrawQp5K-nsG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaz9MRtuIhgef-WUun0-n7Bvq26quIMkkCE0C5kbn6cg&oe=6AB68F35"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjTWiHFG0q4Q7kNvwGdDBmq&_nc_oc=AdrFynraGdWdHcPodtOY2iOYxupQ3YyOBZdcaENoTBb8eTbp6Qr8HjYKooqTh74OvtM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6VSzM6wDW_iHI6h97Wzzki0AZeb7360fNn450rJKlow&oe=6AB6893C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_
c_oc=Adol34d8ApsbQdGgBgMzedxX04X-k5KQbRL0VC6Zs6RDkEUEeEyLHBCYSsu0mvoCDjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQeGE16pXx_oIqo7XfvvC4CeNkic62iUamJ1gqyiGiwQ&oe=6B0DC250"}, {"file_name": "Cast_1400.png", "id": "1756490575559626", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626806_1756490578892959_6246837013926208846_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Qn3jhL6L74Q7kNvwHzFegF&_nc_oc=Adob35_LqR_BQAwa46g8KIabz7voqusIu1QL6zXWt8MkqBhnTBOaBxHFSRWSuL2Q6xQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQens9TpzEKBGZedCvclvohxkWN6eBpGMNMLmon9Z8xrA&oe=6B0DB5AB"}, {"file_name": "Cast_1800.png", "id": "2519882931820846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619369_2519882935154179_4688330543938033460_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XugZqj1N-zYQ7kNvwFOHsW7&_nc_oc=Adr42RWb2jP5b4UuzIrSXrb2Xg75Hfzg9QjHh-RdjYHoKawa4Vk2W3JPmUtRdLhZ4kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGrtzfnUHsYzIPCLalpZk-_WWifm8q35wOQiWmkwh9cw&oe=6B0DABCB"}, {"file_name": "Cast_2200.png", "id": "1605877087557879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593723055_1605877090891212_240330335151319972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW-TC3wP6uEQ7kNvwGEa7cZ&_nc_oc=AdrX67nh9sK6-jsF_gIpmnZath_AGPocnWtw7sdmbSVDIrTKUk2FTLhrIR7lqJOGLYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTE9bsnjMKMwkOa8R2uHr7PscOjGehFBG_ns5mmUpchDw&oe=6B0DB125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vernograph_landscape.png", "id": "1736960657592314", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624583_1736960660925647_3065568427651551654_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWL1lpK2uFsQ7kNvwGZIpMM&_nc_oc=Adr01lf-ssFD3U78fTATBq-WnjqTQb1JwL64UKddgU2IoB3ib6Quq9sCFyqQuxX1uvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsMaPOzoCM_bIFeV9jF5a2U6PEHQObAzT4phRRiOhqvg&oe=6B0DB3C5"}, "display_name": "Vernograph", "keywords": ["battery", "clock", "utility", "spatial", "home"], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "suppor
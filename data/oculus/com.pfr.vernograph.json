/499620414_1087577637191955_5911510275090170522_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCCKTQgdQkgQ7kNvwE93ffJ&_nc_oc=Adp8wFzQriMb_mN3sMXuZH-9Xnf-jnqlr9iH5EZwCKs02yLrKPHJ7eXMprXt2Ma0ih4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAFAiu_NXrwuDiZt5PvSdNg8iU9p460rIZyjzos76COw&oe=6ABBE140"}, {"file_name": "Store_1000.png", "id": "1984329762281197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJNo2L-phKUQ7kNvwFNgCJP&_nc_oc=Adq0vDo4f_5IuKGbLvBxqt9xo7AAiPCbt2sjfd8LQL5ak7FdRK1vseDEJLzSoVrdA_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSYTxXB4v1LaxeRB391cRmcxQ9TIpIOEMseC5Aw3rgSQ&oe=6ABBB18A"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtJVkELFBJUQ7kNvwFxPjrQ&_nc_oc=Adoj_ng-aUWY8O6fwKJ1OY0_IKWaaJyMf3w0cSYd31656KTjPOMbw-FCfpuMLdaNIAg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJooXKS7v6d_ZkUT8Hkt8Qk56b-yYHu2JZKMqwiePlPGw&oe=6ABBB7A9"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p784Ne8PHJcQ7kNvwEZEFox&_nc_oc=AdokeBuecila2ypWbAQhO2YdiKfcoLQ55DuyLJyBMXPYHcKfjJz6MNX8KsXWg0QiAIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqj3BdAlgIIoVqXp7iQTS9jo0ZAsR1tmd0YlrkmN46kw&oe=6ABBD535"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNafWG9mSn0Q7kNvwGLs-CA&_nc_oc=AdoTGefTAEU6cB4IiM2ay1gFaaWUrBK4BPBm30x8CGBitfiZzlm9BCvGZ9HjX9tG5M0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhVXMotR08tOviRzLRQJE3KK44BurqH9wJw6iyyOxpnw&oe=6ABBCF3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_
/499620414_1087577637191955_5911510275090170522_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmOz0xy29XwQ7kNvwE-tZqc&_nc_oc=AdoqWx6fgnOIJ44ViMnq63x97HKwm7ydz5QDM2B92LCSHjJ3zsa4kfgNEZtzVezgGpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-i9aUJd8goPcMFj3nzVDpCzF-_x5KMwUfQYYM1N1FOw&oe=6AB15540"}, {"file_name": "Store_1000.png", "id": "1984329762281197", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp4mIuaME0sQ7kNvwEwnp5p&_nc_oc=Adr5oGX9WwX6r05zEpqilUC3gTGo-OSLBObnmJEyhwrpW3nZpjyaY_bVzcGD2FK2nC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIb1BKVGP13U9atOrEBt2YA3PIpWGlWDHu6KI7_Fg5fw&oe=6AB1258A"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8lZESjhTtwQ7kNvwE_jPAH&_nc_oc=Ado3y4yESJerNu3c9LJdshUl_2HR0M_pxuQhkmzwy3qUP2LZJOaVr0iffv5dtuJcFPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuRYsQXCYh0PRbjTnHOhthRAnb6NRddczIpcD4eSVWxQ&oe=6AB12BA9"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1nDjBcE92IQ7kNvwFY3BC3&_nc_oc=AdrEyE0szUJbXkMD32djYViIGm666Fiz2eGxqzSd8CxmNRGhd9i_6nOjLAEYOe_X8Z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCCxZ__dnpLORBbrgKfU5OQZzk_N_Cmsj8_JJioyU2ZA&oe=6AB14935"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hRlO2ioqtoQ7kNvwEtxOTH&_nc_oc=AdpkGJPwloV3qVk0vJXe4379PEMJsnUIm7kq0L6abZYxB4V2FaXujdihwQRARNRQqDU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0dNUIRMHYcwdI6ixH8AXaXtgvzjPMeBNxZwY6_bBfXg&oe=6AB1433C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_
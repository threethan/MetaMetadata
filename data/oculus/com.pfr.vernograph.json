c_oc=AdrMAkgtC5E1Y2pRyxOSYsAsLd30qpshEnFJtVAXcWYOXxZDcEZJ0_Rhvx2qyehUd6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ8cQpOi6tg8-pbp_4y13h38KdiTUz9_x4dPYfuP8HmA&oe=6B005B10"}, {"file_name": "Cast_1400.png", "id": "1756490575559626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626806_1756490578892959_6246837013926208846_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_63kI2aiRwoQ7kNvwGvGDZS&_nc_oc=AdrGlbPK3hB__VWsDrcQuP3O_GD97wouWRFQBhd4UgweKjJ4e0VNYTTx2y4SCJcG1dY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRLRVfFr_Ru3_-LF9mUfTBoWBZTNn0iTAs77o_ixKF3w&oe=6B0086AB"}, {"file_name": "Cast_1800.png", "id": "2519882931820846", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619369_2519882935154179_4688330543938033460_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Lfzu-dHc0Q7kNvwHKNnfi&_nc_oc=Adry8xTe4wumKRDVIq5dcCm94tL1p0sSpnj0oUSoRwcXD4QSPrHziur2_77oiJ2ce04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDvRopg3OaegT1t5O7Xk0wXx_cQsqd8p_onv3ljltPzA&oe=6B007CCB"}, {"file_name": "Cast_2200.png", "id": "1605877087557879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593723055_1605877090891212_240330335151319972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Yh3H04Fwq0Q7kNvwFbG994&_nc_oc=AdpLk4div3P_uw67oGJrQzuPiXvh_teHMhKua4tDUFSeg_u2qVqzYUujk_V5O34bsLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuEoOg8Xy-rroF5Azh4w5Q08_wxRREKgX4UauRtpMsXA&oe=6B008225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vernograph_landscape.png", "id": "1736960657592314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624583_1736960660925647_3065568427651551654_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIF4sktc3skQ7kNvwF6AOQl&_nc_oc=AdoW2vSrFpzeRkeywJp0kOas0ZtHNK60QC5z9Dbdxkw5Gu8_hpj4_cabIUBY-qaMypA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7l6ciA5zHbzMTRReNMoAbs-m-YQqmuD7Chu-HjKDpLg&oe=6B0084C5"}, "display_name": "Vernograph", "keywords": ["battery", "clock", "utility", "spatial", "home"], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "suppor
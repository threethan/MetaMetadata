/499620414_1087577637191955_5911510275090170522_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C5zGn4xrOcQ7kNvwHJwSY3&_nc_oc=AdrnESKLoOsoTHwATmF02tfFyBDIWigXvcUAla-193LQu2_W4mdDbBtrp7S5iDcNl7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjtwDY_DLn_M03IP1nvDhlwAubuBZANMywgJSSMLx54g&oe=6AB93E40"}, {"file_name": "Store_1000.png", "id": "1984329762281197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9ApN-eyAOsQ7kNvwFWkNq9&_nc_oc=AdrxqfmQiU5pHFSZvBeL6etlirFFP-Ii_0OEUt73c7M15Z3-UL7oHn2PpEZ0e8M1eXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFCsZckZURKqNv6fIzcGlVMgxhJHxG0lPd-jnaJ8FpAA&oe=6AB90E8A"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6_bbzNTt2QQ7kNvwGRbMyr&_nc_oc=AdoHH9ft10KISdvI_vX_5MNjOJSTl-XXf1SZkVoLJUrqGCkhnQYk4YFiwsNvuhIN8Ew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZJq4GL1pMDdk0VghquTXEMeIzcBANNpxGP52Oqi4T4A&oe=6AB914A9"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p784Ne8PHJcQ7kNvwHnilI8&_nc_oc=Adq9Kr7b1vCEAMy9hQC7bhJk_2so_i1-SYLfOazWxRPEP7IahHFugA_nePbFkNTrLWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXSCQ1FlVP-BcqBfcWSoTKt31nIgy4V2VWI9c20nsbfA&oe=6AB93235"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjTWiHFG0q4Q7kNvwE1u8T7&_nc_oc=AdpHh_TpF5T8v3LiLmxRDU1vmm6jA0cvolarrndvpg8y5pTCAsYRcvQS-UhlvWs6eFU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmvgGet11IKK6XiGIJTx1TYaEDMpQ1I5BmpWWkRP-aaQ&oe=6AB92C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_
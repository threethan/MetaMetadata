/499620414_1087577637191955_5911510275090170522_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FU8MlwFfloQ7kNvwE52tmf&_nc_oc=AdoW_2Jls-9kkGZht9oJOKj-BAUDkN4cfFhmNL5IZAtPQN1kBxgl4tXQC3wbKVXmXKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsZZ7gWWC4jnA1An2-9cmWzSrXG9NVr5ukFY7lR177pg&oe=6AB3F840"}, {"file_name": "Store_1000.png", "id": "1984329762281197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-ATlXDptRkQ7kNvwFRMv1z&_nc_oc=AdrUgMY9yTJA6u8IT1IboRnfGI57S2otIgPTOF6jD5uivwbQja6Jzw1i0NjXSzMIo5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpBDbFJxWvJUBywNq6Rh9ZEiz0fHYO4GhgC3mGyt0xSA&oe=6AB3C88A"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAmopJvLFfsQ7kNvwEO4645&_nc_oc=AdpcVz-ZDtsTHnHBRj1a3zknwLNjrkeoQfqrgmseuMOnU59nknewON6Hme_czy3FTcw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbfCiw87QK6byc-kEcJDlSYJamzharf9QzHtLsLkD6-Q&oe=6AB3CEA9"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1nDjBcE92IQ7kNvwHp-Ko3&_nc_oc=AdpA2TNEiFl4uXzIRqwEKV8n9mSVgUj7_ajBX6goBZZinQuuEYxMGx1gWiKw7atZ0XI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdCevT8tGaMo4Y-jJOfZuSE4hj7qBCridJ4Uy8pZXIrQ&oe=6AB3EC35"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHSD96KMGIIQ7kNvwFaxFs5&_nc_oc=AdoT_Hlat2YyaU0_RwkuGhCtkMCQqyAz_T_N-fEiXpEd-NzDLxF9CqQnAjSfRxo8qFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs_Pk1yxCk0Ix2FD75eka17PjySnUnJyQRy4h7ACHMyA&oe=6AB3E63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_
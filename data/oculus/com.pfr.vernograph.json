92959_6246837013926208846_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQjw-79PJ2YQ7kNvwErrOvK&_nc_oc=AdrPhc834Ax8KrySX_ZPPCLzpA_ImGhFlZHnfwHzK5Bcq4fccUT44eDh4MTe15FZg7A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDcoD17xRvBGt7en9-lWl4n58Z1Ss-IE3Ko4Is8lseKg&oe=6AF9B6EB"}, {"file_name": "Cast_1800.png", "id": "2519882931820846", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619369_2519882935154179_4688330543938033460_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYfPaepVWFcQ7kNvwE1yNDF&_nc_oc=AdpXEyQJDN21wTXvDOhAKgVM0sL3jAL2d-RFpafMgT9jEnftjYLAXjBEMx_po4qfwhw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT9S1NVwfyaCTqCyXAM6FJ3xAVf8vL69vcgDhKn8ySBA&oe=6AF9E54B"}, {"file_name": "Cast_2200.png", "id": "1605877087557879", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593723055_1605877090891212_240330335151319972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68TIWr7arq0Q7kNvwF16P1Y&_nc_oc=Adr-jF843tuwmBw8jF4EWXt-nXNdbtedh6XUjxGRHHNKgFfyKqoavZT3APiSmlpb8aw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Yy411uuliB2tsb0fi7sqtrKYcTtr1tt_M_fUN9NDaQ&oe=6AF9EAA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vernograph_landscape.png", "id": "1736960657592314", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624583_1736960660925647_3065568427651551654_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Pd7jTK6pZwQ7kNvwF4rjrT&_nc_oc=Adrd1sEMTWX90zjusJIInLawepW4F05sBO9MZLk07jk5LEy1EEhTmZaACsptab0ys_s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEt2wkxUTy0q9Hr89Y9NAcEitSFuEnP_KIIfvpRY5sxw&oe=6AF9ED45"}, "display_name": "Vernograph", "keywords": ["battery", "clock", "utility", "spatial", "home"], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_url": "https://ravan1955.github.io/Vernograph/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
c_oc=Ado6_0Nm3WxY5LHBiWUI_Ug2BhUgHzWKHh-tRVe_6O9BnpA8ejAdhn83lUFVqCM39qM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo9XmvUJu1a2Q_r3OhthlCGYS6_JcTDYrHFsi0Seq9MA&oe=6B084410"}, {"file_name": "Cast_1400.png", "id": "1756490575559626", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499626806_1756490578892959_6246837013926208846_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Bt99mzu2UQQ7kNvwGDTxd4&_nc_oc=AdrawOd3NgbkYGpAzTwkN4-mV_Q3oOhxM0I6TxrA3YpEaLEKv7zL11RCfqwkGoXw4WE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGY51LrKBdoZSgWR1LnrYQCWYEfqt9bp5ywIq9ldt6Ig&oe=6B086FAB"}, {"file_name": "Cast_1800.png", "id": "2519882931820846", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619369_2519882935154179_4688330543938033460_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0C1JYNCWlsQ7kNvwHMOa6x&_nc_oc=Adq7Y1Rcps9tuuAd71VB75sVAYpVPuqEsgour_HLEuNgRrygluJqVO6DuS6fYgyVV5g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJb7Dttxtq2pxnOuadLELe-9cf0KdeKQL1-ttmIuICRQ&oe=6B0865CB"}, {"file_name": "Cast_2200.png", "id": "1605877087557879", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593723055_1605877090891212_240330335151319972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bG_guafpt0Q7kNvwGkOHJU&_nc_oc=AdoN-kLsN1n87q5J6ieB2i_9w51BiLBs5HjvG61k9FihlwFBqJ8gzRJijte8h8nG1WI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBKKMrXNNLplFFOjCUognxc5DSbE7sHintFfg_kCcCQA&oe=6B086B25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vernograph_landscape.png", "id": "1736960657592314", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624583_1736960660925647_3065568427651551654_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9WqoqWoXE4Q7kNvwF2qKL4&_nc_oc=AdoMaD_rIL3abvK7bMGQ8pTrKiBpiV910yWFzpZn--ZdwixigKmfR7_cDIcueVTsvFc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkvEkprtQzXF6tAY4WFLuImlQjguUDKi2s_4tMGDaERg&oe=6B086DC5"}, "display_name": "Vernograph", "keywords": ["battery", "clock", "utility", "spatial", "home"], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "suppor
2.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-b75SY2ocEQ7kNvwGl9HfC&_nc_oc=Ado2kWm6yQvBU3SqsRYusjV8JcUxXySWYPzXoXSErHUfPQaWcuq81BY4VzJUSgip0s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNZg_HjqmlJ_YRrsLf_gtGZRgtdPGdcxbBi87J5qs1QQ&oe=6AC675CA"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri0Tg4leYl8Q7kNvwGXvKRA&_nc_oc=Adqw-g46QcBdj4Xj8LqlJ6DREkCQOWpVCvEbltcAtz8esGjJNrdKc-cGK25sBW70M7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdZhXYm5lomtMySjVS5y9AtPsS3t_h6xVizdUOv8IlYw&oe=6AC643A9"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HRqmpVnxgYQ7kNvwHZJnGB&_nc_oc=AdpLAZpAxag05xY0uCPNkkadYYxpskHbyZHJTbcYMG0UjDgFM_skQrgsICOuznGLAeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMjNi7siAvj0XlIREuGghVSJBq_7qA5UgAm_S2sZiW9Q&oe=6AC66135"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aLn4wkNzkcQ7kNvwEuIU3x&_nc_oc=AdqbPtocIAyCqYAWr_prVC_824NA5VukxCn7YAYxB3O3_rdqWs1f_wRZNUbuzJkzguc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7tFPljrkQOwZlmsi_DIdipqFN5EH1hz-emHHRtC8THg&oe=6AC65B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_url": "https://ravan1955.github.io/Vernograph/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
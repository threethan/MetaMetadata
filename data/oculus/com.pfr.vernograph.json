c_oc=Adpbp13uWaL1-w-UXZwnYrDcTXRrTK4mhKMdxFn_ZBN_E7y3JCmam03rNODaVglLgrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ7qXOBg5dqfhRsEVvMz_nHG4hT36YJU46glYhUQZSmg&oe=6B05D950"}, {"file_name": "Cast_1400.png", "id": "1756490575559626", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499626806_1756490578892959_6246837013926208846_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxUMercJZDoQ7kNvwEIAv-T&_nc_oc=Adp7rcjDSWG5fLtvZabpY9safkD98IrvspM_vWgsVO4w1MOkMucL52cZ4VH2GhMHX80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqCJLotR9wF2PRJ9UATtGuJmNLXx54viQp9XLYDHYGBQ&oe=6B05CCAB"}, {"file_name": "Cast_1800.png", "id": "2519882931820846", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619369_2519882935154179_4688330543938033460_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E74EL0IrVoQ7kNvwEKTeNT&_nc_oc=AdqJEZajtyrc3tQTFoQpOBrZy2kQ0Q_1nHlbNMtmgEtfrotyAq7H2RtCOEYhFzFS6hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS13wvug-I-ulQdLaSz7PNqMfg_XHfPMC8cf2qODFjr-Q&oe=6B05C2CB"}, {"file_name": "Cast_2200.png", "id": "1605877087557879", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593723055_1605877090891212_240330335151319972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bG_guafpt0Q7kNvwF9fsoN&_nc_oc=AdoxbfRJSqlw6aG-JxcZRmwFmdzQSkZN5Rr4u8X026T-A8KYTJonzKJO_cwPeYxOoGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0DAqgpYJZ2h2YUb_rqsP6mLiP1vrwqrx4V4V5sPd4jA&oe=6B05C825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vernograph_landscape.png", "id": "1736960657592314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624583_1736960660925647_3065568427651551654_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9WqoqWoXE4Q7kNvwG10tNi&_nc_oc=AdqHo7DHhKuYdwmuTHfclptZI3JAeb3Xtt1a8BIWFwvGH8sw8D6G3F2CUHaWTd3RUlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnBnQf1K1sfRYsqDBbJ8co4mteYq3rLir1OtQHbm4b7g&oe=6B05CAC5"}, "display_name": "Vernograph", "keywords": ["battery", "clock", "utility", "spatial", "home"], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "suppor
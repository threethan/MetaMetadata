/499620414_1087577637191955_5911510275090170522_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C5zGn4xrOcQ7kNvwGuCCAr&_nc_oc=AdppBwgOsDhsguAP1uyKk96mPHf6JJEGfPTts1yStJD5r7CrpKeAzC6kW0KrWS0Mcew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzOD7Fcd9mwm-rGL-vaI2uZn0Ss_UGJM03dwslKEV5Qw&oe=6ABA8FC0"}, {"file_name": "Store_1000.png", "id": "1984329762281197", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9ApN-eyAOsQ7kNvwFssM1t&_nc_oc=Adrf2x0SKsprBJdlEpfaxpSwtVllDRXTJS_7Zyw9cjTrhrfAW2Ir7K-fO1hICne2Lns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjVmexbLLzIy0l3kqlJEF8kyoIal7tAGNhKtFUR2_ixg&oe=6ABA600A"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtJVkELFBJUQ7kNvwHzRfNR&_nc_oc=AdqGGY0s4Bh772uUyWPc_H2OJ6BJe9fd5JteeEz943DhJsZYwFPI-_tGb_9FVuRQWOA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrLJx5bZl11wOadWgscY7BILOjZgyw34A3GGhtFceuAQ&oe=6ABA6629"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p784Ne8PHJcQ7kNvwH26_Lm&_nc_oc=Adrk0RjpyNSbYutM40f3-fTnCCnkO0K-quwQeL00p-aNNQt3Z_lMmD3G_M9OaH3_LI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2ZmVbnNWcCaLzbzYPceH9rwW2CV8WbuP-NItf0WFAIw&oe=6ABA83B5"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNafWG9mSn0Q7kNvwHtaud6&_nc_oc=AdrrsoZNOBWkJrNJf5UyAOVU_06HviJkZ2ntK-lXWp-YnDeK0iJTDD8YNXFtUvqLpzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4EzGx70kc8olRMy8zt-dXWt0AkhY6qr125gzKUJnQmA&oe=6ABA7DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_
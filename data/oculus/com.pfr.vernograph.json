92959_6246837013926208846_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOh-QW9EG2QQ7kNvwFy_uKo&_nc_oc=Adr4FtWhpGqv6PYbxT02z3CY6HaVX6QeVvYnx-A_IRWfxq6Ggag5iJKouW1Py-bA5H4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM860AhJpf4pljBGwUjqEKLo21-WvzmO1lUHGCtYs4Vuw&oe=6AE1FBEB"}, {"file_name": "Cast_1800.png", "id": "2519882931820846", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_2519882935154179_4688330543938033460_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e12NmdgKg9AQ7kNvwGx6GYk&_nc_oc=AdoN-wbSoyyGb1GUXrbGIzheuI5aLpRplvb7zOddTz0TOsjLc4nCaO6U9ZpYPtmf8HU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6TswmULOx0Os6AXzFwk-wkaQSGU8lNr6S74bHhByzAw&oe=6AE1F20B"}, {"file_name": "Cast_2200.png", "id": "1605877087557879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593723055_1605877090891212_240330335151319972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWBjy3k3WFYQ7kNvwHXpCS2&_nc_oc=AdrHMpm1LcxzDf_BK6MbSC4vSR_QwKcdzgvwMeaVasf1cReyrOfy6w1qQR0f7tALUi4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhfpnPcnci0xam2W4lBrX8BzRy2TVFIDpV3rfBINZuEA&oe=6AE1F765"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vernograph_landscape.png", "id": "1736960657592314", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624583_1736960660925647_3065568427651551654_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ultNKi3uQC4Q7kNvwECwZBv&_nc_oc=AdohLMc4f-B9icp3RD098pXVfRhzlNh67tYuJjuPblaYPrvOCwuSwDTZeQ01JBylaVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKaaaP1XOwG43WXK2scl6jUUexPQqI_yP26uzdtAAz-g&oe=6AE1FA05"}, "display_name": "Vernograph", "keywords": ["battery", "clock", "utility", "spatial", "home"], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_url": "https://ravan1955.github.io/Vernograph/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
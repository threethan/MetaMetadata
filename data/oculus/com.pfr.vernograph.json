/499620414_1087577637191955_5911510275090170522_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FU8MlwFfloQ7kNvwHyWkvs&_nc_oc=AdqdNnz153pY_F611ECWTzba3CZ8PgWiRmnI_8lRLXlWbvCiHzJMAZGRqHH0PnAcsAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQOlhzpgvaCA4V4d--qqHa-MzqGQGBP8YxkjOngJhhIg&oe=6AB549C0"}, {"file_name": "Store_1000.png", "id": "1984329762281197", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627502_1984329765614530_6104579947488403312_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-ATlXDptRkQ7kNvwEbbdty&_nc_oc=Adpajnak1L9XJWPca4q8S6SCwGBbGxvmjhcwNnzvbP9b8LEh747qjPKT1zFVcZ09Tdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN_BCSIjkcRFU-GpPESQjd98ouzQcbmNBzKOGuombc2A&oe=6AB51A0A"}, {"file_name": "Store_1400.png", "id": "1725478115194678", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628893_1725478118528011_5639402031499615424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAmopJvLFfsQ7kNvwH7n9eX&_nc_oc=AdpxDLAGorhatjBkJpvs8a0elfoLHY-ENjFk6m6ypRY3Kd298q82Drz48h2Z3AKdnl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaB80LXy5dznNCyAPAGp6f3-H8Alkc1NnfZVjASxU4tA&oe=6AB52029"}, {"file_name": "Store_1800.png", "id": "1554489825863767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619404_1554489829197100_7516648434950348762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_QhHB4akGMQ7kNvwE7q_cz&_nc_oc=AdpaVLySg86TzTgULZmXLA4ITahZt1wRhCT7PMpac9Gm-ADILsT6j1hi46JS6DSf-dU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo8jCj-inhWbF2XNfqytkfvdQzSKZA88RUWvSaMxS5Yw&oe=6AB53DB5"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHSD96KMGIIQ7kNvwG9SFGa&_nc_oc=AdpGUp3gtSJJ1AkGjRJ3MFRHwRha1pPeW-tvZeMUreSQS_dwbc5tBh0J9pWZbCdNTB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIANAnris-6RtGcpnIqPmIp6eVw6m7yFmJXWFphxffNHw&oe=6AB537BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_
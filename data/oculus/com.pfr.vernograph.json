c_oc=Adon-Jzf0WsJItBmZ0ZAH1CScGQGSW4YUj1HGJlMTDVCMmht4TK7SCPPxGkVZLrWSI8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4gcnwawzHk7JSpmxQBV7ZIH24WMNaxMvaViyFx8bwNA&oe=6AFB1510"}, {"file_name": "Cast_1400.png", "id": "1756490575559626", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499626806_1756490578892959_6246837013926208846_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQjw-79PJ2YQ7kNvwEBUPYe&_nc_oc=AdryEKyM0oDiT8qv2zBLNj7Pa_dIFzkh_cM3frO749j0LmNxwaEX23XSLMWa6RbAIZU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgIh9ceqL6Ds_VJcY7h2qbzHZNw6Ea5ffpFzqWvD5NBA&oe=6AFB40AB"}, {"file_name": "Cast_1800.png", "id": "2519882931820846", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619369_2519882935154179_4688330543938033460_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RS7A_Ru_fMQ7kNvwGMBDVo&_nc_oc=AdpFDqXkgY5MP74aOgQysMd0ubmZsMBUr5tf3kuV0ULYVdNH0kJn7MGaGcacsMW07nQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREXNKxNGfV6jGxYts1BaCafbZ8V2pDY41qjcCLzPJ6Cw&oe=6AFB36CB"}, {"file_name": "Cast_2200.png", "id": "1605877087557879", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593723055_1605877090891212_240330335151319972_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68TIWr7arq0Q7kNvwHbPukx&_nc_oc=Adqi4xQL-TGUBYuCK8zJl0cnEVxllsFDazrmcyts3ySO7gZvn2wm4jN_TKnr1zOPIAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEKr-_dzjIFqkCpXQyW7Aino9_ls527pepCYn9vGHZPg&oe=6AFB3C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vernograph_landscape.png", "id": "1736960657592314", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624583_1736960660925647_3065568427651551654_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Pd7jTK6pZwQ7kNvwHYLBlH&_nc_oc=AdrI2HHIeHFleUri7_13Zvh5hBnyNWYgv69TQAyB-5hh61ics3s1PgSUGSz2UtfrJjw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToZRUxR-NBssCRoF5c9_0KbRIIe9KbFdT2wCtNVK22FA&oe=6AFB3EC5"}, "display_name": "Vernograph", "keywords": ["battery", "clock", "utility", "spatial", "home"], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "suppor
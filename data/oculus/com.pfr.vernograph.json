6AFDC035"}, {"file_name": "Store_2200.png", "id": "1079820914781348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_1079820918114681_61734794884477868_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8haE1I5O18Q7kNvwHqdNwU&_nc_oc=AdrSSj73cNb0W4SHMqaURPFAPCKMXGm8PoKBd5j6kruYi6Pw_xPZcGaWNLdPrEaczoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmN0UBX_cOIz0MbudICVQ9juh4FBPDEcHT8wQqIkoiQw&oe=6AFDBA3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vernograph", "keywords": [], "long_description": "A windowed Home app displaying a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments, evoking Jules Verne\u2019s age of invention.\n\nVernograph sits in your space as a living instrument panel\u2014not a flat utility sheet. Read the time and date, watch battery level rise and fall, and see pack heat and headset thermal stress at a glance, rendered as brass-and-copper machinery you can anchor on a wall. The background mood shifts with the hour\u2014from dawn light to evening dusk.\n\nFeatures:\n\u2022 Stereoscopic copper infinity-cube sculpture with spatial depth\n\u2022 Steam-era clock and calendar displays\n\u2022 Background mood that changes with the time of day\n\u2022 Battery level with charging indication\n\u2022 Battery temperature thermometer with warning glow when hot\n\u2022 Headset thermal-stress gauge with flashing warning lamp\n\u2022 Works 100% offline\n\u2022 No account needed, no data collected\n\nPerfect for Quest users who want a useful decorative piece in Passthrough or Immersive Home\u2014an ornamental wall sculpture and instrument in one window.\n\nNote: This is a lightweight 2D panel app that opens as a window in your Horizon OS home.", "short_description": "Windowed Home app that displays a sculptural copper infinity cube with spatial stereo depth, fitted with steam-era instruments for clock, date, battery level, pack temperature, and headset thermal status. Anchor the window to a wall in Passthrough or Immersive Home \u2014 a useful decorative piece for your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/ravan1955/cc6b08a15a3a5b7cad37203943d12c09", "developer_terms_of_service_url": null, "publisher_name": "CodeWeaver", "support_website_url": null, "website_url": "https://ravan1955.github.io/Vernograph/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1075913132023820"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2147162566144525"}]}, "baseline_offer": {"id": "2147162566144525"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789591560, "status": "PUBLISHED", "id": "2147162566144525"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1079414615007005", "version": "1.1"}, "id": "1788022322227118", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1075913128690487", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1079414615007005"}, "release_status": "RELEASED"}, "binary_release_channel
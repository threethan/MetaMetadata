8beR8WnNDc3hdI2JQkZ13hgZNA&oe=6AE49D9A"}, {"file_name": "5.png", "id": "593563619980101", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828843_593563623313434_947380134201197030_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obwBZLeKK5AQ7kNvwEcsodP&_nc_oc=AdoOSDOUeMx2y0iEIMGtskzou8Cz0-fo3IS1Zky6B2Ym3unlrezxZSt5PjSA3SFEMu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf-v4IRR0rsV7o1hhhKmPku_cHWG3BPkQbNIaek-St8Q&oe=6AE4A1E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Machine Mayhem", "keywords": [], "long_description": "Machine Mayhem is a game about socializing, action, partying, and more. The lobby is the main base for the game where you can customize your name, change your color, report bad people, and customize your game to your liking! The shop has plenty of cosmetics to style your robot to make it the coolest machine the world has seen! The forest is the main environmental hub in the game! You can access Zero Gravity and more maps to come! You can also adventure out through more fun like horror and rising lava! Hop through the rising lava to escape the lava from burning you! Run through the horror to escape from the evil monster machine that lurks throughout the mineshaft. More features to come in the one, and only, MACHINE MAYHEM! Make sure to join the official discord to learn more about the game, and check out the website for a lot more!", "short_description": "Welcome to Machine Mayhem! In this game, there are tons of features you can explore and maps to adventure out through as a robot!"}]}, "developer_name": "ChaosVR", "developer_privacy_policy_url": "https://sites.google.com/view/machine-mayhem/privacy-policy?authuser=1", "developer_terms_of_service_url": "https://sites.google.com/view/machine-mayhem/tos?authuser=1", "publisher_name": "ChaosVR Games", "support_website_url": null, "website_url": "https://sites.google.com/view/machine-mayhem/home?authuser=1", "category": null, "comfor
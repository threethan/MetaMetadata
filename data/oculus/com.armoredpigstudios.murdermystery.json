dn.com&_nc_ss=7f20f&oh=00_AQS8vX9Xba29ftNYyFozeLhoxK2LSZXBJvxx1Uw-JHBF7g&oe=6AFDB2D8"}, {"file_name": "SS1.png", "id": "2179844142602006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_2179844145935339_424623037586754002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV7mnh9ERYUQ7kNvwE7TK2M&_nc_oc=AdpueP8I-kfFWixOE2PQPXGNLadmSqmZlb0KHY7442iukyhlAbf6fhhrrVvyECA561Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMG3vLaKiD8RXt6x6-FSFGt6f9t3TrBwQ0XigrQyqtwg&oe=6AFDD5E2"}, {"file_name": "ss3.png", "id": "956862447483909", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_956862454150575_4878521316892055638_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qiOSLdzZkgQ7kNvwHRXSD9&_nc_oc=AdrJauksxvtrZLvEJSjMao2lt6fo38s4_Tj0p6Nop9VcKoO5_SwdhZEDFCODcWScjBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXLnJ_7GNq14uta4di1pVdiyiBOePM7l6E1QRtrofohw&oe=6AFDE374"}, {"file_name": "SS5.png", "id": "1141436318421588", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_1141436325088254_1161812435877564380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjPjv-ak_dYQ7kNvwHi28Jb&_nc_oc=AdoRVm4B0t4FgXotWFB14gt64ORZIrow00J_Uo3Fcwe0OLA6Tzg9sAqHYVr1t6k7FKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqLwPrzya8q7UtlY7RCFe0gWYNu8BAa0amL9PGwSi_0A&oe=6AFDC16E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MMCover.png", "id": "2562148647640118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_2562148650973451_6911108393567598252_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7I-GU_ekiAQ7kNvwHoRy2b&_nc_oc=AdqHpvVwwXtNEu2P7wmA9yxG3KtZUQPvWGXlHgYI0oI_BYwgC5Br0H7ZW3KzQuCSd7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOlzyWG74JTcz6LgYtM16teQBblUR78EMIMLR0wjTl8g&oe=6AFDAD43"}, "display_name": "Murder Mystery", "keywords": ["murderymystery", "social", "killer", "mystery", "deduction"], "long_description": "**Someone in the room is a murderer. Nobody knows who.**\n\nEach round, one player is secretly handed the knife and another gets the sheriff's gun. Everyone else is innocent, with three minutes to stay alive.\n\n{1682616626851134}\n\n**THE MURDERER:** Draw the blade from your hip and get close, or flick your wrist and throw it down a corridor. It comes back to your sheath a moment later. Take everyone out before the clock runs out.\n\n{1821104342395210}\n\n**THE SHERIFF:** One gun, one job: work out who the killer is and shoot first.\n\n{2578518912649329}\n\n**THE INNOCENTS:** Run, hide and watch who's acting strange. If the sheriff goes down, the gun drops, and any innocent brave enough to grab it becomes the hero.\n\n\n**TEN MAPS:** Ravenholt Manor, the Pier 9 docks, an office forty floors up, St Agatha's hospital, Tinkerton Toy Works, Hollow Lane on Halloween, Blackwater Penitentiary, the dungeons under Castle Grimhold, Maple Grove Plaza and a college dorm. Vote on the next map between rounds.\n\n**PLAY TOGETHER:** Jump into a public room of up to 12 players, or make a private room and share the code with friends.\n\n**MAKE IT YOURS:** Knife skins with auras, trails and kill effects, gun skins with coloured shots, and a rack of hats. Optional role tokens let you choose to be the murderer or the sheriff next round.", "short_description": "One murderer. One sheriff. Everyone else is innocent. Throw the knife, grab the gun, or just survive the clock in fast social-deduction rounds for up to 12 players across 10 maps. Nobody knows who did it until it's too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1420216556281041"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1736868271479893"}]}, "baseline_offer": {"id": "1736868271479893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792090620, "status": "PUBLISHED", "id": "1736868271479893"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1449296200039743", "version": "15"}, "id": "1120634913769573", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1420216549614375", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1449296200039743"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1120634913769573"}]}, "change_log": null, "created_date": 1794535050, "id": "1449296200039743", "version": "15", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename":
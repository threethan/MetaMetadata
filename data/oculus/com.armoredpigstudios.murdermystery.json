smQPDUvTw&oe=6B084D6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MMCover.png", "id": "2562148647640118", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596168449_2562148650973451_6911108393567598252_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20JKpeN2t80Q7kNvwFin-8R&_nc_oc=AdqAvQdjqALqqdEjc-3fn_32C7w2yNoiMedzrRvAT9kQjVPXxWHt79YDPQgdZz8iCkg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmUK1OLd2Tvw2jI0Z06tf8UpJoZyqLk17IOwnz26bf6g&oe=6B087183"}, "display_name": "Murder Mystery", "keywords": ["murderymystery", "social", "killer", "mystery", "deduction"], "long_description": "**Someone in the room is a murderer. Nobody knows who.**\n\nEach round, one player is secretly handed the knife and another gets the sheriff's gun. Everyone else is innocent, with three minutes to stay alive.\n\n{1682616626851134}\n\n**THE MURDERER:** Draw the blade from your hip and get close, or flick your wrist and throw it down a corridor. It comes back to your sheath a moment later. Take everyone out before the clock runs out.\n\n{1821104342395210}\n\n**THE SHERIFF:** One gun, one job: work out who the killer is and shoot first.\n\n{2578518912649329}\n\n**THE INNOCENTS:** Run, hide and watch who's acting strange. If the sheriff goes down, the gun drops, and any innocent brave enough to grab it becomes the hero.\n\n\n**TEN MAPS:** Ravenholt Manor, the Pier 9 docks, an office forty floors up, St Agatha's hospital, Tinkerton Toy Works, Hollow Lane on Halloween, Blackwater Penitentiary, the dungeons under Castle Grimhold, Maple Grove Plaza and a college dorm. Vote on the next map between rounds.\n\n**PLAY TOGETHER:** Jump into a public room of up to 12 players, or make a private room and share the code with friends.\n\n**MAKE IT YOURS:** Knife skins with auras, trails and kill effects, gun skins with coloured shots, and a rack of hats. Optional role tokens let you choose to be the murderer or the sheriff next round.", "short_description": "One murderer. One sheriff. Everyone else is innocent. Throw the knife, grab the gun, or just survive the clock in fast social-deduction rounds for up to 12 players across 10 maps. Nobody knows who did it until it's too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1420216556281041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604347072_1475466304488096_8068157804222598012_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wpC04nqeKcQ7kNvwHRgfGn&_nc_oc=AdrR6smxapxqOGFxMHofieIshKjyxsQVx_eUKEkpVHDPB3bnUL6wlNc-qx2Ydt9evs0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyA1ARtIfK0g1fZd4lSyGUKpS_hJRAmzGK0y3BTlrIcA&oe=6B085DFA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Murder Mystery", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"t
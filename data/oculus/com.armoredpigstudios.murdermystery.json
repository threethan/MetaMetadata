dn.com&_nc_ss=7f20f&oh=00_AQRutSlLzmahMB6WuKOGq988DShjb-5N3QHhy-ePGtZ0Dw&oe=6AFC6158"}, {"file_name": "SS1.png", "id": "2179844142602006", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_2179844145935339_424623037586754002_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV7mnh9ERYUQ7kNvwG1rW9e&_nc_oc=Adp_PlOtQNaC0E8mgf-ieGWIpLesi3w61xgTcftHIxi31-pUmYG2xVlA-wnj6Rwf1js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhFLMVo3Od5q4tMp_IRZ5PJaIpcMyNARspbbXIj-4dOA&oe=6AFC8462"}, {"file_name": "ss3.png", "id": "956862447483909", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_956862454150575_4878521316892055638_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qiOSLdzZkgQ7kNvwErLriL&_nc_oc=AdpEns4yvsjHsGQuPCz-HwDi7TCEXwpVgvGY5kwrn_Lpr3mBkLd17QbYflEpynB7UaQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTynfyor0_5BpLLoMtxHUzcnwjyyVmt7gRXz5_LwDKmZA&oe=6AFC91F4"}, {"file_name": "SS5.png", "id": "1141436318421588", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_1141436325088254_1161812435877564380_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AJGAj5UUGQQ7kNvwEAY7Yz&_nc_oc=AdpxqLcD4bXOZl8gwMYN-U2BBfX09I95fDpLeYXGwwF3F6uWE4zfDYhtC7MxRv-IOTY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8a7RDaGz53ejDNmSoiQw9UFnoI3Zpt1gSHABMaroUPw&oe=6AFC6FEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MMCover.png", "id": "2562148647640118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_2562148650973451_6911108393567598252_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7I-GU_ekiAQ7kNvwGmYlNH&_nc_oc=Adq2hLcWbVi-F2v2iNVIaPmw3UyEyGjk9QTVJByCBfGn1f-4p-BwBo6brTjwK69bu0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_rwb4fjohMeGyrba73B0L8JnEKCWaE5l27Ut3JQ0r7A&oe=6AFC9403"}, "display_name": "Murder Mystery", "keywords": ["murderymystery", "social", "killer", "mystery", "deduction"], "long_description": "**Someone in the room is a murderer. Nobody knows who.**\n\nEach round, one player is secretly handed the knife and another gets the sheriff's gun. Everyone else is innocent, with three minutes to stay alive.\n\n{1682616626851134}\n\n**THE MURDERER:** Draw the blade from your hip and get close, or flick your wrist and throw it down a corridor. It comes back to your sheath a moment later. Take everyone out before the clock runs out.\n\n{1821104342395210}\n\n**THE SHERIFF:** One gun, one job: work out who the killer is and shoot first.\n\n{2578518912649329}\n\n**THE INNOCENTS:** Run, hide and watch who's acting strange. If the sheriff goes down, the gun drops, and any innocent brave enough to grab it becomes the hero.\n\n\n**TEN MAPS:** Ravenholt Manor, the Pier 9 docks, an office forty floors up, St Agatha's hospital, Tinkerton Toy Works, Hollow Lane on Halloween, Blackwater Penitentiary, the dungeons under Castle Grimhold, Maple Grove Plaza and a college dorm. Vote on the next map between rounds.\n\n**PLAY TOGETHER:** Jump into a public room of up to 12 players, or make a private room and share the code with friends.\n\n**MAKE IT YOURS:** Knife skins with auras, trails and kill effects, gun skins with coloured shots, and a rack of hats. Optional role tokens let you choose to be the murderer or the sheriff next round.", "short_description": "One murderer. One sheriff. Everyone else is innocent. Throw the knife, grab the gun, or just survive the clock in fast social-deduction rounds for up to 12 players across 10 maps. Nobody knows who did it until it's too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "Armored Pig Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1420216556281041"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1736868271479893"}]}, "baseline_offer": {"id": "1736868271479893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792090620, "status": "PUBLISHED", "id": "1736868271479893"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1449296200039743", "version": "15"}, "id": "1120634913769573", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1420216549614375", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1449296200039743"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1120634913769573"}]}, "change_log": null, "created_date": 1794535050, "id": "1449296200039743", "version": "15", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename":
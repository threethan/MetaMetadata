64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHmgoxgrEWYQ7kNvwE1Sian&_nc_oc=Adp4ciRH6VCC9uH5CapF0OwNJy6i3n7tXeSOqGXQKkyIA-vLTFwhNWyxzBp5Y5ogUzI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThwNB_CiQo1wnzNSls-WKvWZkwn7g5gcQpreDcLc6Fpg&oe=6AEC8C70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjmsQN_oWDgQ7kNvwE03kqF&_nc_oc=Adrezgqc1SGILiL7q4C9o3vi4Q8oi2CB8lRuGTsoJWkco2Hb63ES2SxWQ2G4aU3Lsyk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeIrFT6w0hUH_kkRdOBVhhVIme_T5cVCU5qlEgEqp4Ig&oe=6AEC95F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLV73Pn7yPYQ7kNvwEUrJEj&_nc_oc=AdqBcMoEfQWJr8S8pVJMSxrpgM2iXoDwWx7HggAsIJZjh42LAFYWmTYekmRjRC5wG0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu6FvYQQYzwqg5SIK03Z6VWOAGFrFZYrw2V66vwEVezw&oe=6AEC89A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbdbuI6m2nkQ7kNvwH_NjGa&_nc_oc=Adpvz2R_eSV4AONxzx0iJYCsLMssGDevgRVYGvwLfDcByWaTBVddF182-zVwGfg7lwg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUpAuwsvM2nNvb2vB83lYCr9qe6J4NQjwo0oepPpKR_Q&oe=6AEC8ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqAnupbL-k0Q7kNvwEm_sQC&_nc_oc=AdpMvJUy1MMRyU7Om3BXmIQBTHv_nF0AvKLBXOvmlW7sFRYd8M_dn7lk0L2GqGXQ51U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlcGAcjK0gS9oxna9HUeBu-PZMTOjmIN2kI5oPbDSv0Q&oe=6AECA43B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
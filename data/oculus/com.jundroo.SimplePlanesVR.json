64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha0AGYaNuyQQ7kNvwFo5Jwb&_nc_oc=AdpQo76yqCAJaweKsmVLkEn41_yKexuDHRR0yLCi01iRUD_VXdMg0iJQ2S8lCrYjZ78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dTNjLV8xLLcGwWueLplw9hLJFa9yXOY6Ym6b2C-xqQg&oe=6A43CC70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjBoyeeoyUQQ7kNvwEtTl8M&_nc_oc=AdpzTXQheOzzS6qBuEpo5ZXI9Gf2JJlcvjCjH0BJMEU_-NWh886AWfMnqiTZWWj3RG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95fsn2NhpGtLDQb3rIBxZO3_Fc4jg6whJt-Qgmy36vLQ&oe=6A43D5F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w2d-txPbLQQ7kNvwEKxps4&_nc_oc=AdojAHJldut9WlRpnBkoOQfy7nVABsVYA2rcAFViReEDfsZ-_SmgpEb5dzPcPFMqpok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VriF4g3AFRzMo4XyOk2jKp0pDCU7ZV8y2GYOcxq6p_Q&oe=6A43C9A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp6d60AnmMgQ7kNvwH3_EW7&_nc_oc=AdrkTvh9yQDumTaHZactgyZdNemaxx22z3XC66njjiBb16ndXXilQCfeaTuKIJld6sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JqXoRHUaPdf8QOwYl5yoqGoHTKFAvAK1WE4ZQbmgC5A&oe=6A43CECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3Sb6S972YgQ7kNvwF3JAx0&_nc_oc=Adq2UKveOfNyIkWdr5atQmTelcecSAh15T0JNLE13WWV6i0Al3ALELjCtE0_XfOt0xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KznUaD66BGuB0yQwnZkQiL-uWeF0kzh09khjj4nJkaA&oe=6A43E43B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgK8htl526AQ7kNvwGJemZz&_nc_oc=AdrDlMKVgEnugHzK5oc_BX-nSzX881-hYIW8jn2p-gaHvx7jLOUVTKYGoDLnhPrzdPE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq2axES_T-9x8i_Kb_vx6aJguIaAgOv5pAYnqMk-sOdQ&oe=6A5A35F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipo3K-CYXzMQ7kNvwGLuIW9&_nc_oc=AdrTgbqW7klIHzwok2NUUYgfOWQ72rLu3-A7T_9pF30HqwkG5Hqa8URqmVKuUt0P8f4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3MrHivbKbGrd-Xw0zTnGyP2mMC0Yuvvg5njrOGyTqKQ&oe=6A5A3F75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MQHdlirSscQ7kNvwGppFLE&_nc_oc=AdpUtnJxSXkFs7w26SJgkGqJSgydALbApVEdIeSWbXA0nQaaNE84bvoYySU85K8-GFk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArjRMlKTWmBJRb2SbitaoWusZ82qJRiU-DYfVi7_zbFA&oe=6A5A3323"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymCt9ZZ2JtoQ7kNvwEHFwhx&_nc_oc=AdqtIJIJf3NawHwV45F5vkSohLGTsr1cyPEzGEf7qgUkZu1ErQ4fscAlulES2fP4fvw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3MJ7xg27KzDmgP0tO6s1qUYV4Pjcv-1lk3GyE_NbtCw&oe=6A5A384D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZWa2LvqtYcQ7kNvwEfI8UI&_nc_oc=AdrymFG7Evhb_F9OBSTzpZ9lGn9urtCYkM1_KvqnKTGnli83y3InVrnebs0L28C9mmE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqbG_wzCjU2hrujKKBJ9zgT-Xh3aJgdfO_k-N0oNhApw&oe=6A5A157B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
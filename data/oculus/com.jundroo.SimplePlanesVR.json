974864_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_al0_iY-3YQ7kNvwFdV22k&_nc_oc=Adq2KkKUUKY3Lm4rsQUfIsQFJjPcpmVr2dWxqUDjBozeKsYw6VocvQ6VXotKt1XNsxc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0HeYPqDJ-x_b0ehJ2TBS5z6sO8CMXgpYgkEvJk5aZ-w&oe=6A466F70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjBoyeeoyUQQ7kNvwFofeR7&_nc_oc=AdqqTCKgx4gnPFWJ4EjmF6RhNsrBEtxdZSbxL8y9TJfNKQtP9Zqv7B3t4qiQewPYHp8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93wNTMbz00P-9d5iwZbF45Yo-Lf1nzcpWTZuXn_qwKcg&oe=6A4678F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te5YGvSzjVMQ7kNvwGBhKGp&_nc_oc=AdqDy0D7NbMDXhTpiX8rpmOv2v14w27I-Lp37q4SMO7MAuBt4sXFTQDy2CWzrdQn45Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UAqEK71Gg1-Xp_YLT3CRIS5w4dsFWPp2-aWkAkiunUQ&oe=6A466CA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp6d60AnmMgQ7kNvwEePH-d&_nc_oc=Adpkjn34EwfgBpJmYhYuED4nLt9wYwRB_4TP_BXpbd_fXdXr9F75S48jt8O85KGIY7U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WjoJaijbpzOhhwSbU1zyzHW1I1rHKOOTFa-MIUgD_9Q&oe=6A4671CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3Sb6S972YgQ7kNvwHMWwI9&_nc_oc=Adq-xwkvYj4UrjmwSGIXqIHSX033i27lDZQHQssDSNUtp-YVO_WyPbZfmHK8nMOmzeU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u_NJwru9Jpky3twb29BXDZ_d_noQEdzLfKnRQ1JcdnQ&oe=6A46873B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881
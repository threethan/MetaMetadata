64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZGCrdWibpoQ7kNvwGBqaHm&_nc_oc=AdotL6FJBAqdrDqJbaQkvqxDNnAzFzkF1dHl2xE8LutJQbDni1pdVVOnzF22-ucXM_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpXhxx3FqDpNyYd_PiT3dsafFmPjpWMv3lMZVFoIkRDg&oe=6A6764F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfKnMX_RgWYQ7kNvwFwe8sy&_nc_oc=AdoWhulth-Yv4Z3N0eJsl5bqQncV7YLfyUMdmp0pk8cSsFvpJIYk_VvM4sMsRkVMWPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTvTljIFIoBy2X6vwoXkGQ3Wq36b8cCFgF21ZW04s_dg&oe=6A676E75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaOARGDDN_oQ7kNvwGasESp&_nc_oc=AdrBkat08m4yhnIm8zrfa7ymDhM2xPrNcN1Jy7knZxKbJClzRXm1urO2ifV2c35sHIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4LnA_CeVeQzoMIK9vXH1m9IQrh037EjQ2eZDs7wdz-g&oe=6A676223"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NucIzQpQ23QQ7kNvwGGDODf&_nc_oc=AdovymGSb3GisyybPqDY6Iy7Q_T-eA-D5l82XmYkyQhFHymDTWUVUo0iOfX6_1Q2X4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwsO5P1uCYXF7eaARSoF30AsVgjP6_TdwSJ4HQB2-UCA&oe=6A67674D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVP9rTqrPtUQ7kNvwGIrDur&_nc_oc=AdqfK7p0hEn3D8R5qM7m8w3BN54Fz2_2zBKFuCXgmN3yflnTqnnuq-Au22tMVlbMfLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxSfw3FNzm0jlgOVl3vJ7ttNCHSGU5luO2k3oH_1txhQ&oe=6A67447B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
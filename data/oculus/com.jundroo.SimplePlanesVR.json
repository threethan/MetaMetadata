64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGgOMvgXdyEQ7kNvwHWKG_-&_nc_oc=AdqdqFIr0g5CfkaVJFHTTvgJTwEKQsCLDoerE_UHWItHPm96bbiberLydGfJ72HgHpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR_6xN8PBgR86D_DTka6EYKLN5-F8C7hV5jk0-lVLpXA&oe=6AB3DBF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1w5-9pZNWQQ7kNvwE0pJwb&_nc_oc=AdoUnZ5ZWEU34Qu_gdjtofy6p0MXXM0O9CPIg5CGLpr8oj5hJcOyR3VYUekuZYcsHDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi5iBkA52hCYAO-9hVxBct4lZmBQF8WVsGCr0_WnSUSQ&oe=6AB3E575"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h40pMMRrPgoQ7kNvwEjCaCc&_nc_oc=AdpCkoeDvt7BT07vxnfuaOe5LGw5Gnnf9nKEGQr0i7jsj51P83CfOexkK-cM9BS5lNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4OwpiEHcj0ZhXNnMg_JmDWmsdTAHxWibBhGogISsF-w&oe=6AB3D923"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzsebM_RDGMQ7kNvwE_47km&_nc_oc=AdrJbcF4in2Dg2hva2h0mdLAZzXaAPV1D-2vP1Xo90CKgEQvbLWHJ98pJqlwCBtgA6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu97n1L5JYe07rh8jy7g47rN2I8FvYEHyKJAYHhUTdgA&oe=6AB3DE4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k9WPHrIRUUQ7kNvwE-yRUG&_nc_oc=AdrmRcubgITW-TPlBGFDQOgi5M_dVBuGtG7iKViMn45UlvmsBomnyf_Dkb-oFicjWrQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6y0Zz4eaoDhZsE8QWemQjt6pQeCA0ApHUsucmj1bcBQ&oe=6AB3F3BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHmgoxgrEWYQ7kNvwHy9AtN&_nc_oc=Ado0C_oa4jCf1t6bLU15oXBMJeTGrGZgqHZCGYQjHZpoWFEXNYvrP5pNYwt5DQ5XnRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3qhWu9Lz3MVqutaKESOuNig5KX_bc-m7oWKujdBqCgQ&oe=6AEB3AF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjmsQN_oWDgQ7kNvwH0kUlW&_nc_oc=Adq2u7x3JG3bwLD3osJaOJR-IdVvHoA1-wJ6bqZvZcAL2PuOKccyqPEC2C-WPqTbKYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZFN9XpU8I5mw97Rv3-MtG2Gs3rJsgaQsFojv4jd31Nw&oe=6AEB4475"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXN9Ks24wPcQ7kNvwHjk1Au&_nc_oc=AdrQ4zX00DHMYayvuKaz422vV6N9FZoONqGm1VPkAGXHAuQ5ZTylUITq0Ly7AfAmSjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBuVDkZhpcJOUvaYtIH7dkRrl0BNbnQd2vJ_2MxlRZeA&oe=6AEB3823"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbdbuI6m2nkQ7kNvwH_66mO&_nc_oc=Adq--X9t3t7gA3BEjpAzHIJ3rHvDZzbg5jXey5vw4H-AQHBx5JXSZr1j4GJ3nxPyWgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA85RCjoTy641PGwWU2tpngBRrSXpokgpA90g8EEaw2A&oe=6AEB3D4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqAnupbL-k0Q7kNvwHFirkj&_nc_oc=AdqQTrYYnKXRXn_CqKWAs5Ywt_f_EXKBjOyyp58gUPN8lBlofEgBYKAn6JrPieky8xo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR99XuS7_RqB28zungzXlLRI5MaYUE4-y51Ej5phiJUNA&oe=6AEB52BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
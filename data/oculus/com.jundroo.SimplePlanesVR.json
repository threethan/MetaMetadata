64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC37bPNOl6kQ7kNvwHXaEX1&_nc_oc=AdpLUnGjKzYlRC96jTIPznFQPnzRtY_gcT5sSgpdY7FSINwPZB0sQFkXniJO3DngN74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk6-8qqP5kCoa88n34YgrBED9GZcqiyDPNC1U2R3kyOA&oe=6A79D9F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7s2bOT9wB4Q7kNvwFRTgFi&_nc_oc=Adpg65sk7C00XWUSVURqUxH2-I5qgaGLSZVkaSpN57os9QlaKZXN2rJk1G9IIvO1Wcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhtSiqt2520wtRu25iNlADI6QcNQtCi3YtbYfYpVpWSw&oe=6A79E375"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5fS6_Uh8fIQ7kNvwEbgwjB&_nc_oc=AdqsM_FVmkE0guDKsv_MK_rE9uLjB1ALkrkDBtND0vbxjQHqIgYTn9YR9P0DNYGZvWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBuQq0OSh9Iz5k_HTd1U07SSD5VwQy5sL1hSS52zh-zQ&oe=6A79D723"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUoxMgPRVagQ7kNvwGJOrq3&_nc_oc=Adpn0IWRlTINv3vwS8Z3-3UvlxiGvcDjP_WMM1DhdT8YDk8ODysFHwzDz2qnuhgnfOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3YlWgAy_lTANMVhFhXK2gv201hVGr53kHc4eiwnrcyA&oe=6A79DC4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52KUmWR75EEQ7kNvwFgXJrm&_nc_oc=AdqDeVfzpGHgsxUqy1vISzIOBi-7JfUQz58Lt0ePc7PoRVSb_Tt_0GuMy0K7hibQxSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjDPq4DRzdkvGvinsbUicTVz315uF_k5w-Vi7c4AFHGA&oe=6A79B97B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuDbJ3r83dsQ7kNvwER6mIu&_nc_oc=Adp4AJ0PXbaRptVNQqfyYLjj_MdEyba_I23--JzIuDCFeeAfqxiAko-VtLg0hdXgy78&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoNFrzsCgmKdH4UN_RYinT4d2WlE14_67FozU9O55M8Q&oe=69C53C70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmOmQ5hWCtQQ7kNvwF-K_q7&_nc_oc=AdomYGmsiwCT2_lGsOdOJjnce3xlRqgF86HAZ8TqfWlb1VI8DjhfLbd3CnSUrXi2wcU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXrPi_m97XhrNu-ndU3-8AbIDGwM-TA3yZr4M15BDx7A&oe=69C545F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=He7cHr_1GlEQ7kNvwE8P5DT&_nc_oc=Adrd4Bw77W6jiSc1cKSDdSTLuNrKKZyHnyi_-YKTuoigjzmzapYNqKkg7KgKG3GNLw8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMd8GFCyC3UiV300CRmPpcdGT2c0NODieBwJ5K7krE7g&oe=69C539A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k1ZkAEjBIcQ7kNvwFhEC0Y&_nc_oc=Adrdx5CVX5_DSvxn-5Vj9e0uS3G0yc9t9AXaRpnPGUjzWa4zMJG4_HAwwAcw1XRxheg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwllW5uqDUf4_W9ICVLV1kKkwoKNnAcfImrLU1qgPBchA&oe=69C53ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msy-G1UVJsgQ7kNvwECuPFq&_nc_oc=AdokWv-1UF36aT-C60zt0w3KScNkSKD4uzIYiGHJSAuAeXzYmaxEg4GBM3tfyQa_kxw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpankLy4CCMgrIEtbzd0MLcxUz5nxmOb4sTVxBa-x3vw&oe=69C51BFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
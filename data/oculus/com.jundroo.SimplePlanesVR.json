wEgVJmW&_nc_oc=Admq5S2joiHy-PBLhUyCY7N53YSL5pMa4VjXzFwHxr5j-AfBPIRNdbAuh3HH8Lm6UPA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuLXbvAUjGCFBLJ1rnUyfkrH2Rm6O_GD6LMIOzIN_QuCQ&oe=69A59870"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGwARQYVBywQ7kNvwHb6eKM&_nc_oc=Adme9LAVtHlS5flAhVZlDtnSwk1s1SASDBEfUn3ARAm_BFOPqCpcMymxtzsivpYxL_s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuN0b5IhtoKO1RgaNN4lIeXeviptTGB_QKv6c-kluoOaw&oe=69A569B5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRoihtr15mIQ7kNvwHSA_6u&_nc_oc=AdktlAD-HXciL7O_NI29gAPIuYr1mst03XHRq4s__1HEnKA6Iek-8-X5IL4IomRK-uY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvCuxfe31X2tJvndnXghgVEiB6n7BCU1ur0Ik2AFzl-Pg&oe=69A595A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-Wf-XJiDzgQ7kNvwGdmYKz&_nc_oc=Adlj9J6u84Rie0vd8YZswGtfOm6TGJ-8nkzIv7nzbdzQMqPJax-xpqjkLaF6Qzi7cZs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuccvCSynqNYVRI8x6f9o2rD90UQYgW56UEeUA2tHetDg&oe=69A59ACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r41tKT4Ug4gQ7kNvwGS2GkI&_nc_oc=Adn1diXLabBQtd-StIrD0_By_bvTDKTlXtHt3Xwuu7hNBDl65gQiSVoQaRsllnXVRi4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuxYr2SXxVV57wOrgT2YvZz-4CWD1uxPqZfhrY7DJ_HMQ&oe=69A577FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
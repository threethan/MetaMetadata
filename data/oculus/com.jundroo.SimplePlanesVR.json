64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tctCnFjgpkAQ7kNvwExJOc7&_nc_oc=AdrcZNvCeml3MjgmKYOTnJVTfXUF2YS9ROErRTkwr2X8i_Wf7ujg0qg6HrGPIZlMbCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cSrZ22gH8WGIDjsEq1vUstvrAi2nSePaRAS0TBN4-Hw&oe=6A3005F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HrWS4MHksEQ7kNvwEymwF7&_nc_oc=AdoudDsHi7IRoZda6wH-x0mOjbcCaf0EK7kTODWmwGgNiQz2yvRtZlEMKYG3CkSRfb8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mrCofGt9twh7yJjNwwJzBqL1IZiZebwYdnoNecN4FPQ&oe=6A300F75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUas_ghldYcQ7kNvwFxM0cu&_nc_oc=AdomOdQje77z1WPKV_t6Y4K6pA0Vq942sKNzR4VDY_i2VMPSV9tgRw5AAtUxaCGXGWY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7tWSwgRtblOKjMUjdg6WR7Nn6YsZnpLskqNNZp3Rz9w&oe=6A300323"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULQsiUiDxuUQ7kNvwEmBycs&_nc_oc=AdpihVkYnLbdQkUOj42aP0T6Cw3jtqOqeihEW3u-EuC99MLyEf_mA_wodlGFTIoKkOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84T9YF6JEVgWTBV7bn1d3Ffga9qD_g67ZyLCVFav8ZkA&oe=6A30084D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sH3TFkF3pQYQ7kNvwG95IyE&_nc_oc=Adr0kTOnQ0EPMRKG72608jx7DMUbTrG7DX71SQBS7PkFtLlJn9j9WLdvwK644TcaWoY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93GJOtOig1iT7gC9yaDx4SCLVQyIzfExCMLXM96Q_Hdg&oe=6A301DBB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
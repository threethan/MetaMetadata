64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvVQ_us8M0gQ7kNvwEi520B&_nc_oc=AdpMNOrWXfoJETqQz2V0HmsOGO0GXQ-GlV-y3Y0Ec_slOY5Etni8zJueVHHdRZi5_30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH5rZCjNCo87E0ABZR7fnlWKY1so4qJbxcm9P2Bzh5vQ&oe=6A5792F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipo3K-CYXzMQ7kNvwGsFJmr&_nc_oc=Adou1m_kXbVIho-yUQgsrfcbzxo7W3BEwy_laj3B4SXMg9O1E9zu6zBMjnCCAxJinkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw_wo2iaEGszAR4hXF4_pdEgDF_Ma9JnmrsQaw8RZn2A&oe=6A579C75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYSq994SV2oQ7kNvwGKe4bC&_nc_oc=AdpqtByoKJWw_aquirI3nTS7ZE-IPshzMTZvdEX68yI_sFLgxNCedvdYq7W4Iu_wypM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbel1MLZNkFXqcW1ri9f98mij99wrRFFcFfWZiNiLDlg&oe=6A579023"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymCt9ZZ2JtoQ7kNvwGqe01y&_nc_oc=Adpko6s_jp4CMDKLGbhg9gl975swWv45s7B3EI3OMdJPq4o93Vx5WE186f5aLVKc-0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC1acRiEcR4VY_anWZDWyzrv1VuSY3INtyhM3ZLPFw4A&oe=6A57954D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZWa2LvqtYcQ7kNvwH-p5oL&_nc_oc=AdpQ0q4sSE4k2WyemMYLPdJsTCVIBYDtLE5OeU3o7BbrkWWHurTDxquj7XJ-k0vNPkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaczTREsPCTwxEzcocB_ZsS9tSx7x0X9rVoAnv-pxmyA&oe=6A57727B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
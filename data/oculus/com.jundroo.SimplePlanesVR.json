ehJ00wfwQ7kNvwF_nI6B&_nc_oc=Adlt1HqatWd1wjdXrdDdD174_W0DBicDQ1-yUFgCsXnRKP-UTxMG6ToEzxqOWc2S0w8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs7VZ0T4gYdjCy3CNiUc0m22W7XL3ZKI8v38EJlJnq0Yg&oe=699C6775"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv-ILr4VHRQQ7kNvwE5SPwy&_nc_oc=AdltZ0aQf2BX4Eo0nOC2Rp9scwInJiTF8gOn9EPO0O_f-bjroZ1XXbahw56HuwSHUzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfudW1HGS8vS3OisgzzA55WRKGyFzw6kB62lxBMLSnx2WA&oe=699C5B23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRZwckYfCUwQ7kNvwGkb3az&_nc_oc=Adk6meNXZTm-kPHuu6is7lWaot5s-vPuu4hZepbIY0BlzBa6rmaKf_tp42QqiMEy60Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv4lqYINzQtucgGo1qKf2Z1JiXoKAvraIAN298YYVV71g&oe=699C604D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd70gDN8obYQ7kNvwGY1NoV&_nc_oc=Adnw1ElE1QT_0lhNyVaFARYjbaKOtS3HovqXP3JPnka_lc5inig1Ik1n4pEw7oYe0hI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsf6AjpOsiXJ774_hdvTHefwxJQEHsRTyxNqmzJialr3A&oe=699C3D7B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3131812133774230"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1468522388162939"}, {"status": "PUBLISH
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSVXrK59rggQ7kNvwEwe63e&_nc_oc=AdrrJH0kN6oKHFar-22JMs5R8hgBPm69kIt-LiHDhreyF2cPf_xxJFtHUsQM_8E3M9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLcBM0ueHE1RzgRTsmApX5bNXj5aa3u7QGqf_uJoF7Rg&oe=6ACCE870"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcKuOp1LT28Q7kNvwESloJW&_nc_oc=Ado315YMEqqCZb1XoDhiaMXTxijwrcaab0nIDdUcCiDTJLn4NSA7dUddF_kUulE7EAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNKyxP1wLPsekizKZbjEgr_7_vlY2kFd_NhY2U7oRTsg&oe=6ACCF1F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGPlZHtmeDMQ7kNvwFxnYm_&_nc_oc=Adr2e9C_2xmT-GablIHreB3ToZPPWAbGuBm8wBtDPPa9BmPNxTudwexQtIKdQq_-PaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2R-lJAedyTjhbLNfqz-jJH3WudXi3Wt6CzLx97LNRTQ&oe=6ACCE5A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry9CLZXvtskQ7kNvwG4cK3u&_nc_oc=Adoigr3wT6xfEdkK42Xil6PYkV6a3hszZP0Ywy2Bwctjw3YkiPNCMxnd0ro0HFC-17c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ9COx06X3bIvyjVtsPfRk7QOFj1M1WepI3QEMcljGBQ&oe=6ACCEACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWBC-t0wCbQQ7kNvwFhz08s&_nc_oc=AdppbFytfSW3Uk8tvkQkbxKORulIqf-fIJNcVjOvSYHNoevhMTZY_55cOjHsNzXg9rI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhHVHiNUOEYlZgKaI1WSPev5-anLp5fl-ZKrkgTP4QNQ&oe=6ACD003B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5CRCec7q6IQ7kNvwFHT0fg&_nc_oc=AdofxythJK3ERIm-RfIsbdTZ2DnRNR9jXzUt6Mng1ioo7Q_Y9drqwyZVa8G8K_LTw_c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e1UoWpqeyitHA2tKxpDKAuLdfQUMs-O0GFCRNi2MVeg&oe=69FDECF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRShLYk5UQoQ7kNvwEoCV1x&_nc_oc=Adq4BTf-bhmHNq63M2t0cxPXBFNIatSymAs3PHzZChA5vI1Ebf3MUFMR6K1JEoGD4sQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RVKCSq4SOOC-O_IxO9nBBIW0GfNeTeEfmZwEDXxPOlQ&oe=69FDF675"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_6lZdGFiVkQ7kNvwFVu3Id&_nc_oc=AdoTwKBFK8kSAUN2btCFAfX5B0E4ilfbe36vsE5xI2lV31rBY_OMIjyl7zcxYi0W3bs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jhutjRK1GE-ci7AQPzpDM8HO0t99Xm60-gHrhikzuAg&oe=69FDEA23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVIgAzNpHPcQ7kNvwGnFl1C&_nc_oc=AdoKLzS2GIzITCH3GmsjD1FzrYAtIbr-eI5Un2aWEsu6I8ybSEp6JDHE5Bywl2SplcQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DDEDykA-XEtDbaBdYnBGzUg1_XdE6PEG3hcaxNeLVgw&oe=69FDEF4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW_J29OjsEIQ7kNvwHpYlI1&_nc_oc=Adqs_kBSxSbDCi3JCzfNnba8qWKPaJcYvMCiwU6E57NZC2E-WLOE04EMvrSuCgGa95w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w8hJrqvd4ZcXApRS1YxLWlKEOG3JA-95MZ15b7UbN4A&oe=69FE04BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=natDk89FGK0Q7kNvwEscMlV&_nc_oc=AdqTnyrSY8MgXPWhizYS-RVM3LSBVhrHbjMv0x-EKuiZwuSaGRL5C4kUhaCyrZ2a24Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60NNpKbMRnAkO1oevbFyOlRafU8gxdxkRmNncpqz3wOQ&oe=6A0F1070"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4go_l3ccI9QQ7kNvwHS1f_t&_nc_oc=Adq74RbAl4FAxAs8WI6IGCXLGxEPmaRuCQM0yEH2Ut_t4-WP0Ov_q7srUpub8K8Z1pU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52JUhJJcCuCv185k1A4kv_9IMhygJI6WjgoXY3BUp-RA&oe=6A0F19F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBtqk1O9YVgQ7kNvwFzDKpB&_nc_oc=AdqNtkT7HJZK2sJiJf9zBm9TbkwFimmWPVCSZb_Nuki70FMhvFxTVczuUQJ4ogo0dFU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lR7LpDc1fmWSLGIOWuVwjPVL-nSxAKO8OloUA6GDgXw&oe=6A0F0DA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIR-fGj19wsQ7kNvwE27Ldm&_nc_oc=AdpMxtWorq8HlFIk2oV1nhSei8VO8rdB8SvrCr9Y_bPno6pdg2_LnAWBjmffLo4x2-w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KwAhyxIdMFDm60RVwVRt6hP-ZhxS4-kRkKaj4Jj8Niw&oe=6A0F12CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqG3poXVwssQ7kNvwE3p7Hb&_nc_oc=AdqLhR620GaxXkwm98b7j6Izf7n3IiX6z4wJ4ZYB6FpSynNH6oa05S5vniz6hX15nSQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MId2BfDGOJpUWTI_jPbxsnjgTUoXxqGLlEHCKZKzODA&oe=6A0F283B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
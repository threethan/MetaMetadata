64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAiSd1yNhBEQ7kNvwFpZPS1&_nc_oc=Adp0rRo8I-DsZq8e0CW9PiHsETJaHarU-zTBQhRb4PVXeVoR38WjvYDIXzsI1tUs5OI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECqcc3qMsLCpmMb90hwCPmp4-qADe9xWIRs_BGZnYxSA&oe=6A900B30"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAE6KbiWDWQQ7kNvwGuucib&_nc_oc=AdqrzPSUargOg4j1rWS9-ZLSy8x5k0aNCRGA6rDFIPBUFaJpJK85GFZQNtTxSah7be4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgNZ7dLKI1hVLwvWuhvG1wXSo8J5aBchoAJQj-d11UMw&oe=6A9014B5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og-8wHILKbUQ7kNvwFH5Gv3&_nc_oc=AdpROjrr41Z1XyhqKp6Mxu9lNhuI0Ck0kATibErmL2FOiR5zD8a0YjH1XI9Lnu6_UV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAG5skyFfcyTgbg_A-ZtpuzmOdH-TueEpnOX3olG4jXQ&oe=6A900863"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0oYjNPzGskQ7kNvwF7ruM7&_nc_oc=Adrfcagb-RklnkAK8K3-yeT-IoKU6ilp4Rug7n6waLWxsTj-VfJ83MSHoLZB7PcAveg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHENaPbWAK9DEwzOerM0hqiM_e7l-Hy5JnHCuJQiS-MIw&oe=6A900D8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyEosyHnbCAQ7kNvwGRTa-0&_nc_oc=AdqdS_9vLpkEjGR-veJTJVle8APXLm6VCqpWGHosLED_m444VTXDw_QKajFttnDw_jY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5zWdsMiy3LxkB8wHMNqcQpZ8vR126WHjKr7RAzXliBQ&oe=6A9022FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H233TNxlMlkQ7kNvwFqlNqq&_nc_oc=AdoBhIq_Cfhi9CVuzg88aUusYrwKtEgxWVlE3oQKNdKmmcQrhkPmpq-CawcSvRSQIDA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q31scbZGxt76VVJg9pYnTpl6TQ8L7yhU528uFjiGBnw&oe=6A1C3F70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLk6Eks7Py4Q7kNvwET3Gdm&_nc_oc=AdqPSOYR-fxdWii1UrhQ00XwX7taxpjao-nzM8OfiyB7-zff1lxzGqoAuYcG3wtEBbQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Nir-oZzfz0bJow0hystNfItoEKJ7hmwtKPFPzwtkS-Q&oe=6A1C48F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOOKNlQ4MEUQ7kNvwEeTLrc&_nc_oc=AdpmRwrIV5zcCBvvmBXTJvkxYO50Tar9KnI948zU1fweFOprQbpg1ncoAi2P087vxYk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AB1fFXOb7DmczWOKeJ23QYMGw23rSLBDNUjd30C9X_w&oe=6A1C3CA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjQ2BgFCHaAQ7kNvwEjqh7-&_nc_oc=AdqU8FKc8EKDWwkJ-A0Wkpup9vXlKwGtf2h6PqPiz5cSJ3XfkxtRSUmvbjNw-n1cVLA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aZN3_aldr98iVAQCUg2LeQT2zUVI4Bo4jyNQKUYHHMA&oe=6A1C41CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20MT4SQI_M0Q7kNvwGuFXx5&_nc_oc=Adpxy2vS9l3JTcq5VUTM9vuOLUx6VX5MsW-0XrC8ZriMW3_A9SkwulXXPrhpUuboST4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40olSWivE7v9pbGPR5hHYZWc6D9x-dRj-H9KyXrAtZNg&oe=6A1C573B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvVQ_us8M0gQ7kNvwE4Jmml&_nc_oc=AdoAVp_24KQzQ4bjkV_evtwXQytgcKRiV8BKReBde62hqLvClZi8ZMcbNVl8neCWNIM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_iPXDxdsnks2UydqD5mLFJA6vhJUjpZMxTqe4aFjZ7g&oe=6A564170"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz1sqTqgniAQ7kNvwEAngAc&_nc_oc=Adq_D20RWGQeTCQ1vwoMn7FuZ7obeTp8q2l2asTH8QEl9lfyfgH5lX673m3f2G6Nlc4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtvQY3u04Td7HpEYbet-ZU_EnDrryZKjZWe0QpR-4eCg&oe=6A564AF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYSq994SV2oQ7kNvwE9OR6U&_nc_oc=Adp1Cwjgn6BBjEcr5lVRFz8EryIXO1sx6zjnPS2xjk7FNhAQD5e4SU4fAVJW8JBxgk0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1GkrX2RfOSh0hpAn558JqPouCy25IFIeigsDeC4NFHQ&oe=6A563EA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIE4bsqxc9EQ7kNvwHJbOyE&_nc_oc=Adrn4UmUbVX69JaN-174EdPnEogIO9l5SAHR5P2MKA5Op5zJ3gSHLyQqjXv9ec3hyCc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXllVEhKVdD46eyIkyLTpj3XVZPvKGusLAUH20G9ygXw&oe=6A5643CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCWp4Cg81LMQ7kNvwFxNEoZ&_nc_oc=AdryXA2Jmyp2i8JLaV6ZUV6iQ9Eoa9nrSi-3zUyVwt0t943iC1US4puOi8NteoDM0Ws&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6yo90ZN9Ag1qpYtKnmvSBXVrv-0aNoPM3tmKaPT5TXA&oe=6A56593B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
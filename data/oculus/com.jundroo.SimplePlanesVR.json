64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qCHDHHjaMQQ7kNvwG_YznE&_nc_oc=AdrTszO6cu2zPRqg8Vit4JoNjjYkj9On7idQcOMDiEQTu5TZBjmZyFpLscJf9Oixbcs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oyo88pEHS7okJk0vUO1LN43kXno3kW7MtIjPasO5x2A&oe=6A3E8670"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6bGPF8QzmYQ7kNvwHBL_vD&_nc_oc=Adq1P7M89napECGEdne1P19aVB8dCVxmF68tbdg-nTrnIvZ_sLkyvdaPUeqMM24GDFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d-4xI2qYix3l5x4ewZZuPuH56-F-2XZwMZxPVj1oT-A&oe=6A3E8FF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VlNUPNKbusQ7kNvwEXSttO&_nc_oc=AdoBssch3xp7qklqkPtm4Kw6UAaY7y3AmAck5iDJMtEQko5gIeYfn9D4mv2bHZDy9LQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vSsjmz3t7GFIejPu3oMsYzl5bDk2Cl6TduzaFcEbRfw&oe=6A3E83A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDHnTk_DieQQ7kNvwHgG0lJ&_nc_oc=AdrwEQ_xEwxxBc98g5U8vhElfYOL6AWG1jmCXJx6Q12DPx-eCNIknnGWTRrgjFyQXds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j3caQf_jAmZeC7Gxp3iT5zveqfYJZiOpIYUgLg0xZFg&oe=6A3E88CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjoqOZUtn9cQ7kNvwErf3aN&_nc_oc=AdqrTh84P2UTB3D2EAiE6Uy5-wtn6Xd8oH4sJ-LK1sFIMDARMvAUU7GfrygxTEcf_vY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wyJDj1nVmgZTWUTbJ1IY-L_T65OVbYSF3krHJeQGDDg&oe=6A3E9E3B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
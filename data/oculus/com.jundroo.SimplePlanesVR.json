64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY7eXSPROMMQ7kNvwHK4jQz&_nc_oc=AdriZ0fjIBs5_fJNVdbJzhJQvtOY0nKFSuaJ9WON_FXVo6yVM3mevIx1G7gpo5z8SYo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96sDhi0_DU3AGcNsNxGb1nKFE-1maMR9M9MME6EcVeiQ&oe=6A26CB70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT0hV2jCkBcQ7kNvwFnxKyk&_nc_oc=AdrSY7Mr60R-HvQgNzQqqwLoFryk52ya7WuFzDIUZpzO-6b-C2t6dFbT5DuM2_93iOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nWj20HvnQ8NtbmpOtQzYothJAbeVAzHSS0MD9KQ346A&oe=6A26D4F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nebzyWlXoBQQ7kNvwGpz7XF&_nc_oc=AdrtItXxGFKjBPcICfrTpFSQhXpYG2U_IAhWCUaRKcrL2qcKQSwmJQ68IhIxzgzG_Pc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T85_bAkJrqAa5lHQ9uthVIdeDFcaTKM3Imi7DAZhdWA&oe=6A26C8A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGPy3Xqe4bcQ7kNvwEdFQaO&_nc_oc=AdqcSQ_0jo8M2LWH5iZSb0l6YMSuyDX4mVPsTxFk8XpTpC3Z8_YDc9zy80IirUPUoQY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IFUL2Bhhy97q1gRYsJ9KHQFM_GI6LaCTYZ8wTxJd_iA&oe=6A26CDCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgv1KyiJ9e8Q7kNvwFPxgen&_nc_oc=AdoHL4w1TRZPk89ppU7Yr-40-PcJrNhIw5IF3ue7dz4h_6LaIYrWJlL6kz6jkHYJQM0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dzFpfA8rTR75bwS1Ks32WRyG1gYbzNoXhDvt4-SPojw&oe=6A26E33B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
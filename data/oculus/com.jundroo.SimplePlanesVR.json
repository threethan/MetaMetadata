64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5CRCec7q6IQ7kNvwEiQE_o&_nc_oc=AdrScsVHP2C9JSQupB6NhhGg4PAx4cBrESI2zQP3KBLbRz_IDVQA_Em_PwaS6vmrnRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JmUM8YRftoBAZCDvfqE2fv6L9RNv86ZOun0kaiiUlvw&oe=6A008FF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnQZgSu6zPwQ7kNvwHpSD1v&_nc_oc=AdqTq9bcZ-PO5jsWWkNn0WbeilOfw6jK5FFTz_v_E1_A_hfUxZHEtb-1Bs8FTs3SFA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QOPXYm-9yqRE3qz2FulASXaHR-rILnrgcpMWFGCSoNw&oe=6A009975"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Am2FwzWa2twQ7kNvwGWK-7z&_nc_oc=AdrMtftgeuUfR89hgoIN5qu0kqIEVAes0Ehh1BQ9pU6RkRWx8sngDGgyc4LxK9Ot0r4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qP9BzQprAdm_wiqVnoy6hAXpr5HAVApdRTjo9pGSoUA&oe=6A008D23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w0Nwsmyz0YQ7kNvwFFGo8S&_nc_oc=AdpCZ7fLP8s9qm6FkabIENmtzId-XarD_pWUz205vXK1uNVLPRUzo6RPiEyS18QDsMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wc0UES5UzK7P1eIR9sEWD_EDvvtHJVglZUYtKHvM_Yg&oe=6A00924D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh6IIvaEd6MQ7kNvwHKd1Yh&_nc_oc=Adp5bTVQUwt4qLnwZBn87KZUYGOiLx6jpPVPfHeExttyx4TByPI5NGi5H_sqYqfY2-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LY0bmFgorFP56d-xTap3TGhaRCmQcE0EALV4ed6kWnQ&oe=6A006F7B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
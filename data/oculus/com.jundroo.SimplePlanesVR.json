64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwncfUtuO2QQ7kNvwH97Yz6&_nc_oc=AdoHkr_YIXpFRmKEf8nf4tMOytQdjAEI6t8T2AWG0Kbl8Ico_HH8AVGwmIZYFGORIWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HiA2PX9MTrQMDfwJHav2VHHBZxEUnNPTErwTTIG6j0g&oe=69FB49F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZwuoz56d5YQ7kNvwEVLvlR&_nc_oc=AdqNhBgzQ5uyb5yYXQl8NUbw7d0hA-oBte0aORXaSt-qP249yuVj50Md6xzaa6NKvdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pLnQ5_03Df1DgyoKjngjHZm_P_8GITazzlD5SlQTaOQ&oe=69FB5375"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_6lZdGFiVkQ7kNvwGSfvhT&_nc_oc=AdqR8gMe-MCYtYMgXnHPTkBigPu_sD6Mc9-rOJsJZEaxXv3VnuY3CMTEwmkgdKndMQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HpgeGeNtKkoqxwzGFoGADPnad8PfxSamGA7hxleMSIg&oe=69FB4723"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZllzWi5G8-wQ7kNvwERKnIC&_nc_oc=AdqVKU7ScNr5Z8zLr3aQE40w63OO-ojqr_nV1E5jwD-av_ECYlo2P4BdMU77XBwRxMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hcPQJ0LBLk-zjjwY_4mU8g9JN1hLAwvnsWl2nB5F31g&oe=69FB4C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAEy8sYWbmEQ7kNvwHogdbU&_nc_oc=Adpki8TfTlmTJJssExLDuGbcOp9OVrtI81FSHKJLSE-v4Imd4U7pKtIVsxSX8lqM43U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VV65p1ukq34YpCaXxk5hDUfHDi4WIxWNkxQaU039arA&oe=69FB297B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
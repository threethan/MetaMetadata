64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqMqoEeYaccQ7kNvwEU9p_v&_nc_oc=AdqYQ4w8Ym6iyigo6pecl6GEdQPjU_ikmPqMn4WN5l6XwTVlwIxPsFsvOQk4hQZ66ac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVLon1eTyNLEat3Xp3gm9De2OeFebdp8JPJ4W8Il6chg&oe=6A8AC530"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq_x6eCaopIQ7kNvwGQH1fg&_nc_oc=Adoo6JXLEz_Vlc4KHFSW-RZ_vR1r7IK-SJEw1LB8Npp4F_fU6cuNEdEhZAsB0jbGApU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4nBrYbeBW6aJ6o-S8bLCgLzyyoUZlZ6bTdNlX0MZ06Q&oe=6A8ACEB5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTiNFUU1SfoQ7kNvwFpgxDx&_nc_oc=AdqwDTpad9ZU_KGE-bgldb2ZcrLrhkISkr1yCla_mtavXZygN3BpeX4xGBH7XE1b75c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH090ZcRejIvL62vSpzA29lbK9tsevmnEhJyngAxyuI5Q&oe=6A8AC263"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwkxzJ1nNHYQ7kNvwFnpzTk&_nc_oc=Adpl4tROVKhf26rhgUmZRqPta1VNPHJXybL87wibSpg62NUQzzjEuM3-ccGD82b0Ebs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4LPdWwwLJq-iawqoEhPPkQBs63tj91_maT3LFUvctqQ&oe=6A8AC78D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5WMGzpftYMQ7kNvwGCfxut&_nc_oc=Ado6Knt2vvVa32CJfyGIZi-8jJ4iq13vrzktjgghdSwpcIYb_k1qOz4lCYSGwKiBtvY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRCpK4LlT0FwZOQEGvHzcaCgtbzTCQVjOA1Pf4VMr_iw&oe=6A8ADCFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXbrr7_gFIQ7kNvwH0_zL0&_nc_oc=AdqRWYJUM_UNuG3D7IFi7ibmtTYMp4qgmyYpUThuIQxfM5SZsdWZeDURLPZQ4grB_do&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X4piB6FPmh2ZbzUOYGVjLFPTAcm90EI-ugJfgELIyNg&oe=6A32A8F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HrWS4MHksEQ7kNvwHW-eaV&_nc_oc=Adp3S0j5lv7WftJq28GNr9ULwFXqUiqgPQ5p_fiMJCO-BdLno-gJHP-GbGWa8ZwPuCw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mro1BV_Rcn15Dr1ejJDiVJQw1m6MScxP9X_Kwq2meTA&oe=6A32B275"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duqjqdC84cUQ7kNvwHnb8_q&_nc_oc=AdrbvtM3Z0Yr1g7FumJ1Rj14GH_sl1zzM0WZ23apGQC7iNYAuIDK9zFw2GIzuHe-SUI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Tlju-S4w3yPZnM7G4j4Ml4AV3wnQ0MZqqBM8mNTOfKw&oe=6A32A623"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULQsiUiDxuUQ7kNvwGkEIZz&_nc_oc=AdoQOKqkU1Ms1iFrL09iAtkaTN6G4w7_UCd7AkH3GfIsanY9uLzFMjPSqqDAlmbVEKs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lh1gGiVQjRfBThz7Rqc3obJpocR2s7nndSqw7HkiJmA&oe=6A32AB4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sH3TFkF3pQYQ7kNvwE_C7GT&_nc_oc=Adr34r0n-1LGxwtwKTDbXhWzYYk-SH61VkBdjyFOZkdhnZ6JO5asisMX5L1w8cPtJlM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1PVmtauiaFnDHE7vPNH5sClmmHe-4DDNgwnj7qWnn3g&oe=6A32C0BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
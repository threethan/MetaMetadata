64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj7UbAo9R-MQ7kNvwEyYu5r&_nc_oc=AdovcNw-IN7eAr64Q0OutfMCc6hpDPZpiqRE4oOYSaRyjqiap4apOUPfMoCTudbMIS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiuCb6zS0_ju0HV_VDI3GPC3CsXFxQx5wYvnJ8NMTMFg&oe=6AAAA170"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm2Qxr01DusQ7kNvwGZPeap&_nc_oc=AdorTgIQh_bjKKLv5uy1fGUDOEy0iK0NgeSAIoetzpqzxZsqQYrvUCADVfYKveJG7aM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEg0Z2jd7eKrnEtcf9XFM7b2CakXtOwYSgumFyjzWuEQ&oe=6AAAAAF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXqNnqzIORAQ7kNvwGs0q0b&_nc_oc=AdqQ5efHRDA627tPJkLDiHMLY3Zh-ZXBYTw3k_Ex9XMHi-rOGfW4Vquo_o1EvQISCy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu90gQhElIh00fHeVw0_rE317usw_8-jll64Vasnp-kA&oe=6AAA9EA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ32Wd5PFC4Q7kNvwEs73iJ&_nc_oc=AdpT11XXn3s0QPZAI5aQo2zFcSMCYp3sS_cLy3aTHcOexYIZMQ6HyXqEyZPMqJWimvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjChEQ9-r1o8NH19fYP5nZoz6a3dAXiliKE9-HtKafVg&oe=6AAAA3CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeIVLI3U0MEQ7kNvwEdrnt7&_nc_oc=Adrhu1FTdfDABtQf37aUBFt1t6FhmToQ8L3YfWrwHe125ngWzHDbwJZaCjG1tp1Disk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJp2YhOZAQ2YpUwRaHBFgD4682zGzGY8-nfWYgT-T1Ew&oe=6AAAB93B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr1aObd9FwcQ7kNvwFlkbJC&_nc_oc=AdqMbeQNJb2VmrocruYnA8i_VYV0e_HLIgdPDFIbgLak-DK_nFxFhkE6e0iiDKwv2Ng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3s6rYJ3rVe1T8n_FntNCAROQ_vL05QfW-1Vr_dVSXVg&oe=6AEF67B0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xad9zJakCTkQ7kNvwHUp-bP&_nc_oc=AdojKqAkTdQWmBl92sP77aG8QeE5S0cdpJjjSiar29hVHqJYNq_fNPJp584xhX0FHtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpFMmCfCBfxOkpw3450UanvtqNLwZAIn5XqOCKETzS7w&oe=6AEF38F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLV73Pn7yPYQ7kNvwGbeYGu&_nc_oc=AdpZE4rm7iyXfrx6ndxODNPZPCbG3-eBPBy3UcCL9F5UkMUjfwsmt16fJg6A8VaFb0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRZRzBIVLWU2Qwts6qYUfp_idwb7tf_jWannQShG3DUA&oe=6AEF64E3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXl5kvHr1jAQ7kNvwEUVa7i&_nc_oc=Adq1s4JoOLTdQNBbm_1OvO_MWKmDMkz_7jgPYAe4jwjAvxDyOFbtz13QtshKLPGJPNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl-YEdGCB1i6HTZe-WJ9xLmmTf0Sd9W6iNorQ_G5EGEw&oe=6AEF31CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOUI9IqCpYMQ7kNvwGSqxeU&_nc_oc=Adp1pXBlA86DUtbYF6jf8fE3OtfV4a6Md3z0L424giUYeCEgQ5B2k01k2bMqwN8R3VY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPqToJcPLz8QVfNJqGRMxThBgr5ew89Is-7uRWpNy-HQ&oe=6AEF473B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
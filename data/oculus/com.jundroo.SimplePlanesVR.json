64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwncfUtuO2QQ7kNvwFsCFf6&_nc_oc=Adr_kOuNl5pZIDDdhwJmbMih5RduEPG4mEHZo0Ip4lzFQRhW39rX_gDLYbLHBuJCiuw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gZ4Wlef85v0xmGT9XE3UTVUDRkUeZ8f9H3TeV0IbBSQ&oe=69F9F870"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZwuoz56d5YQ7kNvwEEeGB6&_nc_oc=AdpyxTsq-Qq7c4w_wNMlg_7SjKQ3tZSnNipl4IgYRfr6xmLacHV9XLK6sUd-1noflB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tl4Wt01d22b9BdmA5b0j-Mq9oY3hhwZolhhwJp-2A0g&oe=69FA01F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sElac-bDa-AQ7kNvwHcGVvO&_nc_oc=AdrXUG3aP96n6_3fpl6tLdho1jKMlFR_s4OYchpo-f-vuU-PWA0SLz25t8B41Qomd2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lRS3vHWJEwcK9vb7ThIwbBVzhB2KCnq6SIKhlkeckDg&oe=69F9F5A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZllzWi5G8-wQ7kNvwGar9LY&_nc_oc=AdqEuJX6LmA1F0DBtSqxLAU3UlWpvxAKOa9DuXAVWaCmzg_4Qmcq5S05u9w98BFEayQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SB5kXfiShjEaNGyDIET7gd5xKsB37Rp8_d8x2H-XXrw&oe=69F9FACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAEy8sYWbmEQ7kNvwGhzBRm&_nc_oc=Adpw-MtxBCr4FBYvDvG5PIL-DT-2zBqcWZjU1u9bt02cmHlgz5pEKG8OmLl64BqyqQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dwkp1GIV5msxzzpyLbJ7hYk7lvZYXJSrjb6PA5vx-oA&oe=69FA103B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fV-GLE5crLkQ7kNvwHrlcZk&_nc_oc=AdrFlAMkUhGdyIGK5BOgn0zF6UDJhQ3kJcZ3Q4PuvXDl6q2s3uMHNe6Ud9TFPwYjqNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnuSKXlRaXQoIWkfMwRHyBzfB5kPUU4qwwh2I_6HY72g&oe=6ACF8B70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86vPd3kbUvUQ7kNvwFUVbDO&_nc_oc=AdqHTOP1dRjFXb3roMil_LLTgh7wAzFOzcRGAUjnbnIlzffziFHdW8b0k0VJW5kr18U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPneWAqX6BZYstkXjPpVh0DC0AJfnVDTuCEHdZN4nbLEQ&oe=6ACF94F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGPlZHtmeDMQ7kNvwHxTSFR&_nc_oc=AdpC20PbEaabq_hQiFUPHwTJJa10hAh3ktx5TED_6L_T2iILhbQCYGV8SY5k3WiIXRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_xlHXBXpFquex3g5tRo90WtaYGv-wTsh94qh73roRww&oe=6ACF88A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGvokVF5cSsQ7kNvwG-vpU_&_nc_oc=Adr6E3IAXON7jxhHKYjih89sdew8FYy0CyJBlMylM7dpwBgzEursGkwKUOyirN8drac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkQZ1wTVG2vhaBYOUWq-7LnELE9jV0kycKK585-ebr_w&oe=6ACF8DCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txx6vGMjzgMQ7kNvwGUn6XU&_nc_oc=Ado_5b2iFNGwNp5qkIBvy-cFtx1WRyi6W1kjOc9Kp_ciq0TNkdYxtzDAEAkwpH4ezxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxV9ZMX544GmkLQFlcekaCspkLou4sMEnSEI18c-CcCg&oe=6ACFA33B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
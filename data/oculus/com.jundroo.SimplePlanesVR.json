64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RknIsrCRHnYQ7kNvwE3hIsg&_nc_oc=AdrKD5GWCa67sKahw9GgmdgNGUYUYsM8jz7rPE7Jesv81zaQGau8k68brPJ-W2-9MEA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31Kn6EYYqte_rXePJazKN8wU_kO7arYpFnaVfEBggAxw&oe=69EF6C70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkOw1RRqY7EQ7kNvwF052Jx&_nc_oc=AdrmHvPOLGwuPy_E10ricu9GvNedloZzZIBQ5lpBZAsrcqUdXZLeU-sbx7Wxl4m-Ce8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t5qY1BS_7Y8V_zC1M31_UcTW-AHptAmv46qNNSJgxWA&oe=69EF75F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnlQpN1_aPsQ7kNvwH-ySsE&_nc_oc=AdoXY7rc4qG8fxoCKiZjLmIOuaw-fFQy00dzisdcEbf2VsHYU9fIKZvtsC_Ef29prFs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0b7wZuQWkh_N_E17QVygi6nIsLTVAazcIm0IXWyFaJNg&oe=69EF69A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-OnLjh9TC0Q7kNvwFeUsRb&_nc_oc=Adpk3cWNetjsxery_Kgm-SSivvRjLcrp4saL9f4Uvqn1Jvox0yI2c0S_c1XduIWZZMA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1d8WtaKzV8tJgfw8V-oNMjJxFSX7n91TiC4j-a4uQBsQ&oe=69EF6ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSlhhNxOEj8Q7kNvwGhhzmb&_nc_oc=Ado3ZPkBx14W4QHVZg4AEVZlH4SO0EXV8d-2p7_kLD7JLFQ1rhGSa_rQNHflO7jpGRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2F0cSKRPvn8sHzTwKeRiGYPLPCOPtndUC8Glwr_B5QuA&oe=69EF4BFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
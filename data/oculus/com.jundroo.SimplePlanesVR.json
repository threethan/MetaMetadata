wHhJ7om&_nc_oc=AdkJYaqGzLgGKdPUUVZiVqymPTaI5ek9HsfmeK38wxGR3-6DGrtSWNBTVxCR5YMRInY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttIsCUwik_yO9x1q5IAs5Hk4byh95MHXMlYiCpiCYeEg&oe=69A05270"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JYFiCFWY3cQ7kNvwH7WY8I&_nc_oc=Adn8gHA1Rl7Zm6X_WKhEZ0wA-fYFVojH7kmfaolxsCVAhhWID4aXs64OBD6WFCdAfkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCIGqSLfpjfdq__5vX0qNZWGDAJ5cdPiMhcRCZj_7bLg&oe=69A05BF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzV67CCQwKgQ7kNvwEb4c7z&_nc_oc=AdnDNuxu16UlSv7Fxo6ROeC4SHjs7DtP61MZinYOEfI5gmfLd38FTUXKYKASLpq_8j8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMiI1U4_CMR-CudMFle_4r22DAg7vKd2N08M-7yil_qQ&oe=69A04FA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DZO2kRF_QUQ7kNvwEE_jER&_nc_oc=AdnWpbi6RC9YcgL-2wUIqjbPwZ2CVZ0XpSSqz_9-sjVOfeOk91c-xjpFIOj4qxBOvuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuGJ1rqiaKFzwZLVa7tOc7qavwwI6YQnuGBGFM37g7sQ&oe=69A054CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu9nPLSmyHkQ7kNvwGtdskJ&_nc_oc=AdmzaBQoPeVrcJgg7WkLbP5gWZTplwvHUd4Vi5zalZ6FyrHChl6eqP4LLzOcoJkFwgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDcYDnOqnYWjgI3lx0ML6OxqahUs-hLE-xnY-mdsQaMA&oe=69A031FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
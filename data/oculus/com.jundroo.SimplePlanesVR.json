64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cOMtLpmfYcQ7kNvwF_V-RF&_nc_oc=AdqtMT8xBqZoNsBvnF-fkhUax1dyrJRHn_9mzIVGtAMHiMHXnGWjp9OVzfO3PvKbkPQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFygaXsBRziHJgpNWijEphnZtKVrw3hscSS5SevndkyAg&oe=6A81C2F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoSRl3wksgoQ7kNvwE7dS2b&_nc_oc=AdoagfD5TKmsmwdY-C7GGv8qtywGbR54Qhtw7F1iFbr0gLWwgT8VDoqQjGbIuv1sxwc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi-k50WUHr_px11y8pltrLIv9TK-1M8nhJamIzk69VgA&oe=6A819435"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yG6moNy2-8Q7kNvwEC2azY&_nc_oc=AdoqOf0EwrNmylmAQZuYi35LFrge2I1mc22oidP3Jk1cIV903LddRRkEUE2G65guh6k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGugYMEC5eZgvzeaue7dUny3ksSWES5H-FV3sIcbQBkCA&oe=6A81C023"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHIiSB_Kry4Q7kNvwGJfvD7&_nc_oc=Adp1vtnPK51RTe0FXnKYQCyTUrsz1wvMMItFQkJEDrsSkcRj98WzBaikA5-Ax8IC3Dc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKwLmGIyTf9nbVyfssqp76rH-Qfm2ol3hBm_KQI05Bkw&oe=6A81C54D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyOMl4kMfS8Q7kNvwEAACYg&_nc_oc=AdrDP3j8wt1Nqs4TF2nDYPTD-8NL14U4LSZ8_IMCc4Kh0GG28Ne-dx5vjpyYpTdTdeo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2eCzmLsBmP7fFSuiCSYeVGBEOLQQYDHT9ZvZo0jijbQ&oe=6A81A27B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_5hE1Yty8MQ7kNvwEiOMpO&_nc_oc=AdkizhR5DwZnDzqbmtUaQnWewUMnhnaKW2m1DHbZoL4D6qKtdPd8agqD0-_jstfYbNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuO5smAbbUJsIG9eEDRyTTj8xG6bJM8Q9JS09oIDrDNLg&oe=69A98CF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHxuVkRJ9C8Q7kNvwH_LFNF&_nc_oc=Adn-nC5iRjieYex0QtLEV3MvlJYsG7sWbbySyZfflcsx8or3vrTAQvAWUXsjqjJR4rE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvLpe4P51z9xVvsp25R5Zc19j2wHp3_selCXffniMaMtA&oe=69A99675"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9sLx2s0rQYQ7kNvwH5DP6n&_nc_oc=AdlA4vpxkXxIeqLob0x9L0yevjRyUxYJYP9T8x6YPkl1564xz9T-C65IqsvIWSn3kJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftfOLSUPeYzbd0A14TNwUOXxmrh7jqTUC6KST6Ns5Tzzg&oe=69A98A23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEDjEvp9uRMQ7kNvwFj8Lsd&_nc_oc=Adl-IBjpuqh26O-3gzvxld7QnEJghEU06niMaiIsbZZzpaGGxekd-wKExbAlK0lcvH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvkJ63jz7UpA4zWMYQXFhtv-T_L1EAARO2pTfHEM5yXZQ&oe=69A98F4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKcGO369WcgQ7kNvwGGqsAo&_nc_oc=Adm_aWPN7JHbOi3I9hiqXgFLODB38d7mpkzWQGs3CuKgYirEIM3wGYcct7OlS2efsW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv4KN9GcU3YgYmsP_rUubnZpUI8gNKNQuwQn5NXSsHZBg&oe=69A96C7B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "g
wEmLFW2&_nc_oc=AdmD7jq-2MQ0xgYm7J8QuAlh5Z4KWU2OY3MRPPnSs_X9zcBiGv209w7ZY9NyM3MOasw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuXpZ4bCVVtDW0EUB71DcvbGQ2Qz7dkmFWJtDuGjvELqQ&oe=699B0C70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdLehJ00wfwQ7kNvwFIs6_n&_nc_oc=Adn8gU38_0JN_ORpQARrRBgHiR0NjV8UPZeUl3Jc8yVXtOJLJLZoAf5_ACw3_y-80mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvNJSywYv1QdJdWOZ73Z5kXEzOw9_v4HE90-mTFLel2PQ&oe=699B15F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGAsCvhq7UAQ7kNvwFKkTy_&_nc_oc=AdlpcIfZ-fPE4HyE-KN0yQPvvVnI-3LXwtU4aO0OQ60vXwoZJjxZF-tkPArrzKF1B0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs8WcImAHi-ldgQpqgMKZdNChc1nBCkfKFZ6Tq5GGP5zQ&oe=699B09A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRZwckYfCUwQ7kNvwGSeQmP&_nc_oc=AdluhJESt0yOOStFX8Tce2vZc7HuckiLSB5DrbLRU9MKr5qdAo2w0bGN4zcK3BvSwjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu14WTW7cWGbTHJN96zNbDznKxFsRKkw8LTEil2LMc6Gg&oe=699B0ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd70gDN8obYQ7kNvwF4tjgK&_nc_oc=Adn05Hhw9JLHsQEvHJz1rz7KfmrYmdeQvR0pbsnZcU2f8beg1GAYdqL0qU_EneihGrI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvyCh9QdVlGYPMk_T03Nx9WRU81Q5FSoiFtpAzV5MaU5Q&oe=699AEBFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
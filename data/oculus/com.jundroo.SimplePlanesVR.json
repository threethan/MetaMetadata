6880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQqklkUsudAQ7kNvwEli59L&_nc_oc=AdmEvolNNyAm0tB511E1ugmS3f-TnHTHkE7o5FqBImKypuJrM4eUJostHFvUPTFg1og&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRrIjo_teXtXR6tqp0mTp1QgBqCtdsck--YlqAaI6aHA&oe=69AADE70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHxuVkRJ9C8Q7kNvwFYcEUW&_nc_oc=AdnTZ5vKNGdrHLyTDfQpcXlZ-BJxgDLH2SKquJpPyEiz2O-DhET2lElg3RajaguFZA8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBgcLI1YRkyYZwy6pD3TZJyzf3fgtyF_Xq1R17xoLn3Q&oe=69AAAFB5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9sLx2s0rQYQ7kNvwGeAPQn&_nc_oc=AdmsyIviiGCY23oTeBReFiyJtMbBvwinNWb6_Shb4RvXA_jjjZlraG2FmVJGdB8PtN8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxiAw3fub_fFgTpoava9rnQLgv3a8jvf7tP1xr_BGJz8A&oe=69AADBA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEDjEvp9uRMQ7kNvwHtk6vD&_nc_oc=AdnRKvRkbGlQBBslDfqMr8tu5AkbFUSWswbzbd4K8NaG0xUXNZfhPD_z8xz7_NhM0vM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzktE9qzY5NG1NAeUSFe3TEX04Nxb5unfMSVlzKZLy6wA&oe=69AAE0CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKcGO369WcgQ7kNvwF7FnFj&_nc_oc=AdmmPtO6Qvv2C-hI9j9elV6XayExcHGEWf0TsfWdv9D2UUDl42R5ZU8QOz7_cNpNf_k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxfKtOTrEsKQ5uwAOvrpZ2kK70f74QKns3Qd8DVqBAU4A&oe=69AABDFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRE
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rThcr8KcBfsQ7kNvwHCcqSS&_nc_oc=Ado19AmhvLnbgilt7bFz5wIu9WO2mGpvYXcXT_1qNi1RB02TBsSg5AfrdNqR2305jDs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rsaq0CSzmjYxSqPSQCh_sFuZ7tH-lWDh86p3ymNNS2Q&oe=6A1304F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdSOfChRoroQ7kNvwHSwTrZ&_nc_oc=AdqmZmSI7n4GvPBWQe0A8HheZiQKsFGGjjPKQUv8vyMnXfklGnfzjvznRVemRNNT2qA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uEjSLXofrEDql7jD-hD9AUitz8_lU5jIFtEwe0Z95jw&oe=6A130E75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG47cWXLnvUQ7kNvwExagXC&_nc_oc=Adr3Q9SVTVRy8aRNfM355bE1sIfsPuXrKkFcXvyL274lA_FODQhB9VjKuIfHnS43LsM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BrMETRgKtprxNhlgy_7KnnMvdlT3seCN07BLbJMpMJA&oe=6A130223"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLNBhQOdXjUQ7kNvwErqJs4&_nc_oc=Adp_efZKXX3uxdJtW_NVUPl5emIWPoskzCeZ_rXRLp1uRKapWMIio6yuCayZWiS6Bsk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jiqzIsvwT13M4dtspOjxGkAxe-jTAZkxZClYjKYoMoQ&oe=6A13074D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zUgtiLL_nwQ7kNvwG9X8-g&_nc_oc=AdqTsHF22MfChhBejzFo9pDleYEpdBlhf4aGuBjTdVQHClnMlzwyBQxuxNWRKB5NlSE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ort3yBqJ_i4tGgIIzH-cMeYWS0pdKxv4BVCCALuuiRg&oe=6A131CBB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
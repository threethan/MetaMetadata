64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esw7i8hWwCAQ7kNvwF5mmYl&_nc_oc=Ado2WAJExJKBnNBeLdRFpO0Rr8bfkzq8Y1xmglrA6ln7jufmnJJTHIDQ7pZ246lrobI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BxNJkJc0_IeHqdi7s9j1rh7azrzKPNBr9_sOTBOtZ1A&oe=6A37EEF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuVRRxwfmZkQ7kNvwH39_Xa&_nc_oc=AdpvtDU7GH-ylyEqiR4-cD3vnsztu6NbCBB5WxeMG4XARKy34P_Eg2W5pYDchV1ED9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dzOlthL2ZvpJsdqz324b9tgHyNuxfiUPvmt3AKvHFdw&oe=6A37F875"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNEO0dpqVcsQ7kNvwGuDPfG&_nc_oc=Adrgp1hzXkB-HQ0y3GG4gLgch-rArfSzCHCYhlirC4GsrKKHCKhDek31YqAHQACU-l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8acGXSf53HHGqMaQEP6mZ3066Op9i6xQ7URDyxjuUPkQ&oe=6A37EC23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4sQrF7vlQoQ7kNvwHAlfAO&_nc_oc=AdpyUl5CJCJZwxy8m8FCXXGhgEXQqyCsTzvzbTDM902V5IPovAEoOkafYnpF3jwQyKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SZhyOJP8NXavLPEr05FZ0fsefAwY46GgWA7Xk6rN9Dg&oe=6A37F14D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrh6t3Hl4k8Q7kNvwFSORX-&_nc_oc=Adpueyy0sEnsaWbqABLxdPlBfS440tVPRUGptmsx5TbDlTHmIDYnXeZSlrlJMmDQNsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IJ_st7tqDC558gWc_8PLSEfkEa0hs0QiFZNCDyQMqUw&oe=6A3806BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
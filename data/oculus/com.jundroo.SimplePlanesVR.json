64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKHgeLF4eXsQ7kNvwHD6oqB&_nc_oc=AdpZ3ZlFpnQEVVWB2IbAMe9YOmMEFE11ef2bwL0kfJWuh5yvWyF1y_YEjEpxv-gLvek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRUChW6GceFvZOSturvIvlEej6xh2_Rdv7HRlZjZx-3w&oe=6A6B5970"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXIeB7VxfZkQ7kNvwEUaov8&_nc_oc=Adph8c9aab86kebb7ML7YD8H4MzpJXrb7mcHaP1bTS9_GexDPQ88O2_2odqNJmImLyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX4F56DffGbehVPhOkKw4w7tOlkQ9q-oaF-EQgxaiqcQ&oe=6A6B62F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jt8FI8GRuN0Q7kNvwFydsGv&_nc_oc=Adrt1FGcUR4FukFZ4KpgFqsvzGRxaiKeMHXY7vN-02MJD_gtoF_xYG0zqXu5iO06Gzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKBzilxO_Z1Qj9VduFp6nTS2idX9STRvPdtFaCGYhXGw&oe=6A6B56A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdDT1x2oWpAQ7kNvwFXWe7N&_nc_oc=AdpmJLcLGHA_FLeHrCUrkHn7-Skul4wpTPswQj5zDUBLOh5ba4rRhMtZuHUe90V00zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADcIA7saOTzDcflOnnJd6IpWSVnmjzFtLBUOnXbVsjxA&oe=6A6B5BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3mkwVvyDEUQ7kNvwH03MI7&_nc_oc=Adrxbzn-kC-WZWV8g22fJJGno5xyxt8dC6i18tPuu1Hbn2_yORPxAo3vKKDnn6L1wj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALHPHzB9p_caoBpy2oEs2v1KH1ZA20gaK1_ID57HNd4Q&oe=6A6B38FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
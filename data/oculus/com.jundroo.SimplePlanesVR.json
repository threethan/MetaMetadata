wHqyOAE&_nc_oc=AdmZFzILET8pya-_8JI5f5BLX0xtFRVfKXdxpaX0viElZ8qL0YUFZRkg0glsqDdaiFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMOtahAgQYDtOYFTyDEDEN7F_Gpxo6xua90zjtGzRRoQ&oe=69A446F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWyhpeDNBnwQ7kNvwHPedQA&_nc_oc=AdnWfEUuB0QxgAxg55anT8_3PhoWlt6oTWlF-hiOWTqbXQD3RxBLEbEsIYUFczNI3-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfurfgQ5JFRUtuXRC92tNhBxe2Ghn6uZjoNBNhYoIeBYSw&oe=69A41835"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRoihtr15mIQ7kNvwHogGBX&_nc_oc=AdkBkJ2unq0Y7s78naeIJhm5zt5Rr4CjwY4tKXuZ79CvzCZ_pChClqiBxC6sTdS_McI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0jjahP4wjTThc06_-Qtn309yfItv3THfDx5xK7rhV9w&oe=69A44423"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSkX5KiGNUMQ7kNvwHYDqQj&_nc_oc=Adlx2O0KI-hW_3dp-Ws107iiHPyOKbcnYRMz-63P2NjqMOsejqIFxpYriloOWTynVs8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvsx_IQLHq8UGwXk-cSXJgaxs_lXA8SwisW33n48qqyeA&oe=69A4494D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPL_aioItX8Q7kNvwGw6XIg&_nc_oc=AdkEJDqdQT7lfPcjkKb8efPhR_8fvWNZuvMtEIgrJ2n_8DMkLg9iwDCPa668rZbO2ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsdTqypyGhl7VuE77j4uGTacXBN6n1Au8ooVkZen7ULdA&oe=69A4267B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
974864_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0sIXYxvMzUQ7kNvwFd1U4D&_nc_oc=AdqnrbCqNDxNOtwQzmOJEtUjfGULWFCOFsa4QCegHwgMZZBgnarCsYOvbsv8e-UsnN8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_sXuKFi4scsmyxw9dc4zKwz4CQ6bXntcGEfgQCBI8vQ&oe=6A7DCE70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ3PvsPix3oQ7kNvwEKW9NB&_nc_oc=AdrHnHp04R8vZ9vmhvvPk-c01OTEGbRK4VsXpdEJq0JChdDz0WzgBjJGXwCWXR9V-C0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH45oZt-hVgaF9vp15Gi6N09mIg5Q9hkLQZ2uSLaY1ing&oe=6A7D9FB5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsP6UMmG9TUQ7kNvwGAch0L&_nc_oc=AdpGlLZec01_gWteBhuh3c5InDNOsYNVRE8qBlrXrZUJWw08tNMqg9vpikzI7o041a0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa-fpVWEN4mwRquRhnT89ETv79xfxpcTB6C3EkSJBrDA&oe=6A7DCBA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5DqFXCSr3IQ7kNvwFd_ZKt&_nc_oc=Ado0z8X8WTFdgpfttknNxYcm4xGhaA4mqImQ5TA6VWZU8MfKgaKnlYTlRbwuNHxFBYk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTxYstaPDwY10Xr0d4K-HCF5Fe04fsPMnWz_sYn8W1bw&oe=6A7D988D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l47aRubNyxcQ7kNvwHNm6Uh&_nc_oc=Adpm4PYz9hCiW_9rfbN-I7UCS-G7I_K06b5ys9O71A9kUrK_u6Fp6w091Y2xiGWVmSs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMBqyymvC4g3xUBwDTpU_mjB_trCE12BwE_pdTzDXE3A&oe=6A7DADFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881
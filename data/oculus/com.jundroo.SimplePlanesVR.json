wGA5Yew&_nc_oc=Adls8jtErFhSMtbYz_9ywiOQqppnFQ4aZCYWRD1gVE5oXHYSzakvaI236JpKmVLKvK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvgtHzxQRpd7dTmZ2VLSaieaGOUWCk1BoNlaNIxw291ug&oe=69986970"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STFPwBuds3AQ7kNvwG6iQzi&_nc_oc=AdlGU7w_lwCukdm_7mB91KMjGq4vY3eHr0FL1elZbVuRcq5ZPRsT96JXeJE0sq1J6lA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft-zVC8oWkMTswidATnJa-y_dOIc50PRImWtS1uSNxl2Q&oe=69983AB5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGAsCvhq7UAQ7kNvwF2WIT7&_nc_oc=Adlrg1zas82l015-teIH63XLqdc0MrpPE3xifGVtLp6aLgxQjhR6kFJWscR-undfBO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftsF-e7D1J-cjSsbD6NuzQIYI64BJO4a_PlKmg8dnGclA&oe=699866A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKuIYBrBnF8Q7kNvwFj3Hv7&_nc_oc=AdmnncF5ZCPGqD0LdiQh1IlXfMv2m_7_2928AekmZ2WGFjK2xE3n5JOpPPumjjQg-OU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsjgBW3p9VvALJjtRqaimjbnrSp1CR7TgDulU569_LowQ&oe=69986BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXk4mncTXhsQ7kNvwF7jda_&_nc_oc=AdkSZGjepb01os-T8VXBUYS4e5v4CBVteVp6v7Sh3e7PE356xdUKD7kzv_iF7niis3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsgJNo4dM3zyrozVxfo_tDNhMaA17o_gJT7CGdgyhj6vg&oe=699848FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
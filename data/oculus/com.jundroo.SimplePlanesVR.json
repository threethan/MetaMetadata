64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqMqoEeYaccQ7kNvwH2wpo4&_nc_oc=Adr3A-KUS2hXHcjM1RT7syZdiiDnushXQtbysSTBs_V4EEU280xe-djz2HnWsIIYZ-o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrmEuWSAXOQ0rOlCiHYy7qRkQnxktqQ8TMT2MV-L5IgA&oe=6A882230"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GemMQnerMl8Q7kNvwGmwKZc&_nc_oc=Adpy3ehsOTKQlKCkBFo5C7d65VDSv64_yp60oHsRga3oTGp8VxksFlr6P9zlbqMIR34&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4gYXkle0vqw8iQADgaKMF87Bqr8JZPU6tilq-o2reiQ&oe=6A882BB5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K_U0w1l0hUQ7kNvwFr3hmr&_nc_oc=AdrEOcXj6mvqk08bom3rZr3hSwAr4MwgppQNir_uSkrMAN1pUP34GOdXk9qZvjYxtpY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-rOEhWvfvx-QKGXiSRKxSfjJxA7WFavpvPC_DDI5e6Q&oe=6A881F63"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0d-s6ZCbIwQ7kNvwHKxMdT&_nc_oc=AdoXZlyQrLqq3DehnYYg5OajlUZcS2CXT7CWH_X8_hkDDkzRSEPo1Z7kUqKB9houn-k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFCPG6asLyTk5o5wdM3bCIwKf6ZP6lVRDnJKoKJBtA2w&oe=6A88248D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHIHaxl1wrMQ7kNvwGQu8IW&_nc_oc=AdqB_0XZY72cl7NfMirUr0zswesEqU4iu_MaBP9RzVAOHkVgO_W6Xa3DHuZ-65c5xb4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaygcpZGqkV92pqNz-i9ulWBf2FEMfBz1plvQ1J8LtDA&oe=6A8839FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
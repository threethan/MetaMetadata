64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvVQ_us8M0gQ7kNvwFbSlcY&_nc_oc=Adq0vXRz76cB23BHq_R-gf79meeEva91oUu7XV-tKZMIEO3yb_GCXWJjr91MLbkwFBw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-LA3R_a30aLVnNtzj-eJgW0cO-27CJqwDN1lrcw9JAA&oe=6A54EFF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cz1sqTqgniAQ7kNvwGL2sJe&_nc_oc=AdqETXpYh5AT6uGx3HcP20U_M9Si0N18EyMgH6XedHuloZ5nLbigiL2J7jkCCWX9eYU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8kANxQsBNJfWU2DKJaE8tEcDOK40WY7tUJpwoTEdLug&oe=6A54F975"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5kIJtTdxXwQ7kNvwGdVKW-&_nc_oc=AdoEwTlv0sRCRREdxxhAG4MwXjZCwW1Y_yMCjjGbEUtJ6D0_25T4azWi4oyanee3670&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe_G0zElA_a_LPunFGDVEEBcBWfDgZCZIhXWbItnJOVA&oe=6A54ED23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIE4bsqxc9EQ7kNvwFwYegO&_nc_oc=AdrQubN354Ao7lbOIWLEzmEM4ycbSMwaJAqxZGinVRlL9e_0Ui_ns2hq7do1cZA6SWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUZZI0gEUqT9ZA8R7ZDJz96xUYPLDRhuPKWm4RyxILnA&oe=6A54F24D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCWp4Cg81LMQ7kNvwHeNwN_&_nc_oc=AdoexUK_7nSlfmm6_f5lXpO1hieOeBfYhv71rHwsUJAzsLFquKEb_0D1fUcl3IIVjIs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKkg1eJDtjNktE25UpsuoOz3Xi6-P84yGAhIJ6C8ui3Q&oe=6A5507BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
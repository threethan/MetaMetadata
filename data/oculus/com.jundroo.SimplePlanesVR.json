64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDDfLW0jChsQ7kNvwF1TgeE&_nc_oc=AdrJpjXyfipwGsH3qWf7pkV_SnZdT1Mj0mAGt59VRTioJO14rgP5LztFkjDKIbkrCeg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgfJe04-Ag51FULk2Z9tNJAXsCj4QFik3SU17H8WenBg&oe=6AD3B830"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ssBop0s5WgQ7kNvwHv_ldQ&_nc_oc=Adry-l5aay_pL54aVOnWKEsoVNQJwBmxlXvl1ZJOTdxcr_xMG-McCyB1KoGtqqJ7mPk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf0k2-E0a0O0bvWY1o0ckXo3oJnei_ywMoNjSGC-FSpw&oe=6AD38975"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7YqMIwN26YQ7kNvwE67Vnf&_nc_oc=Adq_1V3JVsdBlwF2vSUkKh5eyU_Hh9TvIpp_DhRWoQ9tYpe8Gp-huyBNe8eG7HOs6aI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgz0FYm48N83Rzg4-uPIfOJmtdIFcJR307FHriiQkUpw&oe=6AD3B563"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ed5MkwbWPlUQ7kNvwFD0xMr&_nc_oc=Adoj26dAWERcg-CNuNQQcA6zeEHkPKZ41dgazQyi6aqWNvCC6KArrvN6XOx1olPLiCY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEKtgDnAp62oAyk9IItoDF8HuUxXow6sXEP8z6bU-2vA&oe=6AD3BA8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOrau4_sa-cQ7kNvwE5Obtz&_nc_oc=AdqwJPbDRKy_wcLHiy3quVv0xyMjGfmPHgr2E7XLOynSRiEL8Kl_2Xqczc2XIWj8dGo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_3w17ZC-a7stOYpiLZAEdZBrNPhM-iah_PpGLKh7gWA&oe=6AD397BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_al0_iY-3YQ7kNvwEjcurk&_nc_oc=Adp2t_4PCcnmljCEe1pZW7B_29AQas1vImuoArG_yf5V-lz5er1BucEhsitmH9HPGcM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C0Ml6RI2JTxXtTh-N19q5eEUCeRB3lxKVLya_qvdMdQ&oe=6A451DF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjBoyeeoyUQQ7kNvwESgV5Z&_nc_oc=Adrh3T0CAp3ACm4Bs4qTjlVqhb-N5aWmdg9-Vyh3wppaavUNDhMoW7jVzDJ1w7YJ8Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3gjLtTz1OORc4-1nW9px-RfLcPsnETinXhMMGo9ZF3w&oe=6A452775"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w2d-txPbLQQ7kNvwHx5Eti&_nc_oc=AdozRRUIzmWaK2fOh2TRgT-cadgp83rsZG6OAclcjI0A-ty9p4YmkY-XBGF91owHeKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CismMfht3-ho2BGnFWmuSqyf1AbIsIHR2wvbINYnGyQ&oe=6A451B23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp6d60AnmMgQ7kNvwF5nlhQ&_nc_oc=AdqoHmTx4EHUqqZdBj_YrwiJqrq8qN61ZJeMnq1Ie5kWmfcO6-TQsfplZ_mWUDYelO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cFSFrck7A0-6_U37X9Sxnbs5TChdCH9zafnnbe1N0dg&oe=6A45204D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3Sb6S972YgQ7kNvwF0TmRX&_nc_oc=Adr4DE3eYMj1m8_0KB2dW8usZfRg_I2-SISwYR9vNxS8OmMJG1UzUjSg0Wcw05C2YCs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wOE-X6LHbPSnPl3vJEa4Sz3VYmu39PCpgZi47_GBWng&oe=6A4535BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
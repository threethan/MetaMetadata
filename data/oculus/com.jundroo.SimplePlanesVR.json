64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=no0VOxXSOioQ7kNvwHaNntY&_nc_oc=AdoS1OEb-A7JR9ooYxuLP8dRk81soIdA_qZvlGiJbgGjX7z5qE2S-MjyKCz5f3jIBqc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_JC9-mTyfQPXExu097xbPQbhdctXLWmhxgz4tZc_ueQ&oe=69C68DF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmOmQ5hWCtQQ7kNvwGPIj3S&_nc_oc=AdphP3HH7LJchqsDVEV-VjgrvdBwcdqfe0iaowMcrnHOMf-AUo184qRaytu5GyZ9fi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPqrCpqYk6NIVF4hqZRs1_QkVHPempr05UF6CXBUVe3g&oe=69C69775"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=He7cHr_1GlEQ7kNvwEyj5UG&_nc_oc=Adoafz8a-_uX7y1XRFe7nt2uUOcc_X_pp2icIn2T5tF1fo---I3qsAn3QeMjIqC4wnU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyS6Ok_acXgClfyWyYzDIUkUoPi-f6cRKUG_4h2dMVAcQ&oe=69C68B23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k1ZkAEjBIcQ7kNvwEKrsAR&_nc_oc=AdrSTx46FhQj7ltqsKF5AG10efO6nQIa9FRooAjRm_6GXr-SCy2RrxpjtnuoTAlAVjs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLwRPotT3U9yoBYrpdSziB9LNUAnuK8fwrXirAlXFRew&oe=69C6904D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msy-G1UVJsgQ7kNvwGXEBQe&_nc_oc=Adp_g1oJsC0VtF6yhNhM1fx6tsrnaV1L4W6jvBvAdA4ZpBpZQIIyOXn2BIfJBq-QxKo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0fNqZWmbv3J3QVPvX1EXj1Uab8TfgzHuSwybW3cJpkQ&oe=69C66D7B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
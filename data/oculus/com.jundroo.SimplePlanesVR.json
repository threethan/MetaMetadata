64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9cCOYmM2nUQ7kNvwFluHv-&_nc_oc=AdraK16sti9GQJGHdIm-U3UsMUrbLD5LOs7vMCJ37uh0hv7JIn0ExY1z6Dlnvx-3xD8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Moc1hrgrQ_RQmU-iT5RfBvfucPd7SnnATScN6sP0WzA&oe=6A072770"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk8IZR7U8OQQ7kNvwEAjB-T&_nc_oc=AdoacwzDq7blvlN5dsXFOALXuHR32v4BBSKjICkwhLVSV4ZtajUMEvQCmAjOgWTIVYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IsWzN-7XdlMEqKjwlrAvjIuUwPe-Ni_zITuWpLClOkA&oe=6A0730F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PC93dlMm8kQ7kNvwEFohAh&_nc_oc=AdpDt7fvm0MasrjDsldGLJtGVdcoMJQRf5D7Ts9lhwrO3DZ0cpvhR7IH3L4w9kpcHn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UZ12p91dkAD4x6BZon9YcxwtRsqH4d3Tedkl-HfIZSA&oe=6A0724A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrTslhIV8I4Q7kNvwESJLcP&_nc_oc=Adq0Y92zE2qi4hFOHTyP1YfLA2HLpb2vZHtqv3Yij0LdU9iJ6OcOaUm0SoULEiw7gFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uet8-pPf_xdR-LvYwpzokC1Ld4ffLaAC47nSlIgjTng&oe=6A0729CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q71E7MgOKw4Q7kNvwG2JdZt&_nc_oc=Adp4UTmZd4x0x3X7IuRxnXdhvlHPVYRvEShFegfEqXeoLcyzS3bBgy_KLCrNLKO0n0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qkXX7CA6os1RqvpiVF1mYkPRHqkHx2Q4eph-japva0A&oe=6A073F3B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
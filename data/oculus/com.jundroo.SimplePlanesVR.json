771-25/38974864_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHwLzI_U_rsQ7kNvwFKJqGH&_nc_oc=AdoP4EBRkIfE5nz7mLR8YDbSuz2hgvVu1RhAdQc6PqsZDTGG90C69nCWkyP6lLu12vs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvgG6DcgVlJEZEXfhFUG9WZOVWQjgF1EUeuLCaruSulQ&oe=6A8EF1F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAE6KbiWDWQQ7kNvwFPHJWc&_nc_oc=AdpHiCeXroz79l65mdfQnCVNZmiKGm0t6-ljegl0fgijoNjR50wUtuAnoLBdXMxJ8E4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUeRUky73bqQcI72alYioQhYip5nzSou8dW_u2St6ygA&oe=6A8EC335"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og-8wHILKbUQ7kNvwFpKdnk&_nc_oc=AdpRJ6uRHRlPPKclx3b5CBmZCM_di3iMk7a9gCLimSH2-sjAyY3CdDoDSOcrQUpYOfU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdsdDD2H7bY93nC55R2dCMIWScK9DhsEgNA-bJrab80A&oe=6A8EEF23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0oYjNPzGskQ7kNvwFigh4s&_nc_oc=AdrHJ0DLSc2qilVip_qav_xYE39FLgxpJXzKK_xSr6dHxCqhu2xSNT6_mKzJyfWn8G4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuHi7I0hK9Oi7kyZaF2EN_YbLhaD1R7I4Mcc4khHIbcw&oe=6A8EBC0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyEosyHnbCAQ7kNvwH9bl0Z&_nc_oc=AdoL3AqfQdr67kvcsN7k4X0liz3qP5rUzSBm9aq_Mf0upKULRyABedqGrRfpOM6wq6k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbz5cvGwRvFuczEsZQVBN26jEWFpfsSEFLZ5hvjR00Ww&oe=6A8ED17B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
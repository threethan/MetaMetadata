64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY7eXSPROMMQ7kNvwHSDGtv&_nc_oc=AdozZwVDoZQd58m8wJsW94X_72Zda-XxrzTxHp1u3S6vd0HPGJt7q57_vcTAzgzQMnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ILa4BYkKk3U8AqIkCHSHYajNgBySrn6UWGgod9kV1Eg&oe=6A281CF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jIlvZcC_PgQ7kNvwGysZmr&_nc_oc=AdpP1OFIzOWsrhIrlibIsbwcsD8IM9ZFozx2Oq2XhsItcujlreIhAAD0RalibaIsES0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kUIoF3e4J3juaTCVFXAVayWHK2hCq9vtfkxjp_YyBLA&oe=6A282675"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nebzyWlXoBQQ7kNvwFN860k&_nc_oc=AdqDgP1WpNN5127oaLvwqvle1f8w6HQhPxeq3-UsNFswoDH5CaNa2dcF92WUtD6ZKhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89dD4-nv-iebp2hV55v-h8nohZ96l4LmSbKvfCOAHPLQ&oe=6A281A23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkRSSZ7h4x0Q7kNvwEWRp8h&_nc_oc=AdpG8X9H7ppXKo3vk_Y5vEil6XmlOfzmf5LFqlx5uY1M9ND5FYUf6gvcNvm_CEUykMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MGjFO2zKgXBYotCzGdvd45qxOEOVpmjAWBZ8nZ6MDqg&oe=6A281F4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9xKt7JV1ncQ7kNvwFGynhS&_nc_oc=Adr3_Wi1WJ8f0F3sGC8x_jbpbEB5n7mjJInlJuT5ozh3BISRjLM34X4J_XLhGwSSRww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FssiluuA6JVOfw6LF3uoZ-zQTQ0-6vbjIH_ZxRyEDog&oe=6A2834BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
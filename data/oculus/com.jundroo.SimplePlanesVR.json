64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gHWKXIq9DcQ7kNvwH6wbrY&_nc_oc=AdqJXjhkDXLXGvMFgKFazWU6Q4hoSF4Lp_98lQFUF9IfW_36eko6A8dJIixXl-qclqQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dfb98Bkeup0Z4VcaoPz4hdhbYB4LP3oa1OiOHPZsEOg&oe=69D7B170"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqOLIUtGn0wQ7kNvwEDEOkg&_nc_oc=AdpkNGX_h1YX1zmipm9ie16golmmEcYvY90s7y1Z_JNkKvJTQDw9Z5ZCFH1h6xDeI28&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bhgY3wbnOuonMbq60h2Ab654jd3G5oXmBd6eyveGT1g&oe=69D7BAF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xARpG_00vEQ7kNvwH_JlSI&_nc_oc=AdpBCiAEWgXeXdtrm5pc5JFEztDjMnAFGahvz1YyRY4zuz55L_Ococ6ja6IMwSmcdGc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x707k4YeKXj9ulwOB2ArcnmUBlJAF8eq8DvblTH29tg&oe=69D7AEA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK7TWndQ84YQ7kNvwEqsEbt&_nc_oc=AdpCnrKrBCG73OMDUOqWNITd6YgXk2P-Z0Z5EkMPFDe3OmM9-ivw30OfRTtIIA-yMp4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SNPRLvO_IjSUl6aRwlF47LGtHQZ_cIKjHNjzz5Ni_Kg&oe=69D7B3CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8_cuKiMFBQQ7kNvwHy9tAO&_nc_oc=AdrtMxqhFNH8B7jwdle8DlscIabHDGmfkOo9pmGgu_AFuHQV-s0xzbIEO4NSyM90Av0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Cqr3_kzeVLRALWdJmEWfQMBQO-KDpJTB1WZflhp9Qog&oe=69D790FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
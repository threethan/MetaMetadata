64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO0mlft5ZVgQ7kNvwH7bmE6&_nc_oc=Adq3KTH5vOD_l-_KCPyojOvz2ZFZ0i8Vrv-eJS0KsXI7PtJscqcNHfQDJH9B7PvleGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYKF8MB6Of3eRxqimN1IiGpo0kGbpMljbFsgSi46Pvnw&oe=6ABBC4F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjfNDGZWCR0Q7kNvwGYxoQU&_nc_oc=Adoj1-mWrujCQkDf2kPaTaXup2mbyRLYZxkeO_GY1qJNhedeQdD3sZLj1DwbiXWAxR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0Q_sA6N3vibCNZTRIcUM0WyfJtPvxsvKaGeQBHohjqQ&oe=6ABBCE75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0aLHx9J7X4Q7kNvwHKOmkQ&_nc_oc=AdqXxccnpGzw6P0S1cNdJK1falcORNRWk89-pqvlUhMe_du_ycGQgWfKctkvK4uFd0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRp8S6vXWbU9xQ5VlAmCAU0oC7i6KFMnnCzwVk_fs93A&oe=6ABBC223"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngMmFEMEiK4Q7kNvwFq63mF&_nc_oc=AdpfmQ9k2oyaCY2t8UdZ9gksiLNgjYulVWN2URKHfZzI9PPLoMWYEGLFzpk2emGvW4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJV57-BnlyQIbjWtENNm3mARfvO186FUkeaqTZugGzgw&oe=6ABBC74D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjxOq1WBp78Q7kNvwHa6_x8&_nc_oc=AdreE3s1z5FDTTEyxmWaEEuaupr1wmqSCuMchYnKLe919gWrX08nbDlrJqfDAsvOb5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqvL8wstHWUvYy3YAbrUMZiJ7ezPmHz0ba6mwVC-d25Q&oe=6ABBDCBB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rThcr8KcBfsQ7kNvwE8tz-k&_nc_oc=Adq8qZllfJePEw6f0aMWA1NhoqtXMOTfDD1xQVKiL8CsqWjU5oCUke_KGW2lWJp-AyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D32UefAHjNPEozFOL7LB9rnIm6zjkr4Fe5Wuicbn_7w&oe=6A145670"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsI6S_5wRuEQ7kNvwFsSeoz&_nc_oc=AdoGmqbETB-zzQzcGIJOblDlBr9s6607eekt0jbIuUw8RSM0T1aFZClkTzTi_ywtJlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pl4iCMGqmSPi2I12nySayezjurbyK7I855Qv9nFukIA&oe=6A145FF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aG47cWXLnvUQ7kNvwEXg-c4&_nc_oc=Adpi5_wVpF7R9A3q9W9tHEmZ15aaeLFiM_H4xnymQ6FasfpDBbSM-nRj9ZYtKG2TZAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51POMuuDHUcj1VZc-kVOYBdnhhNwysCKLWGKyXFj7omw&oe=6A1453A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjcgx5OZeAMQ7kNvwEKyMPX&_nc_oc=Adp2ylaVnCRxZCK2xViq6TvOpLFARIUzn30YDjFBauPX2a0rBUdJqvI2-p87tvS9xoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_A7LvNW-Pxd3ICDztycyZS946l-UlJ5nh2Ak8roI2_g&oe=6A1458CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5JI07c91KoQ7kNvwEW8_Ts&_nc_oc=AdrFalYKJXVZ97HJCanoFF12EFJJMmMg0Owh05mpID0Wwb5VvopG6VPXY-x0MoCiVe0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XT4hliROdFkDsF7bO96yTdyaDKLm5C2GXu588bYVJtA&oe=6A146E3B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
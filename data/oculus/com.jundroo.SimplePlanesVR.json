64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJpy02t7U-wQ7kNvwHnBSVE&_nc_oc=Ado4FJPpHPRpH4PE2d8D-V1hXdgw3I981fAgmF4wtp7hcSQiK0UNJfPDT_FUn1gpoww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FxSR7RXgkDR5KzP4EMmdod6QM_kmSNfUcxkSH7RxEVg&oe=69DE48F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuS0Jpe9YegQ7kNvwFki-Kw&_nc_oc=AdrwSQevMEUx_ywuAgWsR7Siucsd9wnVObzS0UpW4NhCvKH2r9P41Gt00f-sRHOqYH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37hD7bneJDqfaYjx99WfG06VabAOCFc2nleL6rMCUK4g&oe=69DE5275"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RpUVEZczCYQ7kNvwGo-uGw&_nc_oc=Adq5SacAzTdSYeqihCjnWOieFAal84cHClIzTqRbxDApCv5XTvqo5aXXE4gyYBu8qaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E43fCvcOtarwfNN2xUynlLOE3FXfbLr3T2J2Stc78kg&oe=69DE4623"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LUJ3pQiOHUQ7kNvwHvbFQN&_nc_oc=AdrM1u7azI5KbmKmonajEkRJKhIRlBbdYsOgqXNUrdwP80BYX6J7MeJkWCfMh2foXfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26_hdzQ6-65Ki_oY7g4wjFoqLmFYHwFqhTzrbx7nlaOQ&oe=69DE4B4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSKCrqjA2wYQ7kNvwE9SMld&_nc_oc=Adq9gc1JPtyQ2pwhXd6uDYlfHaVs9WM6LApkkSyZHZSpcY4XitaGSWYNhgmVAW_5PEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af162E4h1n2GvLTB_cxmyM8gCsjMwajcIpP1ycQ0De_P_Q&oe=69DE287B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsAAbVVA4ZAQ7kNvwH1B4eO&_nc_oc=AdqKmBC1UK1GqjDYgDW0QjRPHWjzfJyZDZfDMtSToqGflYNwolRQ3jhEHrkghCuGPZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA_AhRtUcX6CWHDOuZTMqngRC-7PlgcZQJjt6oTBSuaA&oe=6AE74670"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK5ukzbV56QQ7kNvwHHM9rK&_nc_oc=AdqS7F_rGNvxgtbCeJYLKzNx-EBdJbhTxUWIJTIHCOf9Qb6ppDxDAVD9pycLkXxbI7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkb6KGmjiV1hD0H4OUz6hThCare1sIYI9A1_C0Rw_-wQ&oe=6AE74FF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqwB9D9rfyoQ7kNvwEfTI09&_nc_oc=AdroHq1QTTA3almpCi8KeaIlU315o8zuUoBc6CqnVyaUM6xV0CKPkNoZgKB7YLNIgUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrwHQZuyyIbzoe6YPHIvUkyxzR-WJcwE9uHXA-uTP8ZQ&oe=6AE743A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbI7xKO-yZYQ7kNvwG1RaUE&_nc_oc=AdoxHlmTmw9hwr5tG8wEY4ME1ipHdzi8B6_67tA9qZ9ff919SlC956-Cd3ox3QFaueY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAgMAzKCufUpxj-mtmTagMzNj6Z3LPJCAV5hIHaNquCg&oe=6AE748CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haWEKFkGraoQ7kNvwEBsrOe&_nc_oc=AdryD9153ZrQge_1iDTnHuZYvlNqUOxeHLyX1Ub8FiN1OOfbd9L2pZKFAHpZtVI08oM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLRIMqmj0eCA1GcyHumQqa6qWroZ-JVk5iHA_o9SvOLw&oe=6AE75E3B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
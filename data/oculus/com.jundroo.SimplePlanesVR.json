64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIpeBIRKbQ8Q7kNvwEUl3C_&_nc_oc=AdpUHAh08vf-eeUpKgeadT80JPI5CKcC8oFCCzg7Zln2LL__ThoIOvhvQ7PW6Cbchf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8l7z0Hb9Dc183-vowwwNNWq0cxfEJRjKfKdIdjUh9jQ&oe=6ADE0BF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SIUKIpL1t8Q7kNvwFV4RxI&_nc_oc=AdpV1IWl-jxQpMERPvx0H8Qqg48RG7WNHm3SGFPYraKvNgBxgBjdRiuRrqcbOMWTudo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOApe_rvS9V7uNO5tHzrBiwBvkVs4XBKP7sKv47rP1aWA&oe=6ADE1575"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_CNH_1NeEYQ7kNvwEugc8K&_nc_oc=AdpA-ohgFzTy0NUUuNO-xI4bvrdU8WBNO4L6OkDG_jpLx586qNiP8JAyUDlV41e8hdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvTLNgzAIuJ3LNex7yigm4F9BA_RxZmDXIPa18liWpTQ&oe=6ADE0923"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM1DGkFkhVAQ7kNvwF257d9&_nc_oc=AdrqCatSU7lWBlE4gue4mqbYglCuz3RXHmanLmynWoRNTDiFEA2CqNzLG1E4nY_XBaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx2W6FUg_o8C4fbWi2hMHxsCH5QBhjwrOAfXSsyJJEaQ&oe=6ADE0E4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHNkND4Cn0sQ7kNvwH7C4kS&_nc_oc=AdqDPGXwryk-QmevCpKwKJnSE6GamCnfESvGve4m3QPQ8U6lGuS6s3184toVW7iV7s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFD5v0CL2HqcAal_wFYkNh0rR7tSdanjR_RTJrveU9Lg&oe=6ADE23BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
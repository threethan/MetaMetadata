64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfXbGRFHjqkQ7kNvwHqwsbF&_nc_oc=AdonoboGi3ooxIkz3NdvVGRBZSPnacn6AxLusqPhAS_NyNqAkMXdnPhnn8qx1LRNXyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi_qjLQqU4bVfVXgufjEkmHT2YyrRKvLZp0Vl9Gdh5XQ&oe=69CD2570"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag6aACVMB-kQ7kNvwHQ_A75&_nc_oc=AdokSjt-ldqXRPgo0pBCUL5UaQeTt_YbXDSEZG-UzauquRnLZMFLGx-6mgbP91wY3kA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-aeUXrhqGGz5HKruD0Yd2YaUx2DvPdO4VjMM7cbyRdw&oe=69CD2EF5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD5Um653urYQ7kNvwFLko9n&_nc_oc=Ado4PwCjWycnJPn36ipNFTo_kzPgnAD-XEicGj89faZ4CWJ3MG6jrrBAkC6I1gxtu6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1fVVfIemg4cMAGaxzM-nnDxkzicslaSD7Kmox3OejfQ&oe=69CD22A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEOprTQvsrMQ7kNvwEaokxD&_nc_oc=AdpueSrnLtHhUyGJSIBj5ZkmykJYzdCjHk-9dpf1v6Chi9qcmDUVKIddjWo7-Cu8pCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH120-oIsCgFlzkTnvkjbTvdbr3m7-GaD48nbIoxIcEw&oe=69CD27CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuyXu429b3MQ7kNvwFip3cp&_nc_oc=Adr-SbZl2tP0HrJDjQ8IuOkwA70EMs6rWIe_2GuAZS-6gPN1Nxaou-Hs2Rh5PlLqs7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmMO6eqLViosXp9BSSX8FdnRc94AEMYGw1LiUosJUKuQ&oe=69CD04FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY7eXSPROMMQ7kNvwEKjoH0&_nc_oc=AdpJaFpxaYHUW72TA6o1w0pyZvt4JBv-2eo-pW2xb9G9ClOXDI_jjBFgHkKIp1Ym5v8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80F2sjACXi3Amyffu_6lNNBaVMgB5QjpdygnH8oVkCjA&oe=6A2579F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT0hV2jCkBcQ7kNvwGFAF4o&_nc_oc=AdqXd-PWepoog9-pf93oHaYyeqGG-bN7fHBDh0YHLGNBWIlExEAtHvFhuYJZAmzUg98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VAwyMArZk2rW4cjrAf89Z3o7H3HqhFIoHNpUY2IpJZQ&oe=6A258375"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_3053Vw8a0Q7kNvwGXR81y&_nc_oc=AdoAFXw9l1hZL5zoffa13u-ND9O3pQON4Iq-ft_l541xYIbdDSv9k2XUoM2wb9NZq2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k2WxLVD8UwXOLfAOVqMoMvONS31qbaVfUupwfAbR8xg&oe=6A257723"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGPy3Xqe4bcQ7kNvwHuZd9B&_nc_oc=AdqWNJ3R157fwYXtLjg834mVORE3lKgTWfuq4YNIS9lXNhnG32pgzLF4AhWhLzA_Z-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ci4eR2UoF_Q42OrslqtdUK5a5p8RN-TdDXMNQfC_VCg&oe=6A257C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgv1KyiJ9e8Q7kNvwG5O8ti&_nc_oc=AdpB4Z3Y0QwHCvxRXxa1IK_weWd7cx65mZY2wjUpLmUemTlfVUrJO2mNnjiHlFcj24w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XYnHZmaYyCPmRLc05LI64Ux8owslHiA5TtJtIbOqoIQ&oe=6A2591BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
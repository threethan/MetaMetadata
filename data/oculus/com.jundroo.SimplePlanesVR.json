64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiV-kHWWGfkQ7kNvwFry6p7&_nc_oc=Adrou2sq3MaRuUEflJOAeeElz7Fl8xTnKqxeu13qA4gcF8sOBQIE8ACpqplDVAPNO28&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rr9QL3sPdilU86IoGeJdChXCgZ-4i51l7fZujlUpcrQ&oe=6A16F970"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsI6S_5wRuEQ7kNvwEoQB4D&_nc_oc=Adqt5dE-i7rui-9s72iEWnnJFklcyuDCu9pOzv6s4b9HGij17y3PrXt3aLbY86uLi8g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UWbPuINEfml9WqRw7GRIL2k1T5Ea88nG43E6BbRmbmA&oe=6A1702F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYpt4ZexuugQ7kNvwEm40Yr&_nc_oc=AdpDQJxB7pYkjgV389-osUJIdTpu8J5jHhQgmBgw_6DebaoXAofojDuydz-_U4_WUPM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dIeR7wi7lMxbhbyLokwmJyuFS_-b4Z_Cq0j0p0QPEFg&oe=6A16F6A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjcgx5OZeAMQ7kNvwEljtaR&_nc_oc=Adp1AadMHKkydy-W_TvNFIhEENA2SgjuyFgcqYZDJGdKRtp2Wc7Na2bGFPSHZ-QfACI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mIu_Rr9hZkLGG3YQxipf_63ppa5lSgfIVXlTg2ywo3A&oe=6A16FBCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5JI07c91KoQ7kNvwEU4BrJ&_nc_oc=Adq9WAIFyDI873d0Jomo_RxYXeGfasqUZCqj2wxbY6H-twkE7yons1tmfEgC5RAfDAA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PvflI4H3ra5D9m_dqm83j5hORA0AzvBKTNB-4e2UO3g&oe=6A17113B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
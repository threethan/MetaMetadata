597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDjHYOzPQvAQ7kNvwHIk4vb&_nc_oc=AdkuMFShHW_KTPq9gr4Xj-dnnWWLNhOo8iA5OH2JU9fUQyWRPJ_M-QomGzxbsxe3C5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzj0odD29hb_oL19LN42rUF_7mfgkW0xYUfjeV7ab9NYA&oe=69B02470"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1bTn74SLpgQ7kNvwEeKTj0&_nc_oc=AdmyaUAJUAff7qtnOJMvkryWfUfAVnVfqIAZpo1ufldk-8GGFQJsE5ySNsQnbiBnGvg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZvXMy9va10TheIMWtayx60WasYZBKfrJpKR5Mck-taQ&oe=69AFF5B5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtDW7HQYDs0Q7kNvwGvXdp9&_nc_oc=Adk-gGikHLZBqtoPU19t3X1cbZU_NW-xSGhoPtxstNhyvRK2zIbk2oM7yuvp4gkZTKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4ZmBs7y-J8-c80ZtMBoSafp9Lg2Hxq71kBfyGqhyGcg&oe=69B021A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm7gmrFqTL8Q7kNvwGy1z5V&_nc_oc=AdkQSA-eFFnREpq8sKnwIbeh1kIN6TDl-YUtcKUQ7E7aBtUOZFsOyz4xsPGsSLk8SAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZe8J5nHdLPeCo_XlM4CdwereqTZ1xI6V1HOlSeJASyg&oe=69B026CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIbmUoSHuMsQ7kNvwGq8n0x&_nc_oc=AdmKvRCzt1neCdXb7thk2pbeY6jb5GVJ9ky8HNsZF5V21qYzFAXt_iAHmY-N2p1FkT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz8kw8YtGTsnwvywOQiv0039AbeH5uasbJ7jofr9-9_Q&oe=69B003FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "g
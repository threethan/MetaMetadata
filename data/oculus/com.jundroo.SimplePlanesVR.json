974864_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WtNPQZ2CRwQ7kNvwFN9iaq&_nc_oc=Adqu-MwI_Re2vFEMsmwRWivlrUCkEFWwt-QsUxkv2Tt0BuWnyWnp2dtmyRdFfD5lF2k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MCYl-Sh4MmPPrr99KEV0-Fmj_3SB0lP7vk2AbZ5LLww&oe=6A22D6F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgfQlEr1B6MQ7kNvwEvz9Xq&_nc_oc=AdqJMdXiwPeUNX_djcfWBK3Q4_gY5-5hRAsSxa8c_d3HpHwnwaJ7RnFH5Q6Uj9jWlMc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83jLQ5ZwHVnyrMfGYYECBWYCgy83mNYJY1tW-o7gIwRQ&oe=6A22E075"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_3053Vw8a0Q7kNvwG8IYhq&_nc_oc=Ado05qR4UeELjXy9Q5dilEtDFE7WgVM5BdPBHC-fW0rFAqxiXEcJZ8ZTwtu1TNmsThw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_97rb9wDPg2Qo9K_YngPQ2H81_nrwwAK2NNQYpfu4fag&oe=6A22D423"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TRjtXARCUwQ7kNvwGqCJkn&_nc_oc=Adrf-Ar0uMmQd7LkQIKgRXxtC25erIW3Dk424I7wB5dRwEgY4hPWxkivsjm-qbj9sJk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92HqN8cS02E2GVJq3xxJk28mH-wuYbOSdyEJmPhZU_-w&oe=6A22D94D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydrhyvxMhKsQ7kNvwE6y1Bt&_nc_oc=AdpPZIyDX8uw4VNKk3qcJHv5GzC-7hSzg6bEZ3O3IlSpLw-72sVNOOprQerK3IpwoXA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tx5SyPiHUmWQiHbNPMe_qhew1umNbfUhOT3lwFWRA3w&oe=6A22EEBB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881
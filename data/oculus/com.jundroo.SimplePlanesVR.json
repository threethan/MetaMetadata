64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHmgoxgrEWYQ7kNvwHjmO5g&_nc_oc=AdpYtKSHxfGE8WEZedIA8w-LY50VWGEIy1sSRd6iX7YXf5IMKjo0kLu9rV-ifx8rLTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbuTcQWiVPUwtdB7Bz8JYVkNcY2kloK3fKoeJIVR7CNw&oe=6AEDDDF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xad9zJakCTkQ7kNvwFofDIx&_nc_oc=AdrhPZBQ6FdNl_QEzGiCOEJyXYFdj-rArVcvZUCILXUl4k1zyImOXMnAYJibD-QhCbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTok-nDUVI_EeQCgxrlqbNYSforRBUtTMRRaUrd7VHw8A&oe=6AEDE775"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLV73Pn7yPYQ7kNvwGObgwA&_nc_oc=AdqloM_T-XsCsBwOLCmNMPzJIqJlQKG5upcfL_rj82eiv1yzDzHEQOFXzW6C1tv16O8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ3KxbbYWdosPrsO8oDt3BpSpLHHJLc-FIRc7KFhgQsA&oe=6AEDDB23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXl5kvHr1jAQ7kNvwGfzxKu&_nc_oc=Adr_nmUgHiEBIwOR61yCWlPHk4X6bi13_fk665XQ8loH2iFzYCaCumzkhINEF5LOgAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyUqsoQ46ak0gqIUAeN_WffgedecNTkU9qBmGa6MF8Zg&oe=6AEDE04D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOUI9IqCpYMQ7kNvwF4hLj5&_nc_oc=AdqiTPj3jehX6sTTCsc2pFEqzMBn73is81yHB9ZvD0Reqoxz7OUkrcPSf8wzWarpqWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxxTLDffJ-iFHYE2VVvhPobzW0piei4jAe2hxEglxiRg&oe=6AEDF5BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
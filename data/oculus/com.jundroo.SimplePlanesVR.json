64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3h3dP9m9kMQ7kNvwF0H4PO&_nc_oc=AdpDQFTqXalnB2nXJx-ILSa0gZgLRSa7vKoVGUflQqSqy5vRYRG62wwhmHzACM8qMS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwlTTXLmAPuvhTrtcxmsYZgjlEdArNAIkNuAmvA7PPZg&oe=6ABFB970"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VqCM9w8BMMQ7kNvwHw_p55&_nc_oc=AdpDK9Ui8A8YggUHDQnfJhXg9M3-uaNEC8Plg-gU_HgeQdCsmkpCx9TLq8tooElZl5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgUCWOoQqQOX81y3RBpGKIhrtOcmJGU9vbMUl_Hoynow&oe=6ABFC2F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9pMm8Q2ULoQ7kNvwHfzRIW&_nc_oc=AdrJsiwNxQgBOAJou6BSTFBBUcM0sXBinDDy5bnZaXiLGCsvuqRP6vIaGinD-5lvn6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXQ7o2uqOWGMIZuVY4xOMbB7mJamUHpzwwTDjNqDQi3g&oe=6ABFB6A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nje4-sBs-kgQ7kNvwHJoNM4&_nc_oc=Adpc-_GJVK7O-xaHgwCS52BWCGAnss-qEVIJu5JPfZhVpKuFPTGWFaX6bhJmk_5VICE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN2BAWSoVw0_pwe6Gx_-v9IfEFhlOXMkiQ0Do8GN17kg&oe=6ABFBBCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfm6NH9Kx3QQ7kNvwEttV72&_nc_oc=AdrEXdHps8aqKv5mTeWOKuMyvgoapOGYR2nYKMw_2PK9_9Gf6_La4i3m9C1l4qlJ0Z0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1JJ1_mIXXMzaeuCDdwi5hHCIXTNsn6OjiE-RosmUVcg&oe=6ABFD13B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
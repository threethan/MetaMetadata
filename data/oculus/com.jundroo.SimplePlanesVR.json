64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHmwbd0dIpoQ7kNvwGzWbWl&_nc_oc=Adqvts2AKxpwMej5K_nvwrIKz0gsHFKpHzlja6yg6AHlcT71VYXxk60HcVJkK7KFjOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zGjy3y1hGfuJtUhdRqZDFcvRD6PMzdFzxq6MbI9FNvQ&oe=6A0332F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnQZgSu6zPwQ7kNvwFjqX5x&_nc_oc=AdokY-4uRwL_gjelL6Ux5qNCB_rRfkdnL2Cq7AdPmQu0AxQB4aZr0qhNxQ6BMMhbn3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AfURAS7RPu-5wQfkOjIHzC39tCvreebC97A2poVKRcA&oe=6A033C75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou-Tvnh4GpkQ7kNvwE2-_SF&_nc_oc=Adqffyvr_L5vYO-PxIQxZx9detzL5KMmLyBykAzadbfhzALmqqXqxPUF-UDC1oTMrxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C9afnq1zKAP28rKmCiGudvSG5XkyZsTrAzaWZ7-j_MA&oe=6A033023"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9w0Nwsmyz0YQ7kNvwEMM5KK&_nc_oc=Adq1vidZ4rrXLE8Qqo02qScFs-o-5NCI1OmaopGxySYi0PQnULRjXhUcpukQKa-jXHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54rKCWHZCy4ffEp2kjWrcWbz3OYCjkgp7otZPwmqT7MA&oe=6A03354D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh6IIvaEd6MQ7kNvwGpi3Bb&_nc_oc=AdrJizY3FhnQCcEx8lzoU-4dlhBMXiyy2Mq2ZYqVd2n6czOGvh5fJwLm0tP6_ZG9s30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RH_k8cnBaZdTH2TpHnV9XfAOVqo-fiI1_nbIOJ6Wj5g&oe=6A034ABB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
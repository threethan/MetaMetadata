64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkxNVkOumIcQ7kNvwGDV68F&_nc_oc=AdoffZ-UhN6dmpxEgTr-Kx3--eJpen4EKFPHJaor7IgQKrthOq-JFMopT2fHd2TqRh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPxitSZp7ZgnPZ_XSqX21gGUOhueh1qDsL_l3KrelhSw&oe=6A60CD70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPC4qWWgejcQ7kNvwFYZqNC&_nc_oc=Adp0BelsSew0VQNByCbDqgYx-Qn_RKdVl7cI4VnuMjD2qCpRLz6SNEUazIpIrLQqAoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC86rj5Jlv7jE0DSXUo7_PoMhqrjcyBZq5y2ULlXrw1xg&oe=6A60D6F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-n5BVEuGtMQ7kNvwHRtq-o&_nc_oc=AdpVLeYvvnSVzFjMeH-D30_JK_x8M4vkZ9vZ_JO9kypmzuUIi8cNFxxrTiun2A6QEN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJl6q_JByH2zdTv_QA8bir_kWV9EQOlHqAx5bJF1NTGw&oe=6A60CAA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkyym2Xcsu0Q7kNvwHg_0kx&_nc_oc=Adpx7l2izpnNVvzIyqVr92WFiIXwtNDN5-qPMXPmunw1lwgNsMm6Hqnivy2s-HlBmjk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKWoIoYACGhb_hwFuEaHekfFQNNwvRSwq843VaDBJUMg&oe=6A60CFCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39FaSlt6G9YQ7kNvwFsmuXK&_nc_oc=AdoWdh47hV88Gfv24_gnXNH0Sw2Aw66OdU-CarXrrARwVU-_esNyDFRzXyXqrMij_3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWEQwZB1yx6vTRZe4f1FTZu3bxiLcGlAGQlgXvm7VwWg&oe=6A60ACFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qCHDHHjaMQQ7kNvwHEmj4r&_nc_oc=AdqVFikHY2gLx4XiEI5XiaoUfMDagHaB5TjZMWLp4qf90CgQ5wzud1vZtIV6m5cCWBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fK7oPsR-72fhGv-r3OVOdFFgCeMg-J-Z3UNi1yUQAtQ&oe=6A3FD7F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9pF8-dIJywQ7kNvwGKPCTq&_nc_oc=Adpe1aBA2AztPYYW3Dz_iOUusCT3HQcxr046gzDEv6_DSxKllgLj1xC2pwqtROxI6_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jJolmsCBZ57SSKs25v3hzpXwGU4AlgD8eAb_uQsI3BA&oe=6A3FE175"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VlNUPNKbusQ7kNvwG4r4x6&_nc_oc=AdoRNyEFF4E-6N7mmiyNF58oSCNXzHS9-hf3_5PQfTQsVT9pfOT6SdZr6UItOANaQPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z0uwcagaYzl8oCNjqs5eqKTK16LrsDMZ7VwjdN6WEoA&oe=6A3FD523"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk6y1h_PTKkQ7kNvwHdj3qB&_nc_oc=Adqy9oua3hE_f3ZjRTAJ7_aKvwYmm9J5_taI3Jy_f1j6Nn7Zhcpyv_L7gKDn4eqBDX4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XSNq3lVY5817bZv4SPxRJXkyDDIbiILEUlC6609jzlg&oe=6A3FDA4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSR16wB_j9oQ7kNvwFRoBZ-&_nc_oc=AdplJPVRmjkYvPiOWFLJVTMNPYP1Qx8ForcfGeM-4wJl_178rAz8lzoIpd7-05rSch0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80skHtVi8eNpQLyPAwj9ko96Uq3e0jKGouNlfULGwvEQ&oe=6A3FEFBB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
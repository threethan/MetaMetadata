64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=natDk89FGK0Q7kNvwE5xlV1&_nc_oc=AdotOA7e5L94tEXkzWD-BtpbMzR3lhQ76fr_BCbmcoRJggdhrW3tF7vv5BFs9y2yhdU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xjPGml70CsA6Dqyk1xzN2PGqHPmpbd3hJy4OZMrP5hg&oe=6A1061F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdSOfChRoroQ7kNvwGJPFFj&_nc_oc=AdpXnXVcLNZL0KG6Ch2bAozf4TKk0_8QjXDveUf8yp6UbyV9ZpqFeJD7yEPxS6wS6YI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mxw2aictrACMaiRtvVra25wFW8PRIgFuqzj2Dpdzc6w&oe=6A106B75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBtqk1O9YVgQ7kNvwHMNsx4&_nc_oc=AdrYNfBj9UM_SsnlC4r4Us2sVJ5pu6HFhp1LFwRy42t5DkUe4yxSRnvbo7U8to1ahbY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75dieQEBIMcxjI_FuF1DPb0Vhmj4Ds6RGYH8vEyUmcig&oe=6A105F23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLNBhQOdXjUQ7kNvwHGXk3Y&_nc_oc=AdqeymRFXvtRLTMeB8z1IbIWoTglJXzGdDYAQmdsueO55ZbmkMFKT2aqIyP5AjumQ1Y&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YmqQSLANpgR0IYvKy_8R83FSQ5jKj7BL1h1PeJkhHbA&oe=6A10644D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zUgtiLL_nwQ7kNvwGI4O5k&_nc_oc=AdpoaUvjzk7jBaRbxTjIJEaXsA-I_MGBOOrPozXiSns2U33F4PbKGlmb8ixnDOMrb7k&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o_4M03tGPkIxww0fvc8sGBaFUnsGqlJu4ch86ifhobA&oe=6A1079BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
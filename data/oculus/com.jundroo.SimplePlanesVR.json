64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iy6eOxbypbIQ7kNvwFCcEK4&_nc_oc=AdpuWNRFfn61UNAwtTNfRzfRXJFB4AiAFJYES98KXdr8zhqHVUUleN9_yTPWGoCt7qY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bDQuAgy7TRHWCdDMrTAI00VIJk43pVXw3Q2RRx32UpA&oe=69D26B70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTMVzZ6ZuAQQ7kNvwHCU3Tu&_nc_oc=AdqfqhBYD7B3YeSB_GLTN-E0AQvl402rEe0w5QnvEzTzjqWE_TZx-pAUpQTf4i43kys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UODZOpdasXqUYBdsx94-ExD9903SXF_4YvAH7jVtQww&oe=69D274F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HprRLXAZJnAQ7kNvwERp-Vh&_nc_oc=Adqjk4w44npA7b8elwxdGwKRCUcuvPUS32F-je73Ggakvw7q7foaFd-hC5-3ThvC4ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h7EHH0AsBvT9NDQM518ursf4V7718qWTEcw7X6MdyMQ&oe=69D268A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyX3WAMQlZEQ7kNvwH66Vxp&_nc_oc=AdpKpsMowp21pfWhbQVHvb4Cluvl50l8r6LNVd89eoAKoLQPZcGZW_6Zoyd4BPBnUf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tuOGGuLdEzsyZ7ApCZhLWOJg8gXVHlHEZ8GFEoX200Q&oe=69D26DCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9OZX2aL69QQ7kNvwHWQhia&_nc_oc=AdrTPsEZlbf0ot6vOu5pgG12nfvhU0bWOG9jpyHoiFzt-W6Ky1TI7c6kt-22bDkYNB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EMGGh-W4j5_orlFXoZgEbMg9ULtXukGPUACrv-h6g8Q&oe=69D24AFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQqklkUsudAQ7kNvwEBV9jQ&_nc_oc=Adm9Moz6w7C8uTpERrA14yg_5Ue5mdW0hW9ZRmSfCaghWO1oxMVWBPYtENaeQ5Dq2Mw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhzGgvwsXq8fGeKbcr65_MJb9pBsWaiAlFas-OPEgZjQ&oe=69AD8170"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1bTn74SLpgQ7kNvwEh8v5Q&_nc_oc=AdmOwcBjvaA0Y7NFhZEszF3kgOl0WpWKdgLbDI2CkFAcPWJnMe_RTwRX4QvIhVe1FnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbwgNQ7xT5F3qMR1ZPV70DHylPBrezffQKlEVbTDYzdg&oe=69AD52B5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tYVkrWjY5QQ7kNvwEbVs8F&_nc_oc=AdluMRoeav38Ni7gSlRlIaH81NHf1f_RXchA8w3TMBbX4lrh2xuAqovZpHl0U84TW4Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYPACuP2RoE8yBUbcHK6Pc8aEbJ74K_ohIUsneUFZdBQ&oe=69AD7EA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm7gmrFqTL8Q7kNvwG2YIJ9&_nc_oc=AdmRz_b2lBnL7P_TcJqJA-zBw20y9gUhhx0ebnKWaSxDbX9tGuwsFWLsWkc9T_g7eaQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzB2OlcTdFenraViynis_9N2LOvbiCvA6Rr9-BYzclSfg&oe=69AD83CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIbmUoSHuMsQ7kNvwGzCF8A&_nc_oc=AdnyV_RvHcovoFXeltnZoEwMh9taSk1cd6SqVXRo9kVqRsdH04uCrZUqIa59JUuzpsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXRmSeRPW0be4omoni-oAHRBq5pYcpx-3qR-6Mr1LyTQ&oe=69AD60FB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "g
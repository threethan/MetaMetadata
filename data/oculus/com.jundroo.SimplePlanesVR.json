64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC37bPNOl6kQ7kNvwG_Jdjp&_nc_oc=Adrtr6mUngNDdbvS5ULoFmJmNZfbHhNJ1ZKEn4C7kNGkxrkywE108aqSdHjAKdxr2po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkQGGKTbX4uUdvWGqJDKt_VAW9TONkNPB26fDsjjkvlQ&oe=6A7B2B70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ3PvsPix3oQ7kNvwEXbGSa&_nc_oc=AdrSwbbRxKLRkRDJCn61NbLHbTpo2s3ZG0WC-fHSytK9nZ4pP0jkPBuN7AFLQ7H_oww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOYbQoEz4uUfFl0UxHST_19KQleqikjvxj6_WeC9PZyw&oe=6A7B34F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5fS6_Uh8fIQ7kNvwG4nmKW&_nc_oc=AdpvJ_1PmALWUkf6dwrqa0bPVF8PpiOazudSRWad5IbuTltFcsn3_x4tcqtB8nm6D9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_R8fG-JQ73OqAPTRFgVfvbh49uAbp5FOX0vXMvLPwcA&oe=6A7B28A3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5DqFXCSr3IQ7kNvwG96wMM&_nc_oc=AdpvJNFuaG6-fZgZwCURCdW1J2BaBsKKeWEmdXVdHuUXmVAuajbrScv8e4kx8JLppqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFKR0JH9CUaIeDVX3FlrllIXSA9eFPZyDa2GGcfZtd7Q&oe=6A7B2DCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l47aRubNyxcQ7kNvwHZmrO4&_nc_oc=AdrjHrDe-mfSqnmQq17bg7JcvVrE7y6dLVxNYu3x-pq03wkoLi0RIFTJleBcOXWg9MY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlcc-M72CJxhHlGFzbjkMA29U07IYsij9pWRLWuKvQBw&oe=6A7B0AFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
wEGJYQ5&_nc_oc=AdmvnDipmyoEq2sliKHleie6j9nlyKU0FyKtzvD8wQnL5egK46_zH4EZfuiJsD4TGdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsX62Ro7od06PZFdx7aojMEONlBn5PYAkDs0Bwcv721qQ&oe=699DAF70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JYFiCFWY3cQ7kNvwGwD7Zj&_nc_oc=AdloupZycmiQPDT-d78NPUnLEtaQIp4_lvdP9_6PP6yC3Omk1MZJfyA0kihq4_hkyEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuA64OgbC3XgsLuTcUbvbsXY2r14Vdk7oqK1OUOfqFp_w&oe=699D80B5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rv-ILr4VHRQQ7kNvwEP4gEC&_nc_oc=Adn7_rfPYytyd2VUVJ-ERvHIzruhxEYabwVr_vTP2nQRlJWuj4_V4J-28FCvzYtGdiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjO0MAlckLXa9xezD92lcqg5UKkBKbWHtG73nAfXLISw&oe=699DACA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DZO2kRF_QUQ7kNvwGR2b4R&_nc_oc=AdlXHcY0h3XkT6swEAhz9qf9P8hJbc6G-LMTV7rW9loesTRF5mE33qDHEq1U6V3jRMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfutxVs5ZmwKX8n3ZMseyF-Oo6ZXMgoBThZO0qrm_2kB0g&oe=699DB1CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu9nPLSmyHkQ7kNvwGRDQdp&_nc_oc=Adn2qtVkMdaHVF9d-BQKmczbuwXgAvmLjT5kBe51EsNKa2MbahL_IR7I6BjbWe7tOJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftF3alQyTvezrE-uVzrS4YeBw_-JduB-AvQSLH4gMP8jA&oe=699D8EFB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
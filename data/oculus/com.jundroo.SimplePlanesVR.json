974864_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esw7i8hWwCAQ7kNvwHoq9xJ&_nc_oc=Adpn5sEA3t9JdVpIrwoOjK0vg0PbVbkFUNRtCuCLI15h5kSs2LKSR7FmzfRpJRoKAUs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RBI0-cfgsgUhw-wPbnx5naQBONAh4CUiCg5rHoDMBQw&oe=6A369D70"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsSoY5JXK2MQ7kNvwGSdzLN&_nc_oc=AdqJw36A0RTIQdA0ebMPqIe7ROPCACQw7YMyNYW7KZ3zwUyaR3LeBHFvaJnPzpyU43Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F2ZD-unu7WxDmB2ioXSu3-74GNaxXE493TTq5cjTpPg&oe=6A36A6F5"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNEO0dpqVcsQ7kNvwE1Rv25&_nc_oc=Adq8rUAJvkwyPg6_UNipIivPtKv2Hnzli_rpZV2iV0ActYEy7TGF-JeHPw4rQBvOjI4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eB1uvIqEfapp7M3-iO78WAdHnxFN8eBU3vusiNHJdjA&oe=6A369AA3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4WZ_mdmqwAQ7kNvwFsD0L8&_nc_oc=AdrCihNLBi2rkXZvDVwb89fqM8nKsYtZg4a4Iudw9KOf8IwPcUv4doZZhGnADmP-7JY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HjapOU1h6JrKwcM2JdLJq1CzlDZsmPcMsK4db5I1djw&oe=6A369FCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWn2IsOdf2YQ7kNvwHs2y01&_nc_oc=AdpXKRDn6L4FJxefLL46R-yAV_E7e8dQrUtw8m2ZDTXszsKsjNMCP9WxI3yBRT8gmdA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sVUXWrBj0E21fbbwwjgNCbcbWTeIeA6c-NbiJQYyHXg&oe=6A36B53B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881
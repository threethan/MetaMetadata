64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlR935wUq94Q7kNvwHVO7xF&_nc_oc=AdoIzlOOLazNL5-jQlliU-1mKXSxycuJce3Bey4XisAZ7RK8NJhBKo4RlRP9Rb-61Ho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnasYWpHgeLAPMPKD62DmdC5pY_PGv02F8sGaA-rw59Q&oe=6AC650F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK9yv5nIAQ4Q7kNvwHwB3DG&_nc_oc=AdqIFYsu6uinOyrY9bR75Edk_iBuccK8eK5rklrJKTNxpbxpsfH5uCEw3MW_aR2PbAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdBgDZGiKl5JJfLsha2rANVIEXxl3fQltkS1xBRbwG9A&oe=6AC65A75"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6eq7LeNT9sQ7kNvwH7Mqa3&_nc_oc=Ado4BWyhoqDZPkTh1YXtotPWePRDy74D9hwmEANKLwiQFEWU4-MviOg66Uj0piINx5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQN3MF41244Kr_Elirxr25MHW9ygOABfr4R0uzjsAxmA&oe=6AC64E23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoqKGxJwd9kQ7kNvwGwahw9&_nc_oc=AdpZwC8Rwl_GR7BUcRhedSSXVBGuHZxCPkh65R8wu-SMLjYdhSjM64Z-Qw4apKUV4O8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZDM6kEzBQX0oNB_om7BEXA6mn8G6Nv3SsxfROyYsrVQ&oe=6AC6534D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny2eDhbixx0Q7kNvwEYUbJj&_nc_oc=Adqrd4AcsY3wrR1Ad9kR1j5LieKEdUAUpMPDUe4eNf369G0LAMAEfuhaYCw9VzkrEGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYuFMp8hCmq0WtfLgxNnUZ3-0rG8FjZjAcShLWq5GqlQ&oe=6AC668BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
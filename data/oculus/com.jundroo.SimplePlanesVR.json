wGEXKyq&_nc_oc=Adkq_smT0JVbTz2TfUUj7vVhFND24qdcqykPqTlB4FmILXrQ7Z3sqFc9kEcZkj6kWgs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftmTKLZRoFI3XH7ET3LUkwurrM8at--OEw2icctmykLrA&oe=69A1A3F0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWyhpeDNBnwQ7kNvwEEzuVR&_nc_oc=Adme4RPpZHnuIztxOQWqxj4AmDgmenpLxz0VmFW8345dld2th4JZnKYJLJwQxFdLPik&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsX_ygTlronOYRfD885DBzNlfxfdH4T5ejYGP42x2NRng&oe=69A17535"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzV67CCQwKgQ7kNvwF2_SHN&_nc_oc=AdmVXG3Wm9IiCwkdTJAFio8BMCpnZjKDKI03veaxrUndCWZcq_6CkP_ykENyM7o_fyA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvqPERUzVlMunbnml_kTQiS2ECZUBDE8v8fCMnAECNe3Q&oe=69A1A123"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSkX5KiGNUMQ7kNvwEG1A-p&_nc_oc=AdmPdI5A1QSyBDD8wB-EGzINy3c1-ic52S6t4fSSyGQ9N54hIpEk2R_10DG17qDio_Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsBOGW7PG4fYZD9fT6FobfpS7706vrOzrJqX6xpTtLkYA&oe=69A1A64D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPL_aioItX8Q7kNvwFohkIt&_nc_oc=AdkV8bzj3pPkmsOuTZ08nsqpZM0h9HDDpHM4w9GxG-Cho638njtIQhbhKZJIE2f7O_A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afuu1YXPhFDbK0G2jlReggNpWlr7WRphKENa-djFr4cbZw&oe=69A1837B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMEN
64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slW1hmYlxWgQ7kNvwH7_Tp6&_nc_oc=Adom6S-Kl0xs1WFdUbhAQ8DMl2Twt6n445047CyHv_-mePFmPo8_-kurQ3Ew3DEjAK4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvP6y0AQW92yQfSSokY5_5Aaza2hE7p3ut4QPzlSqOag&oe=6A86D0B0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GemMQnerMl8Q7kNvwHLe0Hn&_nc_oc=AdpGt6HAJTsFKGUGDAH2RJKNQqTBKBmkswCaJp6zVkZ1JOvvlpL0HWa_5AmpLjElyb8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5BPNL6zAB8sRrio7YrMqj59S8rWAPa-kT5ah3qgOyag&oe=6A86DA35"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K_U0w1l0hUQ7kNvwGItDcD&_nc_oc=Adpv2XuTwq74C67BFYkDngksHpnoHFy4ySPUQrVV0uOVJaGeC-wNrMEqErm7mSNIe7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzyQf9VEujsTbFk1aAXWNZumK3IEc1QxO1hbrHrC0asA&oe=6A86CDE3"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0d-s6ZCbIwQ7kNvwFZvezs&_nc_oc=AdqHR51r3TNSRhZ1Afjs1N5t87apTirrU4--nD9QOxIslKXTdi4WjQkkuS10ayAijsA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwr4buq02LbHo0Osurl1RLU22BJtmMYT88iP4na-scvg&oe=6A86D30D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHIHaxl1wrMQ7kNvwEp_9YB&_nc_oc=AdrcM6tFgYlqW47RmO6Xq6gu3gIAC3Cy3uDCJoYGNq9eSqeuglHCO-H8JnfHASHO2EE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBvTQB5G8o_qgB_7kyyA-c8nOM50vr84Kc4_eZYKUljw&oe=6A86E87B"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
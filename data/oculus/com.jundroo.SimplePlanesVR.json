64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG3PtJ9E7DgQ7kNvwHzYZSU&_nc_oc=AdrpzhhKu7zzy-5Q_Kl42Ct0wxioBVozfyPnYiVbMNIgnqjQKgCruJbK8Pu5T2zOGW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGR2yDc9ucb46CTcPgIethnuyGJVDnHPQeL6piFndtcQ&oe=6AA6ACF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9Kf_JtFu3AQ7kNvwHqNnwD&_nc_oc=AdrKEWu4KKLKUf5W4_UVMjsRywlocQe-So4hjJvrzRH6gJ5Vp3s8FIk19CK1WW7w3cc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1XBQb3IMH6Gi_pKFuGSr7EutwC3_NTnNkhfZbAOA8qg&oe=6AA6B675"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ETF6UsN7uAQ7kNvwE9zipj&_nc_oc=AdraUqWIoKeLRN8ZYigcx55-8G06VvV4eun9Fu8o25IHsUcPKAO6VjLQyX2Lio1OuHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx9_fkcZEowgdSm91fB8GX5iYD6jgxXi2OuCytTVqvuQ&oe=6AA6AA23"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV9VcUy5TY8Q7kNvwGywJud&_nc_oc=AdrcUzd7xcY9sGNjQfs7ItxHTCc_Cy6y6sFpxqlE7VqA3bhw0wujHQSwg4UX5x8QpGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT3UllUMLdP_FqY-t_pjVfV88UmeibJenaEiwC3kgunw&oe=6AA6AF4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcjoxB0jFesQ7kNvwFb_faP&_nc_oc=Adr7NU2tYGVC4pbU2MXrodukzTxlLqE5Q3j1C8DY0qzQq-KxPhSueomuFkU9CFVnZpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtIX7taoeRSEOO_hQGnoMcZ5fuY3f2H33SjGz-LfRlaA&oe=6AA6C4BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
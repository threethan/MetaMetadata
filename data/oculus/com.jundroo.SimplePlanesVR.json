64_365723738665296_4698306716880597083_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3h3dP9m9kMQ7kNvwG519S7&_nc_oc=AdoMUjho3UjJfLkL0FG-UrGza2mKAWOcd69rNeRcDUkL8BCJM4GvvaLIwxTJOr7SeZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8KI1BWVhx1SjbmBOV8ogThZczh7q3mtJOkh0RYXfdCQ&oe=6AC10AF0"}, {"file_name": "screen_2560x1440_2021-11-02_18-32-53.png", "id": "650809172745088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_650809176078421_7973338013545744226_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VqCM9w8BMMQ7kNvwFQT_AP&_nc_oc=Adrn4cfQeULZX8FG832z17-3ip2CG8flhqDFxnn3TPVrA1jfFrn0glJPV5B4vZn-bqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWaWxqgSkQvrkQUvPZO6BnDyaKF9nEMYWAcdtBq4tYDQ&oe=6AC11475"}, {"file_name": "screen_2560x1440_2021-11-02_18-34-41.png", "id": "907919173430105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_907919176763438_5345780595119107469_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ECUd7lz2jwQ7kNvwGEfvNt&_nc_oc=AdoNbeHbNsOC0ZhS6D0t8lZJ5oEu8udSjXzorPmikDstzWw2bVyRx4YvvV9fkkNQw6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_KiLcwD8iHvzGYBeCm9y0ZUpsUjxnV4OdECpwhu-65A&oe=6AC10823"}, {"file_name": "screen_2560x1440_2021-11-02_18-37-18.png", "id": "909814363296538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_909814369963204_3199125655487034061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nje4-sBs-kgQ7kNvwFYh9uU&_nc_oc=AdrgnTwRXcPK3dFfC0csSwb2czbA5Y9qjcoTrq7ewHSu6H1Azs1uTkx9h9-dvMjth3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm_dfXAgRzWx1b8IK0SiAOgUgfeYMrJzV1K932_BgiWw&oe=6AC10D4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "675794583341224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_675794586674557_7604741986100865191_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfm6NH9Kx3QQ7kNvwHrtBeI&_nc_oc=Ado1_T7RCuensyzlg_TkRCLRqOlMCjmkRgrNUHCEJqUvdpezs4lu5dAXW8ERbTkmtLk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYO649MZP0xIVbgKiS0PF3waGPsTrEEIVAWPTWzCaWLw&oe=6AC122BB"}, "display_name": "SimplePlanes VR", "keywords": [], "long_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n\n\u25cf Crafts with fully immersive cockpits have virtual controls that you can reach out and grab with virtual hands.\n\u25cf Download and fly crafts from SimplePlanes.com for free. Even if it does not have a fully immersive cockpit, you can still fly from the chase,  orbit, and fly-by camera modes.\n\u25cf Engage enemy aircraft with air-to-air missiles, such as the Guardian which is a highly maneuverable short-range missile, or fire and forget with the long-range Interceptor missile.\n\u25cf Assault ground threats with an extensive arsenal of air-to-ground weapons and sink ships with torpedos.\n\u25cf Multiple islands and airports to explore.\n\u25cf Several racing courses and other challenges.\n\nNote: Just to be clear, you can't build aircraft in SPVR, but you can download and fly crafts from SimplePlanes.com.\n", "short_description": "SimplePlanes VR is a flight sim with an ever-expanding collection of aircraft to download and fly for free. Airplanes, helicopters, cars, boats, and more are available and new crafts are added every day.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jundroo.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Jundroo, LLC", "support_website_url": "https://jundroo.com/", "website_url": "https://www.simpleplanes.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"
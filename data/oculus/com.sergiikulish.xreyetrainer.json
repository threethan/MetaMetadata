: "1620412989694066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595129854_1620412993027399_763862803591915535_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5cnENAIcbUQ7kNvwFOlsmD&_nc_oc=Adozk2hQys41hTJzNS2HZOYbulgbzOdluMa-SoK9sWSH8c_Pn10oe6wMRR5-fCMUzCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-je0BPmIssrzNznAl5isuK0eIXWgpyh41486q-FbO2w&oe=6AFDB60F"}, {"file_name": "02_xr-eye-trainer_2560x1440.png", "id": "4626160784285436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673780696_4626160787618769_4178825961812789051_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPMpfKSE5j4Q7kNvwHZALa4&_nc_oc=AdrjqvvOWb6t293yNXI8uj0lqDKvCSXwHtQsMfKJEcDq4bVCjEz8o8ahUU0q6T6AMpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToSHcn19Mj_uFYHK83AvgGJoj5o_PXbYBgIueyF63JIA&oe=6AFDB1FE"}, {"file_name": "03_xr-eye-trainer_2560x1440.png", "id": "1080429881513202", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673716021_1080429884846535_8049441113925289210_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B_XA3_PKcEQ7kNvwFNcJ4J&_nc_oc=Ado6EMCEx0Xl-jvXqQjN7C5qQ7GAjctnjh2U1EKXwmeyB_gQ-PHUEhvwyRFfkkg0e0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQWY-9Fk69W6X6QXfXD8uwiElsWS0QdbkDWgam9pFYMA&oe=6AFDDAA4"}, {"file_name": "04_xr-eye-trainer_hands_2560x1440_upscaled.png", "id": "941329915702696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604310912_941329919036029_8217551946959676285_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNhHJGGWimMQ7kNvwFnSGdO&_nc_oc=AdpmzYezGmTH8X4xEH8DR1Dz3LzYtnu0eOTURNxSYhmARkQxdL-lz4UN4oXlLBr2y6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6L9JUarbOM4IS3w5lB4EQP3iV8MZ0eDmisBxUpUFpqA&oe=6AFDBABE"}, {"file_name": "05_xr-eye-trainer_wrist-hands_2560x1440_upscaled.png", "id": "2956640734728405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_2956640741395071_3404607274021422567_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6TxzDOOVPQQ7kNvwEjZzno&_nc_oc=Adqvr7a3JJ0DaKkLnGmD99Cmxd10_CTcBhZ1fTnWKMMTOvNMol74PBVpcKBlQsGk47g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-wGsqTR1Ps11Q_1uoYwnu8Y3DGY3IA95tUQcqIYtZKw&oe=6AFDB28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1822615992421086", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/786297305_1822615995754419_6149783115424784690_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=604Y2eRsrVkQ7kNvwFSLP6n&_nc_oc=AdpZn4g55WdW3e-AG2Fy14g6T0LQCfLrZJZA1ecuMFvoL-2rw1vBbr3lfG6SJB6Q68o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnuh4F_-35iBEk9rMlR1tUW-JwzNlLEPo7O_3DtWt6vQ&oe=6AFDD3D7"}, "display_name": "XR Eye Trainer", "keywords": ["eyes", "exercises", "vision", "training", "passthrough"], "long_description": "XR Eye Trainer turns classic eye-movement drills into short Mixed Reality routines. You see your own room through passthrough, follow a target with your eyes and keep your head still.\n\nHow to start\nPut on the headset: a start panel appears in front of you. Choose \"Start guided session\" or pick a single exercise. Exercises end on their own and bring you back to the menu.\n\nGuided session\nA ready-made routine: vertical and horizontal tracking, diagonals, rectangles in both directions and clock-face target hops, with short pauses to blink and rest.\n\nSingle exercises\nSmooth pursuit: Vertical, Horizontal, Diagonals A and B, Square, Diamond, Circle CW and CCW, Lemniscate.\nSaccades: Target Hop, quick jumps between points to sharpen focus shifts.\nEach exercise runs 10 full cycles and stops.\n\nMade for comfort\n- Mixed Reality: you always see your surroundings\n- Works with hands or controllers\n- Wrist menu: speed, target size, trajectory size, room dimming\n- Gentle tick sounds keep the rhythm; a reminder appears if your head moves\n- Fully offline, no account, no ads\n\nDisclaimer: XR Eye Trainer is not a medical device and does not provide medical advice. If you have any vision concerns, please consult a qualified eye-care professional.", "short_description": "Eye exercises in Mixed Reality. See your room through passthrough, follow the target with your eyes and keep your head still. A guided session or single drills, ending on their own. Hands or controllers. Offline, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-xr-eye-trainer.html", "developer_terms_of_service_url": null, "publisher_name": "Sergii Kulish", "support_website_url": "https://xr-meta.com/support.html", "website_url": "https://xr-meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38721762297438524"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_2118916489499291_4655635833558409572_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMAKziIG2zQQ7kNvwFlbcaK&_nc_oc=AdqsFAoMuYDRY9jgUvzDr1AUsGu7aOKWjv9zFmU-_sFuzoUK-By4w5pisda8iz3X4As&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScY02RYTPjqlqJMeA0c
id=6e7a0a&_nc_ohc=INAEH--87yYQ7kNvwHMORnz&_nc_oc=AdokhRUB1ouUfynS6zFC7oCWTDwniM8oHBvYx_y3cHgSXdY_iR2uzDAgn8GEl9AJ48o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjQYpTh24fkmbBXy__YMkGAMN_OsTjOjFZ3_VOnemFUA&oe=6AD235AD"}, {"file_name": "xr-eye-trainer-rectangle-2560x1440.png", "id": "1508360890358966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830016_1508360893692299_7017143899253683476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhyuK5pyiSYQ7kNvwHgNmHJ&_nc_oc=Adp0UE26eBo9RH1UeBObLs_Pq0FzauUhH8Av96AIdSdfHCzfo7Dq3o3I6jLD8suIioM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7-eseoU5DuGePKFgCvelPc_RTvgx2Y0FqajnF-CxqxA&oe=6AD24445"}, {"file_name": "ball-xr.png", "id": "2286059415163527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_2286059418496860_2621248768385387585_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtg_iYY_9yQQ7kNvwH2DYGd&_nc_oc=AdptnOw1bBblRcSTHBBh7XW3yfihaPkGEw0T8nmHVDz_HngXzD3XTKM2kg9Av_pe5Gg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK3ljdT1kXmCALtesaaJu4gMo_npy6zWc1RVwIt7Vg-Q&oe=6AD22F5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "xr-eye-trainer-2560x1440.png", "id": "1341306647599418", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821886_1341306650932751_1504352793844008887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHLP-3repBkQ7kNvwGQW8s2&_nc_oc=Adpy-5RTIrs-bZrV7AIjWUs70bJyqZzY3w8AqIWkUm3qS-GbVwyKdwypJh_gCdxBqIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF-xv-veJ8pe2BDLNf5Nxb1RFPx_5PxwJnZTTu-YC4GQ&oe=6AD24042"}, "display_name": "XR Eye Trainer", "keywords": ["eyeexercises", "Visiontraining", "Saccade", "eyeworkout", "focustraining"], "long_description": "Build a healthy eye-movement habit in Mixed Reality.\n\nXR Eye Trainer guides you through short, focused routines:\n\u2022 Smooth Pursuit \u2014 follow the target horizontally and vertically\n\u2022 Diagonals \u2014 gentle diagonal tracking for variety\n\u2022 Target Hop \u2014 quick saccades to boost precision\n\u2022 Clock \u2014 clockwise/counter-clockwise drills for control\n\nWhy it works:\n\u2022 Clear voice cues and subtle ticks keep the rhythm\n\u2022 Short pop-up prompts between steps prevent guesswork\n\u2022 Wrist menu for instant Start/Stop and quick adjustments\n\u2022 Scenario mode runs a full routine automatically\n\nDesigned for comfort:\n\u2022 Mixed Reality keeps you aware of your room\n\u2022 Adjustable speed, size, and repetitions\n\u2022 No account required. Works fully offline. No ads.\n\nDisclaimer: XR Eye Trainer is not a medical device and does not provide medical advice. If you have any vision concerns, consult a professional.\n", "short_description": "Train your eyes in Mixed Reality. Guided routines, voice cues, easy results.\n\nMixed-reality eye exercises with step-by-step guidance and gentle sounds.\n\nEye workout in MR: smooth pursuit, saccades, clock drills\u2014simple and effective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-xr-eye-trainer.html", "developer_terms_of_service_url": null, "publisher_name": "Sergii Kulish", "support_website_url": "https://xr-meta.com/support.html", "website_url": "https://xr-meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
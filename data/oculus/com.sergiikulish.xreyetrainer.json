: "1620412989694066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_1620412993027399_763862803591915535_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei0mswS_u88Q7kNvwFIFunV&_nc_oc=AdrMDmjqqyKcGviRB0-174s_6UPQrhLkqou2v84grV6Uo5dTJ1LpBBRN586_v4HVZAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3TGjcTNzlavnGJuZ5Ev1Lw75uT10Te2-ABPoqigP_3Q&oe=6B01E2CF"}, {"file_name": "02_xr-eye-trainer_2560x1440.png", "id": "4626160784285436", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673780696_4626160787618769_4178825961812789051_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIVu1hJHKEUQ7kNvwFj0X0v&_nc_oc=Adonlf7Um8CpmjIELqrIbIithHwmFvAwuTtFsKaUaNylvnsLgMx6IPztzdR5XR-UIy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGWip49tGt1Uo3XpfKdi4xWRxsw1jVkHhuY0vmRHBsWQ&oe=6B01DEBE"}, {"file_name": "03_xr-eye-trainer_2560x1440.png", "id": "1080429881513202", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673716021_1080429884846535_8049441113925289210_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0LnZh5EbokQ7kNvwHALD-X&_nc_oc=AdrTtfC-Z1gLpCY85kpgQHq3YBr-sSyT4rAJUw8I04omrXC6Upe4uF14ltSaT_dbWGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyek06GtoITdSx7P0-XJt8NrfN0HGg41xMry8X9yEZWQ&oe=6B01CF24"}, {"file_name": "04_xr-eye-trainer_hands_2560x1440_upscaled.png", "id": "941329915702696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604310912_941329919036029_8217551946959676285_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnmAaJN-J2IQ7kNvwHasP1i&_nc_oc=AdqB-wzyw1mhR4PcT4Y2Cw-O5C8KoYbUaTnJoLrqT5Wugp0cEB523KGEHvqC4YCPKSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXvf2e_5ScZx-6mfakBeGuinpY_YOooI5Am9Mko0jFzQ&oe=6B01E77E"}, {"file_name": "05_xr-eye-trainer_wrist-hands_2560x1440_upscaled.png", "id": "2956640734728405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_2956640741395071_3404607274021422567_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd7B_nnbtVUQ7kNvwEx9KD-&_nc_oc=Adp96TOMwlSqdGuy22VDTyT37Kq-S36LgWVRed16Z7RkMqjCyV_agpZ5yvJ88cdm8RU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7ZX2zZzz_ud25cVkQy1ulFegJNpu1pV5_f35fysUqtQ&oe=6B01DF4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1822615992421086", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/786297305_1822615995754419_6149783115424784690_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWcmu7QNrV8Q7kNvwGvXM18&_nc_oc=AdpEVLWjiGuY2VP7Vj-1zbqkNeTjvMUnBSYlK6S9y94963emN_HICopodl6w9TkhEOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlMyXGNy2-12_eZLHNhkjh6FgQkQHZJ8ggCjMVDtKuiQ&oe=6B01C857"}, "display_name": "XR Eye Trainer", "keywords": ["eyes", "exercises", "vision", "training", "passthrough"], "long_description": "XR Eye Trainer turns classic eye-movement drills into short Mixed Reality routines. You see your own room through passthrough, follow a target with your eyes and keep your head still.\n\nHow to start\nPut on the headset: a start panel appears in front of you. Choose \"Start guided session\" or pick a single exercise. Exercises end on their own and bring you back to the menu.\n\nGuided session\nA ready-made routine: vertical and horizontal tracking, diagonals, rectangles in both directions and clock-face target hops, with short pauses to blink and rest.\n\nSingle exercises\nSmooth pursuit: Vertical, Horizontal, Diagonals A and B, Square, Diamond, Circle CW and CCW, Lemniscate.\nSaccades: Target Hop, quick jumps between points to sharpen focus shifts.\nEach exercise runs 10 full cycles and stops.\n\nMade for comfort\n- Mixed Reality: you always see your surroundings\n- Works with hands or controllers\n- Wrist menu: speed, target size, trajectory size, room dimming\n- Gentle tick sounds keep the rhythm; a reminder appears if your head moves\n- Fully offline, no account, no ads\n\nDisclaimer: XR Eye Trainer is not a medical device and does not provide medical advice. If you have any vision concerns, please consult a qualified eye-care professional.", "short_description": "Eye exercises in Mixed Reality. See your room through passthrough, follow the target with your eyes and keep your head still. A guided session or single drills, ending on their own. Hands or controllers. Offline, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-xr-eye-trainer.html", "developer_terms_of_service_url": null, "publisher_name": "Sergii Kulish", "support_website_url": "https://xr-meta.com/support.html", "website_url": "https://xr-meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38721762297438524"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604370996_2118916489499291_4655635833558409572_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psJrhRPbJREQ7kNvwFPpd0g&_nc_oc=AdqGhyA9Kpeuc-7qLGQyk2_ACV6RoIbFEmIvui5JubZPyX8XCBYiXBIGpLxEcfxB6KU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1dyO9xfD-1ZZnYwnbe
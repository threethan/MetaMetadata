: "1620412989694066", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/595129854_1620412993027399_763862803591915535_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5cnENAIcbUQ7kNvwF_3HXn&_nc_oc=Adoai2jDHvRc-IH3u7T2SJwxANxSqZ8UIWqAt_-6hk9AG5-Vm0EYuHI9mYHcwewN-pM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQPHFtegOUt1xjXuqWLhbyv-x1mx7yo9BOGfoWQXNTdA&oe=6AFC648F"}, {"file_name": "02_xr-eye-trainer_2560x1440.png", "id": "4626160784285436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673780696_4626160787618769_4178825961812789051_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCHgJLRHGgkQ7kNvwE6Cxd-&_nc_oc=AdpxlzdtHNOxAhdq1AneOU7sygy_kNLYa3Us1aUS4z33W8qiGlUW5sMnEgSjW4YNdBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxSFqrG5lMPixmSpJ7t1WTB0SYdWzPGU48OmvggDznSQ&oe=6AFC607E"}, {"file_name": "03_xr-eye-trainer_2560x1440.png", "id": "1080429881513202", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1080429884846535_8049441113925289210_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lGz7f1xF84Q7kNvwGD-YxA&_nc_oc=AdqSd5kf3TmFWQ7YbLfPoBMdIRSuQ8MB-WCEoRBTCDcfHkT7O5Vd4XcODzwGusy8xyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUn-q4AHiPJZjcfNbEaWA-y8e219yua3EbFE0ggL2Jwg&oe=6AFC8924"}, {"file_name": "04_xr-eye-trainer_hands_2560x1440_upscaled.png", "id": "941329915702696", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604310912_941329919036029_8217551946959676285_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNhHJGGWimMQ7kNvwHTqd-A&_nc_oc=AdoO2tLpREVMGNNZOJXkMJwD_JYhtHy8-K483myS7a3QadbdtV3Uk-BHrrdapZza_yk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbIHsx-LSaJ8PH1-kcchfsdJq3nZzLqXa0Ntmvjzacvg&oe=6AFC693E"}, {"file_name": "05_xr-eye-trainer_wrist-hands_2560x1440_upscaled.png", "id": "2956640734728405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_2956640741395071_3404607274021422567_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6TxzDOOVPQQ7kNvwH5tfHV&_nc_oc=AdpfxX3hop-zIzQpuo9EYPIeAaHJUiRKjkoVOkKSwrPj-2Qk0_Tl_GSTohpGQ7Aj7zA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM35Y5jGsPv-NQh0B6TL6_Iq9L0Fp2sR53OZCxRAq1Gg&oe=6AFC610C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1822615992421086", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/786297305_1822615995754419_6149783115424784690_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=604Y2eRsrVkQ7kNvwHhA2iv&_nc_oc=AdqP0w0rry_dBRZrUUVikAJ-tLe4_bTlumIV3Xy7vUVbEDnnD8enTtmUJTf4TuceikM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwRXSMW2po-euanpBGoUMKiAIMqYB9IG0FIjGQkZ5VmQ&oe=6AFC8257"}, "display_name": "XR Eye Trainer", "keywords": ["eyes", "exercises", "vision", "training", "passthrough"], "long_description": "XR Eye Trainer turns classic eye-movement drills into short Mixed Reality routines. You see your own room through passthrough, follow a target with your eyes and keep your head still.\n\nHow to start\nPut on the headset: a start panel appears in front of you. Choose \"Start guided session\" or pick a single exercise. Exercises end on their own and bring you back to the menu.\n\nGuided session\nA ready-made routine: vertical and horizontal tracking, diagonals, rectangles in both directions and clock-face target hops, with short pauses to blink and rest.\n\nSingle exercises\nSmooth pursuit: Vertical, Horizontal, Diagonals A and B, Square, Diamond, Circle CW and CCW, Lemniscate.\nSaccades: Target Hop, quick jumps between points to sharpen focus shifts.\nEach exercise runs 10 full cycles and stops.\n\nMade for comfort\n- Mixed Reality: you always see your surroundings\n- Works with hands or controllers\n- Wrist menu: speed, target size, trajectory size, room dimming\n- Gentle tick sounds keep the rhythm; a reminder appears if your head moves\n- Fully offline, no account, no ads\n\nDisclaimer: XR Eye Trainer is not a medical device and does not provide medical advice. If you have any vision concerns, please consult a qualified eye-care professional.", "short_description": "Eye exercises in Mixed Reality. See your room through passthrough, follow the target with your eyes and keep your head still. A guided session or single drills, ending on their own. Hands or controllers. Offline, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-xr-eye-trainer.html", "developer_terms_of_service_url": null, "publisher_name": "Sergii Kulish", "support_website_url": "https://xr-meta.com/support.html", "website_url": "https://xr-meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "38721762297438524"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_2118916489499291_4655635833558409572_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMAKziIG2zQQ7kNvwGbhKhq&_nc_oc=Adr1_mGVswqtURPNqXTvPBqzGVDQL6GWnzg8ZtL3dKh4KjEaUGMASPuimTam9bGTbkk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPg4RyZ57U58_aGxQEh
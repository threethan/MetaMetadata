40.png", "id": "1785136372208039", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623314_1785136375541372_7482942574136971_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki70MGvdIIYQ7kNvwGIa8PL&_nc_oc=AdrLunmvk8V7YeTCubdzZ2NWWLZUxgfD54753epiEcURpeLxn6hCz3YNV2WYJYHe8-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtNESbI_DGi6bp4q0Z1M_854DyWpvMYje57ihOKsz5Lg&oe=6B05C095"}, {"file_name": "xr-eye-trainer-2560x1440.png", "id": "1339261370937023", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618039_1339261374270356_7721459712022475105_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv73-iXbcUIQ7kNvwF2W4AR&_nc_oc=AdoT5rLjSVr48XZ0ssoXA1dAfFQ3Y08afmSJ-yBzIjA-nFr7XKIZMIMJmDWbkCJJSiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcwO-IBV4fbfDrTSJ2-VGRqhA1hvH4RWa7YdpUFMiwSA&oe=6B05D86D"}, {"file_name": "xr-eye-trainer-rectangle-2560x1440.png", "id": "1508360890358966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830016_1508360893692299_7017143899253683476_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1kA10GiE_0Q7kNvwFgMEBH&_nc_oc=AdruCcyAX8-jZO7ZmlXDfFO5ja2KmqT-lvv_ZczCxYBhHQhPvydEdK_FfTA432t9MEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwnaU-hUb8B-4FHyZdLgmXq1asaN6RE_gPkSq2h3x6Pw&oe=6B05AEC5"}, {"file_name": "ball-xr.png", "id": "2286059415163527", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617775_2286059418496860_2621248768385387585_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIyAf2g27vMQ7kNvwHpwvl_&_nc_oc=AdpMyPgYXFkVGdXqZILq5n_DAAOPWlWBudhVzmEmaivA-8I5_RdT9Yaf6w6YO0-_nt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTEjaEHWdq_pnuCq0Xub0xnk7lRh8KE1RpIIi4Sye0aA&oe=6B05D21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "xr-eye-trainer-2560x1440.png", "id": "1341306647599418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821886_1341306650932751_1504352793844008887_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIxp0bLH2B0Q7kNvwF85H_g&_nc_oc=Adpkhbotg84BGEikGY5mBwsDNpt2VblrhseImT_QOmAQvZx7H2XWJ5cI7KfnFldy9C0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThfHxHcRbfVsyWtEJK433rEPD4TnVoZj0ftOC2s8jyLQ&oe=6B05AAC2"}, "display_name": "XR Eye Trainer", "keywords": ["eyeexercises", "Visiontraining", "Saccade", "eyeworkout", "focustraining"], "long_description": "Build a healthy eye-movement habit in Mixed Reality.\n\nXR Eye Trainer guides you through short, focused routines:\n\u2022 Smooth Pursuit \u2014 follow the target horizontally and vertically\n\u2022 Diagonals \u2014 gentle diagonal tracking for variety\n\u2022 Target Hop \u2014 quick saccades to boost precision\n\u2022 Clock \u2014 clockwise/counter-clockwise drills for control\n\nWhy it works:\n\u2022 Clear voice cues and subtle ticks keep the rhythm\n\u2022 Short pop-up prompts between steps prevent guesswork\n\u2022 Wrist menu for instant Start/Stop and quick adjustments\n\u2022 Scenario mode runs a full routine automatically\n\nDesigned for comfort:\n\u2022 Mixed Reality keeps you aware of your room\n\u2022 Adjustable speed, size, and repetitions\n\u2022 No account required. Works fully offline. No ads.\n\nDisclaimer: XR Eye Trainer is not a medical device and does not provide medical advice. If you have any vision concerns, consult a professional.\n", "short_description": "Train your eyes in Mixed Reality. Guided routines, voice cues, easy results.\n\nMixed-reality eye exercises with step-by-step guidance and gentle sounds.\n\nEye workout in MR: smooth pursuit, saccades, clock drills\u2014simple and effective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-xr-eye-trainer.html", "developer_terms_of_service_url": null, "publisher_name": "Sergii Kulish", "support_website_url":
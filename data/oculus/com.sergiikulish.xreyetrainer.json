id=6e7a0a&_nc_ohc=fPEhwkWOz-QQ7kNvwFrLUK4&_nc_oc=AdpQMkBdcFbahgW0unMR-gxK6sU5KA3Ylt30T3q_WoM3sJwA6fR6DDI6mz7GSxwZflI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-DEEy4CaKWqGvy7d3a00tPVAbhhRp262ooBc5QRZ-Iw&oe=6AF47CAD"}, {"file_name": "xr-eye-trainer-rectangle-2560x1440.png", "id": "1508360890358966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830016_1508360893692299_7017143899253683476_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHrgwsbmT5EQ7kNvwFuZK4s&_nc_oc=AdoPPd9KuH2YgnZXgv311db4gBpviAQGqSpp3qU8oPOiacU84FnycyR2-k3ApPKD0QA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4nA-unxkGky6XKOBxFo0dky09ufqxhRw83rlO-Q_cCg&oe=6AF48B45"}, {"file_name": "ball-xr.png", "id": "2286059415163527", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617775_2286059418496860_2621248768385387585_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHEyhrcXGGoQ7kNvwGvE9aB&_nc_oc=AdpUGwv7vIpoGwxK0y5OiagnAEanvuxedRKpi2mAgdgfdC4xKG7zb35cVFlPDXn_lNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMITIx9VKIVHxGi-8aia51RE8sBNJqcBXiYY5xPFKO4w&oe=6AF4765B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "xr-eye-trainer-2560x1440.png", "id": "1341306647599418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821886_1341306650932751_1504352793844008887_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziTQiSil8X4Q7kNvwFH3Pu0&_nc_oc=Adr4G_uTCjvZJ3OK8YKYKBgSZCeLI7i0B0wHULKDQR58XRcTM1dtgL8usgdowU3yQ04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ62ub-0GwiyM8ncyhXk7K87X_LaWe7b8Gi2GstXAEDlw&oe=6AF48742"}, "display_name": "XR Eye Trainer", "keywords": ["eyeexercises", "Visiontraining", "Saccade", "eyeworkout", "focustraining"], "long_description": "Build a healthy eye-movement habit in Mixed Reality.\n\nXR Eye Trainer guides you through short, focused routines:\n\u2022 Smooth Pursuit \u2014 follow the target horizontally and vertically\n\u2022 Diagonals \u2014 gentle diagonal tracking for variety\n\u2022 Target Hop \u2014 quick saccades to boost precision\n\u2022 Clock \u2014 clockwise/counter-clockwise drills for control\n\nWhy it works:\n\u2022 Clear voice cues and subtle ticks keep the rhythm\n\u2022 Short pop-up prompts between steps prevent guesswork\n\u2022 Wrist menu for instant Start/Stop and quick adjustments\n\u2022 Scenario mode runs a full routine automatically\n\nDesigned for comfort:\n\u2022 Mixed Reality keeps you aware of your room\n\u2022 Adjustable speed, size, and repetitions\n\u2022 No account required. Works fully offline. No ads.\n\nDisclaimer: XR Eye Trainer is not a medical device and does not provide medical advice. If you have any vision concerns, consult a professional.\n", "short_description": "Train your eyes in Mixed Reality. Guided routines, voice cues, easy results.\n\nMixed-reality eye exercises with step-by-step guidance and gentle sounds.\n\nEye workout in MR: smooth pursuit, saccades, clock drills\u2014simple and effective."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-meta.com/privacy-policy-xr-eye-trainer.html", "developer_terms_of_service_url": null, "publisher_name": "Sergii Kulish", "support_website_url": "https://xr-meta.com/support.html", "website_url": "https://xr-meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
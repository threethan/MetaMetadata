G_ivLg&_nc_oc=Adr2E6I9xZzQKFbRbM7Pf4B_k-aQSNiZNb4OrlMX930vJTsN5SJQuGJVNc_QSrUDiGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7aAlijDQwVbn26wKzscUSK6TNl9f-Zhf7jfJZzBB4Xg&oe=6AD39FF6"}, {"file_name": "Frame 9.png", "id": "1727265291690749", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821704_1727265295024082_1532615313812184844_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2oGwgbNkggQ7kNvwHspi9m&_nc_oc=AdrsI4_A9UywdL499slyzWaGsKhOVTWjiPFz0KcKOoocSIDxhfv6ST8eIicLZdBsH3k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3h2f_IBosjTbni8f48A_SZnk7-pZ2W1UgrJFeaCNQ_A&oe=6AD3A0FE"}, {"file_name": "Frame 13.png", "id": "1103824555324350", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821796_1103824558657683_9122818644602408293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4yzyB-_NAAQ7kNvwGTDqiX&_nc_oc=AdqZnt2B1qMnqCqHknwXnV235Sw3J35q55kbfjz8ZwPzrHhX1WGQbAjQssY69wDMtho&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAANSe5DxG2_tJ3pjdbZ64Msi8nnYz-IWGo5KgHLWhvg&oe=6AD3BC0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phyn - Jellyfin Media Player", "keywords": ["jellyfin", "phyn", "media", "movies", "ebooks"], "long_description": "Phyn is the media player for the Jellyfin library you control. Stream films and series, browse Live TV, enjoy music and audiobooks, and keep your eBooks together in one polished app.\n\n**Discover more to watch**\n\nExplore new movies and TV shows, see what is popular, and use personalised recommendations based on your viewing preferences.\n\n**Stay on top of releases**\n\nLink your Trakt account to view a live release calendar for upcoming episodes from the shows you follow. Calendar availability depends on your plan and connected account.\n\n**Watch with control**\n\nPlay your library with rich playback controls, subtitles, picture-in-picture, and casting to compatible devices. Browse your collection and Live TV guide with an interface made for finding what you want to watch.\n\n**Watch in 3D on Meta Quest**\n\nEnjoy your library on a virtual cinema screen or in mixed reality. Play 3D videos in full or half side-by-side (SBS) and full or half top-and-bottom (over-under) formats, with immersive playback controls and subtitles.\n\n**Read more comfortably**\n\nOpen EPUB, PDF, Mobi, AZW3, CBR, and CBZ books. Use the improved reader and read-aloud voices, then send highlights and notes to Readwise.\n\n**Listen anywhere**\n\nPick up music and audiobooks where you left off, with lyrics where available.\n\n**Take your library offline**\n\nDownload supported films, episodes, music, and books for travel and times without a connection.\n\nPhyn connects to a Jellyfin server you control. It is not affiliated with Jellyfin.", "short_description": "Your Jellyfin library for video, eBooks, music, Live TV and offline downloads. Watch, read & listen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://phyn.app/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Appsynergy technology solutions", "support_website_url": null, "website_url": "https://phyn.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "de", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27641535695520663"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED
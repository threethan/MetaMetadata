s and improvements!\n\nOptimized for Quest 2\n", "short_description": "Destroy objects using ultra realistic physics in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": null, "publisher_name": "VirtualGo LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/games.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "502045561244047"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314850_943087966330494_7835413087316449514_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjXMOHHjOXgQ7kNvwEXMyR4&_nc_oc=AdpJzmAFssY5NGoKeSLwW5rgph2Rus-6QxGXVf2vjztD9T4jbhg-gXmj3Dba5oiiD3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp2qJQGa95iaTe58jPwwaZeLt981rI4C8bnI7Dkfpb6Q&oe=6B0055CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sledge Destruction Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1645058603, 
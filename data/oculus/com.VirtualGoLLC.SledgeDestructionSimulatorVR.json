g", "id": "1231559580922126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982512_1231559584255459_3263599359729430769_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO7_sARxe68Q7kNvwGVIa16&_nc_oc=AdqDrIYIbEl_avvjmCZJPImqwrzA9Yimk18mUmTDOMSh-5RbxExGj-tQyUymQgiPuUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0YjDpa5ydO7Ngmxr_3EfIPKlRJIt5VZzMsQFykjjdnQ&oe=6AAFE5A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1347685675683843", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375754_1347685682350509_4888383940291227195_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCuwA0QDPboQ7kNvwHTphEA&_nc_oc=AdoxRImkZ4lqom-7E5G3tIwJOjWTR0goEVBdXhhgOy4sEBp_GuobtzhOsmDp36WGKfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzo423MSOy85aTgJnpnmFcOib_JbXZe-3WFolo6Z9x9w&oe=6AAFD764"}, "display_name": "Sledge Destruction Simulator", "keywords": [], "long_description": "Sledge Destruction Simulator is a physics based VR game that allows you to destroy a large variety of objects with a sledge hammer and other props. The sledge hammer and props respond to weight and swing speed. The objects that you destroy are collapsible and can be destroyed in millions of different ways.\n\n40+ Objects and structures to destroy.\n\nThe most destruction physics that the Quest 2 can handle.\n\nStay tuned for updates and improvements!\n\nOptimized for Quest 2\n", "short_description": "Destroy objects using ultra realistic physics in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": null, "publisher_name": "VirtualGo LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/games.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "33152918813
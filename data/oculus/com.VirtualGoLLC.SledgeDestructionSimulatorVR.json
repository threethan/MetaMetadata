oJmqZ56F3YcYIL4JLsm7XUicwgoTeaVQKv3-nw1GIaw&oe=6AFDACD4"}, {"file_name": "pol.png", "id": "475341777478296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_475341780811629_2058537125130472792_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoJYUIitA28Q7kNvwHUZSdZ&_nc_oc=AdorymkOyzh9agRmzR1MGw3Nr70dmut5YTUFZb0nhVMPKFoQiE98O_pF-P0fT9MEP78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvlHFlhbNLYoU9e-VFW9FhndDlkDY7jsa4nHRoGDQGBQ&oe=6AFDBA3F"}, {"file_name": "5r6.png", "id": "1231559580922126", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1231559584255459_3263599359729430769_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXhitSXahqAQ7kNvwHqwY29&_nc_oc=AdpRC1WIP5hqgcVMZdMlqAbGfPeiOSzpYGAd2Avla-RP_osQ67u-zZgiXEMB4eBL4gQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyhn4jIrPopiZ3JX8yZ4Tb76D5ZbaIt4RKYgzIKu0ONA&oe=6AFDAE25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1347685675683843", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375754_1347685682350509_4888383940291227195_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yd01ArSymkUQ7kNvwFXhhmV&_nc_oc=Ado9QbicFTaUaOS64vNdPyftSP9Iw__DIUkLxBRd-Xo3al686k22L6_FimOVsg4Hwws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvWCUZjh--e7JgnCQ3lIxb6FTbUaUIYdxOAtzN1fvMgQ&oe=6AFDD824"}, "display_name": "Sledge Destruction Simulator", "keywords": [], "long_description": "Sledge Destruction Simulator is a physics based VR game that allows you to destroy a large variety of objects with a sledge hammer and other props. The sledge hammer and props respond to weight and swing speed. The objects that you destroy are collapsible and can be destroyed in millions of different ways.\n\n40+ Objects and structures to destroy.\n\nThe most destruction physics that the Quest 2 can handle.\n\nStay tuned for updates and improvements!\n\nOptimized for Quest 2\n", "short_description": "Destroy objects using ultra realistic physics in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://virtualgo.mypreview.site/information.html", "developer_terms_of_service_url": null, "publisher_name": "VirtualGo LLC", "support_website_url": null, "website_url": "http://virtualgo.mypreview.site/games.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "502045561244047"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75314850_943087966330494_7835413087316449514_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjXMOHHjOXgQ7kNvwE3yKxx&_nc_oc=AdqWNEQcX195riiarAgr6kCspnGQeORqgTdp-AU7AqC7LSaLvj7ZpR0l4GoEZa2iaP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYy1IIWCe4U3UW2qklIQjP1JWbIZFKF8ZuH2o6pSiHBA&oe=6AFDB2CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sledge Destruction Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1645058603, 
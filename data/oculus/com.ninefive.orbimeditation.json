creenshots": [{"file_name": "screenshot_01.png", "id": "514152578413301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393438_514152581746634_3800669213526365228_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1k_y_WmWxQQ7kNvwHUFthI&_nc_oc=AdoHRHv7S5SzSWNB631bLjb-z1aPJMU551CuBllRjeID5YVS-_SEh7pM7KuBpnufsqg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc_8vih1MgYAlJ5w17iLhcYIymEdxul_cNDVJowmiFoA&oe=6AC5278D"}, {"file_name": "screenshot_02.png", "id": "685569970490361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392103_685569973823694_4043381198928964684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzTFpCPpMIMQ7kNvwG8N6ch&_nc_oc=AdoZkuw08rgVBjQGKCKI-RkX9wnUxOrxzGP2ZEQhT00ELMob5CTeNMvWbreW0kytHec&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-1rAUSg_OcJnw0SOYJ_g9wc8NRvA6D7RoI183J1Y8xQ&oe=6AC50190"}, {"file_name": "screenshot_03.png", "id": "667848962293852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392148_667848965627185_3095445195722517524_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cAWzJqpR6wQ7kNvwHGpM1r&_nc_oc=AdobvYlHmeWGbyBYwKBd5jzdGnxAFFAV-O6cyUmKUJQUiX013PFj5uMih6S4NO1MYKA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZe2XeM3qRqQG7KtAk1XVEMhHwo5qO1b9I4Khjc3WYag&oe=6AC51152"}, {"file_name": "screenshot_04.png", "id": "672930218607323", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391935_672930221940656_2172671333555170140_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cInU7U0oxY0Q7kNvwGIdQzF&_nc_oc=Adqw-cPYKsYgLzhr6rzKorHBZhKFmBpMqRlYOovX4ImOxGGGOSWjMCnTbm4RtCMD_Ic&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1dEHSph75AOuX6dTS0YNjUqbZTrkfj5CC0mWGOpZw3A&oe=6AC5051B"}, {"file_name": "screenshot_05.png", "id": "1790789028131003", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473396248_1790789034797669_2320196557679705048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLt4r8RvKYcQ7kNvwGL-Tlw&_nc_oc=AdqcUpbv6AtOouYCX_HMU5D7tJK2DpY3sPCvYL1Gwqhgs4PyMESCGCfZF2g4Fk4ZtjU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJS6heOHyPhTZ5mx194pic279w9AnvrkfHfDpL7DWzsA&oe=6AC528FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4.png", "id": "625164676824138", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393841_625164680157471_8402522233118687228_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t5JPhAGlXIQ7kNvwEpeqFs&_nc_oc=Adq3Q_yb05nXXpCnxM6-UyTFoiVHNYXWqsyZQ3V0aGppI16HGRWnE1zIZGYGe50Royo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvwgHrkIzkOI4Z-eDUkjfa6eNVbY1Sg2nWa6BPN5ODHw&oe=6AC5068B"}, "display_name": "ORBI - Immersive XR Meditation App", "keywords": ["meditation", "relaxation", "healing", "mindfulness", "balance"], "long_description": "# ORBI - Meditation Application\n\nORBI is an immersive XR meditation app designed to help users find inner peace and balance. It offers two meditation experiences, both tailored to promote mental stability and stress relief through immersive healing.\n\n**Focused Meditation: Calming the Mind through Breath**\n\nFocused meditation emphasizes regulating breathing rhythms to relieve tension. The ORBI NPC provides gentle and structured guidance to encourage deep breathing, helping to reduce stress and improve concentration. This meditation is ideal for alleviating anxiety and restoring inner calm in daily life. Experience the importance of mindful breathing and discover tranquility with ORBI.\n\n**Insight Meditation: Reflecting Through Environmental Connection**\n\nInsight meditation focuses on interacting with the immersive environment to observe surroundings and reflect inwardly. By listening to soothing waves and observing subtle movements, users can achieve a deeper meditative state. This practice sharpens awareness and provides a structured moment to organize thoughts and emotions, making it effective for stress relief and gaining new perspectives.\n\n**Create peaceful moments with ORBI. Restore harmony to your body and mind, and embark on your personal healing journey!**", "short_description": "ORBI combines breathing meditation and insight meditation focused on observing the environment to create a powerful XR healing experience. With the warm guidance of the ORBI NPC, relax, reflect, and relieve stress through an immersive meditation journey."}]}, "developer_name": "NINEFIVE", "developer_privacy_policy_url": "https://docs.google.com/document/d/1fDAMmV-qO-octaZoKsA71QAKaBoXLIdFNHMQLKIuStQ/edit?tab=t.1npb427wii1w", "developer_terms_of_service_url": null, "publisher_name": "NINEFIVE", "support_website_url": null, "website_url": "https://www.ninefive.com/#Meditation_VR_Application_ORBI", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9302470726529953"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "979679494008919"}]}, "baseline_offer": {"id": "979679494008919"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743988020, "status": "PUBLISHED", "id": "979679494008919"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25910341395316291", "version": "0.3.5"}, "id": "521939660604901", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "521939660604901"}]}, "change_log": "\uc778\ud2b8\ub85c\uc5d0 \ucee8\ud2b8\ub864\ub7ec \uc0ac\uc6a9 \uc81c\ud55c \uac00\uc774\ub4dc\ub97c \ucd94\uac00\ud558\uc600\uc2b5\ub2c8\ub2e4.", "created_date": 1771921509, "id": "25910341395316291", "version": "0.3.5", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "521939660604901"}]}, "change_log": "Unity \uc5d0\ub514\ud130\uc758 \ubcf4\uc548 \ucde8\uc57d\uc810\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 \uc5d0\ub514\ud130\ub97c \ud328\uce58\ub41c \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uad50\uccb4\ud558\uace0, \ud504\ub85c\uc81d\ud2b8\ub97c \ub2e4\uc2dc \ube4c\ub4dc\ud558\uc5ec \ubc30\ud3ec\ud558\uc600\uc2b5\ub2c8\ub2e4.\n\uc571\uc758 \ucf58\ud150\uce20\uc640 \uae30\ub2a5\uc5d0\ub294 \ubcc0\uacbd\uc774 \uc5c6\uc73c\uba70, \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc5d0\ub294 \uc601\ud5a5\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\n\uc774\ubc88 \uc870\uce58\ub294 \uac1c\ubc1c \ud658\uacbd\u00b7\ube4c\ub4dc \uccb4\uc778\uc758 \ubcf4\uc548 \uac15\ud654\ub97c \ubaa9\uc801\uc73c\ub85c \uc218\ud589\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "created_date": 1760062315, "id": "24632054679811642", "version": "0.2.8", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "521939660604901"}]}, "change_log": "\uba85\uc0c1 \ud658\uacbd \uad6c\uc131\uc774 \uc804\uba74 \uac1c\ud3b8\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uae30\uc874\uc758 \ub450 \uac00\uc9c0 \ud658\uacbd\uc774 \uc81c\uc678\ub418\uace0, \ub124 \uac00\uc9c0 \uc0c8\ub85c\uc6b4 \uacf5\uac04\uc774 \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\ub3d9\uad74 \uacf5\uac04\uc5d0\uc11c\ub294 \ud638\ud761\uc5d0 \uc628\uc804\ud788 \uc9d1\uc911\ud560 \uc218 \uc788\ub3c4\ub85d \uc0ac\uc6b4\ub4dc\uc640 \uc870\uba85 \uc5f0\ucd9c\uc744 \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4. \uc0ac\ub9c9\uc5ec\uc6b0\uac00 \ub4f1\uc7a5\ud574 \uc0ac\uc6a9\uc790\uc758 \ud638\ud761 \ub9ac\ub4ec\uc5d0 \ub9de\ucdb0 \uc6c0\uc9c1\uc774\uba70 \ubab0\uc785\uc744 \ub3d5\uc2b5\ub2c8\ub2e4.\n\uc232\uc18d \uacf5\uac04\uc740 \uc790\uc5f0\uad11\uacfc \uc74c\ud5a5 \ud6a8\uacfc\uac00 \uac15\ud654\ub418\uc5b4 \uc2e4\uc81c \uc232\uc18d\uc5d0 \uc788\ub294 \ub4ef\ud55c \ub290\ub08c\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud1a0\ub07c\uac00 \uc8fc\ubcc0\uc744 \ub6f0\uc5b4\ub2e4\ub2c8\uba70 \uc548\uc815\uac10\uc744 \uc720\ub3c4\ud569\ub2c8\ub2e4.\n\uc808\ubcbd \uacf5\uac04\uc740 \ud558\ub298\uacfc \ubc14\ub78c\uc758 \uc5f0\ucd9c\uc744 \ud1b5\ud574 \uc2dc\uac04\uc758 \ud750\ub984\uacfc \ubcc0\ud654\uc758 \uac10\uac01\uc744 \uc804\ub2ec\ud569\ub2c8\ub2e4. \ub192\uc774\uac10\uacfc \uac1c\ubc29\uac10\uc744 \uc870\uc815\ud558\uc5ec \uc2dc\uac01\uc801 \ubab0\uc785\uc744 \ub192\uc600\uc2b5\ub2c8\ub2e4.\n\ud574\ubcc0 \uacf5\uac04\uc740 \uadf8\ub798\ud53d \uc804\uba74 \ub9ac\ub274\uc5bc\uacfc \ud568\uaed8 \ubb3c\ub9ac \uae30\ubc18 \uc0c1\ud638\uc791\uc6a9\uc774 \uc0c8\ub86d\uac8c \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub3cc\uba69\uc774\ub97c \ub358\uc838 \ubb3c\uacb0\uc744 \ub9cc\ub4e4\uac70\ub098 \uc18c\ub77c\uaecd\ub370\uae30\ub97c \ub4e4\uc5b4 \uc0ac\uc6b4\ub4dc\ub97c \uac10\uc0c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uba85\uc0c1 \uac00\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc774 \uac1c\uc120\ub418\uc5b4, \uac01 \uacf5\uac04\ub9c8\ub2e4 \ud30c\ud2f0\ud074\ub85c \uad6c\uc131\ub41c NPC\uac00 \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \ud658\uacbd\ubcc4\ub85c \ub2e4\ub978 \ud615\ud0dc\uc640 \uc6c0\uc9c1\uc784\uc744 \uac00\uc9c0\uba70, \ud638\ud761\uc758 \ub9ac\ub4ec\uacfc \uc2dc\uac01\uc801 \uac00\uc774\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\ub610\ud55c \ub80c\ub354\ub9c1 \ud6a8\uc728\uc774 \ud5a5\uc0c1\ub418\uc5b4 \ud504\ub808\uc784 \uc548\uc815\uc131\uc774 \uac1c\uc120\ub418\uc5c8\uace0, \uc77c\ubd80 \uc624\ube0c\uc81d\ud2b8\uc758 \ucda9\ub3cc \ucc98\ub9ac \ub85c\uc9c1\uc774 \ucd5c\uc801\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\uc774\ubc88 \uc5c5\ub370\uc774\ud2b8\ub294 \uba85\uc0c1 \uacbd\ud5d8\uc758 \ub2e4\uc591\uc131\uacfc \ubab0\uc785\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud55c \uac1c\uc120\uc744 \uc911\uc2ec\uc73c\ub85c \uc774\ub8e8\uc5b4\uc84c\uc2b5\ub2c8\ub2e4.", "created_date": 1760060696, "id": "24631837536500023", "version": "0.3.4", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_b
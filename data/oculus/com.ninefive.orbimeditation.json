{"data": {"node": {"__typename": "Application", "id": "8409220952521606", "organization": {"id": "1420320065546111", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "2155670682011042"}]}, "id": "3906674446139558"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8409220952521606"}]}, "id": "1522827658357738"}]}}, "firstRevision": {"nodes": [{"application": {"id": "8409220952521606", "release_date": 1743988020, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25910341395316291"}, "id": "521939660604901"}]}}, "binary": null, "live_binary": null, "created_date": 1761643317, "id": "24825028500514258", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "24825109020506206"}, "release_status": "RELEASED", "id": "8409220952521606"}, "id": "24825109020506206", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8409220952521606", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1085762609998197"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1553608429148553", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ORBI - \ubab0\uc785\ud615 XR \uba85\uc0c1 \uc571", "keywords": ["\uba85\uc0c1", "\ud734\uc2dd", "\ud790\ub9c1", "\uc548\uc815", "\ub9c8\uc74c\ucc59\uae40"], "long_description": "# ORBI - XR \uba85\uc0c1 \uc5b4\ud50c\ub9ac\ucf00\uc774\uc158\n\nORBI\ub294 \uc0ac\uc6a9\uc790\uac00 \uc2ec\uc2e0\uc758 \ud3c9\uc628\uc744 \ucc3e\uc744 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub41c \ubab0\uc785\ud615 XR \uba85\uc0c1 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4. ORBI\ub294 \ub450 \uac00\uc9c0 \uba85\uc0c1 \ucf58\ud150\uce20\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub450 \ubc29\uc2dd \ubaa8\ub450 \uc2ec\ub9ac\uc801 \uc548\uc815\uacfc \uc2a4\ud2b8\ub808\uc2a4 \ud574\uc18c\ub97c \uc704\ud55c \ubab0\uc785\ud615 \ud790\ub9c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n**\uc9d1\uc911 \uba85\uc0c1: \ud638\ud761\uc73c\ub85c \ub9c8\uc74c \uc815\ub3c8\ud558\uae30**\n\n\uc9d1\uc911 \uba85\uc0c1\uc740 \ud638\ud761\uc758 \ub9ac\ub4ec\uc744 \uc870\uc808\ud558\uba70 \uae34\uc7a5\uc744 \uc644\ud654\ud558\ub294 \ub370 \ucd08\uc810\uc744 \ub461\ub2c8\ub2e4. ORBI\uc758 \uac00\uc774\ub4dc NPC\ub294 \ubd80\ub4dc\ub7fd\uace0 \uccb4\uacc4\uc801\uc778 \uc548\ub0b4\ub97c \ud1b5\ud574 \uc2ec\ud638\ud761\uc744 \uc720\ub3c4\ud558\uba70, \uc2a4\ud2b8\ub808\uc2a4 \ud574\uc18c\uc640 \uc9d1\uc911\ub825 \ud5a5\uc0c1\uc744 \ub3c4\uc640\uc90d\ub2c8\ub2e4. \uc774 \uba85\uc0c1\uc740 \uc77c\uc0c1 \uc18d\uc5d0\uc11c \ubd88\uc548\uac10\uc744 \uc904\uc774\uace0 \ub0b4\uba74\uc758 \ud3c9\uc628\uc744 \ucc3e\ub294 \ub370 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. ORBI\uc640 \ud568\uaed8 \ud638\ud761\uc758 \uc911\uc694\uc131\uc744 \ub418\uc0c8\uae30\uba70 \ub0b4\uba74\uc758 \uace0\uc694\ub97c \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694.\n\n**\ud1b5\ucc30 \uba85\uc0c1: \ubab0\uc785 \ud658\uacbd\uacfc\uc758 \uad50\uac10\uc73c\ub85c \ub0b4\uba74 \ub4e4\uc5ec\ub2e4\ubcf4\uae30**\n\n\ud1b5\ucc30 \uba85\uc0c1\uc740 \ubab0\uc785 \ud658\uacbd\uc5d0 \uc870\uc131\ub41c \uc790\uc5f0\uacfc\uc758 \uad50\uac10\uc744 \ud1b5\ud574 \uc8fc\ubcc0\uc744 \uad00\ucc30\ud558\uace0 \ub0b4\uba74\uc744 \uc131\ucc30\ud558\ub294 \uacfc\uc815\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \ud574\ubcc0\uc758 \uc18c\ub9ac\uc640 \uc6c0\uc9c1\uc784\uc744 \uac10\uc0c1\ud558\uba70, \uc791\uc740 \ub514\ud14c\uc77c\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc5ec \uae4a\uc740 \ubab0\uc785 \uc0c1\ud0dc\ub97c \uc720\ub3c4\ud569\ub2c8\ub2e4. \uc774 \uba85\uc0c1\uc740 \uac10\uac01\uc744 \uc77c\uae68\uc6b0\uace0 \uc8fc\ubcc0 \ud658\uacbd\uacfc\uc758 \uc0c1\ud638\uc791\uc6a9\uc744 \ud1b5\ud574 \uc790\uc2e0\uc758 \uc0dd\uac01\uacfc \uac10\uc815\uc744 \uc815\ub9ac\ud558\ub294 \uc2dc\uac04\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2a4\ud2b8\ub808\uc2a4\ub97c \ud574\uc18c\ud558\uace0 \uc0c8\ub85c\uc6b4 \uc2dc\uac01\uc744 \uc5bb\ub294 \ub370 \uc720\uc775\ud569\ub2c8\ub2e4.\n\n**ORBI\uc640 \ud568\uaed8 \ud3c9\uc628\ud55c \uc21c\uac04\uc744 \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694. \ubab8\uacfc \ub9c8\uc74c\uc758 \uade0\ud615\uc744 \ub418\ucc3e\uace0, \uc790\uc2e0\ub9cc\uc758 \ud790\ub9c1 \uc5ec\uc815\uc744 \uc2dc\uc791\ud574 \ubcf4\uc138\uc694.**", "short_description": "ORBI\ub294 \ud638\ud761 \uba85\uc0c1\uacfc \ud658\uacbd\uc744 \uad00\ucc30\ud558\ub294 \ud1b5\ucc30 \uba85\uc0c1\uc744 \uacb0\ud569\ud55c XR \ud790\ub9c1 \uc571\uc785\ub2c8\ub2e4. ORBI NPC\uc758 \ub530\ub73b\ud55c \uc548\ub0b4\uc640 \ud568\uaed8 \uae34\uc7a5\uc744 \ud480\uace0 \ub0b4\uba74\uc744 \ub4e4\uc5ec\ub2e4\ubcf4\uba70 \uc2a4\ud2b8\ub808\uc2a4\ub97c \ud574\uc18c\ud558\ub294 \ubab0\uc785\ud615 \uba85\uc0c1 \uacbd\ud5d8\uc744 \ub9cc\ub098\ubcf4\uc138\uc694"}, {"images": {"nodes": [{"file_name": "Landscape.png", "id": "24988806900807653", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295481_24988806904140986_424168414118032119_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BROW8-FoF40Q7kNvwFtu74O&_nc_oc=AdozcRc91DRZ8DFhq-9zlG9yn_7PjhQSTTqvoB0hU9XACpAZgUdfw_vbyr_FbB20So4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7w-f4kaKTysM2K5YtEPevdO4De-FbpSD3HP5cFeUTQA&oe=6B0DA56F"}, {"file_name": "Square.png", "id": "24933590796284168", "image_type": "APP_IMG_C
mq1oE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_lml13i35k-XOWS2H0K1nezkqudurNTWDtvRNaOznfg&oe=6AE1E954"}]}, "id": "819440474592332", "locale": "en_US", "screenshots": [{"file_name": "Screenshot1.png", "id": "1340691220831836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618264_1340691224165169_611567988343258186_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5MMzOY0lbgQ7kNvwEUy0Hm&_nc_oc=AdoxbFn3l14N3isV_WkU8BeI4_BcOjXZxQzO-czAUFsZBzssd6lBK6YiXdR9FsDkP5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6pN3izHAncKuNGIemSYKwenINxDCWyWHiQTV4M4YHjw&oe=6AE1EC1E"}, {"file_name": "Screenshot2.png", "id": "712827631839431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617775_712827635172764_5061746899059024834_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab2nt6031bgQ7kNvwH7d1vJ&_nc_oc=AdoiSXAcVNcmp7kRoxPiSOkWdvwJaQfBeUAU4tzZLdRPH_etiz1uSE9zZkQEEFKi8ZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOuaBA19UemPLVLwt2a1xKBba1j6pZWI4QNFP_h-F5Vg&oe=6AE21004"}, {"file_name": "Screenshot3.png", "id": "796104666527543", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618039_796104669860876_2886549264584663302_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLKatO14FQ8Q7kNvwFGHBFH&_nc_oc=AdrpHz83TYOvSBt6f93OrkwFwlD7LnQaNHHwmduBKoJT3UB2yCxK_6NI334bOod_pE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcFQobZGMnOpdU-0aGl0CkMog8EVco1c4rlBWp3h6xKA&oe=6AE2095A"}, {"file_name": "Screenshot4.png", "id": "808563698738216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619098_808563702071549_2771908231145971585_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEcjkK0YeZMQ7kNvwG-0BGg&_nc_oc=AdoAe8Fq9B54wWOKen6bPJ8kNdP242-7nJsBpRaL6ysPUPB04Ep_1R-OXBxPjOXCwXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqlCawYS2xj65w35wpEjELze9xU6SVjcQUyHw5Oe2Gfw&oe=6AE1F48B"}, {"file_name": "Screenshot5.png", "id": "3210587299101362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_3210587302434695_264134554425134132_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNDINN90PjUQ7kNvwE6P30B&_nc_oc=AdqiPdBzmv12oFJRoHJgR3t_34gT1tmDHaLBATyNQwntjsALitZHIYU5P3-MnH0VRjA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPatkqZpRgjkJu8as1_I0FkPVzihSaMeD1gMzRP5rEnqw&oe=6AE21327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2001079057103361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619450_2001079060436694_5018317595644619471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHw_s12gFMQ7kNvwFYyKpV&_nc_oc=AdrA90Zap2lG_30ZR9iSpyfhuykOK4I1P6Z2FuCwKQOBmANYfpEsdpHH8F7LXuzSoAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6hSavFXP2WciJYk3vL5WUca7aGjd-LT13HVT1s30Tjw&oe=6AE2065F"}, "display_name": "ORBI - Immersive XR Meditation App", "keywords": ["meditation", "relaxation", "healing", "mindfulness", "balance"], "long_description": "# ORBI - Meditation Application\n\nORBI is an immersive XR meditation app designed to help users find inner peace and balance. It offers two meditation experiences, both tailored to promote mental stability and stress relief through immersive healing.\n\n**Focused Meditation: Calming the Mind through Breath**\n\nFocused meditation emphasizes regulating breathing rhythms to relieve tension. The ORBI NPC provides gentle and structured guidance to encourage deep breathing, helping to reduce stress and improve concentration. This meditation is ideal for alleviating anxiety and restoring inner calm in daily life. Experience the importance of mindful breathing and discover tranquility with ORBI.\n\n**Insight Meditation: Reflecting Through Environmental Connection**\n\nInsight meditation focuses on interacting with the immersive environment to observe surroundings and reflect inwardly. By listening to soothing waves and observing subtle movements, users can achieve a deeper meditative state. This practice sharpens awareness and provides a structured moment to organize thoughts and emotions, making it effective for stress relief and gaining new perspectives.\n\n**Create peaceful moments with ORBI. Restore harmony to your body and mind, and embark on your personal healing journey!**", "short_description": "ORBI combines breathing meditation and insight meditation focused on observing the environment to create a powerful XR healing experience. With the warm guidance of the ORBI NPC, relax, reflect, and relieve stress through an immersive meditation journey."}]}, "developer_name": "NINEFIVE", "developer_privacy_policy_url": "https://docs.google.com/document/d/1fDAMmV-qO-octaZoKsA71QAKaBoXLIdFNHMQLKIuStQ/edit?tab=t.1npb427wii1w", "developer_terms_of_service_url": null, "publisher_name": "NINEFIVE", "support_website_url": null, "website_url": "https://www.ninefive.com/#Meditation_VR_Application_ORBI", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24825109020506206"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617762_24933590799617501_8549438081372860389_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjXM0uh-y4MQ7kNvwGwDJa1&_nc_oc=AdrnTp4domxUf5_kKc3LdbTyqmlAY8ptEuWs88upV36av721K_Lxr5kvzgshHoqbN1k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsihhNYDpgwftnWk4W5NdYQQXDtlRRcnmfQLpq4r1WFQ&oe=6AE1ED9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ORBI - Immersive XR Meditation App", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1743988020, "lastRevision": {"nodes": [{"id": "8409221039188264", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8409220952521606", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1085762609998197"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "679021121270791", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ORBI - \ubab0\uc785\ud615 XR \uba85\uc0c1 \uc571", "keywords": ["\uba85\uc0c1", "\ud734\uc2dd", "\ud790\ub9c1", "\uc548\uc815", "\ub9c8\uc74c\ucc59\uae40"], "long_description": "# ORBI - XR \uba85\uc0c1 \uc5b4\ud50c\ub9ac\ucf00\uc774\uc158\n\nORBI\ub294 \uc0ac\uc6a9\uc790\uac00 \uc2ec\uc2e0\uc758 \ud3c9\uc628\uc744 \ucc3e\uc744 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub41c \ubab0\uc785\ud615 XR \uba85\uc0c1 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4. ORBI\ub294 \ub450 \uac00\uc9c0 \uba85\uc0c1 \ucf58\ud150\uce20\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub450 \ubc29\uc2dd \ubaa8\ub450 \uc2ec\ub9ac\uc801 \uc548\uc815\uacfc \uc2a4\ud2b8\ub808\uc2a4 \ud574\uc18c\ub97c \uc704\ud55c \ubab0\uc785\ud615 \ud790\ub9c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n**\uc9d1\uc911 \uba85\uc0c1: \ud638\ud761\uc73c\ub85c \ub9c8\uc74c \uc815\ub3c8\ud558\uae30**\n\n\uc9d1\uc911 \uba85\uc0c1\uc740 \ud638\ud761\uc758 \ub9ac\ub4ec\uc744 \uc870\uc808\ud558\uba70 \uae34\uc7a5\uc744 \uc644\ud654\ud558\ub294 \ub370 \ucd08\uc810\uc744 \ub461\ub2c8\ub2e4. ORBI\uc758 \uac00\uc774\ub4dc NPC\ub294 \ubd80\ub4dc\ub7fd\uace0 \uccb4\uacc4\uc801\uc778 \uc548\ub0b4\ub97c \ud1b5\ud574 \uc2ec\ud638\ud761\uc744 \uc720\ub3c4\ud558\uba70, \uc2a4\ud2b8\ub808\uc2a4 \ud574\uc18c\uc640 \uc9d1\uc911\ub825 \ud5a5\uc0c1\uc744 \ub3c4\uc640\uc90d\ub2c8\ub2e4. \uc774 \uba85\uc0c1\uc740 \uc77c\uc0c1 \uc18d\uc5d0\uc11c \ubd88\uc548\uac10\uc744 \uc904\uc774\uace0 \ub0b4\uba74\uc758 \ud3c9\uc628\uc744 \ucc3e\ub294 \ub370 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. ORBI\uc640 \ud568\uaed8 \ud638\ud761\uc758 \uc911\uc694\uc131\uc744 \ub418\uc0c8\uae30\uba70 \ub0b4\uba74\uc758 \uace0\uc694\ub97c \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694.\n\n**\ud1b5\ucc30 \uba85\uc0c1: \ubab0\uc785 \ud658\uacbd\uacfc\uc758 \uad50\uac10\uc73c\ub85c \ub0b4\uba74 \ub4e4\uc5ec\ub2e4\ubcf4\uae30**\n\n\ud1b5\ucc30 \uba85\uc0c1\uc740 \ubab0\uc785 \ud658\uacbd\uc5d0 \uc870\uc131\ub41c \uc790\uc5f0\uacfc\uc758 \uad50\uac10\uc744 \ud1b5\ud574 \uc8fc\ubcc0\uc744 \uad00\ucc30\ud558\uace0 \ub0b4\uba74\uc744 \uc131\ucc30\ud558\ub294 \uacfc\uc815\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \ud574\ubcc0\uc758 \uc18c\ub9ac\uc640 \uc6c0\uc9c1\uc784\uc744 \uac10\uc0c1\ud558\uba70, \uc791\uc740 \ub514\ud14c\uc77c\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc5ec \uae4a\uc740 \ubab0\uc785 \uc0c1\ud0dc\ub97c \uc720\ub3c4\ud569\ub2c8\ub2e4. \uc774 \uba85\uc0c1\uc740 \uac10\uac01\uc744 \uc77c\uae68\uc6b0\uace0 \uc8fc\ubcc0 \ud658\uacbd\uacfc\uc758 \uc0c1\ud638\uc791\uc6a9\uc744 \ud1b5\ud574 \uc790\uc2e0\uc758 \uc0dd\uac01\uacfc \uac10\uc815\uc744 \uc815\ub9ac\ud558\ub294 \uc2dc\uac04\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2a4\ud2b8\ub808\uc2a4\ub97c \ud574\uc18c\ud558\uace0 \uc0c8\ub85c\uc6b4 \uc2dc\uac01\uc744 \uc5bb\ub294 \ub370 \uc720\uc775\ud569\ub2c8\ub2e4.\n\n**ORBI\uc640 \ud568\uaed8 \ud3c9\uc628\ud55c \uc21c\uac04\uc744 \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694. \ubab8\uacfc \ub9c8\uc74c\uc758 \uade0\ud615\uc744 \ub418\ucc3e\uace0, \uc790\uc2e0\ub9cc\uc758 \ud790\ub9c1 \uc5ec\uc815\uc744 \uc2dc\uc791\ud574 \ubcf4\uc138\uc694.**", "short_description": "ORBI\ub294 \ud638\ud761 \uba85\uc0c1\uacfc \ud658\uacbd\uc744 \uad00\ucc30\ud558\ub294 \ud1b5\ucc30 \uba85\uc0c1\uc744 \uacb0\ud569\ud55c XR \ud790\ub9c1 \uc571\uc785\ub2c8\ub2e4. ORBI NPC\uc758 \ub530\ub73b\ud55c \uc548\ub0b4\uc640 \ud568\uaed8 \uae34\uc7a5\uc744 \ud480\uace0 \ub0b4\uba74\uc744 \ub4e4\uc5ec\ub2e4\ubcf4\uba70 \uc2a4\ud2b8\ub808\uc2a4\ub97c \ud574\uc18c\ud558\ub294 \ubab0\uc785\ud615 \uba85\uc0c1 \uacbd\ud5d8\uc744 \ub9cc\ub098\ubcf4\uc138\uc694"}, {"images": {"nodes": [{"file_name": "minilandscape_mod.png", "id": "1722065985013446", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396566_1722065988346779_3494832194737819107_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bobe1mFX4bsQ7kNvwGu6Mja&_nc_oc=Adr1kGuGH7erkAsoGni9Ww7UqsnXt_C3DcfzHWBECQPaWG9Rgq9NkFa38TrRTlVuHAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPryo-_uE9aMXYw0g0DUPx97MqtkdtE_-oV0c9jeVvbyQ&oe=6AE1F666"}, {"file_name": "square.png", "id": "1585008008807607", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393601_1585008012140940_803871677693361724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmZ_Fvy3BkUQ7kNvwFfmp-_&_nc_oc=AdrrIy-tdWGmBclxGONsRtfZeGCXrOnk-u8BAT6lZySMt40bP1fqo_AlBOt0GRsio7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVnW7igsJAUi3t6sGM5SlDlySuPAejGMJqn1GCKrN03w&oe=6AE1E6AA"}, {"file_name": "icon.png", "id": "1394752825232037", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_1394752828565370_8042694789371535494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS4TI6FA5y4Q7kNvwGefeq5&_nc_oc=AdpuC7is2BOsNEjx55gQY9VZEO0jrDdaaSpI2xgce8aj2qHPuuz9ZDregOQ532iKfXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJm5nAdGBH3dMm6
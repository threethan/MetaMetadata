t=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg6y5dROI2QQ7kNvwE29USe&_nc_oc=AdqykyOgN6NJrPTjgRWCVvUs5xXkrwc2NeHSBp0KGiIRemHOCJKDe6ccnWUDkfhxGQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm2KzLhSKfYNLcxW3y1DNBdnlFlFmRzHr_vtz6FzG5nw&oe=6B046894"}]}, "id": "819440474592332", "locale": "en_US", "screenshots": [{"file_name": "Screenshot1.png", "id": "1340691220831836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_1340691224165169_611567988343258186_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHLjnovYoaQQ7kNvwGwKKTu&_nc_oc=AdqHVvOPXZqQWrzgOZnsc704CH2EzKa4Qq1LrjXze1kS1-3JkGJ0dRXICAsmrQzMIxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN3I8MsgINjUNWJ9mJ70jVIKLBF4zIXp1lLRKGMf6htQ&oe=6B046B5E"}, {"file_name": "Screenshot2.png", "id": "712827631839431", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617775_712827635172764_5061746899059024834_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlRNsIOX_Z0Q7kNvwE52w0l&_nc_oc=AdpZ0ylUL_AoTJqerEmFraJ-m5TfJyOpNZachOI2xdr1fjWP2J4S338DQC1mFZEN_68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS3B-6IGJ5rqhpe9nxOCRZRnbXkaTV1eXgmkilPT7tPw&oe=6B045704"}, {"file_name": "Screenshot3.png", "id": "796104666527543", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618039_796104669860876_2886549264584663302_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saaXZ7-5m0cQ7kNvwES0Lev&_nc_oc=Adp_nXG9y3EPmRjxZtlf-Y6PnYOFUwUO2SYXv6xB_H7ArgmpWBMIZ1kjoDv9vAGYLW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi9CPZT8nVw1f-idhk82a44SJYeFwoJJZll5cdA2cCIg&oe=6B04889A"}, {"file_name": "Screenshot4.png", "id": "808563698738216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619098_808563702071549_2771908231145971585_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFkCPNG4dEwQ7kNvwGyijTL&_nc_oc=Adp8ki4kAthnBBocsVj3pOs3YYiHUZWKH7ePdg87XC24KuxlbGZOdZ_yIvfskogHWwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk3Lx0OOv4XgCTGx3JnGyBKPKIN1LX5VWAGkalnVjPJQ&oe=6B0473CB"}, {"file_name": "Screenshot5.png", "id": "3210587299101362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_3210587302434695_264134554425134132_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKmefyQc8ssQ7kNvwFl0yme&_nc_oc=AdpCQzgdwBwcvw2_vjxmCDPTzooH3ckKcP0zpiYDFlTWKIeYw1-KP52XHON6w3ioZ7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk6MVjXh5cj7DoHCwwwq7PNzusUKoLhFMzF4sXRJnUFQ&oe=6B045A27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2001079057103361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619450_2001079060436694_5018317595644619471_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VKH2UaabicQ7kNvwF7thwI&_nc_oc=AdrRxDUHA4weElyTXbHgaQBg7TxERn5Q4h-dgOANv48X0a0PAJZqrNMiF0n3iRlmcog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz10p20fNHaVmlCjI5LVUBAE3YP7aebstF4rP8ojyEqw&oe=6B04859F"}, "display_name": "ORBI - Immersive XR Meditation App", "keywords": ["meditation", "relaxation", "healing", "mindfulness", "balance"], "long_description": "# ORBI - Meditation Application\n\nORBI is an immersive XR meditation app designed to help users find inner peace and balance. It offers two meditation experiences, both tailored to promote mental stability and stress relief through immersive healing.\n\n**Focused Meditation: Calming the Mind through Breath**\n\nFocused meditation emphasizes regulating breathing rhythms to relieve tension. The ORBI NPC provides gentle and structured guidance to encourage deep breathing, helping to reduce stress and improve concentration. This meditation is ideal for alleviating anxiety and restoring inner calm in daily life. Experience the importance of mindful breathing and discover tranquility with ORBI.\n\n**Insight Meditation: Reflecting Through Environmental Connection**\n\nInsight meditation focuses on interacting with the immersive environment to observe surroundings and reflect inwardly. By listening to soothing waves and observing subtle movements, users can achieve a deeper meditative state. This practice sharpens awareness and provides a structured moment to organize thoughts and emotions, making it effective for stress relief and gaining new perspectives.\n\n**Create peaceful moments with ORBI. Restore harmony to your body and mind, and embark on your personal healing journey!**", "short_description": "ORBI combines breathing meditation and insight meditation focused on observing the environment to create a powerful XR healing experience. With the warm guidance of the ORBI NPC, relax, reflect, and relieve stress through an immersive meditation journey."}]}, "developer_name": "NINEFIVE", "developer_privacy_policy_url": "https://docs.google.com/document/d/1fDAMmV-qO-octaZoKsA71QAKaBoXLIdFNHMQLKIuStQ/edit?tab=t.1npb427wii1w", "developer_terms_of_service_url": null, "publisher_name": "NINEFIVE", "support_website_url": null, "website_url": "https://www.ninefive.com/#Meditation_VR_Application_ORBI", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24825109020506206"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_24933590799617501_8549438081372860389_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3bm7vC4-SoQ7kNvwFM8xsZ&_nc_oc=AdqRsnNLFBE-xa_BhIHD4orLEVbV-9DZOsHyZngY7K-kjw_F1Unp8XLJxM-kucyTLFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlRIbqzEwYFgWPTtj8P6f1GcaWOxZMwOGOZtUWt8Rqvw&oe=6B046CDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ORBI - Immersive XR Meditation App", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1743988020, "lastRevision": {"nodes": [{"id": "8409221039188264", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8409220952521606", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1085762609998197"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "679021121270791", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ORBI - \ubab0\uc785\ud615 XR \uba85\uc0c1 \uc571", "keywords": ["\uba85\uc0c1", "\ud734\uc2dd", "\ud790\ub9c1", "\uc548\uc815", "\ub9c8\uc74c\ucc59\uae40"], "long_description": "# ORBI - XR \uba85\uc0c1 \uc5b4\ud50c\ub9ac\ucf00\uc774\uc158\n\nORBI\ub294 \uc0ac\uc6a9\uc790\uac00 \uc2ec\uc2e0\uc758 \ud3c9\uc628\uc744 \ucc3e\uc744 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub41c \ubab0\uc785\ud615 XR \uba85\uc0c1 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4. ORBI\ub294 \ub450 \uac00\uc9c0 \uba85\uc0c1 \ucf58\ud150\uce20\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub450 \ubc29\uc2dd \ubaa8\ub450 \uc2ec\ub9ac\uc801 \uc548\uc815\uacfc \uc2a4\ud2b8\ub808\uc2a4 \ud574\uc18c\ub97c \uc704\ud55c \ubab0\uc785\ud615 \ud790\ub9c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n**\uc9d1\uc911 \uba85\uc0c1: \ud638\ud761\uc73c\ub85c \ub9c8\uc74c \uc815\ub3c8\ud558\uae30**\n\n\uc9d1\uc911 \uba85\uc0c1\uc740 \ud638\ud761\uc758 \ub9ac\ub4ec\uc744 \uc870\uc808\ud558\uba70 \uae34\uc7a5\uc744 \uc644\ud654\ud558\ub294 \ub370 \ucd08\uc810\uc744 \ub461\ub2c8\ub2e4. ORBI\uc758 \uac00\uc774\ub4dc NPC\ub294 \ubd80\ub4dc\ub7fd\uace0 \uccb4\uacc4\uc801\uc778 \uc548\ub0b4\ub97c \ud1b5\ud574 \uc2ec\ud638\ud761\uc744 \uc720\ub3c4\ud558\uba70, \uc2a4\ud2b8\ub808\uc2a4 \ud574\uc18c\uc640 \uc9d1\uc911\ub825 \ud5a5\uc0c1\uc744 \ub3c4\uc640\uc90d\ub2c8\ub2e4. \uc774 \uba85\uc0c1\uc740 \uc77c\uc0c1 \uc18d\uc5d0\uc11c \ubd88\uc548\uac10\uc744 \uc904\uc774\uace0 \ub0b4\uba74\uc758 \ud3c9\uc628\uc744 \ucc3e\ub294 \ub370 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. ORBI\uc640 \ud568\uaed8 \ud638\ud761\uc758 \uc911\uc694\uc131\uc744 \ub418\uc0c8\uae30\uba70 \ub0b4\uba74\uc758 \uace0\uc694\ub97c \uacbd\ud5d8\ud574 \ubcf4\uc138\uc694.\n\n**\ud1b5\ucc30 \uba85\uc0c1: \ubab0\uc785 \ud658\uacbd\uacfc\uc758 \uad50\uac10\uc73c\ub85c \ub0b4\uba74 \ub4e4\uc5ec\ub2e4\ubcf4\uae30**\n\n\ud1b5\ucc30 \uba85\uc0c1\uc740 \ubab0\uc785 \ud658\uacbd\uc5d0 \uc870\uc131\ub41c \uc790\uc5f0\uacfc\uc758 \uad50\uac10\uc744 \ud1b5\ud574 \uc8fc\ubcc0\uc744 \uad00\ucc30\ud558\uace0 \ub0b4\uba74\uc744 \uc131\ucc30\ud558\ub294 \uacfc\uc815\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \ud574\ubcc0\uc758 \uc18c\ub9ac\uc640 \uc6c0\uc9c1\uc784\uc744 \uac10\uc0c1\ud558\uba70, \uc791\uc740 \ub514\ud14c\uc77c\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc5ec \uae4a\uc740 \ubab0\uc785 \uc0c1\ud0dc\ub97c \uc720\ub3c4\ud569\ub2c8\ub2e4. \uc774 \uba85\uc0c1\uc740 \uac10\uac01\uc744 \uc77c\uae68\uc6b0\uace0 \uc8fc\ubcc0 \ud658\uacbd\uacfc\uc758 \uc0c1\ud638\uc791\uc6a9\uc744 \ud1b5\ud574 \uc790\uc2e0\uc758 \uc0dd\uac01\uacfc \uac10\uc815\uc744 \uc815\ub9ac\ud558\ub294 \uc2dc\uac04\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2a4\ud2b8\ub808\uc2a4\ub97c \ud574\uc18c\ud558\uace0 \uc0c8\ub85c\uc6b4 \uc2dc\uac01\uc744 \uc5bb\ub294 \ub370 \uc720\uc775\ud569\ub2c8\ub2e4.\n\n**ORBI\uc640 \ud568\uaed8 \ud3c9\uc628\ud55c \uc21c\uac04\uc744 \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694. \ubab8\uacfc \ub9c8\uc74c\uc758 \uade0\ud615\uc744 \ub418\ucc3e\uace0, \uc790\uc2e0\ub9cc\uc758 \ud790\ub9c1 \uc5ec\uc815\uc744 \uc2dc\uc791\ud574 \ubcf4\uc138\uc694.**", "short_description": "ORBI\ub294 \ud638\ud761 \uba85\uc0c1\uacfc \ud658\uacbd\uc744 \uad00\ucc30\ud558\ub294 \ud1b5\ucc30 \uba85\uc0c1\uc744 \uacb0\ud569\ud55c XR \ud790\ub9c1 \uc571\uc785\ub2c8\ub2e4. ORBI NPC\uc758 \ub530\ub73b\ud55c \uc548\ub0b4\uc640 \ud568\uaed8 \uae34\uc7a5\uc744 \ud480\uace0 \ub0b4\uba74\uc744 \ub4e4\uc5ec\ub2e4\ubcf4\uba70 \uc2a4\ud2b8\ub808\uc2a4\ub97c \ud574\uc18c\ud558\ub294 \ubab0\uc785\ud615 \uba85\uc0c1 \uacbd\ud5d8\uc744 \ub9cc\ub098\ubcf4\uc138\uc694"}, {"images": {"nodes": [{"file_name": "minilandscape_mod.png", "id": "1722065985013446", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396566_1722065988346779_3494832194737819107_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AT-gt2jb0ywQ7kNvwGpoOGX&_nc_oc=AdquBh9FNU-TkPouFucSF60e6VctBjN_oaWddrjE6VVMWY0fC8iOcT1VJrfTDGUAXcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSePpSljZTE-1zqjIwho2ofy9Jc02VpnKgtzvEASc_dBQ&oe=6B0475A6"}, {"file_name": "square.png", "id": "1585008008807607", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393601_1585008012140940_803871677693361724_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1R8vTcANV8Q7kNvwEVaJVt&_nc_oc=AdrAiuv6zfwuPmuYmeBv1WKzpB-46MeqAEuwAKsJ6yH8nafnPLeB5ly9N8BUVn7b8oU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3WWYl3afTI3hIM-VgZy_HiaqQtcyGoiiweKLBu49J8Q&oe=6B0465EA"}, {"file_name": "icon.png", "id": "1394752825232037", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_1394752828565370_8042694789371535494_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyaZ4br34kYQ7kNvwGlzaL3&_nc_oc=AdpbR1JcxLuMA8tkWHw1c3P0Rpk5yWYTt7TF4ky_-4lzBmOSTqc2DZAEnwpB2f8akiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbE73GrNNa7bhV7S6J_NPbfx1GeYXCsuDMqcrV1lakKw&oe=6B048580"}, {"file_name": "logo_reverse.png", "id": "1127471452003134", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391984_1127471455336467_4228236992929749292_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ui5c3VjkmFwQ7kNvwEGzPbs&_nc_oc=AdrcY_vE6BjGv-NmKLfVaMh6mUNTSUlIeusEHnXoGsSIHGPa64pOTOSSQiFOfHR4ybw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv-KppD8fpOrClGXys3hE2FdBcUNsHwH-wI1eAi0WK4A&oe=6B047DBE"}, {"file_name": "pdp_art_mod.png", "id": "665022439399251", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_665022442732584_8715861223982432606_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xunjuN_usoEQ7kNvwFpapTm&_nc_oc=AdrJp13jjdVFhtRyJWXYIeNMsntmyTi6qMq08vXWWzkXXKFYnRL9Cpd7qBaXsiPEFiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk5eszhvxxhqO2RJ_BJXmEvLA-0gCZkah97Fb6iJClcA&oe=6B048918"}, {"file_name": "LandScape.png", "id": "603164555963807", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391860_603164559297140_8538173648229977601_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgPt_x8zgF0Q7kNvwG2BLtU&_nc_oc=Adp9KZ76lFFCbiqb-Toc_MLdTNBltd47k5_XlkYAYJXYaBBO80-Bc3EXl3vevXAM4lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwxhpuSy0Q02lsDGLlwhYQZ4Pkl3dStkKCh-1-0GoPyA&oe=6B045704"}, {"file_name": "portrait.png", "id": "590873330526209", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394021_590873333859542_5101328508892823367_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoA6grZf0uwQ7kNvwFZpLtf&_nc_oc=AdpLIz6lfdnCHoZExaiyWbOBZuLZUZEEq8lp5oyM6rCNEmzx2PBpqR2u8viPwACg6gk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStz9_Q6QiCukQihBItZTQiHFhrGEXtxJGsiIUR8a-wcA&oe=6B046B04"}]}, "id": "440707712437331", "locale": "en_US", "screenshots": [{"file_name": "screenshot_01.png", "id": "514152578413301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393438_514152581746634_3800669213526365228_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2sGsiankk8Q7kNvwFM3Iqt&_nc_oc=AdrMWT99UAsBuXoPAcov26eyoAECDwOXQyX7VCeOeoa7oifaIFMlPzanTrguchkNSXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk_xnb6iQgjC8qvo7vNYWv0MCvEAqAz2F164WIvUS31w&oe=6B046F8D"}, {"file_name": "screenshot_02.png", "id": "685569970490361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392103_685569973823694_4043381198928964684_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MX5IwOILCsIQ7kNvwFR3brM&_nc_oc=AdojkNC4CWenFYXpIjqe6LDBc13WrH9TmB7FHVd5BvkQD_nXqryWF86YYQapWmV_el4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAPhpierrlr19KH4KuUhID4Me-WITfPf3PlkdM_cecdw&oe=6B0481D0"}, {"file_name": "screenshot_03.png", "id": "667848962293852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392148_667848965627185_3095445195722517524_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TuFFmuRnVIQ7kNvwGJ6eN1&_nc_oc=AdpmuG26XvADqnqv6iMbIuen3mTyJdTeMwyR1d35UX_ebqka9dBFGoozElM4dql2ro8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpalGO5pt0U0dHXoJXGiiIOW-t8zCUc84WuLyLlfHODw&oe=6B045952"}, {"file_name": "screenshot_04.png", "id": "672930218607323", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391935_672930221940656_2172671333555170140_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK0KltamFnUQ7kNvwF00Bj6&_nc_oc=Adrn-mxWwPgmG3VfwBlN-MqlufymIAbBH27epbHfPck6aZpCwmCFxw04QYmC7Uxwliw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHxbREqFNod9i8sR-3Pfqd5ZIO_hOq3KWd8Vqc9FbgOw&oe=6B04855B"}, {"file_name": "screenshot_05.png", "id": "1790789028131003", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396248_1790789034797669_2320196557679705048_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b87upMkSFpIQ7kNvwG3vnQx&_nc_oc=Ado4Fos_YEVPTN-fZUeyKBCm14reJdX-0ky8pJf16MEhAaXZ86dcVb5iE3UlMOhKyyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa-dFdE8S0wM5OnyESNgBscE10jKwdT0AzXP0-SaHLuw&oe=6B0470FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_4.png", "id": "625164676824138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393841_625164680157471_8402522233118687228_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avAac1LjfhoQ7kNvwGBTotz&_nc_oc=AdqivSzC9rnWa0d4b5OA0K2BTCZihyZk6xfYM9pexrrxukHvs0Zwq7qGVlZ9sI1IQQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO1qz_v-mE35yl8RLG6XBLimJRy7OAtxRIFf1EwVtd4A&oe=6B0486CB"}, "display_name": "ORBI - Immersive XR Meditation App", "keywords": ["meditation", "relaxation", "healing", "mindfulness", "balance"], "long_description": "# ORBI - Meditation Application\n\nORBI is an immersive XR meditation app designed to help users find inner peace and balance. It offers two meditation experiences, both tailored to promote mental stability and stress relief through immersive healing.\n\n**Focused Meditation: Calming the Mind through Breath**\n\nFocused meditation emphasizes regulating breathing rhythms to relieve tension. The ORBI NPC provides gentle and structured guidance to encourage deep breathing, helping to reduce stress and improve concentration. This meditation is ideal for alleviating anxiety and restoring inner calm in daily life. Experience the importance of mindful breathing and discover tranquility with ORBI.\n\n**Insight Meditation: Reflecting Through Environmental Connection**\n\nInsight meditation focuses on interacting with the immersive environment to observe surroundings and reflect inwardly. By listening to soothing waves and observing subtle movements, users can achieve a deeper meditative state. This practice sharpens awareness and provides a structured moment to organize thoughts and emotions, making it effective for stress relief and gaining new perspectives.\n\n**Create peaceful moments with ORBI. Restore harmony to your body and mind, and embark on your personal healing journey!**", "short_description": "ORBI combines breathing meditation and insight meditation focused on observing the environment to create a powerful XR healing experience. With the warm guidance of the ORBI NPC, relax, reflect, and relieve stress through an immersive meditation journey."}]}, "developer_name": "NINEFIVE", "developer_privacy_policy_url": "https://docs.google.com/document/d/1fDAMmV-qO-octaZoKsA71QAKaBoXLIdFNHMQLKIuStQ/edit?tab=t.1npb427wii1w", "developer_terms_of_service_url": null, "publisher_name": "NINEFIVE", "support_website_url": null, "website_url": "https://www.ninefive.com/#Meditation_VR_Application_ORBI", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9302470726529953"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "979679494008919"}]}, "baseline_offer": {"id": "979679494008919"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743988020, "status": "PUBLISHED", "id": "979679494008919"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25910341395316291", "version": "0.3.5"}, "id": "521939660604901", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "521939660604901"}]}, "change_log": "\uc778\ud2b8\ub85c\uc5d0 \ucee8\ud2b8\ub864\ub7ec \uc0ac\uc6a9 \uc81c\ud55c \uac00\uc774\ub4dc\ub97c \ucd94\uac00\ud558\uc600\uc2b5\ub2c8\ub2e4.", "created_date": 1771921509, "id": "25910341395316291", "version": "0.3.5", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "521939660604901"}]}, "change_log": "Unity \uc5d0\ub514\ud130\uc758 \ubcf4\uc548 \ucde8\uc57d\uc810\uc5d0 \ub300\uc751\ud558\uae30 \uc704\ud574 \uc5d0\ub514\ud130\ub97c \ud328\uce58\ub41c \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uad50\uccb4\ud558\uace0, \ud504\ub85c\uc81d\ud2b8\ub97c \ub2e4\uc2dc \ube4c\ub4dc\ud558\uc5ec \ubc30\ud3ec\ud558\uc600\uc2b5\ub2c8\ub2e4.\n\uc571\uc758 \ucf58\ud150\uce20\uc640 \uae30\ub2a5\uc5d0\ub294 \ubcc0\uacbd\uc774 \uc5c6\uc73c\uba70, \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc5d0\ub294 \uc601\ud5a5\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\n\uc774\ubc88 \uc870\uce58\ub294 \uac1c\ubc1c \ud658\uacbd\u00b7\ube4c\ub4dc \uccb4\uc778\uc758 \ubcf4\uc548 \uac15\ud654\ub97c \ubaa9\uc801\uc73c\ub85c \uc218\ud589\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "created_date": 1760062315, "id": "24632054679811642", "version": "0.2.8", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "521939660604901"}]}, "change_log": "\uba85\uc0c1 \ud658\uacbd \uad6c\uc131\uc774 \uc804\uba74 \uac1c\ud3b8\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uae30\uc874\uc758 \ub450 \uac00\uc9c0 \ud658\uacbd\uc774 \uc81c\uc678\ub418\uace0, \ub124 \uac00\uc9c0 \uc0c8\ub85c\uc6b4 \uacf5\uac04\uc774 \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\ub3d9\uad74 \uacf5\uac04\uc5d0\uc11c\ub294 \ud638\ud761\uc5d0 \uc628\uc804\ud788 \uc9d1\uc911\ud560 \uc218 \uc788\ub3c4\ub85d \uc0ac\uc6b4\ub4dc\uc640 \uc870\uba85 \uc5f0\ucd9c\uc744 \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4. \uc0ac\ub9c9\uc5ec\uc6b0\uac00 \ub4f1\uc7a5\ud574 \uc0ac\uc6a9\uc790\uc758 \ud638\ud761 \ub9ac\ub4ec\uc5d0 \ub9de\ucdb0 \uc6c0\uc9c1\uc774\uba70 \ubab0\uc785\uc744 \ub3d5\uc2b5\ub2c8\ub2e4.\n\uc232\uc18d \uacf5\uac04\uc740 \uc790\uc5f0\uad11\uacfc \uc74c\ud5a5 \ud6a8\uacfc\uac00 \uac15\ud654\ub418\uc5b4 \uc2e4\uc81c \uc232\uc18d\uc5d0 \uc788\ub294 \ub4ef\ud55c \ub290\ub08c\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud1a0\ub07c\uac00 \uc8fc\ubcc0\uc744 \ub6f0\uc5b4\ub2e4\ub2c8\uba70 \uc548\uc815\uac10\uc744 \uc720\ub3c4\ud569\ub2c8\ub2e4.\n\uc808\ubcbd \uacf5\uac04\uc740 \ud558\ub298\uacfc \ubc14\ub78c\uc758 \uc5f0\ucd9c\uc744 \ud1b5\ud574 \uc2dc\uac04\uc758 \ud750\ub984\uacfc \ubcc0\ud654\uc758 \uac10\uac01\uc744 \uc804\ub2ec\ud569\ub2c8\ub2e4. \ub192\uc774\uac10\uacfc \uac1c\ubc29\uac10\uc744 \uc870\uc815\ud558\uc5ec \uc2dc\uac01\uc801 \ubab0\uc785\uc744 \ub192\uc600\uc2b5\ub2c8\ub2e4.\n\ud574\ubcc0 \uacf5\uac04\uc740 \uadf8\ub798\ud53d \uc804\uba74 \ub9ac\ub274\uc5bc\uacfc \ud568\uaed8 \ubb3c\ub9ac \uae30\ubc18 \uc0c1\ud638\uc791\uc6a9\uc774 \uc0c8\ub86d\uac8c \ucd94\uac00\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub3cc\uba69\uc774\ub97c \ub358\uc838 \ubb3c\uacb0\uc744 \ub9cc\ub4e4\uac70\ub098 \uc18c\ub77c\uaecd\ub370\uae30\ub97c \ub4e4\uc5b4 \uc0ac\uc6b4\ub4dc\ub97c \uac10\uc0c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uba85\uc0c1 \uac00\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc774 \uac1c\uc120\ub418\uc5b4, \uac01 \uacf5\uac04\ub9c8\ub2e4 \ud30c\ud2f0\ud074\ub85c \uad6c\uc131\ub41c NPC\uac00 \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \ud658\uacbd\ubcc4\ub85c \ub2e4\ub978 \ud615\ud0dc\uc640 \uc6c0\uc9c1\uc784\uc744 \uac00\uc9c0\uba70, \ud638\ud761\uc758 \ub9ac\ub4ec\uacfc \uc2dc\uac01\uc801 \uac00\uc774\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\ub610\ud55c \ub80c\ub354\ub9c1 \ud6a8\uc728\uc774 \ud5a5\uc0c1\ub418\uc5b4 \ud504\ub808\uc784 \uc548\uc815\uc131\uc774 \uac1c\uc120\ub418\uc5c8\uace0, \uc77c\ubd80 \uc624\ube0c\uc81d\ud2b8\uc758 \ucda9\ub3cc \ucc98\ub9ac \ub85c\uc9c1\uc774 \ucd5c\uc801\ud654\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\uc774\ubc88 \uc5c5\ub370\uc774\ud2b8\ub294 \uba85\uc0c1 \uacbd\ud5d8\uc758 \ub2e4\uc591\uc131\uacfc \ubab0\uc785\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud55c \uac1c\uc120\uc744 \uc911\uc2ec\uc73c\ub85c \uc774\ub8e8\uc5b4\uc84c\uc2b5\ub2c8\ub2e4.", "created_date": 1760060696, "id": "24631837536500023", "version": "0.3.4", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1756699433, "id": "24273951448955302", "version": "0.3.3", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8409220952521606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25910341395316291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1756693986, "id": "24273475369002910", "version": "0.3.2", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
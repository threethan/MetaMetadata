AB12845"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M1", "keywords": ["ELITE", "ScapeRoom"], "long_description": "Sum\u00e9rgete en un escape room en realidad virtual donde deber\u00e1s superar tres desaf\u00edos \u00fanicos. Con la ayuda de personajes virtuales que te dar\u00e1n pistas, deber\u00e1s resolver enigmas en una habitaci\u00f3n cerrada, encontrar la salida de un laberinto confuso y enfrentarte a una prueba de reacci\u00f3n. Cada etapa pone a prueba tu l\u00f3gica, orientaci\u00f3n y reflejos. \u00bfPodr\u00e1s escapar a tiempo?", "short_description": "Realiza las diversas pruebas que se presentan ante ti con ayuda de tus acompa\u00f1antes. \u00bfEst\u00e1s listo para el desaf\u00edo?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7140313682667744"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473401872_1422710899086325_3352907990262717734_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3zF6EC6a9gQ7kNvwF4e4J7&_nc_oc=Ado0rfmhVAT1HrHPCGm6Kg17Twshbl7tsnVvN65nz6NeoZSB3njlOzxrbZWroPBLL
2_4998990111256129799_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCsOIHxNN7wQ7kNvwH8EN8e&_nc_oc=AdpY1xokOJ3qoWD0TAWqPUCowK41yVOVQ7DLB3omw5r159FT61yv49sOVzJrQlvBaVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzu-7mpsP8Q7kfgA_98r4juSVaZ5MrBGNQ4LeNQGh8Yw&oe=6B071205"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Elite M1", "keywords": ["ELITE", "ScapeRoom"], "long_description": "Sum\u00e9rgete en un escape room en realidad virtual donde deber\u00e1s superar tres desaf\u00edos \u00fanicos. Con la ayuda de personajes virtuales que te dar\u00e1n pistas, deber\u00e1s resolver enigmas en una habitaci\u00f3n cerrada, encontrar la salida de un laberinto confuso y enfrentarte a una prueba de reacci\u00f3n. Cada etapa pone a prueba tu l\u00f3gica, orientaci\u00f3n y reflejos. \u00bfPodr\u00e1s escapar a tiempo?", "short_description": "Realiza las diversas pruebas que se presentan ante ti con ayuda de tus acompa\u00f1antes. \u00bfEst\u00e1s listo para el desaf\u00edo?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lableni.webs.upv.es/privacy-policy-elite/", "developer_terms_of_service_url": null, "publisher_name": "LabLENI", "support_website_url": null, "website_url": "https://lableni.webs.upv.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7140313682667744"}, "review_me
ame": "migrated_image.png", "id": "683972135689472", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138842_254663068281724_3865679658292871168_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_MIwJj1iLcQ7kNvwFNWC5F&_nc_oc=AdqSrjEqDv__RJmMMu2ybRqyFNrh3hbqt5vEgiQinI5Y42b3nQ-Llnth-8EC0Lp_7CU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC2UR_1s32uTQTj9kl_RRqR7flXZxDFRDU8wze4KwMxA&oe=6AFB2E62"}, {"file_name": "migrated_image.png", "id": "219212722615585", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eggXGfKRjS4Q7kNvwGfBGU1&_nc_oc=AdryHMOwC57ajlByQjzowvxtrtcWNJ9mhTo8NbRPr0ESZ6M_Me-TSOIEoB5vBqKAwLE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLYVHi_dhLsIp7qANZ-TP4qdvM8BAdlJ_qe8HxG6i6cA&oe=6AFB3F6B"}, {"file_name": "migrated_image.png", "id": "208934503655336", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdyJyHNsUVQQ7kNvwEn59Mx&_nc_oc=AdoHSLeXaMijI2UukRvB0-XckD6i_yCjPhMRAgJIi8RpRl-l0pFq9qQ2Jaj1f8mfWmk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0hyPLPuymDh7MLlF3utigQoE6vSbsjiCzUR002hwa9Q&oe=6AFB3A8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game made for the HTC Vive. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vr.capitola.nl/", "developer_terms_of_service_url": "http://www.vr.capitola.nl/", "publisher_name": "Capitola VR", "support_website_url": null, "website_url": "http://www.vr.capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341798126234463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1834477123501996"}]}, "baseline_offer": {"id": "1834477123501996"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1487181600, "status": "PUBLISHED", "id": "1834477123501996"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1292741817465400", "version": "1.2"}, "id": "226132784482808", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1264133353659580", "is_concept": false, "latest_released_binary": {"__typename": "A
537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzT2uqj3PH8Q7kNvwGN2ogt&_nc_oc=AdqyYPitFnPF_KaH-1Y1ICqR5xwxByD8_ae4W9NToibByRsHNUuM6-b5T5tqXu-G7jA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22JfsEtQF1ra6z--0DtH7CQ8E4a4Do6cQS6Ttlf-QbEg&oe=69E8CF2B"}, {"file_name": "migrated_image.png", "id": "208934503655336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0C_22T3rQkQ7kNvwGd4M7K&_nc_oc=AdqT7_PVAPbjEdDCyGr6XnEa4aP9cIeY3zAY-794Of6dT4mL8ck9Bd6ZH93LfI7C4CU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2usaul2z59mkA785WplDpJNQLexcHxDEoSLVc7thQ0eg&oe=69E8CA4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game made for the HTC Vive. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vr.capitola.nl/", "developer_terms_of_service_url": "http://www.vr.capitola.nl/", "publisher_name": "Capitola VR", "support_website_url": null, "website_url": "http://www.vr.capitola.nl/", "category": "GAMES", "comfort_ra
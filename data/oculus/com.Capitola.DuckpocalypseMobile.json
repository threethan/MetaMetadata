QVR7v2XoAjd8QGxCEiM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bk0X-3V2O3dqlElvIwonkAbfbUotp8CAhnhFE9IIwyA&oe=6A4658A2"}, {"file_name": "migrated_image.png", "id": "326196295030599", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26NSnKvdFEcQ7kNvwE3omKg&_nc_oc=AdrfummHZw4ZCQ2XON5Uoaoj1KYo7ejuPdimFAv00i32s1gYg0FjrxWfV_ZZOmw3VlM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OoSQyty9xR0hhjy7ynb8B6hBrbq1q85PWaQTLLZYJVQ&oe=6A4664CA"}, {"file_name": "migrated_image.png", "id": "205866957313946", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410397_1882504361980066_5469701135616966656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f60RwQYUE-4Q7kNvwF7Z0-q&_nc_oc=Ado2EG8N--iaa9VnCA51JQvBRFjjvyH3jLRfXOlYutIjL1yMe0CjrkCEq2aBX_aEexQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-w3uJrWN_HuEyIVX6-GrmLjPEsVu9fweREGP72dswOw&oe=6A467E43"}, {"file_name": "migrated_image.png", "id": "200723861180513", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz-UVEtXmbgQ7kNvwEdYnY2&_nc_oc=AdrP10Hrv-zIzMmvcGijOwQ2ppf1JW-OsDZoP3OXHBNbTJlLAr3la5xT_LPektSXyb8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PGoJCeNGT9Yw7JG0jhZ0BF1cZDDQb-APQKvCWUwt-TA&oe=6A4669AB"}, {"file_name": "migrated_image.png", "id": "191725285587420", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12139301_1864267880484395_7085743045286559744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXXH6SttKm4Q7kNvwGD0QrQ&_nc_oc=AdrMQxwODXFYyF8ZKhZXB3V5xwCjqST0CVUIFT4irYcyU_U6GM4e9hpvccxIXCDP8K8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XytPZzh2ONDFk8xAdzC11fCIPOnPuNTbtOYr0Y6rdig&oe=6A466C09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitola.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Capitola Digital", "support_website_url": null, "website_url": "https://capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29099386733040868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12139372_1830214350593421_55835
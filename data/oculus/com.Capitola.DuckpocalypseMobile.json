-ord5-3.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cktj_TvgO54Q7kNvwGmYLkm&_nc_oc=Adk3RXukhM592iu-zPvRTVPGFaijzV_CqHLguq51OJhyDXyo8mPwEtcd6JcET9-ybeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvAi1YG5eVDxRWo5vRIt4gvl5edbIBhyv_zF_PHG0R8MA&oe=699B01CA"}, {"file_name": "migrated_image.png", "id": "205866957313946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410397_1882504361980066_5469701135616966656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P14wF9CUUtEQ7kNvwHu4A9n&_nc_oc=AdkENascSBaz6pvsVIOEVOtOifSz-_OvDuF2Qip-2NX_76WUifAXDZ8vxagDHo3s2i4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvqG-Tpn8ykh-e6br-zjVuv4-r55e_9yUyMs1M7YiTjEQ&oe=699AE303"}, {"file_name": "migrated_image.png", "id": "200723861180513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4jAN4hrxI0Q7kNvwE9WE_y&_nc_oc=Adk2o9M8Hz0Gzv91I_H9CYV8K29ViEgAdsPsmXRlcR0neXdmuHuK2zp1nx-2ZBh_stQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfskaTklskEtazxQ5kZRGYucU3iSfXQPZT_8F1NbGftPhA&oe=699B06AB"}, {"file_name": "migrated_image.png", "id": "191725285587420", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139301_1864267880484395_7085743045286559744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-ISEXGEU14Q7kNvwErEWcC&_nc_oc=AdnsB5jamdzOp70SvaGR1O1EZLK5QqM5o_Fsx79RRHi7jSV9CuICvv0hghuiywyUIHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfurVg01h2fW6pUE_NZbhHKUq3Scju-jj01fB-dO4r8sKA&oe=699B0909"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitola.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Capitola Digital", "support_website_url": null, "website_url": "https://capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29099386733040868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139372_1830214350593421_5583545565989306368_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uoo7TEuZStAQ7kNvwHtotGI&_nc_oc=AdkrPao3hvqmiPZRqjenKQSLSQnShI2yn63sKxYI5w6nRo6Kc6TuL0etZG-2keD6dx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afta8boWmjN05KQIMgX_8j2wG2w2t3nCLhzx7bmBZOX33g&oe=69
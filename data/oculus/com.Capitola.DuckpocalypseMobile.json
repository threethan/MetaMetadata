ame": "migrated_image.png", "id": "683972135689472", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138842_254663068281724_3865679658292871168_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xW-Tj80mOWAQ7kNvwFRuN0v&_nc_oc=AdqztCglFM9ZL5RTo-OerYfr_Ij5gmgkbkZ46hsDnDwkr1OnWkT9UDdEdbVmh7aNQbA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpP54ZfAKgle5byqW5hPPJX5L-AYDsu5OoZ9ajU7NWWQ&oe=6AFF22E2"}, {"file_name": "migrated_image.png", "id": "219212722615585", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NOzKd1YcDAQ7kNvwFza4wy&_nc_oc=AdoDhussvXa94MzaPMFMQCidrbr0DQJn07R53SjXLAqAWMPEeXiXItq_e1_qev1wjBk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW91s35ruptr7Q5i0MRmZ1su_CSK89ttDNiv2TcHDYvg&oe=6AFF33EB"}, {"file_name": "migrated_image.png", "id": "208934503655336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dloTF_CGpoUQ7kNvwHjXpSj&_nc_oc=AdoHKYqnTJACF-Y_BjAv-gcgsyAro78vWDVHvQpSJmeC9U5Bs3U-efdHuwYIGQEakjI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4WaO-EmkgzPxUXknG_h_WmAvxS4jlce5qWYBKIBfJCg&oe=6AFF2F0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game made for the HTC Vive. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vr.capitola.nl/", "developer_terms_of_service_url": "http://www.vr.capitola.nl/", "publisher_name": "Capitola VR", "support_website_url": null, "website_url": "http://www.vr.capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "ARCADE", "SHOOTER", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341798126234463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1834477123501996"}]}, "baseline_offer": {"id": "1834477123501996"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1487181600, "status": "PUBLISHED", "id": "1834477123501996"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1292741817465400", "version": "1.2"}, "id": "226132784482808", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1264133353659580", "is_concept": false, "latest_released_binary": {"__typename": "A
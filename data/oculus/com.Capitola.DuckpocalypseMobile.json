-iad3-1.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvBlsYhOxrAQ7kNvwEbzwb6&_nc_oc=Adk2pb6LN6XInLaFE9LLaKZI598T2610A66gP5ED9-GMJoDFXKRztcZvlmRXi95CYvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQXl40H3ayw2G55mZoPQMhv_JlSS-unLWkRua3raePaQ&oe=69A2EACA"}, {"file_name": "migrated_image.png", "id": "205866957313946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410397_1882504361980066_5469701135616966656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wgp2-kabkv4Q7kNvwG5IM7f&_nc_oc=AdkMVMpIAv47KvTwOLnbMIWEDpojF3McodvaThzQy6PtrBB4A9ObEu8rueso6j7AfjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMThQxBurAXAS2RUoU4hI1qOzVw88XNGT5LpCIws_8pg&oe=69A2CC03"}, {"file_name": "migrated_image.png", "id": "200723861180513", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arTnqLtqNOIQ7kNvwGlenFw&_nc_oc=Adk4KW3xL2FPGVfF6i1iOGdRtDBsTmf_ZRoJGPm1750mnhATIj0VWEHTpB6n41MLLno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvOR9CklNCzoqUMNo4LBvaqR3AStAiUs4mBgzCjsap-w&oe=69A2EFAB"}, {"file_name": "migrated_image.png", "id": "191725285587420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139301_1864267880484395_7085743045286559744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8ICWg3f_UYQ7kNvwEGnSIr&_nc_oc=AdkU6up_7ETaTyVUMqBre39Puv8RJwOWz2mzaSZFE7jpOCCtG8HZkA-wuIWAWM9Xttw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsGFhGrVE22m6BgXMuxmcB5sl9b5ki-VB-SPtb9eamLA&oe=69A2F209"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitola.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Capitola Digital", "support_website_url": null, "website_url": "https://capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29099386733040868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139372_1830214350593421_5583545565989306368_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkZgSI_XpPoQ7kNvwGk27es&_nc_oc=AdkgDaqthp1sXMuZskVib_Fa9nd3obl0JVwZVHhkZWW2-GNLg0a_x7nWKYBKwOY79S4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvIKtL1_CeSjuJX0F_E4omHTQ5mpkEKmZq54JfQ5DY7jg&oe=69
 "migrated_image.png", "id": "326196295030599", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRbhsMxGyZUQ7kNvwE2YZkp&_nc_oc=AdmeXvCGA7L4z9WazgWHsUt-NJd7NB9kUkkgKLF3g2jNPW5TC5NGEqHYBw6msZlpjzY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyT_nkTp0s9O4yteG7mhlE354qh-QHEusqOD2mU7tETcQ&oe=69BAA5CA"}, {"file_name": "migrated_image.png", "id": "205866957313946", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410397_1882504361980066_5469701135616966656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqx1U9zXN98Q7kNvwH9N0B0&_nc_oc=AdmFf4yFaRr7SybaCB4g20fckT5nrZMiDUcmhieBpaFD_HnFtt2Q809DIWmW4rdtLuM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyuqWcRB6L3t-R2KIuZlLHma9DTx3EeouwEkMUoETu-Ag&oe=69BA8703"}, {"file_name": "migrated_image.png", "id": "200723861180513", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvJym6EJgr4Q7kNvwGp1ePj&_nc_oc=Adl2vd_bnTzcl3CaOWbiVaoFu9RKadTWFPDHjl_Ehg3vv7mzRjIWTn2DgBpDuq5NQRU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwtJTucrI43AYH7AM0Do9G1uUdy1dRElMtCwGwHbHp7Ng&oe=69BAAAAB"}, {"file_name": "migrated_image.png", "id": "191725285587420", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139301_1864267880484395_7085743045286559744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohoPerzKoSkQ7kNvwHM5sAc&_nc_oc=AdlraevSXB0Lh5tqlXRtIGjomS0A2gHP9-L3WU6T6YZ5B1zqopPwiXWhzJ09ZpQ_IZY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfYZFSzq_QZSzCaEoxfYjGWcwfMgnmB_e2isY1T_CgTA&oe=69BAAD09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitola.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Capitola Digital", "support_website_url": null, "website_url": "https://capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29099386733040868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139372_1830214350593421_5583545565989306368_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBcFt2QwCEUQ7kNvwHI00LT&_nc_oc=Admxjn1C-1B1HuD28t6a96epdbcLai8rRG7dSxcYO08UF9XTHibLdY7GxRv7my9b
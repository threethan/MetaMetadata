-sjc3-1.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cktj_TvgO54Q7kNvwEZZ3rj&_nc_oc=AdnWRE4hejXGRbbIiYHoDEnYf73urGIBqTjLjzL68paMfBT6QDmhXK-Licp_TQUXbRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvkLaIVSCG_wyBfATcLGaUo_qkJu1xcbwh-RpV7Ga7LSQ&oe=69985ECA"}, {"file_name": "migrated_image.png", "id": "205866957313946", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410397_1882504361980066_5469701135616966656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oSbOiEqHaQQ7kNvwE8oUM-&_nc_oc=AdmnsoCQvYggZc9mwYKDIY-PN5sUABAYf7ihxJDXLAPSa5w3GXdzuiXT5UIYMR9UyZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftkXUZ3tty6xLXJfRL4fSmLlVvBJFCjIyCX_YYmm9oiNQ&oe=69984003"}, {"file_name": "migrated_image.png", "id": "200723861180513", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0oCPUSzwroQ7kNvwE-52Nm&_nc_oc=AdnlvS1cUqxCkIuYVQOiX9cPI00xR4baIIbJXwETHNZ7Ib7exAh9Ds0SoyVNq5ZiNko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftUhV0NPtPeDS78413LmVG6PCm8Eun2tl_eqgNSry2bjQ&oe=699863AB"}, {"file_name": "migrated_image.png", "id": "191725285587420", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139301_1864267880484395_7085743045286559744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmFcigIb328Q7kNvwHHGQnW&_nc_oc=AdlWDqUf-dFW0yNoCBWaqqQ5b6vGWDyoN2WXE78E5TxeYsscnqAKCtNJwWRiwhiAqFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftgGn_haOQOgy4fyMuA_R3hYp8Qo6QhTSfSynGXENrEkw&oe=69986609"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitola.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Capitola Digital", "support_website_url": null, "website_url": "https://capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29099386733040868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139372_1830214350593421_5583545565989306368_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pxuHnR6tbkQ7kNvwHKQ40Y&_nc_oc=AdmL4bBHkL7-dipOxyCcVnctv82hjHysecI6v1co6UZ-7j59jvwK0TrKl-jHnf7Dzb8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsF-QIyetrL0X_-myYVjAkDFyHmIcPvX1S5CnrHL3V-wA&oe=69
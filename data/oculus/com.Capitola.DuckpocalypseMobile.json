537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewxoj5N6j2oQ7kNvwF0Zsyi&_nc_oc=Ado-fAUg2R2rV1mzCP3x6ZW5zpP7ulPlU4p46f4DMfq4Mk_TrrY0ALmNplT3nthBWmg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGLVXLr4qZu1YaqVLdpwwSqE-gxaFcgmuk1m8tOF348A&oe=6AC4F9AB"}, {"file_name": "migrated_image.png", "id": "208934503655336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b2d83BEJi4Q7kNvwGgiXyT&_nc_oc=AdocEsgl4Ez75XKEbu0mWMRTYI9xx4jGmiO8B53NGhLtr6VkMs3E-ZHj9v7DMcZIFZc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCY3E6lXOsp3Rcupq7mcwRR_ukowRckOyE3IUyOjG1XA&oe=6AC4F4CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game made for the HTC Vive. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vr.capitola.nl/", "developer_terms_of_service_url": "http://www.vr.capitola.nl/", "publisher_name": "Capitola VR", "support_website_url": null, "website_url": "http://www.vr.capitola.nl/", "category": "GAMES", "comfort_ra
 "migrated_image.png", "id": "326196295030599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138843_356927344661418_8700206928137027584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDMJTOUvArcQ7kNvwFiYBw5&_nc_oc=AdmVVhR3fHeb_6aCmbMZ_4hk1eBq-07JTb0dj1xF-jjXjV699h-l-F7J_KYzfFf5Qc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV2lO9DxkPDRsOD5kNZthot32Mkbkym9RD4WHwd-T1jQ&oe=69B019CA"}, {"file_name": "migrated_image.png", "id": "205866957313946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410397_1882504361980066_5469701135616966656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_AMH7lrrecQ7kNvwEoQ2bd&_nc_oc=AdlMGq6UtvEJcv-7-lnK-gHpOrKsRV_PcG-tFt25o1WPZsbiUV2wZ_yj1vl1KaRqjrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMmKuilDbC9KmMU6VaZKE4yu5xYEtUVU-_iHxsx8rU2A&oe=69AFFB03"}, {"file_name": "migrated_image.png", "id": "200723861180513", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138844_959403247537527_5807590361731694592_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8PpsYltv0QQ7kNvwE3JUf7&_nc_oc=AdkpTduG6qVIHzp79XpZHFMh0jMTZENAIFEjeNO-JxJf1g4moUB7AV7p1FAVJXOarYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhT_1KpwnXC4ygK3PLSy16aBBCR38nVac0dZOlQoNgMg&oe=69B01EAB"}, {"file_name": "migrated_image.png", "id": "191725285587420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139301_1864267880484395_7085743045286559744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxXbgsymgd4Q7kNvwHErXXG&_nc_oc=AdkN6FPuPxX9CCvOfWE47lPLogpcRD8SN61oPftXicMfJoqzTmSQwB-Hi_En2T35_N4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwGKcbJoee1KZUtOp5t014TSsMVb7rNMi9OVASIwliNw&oe=69B02109"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Duckpocalypse VR", "keywords": ["duck", "shooter", "hunt", "apocalypse", "retro"], "long_description": "In the future, intelligent robot ducks have become smarter than humans, they took our jobs while we were busy fighting nuclear wars with each other. Few of us remained to see what is known today as the \"Duckpocalypse\". As an enraged simple human mind, you manage to build two guns with the scrap you gathered from an annoying robot duck, and so this is how your duck hunt starts!\n\nDuckpocalypse is a VR arcade-style game. Get in, grab your guns, take a second to let the new pixel world around you sink in, and then shoot that start button! Get on a fast paced challenge to bring down as many of those robot ducks as you can! Invite your friends over and see who can set the best score!", "short_description": "The most intense VR shooter you will ever play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitola.nl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Capitola Digital", "support_website_url": null, "website_url": "https://capitola.nl/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29099386733040868"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139372_1830214350593421_5583545565989306368_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqJTtioanV4Q7kNvwE_jc1R&_nc_oc=Adl8-VvTI7ZlXlzqnTLxM7Pglvx3QnU0RA6E375WrsCfsH8ShbeI_oZnMT3PbFxg
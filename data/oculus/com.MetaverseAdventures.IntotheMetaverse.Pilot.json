D5pCcIl1bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC7uT-qsdshEu90bDRvgeFXNriHlRxJhZL-M1II1GqRQ&oe=6AE749F0"}, {"file_name": "Into the Metaverse Paper.png", "id": "168105641801610", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974522_168105645134943_4837882455736189732_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOT8k_Y1yn8Q7kNvwGpzKrH&_nc_oc=AdodGiE71VTvrvhOvnQIwgMT5cMXEHrw_FmN8T189Ouiv7oQdi2htdDtkYO7fwxuF3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-GtfLHSptKfZgxoYJyhP7DvCebu_9NszIX_XWsAPWsg&oe=6AE76734"}, {"file_name": "Into the Metaverse Climax.png", "id": "226622942555084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_226622945888417_4251017930490221920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwzyQXiscXkQ7kNvwHqGdPN&_nc_oc=Adqq2bZ5NV_2mBUUSw1N4nyPWg-mGsQWM9K9KVXLTkpuaHUV8BLYkR-jAD_2FjeEKP0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQee7LHa_UhhHPfZeKIafileul3LZJaTozQofhfIcRPRw&oe=6AE744E9"}, {"file_name": "Into the Metaverse Cave.png", "id": "189748356332416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974693_189748359665749_5205557421742767437_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcd9EPDZi4Q7kNvwGAHMqb&_nc_oc=AdpBl9VvWOEslZKmg-QCqfaN82DiG8_ad6HixI_LtHgkzyQrreegBPwdNO69NnPhKHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd9w4pAf8-UuqSdOXv7Xl6_cD3aDCTTKlrUH_djPCKJA&oe=6AE73FA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Into the Metaverse Cover Art Landscape.PNG", "id": "1140414183128894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_1140414186462227_8407141374657230556_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLP3BL6FKZoQ7kNvwFDpC5f&_nc_oc=Adr9g_xRs2plrHtTZMQ0uwjwOTU6ODNvaayvmwZ9w7jrbUJv7J1u6Q-Gmuyj-P0lagM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfaxpg3v8xQW5nTh0DrF8FnMNW2l_JKuvneQkZlkLZaw&oe=6AE74363"}, "display_name": "Into the Metaverse Pilot", "keywords": [], "long_description": "Into the Metaverse is a Virtual Reality Dark Ride about humanity's quest for ever deeper immersion, showing scenes from the past, present and future. 32 scenes total of which 8 are available in this 10 minute polished and very immersive \"Pilot\". If you love dark rides like some of the greats from today and the past such as Horizons, World of Motion, The Haunted Mansion, Harry Potter and the Forbidden Journey, Pirates of the Caribbean, Spaceship Earth, The Amazing Adventures of Spider-Man, Journey into Imagination, Adventure Thru Inner Space and so many more, you will be pleasantly surprised how much of that experience can be had in Virtual Reality now. VR may be the ultimate Dark Ride tech. \n\nIf you too are just as excited about dark rides as us, consider joining our Discord server \"Metaverse Adventures\" and come chat with like minded people, get the latest ride updates and even help shape the future of dark rides. https://discord.gg/9MBQG4BN", "short_description": "Into the Metaverse is a VR Dark Ride about humanity's quest for ever deeper immersion showing scenes from the past, present and future. If you love Dark Rides at theme parks, you will be pleasantly surprised to discover how much of that experience can be had in Virtual Reality. VR may be the ultimate Dark Ride tech. This is a 10 minute polished Dark Ride \"Pilot\" that will leave you wanting more. Come check out what the future of dark rides looks like in Virtual Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.metaverse-adventures.com/privacy-policy", "developer_terms_of_service_url": "https://www.metaverse-adventures.com/end-user-license-agreement", "publisher_name": "Metaverse Adventures", "support_website_url": null, "website_url": "https://www.metaverse-adventures.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"
uscdn.com/v/t64.5771-25/491829165_4361261947431173_6805165643974796442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4JhF61TzJ8Q7kNvwEx90wf&_nc_oc=AdrvRBRGmkiDyT5r-ZKJbr3tRWzrvB0yI6jtdetYhqYVymhbyNjfHWN8-BQ8Amixk5s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VMmfMEfa5iXYGE3e0NTxp1TmG1IjVVG7SFhcBqv9hQg&oe=6A2C1474"}, {"file_name": "HighresScreenshot00001.png", "id": "1479829683869929", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491831569_1479829687203262_5820428103908562985_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2urMkPAOvMoQ7kNvwG7HGbj&_nc_oc=AdrvZpCjtLQVRAhz6G1Lm4XZKmpYld-SzIDBEt-rK4w6zKmrkhf5vZST4C3jX81J3sk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rALdbPlKYTz9eqQlogOzT9T-u5zEnJ6NbxKrBHYVdNQ&oe=6A2C23CA"}, {"file_name": "HighresScreenshot00000.png", "id": "1477657257334759", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819982_1477657260668092_4656899281242974633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctlLadoX5LcQ7kNvwGVn7-t&_nc_oc=AdqXRMix3LtI7BnoU46J3WVpyHnrJMeB6Bwb6DRH9XnwHPOGsda9vwmHHcDm-_eZRMU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fiLWzPVRtXNhYBL8sUthhaOLWLuX7Ahrik9xMHb61KA&oe=6A2C2384"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Types of Electric Vehicles", "keywords": [], "long_description": "Types of Electric Vehicles\" is an immersive VR training application designed to help learners understand the core categories of electric vehicles, including BEVs, HEVs, and PHEVs, through interactive and realistic simulations. Users can explore components, functionalities, and real-world applications in a hands-on virtual environment that enhances technical comprehension and engagement.\n\nThis application is an integral part of the Immerse Learn Types of Electric Vehicles micro-credential program. It is specifically developed to complement structured learning modules by providing experiential training
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80jjJl7Bwj5o4k3-6ao0nTDtjsTop1MWM17jc4NDGpdw&oe=6A242B74"}, {"file_name": "HighresScreenshot00001.png", "id": "1479829683869929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831569_1479829687203262_5820428103908562985_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMtCXH6CV08Q7kNvwG-Ni_H&_nc_oc=AdqxgbMHzDb0uRS2SjfXyGcNRG7ZycFmNYqoNfy8meAqXBU99O6cshdG5sKUpfUwuLM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UucJSVtMsIabvFEUn7-MO4A_lYIKr7OQtePQWo5IYhg&oe=6A243ACA"}, {"file_name": "HighresScreenshot00000.png", "id": "1477657257334759", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819982_1477657260668092_4656899281242974633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikhFXcUGsRIQ7kNvwFsuMxC&_nc_oc=AdrVTzSCPIZFCjhZPAPASsQgEF6Q1g2aNiWQz_msoSmjXgdg-zVtC3Drcpkbx72FRkM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CNrbf2HaIluwyATAvNBcAysdo-3aVLfHKd64bVCL9PQ&oe=6A243A84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Types of Electric Vehicles", "keywords": [], "long_description": "Types of Electric Vehicles\" is an immersive VR training application designed to help learners understand the core categories of electric vehicles, including BEVs, HEVs, and PHEVs, through interactive and realistic simulations. Users can explore components, functionalities, and real-world applications in a hands-on virtual environment that enhances technical comprehension and engagement.\n\nThis application is an integral part of the Immerse Learn Types of Electric Vehicles micro-credential program. It is specifically developed to complement structured learning modules by providing experiential training. Please note that access to this VR application is exclusively available to individuals enrolled in the program. Unauthorized users will not be able to access the content", "short_description": "Explore the different types of electric vehicles in an immersive VR environment. This application is part of the Immerse Learn Types of Electric Vehicles micro-credential program. Access is restricted to enrolled learners only and is designed to provide hands-on training through interactive simulations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26799429079727220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818852_1488989146019677_4657217130913856642_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G47mrqv9H4EQ7kNvwG9QwhV&_nc_oc=Ado2DrP1X6RQg4FF50P7W0jdBjKLfYsGMKtpYMvgJMH47q7Wj_HfzoD8JRNrZTapANQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CAfVIALVJeE6vdHssrU3iFSd0ngPdah7R2mU78Lsiyw&oe=6A243BED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Types of Electric Vehicles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1778142120, "lastRevision": {"nodes": [{"id": "
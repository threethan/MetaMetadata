0yWgTh68TnZPKz_rAPCYKYhzsaVb0lh3rKz-Rg&oe=6A11C5CA"}, {"file_name": "HighresScreenshot00000.png", "id": "1477657257334759", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819982_1477657260668092_4656899281242974633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlPaualr2x8Q7kNvwHHu2nK&_nc_oc=Adp3jSQbJ1mQ1backYAygfzKk5qZMigRT-RQlnuS-1WiCLceBS_TU76MuoktYfAMR8w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56HnO-UpjWDLLN1F0Gy2ZPDwhDNleO09KkYi0tszyRpg&oe=6A11C584"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Types of Electric Vehicles", "keywords": [], "long_description": "Types of Electric Vehicles\" is an immersive VR training application designed to help learners understand the core categories of electric vehicles, including BEVs, HEVs, and PHEVs, through interactive and realistic simulations. Users can explore components, functionalities, and real-world applications in a hands-on virtual environment that enhances technical comprehension and engagement.\n\nThis application is an integral part of the Immerse Learn Types of Electric Vehicles micro-credential program. It is specifically developed to complement structured learning modules by providing experiential training. Please note that access to this VR application is exclusively available to individuals enrolled in the program. Unauthorized users will not be able to access the content", "short_description": "Explore the different types of electric vehicles in an immersive VR environment. This application is part of the Immerse Learn Types of Electric Vehicles micro-credential program. Access is restricted to enrolled learners only and is designed to provide hands-on training through interactive simulations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselear
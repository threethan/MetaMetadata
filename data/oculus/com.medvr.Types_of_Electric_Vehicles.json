.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h4wKGC6-IzC2p8UZny33T4HW2AspUugaGHo9gt3o-gA&oe=6A218874"}, {"file_name": "HighresScreenshot00001.png", "id": "1479829683869929", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831569_1479829687203262_5820428103908562985_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWy_FzD4SawQ7kNvwEPV0Vr&_nc_oc=Adokdm2J4Z9Kv6h1rtNSGFGsShK99-8UR9DTXdtHLkwJEJiEZ8-iiDzSsqgQm2DEIdo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T_2LbhdFljLWUFXHKLSo8oFl-l_0EhyaptEQI5jKdgw&oe=6A2197CA"}, {"file_name": "HighresScreenshot00000.png", "id": "1477657257334759", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819982_1477657260668092_4656899281242974633_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x14ii5HegnkQ7kNvwE6M2-3&_nc_oc=AdofSGcX_COD3WkUgQzdbRaYcZEFUEkFajL7r0PGf1f96CQBI8hWUot2sWtJlIs0Bds&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8U_JWfVPri_c9XhIzJNXwy3gnT8gF2InkZ4FqP3iz5Q&oe=6A219784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Types of Electric Vehicles", "keywords": [], "long_description": "Types of Electric Vehicles\" is an immersive VR training application designed to help learners understand the core categories of electric vehicles, including BEVs, HEVs, and PHEVs, through interactive and realistic simulations. Users can explore components, functionalities, and real-world applications in a hands-on virtual environment that enhances technical comprehension and engagement.\n\nThis application is an integral part of the Immerse Learn Types of Electric Vehicles micro-credential program. It is specifically developed to complement structured learning modules by providing experiential training. Please note that access to this VR application is exclusively available to individuals enrolled in the program. Unauthorized users will not be able to access the content", "short_description": "Explore the different types of electric vehicles in an
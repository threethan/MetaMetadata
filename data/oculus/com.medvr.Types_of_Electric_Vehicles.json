 "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Types of Electric Vehicles", "keywords": [], "long_description": "Types of Electric Vehicles\" is an immersive VR training application designed to help learners understand the core categories of electric vehicles, including BEVs, HEVs, and PHEVs, through interactive and realistic simulations. Users can explore components, functionalities, and real-world applications in a hands-on virtual environment that enhances technical comprehension and engagement.\n\nThis application is an integral part of the Immerse Learn Types of Electric Vehicles micro-credential program. It is specifically developed to complement structured learning modules by providing experiential training. Please note that access to this VR application is exclusively available to individuals enrolled in the program. Unauthorized users will not be able to access the content", "short_description": "Explore the different types of electric vehicles in an immersive VR environment. This application is part of the Immerse Learn Types of Electric Vehicles micro-credential program. Access is restricted to enrolled learners only and is designed to provide hands-on training through interactive simulations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
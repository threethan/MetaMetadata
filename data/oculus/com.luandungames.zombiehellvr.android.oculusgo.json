4NZ0ojwQ7kNvwE73vAO&_nc_oc=AdprO4CFE7c257Ekg-X3p4H0q7c069oQsOYyjpfEAx2nMFKjZEP_UV22eHjnzxfCuNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABLJId2OOC55aYKQQd6LKhUm8v1h2oKJKOgs0q77nURA&oe=6A525B56"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68kU8gP7icMQ7kNvwHPCam8&_nc_oc=AdoXQRNUVRvBxmIL_kERsEWe8RNC38deTNTm0w5Q6GwUazeWZCV6yevSBC1SA8a7szM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPMgXpgabqvHrD1vCKNdAK6XXegNX0SVrBQLmmkZRX2g&oe=6A5241A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQeU6TYLeGYQ7kNvwFgFwgk&_nc_oc=AdqJTfsges3DRz7Bpfing_kOor_P-Rg5qRfCuiiP8pdR4P-1-YNcTKfxIFZ5E8Kaemg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-DzcxcySKX4OHtUGyiyOh6dLoEEtu9MbvvurgcYUJ3Q&oe=6A524A64"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uucTskDd6gQQ7kNvwHz3Sqh&_nc_oc=AdrX3veMJv7bUY-XbuwEY0N8pgGKSJUId3PUTnH58m7i-fjUeMqnscmZHesImlgIDIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC9CbsjH9M41Jfo5rpX0l8jXGxuxrIZsdLUjbQ5u1E8g&oe=6A524898"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYWOYYzI2W8Q7kNvwHZpbET&_nc_oc=AdqCYPjWqfZ4w7IXyExOM7BjxyJJ4utw9lhpb7IjZPcwAjBiwxnPIKqftUg2TRbkpqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA7ZrkoTIsKntuVmdBNuWlC0LYp6MP78NqVPfTWrKFzg&oe=6A5239D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
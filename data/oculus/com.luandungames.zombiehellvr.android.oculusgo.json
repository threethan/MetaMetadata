pc8kHNPAN5SwNqVDMUHtGvN9VQMI_VCA06sxj6JAXayw_9D6Ex0GwgYSGEXIWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwn64jy5j5V0CQPmEBYFfrQ9R2Tm7KkeNDOCYJSx3XQEg&oe=69B54096"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL6sf5E01joQ7kNvwGOKdRV&_nc_oc=AdmrCxK8pUD6sfk5Ul6vmWcJbfeYkK0xbIiXCGhJi0upDSPghfax-avR9uJSMeQgizg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6z59qKCj2OfwxsaGfSC0KRffmN-6nOZtO-eTArmyS0A&oe=69B55F29"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9Rznhv9i4Q7kNvwFQiOxj&_nc_oc=Adl5xKAXpLEoAEO1KCekoqc5TCyvIx2WfaCcAmdPsE1KfJ4HCBiQSRTPrEYYDsytC44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyouyFmKOZElgEhDEy7tHaCbUt_W8463ScMVrBQ2NVv_A&oe=69B567E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEqjHD-W3jkQ7kNvwEcNyhp&_nc_oc=Adka0gUHwy-Emn8tZs5htXZqM4pRpDuNTx5eAYtLD5dDi3ooJ5jbrzDbS2lRGNKmg7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfypPXgYMrQ1PebXeUO3FpqKaJ_eh4cdxczsskBEbLWVjw&oe=69B56618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdI-7eTAr_sQ7kNvwHFAUGM&_nc_oc=Adlzmz7hpxaHW0DL0sTq9VfczxBrQqM9XlzadwUCXgY0C3k0AiA_YfF4TjFAKddLp68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrgaugE1fnjtgHJ74SnxkDQdvawOsB-c4ieTNmGkj_Yw&oe=69B55753"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
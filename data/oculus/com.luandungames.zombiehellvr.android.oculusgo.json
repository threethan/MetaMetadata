-Y7h79AQ7kNvwF6ckQl&_nc_oc=AdqcFNE2fq6U147PSJWrHrQnBpoP6O6PjGC0Q9ZOg7-kORBC8AnC0N1DNfhsNPIaLu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa5OBigmgdwp9XWrORId2se10WqDaRq7Mx7bu3ORNEgQ&oe=6AA2C6D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csKKiE19-voQ7kNvwH_LmB0&_nc_oc=AdqwHfBY9LJAg6iLJl22gCJE-43a7rbyLDHLknIcZJwED_1NTfbyMjSSK-diBthmo7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpm-ZDtqBeJQ8T48NCnyR1gTa35YSl4H9zS5UYcVQg7Q&oe=6AA2AD29"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF-nNTzpC0QQ7kNvwFo5BLJ&_nc_oc=AdqedcGarex1Kb_y58bidWKLlg_hhENPqe3N4neT0P5f9vW2elpPUCMKj3noKDkU2A4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG-vbPGSrjrjnMZKsYoyrbQ3Xkx2j5IUhHj2t33agELA&oe=6AA2B5E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pah79MfwL7MQ7kNvwFLjSyj&_nc_oc=AdrFB1QfAJ4SqKxmO6Icdi_avbZTlu6dg3wyldX017zIauimcMMmPl7WYGjg1jum8E8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPBcLRQ_Sy3Ec3QnB5uoBDE8pkGKq1tEjL_9DRbMfymQ&oe=6AA2B418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpQ8uUQ5L50Q7kNvwEJhKRB&_nc_oc=AdoI2MBQfixU22QdpbyM2GK8QCnoD4BfT7heKI8q0SlPRQYxIg41gxqmMDGQINUrHug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrIsm4TbILlCf1MdEeuO3yigoJ4Iua89AQRd8_CBIntQ&oe=6AA2A553"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
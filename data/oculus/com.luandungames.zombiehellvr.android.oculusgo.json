y_u4sYkQ7kNvwFwZ1pa&_nc_oc=Adrd304Xd3zAT02HLMcENsu1iuDG9YUlbiWHWM2BW6lP0t7TF6dO4oVjzjBrPtO6l9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoGHNHDKADfSfwPY82BHCf1kXckWKj9F9hW--SJNqIQQ&oe=6AF87856"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=893dIyZbh4gQ7kNvwFZS5-Q&_nc_oc=AdoMxTPoB0CR3vAjk0pL1mrfBnnBUoJwJYszRhMbUSEjbFBO11sHhF_WY4eb3IS7v-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHWZx5UZDqS_1OvyImI95FYY2PG7B8mzPKsKVGXXOKPg&oe=6AF896E9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltGgZQtS9QUQ7kNvwH33bdD&_nc_oc=Adp46HTYIi9PrzmC5jCQ7gScPvoAxswhGDWbxVVWA-8A8n2UTCpwKpuIX39yK-ZCZAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfimTCcvQCqAgrPnycfMc9un3XsW3Ano1KjqZ46RU2EA&oe=6AF89FA4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VulhRNwRaQQ7kNvwEgXXCW&_nc_oc=AdrlA1rpYY7wM66MptOCS7OqGr1rRhJXaF9679DYDmxJ2CT06IiUo0oF9heA858KauY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdz2o29JMmPbYIFhKkcmKOru-i1QGedBgPKKnR2ydeGQ&oe=6AF89DD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s3YfK2IaLoQ7kNvwGhLmjJ&_nc_oc=AdpMPKrQUdCihGtfuoES71SU4lTsghy6PJ0Q3UjIxmmcdBXMSaq-1zniSBgJI6Q6iq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTYQJan9ipMqdfUEdna6rBncJpHPF6PD4Bs_zdo_ethQ&oe=6AF88F13"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
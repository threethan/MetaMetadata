Yf2qXC4Q7kNvwG358UF&_nc_oc=Adrb4n3gjD8iVlk2lHGfURbic6FVFtH37h41u8rSXGegsuy0NOOUYVk7Om_jmnyVfg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xJ4QqrqAzCu0S0RD9C2huln8AEB5opQrfqdgtqHaEhg&oe=6A1464D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jd3JIsXdA8Q7kNvwGQUdJR&_nc_oc=Adq_Kk3tJX765G0GdtQrwD44MeSZF01tVcwNrmfU8wvx4_3KzlVvmCCdeL_dlRQXCKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76q5czPaWSTfnF3KYIbrdR-xCgyuulM4xpmMV4cyCL3Q&oe=6A144B29"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_P-FZEsOvAQ7kNvwHXaHmr&_nc_oc=AdqLDd_t8tcRLWWKmWUtAZJdxhZQBuF-6ltEWLb9tHT6SeVkB03waZgtewxkwB-WWxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FZdEyCCaEX-AfMgC_LX69yKiejq8McK2LpoxRbdXFDw&oe=6A1453E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0pNhZVvaSwQ7kNvwGWBMgb&_nc_oc=AdpgdzDFxb3CEhBOMIumVqoyD0hv0jRm9Zv3TofnQp4nnH9343dOPvX2kO-Pik5NHJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dl2kLqeIpmNL4uki1bHM8GGOzvStMUob9_J48UiCrFw&oe=6A145218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWVW-HKJpVkQ7kNvwEV1DFR&_nc_oc=Adp8oj1n_4mJT11w4wxgNwtLgXcrTV1Mn2mg8e952sUjVYKS6KKr6smzp6pv-ns1IHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xfVBa9G4gkjPZs2cRLhmZXNHYNZiEzzcfgIGn59eEyQ&oe=6A144353"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
O6mQczQQ7kNvwE1m0Ma&_nc_oc=AdqbYu9q5DxEhX8-cWdUz2KIB3_U5NXsUidCOopdkNZPDwy1nkuXrPAcVU8xCOaCG9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84fDCKurpW40uSiZXFwZ64MwPkhEIF2Qjz_wQ4zLt-fA&oe=6A3408D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKxDjNNQ4nIQ7kNvwEbgv2D&_nc_oc=AdpZUapKshJsWJa7Esv80J64UmsK5vHukttneIFPfuv_HF8UxbZP0NFLkD0TVZTRDsY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kh6WnQHmGU-FvruEpKm0kbTuXz0-iB15HCp-z1jSMUg&oe=6A33EF29"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n19UEC0AFnAQ7kNvwF8ZmD4&_nc_oc=AdpARnKl475e4CEpdJKtL_JRM5CCrESc3G6Ew3lROL-0jmrbkTdnq6j7eFuY-AFKUms&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rfx8oKFYfeNzchTa5YzBocdgPjTOK3IppGF64kVN3sw&oe=6A33F7E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU-JzX8iyvMQ7kNvwFeG1r3&_nc_oc=Adqs9iHgA9d59EXRULeWanzyHMYV1XqAFGlIR2yOc51hF3iGIuoMR0sZc5R-b0s53p4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D96ksQlSOCaXh6kHYOzULZ3hVCNuG2op9bJflnVR9UQ&oe=6A33F618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxEATKt251wQ7kNvwG_4oyE&_nc_oc=AdqR_24URjuBfe-BB77hgos6ITwROq1JJObZOoVkvG4TMx2uyUWznvajyQ-wHVF6bvU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t73iMtso-MXT0pnF_d2D_k-uQIjCwE5KUOJOdEiZr9g&oe=6A341F93"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
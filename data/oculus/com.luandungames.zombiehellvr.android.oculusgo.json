rYAIkV8Q7kNvwHNv2_i&_nc_oc=Adpx7XI_egw5RFy9KZcZxVuz0tOj5RSdzipMKl4ASftGHDr6PePe66635niRE9gtrkU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAOB5h-aCZqnS64GgqxfC-KIr62U4rjxLNr25VYLoYlA&oe=69C3C116"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDCpO-CpdrgQ7kNvwEo3wsm&_nc_oc=AdqBUa66RtXn8yeHZZcGoz0bcCWAthndXKG5PLWOmzTsTt3FjjZOFSDI_lN0qxralAo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBZhP0LowkJ4PXvkxcxRXx6MsZ6WFnqnsMYXqLEZipwg&oe=69C3DFA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3ssaELZPJwQ7kNvwFyUOdU&_nc_oc=Adp0mu86pHBiDB4sqknP6Q5jSMR3vMoOwQNvGdWjpIp0EKS1z5gRuA8bP-y3dc4Oifg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJb-HzWnIuvJoliji7fScTKi9pc8JgKARUe3BzdSTn5Q&oe=69C3E864"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQoknOuU9dQQ7kNvwFB37cI&_nc_oc=Adp2DEV_6TXCvHo8j4ZeLlT0koSz88tqQ9_oTuAWd3ykpWP4QxNUy6cjvhStjSKSlXA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwClHMsop6DdMvF2L6p-gz0M6C0MYhU1arj3bML2DxpGg&oe=69C3E698"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70Le5XPjwD8Q7kNvwEYiDet&_nc_oc=AdrfXXyCA95xgwNFMfk33qo_Ls5ZWpz3GxYjzb8Rlf_5SvlrHNImLXX8U4Ly2jy-PEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwI8EF8lt9mfaOBwfY9TsN3BPO4A35ty1-5AC29CCJvJw&oe=69C3D7D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
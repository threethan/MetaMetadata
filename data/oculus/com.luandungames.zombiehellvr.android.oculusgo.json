wNYiC84Q7kNvwE_87sh&_nc_oc=Adrx5NBGnBRWUJBy7WGfqELS0PuHNz1nffOM5lNJPPpeln0zIVZJjdcCx61csD5Wqs8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznJGVJYSOtgJvdK0HabDPkrhbPmac4bhuuGfth-z35Vg&oe=69CF9E96"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSiU7R3PAXQQ7kNvwHfLmC4&_nc_oc=AdrfkrEtxhNOJ2bChADK_SWK3LgD_3VIwxXG-k93_ZohpL9zK0JydKFlfljXwz3wp_Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwTRhcIz_vvcPOtuMEQZaQQStMqRWAMPLW3Q814vnG3A&oe=69CFBD29"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4PjGAZWTJ8Q7kNvwFrjXcw&_nc_oc=AdoeOZZIwX4OvfChc-3gQfnZp5MxI0RHAjoLnDTohzbouN1QyHq88gmkinc5zCQc7lc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT8dYfFtCBU9S_Pqrry4k1iBG3oP7pQOKQSdgWZx5Zwg&oe=69CFC5E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPXX5ZROGM4Q7kNvwF1c0JT&_nc_oc=AdooDOM9oZ_Bu-3ogIKYN0t-bzcxHAPDmTd8g7Yvck4NAHZr87Qny30OachQ7XBAxGA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-80PmZryL5r0gnheioPPcr2gGczfLn5iK9l6WhdLntw&oe=69CFC418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvGqrUV4nI8Q7kNvwG6PNso&_nc_oc=AdogfQ7pYA3BmddeqHrKMC0oMdMCBtCfnJ3tAl6gLgUBv6d_11evLzr99xWqSGB00iQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPN5X5HKQ1qmijnQatT79tHBlQV2Y9FwlqHihpxNSJSg&oe=69CFB553"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
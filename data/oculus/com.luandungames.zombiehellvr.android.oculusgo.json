6tK7g2sQ7kNvwGZwj06&_nc_oc=Adqns1fUlwecIRIZ3wY6WcUl2yMNNTDxvY10YigurLH62kfX3IYBvysqm7SAVFJQQ4c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzT6UYlrCNIGUfa2AUYGobZPCATrSBFjsD0GdWmvQxmw&oe=6A916B16"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPKqOfSxGv8Q7kNvwE2RyOT&_nc_oc=Adru2Ib_ADrFdfa5D2TU9FG6b58J7SjIKfnikMUscNkk6e5xNqjl2HNsEqsdFhrqHVA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpb1Itf41FNB8FBCm2AfPXyNMIHBcmeysulPp1pHvccg&oe=6A9189A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWmAAF95t-4Q7kNvwH4hmld&_nc_oc=Adp0TBneHaUiNnUuozZlo9gNe0rR8EJ9QLNB9VZ6-ttVzXoINp7vwVtp2PMJ5HmETmc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqEO2slGRWQOBWHAQAiB_VuWMsbG_u8RWI3G5JelTnfg&oe=6A915A24"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71pRfRg81iYQ7kNvwHYQehb&_nc_oc=Adp0pfh1TLotxwxT5DKyRpmfAlEK6mrEp6TXgkEhWnALTolnTuS1S9HIEKVyLgOd5D8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQs-BucD1fQ8y7V7u_Pv0GO8-CVORkC3hc0ggZHVkmBg&oe=6A915858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYgmA8A0JYAQ7kNvwHjHtBk&_nc_oc=Adr-I3ljCXfyy5qhRHUY4rZBo6_UoFbnkfnBQP25abeBcDW7XuPW3sg2Ccm4QWB4k0U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLd8Aty2BjEobly18cuh7QPumtoLteOqAUvLYUtduIrQ&oe=6A9181D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
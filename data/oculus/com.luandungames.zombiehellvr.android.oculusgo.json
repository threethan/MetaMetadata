SuQ_JWQQ7kNvwFHwV7h&_nc_oc=Adp7gNn9dq3k70e7jWNIgyW7-9dgLD4NndEY6wnTsnnqF_RcEH19CtuVH9U6i3A-WFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0sOovDYJy-6c8kaBUOzubrIOL9ck-Sev0Hmx0ifNV3A&oe=6AEDEC56"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI4tUSIa1UoQ7kNvwFj4204&_nc_oc=Adrnx9344syvw2Iqk6iiTcn6QamP8MKQyiSVqErCUfHRltdjzwlFyLTdT2-wzr-FNZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYux-Z5nBbpgc9IYWXQH6307h4Bx-MQbVMvtPspHDJKw&oe=6AEE0AE9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29q84Fcf-OQQ7kNvwEXSWiI&_nc_oc=Adopbn4QqddWyXwMN279ka2ul6BEuCeAuaV46QeCGBivHM1SEgGap0ZZQWbNvObZaXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFrRAqSXAM5mIO_fpU1bS2bd86EFunP-gmcJevGi1pSQ&oe=6AEDDB64"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyL6wwoOqo4Q7kNvwHczzso&_nc_oc=AdrjLy9Zpx1JQQ0vy5f11q2J0STFmSOWssSKhaJCOc6EAplFap6PCnKwcXiBgpapJO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Pb_ny_os0fZtUizciAscjTYs-QZzgJrTFnSmCoXmKg&oe=6AEDD998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sydv91Z2tRsQ7kNvwHLYSMn&_nc_oc=AdrVAzOQ6u3N907sT7PwahIzrcQdsd2DXJgV3u8f242csJSdrIO7hW8woQE9WySfoG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0VyQXaxe0TVKTdXPPopOwhTzpynuwIK5ajHBMTDa9aA&oe=6AEE0313"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
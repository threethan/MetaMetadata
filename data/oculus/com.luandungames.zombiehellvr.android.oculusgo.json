k958dBsQ7kNvwFyd5iW&_nc_oc=AdobOlzjXy3ir8aPT4VpK0W5PwsvtjE1qGxPx1v9mIXkR-GbVvw60X2Pl8Nm4aj4m0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kr3Xa9Z0HcguZKyUrICM0CYpYJftOq8xndLwNYPpL_g&oe=6A0735D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLL55d_dxb4Q7kNvwFGyKva&_nc_oc=AdpJSBQw6zJW4ov5pWYnEvMi6efi80O0mcSsd6ghgHSHOzI61GsHGimy1UCJN1fKeS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SoEU1RnXjOItGVyffznqr25kkJclQodtMmrQb_NX9vw&oe=6A071C29"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm5p1b2xj0kQ7kNvwEIYJY2&_nc_oc=AdpqE1bpMYt13rwL9P4oWcXLlCWN3wU6KW6jAcZXGSh30ZRfgNomif1OrS83AvV3QJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af641Htzt9bGKu6cV6VJrXvZvgojNhEYWeRGuUj7KeKXMw&oe=6A0724E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOILyrs-s6EQ7kNvwHY52nk&_nc_oc=Adqvl95jhVvi8X8Is8H2pun3lmKvFz8gPT0Lvyl8eUB2yErAhgEcvkjerIlX1oIa2_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KeTyZCZUwC-CZnWCbRDAlisUmXRT_zRaq9NZLkuqkDw&oe=6A072318"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSyG9nxKu3EQ7kNvwFF3tCk&_nc_oc=AdojeCqfXr4p0t-a7Q7STcKUhybKyylXubuFZBqQgxcZioS6cBB8AFGh8Jk3ixLOxgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XYio04HtGrwLxT3APob96qsD_akammxQrVo6g-WdhwA&oe=6A071453"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
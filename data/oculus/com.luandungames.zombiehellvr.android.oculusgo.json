iCfMYqsQ7kNvwF2OVxo&_nc_oc=AdqyXzCtzOdjxG9_ZFhxPZxmbdJ8E9IGFTD6PHK0CYJT8bOz57SgrlRiwuFeruq3ZoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97N_pYN2kPeNHu0jvGDlTXkv3ffpIKjANEAV2XQytrLg&oe=6A47CF56"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBeDivR3wrMQ7kNvwHPUms1&_nc_oc=AdqnrsN2cnCiUmE8ARPaKnUerzcJDTpUOctD96zymX38I0sRrqCHuG9onbUfJuVEf8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DRTNhFyThI_KbNatEj9KdXoliOh_Wepp2UqRHbxsIMg&oe=6A47B5A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-svbNXhBzLQQ7kNvwE5WHuL&_nc_oc=AdoqJb3tjGiU8CFKNEzBH9Q9GHAuqsrYXkH1IfBgWxgdBOsAY_AGgjXJ1z8VEAZLVXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gh0iVDK2d1A9wKGLl6nfNPK5KPFsaTGFugjgPzwQRPA&oe=6A47BE64"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hwy8I9sVqP0Q7kNvwHHDOhv&_nc_oc=AdqsBXWtyFY126jhrFShbxf6G7IQHiLHvEWWoa7XL48P3nDW1dkUqsmEGn_f3jpT9VI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I-VcMOTkYiRd7qRANKCXm5X8Fjudeg6NV7RwKsRoaMw&oe=6A47BC98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFqys-JTif8Q7kNvwEyV8OV&_nc_oc=AdqzwmCx51yYddHrqsXadQczuidcmUrUz8FPj4hSmPYhlJk4RQHQrICe4IUCCOqeniw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2qor8deZLVdC6gPu2FuJqjK0DYj3WSQWQr0axQqHAvA&oe=6A47ADD3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
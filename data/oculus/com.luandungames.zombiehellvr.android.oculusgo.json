k_fldxNB4bzZzEoi-mChca5mSV8rnAk1e0r0JVx531Jgxx10qXZPg6q3xgnaYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVx--Hqr8HO_O0IAGIOUnIJmuujbrzC3WXRsASVM4jjg&oe=69B69216"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_xkqFUuesoQ7kNvwG5S-mn&_nc_oc=Adn-Rqiha5d28PuscOmOcsl5Q44c_v8gDrOIDiS5KWZsC053TjxxHmD6swlvFFIA4jg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2JRi-Fz5_enfMPM_vOOEmzG9Dz_y0BWsw7YYcess0cA&oe=69B6B0A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9Rznhv9i4Q7kNvwFmfmWd&_nc_oc=AdkEwC6yeqBWczEcUXT_X94j8L06QTNiIAmacgqTVjvdHsoUaO0Ekf9bZHxFx-g5IEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuuZHXZvC6GypP9V_RBT2UMNK9MN_dTDYHnZc_hTp2Cg&oe=69B6B964"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vthOF0PNZpEQ7kNvwHa0NTj&_nc_oc=AdmQNdkc1iIOeJ9GxzLfTOs60oxvvXBYTS6ob1w8eIBXNvn-2YVSGovPSD6EkR-4f30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzamkURs4CG_ryRa-HsD_KggvvjhR6QXbGSJouR2nhHzg&oe=69B6B798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdI-7eTAr_sQ7kNvwGq6q7V&_nc_oc=AdlGGmmA4b0fYmc3Inpmhh-5HP8dDcnco_j6ISiCstL7uicT2KAvXLt1wQaa-_MeV7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxhlaiqo_zZOUc5_yvEFPuHBcB2IBiuQF2drP4gumBgAg&oe=69B6A8D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
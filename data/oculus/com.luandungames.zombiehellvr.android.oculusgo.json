y_u4sYkQ7kNvwHA-zOO&_nc_oc=AdpGH1x1tL5F-54kLA4wCmDliOvRi4aU744sPGfJQHagnChvhkgCCLVPYifU6MqnENM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF8g2K4cp3mblrTDc-yujuMGIye-_haYsQWgp0SPYrHA&oe=6AF9C9D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=893dIyZbh4gQ7kNvwFdswI-&_nc_oc=AdrvfSYQZ-OJ752tJA3LZ6MXPJyIBxQTOiKgbIvMt_4o4km9BgNxgpQQkL345TiE3XI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF7PeJi0YTi_j_8ki_UzDdI1eoV4US_pz9anTkayTzqg&oe=6AF9E869"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltGgZQtS9QUQ7kNvwH-Z-ms&_nc_oc=Adr72Qc2B1fCrAA7VgR2aoAG--JQuwpkmRKJ2oILuLNh6tDwD-ANkAxijkGkxYDQtcs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHg9o1_aG7ElCOUKoz5_IlVNjA_8Te7QvberUi6ygmWg&oe=6AF9B8E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIIar11WOtQQ7kNvwGDqS1Z&_nc_oc=Adop_NWeUWiEgpYXWZd6zFfqz1upba3fMkJNAxmNJtpwo19t9oBEAP0O7tynW8q6Pes&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-1nqZRzmgaAFzZur0asEo1cxF2qKkt-28lCeCki3DFA&oe=6AF9B718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGGZP70UqQgQ7kNvwE3U22b&_nc_oc=Adr0oW0Gdh15BKnSg08GG01ETeU4TBsF6f1duK9AXdi793qZMaGMg-meKsJbuxqtzH4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR834KHZ0z7nXALNqVEObI9SZae_9rWnzZpJI6efDsupg&oe=6AF9E093"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
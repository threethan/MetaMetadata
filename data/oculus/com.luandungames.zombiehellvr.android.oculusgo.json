az_Tv9EQ7kNvwHaW7n5&_nc_oc=AdrRCI2v0rvDX0d0Zt90XuA9DYwajZaoaDqDpMNDQ5kfBFJg5Cp6Q6qWT_cRi8OJIi0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN9ALkXuRZxpN2eFCuI9m7uD5QERMnMSTYgbG8F4eVlA&oe=6ACF99D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K9p5E9_b8IQ7kNvwHm7ld5&_nc_oc=AdpzeqKNyX8A3eLnL0xGftszPA4trzOKdTyu9zZTdyFRcvabBjIU3HggaqWUcwH_vjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgrTg0MP26DQmA3fEaOb_n6k5ebz6XqUL0KtrnpvcToQ&oe=6ACFB869"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goy0YtrbzeUQ7kNvwH0OfU0&_nc_oc=AdpuiM-A9NqrMCgpW01Gqs8CMy6uUMfDlccuqzz864HpRfd21xWa0ZjWZ-4p_0au2FA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPANwM0NPLwdRxtjniNGaPMBBXOmCTvjohisqV71JtR0w&oe=6ACF88E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ8qJkW_CEsQ7kNvwFn0eF7&_nc_oc=AdpqJoLJJ0_yay5Zbll6CMmhNeSUt8tSQxEkuRknJSKe6A_OfdcSh8Ewf-MmjDSEboc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN6ThyNBnS0PuEl8Ksc5NNcTVm6Jlu04HBdTAtX_yUIA&oe=6ACF8718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVZfMoxVXa0Q7kNvwE3ZgeC&_nc_oc=AdrV3KrPhs4tR-EIzyLv_pIMAl82s4HLfjGrRZVCiiOgxbO8gXT6LPoPrfRht21_t_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN77KiaIND4eVMxAx5oe6gSsJOd05cxG2Q8Xnxf6Ssb7A&oe=6ACFB093"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
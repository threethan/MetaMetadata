U_w3idQQ7kNvwH61fsh&_nc_oc=AdoMBcqKun_7Kg_RLHMtWBovrTt-KXd89HXOHh_FDgkEUZIJleKym17IAvunJcgO50k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1I-sTTQGZJWs2KRVgL0hHTcAAjLIvJnYF2maS5R3lpw&oe=6A2C1FD6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH9MBamyZTIQ7kNvwGHTTg1&_nc_oc=AdpJ56dOJMcmrZQ40DzQTrgJGPUDPE3PoNCKn6C-hjgWhgKa9UuLgbd5imHHgViXEsk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vJJoFVrtXmn2dpxo1GE5Xtb_RkPzAGAb0wUi6TMdrUg&oe=6A2C0629"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry53GFEZ35MQ7kNvwHmhzDs&_nc_oc=AdqQmUdjRyDPSMWV8qDSlOtZAfI3acSY62VNjB1979pzNxuXUt0tFmN60Xzik3PYXbM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pknyul2Jch9ATN6U7G0xoeWRoSrpsV8avN0XWYX067g&oe=6A2C0EE4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tFj0eLHBMIQ7kNvwEG0sp4&_nc_oc=AdqEWFx-hPr5y1U9CHVQq9jGutCxwAsTIKR65pZ3YQaFZT_Se-9QJa_-J54tt5puYos&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tyJmwBsbm5Fb79Ny5UigUp6fkhR5AgSByF4ojWeCd1w&oe=6A2C0D18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6mC49c2bYsQ7kNvwHvlzl9&_nc_oc=AdoT9QTFjDEAhMPPuliGCWFV2as_oVvSxnPyVcmqWDHHdPOA60uAe-7OY7TFk7f0tUE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bJ9FAyC23Bj4ac5RjTZtKeIC8t2ISxrOl4ByJhDx2ag&oe=6A2BFE53"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
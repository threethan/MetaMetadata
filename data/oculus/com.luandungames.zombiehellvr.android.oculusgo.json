plqXLkEQ7kNvwEDiSvD&_nc_oc=AdpD_RdY5Hgq5jstX2FxEKPmfZxbHrw9utKHybCBDPWSWI64FL2FNnzaztz9Zmh6Mos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-Kq-QDiuMnqmRd8Hm0MZvmwo9vsIQMIj8HMYH_QMIyg&oe=6AC65F56"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFcv7Y7lki4Q7kNvwGENRKJ&_nc_oc=Adpkx1JKiHT0LKNoWSimljAvq8hciBP_fwsGv2aieHgUR4kWBUReiGtBf1tFqBGSluQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYEI55KtmvqNx-vI6qWOqBD2nV_5mbiZpEa8HIxnygjQ&oe=6AC645A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxuVQT8rPmIQ7kNvwFK8AJ7&_nc_oc=Adqf2uVSzc95rtfrGwPQpklUWEqskFSRf9hfg6dRj-wEUCglIWQq-7hAI9jVpS84OAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMgWbsOutv2KP6P9BHRoH1_HVh3_wVowsLjtOgAw_pTQ&oe=6AC64E64"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Avlcek5hjUQ7kNvwHJRIuv&_nc_oc=AdpSy3hDiq91tRAiYL_qI0Wc5y6CW3X70MoXIRLSfaK7PiuF4t49Zq1BubHfNB61kos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-K4P4AHmEDfOn8mvCO0nRmwZ-4dkpDSa2y_4XGWkjNg&oe=6AC64C98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0AXsASFvIwQ7kNvwFCFww-&_nc_oc=AdrEj0PCREFVigwjBBQaaE7xHb8oE7IeBzCd2DedsZ9ntCCCthc61cncxlnvST4xVR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgIdNGJhmP5piWCghG2a9PjFvKkA6eSZFLod6-HpXNtQ&oe=6AC67613"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
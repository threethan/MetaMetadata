jCbTC1IQ7kNvwF0roFM&_nc_oc=AdpwDxmY1oyc5DOW3L5FG3yMeIYZN-72_2iXSsFn43-eOqDrgLcILxJEc2vZB6nEaEk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKFjAO5jV_SinxVePS-86apPzebUIxeS1rO9zoVcB3Ow&oe=6AC7B0D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caAmedxAuY8Q7kNvwHN0eTK&_nc_oc=Adorjn4yFLcaB2bJAIlcJp1fez6KuC80UOT_4wogc1WFK3StI-8akX_aKfn2UZLkCz0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEP2GeGN9wwdTn8XeBR_ABmU_xoIk0lBeNz3h_O5zrZg&oe=6AC79729"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxuVQT8rPmIQ7kNvwFHwFcL&_nc_oc=AdqrDKdhXXiZmtZGBRXOCoel7aFetkCMrN7aYUA9vsojlrxDnET00pqmH-cEgqqAUS4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-3OifzsjXjwnbHkJ3Gjl3DHxllL8w--h9osiUIbZXRQ&oe=6AC79FE4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Avlcek5hjUQ7kNvwHlnguA&_nc_oc=AdpQOycOfMMyV0EV_0MEwSTf8-oAXJ5tW3SJzJiEe15EhEl1oJeVuqsDzwQi1aKImtk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8nrzoimJejo16-yA3QYQPzDTga20AK98Pjr5LzqvBVQ&oe=6AC79E18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0AXsASFvIwQ7kNvwE9J52F&_nc_oc=Adr9sHy6G_KzW5bpGTqCIcOi_mDvhkZmEsxD4SondS9xvyXhO2hcqwmR5ggFhwIXdyo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyKIXPVUPUjAEys027n10zZL2WRIsVfgBQdVv2FxKYEg&oe=6AC7C793"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
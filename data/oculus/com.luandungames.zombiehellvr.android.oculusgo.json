FBYp9zEQ7kNvwHVIEVP&_nc_oc=Adqo-hSrm-Qu6A8TnzvDjAaRD3ZIkqgxnJ_0IWajuMc1FvEDc9srAl-howhD-h0d9Ho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLzn5UJHC3Gt8tNKF31Fgs5tRkyeTjtaM6ZByqN72R3w&oe=6A7350D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxX6BoAJ5LgQ7kNvwG9wqxE&_nc_oc=Adpsx3sTu1JzCjw2AFdokSeRroS5-NgfrTOBzx_5w7NPAMATVdSJ1Us7sLl10uD4ZpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4ykOcdOzb23YmJkS55EI1oM17faEmP9lM9Nwz_7i7yQ&oe=6A733729"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adcJlnCp090Q7kNvwGEVc70&_nc_oc=AdrPd7kp2O2rtGGW26Y6_xW_Sl3IrJcNAGMXBZVBD8aIpx9hikjaBYq4G5UDpxNgaU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUEPS82F0WmVr0cC3h-dNAUymehE_Rrqvq6RnovcsH3Q&oe=6A733FE4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTErgPQSRRIQ7kNvwEy-JWv&_nc_oc=Ador8xQsVKGBBP37ffWEXsfaKSlT10r0WqdMqLqs3ROVAZrz7jcufZW9VL83hgR55nA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBsel7TpUl5Y_-wXB7FIkg7mfTlbCTg_aP-CljiBbOYg&oe=6A733E18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDW8sSIp0JkQ7kNvwFRLbQa&_nc_oc=AdrHiEN_77T51r53wv74K-StpP3BezYcwchNHiCvdIoLmTv21mYyW6_WkocAJjBDB8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1Z_qur2KmwDrLFvdrftDy48Y2BvLJl-nudg4Lomf7SA&oe=6A732F53"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
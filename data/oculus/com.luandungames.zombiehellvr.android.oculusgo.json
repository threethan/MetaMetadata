m5JgWFwQ7kNvwH587wv&_nc_oc=AdpaD1v5F81EMvpPgrFPI0-dgycFw0YjmluNbN8lBNyY-4469BweOhV5O6y0Xwgfwlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vtrNgFtTE5LTJxAuiRIfKG7pmgX6aJzhdQc3FjC-wtg&oe=69DCCD96"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjevwtsD8rkQ7kNvwGT6eFq&_nc_oc=AdrlLz1i-TpAeEanuQmQV4meyZjbzjrXP5Ogw4aQAB6SckUI2ZqmXvXir05W9zsaW74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rMJes7-fY_Rrll76DuLaTFuBtMJ1FQ4l0TDHz5jo-UA&oe=69DCEC29"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ1BA9kowEUQ7kNvwFtd0i2&_nc_oc=AdoZiaUIp0ZlG3QI_OOuqBuHQWB4JVTBQRrLGtoHL5i6J2430hnav-Ah5ma_2pwpMuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z3ovDr23hLsMdTrL3x8K6K4jNQmAvZT1ZcS8RYtkhTQ&oe=69DCF4E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhHbFW4Z45sQ7kNvwFEoHNW&_nc_oc=Adpox1KfmnSBRDc7Vm43roDv7H9ZYZJArgroRa4BixndvevMEjbD9Utl-EHoOBZmYyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fOjRsE84SvPrjZZ06JxnLmM8Ve98Vz5Yy_wzb1HuCiA&oe=69DCF318"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uoyFj2ZG0EQ7kNvwFgiR4m&_nc_oc=Adq-FuBUd4hRvgvD7MT6JR9ZtS6VKsWLi-Gp5YmlLWKp6tKnCjIbIKwsJmfT-z_KV9E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bnFw60XbJ90T-VlncM_jjthfZ9l75i_49ELTC8LP1rA&oe=69DCE453"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
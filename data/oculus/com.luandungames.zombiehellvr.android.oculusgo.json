QJ-omOAQ7kNvwHMDZzs&_nc_oc=AdoVhY4dN7uistj2f7Mgx7DJVgPAptB2VET_TMIx0Dxisx7N1nLG9xMEj7YIo5wL0bw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHh-ucUT--28LoAiHUipdjm-XWs4LLHUTpu9IvyaaIkw&oe=6A6A1656"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvYKlsCJfIQ7kNvwGEtNse&_nc_oc=Adr4oafQ0iNsjbFudZA0tuJRVjWE2irMDFqlal3wqVovussA7nTmMiZOaMMGVUufQpc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC63h4e7nTLy_2_JChxsSwotICqRwDfEnjVpLw5DQqwkg&oe=6A69FCA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8RmyYs8itgQ7kNvwFEZ73D&_nc_oc=AdpMikOLIuT3WEelDKcH-ZzXIzmyvAFG_veEC7dTY3one-JT-QquEzcpdZkTGqBgXD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHabnm0_EhVcedAlRHVeg283PzJWJie3jbJlUsippEhA&oe=6A6A0564"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4OJjfQPWCkQ7kNvwEq7mG1&_nc_oc=AdrMxOfASlCvjNqLE2D34Cr9a1RHbqyzDv44XhUkTjTka8DrSzg6VJxH7Xp7vN3IFGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClRi4hipRjXe1C2k3AaTP0yuhEVtJLFLzuDYtpLYv4Jg&oe=6A6A0398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snk3PpKAoAAQ7kNvwEU2fWn&_nc_oc=AdqTl9acccUBFrEqLEoMz5t5O2awu1KGskSMB9Dhv6nIVojBQK8jxLn1ONEO1GDZ9cY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCibLowJZKHqrKjnVbCW6uyjOljhrUI-aww57jWGjz0-w&oe=6A69F4D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
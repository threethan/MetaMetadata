4NZ0ojwQ7kNvwGLQ6-U&_nc_oc=AdomNpq6ovwKTy6ZP2cjENJVYudixV10009ml8xOAk7hDH-yMpF9bXekzvFtK2b07YU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUjfFGNyHrXc4IuhHYZlBHFWITjq_ePD1uLS1NBfNZAw&oe=6A53ACD6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68kU8gP7icMQ7kNvwH6j1rC&_nc_oc=Adpbf7OrLZuQvRXBXZE50hqi_RjFTNDITqf-MA5oCBFesVyhxwG11ZPf2LengULBnJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO1FqGqxMEyzbrJdcSVffRkhu0Kr14Ep-sw0Pd49A44A&oe=6A539329"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQeU6TYLeGYQ7kNvwG9KGcO&_nc_oc=AdqEqT8ILGBwohR0Y1YUhwmtZBKfu9ZlWb9Firt53MPjPle1PHboQ6bMazRWTh_SS3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQZAgMsj83-EPxXiMsRB3C_F3t7kfAL02UxRO05H4mzA&oe=6A539BE4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uucTskDd6gQQ7kNvwGgOCN6&_nc_oc=AdqYxE3oSK6mSsDPbYQauBcBWkhygpjtBNHpbO8NTYeISToOaNB0FVYVL-qRhaUWqvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI3vF8LJO573OlxjyaEqevkVnm-7P1THeBc8dLRdlqhQ&oe=6A539A18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN5lVq5SJcAQ7kNvwHFuJty&_nc_oc=AdoM8N0IWuHh34MJGB0FBgXFCP2rHeqOa8j_gbViMS1AIjbEPH5rqI87Rfh1O5WhKgs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLqi0XIC3WQHnZyvFPOJC4scYmPg6q1wVkJogIGmcawQ&oe=6A538B53"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
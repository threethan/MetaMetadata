QY5iA_TpxdE4Qh3ON6U2ejcgLyY1PCREhu5dBV2jAgodmaozUYCwrBoqH4rt9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZJrzDvHUOfJUKrMu-QhimaidVPDN8Qfise5RRNPlMqA&oe=69AEA916"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l6ZZMKHS9QQ7kNvwG6rOrO&_nc_oc=Adl9lKlVVdPo0TDhxraNl8w7Sd5j_F_cZF9N4YwGDsTxS-5OA1NC-R_PNmD1qcf6vy8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0NJ8xy6TL9WZ3Id9SG_8mvFVNVEBxDaXjkjNcVbq5_Q&oe=69AEC7A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J59IvQE0LB0Q7kNvwFsPo8M&_nc_oc=AdkYqNI3prgY6XHWs5mrryRQoowRFMurkYVK6q4GKRSTqWRIgg2_vjmJWjsRIytkaUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFXNCia073_xQT8-hgQ9T97s8CnTKp6IHnc4jKXHCRBQ&oe=69AED064"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_8EbcF0WXYQ7kNvwGxFMlr&_nc_oc=AdkXP8e6BeYjrlz6q6y_7F_HoAyolFJV95s_Zs2NGwAcJn7LJYir6RGWGbjQ1ujKn-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdBP4B6FTLBpQ3OWpknPw5BaNTupgdWCzM0QFKVXHAuw&oe=69AECE98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-06ULRj9bkQ7kNvwGQ6BNd&_nc_oc=AdnGIiG6UvQ4qViyV3u4cRPiFRfTq3MGXIhCE9cmvOTcQ38oSx2g7NLzo5qAdOZw_6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqxKAKYkdhwKFM1ywUxX7Rg01-J0ZHZ4_NlJTLvTlOGA&oe=69AEBFD3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
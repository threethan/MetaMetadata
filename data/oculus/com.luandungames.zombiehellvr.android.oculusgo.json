zDZiMDAQ7kNvwEZfIQS&_nc_oc=AdqYQ_nSNLdmj3CweZ4RBno5SIcm6FANKOv_W14pdkAyEQoMtFr81qhjLLPmVZB9EG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcAju_Lg7xbKekWTTv1jbad72dkfvcHOkXrAECTvpcbA&oe=6A770D16"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcA7O6Zqav8Q7kNvwFl9e91&_nc_oc=AdpPctEuYqC8MJA2ZBepRlWHwArniocfIdqlA7-IVC4j2RQsTn-xjwrxN1yIxyc7M9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYY-MeOeNxgS_bCE2OeBi_SlI9dOcgLBuSRt5mqXuqOA&oe=6A772BA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afDGMIS300sQ7kNvwH1SZQA&_nc_oc=Adr-SrjTnbKQ27nIaNubI_mmg6HWIt1m6vFDkQTTOyKNqjXJW6qbhhzEnufvovCBD8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqpnMrsazOPwgwHVZhrNZgT6hFpcXolrQF3enRzFWi_g&oe=6A773464"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBHsQ5TFOx8Q7kNvwHv-T5n&_nc_oc=AdpepnTs9LfNZ9JpFr34ypeFf7E6CAStgKCkGFi0815-qUiZOhKmS1y6if88lBcR-aQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB7Tw7xLbPkphb1XYXm5KmFoHZnSPUuIUD3tUX7cTOtA&oe=6A773298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mpcj5jNs3jIQ7kNvwGrP-mE&_nc_oc=Adr1klkaBulqfYHGCDLxCyPdFoD0LxTXwEeHOeAoHTlnpE0PQIVweivSqYL_OaeIRxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1e0FEqBLXCxffLuHivr00QJ_BZmaCEgJmsYnLKgrJ2w&oe=6A7723D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
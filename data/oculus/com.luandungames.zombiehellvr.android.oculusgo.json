4h6BE6kQ7kNvwHPDXSa&_nc_oc=AdpTpeFFRBbaS3qok_a_SdSihTkBR9OiuDaDxrJ3RYagb0ZzsJg16yW5Ni0TpSSMHoE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIitmgAkksK0Yz3GACSniojsXbW6o9lLoNL-Chs4pLEg&oe=6A8AD396"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jp3uwsxWhQQ7kNvwGRdsLN&_nc_oc=AdoLX2ndh3hYuO0GvJSX0FM9wzfpqnyrOWyyQZ6GQ0GyiCBCkZZf4SgDEaxj3teV6_s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEowjxGcly6NZn_dbQvsmK1Dx6H5pr1xRBWFxNT9khj-w&oe=6A8AF229"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65qj54mwSkkQ7kNvwHxBCBS&_nc_oc=Adrfe-azGovwjE9kCj3jEegl-v_EnA8rV33IeLhzJPKbXQ9bgUHeXAW59f06t9ubCOI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnMiqz9U7NYnFoMYcfBeriVusOcNF-5MMT6INHN2txtA&oe=6A8AC2A4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yp7EoRHL00Q7kNvwE_UPG5&_nc_oc=Adoj8V_gij9lw6XW4W5KZhtsWhXd4qm5ya5daV8ia-iCJvvPJVZ7JlZPTh98laKxh5s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH22G0ipdAZG79OpwIPjp2CV-BU8sMu7Add40V7j2yZ5g&oe=6A8AC0D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVvDkqMlbmkQ7kNvwHPwYdY&_nc_oc=Adp5G5Nx9SbBnSZPhWBCJPxqaX2bojOPF6WvD-BfG1--nVjRCBSgBGto7Mhcn7JUneI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4IcBUPkuXwtpoD_aMr449r8s6qXE_Rug7Og2BUJchdg&oe=6A8AEA53"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
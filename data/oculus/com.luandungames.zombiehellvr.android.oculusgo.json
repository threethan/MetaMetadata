lkOL1nkdSQcJJLyoZYFp5f4q7ecGxdeaZ5JiOa-CSdQhJddgdEHD3igzxGZRdw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzjldIZPDA0ZzC4AManiwrG4EFRKNsEie1JBu_7Ojtaog&oe=69BA8696"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_-h4K8ylGoQ7kNvwFglXy-&_nc_oc=Adn0C22Gv4RokAZGUtyFZgBs0HGnbn8MnD2nsrg4ydYEtztsE6gqNqR6iJI4n0IR3Ps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz72Mi9AtDfCF8PVAxI8TU6Z2cBwlB7rrz8XfQzCMlBsQ&oe=69BAA529"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aufSyZ5FEs4Q7kNvwF-CEgK&_nc_oc=AdkbF8hgT8P5y04xYrmz-RfIZk90Zi93WrVyKhFKidHs38dVgZpMoPqaIqLNoLrAhcE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKJwexDZGLfoZ-1FnDZYfAiCk_v6S7dyfXWIlIbzsKmw&oe=69BAADE4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytSlwaIBqfcQ7kNvwFj4gGe&_nc_oc=AdkZKVnbkMAcCXs4qOunqG3cdh1eSqUUColNrlr_1Pav9IRmnckx2P4GGOjZuaqm_r0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCnGC0k5lFDWWeKht45OQ1O4Uq_3PLMCz48yquqRas1Q&oe=69BAAC18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Nd65NCqudEQ7kNvwGmQt-T&_nc_oc=Adkgwqz7IAsVHbwU4FPHWFbVdNHCIBq06TuOhMnorv5-BD1fI6jhatKjUg4l2PXlkWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzptmfJmSQcJezoBLRe4SgGNG83GcXIIW2JJ_tKtfZ0Dg&oe=69BA9D53"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
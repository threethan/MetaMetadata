IBN78LsQ7kNvwH0doyw&_nc_oc=AdprR3EyyIRvLUpxuEHtc8BVydpnGyQFJKCgDGCG3KhMPk9mTA-lDfaSgLjpXtQIMxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cYFYC2fBZHl4-v2P5ZdkxvwmHVyLuMCylJNFpSd-uEQ&oe=6A37FD56"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuJ8xP1g_0QQ7kNvwEiSges&_nc_oc=AdqgEooK0O1EI_LzFXLJWFEcRX6QHvdiGoguLDewt7D5ZoeA991uK-s_xc5ryGY5bVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QklWbmtuA-i12iTDLc4uL3LPvSHZb1zl3BLsJ6y10Ug&oe=6A37E3A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83UzytxVjcMQ7kNvwEhYW7w&_nc_oc=Ado2Oq2IDmn1z7odsnyYfdpgRawIv9dPIFAexdgAdKmnwBU7lN2UhVnojS0wwTuYGwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tOzsIcv35YrgiVsKarqwz43zXWvVGfDFsEYWFj7ISTA&oe=6A37EC64"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubma2w7NvZ4Q7kNvwGTpat4&_nc_oc=AdoikIgq6lRdP0W29VFVq_Xpd7wvd-elV8EsVo74RwjAKV4vNhFblf3vBRBsHh8IODI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4g1HmbmtTCVl_8kmJ9B4DgY6rI2NRiAhEerYF41EVEw&oe=6A37EA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwSPOtzDVrgQ7kNvwH3yWFy&_nc_oc=AdrHMjzVmZAFrSS0S7ZbLARhcrzYHnJk-GEr1of-800p2soEcs9UkFw3be95AuoouAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZEZDbxlZvG-vFIWSV3GO1TAfJ-wA-QShqiRcGm_m2SQ&oe=6A381413"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
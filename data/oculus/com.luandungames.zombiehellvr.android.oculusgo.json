7kNvwFF3yvp&_nc_oc=AdqvSHOOAqzlhLxHNiU6F1_f5GlSKT_e_XlwrHDxGTwSwLqrtKJXwsbS4yHfwYsWrG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1h5_2YYxsUzTWnNyRF_bCwgag3Y5t3d3DkSIRsIPhtFg&oe=69F0BB64"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgaJS0B1268Q7kNvwFZfacU&_nc_oc=AdrZBd0-TPhPRpSOQ-lR80v_B_WTUEY2_7Qv8ZBQRcFjNM1-k4kOXEccCF5FLQAYV6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af08ZJZSn4_tyrC_2D61Wd0K5CsDRfdkmbIfJyGcy7KfiA&oe=69F0B998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFjNkWFWJkkQ7kNvwGsvk6h&_nc_oc=AdovXjoCED0IjC0tExJPn_6kHxJYiN7OydH9GSwi8lUXiK86G8twxr06kphTPl0i53U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1wqHHMKn0BdyHQryyjNTWKZ_s03A0fddEeqp0Lk_9mgw&oe=69F0AAD3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "359899352304766"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "412170376003074"}]}, "baseline_offer": {"id": "412170376003074"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1557853200, "status": "PUBLISHED", "id": "412170376003074"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2333561536703722", "version": "1.00"}, "id": "273564976586388", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicatio
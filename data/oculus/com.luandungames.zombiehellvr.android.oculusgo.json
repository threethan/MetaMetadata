-u-Is88Q7kNvwHSt5av&_nc_oc=Ado-jDI2NtDAGIvNnalcqU3RlTNv0wHbGgfKko5Ts6h-b42Fg8AS702ce6NPeJUCFXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSTHSnTOolUjbaii8ihTFgdCfCKhmTVhABQ2YDqcbxzA&oe=6AB14756"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjQAhlhmNEwQ7kNvwFLwWyW&_nc_oc=Adqxqg5ZNoFMrCNgD8uZKWNLN45tJDtwItyvH9hY9AxsfEN1u3sdNVfV4Sas6W7ud6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtD5utlY0lfDoXlWeq3xKKd8MCzVUgWZAw8TMrDM4qFA&oe=6AB12DA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxVwlvNpAkEQ7kNvwHnfzv6&_nc_oc=AdrWFElEoGYUWHhN0DWxw8wxNt9TVxY8O7UTdhSeZYqIlSiWRWBLbahRjM4ql4DBho0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmufz45zInLcLFu0sCIrwfISAGb7ycCBFZ9gdFATMcKw&oe=6AB13664"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNT8QR-FBo0Q7kNvwEt1Yqe&_nc_oc=AdpD5rMHjV0za-ELvgbIwB1MeuVzRcDPVAa_-IatQdPOFSNQZJdVdDYpR_VbC5vNHP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2ZTFCQJgLw-JrElO2ZV7OsZi_FxHSwlzayc3JiRM67A&oe=6AB13498"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrbnkbtOQBsQ7kNvwH6m213&_nc_oc=AdoSSi5EcZRaJgC8qnvTzqL0zJk9wvlPtOMwZJBekK5DXVoUKJU-lfVQRfKyfA31NdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEBi5hveqe7Qxm__gYhkghASp5mEIaGTygHjunzL-t2Q&oe=6AB125D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
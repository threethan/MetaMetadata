vEN5WuoQ7kNvwH8aQDo&_nc_oc=Adpr0HlHL2-J7z-n37p_DRwm0F1ZvQOuVGOQdSTYgunucnN9cZFLjKeND8ebe4t33rU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYnyXMhUX-kAaXQ5sZ9RcC_KkhdC_ley43bWj88JpaLQ&oe=6ABBD356"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMCb_lF7iHQQ7kNvwERbLBj&_nc_oc=Adr1qgSiPDZJiY_OJEv3S8W7MXzJSHbGNsai-WisVH-_1_K7k3xjoySJd0agWspF5xU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFiqiOYJ4Mk5pGwR-6LKHpk4AU9ZGxuEb5MugjJtK7CQ&oe=6ABBB9A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApusCaCnF4oQ7kNvwFPlv6O&_nc_oc=AdpzhTSP7E5GT7Xksw1Za_oUb8CRH_gjHRn97Pg9ZpxigvxriWNtlZFBPy3f8Jf9_I0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVV9EO6PWgzuSa5Y6RZQW2bkMWc5aJyzXq5NBO7Eyjiw&oe=6ABBC264"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP5-Mw07SfoQ7kNvwF1KRIq&_nc_oc=Ado7enCOX0P-kCC7nuz9RqMZ7bM449-qQwntWQEPDD8cKg7hn8I4uk3WlqoNoEBnwhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjR216ce3vlWsMMtXb3hc1zAo4DW8PgiJyC4vw7mH7NQ&oe=6ABBC098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjlfAUGs7OkQ7kNvwGoPc5d&_nc_oc=AdoIuyNoon7hxShB2uGJOE61Wqg0NZ4a6PcuW4Hfl88nYiiBTwkSCPBdwltNis1LfcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgP4Op5G9GRQFmpt9ZGWA5Gq7kHmcx6sb0dn-_y9-z4w&oe=6ABBB1D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
SuQ_JWQQ7kNvwHfkZ6I&_nc_oc=Adph9xdvtfZWcFi3QmBU_-xU3OH9UooENw0KMUbIAMwNHtZuVyYjYvxohZ1JpNK8q7o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnmXaPHnCVzVVMa7oR8gVEnW75c8E_2HYldeadCe70iw&oe=6AEC9AD6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI4tUSIa1UoQ7kNvwHsTOP6&_nc_oc=Adp5feKd4Nffalc0-B4PEwKli48cNQzd4QgO0PSjKHVb2L2okRa9TT1Lyfdm3eQEcCE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCJ1VaqvMJvJg4VbktOOufz7e5zqC8eyQ6gpiT2x42rA&oe=6AECB969"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29q84Fcf-OQQ7kNvwHBVqdl&_nc_oc=Adr1sjKvFcdIfpIq1nNC_Q7rukxaj84l47TK9QFrtKnUu0_PQB_mj6SpIalRyQi0Bf4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGqi3jKD9IBlFzWSSKEO0BcfZ42nuZV2yGr9UUrgheQg&oe=6AEC89E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loflKmzMAbEQ7kNvwGAvSA8&_nc_oc=AdoAfahKl5htnx_W1YDi0g1Sn3ooPfGK3SYDwmQuRDtmmIkz-z4RWTNBdIy6EzYjtG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8HhL69IIQASQLVzgWZlZN8gZ4ojfZQGicwKm2pXwFsw&oe=6AEC8818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx-XFGtS3j0Q7kNvwH4DdOU&_nc_oc=AdrpNhjxmdIZYKObYJAk9UZEH0OsThACxMu8cNQ4NX9XfHqzqy-PJODRcQOI_c5PhAA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNk-LUeSy99NawwdLGgwHfLHAywDzQEG6-_oS06bgdag&oe=6AECB193"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
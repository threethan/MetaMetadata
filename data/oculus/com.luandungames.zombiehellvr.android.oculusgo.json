KFYM40gQ7kNvwHwJMmC&_nc_oc=AdplAFm3LQH6IjV-cRW4KGAdy2ct6Wui3KQ7hHgyZd7Kvhr8YSs9OHbN6FVTfKfwacI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t_pgAVRU0d80X9DJ8A1gHGXVCTGm7JosQR_1KxV3_8Q&oe=6A15B656"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CGuSYfJl9MQ7kNvwH4DzdA&_nc_oc=AdpjzZXZZu7zCM9UdUUfQG8pX3PDSj8QlutyStNUjQ29yxmUla671SNCnppbLts7ca0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zcI0XpwZfQoufFuw64fS4jpC6QXOkjPT7tdcuGr2MpA&oe=6A159CA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_P-FZEsOvAQ7kNvwEa6l5r&_nc_oc=AdoH5zCUtX3WvRuhk1bys-vSgfG3LZgwJbYLJTje-o1XvChrYoCyGJY3m73GehfZWGQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V6V3U1WKE07LM_qoWI4QhkS8KEbOKSSy4PFyGKCsshA&oe=6A15A564"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0pNhZVvaSwQ7kNvwGNa0Y7&_nc_oc=Adpl4KfhUUJLv5FEXVfiVbacNqGSjT6k1N8_Kx3ScQ-IAuIR0wRfGE0hisexguq4jzE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PQBqe8x6nv8Iyf3XGiFT1pr4xg6vOTE0iVpex9uklCQ&oe=6A15A398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWVW-HKJpVkQ7kNvwEuMtur&_nc_oc=AdqUP-hv3WnMXTuzdejVetRLwGJvg2GzYe8ej-z6YFywPWsq8uPXbz6iPnHG8sR8L2A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a5H86Oqoc1bNDP1_SlIzL6X1dAWdOg9Vut8E5UMn-HA&oe=6A1594D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
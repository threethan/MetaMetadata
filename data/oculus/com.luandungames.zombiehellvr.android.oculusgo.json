9UWC8v4Q7kNvwHJhzEn&_nc_oc=AdqMQNjEo2t-sPQFFnPxqIEeM-Gc-33mCKQf_q72Kt9SfiL264HCtLQA9j5N5_3RUbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EFp5GXWhjXvQCirGvtLS2dXQoNMPOBBNv7PXtAQKxkg&oe=6A0492D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYvxYu3IKs4Q7kNvwE-oiN_&_nc_oc=Ado5Tw-OC3-JeeYvm3i4-8XHXBtZkxpkRz1ZTdtqNsJjKglXqAFHbEh0QSTjXaxqMGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZTMttsUOEZXFSz6vRApFpIUNxDCH9zHhsYfDrEOhHPQ&oe=6A047929"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1MOoMWZrD8Q7kNvwFmBCXk&_nc_oc=AdpzJGDJTalXV4-d9O5vAh8M0grGgrMsk4de-0hEtjsXF9opGaFMLwBeK8MEjQh7RzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z1euQNnQe6XkwriIntd9NdVYOWgXy2GjgmmjQpCvG2g&oe=6A0481E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1nobjQ2sBwQ7kNvwGSayny&_nc_oc=AdpMbPTkS5irhdtXs3Zv0NaGK8xukp6YrKKfiKI_VKeR-kE0ljHmgIOtzm3X7trUHVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5phlL96P0COrS_PZotcbl5QjXliJ8S4-hJTKQgGfClFw&oe=6A048018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSyG9nxKu3EQ7kNvwFXVj_U&_nc_oc=AdpGSHnfwH3QStHjUzEEn0HoFCMXurpRjIKJpFVBGoVz1DelcQIxd5zEcScZSzzlmew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af653sHQuy5e7ADwuWbQAvBYftjvPm0k2OrpTOEr5lfn6w&oe=6A047153"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
-Y7h79AQ7kNvwEuVOb3&_nc_oc=AdrvDOGrx24cAjOfMpKvve2yuEVz1a44ADtQL_uNXs4clmajOPv3eZLQDr0a8vKJxpk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHlBScxeUllsSrBqLr-Nukhkv6o3dwBKAZ4e7pUXKGeA&oe=6AA17556"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csKKiE19-voQ7kNvwEzCn79&_nc_oc=AdrP0MUxPblAr7t0dnWSFZV7pfFJjFhy3VbOnt3ZoBDHA6ucJYrObRsKkd2BINN-aRc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJosl2TVvv2KPWXSBlCXdEtpf_-ehxxrdSYbnjiSyHfPg&oe=6AA15BA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF-nNTzpC0QQ7kNvwHtmiqQ&_nc_oc=AdpWw9TlbRUS045_Wb_rDPVev4StjLpvLGEub9cH4a0kcGBbkpNZoH89SqelOU2w0-c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvEYItDPmOlUGO5az2NcBApF_6_T7cLml9cr0omuijTA&oe=6AA16464"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pah79MfwL7MQ7kNvwGf3-B5&_nc_oc=AdrCcRg5I-wnjz9V9JQJ8ZIRLNxe4CAZmK8bwsODXZEGg0pEimIXl4puJ811GZVmizo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqwhRTmVNLqCbi2HGRq0dMg7fE1ej7E01VVoLlhBoZ1Q&oe=6AA16298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfjtKM8O6rEQ7kNvwFkYPxx&_nc_oc=AdpIYQoJIthfmXA6unlGgcDAKIpeYKnBXV1P_J0bd1_Xjp58J_qUwVSTMDpF86ZrwTI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUA-Ysu8aNOnMf03Vh1JMVq64pefeCIQD5kUE_4dfuVQ&oe=6AA153D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
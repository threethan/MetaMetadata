F9LDObIQ7kNvwE0PN6z&_nc_oc=AdpNBksTCS04KiJtFGUBn7GPxS2jBxfyeJ8PDqIRoIHNqLjatRicYbV1jR64sA3Up70&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsSmgO6UHSYuVIvDBaXuvup7vkcGvr0bTb_JXa4GAyjA&oe=69C66416"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEqBmJGZwh4Q7kNvwERSMFc&_nc_oc=Adp1AWQKHXgP-RBzPpSX_fEWScIujGg5ahjttLytxdQOvlbZ99Zl2hEG68IsEH6vIhc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrsITGxg-H_ad-XXQwyJvhcE23oKatNbnOR0o8njxlxg&oe=69C682A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3ssaELZPJwQ7kNvwFwhl9F&_nc_oc=AdqMOUBF4IdRIB2KNxw7l2x3P7M-0nwuauce2RNqJjeAL9aUihxHWJOAFpZ7irmW1W0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuuhdpR5iLrwySi_eT_ahaGYWWYp9iSeq5X4gR5wDRDQ&oe=69C68B64"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quRxHKYD2OUQ7kNvwFRCLBl&_nc_oc=AdrBQitwDZfUbrZwFJJOxTI1Ea3UgHyGneCW2k5w60-t1cGt7EajEA90I_fZMZHfAJI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5k75UKhQ4sXjHDFie7kdMpkHsLKCI7glrOUCJ9PwklA&oe=69C68998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrmAzXzaY1IQ7kNvwEcw7EW&_nc_oc=AdoS8SMELg2mtfNhb6PKfn6mVm1HlpRR5aODnktwmmUhcHol6Cb0Ax2zK4yIbalKS5o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwOCZB7SrTKv34sIalX84OrhocKb-8uKxCkldPzlICRg&oe=69C67AD3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
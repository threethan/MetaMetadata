JdTLiftJFfcQhKEt3t0n9-92PFKzikhY0bLWylm-ZuY4q4iXGGtHWtm_jhNaTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZedRKw1CKlOX0bjcDElw1XBQ2OPnbGQ0EN9HHYNqpZg&oe=69B14C16"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l6ZZMKHS9QQ7kNvwFOSqQu&_nc_oc=AdltIospIHMTH8LNBuKl0iTz_R0RFzS4wiAej5dTyAftn9FBaIP2hKepUbtufMwhmow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-tB8_nxkI7aSGX8oEcUkndjV3mPYbeUefqL_XbsX-ZA&oe=69B16AA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfMmKHRyJf8Q7kNvwFhqbnN&_nc_oc=Admp1bvFL0vSCxoGFYkoGxA7g7GhFDJOPWjNyzMi9yLndd7WCcHBZsdlvlxbnjrcUhw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhvM4wvprcJW91jARhl6X4NLgBTmuQCll80W_6KoqykA&oe=69B17364"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_8EbcF0WXYQ7kNvwGpLuaN&_nc_oc=AdmshXsmA_lOAmzJlheQglbQYf5rIoSkMYFApQn4bqyg57hAD-7MrdsqF0KMY2tT94I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7s0F3JAkFH3CkMz9GZ4v6ZXyRuLTVF3dYlLlehq0EzA&oe=69B17198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNbYMjN3kXEQ7kNvwH5phsR&_nc_oc=AdlXMXkv4vpexx0KkEcrr_wyfzEM_-x7Gyd9TADBSsP0bTep_Kib43kB2R0qt_XS_D8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaBBOoxJsiLleT9k5v90KowntGeMhFVbpc1EjaZFTjlQ&oe=69B162D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
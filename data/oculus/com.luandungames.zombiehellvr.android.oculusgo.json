SuQ_JWQQ7kNvwESuMIA&_nc_oc=AdqRzrLQ2SfU7jAvkBdACmZA8AyQJdOi5OiBq6HADlcZkKt2DDocvk2uSWLFMHkoPgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc2pWsBCO-AlNe4-URabO8hlSxRBZWsUhGOE4qx32KrA&oe=6AEB4956"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI4tUSIa1UoQ7kNvwHzTzjQ&_nc_oc=AdqCJUvGm8u9nGoYsou8seeoJUDp084VVMUl_LZIpzmEBYKDKusRx5XxfWNQgD2oC-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7hKlhx_BtF4WpX-f0fmUQLaniEbMw_8yWSWdpuJnEbw&oe=6AEB2FA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc1ZxVgMnjUQ7kNvwFbY_T8&_nc_oc=AdpMNw-ZucfYhX24HTrbJKSFNNQsdwD2GDJ7zrzlidmUl2rCb7wxJv3D9qdcqQIfWuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShLQB7Qnezlea6iUVH8Qku9KiscHhUkKim5ELoKK8t8A&oe=6AEB3864"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loflKmzMAbEQ7kNvwGZ4GlP&_nc_oc=AdoMdhsku5eLZsHej4SOMhhGRubQ_W-6lKLa2_54pQWFicxG5eAegmdp4dSOWIF5Iew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9kVeSH309IlC0LJAHb8dnwI5PIFNBMGrxrh0XOHvV3g&oe=6AEB3698"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx-XFGtS3j0Q7kNvwEn-_f9&_nc_oc=Adq_wh9FrvknapK4kQYj02FiYtWFUrDxWnPm1pEcrDhvPblT5-CX0hcFfgKAaDqkvjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE2BaYBCN2ue9QZuPFAbW_-v3XMJMDBQ8zUizA1uHM5A&oe=6AEB6013"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
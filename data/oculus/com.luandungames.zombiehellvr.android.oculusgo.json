4NZ0ojwQ7kNvwF0apNB&_nc_oc=AdqeOmh66gp7f6AE5rFTXkwpCfsW0ohIndNGo6di4AliRO6_BdgCa9VNSBrFXUzqIv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDncHVaVphxoyW6t9SB2Qm_9sD9nBEgSwugBfahPinLJg&oe=6A5109D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68kU8gP7icMQ7kNvwHx2FWQ&_nc_oc=AdoirhYY0P1HQz7bOPyDilj9AeCjxU_IYznlionQFfqID1J1YphLmXkA71h_ZfkpTmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsPfbCHgdg4LTnMsyR0jEBf_q7yxcTT2tlYAvLaO_DJw&oe=6A50F029"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17DMKRQWb48Q7kNvwEJjfSR&_nc_oc=AdoR1Ok32IFyDNn9yfdbamAQmueFmkGiR0j67HSpcWi_ObXgD1W0RC9vdx6G-3JDSvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXSHCMMqzomrBJ1jESdRvs9paAXabvS_A9Ke4wojOlqA&oe=6A50F8E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uucTskDd6gQQ7kNvwGicUUj&_nc_oc=AdpXL2tRz-8iBPMc_efILdyaA24-lFQt9J_iDij-SQACgkIN28AdlWNlDTbdBzwjPu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd5kSzB2o59WSPcDMX_o95eunamJCPQ7bUxrFFz1n2Rw&oe=6A50F718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYWOYYzI2W8Q7kNvwGxRHFi&_nc_oc=AdpFXJ5cr-DCmBfveS6e8ocz73qwiqdOHiEKj7VA8RBhtQIji4qjZ_7SfsxWpxR7sOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxiaN1mkgWQl4wxJ9BPg9qnpvMfcZjzoQ6mmBEC_tK0Q&oe=6A50E853"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
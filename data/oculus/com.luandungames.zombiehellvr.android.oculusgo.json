yZB2zuAQ7kNvwH_GHdx&_nc_oc=AdoInJz4-0UjbkNegBYusbXkrt3pVkWGSSQ2dQKK82BjiXjrqSr8pbHKEcUteXqeA8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wzSLxA4bBAn_N_H1Guifa0fMHt5y4NKRkR1skCyBPNA&oe=69F8B556"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bJR6lkqxCIQ7kNvwE314eP&_nc_oc=AdqPY6UP3Xck9OkXwQkRz4Zh8rAUEfX2jEXxrNdZbQ9Gky-KeHO5Cap6E76dHkULkeQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1q7udGwt5JldgyBt6C0PSS7MMohRQC6rZF7b5hMWvkOw&oe=69F89BA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h93bz4NuYFsQ7kNvwEFs1Vf&_nc_oc=AdprhsPTAmcDeFQMI0Kj_zARVb0cz3Nn6FryITH7Rl_NmhmWScwmX9avYaF7dvbIqYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-OSfLooNPljQdclhBtviPxxHPEV7109nuoiRaG1fJGA&oe=69F8A464"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM0r8oUqVecQ7kNvwHukz3h&_nc_oc=Adri75duYlzm3_XUdVDctqLL7DdueR0AM4_w-a6-dbh0utHknNf6Dyynv7HQbaY1FsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OvRGr5sz8SYZbad4w7Nkc-dbgK9ceoDoeN-WCeWLkeA&oe=69F8A298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp_8xiwkHFsQ7kNvwFibMdD&_nc_oc=Adq8Japg4heUv5l10Kjkn_MrmchK8Phrpy7bF2NS5PIyD-KofGmDezZFdjr6gGg3jjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ODcenxr6LZRgvndMvoLiH0lGUbNX026VXVA-Wg6rT3g&oe=69F893D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
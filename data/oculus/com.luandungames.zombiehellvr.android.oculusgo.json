wNYiC84Q7kNvwGHSCX9&_nc_oc=AdrGbtQTQ9rejL_F8RnkJoFwdWN515ny_QQbQEFlinxRA3mPhNvR8ArA2uCUkK71rIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8DKesE1nKExBOOUZGq-A4G_Uu5gedNNbNYNeJ1at-0Q&oe=69D0F016"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSiU7R3PAXQQ7kNvwHcKc6q&_nc_oc=AdrS6DUas8LZ6dtXVGEPxhyour6XQ31_tPBFfRGvmRBUgObUBgePjQqhtoOW2bBaZP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4P_gqGQj1NZodf28-xoAjzKjzu6K-7gYJ3szmy_ZgUw&oe=69D10EA9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4PjGAZWTJ8Q7kNvwE7QP0O&_nc_oc=Adqc1T1liKsP2K-2e6BmIe_eH3Mb-AfnVfsdQ1yE20R_BNJENyGEpvZ8Nm0GQXNn5qk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVkRaBxXsAVwmtNafsxdBXzaRUDz0gVQpHzg3bRN81zQ&oe=69D11764"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPXX5ZROGM4Q7kNvwEyK2kC&_nc_oc=Adqi6SX9vxEYHiLIyJqQLtTqctdO3zOu4LYrMDnGq9hXL4nsHWt0L9tSd8LdAR2lW9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUsI_OlNiJyYAjJqBwCuq6hsuRfM446_kmpzpjdXos1g&oe=69D11598"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RUE-vF9KUgQ7kNvwFkj9PD&_nc_oc=AdoVdvA1yuuOssWdZqQtHU5JXNaIrBETSqF3Ik7KlXOoM1YDdEyj4lUtOpl38npIbCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmEztD4uST0Ngg_L4eFo9GKeY5XzQhKofFiEIQGiA7vg&oe=69D106D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
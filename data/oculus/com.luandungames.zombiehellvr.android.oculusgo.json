qa8GcN4Q7kNvwGCHlk6&_nc_oc=Adpw6JKM7DdvYY-YQIi6kCb-5ACzR08dJfgn-O0cu0v-7zth5_PB8x9kqKsRkSQbOR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cxWoTB904cwvJF1qIjA-Hf9Vmc2TBws1b0vBCdmaSnQ&oe=69E0FA56"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_SpgaWyMJkQ7kNvwHxZNDk&_nc_oc=AdpgnApv-c3K_iTV0yNcOQ_pCmlnQa_ak-N1DUhvUZoV5vtnYjnXjdiF9OkXqctbwGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rpYz7lgXth_rDI2yrR8fXVbCRrEWmWqft4wREFpT3wA&oe=69E0E0A9"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WShW3woiVBsQ7kNvwGZDeuV&_nc_oc=Adq_yhrPqIvFDgugoFKOb1croxjMygHmG8Ya22sLrWNcUI3OCyX8x1IBj5F5wjDuRkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af022CFjvpzbG1MEn_hS6brfNT1XAGs95GroNvj76Xb-XQ&oe=69E0E964"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlT09A0TZnQQ7kNvwEDM3Hg&_nc_oc=Ado_mYpD97koWkyOpJozyGOYoRUnxwQkMWEAjl6rzf-as0l_4o20vkuGSco4e0xXwak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lJ6W84Y9x8d00OojBERDMUr5CYuctP635ZOlIKYpGfA&oe=69E0E798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB21UhkJYRsQ7kNvwF-VaZi&_nc_oc=AdroxlkSdpRTjszzSoOaK37aC77La2CJQkaOPBVO9m1ECZPdMe2MyHcBdwPiYQ9y3CQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QZknDCLBhltJfDDOKCialIIF7j1fZZkii_FTZiK0-GA&oe=69E0D8D3"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
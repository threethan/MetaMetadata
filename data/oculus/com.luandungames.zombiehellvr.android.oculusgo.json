jCbTC1IQ7kNvwGXnSQt&_nc_oc=AdolfW1E05K4TG4v2Aq6XVhx_YXoR2iwGO3XsfgO42Vi2XavALnusO_KZ177phfz6Lc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs_EXP5PfjyvJHa9LmvnovnchgUisdGH599AC5819pAg&oe=6ACA53D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caAmedxAuY8Q7kNvwFwH7xq&_nc_oc=AdprjE4HjkTojj3OOJ1DSXTtG8Y4mDZY6Jrz_mw8PCMMUcbM3qVzOawz-2bhtQ1yzXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFTaXdFpCic9f6UzetvSeVhPnEmGXJfsY-f-x2S5vE7Q&oe=6ACA7269"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjJocE7J3wEQ7kNvwFPEoCk&_nc_oc=AdraXyTmJA5-izv_mhkt5whCS3QavvAG7CZQI5h-pTBImUA4ZgcZb9MBqhrCHO4nLMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc2_Go8JkL0nySxIR6ptjsYdRV2HCBUO9qBJ6Qm4_MTQ&oe=6ACA42E4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YUmtBvh29sQ7kNvwGQk6Ry&_nc_oc=AdocDmvp5jpU99pNbULpiHtYt7gsOEy56YJk7wpNtKDEwMjqP7Yas6ABgj7wMDp7Mqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC0U1gtdp9EEgfHRdWyy5bPD1oaTaEvVdsYhlQYVgY5Q&oe=6ACA7958"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKvtqfvJTocQ7kNvwHZYe79&_nc_oc=AdrDoeYghD2kTq0lYwo6Ih2fnUj9VmVXqi83CBWSl99tWRtHz3thAqzjn2GaQH6hRdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN78rjU3Ca9EA3ZXOEaXAyXIhV_-VCUTh-xjdonQM3s0w&oe=6ACA6A93"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
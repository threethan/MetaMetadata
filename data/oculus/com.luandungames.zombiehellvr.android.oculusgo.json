3qkz_3oQ7kNvwGVUUAV&_nc_oc=Adrjps_cvNNtYdghQdh6gC48O2AhN05WCbV7Ab942Uusta8eR5Xv70DeoI3z0GtFVIw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MnZYR_yIzoLSvjFePbPr8o8NSXHmsx5VS_TyieIcMkg&oe=69F4C0D6"}, {"file_name": "migrated_image.png", "id": "2513073642277286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982611_1253537694805014_6958169408355172352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z1Vh4Bh4bgQ7kNvwGXxj2e&_nc_oc=AdqMHoQ14JJpIhWMqkrhYdeBYMFjEETqg0MFcriQkKEni285QbMppIoBhXCAxoJxzMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07aHZgLyB9WcYVUHNkm_1b9MUvHGkJ9Sbzz-tZmCtAZQ&oe=69F4A729"}, {"file_name": "migrated_image.png", "id": "197227261710024", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982702_415940889190205_3103934536531050496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qw3VOosVFcQ7kNvwHXzrf1&_nc_oc=AdqZPMr_cmyzD2CJCgz2uMLrP7SId9FNEDPnQ8bdVu1gTr9Pc8Px7jVrDDme-mU0434&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2aXrQ-X6GzfpTWuogFx2nfhNyhKXM9DohpmSKH6HzeIw&oe=69F4AFE4"}, {"file_name": "migrated_image.png", "id": "525858488133385", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984471_633824093757283_3183075626856742912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJVcthn7rgIQ7kNvwEKozYY&_nc_oc=AdpatJOvElqqf6aeb2b-SBko3ZlceJy75IeJXGSyMUAvn9R3zAlVIzK49Zeqgx6-edU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03vm3hNH8g_Jd8mnvnsrBucb8ycV-yM6GJbcBtm1LRWQ&oe=69F4AE18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZelsCu", "id": "1232830983551530", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974840_1232830990218196_3888459297247461376_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZQ-NTB-3IIQ7kNvwH5igE3&_nc_oc=AdqjPKEmr4VYCm33H41iwyouv5E7CrHkAkv4LXyHmOHK91SWEc1ym8XTUI7r592vcwE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BaL3WSEl6MmkT39SJky7JVh_4w1jDGDmgrR21T79n5w&oe=69F49F53"}, "display_name": "Zombie Hell VR", "keywords": ["zombie", "hell", "shooter", "fps", "arcade"], "long_description": "Zombie Hell VR takes you back for a ride in hell once again, this time round with full immersive VR tech.\n\n:. Story .:\nThe city is a dead town. Zombies are everywhere, almost everyone you know is dead, but at least you still have your guns with you. Will you survive Zombie Hell once again?\n\n:. Snappy Gunplay .:\nThe original excitement of firing an actual weapon has been retained. Gunshots are snappy, and each shots connect beautifully. Weapon models has also being enhanced to look better. It's a hell of a gun time.\n\n:. Beautiful Levels .:\nImprovements in game engine allow creation of more beautiful scenery containing impressive effects and lightings. Each episode bring you to a new environment filled with suspense.\n\n:. Hell of a Problem .:\nA hell of a problem, more creatures emerge from all around the desolated landscapes to torment you, from acid spitters to tough looking zombies packing strong punches!\n\nFacebook:\nhttps://www.facebook.com/LuandunGames/\nhttp://www.luandungames.com", "short_description": "The original creators of the Zombie Hell game series proudly present you with another game. Be the last stand, no zombie can defeat you once again!"}]}, "developer_name": "Luandun Games Pte. Ltd.", "developer_privacy_policy_url": "http://www.luandungames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Luandun Games Pte. Ltd.", "support_website_url": "http://www.luandungames.com/", "website_url": "http://www.luandungames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory
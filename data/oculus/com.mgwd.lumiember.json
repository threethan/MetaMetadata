ng", "id": "1264760879180782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1264760885847448_5998741483017099476_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcIib9Lq9sMQ7kNvwG_nXd9&_nc_oc=Adr9wkIy5EN00wE1fviP6_f--wqUV_sxI7Mz9WDBRuwKsE40544x1AWz4YP-uYv08m8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVjL41dNZLQZHpdQi3GWXmPlDJu5aYI-sH6hAHIEnkfA&oe=6B103FC7"}, {"file_name": "Screenshot_7_Twin_SeaOfClouds_2560x1440.png", "id": "1100038639473057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_1100038642806390_6125154018648210027_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABsIinO7rWkQ7kNvwEkUo9s&_nc_oc=Ado_Fkb7wZ54PUTNQqK51Q-SzB4hIpv4ZYfmR1GoeX_gbB5cYY-tI9LPqqkTSrixEws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1U_nnv1fHl3ktvCgkI_eQSWpN1ZlUbEnc_zSYPuGLig&oe=6B10439D"}, {"file_name": "Screenshot_1_TwoStarsTwoHands_2560x1440.png", "id": "1512119620775348", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1512119624108681_2577172225008292380_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmySdboJAAUQ7kNvwGQ4txv&_nc_oc=AdpbBGXp4vsQXs7tYq-Ybx8UA8Mm2enCbrnOmSo-IIDJajfCRQ-bZ1TEZzU-ns6mT3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVINJMs3pgxOSkyjK4HePvtBfMXjso5GoQRmqLvZv2OVg&oe=6B105DD0"}, {"file_name": "Screenshot_5_CometBelt_2560x1440.png", "id": "1824888038554278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1824888041887611_8708274437510624667_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnpQXaE_s0UQ7kNvwG3QR-V&_nc_oc=Adrb1Qlu8fHtlFlyM9V68rhZYauR970tLfP-91_c6N5vo1Yy7N5QqDtyaJzF3LpHc6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVqbxRSLDdvgFStpYRTBX2BwmxOz-VJ5A2TjCtwGQUWg&oe=6B1047DE"}, {"file_name": "Screenshot_8_Twin_GoldenPath_2560x1440.png", "id": "1180914617602612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1180914620935945_3267845347626553241_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6D9BVSIjVMQ7kNvwF1Eo4K&_nc_oc=Adp3YJMM_8PLjYP35RGJnxNnAl_-atGhrWg64mUEw2FXLKx9jvIs-1PHsnA-j_OdExI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5GZ1ZXUV3FsyoLPq0V4pzdAe-kGK0vtyaQYLuhPFbtQ&oe=6B104833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_8_Twin_GoldenPath_2560x1440.png", "id": "1149031101213281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1149031104546614_8888943747638173281_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFArWJvxzE4Q7kNvwERj1-h&_nc_oc=AdpfzyMNhJGlXYPz1u6TjcDJcvqzV77JCf0hjffB8gKdz_d9LrkHDOue0w87mfMfdnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7uLQhJk9YI7yau7ZRu7TrSwklD8cyxRTjJMnVFdVDXw&oe=6B103F03"}, "display_name": "Lumi & Ember: Starfall Run", "keywords": ["endless", "runner", "adventure", "arcade"], "long_description": "Lumi loved shooting stars a little too much. One night she leaned too far over the edge of home and fell, far from everyone she loved. High above, her mama's flame still burns, calling her home.\nOn the way she meets Ember, a fast, stubborn orange star who says nobody comes for fallen stars. Together they cross the Lantern Isles, a sea of clouds and the Starfall Heights, while the Hush, a huge cold cloud that swallows every light, comes closer.\nHOW YOU PLAY\n\u2022 The star follows your controller or bare hand from lane to lane.\n\u2022 Flick up to jump, flick down to slide. Buttons and thumbstick work too.\n\u2022 Two stars, two hands: in twin levels your left hand guides Ember and your right hand guides Lumi.\n\u2022 16 handcrafted levels, each with its own challenge: a chase, a boss, darkness, a heartbeat rhythm run, crumbling ground and a comet ride at full speed.\nA STORY TOLD AS A COMIC\n22 illustrated storybook scenes with a narrator and subtitles. The whole campaign takes about an hour.\nYOUR ROOM OR THE SKY\nPlay in mixed reality, with the glowing path floating in your room, or in full VR under a twilight sky.\nCOMFORTABLE BY DESIGN\nYou stand still and the camera never moves. Only the little world in front of you does.\nAFTER THE STORY\nEndless Run: Drift (classic endless run), Daily Comet (one new course a day, the same for everyone) and Twin Stars (one star in each hand).", "short_description": "Lumi, a little star, fell from the sky, and you are the one who guides her home. Steer her with your hand, flick up to jump and down to slide, and run 16 handcrafted levels through a glowing sky world with Ember, a stubborn orange star. In twin levels you guide both stars at once, one in each hand. Play in mixed reality, with the path right in your room, or in full VR. A heartfelt adventure about never leaving a friend behind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/lumi-ember-starfall-run", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/lumi-ember-starfall-run", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1604471457474126"}, "review_messages": []}]}, "cover_square_image": {
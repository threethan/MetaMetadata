188544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974602_425902376521877_1276046860197448605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxjFlYRzo1gQ7kNvwHi3CRt&_nc_oc=Adp_UkSB4c8dGy7A0e1shy-1gBf6Q3tcYJz1s8a4Ak509012DkTRHh3yFOT7yd0_5Q0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9RtWzoq7xpInnI8Sa_-z6UMkTrvcDqIWhy-yDVgI3mg&oe=6ABBDA8A"}, {"file_name": "39035399_943750293322215_2969383470575590028_n.png", "id": "952660983097575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_952660986430908_4472121887103017963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIQNhG134QwQ7kNvwHxO-aN&_nc_oc=AdoGQlFmWlAK_1xs3Devc_sWMIUyh_XCd_Oux26EVqT9x0zqbxhE9YaAmPWsC7-h1QA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzpWeTdG8wWD06dM99nuHLkGqIQBhT6i6HfgVe-LvSYQ&oe=6ABBBD3F"}, {"file_name": "57569480_211166701523169_1764545257225251922_n.png", "id": "723459309987558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282160_723459313320891_237246860822686976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtG89Sl-mR0Q7kNvwF_vn0q&_nc_oc=AdovPPJxL5wb47im3EzDEkiy6UzxFlJTml5Hlj4RHoIq7frtSkSoH8I8MyJkwJ2_KEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzwMiJGGLuBYoNNS3tshyt6JLBQUbJY98U0XDAC4Ih1Q&oe=6ABBDCE0"}, {"file_name": "57570299_573714911401981_8198381933514924199_n.png", "id": "1125061345407238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_1125061348740571_251009917282661543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BncK8OiXZagQ7kNvwG8h4O0&_nc_oc=AdqNiixebMLMeyl_DN9G-DQnsK06VOxh8ENN_zNxB-8i3LJeG9Rv-S4FpM9ulG_VLH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPruZemETUu4Qx-QN_3G9s41tU1ffm2QwglhqaxbNKoA&oe=6ABBB736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TakeAWalk Medic", "keywords": [], "long_description": "The TakeawalkVR application is the all new application from Tak
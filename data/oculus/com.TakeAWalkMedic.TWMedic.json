188544", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974602_425902376521877_1276046860197448605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJIHSeQg4aQQ7kNvwHwwvLm&_nc_oc=AdqSM5P7W6tWkbbMarZOziPiz3PBKGhsxPebJY1XsOse8RZyyn9sCqptLLfBvd3M92g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMkF-pZH0hDUtdp0MCHaZalZPiS8q1Vzf80Qrc2Ld8nQ&oe=6A8ADACA"}, {"file_name": "39035399_943750293322215_2969383470575590028_n.png", "id": "952660983097575", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974852_952660986430908_4472121887103017963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWk6nRcXDrMQ7kNvwFLgQsO&_nc_oc=AdpxMFrZ_gPRY0FV9YZZ7HHnB9k6LMB4V0WsSqBfFciELDmcdyY7dBz9FjeY4_NTUaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF02QSZZIbYatl1S2d-UkfE98TLKZHrAzTvw45GMExNQg&oe=6A8AF5BF"}, {"file_name": "57569480_211166701523169_1764545257225251922_n.png", "id": "723459309987558", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282160_723459313320891_237246860822686976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjooaCQ6SnsQ7kNvwFcM2wG&_nc_oc=AdqmnICC81VZk6XfOMTbbALXiXieCm7-iZ19sbpqRb8cB_7qtbl9GtBUxXMM1-oHznI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjQfWZJXKReCGBNl3BXWA9imV35TJ8VnoK5VUg1OoLoQ&oe=6A8ADD20"}, {"file_name": "57570299_573714911401981_8198381933514924199_n.png", "id": "1125061345407238", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984464_1125061348740571_251009917282661543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB_DxMYD7RsQ7kNvwGyDems&_nc_oc=Adqcm0IbHnY5RWRc3PKECoLP6juSPAkJOE3KjUlIFq-1Nyku_XdNKiQAqZuJeVHfEcE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExrebHCNHQ8Mq-MGh3ucI52yFKGWKqVV-hEcjLbFUHSg&oe=6A8AEFB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TakeAWalk Medic", "keywords": [], "long_description": "The TakeawalkVR application is the all new application from Tak
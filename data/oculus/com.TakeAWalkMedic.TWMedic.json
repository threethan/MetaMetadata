188544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_425902376521877_1276046860197448605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-e4gF5wNrwQ7kNvwHIU_0R&_nc_oc=AdpdxeOJut31NmfJnbuRfXk7dmvDB0jIJTJyQtnls93H6GNO_37YBsFJfzzO61ta-1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0deOpRDwQ0_WQgSmg3MIqV91PwGl7c3jw9Rb7HDd44vg&oe=69E36C4A"}, {"file_name": "39035399_943750293322215_2969383470575590028_n.png", "id": "952660983097575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_952660986430908_4472121887103017963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSQ10Wkjj0IQ7kNvwEcnk8a&_nc_oc=AdqXY7Vozo-EKIcAE9D_HUVcR1c0sN7p9xDpIQXY3te1gDYIC1fU7lv7_nvGlRwTMJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05-jdo0zfcCOWBgFCSdfhCSvHxTa7UzNXw1zSgEDucgw&oe=69E3873F"}, {"file_name": "57569480_211166701523169_1764545257225251922_n.png", "id": "723459309987558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75282160_723459313320891_237246860822686976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4yWKgR31MIQ7kNvwGtmzr9&_nc_oc=AdqyYowz-FVQmhnzg6QzEndnt9L415ltNEeZ_EMxk1Yq8H7SV5fknL_Rk5j-xO5vS5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X7WfSXgDNWdLxnV5Pkn_2Vog9CftoUNQcUoM1yiMnSg&oe=69E36EA0"}, {"file_name": "57570299_573714911401981_8198381933514924199_n.png", "id": "1125061345407238", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1125061348740571_251009917282661543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x4_IpHhMeoQ7kNvwGh4ikd&_nc_oc=AdqSOu_P1AjesniBjFO49oIO_chdVqfD77C0pfW1DejXWC-iQczUcsMuFo5j-RSoqFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wd8FX973WPaC8v6S0ID2Ir7AyVJHMdQ16Z8_zA5SSBQ&oe=69E38136"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TakeAWalk Medic", "keywords": [], "long_description": "The TakeawalkVR application is the all new application from Tak
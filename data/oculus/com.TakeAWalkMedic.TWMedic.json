r before.\n\nGoing to the environments tab and choosing the medical simulator will lower the costs and hassle of using real tools and convert it into an easy medical VR experience.", "short_description": "This is the Meta Quest version of the TakeawalkVR application, that allows you to see and share your VR experiences with other users.\nThis build aims to provide medical simulation of an ICU with monthly updates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8fd94e92-b988-428a-958e-02795d367f1f", "developer_terms_of_service_url": null, "publisher_name": "https://www.facebook.com/takeawalkvr", "support_website_url": null, "website_url": "http://www.vrplatformen.dk/dn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "sv", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9552575174851154"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298208_1682660515952386_5349333905108630693_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkTsQ8O26dEQ7kNvwHDQmua&_nc_oc=AdlsiI-Yg55mUuxuxVkFQHBhniCeYpMl8R9Dvd4JS9bVkMrrW55CoMfqeHpds7r1sas&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsG4HiYOd-HaHfVk7sQd5Qvey2GEnr8nIkC52wZd-Yqyg&oe=699C41DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TakeAWalk Medic", "platfor
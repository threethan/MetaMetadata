188544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974602_425902376521877_1276046860197448605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUSHD1qEAAQQ7kNvwHgTGjK&_nc_oc=Adr6bhm9wDcX1KdbW2WJDiaK1MY104pW5avAEMV7GSKQyNAh4PXHldiICCBhVUQDzsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5-sI-3s8EnUvW7KHuf96vAy_Ob2t3n5q73rrv--QAHw&oe=69C90E4A"}, {"file_name": "39035399_943750293322215_2969383470575590028_n.png", "id": "952660983097575", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_952660986430908_4472121887103017963_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DljM8oGP9DIQ7kNvwF5vJ7-&_nc_oc=AdoJbZKL7EWI_Kzfrf-v6VySQR2yPYezdzMXW45zAMaCw9AerDZrR9ckqkFU23KvW1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlzMQ8-l4OWmzgxb-3O_PRI6zsM0jiEOVRipU4rjNMOQ&oe=69C9293F"}, {"file_name": "57569480_211166701523169_1764545257225251922_n.png", "id": "723459309987558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75282160_723459313320891_237246860822686976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT6GdOmTDPAQ7kNvwEKGQfe&_nc_oc=Adq25M9dJlOGXGeXFfbxL1fmgdfIqk9CEvRMDa-0AFZudzRo6cLMZhCJEtRy0Yha7sY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCVW525GwouI5jffW0F-P8WQN2ElVsE0bfpyAuv9bAzg&oe=69C910A0"}, {"file_name": "57570299_573714911401981_8198381933514924199_n.png", "id": "1125061345407238", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_1125061348740571_251009917282661543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1aog7i0SmQQ7kNvwHGHq7p&_nc_oc=AdqloLlcM0NBr-0IAKzNl-G2offoEUk6SJnh55dYuyTo3rMj-tUeH_3GNQBA7zL3o5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2VrauyOf5qbhj6FiUQ0irjRI_EDOyxtqjbSA0KmmDHA&oe=69C92336"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TakeAWalk Medic", "keywords": [], "long_description": "The TakeawalkVR application is the all new application from TakeawalkVR ApS. In this app, you can now use the headset as a standalone unit, or you can connect to another users session, and experience social VR like never before.\n\nGoing to the environments tab and choosing the medical simulator will lower the costs and hassle of using real tools and convert it into an easy medical VR experience.", "short_description": "This is the Meta Quest version of the TakeawalkVR application, that allows you to see and share your VR experiences with other users.\nThis build aims to provide medical simulation of an ICU with monthly updates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8fd94e92-b988-428a-958e-02795d367f1f", "developer_terms_of_service_url": null, "publisher_name": "https://www.facebook.com/takeawalkvr", "support_website_url": null, "website_url": "http://www.vrplatformen.dk/dn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da", "sv", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9552575174851154"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298208_1682660515952386_5349333905108630693_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL0pROofUCQQ7kNvwEXvKqK&_nc_oc=AdrC-bX2P6TYaIDFtt0MiYiPpsChNiEoPSV283L4wppV74I3LgJxtFIYOpjb6XqX3VY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySH7
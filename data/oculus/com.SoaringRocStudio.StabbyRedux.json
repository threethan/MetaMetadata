kNvwGKcWC-&_nc_oc=AdpWDqA6q1NN9AO6VhK78UJl0ViE4jOqCWUhdr-wf2c6DARdT78Iw5EayI7jl58Rrys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxLF0GXI6F4Kz-7O2e2NtV8J0SMW7aiCGbiMBeWvFBEA&oe=6AFB3969"}, {"file_name": "ss5.png", "id": "1272054904542202", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619113_1272054907875535_6261028720595543911_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imFbJhGVoaUQ7kNvwEyr4mj&_nc_oc=Adry7ON9oC6p7qgX92OU6WscPDCsMMiz_aC0vHxqzuJYThHgUFcUvHGkC7WNIsaa4pQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQysCuXtvbbZHKohzluDBuB_9VUkRvuKhZJbhX_78wVFA&oe=6AFB2C72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1285483719576385", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620860_1285483722909718_8684254705618786479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPKtJhgZ1n8Q7kNvwG4ogu3&_nc_oc=AdqQHiUemZgbVZ8rW6chAlxeB3nEfBDX5gRHZz6f_ua7Un4F2T1VZCcpfBjfytIlBAw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1peM03Fwwy7Mtn-u7MzZTf2mEvWTA3VUJcTY4UJUKPw&oe=6AFB39AD"}, "display_name": "Stabby Redux", "keywords": ["assassin", "ninja", "noir", "stab", "parkour"], "long_description": "REDUX : Adjective. Brought back, revived.\n\nWelcome to the City of Madness, where you STAB. EVERYTHING. Scale walls, hack terminals, hunt down targets and take deadly drones for a joyride. With just a pair of hardlight daggers. \n\nStabby Redux is an intense mix of parkour action and stealth gameplay, putting you in control of a digital ninja tasked with dominating this black and white city and giving it some color. Throw your daggers and pull yourself to them to grapple around and avoid spotlights, drones, and even other players as you carefully pinpoint the weak spots of every target and take them down quickly. \n\nThe City is alive though. Your actions build Pressure, and the more time you spend exposed the quicker the City will react. Drones will hunt you down, your face may even be plastered on Wanted posters all over for your targets to see, and other players to claim your bounty.\n\nBut you're upgraded too. Use your hard earned resources to upgrade your assassin, giving you abilities that can disguise yourself in plain sight, hack drones to use as your own weapons, and track your targets across the city. \n\nYou can join online lobbies of players, teaming up or facing off to take control of the City with intense PvP action. Bend the City to your will, discover its secrets and hack the world as you see fit. As always, happy hunting.", "short_description": "Bigger City. Smarter Enemies. More to Stab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "33517316311192742"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3863366557132815"}, {"status": "PUBLISHED", "id": "944419824990416"}]}, "baseline_offer": {"id": "944419824990416"}, "i
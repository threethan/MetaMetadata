tent-ord5-1.oculuscdn.com/v/t64.5771-25/499622325_1265333128565698_1491573642856464554_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJZ53TCD8dwQ7kNvwEl_jmW&_nc_oc=AdpDq6opP62yBgb4p2XIWPSqhDuLSEnLaFidrWd57U2jFbeZF1qf8oSTf-fpTLTtPvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBt16MsmILjVi-KBqde73Q7rJGmrGVemb-lqcTM-wfrA&oe=6AFDDEBA"}, {"file_name": "ss5.png", "id": "1272054904542202", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619113_1272054907875535_6261028720595543911_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2OmRVVKaFMQ7kNvwErVtDU&_nc_oc=AdpbFf5TjBIJObZZzk8qN8R2wROLGbwO-h9VYYfXSz3qeGBICabJgN4dIP58nfxtXZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBhcWj1AemYx8MWkqO_e3GZNwxG65qkocFwDx9N94UQw&oe=6AFDCF72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "stab2560.png", "id": "1630775472182250", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593716858_1630775475515583_2495321455412587376_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYJAVuZD0qMQ7kNvwE50k0I&_nc_oc=Adqwfiti0O6Ks3iHTbQyg5W6lzgBZp8lt3I7kDyScfFk6unRj4UnEIpyGFt9J-_uRIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRglF81OPdiWaONC0u9yIhFi-GDlMSno1HdrGaByW2Ytw&oe=6AFDBF6E"}, "display_name": "Stabby 2", "keywords": ["assassin", "ninja", "noir", "stab", "parkour"], "long_description": "Welcome to the City of Madness, where you STAB. EVERYTHING. Scale walls, hack terminals, hunt down targets and take deadly drones for a joyride. With just a pair of hardlight daggers. \n\nStabby 2 is an intense mix of parkour action and stealth gameplay, putting you in control of a digital ninja tasked with dominating this black and white city and giving it some color. Throw your daggers and pull yourself to them to grapple around and avoid spotlights, drones, and even other players as you carefully pinpoint the weak spots of every target and take them down quickly. \n\nThe City is alive though. Your actions build Pressure, and the more time you spend exposed the quicker the City will react. Drones will hunt you down, your face may even be plastered on Wanted posters all over for your targets to see, and other players to claim your bounty.\n\nBut you're upgraded too. Use your hard earned resources to upgrade your assassin, giving you abilities that can disguise yourself in plain sight, hack drones to use as your own weapons, and track your targets across the city. \n\nYou can join online lobbies of players, teaming up or facing off to take control of the City with intense PvP action. Bend the City to your will, discover its secrets and hack the world as you see fit. As always, happy hunting.", "short_description": "Bigger City. Smarter Enemies. More to Stab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "40175503628707277"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-o
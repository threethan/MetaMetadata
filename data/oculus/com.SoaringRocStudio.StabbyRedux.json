7f20f&oh=00_AQIwm8kzufVMKpIZhDZsGX6RqxvmCqeR8W4SAHKf2C78Ww&oe=6ABA69FA"}, {"file_name": "ss5.png", "id": "1272054904542202", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_1272054907875535_6261028720595543911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzHo7PyktAYQ7kNvwGvdKjN&_nc_oc=AdoZGaGIm0n30TuP6tKYXxE5NwG8uOtNP0bp2Bdov3LUSxUSw4HO1BFmgOYhZiwcG8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtzemW4lTFrBAefff2fxkPOh7gxlKPFBGqcsMgwncY1A&oe=6ABA5AB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1712917626536089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618064_1712917629869422_1511901659124960286_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxfIhtjYO0UQ7kNvwHZr2wA&_nc_oc=AdqTl3tfxAXUVjP0aCS-Toz6OKIWzaJOFHcDxhPeVW5wtTU-oClqkeKJ3qE-ouqA91s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMjVOAinEEo2sCEJ7ESshmAkZbOjH7kyzDhMad-5XGFw&oe=6ABA7370"}, "display_name": "Stabby Redux", "keywords": ["assassin", "ninja", "noir", "stab", "parkour"], "long_description": "REDUX : Adjective. Brought back, revived.\n\nWelcome to the City of Madness, where you STAB. EVERYTHING. Scale walls, hack terminals, hunt down targets and take deadly drones for a joyride. With just a pair of hardlight daggers. \n\nStabby Redux is an intense mix of parkour action and stealth gameplay, putting you in control of a digital ninja tasked with dominating this black and white city and giving it some color. Throw your daggers and pull yourself to them to grapple around and avoid spotlights, drones, and even other players as you carefully pinpoint the weak spots of every target and take them down quickly. \n\nThe City is alive though. Your actions build Pressure, and the more time you spend exposed the quicker the City will react. Drones will hunt you down, your face may even be plastered on Wanted posters all over for your targets to see, and other players to claim your bounty.\n\nBut you're upgraded too. Use your hard earned resources to upgrade your assassin, giving you abilities that can disguise yourself in plain sight, hack drones to use as your own weapons, and track your targets across the city. \n\nYou can join online lobbies of players, teaming up or facing off to take control of the City with intense PvP action. Bend the City to your will, discover its secrets and hack the world as you see fit. As always, happy hunting.", "short_description": "Bigger City. Smarter Enemies. More to Stab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "35648089248115427"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829980_2495354820893406_4916679727756940764_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9W7Sy8ohPtMQ7kNvwGT0Lvs&_nc_oc=AdrixdetnUtXeYy0tPM88Gg-ibnPoZT7bczdmGWIzHkYlqDOhLKhTl9OizhOaWB_ZM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo8Nzu-W4EIQ7kNvwFEN8rF&_nc_oc=AdqlKcAaGMq8nSOynhegRgCN5wu9vflZq-20cc5ERijzTgiRLp-v7ce04JeVrWECOCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AfTnELZlD8eOWkelpKSuAlhu_2xOT9oPWGNwfAeLjPg&oe=69D50C87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9ysL4_DZH4Q7kNvwG_ngAQ&_nc_oc=Ado0SjdjmHjv6s6lvllO9cIwjjT9GiynnGwjEtrZlzx8liGkEGjTDKPJrSmE6lFRP1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07il77bWCuioiOOQXJRly8ItQqdZm_fLr025U9w9sAjA&oe=69D5051E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F7HWyd0yV8Q7kNvwFSOxvA&_nc_oc=AdoFgOwfbfUNPWrjPImEQZMsMQ32Mj4dmWZV1VQbUjE0W-GcUY-A4-rLqN1p99z8dSY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h79rdsW1_1VHTNwslrSc77wO4IRdVvtm_ozDWMj4-Ag&oe=69D51651"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT0phyK7YocQ7kNvwHtE0E_&_nc_oc=AdpZsW-qeuQXfid-gNaMitXX2TBIXMvDFtdFQPmNi48FAIC3dR2nZv85obwkDIaSC-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Yehsc3PWfD-6J1lN79qqR7DHvc3goVAMY2SZdNBFEZw&oe=69D4EE1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggXfnZ5N8iEQ7kNvwFIOmcO&_nc_oc=AdqBnkjLcFrNpzwMSLxwS3x8JD6xynCvc0rhDns8P8ws-RqcP7v4bMqRtPbecYXvAgE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iEuua1WRLzS9mLHaQ6a9kYHxT_TB6K6N6sodqKnAAUw&oe=69D4E41D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
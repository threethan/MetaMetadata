94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Zg_olDLqn0Q7kNvwGuAYoP&_nc_oc=AdpbsgYDV8kJ2WlTK3yoJizDdTKV32AA-Q99ozaWU_bLGZDZqe6ZNaoy5_gPDcaA3iQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdhQHb6jdF_D0cadTwrhi4yOMCKuuhnLRNARAZao6IUQ&oe=6A539C87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVb5s4aIKhQQ7kNvwGnrQhi&_nc_oc=AdoY_J7eRs78MuR9IeWRh-LKlO4sRywTtL1Sw5xnMTVPCWwbOZhb-7xagNIywtF3NdI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsy0_Z196rYOEWhfAEM6DpK-XbxwHH9c7ozTVgS4P_lQ&oe=6A53951E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lieNLl6qTcQ7kNvwE4iswc&_nc_oc=Adq_7hBZJ6sqVQ8d-5rsw6OvXz5-gY5VKKP8gMzwMshAIC3qmYZfc_Uxj0a7u4o9sEg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUfH0iJZ-TL3i2T3T2YyjJ0-RG7wbpGC3magQB3AT-7A&oe=6A53A651"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G2-kiThWooQ7kNvwHaRMMc&_nc_oc=AdowlUaMRUHLLeGsHZ0dxLlhPmP2Eua7RKiYsawS1cum2RnsdOj-OiNt1sz4el6pLog&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2qlM15sklOaSPr36UzZx5OvktIwx-zLXpdcRV1LS_aQ&oe=6A537E1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWnCWXCHbbgQ7kNvwGb8zpi&_nc_oc=Adr6G74u0yw_ewauXi1A8BSyzYptZYxtSj1SKrxmZtcWrQEdXk3WmQKXciEPxWkwTW0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmiitnVtPbsuh_9CvGhvvdNDe6bMq8A5G7BimN924S8g&oe=6A53AC5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
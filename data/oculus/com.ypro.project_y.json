AUUQ7kNvwEHwhco&_nc_oc=Adn8hQ0Hyk9cgW7fCMOpNDeGHpApUA0-wMyew0-A1Q-L2Owzp8Ejj1fwDGW-23YrEqo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPS0BnNpbGpc9DoWJ-IhhWxr0e656sjqmWsd8xSGLszg&oe=69AADC87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG0YHpKrYMIQ7kNvwHq1HyN&_nc_oc=Adl9ZtsRFGHg1F6TYhLLrz5Ym_D-CwxM6r2wc1gChcYdwHGNMBrjJUBAbjuBqE8sh2Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwddtaxNw28B1Fs6RE18egZ0p5SmPyXLPLJl4kIQRTqbw&oe=69AAD51E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR2Oxdax0YYQ7kNvwFcMP66&_nc_oc=Adl11i_94gjEPS_WsVYOZ5Zcbl_VytlZvxOJzYYDcHvBLmXjl_jEbB3OIHAvEVKn2X8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwaEciT4zDH5JvI7IulUuy1oVZaslNeqSRbpWRLq2OKQg&oe=69AAAE11"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydZCECrV-XMQ7kNvwHUgEDT&_nc_oc=Adm1oxx1l1JaiofYl7gOLEdcCRAUEZdd_OcevvpwkJqNx6IbOgQFQiZjQzt5gq81aS4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkF2dUFFNEYAVDU-y-Lv5XRJP2zu8vpZt49oneAZYHvA&oe=69AABE1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AEHIYYoJFQQ7kNvwEr1AlK&_nc_oc=AdkEIBN2zmS6UtMdGcu9KZKFVucmmzomav8p4tTORHPlg0SDtQAXTwl6Fd7UpuGRqcY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfysksEORanjLZ77SI14KIxF0krwxiLLWK0pOqpCDKj4qQ&oe=69AAB41D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url":
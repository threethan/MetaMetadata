94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5mUrQZcf1gQ7kNvwH5X26T&_nc_oc=Adq9m5n55EH4Iuelby6Ptu7JMP8klOTrNQUdLtqHj0h4d39y2XlD_Q5R3j4vPHZA4e4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfjmmnRJ-RDQXK7X1Cnc55GtZrW6bWnVxisZU9X2lE0g&oe=6ADF5B87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzq3glPavrcQ7kNvwEQ762i&_nc_oc=Adp6kopskTxdvWMJWxLlR1VFWOo6rX5nCPtfy-UspC1aNN5uKrRK4tZSCbLoNSmNDmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxKVpm6Q2cJQZNKw_0YDc9OvrFpdejQg5giDV8DW_sWw&oe=6ADF541E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtIdMXJKr5QQ7kNvwEl1mIF&_nc_oc=AdrIamlsEColSN7gLL_G2UoDN5LjXQA4wUrU_L891Wz53EwhAXD-QwPc2JzNHn9L5x0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1iyqIiROYzRQRyxLtlugFqZtppwMCKGINGJe_sA-kEg&oe=6ADF6551"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzGASzlnmAkQ7kNvwFE-1mT&_nc_oc=AdqsFz01u3uTKlIpOepquzxoahJgMXUASVpgUi8uYTCaFrbbS66kyr7OzUPPVLm6h1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhveCb1XSnsUQ1N8JkNkPL5cyGZUNd7RTeL0XCqi4oPw&oe=6ADF755B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3pjSziWsXUQ7kNvwEun2uf&_nc_oc=AdrNgqbPy_yecvwdCtyfzJ9e6lfwotHun0zm1XRSl0HoSEnjrlxJ6NMZNjKg0AvUnX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu60CJdDtG-mBos0O62zfTPKBH43iv4EauZJyJ9tvmvw&oe=6ADF6B5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
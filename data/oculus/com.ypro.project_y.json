94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WlegjrgL-wQ7kNvwFNZIkQ&_nc_oc=Adq00Pij55jyr3865HusbXvFvkVBMX0WWaAMDnDlEyxQ7OPUnGm_Ke9FvnbdP2bwZ0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe2VwbDSXB7EE92UeBmC2_i4Id5l1N3W_kSMzilzJAFw&oe=6AB3DA07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jpTfAg1ehQQ7kNvwFSiPqJ&_nc_oc=Adr7xhs5K2sV4Ir7nnM2rikIqpVbneMnDOlsaf3FzL8_tC9UqT2TTTRPTeTni_MaBDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9w47v6RIhgMOUoLq7de22hjgRIL__SiNgcSGhpfsdGA&oe=6AB3D29E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFawMlQXEXgQ7kNvwEU8I4b&_nc_oc=Adq3K5CUzb7DlZDIH5OaZwic0rLOJ-pFF7QjyrU4eOIU9Y_Cey8CsrqmDuQMHouNsuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5ywZll8cGWGybCOe5LTdQC-mKnQ0V89EqzNaqx42QfA&oe=6AB3E3D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zqDCr2WQmAQ7kNvwFER5VF&_nc_oc=AdoSdHkQBGSrLFhuO40lxn2rfVC1WpsFhvoocGmC7vC5OH1naTdG_Gd1TE3qjOzYCf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0CrJ93n2mnCDmkhy7DLxQ3gTx3KlKOWGaT1YZATlw0g&oe=6AB3F3DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvMfs0dVrkEQ7kNvwGeA9wr&_nc_oc=Ado5KCUYRg5ET15gJnBqbafJIqXp8yJFNW1pD83DYeMhfM-_nUD8OljKwHZEz6BKRwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI1pToWtf32t7A2fUjRi4rLuyD985WoeRAR6TLl_DLfw&oe=6AB3E9DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
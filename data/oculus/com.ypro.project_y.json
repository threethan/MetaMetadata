94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Haos4IQTAgQ7kNvwHWSNaa&_nc_oc=AdqDXeXyBrqKExkRqPgoF2Hx6eqnQhk1ONZ4OqCC34Uxa0BHahqUNmnbcwIxoJBOOJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGSHnyhBTfBP3rNduT2U0tWyOvloOciQmXQDM0xNFmXw&oe=6A6B5787"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkmFWR0uLUIQ7kNvwHkXWvg&_nc_oc=AdrIx8u9Mr_pPbarmzUEFgBwqDjds27Y5Y_9sRuOTaYwvQzNPVstYZizZyDmcaQApbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS7K0G5KTUDvytDXNWBjX96IY-Qy3dT0Vp5_bKYU-t-Q&oe=6A6B501E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L2AOKfalt0Q7kNvwEi3mzt&_nc_oc=Adpv4k3iZmW-9F74nlfxNTJy72jGmy4AUE_8O8G60YzG64A0XvGyKZGfP7nKWWO2G3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA22ZtQ17MbQYZIjzVBxF57-28GyK0SlXAFQiq102dmfw&oe=6A6B6151"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxWCFYx85lMQ7kNvwEJgQlh&_nc_oc=AdpngHmgPON_D1NZHn8SbXFEwrlvanSlbpcwK44Tp3mUjIS9gMFnFxpCxL-t0HcbSDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-I2kpUP-gvXL_MUoCVBaa6ZSwoKCyV6TYetD0dmwyog&oe=6A6B391B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g30lYGWo3CkQ7kNvwEHhNoe&_nc_oc=Adotgm37hVJgrwylD3DtIiUkFVLYy8SYqd03PXE_I5P3nKYWcoBUTryU0-BJy_la1fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD68FCJADYohb6g42Qptbcp8-Ych85YacRKi-VKjdmoPg&oe=6A6B675D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
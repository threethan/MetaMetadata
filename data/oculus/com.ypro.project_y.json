94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A79ZeB3cDjsQ7kNvwFFXoTV&_nc_oc=AdoIKaO07QNQH7ORI4sR-anDGUvGhFfSqHFYuY_s-lUdsWn07TVxmmDwkCO2BWZaKIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y8DnuSCZDUuh8e7Crb_4yCkRzW9WmX6lVkiAVZ-V7ng&oe=6A199A87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFnNPJEpwewQ7kNvwFudWq4&_nc_oc=Adq9Fttojl8d7l6jiTZYasrbNmO_21m85uylHDITI_j4cGzM8NYPyMBtqqZyRCcds0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E5J8-uiD8KSwNQD9pN3ZOtPLAZ2cTA87Et-FtMz2otA&oe=6A19931E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13ShVknRb5kQ7kNvwEjAe9H&_nc_oc=AdqYJ50q9Onb0dTQfjz9yX9iyDUFs_Jr5opa9ZLQmDXv2fqcNGiBUg-5ju03gC_mQ84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aHkDfMbLrCKOErzcHTDuHA3l30gaHVURiPvL1g9T0PA&oe=6A19A451"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H88xfKCR0wAQ7kNvwEX_2cF&_nc_oc=AdpVFb8has5raDuFe4nSOG6XOO08QnhRx2pDw2hMEPYd9CkG77aizZcYK86AzILMcEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mCKfWg5ZKyVo9u8YPXf-aor8KG0ATbHsID_tHNC0XJQ&oe=6A19B45B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKSH1Li15vkQ7kNvwEJXueV&_nc_oc=AdrCK-5OuGpSxN1zBmVis8EJB00QIN-W1R5_4RpDklHnFhGjZrVC2lX-T8gSEP6AG9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LnjWYFguYrtfoqzu8mszp6ZoFllBjiUmY4ZELa-Q7Sg&oe=6A19AA5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYhyYlKVl-gQ7kNvwGGyqIY&_nc_oc=AdrTsJ5hL0tkzh33kJht9QOxgayrgR6ydkwED6AbMZa4_Srpqu-anPHfZMmm8x7qBWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IyITWosAmEmmnwQ8_ZSzvYahWEXS78dKeJqXPj0WyxQ&oe=69DA5287"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUBCe88yxBMQ7kNvwG3SYdZ&_nc_oc=AdpquA8HjogyXQAjx2fGvpwc379H2cqSyANfJqYPsf5V0LWXnj4y5KkhEsi12JbFW0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16CyIdfKaJvF4Am97pRRgfxMQvGw4ms0GldShdmlt1CA&oe=69DA4B1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGwgR_weq_4Q7kNvwGb60Xn&_nc_oc=Adotekhfr3hMvfipw5ERghtKHUl6SeFj6lbfYyeko0gpy-Oh_Em0nO0i81Wjpe1EOqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-PKNdYx4E9BAS708PsBPqAVPj90KTJ8O00XMB3-M5dg&oe=69DA5C51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9F7v3tRe7oQ7kNvwHuV7ls&_nc_oc=Ado__0VZ21DJ1wYgap52Euh9fksrAuigtcyMNmtxtOLvlIV3Dl8XcsxbDchbO9JFpbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ldYJHV1eAiWfQqzIqWzkNXuhROy4CWyHQAHADATAIbA&oe=69DA341B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8xzmXOJhgkQ7kNvwEuCRfJ&_nc_oc=Adp24ljdOKmxVpSr4KXsDFak2Mmpk5mxTVLOumsxWhyz86ItD0L6iEDpzCCmIrz7UOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Qo2zM6Ze0FTipnyhhxJvYINVBwb-sjzD3AbrBK_0iLw&oe=69DA2A1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovpeInh44M0Q7kNvwFmJbgf&_nc_oc=AdoaiBAhhjgUX8HAf_5rqV4wSjfEIxnd60b30kv5R76DIBMeghIVa0vTtXtE6sL1nJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zeNWc-fEWkAqDyNAMd3tkxtKn33ww_bte2fwOyPuuPg&oe=6A033107"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Too8C0jIVqUQ7kNvwGFbLT2&_nc_oc=AdpwuGukA2RPVq0JN7J1t4vjS5G-zjlq7dXbI4XPhdpIHElOEtaPXOIEvNrfKX5BdYI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54cY0m_spjzwUnUc-sYr_5A7mhnKhXqILSJsVajnLYXg&oe=6A03299E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIin-ZdV9WcQ7kNvwFrrd1N&_nc_oc=Adp3Ccf9idybrNChv9zIhVhRrfXrwjBr4XvsxTujZvvMp-0q4oQ8OfgcNY8gc3N8f5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IhXiYj0P-jm7FnrQYoV7TErupSAm0numxDhv7gkooWQ&oe=6A033AD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsqoGBfrokEQ7kNvwE9m0Uy&_nc_oc=AdpD9C7Zb2ICjFIlsmgqHAR6xwDkkID2oZFa8QoWXs4-KLa8T-vfSK21n-p-1HCqAwA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IE8DcYzAZcXINGLw_nfsWvUchsM8JCFCOQWy4hdSL-A&oe=6A03129B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvWVWm2qII4Q7kNvwHQzens&_nc_oc=Adr7nneN67AvJ0niC5791o8RE1uSQ1Oq_nbImioARb9O6BXTDiBSOl7-CR-kNmXE2_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x5TfHYbpkyXGGG9eRzwe-icoB4K7DrEz_3yZNBX5ucg&oe=6A0340DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
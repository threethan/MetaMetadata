94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=copwlYx4pfIQ7kNvwFQcWzN&_nc_oc=AdpxBgJntsAvTEng8nmJl5Z6Lj0TnUeiIBR9pi8iMKJf_6-xaVHLQhPj_NeAhG1BPmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf0AGO63e5Ur3l0FNXyRp2dDBwdyP47vChsdpULHpUyg&oe=6A676307"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmq-qx-AxyoQ7kNvwFIbn4J&_nc_oc=Adobj4lhksPMFVvHQtkc7qcBd1YPBD0Ii79PbcsArcYqI7paJvtnRn-1IAwaPpU7_iI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBFhWo853g3V-rm7ON87ORjqczcp4BFtSG_UKexyVpVQ&oe=6A675B9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4xQCTt-KnMQ7kNvwFC_pBy&_nc_oc=Adpf1CYAyiwb-zGtBCbREw0V4SuBuCTxUoxQ4jSZLz7aR8-qogo0UY6R2xy5Ccpez7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC79_wPla5V8I8GsNpmPL6bpTstT-TRwSfmxJybDWWpKA&oe=6A676CD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qhfu0wKwSnUQ7kNvwGOf-pU&_nc_oc=AdqqUz5UMlDYZBJCBtXkXYGwM4R8lJy_gHFc79t3qdmc2GqIP5FAxeEMdHVMIZAK-0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMM0hWIjH6-jvmtDuj2Y8fhTXGuQqino_6bKqYYUfpqA&oe=6A67449B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K96ukm0NIgUQ7kNvwFFCykQ&_nc_oc=Ado0JZVTE67_wn2dyfTljxxW9HGdlt-12vtffLboyb9_SzJE166_QKxtmWLaWgy5nkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBItdhrmTvCDjusyspt-T7dL0Ytv7sIfmEMwpWwZ5cT-w&oe=6A6772DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
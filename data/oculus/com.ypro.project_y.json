94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrZ0HPAR6SQQ7kNvwFnvDEK&_nc_oc=Adqy5eOBJxFFFdoRGvH1awFj8Wedwzbol_WeHsN1yT9fQlFPrDQWb-7_kRnAjsoZT5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7jtI2ieFmna8noqlZ3N4Rmcuk4L0lWXystex1Q7mLzw&oe=6AA55987"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_-CMxz3YCYQ7kNvwFkDVo_&_nc_oc=AdrAcNsyztAp-0A9DJIleki_gmSVURaGYAY4PvNLQLUdoQG9nQO_M-r8_kdF81EwREc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx-sqZDnZl5knXy0GzcQiB5KWKHmr1mK7x5RjVTYKlWg&oe=6AA5521E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL8E9tgT1S0Q7kNvwFxBjrK&_nc_oc=AdqpIek8LVCvOfOYyhi7yy01x9sCg916AntPfZ1IWqjDEnZMXYe-BrmsVLwB0twkx3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU7O6DAZbWtVMh7e09nt66olq7gFjs7N8pcija7i4lqQ&oe=6AA56351"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc4gg6j82mkQ7kNvwHxSBMu&_nc_oc=AdqoqrPdRx5yoa-xYkg3m5B4l7vigapZ7kELBlPOJGchl5VVJKvBQfIzwOAYI8s_y1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYJsm7TL7AyC80K3lcj8QGxcAIDaRh5HWZumyvuvPmCw&oe=6AA5735B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDHxbmERRQcQ7kNvwGMHM4x&_nc_oc=AdpGtaKDwOsq4JbfNCu0a1nKat9exD92-5P4CJ-yQp_EQBDybSnXnIRGNd4BmP2v9WU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVWE1Smtrtan12zClq1rT3sTEMWfP0PCKCgMiMRryH0A&oe=6AA5695D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
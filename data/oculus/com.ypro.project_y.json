94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDn2kNLZDxcQ7kNvwHHrWS6&_nc_oc=AdqErTZkfdiN1VCtPX-VCe72wJKgZCcxtwCkrPwPTZaNCmxVN_vj_XH725xxgbDDeHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTQChe6lmwanrcCytmkjvGt5sz3P_1DQ4NYyUpD-usoA&oe=6AC25A87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0YYx-idZS0Q7kNvwGcWeEm&_nc_oc=AdppkAjGmrEXAKV3KV0MC_ix1BPzskc7BrjbQCjR-2rgi0Y8jUjFte5SZEC-SPD2P2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGtqB--UlLRiqj_g1Lfl2JDR21_DM7vHom9lxP86dcPQ&oe=6AC2531E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtm8luUX7Y8Q7kNvwHumlOO&_nc_oc=AdpwqCi3_cay4kkYyDQhcYblXUzVG4zAw2CtNZ6zb77ECScP6HbNXFBS4R0ZcqgjULU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFlkvhRyrpzSM03NYuM1N7VFuBLfLQrbTt287eoJU-1g&oe=6AC26451"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUb-rQpi5X0Q7kNvwETVbPg&_nc_oc=Adqwsb9gjGr1mW6Mwpvs0OIkysn2BoXgyt_JrSS_eap3anlPD1WuqHUZlxdM80h4vmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi40X9E7aC3dUscUuQuGTQNpeMVXQa-pjC_ICknSDGtw&oe=6AC2745B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kugKZNYslfIQ7kNvwE0Kxjw&_nc_oc=AdqzwDchqt1-3DAXFpzfNHgKmwXhreVZwFVN8AufRGQMjuz0JbBSFCuZW2cZaExHdAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJzQHulGZOmEsLt0FssVUm-EzI6lf2lYZqbeJQjxW-Gw&oe=6AC26A5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
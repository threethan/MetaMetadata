94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9RmLCmiFMQ7kNvwHoC5oE&_nc_oc=AdoEuuPwBx_ZIP1NKUzu4z2A5ODbM2zAb__8gbay8lV86zEsyUdpiKbTCE470X_tG1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27nuZUSbbIX3Ei3BAbF80wE5KwEmprpzDu-RNe4OgWqw&oe=69EA2487"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPcv47PPwqAQ7kNvwFSP90l&_nc_oc=AdpZ9fIRrnYZwAWczREpsJU1gP0hHH1YegqTC_tLUK7E4k1OyY8AyBGQ6ihfVd7fMbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21T4o0uFS07Y-nqLLvyZ8zotwpnwrwb-ofZI7frCXw6A&oe=69EA1D1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsdHuO4pqDIQ7kNvwHIhRM8&_nc_oc=AdrokS8lYltR4JxE8ijYEsY3lOVd-q4vAt96JBpI-zfe6ktnaBRAwAJTmX91qlZwBAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y72OTetiXSo6Fmz8gVSvMCCqpTbmwZq0QBELD2RA_aQ&oe=69EA2E51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JajSEnR0c8EQ7kNvwHV2Pcy&_nc_oc=Adr6RBofx2xff6YHaTVLJT-ZoetueyVtKOpRLKFlhRjcwx9rSlZG9CL-6nXRM0OoMBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3daK_WaDx2xD52y2raRW7IoJpKPM6nlSdjeWTSJS6nFw&oe=69EA061B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJvzdsb9r30Q7kNvwFWUUgC&_nc_oc=Adr9vJ6fEvkGT9alvG4QwRXyQoknnuAZIjiJkQya0dpv_PuAWgkx7Cx0zDoZDZZSHYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-Ok2D6FmZfp_h03lJhVHIK52whxN_swvM1m1k7bsiuQ&oe=69EA345D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
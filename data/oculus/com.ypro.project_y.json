94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkyK7tUB6XUQ7kNvwEMhEBa&_nc_oc=Adra1lF_dO7CjqipUwMeSeaqq4q5g8spA2Sk-_FavcDs-5-w-fo5J6pB5h01snlS7Kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90cnyDpQOJu9lKDh0rct44BHPM_VPj387r3--xAiRuNQ&oe=6A47BF07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNr6l7rW9m8Q7kNvwH3H3dc&_nc_oc=AdpY0fyP0BB_LxqGdtP4x-sgNqWEVICsyKDDkJSvQyasHU72uIUmGVGi2bmyvWihda4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--KcO4VRqBTkqg3eZ2zm09H9GmLAyaEkkvhFr30uUADQ&oe=6A47B79E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we9UAeMz3nYQ7kNvwH4fSA7&_nc_oc=AdrTDuqPVff4m8Ra34GMj31rsdB_-K4gJs0ZGaBAeesJnmVkIzuBJ5uPQ_bNN9RiesI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mldr82iGeFqraxZsZv7OvzWo13MGKHl5sFEMms-N0eQ&oe=6A47C8D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIV1Ex_xp2kQ7kNvwGbUCeo&_nc_oc=AdpZ2z4hqNgeLt6E0QYdaXX6I5KhF-l40cGwKdkntPutlky5mx1v-g5gLNN9ZxwFCpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qzj8sMzvyBjSe00Fy-ZQPbmBHIxil7oHx8_h-lPkrbQ&oe=6A47D8DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUNrYFBdzKcQ7kNvwHs_s6B&_nc_oc=AdraYbVcRdT0h-d0qRk_qHvo8bNsh9zRcS9objqD5caMb14Yt7bbigWc_yD80OY2bSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RGiypwTDn8_Y0hJDIXiTxy43u8bTuKBt4hT7yggmmgQ&oe=6A47CEDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
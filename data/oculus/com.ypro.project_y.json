94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDn2kNLZDxcQ7kNvwEGszt_&_nc_oc=AdonNPSNd11GNY7crpa2YwD8r-KffJMBNa6ir6Fvfzxlz5GoGaJeszJpUIH6IHy0src&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJZOBpYo91iGiPDg7x-LIR0ArGnPQXqvc5SPe9q-FFKA&oe=6AC3AC07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0YYx-idZS0Q7kNvwHxAONj&_nc_oc=AdoSCGHS-NQFkhnf-AAdhPhrDGz7-kt-dwrn-ms_td3QLOFJvcXgol1BNcbrmiKgOn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzCCH5S1dr3wyfzCaXucV2w8XiMFI-u6Rl_1ILz_kK3w&oe=6AC3A49E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtm8luUX7Y8Q7kNvwEOBFWN&_nc_oc=AdqngaQDv-snK9MiQOB-SNpgTjVIklrYFy72mbrlUWfxtSbBuXmu6rAZJg3bI_UTgfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV2rSySquQhC5FbogPU7xFr66-mccVKJQcgCIA2vDJIQ&oe=6AC3B5D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbMQsXqkYvgQ7kNvwH3v62K&_nc_oc=Adr10XM1yqinG13vxTY4l9mSGz9M6_NXyQWvNMdBxnOoj0VM2ZQIVCu88IcRtDbbR5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt8psf8D40WnFEr02_QWc1ENKtMDMAmUnhOfmPhBw7iA&oe=6AC3C5DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTsgLjKuVoQQ7kNvwGusoic&_nc_oc=Ado4GSQ6Ua_4NJpnH7EFtlW8SZLGlQVhHSWE7Wihvczl4_H3MZoG34ytjShNSQIKRts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ4OYX5PsbHvr7FxHrcRIsxDVJyWgommI724wNdjLRtg&oe=6AC3BBDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
vu9EC&_nc_oc=AdmU0MRZ3WfzkMD5MgKBADH-8ADirZBC78D3HD7RHxcxJhX_2M5RIV_y0BxHxHyiDkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFoLvNpvmE5Wg2FqH6QFpjDMRxn6NMobL2VzFECylo6w&oe=69B56887"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zLWgB4_RfQQ7kNvwFZ_fDP&_nc_oc=Admu3Jso2Q-xhtEzZoc7bIem2blPhQO_a9RdApRvrRmHnAisGmwqaV7toj4YZFrHQog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQvK4zFCwJZW0EgaADqA2n_Uiqg-k_b-HJUALE5rgk8g&oe=69B5611E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVCVMCMBMiAQ7kNvwHB0BTH&_nc_oc=AdkgPJRYYEasEbORU_SxbB2Co6Ti0fMlrrxeCIlYNooU_N5AEGcMUNMr4bZlo2GPMUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTAQ_zAdzobYzl-2r5uaeUByhEtIoB-gwPLD53XCQ7Lw&oe=69B53A11"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toupNWSD-88Q7kNvwExX2dK&_nc_oc=AdmZFgAh-Q-8l3Elo6ZSTQpyqZXQ2FhXUvzHiJuUMG-JJF3wG5Atc7vOW_ywF3XG2Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCO71MxaIhOFYCDi7Ad5nGq8QpO99k8Ff2-mZTOAkh4g&oe=69B54A1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yN1TXaI-HCIQ7kNvwEyU-Rz&_nc_oc=AdkkZNesxnCbh816MTvPHey8T55B207KlvOzVPKBL0bjdK4INCxhuaaWhOONrU07PpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwndmfv4Rp8IDekWo-wElL_j5bJ5_Tsc44HymsWOvXcjw&oe=69B5401D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url": null, "websit
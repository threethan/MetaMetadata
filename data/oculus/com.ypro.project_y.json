94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY9QDTBay9EQ7kNvwG6jtCB&_nc_oc=AdpXowqAySP2QvNQltU98jMBYHPLi2opX0ydxHndxkEYmz9qY4BD61pgz7Hs50NbQMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9r182ceGNAH_iRbkYumRg91wRqHYrYxUiDRT8K_zS0Q&oe=6A773507"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgJo3_NHMzkQ7kNvwF6re14&_nc_oc=AdoUrfwR8RE27ZbdRT8rpcNIQ5Dtjz0ShzO5Zhir1tgxSoBJu87r9Fys2Wm1yXOGXFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECvQm88655LFLC22suPcgF5eJ4MNkagoXd1n5RRCET0w&oe=6A772D9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEvgTrBy2sQQ7kNvwGFI3Qh&_nc_oc=AdoujCCqPBw4NH6vI1OwyQk2KdSQtbUSPBQxsqiopMx6YG-HavJxi-R4F7nUmv-Jvq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUIr4X8y-t-zKtMtvcv0tbwpHWU9n3mD2nPJ1fm6HQDw&oe=6A773ED1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX_Qzd4ndGUQ7kNvwG5FdDP&_nc_oc=Adpn9jmI4ILu4lONvLRH3QVaKR3s__1U-Rxy-TVOWokizVDyGjvDyl_SuFRlW6PcAwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuwIKCLeu8Ur0SQecIQu_ofL_NEliNlmEXlpaqbrBSdg&oe=6A77169B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6o-YUFsA7gQ7kNvwFHswfz&_nc_oc=Adr8PmwVhcni-lf4n6oX_b2gomA8tuEi0X04NhbZiS_GtTt1TTpK8foj8JhD2mRzkYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETFR3d_L9Tw1Upz7Vqj3p0Zyy5sRjnfFx29_dwZDac7g&oe=6A7744DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
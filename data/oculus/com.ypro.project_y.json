94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNR2TWizWL4Q7kNvwHEzbuy&_nc_oc=AdqhT9t2suQeX0fCJxZ6OBIljWJLV9l20mGJbehMeYTWK2j0bNe9xXZ8xfgf487aMnQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmqtaNZfnsWn2Y3Uj_zf0CoU-hFO5kXh9yUOATOVV2FA&oe=6A5A3407"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcfyxpZtTlIQ7kNvwG7UN8B&_nc_oc=AdrKZX_07SHAnLCowG2WcSlKIpMV3Nn51rcBgMY7Zn4Zt4bqs_BOLZXy8xfh4dhCa0s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsxq5UOa7nxt5WOGPUwJXfXhyundPSXAIAvColLDtnqA&oe=6A5A2C9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pewS4J3W-sQ7kNvwG4pPiI&_nc_oc=Adojpu_J-kBg27bZXifzi_Mk1CJ_H5OP0D53qoRgpH4CnSI_EbXjIM7Th8DOq49d-4I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL9ZYV75ftSF3Eou2EA4mDkA1HP3MPKiDduWa0A8nS_Q&oe=6A5A3DD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLHoViOPh7IQ7kNvwHdwFAE&_nc_oc=AdpBqIdrrWTiFhRHz5VFGzGNBI8y736lNIUUt-fiTj_9HgUMBlF8x7YA1_BrM_sNsYo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_4Jvq-i2S42DakRmN7Du1DD7xDFdFgk-yGeDdagjSZw&oe=6A5A159B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8-HD_Jt5vAQ7kNvwF5CMGw&_nc_oc=AdoP4WvU-3tLEv-IrEdupgfD5M1H0jUMnwQpmIiELOJOgpBgk0OQluMHPC_0hxU14Rg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkL5K3RPNHaglivijdltmC_6Ofi5ijlpCDIlFb4V8kYw&oe=6A5A43DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
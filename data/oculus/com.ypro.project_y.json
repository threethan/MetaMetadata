NCWQW&_nc_oc=AdmpbU26BryhvGaSBFF2tVB0Ogcxvo2QA3pG0j-lG0QO9w1NRwltPKOSHY7tEcOUDT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLKq6swde8qThc7mlALoflEaSi6hKB_fJVAnltiKBzlg&oe=69AED107"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iyKifL0k6IQ7kNvwFn8UVR&_nc_oc=AdlH3dsKTbf1HeJ72fXjmkzJDahFQzhieQytcAMtVD61mS3jW-A_8R0HRC9-VoQG8G4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeoydyRJv60GEwXFNtvKsqeDiLDHvU6RjQhDT6LVkqkA&oe=69AEC99E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_2GBx1o2AIQ7kNvwG3sOEh&_nc_oc=Adn92j4JGb4yuZA0NWyYrfJiRlycXc1fP2CUh6eiJKANbMTlU4Qmr4FqVXxwDfOwr5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuydziJM6a_pVgWZ77N_xl11vHEC5_wxDpZQqUsi3eKw&oe=69AEDAD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wApjFwgAsQQ7kNvwEY2TXZ&_nc_oc=AdnHVKW6UNwpEyDdqF3ALzCMxETq44_RyQuomHgV7XGyVfgL4j3jvSy3qnnaAknQ20c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu4LxahGuvT_QmOkdwHa7DcQZHZVUYvUULZgcTi8UJHQ&oe=69AEB29B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLJ6hALZ2cAQ7kNvwEuxWNm&_nc_oc=Adn2UwcA0UDgNUeivfo5FQXGvLid9cBcWpF2jYhT3dDc6bC-qgPN87KCvNWfs6QpIgw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv7zqas5GCuQzbLFOsYBbHHQ0wQkUtLFfz0BV3yoXJXQ&oe=69AEA89D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url": null, "websit
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyO7Q1wVH2cQ7kNvwEDq3xb&_nc_oc=Adq8S7SzAzMMvCrj5zf_doJzQcgXmNRy9lJCscfZIFhQHWEWqGtwU1UnrawB3Ri9l4g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHW7xB6u5z7KbcbbPW9udAMfPpFLbEsBwmsbPXcoE6WQ&oe=6AE89607"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H66hbHllIYQ7kNvwH8XIfX&_nc_oc=AdoWP4t0Bdxih6mLYnQiXBlgOJpH6HQNFXKOAhDbcPGVapGuXormtkVs6BBnHIFWG1I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzs7HNlinrcVQjqYZKfpiAsxbheyzfSI7-txoFeEycjw&oe=6AE88E9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raSby8baKxgQ7kNvwGIs4yV&_nc_oc=AdoOD-6PIi3QGWpcfDVexvAhpLnsNAwJR7ajPvsiOvh267of_r5h5OupwJfQV6rtE8c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcbXnud18DtJLSS4xmib47Je-cu85dxq1mzO7Hdv5CcQ&oe=6AE89FD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCzMdkxfAWkQ7kNvwEftCN6&_nc_oc=AdquFHmx7DLy6g4iePwzqUslXdXnSx2tgh5fqL3Ck3YSkvOkakxht4fi9mw_NUjpzMo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnQZFN8U_wzK4xiCvE2dZ5oi12ePMo19Qf5QKtXK3VrA&oe=6AE8AFDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1CTX5WOJd4Q7kNvwHZgI4I&_nc_oc=AdrdbXkj6r2Ofpfj9XbV5JPLfje1O813f_DyLOBq8b5uJ2yg6QJ21Hxu1MvtsR7t3Sk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf-IDFfRAhPM_7gmLvM2C83V5mQVxUeh92X-gGnkc4gg&oe=6AE8A5DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
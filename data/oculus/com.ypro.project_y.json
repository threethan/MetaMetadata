94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa47j_TNnN4Q7kNvwEZUiDq&_nc_oc=Adp2UM05Tl3LpbRg6PXVjxhfEk6GJMdhdwxi4NqosLf1btTeCi3zgT2b-yWC4kaFeM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp49hHztk4x7t6SLFZ3ezlZExVL6dpVAckZl7YAtqZIQ&oe=6ACF8987"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcfbYZVpY6AQ7kNvwH1OZ9R&_nc_oc=Ado2ZSvot3jP0IauoTSZJQlnyEexIiFdbZ1-b2nJzmRR1Blg_LMXUmmogyIb0cVQYm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPIXejYBPBmMkVq4I2atN0xiHr7FLNDl1ypj_UTHyR4A&oe=6ACF821E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XucdbtmmjJMQ7kNvwHbapTw&_nc_oc=AdpVZhiSH201oYtzCl-N8CvoH4x-dfVr7NfIdlYi1DjkNDqB2DHrW-yimxY1dDpKX4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0eKiSiQiXMYfw153AQCI3yQ0bSEH2JN5teWddsnBhSA&oe=6ACF9351"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ4P1Hfl6agQ7kNvwE9klix&_nc_oc=AdqtxbQBtopGC_X6OQpb6KoMNzzLsk80Ym6HSFNTR-21Am1-wZ54_sEUEVm_xZCAi6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF_OxxIgjY_G-H1PaIw50pIgfD5JxCRZmDvdwVEwtYuQ&oe=6ACFA35B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PjpMMgO7AUQ7kNvwFfDs60&_nc_oc=AdpMOcKX4hkgGW5gGjF0N_G4iDt45CvB_4g7iHj7Y5Yj8_l6eFonz1fA1-ju3N5HCUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODN3FPPv_-EuVXoje-XbTDFFTJthcnamLalwGDVbyIZA&oe=6ACF995D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
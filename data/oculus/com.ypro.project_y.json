94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIraXSRoh9IQ7kNvwHhy1ya&_nc_oc=AdoklCdPiCGS1M45k_y1jF3gKhU3SM7BMCGUmvfcaBsmx8RwHGC1HWTWJ6b3UA0fEDQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9krfvSlsAnkahnU9j8YK7jjRINAws8FAU6K5jJtzPhaw&oe=6A3D3307"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uja5dRiOyTsQ7kNvwGrGzFU&_nc_oc=AdqsKfaW8yogpFc8ks8sFoSdDXnQ8qYEDi8FH98RYBaharE9uDB0l1AVIaoCZRnYpQY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ov2fHRBdKlgwZzuRhiFEJB5KvXYZmgfBL7uutY6zE5g&oe=6A3D2B9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1GDv7BPfKMQ7kNvwHjcDpp&_nc_oc=Adr9RMXyauSdQ2IqCVDnIVKu7q056UNqpaCk4PVe4U_cBKcRLAarw8UfD7C7zdajngA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O4DkOeZuAf5vJCLPN-bV0JX0cJa75p5QL3STimkm5yA&oe=6A3D3CD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTWpcA5eYxcQ7kNvwFNJAb6&_nc_oc=Adr2YDHCfIE2AWHWDECakZfHPmuzsRAk5i1oKQ0kLBOYfUkGXI_ScTnguG8xa7zSlF0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b8dXFCr-PJqYGyNRr8zcs_9dJrrEDglKCOwUjqNqDvg&oe=6A3D4CDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPgfP3vEhs8Q7kNvwHeJ97e&_nc_oc=Adqa_ACVzlzyINQwnchEYu9nGYLHmFZLNwgp3dPOMvQXyyw5qkwDr8hnwIyvcccR8BU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aewNEERsRoiOPrcC__KyWQKOAVcURd36rg8dhaALmlg&oe=6A3D42DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
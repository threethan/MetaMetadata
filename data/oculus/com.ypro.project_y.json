94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=097Ug6HVYNYQ7kNvwH8OXs-&_nc_oc=AdqvK80a1eerjbad09gxJCSeyneDiLZ-7jm2YBV2AMs7eDNkvHbm-sgnGd-vmdZj35o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSvSqdzknSpGLSAaW23NLqjiHRpiJFg2mlr3gfJ8xsEw&oe=6AD3B647"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WooAkO7JmgwQ7kNvwFFPmiS&_nc_oc=AdpdKACAePHaOajTil4rZ9I2Uw7AbhhHcMuDZRXzIJmBpaUboWiPRA_aU28XVVXhG_o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_JCsxrarN5G7STgLpvqRPOsC4Lb7MHgQKgsNdK-SS2Q&oe=6AD3AEDE"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0f7m-Pv_yIQ7kNvwGvwnHd&_nc_oc=Adq4GgLYdfmCyZ__C8t0Z-BVPtfiWNGi30cZEmeEcDOBgx3PeCMQuoMtGcqiPZFKAHU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Z3DgOQDQlnByJ4kY8B7Lq8QokCsd9jLhzTS0VYmEzw&oe=6AD387D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gIQwz6Z-OAQ7kNvwHc4tc8&_nc_oc=AdrDG_iDyr-W0DK-0iyRdMknGUOYs-ap-DhfktIyKg-N0cQ7l1NG4rvvjyRuLoiLsgE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-uW7aVkUGdRbcPV_lmXFxmxdgnnT8MIvRzmL-WToFow&oe=6AD397DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la7RdH5fdNwQ7kNvwHvF-5H&_nc_oc=AdrsrHl7eMiXKdX64R93BMByJBG6oA7xgCOLAvIyG0eX8U_s-uB996lF_rxySv8caFY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaxbXKTSyChobLYaYfKuwInW5fVjKiwpV65UpXeAruoQ&oe=6AD38DDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
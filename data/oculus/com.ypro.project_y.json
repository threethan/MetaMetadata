3oP9k&_nc_oc=Adl5Oeqa4QKCV2kDYDBABjdWF3z5J-bbywHFgkiUkTMfsQ0cw-bJqrQQ5SYghBdqXuU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWAxPEyFzkhDDEsaO3W2r-and_IsnVQjfsfwSOKiuFFw&oe=69BD5187"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZO0PZ37N2kQ7kNvwEXSMul&_nc_oc=AdnhNM6kuB4JGZ3IpST5FwzPdW5ZbE4BFlB_eRzvX43VSkrBJVTR2GiLHm-P7X2-BTU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwU7drX28zHc97FxJ420lVODXnyjlEXsoRR6fHVg-vnuw&oe=69BD4A1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBGb7IN8S2YQ7kNvwFUnLVa&_nc_oc=Admw2TRmWCI_A8ew5vG9KD1_FI_CNE7iMr8prhKF1LCRB3hBkdjFqNL-w5QwR8nFwlM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ5rkeve24QfPU2NRCFwLlrga08HKqUBk_-1io82LDsw&oe=69BD5B51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FL_sZ6a0IcQ7kNvwH3qpYM&_nc_oc=AdlZuAdvjYgh26idTlbN9O9Oi_SKExK9n8IKSgMTbAd_veEMTrXKflWKEivFaliFVbM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBS0PYURviHcxDW3FNdE3XSJUl7hkml-ROthdaBLvBaw&oe=69BD331B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z16X14pylawQ7kNvwFbND3t&_nc_oc=AdlpVOimVx_OuA4RG--Mr86pw7T1MeGTB0RoTE437IeO9y73L1Mf93KPUfD5JoW1ALA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_Qdp6foKGvMCLYxoVrcu9quF9CfBIWco9Jhag_W8j0w&oe=69BD291D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url": null, "websit
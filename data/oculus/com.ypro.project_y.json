94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnZCPL3zyXsQ7kNvwH2-SaV&_nc_oc=AdpCYTC303T5SI4VM5z05pzv-dSr2r-O3nAFiEhN1GS4NIzU4c_vgV97Uqg3PEcI-g0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8riDOMbUQYbC1YD_orUbQZnrUUZm7kSwAFyiS-9IB8Q&oe=6AE1FE87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzq3glPavrcQ7kNvwGAqYru&_nc_oc=AdrC6SLIU0IQ58rYoDmBDdvYdB89XJZDsVWqlZUGhQ_vMx6qAd1qJ4EA7brWzK9WTJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAQn8nAE5yweLI-o-NKWZfKIzR9fSsaae28tcPyj7U0A&oe=6AE1F71E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXc15NBs5-0Q7kNvwFKcbGe&_nc_oc=AdoT3ZljsKuvceEcr5mVXMsPvoT3ox4lsX5QKCo6qnhBU6jfsqLOR0Mi7OzMofx39ew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCVWyObwWZrdT-9Mqx3MEqdMUDcm6XxgNOaFwdbZEm0Q&oe=6AE20851"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzGASzlnmAkQ7kNvwGrCJis&_nc_oc=AdoBIYFUiNLasnjvmH62WcwlrnofkuChe4iZUUr4-QGwiwvAwN8dBEoyCtozKl2TjqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMPQlrcz1cx4rbNhU0esQBrE6LhYgyyNeqE5AVXiVbWg&oe=6AE2185B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3pjSziWsXUQ7kNvwHjDsSG&_nc_oc=Adqf1We4bZ1IbZH8R7bIF8vx054MRf1Ch-9tvPkdOC1FKY_n3UzEGW4HdM5_sztKbHY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZcXzmH7DkadWgiq6DsxOKOrp-RqZWZLD-0_z51bYkEA&oe=6AE20E5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqLtWvYam_cQ7kNvwGhnmcM&_nc_oc=AdrLcCb1ap80YcUq8u3-vYVXeNxoE0yedFW2JPCnzcN5rvqRqZteMc_tLHSiNbRPwlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_xktK6x-SfL3OEPhWk55gGjxNRkOnDHi7JK6-y5h8Dg&oe=69DCF587"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUBCe88yxBMQ7kNvwF_Ymyg&_nc_oc=AdrjTfGhLI7ZSlhQRW9CBYkw4H0gZApBBFduKHPSe-mIBKrYEYzSKHyJzsY8xCqcbhU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WPNXALla3jMaZxbnNqPp_Snzx4hC1E9hwWX49tG4bxw&oe=69DCEE1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnsYVTXK6SUQ7kNvwHZHF02&_nc_oc=AdpolIqdBdQjOfNMZ_Z1qC7jwNwfb-epSuWsLVyZpxkq3IgeJeBMx82f73G6jt58l00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pEIktdNh680c8EoehzhGAx8uRCc3JhgxgWU_-m2N74A&oe=69DCFF51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9F7v3tRe7oQ7kNvwGQJGPT&_nc_oc=Adr9ZlITk0xCAX98fN7jPXF2mXcIGWkzCyNS9Mc9D5YszJbQqvKKHxa7AlyFUQf2O00&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AVRrCAU17s8jQtOSxVNYoJSnDg2TKMRy7_jRGvN5pYQ&oe=69DCD71B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8xzmXOJhgkQ7kNvwH2Svwv&_nc_oc=Adqj77SvnX7dMG_m8bQdQH2XBKB1p1j92ZkeAyyzSY4waTAwLr7zWbcAV_ryA2j_dQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zm7cE37YJQUn1JRCU9ltRSlWAoXKnFqzDdP-HF2Yb0g&oe=69DCCD1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A79ZeB3cDjsQ7kNvwHOgtV5&_nc_oc=AdqyMFTdapJ6dIxGFNEU2YAiECpUVZSGxw5tL4Xbah27Fyfrl5vuX3FKo4N4Nl5jbRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UmAok6VcbA97YZ1vB9Uh3RNNQWpw040rWGCpjADxZSw&oe=6A184907"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyPgrMnYxTEQ7kNvwHnpQkn&_nc_oc=AdrvSNAbUPAcOdgl7uxDtmG8GppQhnt1m6_9QJyxx69Faca7OtPQpuVrZiGuPKsww6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af534whqxJtw30aiKvuTtY_Ra8TWRgBgBEI0AWcmi06sWA&oe=6A18419E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13ShVknRb5kQ7kNvwGCRC5e&_nc_oc=AdqCwPY7_Zg3P8MHwqDpzMm9TCH3rm6caAS2Duzfp6udX1-4K8eHQzxuuJL4OXTgPd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aHqfmkmWdrbgKqVqLUIbjgLTU1aYQX5HW1ES039DMBA&oe=6A1852D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfM0rF--9F8Q7kNvwGmV5YQ&_nc_oc=Adr9jhPH5aPKoNsT-XkFuQDgZSX68IWfFBFBsr3fqHR9f0LBlZjjmY0pgQCzxS5BqZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-leWj8sxKYGMfCNMX3X-HmpnpKy4nQimncQLUAWFX4g&oe=6A1862DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gHfgv1HJz4Q7kNvwGboYLN&_nc_oc=AdpYRExYyxwt3A0Hqgl8z44Eemy3NlG1uvTfb9mdLiPGvJ1QvDeqADDgQdJA9Nqv0aQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VCTmd-F5-62CG8hgIetyi9ROeVdtdleuThKY4iYi0BA&oe=6A1858DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY9QDTBay9EQ7kNvwF1xnxY&_nc_oc=Adqea9IMR0pZYl5PQsjVoxGKUyH7BgY-Jxzg-hLGHpXAQTwZeVMO61RKyZDtXSmumRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_QQprAvfg4DqX7jkTL0fHLgnCmwjDA8sLRYo7DrugsA&oe=6A788687"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhLXrI2tlGIQ7kNvwEGrz1f&_nc_oc=AdocbXywVkLZnSng0btwNytGsUIFnkXb3D3weI2qL2RYtRfBQr7B9DYQ_iHfTDvd9RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4B87oCWpG1FVg90WNV1tWjJwdobprydY-hrgRSrzfsQ&oe=6A787F1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEvgTrBy2sQQ7kNvwEejzFe&_nc_oc=AdrNvTl9_g7ubc-l0WX7tymGrQNOZKsROUEei_QLBXZpOrg_7pRML15MluGoo0x-uS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaVHeRUOUBzW5oLL-I3AvsgcNEmuh132DqcJ0Fgw_fVA&oe=6A789051"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU6AkKMHcUsQ7kNvwEpVxe-&_nc_oc=AdoPUD8XWj3jvUoegVo7e7WjMiDT5Tzq7aMjiFI2yj358n9DlFHJRtjO5ar4xgcSyAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbUuShiOHTiIA6Xil0WnjX_addB_9XRZwPfQtUlUExxg&oe=6A78681B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfafBqT49FwQ7kNvwHtOPX6&_nc_oc=AdrxVM1Kpq-J2Er7Ibv9Mxo7Q8xaISnvg9vkQ4HECzoj9iYYpl0LpVoYHCptzQOT03k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxXW6BmiWiPlnsT_FyC9m1NhX9haTvnBZjyPR-1K7g0w&oe=6A78965D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
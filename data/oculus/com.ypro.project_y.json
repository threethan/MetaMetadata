94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVt5g0GNmLkQ7kNvwEjKKUv&_nc_oc=AdpmVvgDqScfPUBxJp0qgmL2PXAkXXzP6K_BLa4qsDS_Tz7xwR42fiFCDWsOTRtjNco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA8NhCHRo4RE0VBsPnnB7jHm9aYM-KlMpiVhkCfO16AQ&oe=6A7F1E07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96SmX2r0nqwQ7kNvwEWSlSO&_nc_oc=AdrIoLOZs1LPQEdxBRnMQDbEzFaLNpZhg8fas0JIeYq4YfvjK6-7gIX7DbCZgkDm3xE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBBrmck79IA7Jz_rhDGIU92LnviarFm_a4A3tXu3RiBQ&oe=6A7F169E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN1ksbk6290Q7kNvwF4ZvPL&_nc_oc=Adr51B3Cs3SE5I4ZTmUAkZHCepxek9viQY-zMCQTOah87lOlhPsKk2HUXd9gbClRW34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqTDjwXiS5FENhjJNLOA2LTGj5I_M0ZOBsWbL2Ab3J0Q&oe=6A7F27D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc-nt7msz3wQ7kNvwFJXcrp&_nc_oc=Adq31mVri3usa-DoQN8ry_FRNBOANCMFbI0HzWcl0uBmosYQqs3-TohXviFI57yvIKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgfOfMiK3ks7PUXFZ5jKP3ToY14Y8pdvYhY7BRZ8-cEQ&oe=6A7EFF9B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S4801p9wHEQ7kNvwEHZcBX&_nc_oc=Adpzi9tXxff7uksqWogyPFq1U1QlYX6R7sCaMsUMVsgBj7inYbQ51fuvWvfgPAwesKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfoCfnOTi9iqgpWidM7CWRx1D_NVMRkgSEohmF8_wN5w&oe=6A7EF59D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
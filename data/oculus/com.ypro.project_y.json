94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WlegjrgL-wQ7kNvwHWmJDW&_nc_oc=AdqA2vxi3k6JKXSNGRFBEg4m0yOPbAatDEfywN2eObi6rzFkDuQHjTffZ8zGJZNMrck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOMUnuCwuNzbHm2J6S0uOFFzQgv8dtWOEMq0LhLQmMbQ&oe=6AB13707"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdhzNylGLVIQ7kNvwFsfCJ1&_nc_oc=Ado1GZKxFKiNU2vh_BIR8-KN50g1MjzBCgmkdFQimXzxwxI2QmxmEWkURhgl7iTMKYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_-9_c3-9mRFRAuVvb5NYgb-0W663tQ4XoqBXrRgBTOA&oe=6AB12F9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA7wNqdWb14Q7kNvwHkeCTN&_nc_oc=AdpaeZiy1VaP-by5UVEPyXzoRGBEq86_lqIYp81faIlUxX67X3WHok2DjtyysuYNeN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIza6euhv2SuVWaT5tAhpZcEqts3ioDJSJSHUenfvj_Q&oe=6AB140D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rL1ZiwzRScQ7kNvwHQhI5k&_nc_oc=Adry5yoW2kFOdw6j4W_W0PbFiMVKlyIDP-CA8EOOSUMjXjrntsSKzz9cJRVkf5RypG8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6uTjWCok4fgD9_mgMlRBeeKx1ppLb7r74Gv7EChRD0Q&oe=6AB150DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaui5gGJ-mQQ7kNvwGZbk19&_nc_oc=Adp_jzBO25joe5fXdlqKx_k_nYe0GUcSxy5JTZy2mPeuEWA3Eb4zKi0pahcIIU0aaPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjOy2wej6_n4me90mwn4U2uIM0hL80pPXB0H47UTvPAw&oe=6AB146DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
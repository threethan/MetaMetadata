94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDgiAdiQHPkQ7kNvwHe0rR9&_nc_oc=AdoXmPpLse897mHwNTlElzYQKmBxHRfrtBY1_wYvSZJVpC5Tu7YxXSY35q0b7-VNZk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXyeAtaqap8QJ2o9828sPJm5O1Wdz4nr1uh2Luu1CIAg&oe=6AF8A047"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atW0ztnYJ4sQ7kNvwGhzUNi&_nc_oc=AdqKhTBSpJglF3Yph4XGZ1CGCMTtoHeeMN_HZiX3K94RxdZdgVT8CAw1BRelrMqPHPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReVnjCJxSaQk8TSjeRqMsMnDmaYLrEMkt_E3BK7RtNuQ&oe=6AF898DE"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTW43rU9ki8Q7kNvwF5RX7s&_nc_oc=AdoB9b9YQYIH1JifSH9IpTMC0J7zAs79KuMt_48GdrVrJQRplTFsgBVtD0RkuuDcSvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAUD79ip4lsnhFqdbP32i_qB_rU1KGrNKEBde0rAqr5A&oe=6AF8AA11"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PooyFEs3Ad0Q7kNvwEYh_rC&_nc_oc=AdoUeD9cBhqGLne7amia2Zko53SEoNm4eZ1rosWRu2Uq5oPd8i7xZfmj_fXQp1zlNG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUjq9plPU6TT7uq0u_Ry31mOx_7KNXAl1Cda0kryv2UA&oe=6AF881DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiRoQBJR5z0Q7kNvwH4fLUp&_nc_oc=AdqjqUWkrZz1ob9MrhdNDFWAppR9sZynniBsUS7zcUluObaOdlIphuLZWR7a7EbVYpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTod73R71zoWtoM-23L2S8Wx3fiCcUfhBGlrwpA5L1ugw&oe=6AF877DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRjt4Iuv66oQ7kNvwHgTH8O&_nc_oc=AdpNwM71ghBTmrE1tMKbCckE9j9fWlIkUbvtOBEzyn2rjbIYVNXDC-MuTmClE3zU73A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiB_sfjbJwPLSvnfqijITRb5RCApo7aeoqbCWKWAPdDA&oe=6A734087"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYdV5u2wY3cQ7kNvwEokEPb&_nc_oc=AdoJEgY1hdmb2lhX9W5Ny5s605I9hOeLpFb4zlzEG1jylUPHx50om2c6rnAiItn3ZTw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGODn5cK_xy1n4KIy6ozBm9ODaV35gsrHuO5yL-ToGngQ&oe=6A73391E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewoWFhwLE8kQ7kNvwHK9AkW&_nc_oc=Adqi_vaI2oaGaHepMqpfMV4ZPcmx4X66qYVB4XgARAVul1EUbSSlcnSXmZDgxOaWfMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYBuCCkWZ4m_B318mdWDH9RQ2C2RwaYQoGlIzsx4FgvQ&oe=6A734A51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGBiTI1AZewQ7kNvwEH9ho2&_nc_oc=Adqd3EKuiQ7RIs12FXSLrD9UVeRQyVnDJjVEkZGZ2nvgcVsjJ3_qCbv0jk8rvS0We-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbx-t7Rgb4RfH6jPfOlOVgfSSMOM9PHSiXzO0_3i93Vg&oe=6A73221B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S925pzBVKMgQ7kNvwFG_gAJ&_nc_oc=Adr_yLC_humEbubjAX4pr4saAGspx3nBfv7trtNmIqtrv43OOU6ipBqOBxHBDzzXkP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELgg6sJ-ar_1GV755kEMKlzaLWy1F-EPT7fwOubXfj_g&oe=6A73505D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
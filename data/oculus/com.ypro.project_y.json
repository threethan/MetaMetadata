94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-fz0jqeKmIQ7kNvwH9Ol_P&_nc_oc=Adrqmsykg_Q72hbc8zt-5AlTcqvUWX2vmVIqot0PyU2ZjUss0vQ-gMn4mcBlNKh60jY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RWEZC8h8a0bQ2vz3XQQNtIHVrM1WtrVrIFQd7_fxNPg&oe=6A32A707"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA2NEV3brwgQ7kNvwHf0rAP&_nc_oc=AdqNzWLHgd6f5R4zZJYn98vskPwQpHHKmyvLEf3X5t0xSUAO77AMwP1I_z1VA-dR20w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KRVO4rIO6189V0e8JsQpR6uVet0895feZXEfyFOf_IA&oe=6A329F9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4xU3Sfb5TEQ7kNvwH0RtAZ&_nc_oc=AdrAgF0RcfxDR7_I8jUbQDkKoHxLX5AAiGw3DOTsNZqjndCIYaaYpVWSCefTgaYNIyY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--MoVSXjnkkSL_zdOc8xKlTV628FMhc7JcneOcW8J0Fw&oe=6A32B0D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUUe2tg-vxAQ7kNvwGfvcBC&_nc_oc=AdonYUrj9V_CqAx-oRcrUkloCzk_lFmpFltzt-vFHy7WyJUsTot45ud5YUfGE0-t9Rk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DSsDCuHdY10Ty-MbUidhUR3R1fzDei6bbsgXteDiEig&oe=6A32C0DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL329SnvW6wQ7kNvwEAxzXV&_nc_oc=AdocihitR-p88jCvJ_vtlVDukUcRkePY6t39smNERYWSFt3l8XQc_4BoYpJ1zJGpRKo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bHLGGeT60ohzfFk2JT3xXl9-hddqbwtel_OOb2T7oRQ&oe=6A32B6DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
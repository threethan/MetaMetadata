94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMzSCdM7eyUQ7kNvwHkT6IQ&_nc_oc=Adr5nGREwUwLYJtOxmxcX5e_xBtoKrjEebXrYS1nOKs71ZB8Fqk3t-TtA6OZ2kiCivA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt2aNdyY22SMIQuu1AgC8-n3gUYqZ5eq1tvWtqqtdXBg&oe=6AF5C507"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atW0ztnYJ4sQ7kNvwFqSxgb&_nc_oc=Adqq_AAfstfqQ-eyWqEEG3OxOV-4h0_aHGYdWakAKg0vXMZ3-qlqoe6sF_JjlCgeupc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr2Iy7G9C3PBAN8IBw_5vFIccS_kWL2YVjCLwMMlq24A&oe=6AF5BD9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTW43rU9ki8Q7kNvwHXBma-&_nc_oc=AdqgKilcBD_J11Y7kZFCHvssZgwXcJ4VaojatQJir2T6BuGP4dy-IDDwffox-F5vfbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_uUfJRpqAuefgGxv1B5LNQ3iwrg7u2mSVu148eREjZA&oe=6AF5CED1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7WlNYEB6dsQ7kNvwHDHSKx&_nc_oc=AdpH_TgTA265Pgz0oY1k9_W9bfKXoREyvweD_iPa9vSDogmmVKQdHTkaoIXrkATWKZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaTMhXlybyKvEHet9-Rwfip7cz_8IxD6_EafbJiwD_HQ&oe=6AF5DEDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrSCwWoPvxAQ7kNvwGEl_4F&_nc_oc=AdrndxkxUN-rPJU5n8AnC40I5MMrSoprwOPvY-b_fuh-iA2dlwE6CBSu2Dzgry_0uog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnFdZqgxL6yt2MQ7NfWFPJNLS9Ct_5omzzFbtaWP-AGQ&oe=6AF5D4DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
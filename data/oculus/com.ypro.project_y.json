94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvpBJrrfAusQ7kNvwHKe4xG&_nc_oc=AdqIno8oaKwv7lLvdk7TiJkzH9BmgcJDLN9wvGcY9d04LEN6tpwQCNlqU0EJlEIG2qU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vz0_mc6QQXys55Ygw9IZVL8x3jVKY7GibH4Miaa-bZw&oe=69F9F687"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7Ep53jZ4WMQ7kNvwFiDF91&_nc_oc=Adq9JjUGnrpjJ_dWkQKoWM1Y0vYg6XOOEjUHxo3JQqOSBnDfdGGFglJBvxVqlbrpbJo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51TEWXYGtn8gLpflsoCIE-4E4CwSPc_DHEu8X9lagJSQ&oe=69F9EF1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_VfFj8S5JoQ7kNvwEgIh2h&_nc_oc=AdoCsVWQGQ9d4mgwUhIqJjd26O4vrFcpuwkUMgne8j7qWNY_hKV9kCrxuBSNH9rnMtU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GLXYSxALSsNM2JiALp6i1-R9dVay7naLQoubeEQpK4A&oe=69FA0051"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTROWejjeMkQ7kNvwHPoKIt&_nc_oc=AdpaztJl33fVNAzuOUe0MGFbNZkm6qeKiWYrwTEsa4WAIHBuMXAohauJVdun1em9vcM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GXlx19hXEBmymdc-e7nEKC-fUY1aXhuCI5UrzDmr05g&oe=69FA105B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FoLIVlScmIQ7kNvwHRQWNo&_nc_oc=Adrv8Pg_5FzLQ4V8HT2lfNPnIUbpdJdwajAa64krOaGXfa5Y_hIM6IEzLxiI8d4Wtr8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hKziFoyfykU_BEgKixWkelNLC-Z7FX5E7NgPL6YEIdg&oe=69FA065D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
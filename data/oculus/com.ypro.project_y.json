627778378694483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGARNCbE4VsQ7kNvwGIijBH&_nc_oc=Adr2JTOb2Z1EMBBDy-cSeeiC3_7bZD_xVSjxyZ36h9fUzsOaTBBHUNPvU8o7R2vK3iw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUA9yCQMRrtCpMUbzJFNPhJje8nc76K5VD7TrQ-F32DA&oe=6AA94E07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHC3_HwB4iQQ7kNvwFn94Ua&_nc_oc=Adq1yG5RzsL-Kxq6vXzvgWqRY_h1LRLjBK3f9Eh0czF1YLvuWau1BSdhy5WVmaH7UOY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrccpPQ5K3znPPh7Lph3-exY3-AcIZ2ixFPYOvvGhrbQ&oe=6AA9469E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4tYHXN1O_oQ7kNvwGZO32u&_nc_oc=AdqKnfZ5u7f580dlW0wgu638-qllyBCvxuLTJA3nG6rp_FJQ8k-4P1Y_kiXVBll4QtM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUDL22ckK7pzx0_5vek-3J3xeZTssltAzRZ8sJgqfKJA&oe=6AA957D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFwa1NTTJY4Q7kNvwHk53Pj&_nc_oc=Adqy32Pw9sfKun8j9b6qjeTWU1wKUUquNO87xRhoXKUnaeMWlpBFiM5Skr8KPw6qIpE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImk16Aynjl5vtkD0MV-iK9-SKlCPobEhiGIYqwdPv5qg&oe=6AA967DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be81BAaM1xEQ7kNvwHx_-Ew&_nc_oc=Adq_hZI92dGT7l6w-j1rkYFPiOOx9oTggUXz24ooAPi7j2JqddA4BFHm0suMA3WgBDg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX9hZKUKt70DGeU1woGBWrt6IPM1k6h0DVaQbm2uQTiA&oe=6AA95DDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb
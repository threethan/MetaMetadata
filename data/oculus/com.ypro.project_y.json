94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgEVoVsl6QoQ7kNvwHnbhzK&_nc_oc=AdoX1yvzbB4dNdogRkdySkfCERK02Z0tWQAwceL3_towctXfb_3zgKKOcbFrrENEpDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED-w_JZw2auihtbEk5Wx3B1svAn_F7Jc5NGT0D3tolWg&oe=6A95BFC7"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtQCsnHIOtAQ7kNvwGqDD2v&_nc_oc=AdoA2fDHj9quXUmRJnJZKgdnL77F4YIZzfpxMELIzdql69xtRtD5-WiF7NSqig6fC9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnjymFqMjsBNehUeWiWHfDZiklm0-dOGBYvb01oORMOg&oe=6A95B85E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mklFqqQvz8MQ7kNvwEjQs5z&_nc_oc=AdpbtdDuaQXhaAFtiTBaoXqxJA8VJsZQLnz4mDHmqSZhPnLoNf8pJFqc7uGgSUzao7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfIq19NyYTdOdKv1SLlklnSADHNJ_2z6xr-Jtab7oRbw&oe=6A95C991"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhsyKfMD3-IQ7kNvwGBXi6K&_nc_oc=AdrCTVuvKsVqthYH_zkSwAm7jUrK68N4d0mtnBanyOae7oVMgIwwW5shSziqUJ3BGSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3s9XC77f30GVHrXZ5rEneXOj-YfB2QC-cz7DyFrQ0rA&oe=6A95D99B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AybYcLxOE4Q7kNvwGzFUDE&_nc_oc=Adr7GCvfK02IaOQhwhF7wqBqy-aG2JCTfCDxwgIZ24lNh4-M2oUgkR-853CW2wjOtQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnorllESFt70H57OfpC09kNxbsk8RWUnKlKBBe3Lxl6w&oe=6A95CF9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
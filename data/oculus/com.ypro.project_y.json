627778378694483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=456Y_OuceaQQ7kNvwFKyyVz&_nc_oc=AdrcTBDg28MJio3bcUDxrjt54WacUVRDvxrfpzCCZeUZJSCoLpUSwGAR-d1zuehoDxA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInN-k5Odv3DasFblTWg1VuHVeHmjqp9XpoFt4fMVr22w&oe=6AAE9407"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFVqgAMjOrwQ7kNvwEtAFDA&_nc_oc=AdqQtwUDV-e3vdIBR9-cYdQIO-PeFkWsJlGGkJZJM8ZysrmHpRoeJ0ilSjkb8Xt5qOg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbe4Sfc1IQiU27qEVieG_YdARR8JsLGs083gCH8RlL2w&oe=6AAE8C9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA7wNqdWb14Q7kNvwGiYb9T&_nc_oc=AdrxtRE_Z7iqxwiJ6Czcbzkz9djg_PDgb1Hc4jbJ45cRmnKrSYMo70AIUJFWC1IcxQ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuaMJG1-ICuwXFyLNt5UDssfH_mhkHlZNx3Ra6cy223A&oe=6AAE9DD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpZfVK952gsQ7kNvwFNcFx0&_nc_oc=Adppg4q7Ny6X4PzWyxQLCrwVFextwz84fEwQmXiM-mASGgXdQyjCt5CUmsXa1h6X06o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYFSkGYFZcCtG-3osGzFUti8b8s1PGF6-Sfyo-u1MRLA&oe=6AAEADDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-81u1HpTtwQ7kNvwGMyw_d&_nc_oc=Adrja4xjTX5y9QxXX1B1OjwjS4GuHv50HoUDc2UVqoKreddVbko2QzKQL2zfeAPedDY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXMOmEIKQL6bI983PoyorDKk2qRxtIpBBqr4S5WVvN4Q&oe=6AAEA3DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb
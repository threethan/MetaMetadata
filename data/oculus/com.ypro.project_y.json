94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK0AmRl0vzMQ7kNvwFH37V4&_nc_oc=AdqO7cgUA7hURLAi3YYupTq_58tdKVokoim4lFir-hpH6IvReNsjY7zp8--osWGvjTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_WY4Qm7jJBs6tiy_SsNvAZw2cM5u6BOMh4OylhmhvIg&oe=6A64C007"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmq-qx-AxyoQ7kNvwGl3gd5&_nc_oc=Adqtp3ApHbFoA5LMS260-BzssyKOO6eszD500_mjNIEn82bbfTdBSCqri8UDH0-0DZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnlZfi6weGIT-3BxQfcqwkczKpabAhVVV_0iJIXCV2hA&oe=6A64B89E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZXk8MQY0TsQ7kNvwE3oGJj&_nc_oc=AdpVGABhqnDjZF7PPyxdqk6CfQ_wTb9NAqW3L9v7qUFrzf-hPZyQxwL-NVueqELkUMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOn4YfzCmAE6k5N8gYm3TmZj4C8DZYerNWv0nmvzwLJw&oe=6A64C9D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qhfu0wKwSnUQ7kNvwH-NiFc&_nc_oc=Adq3DqDTbnfmaD05Pc9gF2AsM27BFCKAyjsvbKjQrkF_bhAVcmC1upl_l3yt8u1Mb3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3iu7ynKLkD81nBq3DMg_sBC2Ywfz7AEWXeY8eRDaVjA&oe=6A64A19B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K96ukm0NIgUQ7kNvwHr4tqK&_nc_oc=AdrpO5bIHKqkKJv0DzZPwNEgaZ37N4suSMOF9artXVGRzzsygsFICS2juJH8-gde868&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfQwsB8hf0Xq7aYbkMHczl43zSek-HQqMItXzlD0BzBw&oe=6A64CFDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
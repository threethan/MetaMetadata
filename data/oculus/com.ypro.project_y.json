94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGARNCbE4VsQ7kNvwE9vYan&_nc_oc=Adpg1MbYTGzvQpRq8dnCQcggXJYVbp1Es27BT4orj_uSl3mM9k8aVv8bue3tzMEvZpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRMays7vk5TKjizAP-9Jv9J-4yvNWCqDny5My2-geNJg&oe=6AAA9F87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHC3_HwB4iQQ7kNvwH7CWZq&_nc_oc=AdqAFI-jIXrLpshXWRrb7HO-R_3ljm8gCjSJf4rLUNsb0QBw9grFus8nzNEImAqIcTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBBc4vWEnXynymXVb6q7_ug7toK7_BvgZHtJZMwuuxag&oe=6AAA981E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icRU8_Y8kTIQ7kNvwGZHRC3&_nc_oc=Adpoohv60Y07csq5hq6-NwSYxHJWSwPVNwSRPs0zRtWOQOs1USoROAJVavqqlyUuRPc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJsVzdpkj-wtz4eZrglMMUOJ3rZAorArZ1b3CEwrT-Qg&oe=6AAAA951"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFwa1NTTJY4Q7kNvwH0XmpI&_nc_oc=Adr-BNZUYDDpNj1ZA2oXO2Aw2YA3GgsPzXkJYguVdIqmSKFRZac_xMqzqF4ihTIB_A0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjYB05gWpncTrogPhQgDe7GlCqEvKaucr_-XSD692Mmg&oe=6AAAB95B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be81BAaM1xEQ7kNvwHBENGT&_nc_oc=AdoXiGcqFSEIAt5TCElxqM7LW7Alz5X3uVMvGzxgrcS38oQRX0a-la1jP0f2B3wpOU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU5XEGkXHOoYZkzpoJkLsC9tGZ-S5FqpLfbmFdsy4bqw&oe=6AAAAF5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
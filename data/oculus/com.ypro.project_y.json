94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sECj_6ZHqCgQ7kNvwFOexP7&_nc_oc=Adpu-XPNsHk8dkTGOhOILif1R79Bf8V0V5i17sCpU2N2I-IADnSKdY_Lr0NVNt4_cBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF15wBJeuiwNrIkGhTwPg7H6DMjx27jJYAog4uKcXJDQ&oe=6A9EC207"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJDLi_m-wdQQ7kNvwGvoJ52&_nc_oc=AdrCiiVq_msaKjyANn8EKdhVa7t6GdVuWyUeNfcYLavDRAcbMxPvcOcGhcREWIZwSQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2JOc4OsU3N7AxE1_Nx5sG4FiAizoF_klyno2iXCYXcg&oe=6A9EBA9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcTXCtMcM-EQ7kNvwHXce_c&_nc_oc=Ado7FB1bm95ke3JHJ8dUROuDw54AH7pfa8JHmvTIByvhYL_TiIKDJ1reukWrH0MCVps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLff3esFcbsVGmLk-QbqnHp2oU-95yhLE3MdM9pPh_56A&oe=6A9ECBD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSlMRPt3sh4Q7kNvwGEpqry&_nc_oc=AdpzqH2hj3V-SFXww2ds07jQe_N8IJ4TtnPW_ANIrPlUHXkqtodRBHO9dihtHcZw5f4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuh66ZNFb8tKiy2NO9AxAhGABb7MgWFoNp83GSDwF7Tw&oe=6A9EDBDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YH3RfrBt5oQ7kNvwF5wf-o&_nc_oc=Adr7C8CnIliu6u4Rh0LZFhlQxuazx3Q53-7AEQIayudxmBdT4SSHD74V9obRrb8zJyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOngDBY142Ccr71tX2tw-GHtMioO5XQiUsfJhtZt1yQw&oe=6A9ED1DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
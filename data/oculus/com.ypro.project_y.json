94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa47j_TNnN4Q7kNvwHPpPZT&_nc_oc=AdrrgxU4D3imGMt6jpD1_lXfHg_3YzZ4CWRY3nH0dY-LyOH3b5KqFpXUkIrbObusnJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO0SuVTlqYYLznwyoSQ-Onr5t4GRD147EvycbDI-nadg&oe=6ACE3807"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcfbYZVpY6AQ7kNvwFjZxi3&_nc_oc=Adpe4-oEz8ofxwyRpUZ5LYel1Xtsj3YJINHTjZ55DUcFSGwZAaJr19W8vy6mAoram70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5IrfZ1QPz2eNVypOvNkmtJlXYBNJte_7TZ-Q1B1_HlQ&oe=6ACE68DE"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XucdbtmmjJMQ7kNvwFddOFx&_nc_oc=AdrHVi9KqNDGYMrQ_L2DVokO2_K2qgUlbr0zToWlyXrxWsNs88rtcU0i6d62vSCjly0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP64EnHgA2nt5owsnZV-rUtZPUbujqoFuQBgMAVuILmHA&oe=6ACE41D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_zkBkjybc4Q7kNvwHLGdmL&_nc_oc=AdrkxwUxoThe8W7MB5-2pffMSRhinFALlixpOBsouAo_i4yL8GyqH-hPvEp44FnDlcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT_TaTSOFben4GvKD1gwrDX9bmfuHLYwTASU2XF9Wlkw&oe=6ACE51DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0hEQlNpPYsQ7kNvwH4tctm&_nc_oc=AdoA-ZWVQm60Vrtp13xO38BX1UYf80gTOHBSYGq4Fi2Mref24BBWWAyfrEN4RQ9K6ZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNotJzs6BL8m4qcn5fWanUDJG4B6IsyVAENszrdSm26qQ&oe=6ACE47DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJlRNI6edcEQ7kNvwGWftji&_nc_oc=AdqThQdryMmdMGU7M857_yTtWEFnO7hmVEBgOf0GSIJL5-hypTkzMITdKZoh_B5cGko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTN_c_Y-VBknOFeyqtT7t7Kyz_xl6z3yRhnkiZYuy6Cw&oe=69D11807"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=972xUtfFYesQ7kNvwGblbAn&_nc_oc=Adrtl4cph6U3chLgHINJQzQcE0oJF1qYrPk0-sm_jD0GAP4ezpLcb79ac_Tud0tl54o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCnj-ODcO2s_C7WoEl6slhEKL5LH0pIhuVYMGQv_FX6Q&oe=69D1109E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIuwXDyvbHIQ7kNvwGZDOR2&_nc_oc=AdqU6UZPif5jQ-IQpB5UuEVxIbMFqYK2LuHbM8zGpK5haclcOe8mSHXGEr3qcxuQ7pA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCsHGh50sRDlKTXAXpM-N1hN2L81gMqJe_RJoPsaOa4A&oe=69D121D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL5gkzq5euoQ7kNvwHvi1Yp&_nc_oc=AdrNm66SWe7BiUHysIKNswUiF50NEI7FgPYTgZP9XnOoIy6MGCBC_DOaXsMDy_8MlCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDWLW5Ev_xotYdVHNFbTithbrDU8fsKtxwdWIm3YtQHw&oe=69D0F99B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmovULBgeKEQ7kNvwHyeJ75&_nc_oc=AdoFAKIDTjdLhxdx8LFI3RSGAUGxDlf6bFmKc6tozx1ZxgAmyXg6jbE9zJSsSiJi-KQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxsn1P28-IIFwXrrYFwSCWxaI5yXxhPK-sxK4WXksfsmw&oe=69D0EF9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
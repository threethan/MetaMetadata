94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3p8zRyEe4YQ7kNvwEaARTp&_nc_oc=AdoWhH7HC3V6PEivpRNl8NtJl6Vvcctvu8P-Zv-dmtd5YNl4FFJ6s4gt4yS-QKxQO2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkbiUTgi94MyFHeOTmvu25hR7Znvp4aDILiwPw2f0oFQ&oe=6A92AC47"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44PieYP4aioQ7kNvwEDpUx7&_nc_oc=Adr9yMllJtIRhKcsvSUMSL8ePgo-SAOEnwLWD2YKvNY45kQh5fcY5YnTRUioO9nPGwI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJrKOo1eQGjcOrBHi5d0HwBb45Xg9NNa1iAo8PvdZMxg&oe=6A92DD1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mklFqqQvz8MQ7kNvwHu-icY&_nc_oc=AdpHqrcLVNeNHw6cXyBON6EALHSObJ_oV2b8L_lnyD8EBf9NMwza-l97arbfjTQDQro&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-kQ1shcuyrw9esT0fNzLWc9mh3wYSZOvTWO8ip4HfwQ&oe=6A92B611"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYoFpm5seAsQ7kNvwH5MGnO&_nc_oc=Adqu_wkP98ODBQYYG5eVSkyHuj3qmyGr4c37bg4q4HsiSHeGLrZvtIxm9-4-J3f1m8w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFURnPaBdb8cYDGZrUAqxXe0sOS5JyiANdy2U0f-eJ5pg&oe=6A92C61B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM-AUe5fTtoQ7kNvwFyd1SK&_nc_oc=Adow2J3WBkcz2q8PKfaPLwspNw67nopsFiv41E2B6QWADNymRAibRq8xZ7KXCOznOLw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9KdBgosbaRA2_9A0R2m6RrUW7bmH1umclHD75CUT_Ew&oe=6A92BC1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
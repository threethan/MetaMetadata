94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJlRNI6edcEQ7kNvwEyDcjv&_nc_oc=AdoK3SQ4R_leizS8nhAo7QkbbABH8glrZ9eeNbq7xH9HbKK7QTWP-x9lGfgnIzcgs24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QCMVqmzO2UiIFWJ7i-OyBP94_GeRhg1hkTFYjZ8dL-g&oe=69D26987"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9ysL4_DZH4Q7kNvwEt5qaZ&_nc_oc=AdribsDlyZIq0WL4CA5LZ38d7zK2SuTXXbSk9OKe2NloYwjbDxKhpafXLBYiI5Iv7u4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j92Ep5lIDckwtCelDotMi6Oz6YaL3Yqu3bxSJuWLNeQ&oe=69D2621E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIuwXDyvbHIQ7kNvwFhCx2o&_nc_oc=Ado8nIXTotBbHFQ78fk9_oeZfPiPNshGjRb7IVQrvbDOV309CrEzYlBPpDNGKsWgG7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xv4EwsGyvJqd7pH7WbuaEupOkfbEHgOV7zXZon6hnsQ&oe=69D27351"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT0phyK7YocQ7kNvwGGNsIu&_nc_oc=AdpmZONK-Sba25jwXPujZIuIT_9iSC4EQiAGZvpUEAbQkq-LcNwuT7c2pwVWTUoKdqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ogwsSY5th3vr941OLro0eMe7vlgCC5hv0DLfwolS2gQ&oe=69D24B1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggXfnZ5N8iEQ7kNvwEq9NNv&_nc_oc=AdpuTTwFnC5rTrDZw4bUIbHU6dMdpoiXuP8550C1IfrliffKh-W8pwUSVRx6DgEixjM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XKCy-SKpkovN0MwTFnGg19IYEDqoVw2eGlRIcxScDXg&oe=69D2795D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
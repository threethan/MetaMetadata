94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqLtWvYam_cQ7kNvwHUwGOH&_nc_oc=AdryVBWH7fBK-7twW1jngJQFlqiRpG_9_8dbFcYc-2F9W91SUSWkL0N6C5mbD8Xuf2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fjpJ6XyWw2wZS5vla1Wv_2-f4ebk2EzPA3jZY0EOpzg&oe=69DE4707"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY1HxX-BRmsQ7kNvwHlm3VH&_nc_oc=AdqqXbRMuZ4hzwBNAObSujmlH6MWjImKUlhKPlX7lGDQYPxVzPPVm2BA9YWSoPH-v6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o6egBuoaUI5vefYLDcFhxbgoDLRX1crLNNUL3uNFPmg&oe=69DE3F9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnsYVTXK6SUQ7kNvwFq37xT&_nc_oc=Ado1Bmv-HTXOSeD6D0OClxaIVqwFAyoT8X8rzSwvDbHS3clxA7H-1iWuxc_m-g9SNWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mSIdyGifV4YFd2PmDtVGfYqbk__1sEPjMcsbDjI67Og&oe=69DE50D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL7OsIGW9ngQ7kNvwGi3FwP&_nc_oc=Adq793flB7BvA0lNpWHt-UbiYEDHihYsmYJN3xW03Ah0qpB3x51KtYspo224RLTmpD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G9APmNHpaLqFuL5_eyCAu40_aYrJZTkjfmUK_X6DFFg&oe=69DE289B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm6b1EuUGHYQ7kNvwElZM0n&_nc_oc=AdqKE0IQe-FCUo7CJbIIKnj0mufM7Z_KtwdCCy6ucXFxFNJ4YRyZcv9GxChoRerxSGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qjcX81jLqtji8G0uAZ7fxnsGW8sZ6pnFgsVD6YCN33w&oe=69DE56DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
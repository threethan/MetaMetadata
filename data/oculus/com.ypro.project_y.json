94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3UVIiivmLEQ7kNvwGOsiKT&_nc_oc=AdoiGpT9GUxQCXRqBEconpcQDTs4yi5gbcGePockf5Fqi-HLSU_xD6KIyIbWCVtPraw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L_ehT86AlMg2jQlR45OGg3YmRn8NYiDZdgbSeq-sBCg&oe=69E23B87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_Vuc-xOemEQ7kNvwE41OPc&_nc_oc=AdrzCeOd0fKMW5rkCStyrSmifzyo4vVcN92rQV-L3elgHrZb9uEvXADUr7A0yQeaXgE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29eNSM6jcOBkKyVOHX42N-wIliYNXhxV5uoRLb1aIXLw&oe=69E2341E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhLAHeeVa4cQ7kNvwHv7ZBC&_nc_oc=AdqOMXuYgMXMaJK07CA3RJH3lQY5aGZq8deG3DhjUPQhj2ICimB00biSURbwZE9Lxgo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dOfEdbMHfXZNW2LSiyQ_5g4M_AjA5fs5L4pR3ktYUNA&oe=69E24551"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAxHMj6g_w8Q7kNvwFMxodO&_nc_oc=AdphJlznFXDYxXC654WQlVO0i3hLgBxBIUCUgbE8aTUggfUB5NnMD8gF0odvz6u7zG8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3whrsfIYADdOLul_eF1R60o077yxwf9siiqfjcg9DI3A&oe=69E21D1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5B2ZcDdvY0Q7kNvwFNJbUD&_nc_oc=Adrp66fp7og4RkwsDwq2gm1SrZVWZe0fxL5-XfxD4ZTfofQEnhCTnde3f-YHEETLLq4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dKduEExvvHBKOWBarW--nj6MhqLca49WOLG-FOiznOg&oe=69E24B5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
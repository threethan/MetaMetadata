94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkipGB52t7YQ7kNvwErjB9g&_nc_oc=AdqhZFsRvVp98nPZHwWBXZflGl7HoKaywaAcRXbfCwhLzg755fYsbr5ppXKw7NMux28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47X2OS0-nvrOdcbkO7NOs8WCOIooLSEON_MB4AgtUP7A&oe=6A072587"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IankLi3sfUQ7kNvwFTA_AB&_nc_oc=AdpmfUmYHns3BcphqupZruhMLaDc03YGIpiQ5vRHjNAiitmniB8ROZl0OS2xGbJEXcA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uKgY8RHC36AR8fDzFd7sw2KN_hOuRqezFcChHC5q55g&oe=6A071E1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OnwnJ20QoYQ7kNvwGJgT1p&_nc_oc=AdqhtZbjBS3Z6fA1XrRsfMEA41Wb2Mch4qBJ3wQdPVKVKEFPVEv9kjESzwfYYl1BzlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71Ad-a8zRmeRzJkqerz9r5dota7aHwoSkW2B4hUwgqqQ&oe=6A072F51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo2McJvXz0oQ7kNvwFnSixq&_nc_oc=AdoB7fq-DSC-xbm2UzxUPcBwrUZR_olCGy0lZbsloNwiBNCTL7DkZtKWrHXRJS_gDvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ovX8JRtGM2AbWVdESst3UByT61Gu2zMcevrjMiXFvQw&oe=6A073F5B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez3EmQIXP5cQ7kNvwGqOwZo&_nc_oc=Adoi8Facmf456nVT14O06EFinhFRxfJK384zUvAruLK3a3JWZ-eVqDTtGoMUVITx0VI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zbNIfMQ8K5dzpL42UhaFZS_AkzObFaUS2rjufx7HQ2w&oe=6A07355D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
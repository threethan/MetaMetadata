94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIz4ZOCeNTcQ7kNvwGQleUN&_nc_oc=AdpAzmD8TuweX5evi8dxcvXyFai4-mEvcWDJugWTZ7DeSH-d_1kdxls76t_WCf4t0xs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi68pVwmDi-_oUvHremrL0ECCfCqoQL-U-TFEXsSEEFA&oe=6ABD1487"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDhYt1L_1eMQ7kNvwEQ33fr&_nc_oc=Ado79L4NcQ3XKvpbAMJTzXMDnlF0UiBLlmcQKDCnPsnM-Nf_Vs2yawmGsORRL1chlfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8FGDYSab_PVyepwHaDgwnuQ2jYj5IbSNpzJP4A5THXg&oe=6ABD0D1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V9uMd-0JrcQ7kNvwGYIoCu&_nc_oc=AdrFKsINIXxso3ZTt3lbr5Ozyfpl4KdV75-KIcAmYc5zwrt8j8-2tOH-7OTq26LtPfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjDG00MyLlI0RY_DCIw2qCUQT5sLuClijDcr7sG2cyJA&oe=6ABD1E51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMH4aRUinPQQ7kNvwFdfN10&_nc_oc=Adqb1zAvWz1-A51up93015PpVm1eKkNBKuG7XBTatw9kAKNZcvHmi-WItLBIZthZG2Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7yM6J0bFNmzO0-OfE_7lKPJJSog4PmgJyEf7LMLEFHw&oe=6ABD2E5B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMMgzopRYTQQ7kNvwG5kqiP&_nc_oc=AdrElQ5iY5o3NX6_ysmsBsDtwsUE2sw7ZXAcdwOro1wUwp0_whMSQG1e5F3CgznS72A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlsPyRNt8xwxyIoM5sAqnOrIiz_8CE5ryn6NZ4q3INoQ&oe=6ABD245D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
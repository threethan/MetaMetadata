94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyO7Q1wVH2cQ7kNvwH0f8AA&_nc_oc=Adr8QzHnTCMOyKMMZv6-Eib35xDT6hlppV1nZX8S8ncQtyzOpxh4mDLXNCuncyPHKo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa8nRuJRac6iIXPnQ3BOOa-KYIdol88to0oc3Qrf4_hQ&oe=6AE9E787"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQDk2AkuzGAQ7kNvwHi-nhp&_nc_oc=Adr9KJ-VTqckQEo2aPb2SfUEItz2RJPawdUpjXNzdm3SB5DmDH_zpb-I-YpWmLict7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBUdRSHbDw1vhO480OSqyB07mcaqPgeUbhrPOqxBRjyw&oe=6AE9E01E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cROXUOv4kEEQ7kNvwFZVx9L&_nc_oc=Adr7dgD4vNMWb-ljGPhW0kMUGfB4YVarby_mjGd-96bt28i71MnG0Z_YoofI9eU702U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1-nz5iCMvRFlPbxPQoCrTixRVZ22fe6r1pwBGxJksmg&oe=6AE9F151"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCzMdkxfAWkQ7kNvwEsVdKC&_nc_oc=Adrbp_f8kg1xkFi5bM1BFWcgfRdU1pN3dyLTxr1HMFLlm7whza95xyJ5G2iv5AkRIjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRFNMhGiG158aF9JlbtHyIBQ_FVNPgkQNHrsC1HLbqNg&oe=6AEA015B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1CTX5WOJd4Q7kNvwEnxLRR&_nc_oc=Ado4b8SgZoL3zvKg1rXqGcOJw3JTt9Pkl0NDpV8Q14kCZgpYu3Bnn_CTFepjDerWelQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnzuylX6lG2xRBlStRcGpMqTEpZ8nsjMDouPNyRH65-w&oe=6AE9F75D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
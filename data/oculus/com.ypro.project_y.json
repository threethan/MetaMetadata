627778378694483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkyK7tUB6XUQ7kNvwHYMJnC&_nc_oc=AdqUKQ1uG49L-bP-BX3utqyJ5YbPrDHhSsrEarm5pUmrcWsZ19lZ845TFRqJYcVH1cw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TXAarXKxOxqwiA4F-7cfA6vHQkJnY8WorA14QNen4JA&oe=6A466D87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNr6l7rW9m8Q7kNvwHotWEY&_nc_oc=AdruOak-zjjgyIkhDcs3CkIh1eT-nk7sjY_qxkzt9cGr9CdcytFNVwTBzOo8pQpRRRY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XxrxCPN-ww5IrYf7-XnvnLZmmtxrWH4D2LcfT19O-og&oe=6A46661E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s__7PmCUuCMQ7kNvwEMpPm3&_nc_oc=AdpzCuTtiJjIHcwFsNNvX5pY6qonE7d9VhH4ZqvGAuvfzjD1EJq0xJCyelKJRquw1BI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z29m6sKYIOCTsIEOc9-IBYLIvGg2EnZIQiZYBdcfY_w&oe=6A467751"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIV1Ex_xp2kQ7kNvwG3On64&_nc_oc=Ado1Y547FUOr6PRc5WW12J4RklBIuWSE2YpDqObR9-2ocQeCSoB1IdHlMGo5g0Rj8Ik&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tn12125PBqucjnH9uVLN3ZONfO5WjO0XHFm9wBLRfjw&oe=6A46875B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUNrYFBdzKcQ7kNvwFiMt36&_nc_oc=AdrBkfXFzSEMTQrCIQAhyfLii46tVuchmv6L1gf31tZVN6eHAaEDYT7qkbvXCvH326A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IQlWHhpW4y4YcjETDivBDHJJafgwGhIZ_es0tBxnfGw&oe=6A467D5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb
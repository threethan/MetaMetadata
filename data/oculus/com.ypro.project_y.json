94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vp9dVFHjvoQ7kNvwGgqUX3&_nc_oc=AdoOlQC3TvVX2lNIzb-8ntLWzgnb_H0xpSSX5lgESqmFpOUR6LSWQSF0N1ExYHd9oes&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzqLrp6w47ZyFwkTyBGm5r4NUAnpeJ3XzgEYnS1T32eQ&oe=69C3E907"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6pl3qtzB7AQ7kNvwEd8B6y&_nc_oc=AdqeTwVYdyiUhQr2qwjdpg6fHQ4MDD2ssfT7OseZAjQrTZX4Uo5UBdlGvGW7_7dK4BA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIIWApDu3G-3J7oBIe9mCUxLvZqWArGw1lPb19U--e_A&oe=69C3E19E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YvRA9aU-uYQ7kNvwFrNc4t&_nc_oc=AdpcpzRZg8zhDiZrSKjlIXYtzYMpGYMD3xWaHU3PBKRTE4927tvr8JWN9YrqW5mj_xY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw09o6K5BWco_usES6oPkOe65TH4xczZNh4-WVxPjnaDg&oe=69C3F2D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq1bRowFBWAQ7kNvwGXF0Vt&_nc_oc=AdpXUUZoOW6ZqXZeTJFWoFKiZRWDzgcolRCL-hsaZfWsC_8SA7AyrAg_fQoCZT8A-bM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ8HqOO2R1HzH51RCZOaMUlzq4JYtkkf5frNIkLRiRmw&oe=69C3CA9B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIJPlVr3a80Q7kNvwFokREW&_nc_oc=AdqyjYouwFCpEtQnzkdiA-kBs3HTy_DszPB3LlkGpVlOWkRY2tIEPXlkFXBt712pRb4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwkqngIESkPu5r5CCvGhj6SiGASF2k0LycuQUrT0szYA&oe=69C3C09D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
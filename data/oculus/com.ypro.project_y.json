94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo8Nzu-W4EIQ7kNvwHlzNMj&_nc_oc=AdqBLMbKJOPC3YWkn2oLIesqu-rTcpAYAW7iypC3YwsFRpMYlLJ1rxkPLKc3-5TS_pI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zN3tL70L3Sb1mtq8tNdrTInKqT9wEINdHe8havW6tGQ&oe=69D3BB07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9ysL4_DZH4Q7kNvwFEdRO4&_nc_oc=AdoiZOTBP3A7A29cDAXvyvggbk6QIeuw2shctqzqNSP_UvtiWhJYJ-18rKkwI5C0A4I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37j6dYYn5OYl-NtQOfEXzFFRg1MoUEeqpoEVwtnEIdRQ&oe=69D3B39E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIuwXDyvbHIQ7kNvwG6Oz_b&_nc_oc=AdoxGnosAi6q7ZhwFBeppmNcVxFftvrwNFCNXHBTrN5LYXjR0g_DqMBkLYFNmRvnFkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eh_smm0JU-Bp23Q1gf6ihXITMDFpxybJmyEFWXcmW-A&oe=69D3C4D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT0phyK7YocQ7kNvwGtm2N_&_nc_oc=Adr9wsi5aZuEbcuK0ORT7d0ZTu3tgHpgGDeaF34rTZ0yuMoscc-jmdFYdSQbO4kqPBY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0drFqo7SvXC0dR1dtKqLYA7pQym9gXcwijv6v6z5pEkw&oe=69D39C9B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggXfnZ5N8iEQ7kNvwHO1fg9&_nc_oc=Ado1Dkl-9kqc6Je6WquCqWxUGwT9Hf5Ic5SvrViq0Por9FtrrkGnoRAEEDSJ3bYkxvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zSXluguSrd1ddQtidtZBwymq2mwsee9u-ATOlLcR1ZA&oe=69D3929D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi3zrasu-owQ7kNvwFBhgbB&_nc_oc=AdoupQZWJmMTAoRYU7ruB6fpzY1fowjym0IhquJcpaQsp6MJhik2eAQXEzB2dJVMHOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG4MG9dVzZ5Mkx8z9hIPdrW1-PPTi9QW1p5NiK0VwxgA&oe=6A900947"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44PieYP4aioQ7kNvwHMqdGD&_nc_oc=AdpyQ-qjZsydP0nSp0s6W5RX2U4mtcMOEFm--Bv-XONf3-3iN7eB1CuR_7sVNLAyfjo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI1i_O1DrobdjU0ttNol6ZKnImOMKc2aKGcKnU19gapw&oe=6A903A1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m2LfXrNcIYQ7kNvwE9Nwzx&_nc_oc=AdpVWUnl1kNSckDzp3OLmla2gPMC19MwdFE9OxTHIMqUsE9yLbRJc5dK87XSC5ucKoE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDDQ6m73DisboWnIvktUMsMCydEna3u_il1XelFWr92A&oe=6A901311"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYoFpm5seAsQ7kNvwF9VDXt&_nc_oc=AdqcmU4hnsB6AexbQUVlElvI7oMvaO7IOOcphG8LHnnIIcjYCIKLve7Kuj-zcdEghr8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQdOc1dOiGlh33o7I1DPtSZSuww4zqt2E3c4KIRPItvA&oe=6A90231B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM-AUe5fTtoQ7kNvwG01UO2&_nc_oc=Adr6Oyn_aJq-zX8m2Im3a-JtBqGCmhMeu7Eis8APzUp28ND59MJns00PSxB5URza6Iw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4JuCM_6EUnYEFRhrhMTeMSSBgiMDnopjrQ4JQUZj0xg&oe=6A90191D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
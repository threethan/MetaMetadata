94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5mUrQZcf1gQ7kNvwH9AGjs&_nc_oc=Adpp-B1GRUrbYY2MNONB-S0jxGSYV427BWZHUSGu3z5PzLs2_mNJnzbXl6RyxBkCobQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf6dHjI5xMSx3z5A2gunGXExi6Wn11v2w2deH8FDKFDQ&oe=6ADE0A07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0NCFR8K3esQ7kNvwFbEGHb&_nc_oc=Adp3VnF7YQvbK3Lg4vMT_7KRlgCEJ57Dmim1peayqZDM9sBxs-UkP8LJMmJrSAz1ZVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgzOYUSDTs6ZUDZj083v0HLro21ntaELe8AFNgzV6bJw&oe=6ADE029E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtIdMXJKr5QQ7kNvwF48AZO&_nc_oc=AdryPPhIiduU1E1vuif1FVXkz3pSJCub1_JxRx-iodFDJ5UR1iVdTUf5QUywrXYoWok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfd_rjThYJ_s83kk4FBerofhEWfUQ3GlvXTbnhGKoSEA&oe=6ADE13D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUEjYXfLafkQ7kNvwGEhbEV&_nc_oc=Adp5O5yjhVrpmAkRSy2xVowwqrvViran6mhG0V29wumOsMv3d_5CPL1ite269IDstIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo0bip0QH1-jdv-wHCZur9e5f_IyBjc--ivq17D-_NFg&oe=6ADE23DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMcLDdQcISUQ7kNvwGinnjr&_nc_oc=AdoHvt9t7f2ZhBZCLqDYd6jKfSm9BvneAjkCvpxHQ_u7vNF1kPGlF_8JdB47P5CN2_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTtfn-ItGlGmgHUENg2lS3mhI5UiipSi6tItWgfvqs8g&oe=6ADE19DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
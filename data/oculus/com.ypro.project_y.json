94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BkjJMxhFDYQ7kNvwFl72Z0&_nc_oc=AdrKTmUhRHy-1R-yPhYRRDTSHQu_iJnYp86Gc3qlRoZmikcqNRdJW3ENkIoMtnvgOQY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t4RN6wxip9VqIII7SaBeP9UFnruBTrjug2Y-Lt-txpQ&oe=6A300407"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA2NEV3brwgQ7kNvwFf1O52&_nc_oc=Adqi1TP-DlAB2bhkjfDq8659KCdgAUrdbqcHMxPWmaw93v85qrvjE_uc2RvZKNNRkzE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pITmSjKpPBDlOU41fNP06QjQPiZngxdvRgA17L5MQ2w&oe=6A2FFC9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4xU3Sfb5TEQ7kNvwFaLnxu&_nc_oc=Adokf-mstRyXArHX3Tmd6J_ESU5NyoaETcGrS3sOHiL6mKCWfkGmQyEuhyYm-4elfjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9deqXu-clu8uuQDXjlHiy-ZgOddVe3ciBYb_IydVfUWQ&oe=6A300DD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJOqn0UW7XgQ7kNvwG0ahY2&_nc_oc=AdpVoDVKl8EWKpS7NAUTQjTzbuu5JF8oO8dYzL54bK7yQIv2CGoWfYgiLOdDOUp-JyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xac_N7F0S4uBbGVvj-As7646Jy0W_6yxhZblwbUrQig&oe=6A301DDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBKVNaki5RUQ7kNvwGKgRb3&_nc_oc=AdpnqSDfL0UY0EiErZUQeNWKKQj72kZFu4u2zmyf48EiDwBAPpzbYBYF-WS5LvLsdcc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ix0uqWvAmQhtIE0Zb69okBy46B1fKmaA0SLjXBJMEmw&oe=6A3013DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
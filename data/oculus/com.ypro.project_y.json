94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O1v5XWUH5wQ7kNvwE0cYLX&_nc_oc=AdoYIbnSXNCIlmKyRoX_FM7jLAYKW8Cbk-mHFfB-rJAq85PZPEVaQsv_P3EhB0KeQ5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQCORgwH_MH564VR7BYMqv5sn3ooXujtYpYYPUhnzw3w&oe=6AEDDC07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFAO0wNl__0Q7kNvwHWKhX4&_nc_oc=Ado5g0hWlD3VBGv1WzpTgMoCpCxWX6Yx_QYSDqhNM6HQnnHAFvcG7K-I-dzWNFXsS4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs_FY0HToPwldCMz9EvdtIP8sYjLSulk1lPsTFCH27sQ&oe=6AEE0CDE"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JClGGPKFo_8Q7kNvwFCSULL&_nc_oc=AdrB1-Hgp9V7D64hNizRvWaBRH_PWmzE6b04_o_abIYxLhILlkpHHZtnhbZBYkjaL68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOi07y-0zlnmpEismU8SPBkT32EyDsRfwqa6XbiYMFRw&oe=6AEDE5D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF3GibJzuD0Q7kNvwH5-YVS&_nc_oc=AdpCsZ8XUxnM7hezRElgUCFoFBKh-kltThfnjObki6zi8xCmSzPMBPxkjcsEf1XpBnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyu_WeBqgsUxeQ9n-qQUZchSG2EfgNDP2W5koKN3V-aw&oe=6AEDF5DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5M72dkIMzoQ7kNvwEgPA6F&_nc_oc=Adro5Pp_VCUUrGZWt11d9f_M-N92_S5eYYPGK7w2BpE_wMrQI6KeRHvoo7UIy54rRQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHQGTcFTFat9QdAYwEniBbnYWIXAFyfD_7Veh6-Ahr1w&oe=6AEDEBDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
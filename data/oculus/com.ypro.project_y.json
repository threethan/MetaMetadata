627778378694483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juqu5BwwXXYQ7kNvwEUtrzl&_nc_oc=AdoVFNDpXER0jkxQccaUZK3kPgsx7RvY8zmSErofIYkQCL7EqdMDOi_HT3Hhj52KQq4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcnI2KR9JN5DN5S2NPke542ALdeQ5ULJeiKtRQXgYr3g&oe=6AA40807"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_-CMxz3YCYQ7kNvwGVSzAR&_nc_oc=AdqCy9WM4VHabX5DruqoTo2XJ7BsKHTHX_kb3Zh3w7k0a7Ak7heB3H8mKjly3XnoP-4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaXd1ywkzWsa_En9il0a9BCcVkuqeqIfBdycnDSscrAA&oe=6AA4009E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL8E9tgT1S0Q7kNvwHtnqgb&_nc_oc=AdpOK_I2lbVHEOb29fXmEwAAwiqSx-PgCZ2pze8h81__8PqpjLcxhsrnhaFzs3d9e7s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjrgzzbkMvtHMxZXlyFcWNJJzVdtEwk3egJaSj24-oIQ&oe=6AA411D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc4gg6j82mkQ7kNvwEoDj6o&_nc_oc=AdpXLDq2yxjkYEt7XoL_XYS1BVsKpbZj21qa33vNWvFlrl4z4jQn1N5B-Sp8LCZoRII&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3aTq5EQoih0H7NgjGsdUHa-VLaVjjDd1CJS4JY8XTMg&oe=6AA421DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDHxbmERRQcQ7kNvwGup1Bk&_nc_oc=AdqZw60rxbMzvqjUg9u5tuscnOBmw4cUEcGy07tdApRYv8ZI-cYfYEDFM1b1lfS665Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbGJmC14A_fPPGKe5Pa-RXzsB1FPbKYPnphH3nO-8CmQ&oe=6AA417DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb
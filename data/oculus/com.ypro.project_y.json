ufiXSDZA&oe=699EFF07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wn5wsmYjssQ7kNvwFVl_7k&_nc_oc=AdmhfGowwqEf3_LDESK4RP5IjqMijZqOwp-O3ROgFvtTvJxG-uUgvyRdbf79gHUMjNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftGoXtdqkYSqVHE3MVmA1m9oUCSDXhCSyfwXoSrMH_txw&oe=699EF79E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTyNMKGHOOUQ7kNvwEucdDx&_nc_oc=AdmrmfGJfv2XDn80iNrqY_VL1bE06aYD21666We7q2c4H9h9XrlZbIdCxbucNqf3k8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afve7WeO23DGKmQZHLZ72oBOtLHoSSsLXAI38w1CPYq53g&oe=699F08D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmg6y_9tYnIQ7kNvwF8DJMc&_nc_oc=Adk-2wmbQZVwFUeDc9bXQ_UaTH_i8oMjsoM3px_9nmDhwokA6sEPFD6IKsC-6GlPkvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftzWzvSoHaVOtrXr0AeFbLUUjdCxTnddt38czG4CqeImQ&oe=699EE09B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kicjovnm7XUQ7kNvwF78KN5&_nc_oc=AdlQjADDQSmahK_Cr6v4N-fx1nKxKFS1j_UC8Vo_UyOC0RGtQFQsPpK-cUEauL3SYc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftPq7KHN2zJHD3mbGP0aui0L5-N13PaNKkkrOI68uhu9A&oe=699ED69D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url": null, "website_url": "https://sites.google.com/view/project-y-2023/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
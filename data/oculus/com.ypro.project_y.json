94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI9s1PGaluEQ7kNvwHQS7J5&_nc_oc=Adq7vGllvq8V7oOE7agfoRdIJPH-8UqJJm5u0CbQYYp6rc9QClpVy7kUWX9U2aXpRRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dIopptbJF7sNwrFRUMI1RJ_NcMx16ckEMq0WM4UcICw&oe=69EE1907"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvQ6h47iTGYQ7kNvwGpVfEu&_nc_oc=AdrNDpgYOzSZ0uFvyL_oC8Xw-NWOQ10CaWmeAtcU3Obxv89Is3oxfJOcJnvvaDy7LDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qQL1XCwZyDJfcKHKI_CHdFU7d9VK1xeTcdo0ofsQ7BQ&oe=69EE119E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwWXH1ZPkWEQ7kNvwHeecl1&_nc_oc=Adp9TluEZTtfnFyOpc034ZH2ENDbK7OUT44qUgtVvuQuIiK7Xt8Qde-lBeMuxT3Fz7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pqXXXjUgvqOGU84X6jpNPCyQjLhtGDDMPr7bHXcUoLA&oe=69EE22D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9RwaV54EQ8Q7kNvwF8CghK&_nc_oc=AdqnevBZiYiVCsax7chVNAjakNZjbFdPHz2QpSh--hQYJilQkpglHJr8piWtzLNXNiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O_gCaKE-A2YUFXtveqNXJSRj06knnSzIYrfCL6HkVJw&oe=69EDFA9B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPP_gdeRxBAQ7kNvwHA22qC&_nc_oc=AdpzV5Rq-K49ZxyPkVpIdcgguyQ90PJ_T16F-IdPKveWQg-J6Qo-nnDsCcfnU3IF_ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XKP1bpTXD__b7nih77GAoVS2j1CtMwwvdo9TZimNwFw&oe=69EE28DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
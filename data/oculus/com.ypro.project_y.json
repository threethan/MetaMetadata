94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNA8VdhcSq0Q7kNvwGKyuzT&_nc_oc=Adq7fQloIlNkwiquuaOlPQEH29cwlBni5jBJTWp6ATkFCmvG78lU3ApMZUwYRWuAyQU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqY086ham2OMSSSt9PEWifiAoNukA8KGtoFGDrJ2-9tw&oe=6A86CEC7"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyzkEyD4d0IQ7kNvwHcJIgE&_nc_oc=AdpeWTuDURKfIkH_R6diu9KZJsrX-d9c70c-Pr6qfDYcM39Pn0CbeUM-ySGOsGt2WOk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgIr-kSP6mcw8sB8_vS1EPJnUqE1csJdvWLulqWrvScw&oe=6A86FF9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvCWcqg2v_UQ7kNvwFKq_8t&_nc_oc=AdpL3kdmGqUrn1o-nLSpnJTw6Y9hdcxrpAnXuJgBgFdkAHCUVIRRCcmpvApt01EP1xQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFEz54gkWskWuC_ippbSUlKTVe9dHTzbNq32-rW1XcXw&oe=6A86D891"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNLdPmeBwLoQ7kNvwFUM-UM&_nc_oc=AdqNgNdH_79oVyxJANLdhUM_fbhKEbo3SHGjwuVp0dpUNbsawxtnsCXfC7yc7Kag5OA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0oOSX5rL8zhqc8wSncNm3hJc2qwHRSrDCkfssYrskOw&oe=6A86E89B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3e58MytmwIQ7kNvwHO_9rT&_nc_oc=Ado36vAXKoPu9xoaB6y7Y6lDXJkMYdvja3AcBpP2OHY1-JfbmCTry2oxahSaNPZo_J4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjZgGdmwTq1-o7tII0eBMtQDURGqyCzEoF8Z8ZKrIuug&oe=6A86DE9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
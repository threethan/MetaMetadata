94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rlf6QpJSutgQ7kNvwFOxApP&_nc_oc=AdqaiLs4J-mnSW0PEuun9fqwAdZ1Y_A4f1_TjtOFro4xziLEA2O1wtuIuzaL2HVMnrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgwnFMdYTgJ8sisR0YUkgKXQUIsizzj88_GSuFr00s2Q&oe=6A579107"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIph1WjgH1IQ7kNvwFF8b0C&_nc_oc=Adodx9OLJMJenmfQLvDoT3yyvhHUQxScYZzoq0uBKj58TWNXDDt1gD7PlSuwg-947OA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBovw-w9r2GZMeVIxqnSshHxlGHaymbtENnHK8z8x7R_g&oe=6A57899E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pewS4J3W-sQ7kNvwF-UyQI&_nc_oc=AdpIbP5P_rsDs15SI_TCWn-sOA4bwonoNdVCrLUCVoseFi2U54ONqycuhg43qdsyQww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5BJxU-nAnS6oRyr5N-9T8juEKLtz8Lw5tQ9rn9zynLQ&oe=6A579AD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im4oeWPM1qUQ7kNvwHjlKL_&_nc_oc=AdpoFYUiEKr2F8xutB6x-glPD5us6R_Ou1OiE43AcRivaQ0gv76tcl4MfxAjmR_z6n0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWGP5d0XZPjzY4m1e8rDdc8sWIKRuNDinmrfzLsXKV9A&oe=6A57729B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoqPiLS1OrUQ7kNvwHeRaUI&_nc_oc=Adq-XAX0rwuUGVzP12kx2Q9IHM7v75vlvbA4pYVQ8n96ot_AV1C7JBYk141ILBduizo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGWuy4O_ry1KMG6rITKm2MS6ts7uk-ph20hGt901jafg&oe=6A57A0DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
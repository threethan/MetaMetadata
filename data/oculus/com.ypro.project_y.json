94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oRdPH_yT0gQ7kNvwGG7hxQ&_nc_oc=Adoa99_uBt0BI86MwL5ZWfJmU6T7ZEJeeu6lFPnAi3A1NV22wA3awA7cPcRe40QPUsw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kLLTj4tSy-YebfqrMyXxKtMmn6209tAyC8BfiMCRW_A&oe=6A1AEC07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFnNPJEpwewQ7kNvwH9S-Rc&_nc_oc=Adra9UPOhXFCB_iR-XBhy-5FjTQakY233l7T11qsQxvK0X6yyyeTHSQgDPV2_VrM5-s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47P3-K-Zvk8Fc7kKDapZ41GuoI6wLDkIOKB354R1sveA&oe=6A1AE49E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13ShVknRb5kQ7kNvwEk8Ovk&_nc_oc=AdohpITL4szixf_AZ0MX4IZswg_MKaJJIK6ArOEwSqexebpwbnRCQeGrGzUqzBxoUz8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af703PQ5043FRo3MmDRlnniN6zLwumSV4dubjDUJc9FIeQ&oe=6A1AF5D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H88xfKCR0wAQ7kNvwFhrp1p&_nc_oc=AdpYW7xT15u89Pf6oAphuzDXCwgRsLZrlNZwIMyK-St8aGdJRrxNQsvojwU-W-vUEPU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P_KlzyuE8V2dy_shjnINFxD-J4F9AdBuWTt_E0Yyxlg&oe=6A1B05DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKSH1Li15vkQ7kNvwGqJK_o&_nc_oc=Adqn_9RsQRF6hq35z5cJKsrT9vsiajwlBRICBNIhfn9dej_UPyeIrz1QUvW-5keAyfM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pyLNZ_HWwpfN9d-lkQyfzjPLa-Ma7me1o0FGjMeKx_w&oe=6A1AFBDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
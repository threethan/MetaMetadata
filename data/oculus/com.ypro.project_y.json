94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-fz0jqeKmIQ7kNvwGVnW1f&_nc_oc=Adq9lImG33AlNRN0-ppJebViB979gNiK5tYMFZ-I6WbJlt1Z09VkNkSau1XzJjaWdCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TjZIt6HfaEoVcS40fgBzIg9JrT4v_7odW2FPTg-gnpQ&oe=6A354A07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ7NKOcHb0UQ7kNvwHz8ID_&_nc_oc=AdqwuPyoFJShYl98BkPeut-mRE7nw0O_ECePTb3nZg-yFnlLUQIaaXRH5fIgzftBt_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ts1N4TlWcOGBBag5IeX4VEbkW08N57iPTvr_mtp2M4A&oe=6A35429E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRYoxi7bLH8Q7kNvwEgfjuL&_nc_oc=AdpXj5mb4LHI6UEZ27xpQWzXqrFo0UKKb5MEmul-HpxGtD2-AY5PdLKvDjWQaKDKq1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90IVzj0y0g58-W4HVaKX7G0009TxPrgyQLzCA-4t_2ZA&oe=6A3553D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzXEQVFTnY4Q7kNvwHWafUJ&_nc_oc=Adq-Fc-Hxz-q5DhxMgthVjJkN3_-nXmcBPmgFel8fGsgNbtOhWlJR1oJqQ1bZ7Mr0OQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ILMoE71NtMFrlxio1OLprlK2Horl6iynzIyyi0UwKyg&oe=6A3563DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XrjYsKX57gQ7kNvwF6gFuH&_nc_oc=AdpXl0nrybKUYjRxJehu33c82Z-eZpHUb9Yvs9UH1x27xbwdUycUFzyFjTUBOnKvpnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FhtCW3ekEgH9cgkSw9F-YF1AyfO3n-POLPaowlSHA0w&oe=6A3559DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
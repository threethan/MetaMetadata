94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMXOWImGQI4Q7kNvwGPTWdL&_nc_oc=Adpjr6kgybK-PmQrM1Pv59T7-4_pgCMkudXXzzAH0BXm2p6YCai70fcFmmzoBCxwgeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIjhkZ5G5_V24728x_FlYA0ubNUgMjKjIaRkWIGT0ZOQ&oe=6AE5F307"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H66hbHllIYQ7kNvwHoFWlQ&_nc_oc=AdrBHZUbRi8om6fif5_KcY-2CTDFRsaUPsvqWjZRSYYMmso-GSWhfdWPxS4F4pqxo50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjsPy2U1V2Idz1uUPhEvF0Ns_pIYXBnEi-wq3lEzvHbQ&oe=6AE5EB9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raSby8baKxgQ7kNvwFWn5qc&_nc_oc=AdqSam_ItW6JslZdG0Qul5dZlHUIVrlLfZ0eDZTZwSGoMrDjPZTNoaZWtzJekSSf4-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOXbUwhw85u8msL2fX4tsw93oUb0m6iXRYa-SKSRl23w&oe=6AE5FCD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgOoLJr90UcQ7kNvwEF4GJz&_nc_oc=AdqGdnAloaW8N2wmYK3YnLvGlM4YkglUijakHqATkt2vyE6nDmHEjmtd-UPiz9dYUmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS9m70fAjpXrMBqRZUT8yUc2MP8XgWfxFeKKxqzfKZgA&oe=6AE60CDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr7KcQKMPukQ7kNvwG0qkUX&_nc_oc=AdppLhthr3-fOy_LCQrQuYa6y9Ae_SjgNZUe3uYxSnjSH6OPsZFXvByb4okNbj8Ww2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6vW9b6hRx6ORtXGFXZnEjlywJeqeujss1S1KZk9djiQ&oe=6AE602DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
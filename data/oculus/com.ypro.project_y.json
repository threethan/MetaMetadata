94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9V_ihoCW1EQ7kNvwG7YdIc&_nc_oc=Adrh4YzTKLmnccmKOp7AnXBtrFgN6B_I9740qsAaNOWst5ihFJwvyJHTkKE4UyAj6Rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7hTfSu4yJs9O_c-kp6gvCz8i7IVNKBQDBgq3X8VeRKg&oe=6ACA4387"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWS1VU4KEycQ7kNvwGel4bL&_nc_oc=Adq5pzR72-Ch4C4GX1Re0gwy4U2nU6ey0KdHh4YLkWWEytHgdWnnKNcISFnH_X2_owg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkJ3lBAL__w4X7G6kZSVqjkKeVK6mZtXCazQmeN8lDrg&oe=6ACA745E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTKGS6ScUxwQ7kNvwGYuOmJ&_nc_oc=AdpJDq93ZgvGQCKNRwf0aL_jLArT6pqT8K2eUYleLz_eVYo1NFURC2q8gHhlU0qxEU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV3dGeT5_tVb33kk96IKdOFGYj5ACQH5mJVeugXBoAJA&oe=6ACA4D51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF4qTFgzsLsQ7kNvwE7UK2z&_nc_oc=AdoPyRuuceiZ0hMbulFsx5KcvVCiv5Kh8ALHErFN7KQBT4Ll-7zGyvk0S9_aWgDjeek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHl5_oKDyXij2k3ryj6Ekjg3euZhsmGV18tTTAy-68Ig&oe=6ACA5D5B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcwUTSS4qD8Q7kNvwH0XuRJ&_nc_oc=AdoGBLBNFjK-LGGNzcEdQDanaS0wy5GPrs1018mMoI4LruQ1Me7iS6hMQzXRmroAmP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFaUKzc64itL7_QFv7WPb3vmXt151V9nCLHBUU_a0B9Q&oe=6ACA535D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vp9dVFHjvoQ7kNvwHnybBD&_nc_oc=AdoFn5LYW1Nvefe9HoCI_7QYRuzORipc-j17jQ7o95ZlSo1Rznka1ebdGGHAHOzwovs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXO2jrUUyMphOF4whjOcqSh5vM1wFKtT8NcdMbScaD2Q&oe=69C53A87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6pl3qtzB7AQ7kNvwFZ4UGy&_nc_oc=AdrKGNfvfxP8Sps05OKBSVY5WNApl6sgaZdspV2fDYEHdv4Ba9oDENE5cuCF2CulLH4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIqysbOR-pSNFd40kd2DMOkNAuAg1fub-vCvzbnlhPNw&oe=69C5331E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9h6Dh4YVdAQ7kNvwGPsfhJ&_nc_oc=AdotQG7Zhu6WbLDqDQYSiRBiikF_CeIhw25AbC-dl1Nn3XSMdLEfQfRg0euk53DAxCI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwu7BLUW1VVA28SxIbLPIPblnqarY2gCRmmTUlpDv7ufA&oe=69C54451"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq1bRowFBWAQ7kNvwG6SCVe&_nc_oc=Adq1xHHcPnACuoujJ2jtLLSTLERnWbxnKIlQ_k6SK6GcWcm57HRw6cz3K88NT1gZOgw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbfF9UHFkgc17zgwBaf7HiJewEHKPScsnerc7EAqPKTw&oe=69C51C1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIJPlVr3a80Q7kNvwFICLVr&_nc_oc=AdpXTfCvOwBDj40ndefGBNXi_WAG56hkKi9y_q-vQLft8MwHtajzfrHUof5aG8GDpVw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZEWmfIpal0HN6WaSFmjK0Cj-y5SzDkGMK4NXr2_KPMQ&oe=69C5121D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
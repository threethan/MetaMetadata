94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_elT6FOovAMQ7kNvwGcrxvf&_nc_oc=AdrLkhk3-2gZKC7-ID7i4kfpwibqqU3p2LHtFL1Oj25kwnxgF9gaTfVr5VHHUlGlV54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHIBg3l44m4_AWLInsLyRAnp1tpeX04kl0m9eQjYr4_g&oe=69CE7507"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=972xUtfFYesQ7kNvwG4UQR4&_nc_oc=Adojyy441vspApMa19gl3bXnvVHHNZ2tuMFHnatLu5653KqPiBT7YMd2Q1v1k4ICsng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVU_8p-K2N2OXggJJ5BFTVxWrj7_vePSaANDq-v37CYw&oe=69CE6D9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2OIbiFS-goQ7kNvwEjySjA&_nc_oc=AdqxVZYD1gAWjuJ4ivBqyrTBv0VOsZy-LgEFYz2z9uekipmGQO60sy-Yp49i21phbi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwP1aS-aSmUeVWGNwMF3C-dpQDlZnlkxenpEQBDP9Bj3A&oe=69CE7ED1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL5gkzq5euoQ7kNvwHtKwsU&_nc_oc=AdolyYSuG1jKc7CD5tkorBDYay2-d8_PrUPTpN-RfvS_57NztS8CPiNUySkdAA5sdw8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQyxJr_j70RTkpi0wfKhd6KAs652cP1IucMLUA53TDjA&oe=69CE569B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmovULBgeKEQ7kNvwEdUJNv&_nc_oc=AdqOS5dxHc_8n6R2y-IaE3tH46XCHPrYIJp5klobheXcnIjPmz-zfV-QcrL9qjlg1c8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgUFkSgaSBvzXPyP1FPzCsNvbCeP9Lcq0klri0CFFeFw&oe=69CE4C9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
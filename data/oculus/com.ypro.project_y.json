pzkA-YCA&oe=69A44507"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0HC_tzelVEQ7kNvwEkBy6q&_nc_oc=AdnBBNISa1Bg2tuR_rAUa6M8uLzKNY82U7MT9fCRg9akTK4E0-pFhm-YUrI2iy7aEog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftYx-H8xRq1BIw9RcNlnSVSckmBnRqQ44gIfIS3_bxvFA&oe=69A43D9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDrzUgl9JxkQ7kNvwHldtpG&_nc_oc=AdlClLuWLuVbF5F8thoAQKA4FRsNbVn4bt_iWD4cQcVkE9KSHtbzp0Y4jRigNvIVbsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu7JPXogsSYzrGPRwPBSg8UnjTumau64saW0gsF-oY7VA&oe=69A44ED1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo51-03JTk8Q7kNvwEW-Uo-&_nc_oc=AdnJs4gmII274bCOw5ANekuJ2B8DSHX3j8sknZpEdo4HFt8NOiAXcDte65id6rQ0Lb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvxbxZR9NMEnnpxm2DoUQO2o-bUxGniHJMO_S2g_rVJfw&oe=69A4269B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63CxBqxTu_4Q7kNvwFXKIqC&_nc_oc=AdnTdzZ1omBK7p2IC7QNYmhfF6fadGVT3Q9X-gAsywba1FApPfgZp4bjnzaeNyNn6FU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsVm576lBIjS8R3xeVNBwfcI74hE8C72XX3Bu1SWhVHgw&oe=69A41C9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url": null, "website_url": "https://sites.google.com/view/project-y-2023/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9V_ihoCW1EQ7kNvwEAgokT&_nc_oc=AdrN6SoQVLSEhNGcqt1IVK23IVLWvmlLe-6dzKzlZeUP_boHs-vt_LXS8wuaYFiS_R8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh_MHUIeUDAMKi7q9RQxBxxVIJlulRwy1iuFHyBUJxnA&oe=6AC8F207"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCa2K5INyhoQ7kNvwGRQ8kF&_nc_oc=Adry80PWky3RKIHslkmMzA11wvjaTRVw_B8arM7LuBIj3wH_Zl8wi2juxEEz_i0lqGc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm2vv9IC2BRt0QHr_-bQtiJhKTcx6cg_o5PJPyduo5lw&oe=6AC8EA9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5QuTFWkRAEQ7kNvwHeMj_x&_nc_oc=AdpXkQKRlReqqFPtgWhTrihV69dA0ef-xfKwWo7lLqXh7qxhRKsTF-VrrmiVDQLbTaI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN52dW_S8VBf9Znf0bCYbk1yXzei9czvVMkRocibqX4yA&oe=6AC8FBD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF4qTFgzsLsQ7kNvwHv9yHW&_nc_oc=AdqmyAPjJVMq30unwuIauIH_vxyJIyJ8zSj7L342YdmZFlnYL9S3SaAfebPHCJyTf6w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNghsT3haLlU_GtPIPiVn17_Owpw7nEqGract8R3HiMQQ&oe=6AC90BDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcwUTSS4qD8Q7kNvwHjIIOs&_nc_oc=AdpiICR4hGDqCymXwMLErSm2ZuZi-W2faOu87HaiXryHBlY1gNw6-vX6inI2bd1hrRI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY6t8U8LJVfBvkZAjXnoxoYVukxxIv8orYzspxm6n__A&oe=6AC901DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrZ0HPAR6SQQ7kNvwGOyY22&_nc_oc=AdohAZ-YhJjGWUfSAl0y8_FdoB_OBOC0E9nxzrxn2OQ5Xm2DoODg71eVVZhm9D6XheI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5pbGEvQxJXQCHHAJVtV30M-fVH_kR87INSGOnMgDnPg&oe=6AA6AB07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_-CMxz3YCYQ7kNvwEW8K9W&_nc_oc=AdosHHedemqKoKNrJ2bMsH0C0byJMTSsGdYTkSWx7Ya0HJKhrGfnShFbS3-wDkNwQEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5_SRDpeAb0Plp_G_xauEHbMVyU2qJYzX0XzCD0xc3IA&oe=6AA6A39E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4tYHXN1O_oQ7kNvwHWCTMy&_nc_oc=Adqj_YOVeLLdgNhBnZqvggIPYUhszE4ZVqz5Uu8OiBFxSsqS2tHb11bf7uhVrYTbc64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAzQmfX0Ct3VwKkMFH4n3ufFKPliJSTtqxTC2uHgBxew&oe=6AA6B4D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc4gg6j82mkQ7kNvwEZ48xQ&_nc_oc=AdqMv1e1J3x2VfOgjh-2y2G231vKR6gIsSjuKSsXbCYWG0NkuIOKh42VVmW1B-rLGu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwQzZa7eOv25Cey92cPtQoP04II2zRZOSELYEPCgf24A&oe=6AA6C4DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDHxbmERRQcQ7kNvwFiuNlV&_nc_oc=Adpg7Q3jOsUNJfGv30EIC4guno9-lAaGg8_ZdPUJrsjhbqZlmaEJ13xpGuCbLL4T7uA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-5vU00goAUvdVttx5a9XSw0Y-2pq3bp04gWxcSFZ7HQ&oe=6AA6BADD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=copwlYx4pfIQ7kNvwFAdOZW&_nc_oc=AdqBiNBiLYe77Nk0CYlTAVSJaVSuJj91FnpbRfQpaf6YOuN0-TyMZUdbcy5s-iw77WM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7b7t2-cHEtjluhaTnZjVt5rOd10YpWf9xPudDTHivEw&oe=6A661187"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmq-qx-AxyoQ7kNvwHIbRmq&_nc_oc=AdqHENYtUSyibA72jw33mACUKiNE8fg2JURro_ukxV8HCk98CSXkUTk7Bh3H9ZUQbMM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJtQkhI4YtQDdydQQTX-DXTrLU3ZZI1uxCxF_y4UNX7Q&oe=6A660A1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZXk8MQY0TsQ7kNvwGgZWgG&_nc_oc=Adrcpqwiz3LtSJxHV6_zdHlz-LOUC-4ldHQgH9we4OLdtQhOdeJbX-N2BlFqqU4L-Xw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTeJZkpKbBJytHuL72EDCRZS7tUB0kIaf7p0ozxnCYQQ&oe=6A661B51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qhfu0wKwSnUQ7kNvwHN0p9e&_nc_oc=AdprQ6NN1iB-zaukFeQAiKeqgT-jY8Z1oyOBGLzFPypnG-K98_gcmAlcyEs4Co9A51Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtUbDC1nETa0JyozCntXr5uXdjok_ugJZRvMaMnfqQxg&oe=6A65F31B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K96ukm0NIgUQ7kNvwGrgIks&_nc_oc=AdomOvC9Sxyn1nqKj_oMEfu3HQx1vj3umu4k3-YeOTa297lGoZBd24lelOEhKE9J3PY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuc1H7VmbQkgx38s0wVnqqwFCoizIEgL04m8NdPscrwQ&oe=6A66215D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckNJVTU9NkEQ7kNvwFX7MaH&_nc_oc=Adqk8YHcl5EvHib08O8j5f-cZ6mBj0BkaLeHWsLMBK0CxM7rb66aRgafjM4MemWhan0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKhVj04OuyEvQp9OnI2T96nF8RbP6QYqbMAKOH59qzeg&oe=6A60CB87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xSh0NtFDCsQ7kNvwH5i4CM&_nc_oc=AdpWEhoKyu131xEPRHI46M-FOTt96QhD9RfdyXNVES3rkRYlpNdLzh7a5YncSu4PuAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUTSvTun6lMQiKq4fzhTCd2ynfZ0ySDiz2with19lVyQ&oe=6A60C41E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNXWIGaIOWgQ7kNvwGUy5iA&_nc_oc=Adp8GwSMTfh-eFx384w0RzBCwiwnM7Ax8Q5IQART56qHegvh8XdwJLh7gs05g5SBEec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOmgtWP82DC6jD0hSD0zVfWpUIL7JfldcjTIv_lXi7_A&oe=6A60D551"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhoi1QsxKpcQ7kNvwG_5_OQ&_nc_oc=AdowBIysEJv28LWvmx7CFqtRJlKmMZOmLUyVyY6_ZjbS3BYo-4dCOpvKrkik0-ocSjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJl0oJ3Dk4ekBMWK6Hzk6GVVQM9YqQXli-KE9yhWtL7g&oe=6A60AD1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAqziOPBM_kQ7kNvwGwBAIe&_nc_oc=Adq3wAdBKwAhIjjeL7pPVSb3aiWJEDrFU3Q9e6MvGdDN4S0j1ZSVzx2Im70oRBOdOis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAodxeGaGCS_CY7Xn0F_cmqs4zqJvOd0IWymHkc-ZMqbw&oe=6A60DB5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
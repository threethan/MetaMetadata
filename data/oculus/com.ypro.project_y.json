1w36K&_nc_oc=AdmA99FajMaWVIqcpKdFgzeRM7Tb5PfrQ_DI304P1iwNmb2LDv5FTBtDIBqGkYitheU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeIskljdH9jOZE1ppTbtgbOFAIZ1GkmTE2n8dp4JrrGQ&oe=69BAAE87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZO0PZ37N2kQ7kNvwFmPIX5&_nc_oc=AdmXNk17eaHPO0dSGhnGAWEOQLCXHnoqsDpuXY8LUI_XIKBmdBwW5tjx4v696TgzkrE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSt7BT5sYOVwvqQB0cZQw4b4NW99fBdd3vuhG2eFGuMA&oe=69BAA71E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRN1p2_OezcQ7kNvwGsUI4o&_nc_oc=AdlmM2r6U0pyVNF0sBkvwiRsy1IXIgeiRXrDj504pNOgpeDFzHwEvVv00Pyz7L2ofUo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVSmO3eHkN6wclZNwDpajRe_hTiwZDngiN67h8knW_rA&oe=69BA8011"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FL_sZ6a0IcQ7kNvwHwJYPP&_nc_oc=AdkD4EepLQlgQb4Sfs-i7oCzIHpiWtUNZIQEiib4fJnY0rocvJyf8VioplgJ4ZEmR70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiJv7Dc1Vro_T3GXDoqtj0kTYt4UkyuYwrqpeBvizelA&oe=69BA901B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z16X14pylawQ7kNvwFzI3nw&_nc_oc=AdnYm5bUz52ZlowSQImLnbVTq-OWLAIv-gChT9tS-MpAzG2MnQrZwwivjD65HzxF8w8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwnfr3lRSFu1LQogeJ0T7TUY8PgLjgey84AnzH9w-_hSg&oe=69BA861D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url": null, "websit
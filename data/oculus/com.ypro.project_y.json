94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDgiAdiQHPkQ7kNvwFRkr7H&_nc_oc=AdqAtUxIolyFL_-jvdzzyZZIi7jDWoK0zu_vuB2md8O3Kr8UmVLIj3NL5Oc6Lw1Ej2I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrhbCnIB_gwH67prVsEfMPeDBMc2yT6McQrx34QAH6vA&oe=6AF9B987"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlIpyoo1NzcQ7kNvwE4ybuL&_nc_oc=Adr8k0fTB1vmKVvYBYxSA-ZNHAGj_2Y901H_GjIGIa2S81TVAOztZBPH24P__BAnkQo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE4RtBk5-FgF32XbtL8TuPqybtMju-pa_wAGgOEoud5Q&oe=6AF9EA5E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ie05Ft0k2EQ7kNvwGnXxX7&_nc_oc=AdrJgZcs2lQ9LFFcMG44nTdaNqXKPGtyiipG1bbCsrCCBhpfW5JPwv3grp7sN9vtSH4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6hGXfxGlK0U2Oz8N-XnBeJ55-PXUX3uQ4wzlD5efdhQ&oe=6AF9C351"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PooyFEs3Ad0Q7kNvwH0m5Ck&_nc_oc=Adrx91qbXezhLbzKBvwcchJZeMRK8IG1PVDA6bite-CRfjkxyzODP8bLzVyTrWHl3_Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaeJyomENyYCpBSvWhVSuptBH7pCmLrwZh-NF_Jjftgw&oe=6AF9D35B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiRoQBJR5z0Q7kNvwFBUmgZ&_nc_oc=AdoXu0NhL5f9gZfdwFsJxDVIrDfZhlsDQ5mktd5MuKncs_lxF2vwgeojw-2YePK7Npk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKgzsrmSDKHbzS_i9hPqRmPh48MP-tIuYsVVDO3kUt0g&oe=6AF9C95D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
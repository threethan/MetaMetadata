94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWBgkcI4PK4Q7kNvwE9fgmO&_nc_oc=Adr53Lwkl3a8YnhmFr_wxsAlT2lWGeMv3ekxFzt-ssP-ZZSZN7M5PmqESJ1llxJTK04&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af551UpptJA0JHKhLFQpGjzzJlXInTYQMZtE4RFcc6yLew&oe=69FDEB07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlbmCBVMBdwQ7kNvwHI2CMD&_nc_oc=AdqcS_UqSmFMce7O4PJnt_xqXSy3Wih1gousrk9FWla_RLQ7CoQ_ApINM_JRHbntj7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ucWvGxyFNehV8BO3-lt-usih02NiJ9KR0mFjVHzd-Yw&oe=69FDE39E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKvwXMYP9jIQ7kNvwFCLTcq&_nc_oc=AdpVaefWRQTm1zfJ5g_IHA2OuqSMIUHcBw8he65B_eSyESp-qpBHKn17eKxL17JmpFc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PxBnUPgrCnVbY7eaNlhBQGUNfhKZ9-B0Y5rTQPqwrBg&oe=69FDF4D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpME-ehpnZwQ7kNvwEbmEwo&_nc_oc=Adq0_kVMacGMSlqA3amipfcIfEqM7YSYeukoZQGyW_yEcrzMsAoZwji89RBlSMWF8KU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SMCdLfizt_a5S68RDe9-bZDi0Xmzx0HqHd5j_nvz65g&oe=69FE04DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVwhVIXKjvAQ7kNvwEb9HlJ&_nc_oc=AdpM9KtUH1Q-nv6YnzjdNGiNda4X9hFWFiRIsBvTD4ELwXuu4gt1Pij0ROZ5zeHe1Jk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bc5bg2dYb3BJu26qmcA5msnJoR7b7lyvFfPIpdigAew&oe=69FDFADD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
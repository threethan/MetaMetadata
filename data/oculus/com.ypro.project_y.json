94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKX9mKJ1_x0Q7kNvwGUMTlP&_nc_oc=AdoP3gUPMGoNFZYWIUW_giHiaaUZiA4eIXuvXbR9HBwxrylWB6AP6czW5SL0wDE4uPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV1UfibbUfmWuKWhTvOF3zb2Jl5sgT-GAyJR0Yidp0vA&oe=6AC7A087"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCa2K5INyhoQ7kNvwHWH-5Q&_nc_oc=AdqR0I-CS60KZOn5K7XmBKa0cYvcZP9xK-aYSD2MN4kE9L67czJHK7ZbYlVRX-by5WY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUrS33s1ZiRFN8zbKwdu7rZg09GRyBGPqFIUQBTQOr4Q&oe=6AC7991E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5QuTFWkRAEQ7kNvwE_cfwx&_nc_oc=AdpTJ1KT97B-fWUc1yx-jn9NK16h46AeCKoykRocbTsi02dJ_4JAHCCkOytoxFI4puA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTeH7xtMTTosBuYV4tnCd68EoiRMmMr7f2TDWXFN47Gw&oe=6AC7AA51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF4qTFgzsLsQ7kNvwFEaQar&_nc_oc=AdqCJ02LVKL7G___x0lHNtVlCpanJj8QjiI-ILIlfkEb9rmxT6qEYvO9KVygxb7uZM0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhyiwlmnRlBP7vyx4xIGvzMMmEyzaWBKB5KGXFtqP-1w&oe=6AC7BA5B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcwUTSS4qD8Q7kNvwE72eS7&_nc_oc=AdrO1MYDjhrHsMr0KAGw00Ee2SrqwAJ729atpGhXJDPDjlXVsMKkfSHmXEqlaTd56Fw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPegblHKmasSkXGq79KOVrG5mxcowBiNmfxNtd5_cKAcw&oe=6AC7B05D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnZCPL3zyXsQ7kNvwFiU_8L&_nc_oc=AdrDjEZE9TFGnnnN_6G4mxWWSJKDS3KjUrgfbk7RMj4ghjDiPLrr2ta6i7Q-pdp7kxQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYBqq62yeqRmwXHYagpUrKGjdKocNKCzG5_iLgtgD0LA&oe=6AE35007"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkXOdHdd1rgQ7kNvwHR00Wq&_nc_oc=AdpA1m22U6JQTVma_5OthFD4EL8q6aGgKHxzKXrnBKYfv7hstfPMBW-7FfL0BjCCsAE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKKlJOdTn71TDreLFAhvVBjUDq9IUle5bhzl1rhYjfHQ&oe=6AE3489E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXc15NBs5-0Q7kNvwF6qg7H&_nc_oc=AdpnpmpddvB_7x8NbK9a42bDCDsb2gcV9qGLmRLWjSfhiDgps_uDP3mRieRZYO5pU20&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJnNBAmXgkG7LrGGnUfxqgMMNeX_t7N-gD0jkFma8GUA&oe=6AE359D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgOoLJr90UcQ7kNvwEU1kdc&_nc_oc=Adqou3FQvdn9a3Pdd9IAuQv80-l6bQLzl2GY2ixnr6W1_29H1H8EF9n9EcfjPjBVVZ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvsdr24IgeTIGWqKA06QVLJeNEHXXo0cAzoxf9CcxFrA&oe=6AE369DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr7KcQKMPukQ7kNvwF992Q6&_nc_oc=Adpa0WXFxH9EMwYhhbn1Zlfd-pxJ0cAwMZfHB6fixVToTWFW1B08imBDrkSzUEYEPHQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmOcIdACnOGT78_qo_LkNMSTSbq8VqNmpnKMrgMMLxWQ&oe=6AE35FDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
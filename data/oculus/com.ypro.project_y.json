94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKX9mKJ1_x0Q7kNvwFOlt-V&_nc_oc=AdqFwjm3hr6dR8gms7ZgQab8Exrru9tuAzWoL8IwWX20eJgxFLJHZpfpVigQUSVafDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgTiE2VAwMNEFbC0urLHCYn9Tcpi7K1QYaE5gDYIIbzQ&oe=6AC64F07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCa2K5INyhoQ7kNvwFB8rv9&_nc_oc=AdqwEqH3N1wSGlU5zpKroxHKiC-nHDSuk4VCJH-Us6VzXKmgHyqK8lJW06D4u34LHj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZUEM76asd1crkDPtl5_9ouEQ_B72WZ-36jOYmD9bJUQ&oe=6AC6479E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5QuTFWkRAEQ7kNvwFLu9Dn&_nc_oc=AdpedJBlORn-g2eUOFVFW01iJUbwAXPnObgIxuuOsxFPmA5xzwNpvMvPAYq574t3Y_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2rJzHmIOrempIqbLXihC9u3qeLgs4j1Yl4kBYAtmFDg&oe=6AC658D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbMQsXqkYvgQ7kNvwHNLvsN&_nc_oc=AdqEV3rlafbi6DaDEcRKACA-F3NSqdz35E82mtnCqxJLxs2TvEFCK5jAG7Vfvm5dvIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBczZZVcc57YdUOqEZwiGvnRGy2p4B9epuXKZkaEWe9g&oe=6AC668DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTsgLjKuVoQQ7kNvwEqpjRT&_nc_oc=AdrDDrIpuDvy17LhNxHuNS32Y9hzSvPLgkRGYtFVdE2VEFCsRCFh4dsUm-JBa6mWQ4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDtsg59OmQAFd4T9OsumUzcozrf1slqR3CZHwB7bYLzQ&oe=6AC65EDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
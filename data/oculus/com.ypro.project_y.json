94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Np5wIQEpkRcQ7kNvwE91FK3&_nc_oc=AdrGjkXXFzaIgDMdVF6-pGsyf6PVKStG_KMdAJ_TOgBOpITYwjL7g3y7MFqjhR4suX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQeVUnvz9oKDg1j3M-zStvW8b49bCBrh4cnKg1yKUvTA&oe=6A6F4C07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSlxrbvuIAEQ7kNvwGXesNe&_nc_oc=AdpNdU_mBCFQmLxU764icKdGsL_Es_QakMW7REckVeQs6Dvb7gASGAJ0m85MzGG6ONg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCISZUWFaGQkEhip5bCOK8Y_Bp9uqHaXA7bo-esdOPDpA&oe=6A6F449E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9HhcLU4cxYQ7kNvwGOizs5&_nc_oc=AdpmM20ymqZFRLoKj7chGII7SN7SKXiegoEtkbmr4dA4kk2jllIx6i-UTdrP5Gr5JXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD01iLMWbchsihjPSurrmv1MjKJpPyYVLi7y2y-kaut3A&oe=6A6F55D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiSIdU-Ip4MQ7kNvwEkqMgG&_nc_oc=AdriAtRbRGa0ub2SS-sr-su6LbYAnvsoK-IKXwgBL4K1dajnLnARXv-RzTkqlCmtWJE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFzpRuuEGzGZQXjy6txk6NoZ5-Nof0sXuWe2q_bu-s9w&oe=6A6F2D9B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceV_tJPVkXwQ7kNvwFaUmR7&_nc_oc=AdqsUV4ezr4IDdy0_lO6YHS9T8QUMPLCOsM4oPgNOO5GT4j9X5eRmARkN8ad5UAmjSY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0TDTE2B3KWI-Y1sPE-JPMO99OegYEA1hM2bYvY0FpTA&oe=6A6F5BDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
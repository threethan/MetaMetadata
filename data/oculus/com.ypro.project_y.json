627778378694483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tkrWn4sKpwQ7kNvwFWejmy&_nc_oc=AdolvuA8AREAcc1I8-2MSC9yw1fF40BM1gjtA_vvyCtwJvVH-5WxrJNY5bHGcof5XbU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jGmzTX4bTQm8FEIYEFcmTH2tCOr6pEfUWOnQ0jpS6GA&oe=6A393E87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9cWvd7gRBsQ7kNvwGvum5C&_nc_oc=AdqyPREpihA6AWiW8wlxdDPrk0addunenvZqvBtu01z8nPR-K4K3lwh16_clgSMA-BA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8kUFHl2Z6k_RcCDrly4jIS79ErrSk7GQ688GM4uPK9w&oe=6A39371E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1jJnvcfy1EQ7kNvwFmgi3U&_nc_oc=AdryNpv7202Kp3ihV1TCEHiDaSBdG-TdYf6FP3fn9rA_EoRtMM05YhTZm12QBdjO9mw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xwErkWQrz2gIy5jzuRIxyyiVk5nDaRbeIQQNxRL5JGA&oe=6A394851"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET0TEQgJy7MQ7kNvwFP_9CE&_nc_oc=AdruDabUqefxQs7apUfaIXhg0B8vEkQkyWs44YhwkJkOUVBMQApeXCPM1cohAY8ztRM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8etVUiFq7_a82_wGbV2LUbukovfMPOzM2G1Nj7mlyErQ&oe=6A39585B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMYqPwGZfNsQ7kNvwHYoMkd&_nc_oc=AdoNFpwmC5vfn85v4-99rP0OP2_m1kQJd0G-a3532cQHUG72QzFkxL2qJnemm7OizXA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fP85dqrKNWfBLP_7kGyeHCxCZLaf37XvjTroKAzIdPg&oe=6A394E5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJlRNI6edcEQ7kNvwEwrsL0&_nc_oc=AdrdRw4Bamex8Zd2lc8vKPXk3cEF7iGca6WI9kWSzVggAGveHZWEvuNJJbWDSDPcRqY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv7FoKcPgURd5dvD1OBEKbpQt7CSX8mW4kmrqPX2rNNQ&oe=69CFC687"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=972xUtfFYesQ7kNvwEYd6lt&_nc_oc=AdrBxN_qLV5HoPbRxDaTR4kmUEepz37MOvMLf8gQsOoz5iYnnceVvqTuaBYSWSHbD88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwc8PGbqEi44xTM_j8hQtRB3Y7fi3-FYafg4xsgqR4CZw&oe=69CFBF1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2OIbiFS-goQ7kNvwEIL2LD&_nc_oc=AdozL-QpHSgq8R4AMgu-MDjXRnV-vGjUGra9_C1GzHzHDjvIZs3DkU3cOsPyxlENO9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDMdo_oEE0L10QjBKe3qOQiTxrWEeMbKXIKEfbEWqT_w&oe=69CFD051"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL5gkzq5euoQ7kNvwHJixr3&_nc_oc=AdpjDDeaC4MDRU4DLNJKsXCjiJMTncDUo5vEKxsCaPGsJ3KTh86E7t0ax86LktlcVaw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdDuWLP3vaG7lTdtmnejpwkSjf5Sgt507xw_j7LrKdYQ&oe=69CFA81B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmovULBgeKEQ7kNvwE2W5Km&_nc_oc=Adot1u0ffWn_gAqZBBJ50oG_XKKmzVp85MDIc_7f1bmmXeQaghs_WISDKjZqoHk11JU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxt9bm8n0qIJDS6JnJVcttYPfRJ6qNkHR-2Rbm8tApZUg&oe=69CF9E1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
1Enx0&_nc_oc=Adr7G_28kxcEbmEd5mbDEnDqkQymFbF3dCTntDStmo0MNJGKgF967SqB_OHcFfiVMQc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxY_Z7MVtekcc8p-7spgWDTlGk_0sCS8oQjzPucrC1cOA&oe=69C14607"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCT5N0U2_D8Q7kNvwEeNuva&_nc_oc=AdqmfMjh310Iqflh1ck0wOGNpWUyUreqajFQNc2pghw5FQCNNI1JZApnWkaWNFXB7x4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLYAkbK_qCBiJyrlxBL5lxCJyodDIG2mao7WzwtuTciQ&oe=69C13E9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YvRA9aU-uYQ7kNvwFt0aKr&_nc_oc=AdolTSzXfKv40f5xPLTjU18pucakwwjuJn9NaZAxIW0LlRIsC7LPNChKrPB0Ld4XrY0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkNH5KXG6FEW3gOCKr2HONOwnOD5WLT0IeRrh801_V4g&oe=69C14FD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dDqukiM4XYQ7kNvwHrRwkp&_nc_oc=AdrPQZ2-e8P0qmvwfwDZoRNSg-sP3Tf-JGeVg2DNxnomsiKJWgVbrQIoAHeSLTkQyqw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhHMVyp0L9qFU0yhEQDDKVIIpi6ThdrlhX3qRCNYU79w&oe=69C1279B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX3qxDf1mg0Q7kNvwGp68r9&_nc_oc=Adp_3BO9FlXDiFskxAHYPM0lksRBjx3BWAQV_sKBEy33oihx6o5PcDVJb9t5ywmYTv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxboPr4ishe0vLr969ozKv-vIFuxJCRHT-68kcAEzxwCw&oe=69C11D9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_terms_of_service_url": null, "publisher_name": "Y_Project", "support_website_url": null, "websit
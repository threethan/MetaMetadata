94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PERO8YxvccoQ7kNvwG_PDyt&_nc_oc=AdqTQGmrv1ZudFT7xyFPVjnJPdqLnE4ggGITlbbWdw_T2bQ46Y_5kWI636-KetBKuiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU-xtL_3YSe2afoe5dSr9Gc4v6pRJ6BUYxPVqwg5hLnw&oe=6A7B2987"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhLXrI2tlGIQ7kNvwHDjmsn&_nc_oc=AdoXnU7K0wYdtO2nLfghaILLm5Oj7Ur6nK8STIvdxq2EpBrRzw5sPRjl5s33XKT28J4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfcp0uhZ2LvQxGsiBvnYnvYPL2-P88PBPCRHuA9tH0qA&oe=6A7B221E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyolR5rlm8QQ7kNvwHDRNIW&_nc_oc=Adqfbxdku3zlG0m1jFGNkx_ChJCmexAx85r-t3AUlc8ceIAfBl-Os30J-ZRb3LKS20Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQw7nHElwL3vlNEjrjfy6Lyt-wfqWT220Y4yf-NdVTfw&oe=6A7B3351"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU6AkKMHcUsQ7kNvwHhp7UK&_nc_oc=Adrqj2Icwz_OYRu0KLKEb16uXuHTkZmDo_49Pk-0-pD88hbbw3bTpt_woXYTR__JwPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4zimhXS6Ho2asgc5rldfhNuPcWaEB62DRRSCJOREcXw&oe=6A7B0B1B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfafBqT49FwQ7kNvwFkUpoe&_nc_oc=AdoHZ_wGoQ12YKS28BoQT16LCGWZQ3ommSWhfx07GcUyCCS_j1k_N6H6YYLY3hg23Rg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHP6Mr6pIg89HNGxXg6vdIY-u0LCT93MG6c7hS97JE5A&oe=6A7B395D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rlf6QpJSutgQ7kNvwGeAEYK&_nc_oc=AdqLJMB17TPoT3AFqcv4piR2xd2aRd84cx-pPfIAhN3CLrn1HEzRLH2AF0EFKYHCD6s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABNxK44F-8R48qzKXlRGjZJm7WJIHkEkzgRw2-8Sw1Sw&oe=6A563F87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIph1WjgH1IQ7kNvwHi3f-B&_nc_oc=AdpSOK958xnO4zIoH7HopW-A49LlOe2cx93OOod1rcrNiYCuQVtA138zIL7B53Z3v_E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfGLaRhSFNoscAcGOJSVA48eiasGUcQKIec3fTbvaUGA&oe=6A56381E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lieNLl6qTcQ7kNvwHgAFkb&_nc_oc=Adq1X2-YjR3WIEkJI_QP_OAnR_fBrEuiuf3FN5NpXgo164XiHyOzAfuxXYeyEOJSeBg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNJY8TRpwkFSd_bAuuENohJslaSL8KidogX-vyLQGZTg&oe=6A564951"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im4oeWPM1qUQ7kNvwGrbCwk&_nc_oc=Adrtl4kGU7XfOkLmgPry-9BjmwgWICtCm4DNqNruPqaAg5UORvSJgBT-ZCn0r7uklPc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgatRUi9d_9SBGIFFP0CEy798gshPiw5gftGKxD0nyWg&oe=6A56595B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoqPiLS1OrUQ7kNvwERi8iY&_nc_oc=Adpe7HwMkOdNc4a4ORD85hCrZ0xOQzBQrHBrC3X1VS4dfe9eRKBw6ccbo2LALOZ-0jo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEIMuXHEL1HIBV1hZiBNWRu-HlUjetza1WGic8X_uXrQ&oe=6A564F5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5u6gWzr0ysQ7kNvwGvV6CJ&_nc_oc=Adq3NgzXvFifMmsnzU1v1gSKU3vfbmSO7lSubZn2-arr5sn2NNTOlA1AlaBPLGpTgOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s1i_yJz2eyeeEDAWy2EplToAQj6Zd2dVeSTBzb9CsVg&oe=6A427907"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiWpaTkbwIsQ7kNvwF5tJrO&_nc_oc=AdrEXM3uW0G9OgSAJvk4OBIGaS6G1L_n3NDz7yklqTsRui8tWKeTi4vLBQNkpuM96ME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x17QQh6nNuoTFS3QUHhVWV6VEJpiXdY8Jc2zNVnXihA&oe=6A42719E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MmtHCScEZEQ7kNvwHJazly&_nc_oc=Adq_ZfQcZyiL3I1dee7G6FlI7UzCOLlGRKvQqjT6vLVLHXrB0SQgMun6SRwgG_WNoAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n3TECDDR2f5z98xqD_IOvEa5H7wYIXB-QqjhXDMCmag&oe=6A4282D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axrDwsPD2qoQ7kNvwHTYMlN&_nc_oc=AdpV5poiboUsRA4Z-WZYx5w_7JkxHMZvBEfkBqkFavjWTNR0ryK74XOCNTvtgA6Q4eU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N7veMYRpeQL_U8rTyZhJ1X6bmB3heB4292dDmXYrtyA&oe=6A4292DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEXCVWScOG0Q7kNvwFTlo1h&_nc_oc=AdqJhfulwvHMLzblAd0miKliYxEVsorJu6wjIEHGGFBgfXm2MfnOzj0qkEtQBL4LnqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sy_jcP1TwbpmGuiY7nwmA2ZacpgQeZD_SfWiv4h3kbQ&oe=6A4288DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9RmLCmiFMQ7kNvwHAJUHj&_nc_oc=Adr5Lm8pgnsKGz6pgpv5iAIOLJ9kTJyz_Sh3BbeeM2hq4ulbdlShJmYBBUR0GYFMoiU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jCReD0BqpJ42zvmsXa47e2NUVsGc2Z6r7WqEm9ir_PQ&oe=69E78187"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iha54vQZph8Q7kNvwGd9zl0&_nc_oc=AdphWLawseBXkSGaTDzojOi5QpPqgNIcRskuDwSxIeEEh1mddoK50mdA5AF3r0BdCSY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VbBx7xJlFILub_8Z1TRWz_BPB8WarUFjuPuz6FQa6TQ&oe=69E77A1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxWbJEiy62YQ7kNvwFQKyZH&_nc_oc=AdqlDJEl32s5tbCa87OoYQw4IByTDe456pw1ay47Ll8zaMTbs61s-nmverR7CulCOts&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sXx0HrvpH2OWHlcs_eSX9zan-oRD2_gltG681FcRzFA&oe=69E78B51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72w-BpwCRE0Q7kNvwHpyIyW&_nc_oc=Adre85IpA-Jp6-vu7uWrP6IFo4Qd-FOMx1VCx3F_V-aPFsSWeu7RNudHGxfi5-ROxxw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uTSjZM2mwZWF8kPCzRfyUN2bsO1FMppHuNocdCbxSJw&oe=69E7631B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqu_dIe6nX4Q7kNvwEHzOW-&_nc_oc=Adq70ksMHUIHycRK6hpM30cwrtoLCQWWWiXLny0yVkSbX3a-0Qovq0LwPV-_sWXJWIU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-rAU950d0d9Xxpz8yQAkQBVzTHVt_D_w0xlRBySV9Eg&oe=69E7915D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juqu5BwwXXYQ7kNvwFIYVwp&_nc_oc=AdrlB5DRtu5UHmN-vSW4VXWcQlumTnaCN935bZe6TgpvpkDKtyjQeJI5oNcY1RkuRlU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYWOh69u_ZrriLKnFzzKwKXHbAHzY7RU1bRvB2L3YKzA&oe=6AA16507"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyqV1mnvV5EQ7kNvwFaLAMm&_nc_oc=AdoWo7tlU3_UsdnN7Rp70MjZp6xETV_dVBVPFjNh1S-AFjS3msTU_hMZxiTXKBn8hWc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs1g2SnlIJ1Mtyomsslzi5cVW1Z-6E7bFM5juF77ws8A&oe=6AA15D9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcTXCtMcM-EQ7kNvwGj67no&_nc_oc=AdovQihLC0bklmsw9e1CQ0zyIUbsPwvAIums3YwJoc-f8DK4ZnShV11ojg79WsOxNGU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2N0dzDLxWTQl0XTp5zczzforZ7wiAfS70M4KJEDEjLw&oe=6AA16ED1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX53SKX3nDoQ7kNvwF-M1xe&_nc_oc=AdomXT8O5JTT29_J0E2kwdDtVPm-xnIGvQi1NTnqg4WtNaOpIGtvPst5kbK6jQ0RvbI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRzqLZ9PySvv_sf2LoTo4ZIXeeGpKfuP1uw3IVdV1ZcA&oe=6AA17EDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlLFKieoJMcQ7kNvwHQRVnt&_nc_oc=Adqu0CRAYemgm24uqk3ASTq2A7mdYMbBaTGi_3j2hzTXHrs9opAUAFSDtJrbYoM0c1I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWIZ8GTDyKYpHTxo6Ud9TEL81p-5jhhnbNHWRPIaKLIA&oe=6AA174DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
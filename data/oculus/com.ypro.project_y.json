94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Nl5aXJFRsQ7kNvwEeHxZ3&_nc_oc=Adp_2CCvLsR7gZVOtWZ7-20rj6eMpaUVXYwAGg2oqHJc7e-AWBrqYooYDNFJ44NFRm4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwlaipMmU90laGhxxND6gwio1aAAi8GC4LpOV-oDjdmw&oe=6AB67D07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jpTfAg1ehQQ7kNvwH-KjnR&_nc_oc=AdpH7LwKzVUV7YyKaQSH_J_YeLaE5hrKvJLGereZPjAricMjiT6LWaO-b11TWpCi0Lk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVeVrX3Xho3yMeT13GfER9KLDxEqNhVUwukc9SOoWhhA&oe=6AB6759E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpJ-MWDCBloQ7kNvwEvOVDx&_nc_oc=Adpy5gqkwtxOe2XSPjqIJxeqpNpIAdXExR-9P8X-nbxzLDeM847Zm_kPlageHSBmqV0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7zpNhdU9r_UlpO0C0rWdo93Pp8PX5DTcICLKQMhQEzw&oe=6AB686D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zqDCr2WQmAQ7kNvwHa55rm&_nc_oc=AdprfoAah0kmChKIoUQOIZsXVKEyLPE-bve_HLhafaDH-MN9OcKxsUMsKvLadtQIvwE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtZjMKvowYN3T5OeRgl4s0ux91sXxiYTUrH9LbytXD4Q&oe=6AB696DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvMfs0dVrkEQ7kNvwE1obqM&_nc_oc=AdpkDDZptVcjOOCdRwsNRHZEfk-jZ__mTPcm3DJf-r0ohrmzFz46Ws7hpjF_1VFxF3o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW_fhPBp0NSIkXsT2LuZImDh0JGAqfivxgT3WhOvD7yA&oe=6AB68CDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
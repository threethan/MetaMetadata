94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIPvKN1oXMcQ7kNvwENl1Xs&_nc_oc=AdpVqQX2kmv2dbT6RKuiF8zx6qqEsrZVCYwAPuhZBNx2OQgvC5RxXOWQ0ktPu9MvCA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQpqNgROn6EOgdDLTbb7TaTHDCjD7-rDTYIL-WfnTuwQ&oe=6AF32207"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr4RIqWFWAwQ7kNvwEgObXM&_nc_oc=AdqnZoMp3hV5cK_PsryCznlQ0sjwYJcddN0wTVCVaKiYGLffXOSAgrdXEsx1yOApClU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv8HImoQrkZlVwYaktUHDYQWAF23e--x-ngBGduSzmzg&oe=6AF352DE"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE-MoixGN5YQ7kNvwGo_Hi3&_nc_oc=AdoJSqy6LX0brIxcW5l17fLsGyCPThKj4YqO43BMIKA2wgxuOjl4aifwP1UEg7Jzx9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8YTNsHhjpjqFeIIsB7YC7dIGDXcKKwyz4xcID27O7WA&oe=6AF32BD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7WlNYEB6dsQ7kNvwFZXMpX&_nc_oc=Adra4GVca0ByLbKU0iyjFrak42TQdyuWqIy6eN6x9ekBKGLa08Dk3rYVRabO6M4u-6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1PepBWKdLTpaLSPSrrYpBAWUMbiQYio3k00zQzzh-uA&oe=6AF33BDB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrSCwWoPvxAQ7kNvwEzo1-n&_nc_oc=AdoxcO-Q-MFz_0Rx-bQYsyIHkq0vWZ3wHr8JP-V_2G1jdWwus5fTUweEkjrzh9r6Jow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGeYKB9j0UyrXyxPHPAxstpu1OIRymH8Ue8SqGtDmw4A&oe=6AF331DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5mUrQZcf1gQ7kNvwFElH_7&_nc_oc=Adq5un78P0Ifg8w5a9u95xm-1QL7dW2GNLbZoS_st5XxrX_TKDv8Dy8sPKPUwP91Znc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmigOKwxcbAZwH5tApN0ve4vUUnvFpYVIIsbRMT7ZWTw&oe=6ADCB887"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0NCFR8K3esQ7kNvwHuMlCu&_nc_oc=AdpnnKclfrd5amH-0TZ9nXxxxtMDh1KARa0MYLbM6hz-a3S9Q8zl6m_tGUGpQudPJu4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-niBmh9Pi7H5pJpENQRNF1KcWQhqKp4ajapkk51ZceA&oe=6ADCB11E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cytw26NcSs0Q7kNvwHa1LPN&_nc_oc=AdrRmHN9paGYlk1Pc-LNg-1yK8AKylmHqkyjroXK6eutVteZID64z7dBvwtP0rmrMW0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQwUUYhHLa55thBSGAq2lQZXpwgqkJceWukA7FLXwrxw&oe=6ADCC251"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUEjYXfLafkQ7kNvwGW8br-&_nc_oc=Adq-EQuoIU33vI4JS02uiD1GvPbi0NNA51ybGodWqSgCkLD9fp_EXxdpVckb3y59wCc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Rj_-yUJ-q8bqsJGO8YP_tMr4riK9vKfiSWtZrbJNzw&oe=6ADCD25B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMcLDdQcISUQ7kNvwFRuRkU&_nc_oc=AdqiGO4ZIzBdInD8yZiCS0fOaDbKljduGFTY7by8s8cAp_7Xq3bUmFdiu4cDg_kTJoE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODYRw9pDBfuB3kObxEMnX4wVE1BkfZrhvPArtTt7SQ3A&oe=6ADCC85D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
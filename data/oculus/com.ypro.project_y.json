94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMzSCdM7eyUQ7kNvwFoC1Tr&_nc_oc=AdpGLjUuesDyAYOQGqDHErtMG3YadFJ79RaY2W80OsGrjOu8UdPWURN0iu15lgu5qVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc1nmSxhV84Fbmfo6QDcbJoD9aKOgKibEzj-Xb5PZpww&oe=6AF71687"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atW0ztnYJ4sQ7kNvwHx6JYi&_nc_oc=AdpuadGpoFODYu929SNu8ydWXEXXKqT4sfxB004YRryLges1XkNJV4x54AH1KNTpOVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOq6Nbp7Sa0Qjt4rjFDF8qFy7_vTjR4-7bTa7tRZulvg&oe=6AF7475E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTW43rU9ki8Q7kNvwFygGie&_nc_oc=AdoTQ-V0_lkmKkhEjdw5GiDFjQIIUSBe3xpTwirKX1pLNhxOcXpFLPnoGogbMKw_kug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToVFAtbMCd4tQPxb5kwhGNhDTNjlmB9gWF3K1vVnA-Sw&oe=6AF72051"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PooyFEs3Ad0Q7kNvwE_-tla&_nc_oc=AdrfPZf0qMG_r2uQxVokTg-JPhz2BXRAOaZt0WggfIGJX7FUy-3X1QgPs09xbiJKqy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTv6f9eYWE2fIWJBFjQfjneuyT6god8AU03tGhGHcu2g&oe=6AF7305B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiRoQBJR5z0Q7kNvwG55SFm&_nc_oc=AdqyaFz8Idu8zVFzsgsYf1myQ8ArvvNaIGGRu6CvXV24T246t72Z-rpmlRCNo22ln-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9NdVRksRD88Ids4My63dQzfKox4RyCx8qO8a6WkugOg&oe=6AF7265D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
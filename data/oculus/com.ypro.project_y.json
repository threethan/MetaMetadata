94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5u6gWzr0ysQ7kNvwH9hFf2&_nc_oc=Ado59vXGf5MScXuoYO-Wa293wu1BOLMDtECfHLV2PxmZSz8QQHbo8WWNB2mli-VtyFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VVTWSUSV96OcvyWU55fpJJfeMiNn62C9D919BEPPL8w&oe=6A43CA87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiWpaTkbwIsQ7kNvwFgKmRT&_nc_oc=AdqCVR0nFmQcWa6aUGXhAbUjsaqBTsnAS8tLMRlgidGIL-DUSjgLSlPT3Av1vQhL6Ow&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x0wAvv9aNv8IwLRVfjp21_n4grsYA36phCtyX9uCbfw&oe=6A43C31E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s__7PmCUuCMQ7kNvwFy-IzJ&_nc_oc=Adp-ik-5OCr7DUvSh8FJDpkjt0c37sWHXoUnen_G-hE9GmB311uaHH7z_cVmu2uFFEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-c-zC7Rn1QRN4xcKO1PM5Ns1J4RkGf4LpK84T_Pl1-g&oe=6A43D451"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axrDwsPD2qoQ7kNvwEyAfuc&_nc_oc=Ado6kBoT5pZ_PBmThZWpGz7efCujz8XvADiNy8QpKjVSjnsDjSkEgVO1vPh9PtHEeoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O6qAOVsdlQ_Er_3EhvO5J40vmWKuGGrNVLFlqTjuk4A&oe=6A43E45B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEXCVWScOG0Q7kNvwEwODMy&_nc_oc=Ado3LvTS5ypwyeZZif8aD4h-DgYyU69AlnEZN8gzp_SOo-7OaFW-ONZIR4RI-F2IAck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XrCsgBH6_1h3TFokIewAiLOTUhkQLsrK4JbZBBFv-Pg&oe=6A43DA5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
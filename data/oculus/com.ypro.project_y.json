94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A79ZeB3cDjsQ7kNvwG_PnUr&_nc_oc=AdqDGbfXUV8g706AwxAcsMJhCk4WhWigLcXNbIGZy4xHgOjN_bJxB5g8_U6kZfujPKw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IZXTfIPcS5gXKKjAs0ccwI_mklVm1V87n_QWkwvGZug&oe=6A16F787"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyPgrMnYxTEQ7kNvwHcGU0S&_nc_oc=AdoFvc3b8oRj_PowSEHYsMucg2Xn-O_dig361YOhizAtbG3UV4tQBZRDwemUho2xeMI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af774utSmNx_LCC8e_L1xMdS8qDh4YTvOWNu09FYkkC_fg&oe=6A16F01E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sd-_g2rNGQQ7kNvwHEItKL&_nc_oc=AdoMhqD2VnYIwUOTEDmVYEJKVFkxFil1_zt3wjl43xmLxgb1ij1SVUcImbL5Dozb_oA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hQg2TVHx6SDMuvSqu5WV7tIcNN4fexWmRxpYclFpHLw&oe=6A170151"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfM0rF--9F8Q7kNvwF-kaiv&_nc_oc=AdqbfqqN3IyrxIrgQQs-y6xsjDNiR1oqhDwdhzh8exLsFFaa0w11ZIBhgJgVOp-m_1I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tvmrA-JbS28u2y8zt9-92j2wLKB4rkq48iAPAF9WTAg&oe=6A17115B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gHfgv1HJz4Q7kNvwHChkf6&_nc_oc=AdqI_OebnufdXG29jqTUQymSqv2lO922NViT_UTDdKc1W1uhmpvm8urA9Spjlv1fZpA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64vDYNkB4OxJ4efPo4RtHIImjfahfzxSBijUPf85zxRA&oe=6A17075D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckNJVTU9NkEQ7kNvwE6qGMv&_nc_oc=AdoMpUoxmrEwW2ebXpFrgggByfXjDFg1saCdR7tU9JVjjCtQH9zEtQs3WWd5DfWpf8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU_TmHfKpKkGB26-crlhiJPW2QsOSvfCd-bGwn3FmOvA&oe=6A5F7A07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSQD-8Vu2rEQ7kNvwFrzX3C&_nc_oc=AdoIKDn-06ydksSRh3fKHTDyDa9A5-vciXc2HVRZFS6ii5SSjMSDbeNv7Qk5KWQb5Oo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTFwVfhLQsdmsLGwdkFn2HMpYxtyWsfUPaOI-4Twz4ew&oe=6A5F729E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNXWIGaIOWgQ7kNvwFwnqW6&_nc_oc=Adq9Bxv2pcy6w58r4g46eTW3YKDrakTD3CFpW9zwg_DPHPxvC2xVa6WWS4bWHts4EOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOgHkgSd41jQGm-RoIbMZHITxRHmiMmj2oGF9PMt69Ig&oe=6A5F83D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_0-aEF94c8Q7kNvwGASXNY&_nc_oc=AdrW3Y3uapqQsLtSIhLH3t_bcGgO51jDyW4CzpCUzjPrhqo1LUkTUpdKya9aqpdU7UI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHt1sqO0j54XyQO-ByW0qc4sVQ2EvMYyACARKDcWZx2Q&oe=6A5F5B9B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYQvoN7OqbEQ7kNvwGLzOpy&_nc_oc=AdpthvIDSNzFIg_OiB3JoJ1NBRJFVh9h0st5hmIYpWtcFTDZ_LlQDkPQOjaHxxjuvEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoFchsdo_1EigIGptt06xRJYpO4Nti-Stgy0LufOWLTA&oe=6A5F89DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
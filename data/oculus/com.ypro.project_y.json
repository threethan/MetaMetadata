94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JdOy6WkywQQ7kNvwEVZFyS&_nc_oc=Adrep8tp6_-I9uZaHq5qYCCpwSxIbVmAUy195Hf6SMrTbTD5eudmqluJ12uRAOnA90s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQEFimx_CVWQXtYjDfk1yKDrQUiDWCc73guWQeH4jKNQ&oe=6A9ACD87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJDLi_m-wdQQ7kNvwGlQIXw&_nc_oc=AdqITTHi74Son2WnbHNxAruYrBVmWGrxIKqOnW_g7rXo4ONoMbPxxKd_k6AZNGZ9zlo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ8d-WMiLgkLtmMG4-Ve1mJy9C71y7PTmVl68fyqkQHg&oe=6A9AC61E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS4C1oNWkSYQ7kNvwGgfmOB&_nc_oc=AdrTmeKfLK74uz9XHu6t2lisL_a6JOH41TJhm9J5YoekMJTDPcABOYdd-oCZquIO-UA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBSIBxMjE3n6QxsbweD_gBAtHXil_Xm_n1OpU2UwKeqg&oe=6A9AD751"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJVXc4uig1YQ7kNvwES8l5g&_nc_oc=Adph8UK2Z3Fm2OkNKALgcaF35GbF-Q_ku0EFgNVT_uI9mub9_0do40J6ETKEGBbcKvA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9_haDGT74DMVfkp-lR3bjxT9WJwQWTM3VTAe4wjJkog&oe=6A9AE75B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkXLTUyZPpEQ7kNvwGr50u2&_nc_oc=Adq6QK-JgwDDtQUEaAOjNxDWmggnkkMHbk6EomaA3VYLUGgumJhk94wFUcY4FwyzMJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvmzZfNgS2JEtUdxNgyESewo2Y0E4yLVrleyljZ03uaQ&oe=6A9ADD5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
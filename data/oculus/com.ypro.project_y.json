94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWBgkcI4PK4Q7kNvwEqJb1Z&_nc_oc=AdrBDn8X051JK3MGgS8cBg6dZMfZQaUq5mMYUzutW-mDtyUDuuup-y7NXLeKhj9teng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j7YbWG7rRB5xEe0nuhEqJMuRXQOY4yzIf8VqAcfZxTg&oe=69FC9987"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7Ep53jZ4WMQ7kNvwE6-PSU&_nc_oc=AdopUBp1EZLtqA6ncVTz2QFBp76UHINZQ6roqlpwZw8fEFRz8tzoa4meD5fwkQQqskI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bfKD1wZw0UJVIg62gG7cjfx0oB_MOpK4k7HeeR1s-VQ&oe=69FC921E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKvwXMYP9jIQ7kNvwEc8X_T&_nc_oc=AdpCWBj5bBWXUZ7GZWxi-zF-1KdmVjMWuK5QnDrnmn8JPeIleg4Cvg2OFwg3kgW5aJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ybxJEJQzpThzSxsBTYd_3uZ5JL4ROzS1Woj_5cMkHlA&oe=69FCA351"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTROWejjeMkQ7kNvwESaEh2&_nc_oc=Adq62suf6eXBJD-5BR9HyVZ2XSjIM4G7aomnSNcCMfMQZkJ6q820CB23Ola7uO2kchM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oByjwDitSeyQTPgEfmZ37kNa81xGCUkxOi1TaG0cP9g&oe=69FCB35B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FoLIVlScmIQ7kNvwHgbgjN&_nc_oc=AdpUio2m3Whn4IuJn1TauVHtYe4W7EBzwIPTY0MyfudvIX9xpNAV6ytBTAVtUM9M-hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z69e03O3n_dJoPJ82zZLxMoO2J-RHGu45047CIxkpDg&oe=69FCA95D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
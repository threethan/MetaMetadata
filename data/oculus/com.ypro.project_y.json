94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2DpLL45LicQ7kNvwEVOatI&_nc_oc=Adr4Ed5Bl152Xh6f3YIzqhCrH_BCu-iFp9BBhilaPIUDsIvoPfCB3UHpA_mAjzgOp1A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c2IAllk5OE7yeOTxMmN5V95Ob-sBrr7KHxI3OdGbtQQ&oe=69F4B087"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrioBKieYKEQ7kNvwGrKK4C&_nc_oc=AdoM1xqu2RylCR0jSyNtyBQU3v2a9-XhsfkQ4Vue_Eo810yOzr5nVcdCh_MRQ66g9SA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Pf74NTpjAA7ImC5Dozoawdtbfe2aX0gK6aIXNB2sAOw&oe=69F4A91E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv2hGFg8JUYQ7kNvwHzW18B&_nc_oc=Adr9u98kafkk0oR6oq8RStCS4yzPjyNHVkoXjJlwiekOVLBPfKFhPYQL-i1GIEO2Nqk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2szNvZxZ1jhGV-lEvJHu5HRKdySV4qPpw7gVgewT_qHA&oe=69F4BA51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHtBNLl0iAUQ7kNvwHzerNp&_nc_oc=AdpygG4YC2zTv7XOzsBLjZfiuoSiA-MlLX3pfl9o0hzHx2XhpamLNGT_ev3a-rbl260&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ayhM3bnLhJMcGXkUf2nPbCoq3zwbIemqoPet7hhiAZQ&oe=69F4921B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTSfyaKS9wgQ7kNvwEj9qcm&_nc_oc=Adom6alZEmjy7GdQsYvlCVs-8GZzS8PyvLt3lsnHzG3MVnc-wQvH1zf3TwacQK5plVU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vG45VozMAlg9B7X2eDKLpN8nmgbhk6JVagstePytMFA&oe=69F4C05D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
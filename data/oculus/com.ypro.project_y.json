94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-fz0jqeKmIQ7kNvwHEMXJJ&_nc_oc=AdpTtm7uuHf10-sVW0PoNop4PD120SOWx6AF7GiiD_r7twSbSSiSlbP-SWTUQAQaWTA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mg86TW2C6gCzJ1AkRj421SKpjYfqSTsclwrVRTt9wog&oe=6A33F887"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ7NKOcHb0UQ7kNvwFbTsQl&_nc_oc=Adoen5q54psEVYc0w7MK20HRBQW7hWNycnTcx5t6t7YOCyzSTlxmUGaciiFfFpAqsMI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CVc0QVtNEH884SczDGkZUismOWkg6RtfVKGYWjjvFmA&oe=6A33F11E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRYoxi7bLH8Q7kNvwF-XWE9&_nc_oc=Adqmebvs1dLWI5gjDuoFxNY2Ac7JNWe_FhSjG0qe8RdkEKRkj1vgHaHdo03uAnKfbZM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BQ-yWDY-OF159sHNM9QoAVHyf3cVHeYspM94Wb3K1fA&oe=6A340251"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUUe2tg-vxAQ7kNvwGQvP9k&_nc_oc=Adqr7oDxTusJILy8LMEBWgBJv5D9AONCbkkxAqIIiNc89Qt4B3xLLpd79NZk-AmU3Js&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QDM9vTWm9hVsZLQ7mN3ogiWngTvSVCB4VR49ZLwDjuQ&oe=6A34125B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL329SnvW6wQ7kNvwGHpJtZ&_nc_oc=Ado2lYLHbF_bKi6wos4_wsg-QShfOAF7aVQW-AkBSJpy9PucN6hesh6MWjaUGhC2-18&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dTbcu1KAxEODoQsIdDNWRs-a7ArtsTYbMe2pbHQ3UIw&oe=6A34085D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXL0TAL83QoQ7kNvwFy7c1x&_nc_oc=Ado4A4V4dJeGItmY5uIlVsa3pbNbj6uUP2EPW_2LV_GkPzakVhWekIHBhJ_CeVUqId4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnMvdVfkYhz-cJUcQOzWapOS15vNS58H3jZ5U55GBG3w&oe=6A4BB387"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4pUHNAVTNMQ7kNvwHgMRgo&_nc_oc=AdrcLZdlDwmFaFaJQVWJSikHl-1bh0sxMrvIVwlWgORnwaPRRh_eritG3Q_I6t8T6O0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChDkvuCgm8Usnt_POgHsGWsgaJ4wH7XLadN36Vradj6w&oe=6A4BAC1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gveP1zpNLTgQ7kNvwF9ZiOE&_nc_oc=AdqfZ2k9dfWJ1eJJHiV0epzgD9kW7ZcAFmKxu3d2kcKORrW3w2dQY9n46Z5Uuuli4DU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSJc68gLLfPJFvfWYhvz7k7subla1ko04o0hGV_MXi5A&oe=6A4BBD51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85vykMb0Y5gQ7kNvwHaSuNb&_nc_oc=AdqMKCjfFM_RFPpdQb07jrZoc82OTIqEXppprcoJlIPQXu_e67dRaesIW1Kzo4JbCLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnqVQJTvglLOM9Ba4VG9TaHcs0d8uz-FaZoIYivDcE9g&oe=6A4BCD5B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhY_hyA6Aj4Q7kNvwHm9SkS&_nc_oc=Adp6BKEiyTrbS66zCdijhC6l6siLz2pCi_PycrOM3EEZKXmFR38HNl37HAjorbTfBPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRceSIMsh8GHwPlbbAwoUirNR0XwcZj-fPDJ7jxFySyQ&oe=6A4BC35D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
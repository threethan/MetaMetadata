94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_elT6FOovAMQ7kNvwHrtwvI&_nc_oc=AdoFMZFrogsAFA8pRg92TShfFDioVPe_pUVpTlw2xAqxo1U79u1qcZ0VfGoSfQ0HFog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDG5Bq24vZsqS5IB1Lc0UWrjQKVyiJAeEt7fG27u4qng&oe=69CBD207"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oKrveeXoJUQ7kNvwEZW5Ii&_nc_oc=AdoMpSj-4L6hKapMkKWdLHmqv7VnB9GJd28ub9xnwCav-o5dTFNUIgN9vw91PzS9LPQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0fSD0oX4HRYvjrElyiyvwhJEwC7wAYA9BYIZ4Wfgx-Q&oe=69CBCA9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNSODv1Bq5MQ7kNvwEngQe-&_nc_oc=AdroN0k12pAXCDRv0iEhWV7c7dmeKqsrvUCoqaes98VNgcr0AZGmIvFm8o733pBxaTc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRmZuhezk2fKsYqGELLPi8GxXN_Flk85cVwC4-M1jwbA&oe=69CBDBD1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyHS6LuKFI8Q7kNvwHSIdPc&_nc_oc=AdpuBXGQBqu3ggds8AhEXbWO1cnfoQfq-5Ao5dD0gxgJA3sQBnVaAeaiUkKRgWg9C1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfZ9Iwtqwq1rnGjtqcuSXp8YJlEz0IAHslj1IYEmZquQ&oe=69CBB39B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3rtLDVj6BAQ7kNvwEmF5r1&_nc_oc=AdpWQRqkupg1mtNkhRudDmE0Y9zraSj43ASiobpkxKNGOje3OhLs92I1I5cq12129hU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxqBIVndXSOk8PEv16rMfINwiQkrno_mGpR7-WNPD1jA&oe=69CBA99D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
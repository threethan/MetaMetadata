94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJYx6rWnw60Q7kNvwGErx8x&_nc_oc=Ado6H25nPMPkNivIJ35KoYO3R1oeJTzDfLgqMbjTqOlu5gawQmFplAuuyaDOe5CYFrw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FId8IVvvqk3d4Si0UzKoyEfrfyxeOUqsiqwqeEVVDvQ&oe=69EF6A87"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvQ6h47iTGYQ7kNvwECU508&_nc_oc=Adrn0SvRhIGOmP45FQb5dG7txWovIuBs1YGT2rKmEm1YMt2pSiflXP5N9pEJx97c9x4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VEkDfRKPDRowT26mey82WX1naLSQhCHX3vW4izG99ww&oe=69EF631E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwWXH1ZPkWEQ7kNvwEO94GO&_nc_oc=Ado0S_Ui_psGltpaVtfM_2BJCjlzPFDBZo9E4Q-JZHjczRCytERQFQQ0MnbiMz62O8w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0l2KSPiu9aq9oasWiG-ZglEKKAZ76kuiULKsJq_5gaRA&oe=69EF7451"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9RwaV54EQ8Q7kNvwHoW0od&_nc_oc=Adpr9tosc8MA3z360fgw9o2wma_ahSOaXZFkw6muoFRHiIL-1flY0MFrChtKg1NqMCU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wcZ_jtSmlKThX078TXado43dQVu6DCTxBFMlwFnPBgQ&oe=69EF845B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPP_gdeRxBAQ7kNvwFEKup6&_nc_oc=AdqGoTPsmx4mPwIku7jD9ReP4JD1av7_N6INg-gXp2dSwZpFM8yzrQdYbPz91Ul7D3A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MRLvLAzeCgz8TZCoZYe_xwOtLhTPdI3HaS0FYRU788w&oe=69EF7A5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
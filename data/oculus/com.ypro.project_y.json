94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MHvOpsx5LIQ7kNvwGnRV2f&_nc_oc=AdrX4VaGL4n30YTffT__Nwh1kbkaZ9GCjOfVmMIfgQoqvchQ5M0kJNqW8ufvRlpB1CI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5yb4cVU-OMjCNMc9G-for5uErP7vXrbHdNUigyoPRqA&oe=6A4FA807"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htdeOeLIBosQ7kNvwEGfDqA&_nc_oc=Adq4qdiHADTUI7ztvhv2zA5YdTMjK00KimEGXenRKzIC9aWXZLFJvTysuFTEw3DJ-YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsoRuZzQlUqDr_LJx6XuOd7fRpBWYlNQ09aaPUD3r20w&oe=6A4FA09E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTqshlx50BkQ7kNvwGrQRYu&_nc_oc=Adr3T73w92YSp7YPAuNG1HwILmlVNKJGV6_yNoEqHkiWQTEN7HrGY9VEt7Pe_bYosL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHkC-8N6gX3fteHQrrbTFsyBqKmx7cPWTGzpquT-cBIg&oe=6A4FB1D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2V8gbSKf3QQ7kNvwEykNiT&_nc_oc=AdqazH6TheO6Q4kE1nT3F-k9KcubNJ9JS4GOCG_c0vpcdxBybcKvMDUqxGAfi82imwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoWdWzj9GZqGYVfvJyCyeCQ9xs8emtGbA4Xz-u0Jgpow&oe=6A4FC1DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcrjywWc9SoQ7kNvwFTDcRI&_nc_oc=AdoQkWlMUObI0hLM-cn6K6vK6PwrNAQGZPNUTBer2RCLueCXLQLZpoJ0vZCPohBb5bE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg8SYnTQ7fD0HI2XuPhGPMb6kwonY2FRpKj8yFmkNCug&oe=6A4FB7DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
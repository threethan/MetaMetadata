94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY9QDTBay9EQ7kNvwFA0Gwt&_nc_oc=AdpZXs88w_QgGmIWst5CYz9Pbt4zCOcF2tCQ5VsjX7XfeSgmRIedQTk05Nc2Xra0FH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExlsUoC3AVEHrWbAUmN4hafy5YJaPubepcdg5ibxZTug&oe=6A75E387"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgJo3_NHMzkQ7kNvwEOggjS&_nc_oc=AdqbTG83kcPf-NqHaNMpSDqRUVwtL_rsM6T81fN98AXmxjuJLHn78qchBOlqPPWMPQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlKk7M6ycuF8LGzzku4NCm6mJCb3A9J6F7hMLB9p1Kng&oe=6A75DC1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewoWFhwLE8kQ7kNvwEkM4_e&_nc_oc=AdqJTLEwDtbE3P4k_b2yIJmMpYJVRhBzjgK6z5rnHVfAoxxUr2ou_7cSKQ9HQHnCksU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEabIpqzroUMlKJSzvyRWidARtmC9ztAl7-RE1E838zEw&oe=6A75ED51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX_Qzd4ndGUQ7kNvwFeMSVP&_nc_oc=Ado2kzCoZ3rhJejnaqJkqVz9-WyJuEr6wBrd6bnuomDQjMaDT_F4CI44kNHc-Qaneqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhR5kpv6Eh3PF8bAseeHcyvrs-NfhXg3uGevY7YAe2Yw&oe=6A75C51B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6o-YUFsA7gQ7kNvwGtiBgB&_nc_oc=AdrTqz-pES0NX5IJz2qGWA0ehaRqMGtIt0PklwTxi_NdqynPN7NyG7gvf1fwjZPKEQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELTwBD0RGxSatAaj3nOf1rFq569djD8k1OFPlaqzVnBA&oe=6A75F35D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JdOy6WkywQQ7kNvwGZbZqv&_nc_oc=AdqbpIo6K5KcIyC89vYZAY82V6LDNyxI05Ko_HzoGWZnouT9zSuW1x0MsANz4vwB-QE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtCnfG2Fyg6cpSLLR-TGPAXy0nv4IkGn4m6vWZrxl2yw&oe=6A9C1F07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJDLi_m-wdQQ7kNvwGxheHX&_nc_oc=AdqfQWKucDjhkfWF7VRkM02qBCyaNrct03OUvuhdrnJSH8BqxY0mAe-C0blJSXQxwNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNWVYJFXA65xGXJKN_TEEnAjV4sISfNt7wU-KjB5wxfA&oe=6A9C179E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS4C1oNWkSYQ7kNvwH60Jf7&_nc_oc=AdrnGcrK0NU58X8HFx-CVU8G2FOHDfcedf3mH-S9Kwu1au3b_RUnC9aD6PqI_SQoWbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAPUZLHo7twTntL1udA63HFjMEa1Yn6_zdnPKzd4TzGA&oe=6A9C28D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSlMRPt3sh4Q7kNvwF7fpFo&_nc_oc=AdpytV-qkelsbPA7Ho9atSwny1FGcUHb3aza0_ipJHUYmRctj03PsTAq89vF2D_YjGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJepSStJx6mpEK0OQ7JbEdPG0bJAzBSgPne6S9G5kgLdQ&oe=6A9C38DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YH3RfrBt5oQ7kNvwE8J7Ud&_nc_oc=AdqkSx2q3yz1jxzw6-KhLVtmgp500yruPeo5SGD8WWX8In3PtLT0lGgbb88F4oib-ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUNubLOYMBTCQoIAJoPydnywH_y6aeRjSmBYAJsZcLWA&oe=6A9C2EDD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3p8zRyEe4YQ7kNvwEqzJOH&_nc_oc=AdpKV3KkQkhY4bPoJ_iYikBR5tne1HGYKRlRo0Hsll4675fCNSo5Yh49ZksfenHSIB8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7x13KWxMPbpxVTG7HGXd5eje9HU2gbXsQ6r_3yyr6lQ&oe=6A93FDC7"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtQCsnHIOtAQ7kNvwFGAqKN&_nc_oc=AdqtSMV_Uge-g2MmUvgmLyoqtnrWIc6UI6xtDYb6qSAb4i7ZjCcNo3kXSoOzzb0pqtc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjgvLSBmRU30kKHDI3IBc1HBZJAxULSaRYGleXnNKmvQ&oe=6A942E9E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mklFqqQvz8MQ7kNvwHRJB-4&_nc_oc=AdoRd-HG5wyxMjGunAnXcr1_WvrgrmVsow0hYUjdRvQHGSoSzKxzKMDja4ygl7unLA8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-69c5_8IQPQptRULe3EDOCb8mydWG7q9hY3TtXXdb3A&oe=6A940791"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhsyKfMD3-IQ7kNvwFDn7FM&_nc_oc=AdpsrfdzYMIJeEyU9BgDkELV7TVZTM9HzqgFHTeDLQUH1aN7ck87davDT2OMlnAsoN8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPIXFVD3jsfqD7nSdZJ24BERMMHJ7z1bYyqKpzi8CVOw&oe=6A94179B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AybYcLxOE4Q7kNvwFhtOr_&_nc_oc=AdrzCD2Ee3EHlkTgbEzDPKMDfNYd83fGV66bty0vk5VPgc0eXKfD7notxs60Q5rAXoo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf9NH9pzkyvlRwZNQO3A7OJqMJ8DEPYlkOlGfRlkjcWw&oe=6A940D9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
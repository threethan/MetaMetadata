94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Haos4IQTAgQ7kNvwGNsbhn&_nc_oc=Adp3SELIh6zIrFCH_iBbt2ysZ_0nyiZwuSo1jzskLqS88_don_6jm5wtYHJxwVMqFDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGaH1cyyCymqOfcb_tufQWGDpUUHc6X1xeYZq_WyinoQ&oe=6A6CA907"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSlxrbvuIAEQ7kNvwE_p675&_nc_oc=AdqWQxAyZNCsokTVVZxsgJzsCvapebTbCG2O6qu3Qw-fCsmtLWblZvxdpIUhyTjXkN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmqWb6hmLWofHahaC21MLpRrEegsCHnBNiquD52Ba6cg&oe=6A6CA19E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L2AOKfalt0Q7kNvwGg_QMJ&_nc_oc=AdrQl-rPGHfMa6JqT1-JtxhFnwW1V8rZ16d6evZcIsC1HQidWtfMiwHep6UWM9fk6zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9dkTAcvQPXpENlXB1kFdroibDqGBwBfbPx7O4psvdRQ&oe=6A6CB2D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiSIdU-Ip4MQ7kNvwEUUXtw&_nc_oc=Adr1ROSiHyiXA1mKK5KMHDg96KJVDpBT-78s6rLZeapvlH7FdQDWeUBkNq41679ACuQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHU1qxXzB4SIe882AkuzLp7rL9fcZn5wy-HtvtRHPxAA&oe=6A6C8A9B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceV_tJPVkXwQ7kNvwFzIz7g&_nc_oc=AdokglEIe2bc_Iu2WJiuhvEApEx3KyZ0TjLD6cU42gYkzQBdRIkOj9laIvZhHDiPYSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDa5US_7fBsHDxzbN0JIsjVYXUvzOdlh-hJ7x1_g05lg&oe=6A6CB8DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
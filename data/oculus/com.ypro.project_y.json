94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juqu5BwwXXYQ7kNvwFPwhNe&_nc_oc=AdpCUUPJLWNEuFm_9KTneZVfe0VKShczhiGyd-80HRCGEd5s6TntvZqmpxzl4mFs12Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKum4EP1yTClwqqpFHFtry1mRqXpVD1IoSDJRUZow1XJg&oe=6AA2B687"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyqV1mnvV5EQ7kNvwEyDS-s&_nc_oc=AdocAgO3_8RawLqJSHMqkwAKJVNrBTDGWftmxHVSGBpEFZ1RGHxo05bBYkvLPYnYWYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL32Vi1Mj7Tq3XfjeGMavZ20UKJqga_5ot_Ci-6m9hUYg&oe=6AA2AF1E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL8E9tgT1S0Q7kNvwFjryVV&_nc_oc=Adp7Zq_EAGcCjgrG6SNT1cIKBIAUlxPCMsiL2bmJ04SsxP1iHM66GWMwaTKmRJan-MQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLegzLra2CUvf8oJiHBY1nx0Yt_k4IhAa0pbZR0iRdBhA&oe=6AA2C051"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hX53SKX3nDoQ7kNvwEax4na&_nc_oc=Adqu28HEWW8OlzRsEIz8w7A1oTwMrGA2zIZC_l02kRK4d8U2sy3hONeIW1xUlJklQgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvR5_NLOaTpJH-0lm6N9_Z0qjt1e6VZoC7h4McKGoyXQ&oe=6AA2D05B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlLFKieoJMcQ7kNvwF6vabt&_nc_oc=AdrI7pA9WlyOOkWuKsCinghGg3UZp3LZVNZyGZXJiJKcjJjBkGLKnizHylUb3Iagtmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRCcLZy9PLtn_uo1wzGzgaSh8l2NetFxE81QNLEpQrNw&oe=6AA2C65D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
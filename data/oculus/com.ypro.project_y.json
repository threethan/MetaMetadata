94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIPvKN1oXMcQ7kNvwEzOAl3&_nc_oc=Adq8VVLJrJtiDldtpQu1y72yARJ2Fk_fSQIihW4I36rgvss0_LovA7SH8C_2ufL_xZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm-L00Kwm0LThLvUnmIQf0St_LiZJgAMMZI5osxhhS1w&oe=6AF208C7"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr4RIqWFWAwQ7kNvwFWPo_G&_nc_oc=AdoBNCV0MMeaCAJr1o_JfXZEcqNquX_IqaAdGVW_e9DrRXoK5iYfu3dB-8xkkG_4U8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMPvNgsn8-zigEg2iG0KIX04Af4xF7pB5h90UvWeA2YQ&oe=6AF2015E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE-MoixGN5YQ7kNvwHW4Udn&_nc_oc=AdrA7Qfj7LS3eoX9YZNhyCyjX32xXGGV2sl472RcqCaF3LFwXVTeibxHs7dJgdk0KvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqwPS1VudgAe_Pzt3O4r-Xy9cW6RO1byKV37_m5ytCkA&oe=6AF1DA51"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4FvWYVvgm0Q7kNvwEM9MGG&_nc_oc=AdphGDvD1WZnwT39Y2rCTWwlL0r0FNkjjBAR1HbmYkSiFsL8tTRCopcG-50FAhaLyD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfVfG6-nPsvmt3Vb7Pnkz7Lye3U7_xuVJrmtR9Nyx8AA&oe=6AF1EA5B"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj8KISpErlIQ7kNvwG-n71F&_nc_oc=Adryb0Xti2c8867Gfs7ut2ZJjpJcQku_bkhhiN5hVxQnXGJLIECEGfPe66RL8YygG0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwnDi5HaMZVifWDu7gyDJqQiuhWLgw1dys0hF27k85-g&oe=6AF1E05D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
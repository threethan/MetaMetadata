94483315_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Zg_olDLqn0Q7kNvwHjolCO&_nc_oc=AdqUPm4-4sx02x2Vkun1HoSWF2QLgNMLD03TLc7_NKVGrMS94igMdj70t_3svKCkOQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6AmVZUw3lshieFA0Lg9bKUvj4nGr01bllEK6hDJPEcw&oe=6A524B07"}, {"file_name": "com.ypro.project_y-20240209-214331.png", "id": "768312218730772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_768312222064105_2483983745682146754_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVb5s4aIKhQQ7kNvwF9byF-&_nc_oc=AdrZPl7Wfvr8w64jvoHFrRG58bZ5DBKAbC5NjD5yNAsFEe8RgvN5SVKGeestnIyU-pQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo8x-WCaBJMfDCtzGPe1Xi7-7fH6EdgTYwHQopRgjd1Q&oe=6A52439E"}, {"file_name": "com.ypro.project_y-20240210-1504414_2.png", "id": "1144388200046417", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003227_1144388210046416_8982093088097178928_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTqshlx50BkQ7kNvwFcAlYj&_nc_oc=AdrWj4oBRb8ZWTnrrSCGJTtcU9x1gf52oxBskXL78TSR7BXpbuC_rLEaY6Yb41c8XeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZQgfVHGzh2LIZj_jtzwxfl06jNjtj5lPlUgv1W1rDtg&oe=6A5254D1"}, {"file_name": "com.ypro.project_y-20240210-115437.png", "id": "1405118490144295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230048_1405118493477628_4689660376237645316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G2-kiThWooQ7kNvwHEHwfU&_nc_oc=Ado8x4hsVf_nQ5MdloGeZ6rt8PW4RK2omSMOjSCgL_C73nfcP7hzUZr2_Nv1EmJp5hs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtRbb5stfZEDFfSSEKo0ceemG6UrU1lHnaMxXciXwT_w&oe=6A5264DB"}, {"file_name": "com.ypro.project_y-20240209-2137122.png", "id": "7621650634553270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556799_7621650644553269_1655627145384024300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWnCWXCHbbgQ7kNvwHX6agh&_nc_oc=Ado1gtC_HZv8sTlPX2-t_X9IYDqtY4Hn6a49_lR2xrCO2xr49oVgtQONOE4OAfct1j8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvc8x8_ZEorev65wY4OGoFnhdbMbjdbehC7czXihV_0A&oe=6A525ADD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project_Y: Working Title", "keywords": ["horror", "Project", "Story", "Game", "film"], "long_description": "This game can be played in English or Japanese.\nAudio is in Japanese, and the interface text and subtitles are available in English and Japanese.\n\n\n\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n\n\n\u2014 Video noise signals that the malevolence is nearby. \u2014\n\nIf you watch these videos even a single time, you must look for all the sources of malevolence contained within.\nThat\u2019s the only way to escape the curse.\n\nAnd when you do find them all,\n\u201csomething\u201d will happen...\n", "short_description": "\u2014 The terror comes for those who watch. \u2014 \n\nThis is a true ghost story as told by a person known only as \u201cY\u201d.\nIt centers on a series of interviews conducted to discover the truth about a \u201clisten-at-your-own-risk urban legend.\u201d\nIt is said that anyone who hears the legend will be cursed.\nAnd a \u201cmalevolent presence\u201d seems to lurk within those interviews...\n\nThis project reconstructs the interviews as 360\u00b0 videos, and presents them as interactive content using live-action VR.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-y-2023/#h.16e2qbqtwnwb", "developer_
cdn.com&_nc_ss=7f20f&oh=00_AQFy87H1sVRhaNmwyr99mzuFZZzyEtwPDmeW6SOhuaW_vw&oe=6A85A84C"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "584195774663478", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391890_584195777996811_2033612844554597697_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZQmcywRuy4Q7kNvwF7KxYi&_nc_oc=AdqmIXM5F-stjZPQOyNe1HbZPSl2clSnVij-V-o2Drxi0JUchuBl9QAYPkWngLeGS_0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCKsrSTRlQOPc3TBH9upPGsI61OOAiBOiAzBcSTAM0og&oe=6A85A7FD"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ3mq0AfQMoQ7kNvwFTR8oE&_nc_oc=AdpuVrr0GFZMtY40iVdRwyV3n0HjdcwJaEg956zjYkuGNecpnLqo1xPE7-dexKH53t0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNCJUb-xC11SNBxll3P2QrcnmfhEFwr220ocamL8F1jg&oe=6A859B9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"
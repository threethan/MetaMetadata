com&_nc_ss=7f20f&oh=00_AQLza1sVTmQHKqcfh3jFCt1eJgoXW5kxYHEw_SkQTXG-pA&oe=6AA940CC"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "584195774663478", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391890_584195777996811_2033612844554597697_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzgpkYwi9KsQ7kNvwFXWC5S&_nc_oc=AdqnjpainQQ_-ux1p4tb8JEP-04GHMMz-CKSW3-ProXe5ng2TDkhyjG6nuJJdFTxX30&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_8qrnE_3y3uD1fDezw4ffoDK16nKAkf-8YTmxqqPUew&oe=6AA9407D"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvr2vr5IH9AQ7kNvwGNK3I0&_nc_oc=AdoU1Rdxt-wXH-3_RqXvGFTWGlz--qRx_51V_my9kVXU4fBISqccFNsJpNFA6nzwR7I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHyE8ahDN1U1x1BqL8bVQHrAAZKrty7FV0ga3nkqUK5A&oe=6AA9341C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "de
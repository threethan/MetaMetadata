_sid=6e7a0a&_nc_ohc=GVS1dr73k4QQ7kNvwGPcWUY&_nc_oc=AdkgZUNJOwKvp7y-O2544SAJT89xp74OyBPfN2wqcQLzH9MiI1iQOKSRB-SI4b3Kilo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvmsuw2hpA0RAWpEdK--_JyAFSC-i3v9o0F_zVFab2RgA&oe=699D9FFD"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCU5oREDhQMQ7kNvwGJOVq3&_nc_oc=AdmOySdGAoFDNvUNZVfJA30U-adjQ1psR1Q1jHBQoacYcz-WrUmalN69UXwBY87V65E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstmY1aSaWIxk79dP9F2ODtzCiGJBMZ8_uZ1nzjE2x9kg&oe=699D939C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-taggeringg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-taggeringg/websites", "category": null, "comfort_rating": "COMF
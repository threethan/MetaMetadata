0_1573740710009977_1669577520261884236_n.png", "id": "584195774663478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391890_584195777996811_2033612844554597697_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-YgsDW_w0QQ7kNvwFKUEey&_nc_oc=AdltvDXMPUUJC9QM1L2fpDr2wuP61GwwY2OI9BiDTZnZQltGfjL2N6goPwnBE5od7l8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0M043HQaGH4GvHkkp6Z5v4NTswbXjWAcUTAqog-Zp0Q&oe=69BFE6FD"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1gDrJreuwUQ7kNvwGGTt0I&_nc_oc=Adncc35_zgXMwJHxJelsi5CCmf2w0LVn_0yGJ0I7hv9CLZm-DMk5cah2r78_HtkBwls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMN8Bsvi7jRQp936xy9C417H0jrO5JerX-Axtnl10Shg&oe=69BFDA9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-taggeringg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-taggeringg/websites", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "29548441211407824"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30462192743365995", "version": "0.03"}, "id": "9659140680798548", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29548441188074493", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30462192743365995"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "9659140680798548"}]}, "change_log": null, "created_date": 1749090207, "id": "30462192743365995", "version": "0.03", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, 
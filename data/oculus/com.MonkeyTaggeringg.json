_sid=6e7a0a&_nc_ohc=CPK4kQzySlwQ7kNvwGGOcuc&_nc_oc=AdlZZplBDVhxQ1dzt3kfX0uTzQUMgTHN-CXFzX6tzFnItaTB_D0Ew50K1SUsl7R4Bdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvJ-llFAEh0ThC2dPLV1a23oA4CzbXM25nRNUQefXbuBA&oe=69A4377D"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMW8yZX6gMkQ7kNvwFuTdja&_nc_oc=AdmjCJu6q1YwO8hx8QfFwiQVf_D4EpvG56QtrcMWdTVjDKlv3Nq7VpNZUZeqx9NoXr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsuOBt2RFSM_qdwdcUYb2JnIvZMKwE7eQMB1ubF2Rom0w&oe=69A42B1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-taggeringg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-taggeringg/websites", "category": null, "comfort_rating": "COMF
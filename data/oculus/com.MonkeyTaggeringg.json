&oh=00_Af3mEP59MvKoXToMAbqGR_2AOZOZCa87aAZlhfhz1XOcdA&oe=69EA174C"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "584195774663478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391890_584195777996811_2033612844554597697_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxGFRiIKKHMQ7kNvwGmFzbM&_nc_oc=AdoL263bppZoPJ5NhPZnwHI_SRZFDMfP3cOzc0mVFH98By70fJtdGRcQpNahJCKOCMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32-0s2u7Ie5cI-QWdUuETvpXMy2su-btu49Ab_jq1j-w&oe=69EA16FD"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvEHfqO31NAQ7kNvwF8iFHT&_nc_oc=AdpSqrdWLSYS7g5kG51qEHjqEzSg6dTbU8FkJzLKz_T1e75TFvblLx_I4dWaXE5w2S4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LLPT2gfIbywkXMh0B5ssitmHPSuGVLGA7Y4lLXoxqFg&oe=69EA0A9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "
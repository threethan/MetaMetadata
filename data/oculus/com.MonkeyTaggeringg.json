_sid=6e7a0a&_nc_ohc=E209Z0Ll6EIQ7kNvwHGU_Ek&_nc_oc=AdmdXlvWNbBYr38qL21xK2vQN2oiLmHsLA7mPlDbTnQAck_q7axOU5J4u-74RvFisQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRMY3aV251oRPcmMsDruEv3CmbahIEEZNVDQp7hFTtEA&oe=69A2E5FD"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMW8yZX6gMkQ7kNvwE3ch7H&_nc_oc=AdnuyGjz6z3x8-xsJNCqQUPZ2CrXYr5ST_t87QgwC3sMz-0qyrtQoSf-nBQMa4kUQSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2ARG_PRUFnWHQPXBUvXMXBxuPw_5J4VyclE93iEJxmQ&oe=69A2D99C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-taggeringg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-taggeringg/websites", "category": null, "comfort_rating": "COMF
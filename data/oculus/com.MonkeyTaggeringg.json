_sid=6e7a0a&_nc_ohc=yG3luWkr6C0Q7kNvwGoCuf4&_nc_oc=AdrEKwaFXbpc_kxyOeMWI1NjSpFImPmet2UYEy4m0eZ1V7oAaBwgQE1-sYLMziKFI8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af00HtKyE8dsjvyguoS6DzmEn_Ce8AZYxNzF-donVYFZpw&oe=69F0AE7D"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9qJrxHbxw4Q7kNvwGOA4yR&_nc_oc=AdoUAIxed2SA-KMaAT_-D8r5CZZB23lEbPH7Ztcbn1eUimj7BtdHokTpBuZQK0OMiLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2akM-t5ZvQ-GKFnAEtiS05VrPeRum6HKPH9u0SWajOGw&oe=69F0A21C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-taggeringg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-taggeringg/websites", "category": null, "comfort_rating": "COMF
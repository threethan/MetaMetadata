_sid=6e7a0a&_nc_ohc=u-JWCYzx_I8Q7kNvwF9TcLJ&_nc_oc=AdmTEREIvXZzjkJ9zyPpAeUchzKRYxeuE1gB4r32gW5nnDsfwsiY10ZD7trgoMrrAEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft34Y8oZIuVgUuxAkhZ_DqMgLst6B2b94M2lGhZOnDzRQ&oe=6999AB7D"}, {"file_name": "473393450_1573740710009977_1669577520261884236_n.png", "id": "1697445814195303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1697445817528636_4262402563259808102_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhcX5zUb9rgQ7kNvwFc4wfR&_nc_oc=Adn6tKZ1-j8nSXkWI2YEdLVuymOLqZT9m34-8ual6qe0FQxgcJuZH0aKHSJddhTKQEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssGcei6tewOwnmep1MyqIADdjy0zO3XzVRkR7xbg1SHQ&oe=69999F1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Taggeringg", "keywords": [], "long_description": "Monkey Taggeringg is an adrenaline-fueled VR game inspired by the beloved mechanics of Gorilla Tag, where you leap into a dynamic world to play as a nimble, gorilla-like avatar. Using only your arms to move, you'll push, pull, swing, and climb through intricate, obstacle-filled environments, immersing yourself fully in a thrilling game of tag. Every movement counts as you chase, dodge, and strategize to outsmart opponents in exhilarating rounds that test your agility, reaction time, and planning.", "short_description": "Monkey Taggeringg is a high-energy VR game where players become agile, gorilla-like avatars, using arm movements to swing, climb, and leap through immersive environments. Dodge, chase, and outmaneuver others in intense rounds of tag, honing your skills to become the ultimate GAME NAME champion!"}]}, "developer_name": "JAYYY LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-taggeringg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JAYY LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-taggeringg/websites", "category": null, "comfort_rating": "COMF
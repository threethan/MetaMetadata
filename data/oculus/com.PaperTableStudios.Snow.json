E6UfxEswQ7kNvwGxvAzJ&_nc_oc=AdoASU9_gDC0omDx-quhhYdzuoOv52kLGHnpoL-uBNmpEb0gZs7DEpmOBaMJ2WA1gWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb1gHvPoGQxLfqy9JJ2p_j1fh7vNawAdYQjmjqrR32Kg&oe=6AFC6CF7"}, {"file_name": "4.png", "id": "1429184945280847", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1429184948614180_2350574715754970961_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqX3svP6JsoQ7kNvwGFIYx0&_nc_oc=Ado_OcTXUBQL712hn2njcZG6fihHz257rvj1L5Luoqu0o7-2-uQnyLGXXP9IPyz2Yok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHIEB17vjXQayKfRrr9EUplknuyAdP2ns6IF784MpX0A&oe=6AFC7F2F"}, {"file_name": "5.png", "id": "1384760823210376", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1384760826543709_6281863386735494414_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZKtFpx8hlUQ7kNvwHbdxfn&_nc_oc=AdoVgA7TyPnmxY33OkKJw1P77YuWlxXzABZnaiq7jWmGGIt12jSM1-fWW68yXfU4_y8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXk16db84tYNplSgPN1pvVpT2aN5P3KUxht-mwD7BiAg&oe=6AFC9705"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Snow Game", "keywords": ["snow", "yeti", "tag", "infection", "fun"], "long_description": "## **Snow Game**\n**Run. Climb. Throw Snowballs.**\n\nSnow Game is a fast-paced party game built around hand-based locomotion.\nMove using only your hands and arms \u2014 no buttons, no sticks.\nPush off surfaces to jump, climb snowy terrain, and outplay your friends in multiple gamemodes and chaotic winter matches.\n\nWhether you\u2019re chilling or competing, Snow Game delivers smooth movement and nonstop party fun.\n\n## **Game Modes**\n- **Casual** \u2013 Relax, explore, and practice movement with other players.\n- **Infection** \u2013 One player starts infected. Run, climb, and survive as infection spreads.\n- **Snow Tag** \u2013 A twist on Infection where you can **only tag players using thrown snowballs**.\n  Aim and movement matter.\n\nEasy to learn, hard to master.\nSnow Game rewards momentum, precision, and creativity.\n\nPlay with friends or jump into public lobbies and see who survives the snow.\n\n**Bundle up, Welcome to Snow Game**", "short_description": "Snow Game\nRun. Climb. Throw Snowballs.\n\nSnow Game is a fast-paced party game built around hand-based locomotion.\nMove using only your hands and arms \u2014 no buttons, no sticks.\nPush off surfaces to jump, climb snowy terrain, and outplay your friends in multiple gamemodes and chaotic winter matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/papertablestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Paper Table Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/papertablestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "25828706840067757"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25905949535676820", "version": "25"}, "id": "1538043194
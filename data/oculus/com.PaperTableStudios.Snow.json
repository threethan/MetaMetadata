wGpp9et&_nc_oc=AdoHEJ4jYcyQTLQh6cXAARXsRYVT3ph6kmdK0ZGjflOOFQ2SttldS_2mWDj372KSZPw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1chzLxYu_HJSEig58EdHABJ_vmvupnBHupCxxIwiFDFA&oe=69F34906"}, {"file_name": "3.png", "id": "1621549675863953", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820887_1621549679197286_4058723899459942187_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hM-hQ6_WX24Q7kNvwHc6ON7&_nc_oc=AdqLfcvfThMObzVJuSeOydx9Kgfwu3mkFbCqVZzC_bmfsa3XgYx7-CHVd4wiGCamnVE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PbEaLSlxHPw13bb3Gxu_zkV8TSJ0IbRALruNga0E-ng&oe=69F36F77"}, {"file_name": "4.png", "id": "1429184945280847", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823296_1429184948614180_2350574715754970961_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeQ9rNyn2bcQ7kNvwHsqIb6&_nc_oc=Adp_qda93xWZDwtSzTZNeBILOwjCl8XV5h5F8yDH3un_VJwPiDomLlCbNzkwNOXHjjQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JAm_wdwrFOzrdj3EIOIKZBO-wrwErSIHx6GlCap6yDQ&oe=69F3496F"}, {"file_name": "5.png", "id": "1384760823210376", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823940_1384760826543709_6281863386735494414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLHaB9jT0D8Q7kNvwFW-MO2&_nc_oc=AdrcatV0Yw3BOsXDMku52As0r57Gv4VxgQ2HNHri7ecubpGuuBz1Ilrj2R3plZP0k5w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fWW_XxXF7Rg3Tr1xKbrd_ThryX82UHZYUCPZOc_WLrQ&oe=69F36145"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Snow Game", "keywords": ["snow", "yeti", "tag", "infection", "horror"], "long_description": "## **Snow Game**\n**Run. Climb. Throw Snowballs.**\n\nSnow Game is a fast-paced party game built around hand-based locomotion.\nMove using only your hands and arms \u2014 no buttons, no sticks.\nPush off surfaces to jump, climb snowy terrain, and outplay your friends in multiple gamemodes and chaotic winter matches.\n\nWhether you\u2019re chilling or competing, Snow Game delivers smooth movement and nonstop party fun.\n\n## **Game Modes**\n- **Casual** \u2013 Relax, explore, and practice movement with other players.\n- **Infection** \u2013 One player starts infected. Run, climb, and survive as infection spreads.\n- **Snow Tag** \u2013 A twist on Infection where you can **only tag players using thrown snowballs**.\n- **Horror** \u2013 Escape from the **cave spider**.\n \nAim and movement matter, Easy to learn, hard to master.\nSnow Game rewards momentum, precision, and creativity.\n\nPlay with friends or jump into public lobbies and see who survives the snow.\n\n**Bundle up, Welcome to Snow Game**", "short_description": "Snow Game\nRun. Climb. Throw Snowballs.\n\nSnow Game is a fast-paced party game built around hand-based locomotion.\nMove using only your hands and arms \u2014 no buttons, no sticks.\nPush off surfaces to jump, climb snowy terrain, and outplay your friends in multiple gamemodes and chaotic winter matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/papertablestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Paper Table Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/papertablestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_
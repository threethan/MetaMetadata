_khOsCTsiQy7aMWdtSAHM8sW0DrybmywjqDaJU415CGk3TtZruR1g46VYGF3Rq2U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyADicqtfAREg_ZF5Bxs72sbZNzQOth6Txlc4bxQnXkA&oe=69AAC686"}, {"file_name": "3.png", "id": "1621549675863953", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820887_1621549679197286_4058723899459942187_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGPEUK-J9ycQ7kNvwEP7EI0&_nc_oc=AdkaScr7zGZYPz-D85kqhAdmzJ99x0cNmPFoHWzsH4irhRhMd9dJKJAs6AW7qmyzVPw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuYjxlTF2DL8ASWXwePvHXqr495n5qZMyYn-0jxwo4Ow&oe=69AAB4B7"}, {"file_name": "4.png", "id": "1429184945280847", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823296_1429184948614180_2350574715754970961_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xn070erQjboQ7kNvwH6REjB&_nc_oc=AdlH7mrKX-8R5KEZGq2mD4jIzARSiTsqEq-El1Y96-g63sb1RWk7dF3dMHob47vp9Ps&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5rfUwcAr2yN-cHdtGOiNyH2P_RJJFHlCGbmtrz88mvw&oe=69AAC6EF"}, {"file_name": "5.png", "id": "1384760823210376", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823940_1384760826543709_6281863386735494414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ElKyiF7WvUQ7kNvwEKP-jE&_nc_oc=AdnPxARbl0GeiPJrAlwC-ZRTsabuu2Yee59XEQNcmnLaMplLJYe1WEVnMK9W1xtleRA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6lCGByBCxnMqUQnSwv5ePu2zgA0J354LnIPxduMR3iw&oe=69AADEC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Snow Game", "keywords": ["snow", "yeti", "tag", "infection", "horror"], "long_description": "## **Snow Game**\n**Run. Climb. Throw Snowballs.**\n\nSnow Game is a fast-paced party game built around hand-based locomotion.\nMove using only your hands and arms \u2014 no buttons, no sticks.\nPush off surfaces to jump, climb snowy terrain, and outplay your friends in multiple gamemodes and chaotic winter matches.\n\nWhether you\u2019re chilling or competing, Snow Game delivers smooth movement and nonstop party fun.\n\n## **Game Modes**\n- **Casual** \u2013 Relax, explore, and practice movement with other players.\n- **Infection** \u2013 One player starts infected. Run, climb, and survive as infection spreads.\n- **Snow Tag** \u2013 A twist on Infection where you can **only tag players using thrown snowballs**.\n- **Horror** \u2013 Escape from the **cave spider**.\n \nAim and movement matter, Easy to learn, hard to master.\nSnow Game rewards momentum, precision, and creativity.\n\nPlay with friends or jump into public lobbies and see who survives the snow.\n\n**Bundle up, Welcome to Snow Game**", "short_description": "Snow Game\nRun. Climb. Throw Snowballs.\n\nSnow Game is a fast-paced party game built around hand-based locomotion.\nMove using only your hands and arms \u2014 no buttons, no sticks.\nPush off surfaces to jump, climb snowy terrain, and outplay your friends in multiple gamemodes and chaotic winter matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/papertablestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Paper Table Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/papertablestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_
T", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNtPjR00HqYQ7kNvwGgYx0l&_nc_oc=Adpm33xxVAshCqlg4ljsbpTKXTurkoHTukdUD3Wh5O0cqdq0bOs45HRChaVtYxr07qo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqJsHmW0yikqohRXRpK0CrB5vGi6cnFWR9KKUDPVH5zA&oe=6A5CCC4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftHXd44o3VUQ7kNvwEf5ev0&_nc_oc=AdoHR0A8a6fVkQfmhjZ1iOxaA5ZKMqQ65oPbe3yb_hfDL_X8EY5ZXP0cwcHXKNNZAo8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbPeZXZmFg-FaEF6xlkE0aSXqR-vTP7BVjvJ1nDFmneg&oe=6A5CBFA8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs99F6cPwuUQ7kNvwFaIoKW&_nc_oc=AdoTbAojUpjZrhe87tTgk3D-bJJyzAgtvdQiT1WeMLf0OyFhagU8SdI44elSHuHyG3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOvma2h2CixbVxZZR1QnXv8_K59oEazvZp4wnVUmbsFA&oe=6A5CCE50"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t5WMG6yfdgQ7kNvwHzut7x&_nc_oc=AdoWgGuEuWejYuniCoFWzLXwsHcn8WQa-rQYvKSW9ABRfUeJwrWGMX2LZnybk6OUTNo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuhyMo2md9YO-vWQjFkUqHHcg4othwEo439blmhDyl5A&oe=6A5CE284"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMrbOyKEf_gQ7kNvwER0d6l&_nc_oc=Adqwolxu0htto6DDrmL0-HSeEBE_dot2GUr4yR4gkRJesQcLlqBUjqhJ84rMNRqOfeo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXLBtewJefq-IbLo1YFi8khPwA8G-kSjAlmK6aT2Oagw&oe=6A5CDB32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAgNtreMZ9YQ7kNvwHkZt9S&_nc_oc=Ado7FeElzPgzKmP2pWtySy3DSQecGp4BjhCVgsqfIQ7dVQJoaAXjQzYRJdTGdT_CpBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlDuVOAN4jq9cgoy4j6_3T6rJsvO_R43Ed9AsD-ZDQZA&oe=6A5CD28B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCUyxiJDWaIQ7kNvwEFPM2f&_nc_oc=Adp9lpkHZsic8_8Qjd3_0eM-Nua-qGcIhdpDXIN1JUHZPjGESuJirnxr-3KYKrJ_xeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA6w9_aonOVMk5Mub7Vsr09dlo1KuSgofSymNr6n9P6g&oe=6A5CD8EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i88LxIzk2cQ7kNvwE2wYM
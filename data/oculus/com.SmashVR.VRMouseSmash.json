T", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xh2XKcn1bgQ7kNvwGYdJwv&_nc_oc=AdrOYuTPYnfp39-9KuaqQlm4kMaKros59n0iEqcXn5LV6iV8UqKhbUrb14gXpw3R5ME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_aWJxS9N0iO-Zy1u0BIxUvI1lWbn6Ia9nc6ARCuocFw&oe=6A6C9E4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIi-sgfCUF0Q7kNvwFEepKY&_nc_oc=AdrAXYwZyJ45Z0643M3TEJzAh6CdK4QtxcnFQ1jElgFTu1mu8WjzD-kE2wHdQes9JzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPUEdOeUNTUx4PAhxIwjfwgRYZbvFfSvedgRHVfIXlkA&oe=6A6C91A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg1xbdoeFS0Q7kNvwFN9k8u&_nc_oc=AdqVTc2V4eChUP73x91Er5NXEjkspNVjvKmwr5OEN-sfSXtoK9yjVXRWBLYvNhhNIwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-Yv2i0YjWueyEx8r-9hoXFjLGzc4jEhcRG2s9gsnSbw&oe=6A6CA050"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4Z2gnwEGfQQ7kNvwHAiwnk&_nc_oc=Adq8O_aJlEsO0gZIt0NemWh1mwzXzLswri4w14BfB_fryXREjD6JSHjM65YPWzqR6Z0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRAk50p_T5oqmVqSjcMrndJ07nq-wpOwnbCrZq-kThqQ&oe=6A6CB484"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Njh1p_yUD74Q7kNvwFqdVB3&_nc_oc=Adq5ilsbfl_I1kA4gp0FD-t9eTEEuGWVbPnlHFxLT1wbkQpKp6vm8NUyzw6pRZDuKfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDejHfJF5oH_fsoXnmU5MFCr2QPtyLdM14iHlyuITAMFw&oe=6A6CAD32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rcLwvhgxxgQ7kNvwGbSY8O&_nc_oc=Adoq3-a0L8g2Q2YYGLomXZKU0QywWbuJDBiRQl0p8gXmX6vXG7KoQwrfUrDT9Uaf7KU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfdJd2IYhKfcJ1JKVsaSkVhQtJOwEWG5kchvesxEXG-g&oe=6A6CA48B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktxvR8XzoBsQ7kNvwHvwlbm&_nc_oc=AdpZW2K2SgroKfyrdlwvkrysqaOPTUoTBRbDF2RwZnENaP2MpZgob5D9N0gM1pNq1A4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoDG7aw3Bd_Hb86Dlzb1zp_5EhLPtMZ9TD6rVLvmc9wg&oe=6A6CAAEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZqKnhYbaKoQ7kNvwH9bDq
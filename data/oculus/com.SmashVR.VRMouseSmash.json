T", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Vi-el_KT98Q7kNvwHNoaNb&_nc_oc=AdoUhSSHyTjoDMINZReCNzT4EMgGD2dupP_KN4sK27du0ejFU0xzw1Lf2Le-Lz8A1No&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TuPM8nhDneUVZO5naGdWt4DzEiyoJ2HuKTFo1q-qszQ&oe=6A09BDCA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4AJUCZksUUQ7kNvwGwZ1af&_nc_oc=Adqn3ir0PtCDraiAJQRa2ymoIigTAos88cRenanFAifYkx0EMko47c4rC3ZGB58Zb6g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6luc2H7wn_aHxA6QDxYaDmVC4itT7BMakjrWek5DJ7oQ&oe=6A09B128"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzCjY4ZCU3oQ7kNvwFe5GbA&_nc_oc=Adq2IF-vNoP3Douk3sTnl5FmSgv2otKBGMZcUDMgZwPpJq_dNRr2PcJ2P1egkfHd2_E&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yfWFOb1j373gzm_6IoObvFqqf5fepiaNLVvd0fHp1Pw&oe=6A09BFD0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xn9HIwfVH0Q7kNvwGXEIea&_nc_oc=AdodcVTu9BS7A4XoXtAC9mh3N5QqqcoNVhKwmmI77JOJjE137-jFz1qm9Y89JtsFZ_0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60mK6Os5bKOw_bPTg4oC3jhLdpaTSiTV_QhWf40MVXeg&oe=6A09D404"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV3C6YzIIPAQ7kNvwFMyaww&_nc_oc=AdoeQozGrhfqRzvB7sWRX_-ZbyfSjcqutIFvxVn0qDNM6hzjAz5qg1gtsU2IVTbaAgY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gehOyz_61kDrnI_rRTyBDAgPB-oIAAsVCry1SmS6gYg&oe=6A09CCB2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dcr83lMfnF0Q7kNvwHwP3iU&_nc_oc=AdpL7jNJIOdnOXuETY4E5Rt1yjidjy60QuFer3Gsy6caidv6Fl3STwa96la9e9TscLw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49wPTGJFHzXffw2MYJMQ5iswf4OVPSxu7-KKR_tL2D0Q&oe=6A09C40B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-wSdSyG72EQ7kNvwEjw2xp&_nc_oc=AdoTmZhanVuSuYakovHCkLwa8ugzg8azWnWG8kurdvxXyp_ytwFs0GOe_rY0T0KDRvU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56V9O-3oUCNwTu_3P6M1laRu--OT6w6YHvctJyqqEi9A&oe=6A09CA6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5P02QR0yMD0Q7kNvwGuUwd
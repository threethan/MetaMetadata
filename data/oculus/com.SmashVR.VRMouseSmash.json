ENT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd_mGNiK0soQ7kNvwH5kPTQ&_nc_oc=Adr1Idu_3NFcTgfQf2B3KaVVNVR8BSwUzRMHegUzVZ-Qtf4GCe0E3lmyV7_78sWYDts&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhZlZ6DqPOzwdW_dkjUAgReuUWOT4tBNxUwjdEy0G4jg&oe=6A8EE54A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jIuoU69M2cQ7kNvwEKzotL&_nc_oc=AdqlJgQqpZpDgPUl0GdCSp0458vPNq9g77QZTynsitm35-7tQ5MrdPlxVN9KudfEHxk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm95CRdYAxrno-gTcfgrNh-E7EXWF4K76-TUaRkleWgQ&oe=6A8ED8A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-Tf2Hmwq9IQ7kNvwFhuxQt&_nc_oc=AdqXbvfm7pK7sZ0XTBaO0bzHAfVzKiJyiOHlEPQwKwR2OgrnG3iToo2Z5ibqmT5Vvx4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnXIH3sWKdy_jvlRsKPIHmOGnxBfJw3cJTMZ9TrNSemw&oe=6A8EE750"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG3BJmf3s-EQ7kNvwFs0tCr&_nc_oc=Adro3zgVLLu3iL7qKcbZkhfOSeHOLLoJfok-7J74KVKqPaw2RyCwtefgnWiS1CY8cKI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOQgeLxIC_9SxYs7XtiErWE5S1ROK7KXdpzvVCrQVRrQ&oe=6A8EC344"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rs8ccCgQGTIQ7kNvwFnXZYJ&_nc_oc=AdodQFoQuy5CRr984UAEegUqXoSzb8dUCyGNj4n1oXQlVvB02ut7fSxQHFgoF7TxCYs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKgpfAYWnJs045Ja-DJ8iypR7_qiRKxrFCRpW44-ODKA&oe=6A8EF432"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_U6CZ4uyK4Q7kNvwHGUG1B&_nc_oc=AdpaV-7GLSECfB4-chU9DAeXhraIHQMUuWw6hJtrR2uBWMfsxXPi4b2qlzS9_AAeWmo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsVqPMThK2LyYl7BNBKYxy3fxBkV_tqHKLDaorlIxDvw&oe=6A8EEB8B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKdN52ZD72cQ7kNvwGpejQK&_nc_oc=AdoO_n4kRUA2cfqMzBnqkyB__Qw_2EQV3KDXC0qIFiLWxC8ekEVvFv-U_eQ3S6mR5EE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZhwwHhoYtIQhtfM5wYkXhTuw_YQ5LuGCovrOKiYETdw&oe=6A8EF1EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCuqtjw-CPsQ7k
T", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bcfVbzZo0AQ7kNvwEebYcO&_nc_oc=AdoRvtCGbi4ZXVJgMzWPSqj-nrhxkhjHt-4-ziU1J9biakPpbJC569AL0zQBjAttd3o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnHTampE9tGPXbzvIVzKUNHwgSr6EaLBI28yuxI99PfQ&oe=6A4E4BCA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSBqXxZ_Z0QQ7kNvwGA8Xn4&_nc_oc=AdrxQnhbd-4z98-AWjpXMTKWgZAG0-4wHwXOSzIBpmtgXbr5qcmPCaGq2cLnIpJho6Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFeFou2LfYy5CRrF2kgbnBPczW7p2OqALJ7xvVPzUR1g&oe=6A4E3F28"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7DXfZ0D8q0Q7kNvwHF5-Ov&_nc_oc=AdqYnxwl9J6NgXIrLnikS_pQHR2rK6L9Z_ARCJ4jdaTjYEkU6LFR6YN2AZj-1C2IfrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbd4bxzGB7H2T5zuJyBLw2EsAh90Vq4gR5e0RfFJzfYg&oe=6A4E4DD0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhaujcsHgOwQ7kNvwFtu_Zj&_nc_oc=Adq0na0AW6eOzyQvE72IP7PzqLQHHzUoM68R6GcTpiH4lcdNvglIktJiu0JqBVi2qtc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdJ23NH95cRKss3fUVWM2OIOcHkSACrWLf-haqRVrdcg&oe=6A4E6204"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53UhzVn5shwQ7kNvwGiNvnT&_nc_oc=AdqQsOru7TRK4EhQo59Fi1KlmmSH6bH_ri3VumeztLM2gmLSJpQkm9FQtIrs8FAmeEA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAknOVww1W8gA9ZkrRwBrRiI3F5XrNhW1fwCI3oCzCMNQ&oe=6A4E5AB2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpgNy71y7Z0Q7kNvwEMfW1V&_nc_oc=Adqq6NPqDf5ALChl83XMXPSc-OZF57QSyCYRGKkyH0lQVOkI9aBlBj9qtbygdm31qm4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN8zdFbTRnqjWMMAZanve5127qpaC_tW7rjR_HIEu9cA&oe=6A4E520B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NUT6jgy7o8Q7kNvwGsXKGf&_nc_oc=Adri5MQgQTQhKcdewtMq4jCEvLlPRE-PTJpxDOkJ8dAZ9EPBYzlGH1rosgwbN7MwHvA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0ppUzM7X67QF-wSd99jL9ICLvSUDjRqG90Cjn8XmrDg&oe=6A4E586F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ECJbVRf_kEQ7kNvwEw4i4
T", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0ceoiuqlUgQ7kNvwHh-wY-&_nc_oc=AdpnFztl4CzYZJHPbvMi0jH_UJvqoKqoELj_o6jgymhCA3Ld7-C2xz_1U1a6vRQYI1k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDcdvBWyeFXqvpFfzknXXJUmyqiJp6N1oQ3M_IbfyT_g&oe=6AD0D04A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7DJ3CBnKXoQ7kNvwFTb5QG&_nc_oc=AdoBVmrYMqMUpxq-6O2WXBVvImOgxmwk2NsjDL3gqHBgkV4juOmQTyY74W_FFiqJusI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVr8giWkwK9yXlp_yh9ImzIub_hswfjY3gSo91n6WXSQ&oe=6AD0FBE8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew9kGnM9Tf4Q7kNvwFX_aJo&_nc_oc=AdpGkeSEPoqGfdcnv9Jfr5fJBU_lA0xTke4UyeH2bIQhCE6FYKjO3HBqG_ew1tDe3gM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRFkUBfDwNPGkq6TENLIQdkrgcGmRU37jhxU0gZds-0w&oe=6AD0D250"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXsGkyMDZcIQ7kNvwGHDXGS&_nc_oc=AdoH_yen_eN41gfNGXm85iVtbijoOoriJ84uJAc76j2QTZjafRButTudFR-cRjGu02A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm1jJ6JV1mRmWAhmbC-0UY2eV2PZmTHtqfve4sJBx-ig&oe=6AD0E684"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aM2YerJ26MQ7kNvwHDdq9w&_nc_oc=Ado3NpvvPBXagzE8cBbkduX8IstkeuM6I5c27ZFymBK232KqG7-xSAtc_fKJZNBRMNk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjehQfYOpt2S7dHaoB-sKMDhu82pIXgmI2sazAqZ3Ztw&oe=6AD0DF32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUtA6FHC-NMQ7kNvwEyc4fy&_nc_oc=AdriaJEnd8Dz4_zb3tWbgGBhUKDRjuIaARyKGDAyQ9obL9gv0wl94fW177IZ0vXzU4g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnpoXQ1Wwp6qphWAWxH5vOCLDecuWx5QNxx_7HfwV0jA&oe=6AD0D68B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDu32MQ0BJQQ7kNvwEtlNIq&_nc_oc=AdqnLSU_eDfGUsxkqLZ4Sa7neep8bFYiSkkD4_w-tSTT71LJg3aavrA8ikuyiyaIknw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkcXqDXD2bs7Nxfs7Ol0M9diG-zjsRA6VrrpglzxFplA&oe=6AD0DCEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfQByEGABIUQ7kNvwHbgx3
T", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmJgLlhSikIQ7kNvwHWydSe&_nc_oc=AdoMSjlKVBL9jzGUXsswz7eJTsyCr-91s4Qe9RztEXBW16otocYgRuG83kfSJe9ZtK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kndIh14U672Xy2U9lzEsdtC_I0cizAyAfv6XjMwgTgw&oe=6A183E4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOrowqC2mUsQ7kNvwEYXZyk&_nc_oc=Adrq5dYjKLto5SwM9D0_igZaXuX0by6RMU85abax7nnTV16LgMgGPf8umDpmkhP79pw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VRLFUPGdTQSGafVj2Qhflh__eBxv_ka4e9tFVpSRrjA&oe=6A1831A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmsc4qf3d-kQ7kNvwF4nZdN&_nc_oc=AdoHJntMBRgq4onOfy07XFwkfM8Tje98dsh60HUFSCD97Nt7NZRrYlekUkqqBvxV7HM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wdp6kRKASRQ69nW4ZYl0OgvHOxFLeuGTd9bvapxjEHQ&oe=6A184050"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm68ujE6P6UQ7kNvwFUR2ll&_nc_oc=AdoXqj-QuecKMbLzidQ1pVXNmwWrQ2yQ2EjbnGanobmJiNhZMs-tWBMvXNYdzqimxVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I8Hz5ASiI3FwXHQ-vb1pLQX_cGhg2Gvz2cWN9wSPPKQ&oe=6A185484"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRJy35ZXORoQ7kNvwGwWk-X&_nc_oc=AdpH0J0hvpQPggJptOaLim7EhKeUgnDPH19odHuiqHOZmhlkkkQyydDL9yaafjrMWtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vD2QtrEM6oXGf4hA-6a3w8bnkC-VE2eEOyr5nsN4Z-A&oe=6A184D32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sue-R_D0wTYQ7kNvwF64j2e&_nc_oc=Adpye57SrrNMvF0E1IgbydE1n30mTFqNXT9PMp-d2KFCQEsUPXksdqCUIo9hH9wIjmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v0KZDATwg_r9PfoicGbkR7cWtEul3XcqthxZbeB8IfQ&oe=6A18448B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P88d2-bro94Q7kNvwG_iLtR&_nc_oc=Adqu7HuZ30p7U_s2XgITlxLrMgjUTFkPqv_AfS5g9qB_3oc16akZOXuPiG_W5j_xYbA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TRnz_V_Iav2BwtXWC1i-s3XObsoUw7Rg_YHuBVmC0Kg&oe=6A184AEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tn0bFyphcbkQ7kNvwH7q7o
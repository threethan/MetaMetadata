T", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBrzbaV0vPAQ7kNvwE6OAHY&_nc_oc=AdoQnLH-wKF-xkhEihO1OWp-wMBzTXer5QYslEM6fD0m5H7m3HlBIqCgV11trnI9wnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYmxfWlPyN_GN5fSdkkEW7_MQgMaCRaLkG3jgZAb51vw&oe=6A5F6F4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftHXd44o3VUQ7kNvwGUvqw8&_nc_oc=AdoAj45hq78Sm1qJfI1wVZHAXmnHvy75d9i5Bub5neClZ__5nyoV4VJGDC5EiCQUmQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA96ow1O8zhaEZX3PiDe_6PX1L5lZqp3OHI77jfKfq_ug&oe=6A5F62A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzGtWPO87OEQ7kNvwGlirC6&_nc_oc=AdrhSf610ZwDeO9wv01damxlAIJ4EK0KkCnsJ5taR7kkBrpje6RXwVT7f_ZKtEuSLTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7VRqpLordKsfiXi37C6TRs9SFFPulZhKluLzpCuSeRQ&oe=6A5F7150"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t5WMG6yfdgQ7kNvwEYtPJO&_nc_oc=Adp-9XcFriXf76e1TsgWCUgW_tzlRtY-Sk3Vhp9PTSMI9V2F8KBsA2Clt65cq97bCrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2KHIw4fyQr-11pk5c-a68al22F2Kcn1R1aDXaqqEUDA&oe=6A5F8584"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMrbOyKEf_gQ7kNvwFfE-eb&_nc_oc=Adrea718k7nSQ8pfPN6hDvL96OfVwLHiQxDf5w4QHcIZViBMhbDSe47klVYifhqoDvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbSNirKZNwyiaCA8i_Z2cxg4fQiBG9EvaoWvYm4-35ng&oe=6A5F7E32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAgNtreMZ9YQ7kNvwG9ZKkR&_nc_oc=Adqz-vZjCQqY4dMhq1pNZh73aE89GbePm7ngkFLU49MOZiRIZrhNgcAkRNdxrbOucGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkPk8IQ5bP3My_yf0-Ebtcgy_C4pd1jiW3mOKHYA2g2w&oe=6A5F758B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOy0kai4rDoQ7kNvwF0XdGH&_nc_oc=Adpu_qL9ufnftXedShWcbmeOGIh3fos3nJhq4tmgeKe_wcuczmPGQL6s6N4iPWcbZ-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaGstGXEJvLvrPyfzMdpxWMIEvf8FTcLpCc4r_YiLxfA&oe=6A5F7BEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdIu1NdzycEQ7kNvwHGXmu
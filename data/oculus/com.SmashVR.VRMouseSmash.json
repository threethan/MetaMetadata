T", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n9QRkFko94Q7kNvwFUZ_5j&_nc_oc=Ado0j-QGop7Xx8VFa2LW-0hxKqNk4-BtoRPBMzPl5f5r4T6aZGItehAyRQyPOjOP_CQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12xhIKTb_KajyvhRM5xu62VJ2PBMYp-tV2C9QJBAQcrw&oe=69E6254A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTXnTLoCwRwQ7kNvwEqfiac&_nc_oc=Adqc-7-hyz6Tj-_aKoYO5IutptmljiO6IvlL1zdzP3n0UJOxrSfSNroAKfWKVuHPm1o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18SH5PE3fdSYkzlGE0VrzN7C14l7LRRH8FVDLhoT8Vrw&oe=69E618A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yb2c2CNvODcQ7kNvwFcB6IS&_nc_oc=AdrGf28gBxkyZ5aelCtYJhkZsJ0B75xILXdO_MSyrWOYPXKMH-EfIkIES2jKEZZqQSM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nNPVF-PFDCNJmfZ4wFahk_j0evJCIDznYswybJtNe-A&oe=69E62750"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjz-bV5bwxIQ7kNvwGZtMkJ&_nc_oc=AdrhqAQtDyxzk8p4886hs51T07wUcRai5dgnTqTqwXKJys_Ux9H9mFn6zJ3qc-zmuY0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JRyX_ho-N0nSvbtIZm6T0QD_uXZWc3mUI0m53tiZHHw&oe=69E63B84"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaTCBfZ3APwQ7kNvwEnTUaP&_nc_oc=AdpndRY52QzVsA3j3IiSM6TV7cHBe0Ggp3BqFds2ax-CWXkImR8U4qPr3GT-PpDh4vw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PZAlhEpWDCW-eV3iG5TRvzGZqIaoD1pJzH4-CFxYhjA&oe=69E63432"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF8To8abZREQ7kNvwHKPbl7&_nc_oc=AdrAnxLLKrLRlIfBVtOJhALfWzF1yDqfs3qO1_3zf1I5mN9v-wXN5JIoat-eZAql-lo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28poqzpFhCUcVi8nB6Y-o9YgLwnEGGqCTBvDXdp-Pseg&oe=69E62B8B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UiVCgXUHg8Q7kNvwFLfuAL&_nc_oc=AdqGBU7VaRKyEeZIFqzgbeYEZY9JSSeum3DPixPKCMc1lQ92uHhqTuDm-MWGxoXePK8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pgyy5SW9awCnNUMU4oRnInh7YNFxrtLv8RvD6HYkKQA&oe=69E631EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqLBUb4sAWQQ7kNvwFHIuB
T", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cAO1JEg_4UQ7kNvwFhtbWI&_nc_oc=AdrudqHzOKnE9dwkUp_0ku7UaoibKsJ8lLqFo6P5WWY8sTeVsWIIEJrXRsw1OmCfSSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx2gwmWZ7KtPFMn-oNrtNZHD1Hh2v1sqJc2gGT4XUbBg&oe=6A4CFA4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSBqXxZ_Z0QQ7kNvwHvIEy1&_nc_oc=AdpCZ1ULRQN9i9PFzo7PouuKs7MdWgfzYyaWS8PLxUsGrERvuYolD0kcsIFmJhFDdnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHj-cdnHPYT06JoBInvWauJ_k9fIDqnnrp-hattWM7FQ&oe=6A4CEDA8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7DXfZ0D8q0Q7kNvwHgAR-2&_nc_oc=AdqIAA5zQ-OiJDrlwixkGsIa72sA_JF9ZNR2--xkciRlXK1mTSjbtVnrO-9n9yLhWQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHusXneBC8p4q9zneZ8sG-Qw08L1EVvEDkCpA75MXa4g&oe=6A4CFC50"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhaujcsHgOwQ7kNvwEYvOPu&_nc_oc=AdoAecyGBC2Wb_CBxWQF4Oe_NjHIu5HrrO3z15oB4a_Q4yLGNocpH9w1iEmvRHtgHeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATDPt2jeW5I3LTez1G6xTdJnRDjWEV1D4-CeekzBiRAg&oe=6A4D1084"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53UhzVn5shwQ7kNvwFuwPdT&_nc_oc=AdrthIe_jd3vzCh_Ru5t7v09jbvDdGaHAh9lZqqGFLMNobI74IQUf7jwKw9f9ReCu3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKn-zRm4zFaUiPeVKmTvH9C-Dt4nMtkqAHYPFw7JEx4A&oe=6A4D0932"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpgNy71y7Z0Q7kNvwEsdvzw&_nc_oc=AdqwKoBu1C5vBzcU59cN8X-6S86y4UuNTjO0nXn4nrNQzGHccUhnT4WPn0pN889bmdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUIo-UXLadCD9WaGM_WOl92zgxY59_L37kkulZdNWqKg&oe=6A4D008B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NUT6jgy7o8Q7kNvwH3tSSz&_nc_oc=Adp3NdmCs46-VuKM96ZnoGpPII4H9oKvUwsBdplS8vLOsjYVjFukEtVSA6REmPCoc1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSTl5tsCcIoXq1uz_DjzMjo1fNuYQ56vwi19zZF-oBZw&oe=6A4D06EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ECJbVRf_kEQ7kNvwGBA8q
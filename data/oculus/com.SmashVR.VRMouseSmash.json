T", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryARN7_9M94Q7kNvwGteBE_&_nc_oc=AdqrYBBkIe8gz5989BJCdx3iYeIhTebrJA0FSJc21vh0XtNi0yhrtITlQ5ePX9yyHoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dGalbNjr3wGUsWVEdpuXTUYH61rd_2DXLls6-gqMKAQ&oe=69DE3C4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ0L3gqXzHgQ7kNvwHahFTY&_nc_oc=Adr_RDvdFZ8TjKO6TZxAUO2K6jDo-MAPrkxWVucd7bspVNlaU6Y1NSn26Xl17jWWOfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SlBvky0Z4KKMs0VDu0TpqaQgX8I6ab0JtM98zkPwgAw&oe=69DE2FA8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMWpjDuEWakQ7kNvwEquynj&_nc_oc=Adr-FvtQR9zjJ7xVS7m0D3FkBKQ3-XVoQiC4yopuJ95dztMGqxxuhlZdY7FTqrognm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xbguq2HQoxJqCKrcz25EL5Wq1vsw4Bol8l4u1pmSqJA&oe=69DE3E50"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcbrekABtRAQ7kNvwEaDI-c&_nc_oc=Adp_osbhOX-zlhI5I42UbHVN6cxYtvJXeCr7sSD2Pv7zZOutxb3VGLcSxp7ON9OJAb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o_yhMZUk5mShJt4kQVCZsK5EYEys2KYNK87m1_aTyYA&oe=69DE5284"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE5LHYryre4Q7kNvwGG-SZY&_nc_oc=Adr419-thAYofu28Meete62rbUWqNITNmmRZFdnf3u18TEJP0-On2u8DPr2gPEpqcic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pqZyT2y1eSV7flFli1mretARJ6IkGBoNoTe3StPmHtg&oe=69DE4B32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX22DUF5G7AQ7kNvwEBSYed&_nc_oc=AdpiQeXGO8eTKQx5GCYmRY9HI-iRtwB0cQUuWtt-LVj1j8e2Owf_mAqkrqOvZZ2y1jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H4GQr6wG5WpPUvVg7h8-_U_FxkcCL_RekP5GuyXISuA&oe=69DE428B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUtDHd7fCyEQ7kNvwED-YDN&_nc_oc=AdorNM4TAoJwrqJtCW9ZF6RNSFNZ0vpqFsSCXvMp6crA-ljCVm1bsSvDHZ-PV5lNnL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Mt9pITTWRIAYfmvn8PgxaT2HVhzGdxdzD15JaEoAoHQ&oe=69DE48EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfH1KyWISyMQ7kNvwEqQsJ
T", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLpd33uT-v4Q7kNvwGb4Svu&_nc_oc=AdorwkgFY4W9JevE4W2qRHh6-HMeco-dwCnthMWSMuBGYiFxI5bVHCCvoDJFnTekzzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP3b2iP4lX39iKAD1AkNA7_PSVGjso-O-_Ls5khq5Ldw&oe=6A54E34A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzH_vM_rhx0Q7kNvwE5J7O0&_nc_oc=AdpQimzRkzNrKVjKEK-eYh1ost6IjS1Bvp3zqnoGBzX1Em7WUxlvJtLHVX-rAcVJPU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArTAd5amm4M4438DJqkIKC7f_mJ3trrrCkk3rNfsjtog&oe=6A54D6A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvFVIlJPDyUQ7kNvwHsmaCj&_nc_oc=Adqt1CvYV5PPTVP6RGGBVuPo0ZiesloigSB_5dgNrlrZbN6KUp5qlmv186NP1hklRUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAabR27tNc2Cak8SWv0J9xxJvxDusgoUI2AuncRFiBbpg&oe=6A54E550"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R8eh49BuXUQ7kNvwEUt5oK&_nc_oc=AdpKCO80pcHKRBeLfwIqWQyXUX6r9pxW0YEwmGHZG-vWDkvLn00QOg8p-FgTZfFDDs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxg86jXoRbBza_8195AFy_yE1HkpLBamzOagEe9T_0Vg&oe=6A54F984"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJWidH7LD6MQ7kNvwH5Q8ke&_nc_oc=AdpIGs71b1tfU1YaaFDcxCRvRkh7kN-_TcM0zO-a6g2Sqsdfl7BtPGpeoMy1nvTssZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuJcJspFRd9SYmPUZxyigdfzZP_eLzllA1nHjOekUjlg&oe=6A54F232"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ap3UHzqp6tEQ7kNvwErEQWb&_nc_oc=Adqe_AiQXTR-8OWUgLYr5dAl3dv4sOB8r9CZMyIlkhZNUMoPJiGyW2D5F57nQEOpNRw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbP1ff95bLGYBv_YnB1c0MoTQhY-_HrT89PUAJ1Lou3A&oe=6A54E98B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuqnK8Co7FUQ7kNvwFE6Cyr&_nc_oc=Adp_W9UCtEdyEoIZrS32rAFE7FAQD9NqeoyX2uLzCZ0kN0Vd-UpX3ovLu5dcHR3f9Zw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMFbchY33WRLcImhchLQ01RX7N2xsTgH2NKlV0BrPy9g&oe=6A54EFEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_betfxKuEIQ7kNvwFSQw1
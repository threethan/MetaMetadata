T", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-uhS3Y7IQYQ7kNvwFNWAq9&_nc_oc=Adozj_LLCR_FsxbpgF17baF05RuG6SEL7Km6tnaCxsbz12PQln1LPUH1fmzn7-SpBV4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdHUmjduEYMekGQ9lZIahYYM6bAF0r-n4GCuKiGdqlGA&oe=6AE8C38A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FvKPDEkK04Q7kNvwHEvJwu&_nc_oc=AdpmvySPQ3Yu3q01QA1R_ocBiyIMa0L0O163hBPOarF-TL1gmjKNzDUalI2jEI3EMl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn5zX-186RVHbbJ6lfGazNxKudxITVrKFKMmP32SCllA&oe=6AE8B6E8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiB4I20dQ74Q7kNvwGlx6ds&_nc_oc=Adrh7w4dJb-lT1DuvVFoBGBxkiZvLMK_FnotkrYtlIR0q2PLvQw56CsOWVYZ__umOJA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP9uyx7KygZaZcAyY2GQ2c1YoMLBy5t8o1PVZmW7TWhQ&oe=6AE88D50"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgFKbNGdTpIQ7kNvwFulPZJ&_nc_oc=AdqF-DgcqSMLBJxZJbR3XCnAWI2LGyuAhEPAcEDRhDHcMN1gaqWLDpuuK6mG0Yi51bo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlVkgPbmRxj6bFUAYE-me8n-ETSi8p6qZUAPBoVLm1mg&oe=6AE8A184"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp5KR5FS810Q7kNvwGVHfMZ&_nc_oc=AdpYDbPwoNEfb4Uu0WfaiaZozGGykXtcinN13RGFDGyf8NEsx6ZmMGvbzdY4uqQE3gA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfngCep7Kbwt2IT48cOp_7kyCcldA1yHd5kE5xcvADTg&oe=6AE89A32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjXH0OojVKgQ7kNvwG_OrU5&_nc_oc=AdpgsOOP4dw6uWGe8CuyizV-HuBjP_mfBYVi7yWoOujmJGM_xTfrqi5RrdV2JTO-SHY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbeI_vn5z9NY58o_2-H3KHUTYFZ1q-NEN2jwoR9qGNPQ&oe=6AE8918B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azN9GmveK2MQ7kNvwFcBbO_&_nc_oc=AdrFPktfVFFbFk6zsnz5wfyGYavQBVvvw4GtKrW6tWvF2YDw5UuKx_a7B333gdLK4GE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdV0hOcySWmS4fGx9q1u4iNmuCQNCmgi6TOfNwIGKpHg&oe=6AE897EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4faFlwtbJRUQ7kNvwGK3jp
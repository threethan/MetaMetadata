T", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS3ywwxdhMQQ7kNvwFyhRBu&_nc_oc=AdrJhamV_NTXkvbPZFKs0QAhr3AF1H4__fI9UfwdV_ElBTGnSjtiDpNy_MsuXD072Sk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP-90N4CqBS1FrPds_FEDzTBwgaYFn08vl4M-3Mw7Psg&oe=6A8307CA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwDyka9JkUEQ7kNvwG4FLT3&_nc_oc=AdrmU9q81Slx9KqPObFgkgEwfr4x-H2hrBjbb8zkpNI9pOAd_zFS3HrwZqWYqMtpsp4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxaFEPXKYRz6NjA4p7wktJ9ddE9T1a8fsBcj9ATOCKRA&oe=6A82FB28"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQRdf_a228oQ7kNvwHh4FAR&_nc_oc=AdpQIv5p7sR2mgqQtVHahr1mr4XiN0MSS2b9NYOgMVkgiWYAbx3IMma9-VXY1tkksfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6u-Bkzw1hTPPwksxvytCraJ7er3rkOxE_-etxD-H1Zg&oe=6A8309D0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nm41VgcbBn0Q7kNvwGC4UxX&_nc_oc=Adpv3LMLh1c6Pz8GWBteLrlBVo2RIFDnqvw7elBcB1pDPZDtEKprIM9ZKx8fQaYImDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXETdNb8R-evoSJLdAj4PUcbJtCwCNNOjtV8CiJUFaDQ&oe=6A82E5C4"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAUo4dD6cOIQ7kNvwHQyGiz&_nc_oc=AdpvAu6e2nfMc5yqs9oUYiDRZotwiEMKggbdDV0SxpqWsWDNz-s-btEhPlyYXkTwNGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiQ_J_1u8mqcX-mibgGlPk2_bep0-cCWp6cm3LcUSFLw&oe=6A8316B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOiVmLwowYYQ7kNvwFWS9fz&_nc_oc=AdqHJunv64HKqfMCLweNEWmjipsLU6JjOMBQSJMuhJ1MzPEroZBm0ZNBrxgdlyjh_ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEspgw09pA5v7y3eY1SZSPKxlNcI2UYVZXjIuPsZL6nmQ&oe=6A830E0B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st_3Q4wRDTkQ7kNvwHohfjG&_nc_oc=Adpu1w9NKleBrmW_v2EPayl3rY6RAmyG3J78AQXvtHBmNkoiAbm3khPA4NAd0twii5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVz8Mie1ow7flR_4Fglp6vo-2Y9XiIIktr5shZQJJ46w&oe=6A83146F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTECImnzq-MQ7kNvwExG1H
T", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgftnzws9pYQ7kNvwGkJL1a&_nc_oc=AdqExZdtElIYJuk1V6g4dS9MHq5xiuYG_9cY4uos2PVP8OB5sdzILwQplvE4v5ch7l4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJozgysoNbyku3Oys90NirwKzZg4DtBpnKc1fCvMjLt2w&oe=6A9C144A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KphiNRC6h94Q7kNvwGc80In&_nc_oc=AdrElhDYdi_E4cl_BicabZyGJVwSC1S6a-DyUXdMSsuJkqY7BYl7jpl_6cFZ70bA_kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVHmP7inWZPH-tbd1sUhBKTza5JQAW5Akz6db45oCbhw&oe=6A9C3FE8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AXynCBpL5kQ7kNvwFmiBQy&_nc_oc=AdqT4MzROST8u5sdVvs_nrIrBXx7NOkioji6CDqaUvoj39v5rvoTJjvpJfbHeP-_TVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVmKCtmUYF5ZN2Nq3RGp1m-JQl0VKWPR24XhWPNQSLOg&oe=6A9C1650"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_sCpRDu1m4Q7kNvwG0tmt6&_nc_oc=Adp3koDQwFSZHmQ_vrqmvhHxJwzKzfmM7NIyQP70hAUpj5spZ_qLWeidn2URoyUO9lA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRLIvSDOQznzArrHx6ARsnrDLGMnih9yR5V45HnlNgwQ&oe=6A9C2A84"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UFD7LbcjToQ7kNvwHtD2ym&_nc_oc=AdpzphD0j0n_3cljyP9GfnQ26vIq08Gi3F1Hrq-09ghqpKOcAdxC-mUCk-Qec1Mi3j8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8-dvPKUUk0lVUBba4Vy-Fu47Rpevd1E5uAHYtbhRRkQ&oe=6A9C2332"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq5_2Y_N11YQ7kNvwGqF57B&_nc_oc=AdqXqw_fRkCqmqM2_huvPBXkBcXNqDUaQdsUF3kBK5GYHp__FEEn1ozDwlR0GSAhaWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFvCCouNM2lK2dNd8r54on75CNrWGc7B0GzE0JZmKPnA&oe=6A9C1A8B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1THZbARIoQQQ7kNvwFXz5yx&_nc_oc=AdqW8CWsQXGOpLq8BUD6XjWDKYVBB3jI8vSKEbH_CaWL01wgMevD2mNa5qRWKhToH8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb60w1JV4rqgVEB-cqlcofp3BIUGeIIErXVd64UmN2ig&oe=6A9C20EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9HSpBy1YZAQ7kNvwHhifE
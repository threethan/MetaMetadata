T", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGBpwhxPhEoQ7kNvwHvBusj&_nc_oc=AdpQ3u4sYxLeZLWCa0vGqMpqomh7JHpRYYk_vwPgKVziZwyZY1RmvMkj6tO92qhMAEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOptcpMbNB9J3ElVmaUwbcPOBFxtEU_I0WgkUqAKhJFA&oe=6AB3CF4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTt70X7jEakQ7kNvwGDVWlv&_nc_oc=Adradqnr5g0EktEFcQQdhVA8Iif7ZpJIb-0gUuGWasItmh7l5I839EPZkQOVXqPgkhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZFXbQ4XTwyxvpjDOo95yn6FglJGncp7xBsk5jLJ4i4w&oe=6AB3C2A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkPXmhp--9oQ7kNvwEF9Wxc&_nc_oc=AdolZRyuq79u1bIElXhshEvbv_97fRNxNM2COpxdSfCN3QOzcqPNoG_EOcwuHSUR-54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkuHgyrgQgwQ2yQTXNMMwBPUxGQCM9aEeDJfBjp3-qgA&oe=6AB3D150"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaerwleT7BYQ7kNvwFZooHk&_nc_oc=AdrElqgQs589p37ZU7DSoQj4lQY6Ri4eqDIqbvTeXQDpU1g5T0GSr9VlLgQ8GTD_ycs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEbOVJOU4WXsKCubz88tsDWoJBV0TWvOwPpMoM5UrnWA&oe=6AB3E584"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_-k4nG53D4Q7kNvwGjw2q8&_nc_oc=AdpZHWDuVFnPSwxpiYmPZDdG9SravAUhuVaKkIt12yDWrU5MJS-PuVpEbwkRtQ8I4-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILbdu4AHvEVx_I8aqYoh_gs_9dIpqYIXGiaf1VbEG5Dw&oe=6AB3DE32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lo4JW3MfGLYQ7kNvwH2uWvS&_nc_oc=AdqWs7eIUkQZtCVdP85mQBDbfjrD1PEq8tZ_PpE2J9W6XNt7By4veXR04Le-JZT3myw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5e06km2RM-AZ6DWHZVdV9RVbCMEA3qjC-rqI06istVw&oe=6AB3D58B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56SapajXdv4Q7kNvwGGMDDA&_nc_oc=AdqAAgwM1ayoFFJYL6aDx2gHnl7KzQ26hLJVOsgzzrA5ySNuxstziqhMP_zUgdFAUkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMwV8-PUM2H8TIuxxmaAofN8U1Gwr0OlcDi5kxQAbs9w&oe=6AB3DBEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4YbfSTk034Q7kNvwE9DIA
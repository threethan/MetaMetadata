T", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ssBEYHuKV8Q7kNvwFAoMXk&_nc_oc=Adqcb1WVivmBfQzqCI-4vW75q3Ot6T6OGSNb14uJwMucr70Ow7d-TMQpeT-w-GOem88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESa-WC372HnmQ3pGfiw1BCmX2qMoGXTqc5Eez5yzaXLg&oe=6A8C424A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jIuoU69M2cQ7kNvwE_mECK&_nc_oc=Adqqt9QEcutVROAA8xy0gbZhWk-W3Znxg6svGyP86yqnuicKpNSEdhXj1036_dbfg4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMlinp0JHJvIeyxUbvP7LjFPkGBkmy29NHPaWzZGlWHQ&oe=6A8C35A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DHtnU4sIagQ7kNvwGL4MCW&_nc_oc=AdpZcYqU5Ro0E_bii5BXeoJ4kgc12Iq3tkXV_ZsKYBEosh57_ciI18R9jSP5MM6y4Ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG46bWJtOHTX8hz5ozaIHyjmcSqkYKRCdhi1pDv3lNwaw&oe=6A8C4450"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG3BJmf3s-EQ7kNvwEo928Y&_nc_oc=AdryznNdKMsZf-e5jLD3IcaHh7ec0oDA_i4L76GF9VwfXSm3CjEX2aY3v4jtWiaPUJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGH-b_TP_pB-ZBZXEkP6HU_QrFX9utmpIkP-bI-CdZ7w&oe=6A8C2044"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rs8ccCgQGTIQ7kNvwH2lAuj&_nc_oc=Adprd-y1ry_LO-qBL4R_0Kw_iImK0QlbcJMqMHvydkT5KVbCLcWWupctutNHWr9pe4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUEVVSj_smYR0fs6LMYUgOKn37qikYHj4GJQTLOp2SsA&oe=6A8C18F2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_U6CZ4uyK4Q7kNvwFpHHxo&_nc_oc=AdoynGHb9ZIS9n2W0o7QQjJSsXrHaPYMuLbLYXCh4Rn1GHYW-M3cxBXpgodpxAPvD8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFootyT3hPlkKmC9WyHd9ywJNWrHoRlaCatzH80x99XYg&oe=6A8C488B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyYOeg1JilsQ7kNvwHqvrWd&_nc_oc=AdqFWqJAaonpLN5C9tmV5m0wywZJke3_TRILpc6KU-kJAwyIQm8NVlZ7ryDltfXfkp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC8D1aF8xkKuEgB18wA4DGLsJ7MWH6laiXP7pZ8aoFCg&oe=6A8C16AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCuqtjw-CPsQ7kNvwHt6qQ
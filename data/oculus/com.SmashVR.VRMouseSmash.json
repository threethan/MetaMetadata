T", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tl7hX4yq-H4Q7kNvwHtRbqL&_nc_oc=Adq09sQVBc9JDC6ueJR_0C3trOuqOnEyzwcYbfsOmbC7AOHwIKCm1XY8sb2uaREsKZ8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR1JIv1P3Esm7BLXHYZmNNzGwAzW3-ibhEyerIcon3sA&oe=6A973ECA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az43BwB1GYMQ7kNvwG4BGTb&_nc_oc=AdqpS-b9y9cSFLUU1-S1ud2cJXBFdo6MauWLwE0nbzwfQK0oJz_x7LGWbc0c6Z4lFuU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvWl7EpfV9IduoMLuf3kysFWZvbl05CBHZXYWJ4Cs6Pg&oe=6A973228"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCggTDUu8qcQ7kNvwF1LdBh&_nc_oc=Ado_3LVCZ52FeRRVbd5TOC0sBWYaaAnxffteGU8sw93GwLxFGBt2lDdg9l4P1BADncY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOL4MmaJTeP1sEMn_q9noeaKZlSzyxlbTzfgb2hEswEQ&oe=6A9740D0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyztO8XYdkoQ7kNvwGDTRaO&_nc_oc=Adrn5ZYgbjbbJIcqQgZCCvstnXeYFH9V2Lj8EkVx7829IT4IYOtjSlm5ToIe_9VSfU8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKSE3ieqFJWDfGnfx444-E8F8bJvPLAgSZGEWh0psN6w&oe=6A971CC4"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEDLDR-2T4gQ7kNvwESRge7&_nc_oc=AdrJtG8LbMPT9bM3zsu5J3xrsD2SW2BTFsnUqJY5AR6VvXnXH7IvO_I5zeXDE1uJNHQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfu8CIhiz6NEe2OspnFLd2ONm9F4HiQgzZF083JORBNg&oe=6A974DB2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYhcmNWsG6gQ7kNvwHBG8HT&_nc_oc=Adpc_qRk-ni9icR9TwaOPf1VxEnI069TOmPhwoTPIVoPn-4lHmleIPIyQEt8zsSedpo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAzxkkoU5f_izuo8VqG5zn87J0fJVsaDzuxywaxJH-WQ&oe=6A97450B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M84UoEyZy5AQ7kNvwHXcLpI&_nc_oc=AdqDtz_Zlgc5U3CNm3XZaRRBIxO4lXWaUTDjt2S6Q1zgYrQ7tkuxmQJ-EPVhge5idjE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu8XjwTgNhKrffmXjSAI3Btd8Cn79h1ZA-8CH7IRmNEg&oe=6A974B6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR4Si8ENzw8Q7kNvwH0KrY
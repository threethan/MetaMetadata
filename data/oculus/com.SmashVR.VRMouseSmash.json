T", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPMN6VTsV28Q7kNvwE9oIsX&_nc_oc=AdptWfN5SmSNlhkibWk8pYtYWVzr8VsdEN77KWZ66MoimMcOuuBcEV8lEOc3aR3RsQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QwvcRH8V2IX_-gih-j2xSMWbrX1l6V1inWyiK6D94IA&oe=6A314ACA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xREyS9vPckQ7kNvwEDQ8t9&_nc_oc=AdpjRyUDvX3SlkWXQ4yGnMDDb_kSf6Q5LvZKA7HzzGE7hBgG93pVJi1k4MU0MuZxMSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DUzBh45oTL8mwUke3-VwRQhoZuU4dzVOEi91buaFxFw&oe=6A317668"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KW5OI3zmVmsQ7kNvwGeGugZ&_nc_oc=AdpsJzJJeYni_HSYfIKOBgN6ACK6c20P_QvVDPRt0wVk9VRV56brr0-BQw3gQj_EOe0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PD2Da_WJIGOLgFSS61VwHd8zWDok7CkLNRwJv0J9dbQ&oe=6A314CD0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ1y8JxNtyYQ7kNvwH0o2t1&_nc_oc=AdpP1jzyI-NNlIoMTMwARSEdI1nk-GnHdlHo-ZjahlsisBYtqG6lQrqdN7NM2C2dbxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lbqnW8mGpQ8HqbLKcMZz8crcyAlGvWlPZgTeBLjOr6w&oe=6A316104"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p5Wz4xfCjcQ7kNvwEcbv-f&_nc_oc=AdomDJihihE1QB1aBJGm9AACl8zeCeLmAIBENoOiHuJ-dUQZ4qPyL_P_QgH04i49qic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j6ZemeK_HGmY1cpMklQdRr-B-qi6xtiMFfCp2jP60Kg&oe=6A3159B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufvsDO6ZVQwQ7kNvwH8HdTT&_nc_oc=AdpjcGaIWS6Mp2YQlELR-_zzHzWzyjXkjoeCLsm0GnJNXlJYwiTamgHWhC3G9hLQcTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QtJsJr9QfKPSXt6fR7B6Ggr8Q78A2-hZFXnvELrnvng&oe=6A31510B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0ZG6Nk3eowQ7kNvwFY3uTt&_nc_oc=AdoT-6eYayaTHnZHRmK1oh1fR9m-u0bXwXgfiCEhSeAa4c-NqFDa2xGupqndRsDA_Kw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af980_3wfatSpuTBGbpUjYX-dGM1tiFs-UAAAJFx76dV0A&oe=6A31576F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQiBr5t2vPMQ7kNvwEIHa9
T", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCz0hZcSUnsQ7kNvwH7w6Ju&_nc_oc=AdpgrspklUWm54ah55lcQWJvICdly1wQ47iDSgedCfLHXHzjeToi4Bnusx42lHbOxPc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgRIYf9DdLAfAIxtnt51eiozWRP_MTixOZ8vAYzUIaWA&oe=6AC7CE0A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VuyPEsHhl4Q7kNvwHcjteP&_nc_oc=AdoiQRCawe-t6ghjc_PUGPA8o0RNYEss02HbO28Um4HKpdSZT7J7-JM9TfXnNP3T40M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE17QbLNKS6bYHCX8sAGtnSNTlVJ3_xbNmt_Ecf5EiKg&oe=6AC7C168"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7HXoGSKzDUQ7kNvwEKnwd0&_nc_oc=AdoZmgM4i2Gw6GCrBfRhd5rSiZxKXL4Wb_oqk_49J4fhXbJtGNdfbKyOF8OjcNAD7gQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1WZb7X_qjoJWQv4xbJPFxgyrfvmmkysR1BzDhVTV4OQ&oe=6AC797D0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89f6svPPJuwQ7kNvwFjnt9H&_nc_oc=AdrweazljPNEHY1lOaBqKOVic9OH6dybGEsdfwUt_Xwftfen2TvykLnZ4OuAhcxn2Cs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCnjqd_fRTzUOdFuDOEpfwCp2kTmTaJTRhbKDqb_k5wA&oe=6AC7AC04"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht-Cm_OnGNEQ7kNvwEIfZby&_nc_oc=Adqz7ZWNIJ4hi_EKQnrHuMpuKvzmKOILtrDmxL9BoDi7v_xBWEXe8iq2eJs2ASW5NXA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpmh8DlKzWKVIujbk-ObwV7_5hMO-np4IU0Pg2ydpedg&oe=6AC7A4B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlNDFBYj3zcQ7kNvwG5D59E&_nc_oc=AdqVZIzcJulRa8ZM7lhXv7brYCfW8zaQ40EBCTcfdtuqo0EN_Se_g-NKd9PZg3jupdM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6eulgzERa6eHl3boswVLUDwiS5wdrTl-iLQsLrF9i8g&oe=6AC79C0B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYebZ5qWOcUQ7kNvwGj8Eiw&_nc_oc=AdofkiWlZjyyb683ypAFB8K5q1YG2mRRY_5Ya7DER5CtMWVjxz1QO8li0Jd6NwXQigM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBX-0t-CUbKw_6on9K52m3OxJkj7mtFaIjQP_tU_LrTQ&oe=6AC7A26F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVnWbzGaoPAQ7kNvwGkc8c
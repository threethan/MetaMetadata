T", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ra_ys7jJY8kQ7kNvwF1HK_7&_nc_oc=AdpAD7JZ5WARNmdKOwDK8QCM7E6488qdnTduo_fHkiUiPagKFx85sWFuPsgs-MblGZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWctlu5JZuRLPrVAAJd9VDbWN8fHz4-rz8f9S82YHG9A&oe=69C3DE4A"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqPZzAYOfDYQ7kNvwGmA1CC&_nc_oc=AdrxnS-1V1AY5USTxNN7EBVEaFMh8Tv9uMwAOatVFkPtCvyfMvoxjgGCbVeXCfd4gKk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1K6kF5HJK2ODWFArJu3nPdrI3Tj8MroDTAt4aFiMTUQ&oe=69C3D1A8"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNYh3fFDlXAQ7kNvwEFQALR&_nc_oc=AdomyBdsn8fAnbmSk2rVYieZlWl0CjV7rCK6DabGgvMIJooPs5UxznnJL3to-8qpSsc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz184KXpzzQaJhUy0LtcNjA117uhm3eZVPZpcOg28cW2g&oe=69C3E050"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4RP6bgT7uQQ7kNvwF3ufie&_nc_oc=AdrNDnUmncx2ETgVAuraHHfROwcQpVS6S_mXcL5cvVU-HwBXzGrlRKRNKtEl-CUX0JE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSawFLck2EjlOe31SILGdYATZ28HFHPzTbbCvxWqzjNw&oe=69C3BC44"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogM0mq8hxUQQ7kNvwHNeD37&_nc_oc=AdpsDX3OZbU9TQe00jP_wTArlIAqJXscrgCR25aYTtKyDJERhwVzWUIlYYxzsN_D8hI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAWHczLCoa_3vDmSXsMO7Wvh0NlbNfJJ4WA4UEg_3cbA&oe=69C3ED32"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRONjeAUNv0Q7kNvwE1d0zz&_nc_oc=AdpSNo1D4r9gsxnqOCu4-MxuqshjLTgpQeMuNnONIwa9CiPvop7-iVfOqttMIcj13Us&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxW7xbO0GeI7Fjw3OxXFp0NUcJfWFP70x2VbwCFeRVFoA&oe=69C3E48B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-usUzKimBjgQ7kNvwFcMATn&_nc_oc=AdpmYB1KJhc_7h0A12d1otirq85GyMRg1a9MPerd8xO0uUEdEHR_Zmjklqa1ZXLldT0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqYJiKDWg99ANrfmgWFOdPCCqpbiFdiaALoHjPk0f6Lg&oe=69C3EAEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHEsGy9kihgQ7kNvwFNi3n
N60oQ7kNvwERx3Xo&_nc_oc=AdkNzwdK6rjxBHr6ndeHKAX9a1K47iTbNnlY8lNkirBw7V5ASC0WehLUlK27uv8xeLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjLpK194pHMM8EK09al0ZSmURZGkIv1eLfgGXKGLj-Ug&oe=69B026B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZvbgoJsfjwQ7kNvwHZh3Ik&_nc_oc=AdkvKduyndUVqrbhTrb9cbnDZFCgr1hvTSTa1hOzJBgzjJHo7xwQjl9ScWDjI63foS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3UVgH3lSXubEnxnhDyKjETqV7KElHOnpfDk7b7ri6Tg&oe=69B01E0B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II8PczG2_7kQ7kNvwH7Zixd&_nc_oc=AdkArnQOvj1x1vwdt-gAoQZOcvx8ix1QmTUUhNJNn5atWe3fQ_Z8s1sO66ZN2nDT8-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRgcB-hhmNqYStrSF3llHmlK-gtCX0pGaj_OKtQCb9gg&oe=69B0246F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQev8aj9kcIQ7kNvwHDYxL5&_nc_oc=Adl0P0SUiVNl5PVpDY6oElt8n2LtJku_bmTBTSu
T", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvWjItIFz38Q7kNvwHXOCRv&_nc_oc=AdppNVSrrxcKQurmu1uVNAeDAMYcW84QvCjAozSwGm6g1l_YF98eQDRPqYoeOD-LGcc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19qNm7xi1okVNMo66PmJjWz2SO4AOspy9TTZGqaJS80A&oe=69F4A5CA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c7rLzjb_9sQ7kNvwGjT-ee&_nc_oc=AdpNw789xm0s1LlASMJFCmgHDYDJHkqDQ6Y1RWHYGjsFNXh1MqZ_m_zQGjGPdEDn5pI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1M59QXrC3J0FhEfknBQ5YBqyTeWTXowM86b9IGS7brww&oe=69F49928"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvnFTJEV2YUQ7kNvwFYmrBH&_nc_oc=AdrjdAIBukPSsJFbQxMCsVcjtVb-OW0YxHAqIlpFjy6_KAFc56UwdYbcIZD2xLTBRuY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2N1thBWewf1xD2QNbCuq_Sd_Ti84o6ris-AC-52NUWfQ&oe=69F4A7D0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTZjvlDAR2gQ7kNvwGKeSWe&_nc_oc=Adowt5wHKb06uOH6kmdCHVtlo8gBsjOr8Try7YPOkVv7lL-xJjGMdzmfoClA5ksJVAk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IkBq93yvX1quWE5riuAH6VjH_-Ey3Ii77TzxTw-28jg&oe=69F4BC04"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89fhql5vuesQ7kNvwH3ghem&_nc_oc=AdrkwV3XmeB7pIDcEirQt_L5gYfjpOENNpH4jvNSM_wvD0QhNfL_ThG6TC0eJcM4ErQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Au1jHafZ-qW8zZvDyz9Plh5UNkO_Aq-t7pg-hBl1omA&oe=69F4B4B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UaMKrEIT-4Q7kNvwEKN7-h&_nc_oc=AdrBcaVJTlYRNvoMUycNO_I-96hnl7rjMScGbSyW4MRSPnXtSmhJHk9qXeU0yFMXNpg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RJaa9DDmxD7YA4xMrNJNrUKVGjpB6upUX4KlvBmC1cQ&oe=69F4AC0B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSH_lDw6DTEQ7kNvwHcf5e7&_nc_oc=AdqO5ISUQDHNTLhcWyKZlDng5VWk6dPrFhJuu1OvEd6J6bGRJdfqPbX5K4x0FbYlZKY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-Hc6dDsLCkjRBhLNaexQE51vbjEjrEFmjAUrFN-M3Ag&oe=69F4B26F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zReb-6Uq6T4Q7kNvwEota-
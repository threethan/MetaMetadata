T", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stNlSDKSgdAQ7kNvwHWP6QF&_nc_oc=Ado0GITI_4qB4ryx65MQHmhzmEWAnrYG2367oANFxNqZOWQL6k32Bxnx3Es6sd5W_7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGZk4gvATIc9HZGXuPpNRoe6AwztcIr6QCEctb_sJWsw&oe=6A68A9CA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt6qXg4jAf0Q7kNvwE6c5L6&_nc_oc=AdriFTcQ7lEd5WuzrGzd8_ucLCfnLTZfxe8YJ4mwehV4rq6rxX5p7Fih-r7DmLl96FM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDblJknPo6OO00yj_h9adKHpquBiguShPglP3iyI7vNXQ&oe=6A689D28"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN3JkZzoK9YQ7kNvwEWjvv2&_nc_oc=AdrAt9IAwsPIOtnWnOmbhAjSKruC2LuIMMTbBe58tIpsNTSXMHXvGUKvH2ylyYXS2II&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDScC_snxk0duSxH0hgdrl7CqTClArqtwJDcgXIa0PONw&oe=6A68ABD0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd6r0E7JBwsQ7kNvwEXtbZJ&_nc_oc=AdrX6xc8kWR5GksmIcVPagZFeViYF3gX9m4a-9uzUbDRBIoh9QjpRcW_oySpBYTAZJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjwn1oYOeJuidBYAcckwZ_Q4PFc3DIu2ciX7pqHqvpnA&oe=6A68C004"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3y-aBnKIvsQ7kNvwH7bMJW&_nc_oc=AdpvYCtrFtYqEDfAK8QPR-lLzM_oMuJ_PqrweUJ_1nKjx_dL76UZhqSrM25SX5q35sI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNuc0tDT6Vf65aEhldjokjnRuN_hiLQAMKN4NNay5FLA&oe=6A68B8B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrstV0Ov2d4Q7kNvwHTLmJ-&_nc_oc=AdpIfC8CDk-wT6JggNIdNoqyVKXsfTQq3fq-6xBCWXYnCOWg635Hh1y_zK5g3l70wNg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_IahCNvfC-1mkQUnk_ce9Yc-T7JTCIWzRZ2SnB0J2nQ&oe=6A68B00B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf8peg6PB8UQ7kNvwHb700x&_nc_oc=Adrr4fVirpHMzoxVXF7YL-KaujX0kP67ZJilRz0M33ZMvszybZBaAikrZL3TxqHs5M0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyxP5cQPOq6P1qxq6XZw0nrnG8sMi6s4o50KIZgxznsA&oe=6A68B66F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFpbWS7vgA8Q7kNvwHgVdV
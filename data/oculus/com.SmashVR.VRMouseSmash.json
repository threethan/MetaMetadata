T", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JrTfh1YH3oQ7kNvwHINoEo&_nc_oc=AdpZeoSZtFMUnCn6oW4MGpdjJp3v7DBGfezGT6cumDmzbMa6lzrHwG-FWD9bWvbomvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuM1UZUPweKf9v29WbGchI0q3UB0dRey9FvV2xZApTgA&oe=6AE496CA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WA53HUu6EwQ7kNvwEvuUU8&_nc_oc=Adp5UC01WeS3_SOzk8GygAoi2kNpofLlpzFKWkH_zINP8Q54jRimFO9B4rPNz3O6ecs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn6vAFtSdlhi0j2QZ-oypFjXkzS0EzKCKq1uKm_R2wIA&oe=6AE4C268"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpcLwjvVJtsQ7kNvwH4kXus&_nc_oc=Adq41Fjj-PjHvHUbuyIoEkPLXqRc04P3B1qNvf5kFJxHLN1PSPlwa3wxMn4XPXFEy5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6QUbUIa3u0vk7xbEHI6zSyPbXx0vY2El1-XVdQknP8A&oe=6AE498D0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP9P5CY3OEoQ7kNvwHGurIO&_nc_oc=AdqZJK5j2SDAyYsX7URZdZlGQhe3ctFr6yxZh_3JnYt8B2hIcqGS50CX4vjZX3fP0Vw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA1_pF7Sh1gSnAvbt29q7OzWC8XEXG5DPePg2ZLf4rug&oe=6AE4AD04"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB4-CLZth-IQ7kNvwGQShDP&_nc_oc=AdoI7mO28HHeFfcSakp05g3whPxn1vyFo0pUz2e0M_TSpMk3aUY3w185YI0z0qylXh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNqjsV-IX8yGD6vDt4a4HYfXsXcCyMp2vqiVXUUcpH8A&oe=6AE4A5B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysNVw3yBbbYQ7kNvwHmsuaV&_nc_oc=Ado0LU1Wd5rGleO8xG1wTh-KXcXA5lmZl1yRKbW6BGvMKHcUj0NTKGwcKUX-gOlAPSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoZA6CbZkj8PlYY1SVvXf2LnXPrLu_0VeKeW5llWNZXQ&oe=6AE49D0B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2Fc7iF8DsEQ7kNvwGhPbYJ&_nc_oc=AdqI8khDAw88Ol5PN3ICpSDPZz-8dQjQdrvB2iiIP7cvFvrmuYFGtzR6o9QH1A_2Skc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM-vcoN9Cbg1RUh8tvlw5oOyh4CWnF3G7p_D2TP7oucQ&oe=6AE4A36F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGCjNRApSSUQ7kNvwG3IY7
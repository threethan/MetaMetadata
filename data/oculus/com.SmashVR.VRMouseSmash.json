T", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHBUnOkslGAQ7kNvwH-5nTr&_nc_oc=Adozo7evWRqpF7YNo-lcLsesB9GClhWABTWrybBsGZjq6_OBCQYLtWiEWDeFZec7A2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9iPqBaVefC0-fWBUYKh5vpugLlUt_TN8pG5md6kZ0pA&oe=6A787BCA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkH8Ozp1Ig4Q7kNvwGHLkAi&_nc_oc=AdqxNaXVSRJ9jhuytor9IQAWDXZNMQpxFz5xGB_CAxvdynkndVlMluDE0lE7xwQ4UEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhNtTR-DNWCUP-zyvPWA66W_dSWgzkpGsNqCsE93pSKg&oe=6A786F28"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z158exaKS1AQ7kNvwG8baeA&_nc_oc=Adrf845n9QQuKNcYs2NoNWubHnNKyezOAztXprPhC3k1r88f1YEaL6JbgihamProFnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLzBiy3ivGg8qHmATlktOTmXsD74k9ZUNaIeo_oFOHCQ&oe=6A787DD0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uts3qdXry_IQ7kNvwEyCLFe&_nc_oc=AdrPT-vci-M5ptRxMsdwCVYroSYWDAoy0M2GJJ6S1HIiULKRl0EVNpDW7zjL5t0EspI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFj1DW8_jQMSCs4H9RE4ll-DnyEsk52LforM6r-I5wRg&oe=6A789204"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y0Pi6qf8U8Q7kNvwEaMnGQ&_nc_oc=AdoqBCJij8DKUu0mhQO7aK8bhxFCoUvkQ4C9xHKde0b7FLGQdnRBwGIUsEAsqyLOMbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvi1qb0jYIkHEudq37w3wpl7Y2g2ON6y41xryEm5B3zQ&oe=6A788AB2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4_M8j6V0lAQ7kNvwF3txI4&_nc_oc=Adq3995xAJU-hQjXSGCNjfpAsq5zEGWMrnZczBeK58o5Hlh0vUXBV1yBpDu4nlZVYVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM1D_ONyNxDyBEyHY1GWdV0WhOeHjvvgX12PqL-NZXfg&oe=6A78820B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDQVrlDfEGcQ7kNvwFxyRMm&_nc_oc=Adqm2ZIYg59sOWjGGi7qcY_muD-3714pYOcMHmDjxgdux1H0ZqZgz1xcbL6cr2Q3pkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2O8shvyZs4P6y6ooIxSR8XWlhGgU0ZEniPceOmLg1tw&oe=6A78886F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4q5OuYNIJi0Q7kNvwECea1
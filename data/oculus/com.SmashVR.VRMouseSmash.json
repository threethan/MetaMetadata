T", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK91DKZaqjgQ7kNvwGzi_Ku&_nc_oc=Adp6vOfuLQ2vkySoZzP6WTNSWDN_EmVn31MirJ_ItLGgV3u9VgcMn67O3OH_Ccmxgps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rIyBFBoxzXXg_8d0rPQkwyvUCXX2TQEJaHe8DwzMH0w&oe=69EA19CA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1W1h5-fJQMQ7kNvwGCf_Fl&_nc_oc=AdqLktORC-udh7_qrbN7g_NWboiGQ3jc2bMkGMUrqGZFXLpuF-62JUFWUWYnE_gLmmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QLNbNfpbXJunAaLqN1v32lP0YXGKoBWEbkk5Oh4qByA&oe=69EA0D28"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD2VqxUS9gcQ7kNvwGo-kWP&_nc_oc=AdrxglcTGtQcSumEk4rzoUW2JOUS5gd0qyZj9NyBCANDrw1sRiWBYZn8sFn9fklifNY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Q8E2Qazcom776ReVFiHPyKedW1BahICJLVyfIW7xj9Q&oe=69EA1BD0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCEE1eoO2K0Q7kNvwEXMFf-&_nc_oc=AdoTm1ycrb8r0SfmXwc5hBFVCXTxRKg-bAjGzbdLM2k71-SqO7dnwqjNLQ85OMjfVL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af206aFkIb2aO0PebgfzOt-M0BS_kZ5Zp455fWlUaiHyBg&oe=69EA3004"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D1XlzsAaysQ7kNvwEwCAil&_nc_oc=AdpaG8kDjU5fqJFdUe8S70HJADo-i6Y23OjZhpRk-67ByqpTW-beCRpsXubS94GMhbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PEux8GSriznOuPHEqzKVM7tFSxAqar2VzJvY-9CTYkA&oe=69EA28B2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6L1K9dSzAIQ7kNvwGXaaCI&_nc_oc=AdrePTFumcUwvnX6R0jQ9GozFZoZWugDgZY5n9geb-AyZI1UlTN0SYAsAgqDpQsviTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iMKHr-SC-uQ5XAoMp7iJ00qouSiRQrJPeaZhZIbRM1Q&oe=69EA200B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14pMZaiZnbQQ7kNvwEQ7QIA&_nc_oc=AdrbSIuTaT3K991pv__92YgAl_eNQwFkBuF8oHKfwbxmsYlmXZbsI4fR8hff4sttY6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tKQzlhDk1qYALqvQbmphGPhFf1A1klKXQZV_8egIXZw&oe=69EA266F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z8iaLEWYyIQ7kNvwGpQj2
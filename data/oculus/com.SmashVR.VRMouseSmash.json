T", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393637_1145702710138689_5532471054142821038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVGKWQe9RKIQ7kNvwEVZOcG&_nc_oc=AdocPqvZCQxkiHL3IelaBnwaZue8NFdK_1pIiyKlDADOM4UmgmWvDS4r9w3y1-tq3tM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38ZWOPW7E3o12jE3fq9YMoehGOTPIuhWVPhmmnQPRsFg&oe=69DF8DCA"}, {"file_name": "mini-landscape.png", "id": "612390061618106", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391894_612390064951439_853927345498160075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ0L3gqXzHgQ7kNvwFCROWm&_nc_oc=AdoiExEv5071rcqolcxKOMKkfqu6TL_1YLs-IAflHYVKOiJMOAzRd-WRt1MujUPqnC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ohNW7XD-knNknpp9KSlgLPh-bFPS1QKc6rtcX6UyGLQ&oe=69DF8128"}]}, "id": "3161585974012647", "locale": "en_US", "screenshots": [{"file_name": "screenshots3.png", "id": "1372699053763169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392148_1372699057096502_6479661041700376531_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMWpjDuEWakQ7kNvwHfeJqd&_nc_oc=AdqnvtDyb_75Bh6faD_tPUcnRBkjmiK5MQg-4uzZaeEjF4YP-nb_Pm70XWw32X8wYZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Sj-iL0ySVGMhzC0ezw1dv5X0DPqys-FWvjAQBlvoOsQ&oe=69DF8FD0"}, {"file_name": "screenshots1.png", "id": "619693887710410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391909_619693891043743_7531088885023627721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcbrekABtRAQ7kNvwE9B6Br&_nc_oc=AdozosbfwjVNqZhxraN3kyi4pPRKudqYCocds-1vq6n8ZsLViY0arB2bRqo1AWrqDfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ue_23rMhO06M_m2sq53iTmdaEb2tNixM-8j3bvg6zSw&oe=69DFA404"}, {"file_name": "screenshots5.png", "id": "1170044351465185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393594_1170044354798518_6009288009920780896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE5LHYryre4Q7kNvwGEjKMG&_nc_oc=Ado5wRMsq7BTEaj2pibYjtUIDOLYt_rOpzuHcCOoFU89XeLV9UJZlMe_OYZeZvnlsMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qPw_cTRTrURR0fePfL1Eny3z1akFxjH90ciz02nKEiw&oe=69DF9CB2"}, {"file_name": "screenshots2.png", "id": "989274169246366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391998_989274172579699_1040597110251421878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX22DUF5G7AQ7kNvwFwD9t2&_nc_oc=Adoh6TpKJC6WeoGJFpL5ZP5Y_g6G5mU-8XzdE319lmLo99PaPpp0MWZeTQJEVc_oqbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08DjEoDOSwTlhBmoSh13szuPE_M2VaFCXBGpe4Q42Ctg&oe=69DF940B"}, {"file_name": "screenshots4.png", "id": "668631666107065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391852_668631669440398_1431691838644141093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUtDHd7fCyEQ7kNvwGkf9em&_nc_oc=AdrbxqXXnVmVx31AcNaL2HFh1jwbVWURC8IlNNoZe8JzR8TxrJnh0rIIdB8ksU6l3z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O_NwT6iy1cYn3NJEDKpG2JzLq4CLcVFK39hoiMnze0w&oe=69DF9A6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mouse Smash", "keywords": [], "long_description": "Gameplay and Features\n\nImmersive Mouse Smashing Action: Use hand-tracking or controllers to smash mice as they randomly pop out from holes in the cheese bars. The tactile feedback and satisfying sound effects make every hit feel incredibly rewarding.\n\nProgressive Challenge: The longer you play, the faster and smarter the mice become! Mice will pop up more frequently and in unexpected patterns, keeping you on your toes.\n\nCombo System & Bonus Points: Smash multiple mice in quick succession to earn combo bonuses. Watch out for special golden mice that give extra points \u2014 but they're lightning fast!\n\nDynamic Environments: Play across different cheese-themed arenas, from classic yellow cheddar blocks to stinky blue cheese caves, each with unique visual effects and soundtracks.\n\nLeaderboard & High Score Challenges: Compete with friends or climb the global leaderboard to prove you're the ultimate mouse smasher.\n\nFunny Visuals & Sound Effects: The expressive cartoon-style mice make funny faces and squeaky sounds when smashed, adding humor to the chaos.\n\nTime Attack Mode: How many mice can you smash before the time runs out?\n\nRelaxed Free Play Mode: Smash at your own pace without time pressure.", "short_description": "Step into the exciting world of VR Mouse Smash, an immersive VR game on Meta Quest where your reflexes are put to the test! Mice are sneaking onto delicious cheese bars, and it's your job to smash them before they escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8edbc237-17ef-40d9-bf16-eba2fc46bc7a", "developer_terms_of_service_url": null, "publisher_name": "PAHM VAN THONG", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-mouse-smash/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9228827270487721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391946_1641736576457993_7976623657549236519_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfH1KyWISyMQ7kNvwGQ9wU
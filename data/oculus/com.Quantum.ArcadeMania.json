UaCEFwqJaI1WcMTP6H_F8OgW52w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvqJ7vCzOiw5m7k6zQ9rVwp5P2_tn5-sF2EUQxCQt6Hw&oe=6A902D39"}, {"file_name": "SS_Archery_01.png", "id": "1560772989011489", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823351_1560772992344822_1438188979827468888_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohRYai2FAWkQ7kNvwEOqH-t&_nc_oc=AdoviD9oqeYw0H9KZ3hUcsEyurGTFNw0vjYe6Dn74qSQK4KEw8HDRBTu7III-i3ZARU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3c4AJgKc-xbbswHPYWenL_0vrO3DDxCxq8KrbijxwVA&oe=6A90256B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arcade Mania", "keywords": ["vrarcade", "minigames", "casualsports", "shooting", "carnivalgames"], "long_description": "**Welcome to Arcade Mania**\n\nExperience six action-packed VR arcade games in one place! Step into a vibrant virtual arcade built exclusively for Meta Quest, where every throw, shot, slice, and bullseye is powered by immersive VR controls. Whether you're chasing high scores, sharpening your skills, or competing with friends and family, Arcade Mania delivers endless fun with fast-paced gameplay that's easy to learn and rewarding to master.\n\n\n **Master Six Unique Arcade Challenges**\n\n**Balloon Burst** \u2013 Pop colorful balloons with perfectly aimed darts.\n**Basket Blast** \u2013 Sink incredible shots and beat the clock.\n**Aim Strike** \u2013 Test your accuracy against mannequin targets.\n**Arrow Blitz** \u2013 Hit perfect bullseyes with realistic archery.\n**Fruit Fury** \u2013 Slice flying fruit with satisfying sword swings.\n** Bottle Bash** \u2013 Smash bottle stacks with precision throws.\n\n\n**Why You'll Love Arcade Mania**\n\n- Immersive VR gameplay designed for Meta Quest.\n\n- Six addictive mini games in one complete arcade experience.\n\n- Realistic motion controls with intuitive pick-up-and-play mechanics.\n\n- Improve your accuracy, timing, reflexes, and precision.\n\n- Chase high scores, complete challenges, and master every attraction.\n\n- Perfect for solo play, family game nights, and friendly competition.\n\n- Vibrant arcade atmosphere with satisfying physics and endless replayability.\n\n**Ready to prove you're the ultimate arcade champion? Step inside Arcade Mania and let the games begin!**\n", "short_description": "Step into **Arcade Mania**, the ultimate VR arcade packed with fast-paced mini games for every skill level. Shoot, slice, throw, aim, and compete across exciting challenges including Balloon Burst, Basket Blast, Aim Strike, Arrow Blitz, Fruit Fury, and Bottle Bash. Play solo, climb the leaderboards, and become the ultimate arcade champion on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.quantumarcadia.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Quantum Arcadia LLP", "support_website_url": null, "website_url": "https://www.quantumarcadia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1181756825017139"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623601_1053246930444457_5716686203933835573_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-tZLMEShdcQ7
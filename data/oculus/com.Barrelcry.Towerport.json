HDrDJFH1B6TpfwydtC_heNWovI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBED8QZfO_tigclkdCOW_tgp6SzUELTYuZHUblc3YfSHw&oe=6A6F3B04"}, {"file_name": "1.png", "id": "750161646044233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974738_750161649377566_3563633512712430094_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDxoTUEOXAYQ7kNvwGPMhwi&_nc_oc=Ado6PlO6nS97Ls-l_imIUgRN3QWNd1wLtTdyV6S4Dak63UVHh-0h0OmDn_rcias3RgI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdoJkiwZ7c0ti5KJhOUZXYhM1IfPoRM3cQGrf2aP4Mew&oe=6A6F58DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "2750851408402099", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035421_2750851411735432_7352797990750624422_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm-kVglHczYQ7kNvwHJbw9D&_nc_oc=Adq8heMv-qh210iWxI0L5Ignb5hZ1iqHcbYjHi_QDsxCF2s17xXbzFy_wREDo0Kc9tY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv76Dd7u4SdgA1uhanrGgixPPEGhenRWXGQpfQkG3UwQ&oe=6A6F5969"}, "display_name": "Towerport", "keywords": [], "long_description": "A VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! \n\nSTRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.", "short_description": "Towerport is a Tower Defense game where you operate as both general and soldier. You need to build your defenses while also taking part in the ground action"}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "776717013567651"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "609255620605567"}, {"status": "PUBLISHED", "id": "446570603912741"}]}, "baseline_offer": {"id": "609255620605567"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1662995640, "status": "PUBLISHED", "id": "609255620605567"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29473349982313763", "version": "0.3"}, "id": "1108424596427487", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7805743412834399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "294733
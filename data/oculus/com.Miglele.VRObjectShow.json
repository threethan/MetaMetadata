ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwCfe3qE23gQ7kNvwEQj-cb&_nc_oc=AdrgRJQHg8lkSF5NnyJO9atVeqyK88lITXfUVSdxduPdhdzfyEf09EyE7VTAP7x6TVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTHMlqctnyalVVbVfeaIA0oU3igJdGNvNwqkjmboBN3g&oe=6B0F12A7"}, {"file_name": "switch_1440p_16.02.2026_22-39-54.png", "id": "1433513625121129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295272_1433513628454462_3302509179042352396_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycx-iveQnAsQ7kNvwFbtRp4&_nc_oc=AdoKn-4VpnLZL93RepPzv4FnrNvoc1kFVRV7hLDtEe1B1GRuXX9aM3-L9U11B1ozYRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeqlUc-n63l6vkTrEtgz2PsCN87EoUnPsNPzGXcnb2PA&oe=6B0F0362"}, {"file_name": "switch_1440p_16.02.2026_22-51-28.png", "id": "34141214158825861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300910_34141214168825860_2819536805258660503_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjS_8uzsrCwQ7kNvwHxTU7A&_nc_oc=Ado3fZv3674HrKj7zJ8bYaRjoEixHhXE_3MjM9hBsXSK6xtVH1V_GxixpHTZj-4U1ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0z88BTOlIwDP_QEcrSfgNG8WvgbRKMzAef0CjSccWbg&oe=6B0F0211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled391_20260218001219-upscaled.png", "id": "1242821364007273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307339_1242821367340606_257878778568831300_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4_pMExzO_0Q7kNvwHQLRlz&_nc_oc=AdpR0QcdE7ptEEm72rtLwAUDkE-kx84nZxqnZIynpXSBVy_7xzjDY3yC16eyumpmi5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjg7AJ4ZBik90m2786PpVJTh9Sz0zf6mzwb62MWVB8pQ&oe=6B0EF12C"}, "display_name": "VR Object Show", "keywords": ["vros", "vos"], "long_description": "Welcome to VR Object Show or VROS, a game made for the VR and Object Show Community! Traverse into different maps, dress up in your own way, or host your own competition shows with friends or other people!\n\nVR Object Show is separated into two parts, which are the Main Maps and the Gamemodes! Main maps have some classic and mostly parkour based ones such as Forest, Desert, Mountains, Lava Land, Yoyleland, Tiny Loser Chamber, and more for you to explore!\n\nAnd if you are interested in the Gamemodes, there are a lot of them to explore ranging from different difficulty or additional maps, such as Acid Escape, The Dark Room, Big Slide Laucher, Yoyle-Maze, Freesmart's Super Race, and much more!\n\nAdditionally, you can customize your player with different cosmetics in the shop, ranging from community suggested ones to collaborations with multiple content creators, and even limited time, free, and unlockables you can find around the game! There are over 600+ different cosmetics you can purchase and unlimited combination possibilites!\n\nUp to 19 different players worldwide can be in the same public or private room and earn 100 Muns daily to purchase cosmetics from the shop, even if you are not playing!\n\nIf you are a fan of Battle For Dream Island and Gorilla Tag, you should give this game a try and leave a review while you can! Thank you for your time!", "short_description": "Explore diverse maps and dive into multiple gamemodes, hang out with players from around the world, host your own object shows with friends, and customize your character with a variety of options!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrobjectshow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Miglele", "support_website_url": null, "website_url": "https://sites.google.com/view/vrobjectshow/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696
ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwCfe3qE23gQ7kNvwHdxhG7&_nc_oc=Adql1jDR3mizLXm-7m6EueBMixXVw69qvUm9FGucMw8ZnXM5HGSjpCl3DsORziNrTHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVkBFerF889n4Ld4Suv41XRd5RDxfyv_8AwYtfSanVwkw&oe=6B106427"}, {"file_name": "switch_1440p_16.02.2026_22-39-54.png", "id": "1433513625121129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295272_1433513628454462_3302509179042352396_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycx-iveQnAsQ7kNvwHGGwAP&_nc_oc=AdqTlTEm58P7nR1HHVVmDbPaIg3ItjE_IO8R7oEC31nSKs0j0yxGrJeQ6eeLQOcRHH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXZqycDgFYdvQDLcT_XAPwJYNis3HAKFD9KgcaEqt9zw&oe=6B1054E2"}, {"file_name": "switch_1440p_16.02.2026_22-51-28.png", "id": "34141214158825861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300910_34141214168825860_2819536805258660503_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjS_8uzsrCwQ7kNvwHdq-tX&_nc_oc=Adr4VhPL0kCP3tHnymvPH4dev1_7neWESQHwVAjsGr7hGV50bbsS4CHAA_ef60Hp3kU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUV8kNFUjS9Ljz1JMN-5y145KN127NNbxJ9Mg89hIZ5GA&oe=6B105391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled391_20260218001219-upscaled.png", "id": "1242821364007273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307339_1242821367340606_257878778568831300_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWDbZE8bK8YQ7kNvwGP4Xmu&_nc_oc=AdpUDAwVCr6_m7P2tniYMfCHUb9nj9AtMtPI2R_11-HsgpAgkYgElb9ajMobhh8ogeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJgrppjqDo8LqQ6KJ5CIVayj-VMqRDH9I7_tl2VMnJng&oe=6B1042AC"}, "display_name": "VR Object Show", "keywords": ["vros", "vos"], "long_description": "Welcome to VR Object Show or VROS, a game made for the VR and Object Show Community! Traverse into different maps, dress up in your own way, or host your own competition shows with friends or other people!\n\nVR Object Show is separated into two parts, which are the Main Maps and the Gamemodes! Main maps have some classic and mostly parkour based ones such as Forest, Desert, Mountains, Lava Land, Yoyleland, Tiny Loser Chamber, and more for you to explore!\n\nAnd if you are interested in the Gamemodes, there are a lot of them to explore ranging from different difficulty or additional maps, such as Acid Escape, The Dark Room, Big Slide Laucher, Yoyle-Maze, Freesmart's Super Race, and much more!\n\nAdditionally, you can customize your player with different cosmetics in the shop, ranging from community suggested ones to collaborations with multiple content creators, and even limited time, free, and unlockables you can find around the game! There are over 600+ different cosmetics you can purchase and unlimited combination possibilites!\n\nUp to 19 different players worldwide can be in the same public or private room and earn 100 Muns daily to purchase cosmetics from the shop, even if you are not playing!\n\nIf you are a fan of Battle For Dream Island and Gorilla Tag, you should give this game a try and leave a review while you can! Thank you for your time!", "short_description": "Explore diverse maps and dive into multiple gamemodes, hang out with players from around the world, host your own object shows with friends, and customize your character with a variety of options!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrobjectshow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Miglele", "support_website_url": null, "website_url": "https://sites.google.com/view/vrobjectshow/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696
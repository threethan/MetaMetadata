words": ["adventure", "exploration", "roleplaying", "online", "fun"], "long_description": "Welcome to the Virtual Reality Object Show, or VROS, or VR Object Show, or whatever sooths you the best!\nThis game is inspired off two popular community across the world, Battle for Dream Island and its Object Show Community, and Gorilla Tag and its inspired fan games.\n\nTravel across plains in the small but yet not forgettable forest! Which is where you get when you first join in.\n\nBehind you locates the Shop! Buy cosmetics inspired by the two communities ranging from the classiness of the Top Hat to the more obscure ones like the Suitcase Backpack!\n\nMeet with other players around the globe as you explore and create your own show or roleplay of any kind!\n\nThis game was made for the GTOS Series and its community! Made and published by Miglele.", "short_description": "A game to reunite two popular communities with inspired content from both."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrobjectshow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Miglele", "support_website_url": null, "website_url": "https://sites.google.com/view/vrobjectshow/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24521061284153140"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "P
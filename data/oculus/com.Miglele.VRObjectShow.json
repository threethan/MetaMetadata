ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMi5TZ4BTXUQ7kNvwEfeXdg&_nc_oc=Adr0k2QQErjlY_a9AkUy6AqY1MmqO5GLjo_0KFwpq9UimUVO-hlhST70Yfe-HGRRjnI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrQWvzXExOwPlQpSl8nMiBvTTYlcAJV3Hiaq7HpycTdQ&oe=6AFB4C27"}, {"file_name": "switch_1440p_16.02.2026_22-39-54.png", "id": "1433513625121129", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499295272_1433513628454462_3302509179042352396_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYsctHLgdxMQ7kNvwFD_2HM&_nc_oc=AdqphP2qgcJMw06TpEjtGJfcdRfARnDXFFSkX4vGyvOtV9P--0JWQJcDWI47v4o_bXc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNMO-rQMCq646voAKKm-srmKXgAPkhEz4Rwh7vdmGy-g&oe=6AFB3CE2"}, {"file_name": "switch_1440p_16.02.2026_22-51-28.png", "id": "34141214158825861", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300910_34141214168825860_2819536805258660503_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hHrAneFW74Q7kNvwH8oKPG&_nc_oc=AdqSoUlBqelSmZLgrT8zF-Omlcq_Zf0GjqyG1by11156Eal7muGI0103e6y1P1XQ7tU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm7AlDdnl3E3q4VAPbRZvvFM42emdWxaH505UC-QUt1Q&oe=6AFB3B91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled391_20260218001219-upscaled.png", "id": "1242821364007273", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307339_1242821367340606_257878778568831300_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V-uGxVv2vkQ7kNvwEPVfP6&_nc_oc=Adpp1gJug48pprgxs__XkNmWp4Qryxeyf8yRWitsywBLfw4qv65q6DlbxtLrUfsZ4IY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5fZoq2KhLJV9zO_1171EogGlBkAZZpTaIrJBBTxCFsg&oe=6AFB2AAC"}, "display_name": "VR Object Show", "keywords": ["vros", "vos"], "long_description": "Welcome to VR Object Show or VROS, a game made for the VR and Object Show Community! Traverse into different maps, dress up in your own way, or host your own competition shows with friends or other people!\n\nVR Object Show is separated into two parts, which are the Main Maps and the Gamemodes! Main maps have some classic and mostly parkour based ones such as Forest, Desert, Mountains, Lava Land, Yoyleland, Tiny Loser Chamber, and more for you to explore!\n\nAnd if you are interested in the Gamemodes, there are a lot of them to explore ranging from different difficulty or additional maps, such as Acid Escape, The Dark Room, Big Slide Laucher, Yoyle-Maze, Freesmart's Super Race, and much more!\n\nAdditionally, you can customize your player with different cosmetics in the shop, ranging from community suggested ones to collaborations with multiple content creators, and even limited time, free, and unlockables you can find around the game! There are over 600+ different cosmetics you can purchase and unlimited combination possibilites!\n\nUp to 19 different players worldwide can be in the same public or private room and earn 100 Muns daily to purchase cosmetics from the shop, even if you are not playing!\n\nIf you are a fan of Battle For Dream Island and Gorilla Tag, you should give this game a try and leave a review while you can! Thank you for your time!", "short_description": "Explore diverse maps and dive into multiple gamemodes, hang out with players from around the world, host your own object shows with friends, and customize your character with a variety of options!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrobjectshow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Miglele", "support_website_url": null, "website_url": "https://sites.google.com/view/vrobjectshow/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696
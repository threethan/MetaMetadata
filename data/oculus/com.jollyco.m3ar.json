7a0a&_nc_ohc=zds_SrbOaaUQ7kNvwFNw2Km&_nc_oc=AdkKpHkRSrOqUNKXKD7RLIAd7XbnI0wOPbMeVzW6MZKweP7YBIXE00BsD7bG-OAfA68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunUIZRrDNO56xjDqosrJ5Vnx-A-vU5t8HuI8l0k2BbKQ&oe=69A6DB7A"}, {"file_name": "JM3_Screenshots_5.png", "id": "1176980123901068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391998_1176980127234401_3815574379848015760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztOBRsYuzkkQ7kNvwGyJ0YT&_nc_oc=AdlFtV7hI2O2twwhS6teRLQOfCSL7s_AjR_OpR_2W5wA0RgQSdOwlcQO64YiPOyGs5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuH-9h-ks6VgPTaGTEs4lNcmAsjnaantli7JGyFK7MZ5Q&oe=69A6CF8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jolly Match 3 AR", "keywords": [], "long_description": "Experience match 3 puzzles like never before in the first game in this genre designed specifically for augmented reality! Bring puzzles into your space, interact with the game board in real-time, and enjoy an immersive way to play classic match 3 mechanics.\n\nKey Features:\n- Match-3 in AR! Place the game board in your environment and interact with it in a whole new way.\n- Fully Interactive Gameplay. Move, rotate, and zoom in on the board with intuitive controls.\n- Powerful Boosters & Combos \u2013 Use the Hammer, Unicorn, and UFO Kitty to pass the levels faster.\n- Build Your World. Unlock and expand beautiful 3D dioramas, from a Wild West town to Venice\u2019s canals.\n- Seamless AR Experience. Watch the game blend into your surroundings with smooth, real-time interaction.\n\nJolly Match 3 AR redefines how you experience puzzle games, turning your surroundings into an interactive playground. Whether you're a match 3 fan or trying AR games for the first time, this is your chance to play in a whole new way!", "short_description": "Jolly Match 3 AR is an immersive puzzle game where players restore cities and landmarks by completing challenging levels. Match and swap elements, and hit powerful combos in AR, unlocking breathtaking locations worldwide.\nGet ready for the captivating experience for both casual players and AR enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jollyco.us/privacypolicy-jollymatch3ar/", "developer_terms_of_service_url": null, "publisher_name": "JollyCo LLC", "support_website_url": null, "website_url": "https://www.jollyco.us/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9978591572169744"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4181806332141893"}]}, "baseline_offer": {"id": "4181806332141893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750338000, "status": "PUBLISHED", "id": "4181806332141893"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26688027924132846", "version": "1.0.541"}, "id": "1180912750310894", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9978591555503079", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26688027924132846"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes
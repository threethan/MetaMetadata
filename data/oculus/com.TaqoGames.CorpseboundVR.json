bie", "sword", "slash", "survive", "rhytm"], "long_description": "Corpsebound VR challenges you to unleash your inner demon as you face relentless waves of zombies in fast-paced katana combat. Move with precision, strike with power, and cut down the undead before they overwhelm you. Every encounter tests your timing and reflexes in close-quarters VR action. Customize your atmosphere by selecting your own background music directly from the menu, and carve your path through the horde with style. Sharpen your blade \u2014 survival demands it.", "short_description": "Unleash your inner demon as you slice through waves of zombies with your katana in this intense VR action experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11pzn2FMvzefXI1CQbgoZJ4qe6h-OAN2oOHnQDPZnXM8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Taqo Games", "support_website_url": null, "website_url": "https://secret-adjustment-848.notion.site/Taqo-Games-Official-Website-2ae914827180802ea420de23e9eb2d80?source=copy_link", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25379725591716852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_2063949624354425_1894635615695093769_n.png?stp=dst-png_s360x360&
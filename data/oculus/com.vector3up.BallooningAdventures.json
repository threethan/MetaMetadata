3aw4RBaquenRLsbvVRIYZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbvCo3JvIiIoHxXaP1jKnruMr3Qm9uVciy2YYU_wq3iQ&oe=6A4A79C8"}, {"file_name": "Balloon_Screenshot_2560x1440.png", "id": "468313364347519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974557_468313367680852_4533831396961985435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rATMtgv6z7wQ7kNvwEf9s-P&_nc_oc=AdqPLGgVVW1tRz9DxbYF75lKEJH6ZZRCw-MloqELweJu-k5kBtBB7Ua9nDVruMX1YuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOREjgC3SV3PZARJCjXE0Gdl2lOH2nP5c8NLoJ7Au2kw&oe=6A4A80F8"}, {"file_name": "Screenshot_Inside_FireB_2560x1440.png", "id": "409976753627506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001699_409976756960839_4786861500436082472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSo-xASVbSIQ7kNvwHXbdoZ&_nc_oc=AdqBYVUklU0Tgf7uq2jVjb-n5j8CMui6g_hbS2NtK3lkFLsk6Aqvo_ByWmEFTHY5mho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYxz3VAx9lFhEVLNb3G3KOrYHdo1QRdpy6ZUZ6pGMCWQ&oe=6A4A64E9"}, {"file_name": "Screenshot_Low_Wide_2560x1440.png", "id": "441069600581684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_441069603915017_6275985623359077382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v10S6QkvY6gQ7kNvwEWDtzQ&_nc_oc=AdoAnkQcY8I9CZLz7iyahz00x30vJIewbwwBj__wWxdxdS0X9OMCY_5r14g7Dbt1rRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy-GkOHxEP9ACFPbOU_nLPO0lugZL4K2THLKV6MxEWgA&oe=6A4A5CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "326566892052330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_326566895385663_4441488385814727431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlyestOGAM8Q7kNvwFCa5vR&_nc_oc=AdpFo3HL6Ml8rigm59BtpsE2kH4qoi0G1ZbmpBhQd-8PuIyPLQL_cdINvdFj5_it1Js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkbBR6keE-OLqeOnLWHkp2F3el0XsEooIGUsMVLfPxCw&oe=6A4A69CE"}, "display_name": "Ballooning Adventures", "keywords": [], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectible. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": "https://63bf4148e3666.site123.me/", "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "687425229783852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.577
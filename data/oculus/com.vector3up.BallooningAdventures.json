ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eG76lbyd0GnfvbClw_d28tS_SNPG-aACTmLJ4-xTj6A&oe=6A201C89"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0icCsZmF0CEQ7kNvwG7GUO9&_nc_oc=Ado7XCZgwK9jJYcsuq2AT50tV-Q89Dp4Cio8JtxdFs5vOpNH2AXNtDcGxtkGV9y0cl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76GU55vtkvnS8iCaP9pozU3E1h9Yyn_znHZg8YA71GFw&oe=6A20236D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx49W23yuIoQ7kNvwHciT78&_nc_oc=Adr41OrK64Kou-I8mi0yNsLouy_gdRV_gPQimhxM60hGSnqhRFczk6I8Q1iqTfp7tnI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iKD9r3dvXgLQWSM18wSIXQBvaSt_7gHuDl-VYqDTAWQ&oe=6A204E94"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
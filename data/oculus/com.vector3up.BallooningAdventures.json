m&_nc_ss=7f20f&oh=00_AQLHNhX4l0IooFFdjfZKW4coqd8Ayl1XRRANd2-R0-SxHA&oe=6A9C3280"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m-_Jgl_hNoQ7kNvwHdOem_&_nc_oc=AdrQQYoIq8nCqYtcpwZAvygLowCFmw3yrXlHm5-jmi_SVoegFBQakLPFi9Hdnf0C5-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwhjV29yun4S2j4HT4q7I-fuspiocQWEXRvYDXfvkngg&oe=6A9C30EC"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vPWZNfI2Q4Q7kNvwF7w3Rl&_nc_oc=AdqI0-BiF2r5GI0NsZaG9m4dQAsHs7STxAsxTWoKHFZm211ZVESGseN7FIBYqSDXfzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZF2Af16Rnj_qRsUVmDLzXTWX9Vj6vWA4VQZBo8_7Iog&oe=6A9C106D"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbl1IrvijiYQ7kNvwHIITc7&_nc_oc=Adrohafvy9ZV4TWd2OCvFrqPkiKG6p5aUvQ-XXg9DeaF_K3UwM_zjN-Z4r2LyWMnhgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSXxCFovmm4SUSuoLN_4Ud-HsIZbVB2xJG7vWZVl0bpQ&oe=6A9C41C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxBqhOILCNEQ7kNvwHnSA9E&_nc_oc=Adp6p9KSWi7Mwx7LgpniU_gmEHckPcysrHf3Xc66I0kF5_sqgDk9hc8_WsI8OqFkU2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHQMs-8CjG5fHa327YCUYd2UpNPYKA-RzV9yA2KHo5Gw&oe=6A9C3B94"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
ent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z41qYECU5KkKhKHqnGfYyoIyG9bT17C03y3OVbyW58Q&oe=6A0EF909"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZJW2jpbomUQ7kNvwHhdM92&_nc_oc=Adq8fZFpfQ0rvnV9g8fs-hl1wfkmS7Lz4S8D5JqI5qh2KvsG-N8VVtD7jg8TCXaIn_o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uYWzS2_Dcvx1PaNcuh0MO_R_lgoiQsPL_F4J20mNSuA&oe=6A0EFFED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rq4G0ANapMQ7kNvwGR5o0A&_nc_oc=AdqkQHP_7AaCVsHmA-IcaHdwuaalNhVh0_s7MwLp5byixXNT0xY_TRe9tAWS9aLpAV8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OJdArXH9WwN970VjZhSO9zhqRfo1tGYWRxR5fETnYhg&oe=6A0F2B14"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
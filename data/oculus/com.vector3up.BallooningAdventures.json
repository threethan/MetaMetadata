, "id": "266524951015136", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxHCcUxhGfMQ7kNvwE77ONC&_nc_oc=AdnL7VEEpI8jKa8gpH8E4QpYM6-cOGGpBh4d4wMNIEUcuRhv21ksUbHWv_jVVx533v0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvfV7byQkDOKpu6cWdCgXK4Ahr41cczVLjVzb0rsqtK-g&oe=69A17BAC"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv1jH8WN4UUQ7kNvwGlAP4g&_nc_oc=AdltwaUDxFRGmxwgZ7NILkaF6H2zkv6r2x3a6oiJbcZDLLcYkcz38bMPLvWhOzYWEbc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft0PdG6aeN8Oi8eaoaR_cnF49b4JTxBVgUwu5SHyhLukw&oe=69A1936D"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEpd6dOevAQQ7kNvwGMtfnG&_nc_oc=Adl7FcBQcz86KgPq1d5fClJm1znoViGSn7nWsk9hC02uwnfnr-b_42DfatATUoKOzCY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftU-zpXM9KR6tyNMnRUAyymzCaoPmBw9RigzgwVEYMlJA&oe=69A18C89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsp-aD_leKAQ7kNvwENGCBZ&_nc_oc=AdkTIVGwIo2sH8QARvQvcr22i_KpytVwAjJjwfqiRb1VlVvri8eA2xQosgPAWTanuHE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftnTh_7oLf9YvIOPH7OwzQ_RuxLCcz6ruG_lXOnaxS08g&oe=69A18654"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815510728704_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bud3l8_N7QQ7kNvwEmN688&_nc_oc=AdnZ2A_QE0NsJlJpP5ZsrxzvL7Z0j41rZHSQKkxKN7Xilkf-oqWOrUobj0
cOhk7WynUBx_7H3Tg&oe=699C3B88"}, {"file_name": "Balloon_Screenshot_2560x1440.png", "id": "468313364347519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974557_468313367680852_4533831396961985435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWbKIUfbNkwQ7kNvwGnHdT9&_nc_oc=AdmCQDA7F4I_lj8hPMMbfyYGGodU6zhM49IHQAFOaHdexwudz6LM4tZhfslDP2q8K9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsknDXiwmUm71TPZhZkFzu11ByBPatuflC3lR0IFfGu5g&oe=699C42B8"}, {"file_name": "Screenshot_Inside_FireB_2560x1440.png", "id": "409976753627506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001699_409976756960839_4786861500436082472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLAkYELmGt4Q7kNvwHvkhwz&_nc_oc=Adk6ft4Sh4gfIOG_A4DKFy8GVP7a__XegKW0oVaBnMV_Z2do_JqcKBlrICg939mUtKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuAhgjdCVbmCMYb_R1HV5h7KOKjixiMwq7CeeWbHyoSGw&oe=699C5EE9"}, {"file_name": "Screenshot_Low_Wide_2560x1440.png", "id": "441069600581684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_441069603915017_6275985623359077382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7XNrjFe7ncQ7kNvwGMN00q&_nc_oc=Adlst76bdYbRbYkXYyomnxfZSWvMVkh4udSO46TOyT1einrZXcTfu6wVC-ew4D3259I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu6Y8rp4CI-vscmrPMpkCoBiJuvcldIOdjcXjzOL_k5gg&oe=699C56ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "326566892052330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_326566895385663_4441488385814727431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ9THwKLtQYQ7kNvwELXYt2&_nc_oc=AdnwHMcTA7cG6vzRrRI8iFv8GpSGy2kWyTLIWUeNkcPBfG0M3v-vVv5O7KovevIvLXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsGVRMvRkGxnvTKD57Df8I0hBuQQCYnnU9S25ftDaGl_A&oe=699C63CE"}, "display_name": "Ballooning Adventures", "keywords": [], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectible. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": "https://63bf4148e3666.site123.me/", "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "687425229783852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_433307584780354_80746330162278383_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFh_7GeSRRIQ7kNvwHChNzS&_nc_oc=AdmLv_HKwQEehf1peKYM
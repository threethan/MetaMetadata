m&_nc_ss=7f20f&oh=00_AQD2F8VDuLRK8xFWJLSpzvEpaCuZxxlY8Gq2FpJ8LjIrdQ&oe=6A565300"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=004t1-FUyPoQ7kNvwFj3cbc&_nc_oc=AdoYQDCRfDK0Ej_AyfGj44tv7nLMi0G9kSZMwPo_IFyIHG6eV6kSIZ9J0J5OSvc_VGo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkBzpuju0Nx34uUgmrGve5Buqq2Hl0hRrmqyOAziNyIw&oe=6A56516C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uI62qYLiA-EQ7kNvwEKoi9L&_nc_oc=AdpKpkjVTOluJJard55h9cVm1PmMAKXTdY6b6cvLrfj0hLgBxB_8LwIiniLask5kJ9g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDvWzQMaTCbvEZgQOy-UStAAcro0HCnwmjauBUuRIIsg&oe=6A5630ED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08fCGVNqCFEQ7kNvwEV3nVC&_nc_oc=AdoFp5hTcmwD62anj-OZklrFbh81bLHU2uO6mAJmHdyE3s_EfUChMp4TQyahjcUsuaI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAufyJFHxQEieSBEJNR-61Dkr8S_C7EJPTpo0O9vOTAA&oe=6A562A09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeufM7VevXMQ7kNvwHvm93Y&_nc_oc=Adpd96vjNxEw9TkEhUh87HSd1vu2feCIP37LMPTjg-wUVSdqdxjgz1LaV_KXHmy_tKE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUDzSM0fjiqvfJb1V1uOKcT3j5IqiZzOxuumhMjxycYQ&oe=6A565C14"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
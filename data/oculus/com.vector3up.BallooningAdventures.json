m&_nc_ss=7f20f&oh=00_Af88lL_cdsjKB62bFEwOvQQGoaNQz3Cjoz-6fYTh8P6vHw&oe=6A2C2300"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aycpUbrH99EQ7kNvwGqRvi8&_nc_oc=AdqsSpFj_r1FJ1Rcz39WREOhioNGKvBd4HHY_uPB8YHLLmybHAH2QxgSppGLRqULTFA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r_dgQK0yRplhC2_koSib9HadldQ09mA8mpg0gtOGYag&oe=6A2C216C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjEjmMtsKQUQ7kNvwHJrjdS&_nc_oc=AdrENQqCzILAbPuv41RhMQGdxEF3n1Xp9-IcdXFtg-L9s3cr82xYjzUXK0zzf2tHGyk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zxariqFx9oKW8hxFOiRXRhODG2jaK3gT4RN9fK6i8LA&oe=6A2C00ED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wisny1uPpO8Q7kNvwG-XAe8&_nc_oc=AdrJyfF64Z9dYRlxMS4e6vk6qaKMdLpFObjAy9nwt0EuWRNgmqGv2Sn8MGxaulO7b2I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WucrAxa8hH457RVD3vrakjja1aPbCjoqrHF70a3WZxw&oe=6A2C3249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU8SLY7TM7sQ7kNvwGSTL-1&_nc_oc=AdrPAei0XtzMk7RAmbZ9boJ8UW5d32TzLdgMFexbX2u_LsVp4oTAn3DXaCQr1x69ARU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-itOhwF9IStph9D_LEN4FWdOV6TktGxr7MRzzaTbwp7Q&oe=6A2C2C14"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
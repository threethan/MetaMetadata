ent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqKUYb9Q0l1r49q70IAeFjWhkCKbW_p0r2saXAcBEnBw&oe=69CFB109"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6Uk0X5hutcQ7kNvwFU5oGj&_nc_oc=AdoSZZh3mb7OnXajT8J5JBI9MAL0IQ2LvPyoTo1TB0yDXByLDn9PFfUP0WhAbfsJLjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWU-Cm1NPyqzu5gc4DAYlHCTFiu7r5s17z2cOfLHqLVw&oe=69CFB7ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrShwYTfW8UQ7kNvwEvl7SX&_nc_oc=Adr-p64gZ9D7c7G25hOYg5ZRXT7_WRyq0ecDUzXZZFGgUDR4MgZEwD0vtfIiEIagxDw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFj9_zr5H_EKVqYWieg8UbMlDTZ3hpNvtyElN_3dvLvw&oe=69CFAAD4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
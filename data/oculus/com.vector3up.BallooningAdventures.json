71-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEgReHTiVOoQ7kNvwH0kLp6&_nc_oc=AdpJlKlRNcV77rUDm7dOw4s7bbp9vm27M5futjU9Gi2j-IRDtn4_cSyXIcvmAZdOPtg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0BF8Nun_tx9EQ4leKtW1oNcisJgTr4C5Cp55CvOKM4CQ&oe=69F1FEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acv137AlQEIQ7kNvwGgOx7p&_nc_oc=AdpslOHeWdV-FnRXsDRJYwC8_HnYo_a9Xp4sOsPp32yPIwO08UtT_bcBl4KigKTvz8E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3KejNuPLM-VpDfp-WKwR92XpW31u7TSvVOu57bwD8Rlg&oe=69F1F1D4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vector3up.co.uk/ballooning-adventures-privacy-policy.html", "developer_terms_of_s
mg&oe=69F1E8C0"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJhihhWkKsUQ7kNvwEwee6t&_nc_oc=Adpkjj-c1VXle_cjJznTiMlbDmPHzdS0WiFEhbWLU2ZnqDIqOFlWBMyU7nODl79Rw9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af35grDLr43EnNqvno8czYbfpmOrtcIR4kDZcYLr-BPmnA&oe=69F1E72C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEgReHTiVOoQ7kNvwH0kLp6&_nc_oc=AdpJlKlRNcV77rUDm7dOw4s7bbp9vm27M5futjU9Gi2j-IRDtn4_cSyXIcvmAZdOPtg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0BF8Nun_tx9EQ4leKtW1oNcisJgTr4C5Cp55CvOKM4CQ&oe=69F1FEED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m6PdmJ6lfkQ7kNvwG0cBTc&_nc_oc=AdrA67s9SHbve8vJT5OwvrWsIKjp2BFv0jyui3tjVD6LsWoZRqUQKpUBn-UYRRCKOOU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1XBEycqPDJQNvw2V1PxT6TjBp8fcLfpGB_6ipHcpIx8A&oe=69F1F809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acv137AlQEIQ7kNvwGgOx7p&_nc_oc=AdpslOHeWdV-FnRXsDRJYwC8_HnYo_a9Xp4sOsPp32yPIwO08UtT_bcBl4KigKTvz8E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3KejNuPLM-VpDfp-WKwR92XpW31u7TSvVOu57bwD8Rlg&oe=69F1F1D4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815510728704_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQwG4MB9NU0Q7kNvwFHkKX6&_nc_oc=Adp0HU
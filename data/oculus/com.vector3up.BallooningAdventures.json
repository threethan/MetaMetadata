ent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUUuzv7J5VXSXFeab8JKcq43dNw0QmsvLPbP-kPUfNOw&oe=6AB51609"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dYjEslIcbwQ7kNvwEdn2MX&_nc_oc=AdqwC3CVWscgu_w32BfuCSRUAup-rgV7BezRl7pOL0ykmfpyOGE15nSxe0JZ-bux6pg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjoeMTvQh5CDSXfcLt6lSuy42S99eSW6uv8SaBdD3JTg&oe=6AB51CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED-3n9E4qtEQ7kNvwFBoH1S&_nc_oc=AdqBZgLaw_BEsICsYcmyd7tWsYhTyK5E2t9ly-4-oZ2WVEnmN012ZUnAVnsX13PZ_jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID_otT7fNvDhI8LYzpWp_HdnoaoL4Hp2A1cieDRsm0dQ&oe=6AB54814"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
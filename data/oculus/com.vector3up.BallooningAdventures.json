ent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WucrAxa8hH457RVD3vrakjja1aPbCjoqrHF70a3WZxw&oe=6A2C3249"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjEjmMtsKQUQ7kNvwHJrjdS&_nc_oc=AdrENQqCzILAbPuv41RhMQGdxEF3n1Xp9-IcdXFtg-L9s3cr82xYjzUXK0zzf2tHGyk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zxariqFx9oKW8hxFOiRXRhODG2jaK3gT4RN9fK6i8LA&oe=6A2C00ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU8SLY7TM7sQ7kNvwGSTL-1&_nc_oc=AdrPAei0XtzMk7RAmbZ9boJ8UW5d32TzLdgMFexbX2u_LsVp4oTAn3DXaCQr1x69ARU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-itOhwF9IStph9D_LEN4FWdOV6TktGxr7MRzzaTbwp7Q&oe=6A2C2C14"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
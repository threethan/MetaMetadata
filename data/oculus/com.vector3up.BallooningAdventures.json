ent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vSVtti8VIf1zxL-XWq5Nmpi2Z3J86PVzxpCB9Oq8M8A&oe=69E0D489"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orJxH3SXgxwQ7kNvwHvfLW5&_nc_oc=AdqF2ATBRZoh3FfBKTgFdpWKWidvnAP0cB_0riIWn1kzD-Wo_okgEvNJspHJRVah2Gc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s2XmD2AuyS0PLzxz2vbKSnJUwTH1t6-I1rceGMr-HGg&oe=69E0DB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_iB4xk9RUwQ7kNvwHeukKa&_nc_oc=AdoatNvYQsK7p-Axj2t0OjcvFQY786Pn5ARmFt7oOuehLlf6KBJ6Ervbz3m1_dsyGIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TD8-ThWgksmBdZEGX9aJaA82EDFlQp2WzsfmLEK-24w&oe=69E0CE54"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
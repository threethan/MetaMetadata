7OTMz7eTiEgpQOEMjbT4uBYwYvC2maA&oe=69B3F240"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sIWh2I1hFEQ7kNvwEliaAw&_nc_oc=Admy1vStTHu_Hb7GspiESY6lXKL3lOBE0VuHnDdhagYzyoZeFhHk_1zw_xBIS4vX-pg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHEyO2oxoVFhp6ITiO8YxYIMNp_kAWjJwiiwIxlHdEGg&oe=69B3F0AC"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo4SHmyrTxcQ7kNvwEEvIGm&_nc_oc=AdkYVJo8knF1H9b-LNdtsuwm6v51HYmX-qFw5qvApmplX5MwdXYWUWF9aSSs6BPyP_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4dJhdOW2XlTIJnZirmBc-R5iaQ9WOsgdco7O6m0CONQ&oe=69B4086D"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggcYjkq8pCUQ7kNvwE0vPVG&_nc_oc=AdkRf9YBg-4unB0cQvD1Chr16XyWx43XOij3dl4cVJ_ctB4XnjIG6hY8kueeyMLXI2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1Oaa7EclzuFYjnb5XHlSqhkSaAF2NdLEGjQAHObTNKg&oe=69B40189"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tQmUAGuufoQ7kNvwGforjV&_nc_oc=Adnk5QaM4fdWmrAERXB6rKDimMxxkvnL-kjX7nM2wK0X-uEXNUmijMcCiV8mlz-X3Oo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2P_HDCRrS1FuPp7mfU_EG1F7Co0DYOrQossghpLDz4Q&oe=69B3FB54"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815510728704_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb
ent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbDoauOinYxV7sYry0IPVtcQmaMWdhOp6jILCr3xrn9Q&oe=6AA7E709"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTKkLkSmhWcQ7kNvwGVEkPl&_nc_oc=AdoiIzh6snDfwQJ7ilP7LOo4OiBZVOGB8ZyHZmdJsIKoooZu4BaYt4DqoveYgkjib1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrMSSVoectJq86vLs6PiBuMUKQGocbLywQMK4mZyoFoA&oe=6AA7EDED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz1aMKqFgDcQ7kNvwFmKalU&_nc_oc=AdoA_5AzdZEbzdadGBDILwtD2c4wCTGx7-wtNCHbEWQ5mZ1Qgz2c_jztGcjgzdZ22F0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0kWssLLh_Gonv8ur-5S9Ij1_w_MD6x4sDxrFOPf_Q2g&oe=6AA81914"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
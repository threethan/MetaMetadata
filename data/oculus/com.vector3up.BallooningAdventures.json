m&_nc_ss=7f20f&oh=00_AQTsyqQNVGBrqhG5mykqR3qiaec7kHWW7n0vaK5G3ZODvw&oe=6AF33580"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMbrO9NJY48Q7kNvwFTW-n0&_nc_oc=AdrCadIfvDv7Tuc_ki1VTieO1RlyTuY5hYXdpFYDWDITDcPYAubuvaMMaFhgMzEPWaE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpbwgutvL7eH_DwMaiAbaC53lLANtbJ9_ULaSFRM9-yQ&oe=6AF333EC"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsdVfaVC7DEQ7kNvwE7sjcp&_nc_oc=AdrTXqXk41cxj5Iwm8M00OGpP-lmaFO2ffvo9h9_mw2b7ssvd3RGrzLwb-79sADekNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Udh0n9Aj5awiMkTnOjBqkvBFCnamRM7F6yW1UcoBvA&oe=6AF34BAD"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckaKdFOiFnwQ7kNvwFzaB3-&_nc_oc=AdqQ7iu4l0m1JFNW71sYUCIIB3I_2MD8CNbr1OpMVwLGqdC5IigdtOLzPUM_LGxEIbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReIxZwHpsSyEUbSecKOhnA3phndWPCKpAhxoqyWe2k-A&oe=6AF344C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKOsr9cYL3kQ7kNvwGD5iet&_nc_oc=Adr9D6Sgsdk1ssrg0HJc3GwIqmJLCH0hNe8yfTjMktHP2LWsg5WhI9Yg3UwH38XpEXY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO51GYMlarU_LSNhsBGBhtHc_aPkYZrnLSK_h_r5qF7A&oe=6AF33E94"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
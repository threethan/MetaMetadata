ent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zWpMkOqUibcNNozhYC50maKRIO49ExZCHcFebx3Z6iA&oe=69F5EC89"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh5LUivdvqIQ7kNvwGO1dj-&_nc_oc=Adr4-8PoGaW2XXm7cxFkxaxAChvdTEVmM2yIwZy5N88ACOMjisEv1UA8wu8WKAPlVoY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2d7v6YXReCesYPcd7gWi0lD6wAWLgN9gdY8hTQNaIZbg&oe=69F5F36D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvDb8ZrUWw4Q7kNvwEaMebx&_nc_oc=AdqHaJ3XCnb-hgfIUaoItcg2OkU5k8MZ9MOtdF_wlBLcbk3s1v3U4AGDxT-yCQXT2bo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ytggzPjyWBe-B5OCPvv9YjqsJt9ZOCgPMV0nez8IXLw&oe=69F61E94"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
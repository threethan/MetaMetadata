i": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001699_409976756960839_4786861500436082472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF_MoMximXEQ7kNvwEbnQF6&_nc_oc=AdojoxeHgqD_DrBvnrv3prHC-oq5UafU3nZTwUsqzbi3dRhqxbEav_wsMQ64nIXgE-Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInDKDaBRvKT8hnWcQ_cH70O9Crp1_MEo_t6O855BWp9w&oe=6AA950E9"}, {"file_name": "Screenshot_Low_Wide_2560x1440.png", "id": "441069600581684", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974827_441069603915017_6275985623359077382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9f6CdvnGZsQ7kNvwEH-qB-&_nc_oc=AdosPCvvzgP_LYsMT_u_TcBtKtIy9ySaBJd4uh-KmSjv2HwVN3UGD-v09l2W4R5RVUI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx9KxHA4FyR06FbQBOdClFyxD5T23cVyF4z4ITockU8g&oe=6AA948ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "326566892052330", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982584_326566895385663_4441488385814727431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJXEdKr5dgIQ7kNvwGJACYc&_nc_oc=AdqMhHKrixkDLuy3lFpIs_SP8NmpWi8q0osRlY6_3EYi6cpLXLpGOCNpqu1YZgSRoUY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxZViEfYriAXWwp5IK7XZ5ARdxk7J5b51Z5oUT2RHZWw&oe=6AA955CE"}, "display_name": "Ballooning Adventures", "keywords": [], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectible. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vector3up.co.uk/ballooning-adventures-privacy-policy.html", "developer_terms_of_service_url": "http://www.vector3up.co.uk/ballooning-adventures-terms-of-service.html", "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "http://www.vector3up.co.uk/ballooningadventures.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "653681422448125"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "170086434961478"}]}, "baseline_offer": {"id": "170086434961478"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1616447880, "status": "PUBLISHED", "id": "170086434961478"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3822487431176466", "version": "1.1.2"}, "id": "846569332864513", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3700318683393342", 
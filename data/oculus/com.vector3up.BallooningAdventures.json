874614273376256_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srJKHAEDsoMQ7kNvwFiKUNp&_nc_oc=AdoicDNVr3bI6385vzGATg5nuRxKsVJKOLHaDNGkQHo4incXbXc-Xom12lWgIKtayFg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQawWqzap19IgBWJ5pGa5X8bE-bH1jw_ChC4i_wrwIhCQ&oe=6AFB1E80"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evmZce-lu3gQ7kNvwFaIkml&_nc_oc=Adqw35EOzGKWs2KtaXrLaw_Ih3D8Cdyst71Kyw0rMVMMQV31NuctoYYYqoXATo9lBVU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLIaQjThA-HKL0GY0JvTR7ovNp6JQlgriYWWHmqL7ABw&oe=6AFB1CEC"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00WL9yHI73sQ7kNvwHkKIWZ&_nc_oc=Adp8r8p6sDXZenxUc2tv_MuD_oKnbRfFxJ6aIC-LnmDQNgWeVaJnNg0f8FqaLjtpMoY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBuN1Ff1KWoHr7Q5uJubwMp6GKWk3yCNJgF5yavTwP_g&oe=6AFB34AD"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9pASlFgKYgQ7kNvwEHltRX&_nc_oc=Ado0ZH172FKhu699ZAfe04HixVgijVdp-SG1m9weNYsDgmhfQ1RKq2933V1TgpUkLVY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE4k_t19Ex6R-32yRqK8eyTh3_FjhVk_ffbiWWGSXvNA&oe=6AFB2DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_ERQ-W-3OoQ7kNvwHB4UrP&_nc_oc=AdpfQfwKODb3M5okZ9yu7H8c8YbgvNx8fSaXYgfE9lAg4UNO1SlQPY19XKv7s9387l4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmDS1_2LyW5C-Mh55IvuA2XXFYmW4e4iMFtxmjkn0OBQ&oe=6AFB2794"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
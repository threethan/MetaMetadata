LcVdPzmRpgRCzin9Wewer5JQDqdrCkg&oe=69AFFDC0"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FT3WInGEII8Q7kNvwEzdtWK&_nc_oc=AdlbC-MshkfYKNeDO0s69Im2gV1HgZyC6PWWoHpIcxMFd-epHJKn3diYoEtlivuO3PQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWbEs38TxgIo3kymQAdunhB2U06EsVKxs6wiOhzBuAwg&oe=69AFFC2C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v4SXjS8OSUQ7kNvwH3k4Ar&_nc_oc=AdkbngP0Tp3qXVHl79NUd_W6uPZ4FAxeY6EsqBw26GEqvSYHvFF6C7xfXqp8gZ6HvPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5_bMWGwSqg3ql4z9t55cDvpe0remXOPgJzEFbHcb0IA&oe=69B013ED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CE9-ozv4NQQ7kNvwFG-TbJ&_nc_oc=Admz9IwAS2Z2RVQsMJ6ETnhKH1DEDGDTVRY5Bl6dOMy_z2VHt6-F52JyLKyamDRyAiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNaBMsBP3FuDGqHmvCd1S7PoNjul7W-g8VsENH4eAeVQ&oe=69B00D09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B855bXmuOtcQ7kNvwEkbjKa&_nc_oc=AdlKZWSJUUKUpOunSvav2oTh7YYRJs2bn0U8h59S_3UDGUvvokYQZK0GHKIM2mpbyQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_f-2ZdxWT8X1fBEftuZHEqSX5F6ejEQwydQsolX7P5w&oe=69B006D4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815510728704_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb
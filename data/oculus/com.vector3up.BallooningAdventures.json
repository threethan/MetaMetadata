ent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo_rxuw-Yk1Aqy3M7SATDjEZeqALZVjEzsP-o6fNx1yA&oe=6AD0FDC9"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJXinaMzbSUQ7kNvwEgeABi&_nc_oc=AdpmMfaWIIAglF7rYFuUdJA28iaVLyiChpzVp83iVpzk9yOgX_n9en9PIM_99LlooXc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0PyEizXSprkahz_rP1_DIS-UXeHHqCyPr39k3xCGH6Q&oe=6AD104AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3smbTFNqJ3wQ7kNvwEjS1i8&_nc_oc=AdrV5WLSOZcPUtYUr25pisrVVigmem0rtX4AU0-SHdxREGw9rVvHQO8zXXFtJQOWCeA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOORZ_g3ce-ETUL11UCJM-y33nU5X479oHmDvcY0_9rtg&oe=6AD0F794"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
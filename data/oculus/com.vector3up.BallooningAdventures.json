guxWYhqfETTC-GWmXxzQVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bT4l8LCBJHvpkOqjXgZYOtbJh8N8v1387d09j_UanEQ&oe=69D24908"}, {"file_name": "Balloon_Screenshot_2560x1440.png", "id": "468313364347519", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_468313367680852_4533831396961985435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4ob5jGToTQQ7kNvwGzkzYV&_nc_oc=Adpv1-OGu5y_94owmzLN4qtNFWyvqqCj1r1oM2Yrh-BSdHPy_16TtUUgbVitGnYiGVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Igj_liJT5dj52mMFW6i3B1dYDlM_N8DWbT1q6uIls_g&oe=69D25038"}, {"file_name": "Screenshot_Inside_FireB_2560x1440.png", "id": "409976753627506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001699_409976756960839_4786861500436082472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7ZMQ-APtfkQ7kNvwHicdFM&_nc_oc=AdrNveFqHCimxmF7RXtOeivq2OmaOPtN-PsoiiI8CnStFSdTSDrX04Yxt6hba1xgjKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dbuHOPGxCEG5wJjUtPUp8VxrIsIOEWBrC06Z8ZdXFtQ&oe=69D26C69"}, {"file_name": "Screenshot_Low_Wide_2560x1440.png", "id": "441069600581684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_441069603915017_6275985623359077382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTwW79zYQU4Q7kNvwG5kcVE&_nc_oc=Adogza5MBfKRttYGKA9YX2CdkFN_SajCExiDrA6RhXJ0Df7WwPtV7wLsr3xzIWdU2Ow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PF6VU4z0pTiP5vwfjV2DN476ZbMJTi3CS4wqyBmfLdg&oe=69D2646D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "326566892052330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_326566895385663_4441488385814727431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NUEwjq9drsQ7kNvwFWc5ez&_nc_oc=AdrFrFqq2UsUkgfDRXbcbIJqLIuxoqLgoOvBJWmWTn3EFPPK8kF0uEuLNGN-lhqoNMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ANRsooQEzNVcOHi1XxwaYUcQBB8NvB9y_xU9DmsMiNA&oe=69D2714E"}, "display_name": "Ballooning Adventures", "keywords": [], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectible. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": "https://63bf4148e3666.site123.me/", "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "687425229783852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.577
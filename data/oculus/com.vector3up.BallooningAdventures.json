m&_nc_ss=7f20f&oh=00_AQFAH4EiLjWWRPGXkcD7z4RxjzUePAj9rotwLf27er7p1A&oe=6A804AC0"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL7xJdCLlVkQ7kNvwHwwD5y&_nc_oc=AdpdTTRttXU2LK1E0BehrREIltS4viSb84r-8ONf_8Z79eajGSK--yWXRbXjVcPCsak&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuCzpVvNJ5rhU8lky8gdFFag6_DTfkuHTv-Gu9XnFsJA&oe=6A80492C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eswa1KkeGMIQ7kNvwF2DAI4&_nc_oc=AdrBz8fe7vBncMd8nrI2_E4wG6EodBCFaVQKLFJYTYRUgHN1XtmqPybDM9KfHyn3Dqg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXSSxehkQziy5p23c3qrAdEMSoGT3tqO0Nk-LtRbAWow&oe=6A8060ED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uI-twmMyqpMQ7kNvwER-CYN&_nc_oc=Adr1y28gSkPpOjJsKs63TBidY-3syskgPEY2zb-6QKi4dPbLpuDlcM9L10L1jh70Vn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEDQZigJU1uub-QlEhh9w8P1GjB4lA01prcNcplrI-eQ&oe=6A805A09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDYs6SwIIw0Q7kNvwHSl1nm&_nc_oc=AdoM7DfBH4HYnEJEXKrwAXgPvMJcRNu8ITgxVxMXLxejDSQSSi_B_cZUWUu6Rotfvkk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_BlSAwyu9aXfCIPqy1m99Njuc47MmZ2glR3x7FzmjPg&oe=6A8053D4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
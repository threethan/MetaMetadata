T3pGmZPUGr0aMFiEArWwyr2VA_ElZbQ&oe=69AAB7C0"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpl9Jo-fSucQ7kNvwHyNWY-&_nc_oc=Adl1P_w7_3W5yOVF0vztklDipjfQuPnGmLKm3uf8rrapUyYs3fOY3wsNiIzT5MVNQUc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXfqGv8_m-UBpKbP791nrfWzEs1SKVGPQL6WWBEpIcCw&oe=69AAB62C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8b1UHfGGs4Q7kNvwHeK9iC&_nc_oc=Admt6hCOwU3Ge6S7YCJyrm_PBml8brBJGmGEe4IVqhLPP4RpMyxH2lY8XIs8wqEjnhs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPupmmWbY3U4z_F8Fa3Yn0aQIfGciOr6Q5myNS1bHTLA&oe=69AACDED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYER25QdfnYQ7kNvwFnYef4&_nc_oc=Adl67Qa-wzXGojmanZyAm1kyPStUK72EYm0h6XCBmALBzP9w_mG_sKpzY3_7DuojpMQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaIFU7paLcbZKT6gLE6Kdq20qFMCN_icJb_C3n2ZSJIQ&oe=69AAC709"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z84uk02jD_AQ7kNvwHrvwyj&_nc_oc=Adn1kRYK33U4pQdDJZ4Qa9Q5m1qj414KKrjynBTLw_i155nA0dXJFt6wRNc7CZci50o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzYXndxzpheyn76XQjmUpQWVCGFFXAUYgD0oWxtVZXrEQ&oe=69AAC0D4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815510728704_n.png?stp=dst-png_s360x360&_nc_cat=111
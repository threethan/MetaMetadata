, "id": "266524951015136", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-4RYyufF1gQ7kNvwGOyknr&_nc_oc=Adn7i1JFmfU5pRMjHpH9sgDmUNReoc-tfxZRuMcTsQ1NRUEXM1QEHJKNqmo99LJetNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDVJHAvrjmQN4WfwC2h6ACGu7gmH43IZrX2GRJiKe0AQ&oe=699D872C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNVX2RJ1X90Q7kNvwG7wT9O&_nc_oc=AdkvUitYwKTvFEWaJLGH2GEvgiRxbf6ilokzerOFhXd7vNk4qD4kY2-lVDhC50MX4Lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsPGCD6cfdYhaqHbXbldJVgUlExN08vyH4aF3-oLeBDzg&oe=699D9EED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4QjX9baEt8Q7kNvwF9t9Al&_nc_oc=AdmVV_XnKFuzh4MGMTYcU5yY-eDNnK8Vh_K6gMxxIRCjQOOro1w7Vr4zha8OHJFs3LI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuu3lV548ckbr8oGfAs25Z6EqSYIypatsAXFyVLzsKr2Q&oe=699D9809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab8S639LEA4Q7kNvwEb5gc_&_nc_oc=AdkJk72s56edMpc_ccgXxrJh5kSfSE8E4uQOgvXt55wQSIZK8liPdMxhE0wXddo5c6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstEKTKGxIdpzK3Lo8aR-9yvcfeIXaoWTbwSS57EEiO9Q&oe=699D91D4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815510728704_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyA1nTCnYh4Q7kNvwFor9S6&_nc_oc=AdlR5lSV001IJ1EThPjzw-6dwnefAQ90OcVGpktVHVzSn1HqZmyJFIopwm
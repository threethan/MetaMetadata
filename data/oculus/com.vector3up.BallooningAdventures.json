ent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6n649tVdBQtF0jV6EorzDwqj05p2uriTmMfozVBWsvg&oe=6ABFDA49"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHFmMJPNWbgQ7kNvwGm-1DC&_nc_oc=Adom9KYT1GVKu6MVBcS22FGq51U5P-27rqfpCat4O_oL1qNDt2te-iGbw2Quxa7gAFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcPCv9MstMYzoNJr_iFvqOetpGRUUyZDvpxKYiVRM90w&oe=6ABFA8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAScwCyjeOkQ7kNvwGzeXyd&_nc_oc=Adoi589PAdQKbIhRK8l387U93kGE0YFQhz4WiH2Px9iy5ZfRez5uRmfK4OZLLFypNhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlI0iYkLhI108PJrARUYAGbpFWHY81W11p7pAlR3IXjg&oe=6ABFD414"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
Eir4eObmZInaUKOqcwI1Eg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dwWUW-abxKu5rPfVZKpxb8xkFJaJdcWk19DfctLwKsA&oe=6A049A48"}, {"file_name": "Balloon_Screenshot_2560x1440.png", "id": "468313364347519", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974557_468313367680852_4533831396961985435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeHQSlxFlKgQ7kNvwG_YveM&_nc_oc=AdrKTWO75ph_xDN9UTOVY-M_MX4Ln5S-tLY_NROoUY1IfY1rsh6FoGPz47uWl-yuskk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q-kdjzsLmWxu1sIImtrxp50I_AJ0-7hNMrHRosT5mTg&oe=6A046938"}, {"file_name": "Screenshot_Inside_FireB_2560x1440.png", "id": "409976753627506", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001699_409976756960839_4786861500436082472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDzmC8LeY6MQ7kNvwGtuRx0&_nc_oc=AdompRbFpyeFlQStOweGrW-TGQGKvvqZnIRHz04pIYUkCDZl7a_YgOFyv7sJxDec0aQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48wUJm4yF8KJ4pICiZqIKjwA-ztOHGfz9QaxULznheGw&oe=6A048569"}, {"file_name": "Screenshot_Low_Wide_2560x1440.png", "id": "441069600581684", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_441069603915017_6275985623359077382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWmZHAQlznsQ7kNvwEXkVTc&_nc_oc=AdrTliJnEZ9lIkoVa9rU1C3QRoKhc8rGgvGimkNn_tc-oElrXWB9N6SGRhaufh_4y30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62drgDeDoWNSsgwT2xpxtrdiwFRGqyDuaraqzfijsQ-Q&oe=6A047D6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "326566892052330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_326566895385663_4441488385814727431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtTUPnNYd04Q7kNvwEICM6C&_nc_oc=AdqFVCwU5te7cPA2m_3qSOMZIvJq1cWmdJ0pHMRJm5Ya-5Ypn0TkMRGD74W2pETZUlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hJcg1UglbLRvB42G1CZ8OoUtBCodTHnEqBOJpCDVzyA&oe=6A048A4E"}, "display_name": "Ballooning Adventures", "keywords": [], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectible. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": "https://63bf4148e3666.site123.me/", "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "687425229783852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.577
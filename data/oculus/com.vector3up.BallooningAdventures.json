0CoZxCDZckSHQDrQvITId4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBkavfR1WlorJIu4OwRt3fWG9yTqAR9NOUhKUHwoB1Ew&oe=6AE367C8"}, {"file_name": "Balloon_Screenshot_2560x1440.png", "id": "468313364347519", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974557_468313367680852_4533831396961985435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI0plMEk_xgQ7kNvwEwhpTi&_nc_oc=AdoxMYQU-kALen7OqNAi8pKlO8I7eaqVuoYi9_xM18lK0Gz2DAn1iplH8HGsmzGAKaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdKbQ06pjurmORuEpBSWBT-WSYgyY0Dpt4cumRUI6ITA&oe=6AE36EF8"}, {"file_name": "Screenshot_Inside_FireB_2560x1440.png", "id": "409976753627506", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001699_409976756960839_4786861500436082472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URF5VUmbmkcQ7kNvwFZ1njf&_nc_oc=AdpFpH6fpm3ypeBFeuuq_eZ9YlrpbDdWfzyuBASEjTCQbUOcl21XaXYFjn3Lm-gAHlQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDQnUwuzPiS9QJtCJ5Wb57aVkS5yS_pFQOWTtJ50ArOg&oe=6AE352E9"}, {"file_name": "Screenshot_Low_Wide_2560x1440.png", "id": "441069600581684", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974827_441069603915017_6275985623359077382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQrw8clWC4cQ7kNvwH-XVLF&_nc_oc=AdohdC3AeR_AJW6moBXniHbhE4cXaOpo10w6WwXYxus-am0ECzaPBIiehQ2ZHnZVuwg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJagfdWLnF3XskiKC6OdkKKJHZ0RtRCuBMpAn1WFi8mA&oe=6AE34AED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "326566892052330", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982584_326566895385663_4441488385814727431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRZVbWyU79AQ7kNvwEClfc1&_nc_oc=AdprXo-biIa05wfFYHwj2ojG3XQbAPZITwlkohtYIyinybqS-cv2lf3QNM1WyAYI0S0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqiaqbQS9LzRQlcJ7JlmlDULFEooElrzg-fUQFYE6lDA&oe=6AE357CE"}, "display_name": "Ballooning Adventures", "keywords": [], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectible. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": "https://63bf4148e3666.site123.me/", "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "687425229783852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.577
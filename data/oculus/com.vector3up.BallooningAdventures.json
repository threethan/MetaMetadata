ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FchSGDbuU8P0kVbl-HESlqEu2K9IW-RK8jiXG0BWvyw&oe=6A183389"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5e2KtRyKbRYQ7kNvwHyqNDh&_nc_oc=AdrPziFcALrM1jM6pKIIGdQWh9ov3VOb-1zG3USIjU7k1rFL5n9iWOrmcRbavx_llGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zqzkSJ1agaxv4x_KowU6hotrzIR0J50PTTCgdQb-qoA&oe=6A183A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yE61eYhedUQ7kNvwG5ONT9&_nc_oc=AdqBAkFd7dKrEHlb0QbcKrElilnWLNysdSmKyNwU55MznfQ7_DjwW1vAxhZH_150ey0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4psRpdQOxLt6QygPL6ugVEzWRCrLBAHaMnkhachEgzKg&oe=6A186594"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
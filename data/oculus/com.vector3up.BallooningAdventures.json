874614273376256_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yovtmnw5Y2kQ7kNvwGunTp2&_nc_oc=Adq5x9RAe9926z7xxrzFbA0QQ9igRgHATQdRx3S0tstOER8lImFwWt4pKFlYMLaxZxM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkSNPoPHvybgB2ygMoUNhDyaJiBS0aRscKCWi0KE39UA&oe=6AFC7000"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eok17V-zAmwQ7kNvwHbSriA&_nc_oc=AdoE56hwa3gjZaYZ0Qxv10fK0GSvn8_h_vnCDI_yo546ROiL2ChEmm9EP2randRC-ME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-zpbD5UHCzRZogKyXX7dla1rE74jr6ylc5BZ2qdy8og&oe=6AFC6E6C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00WL9yHI73sQ7kNvwEZ9Aal&_nc_oc=Adr4xv3VoVdJuhvmVarkOP0xI_w77UiEcSghjwQaCmk7lG3GhnQtZNKmD4USAoNd6Mg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbV4yNcLWskXs-w4UqSNLQMZ-UfQW27ZyMnHvx-rjPtw&oe=6AFC862D"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9pASlFgKYgQ7kNvwGwz5jl&_nc_oc=AdqeWzZib5muEqkMZNeJC4uuTYqnyqTD7I3QDaVWp8rLFUC9wVwrNmHe1MpXIvt6EhM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXVMgvkvbSAnT22A-ZhZp9LUXleVZu2Y3IXUxOZ6JwyA&oe=6AFC7F49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_ERQ-W-3OoQ7kNvwEQRSq6&_nc_oc=Adqeky_YvZu3FSbnzXrq8CvWyfMwErQVmt7ZeIqtt6wr1qNrwjWODfxpfopFhVW97ks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5J55yJ4wHpXvkAmeGHlpfRGQz0UjrMz6TvuoMUoXR5Q&oe=6AFC7914"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
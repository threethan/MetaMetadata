ent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zS8R0_0jhVUEjDK7IBK5OHFYVPjPF5EnvUqiHysGhbw&oe=6A1C6049"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alomkri0kXkQ7kNvwH5-tGp&_nc_oc=AdpRQ8zPLOCz4mMvo1HqAHTn6e9vYm1yfSbtoMbL3fPVP9PRA6k1QZyp5QUtcBhSnVI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pLLOeK4ufCDnk85Zc9P-BDz1SzQdGmjBnX2TLoXAKUg&oe=6A1C2EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-Vleur6bgkQ7kNvwGIMNPS&_nc_oc=AdoFEuFnv_M9r6p5nReALkYEnoRht8Hx9biOFat5R9SrRs5LyvJDIKfBfgZSTUuvfpk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MiKbx_-cGbpIRNzEbnlbGLM-vBomPEo7a5P9I7Yp05Q&oe=6A1C5A14"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
ent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gxh5kerp7fnDJyDXJH0M7D21co-ud_0A4U5cl0jIRAQ&oe=6A3026C9"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFbV9yTeDyQQ7kNvwEB-Xz3&_nc_oc=Adqew85ITSmKt1r40Vl_mOhO8RZBn4QzcZd-LWvmopxWmyPOhS7jAAdHXyLsMrPjrYA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i_fcaLkDgOy-QvQQahRhP5B5g37syzHhsx2aSuHgt9A&oe=6A2FF56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FkqPI4ChZQQ7kNvwHkL39n&_nc_oc=AdoZU13vVd4OBo9l7qW0Vf2Ejb5gt1TYkD5qabq0a8LvoqtRu2rL6H4ET8LJ-2hEQnA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rm1FekJAnXQ8spQGDoGlROWsHHkOnjqxn7Y13HKs5Nw&oe=6A302094"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
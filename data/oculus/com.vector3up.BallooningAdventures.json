W4o3ssHTpJCBsWfW1Xcu9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1up7tx5LCvLqI-QbvVNnEhyPdecOp2QN51ZQbnUoEqQA&oe=69D4EC08"}, {"file_name": "Balloon_Screenshot_2560x1440.png", "id": "468313364347519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974557_468313367680852_4533831396961985435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTpuF1leZY8Q7kNvwGhYRrM&_nc_oc=Adp292wUyVOuOKoBi8MBRcfamWFv1-SJot3LMS5Wrbovv0EkZoYh4s6Yr1ysN09LqVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oCs8e47WZ2bew2Lxew0tHN9SyMKGKANuVpwi8c4hAvw&oe=69D4F338"}, {"file_name": "Screenshot_Inside_FireB_2560x1440.png", "id": "409976753627506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001699_409976756960839_4786861500436082472_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7ZMQ-APtfkQ7kNvwG_sfIl&_nc_oc=AdqSmys8hNuM1zW9qISATcRqudCFILTLiayTIXuKnQ6Wuxtq40Sw1bpL2YQfd4Agpmo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C8SX5HNV7R8x1M-ee5qRDgtlvseWOtCzr8dJCok9JTw&oe=69D50F69"}, {"file_name": "Screenshot_Low_Wide_2560x1440.png", "id": "441069600581684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_441069603915017_6275985623359077382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHaUKrYuvHMQ7kNvwHfa8ad&_nc_oc=Adpnnq9K2jJ7NaRhlb-j7TlbsWfv9WONhdUwHng_LNGYKHPAuyauane210piuupIQV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AyMEMkXz1Mq7Zq1aaoF9MVgsUya70Cq10T1xipeM9-g&oe=69D5076D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "326566892052330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_326566895385663_4441488385814727431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NUEwjq9drsQ7kNvwH4ooQi&_nc_oc=AdoPgsJvXg8hWIslbF5-Z96IPvtMpUkHUKa6IO4gFM9M3uKaZmcX4q3uOgPqkFhoLpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NLeVtje1yS2JNVyPTti1ylnFe3ONmLC4pE6pDxnsg1Q&oe=69D5144E"}, "display_name": "Ballooning Adventures", "keywords": [], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectible. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": "https://63bf4148e3666.site123.me/", "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "687425229783852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.577
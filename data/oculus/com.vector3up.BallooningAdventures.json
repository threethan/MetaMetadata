m&_nc_ss=7f20f&oh=00_Af21R5vIFZJB1CpHQIar8TioLSKI4sdxu0SXwubR2oYMkw&oe=69F76700"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEcZMcofX6gQ7kNvwGMI6qJ&_nc_oc=Adraz6LytuOKB6fOqsr1FZzC6YY6rzjpEBMSWCX_E9sbS8ENbpe6OtjDjUXNneeVicg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t0TpQtBN5tgQ1SPU-kXz2G3dFa9tWNuxrk0LvalJjxA&oe=69F7656C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh5LUivdvqIQ7kNvwEuRp1k&_nc_oc=Adq2Ul6DFCc09eA_xv1Ezjyiq0sfx68zgprT5-rcjmyNklaU1kml3DaYYGrdvXdRf3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xWj-OnLMjbbfn2myA93JBzG9GAxHnkMPFIX418xLbfA&oe=69F744ED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRLIPlJFY-gQ7kNvwGpwe2K&_nc_oc=Adq_rQ6sgOajkcW1e0I0BKQ4bq3iqzV5l8gcdRgityPcxs8MU01UJn1Ccgu9XnUfAJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ALOZLsQGh1gIRlv4JDV3tgGJ48pElZOPRYhAN9i3ymA&oe=69F73E09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvDb8ZrUWw4Q7kNvwFLTsGx&_nc_oc=Adps_Wvp-3VlswwSw5Ni_FqrhS0FHusRaNwAFwj7-6Yjv7emaIg6D0W1f95hhxc1PrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hivDAMVavUorDs-cSA5P3OAzQSp3s0P2vUhpdAQHNnw&oe=69F737D4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
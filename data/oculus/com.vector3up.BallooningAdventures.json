m&_nc_ss=7f20f&oh=00_AQLglPuEV5RkrAcPSdRa7AwNg3-0MorwEeEY3uyYWMm6YA&oe=6AA81000"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L77TM1Xhw3IQ7kNvwGgDyIC&_nc_oc=Ado_G_ILsZ99jaRWGkJSV6FygblQDGAup1THI38FYN0fXAavxAmEs_SQcoHA32j2ZtA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZvJqdzbzm47nJuDsrkCzr3vqyNCndJsiElXagVfoesg&oe=6AA80E6C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTKkLkSmhWcQ7kNvwGVEkPl&_nc_oc=AdoiIzh6snDfwQJ7ilP7LOo4OiBZVOGB8ZyHZmdJsIKoooZu4BaYt4DqoveYgkjib1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrMSSVoectJq86vLs6PiBuMUKQGocbLywQMK4mZyoFoA&oe=6AA7EDED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjGfHmlsImgQ7kNvwH2IKye&_nc_oc=Adpc3Eb-BEiDPkKwnF_AzRHTnTymORWecBEeQqwkHKUn4XcqW2KnCYsg1edNEM9MlfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbDoauOinYxV7sYry0IPVtcQmaMWdhOp6jILCr3xrn9Q&oe=6AA7E709"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz1aMKqFgDcQ7kNvwFmKalU&_nc_oc=AdoA_5AzdZEbzdadGBDILwtD2c4wCTGx7-wtNCHbEWQ5mZ1Qgz2c_jztGcjgzdZ22F0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0kWssLLh_Gonv8ur-5S9Ij1_w_MD6x4sDxrFOPf_Q2g&oe=6AA81914"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
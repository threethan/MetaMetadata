m&_nc_ss=7a30f&oh=00_AfxZJW7ZpZeip_FOvMnEPfioJDgNTWDKX-VHNx1AzPh3KA&oe=69C272C0"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n03Fo5EavFoQ7kNvwEsh-7V&_nc_oc=Adp4-Bz4Li_-ZYl9WGnjknIA4lc-sSDSyQ3bFenbAOxe3Y_-g8jSV6lLm0VwRRHxiUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlkW8YJ55PlOgHR_nZLee_ImcVf1wRuyhFkv7SiOq5_g&oe=69C2712C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAo63OIPuxIQ7kNvwHjyD38&_nc_oc=Ado_VAHSo4-WvF3LBnvs2Ch82-g0NPy6JVB-DRax3WxLDsPikUR8YByiItWdchfo82o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSR02yKKfRfA2i0YkPQtak8C7eqnDlaic8Ye7bmSALUA&oe=69C288ED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AOq3LAKjCQQ7kNvwEQn_6q&_nc_oc=Adq7HCbZybzImuV9bQPCo0SO7EoBY9Rk3C7a-a3y9fr9QBVLDLDKGRl0F1Ip5wIyiVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO-BRlwzuXacUVfBdh5M-5PmnbaaEP53YCA8NxMX07TA&oe=69C28209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K16CP41EUhwQ7kNvwHU7DmC&_nc_oc=Adp72Tz0BBU2kBg5ujmHS5xjYpV2CsFQmkHLWQ5_JnNbyg3LOK4xjECY1FejcGOMwJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZarOPN7qyZx_HxJ9zBSY-ixiDHd-s_Kc2KqnA753pag&oe=69C27BD4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
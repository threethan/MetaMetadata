ent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO-BRlwzuXacUVfBdh5M-5PmnbaaEP53YCA8NxMX07TA&oe=69C28209"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAo63OIPuxIQ7kNvwHjyD38&_nc_oc=Ado_VAHSo4-WvF3LBnvs2Ch82-g0NPy6JVB-DRax3WxLDsPikUR8YByiItWdchfo82o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSR02yKKfRfA2i0YkPQtak8C7eqnDlaic8Ye7bmSALUA&oe=69C288ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K16CP41EUhwQ7kNvwHU7DmC&_nc_oc=Adp72Tz0BBU2kBg5ujmHS5xjYpV2CsFQmkHLWQ5_JnNbyg3LOK4xjECY1FejcGOMwJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZarOPN7qyZx_HxJ9zBSY-ixiDHd-s_Kc2KqnA753pag&oe=69C27BD4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
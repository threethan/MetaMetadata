m&_nc_ss=7f20f&oh=00_Af9WfgblSkMk_Om71nEuocFlFbA-u5zr_3PIKzSrfd6zhQ&oe=6A32BA80"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc-rRzTyw90Q7kNvwH71Ewt&_nc_oc=AdrzseariAgzf1u7J9K3gHqjeLGA2aoEmJPOZMPpTjFX22W42fWrUTT5ZrfRu7M46qQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y7LRGpiPgCDU6OEkOO6DH9DSSGGbx4sz7j0-xUkmIYA&oe=6A32B8EC"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFbV9yTeDyQQ7kNvwGLsfq1&_nc_oc=AdoXPi__bjcq48aomzf751e5NRt-nUm3S-QfEAC4lnZTTRJG_kYDCCd5Haitue5lvCs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fGHIj5y-L1cW5w9KATlCxxRoOKeXL8E9t9qp3vKot_g&oe=6A32986D"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfSBFYS_1lAQ7kNvwFf5Fvc&_nc_oc=AdofEJtztAhK6cdkyTt7kqTKn4yn0hA38UWOBt4CdoD_FFhZA-McfWIoEb9yVrlE0YE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t_cGGXWbgnb1e595drvN0kN7i3fc92aCnfDyESBhIoQ&oe=6A329189"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JFwJZyoJn8Q7kNvwHy-3ZZ&_nc_oc=Adp4t-9oHTRB_3NqH43pVf4nLw5sgyE4l4rTEABerKtNUMPNOu5uy3w1GE3UIybxkeI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FeQZ50-dn0HCy7qcWWs8LtlRG3yWlm5LoKeZXY4nmzA&oe=6A32C394"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
ent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBu3Rx5e0jF8s30YjNy9gJxAk2pW3TErmzPs98WNq5tQ&oe=6AA54409"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaXJR5CLuc4Q7kNvwGG9y55&_nc_oc=AdpD_tfqEmC6yuSEz2rjhuSNScFwZo36tM02GBge54hybA4ZYD86nLqThqVSo0bIj2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4LHWFRODSqdl_SKaSX5MTcIN1mLk6wrxTBJPz5MQdRg&oe=6AA54AED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7kmVXmzhU8Q7kNvwFLGilv&_nc_oc=Adq_ctyRYHAFN0OPeh25DdMRBxZEf_Wp0NoFnHFsnU84E7RWldaaoLOq93BcXXAuD28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAPnhIOv8sjzW4MlAyv-n5JWHkvhuef3nbQElksVG6ow&oe=6AA57614"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
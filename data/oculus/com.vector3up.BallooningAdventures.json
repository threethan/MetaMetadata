ent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwSVy8xybbxEns79mte7Bpr5U6nmu5eD5csY6TGqrYRA&oe=6A5A1E89"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9spQPe07qnkQ7kNvwFRbumV&_nc_oc=Ado-pq-cNsCexCthduv_vkYmwH-0Mzb0ugt5Ek_zBQ_hdvpWrHSPLL6apFDkI3je8Ag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdZyQR80uxJuDlUAwB71-qxVbQVeTWdpX5qY4l0JagMA&oe=6A5A256D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXby3ZH69woQ7kNvwH4yXzb&_nc_oc=Adqzl8IwwqdvcaGNTbijACkgI2TfNx8lJQ6J6NmZ8nJ81z8rTnHRv1DGdMYCDynFwxA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDkg7dOw0GH2tbEkkn7bVljxGNFEjdTQWxLKSai_GXtw&oe=6A5A1854"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
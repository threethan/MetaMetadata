J0MJPanTDRa4yOx9M_mnd8RETx0WlpQ&oe=69B93840"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mExYDj-06_wQ7kNvwGbfy2I&_nc_oc=Adlo1p6Xy5JXDsvX_x0M8BVU3OMWL9DVjexCPKaKLZ_b0Sauij-i2ffxaWDfkmA6MTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYnWqfLh_4CnO0fCaN1DIrNZmY4zXMj8KnyZJ1C6VmIA&oe=69B936AC"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByoVjhBLl1sQ7kNvwFY-LBl&_nc_oc=AdnnpZof1Wbqnz-ze3AJK8UCqxZU2sAoMGJRihv1DThjA4NUvAX9m5WtpfXZdZFPhO4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRgJ5POXry9TBTfeiQdwSJIjmORReIthNIaGSkRt2Gyg&oe=69B94E6D"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSMPEP6kAtoQ7kNvwGDQ944&_nc_oc=AdmLhHr4vmVv_5NHgZKcmELlfmH12olium7wfy0qbLONUwMXCrOfx0aVvuVqyIkQCNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzteXBDURpNGl1-Nvs_pov5aKoItwmr35G9sFYCHvNCpw&oe=69B94789"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WANhPb19P3QQ7kNvwH0NO9O&_nc_oc=AdnqLcMLhYcVWH__oBVizhpbo3PNaFcNmw3vtGNyN1f7OK3T3u6PLXuYalZAS3R0nVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPMXdzEuCBr-wogWF0nWnVtCxSTO8Vrl3X17sAAggL4w&oe=69B94154"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815510728704_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb
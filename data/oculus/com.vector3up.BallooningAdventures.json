ent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW7YakbQyutB6_xsJnxx2ZMMVZcrnm2bDRp1XSg1c-CA&oe=6A942089"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKE8x5gfFroQ7kNvwHBOjuu&_nc_oc=AdpCjp1ruxcGjNw5X8mGE5kJjHzNm0vXFff8uqHPWcwYFqQ_nNmreBk3uFXKeqjauqs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRv_z5J_7jp8y8QQHhPl5QeQDYtbPK7CgCn7eH08oqnQ&oe=6A94276D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4OExPc6DnIQ7kNvwHGIInu&_nc_oc=AdpqRYKlzsObzZZP0VcLAg41PBptyVjwLzpOivgWHF7Xs4fPZ6y2ZgBJrtbTTLJcoig&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtNlBX_7vXl0U9K1YjQbw3YcSqmm_C3xu2A9_lffZ-6Q&oe=6A941A54"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_d
m&_nc_ss=7a30f&oh=00_Af0cyD4siSGh3W8O7fzKKZJ2PruLTE5BwM7kyabJPSPi6g&oe=69ECA2C0"}, {"file_name": "migrated_image.png", "id": "266524951015136", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12482341_379249222410404_3129693740327763968_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na36PgAJvYYQ7kNvwGdnkMB&_nc_oc=AdprrFBFg6Wwrm7rAMMDtSGyDAD1sGReGzdckMkD5wiy1IClAC-yVeeDgFF0L4tryiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28KyyAURmjbfVWSKgN6nFch7NbtRDLCA-9Koero-5clg&oe=69ECA12C"}, {"file_name": "migrated_image.png", "id": "252458705909036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482342_352008968508909_6411536963404300288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IOU-LYvsjoQ7kNvwGnF1YC&_nc_oc=AdpvYir3I6T6Kwe7wzvscxARgIxP-O0V_pFpZMgA8053PFCnsf8ipzb__QG5bHvYxE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZGDDnQNe55zwiRMVUQEiNoE4xgZofjQTiGHQ9gjKm-Q&oe=69ECB8ED"}, {"file_name": "migrated_image.png", "id": "212859093285900", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410461_1703915193259196_77303351129145344_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLU7SiGASOIQ7kNvwGzMj0j&_nc_oc=AdqBC8l3QqEBC8bBnEKWIQeODdmPA880IFdpOGtFvvOYMrJN9jjPjI5vNUHg5zb1-Bc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01S88paybzc0JW6phSITFrjlAJyA5FHfJSOuLcuOsOFg&oe=69ECB209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCoverArt_2560x1440.png", "id": "369902480024073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410454_369902483357406_2751058636217253888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JnkMrU4XAoQ7kNvwGt2Sd-&_nc_oc=AdqRxnoLlRc4ar-E8jtbug9mSUTdUIISgnCJbPm8ymQc8ss8C2J-TvmIe8_Wc96dTLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CZs0t92LfZpznVZ8AZ4rGuyY0AlzX_9feJ07Au9qKnQ&oe=69ECABD4"}, "display_name": "Ballooning Adventures", "keywords": ["balloon", "simulator", "flight", "relaxing", "beautiful"], "long_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape. Ballooning Adventures has been specially developed for Gear VR. Using the built in touchpad or a gamepad, pilot your balloon through breathtaking scenery. Find all of the secrets and explore all three realms. An uplifting soundtrack will accompany you through this dreamlike experience. After a while you will become an expert balloon pilot, accurately triggering each collectable. Fly thousands of feet up, find your target then swoop down to skim across the fields and drift through narrow canyons. Ballooning Adventures employs a vectored thrust and drift mechanic that combines the gentleness of balloon fight with a steerable and intuitive control.\n\nPlay to relax and escape, or complete all missions and 100% the game. ", "short_description": "Take to the skies in a hot air balloon and explore a vast beautiful landscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://63bf4148e3666.site123.me/", "developer_terms_of_service_url": null, "publisher_name": "Vector3Up", "support_website_url": null, "website_url": "https://63bf4148e3666.site123.me/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "EXPLORATION", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928330155268930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522493_1821708924773889_1966669815
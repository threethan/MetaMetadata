emV2UhcIrOAt2UcQ5qtTZg&oe=6AFB4B31"}, {"file_name": "06_guitar2_2560x1440.png", "id": "2124127974812628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824665_2124127978145961_2217890887394477926_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtP05Pn_5HMQ7kNvwFAw6-6&_nc_oc=AdqOOjrPFMqJWPYd8uRjMsFcuB6EVt8Z27DYlxj6iR_pZPYVbOSGtvOujfvv5LiF5fE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR81ooYe600Z1n0ygrGuzjzzu_vxGddu0qV1-RLglFR4Q&oe=6AFB29DD"}, {"file_name": "728196126_27461150950237850_957231309461221416_n.png", "id": "27312930675028928", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825575_27312930695028926_8573605772056100451_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyIr3DohKGQQ7kNvwEmbP0j&_nc_oc=AdoSVdVWFvEstMSfQNbFmjq_9q73Bb5gj5TB7_CvDlaPK5Ge18mpHglCe4K4gZkpFPI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIlqmB3l3jaM0uQQ3h0vVpVUxripKf8F0Mz-o8qJvssw&oe=6AFB46E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1995466741333220", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824700_1995466744666553_28257383251070186_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQ0rO84yf6UQ7kNvwE-dzvI&_nc_oc=Ado9IfIKsr1YXF1nERcOlMsRG9UWdKu6cEQsHzojLv9ESxjSmYmB1RalTdK_dyOSBKQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP2V7uNiu0rKMoTnnvDYxqRnlJ78ziI6jtlTBqJ-94Qg&oe=6AFB32AD"}, "display_name": "Jamsesh", "keywords": ["Drums", "Free", "Guitar", "Band", "Social"], "long_description": "**Jamsesh is THE next-gen music game. Your stage, your spotlight!** \n\nJoin the jam. Jump into the Jamsesh discord \u2192 https://discord.gg/jamsesh\n\nWith weekly updates, there\u2019s always something new in Jamsesh! \n\n##\n#  \ud83c\udfb6 Play to music with instruments\n##\n\nExperience what it\u2019s like to be a star! Choose drums, guitar or microphone and perform on stage to an audience of thousands! \n\n\n{1317066057198465}\n##\n# \ud83c\udfb8Create bands with friends\n##\nHang with friends, find bandmates and create and customise your own bands.  Perform together, build your fame, and  discover new bandmates - perform & unlock gear. \n\nJump on stage \u2014 go solo or pull up to the social lobby and meet your next bandmates\n\n{4157665797711424}\n\n##\n# Free. To. Play. \n##\nThere\u2019s no price for entry; collectibles and gear are there if you wanna flex\n\n{2546123605822612}\n##\n# Custom instruments and outfits\n##\nDesign your look \u2014 create your own star persona and an identity for you and your band\n\n\n{1697471948041355}\n", "short_description": "Experience what it\u2019s like to be a star! Choose drums, guitar or microphone and perform on stage to an adoring audience!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jamsesh.co/privacy-policy", "developer_terms_of_service_url": "https://www.jamsesh.co/terms-of-service", "publisher_name": "Jamsesh", "support_website_url": null, "website_url": "https://jamsesh.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "27603955999295100"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "13371719113430
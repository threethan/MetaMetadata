_nc_oc=Ado3UPr--SgB9zNqH_w1vvH7CHRwqc5WFw52hhBGQu7LncoEqk5oo3fE9GWuKyM8Rww&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTXauyiRb0DsWdUUA7uyOr3IdMnpmdcAhnJ-1gnKJHDQ&oe=6A941C9D"}, {"file_name": "728196126_27461150950237850_957231309461221416_n.png", "id": "27312930675028928", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825575_27312930695028926_8573605772056100451_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89LDvrpTm6cQ7kNvwGGu5nZ&_nc_oc=AdrTUTkKZRVFqkFFabPbN8FFOKPICMtxRNcInUzK6vnff-O67xaTkJkKh5rPLwUdO8o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjT1xGRhYBnKqxTzxCVfKadkcZpy6MDnIH2WjkMSQkQA&oe=6A940168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1995466741333220", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491824700_1995466744666553_28257383251070186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1JBj17MVf8Q7kNvwGD3eX-&_nc_oc=Adr6gyXmcQ4kUKPpvjODtQzwNlK2bqScYZp7DMmoGHrwPxD2CPA8O4niDoW_pQjo5os&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwSAVeNyXTeljGSok5ZAwdm57w6k3yNc2h4JQzJuQu8Q&oe=6A94256D"}, "display_name": "Jamsesh", "keywords": ["Drums", "Free", "Guitar", "Band", "Social"], "long_description": "**Jamsesh is THE next-gen music game. Your stage, your spotlight!** \n\nJoin the jam. Jump into the Jamsesh discord \u2192 https://discord.gg/jamsesh\n\nWith weekly updates, there\u2019s always something new in Jamsesh! \n\n##\n#  \ud83c\udfb6 Play to music with instruments\n##\n\nExperience what it\u2019s like to be a star! Choose drums, guitar or microphone and perform on stage to an audience of thousands! \n\n\n{1317066057198465}\n##\n# \ud83c\udfb8Create bands with friends\n##\nHang with friends, find bandmates and create and customise your own bands.  Perform together, build your fame, and  discover new bandmates - perform & unlock gear. \n\nJump on stage \u2014 go solo or pull up to the social lobby and meet your next bandmates\n\n{4157665797711424}\n\n##\n# Free. To. Play. \n##\nThere\u2019s no price for entry; collectibles and gear are there if you wanna flex\n\n{2546123605822612}\n##\n# Custom instruments and outfits\n##\nDesign your look \u2014 create your own star persona and an identity for you and your band\n\n\n{1697471948041355}\n", "short_description": "Experience what it\u2019s like to be a star! Choose drums, guitar or microphone and perform on stage to an adoring audience!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jamsesh.co/privacy-policy", "developer_terms_of_service_url": "https://www.jamsesh.co/terms-of-service", "publisher_name": "Jamsesh", "support_website_url": null, "website_url": "https://jamsesh.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "27603955999295100"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1337171911343008"}]}, "baseline_offer": {"id": "1337171911343008"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785878100, "status": "PUBLISHED", "id": "1337171911343008"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28089654540725241", "version": "1.0.1"}, "id": "261066
c_ohc=nW50C6GyOw8Q7kNvwGfGqcx&_nc_oc=AdoxIaHZmcGnws7tNZ-8d4_x4l-PbBQFqLQDwKAejC7mxiS1u8XFcU4aTgCK2kMidYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrpYyMRppSlbhs9Fdjk3tLVW0n3YbTn-wu0Wp3aGhCZA&oe=6AFDC6DB"}, {"file_name": "10\u670813\u65e5(8).png", "id": "1587494682593186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627527_1587494689259852_1109469999864213150_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrJON_scMr4Q7kNvwGXb3Ug&_nc_oc=AdoNSKN8mv85-HhQS8qzoS1VHfoY_GJjoeyDSKZ9EXkmmWHNLybaO0R2-EUMA9ql5fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4wFkuwmn4Xz8Kc8u4awCh8n-bbregqqvtp9b5NzzsXg&oe=6AFDE5B3"}, {"file_name": "10\u670813\u65e5(10).png", "id": "1135821895543074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620341_1135821898876407_4027588876905790746_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjZazID6xzwQ7kNvwHLo6o_&_nc_oc=AdqEqZYf5bezkEWXyBjdIbXvpoUwt3XJyO-k8eVml9_polXNqQeB_T7312KAc3IhoVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZzasq8MF1ziK3_8h7E8--pAMp2vzM96YZzmuMiSXQkQ&oe=6AFDD425"}, {"file_name": "10\u670814\u65e5.png", "id": "1535930151626198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620669_1535930158292864_4338165564501077954_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpSqI7xx4XQQ7kNvwFeCGjR&_nc_oc=AdqncyL08sYArGg8MjIx2HcC-elCdYtGF3Td90adHS7conZHDPj9khJ01M6uGtBMSbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfeTgdvnPmSliDW-iekHVNM4RqNqsIJRNB42dfH_lsLw&oe=6AFDE0BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1873078686994651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593839439_1873078690327984_699756718125280317_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-jzW6Zx3X4Q7kNvwFYfrce&_nc_oc=AdpI34L-dtJSih64RhQb1Chz0enxh_tBPz11uHWm0jHhbsz-6aFNKoWSGGn0Ct_aViM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnPrQ0Gd5j3N55BUYJg03Vb4PsVLZ3gabScHXpTP9OLw&oe=6AFDE018"}, "display_name": "Dreamland", "keywords": [], "long_description": "# Welcome to Dreamland!\nLooking for a place to hang out with friends,  and share unforgettable moments in VR? Welcome to Dreamland, a multiplayer social party game where you can connect with others, explore different experiences, and make every session your own.\n# Meet Friends, Make New Connections\nDreamland is more than a place to play games \u2014 it's a place to connect. Talk with your friends through voice chat, create your own private room for a hangout with your group, or join an open room to meet new people.Whether you're catching up with familiar faces, or meeting someone new, Dreamland gives you a space to connect, and make memories together.\n# A World Full of Things to Do\nThere's always something different to experience here. Get lost in dark, winding mazes, become a cowboy and take on challenges in the Wild West, or simply hang out in a chat room with friends beneath the stars and fireworks. Want to celebrate a special day? Gather everyone for a birthday party!Pick your next activity, bring your friends along, and make every session a new experience.\n# Find Your Look. Own the Spotlight.\nYour style is part of the fun! A wide variety of eye-catching skins, giving you plenty of ways to express yourself and stand out from the crowd.Some skins come with exclusive visual effects or even flying abilities\uff01Pick your favorite look, show off your special effects, and become the star of the party.\n\n# Party. Play. Meet new friends.\nYour next adventure is waiting in Dreamland!", "short_description": "Welcome to Dreamland, a VR social party game! Voice chat with friends, create private rooms, or join open rooms to meet new people. Explore dark mazes, take on Wild West adventures, relax under the stars and fireworks, or throw a birthday party. Show off your style with awesome skins, exclusive effects, and flying abilities. Gather your friends, discover new experiences, and make every moment unforgettable!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamland.zmvr.com/DreamlandPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28300104169685393"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75451775_395919482920656_8635810378252372546_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swrEU1TgCQoQ7kNvwE_2qL6&_nc_oc=AdpXIjYzHOvy35_fzvzQYJ_WrR2u1ogMiyg2n6HLsqqCen61k2MfCWSEXCXmtPmQwqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD4SahhuiSgOa6xJ4Y4upSjpVQTrXMY9sxdJszbfzC6Q&oe=6AFDD7F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamland", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1687656600, "lastRevision": {"nodes": [{"id": "599756542
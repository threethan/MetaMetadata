_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhyAdXgwc-vIw13kyiyO5VpyrtaXTy_5Z2H_2kKeV4bA&oe=69CA5C94"}, {"file_name": "8-2560_1440.03.png", "id": "223194093849966", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982486_223194097183299_2575517891166973028_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb7ElHvOfocQ7kNvwFTdwDj&_nc_oc=AdoV7IFFZD_AJDrJ7l0H6-IbxUxpyH_soqVO5c7gsAwDvljpJjPVo0NTyB3PggpwScc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4Uaj2rIBGK9IoATXaOXx9erXyggiJ5vZGiQ1_hLs_Kw&oe=69CA56CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10-2560_1440.png", "id": "6224892400927341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195908_6224892404260674_3206279987680097715_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=627u_A0_QIIQ7kNvwHi1cMG&_nc_oc=AdqYQlTqlOPMVdbLYqMc5Ieh8yMZlSQ8QBAGgq-CKMVYBBmqX2sSLDNv1CeLI3SFjxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi8usWs-k5VyrtRcjTFFO9oqlbqpiC5BpfI7_S6UiymQ&oe=69CA82D1"}, "display_name": "Dreamland", "keywords": [], "long_description": "The challenges you will face\n\n\u2022 Experience the horror and danger of zombies in ShootTheZombie and OtherShore\n\n\u2022 Defeat the evil cowboy in the town in the WesternRanger\n\n\u2022 Playing the adventurer in DungeonHunter to explore unknown underground castles\n\n\u2022 Break into the dangerous laboratory in GunHunter and defeat the evil organization\n\n\u2022 Use watermelon and cars to eliminate the threatening enemy in CrazyThrowing\n\n\u2022 Evade the traps scattered throughout LostMaze and find the correct exit\n\n\u2022 Experience real live online shooting battles on ShootingSquare\n\n\u2022 Dream World has now launched 19 different styles of game scenes, including social games, PVP games, and PVE games\n\nGame List\n\nHome,Lobby,TheOtherShore,ShootingSquare,TeamBrawl,DesertTown,UndergroundPalace.SpaceSquare,ShootTheZombie,IndividualBrawl,TeamCap,WesternRanger,GunHunter, DungeonHunter,MazeTrial, CrazyThrowing, LoopsFly, LostMaze, GunDuel.\n\nIncluding action, adventure, strategy, role-playing, rodeo, shooting and more, and constantly updated...\n\nOnline Adventure\n\nSome games in Dreamland are very difficult. If you encounter difficult levels during the game, you can invite friends to work together to overcome them.\n\nDreamland is a world full of imagination and adventure, waiting for you to explore and discover. Join us and embark on your adventure!", "short_description": "Dreamland is a free virtual reality multiplayer game, a mysterious and imaginative world where you will experience a wonderful adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/DreamlandPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "1338223150090766"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25837832735912561", "version": "3.3.3"}, "id": "614393517294747", "channel_name": "LIVE"}]}, "is_fo
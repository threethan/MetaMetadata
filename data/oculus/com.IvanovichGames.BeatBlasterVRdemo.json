COyhk7rsalKr8iUPCib2smL5Mz4NQXrZjn69ihA_q2XMgA7ku8m-vczRUuL8dMCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vZQGB4bhgH54WuV6QtwU-14JwmybGdDYMmRr9cRxPbQ&oe=69E8DBE5"}, {"file_name": "screen4.png", "id": "247834320144081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982548_247834323477414_8094020518288850308_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57V31qf1I98Q7kNvwEv56Cp&_nc_oc=AdqDoX-PGqBD14mQm2qf1pZXXORcIsG5xFlxkOuAfMz5imPL3GcruknCQ4zTmm50WPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZCvjxAj3PB5pUjcmVju1952B6Mr8AIQcAiLk6eD0EzQ&oe=69E8BB59"}, {"file_name": "screen5.png", "id": "126955279243438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984461_126955285910104_2757384090958905395_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p44O3e4L1FUQ7kNvwGdTizT&_nc_oc=Adp-mhvwJ_RrR2e4I3oBiU54NB6rzaup0D52QwOaJZ3txtK2WqAKet6YYjzqRORMO28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ypIlqzCKaDFNQQ_yUqBt6GuIWulJpumy3Uu2jNWmG_w&oe=69E8C16D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1145519002574714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1145519009241380_3483380882314472080_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA3NCdmcoqgQ7kNvwHZ6ix9&_nc_oc=AdrbezSqV0amm6yA59e7HDYzkaAZ50JKZui-ILlrdlsUIbBKiOdpDIYzgS9qphVlAb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iEoahAvcxjsdOh0VZtgd-2EwQzifp41t2S5VKAXRWXg&oe=69E8AF9F"}, "display_name": "Beat Blaster DEMO", "keywords": ["Rhythm", "Music", "Shooter", "Arcade", "casual"], "long_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty, and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n3 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, tilting the head, or the intuitive and original control based on the head's movement. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all the game moves are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and single life to dodge or kill all the enemies that will appear to the music's rhythm.", "short_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": null, "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "pt_BR", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9211381948939547"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5
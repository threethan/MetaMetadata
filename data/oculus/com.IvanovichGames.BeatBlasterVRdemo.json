e": "screen3.png", "id": "1350020995358073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_1350020998691406_8282238470663016331_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTCrBbC-HQQQ7kNvwEmXTsy&_nc_oc=Adoz1KCkmEq6JQ7ux_D77IVewd8gS6dFYl7WvoGzGEdfp8PU2FAxV6LbpKDYQGgE9Ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1zmdqr_uJmPR9u8LcahF90_YzTfJXeqDF2s1rL7vtPQ&oe=6AFDB6E5"}, {"file_name": "screen4.png", "id": "247834320144081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982548_247834323477414_8094020518288850308_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcERmue3q80Q7kNvwH_rnQ0&_nc_oc=AdrvvtCZtu-yQzriAMbP6B8aG-S-kbU-vES7-AMGINb0Khl01SggHg8MdedvT6MMRmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROxNW3gNzx5pFUoQ3yqCJPz7C24RH96EAkOOI9hNjyUA&oe=6AFDCE99"}, {"file_name": "screen5.png", "id": "126955279243438", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984461_126955285910104_2757384090958905395_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VkwALUaoF0Q7kNvwG0wUy4&_nc_oc=Adoou9y_Q2xiIoMyD5UikqTVhU6ZrVpbrvM87cmXYf8Ki4BsZix0i4n68UHTsjZ6k3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNQfrTAaiLsNxSU6V6TM3dgqNZqjC1NNON_XBuUQB_cw&oe=6AFDD4AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1145519002574714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1145519009241380_3483380882314472080_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuDG-ICQDJIQ7kNvwHZ8wI9&_nc_oc=Adr3PPd7B_Mg_h56mS8wGgCcSJaTmTI76FPqAI3wTwtQ48GGVW2I_VdU5h0zO0Onc28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZoQIk61G71PkLIESKL4CEHqg-ZYD10-tusrpNbb0Iyg&oe=6AFDC2DF"}, "display_name": "Beat Blaster DEMO", "keywords": ["Rhythm", "Music", "Shooter", "Arcade", "casual"], "long_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty, and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n3 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, tilting the head, or the intuitive and original control based on the head's movement. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all the game moves are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and single life to dodge or kill all the enemies that will appear to the music's rhythm.", "short_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": null, "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "pt_B
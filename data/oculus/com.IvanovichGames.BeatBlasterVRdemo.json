e": "screen3.png", "id": "1350020995358073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982548_1350020998691406_8282238470663016331_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB0XiTD6sMAQ7kNvwFXb7Mk&_nc_oc=AdoeIl7BVUVHhcMhOZBaQvizvYeLRkXP5ywaFP74NCHt74pRCARy4MxHFFhMEY8CytQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCPNthEgQZey9ckLLIuzxtvTpHoJT5ai7-GJAp_TDkpQ&oe=6B0486A5"}, {"file_name": "screen4.png", "id": "247834320144081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982548_247834323477414_8094020518288850308_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4ONi4xxkL0Q7kNvwHkMB9Q&_nc_oc=AdonVVHUydboRxykse3etqlNkhZW7fT8hdIQVmzcc4km4s9JW6Ba781A4-xrIvIs_kQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwjVLFWiErOhwlThA4ncrGnSpf8kYGF2mqiLwlbYnEbg&oe=6B046619"}, {"file_name": "screen5.png", "id": "126955279243438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984461_126955285910104_2757384090958905395_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlNxLng98u8Q7kNvwFRWBVS&_nc_oc=AdoP_tLFyiO1dqzWn3SyJGYikkwxbb-Bp9f8PxKsb4AxtqNlUhN1tO7tDqi8IfNU_ts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOKAbPjCQp7d-b108oJZVVKNFCtt9wmvm_ihARLmHr-A&oe=6B046C2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1145519002574714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1145519009241380_3483380882314472080_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFAOs6ZfEJ0Q7kNvwFhZDTF&_nc_oc=AdrCcrMncY_9QLy_kmGTxJUI0R9gTGtV14NeRU3axh8LfBzYt_XwW5FBBxJ9PF8Acoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPfHO3w6xgJ50aBNyt6YidQTNWbO1DFCaDlORbemO7dA&oe=6B045A5F"}, "display_name": "Beat Blaster DEMO", "keywords": ["Rhythm", "Music", "Shooter", "Arcade", "casual"], "long_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty, and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n3 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, tilting the head, or the intuitive and original control based on the head's movement. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all the game moves are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and single life to dodge or kill all the enemies that will appear to the music's rhythm.", "short_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": null, "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "pt_B
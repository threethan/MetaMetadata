e": "screen3.png", "id": "1350020995358073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982548_1350020998691406_8282238470663016331_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxjHhqNOMBoQ7kNvwFMpOnK&_nc_oc=Adr1CFsVDpf60T23mkP-8Pf36KW8USOqK1d9r7PUu6l2VJysLc8fzbum2Wb9bF9ikCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmHihBDo3P3faVmP_VAQ-3wfM_x4SgrL4ne8YS2ibVdg&oe=6B106425"}, {"file_name": "screen4.png", "id": "247834320144081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982548_247834323477414_8094020518288850308_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J8F8ZUKTykQ7kNvwHuc2nT&_nc_oc=AdqULTFVHpQ8Fij7hFvqQ_bAim1sVR3i9m-WaRoWRiE2rRKk5GIY5Vi7CDfuAAlC734&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHlvhhAzSh2HAZTUmApMml0sLq4yMVEp20WUMG1Dtjpw&oe=6B104399"}, {"file_name": "screen5.png", "id": "126955279243438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984461_126955285910104_2757384090958905395_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TYfDzWAHrUQ7kNvwHzXsuT&_nc_oc=AdrCAp-xMiUHEJil-KO2_7Gz7YoDrSdSKLD2HiW1PFByyazETN8Bk05rZmTLcMLNjX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVhZ53DI-e_1SjFuszhDqFioIqFT_mCZOIkOMjyU1ZXLg&oe=6B1049AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1145519002574714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1145519009241380_3483380882314472080_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWVD-2bMOb4Q7kNvwEnTnMc&_nc_oc=AdpwfZB9B49uLlMe4fxbW4n-MaFaWZz18Kpbyx0RDwuniA5M2duvgRlwqIMrA3BUAgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDa2suPaQSBMoWOvw8oaCqSDO3i3OE-efEukQWN66I2A&oe=6B1037DF"}, "display_name": "Beat Blaster DEMO", "keywords": ["Rhythm", "Music", "Shooter", "Arcade", "casual"], "long_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty, and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n3 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, tilting the head, or the intuitive and original control based on the head's movement. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all the game moves are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and single life to dodge or kill all the enemies that will appear to the music's rhythm.", "short_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ivanovich Games", "support_website_url": null, "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "pt_B
88850308_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVY8uVeZXdYQ7kNvwFwaUP3&_nc_oc=Adqtxam9uixlmKaWM2S0c6rz1PSd2IeWH7Xs9PEmA_Htr19ISeHQ65u3gnwTAEkFdNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5ccDZ-47dFjN4DrWq4nWpd6H9P6CG75hgJXjAd5tflw&oe=6ACFAA19"}, {"file_name": "screen5.png", "id": "126955279243438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984461_126955285910104_2757384090958905395_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVNd-_C6cj0Q7kNvwEq6W1S&_nc_oc=AdqVVQninPlRo7rDoFCRwBtxB8B4D6euOoCccIgOJ9460LsNiYQ4vC6TRov-Itf1Mtc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsasoeJ6qdzmOWiXnShg5ZEOUY-2k4NFFC2ShwkOKXWQ&oe=6ACFB02D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video.png", "id": "1145519002574714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_1145519009241380_3483380882314472080_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZk2kbohdwIQ7kNvwEIyeG5&_nc_oc=Adq3nXw8FCkVuKmRtUd5RrBjNWRKyrDtUedCHcQyzKsPPN8fn4Bte6tls7aFn-QESV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPWEX-pxFF5kZVPCDL1gbbQsNPNlNntYPPyRLuhs6-zQ&oe=6ACF9E5F"}, "display_name": "Beat Blaster DEMO", "keywords": [], "long_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge.\n\n30 SONGS & AMBISONIC AUDIO\nEach level introduces a novelty, and all the games are different thanks to the intelligent generation of levels. \nAmbisonic sound lets you experience the music in an entirely new way.\n\n3 WAYS OF MOVEMENT\nYou can choose between the classic VR controller, tilting the head, or the intuitive and original control based on the head's movement. \n\nNO MOTION SICKNESS\nBeat Blaster is a VR game with a high-speed component. But all the game moves are designed without rotating the player, thus minimizing the probability of motion sickness.\n\nEASY RULES\nTo clear a level, you must reach the end of the song without dying. You have a Blaster with infinite ammunition and single life to dodge or kill all the enemies that will appear to the music's rhythm.", "short_description": "Beat Blaster is a VR game of shooting, running, and dodging where everything happens to the music rhythm. An original mix of styles where each game will offer you a new challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ivanovichgames.com/privacy.html", "developer_terms_of_service_url": "https://www.ivanovichgames.com/privacy.html", "publisher_name": "Ivanovich Games", "support_website_url": "https://www.ivanovichgames.com/web/contact/", "website_url": "https://www.ivanovichgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "en", "pt_BR", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "469920751398902"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2782718895315617"}]}, "baseline_offer": {"id": "2782718895315617"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1620082080, "status": "PUBLISHED", "id": "2782718895315617"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24902510452733444", "
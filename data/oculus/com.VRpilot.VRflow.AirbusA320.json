=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6frbzsbI8J9fEDdpab8SUQsxlnyabFY4NWhq9EIDWKw&oe=6A859E49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRflow Oculus Store trailer_thumb.png", "id": "1170281000112103", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974503_1170281006778769_5305616749076049116_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWF-9JbMtIMQ7kNvwFVWna0&_nc_oc=AdrUGnXlAbWtuZ_us9FjE8QCXD4aD-O1sKnTCJk44Z6wQP9i6_BOkGul3YQ7ijoc2b4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIkBBCoxh6f2sqaKL7rX89JqCNntYTw8uCHF5ObKCpSg&oe=6A85823B"}, "display_name": "VRflow Airbus A320", "keywords": [], "long_description": "VRflow A320 is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\nThe following procedures are included: Preliminary Cockpit Preparation, Cockpit Preparation, Before Start, At Start Clearance, Engine Start, After Start, Taxi, Before Takeoff, Takeoff, After Takeoff, After Landing, Parking and Securing Aircraft.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.", "short_description": "VRflow A320 is the interactive cockpit procedure trainer for pilots. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nAll purchases of VRflow will be upgraded as we add more procedures, fix bugs and make VRflow better."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url"
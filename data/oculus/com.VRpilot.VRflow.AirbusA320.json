-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nGUPZWCY2Djpah8vlu6nySnWjxrgEz8I9_uJz_LF7pg&oe=6A414889"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRflow Oculus Store trailer_thumb.png", "id": "1170281000112103", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974503_1170281006778769_5305616749076049116_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4WjKKzG2ygQ7kNvwF1zomx&_nc_oc=AdoXCLDRZl_xXLPsw_EM3Du-04MukBI9898iCfcy2C71_81t-BzzCj6ChbXs9NqFMdc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fqgmXXBZK4Ree4BFZJO01HZR1zroO8njB8OWwa6S8uQ&oe=6A412C7B"}, "display_name": "VRflow Airbus A320", "keywords": [], "long_description": "VRflow A320 is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\nThe following procedures are included: Preliminary Cockpit Preparation, Cockpit Preparation, Before Start, At Start Clearance, Engine Start, After Start, Taxi, Before Takeoff, Takeoff, After Takeoff, After Landing, Parking and Securing Aircraft.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.", "short_description": "VRflow A320 is the interactive cockpit procedure trainer for pilots. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nAll purchases of VRflow will be upgraded as we add more procedures, fix bugs and make VRflow better."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "611597100138988"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "256743392962971"}, {"status": "PUBLISHED", "id": "352173646608932"}]}, "baseline_offer": {"id": "256743392962971"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1630509720, "status": "PUBLISHED", "id": "256743392962971"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27091917080403445", "version": "1.12"}, "id": "852652802032882", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4312061448815665", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27091917080403445"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "852652802032882"}]}, "change_log": "Typos fixed.", "created_date": 1779176230, "id": "27091917080403445", "version": "1.12", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {
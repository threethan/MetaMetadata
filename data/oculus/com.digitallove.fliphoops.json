U-UKfDWNwZzl6eNt9qjG2eYSc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoPeMJUaJFSYgwkKDf3VDykAAykWwghMWFAGXxmDG4lg&oe=6A80542A"}, {"file_name": "Screenshot 1.png", "id": "937129968774325", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823949_937129972107658_2389765946151677999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-b-8Z8txJAQ7kNvwFPPwhd&_nc_oc=AdrrU6LwfkXrFL7az1DUXidEfyg6wwtLoeaUp2yj6B5ztyNLz88f3lKCCiF_VWd-DuY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUHhB7-odVcmCQvLgRZUTEY2g0T9kZ0MtD4VMuePXuow&oe=6A8040D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "1656835112343107", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821674_1656835115676440_2105807332759053448_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSdQvHOQfggQ7kNvwGpH4Qy&_nc_oc=AdqdqYyKPZjFAvGNLtUXKo24oRZzXMNfVQkeA1XhzRy1cJyqy5FbCMJGKuidPZ8pfHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZIzWs7oN_hD7fBplNdarIJoRm74ZZ1J4JbXFZg0ygNg&oe=6A80570E"}, "display_name": "Flip Hoops", "keywords": ["basketball", "gravity", "arcade"], "long_description": "**Gravity just changed. Can you still hit the shot?**\n\nStep into an arena where the laws of physics are only suggestions. **Flip Hoops** transforms your actual room into a high-speed, gravity-shifting basketball court. This isn\u2019t just a game about shooting hoops; it\u2019s about surviving a 33-second blitz where the \"ground\" can flip in an instant.\n\n\ud83c\udf00 THE ULTIMATE GRAVITY TWIST\n-----------------------------\n\nIn Flip Hoops, your environment is dynamic. One moment you\u2019re aiming for a standard rim on your wall; the next, the world rotates. Suddenly, your floor is the ceiling, and you have to launch the ball _downward_ to arc it into a basket hovering over your head. Can your brain keep up?\n\n\u2728 KEY FEATURES:\n---------------\n\n* **33 Seconds To Glory:** Every round is a high-intensity sprint for the leaderboard \ud83c\udfc0.\n\n*   **True Mixed Reality:** Your walls and ceiling become active backboards using high-fidelity passthrough.\n    \n*   **Pro Hand Tracking:** Leave the controllers behind. Just reach out, grab, and flick your wrist to score.\n   \n**Your room is the court. The world is upside down. Are you ready to flip the game?**", "short_description": "Gravity just changed. Can you still hit the shot?\n\nFlip Hoops transforms your real-world environment into a shifting arcade arena. Rack up points in 33-second bursts as gravity rotates from floor to ceiling. Sink \"Nothing but Net\" swishes on your actual walls, unlock legendary skins, and prove you're the G.O.A.T. of Mixed Reality basketball."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fliphoops-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26813491774923620"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1976697120398378"}]}, "baseline_offer": {"id": "1976697120398378"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773905460
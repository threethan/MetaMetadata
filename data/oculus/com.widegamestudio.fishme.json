* \u2192 **Fight** \u2192 **Flex** \u2192 **Repeat**\n\nDon't forget to join our Discord!", "short_description": "Fish... or get fished! Cast from the anywhere, reel in a fish from uncommon to legendary, then chase it down before it escapes for good or... comes after to bite you.  That's FISH ME!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/widegamestudio.com/fishmeprivacypolicy?usp=sharing", "developer_terms_of_service_url": "https://sites.google.com/widegamestudio.com/fishmetos?usp=sharing", "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1747980120029811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673558985_1806816140433010_1233412894813395027_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhZUg8Bvuf0Q7kNvwFrvY20&_nc_oc=AdqJX2Vq3OHh80-pzKIyWy40efpDV5NzdRktmVojzWk__Dfz1uDv5v6oQGJzrQw9RGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCRqS5kDET0ZwXxa3hxV39HS56Y1InJhG-0QlO05_1ug&oe=6B0455CF"}, "is_concept": false, "is_test"
ere the only things standing between you and a watery grave are your gun and your own rotten luck. \n\nTest your skill in wave after wave of arcade-style aerial combat.\n\nChoose between survival and glory with 10 different challenge modes.\n\nRack up high scores to become the most notorious gunner of your time.\n\nYour comrades say you'll be in the drink before the day is out, but life's a gamble and no one lives forever. Give 'em hell, Ace!", "short_description": "Welcome to the tail turret, where the only things standing between you and a watery grave are your gun and your own rotten luck."}]}, "developer_name": "Grizzly Machine", "developer_privacy_policy_url": "https://www.grizzly-machine.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Grizzly Machine", "support_website_url": "https://www.grizzly-machine.com/contact", "website_url": "https://www.grizzly-machine.com/tailgunner", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FLYING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "278995277665851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974774_2757397627684328_6121967175931527168_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPQgHzEDRmcQ7kNvwFuTQmI&_nc_oc=AdpI9CtZjoloItzqJ-g1OdzM89Uf1qYgfxdBo7zB_RtGhGRWxDsBd7jzBoTPoTy3wVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CoUl_iABfR2pa7xL7_GVEyBEQCOxi-u8uelbtBGEC-w&oe=69D39B20"}, "is_con
.com/v/t64.5771-25/39031401_1343203129191573_749809699704012800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWLNYdHWMVQQ7kNvwFwA4TS&_nc_oc=Adklsuqdeu2U7gXZZo4W-ExDNXIFBXLi6wO0rp_Xh8nMHWzgSVfhnInyP7nUIhu5Cg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvh2k2Sd4y1-AB6BLDXyRw-jxRSNPPZo1WDH590WxdLcA&oe=69A03722"}, {"file_name": "migrated_image.png", "id": "229898084862354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303839_1468819519949319_5321938695673085952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avYnJcANp6AQ7kNvwEgs2Sr&_nc_oc=AdnbDR4kPS8QzfYOIneBABhdvionyRkEoqf5sPRFYginwSbtQ-Ew_E_Zj1B0R86tGwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxzKuWm5lHbDhIs1eQ9kN8kWrzWPc7XPYI1jxIzTlIFA&oe=69A0311A"}, {"file_name": "migrated_image.png", "id": "2516816865089503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982458_2723478237673905_5623678650936197120_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4Vqc-i4p2wQ7kNvwH1ipaP&_nc_oc=AdlbNs9u1cDV8-KG7Zavqt9_gVaN6_HZ9y_JWc4WfUh9Cd9thh7yN4MQf2IG7zK9g2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu65nZaRziyhWHsSQyUn4iBR81R4EbUUdycCGpmh2hmug&oe=69A03D64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QgQgdx", "id": "363531957809828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982473_363531961143161_6366102209481932800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rB4JIhnJBKwQ7kNvwFBHc3z&_nc_oc=AdmiNprS4PX02MejXJSt3MVAxQrghMYM4KwYuSx5FT6Un_vj-uvmBLrf8KdLwFvWRPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv889i3av6RQDhdXZhv-8kA0Oc8CKLAAYp24SIf4men1g&oe=69A029DD"}, "display_name": "Tailgunner", "keywords": ["shooter", "arcade", "flying", "airplane", "celshaded"], "long_description": "War is in the air. \n\nWelcome to the tail turret, where the only things standing between you and a watery grave are your gun and your own rotten luck. \n\nTest your skill in wave after wave of arcade-style aerial combat.\
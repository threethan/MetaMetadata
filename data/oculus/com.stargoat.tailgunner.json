.com/v/t64.5771-25/39031401_1343203129191573_749809699704012800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKkFW63kSnUQ7kNvwGgSY-U&_nc_oc=Adl5c58jFt6NJkzjs_sxYWpZgws_VXLIqQk6Vy_vSwE04gbiY5CMOYYeFDclq8X9cpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsonzteHAeYHk7_HYER12Kf1OEybRANVp-TNPHUZx7nWw&oe=69984E22"}, {"file_name": "migrated_image.png", "id": "229898084862354", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75303839_1468819519949319_5321938695673085952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14_oKfOo7sIQ7kNvwFOFhUS&_nc_oc=AdlPVUD3fB_DMy2qzGbbDjh-UDvWdI3MnnOZe9kY4PGkQpHmykTY_mMKBz9OHecbXCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuFKv1-pirU-rB7GDskGKMHoY32jN2m_tW2FmR51LeMZA&oe=6998481A"}, {"file_name": "migrated_image.png", "id": "2516816865089503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982458_2723478237673905_5623678650936197120_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4qzYdqmSdIQ7kNvwGL6fOk&_nc_oc=AdknUxyFXAdc7bz86PwExUJtGbLLXLOeNyqhT9isVohJRfy3Wqp2Vyheya_zZieXHcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvADI65gB2gwAH6FyIAeyYNYsgh-9lBoHjGsp5pinIogA&oe=69985464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QgQgdx", "id": "363531957809828", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982473_363531961143161_6366102209481932800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeaR1l5WpeIQ7kNvwEYYtSU&_nc_oc=AdmqwlyVBU2sQ_5i0RuskhvbgmcsdogJ0QTGsBqDEPL2_1BtLeXZA-QcI7jTWPwh3R4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvcgQEj-_Gz56XzXLax13YirTpKCJZKzrHe6qCVvUb81w&oe=699840DD"}, "display_name": "Tailgunner", "keywords": ["shooter", "arcade", "flying", "airplane", "celshaded"], "long_description": "War is in the air. \n\nWelcome to the tail turret, where the only things standing between you and a watery grave are your gun and your own rotten luck. \n\nTest your skill in wave after wave of arcade-style aerial combat.\
scdn.com/v/t64.5771-25/491830441_1485645573379920_6101888112851096281_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpDvwdSlNUoQ7kNvwEUUQvt&_nc_oc=AdqXQU88ptL1USBh4lBhCm7zo7wegYqWAlZGU2gzW3po_dJwD707DPjhMtE3OduU08M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIApUl2AkReiaKYOoc25KjY2py8hJD-AWlzgtnaG8VDA&oe=6AFB4150"}, {"file_name": "Trap_Life_2_Police_Cruiser_2560x1440.png", "id": "1600557664900066", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595119480_1600557668233399_4607244000181722666_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1Z_1gDqAH4Q7kNvwHg1SXE&_nc_oc=AdqphvcvYBJQI2TD68rJ78q8MnI-XVkU38qDzG2euTqQPQ4Z5um-RpiOq8tsjWbMVNI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnNiexrGVu5KGQ9z4ci59NIUOwRBQ5EmQXqICQOjWnqA&oe=6AFB1BC2"}, {"file_name": "Trap_Life_2_Nightclub_Money_2560x1440.png", "id": "1107298655275739", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830576_1107298658609072_2740127793640763558_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFGb5p1BxicQ7kNvwFK5uMG&_nc_oc=AdqRkxF_ce3Ycm1tpNuvacw1L3OY_DlOOb85whHSgCV2TeRGYxZGAv3_3DjrgjHofG8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhxZXQvvRlw-gXGmUU-Wq-5uJPL3zNmJiJvMho7_plSg&oe=6AFB405E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trap_Life_2_RICO_clean_2560x1440.png", "id": "1889336142446370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295481_1889336145779703_1033501578000981508_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzjSwKBu8qgQ7kNvwHVzEO6&_nc_oc=Adrz0i-IHKhQ6x4L9uQBp6wWgI2mvVBXX_ZlQQjZz3n454CN8kd5cvkZa3EliM3VIuk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0nj9G5NDENRp1HuGnx-7SXiOwr2is8pPuNPzqSUY_lQ&oe=6AFB3F98"}, "display_name": "Trap Life 2: RICO", "keywords": ["openworld", "crime", "driving", "roleplay", "multiplayer"], "long_description": "Your city. Your choices. Your story.\n\nTrap Life 2: RICO is a multiplayer VR open-world roleplaying experience where you decide how to build your reputation.\n\nExplore Ocean City, drive through the streets, buy and customize cars, earn cash, complete missions, purchase weapons, build your character, hang out with other players, and create your own story.\n\nChoose your path. Build a crew and rise through the streets, become a police officer and enforce the law, chase money through jobs and businesses, or simply explore the city with friends.\n\nFeatures include:\n\u2022 Multiplayer VR roleplay\n\u2022 Large open-world city\n\u2022 Cars and vehicle customization\n\u2022 Police and criminal roleplay\n\u2022 Jobs, missions and activities\n\u2022 Player progression and levels\n\u2022 Weapons and combat\n\u2022 Properties and stash houses\n\u2022 Social locations and nightlife\n\u2022 Character customization\n\nEvery session can play differently depending on the people you meet and the choices you make.\n\nControl Your Destiny.\n\n\ud83d\udc49 Join the city: discord.gg/TrapLifeVR\n\nWelcome to Trap Life 2: RICO.", "short_description": "Trap Life 2: RICO is a multiplayer VR open-world roleplaying experience where you decide how to build your reputation.\n\nExplore Ocean City, drive through the streets, buy and customize cars, earn cash, complete missions, purchase weapons, build your character, hang out with other players, and create your own story.\n\nChoose your path. Build a crew and rise through the streets, become a police officer and enforce the law, chase money through jobs and businesses, or explore the city with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://traplifevr.com/privacy", "developer_terms_of_service_url": "https://traplifevr.com/terms", "publisher_name": "SupErWin Studios", "support_website_url": null, "website_url": "https://traplifevr.com/", "category": null, "comfort_rating": "COMFORTABLE_
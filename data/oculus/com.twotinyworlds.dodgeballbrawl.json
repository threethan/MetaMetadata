0450520_1230094703841343748_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh5E0jnol54Q7kNvwH9qcI5&_nc_oc=Adp09H2XaFjdcmDVS6f8Rc7CmVIZeFcHY7tr_E2JIai7r5IUxZ1F-Q8Lw-xQJGYl3R8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwrKNLAWYNdkHVByu9RSDguUfayp192ZrzbHdbjX20gw&oe=6B0D9CBC"}, {"file_name": "lights-out.png", "id": "1399618328648356", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1399618331981689_3210176801198649899_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebuAZsL32LgQ7kNvwGKMpto&_nc_oc=AdrXBc1yEvkCofsrcz4QV3ZkaBlZwTWWYs_LqmWacnyK9oLspyy1a2tF1BsUAeKsnQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSjB-aBSVgmf9HzaBHKhsoocgox45wvJLwwYqCBeUqEw&oe=6B0DC04D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dodgeball Brawl", "keywords": ["sport", "arcade", "fun", "throw", "dodge"], "long_description": "Dodgeball Brawl \u2013 VR Arcade is a bold, colourful dodgeball game for Meta Quest. Step onto a splatter-painted court, grab a ball and go head to head in fast, friendly matches.\n\nPick up balls from your side of the court, throw with a real arm swing and catch the ones coming back. Block with a held ball, duck, dash and jump your way out of trouble. Matches are 3 on 3, with bots on your team, or you can team up with a friend online.\n\nThree ways to play:\n\nQuick Match: you and two bots against three bots.\nPrivate Match: play with a friend on another headset, using a join code or an invite.\nTraining: three practice bays for throwing, catching and dodging, with best scores to beat.\n\nChoose from Classic, Arcade and Party modes, each with its own rules for hearts, sets and time. Special balls turn up in matches too: a heavy watermelon that cracks apart, a disco ball that shatters, and a rubber chicken that knocks out whoever it hits.\n\nClassic Mode - Real dodgeball rules\nArcade Mode - Classic rules (relaxed)\nParty Mode -  More chaotic, more lives, more ball types and obstacles\n\nBetween games, hang out in the plaza and browse outfits in the Crown Closet (purchases coming soon), train and play mini games", "short_description": "Stylised, kid-friendly dodgeball arcade. Dodge, catch, block and throw in 3v3 matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dodgeball-brawl-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Tiny Worlds", "support_website_url": null, "website_url": "https://sites.google.com/view/dodgeball-brawl-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1448269541694615"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2564568744020807"}]}, "baseline_offer": {"id": "2564568744020807"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795046400, "status": "PUBLISHED", "id": "2564568744020807"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1495320783656157", "version": "0.2.2"}, "id": "1645668250905441", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__t
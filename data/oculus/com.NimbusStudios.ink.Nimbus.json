YTqsbOKUzcv4QrT3waYd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSNSYIjFa8E2fSQb7n10DMadIkKvWWY-3JlSgqvSJGVA&oe=6AFDC0B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NIMBUS Banner.png", "id": "1144838296514120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003276_1144838299847453_9209966805772355870_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwabytl5TeMQ7kNvwEibrjw&_nc_oc=Ado04NmvEoAXVo6PTgQ0WzhDN4-ct4p3TKWdRCrjKzhAqajvpN6oNVVzh97TBJYFv_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm3rw3rrlVRAphE0owDx8bs15ODnMbjJmCC3dSU3G9gQ&oe=6AFDAE35"}, "display_name": "Nimbus", "keywords": [], "long_description": "Nimbus is a multiplayer VR game designed and developed to help people make friends, have fun, and compete in challenges. Overall, Nimbus is amazing and quite fun. The Beta Testers including myself, really enjoyed playing the game. I hope you will too. This VR Game is met with many different environments and events such as Forest, Cloud Puff, Lava Room, Shop, Hangout Area, Mod Vents, Horror and much more!! This game also includes assets from other games and publishers. Some of the assets show INGAME are not owned nor created by the owner of Nimbus, \" VORSHADOW \". VORSHADOW has collected and verified 100% permission of use by the creators of the assets. The publishers known for some of the assets shown in this game are Vozify (OWNER OF MONKE MANIC), Shrek (OWNER OF BIG SCARY), B.Awesome (OWNER OF PROBOSCIS), Scod (OWNER OF SCOD RUNNERS), Dakota (Transgender Artist), Pear (OWNER OF FRUIT PICKERS), Random YouTubers (YouTubers), Other Creators (YouTubers, TikTokers, Artists, ETC, and Lemming (CREATOR OF GORILLA TAG). The locomotion used in this Gorilla Tag Fan Game was created, scripted, and networked by Kerestell Smith (also known as LemmingVR or Lemming).", "short_description": "Nimbus is a multiplayer VR game designed and developed to help people make friends, have fun, and compete in challenges. Overall, Nimbus is amazing and quite fun. The Beta Testers including myself, really enjoyed playing the game. I hope you will too."}]}, "developer_name": "VORSHADOW", "developer_privacy_policy_url": "https://docs.google.com/document/d/1uApvFCq8WOFh2ayHa4ixXVpLLRMgwnuOzNu__CjAe_8/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Az-oe1qXPX3xVVLl1oj5eyqBvzq3p-4JXbBwfuJCZIc/edit?usp=sharing", "publisher_name": "VORSHADOW", "support_website_url": "https://youtube.com/@VORSHADOW", "website_url": "https://sites.google.com/view/nimbus-management", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7278389018864946"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031333_417315917653401_9154185212060228281_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-2qSCLeVbUQ7kNvwGlwInY&_nc_oc=AdpTDlqfm2Dgz2KQedYrVTcpDjYDU3zFsxPBp9rlVWFOqbddkHupJB1ajcTYG_cYUys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBoNUvuqBmE27eHwyIKyrPgvSOdhZ2xGjbPpQhtRWC8A&oe=6AFDB6E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nimbus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_to
aUWqUe6zd2MHbHYICKTaQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmt3d91Eul_a87kdTqcwkYrulCi_KnnnmzyYDyZyCdEg&oe=6B084CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NIMBUS Banner.png", "id": "1144838296514120", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003276_1144838299847453_9209966805772355870_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY4Oe9g1f5oQ7kNvwFhc68p&_nc_oc=Ado45lcIn9rjCuRMT4Uqv1fq9dG2po5WD6Y09lub_4vDaMF-Wwfr74pm2v1GumPWI20&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIvi0d2eAp74OUIXqc7dB5h3Ed8e251uVVRBH6wf4gwQ&oe=6B087275"}, "display_name": "Nimbus", "keywords": [], "long_description": "Nimbus is a multiplayer VR game designed and developed to help people make friends, have fun, and compete in challenges. Overall, Nimbus is amazing and quite fun. The Beta Testers including myself, really enjoyed playing the game. I hope you will too. This VR Game is met with many different environments and events such as Forest, Cloud Puff, Lava Room, Shop, Hangout Area, Mod Vents, Horror and much more!! This game also includes assets from other games and publishers. Some of the assets show INGAME are not owned nor created by the owner of Nimbus, \" VORSHADOW \". VORSHADOW has collected and verified 100% permission of use by the creators of the assets. The publishers known for some of the assets shown in this game are Vozify (OWNER OF MONKE MANIC), Shrek (OWNER OF BIG SCARY), B.Awesome (OWNER OF PROBOSCIS), Scod (OWNER OF SCOD RUNNERS), Dakota (Transgender Artist), Pear (OWNER OF FRUIT PICKERS), Random YouTubers (YouTubers), Other Creators (YouTubers, TikTokers, Artists, ETC, and Lemming (CREATOR OF GORILLA TAG). The locomotion used in this Gorilla Tag Fan Game was created, scripted, and networked by Kerestell Smith (also known as LemmingVR or Lemming).", "short_description": "Nimbus is a multiplayer VR game designed and developed to help people ma
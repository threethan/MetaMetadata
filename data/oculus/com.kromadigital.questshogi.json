ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_1857554755657325_5681842763290867083_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih13YbOuCMcQ7kNvwEwgrFM&_nc_oc=AdrfsY_SLmkne4USHGzOtj1iDNfEnp1tJKKdDAvy38hvk8vY6JCJFqwhX_ez2_FYFB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvOE04xTqdS_kUmzh6-rDQ0dsSkbCl6IV5lCVps_KHIQ&oe=6B0EF21A"}, {"file_name": "pic01.png", "id": "1790754895290975", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593863731_1790754898624308_3379113257588405239_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNusMmNH21IQ7kNvwEKpzDX&_nc_oc=Adq-Hhh8hiJ7Ji8UPrd7ioy2Ul1U9WGw5JWFvqm_ilAB5arrI9nJtzon715Z4J7xtxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWsTflHheUyH3n-lw4oX-aKmL_MvwH2j1gDq3BEVjpW4g&oe=6B0EF5D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cm_thumbnail.png", "id": "1086420650880779", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622162_1086420654214112_5986656680160068480_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OrFzA2iuVwQ7kNvwG1tUKw&_nc_oc=AdqDinCgtYBl9Q9mfEC5dkHa8IwRgUlfAwHcWF1ygwiGvE0Z4SLEnpMpixjsGPnW9XI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5XUwjKrv6-dIevk43teYcWMK5CoyKvUO0zym8J9W7zw&oe=6B0F0615"}, "display_name": "Quest Shogi", "keywords": [], "long_description": "Enjoy authentic Japanese shogi in your own virtual Japanese room.\n\nQuest Shogi brings traditional Japanese chess to Meta Quest with natural hand tracking. Pick up and move pieces directly with your hands\u2014no controllers required.\n\nChallenge the CPU across 20 difficulty levels, from beginner-friendly to more demanding opponents. Practice strategies, review your moves, and improve at your own pace.\n\nChoose from daytime, evening, or nighttime Japanese-style environments, or switch to mixed reality passthrough to play while seeing your surroundings.\n\nFeatures:\n\u2022 20 CPU difficulty levels (Level 1\u201320)\n\u2022 Natural hand tracking for moving pieces\n\u2022 Post-game review with move history\n\u2022 Three Japanese room lighting settings\n\u2022 Mixed reality passthrough mode\n\u2022 Customizable shogi clocks\n\u2022 Hint and undo functions\n\u2022 Play as first or second player\n\u2022 Resignation and repetition handling\n\u2022 Fully offline single-player gameplay\n\nWhether you're learning shogi or enjoying a challenging match, Quest Shogi offers a relaxing space to play, practice, and improve.\n\nYour next move awaits.", "short_description": "Play authentic Japanese shogi in mixed reality with hand tracking and offline CPU opponents."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kroma-digital.pages.dev/privacy/quest-shogi/", "developer_terms_of_service_url": null, "publisher_name": "Kroma Digital", "support_website_url": null, "website_url": "https://kroma-digital.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1371038829426763"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628449_2211338173128579_3138183059294537145_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9_30xIkMyIQ7kNvwGyVq3R&
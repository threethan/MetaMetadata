qd&_nc_oc=AdrR6UESr35mfnGw2FwGa8-rGF0lzjTylW7d1OLB-fizKHsmqIVbDWaxQ68ZtxoZC2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lFkahGMNdN99IU8z4Wd5Ov_MTC_Qb1Hw8IowbgOPDlg&oe=6A25A315"}, {"file_name": "ss (7).png", "id": "549528158241865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823434_549528161575198_2407590036536240669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bqgn_PjvX1QQ7kNvwEwXpvU&_nc_oc=Adqk4xATLpKg8z3A_WA36RPLO7x_XcIAeXHr-wRcLzrBjNJ8udpjbxFXqNOpCHtVHuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98P0YW9A2vCcjfrBVyeGkI41hkqCYvoj8S-iZUa8WAYQ&oe=6A2598FD"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fFFmAWWzm4Q7kNvwEqen_F&_nc_oc=AdrJDmcKPlf3pp2_yVFk593oHhIxMgWjbrkm3UPaQy4gFgaRLRjhkeQOLfey6M4MpRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JQgTgud0y3LtEq3DkuPJ2a283Hy-nAnBcRWV3UNyA_g&oe=6A25A4A4"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TblME9qHpUQ7kNvwF8VFzD&_nc_oc=AdogM17YDnmlhlC_J-1wgbLRByExOUSobyoq-2L_1cQiD0lCZN49I1mpq6UlNsjdnSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sMNWRboOqzkVQZfsuJFc2Fzke1vzx-U5u6_5hibT0Ng&oe=6A2589FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIS3JyxqdWoQ7kNvwGzz3Ot&_nc_oc=AdrFktCOGKeKiAillmZHr9MJwXhU7ZySj2BFyWodeSjklAXKIBtA8sKK6PnpKwgmSfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NS1gINhpqSFzbuoIS4VCzk9C03Yn4n7nL5qxKqSvpEw&oe=6A257D26"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8taH9ktl0Otjf5pI2VA2OF2dOvVYEBPGS4_nsWEGqwg&oe=6A2971A6"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_con
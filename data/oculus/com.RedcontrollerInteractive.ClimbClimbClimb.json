8r&_nc_oc=Adr4kPMKTR6hNszcoNUkfy65IqmjrB8CNb72ujN3Ocl46gl3vbvChiBdFu369acFvmA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80CEPFRWzWztrpWCtD7_bRZ15q8wAgyLmu4NwkQHaowA&oe=6A241955"}, {"file_name": "ss (7).png", "id": "549528158241865", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823434_549528161575198_2407590036536240669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bqgn_PjvX1QQ7kNvwE7G_t6&_nc_oc=AdqCEy8sAPVErOlVapsiPzEhh1VwRs0yshRoVzl0gVI1yMKwdjcLh9EV6NlhxOMyEqE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JI15LwEczKt-flHCNB_Ps_Az0Acjp7giWRkwizgVCLQ&oe=6A24477D"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcTd_qBH7RcQ7kNvwG2-UyJ&_nc_oc=AdrbOWggTNq0Nl1EDL03_4PAdF3g7UkiTXPBrszwBo2Cp1_ZJWA0kxF__C--DfVqf7s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xp_SqwHZP9he50_zw4XZl5IcM7UR1GUqPr7vfprW1xg&oe=6A241AE4"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEJ4_ADjMy0Q7kNvwFOLokD&_nc_oc=AdqZtJFXol9_aQFIXjd9vizfVCQ6JYGPB120DVbFMzWJvHEgSURxuMb7upi3BdQNfsA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90h2g0f6qmtydLkeUlv0hpMc9dkzksmeUOwLFOKCDStg&oe=6A24387D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIS3JyxqdWoQ7kNvwEkXzES&_nc_oc=AdqrhtD9nQwr_ezlv76KEWAcxQ-gnBqYa4L3g75IvzLbx_Gw3u3gsjKexofOc7Fcsh4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kFkWlx61NU47Jf7usyKmc6sP-pXb3czK3Z8axXqJajg&oe=6A242BA6"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
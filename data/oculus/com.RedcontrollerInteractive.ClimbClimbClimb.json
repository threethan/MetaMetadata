865", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823434_549528161575198_2407590036536240669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wB3e6W7d8kQ7kNvwEFTHeV&_nc_oc=AdonNtqeUeHeRRY-O_6E4PAiZHLe6p0DtqJBrq2iCF6jutAFwF8kyp3jfePUHdoXDf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r1YIWSs8XhE1K_edomtVjyZNTJDyIYPLfI3HoVZZJSg&oe=69EB5EBD"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3Ob14fvp-MQ7kNvwE0rZix&_nc_oc=Adqe-0QWIQgpzgszNdkj6lSiiMwa6WxcV725ZREgt98HkQiLeNqkhg8oAm204gnQsUQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J7Z1G0L5fk1XlBcdLyMmMY3melyXI4lQj31jKpWNzqw&oe=69EB6A64"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmHqXbzY3rYQ7kNvwF4LGax&_nc_oc=AdoHOAWf4ZXW6FfLwB0vAj9gGRhwxIWWS41fMo1EDIEWd-nvIqufJSb8B4EDLmVJ73g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ka4JMk3Y0i-RV1tRCn8brcV1dlnIaiCqjYrLnfCHtaQ&oe=69EB87FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzSPqC6-Uq8Q7kNvwGewi88&_nc_oc=AdoBxpPs44ABIJ_gmKOMC4hcE4iyGTWvLW_6ybbuzw65le7n6HDF73CZcZs-ffHZF1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CNKTZSq4Odo_UWRcsZ1idnxd99GTwVJiyQzoEFMwEFw&oe=69EB7B26"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "revi
729730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3Ob14fvp-MQ7kNvwE0rZix&_nc_oc=Adqe-0QWIQgpzgszNdkj6lSiiMwa6WxcV725ZREgt98HkQiLeNqkhg8oAm204gnQsUQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J7Z1G0L5fk1XlBcdLyMmMY3melyXI4lQj31jKpWNzqw&oe=69EB6A64"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmHqXbzY3rYQ7kNvwF4LGax&_nc_oc=AdoHOAWf4ZXW6FfLwB0vAj9gGRhwxIWWS41fMo1EDIEWd-nvIqufJSb8B4EDLmVJ73g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ka4JMk3Y0i-RV1tRCn8brcV1dlnIaiCqjYrLnfCHtaQ&oe=69EB87FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (2).png", "id": "1780335179226531", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820652_1780335182559864_9187892686426436111_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKIUPKXA3Y0Q7kNvwFQggTw&_nc_oc=Adq4vNErs8Xv7oAo_dOUTGPG-zqoFgx0ZViJMx7d-MaCQBiHStfoDPm_2gLr4-dYi2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TBvXNgxd2_p8Bv6u3h04hfmaWscMX8A_FBmM7MuDPFw&oe=69EB7CB2"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9883308741761766"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2472716113114599"}]}, "baseline_offer": {"id": "2472716113114599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749735600, "status": "PUBLISHED", "id": "2472716113114599"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9883837585042215", "version": "0.
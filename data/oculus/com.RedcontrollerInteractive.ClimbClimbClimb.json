20f&oh=00_AQRCOLAFVRlLfYY87UT1C53KOvQ2CfSfvD858_HLWUC6Gg&oe=6AF74324"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_bmI3hvF94Q7kNvwF0RlOv&_nc_oc=AdofqR60bga26-41exPHUVXNJ1I9BI0xL-HBhZm9iy4hqhu4EtoNL1JGF0HaqWZsDEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDKUDzEI7zik8DA_qfqqKE3A7dg_wbF1-ZiTYWykafKg&oe=6AF7287D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9ZTMojdykEQ7kNvwFeqT1M&_nc_oc=AdrV_wmqrPx9R-X-iul6QvT-yLe5Juv5vFGYPnqjv2vFa_a1Q-fI4UcEVmEVUj_OcvY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUWqDIL9Hnc5PEuytOarc7caKAhmClJc8j2Y6JClSCFw&oe=6AF71BA6"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-ba
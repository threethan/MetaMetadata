8U&_nc_oc=Adq8n-TGh3F7qMKB7HHZHob2d1OODQhwueJelJ72YE25gHkBERun6smKPonZcNlAkco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qUPXfEa8_nDc_pWk7t2efya6j8SDv_S8TzQoH4SagOA&oe=6A2024D5"}, {"file_name": "ss (7).png", "id": "549528158241865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823434_549528161575198_2407590036536240669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZQIibxemrIQ7kNvwEOuUey&_nc_oc=AdrbbGj7iQvk3zUfyLFVM11kyo5rNCy6xY37HMAnBUGuPt95GR1gz4j2dEAsCdx_jhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5krClU_Y_eBLtyteEHNv7q8f3pRVXcYrOLTpM65C6LIA&oe=6A201ABD"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYnIziOhgj0Q7kNvwFCoN5h&_nc_oc=AdoguPSbOth_dMsx4kv2qjXXGfc6nY16cmOVlUijpzzgb47_qkLcvLJWWPX7bM7A2PE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kWJ7z82o5Zi_i7M6LZsTM7iKPle83YdBApz1Z8gmBoQ&oe=6A202664"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZdQ72fKP9kQ7kNvwHEfpFD&_nc_oc=AdqjZ5VxmeKYAh4GJltYbLk2u-1Mcc0DeN5VTV9VBOwZy5PY5l7hFp4tGSlfOMUr9Xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E9jMOlqJ3wxp0jBKK2YumZKqsIYJGuggx2nhNTcQcxQ&oe=6A2043FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Pn6aNlIjP8Q7kNvwG6XL3E&_nc_oc=Adp6rTQTxwdRK3ncwD1Z2eKwnPzVXiseO7Zo0ObzknKDQ788jVFZlDyEk4e8FxZvGyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72o1--J0WtKRF7TI6cEdIgASRHUXnbkxUOXuDFHJSjeQ&oe=6A203726"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
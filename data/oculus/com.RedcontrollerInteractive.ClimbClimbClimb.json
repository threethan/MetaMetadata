865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823434_549528161575198_2407590036536240669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o34GEwWBx2AQ7kNvwGwMxIA&_nc_oc=AdoXvCnDKuYPO8EcOfuF8OAq92aV3YKWA5qMzaRoK-Jdzjo7wpIKY1XEVOlBgDF4yYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aCgSIRSIti5xJWwe5nPKk8X4S474Kq21tE5sjE_EsrQ&oe=6A046B3D"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r1x1s0fdtcQ7kNvwFh2zxn&_nc_oc=AdpzJU5qFzqVluogMOxv0ObkJszv7ega6Qz5J8TfWFcPHocAm1S-GIv6F6cXZgXt4n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ehmdnW6qLY8OIOo0O7xZCnaEjzslrcLaJ6Yji2teWJg&oe=6A0476E4"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5TkXkXcybcQ7kNvwH4mORj&_nc_oc=AdrhHrqLBVI2JGXPzDZNLTaq8NRmxwPIF955RxPDdLyFQA1tkyZ_-VVzLyfY9sWhdoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Cwk8BwL7ZSv2kVyOjAhJPSq6nk3gaSXqLhp9cYPcVQw&oe=6A04947D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-EAiKqkqygQ7kNvwGVAPHW&_nc_oc=Adq2NfrtrhEn80dToCRa8MK2tfj4FLvuElI3x4kvA3maQxSahxu2lVCdWVTqXTX7b5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T-42j2kEUvRi-hnxympPEA-F9T7TjwyASU0IqH9K1tA&oe=6A0487A6"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "revi
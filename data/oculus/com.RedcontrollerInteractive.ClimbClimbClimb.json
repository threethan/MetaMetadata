dXJglAm_CpoUwRsbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsrpmyIpWO3mvRM1PqHysC3AMRYalq00oFKQfbDV1xNmg&oe=699EE7BD"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfMlmpLivmAQ7kNvwEwO1qK&_nc_oc=AdmlORdeI2G5ulnofuHr_Aw1k7dGTQcMikE-3hYjNn-Wu2adRy0kPO63Fy8Y3CYSOlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftvuRlpdEDrwqhmhW3inaikF-C3-dpCixJA70JW478OYA&oe=699EF364"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A56hWFAFbsIQ7kNvwGfjW26&_nc_oc=AdmR2SLpI1mBqNz_TmwIZZMlT71BD7V_bw-I0UwlxJUIFAWnfS_qPb2LFykw45y5rno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvbKl8WX8D3sqxTZj8hCKkDp7Y1u4cWHSr8cfpavXro8w&oe=699ED8BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwHQjPBkYeMQ7kNvwH-HnUM&_nc_oc=AdlhfwLxpHs4N-DjEZcUmcGAvAA89IEO-kaT-7WlhTxujfvkT71-EKm-K2JR6Sf7f5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft8if3OgDsp8naz_rsxzh2d2eS3ywN7VCrXvpaa12dYLw&oe=699F0426"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_9887136028051453_4307738622475053645_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g2fDTUMRaUQ7kNvwEWgCAt&_nc_oc=AdlyNHsTQLICrl05yWnXdM9u14wpMy_rr6AuiCUBSE
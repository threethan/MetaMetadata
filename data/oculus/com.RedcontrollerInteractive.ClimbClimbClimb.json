hc=MXikSmkcPCUQ7kNvwEQQ5jI&_nc_oc=AdlcXT6mYaxKIqo5l2wNCeGXIgtdBqE1Q_jjTqGPohhgHqbyDNBCFaaYSwsBBpzo4IM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afwb84cBZ-LAAo_ImAjzIfFrLPtFqafug4-WY1DjFHUZdg&oe=69AAC53D"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2CXTHCAi-wQ7kNvwGdWQye&_nc_oc=Adm-yYmp-bQo7ahwYH1MpuwTWzqnP-3RknhJOn8XHb-dQVdkpNS3YksYAlsrNGcWlW4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4ycVfhWLBk8HW4ZYZHrnitAjR2m0OZQKONisvZKH42w&oe=69AAD0E4"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLQr-f6oLQQQ7kNvwEb2wvg&_nc_oc=AdkZgm94HVQHjcrZIMJGnToGxtKXji1c5HZCVtsjD_JhAas8ol_UmsoGVE9aYs-fa5I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz1sErnAtLI67IotKGCrfBIoxt7J2roKH2pPUoKMXRow&oe=69AAB63D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPfqKijbJu4Q7kNvwHkgcgB&_nc_oc=AdkEfWaBlPYd2LwjHQio6-iu_P8oTv18nyDQWESBI26daLjl2ga8E0tFB6GwxU4vDzg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_b9dSmoXqRVzXaq4uOyw5L-3NhJ8T_22P7ErkuhVJJQ&oe=69AAE1A6"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618512_9887136028051453_4307738622475053645_n.png?stp=dst-png_s3
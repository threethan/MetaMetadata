BD"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMP1JOlnsmYQ7kNvwFN6WZK&_nc_oc=AdkG6CJPDXd4p23ActMKSHCgTaBaPI8WSWjpmweUseiEvnCiHl-TohYjOrjbXz-WDc4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftgWkQT0yH0ZIT5VR_z1NJ8ky0jHgBXfgOsF91XcOE5sg&oe=699C5064"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykUcyrXvz98Q7kNvwGe-EeH&_nc_oc=Adnigq0a2N0RiPDwEiVlC8LDtkYdx1tcQGcBZ0nOUXOihA4Tp3RyYmCf-5uEa_xOXQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfseYjTJ3BktJd2GboRbcGmA2y9mAi_mG9UYMx271D_tNQ&oe=699C35BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwHQjPBkYeMQ7kNvwFC5aru&_nc_oc=AdkzIeUVXtlxRvBRnBKY1ib58unwyB5PEEc1b0QhOHGbNanDMuTjw2rqjKM-oh1xo_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBQ4VTLTSN6KlTpxkPieZAzvuxlAxZ0pOnYOJj4dKiUQ&oe=699C6126"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618512_9887136028051453_4307738622475053645_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g2fDTUMRaUQ7kNvwFkdsZj&_nc_oc=Adl7c7JsqCgJOnTDQepFPlQF_IYx7QDxrLe3WTPOY5K9Bc07MzgIQzaZL6UpMD4uvBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuC9EjwOUymRcafAP2lyUR0KrCe_m88b4SswNngoaglgw&o
865", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823434_549528161575198_2407590036536240669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qfcLoCKQl8Q7kNvwHGdFaK&_nc_oc=AdqpHYhQEW0hY-A-m-M6JwqmKjWobU0y6NFqiYXOnaaRK6VKuT-KscnyJW2XQEdkgS0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4MW_i1vA2nnGC8UxxhxhHUsHg9FSZxNBt8ZrmAd4FbA&oe=69C5233D"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01TFkmC7vxEQ7kNvwFTj2KV&_nc_oc=Adp5EtWy7JUj3iynAi3Sh0TyqXkbzqH25suBCbXjZ1ik-ZCr5rSu_jeeq60oHEYYN2o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDWYDXVaYkW6Vn42IHX_JXiw__VIZE-OzJERh92eenBg&oe=69C52EE4"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mV9RqjtkvcQ7kNvwFn-54j&_nc_oc=Adq4r91CLlZWJr7SMUJ5mbh_SLt0D7czwrui8TwGDLJPsqnsJRSoNl65VdJBAnxDDQE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmCKEjuUzwo3Iav5LMRfJH3KqnevZhq7e6wA51X5kAQQ&oe=69C5143D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO8HvaYEiKgQ7kNvwH4E--9&_nc_oc=AdqgwiyHSALJ-gcZFBYR80zYyK1gk_PwGRQyZLoykhicbGJnWi3nhRuduy21l238fQo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo4T2OWBufEOVGoB182YDZlxrEW301ar0Uk95aPU9upA&oe=69C53FA6"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "revi
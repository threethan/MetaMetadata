865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823434_549528161575198_2407590036536240669_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnAjrxtXh2oQ7kNvwGeKsy8&_nc_oc=AdqOFnMwWW_WwEcnlQxgtHaouk2mivI9aX9whaDNPs0x2utwO4OjIAXrHHZ-rcsV-ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qoS-TvQFQkj6lG0u_jecbkwho5PJM_L8bepGauQsFiw&oe=69FF253D"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgHitLLWWvsQ7kNvwHWxNE3&_nc_oc=Adpw4LgNKKhh-NqAoOisR93OMC8jSdFHxh0y7Qx7fX0kom8QDejglw7AffXNYc3s2sY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dRuJAeGiW2ig1PZ-IrbSWdW8PiV-XU5JkncmHVDBuzA&oe=69FF30E4"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC2UlpAKJCQQ7kNvwHrK0oK&_nc_oc=Adq8BgwXxlK9Zd_p6QHYMgsXlNBuyi_UpLxKPouqMFx9a9v8_NqQ0iWbe8BEd1az3DI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KpACPEMV-9ixSZxVuu9ApnxfiCJSTEnjsLlykGvW6uA&oe=69FF4E7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghauNl6u1dkQ7kNvwGve5Rm&_nc_oc=AdqiB3i8VEymXOr2kjkkhQQ5_OGBDVlGQuzWZ5MvmVBUPfag-c-IT8cvycGHWw6DZs4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zR95iNSzGauXteje7Zez67MNR8kZU-NppngC3pqch4w&oe=69FF41A6"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "revi
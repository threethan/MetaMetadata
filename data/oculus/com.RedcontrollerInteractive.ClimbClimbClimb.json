cvwjENrQ-0ZgVFbNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMQqSepGKSxbOcHBxSD4hhisB5h3af849V5D0SKR-8xA&oe=69A6D0BD"}, {"file_name": "ss (6).png", "id": "544389948729730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824210_544389952063063_2400247090057483300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWw82F401l8Q7kNvwEDnhkd&_nc_oc=AdkcqvPclYdq7f011F-ailYuzyGevlaptjj9ceM2_Y5yXQZ2IJ8YeWP7wyY4DelkvjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEuuHAJWuE3ORfShA7-pAQKCk-7armp8UKmoPP4_GgTw&oe=69A6DC64"}, {"file_name": "ss (5).png", "id": "1803491600514560", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_1803491603847893_436587189985593674_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQSSmPR0KAUQ7kNvwFAMGoR&_nc_oc=AdlcD9max05VP6MVtzSKv4tFBLQPwyXX16THY_Wc08iMboTPWKevRwX9QULE62dc9c4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYh4D_8u_lVd8yoOUH4Z5KLXg55KOAEylbp6fDpgA9Tg&oe=69A6C1BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ccc (4).png", "id": "750620057526410", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618095_750620060859743_3844683554795365071_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYHVArEKm3kQ7kNvwH2pfiS&_nc_oc=AdlyZPJ6fAzmVfPz72VwbzbZ09VoNHuCwmaOnRL-MtxNJvoU2iWrgC4iLAmR1_wOiIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afto5PIHvDOP-h6JvxX4em_R5xg8DO4rOlTm7V6LOVSRdA&oe=69A6ED26"}, "display_name": "Climb Climb Climb", "keywords": ["climb", "parkour", "climbup", "climbing", "vrclimber"], "long_description": "Climb Climb Climb: Insane Parkour is a hardcore, physics-based climbing and parkour game that puts your reflexes, precision, and patience to the ultimate test. Navigate intense vertical levels using nothing but your skill and momentum. Every jump, grab, and swing is driven by realistic physics \u2014 no scripts, no shortcuts, just raw climbing chaos.\n\nFace a variety of brutal and unpredictable environments packed with obstacles, traps, and dynamic challenges. Whether you're scaling crumbling ruins, hanging off skyscrapers, or launching from ledge to ledge, one wrong move can send you all the way back. But every fall teaches you something \u2014 and every climb feels earned.\n\nWith no easy paths and no hand-holding, Climb Climb Climb rewards mastery and persistence. Can you conquer the climb?", "short_description": "Climb Climb Climb: Insane Parkour is a physics-based climbing and parkour game where every move counts. Scale extreme environments, master realistic physics-driven controls, and conquer challenging vertical world. No hand-holding \u2014 just pure skill, chaos, and insane climbs!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4537477e-fe4c-450f-a254-3d67369c9340", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9899325603493413"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_9887136028051453_4307738622475053645_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IKo0LTSzc8Q7kNvwHvexLH&_nc_oc=Adl8HSj1ITjLv3B7H4JRKbaAttyA0nvj7-AKqVantz
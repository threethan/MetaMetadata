agevr/SoundStagePrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "James Surine", "support_website_url": null, "website_url": "https://github.com/plaidpants/soundstagevr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "29628184733474442"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1309398967998712"}]}, "baseline_offer": {"id": "1309398967998712"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795799700, "status": "PUBLISHED", "id": "1309398967998712"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29639642038995378", "version": "0.1.8"}, "id": "462432738601842", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4976289672423957", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29639642038995378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "462432738601842"}]}, "change_log": "Private internet rooms: enter a 6-character code to play with friends anywhere; anyone on the same version with that code joins your session\nMultiplayer sessions hold up to 4 players; a 5th sees SESSION FULL and joins automatically when a seat opens\nA chime plays when a player joins or leaves (turn it off with UI SOUNDS in settings)\nSmoother multiplayer: notes, tapes, sequencer timing, sampler playback and most controls now sync live without reloading the whole patch, and stay in time over long sessions\nNew Scope device\nTimeline notes now stop at the end of their box, with an ADSR panel to shape them\nHelp on your wrist: turn the back of your left hand toward you and touch the ? to see the hand gestures\nTapes go into the deck you're aiming for and no longer get lost or stuck\nBuilt-in samples now play at the right pitch and speed on Quest (they were slightly fast and sharp)\nFilter sound matches the band you draw, larger grab areas on the reverb and mixer faders, and many other fixes", "created_date": 1795642403, "id": "29639642038995378", "version": "0.1.8", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4976289672423957", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29639642038995378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "462432738601842"}]}, "change_log": "Initial upload", "created_date": 1795050754, "id": "29554596797499903", "version": "0.1.7", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
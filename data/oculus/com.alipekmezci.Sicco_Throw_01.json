6800745971_8605670816543595066_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOfYtFCTskIQ7kNvwEbbEaI&_nc_oc=AdqP5hDohia9l9Dte8-I2-7FrdWyD-beFceq9JG53klfWeBm8pGB-LuFaYM1jVyeeME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL7uVHyBiTfhJ4-jWm6lP9vNYFizjMswuMpjaAi8EcQg&oe=6AFF27DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SiccoThumbnail1.png", "id": "705237648101820", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75485579_705237651435153_4449502046672937248_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jdpEpWayM4Q7kNvwHcZYsW&_nc_oc=Adq4SuosXJqUHhkkuGRo7yO20Aoig9SOk-apnQ2zfDC4lacwuCFwBY-NmeKB_qmM1Rc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWKot4FvZ6JpV-SAfF8JG9h-MwDBTfnNWUzJ2Fb16V5Q&oe=6AFF1B5B"}, "display_name": "Sicco Throw", "keywords": [], "long_description": "Sicco Throw\nFun little ball throwing game.\nAll you have to do is to throw the ball into the hoop.\nBeware, It's harder than it looks.\nAlso, make sure to hit the blokcs to get extra points.\n\nE. Ali Pekmezci", "short_description": "Fun little ball throwing game.\nGrab the ball and score some points.\nMake sure to hit blocks to get extra."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alipekmezci.com/VRSiccoThrow.html#PP", "developer_terms_of_service_url": null, "publisher_name": "Ali Pekmezci", "support_website_url": null, "website_url": "https://alipekmezci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
{"id": "665216459062614"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701726737, "status": "PUBLISHED", "id": "665216459062614"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6830197253686043", "version": "1.1"}, "id": "822701519378546", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6679998345372602", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6830197253686043"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "822701519378546"}]}, "change_log": "An update has arrived!\n\nIn this update, I have added a new gun!\nWith this gun, you can throw balls more accurately.\nIt will be next to ball spawner, available in every game mode.\n\nI have also added block remover to the block shelf. With this, in mind you can remove unwanted blocks.\nIt is marked by recycle icon on the block shelf stand.\n\nSome Quality of Life changes:\n- Scoring sound is now scaling with the points you make.\n- When scoring without hitting all of the red blocks, an error sound and message is displayed.\n- Adjusted Levels of detail, so objects in world should look better.\n- Adjusted UI textures, UI should look clean.\n- Made general minor optimizations.", "created_date": 1694782788, "id": "6830197253686043", "version": "1.1", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6679998345372602", "is_concept": false, "latest_releas
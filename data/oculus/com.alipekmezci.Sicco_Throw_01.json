485579_705237651435153_4449502046672937248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N2pFTS-wAoQ7kNvwFLUoWd&_nc_oc=Adl1D4lO84jpCrjVPTNJaYOT8AvX1rAAZ5yWFxC9gbzBrNETAkmj2chy_OEVj6tYSEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftB3aIR5UTOb9J61UicCic1ncfuaU2TMjbnvF4JTERiJQ&oe=69984B1B"}, "display_name": "Sicco Throw", "keywords": [], "long_description": "Sicco Throw\nFun little ball throwing game.\nAll you have to do is to throw the ball into the hoop.\nBeware, It's harder than it looks.\nAlso, make sure to hit the blokcs to get extra points.\n\nE. Ali Pekmezci", "short_description": "Fun little ball throwing game.\nGrab the ball and score some points.\nMake sure to hit blocks to get extra."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alipekmezci.com/VRSiccoThrow.html#PP", "developer_terms_of_service_url": null, "publisher_name": "Ali Pekmezci", "support_website_url": null, "website_url": "https://alipekmezci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "770328721556912"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "665216459062614"}, {"status": "PUBLISHED", "id": "267032952757248"}]}, "baseline_offer": {"id": "665216459062614"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701726737, "status": "PUBLISHED", "id": "665216459062614"}]}, "liveChannel": {"nodes": [{"latest_suppor
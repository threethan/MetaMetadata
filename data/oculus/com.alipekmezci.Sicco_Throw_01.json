6800745971_8605670816543595066_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFlAMBHO1t8Q7kNvwH2-N9X&_nc_oc=AdoUXowbBqAfiIIqnyYxcj1r0qYqpi9S-L68tRQIby1YLIJznckwPfjZ-oSgCzm4V-k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhH3qr8aY05JC379zJCcgSJ6o-mdWcaZLZF8036ZPKJw&oe=6B0B3D9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SiccoThumbnail1.png", "id": "705237648101820", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75485579_705237651435153_4449502046672937248_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so_EhkwOOpkQ7kNvwFUk5it&_nc_oc=Ado3PlVsypVhga4blGWjFs9JvUsNU-NG6EXxWqUyRquTABJ39rlslwnemkMLgHsgoZE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcjrVPjY-LItcu1qfAORrp7cGXW8cLRUK-lFtk2MwUEQ&oe=6B0B311B"}, "display_name": "Sicco Throw", "keywords": [], "long_description": "Sicco Throw\nFun little ball throwing game.\nAll you have to do is to throw the ball into the hoop.\nBeware, It's harder than it looks.\nAlso, make sure to hit the blokcs to get extra points.\n\nE. Ali Pekmezci", "short_description": "Fun little ball throwing game.\nGrab the ball and score some points.\nMake sure to hit blocks to get extra."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alipekmezci.com/VRSiccoThrow.html#PP", "developer_terms_of_service_url": null, "publisher_name": "Ali Pekmezci", "support_website_url": null, "website_url": "https://alipekmezci.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "770328721556912"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "665216459062614"}, {"status": "PUBLISHED", "id": "267032952757248"}]}, "baseline_offer": {"id": "665216459062614"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701726737, "status": "PUBLISHED", "id": "665216459062614"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6830197253686043", "version": "1.1"}, "id": "822701519378546", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6679998345372602", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6830197253686043"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "822701519378546"}]}, "change_log": "An update has arrived!\n\nIn this update, I have added a new gun!\nWith this gun, you can throw balls more accurately.\nIt will be next to ball spawner, available in every game mode.\n\nI have also added block remover to the block shelf. With this, in mind you can remove unwanted blocks.\nIt is marked by recycle icon on the block shelf stand.\n\nSome Quality of Life changes:\n- Scoring sound is now scaling with the points you make.\n- When scoring without hitting all of the red blocks, an error sound and message is displayed.\n- Adjusted Levels of detail, so objects in world should look better.\n- Adjusted UI textures, UI should look clean.\n- Made general minor optimizations.", "created_date": 1694782788, "id": "6830197253686043", "version": "1.1", "version_code": 4, "release_status": "RELEASED", "status": "AP
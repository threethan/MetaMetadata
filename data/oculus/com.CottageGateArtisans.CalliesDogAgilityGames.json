nc_ohc=XNbsCztg298Q7kNvwHe3yMz&_nc_oc=AdoivNG0Gg0FEb1eyVCVM4AzOKJnA4yhmznvHeuboR1yJQItnq-1_lQE2saQeYSGcE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXRbV8UDlhGShpe33-4Bv1yEaGo5GTNfoBz2ffI57Z6Q&oe=6A71CF1C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXldzPmmnkUQ7kNvwFlJYC1&_nc_oc=AdqRnXDsTCqm-2eB5kuDHGIt2PopDz2DqArxfSaAMioPzkRKS71ahjoHF_6zUlpbbcU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY6WWH1tN5Gm9SmgTPCQQHLf7GhPpe9ZJB5Lc8-yJzQg&oe=6A71D600"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FyuCTvvMW0Q7kNvwGChMd1&_nc_oc=AdqLLYX-YBbyySSW8DUFwWVm2XaU859YwbQGcxMFwOSFj8gTn-8-WveZutOOr7y3oQc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-nULYONpuyyoX8taNGAv4_YFVqjGwHLQCVvP6v0hWsw&oe=6A71FFD1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-DV3Zlq2lkQ7kNvwEEH1QO&_nc_oc=Adr_WsQWRL251AOH4WnPQ6ytrTAVkhl0kfa2cVwdlXvoUENDHKJG43SMKSupE94OQoE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5KGW4YoatOGVUshlLT3IDm5QdPcMJxlGqadKOzsJdMw&oe=6A71D131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvVkWEUzdIwQ7kNvwEsivAB&_nc_oc=Ado2HzZx-RkAo3BTBb0wxJE0fugEZUauZ1SsK_HzM7A6IdIZPKNCtA8aLfq6U4oaXJA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETVp9K36l625WhGzp6Y-H_iPoa5kR1qYpbaeVCwRogsA&oe=6A71FE17"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
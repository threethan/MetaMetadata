nc_ohc=QRtPIOYgkWIQ7kNvwEUkTK4&_nc_oc=AdpYy7S6TeLSy3nZuY6atvqb0Y6Ynn8zCsVg58p-7wL4c_l45jwKVeFUgIj7ZWHwFNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRUt0kJKpsARjRdtkvT526Iat0jp32UvyV7XlSZ0GnnA&oe=6AEB515C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiNgaz6SI8sQ7kNvwEnBOFV&_nc_oc=Adqrgwf5EZd5dOE3sHYOEC0YR9Mb2clsfGGLHqK_HEbH09khejrXHusqwXWVgkUdTdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4qwBPK13-hvo6QtW-eDE_Xs7ZDAB0akTyRfc3XirlKg&oe=6AEB5840"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyarX5xVqf8Q7kNvwEQMluR&_nc_oc=AdocL-9msDw_nvFEEuLPpY3-Cp7GGOpT1YtqlHAAwuRm362XXEKsQbJJ5PrBb4kcMCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJhlQGfTW1vuvQS-3lmYH0bqImPGrzcRC9umWbLrRuLw&oe=6AEB49D1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DaHEp83sI0Q7kNvwFJOQYp&_nc_oc=AdoiZfg-mDynQzc-u_9BM6ZBTj8xf2Qa7p2E4BwhlumG4xGUR116bX39q2gPmsp955M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo2JU1E882CYworQTkE1haSjaKR0PviAAymgadWa5Ylw&oe=6AEB5371"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziuRBwqaIEsQ7kNvwHbQLTp&_nc_oc=AdpPmUaRW8sjtndwcLK3M31_rpXEorTfGQ3zPy2TVmwjG9bq2YXcMbzrnB7nnZNRg5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwhhn7ll02KDyBBK1oSKCj1FbLwmEZ_oVBhZ5-atHkFA&oe=6AEB4817"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
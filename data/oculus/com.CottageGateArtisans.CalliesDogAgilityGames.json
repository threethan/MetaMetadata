nc_ohc=o-3ux0w09XAQ7kNvwFmCoUY&_nc_oc=AdrTGsBXckqknT_LwdOTrC5RNQv9HYgHkdd_K-4w44_iTnQYJuKv4CAA6879_xHgIbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVBZZHhbzqeW877dazpuyqWPcWBLD-eN3PSbUw_UatWQ&oe=6AE4B9DC"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHkwRfnYfNQQ7kNvwE8zGIA&_nc_oc=AdrpcttpiA0P8l-8EsfL4pmraTNUgqAMXFiTBv0-Kd2r6BgrcKFuOxyVde8VaAUjljo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXZp_rN6VZOYr2uduWFstXKFOaGa9mPuAgGKn491yD1g&oe=6AE4C0C0"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM-u9-KqvdQQ7kNvwHpM7yL&_nc_oc=AdpZO3KSxEhcZ0G8Ihr1SGhDqYMdOFYVLMt8TeKhsB9meDzDSbUtkKP04_cIsKq9IGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-szeSfyHDz5R1qY7LlGvUOpWVuZyebb6Ax10-Yc-D8Q&oe=6AE4B251"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vZ4UP6rgvsQ7kNvwFhBWAz&_nc_oc=AdpC1BXvBQvm6oMfrlNaBJsgnij9Qqc1s_4KF_lUGoIjG8wBwW57VZYHokY2HB5ZLhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmC9orxpHhqA2cjSIhs3VDTvYVnD1CKQThBE9s_JTOFw&oe=6AE4BBF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvZW-6ePrrAQ7kNvwGuJYpx&_nc_oc=AdozFWq3hc8pvwpxsZ3fb7UYqwRNzOTF8dyLgNx7vFAb10UlZGETVPJJDz1TRhKdpEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbY70eDcCRRXBhXGTVHjuLbMsR5dxzWu0nNZpJ1zi8mg&oe=6AE4B097"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
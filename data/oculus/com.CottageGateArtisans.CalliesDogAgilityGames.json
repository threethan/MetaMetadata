nc_ohc=RoJ9NBo00UEQ7kNvwE70ZX7&_nc_oc=AdoBQZiPu2xRFgp75-B88aTWCWaUA1dVZt8bhjnG4vYIBVwCjl1EJ80rXvMeRNNyLSg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH1wVd4pYDTXRKyBvlAgJiHc6UEPy_BuG6HMHvsVw4Tw&oe=69C3C91C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8EWLLliAZ0Q7kNvwELoBVt&_nc_oc=AdouP42Fx0Uan306s75NNJl91u8-qL36Rh3l1c9LYbIC8tYozcO044elvBcIsvOjs-I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwvtcFHP2PA4Hra8Jv9OG0gtO_GWvO9oGWe0A1QE4w1w&oe=69C3D000"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3eQrmks0WwQ7kNvwHnQOtl&_nc_oc=AdoyvKZMWoajILj0gUZLFaPtnhlwpVJ535RCKtzKyHbpd5IkcHJfjtNH-4RZZAFO4Ug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5Q-0wMZz2yUezWMS1h2zhRvyNOOhbK-BZHZbzsMqaUQ&oe=69C3C191"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ-D8oFbIjIQ7kNvwG5RvBq&_nc_oc=AdofdRGhcilEuCzowbw9JatXQvJc1yh3WDJDLyab9lh74XddM9h1rgt1oRxFLs4Sa4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwyg0LRw3d7CWyCtAHCGwuy2BlPs-8c49PUBrQHEfc6Ng&oe=69C3CB31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esXHt1_HyFEQ7kNvwGu9fNq&_nc_oc=AdpOLQCuOZre39HHobaAj3gsfNKWyfLLTSrLSwAwGZJxOaLNbWQB-Pz_LZUMUS5syaY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1GVqRRgeXlM6T6HUp21xi3uPQutlkTP49VVxNHMS8Xg&oe=69C3BFD7"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
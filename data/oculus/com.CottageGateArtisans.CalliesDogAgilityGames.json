nc_ohc=t6N23HTH6DsQ7kNvwEfJJUg&_nc_oc=Adr6EMJgQQA-k8yhu7Nb-az7vMReL_u4GdORJRyK7mLtN-mJ5y0I5GHhqAIfaLQJqSE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f5e4PuwyaJC_llHlovFmHyJFAKhropysoUZfhS_jX0w&oe=6A0C83DC"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlcpetCvVkcQ7kNvwGtBU8k&_nc_oc=AdrsnBZ-_BV76wM18kLp72CCVZZ67nkXOktC9mVW4Gsy5CLCIL28gDVpTfc7BiFlClU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5402mKBnVrPmcS0hKaaVzOqd8SVveogdYRgbQpmD81iQ&oe=6A0C8AC0"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru7_lp_Rr04Q7kNvwENEQCI&_nc_oc=AdqZl9DBwS8O31pknEM8TQ3Ly7dVkPrBmb134DmGUUCq40j3D3D1JdrPqw8htFo-hvM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e5mNr0CY6tA46D7FRKyOM01ZSEdEkcEJTIG77xNIL4Q&oe=6A0C7C51"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzatO3WrLwoQ7kNvwFJphRD&_nc_oc=AdocOv-W4HrUU1xRvP23zakekyxTr8kIvW2plBo00P3-1Y5bhvwXCvjYClBAMqkJc6s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o_6ACjTGCKJ3h6_0HR-WoW_pvA3I3ZMU-Yl0WPsfTfg&oe=6A0C85F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7BcOFpBvkUQ7kNvwHw6T_W&_nc_oc=AdpSxwVSb9tO5sQ63E-DzPS3JND8p-F0eYbTA4fgnKA8bblZgch_dlGoGJlQLvhei2o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_bRCUDvmuWnB6I5mlOkjYYXlhQ-U84ZvJ1Zsy1CdVZQ&oe=6A0C7A97"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
nc_ohc=qovleVweZTAQ7kNvwF-E6BX&_nc_oc=Adr0tOH0yL34Ueb5FABSBMMWiidPOzDoUpmMb1A6QzMsteFNqZZOXmRlle2acdCAol8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlhtBcoE1-pqULPmFQbXyHW3eeKYllWCrXxBKtWJXiYg&oe=6A6DDA9C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBNhPNlF-Q4Q7kNvwGPeiOa&_nc_oc=AdomxUO0vb3EqiNgP-RktS0PiO64WgMSf2QUboCum64cYzxhhqorNGJPq83u2w_1dr0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdrIUaTauesS1ZbnJnp1XE7YQhDqFIkQInNIvwkzr0zw&oe=6A6DE180"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hy9Y6DVbBgQ7kNvwHS2h9G&_nc_oc=AdoKIPXqW8spPyDQfoNFgNSnh5E8V9xdS8pY_JnWNV46U77Y0bzV_qpuMB9Q_a_hYGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVcuHVex1uiEu11f5FjKrDeEBMlQeZx2hUXFc4HlXpLg&oe=6A6DD311"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zFvRbcMSGwQ7kNvwEgvOs-&_nc_oc=AdqQziCGTK7L_iPiouaWIfIYbz-HRw2bJKKZGB4aN-MG160-Sri2SI2RBD30P_Wck5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbslPxLDYIxJ0b-EyX3OFgyyuOehdaZES6zcEk2RmWxw&oe=6A6DDCB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN9AxkCUsCAQ7kNvwFuKc8b&_nc_oc=AdpCruhA7VgcldeIw7xrtnyZNudECM3JZSS9ukdTJX2elEh2KfZWORkTaCsT9LCaUrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxFLKevpMiu42cAhMuw2VYyfmiR4t2DfEOFhZNKYuQ-Q&oe=6A6DD157"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
nc_ohc=QJ3u2JWLyRQQ7kNvwGu2ctr&_nc_oc=Adr6-hgumUuOI_9vvsIWn767A70eg8oPEvcsbIxE9LqzAKoIkeBUy1bll0KI_5B1zb0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOAlcpbKuSlbdjHBG1ygDU5DeE3q3X3NIB1NxVmTWKvQ&oe=6A91731C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emLAy0lD6qoQ7kNvwHNMvKv&_nc_oc=AdolyaZu_LkVOw0lum6mG60MgqAZ1w_7zyOj4dp7U7dLqNaRUDgfsB0-nr-ctwXFZ5U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF04CRSIDYHdFERyDvneRn9vITPtZtpbKUXLeth_hUbdA&oe=6A917A00"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGpyfhKOG6UQ7kNvwEAAFpU&_nc_oc=AdqdfVN43Xf4vOVzY0yiwD--eEwL6nvfDU6dsgW8kgVOs6XIDf3o8BLGbggQjrYRWn8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOxUzpyLPohAdNUlZqeJRPzcETW77COa-rsIQQ3b2nyg&oe=6A916B91"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKbFy8XqzmEQ7kNvwFUX3t1&_nc_oc=AdqEGRl1T3WgQ7o43uddRsh6Rp5lBisnNVR3F1DabxOEIsY1x5PkWQzWJJdla_xPMVs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8inRcGruMBHRO_RtWO7HTZXZmq24kk0aCfmWJgEg92Q&oe=6A917531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bymUoUn2a_EQ7kNvwGC8RJU&_nc_oc=AdqYHBMhu5MYibcYQObp5e_PkXr2mi9MTc4tbEm9YxLF4tNVr0lsTVfHxSR-baO0n5c&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg45iEkh8qD-xTngpOhtYSUOzBi-2hhMdH9VWUy_Pixg&oe=6A9169D7"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
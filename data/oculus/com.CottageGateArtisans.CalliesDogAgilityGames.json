nc_ohc=HlChaqrFHSkQ7kNvwEKguYn&_nc_oc=AdoWdVMc3E2f7olG4GDlOVyZEe9kgBNDJfDtSeuvisJQO18o_mLhumEc1fzgyEpH-hk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xq4zZS957EBl1iFcC61mAK-2bDCk2G__RAY7HBnm-mw&oe=6A26E1DC"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2ReKfJNgPQQ7kNvwFkJinZ&_nc_oc=AdqqC0FfXfnR_TTwj0_sl4Jy85q967F6KM_HUglFalRKtfKuenCAjE--8xUnIRqRG2Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JHxSpEPpJvARULXK9OfoSnC0jc9J6TgRn26xOUjJXvQ&oe=6A26E8C0"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0fgUiNFLtcQ7kNvwGzpDRv&_nc_oc=AdpD4Y5SqmM5actnOCAfi4cBQdPgC1Zd3l_jqcMTu_A9-e7LpTFsRHad5jaq81YNYnY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PNc7MCvYsdzyumi2y36FZ7RJVekDWPdYkMy8QagfZuQ&oe=6A26DA51"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvWsSNJDhYQQ7kNvwEKOiys&_nc_oc=AdrUnbhzNBYlvZIe1bvNI4Oj2832ZPJdnzmGt9TfXoIMDkuunxcq8a6cG6zXFrwzVQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Urq6R07PyJH9_-FBfDnq8nXhspG-8tyTBQ-yKB0LRMA&oe=6A26E3F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOILghpOn6kQ7kNvwENlH4X&_nc_oc=AdpTUb1iCnuWUcZVI-h1rQtO7q85bLTK1-aCpsiTuc8SZa1kyaHQ54ewWYgp0vw7QJc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p7y5f9JNAYn_Q2jBXYZRbHZ_kcB6oqFDVWzC6uCau4w&oe=6A26D897"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
a0a&_nc_ohc=wLSATCLFfGgQ7kNvwGhoX5p&_nc_oc=Adotb4DQLdi5aLqo0Mapo1ZVWkDqTSWvP9ulNtRyWcNrH8ny8uW8Q_2LVUeOpy5Pjb0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjSKGz-b9q1fcqdCG_tmz99cQq1Z2S2WjWEIlujVDCbQ&oe=6AA9665C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OY4Ont5zRQQ7kNvwGWENQx&_nc_oc=AdoVU-UBJ3hqjU6STpQSB4NNCcN31LXC3M-C2iaCAgznZGXHpO54fQf3t1cOSXGu4QY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvTq7nDAh5nfCBVkd5PREh5f9Y4G4orl6qxjLgwokW4A&oe=6AA93500"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Tos3TFl9-QQ7kNvwFg0q86&_nc_oc=Adog_Qx4X8MvzbEpSp563EobIzPm96bo2-Wwsye6TbeHK-25cywa-0d1DcrYsDT1FH0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0QcrvGcQac4qRFnaJ_RnVmuKlUvf1_C-cCuD_2weDbw&oe=6AA95ED1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aFqyujVJ6AQ7kNvwHnXQER&_nc_oc=Adqhi2JB-G7L_JUOY05lf3J4ibBA9Wr07eQIhw_OYBvglLaG7eu37WOHm1JmYDI6Slk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq1ouZbm0aMsrB6op2m6yKpuZ-DjMXyO0q8PvdMOFTeA&oe=6AA96871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5MEQsHwas8Q7kNvwE3Gebq&_nc_oc=AdqihktFt4_IvSDv2eJGGOvbh2Y-SxstQ7NG2JkOV1QU5hQqS_QGFDOQH_c_50gPhw8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRMfk7Qa-eyTjmqsFxubnD1-r2pFeVkAt7FGlCQZIUYg&oe=6AA95D17"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
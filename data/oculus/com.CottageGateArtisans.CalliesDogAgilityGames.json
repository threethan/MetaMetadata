nc_ohc=h6_yG7pE83kQ7kNvwG1TZnX&_nc_oc=AdqML5XOp1LSv-oG_Yp5-0sFT_9EUH_euL6bHufn53e-NSOKcoDroraur8LaxZsKjbU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpxXgnaxW6Mi8GoHmFHQfnFZknMt-yYRVryhHT6qpxSw&oe=6A8ADB9C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPGbluKJRc4Q7kNvwFrTUPD&_nc_oc=Adp4xU-WQb6k9m5hKfUnWOenNXhz7CIbHsJqq3AH42I2UJDUIcdndojTpwDoe9s1skY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnJW-so2DMARzmNm2c29X5NQ6Y3tvmczysJFvU_ninjg&oe=6A8AE280"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEek5FN_4HQQ7kNvwG7ByB2&_nc_oc=Adrg36F7FWrsFvP-xL5SZrBe7nw3gZTiNGEhGKb0hHl9DJdhzY9706Ou7NBjJOGwNWs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETRDIvtHZ-ZyyNbo2ltUB5xtBpVaqcITnFSc4F-a7a-w&oe=6A8AD411"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy0PTnV1VegQ7kNvwGn3orU&_nc_oc=AdpuU4B_3J4FHjEBi05I3vsq0mmuIFR4I6mKAlfVwsXa3Ay-pF2xibtQ-q6iTDAuVoM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELzDCExpbOm4gibFuBFdDVMFiUReu-j200C7J428BD3g&oe=6A8ADDB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1NoHtFAvCwQ7kNvwGGcS7X&_nc_oc=Adr5ZWjF-rgZfeppPACfg7krGK5CZytM-RZVlH5eZveG3CZ9leicNusI3ebaQt7Ft50&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhGD07ekIM8QF6WUKTV03xMWn4LMG8UDQGFCzlysuFQw&oe=6A8AD257"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
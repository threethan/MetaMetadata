nc_ohc=IgSmSS_bZvoQ7kNvwH24H98&_nc_oc=Adp7a2GXXwAPaJO2Ukc1YFjQPJmkl96GYJh3aZA9l28h012S1sjsE8RuZ6pqTsrvb8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_KXSyRab5g7YGPN9vlArmxXcb8szGwqCa9tplbJiiNQ&oe=6AB3F25C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX8IJg2v878Q7kNvwFeO-5i&_nc_oc=AdpO2FYXkRjLfk7Jx1g6ZteY_FnPdXgn_0oWwS_8qvYUsyRNFk7zTKgAX_Wd408AjkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0tzZZ7BSfYsk7tzJT2l0NH-ojXhJkKm--Ts2CzBL8Kw&oe=6AB3C100"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgiiMBXRLrIQ7kNvwHr7gz1&_nc_oc=AdqGYSeAWL_4kH0wLdXl4dnprgUsxDNXuz4KJghmXf4w3Ik9HOF-7NZHryGAHFLq0es&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICYG6sxcqG7eB8VmK_xk8xIMc-3RqlPmQNzzlL3EpwoA&oe=6AB3EAD1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g7bm9K_DtwQ7kNvwF84bbB&_nc_oc=Adq3dZvFhVbrkkMKmqm11h79_V2DXm-rayFxuYPGVcDEz1a1JtNlxMGVBPn_ykSmi9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDAga_X72GdOXptJCE3boGjR9Wjxofi9b2b6EX9Fw0YQ&oe=6AB3F471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75B90YVgB7cQ7kNvwHYu9HK&_nc_oc=AdqytxGRq0Hy0MSP_GEr3lmBI8_luceWNNI_nKwYt3a5i3lCRkzdWHXZXT5NXHTl2nw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiVJpjJBu4BJ1d8O8m36jdQu9Ywzyj3r99MZjfW3TzTQ&oe=6AB3E917"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
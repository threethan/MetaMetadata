nc_ohc=S2aCRFnw6XQQ7kNvwEItN56&_nc_oc=AdrvCKHN_8R_x6KC1QbIBE0dFL9Ev8hJH44JoUvx8gMU2RYAzw5qZQLo5ZVuh6cwhPQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WqErvsHTvT8vxNtnWlz92H7hjbWGMJzzzhE8yon3kRw&oe=6A1C55DC"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQJJmkG27ckQ7kNvwH46Utm&_nc_oc=AdrzWAEhlSbh8_9lfByaaY5MOLVDdcEL6GQCp4b6MHF3soGF016r8WN-v2xlJWGcng0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af747rj_lio2YVLX6AaEt9EdGjr5ghUeK8_v0vehQmKsqA&oe=6A1C5CC0"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBur0XCAxPMQ7kNvwH7vmz3&_nc_oc=AdoooNxlB4z3bb3UIrV3PVM-uy3eG1IYYTM4xLzdCYnj-_IYQQOUZJAMOrP8HgpPcfk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Or4qT0T0-UeNzpVO2K9R3S_JJZgMe1ArBQSYo8lJrcw&oe=6A1C4E51"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgLKOjYa4x8Q7kNvwE-Yl3i&_nc_oc=AdpXDNwqPnLB96ymyuc0RGkSEf7bwXZhEMHpVsPBp3BN4msIvarsigNdFn9ZeFgj37M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VSPnjwlDKL4hh9SFtJP4VuIIoNLmSLQMYUQMbmUyuYA&oe=6A1C57F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7biF8nwRI_8Q7kNvwEIuc8e&_nc_oc=Adr_JmLBgUHlFVBLP79PKAO6C8W8tVwFM5JKrJIjBxI-ANWNoQhFAC4TRxnC5wd45Zs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cg5y3TSmn8U2CE8BenNjLs1HS5dFWAAn_oIWdp9E_Fw&oe=6A1C4C97"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
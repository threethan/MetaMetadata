nc_ohc=pSDV7xMXpXAQ7kNvwHHv__g&_nc_oc=Adr2xIyS1jqfoMbjhyy2N15Tr_espvCnfKyjiZd7e9ieUN-WlP1DetmukZoXR89r35Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9QV20GLlAzzNDwzF95BV3IPmM1xSv0lZlPzul6pJFOQ&oe=6AEDF45C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BugVpc1Tc8Q7kNvwEP89An&_nc_oc=AdqT1ny284JSnwuErv1lE3xRZtWhC-D43sHk7s1htNxFEDr3SFiX3hDO0XhFnW4kogU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtpr36y3S78fPciCuZftUtmYbJl0H1t_Edx4rfSmCHwA&oe=6AEDFB40"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9N66EnQs3uMQ7kNvwEMy5a6&_nc_oc=AdoCbTVCHZIPImV-eGm7G3K1KBa0LRiW-iYUZVsWnHOqEjleKKX2TkkM8ym7SUt5rW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyIOsQVQKJ-zT3Q52cS_TgeJyokWLfyjT55sPQsaXpJA&oe=6AEDECD1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3L_pUwQT_cQ7kNvwGgEDQb&_nc_oc=AdpK6nFsIeB-erazL5YU-xJKfsKZf2r0ddL8PAg1_OzJQxpdAVUe0O1TQFDY6IPdnNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdtyT80QL7OXn1Hub9ziInu96mkrVgVfFU6ayWYkZaxA&oe=6AEDF671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1widBBl5lZ8Q7kNvwEca0Ta&_nc_oc=AdqZ9wAFLyz5wazlB-RMa2RjmqJMXYcZTdv-SUMccxe3ny3iYozsUd-wRkYa1JBtyR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTovH3j-gIdihG0CpyZqCYw-xppkHAJfmdIXqB2S1Q68Q&oe=6AEDEB17"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
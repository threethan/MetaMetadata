a0a&_nc_ohc=qzL_U-nYy2sQ7kNvwF_1ov6&_nc_oc=AdqQmxCf1BZqwfzEeH-TUO7MTTeUf5IZsj3rBTmD4hvuU-OnmC-Zx02cznKC1E6iDRs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Hjx6OUeRJxgt1hduR5TzK67MUkZ2IY2bHH_1Yg1EBxg&oe=6A3956DC"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4bh57WelCMQ7kNvwERf-py&_nc_oc=AdrPrEWm_NAy-h-rC-7rWLC1ns9-PsGdi73ruXlNn5_k65ZpmweOKo5GV9pVysIchyo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UruVklBV0Gn1jRQjJsbUAPqj_hge20vhZQrfVMsxr5g&oe=6A395DC0"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovr9QFZWYb0Q7kNvwGAbSFc&_nc_oc=AdoLxrLPaU0o4Kx9MjGCb68Vq7j8P5VAdl6EY6grV7P_13KWw22RIPEDMdlQBSxoS2E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dIB2nCbPXIHK2A0RU-zwJBGzWovHmw2xIOz8ShjGe6Q&oe=6A394F51"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSFZNL_BbKIQ7kNvwGSZjWk&_nc_oc=AdqxSKWT67osuMVwPt5jwJX0RUTKes6ha33w19gv_4pXowELjlBsviNkAUrsFVHag0g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S3TCpDcw9wBO5pj0L1nVar4pEiT9jkpBm6RQGtZygTQ&oe=6A3958F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45RzBgRghXAQ7kNvwFz7FsH&_nc_oc=AdqVD-X3FbDf7fIjGZv0GtVByNjfiN97gjPj1FDw7Ri5SZjLfO59BDDkKquwl0_v0Bc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_qyxjqWopb9avaM9fLpDUnU4OqNc2uhuE32GeqRaSxw&oe=6A394D97"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsGKfGU4soVH6eJNyKOF1hO_Ac_7IbdDFIM-IPFrDcFVQ&oe=69A1821C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfuqfclTBy8Q7kNvwGdb1VK&_nc_oc=AdmWp1xXR-JaAYTyanAPSnrAhc1zy4wb1xibGpAo3WbAHWH3EaZy1kAKiHVY3gY59aU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuTNpJxh44PPlp6a6JN0Zy8-h1sqLACzInGK9IcAB8_GA&oe=69A18900"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z2aA6rUVtQQ7kNvwHDcJpi&_nc_oc=AdkiMxKMNNgd-q99Gc2rPiCOqoc5hs-7iZgFlIfHaA08y6bex9HqViQzpfDQu7hUpSI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsIlsJO-_mMBImOe5KcF0y5YlzzYGhv79h2yBNilFsnJQ&oe=69A17A91"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3T-pOlROOEQ7kNvwFUamMJ&_nc_oc=AdkW4R42HvaeWiZOlP0QVrgen0lDZeJHQ2DxugVuSn80z93bsOaq-r7mBvRD41zGlsU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfupdGNmvsuRj-lC4HutHXBMR14EhSbOyCibtWDrhIBuvA&oe=69A18431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kOUowxC2I0Q7kNvwEDDtsg&_nc_oc=AdkhqUOVn-JZind3B66HN4q8jbHJcCjj71KA-FIW_FDoN81BXnJ5isZVzSt3yK_ypcs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsbiiOPU90X3Sz2xxECPemWpNQxmtllVDVSGdi3G7yf2A&oe=69A178D7"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mo
nc_ohc=iC5yIU5Dd6IQ7kNvwHaV98_&_nc_oc=AdojcRRcw9gp2i3fNCrIcyQhdJq4mebtUHcTgNxa9r_SU6EKKExMbD3lS8gp2RVcGf4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYhB5a25Cx7p8IBeNhjt4wtKagswaPG2EtxnOPfIylig&oe=6ADE225C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvgBdGf7F84Q7kNvwE80b4p&_nc_oc=AdotFFDctDfrlBS6MDwW9ckruddOBmtUWe_XboLVNISJu8SuyBZ0E40Cry-9YkuIDDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqCVV9VTZJMPG0DMQNJ0-eySyfgYJzvWatxWsN7jikdQ&oe=6ADE2940"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQlGAGwlvE0Q7kNvwGcHgey&_nc_oc=Adr-0caYNj9RDa3bLIOOSRlLrxrNYNTPzkqFHGszFmRaUL8bTiorjugi3dfq6Q-KzVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNILqRs23nVXe8v5YVBkLouhGVNCOXpKhBjJwbsq016Tg&oe=6ADE1AD1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPDfvqmraL8Q7kNvwFhUi2T&_nc_oc=AdqaXoFNJZ-V_cHK5rJmtDc0bqeMbhEgsn60gt_4MejGBg8J2O6NrLK0Cmx_saWgxpA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9rFFhwmCxwYfz4Tltnlll4UyFjyQFde5CpLwfhRsJyw&oe=6ADE2471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTGXLOWn3xAQ7kNvwGv8Rt9&_nc_oc=Adpj258SpOPq5ACo0VA_kvwcQnNzCfqUfMlqa-dxExDU1kBaPZiTcX7-0nriBZH47zc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW2lFVLsv5TVCVqlAc5FFVWPgPoruPT2WQj_SRh4lv3A&oe=6ADE1917"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
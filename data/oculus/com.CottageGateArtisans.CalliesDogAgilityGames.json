nc_ohc=_-lQhbTtr8QQ7kNvwH-cYpX&_nc_oc=Ado1NsYV8s8J2UQJkSlC_A3OB0wg4CVDE36dM-Z3RWS1j_KFBPilsqKFErNqC6jLPjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UBxWsKwaFqMeV39ZKKX5lRLV-Maf5futxt7OozQh3AQ&oe=69DA329C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnJuc9o2VA0Q7kNvwFu-gg_&_nc_oc=AdrEY2NC9LcV_5Ty212xmtGhTGE-D7S7dzs2tJm1De1XrXbeAq4RSRw1IHBICrL5SyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YOCwpaGsjUylZ1n4ECAri0iA8bFOs5TjPsbjHp7Aegg&oe=69DA3980"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mlqPfQGP14Q7kNvwHxkko2&_nc_oc=Adp16mIgizeR7gG4yFKgpFbMZrbTG-Nk50eMGINSmzbfqFus3E4iz82qlDUCalhC0Sw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dB7gpCHVZy8b8O29wdw2xcnxKsUPzfXJ4waBsXC9X2w&oe=69DA6351"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id-0_fQKuA0Q7kNvwFbxrEt&_nc_oc=AdpLbZ6rESanhAfSQ8_DFdWmgTH6XZf9-_7l9_dOSnC6Ddf4GHKebbGE5hHXY6ykCGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K8nCAzLOE9HHVCs8x7VBW9azBtTVkU2D90axceePPIA&oe=69DA34B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt3Y00hmtpcQ7kNvwFUiJ3N&_nc_oc=Adqd1pNSQCkSrZA25TtkjNij9ozW4gkCO8y1PVUM1NDrCIfnOXy7Rd-U1BfjacDmc7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hJyM56a6AM6mIEJx1Fiad44Ktq8VzWLcr6eZPIXM54w&oe=69DA6197"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
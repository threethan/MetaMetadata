nc_ohc=0G4NpVOB-yQQ7kNvwED6IeS&_nc_oc=AdrRLZEy9_oQAZOP9j0VRNhWU0C6sCt_GYtiP-ESZ1cErh_1cm8ZVM1JIwQK82fwJPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSagc013g4reDOorqiCv0scnQGbBaO_V3mOxw0NX5BhQ&oe=6A5F5A1C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR3Vp7W_kFMQ7kNvwFz0be7&_nc_oc=AdqckuvmA2Uj9mltJ6HZwHy5HwzGsdXuqCAMl97pTY20A58NPULui_R-NRJOfMvUQ1M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7ptJ1EpIh6NhjrDvQiZ0gOvuODmMLjf3lH7si-_6MEA&oe=6A5F6100"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzvGG4L39qoQ7kNvwFIAFsB&_nc_oc=Adqej6DTkcuIF3u_-uJeLRvv_py8jwU4imNR6ef79LjgOA-uCUNJDxA7cwJH277xdOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZHDgH2r7n7FRiIyDnUh54miseqm34TMtdakP-JNKaYQ&oe=6A5F8AD1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx_s7Jum7PwQ7kNvwH1XMmj&_nc_oc=Ado96BQOj9v_XvXIT-iinS_4Yr0t9K4OIq_6u4xMcz0iXf4d5S3g70XB3xAOcy1Y-mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB73X7HUV4vPIkBkCI2y8C8yqcd8l6IfcthC5XRxN18jQ&oe=6A5F5C31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UQEdXiZWX4Q7kNvwFNy--j&_nc_oc=AdrpgHPHsB68RJEjhWsSKEA69Jin5BbQscWPQaWhapGtvJzwd6khBoTJoSOUpZsbf2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL5Jh90J673ffaB8UtPDRw9YlGaanZtU-dqrk4-Ym15g&oe=6A5F8917"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
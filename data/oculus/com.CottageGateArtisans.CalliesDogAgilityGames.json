nc_ohc=QJ3u2JWLyRQQ7kNvwGoR-30&_nc_oc=AdqKnNU_vCEMeunHBTEjlOFD9SUljTMyFeaitRidHyG9Br-0LxXWR9wLA2fAKbwq76k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsubLIjg3XPw79-qkomVdBp1PVIQ266n7PFvnglsl8eQ&oe=6A94161C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emLAy0lD6qoQ7kNvwHqvN9W&_nc_oc=AdqxCXWdHBKH3HYLYEe0gddI_n-1H-BQtx2Nnj1Ljpj3B4ulgB9PxBSXQeoBgBHoEgY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWzf151RYb2fqVVDNDpBs6UZSa92mTASfmgmzJmAsf8Q&oe=6A941D00"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D4eVk8PjD4Q7kNvwF9Yh8B&_nc_oc=AdruNbyP0L3e1dEgxjLHlCdpiJGW77NLhO3KZWic1PqT6Ly0ZY7_qer2mWJxXNMKolI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxsDOCzaHL5e2VRn1cgUetBmuJbKpamG7juJC0kNHx2g&oe=6A940E91"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKbFy8XqzmEQ7kNvwGxvYCu&_nc_oc=AdrRYmcpHkJDyUUkrqlKn5FQOCfBG78WXY53rR_q5aos1zbY6VT4pe3tGuv0qeWnitY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMG3jl2Pv2PeGR2PNLrC1HCrmKecoIZ4VXzhuJ_wsQTw&oe=6A941831"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bymUoUn2a_EQ7kNvwFGZDs6&_nc_oc=Adq2Q5UBQF7cJpIWVnlpTFz6PsiIdfNy0I8ywP1QJ3MbetJAFtpbWRhM8pIx8KD39H8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcuci_s5fMD1KqbSHddw0pWIZboUUFxEz90leTZxA_jQ&oe=6A940CD7"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
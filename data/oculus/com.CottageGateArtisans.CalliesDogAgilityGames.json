nc_ohc=Y20Tu0E8cL0Q7kNvwGs_LL7&_nc_oc=Ado_JeDql7YHI82w-EIHIq-F9Vf7Kqs0FAypBgRCDu89F5gAqWN1-vS_SRRsrMhumE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxwa2SzhNpds3fphsR7Z4PtnDeT0MENik_VBif9WIi8g&oe=6AD244DC"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V3J41BADWUQ7kNvwG-oMiq&_nc_oc=AdrjJBhw2gK1l5TdwVQFGB2rWdrexpxyvxqNgb8Vhkm2nNmo1uzBzs3LtaRw5lbgIB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_qhrVBp0RSxKiL4bxRbx_M28NchCB3-7JOqLrQjsPEw&oe=6AD24BC0"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1PLTcoiTMoQ7kNvwHyaolw&_nc_oc=AdoKzWb0GGR0FRTOneEJWqj5vMHrelP1z09khRwOvSCorvyYkUbRsEhiTe_LcIv8IN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoBsXy9xhKeGdEDxN0KyeBu2-FlaVGJfZpVM2pn87btQ&oe=6AD23D51"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkarQZ2cmvUQ7kNvwEY49JD&_nc_oc=AdqAP3O1Df0LwHWlAcEqn4MJPEY5Ov8RvI_mXhU13ViGPd4msS2VUdneY_HdTfVwKLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIp4XDOYQ9-eYIZxF2e0q65eQeWDcRbQLNjLNcdyCpMA&oe=6AD246F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2sX2QD2JQwQ7kNvwE9gwRa&_nc_oc=Adq3JAHUGlKtizf6UvshqEZ5liHhsc9rg1e5N85THKpglwyadpMRkBhcHRKdJC2_Y7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPydSlwJKVIm1I6x1TmzuapK_XGNiBh4nEZXctzX4KV5A&oe=6AD23B97"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
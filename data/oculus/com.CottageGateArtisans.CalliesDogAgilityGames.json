nc_ohc=ywGK8jyxNAkQ7kNvwHrb5Og&_nc_oc=AdrB4s2nJFfKLy1iKSZBMqAY_3PSTWlqPpk39YrZe-7-mu5mN7vd2_kI5977G4C5j7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIumnPfRBE5UxHJ_78DmA2OPfU-tW_eZGmJ0OAA05s5Ew&oe=6ABBDB5C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FV_q4N99nNgQ7kNvwGC1Y-z&_nc_oc=AdpgCy_YsPrZTQEGawg9lcRPoPCZhYqqNseU8S0vRdKEgUZKKim7BW4RwhTCm0-qPJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfZ-9bAa7elD1eb3RmgmtcxV1atvcUOKMmAzMhIeTdgA&oe=6ABBE240"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYS4HU-IL8oQ7kNvwHMe1He&_nc_oc=Adofz7pC3_Wj_sfK8zcglUQlhABvXkN7TZi199-yC7m8pocofRL8u5XFS3F-ZS6hGx4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjzwnnSt7nLiZejnhaDdk4p7L9ghCYAcsVHBlbt7of6g&oe=6ABBD3D1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8J9SqSOKowQ7kNvwEa_AGd&_nc_oc=AdoJiTIqDW0Y8E4hYTrjlLCY1JPbiAu9rwZiV5r63CN-kptnH7HHllAveaczU6YUqkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj8AresNLOZLOplWFhykUlc9S7UJQpqTorXx1DZ0fD7Q&oe=6ABBDD71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHJ8ISnetuoQ7kNvwGBfyrW&_nc_oc=AdpxXZhw-GcAd0WOAEGRhy-tiRmaYeOHVo_DDXRh0Y8vnceDLM-907mGlH8nd-_2nEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJRu9EDxQOdAIg5ddSz9aP_JXAKULW8XbI6LQV9HeiZA&oe=6ABBD217"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
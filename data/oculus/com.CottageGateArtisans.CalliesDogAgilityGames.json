e7a0a&_nc_ohc=aX5qucngPyoQ7kNvwE6N-Jr&_nc_oc=AdosLS6UzpuqQrDDQIX9gxm-Uz5RJn2JnmF_01emdM4dGa6qQJI2a7UN9BE-bOqamX4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY-DwRyyGca8Z7u-RhHWrpbvySiPey2nor6yuhxzecjA&oe=6A8ED01C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY2TSxo576wQ7kNvwHq9LJM&_nc_oc=AdrSk5CyeRf0P0PyMXGVpRmavqY6bNvkbgkfetjKacjQlr4JFp3aFOtUL2KOsCgiPls&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE09AQoitl_JBXZra1ViUpKqTVbI6r2I9hI3VTWvenKyQ&oe=6A8ED700"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSfnHRsBQ_8Q7kNvwHajKMX&_nc_oc=AdpwkzAEmHejbC-cXMHJWquESCBY2F1duW7bGRpdrkH1y12ZkntkV3X-kqx66w4H22Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFFUKhpW2t6hmWJ7qB3hTNSCOlqC3LF0dv2MUjbQdFzg&oe=6A8EC891"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uCZDnQ0BIsQ7kNvwFn29Ni&_nc_oc=AdoVw-FSmws7MW04-kI6u1LrIek_LQ0yZgmCWNJdLrq3Z_NjV8uqvL9UEZEo79Rf_MY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3OWBesLaelbgXnulbxH-dYCxzFYY0OBV_z8WDl2sbFA&oe=6A8ED231"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2b3R-sS8dgQ7kNvwFF_ccf&_nc_oc=Adq6G_yYSXb0pbF-UoUCVBhlNgf1wTuV2gksTLTz6hbNFIkoFRhK2Vf1tODB8y4i8l0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHRbA8P8RmX_Z2q9Nfi9ShqE4_CnsOdcv5iLgnjcGB2g&oe=6A8EC6D7"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor
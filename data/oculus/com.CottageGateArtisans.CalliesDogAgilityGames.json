nc_ohc=Yq_ejkGP8kwQ7kNvwEbnYi3&_nc_oc=AdpDip5I7-f6VTCACK__36hAJGv5HLoW5bs0mgtnvvJAAaVpepg-0kEftUiIJzD8oug&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TxPs554U1lxOOhjBopLy6ensLKZ9n-Yw6VXPaa2zjLQ&oe=69F33F1C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS_MSr8fnqUQ7kNvwHvOn6c&_nc_oc=Ado963iHr00K5oL1SuDvgY_VhKqC3fsZl03hcHwwjsrxCgdL4SXzD2BUMLR2iJK2i68&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bmsTefJERZXYduPh2307jclV3gH1KCdsa4UG1JsJPGA&oe=69F34600"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Prb7yzHfaPsQ7kNvwFByrWv&_nc_oc=Adq7jeqlrUy-pYD_jV-VmESAx6Qdik_qY5efSqWwaf5KHrtPGxTKR28598XdhuCKKDs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31cjElSG0YiqAEzOu44iX49NVixfAoka4NLEL-XXcM9w&oe=69F36FD1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWwFdXfZrbAQ7kNvwFQtK5E&_nc_oc=Adq74LYReDmLIxROa3AkObbJxl5SjTJg-rW63-hyRdpG4mtRH7NRZHirCM4egkLVV34&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Org4irYyU7B-WOXj8k_D4ddDaoy8b5mNsxgZ0pClIgw&oe=69F34131"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncs1nrKJTc8Q7kNvwEduIJH&_nc_oc=AdrzF__d68i2Zdnw5IZ4ytGLdbDEYu81JRjQitTlL-tosD_ohVk0EBAQVxnhPX8cNJQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ntBT9Jpkv0Rm6J6wYGpSFGb-59ruF2z8fBoXv1QLXaw&oe=69F36E17"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
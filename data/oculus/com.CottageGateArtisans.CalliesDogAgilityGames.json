nc_ohc=YPZYXdsPXdUQ7kNvwESMRDq&_nc_oc=AdrlqOZCiEj4Il7dzyARqKfRDveQSCmtVK4_uSaXX7GijjtDtIB-CMR5xp72Xp2-D_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ivgCtMSq4uwHSPMoW6Yw6h7fZU09EsVs9onMeXLo6fw&oe=69E8B31C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSYmAV6xp9AQ7kNvwF7i72w&_nc_oc=Adp68TpHEXJ4rma5YQmektGwNUdrAMiSAxFCAJc_RXOoPj8t-abiD3Rk0pync0m5fSA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ybIYiZN8VY8tdvKXTxymSpV9guTxxnjtJiJgVZ8L55A&oe=69E8BA00"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Lf71hIgAr4Q7kNvwGWi0tf&_nc_oc=Adq76k2D4eBghRHY_jn31eyig5NMeV9t-elAFAkhAQB6zJnp1_HEGB3r0jPU4K-g4oY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bAx51qvhIh9K5BhPDB6NIWAaim7MTh2aOduowQ842Jg&oe=69E8AB91"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9ACRnZMbjAQ7kNvwHWjfgz&_nc_oc=AdqYIdJCz84u19LZneaohRqchR6Qu3NG6jO4kAO45RrUw1ISL1doCOKmPU_5zTFKq-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-dzsCz5ZPhv8BwmtgONXkFPl6fDPK-4KJXu7EEygBzA&oe=69E8B531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKbC2IAPB74Q7kNvwFER3U4&_nc_oc=AdpCCSqA8IlnKWvPb-F1hUYH_bNixe9rc-gDskHrhX9IdsH7h4oRi549bcgPWm4hcVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hz6axM3TpM2UaHbp7Acwg7h19SntAa2FeHaMdvgXFtw&oe=69E8A9D7"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
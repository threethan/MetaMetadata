nc_ohc=c8YmXMO-lYoQ7kNvwFS8Pni&_nc_oc=Adpr7S5RI_iBQAqxGexSjtuu3oZmoJd0E1sGup167ckNq3Vk3uRHiEwXh7y_ChITYNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bVyg-GOn0s5BPaOC_VnmBteXPH87Q3HvgsELkzykZ8g&oe=69E36D1C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8qmPdOUBq4Q7kNvwH9VANX&_nc_oc=AdpmrrsMO98NlqXHYjZDvpNZlJKkXELmNkN1ns7slo_Nsc6jMgp1HlWxhBoJUGB3CyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3p9O6_WcfQ_U_wnAhORfcMFFobNUVDBwR9ydOeRU801w&oe=69E37400"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An6O2_Ku8VYQ7kNvwF0oC2P&_nc_oc=Adq4wprZknDUPpXEDDkWbA20nqseffcAcRbsWVVQ5WTws1lEkt-4AXgO3eak5zWECFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03pFmLzMQahp7IoYYMCBtfyps4Je6QZJZ_RfoAM8xFaQ&oe=69E36591"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hADx1l242gQ7kNvwE4wloA&_nc_oc=AdrOFeuF5Y22Xq8G4TixBtk47a6sYooOMLLkZ1UdgPmUu9v3nkqfOR0WysusSKzzd3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QLcaaQIhC1X4ja4zVEuFBVCyrvihstV64xaYeBgReMQ&oe=69E36F31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugzE66NNZMEQ7kNvwG3V561&_nc_oc=Adrtn7DYRcyEe4Uu8u-_5ha4RrkGNM2M-hEazcxdzGoI4RTh-kytROISej5tZro90bQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pFMIkd5lIUal7s2iLQI5X9xO6MPCop94cybMaeW00cA&oe=69E39C17"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
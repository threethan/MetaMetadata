nc_ohc=ivHSxkTrlmAQ7kNvwH7djhE&_nc_oc=AdqnoFWQEk3VwKgt4LYAQmy-K-rwlW5zuiP61oz1OnekN9dVN4q_wjZpMZAIF1ltzx4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5uZaZgqjqN47WuYDwsnaC6pwls-p635gykPkwIE0E-w&oe=6AA17D5C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr8HyvWvL1cQ7kNvwHpDKJY&_nc_oc=AdqjV8SoXUznSF1nhmoQypHVx2_NY2ysqCSZt_7tDmJhMRItkecmQTAGtNOobrZPMQo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK94n-bbDshJwaiysg1Tf0EdZlB9lRYYnj3GKykyC3uUw&oe=6AA14C00"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNPO8OahKlYQ7kNvwHUG2mE&_nc_oc=AdpNXQeELNEIIMtxySAvu5mCC9kFe6yqRkrrAJSWceRzTjN5CCa6ZLHekiKgDlTK1MI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhNyC6dAUPVCUFSDvcodjOb9Fmc32VKXeOGMdzbkIteg&oe=6AA175D1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn6zm5u5XKMQ7kNvwFSeeSh&_nc_oc=AdqMZiMgbFLb-eu7IRmfXDC9oFWH0Rb3y4VbEXh1-a_DsDsWo7DLpXsMjxDo38E0Rlo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfo4D_VaxgyKhPH6ygW8-h8Xfb9nRq62rZqMERnZrzDw&oe=6AA17F71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXIAfcZclRkQ7kNvwFzx5E9&_nc_oc=AdrU7g0BSWaqPvq3ueRdczFWuSSOUPr8aXFjMKQ6dYyoBwvJlv8NfdwgVvjxuRgrSOY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLDzFPcEHFaP6VjB0BIawndoFlDZajCSLSydPz8JN4xg&oe=6AA17417"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
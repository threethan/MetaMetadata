nc_ohc=6RFPvBhp4sIQ7kNvwExNZI1&_nc_oc=AdqqqweGBGDiRZx5EtNsw2FcA93cr8XxypOA0PNtYDUnM0fRqNWUw_RCD-Vaim9YVV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEsFbyVbUOoREEczehwqzu8TBbmnS776DmWJx8BkwH7w&oe=6ACFA1DC"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avSzfr0lHYAQ7kNvwHZI6iO&_nc_oc=AdqcVA319NtdYs4Z3fye-oqSsQY6laGetMLw4XVtzVxD603W7ZJasT8FMPZb9ffDjig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtx1jVxuZ1c8mq068xwKwAXbct2JvSGsPa6Xp7sbku2w&oe=6ACFA8C0"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwVrBg6ShcoQ7kNvwFqRmWj&_nc_oc=AdpbReXwTbN9ug3LQsNAtYcna2nvTZKWVuXoC0qKBloz90FMP1901-GFKshuXoeDSkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvq3P6z-S7hHfLOvGxJu7-IyVfeo8uwtm1X1VqdVYzkg&oe=6ACF9A51"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lZm4VmViKkQ7kNvwFsmFt0&_nc_oc=Ado7rJN5BFzXF9GsvY_17r57WHLLC6u7pIcmlwQzQRA1fOfPAM7q_IMa9pIsHp3nkMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWZiNITxjT4VcxOA7FWZir_ShMuS-O9zOHS9O4KDPy-g&oe=6ACFA3F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VpEYqGuGPkQ7kNvwHecmmk&_nc_oc=AdreMKzNc9rvhLohdH-83n6Fo5fCf3N8BwtAnlWjAvcJznElzfJgOp5H_YzDadXrLqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTZl0DmlwdUhhvNGJbakFJvdaOjw75H-bJlA8lNRgDJA&oe=6ACF9897"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
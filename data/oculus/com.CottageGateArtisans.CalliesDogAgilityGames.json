nc_ohc=o92Vl1bWD2sQ7kNvwFPmK6p&_nc_oc=Adpvx6dplCuckzRRQ8_OBOEqh9bYfZADJ1WLC2n1nHeQfxTaDWittCvHMpthXwCT4qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIaOB4iKCJuJ9eVEQ08VFjFsX2jYpYsotcaTvXjTx-JA&oe=6A7EFE1C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe-dWj2a9t0Q7kNvwEGBHgy&_nc_oc=Adpwol6fP_6GlolDh1q-X6AXjHf0n4v4YQvj20pjHBuV2kW7dyDj3hCFouVjzZPMgKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGvC1k2LC9fiQSK2_KgZLVe-sEninujFu5u9KYPPyXfQ&oe=6A7F0500"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vtc0HUbwa_YQ7kNvwGTiT_b&_nc_oc=Adps6ER3k0gpdxUw2FkaVki_XvtRmGoU84-JtEQU46AsxzD3Zy-unDAZ_RDW-CLEGH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfSkHEQcY-4DrECBhf3dNMZF_b7r1aYKVizNHxJb_2Aw&oe=6A7EF691"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ergcPv3avfQQ7kNvwGnbC58&_nc_oc=AdrCt7Wm7EHhK0zBAc7HmXEEqTS3hrdjdvCeU6rqWFGEBBotg5UJv9lbe7GCBb33e6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJD4s3_PNKBjruY_3BFBISBjf42NehR9hr4zt4xEjxhA&oe=6A7F0031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptKNw1raJbYQ7kNvwFmE_5o&_nc_oc=AdrGJLRosLF7_hiIGijIzTMDoUqAogrE4N6JD_1AavbEndqakfXne9I-Qrj_0Eonh9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgltxLtpfnQWM_PmCMWTa7JgMmkUQRtyGugRdaevV04A&oe=6A7EF4D7"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
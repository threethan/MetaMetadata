M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftiEZcVCCkklKVGKrcLE_2PGBqyHYCWZ1butpwSddI6Ag&oe=699D8D9C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsHoNz4IRzwQ7kNvwGc5Pnb&_nc_oc=Adk9wIOLCNg_125pJwz4z-hVfmoDuWbW_1vTY1Neq4L5E7meMJNVQdUzLHoohV6JMBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftI2HywxgyeJx5ew0A5F574u0xajXTSLR6E5fw6v8nGcw&oe=699D9480"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP3JC7YH63EQ7kNvwE4ArrG&_nc_oc=Adlman9XxNQZ-B-L40xpbBUfzxRhKhJlyss2P4-Ub4hIsHjgWRqZUU5BPBtbK_wz1I8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftg1fHlP1un1EKDIgb3vlMMSe3bGhOlhKvSfShxdZcFMA&oe=699D8611"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVNc6B4v70EQ7kNvwG766gC&_nc_oc=AdldTo2sAGtzWgml4Nj1RoR19a7lZM8hX1xPxDAE1na0pQWg11DhkoqXoPRpAJ_DjI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft4xTcA-BlvaLNfFEMYWi_C6j1JnxzGJ8AH3qaMgzHrdg&oe=699D8FB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgnkZQ5KZS8Q7kNvwHYoIFt&_nc_oc=AdnptYxfYe2H6FqrnZ7K9qGy1FyikPN0f7G--VLJIkCP9dI4DGfx0RLtGsv2-TKmMWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftED26ljpX4la5TmD_EvINlgrB2K9YIBEoXB-jsR_Y_1Q&oe=699D8457"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mo
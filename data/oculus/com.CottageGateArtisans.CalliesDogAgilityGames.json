nc_ohc=0G4NpVOB-yQQ7kNvwHEoJLh&_nc_oc=AdqEEakyWMJdifzb0Dub_4vWZVI0Co8ywSggEn5ek7eKfGLSP4cuyc5Arc-82IOer3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7eAD9AHrbshJUynXICaKXni42dcgQ_wUUn9V0Gi5qhA&oe=6A60AB9C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR3Vp7W_kFMQ7kNvwGhhViG&_nc_oc=AdpCRUCcjO7wt46hVqSjihhb2SPm-w2cZqx64216_yykv-fKBxQgmSLOaDnR4faqWQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYF-hmQzPx8F8ZZfDltOtjSeUAHr77z5RbR4PejlyrvQ&oe=6A60B280"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jQd7am3udUQ7kNvwHUbhUE&_nc_oc=AdqV_uK6gU4WYzGT3bnrtq-CotUbyNP-mhTDltocwtKVe-ifTnk2z6q5vKwP8dukUrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClQKNk3-xDi6JJTEvf82SMh37IK-UP9NZ6CEIikH4Xdg&oe=6A60A411"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx_s7Jum7PwQ7kNvwHTvQg9&_nc_oc=AdqDO3epu9kxq6iJkydjx3DN6Vev9-SM7QUkuszj1kU4_uSlYw5shck4EsBF9muBEAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWiEip4IQuSGE4N0LHGHk2IaIoQ3mjJBZeM--878FfBA&oe=6A60ADB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UQEdXiZWX4Q7kNvwFJZ4Df&_nc_oc=Adrxa52peNjTzwcwrhbK4HOfkyhH6pQ0FZW4jeK_FQQXG-3x6Ee7ziqJrZ-8y61jWaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSDg5tlpcfFRgHr4vCqEJVb2pjGHloLhxA4nisKNpyjg&oe=6A60A257"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
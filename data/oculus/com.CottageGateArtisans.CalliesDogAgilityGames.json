nc_ohc=flr4TQsEHxUQ7kNvwEwKv_z&_nc_oc=AdpTMRvvLWppphrjkY8PEkc3RBSkLn-44nOxqORqI3cuTH4La35qPJ7RrnUnVe7aUhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fhKzG3UjZBqTCaptrwDQjsqtjI2x8g2lek-3BiYbnxw&oe=6A35625C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqWyquwpiSQQ7kNvwElNGDX&_nc_oc=AdqLGXAo-WSRQEKizLSh24_KF3HUjBm0zgJbmURlZVNuYxiL3aBztpckWT52BAqxElg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__Y8FdV4H-iBc2I0pNJInWwDuLKFMbbHRtMejnw5mJIA&oe=6A356940"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH1DywEUz40Q7kNvwFykMFn&_nc_oc=Adob7m8fCgVmVPhS6pjDSe12FuVZrK_S7WwU7wjcur_MyZgPlQjj-oZNyDS7k0HIJvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ujjVZVOOwvynomxTWBUAg53s85fsnZFtusK5TdAjSfA&oe=6A355AD1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkQyCgUa4VgQ7kNvwFGTp9v&_nc_oc=AdpKNHezQFw7cPwJc5IEOA62ISAotL5DC8T1GHChKSUMdNej0FWkaZo3RcUR1JGWLKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DF6GuzYRKkZv7myt1XI7H-xWveOuVV2jhWgWPHqMhBw&oe=6A356471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irK8iVfW2e4Q7kNvwEYa04T&_nc_oc=Adp2r43r2Bp2M89zBYZ8WdhAdMbzoPBLGghhAFnm53c9tqxbJz4yifTcl6GmJKpZLjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZuYKVVTKUfhGVZD6MrZoZabv4qbBn770_LESHq41dKw&oe=6A355917"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
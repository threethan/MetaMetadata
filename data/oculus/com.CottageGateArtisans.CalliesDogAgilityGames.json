nc_ohc=YPZYXdsPXdUQ7kNvwFhz_KY&_nc_oc=AdpWBbxhNYlh7L4nsUEw3tBZ2DvLBC5SbisKqrqVdG2DJ4lwSs4seWt23qdyltsb4sE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iqpcJzoaklknRbySt_qKMRjoaFIJEF_ifSy8GvC7cIw&oe=69EA049C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSYmAV6xp9AQ7kNvwFobkSr&_nc_oc=Adqxq4XAi8svj74d1PrlCtzjXfuol3oL3oBZ8_2tDL_S3va45-O58MlyY6K08DjoivI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IgN_ofN__Ko4TZQblg5Yl8sgcljR4qnoa4w6rTjvKvQ&oe=69EA0B80"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUskb4xhftYQ7kNvwH1dRXo&_nc_oc=AdqrTuWYgWY_CukzoY5SbqhmbIvtf-LXBTn3-fq2M5MK4uvV2u32d48t7oMToFcC-HY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kynVhk1cQ9vP2UMMr4KJoVYrlVdjL-Tk44KGmvBW2hw&oe=69EA3551"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9ACRnZMbjAQ7kNvwHqGq81&_nc_oc=AdpEMGQpJF6domdvAg9IA_iXbmvzIbXa2mhS4JcbZnXWaFIqlcGhrQrz4YAIenCJV7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RH3k0n-O2meD8Br6_Hdui9s8agU1j5zNkYM_wgDpPOA&oe=69EA06B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKbC2IAPB74Q7kNvwFh2wkk&_nc_oc=Adofi4leDfCaV6wBBPUmL3x9f_jfRK6Cgd3Kce5VvFVEEwJ9bQxsalM9AdLmkMty7eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qV_bXbBGOaRmDsvd0-CkNUNuI_2zZiScpfYrL-sWcBA&oe=69EA3397"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
nc_ohc=o-3ux0w09XAQ7kNvwHASXKP&_nc_oc=AdoZOwtY28KrUlm5b7NTCiVtysm-B5cGD_7NhDjestn6qVmf_1Osj2GoQONnIWG46Bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhHr0LC4wtmqSdYezQvcp_2rvttPbq82y5kxTTosQ2pQ&oe=6AE60B5C"}, {"file_name": "image_005_1440.png", "id": "562157055942015", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75307248_562157059275348_2956675218899554246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHkwRfnYfNQQ7kNvwF0biXL&_nc_oc=AdqHrZbItMBNp4DuCkMYT_I1l_T5JwCvaZr77VFhhSq7n8kj5tbr7M-PK5_4pEm9p24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHiON4ccorhYoS7anJVRTKtX9027kh26hQmEFzwHfEPw&oe=6AE61240"}, {"file_name": "screenshot_2.png", "id": "250426577530661", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035449_250426580863994_8331402531073700115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWBpzNsvQpcQ7kNvwF5C5R-&_nc_oc=Adr-rWIye1kZpJ99uKdzUx0J8YN9hxO4UqSIvCvPNH1Ok8IsoPea8vxJJJkky3OkcpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz11g6ALIgVg5OlC_nEhlju49LNVZJvqIUJT2IcUcNfA&oe=6AE603D1"}, {"file_name": "image_005_3000.png", "id": "3518339268451184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974873_3518339271784517_6182602566968493729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vZ4UP6rgvsQ7kNvwFhi5v1&_nc_oc=Adp0bZB0vhWPpCD6rGo8bg7kdpwUKhmA0BmAdKMgWxSdMkuAOUnxIp-9RyG2cbfHk78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjI0KrzqXIPxhHuX6KG9PU4TesJqo-e7Wjf89DDdCReA&oe=6AE60D71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "night_2560 x 1440.png", "id": "545498841114982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481473_545498844448315_7405858449675253485_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvZW-6ePrrAQ7kNvwGXIpau&_nc_oc=AdrD05fvAhDNg8LPH0fNCa1mv6rui_hNK7wY81Z9zeHtk1UVgHbc0n3h67kzZFFhm68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKYQWdI6dvzrxiY8JTjkAqlA5-CSVrXiPCksU5V_e-_A&oe=6AE60217"}, "display_name": "Callie's Canine Agility Challenges", "keywords": [], "long_description": "Experience the fun of running an agility course as the dog. Jump over jumps, run through tunnels, climb high on an A-frame, walk the narrow dogwalk and follow the increasingly complex obstacles and courses. Try your best to weave through the weave poles or jump the broad jump. Get a bird's eye view from the viewing stands. Start the timer when you begin and see how quickly you can complete the course. Or you can make up your own sequences using the obstacles on the fields. \n\nThere are now four courses to try, some easier, some more difficult. No violence, no fighting, good for family fun. More courses to follow in future releases.", "short_description": "Have you ever watched dog agility competitions on TV? Did you want to know how it feels to run through an agility course and jump over jumps, run through tunnels, climb over A-frames, weave the weave poles or walk the dogwalk? \n\nHere is your chance. See the courses through the dog's eyes and experience the fun of running through a number of obstacle courses. Challenge yourself to be faster with each run as you follow the sequences through the fields or gym."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cottagegateartisans.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CottageGateArtisans", "support_website_url": null, "website_url": "https://cottagegateartisans.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
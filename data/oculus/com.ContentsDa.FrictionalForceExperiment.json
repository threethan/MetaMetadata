my on top of it, the experiment is conducted from the viewing area, there are 3 bombs labeled sandpaper, glass, and OHP film, grab one of them and throw it on the mat, if it hits the mat well, the bomb will explode and the surface of the mat will change to the corresponding material, Adjust the button to gradually increase the angle of the mat, and at a certain angle, a wooden sled will roll down the sled with a human model holding up a hand, repeat 4 times for each material bomb and average the values to learn about the friction of different materials.", "short_description": "Uncover the force that opposes motion. This experiment explores how frictional force works and its impact on movement, providing insight into a fundamental force in physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9617118238303823"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269159_927519328725470_2806130233976989568_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_
48691591_477372374519270524_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqQMfdRamTQQ7kNvwElXRzI&_nc_oc=Adpm5pzFTKPyWzXGz1lcHYCuMhpGp3afUXEoDjEhWlCW6dGceLVwh5xqVheQHjjmJPk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPCK3mRFjxvjtknDd8HtxVwmZxi_s8-ka2BGbRrCDTLQ&oe=6AA409E4"}, {"file_name": "Teaser Image 6.png", "id": "872370878520625", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819356_872370881853958_6721384357909725880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2c9bmYvwc0IQ7kNvwEiExc_&_nc_oc=AdoIgSooAiaUuauCWS7iXz7FY-ZRmu1HJ5vrnchkA6ssUnhlDeMAADeIn3p2w1w3iiw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6TOGc7qMOx_FDh-6tv9Ja1dh9jASFUD-CimkQtpKTGA&oe=6AA4131E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Void VR", "keywords": ["Horror", "Scary", "Fun", "Experience", "Hangout"], "long_description": "Step into the world of Void VR and experience a variety of maps and experiences either by yourself of with others via multiplayer. Whether you are running from Next-bots or monsters, your heart will be pumping with fear no matter what. Chill out with your friends in Zero-Gravity, test yourself by climbing the Only Up course, or push your agility by heading into the horror maps and get chased by the creatures within.\n\nMultiplayer by Normcore", "short_description": "Void VR is a multiplayer virtual reality horror simulator featuring a variety of unique features to not only make gameplay better but also to ensure that the game runs as best as possible when it comes to performance.\n\nMultiplayer by Normcore"}]}, "developer_name": "Void VR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Fmz3LyYV2KSl28i3BN2d_vbuX4om37T_KS7ymLhTRjA/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1gOxhH5JZP8y5OkUU5H5Z8OWny1F7ZGYD-IT13Zfozug/edit?usp=sharing", "publisher_name": "Void VR Developer Team", "support_website_url": nu
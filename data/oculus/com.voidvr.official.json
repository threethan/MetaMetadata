691591_477372374519270524_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im9yHZs_CFkQ7kNvwH0Or1U&_nc_oc=AdrVboj4MCmyv9eOuvUmklwjlzPBhu26D_L8bMgavuMBTTiXFCrFc6n37kNPEUMUjaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrIz-sabqBPjgIfr51QYg2vfE2ahE_MBoBFHXwmWN9lA&oe=6ADF5D64"}, {"file_name": "Teaser Image 6.png", "id": "872370878520625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_872370881853958_6721384357909725880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4YDWdieQYAQ7kNvwGB6Bjy&_nc_oc=AdpHC-8oA-7RLZy1qB7Qtk84S5-kPB_k-hZ9osjvrsbzXUOrR6p0e2blVIYFUNqmqHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzQ2c-fHTDoNeGtrWYr_7ZWrLTaFixAtBbv2SVl6d25g&oe=6ADF669E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Void VR", "keywords": ["Horror", "Scary", "Fun", "Experience", "Hangout"], "long_description": "Step into the world of Void VR and experience a variety of maps and experiences either by yourself of with others via multiplayer. Whether you are running from Next-bots or monsters, your heart will be pumping with fear no matter what. Chill out with your friends in Zero-Gravity, test yourself by climbing the Only Up course, or push your agility by heading into the horror maps and get chased by the creatures within.\n\nMultiplayer by Normcore", "short_description": "Void VR is a multiplayer virtual reality horror simulator featuring a variety of unique features to not only make gameplay better but also to ensure that the game runs as best as possible when it comes to performance.\n\nMultiplayer by Normcore"}]}, "developer_name": "Void VR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Fmz3LyYV2KSl28i3BN2d_vbuX4om37T_KS7ymLhTRjA/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1gOxhH5JZP8y5OkUU5H5Z8OWny1F7ZGYD-IT13Zfozug/edit?usp=sharing", "publisher_name": "Void VR Developer Team", "support_website_url": null
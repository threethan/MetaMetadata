_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vROXcgkC2RUQ7kNvwHPbIRo&_nc_oc=Adp8uNJ3OBQj80q7s2xcZxDcxgvcAdz5IB34d1rEqNS18e7yG81MACqRrwaEfPpSyPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi0BH5ztsb0BZVgqSysWd4ttq92DLOs1T-ADwe2v4SOw&oe=6AFF0708"}, {"file_name": "screenshot_2.png", "id": "1989630731993604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673531334_1989630738660270_1410379880689360759_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udDG0wDdh38Q7kNvwF1BDaK&_nc_oc=AdoOjjZvmfVR6PsHQjUXuCtjbGAXfHa4-Ff2oz1FMwPOK4Dj_2PqkhgkLAWojq4Lar0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfGxbbgZ0IXFIOoJGCLKwPRjSgFGuJxyeWGeoJ0bnclA&oe=6AFF0484"}, {"file_name": "screenshot_5.png", "id": "1729718754790941", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_1729718758124274_683004808499148137_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4KufSroi_YQ7kNvwElntII&_nc_oc=AdpSEbyYYwBaOfMd19bv-Ga2kvSfFMYxIyfIIahbD2i908yrGzR8wEh6gQDKbXEdhRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLSl4STxB2XdP5CRaXQYEae5dhpx8Gn7HhuphY342hBA&oe=6AFF0A5A"}, {"file_name": "screenshot_4.png", "id": "955948890911188", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_955948894244521_5019887531382831138_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJbfMr9GfGMQ7kNvwGR-yix&_nc_oc=AdoicReqWGjDo4ybshYcmx4nWVllpcm7kd5sVeviMPx9ZWEw8DmMEU7ykuLJ6-RClnw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBuTVrqbyeAT3zYE7lM_Ib39wWMW60Uvr5JpQPVshXYA&oe=6AFF32A5"}, {"file_name": "screenshot_3.png", "id": "1417065336590667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1417065339924000_5099897222480042554_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtQSsFXyQSgQ7kNvwEckI0q&_nc_oc=Adprg94ZhBrj1mcUkuBpy48mZPceT0mlIHKeYRko3KEgutf5J2dCS3MB2SWQQTCGNYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6KJGyMzjG5W29yr2K54ENSW8khOWsj8eqibBdUDdD9w&oe=6AFF15D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1434733908613802", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_1434733911947135_8105978087928042724_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbUFIUCZuAUQ7kNvwGRTb3Q&_nc_oc=AdoWojLCCOkCVfANpcp62Ei2kVz3JWY4bMJykAvHudVtdwvUgQEqNB1G51DlOU4_OqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvscGzw86iVsWO-_5X_KJQwjweRPcOlAt7HNIiPLpeEg&oe=6AFF0E0F"}, "display_name": "Flight Simulator Paris", "keywords": ["flight", "simulator", "paris", "jet", "pilot"], "long_description": "Flight Simulator Paris puts you in the captain's seat over the real Paris.\n\nTHE REAL PARIS\nReal satellite, elevation and map data: the Eiffel Tower, Notre-Dame, the Arc de Triomphe, the Louvre and its pyramid, the Invalides' golden dome, Sacre-Coeur, the Grand Palais, the Pantheon, La Defense, the Stade de France, Versailles and its Grand Canal. Charles de Gaulle, Orly, Le Bourget and Toussus.\n\nTHROUGH THE EIFFEL TOWER\nDive off the Trocadero, cross the Seine and fly between the legs of the tower, under the first floor.\n\nTHE SEINE\n29 real bridges, from the Pont Neuf to the Pont Alexandre III. Bateaux-mouches on the river, the metro over the Pont de Bir-Hakeim.\n\nTHE CITY OF LIGHT\nAt night the tower glows gold and sparkles, and the Champs-Elysees becomes a river of lights.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance.\n\nENGLISH AND FRENCH\nSwitch every menu between English and French in Settings.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Champ de Mars, the Eiffel Tower filling the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nELEVEN MISSIONS\nOrly over the city, the Seine run, through the Eiffel Tower, Versailles and the chateaux, a fighter scramble from Le Bourget, the city of light and a Paris tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Paris, built from real satellite and map data: the Eiffel Tower, Notre-Dame, the Arc de Triomphe, the Louvre, Sacre-Coeur, the Seine and its bridges, La Defense and Versailles. Start in your own glass hangar on the Champ de Mars, fly between the legs of the Eiffel Tower, talk to air traffic control and land at Charles de Gaulle, Orly and Le Bourget. English and French menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorparis/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorparis/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1375151629014706"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "
-7&_nc_sid=6e7a0a&_nc_ohc=Rvw--j9kyVkQ7kNvwE94bkh&_nc_oc=AdpVc8ttIhIu2s5PK6Sbji3hOks2vQVXW9q0C9yjRfFF8TAJb2AWs9cIbpJwSapHfm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOfm3Kw2heZ9iY-9ewL5F8nHakmo3v1Q87ehpTEe7XDA&oe=69CA719C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER ART LANDSCAPE.png", "id": "596728183160716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393328_596728186494049_1415115793361388423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LLZbil4ibsQ7kNvwHh2u_O&_nc_oc=AdpaxCfozPBQPEc-6VeofOgmPUH7zNAaoD8wllBz-61jc3R9YqXpI5d1-ahrgSVAT8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh4DEbpPeF9hAHtzBliCK-q_-wgq_q_LpBknjEgc_F7g&oe=69CA65B7"}, "display_name": "Fitness Fables", "keywords": ["workout", "training", "combat", "fantasy", "Adventure"], "long_description": "Step into a world where fitness becomes an adventure. Fitness Fables turns your workouts into story-driven quests, combining fun challenges with beautiful, immersive environments. It\u2019s not just about staying active\u2014it\u2019s about enjoying a fitness journey.\n{2084049595368528}\n\ud83c\udfae **80 IMMERSIVE LEVELS AWAIT**\n\nDive into a magical journey with 80 levels, featuring 16 boss fights, 16 bonus challenges, and 48 varied traversal stages that keep you active and engaged.\n\n\ud83d\udd25 **24 HOURS OF GAMEPLAY**\n\nExperience up to 24 hours of workouts tailored to your fitness level, from light activity to intense challenges.\n\n\ud83d\udcaa **24 EXERCISES, FULL-BODY CHALLENGE**\n\nMaster exercises like Power Squats, Rope Swings, Sky Press, Battle Ropes, and much more to build strength, endurance, and coordination across different muscle groups.\n\n\u2694\ufe0f **INTENSE BOSS BATTLES**\n\nFace 16 intense bosses, blending fitness and fantasy with moves like Power Bow and Battle Drums to restore balance to Alterterra.\n\n\ud83c\udf0d **16 BONUS LEVELS FOR EXTRA CHALLENGE**\n\nTest your limits in 16 optional bonus levels that reward dedication and perseverance.\n{932722882196334}\n\ud83c\udfcb\ufe0f **FITNESS ADVENTURE FOR ALL**\n\nWith scalable exercises and adaptable gameplay, Fitness Fables welcomes beginners and challenges fitness enthusiasts.\n\n\u2728 **TRAVERSE THE WORLDS OF ALTERTERRA**\n\nTravel through stunning worlds like Terragon, Frostia, Ignis Prime, Aquarion, and Zypheron. Engage, and active.\n\nStep into Fitness Fables a place where movement fuels your story, challenges push you further! Are you ready?\n", "short_description": "\ud83c\udfcb\ufe0f FITNESS MEETS FANTASY IN VR\nStep into Fitness Fables, where workouts become epic adventures!\n\ud83d\udd25 FOR ALL FITNESS LEVELS\nStart at your pace and level up as you grow stronger.\n\ud83c\udfae STORY-DRIVEN QUESTS\nJoin the Magic Academy and save the realms through heroic workouts.\n\ud83d\udcaa FULL-BODY ENGAGEMENT\nBuild strength and stay energized with dynamic exercises.\n\ud83c\udfc6 TRACK YOUR PROGRESS\nEarn rewards, unlock achievements, and make fitness an epic journey!\nTurn your workouts into a magical journey!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immersion.games/en/game-privacy-policy-cn.html", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://www.fitnessfablesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["
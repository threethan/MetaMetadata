content-iad3-1.oculuscdn.com/v/t64.5771-25/39035387_1106902937437665_1830145943394226629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u-DXKBhN14Q7kNvwHdacir&_nc_oc=AdkfeO81WXP3p65LDOUAAfvxvrWcyz9xhtdwcHayuqN6ZIMkKbM1ftENoAzRF09-0wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvq85Ov3U_qanCyBVRYo0kQRblfNhC0FsZVPnR16-5YLg&oe=699D90B1"}, {"file_name": "Frostia_boss.png", "id": "3516536305317687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974524_3516536308651020_7161439292060886267_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC0xat16zDgQ7kNvwGDm__A&_nc_oc=AdkfHPIGKya-On1K5wKcLCDEz-3YF1NgKmwTKshjfwqBC5TVAkptSBuljDdv9y_L-6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJBX5jBzsA-mIII811MynsGuG-2rgDKCTZRCwUmytDdA&oe=699D8FAC"}, {"file_name": "Fitness Fables _Screen04.png", "id": "450863567726764", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462959_450863571060097_160294925395243725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UERJj-9wRtcQ7kNvwFGOYGm&_nc_oc=AdlItHP8RXP8H8S1JRjFUnMJmWuOcPFoKresaxT3bSjg630xF9DDTmePVQjaXKTTV50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucG5PyiRBPXMqQ44IVLHe4fZYmuSq4Kdp19Efe_QcbQA&oe=699D8EB9"}, {"file_name": "Fitness Fables _Screen02.png", "id": "1767400787431601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566690_1767400794098267_2041132177250147872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY28-ZGubmcQ7kNvwF9UT3H&_nc_oc=AdnhGjgC5p2QZ5oYfDZBpUavmxEyjd-gqNAZNpvB5fUNceE4oyXs4PDrFdVqaGFnQEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFkQ7h4X-F72wweKLzhXdpqr60MDJy6K5qsuMgtSS9QQ&oe=699DB52B"}, {"file_name": "Fitness Fables _Screen01.png", "id": "1017928296768780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566680_1017928303435446_5168109478840329162_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnDe7ScIDl0Q7kNvwGFdXxA&_nc_oc=AdkVuQIct_Q0ctMbtpj0KrGopQowaJdSp3QkRfh1YV8U0tYPPNhvw1-badtVHRW7kaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIz1sIk6hc2YKMO3f8_YwbLAzsO-Y0HSBCULg3h_hKhQ&oe=699D9E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER ART LANDSCAPE.png", "id": "596728183160716", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_596728186494049_1415115793361388423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZz_xLobU0UQ7kNvwGFyO1T&_nc_oc=AdmbTYj_PmO-06fj6nsvEzULdNVKJ9pwybNW-NZoxziH_PFgDV7kSKhio3Cwa2UsMiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsH7W-We-tByq_ZHb19sIeN5NV-GjCNfJCZCXfMgr3yZQ&oe=699D92B7"}, "display_name": "Fitness Fables", "keywords": ["workout", "training", "combat", "fantasy", "Adventure"], "long_description": "Step into a world where fitness becomes an adventure. Fitness Fables turns your workouts into story-driven quests, combining fun challenges with beautiful, immersive environments. It\u2019s not just about staying active\u2014it\u2019s about enjoying a fitness journey.\n{2084049595368528}\n\ud83c\udfae **80 IMMERSIVE LEVELS AWAIT**\n\nDive into a magical journey with 80 levels, featuring 16 boss fights, 16 bonus challenges, and 48 varied traversal stages that keep you active and engaged.\n\n\ud83d\udd25 **24 HOURS OF GAMEPLAY**\n\nExperience up to 24 hours of workouts tailored to your fitness level, from light activity to intense challenges.\n\n\ud83d\udcaa **24 EXERCISES, FULL-BODY CHALLENGE**\n\nMaster exercises like Power Squats, Rope Swings, Sky Press, Battle Ropes, and much more to build strength, endurance, and coordination across different muscle groups.\n\n\u2694\ufe0f **INTENSE BOSS BATTLES**\n\nFace 16 intense bosses, blending fitness and fantasy with moves like Power Bow and Battle Drums to restore balance to Alterterra.\n\n\ud83c\udf0d **16 BONUS LEVELS FOR EXTRA CHALLENGE**\n\nTest your limits in 16 optional bonus levels that reward dedication and perseverance.\n{932722882196334}\n\ud83c\udfcb\ufe0f **FITNESS ADVENTURE FOR ALL**\n\nWith scalable exercises and adaptable gameplay, Fitness Fables welcomes beginners and challenges fitness enthusiasts.\n\n\u2728 **TRAVERSE THE WORLDS OF ALTERTERRA**\n\nTravel through stunning worlds like Terragon, Frostia, Ignis Prime, Aquarion, and Zypheron. Engage, and active.\n\nStep into Fitness Fables a place where movement fuels your story, challenges push you further! Are you ready?\n", "short_description": "\ud83c\udfcb\ufe0f FITNESS MEETS FANTASY IN VR\nStep into Fitness Fables, where workouts become epic adventures!\n\ud83d\udd25 FOR ALL FITNESS LEVELS\nStart at your pace and level up as you grow stronger.\n\ud83c\udfae STORY-DRIVEN QUESTS\nJoin the Magic Academy and save the realms through heroic workouts.\n\ud83d\udcaa FULL-BODY ENGAGEMENT\nBuild strength and stay energized with dynamic exercises.\n\ud83c\udfc6 TRACK YOUR PROGRESS\nEarn rewards, unlock achievements, and make fitness an epic journey!\nTurn your workouts into a magical journey!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immersion.games/en/game-privacy-policy-cn.html", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://www.fitnessfablesvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8984544191599464"}, "review_messages": []}]}, "cover_square_i
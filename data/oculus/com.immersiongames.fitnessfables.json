qIavCDHI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l-WpRyuVtIvf1o0hYv35fB3jSuwTaXOSeRdI4TFW0MA&oe=6A11CCF1"}, {"file_name": "Fitness Fables _Screen04.png", "id": "450863567726764", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75462959_450863571060097_160294925395243725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iMlOE7LZNYQ7kNvwFxxnyl&_nc_oc=AdpZBHhTgRXGGFFK1GKS3o-aPPuc6Sy810t6cHgp4b5o7-HT0_2TrOCM4CRI0sx78N4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Uh2u6-3DtN7HMPL5izDgoF64zVKuIHL2QvD6qstqng&oe=6A11CAF9"}, {"file_name": "Fitness Fables _Screen02.png", "id": "1767400787431601", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57566690_1767400794098267_2041132177250147872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8T9EY0GSe_kQ7kNvwG1zd0F&_nc_oc=Adrf6zUfuzSU7T6veBwlwig-B98WdpeQ7lxvN52hGkmIXWdOGfwiH9lU9WXGV7ljrmU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GwpwxQTP4YKEyLZrkXkJM-Tvm6FMWAvQYgit3p4yVxw&oe=6A11B92B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_B.png", "id": "2320134108364817", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/43997708_2320134111698150_6193331455269072673_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxVpiH9nh6QQ7kNvwFpflsR&_nc_oc=AdrcxMd2m3y5hY1e2Dd5LNu-Ar9jjvHRc0EbEf-7LzkTAbQlygbpxEBBZD7ZV-eWroA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nf22KjcA5ygePIFMTAGDITYgFTlPwEDN7WzGaFOcZGg&oe=6A11A627"}, "display_name": "Fitness Fables", "keywords": ["workout", "training", "combat", "fantasy", "Adventure"], "long_description": "Step into a world where fitness becomes an adventure. Fitness Fables turns your workouts into story-driven quests, combining fun challenges with beautiful, immersive environments. It\u2019s not just about staying active\u2014it\u2019s about enjoying a fitness journey.\n{2084049595368528}\n\ud83c\udfae **80 IMMERSIVE LEVELS AWAIT**\n\nDive into a magical journey with 80 levels, featuring 16 boss fights, 16 bonus challenges, and 48 varied traversal stages that keep you active and engaged.\n\n\ud83d\udd25 **24 HOURS OF GAMEPLAY**\n\nExperience up to 24 hours of workouts tailored to your fitness level, from light activity to intense challenges.\n\n\ud83d\udcaa **24 EXERCISES, FULL-BODY CHALLENGE**\n\nMaster exercises like Power Squats, Rope Swings, Sky Press, Battle Ropes, and much more to build strength, endurance, and coordination across different muscle groups.\n\n\u2694\ufe0f **INTENSE BOSS BATTLES**\n\nFace 16 intense bosses, blending fitness and fantasy with moves like Power Bow and Battle Drums to restore balance to Alterterra.\n\n\ud83c\udf0d **16 BONUS LEVELS FOR EXTRA CHALLENGE**\n\nTest your limits in 16 optional bonus levels that reward dedication and perseverance.\n{932722882196334}\n\ud83c\udfcb\ufe0f **FITNESS ADVENTURE FOR ALL**\n\nWith scalable exercises and adaptable gameplay, Fitness Fables welcomes beginners and challenges fitness enthusiasts.\n\n\u2728 **TRAVERSE THE WORLDS OF ALTERTERRA**\n\nTravel through stunning worlds like Terragon, Frostia, Ignis Prime, Aquarion, and Zypheron. Engage, and active.\n\nStep into Fitness Fables a place where movement fuels your story, challenges push you further! Are you ready?\n", "short_description": "\ud83c\udfcb\ufe0f FITNESS MEETS FANTASY IN VR\nStep into Fitness Fables, where workouts become epic adventures!\n\ud83d\udd25 FOR ALL FITNESS LEVELS\nStart at your pace and level up as you grow stronger.\n\ud83c\udfae STORY-DRIVEN QUESTS\nJoin the Magic Academy and save the realms through heroic workouts.\n\ud83d\udcaa FULL-BODY ENGAGEMENT\nBuild strength and stay energized with dynamic exercises.\n\ud83c\udfc6 TRACK YOUR PROGRESS\nEarn rewards, unlock achievements, and make fitness an epic journey!\nTurn your workouts into a magical journey!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games S.A.", "support_website_url": null, "website_url": "https://www.fitnessfablesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6807522875968284"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1526273554693435"}, {"status": "PUBLISHED", "id": "787518323849589"}, {"status": "PUBLISHED", "id": "685047414469460"}, {"status": "PUBLISHED", "id": "592763000222424"}, {"status": "PUBLISHED", "id": "1643412406257869"}]}, "baseline_offer": {"id": "1643412406257869"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757955600, "status": "PUBLISHED", "id": "787518323849589"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9392766264110586", "version": "1.0.1757"}, "id": "324574470524766", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6807522865968285", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9392766264110586"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3245744
_2681937929479496238_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tVcTrqondUQ7kNvwEl2wqe&_nc_oc=AdqtHUd7dpOKGX0TYhoCMifzmqxPVdc9b_Yr8_awl5Vy2Y8u2zSEr6vzQ7cFhav1J30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLj92JP8ESRZtub2hWg59LCZCgq5xsyIcP7KOsjB9U2g&oe=6AFDBDBC"}, {"file_name": "screenshot_3.png", "id": "1446374884041000", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1446374887374333_8807225425388230597_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCPjQhPr6BEQ7kNvwGyZV_7&_nc_oc=Adr8Jql5At68n3YlE4YMkPZ2tc_adzQlfjJA10jP_2d1rDytJwGhAo5noSJudgqk3A4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5rd_UPJG6gzNwHSnN5eQF2n7uCnSCCW77o065WCYlfA&oe=6AFDBBA1"}, {"file_name": "screenshot_5.png", "id": "1398221611884154", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1398221618550820_8709774633021050920_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54kRZQQ5DJ4Q7kNvwFNNQEL&_nc_oc=AdrZcE_tdVEJXRfcOcjxMpXPETw740GP-IPisP-ceFPJLSJfO0z6-EzjTPA8nPoddes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA5xZ0Jc4cXI5jSMdhNwdRoUTWmOgx-DrIomV4cpuDqQ&oe=6AFDB87A"}, {"file_name": "screenshot_2.png", "id": "986012894519548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596106838_986012897852881_7280261161476975052_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4GGQbi4DU8Q7kNvwHZKqmG&_nc_oc=AdpJDBSrzrN93xG3c2kg9qrF1TCnndsqIRMxfzVdA8cws77uAZHm0svcc1lCyjzR7aU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyvYpG_ekkdT1EL9hurKXC251Sk9XuEy2YipkBCM0OeA&oe=6AFDBB78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1725225721896948", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_1725225725230281_5511710360584869104_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWuxxxvaAfgQ7kNvwH_tw_r&_nc_oc=Adq55se1pgJupX21bfjeendGYNPDkVlBZA1PLFCJjwbPhxEE3zCVbEhBW0U3qfLGrrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlnlztw3qRpDbwymdpPwbMk7T58TszsfQco_v1ZOLsKg&oe=6AFDD74E"}, "display_name": "Hollowdeep", "keywords": ["dungeon", "fantasy", "adventure", "sword", "rpg"], "long_description": "Hollowdeep is a single-player VR dungeon crawler where the heroes you rescue become your party.\n\nRESCUE YOUR PARTY\nFive adventurers are locked deep below the Lantern Guild. Defeat each floor's Jailer, take his key, open the cell, and the hero joins you and hands you their weapon: dagger, bow, axe or staff.\n\nFIGHT SIDE BY SIDE\nYour companions follow you down every stair and fight beside you. Swing your sword for real and block a skeleton's blade with your own.\n\nSIXTEEN FLOORS\nThe Old Cellars, the Bone Galleries, the Ember Halls and the Throne of Bones - then Act 2: twelve deeper floors through the Sunken Crypt, the Ember Forge and the Hollow Heart, down to the Lich.\n\nWORK AS A TEAM\nStand on the runes together, hold the circle while the Mage breaks a seal, let the Rogue pick the lock. Wardens, a Bone Colossus and the Lich guard the way.\n\nMORE TO FIND\nSmash barrels, beware of mimic chests, and gather twelve Lantern Shards to forge the Lantern Blade. Spend your gold at the Guild on potions and team upgrades.\n\nMADE FOR VR\nA glowing path always shows where to go next. Smooth stick walking, snap turning, a jump on A and a left or right sword hand.\n\nControls: left stick to walk (click to run), right stick to snap turn, A jumps, B switches weapons, X drinks a potion, Y shows the wrist board, left MENU opens the menu.", "short_description": "The Lantern Guild went down into the dark and never came back. Take up the sword, beat the Jailers, free five lost adventurers and they join your party - a Rogue, a Ranger, a Barbarian, a Mage and a Knight who fight at your side. Lead them through sixteen floors of 
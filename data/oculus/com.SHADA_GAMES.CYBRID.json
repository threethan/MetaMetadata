_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeLkLrZxHSYQ7kNvwEbmef-&_nc_oc=AdpTrl77H-R8nwH0WlPwJ94SyAghIb2dtOF5DUEHKRmn4F8aWAzsU_dd5JXaq9G0i3Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iWfJQXlG9W3_vU6x21TedvTdwxJNqPce-4FwDNkgTUg&oe=6A0F048A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF65LCQYcMsQ7kNvwG4NuXg&_nc_oc=AdreSCGT8OhrEB8Mcqaeln4DaWshgFrYEpqADd96Q09v4qiK5Dv1R_eQI-P_m0DOsxM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jBzOiK7p_n8gEMSya1RH0tVvafm1tALnSbvB2f5dYsw&oe=6A0F06BC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw2q9Ekf74kQ7kNvwFKsQ0K&_nc_oc=AdrfhuLkzUcCfHEMA0dQ5pHRDEpo5c9q8n-BDiQNX9LEYcDIkaJkeiDay6XyHgAuYqs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Lz8eMV7Ie5zxLeuTNfzWIV9ZeuXgFQEXYX20I1Pn4Q&oe=6A0F23DA"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-9T31zpmoIQ7kNvwEIu6uP&_nc_oc=Adoi6F0u70UG0vFVTxVhwEcPKF_I3HUyN3uKCzG5_ChkyuzalfWwyxk6BuBYjPpyfsA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pNOMjsN9TeeiKCDrLLPzMCTPygzRrDJSEnCm2n-P_RQ&oe=6A0F28D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwwzAVrhaIAQ7kNvwHf3QuI&_nc_oc=AdrtzaE1On5PHkD3FdYLqqu3XJGZUGrIqAPeo_lBZk3dKyJpSI98Eo9NmhQKz1BoCY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kpNAmguklOiPjRWGyoT9ZVC7TRYB9r4JtSfdC2hH_kg&oe=6A0EFA6F"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
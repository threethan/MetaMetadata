_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEGvlNxW9sMQ7kNvwHtIq_g&_nc_oc=AdoVtFpzjSTAHoJxPMyIZm7_oToytjQt-Krf-jW6NG5Wi3jerS71ZBHU-Z8yCMD9EUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y5oA2YVcESx8PfSNBS3qSu5SAhi2sWLyVUqFiQJrr2Q&oe=6A086D0A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxJiflEfYgkQ7kNvwE-TWU-&_nc_oc=Adq4vXJiuMu6_CbGJk-DGXJBcmYTdcCOIqQ_9Lrkz5lD9fLs4JKfQQPW0KlxGsEH1K4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NxoMRwbFdPbi1mWR3ZAPwn5DzhPIDckg6zA7sT8eH_Q&oe=6A086F3C"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se5MqSuTnvEQ7kNvwEWjbif&_nc_oc=AdophZB8BJrYohmeXsGQd_-ZJz6BHU4xFcASGvXkMdfla1-SM25QoukiHZ26D1nHlr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GQDQCMxvsXxiaCEg75jg0mgMCMNlR_box0whyMVqelQ&oe=6A088C5A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B21XJyS3O-4Q7kNvwHSiHbZ&_nc_oc=AdqFn1dNGnLWkY8gApzznJSUXqj8sJTyqeozq_mNtr1cVtAVJ0QIAvicCWQfMYgb-SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yLc2liy-30vX0mGI4p2_fsT8nyOswydTgQCxcTVKnzg&oe=6A085915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMSPsLsogMQQ7kNvwHhkELd&_nc_oc=AdrNhh0Sg6sYbZbd8_gUkBaoIJEBQEvpHP5YCTADMeg3e-dchOy6CkOXvXtm4p-bb0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50qSmRuxgJ5KqiPbiMOBPZtj0cRqJhJV32Sw-hXgWYVw&oe=6A0862EF"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcQn97sm2_IQ7kNvwGHCgcq&_nc_oc=AdrelWaYJa7byILdtv0X26u7ocEI8gfMVLNAZYhpWnl8n8CtqW1bmUElaHVRNa2etWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QEz7PIog3lOiiLzayHnNVL2I00Jt7Sw-ToE9Xv89yLg&oe=6A00840A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OvH8NbfGQAQ7kNvwGiJExC&_nc_oc=AdoSxG1J7FU78EMM0FZHbZLWsktkjFpo5NNodbMuYUAYd1Um54e3xwbqZvkGVgf34cU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X_MF4mLptOUtI9Ju3nziJIsoXcoPViZhAnbzjxnN-sw&oe=6A00863C"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIZl4JNPbSUQ7kNvwEkAHBq&_nc_oc=AdoDi_SSM-2JIGzbuYoUdQJDJyq3b8PNLGox3KAyF5BKhvofPFqRwhga_Q3Csiyqp9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50QGmrOM7WI1UFaVX5aQ4eLsHb7OXktABkBsXGxf57eQ&oe=6A00A35A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnE8ZV4WhToQ7kNvwFOS3KA&_nc_oc=Adrlo3n7TUfg9qKS1TLAGPYLwhj9LudhSq29Xw4zfYJ8-2fAMgV9qLzRWtePVMsyfHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z67mLbiuoJMZMsAtDgii2Cu3j5m0spIi8QjYbZnIP0A&oe=6A007015"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JjOw0iPBAAQ7kNvwHHbGSg&_nc_oc=AdolfSy_hig-0kwtG6IFKMeWvKImNWiHTIkb7xyRcySXdTKVKUSZ3ru2s4q9tV5JKJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af617AixSJrLIU9VvWseDqXhU4xzvs8CWAyvxrocRFqKCA&oe=6A0079EF"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
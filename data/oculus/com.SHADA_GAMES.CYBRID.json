_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1_T4bpNqEUQ7kNvwFjXbp2&_nc_oc=Ado3G1uySAAcUnaSsmm4xOa1W_jF01aQVGVIYRzSDRTuhZc186AJ6lJFO_-m8RIhPY4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RA8_VtK4OlXHIqYowZlnmMHgjV8wA9cKFosIwz3unag&oe=6A19908A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIplCTx67aIQ7kNvwHFC5nI&_nc_oc=AdqNpcJvSa5yFjA7iDB4_Dropu9hkmZe3YupBHJQlCxF0gq8_tGO93PpluZ4s8CpFoU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65Qxvl06qQbJpee-Vdj3m8a6YWK9IPbXRNE-hUEiDl2g&oe=6A1992BC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIgv5pF4skgQ7kNvwGxELPc&_nc_oc=AdqFMiBoXZlzoWALUBjhhIFVdPJJvHZv_JriySnmTJqDDV-XHxgHyhiFpj_ZLNONK5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60zHdvvm-hCZdNHtzdOPqDcBTa1S61P53d2s5gEfltJg&oe=6A19AFDA"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKtA8_rfLccQ7kNvwGCjnaw&_nc_oc=AdpbtHXS0jPAB7pcGuGS4SQhG2c7KwkuY4qshiC7nIx0jkvaY2xu3RVRmJdKYB4YSi8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bsg3RTMhEsogHB9Nop3bSqM2EsQSJfZYfxj8s5VuibQ&oe=6A19B4D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o357MDzbYWwQ7kNvwFFryHF&_nc_oc=Adrj3564bYd30kyuoYux49OKpn3_oa4j8LYeaSE19vk4JH08uYPAPiUV3epRtmzJ4C0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6glQA6sv0Xs4MCXeqSyps1Yyzw5JAEu-Wnbu4zEd7enw&oe=6A19BEAF"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
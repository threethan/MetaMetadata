_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwM5o24naIkQ7kNvwEKb_eT&_nc_oc=Adrbwg5qrUXBD6tE0W-bRZcl41aVhYm5Be-WHzmJS7RH9NRR2AESjk-adkh2i_1KJ5I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UMKY2-NQju_UYjNdQ0avtz7OX54_5_0_YXDsBvsasrw&oe=6A0C618A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFVv4YmYcQsQ7kNvwGPzL7E&_nc_oc=AdrxNW-mYJANPfKVrK-UkH-9vP1buMjYzWXjskU42of3dDdA9JVGAX3e2a-ecWHvxr0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qI7d48reXvs_673sSz8JFMfYi5lw69lgzWIW1XROvAg&oe=6A0C63BC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jAH9c_WM2UQ7kNvwFPrOtF&_nc_oc=Adpo6JHDvgPLGqAeNtMI75kLX0pE_RXeEefUXxgPT69fwIwNEvn6eS08PkUKx0Oxvns&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jWPh2uTJn8xJJhdXbwbEse9E_mwtmJzcDtre-zgfZnA&oe=6A0C80DA"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BzMj0mFTCkQ7kNvwHdoqKM&_nc_oc=AdqtrXJFAfO623Aiq9Lh2pWC9JVroYqDSPFdIe0rwFSLitUiqXS_X0tZ97wUNNfNMS8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o6R25xpGrSdpI9A5RrvyhmoI0id1h0k_DaBNEkQ_BFQ&oe=6A0C85D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMhtdRYTojcQ7kNvwEN_Z7n&_nc_oc=Adpy5I8UxHlqrf5Q6AXuXtrwZLITnLn3jTJmQCga7RHr6PtdoLDWLhXdKY-HhYphswE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ml2Q7-mu_nba1UHmv5dBO7tj-3NjSVJ-QuByJ2Na-RA&oe=6A0C576F"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
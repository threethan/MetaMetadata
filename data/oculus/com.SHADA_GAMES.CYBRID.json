_G610VOCwadAsF8qk61B_upUrWK3Gs-ZkVdaiu-GoUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHoKLDUEv8cZ9UJ-T31IY9n6des3vfTUL9YOxV-f_bhg&oe=69B55E8A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miiIa8RbJosQ7kNvwE8_TGm&_nc_oc=AdkPu_GwZob-7Mm54BWdnIM5Il47CfTmZ8b9Mje7nFde-9PpDcue9MNljQW2_gBuqXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkMs0j95uqlNDAw0v5cOyA1_tNkDggPJQMbbg5IsFC8w&oe=69B560BC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEMMdTCFHrYQ7kNvwHHnzeB&_nc_oc=AdlJ77yhSKrmhd9l1S2QCDBEc6HNAdXS14pyru6_z7gHcRbq0LxeSlWqD2aXmMymsMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYRwr2veg6yOXu2udGc5zv8fxNDtnOfSZ4QMouxFY4Ww&oe=69B5459A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrgDWnu4qI0Q7kNvwE6p928&_nc_oc=AdlIHhotVfB9mxjJJUdH6kNesM6-0Rg7q_sXXCSiVpCG5QPRIlkDILDtotTfGHSvsME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5Tx5oYsAM_IdInbX3RUT_ZdMmDMLRUIwbQnbsb6DJ2w&oe=69B54A95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaQuestTrailer_01.png", "id": "4282387205323425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310868_4282387208656758_2460755889903371770_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx1QEgtlQC0Q7kNvwEPUSSP&_nc_oc=AdmsBChliqDLlXc3817Zw7YoCwGJhLPtYvT2_OCzAhqcpIuwrCxkkesqWjqffr9rHZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHgCmfH8tcl9c66GQ-r2yaKkoUR251CkQCuV5xJCuxew&oe=69B56772"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
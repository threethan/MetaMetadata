_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcQn97sm2_IQ7kNvwH897ti&_nc_oc=Adp7AIvYlZ9w15M47x0ThglXsLrWFwYBrwfqIBz-R7gYLS9zv-HYHbj6-Cz_31xAWjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af573m0IEMRybIlWwNKXZBFQPOsgi-bi4T3iDFJLtZMfpQ&oe=6A01D58A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoKiuMOQx98Q7kNvwEDWYq2&_nc_oc=AdpgBpC5EpSRk8st4TCQa6lIbfR7xrPrc6nCjbf76eyiXiyaiko1bbf32gwSVGaGk_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78cPofOsjlA9OptBe2ltnsQIjEnlrY5THB5hd8jnVYJA&oe=6A01D7BC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKI9MyhR5cYQ7kNvwEtSI7L&_nc_oc=AdoS92LU5ixPS1BNsuUZVuzmtk6AhUUx9fr1UB5AzyGG1ZPbgSthSf2gmjBFG6SJ798&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hTICY36x24PzNxu-oSGC4FaIYFcmYppNUxQVZWeJ92A&oe=6A01F4DA"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnE8ZV4WhToQ7kNvwF9S-Pq&_nc_oc=AdpOlOe75QcYMI1MDfZgl0ihfTIASmOHw1rZKPwFFvpvI1Yh0VRayEjDC1DxvWvIo2M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YJ83V0NziLwNG30yjFgXp-G-UnKpxdJZssHe8XqyWCA&oe=6A01C195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2PMVdJeTJMQ7kNvwEfK4B7&_nc_oc=AdpKkOIhHNoKiLtPRouiktvJ4o2GwwFxRByeyZnmDgfBVOltE6FsQoBJsRFBQZV1BRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NEELEP9NAd4wX8x97BK3DbDM2SVHzk-g_jZ9Cd8lCwA&oe=6A01CB6F"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ52-N1N4XoQ7kNvwGMwwg_&_nc_oc=Adp5z3G2761PgkIT4tAp8J7h1z0r9AfmGk7HJ6zNIp3GCisQHH3Ua4Pgjo4E_2QilHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zq3ip2dhbY8aSmP5cU0Q0TGBPTC5_FjIzchIXE3lgFQ&oe=6A1D850A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQzO_5iJeHAQ7kNvwGG4X5_&_nc_oc=AdqXooTxUNulZPnqAfndv608sFUgu5bhNWpsY9Php9dXC6YdclpqdmhZ7cFnAsorqwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AIPOHMoCxIg1fmIsiscYd9mlqMwxtlJz47Tr2ikK4yw&oe=6A1D873C"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n798mDrvawQ7kNvwFC-lA0&_nc_oc=AdotTPePG_nVfXftMIPWFZyvyb7DmR6eNdLFpQqrvmvWJ2RIqjFPfnRMn8rsKzdC-lc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78KB8RnoPUkCV2FukxmPOa4psUjm5___Nx4VqX-uCQbA&oe=6A1DA45A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67FR2_30ZCoQ7kNvwFMIdLL&_nc_oc=AdoA6pgceLQ8Q6c_ZD3KbBRGpAHip8baUwovZxB4DE8m9FXY5PUv-bQmCI2S0T9ITMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ICMn9zEnt8bevIHHE0uH9gmjNR1YNLpFKSEUT0qATrA&oe=6A1DA955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4JKmzU9yAUQ7kNvwFzFs40&_nc_oc=Adq0vA55OZLPEdX7yiVzzif0ix6oQkpUJrJ8Hs0EvJ3dcSsNqKnHQSNYbG_tVTU2AqI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-9reIDfXa4-TdO5JbiuYstfRUkeHkR_KqmlZSk6kn2w&oe=6A1D7AEF"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
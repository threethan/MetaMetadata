22931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szN_zPJ2QdgQ7kNvwEKHKCM&_nc_oc=AdoFe3Ix8lUVdrDYE9A8U_VTdJWEQdYLXk315wWdWXQ-zfXFRJ1aNgYjESKELWiEbXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af396WKP5EeY8JbHvjCR2YdrsMr5U6bgGSy7XzVMIwvoPg&oe=69F0B20A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HQ4SoflVMEQ7kNvwHvLLx4&_nc_oc=AdowAsP0R5wJ1lqF9qpat15e87tVze6zhNbQXdU_u3y8uZJQ08zunyUnA2TYEQggq9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af11-wrToB00R6ZNXLGgd-uDg3BEVGqFPqI5o07veJAzLg&oe=69F0B43C"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2e9PDy0e2qoQ7kNvwGQypOk&_nc_oc=AdrmaKEGPj4EGejqFbGJRM0ZJwqOAIeTMrKBGp79Agru2MryNOy6h0AbECUFeJAmNfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3QV79TeB4eS0SfxqakrGwFvebrKa9vmt56CsEdMbtiiA&oe=69F0D15A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4B3QQMGI3sQ7kNvwFwpPEm&_nc_oc=AdrLYIGGJzEmips_c22MLF5kX1MtAE6osKB4zAhJtV7fDItK7epMQY3b7yvE65Tu6RU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af35QDdSqIYHr6BTfXROYf3kF32l1hfxzDmsFpUTIZFg-w&oe=69F09E15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl6EJ6Xy6gEQ7kNvwFxqkro&_nc_oc=AdqBvdhBt3OLllu7SFvrme1_BcmZvSM1lULsUDD8RKIhrd3O_LpeDr0rz8YhHYSmNIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2K_da4WA1nLsWeu60gj4pk-PaeFu_CeXxKVpyRRL_PsA&oe=69F0A7EF"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating":
_MQSc_02.png", "id": "2123631001380570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622931_2123631004713903_7586332272968938634_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16g3TdIpMz0Q7kNvwEHVben&_nc_oc=AdpPabu9JToKU8wsCz1IHOE_Xu4rF7n1qlhAUzcjFMXH2X1XdwdlCAY1EP6QVvY9fac&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gv5uPh5LCGloBYUeqA625Ez4Wsx0AF__HG7x157fxDw&oe=6A241C8A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI5YxbiswxAQ7kNvwHCj112&_nc_oc=AdpTXGbhJ8iBEIDugaIMDJCSj8_f5_01Jsd65viuapMvb_udCWQMeWYbx1YVbnRb_VM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_dbcMJIOayk4s9DRqjt0it_HHOct3Ax1F9KKrJTXdbA&oe=6A241EBC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi_-pJSt-DMQ7kNvwFlw9KF&_nc_oc=AdryKFyKw_PI2VKyC8L-WAHZBNGl2S8zcYh-LrO4qckL18_fOvoFslccE9a8iqUarM8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uk0ZfF0M_UHQpxoGo1QjCFglwBK9nOP48Nnynbd_cMQ&oe=6A243BDA"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbeL8q_CGWIQ7kNvwFHX9nR&_nc_oc=AdonTEQqB92MkTo-2bdLrvqs2JpV3rUUtxm4baUs95GxsFFGWI6dhpzLN2xJS52Pu98&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C8gcDe86W7G5MJV_MmEnBFL39kDTtXmSjbMbix8IlPw&oe=6A2440D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQS_0993.png", "id": "4275862849295055", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821682_4275862855961721_3485820925442969898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6oFNlq8xBAQ7kNvwGT4Ikh&_nc_oc=AdrdpcyfXU2jLQ6vKtgoUfDJVZ6h4GqTw80Sc2qTsreGVHMoiBXY0EElcj_9AOZGqpc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CjuBrmHBrNrfsUMWKyJQO1I7DXFI0sT6oY6wzWWK7XQ&oe=6A24126F"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name":
p14B-w&oe=69CD198A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTJzFM1k__4Q7kNvwE5PRjy&_nc_oc=AdrcKBKBbTsqvs0AY1V0V8d2S9U2TA1itTgFopOsc_Qf68VYji5iACe4OmQzAjBEpxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSGDhke1ZtXDv9x-tGJxONTnLTLe2goQz9FER0ak1bKA&oe=69CD1BBC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIU0vjnSD_IQ7kNvwGTazBn&_nc_oc=AdrFuiEx0B8yjCOeRuoNIX1Bqby2Xe8DfkYJ93HtJDgx_44jxgQvCi5PUgbxtdYzjZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_8h5RDnZlcAV9PMsc9Qqgwk6ij5hbwWsMb-e20POXtQ&oe=69CD009A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IB7iFHIiNwQ7kNvwGp0HLz&_nc_oc=AdolRghBMT7lo_oBmVAVfjpialZwfhB6IRwOv7FQD_oQijQc1HIHTmWwdPRVq93w-aA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrMXx4ZpW-HrMzLuihV9-afl3Kbi5t-9fpUBsLvfiVzA&oe=69CD0595"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQV_0992.png", "id": "1162421445414028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1162421448747361_1962121518188567718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3g7Uz5bx2AQ7kNvwE3LAB3&_nc_oc=Ado9RiDxZGInsEXO2oqIjgNE9J91GGdHudtF8pUgy2-e8JD5ncoZKv7yww02STVYGzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz319uDG8DoujCIUfC7QhX9pFCzMUQ5oIIlIupogyoBJA&oe=69CD106C"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id":
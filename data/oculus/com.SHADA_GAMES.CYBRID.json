xwNtNw&oe=69C5308A"}, {"file_name": "CYBRID_MQSc_03.png", "id": "714601991469389", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gRZOuMwHvoQ7kNvwF0YjrE&_nc_oc=AdqoipeF-HjSbXI1fb8ZR0E3e5fJFDo4JM35_2QLPVvqk2AAnwoHP2xcflh3XC4iPUA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx_V65kjaMeifY6Jo33dnDxPq-P-9CJ9P2lvErgHSaJw&oe=69C532BC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbQx9RSn_8wQ7kNvwECSW-a&_nc_oc=Adr6lLxNoemhLwlvbjaM_Nh9alJ0NAR5JjY_LTVV2aXgTebCgLaG88O223C-xzoDvc8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_F2eD2H_vzJStTInEIp85ytkGaK4MEJoj3PIIrpGBkA&oe=69C5179A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9rf1zQu5EQQ7kNvwFrGVzH&_nc_oc=AdqcccBEPhHhJHLR9SRm3rqYQPPnpeMOHrhBFes_sgrvfp_Cb-9_Mu1_OV_aYl5skUg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrqfQU2zhZO2eLwaPeTFhcWzJACwL9VpgMkDFpAZLKUg&oe=69C51C95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQV_0992.png", "id": "1162421445414028", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823351_1162421448747361_1962121518188567718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj7P9EX6mKcQ7kNvwEmCwIX&_nc_oc=Adp5HYDSZ2_ktB6diDIQgFowsxtd3QBCfrjmHtt2F7-0zlkF9qp7bdf2VNUk7_XKz6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA_CYxJqINpbyWp_6M47TJx6uoFIS2PzYNABm0tRDxcw&oe=69C5276C"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id":
uluscdn.com/v/t64.5771-25/499627193_714601994802722_4550155810548573737_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxJDbwANOJYQ7kNvwGNgANH&_nc_oc=AdlSoOG11dfTnii80tzfMa2ULwhHcHZMJjIS9HSQkCl-wv--kQ-w4bZZiMMKCMcxbOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftfU4rIca8aKk_eQMdBhgZIvQmMWsfGcIRhaK0xOLwWhA&oe=69985FBC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2116174532205649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299715_2116174538872315_4274879067373610059_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8oIQNuRRUYQ7kNvwHFKJJ_&_nc_oc=AdnZ7LexSISg7qq6vJJkUEtCN8HVqzn_wBdMj6i2iWkI5dYtLq5QGjoefTr7tosZeYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRIDfM8kGX7-vzo6pY66o5lxin18t1sdeSytXgFOmJGA&oe=6998449A"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1086629629501634", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1086629632834967_5810593074052800085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTc2uMYVv6YQ7kNvwHZ4SAp&_nc_oc=AdnxkHcGiG2Sgc7z1O_DXIym8mI9C2s-WrMzF_DAqcZDh28FEwt-drh4ilIxE34R9fY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvcT0RwdPn32_3uZ2-b8p3Wg9OEQRzToSrnCnF8_4A8Xg&oe=69984995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NewDifficultyHardQV_0992.png", "id": "1162421445414028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1162421448747361_1962121518188567718_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrfK8VHyMvcQ7kNvwFuVGGw&_nc_oc=Admaer-8vKCzzYdiMJXtAK5j6PtTHRTEhAJabcPeRra9x7VtjcYi09AG45TrwW-98oE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afvwdc5Tn6jGtfugu55dc99PnhojXxvnXciJGz76Sr0PSw&oe=6998546C"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat", "Cyberpunk"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
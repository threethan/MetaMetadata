ailer": null, "video_trailer_thumbnail": {"file_name": "MetaQuestTrailer_01.png", "id": "4282387205323425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499310868_4282387208656758_2460755889903371770_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58V0juDxb3YQ7kNvwH9TgvI&_nc_oc=AdqO2iI-_lPRW8bwvH14F7WAO4lC_aIAvRCMG_tEBIVXz_OKcxl7khCrIsGrJMUzxLE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o_h1mjMlFxO8uMVeRT1VKdtaV5sbD1gVCaFT26frg5A&oe=6A0F0D72"}, "display_name": "CYBRID", "keywords": ["cyber", "rhythm", "action", "beat"], "long_description": "CYBRID is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n{516013861570008}\n\n**Gameplay**\n\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n**Feature**\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n**From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24222970277328722"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1669564010913264"}, {"status": "PUBLISHED", "id": "1594618131770558"}, {"status": "PUBLISHED", "id": "1430962315424106"}, {"status": "PUBLISHED", "id": "1386368663284704"}, {"status": "PUBLISHED", "id": "721400407480356"}, {"status": "PUBLISHED", "id": "1358377598641070"}, {"status": "PUBLISHED", "id": "634466332989179"}, {"status": "PUBLISHED", "id": "752304061115778"}, {"status": "PUBLISHED", "id": "750396737596532"}, {"status": "PENDING", "id": "1811208469806623"}]}, "baseline_offer": {"id": "750396737596532"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1669564010913264"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26344469145178814", "version": "0.9.9.3"}, "id": "1281453996767
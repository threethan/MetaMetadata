238", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223485_966602534494571_26680306285025171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt8z2rh8vOEQ7kNvwGoO_UG&_nc_oc=Adoo6qZNpeNUAaSbDYySTqR46xuIQ_BkOrqBtKxZjewFk96B3e9TmNG2a7S4kbS-wXU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af868KXY9nmUNMQ-kQATg2J-1V7WwJxp-6IM5U9P2Cu6IA&oe=6A2FFDE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "palanAR for Quest", "keywords": [], "long_description": "You can experience AR at Quest with the AR creation tool \"palanAR\" !\n\u25c6You can experience AR!\nYou can enjoy AR experience with pass-through.\n\u25c6 Hand-tracking supported!\nHand tracking is also supported, allowing you to experience without holding the controller. (Pinch-in with the controller in place to switch between the two.)\n\nHow to use\n1. Search for the id anounced by the creator!\n2. Experience AR!\n3. The AR you have experienced will be saved in your history, so you can experience it as many times as you like!\n\n\u203bYou cannot experience AR creation with this application.", "short_description": "You can experience AR at Quest with the AR creation tool \"palanAR\" !\nYou can enjoy AR experience with pass-through. Hand tracking is also supported."}]}, "developer_name": null, "developer_privacy_policy_url": "https://palanar.com/policy", "developer_terms_of_service_url": null, "publisher_name": "palan", "support_website_url": "https://palanar.com/contact", "website_url": "https://palanar.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
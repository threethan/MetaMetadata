4R6m0Q7kNvwEuKbRP&_nc_oc=AdrDpSZ7YJ21GhmF2MZwX0MIiEuryq3cv_WYkiJbnYkmLRxy4hZqBcDaOMC023TJxnQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRmMjON_q3iLnFylSXoLX2u2xdXCadl-5Oplgd994jOQ&oe=6AFB2DA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PSG_2560x1440.png", "id": "1082152944447585", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/596061819_1082152947780918_1164219238277960821_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22Lc0DE4AEQQ7kNvwGBTuxr&_nc_oc=AdqM3H2rHfbtMVJjVPDjth7BOxJOIwEn4YsshsiUU2KJHpzxZVhTPOn5v8F2NDAeolE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGjhFOvVDNFGewEVG1o8kFu4J1s6-dhBE1NFFyksO8qw&oe=6AFB2B28"}, "display_name": "Prison Security Guard", "keywords": ["sandbox", "prison", "guard", "comedy", "humor"], "long_description": "                                                                                                                                                                            \n                                                                                                                                                                             \n\n{1078345568303643}\n\n# Welcome to the Intake Station\n\n**Prison Security Guard is a VR job simulator and hilarious comic sandbox** where you take on the role of a guard processing a highly unpredictable, cartoonish intake line\n\n**Inspect** pockets, search belongings, sanitize inmates, and correct their uniforms or hair before sending them through the final gate\n\n**Run a flawless, professional operation**  to maximize your score, or tear up the rulebook and unleash complete sandbox chaos\u2014in this prison, mistakes only make things funnier!\n\n{1758547102077781}\n\n# Key Features\n\n- **Physically search** pockets, shave overgrown beards, hose off dripping mud, and use a laser to erase banned tattoos\n\n- **Every Inmate is a Toy**: Interact with characters designed for physical comedy\n\n- **Stress-Free \"No Game Over\" Play:** Focus on the fun\n\n- **Slapstick Sandbox Arsenal**: Earn Guard Tokens on your shift to unlock purely optional, chaotic toys\n\n# Join Our Community!\nWant to share your funniest VR clips, get exclusive development updates, or chat directly with the creators?\n\n\ud83d\udc7e Join the official Prison Security Guard Discord: **https://discord.com/invite/etermaxrstudio**\n", "short_description": "Step into the boots of the only sensible guard in an absurd VR prison intake!\n- Inspect, clean, and prepare a line of cartoonish inmates using highly tactile physical tools\n\n- Confiscate bizarre contraband, or cause absolute chaos with an arsenal of slapstick toys\n\n- Follow security protocols to the letter or break every single rule\u2014there is no game over in this hilarious comic sandbox!"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1129901046240075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/4993123
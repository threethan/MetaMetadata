Dam26RIdgmJ26V-7-ELAz7MX17Hf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUWx5rrH-AfZ13_a8T9wbxI2rdlpCjJf0UgmIOszrxPQA&oe=6B0EFBFE"}, {"file_name": "Captura04.png", "id": "2248272502694474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_2248272506027807_3764608963423725535_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paeBWPzmLgQQ7kNvwEbxox-&_nc_oc=AdqEBZbShh6SYxJOSzJTCtXrm4lY_PunFu7xYWj5o24mC-OFdJdPucRwnBClxJFIy6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzFXp586IX4O1BMdWRlOCIg-Qljgss8_QvyrP6BA6FeA&oe=6B0F01C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prison Security Guard", "keywords": ["sandbox", "prison", "guard", "comedy", "humor"], "long_description": "# Welcome to the Intake Station\n\n**Prison Security Guard is a VR job simulator and hilarious comic sandbox** where you take on the role of a guard processing a highly unpredictable, cartoonish intake line\n\n**Inspect** pockets, search belongings, sanitize inmates, and correct their uniforms or hair before sending them through the final gate\n\n**Run a flawless, professional operation**  to maximize your score, or tear up the rulebook and unleash complete sandbox chaos\u2014in this prison, mistakes only make things funnier!\n\n# Key Features\n\n- **Physically search** pockets, shave overgrown beards, hose off dripping mud, and use a laser to erase banned tattoos\n\n- **Every Inmate is a Toy**: Interact with characters designed for physical comedy\n\n- **Stress-Free \"No Game Over\" Play:** Focus on the fun\n\n- **Slapstick Sandbox Arsenal**: Earn Guard Tokens on your shift to unlock purely optional, chaotic toys\n\n# Join Our Community!\nWant to share your funniest VR clips, get exclusive development updates, or chat directly with the creators?\n\n\ud83d\udc7e Join the official Prison Security Guard Discord: **https://discord.com/invite/etermaxrstudio**", "short_description": "Step into the boots of the only sensible guard in an absurd VR prison intake!\n- Inspect, clean, and prepare a line of cartoonish inmates using highly tactile physical tools\n\n- Confiscate bizarre contraband, or cause absolute chaos with an arsenal of slapstick toys\n\n- Follow security protocols to the letter or break every single rule\u2014there is no game over in this hilarious comic sandbox!"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1042694664960714"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "956930037147208"}, {"status": "PUBLISHED", "id": "2161552058069616"}]}, "baseline_offer": {"id": "2161552058069616"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "956930037147208"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1143826104847569", "version": "0.7.0"}, "id": "1058236670011662", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fals
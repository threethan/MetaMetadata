5/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUbnzUKagUIQ7kNvwFrFmVX&_nc_oc=AdoarLqVjOA6L0v0tVZbPhixZZj0udS0Y_gvlhvGyhJPJt-fDYuYYEEyr6vh3HXMuB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I_NIe2_9oEcvwt6u21NPdF7SfpY1w2eX19VRNR-EN4g&oe=6A1EDF9D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFs-4dTdeZ4Q7kNvwERpnE9&_nc_oc=AdrJp_vO9cTenzGLTplC2bUwqL32c2nF6uE6_g0CoGsqnK5PZhr8JzjiIHKdcW3Cn1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QfVFqeqkctK4M6eAfVBcvMofm_11nWrHqLSyhyYiRtQ&oe=6A1ED241"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GdDby_l7SkQ7kNvwHL03gP&_nc_oc=AdrNZ_5oHcSLvSUltqb1jyPHlkVllPY2fTUxqeuaT2WpfxTcnJ1T2SjofPRxFt0usyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tnss2boqFhPdVGn33Obqc5jdMQPVmArH7IoU9BebOWw&oe=6A1EE971"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7IZD2Apu7kQ7kNvwG_hB_N&_nc_oc=Adowmec3dEdwY7Ms1AIAX8jhNBDKI0zaUAkffI0zfpJ6XgVE9wPZJLgNLmFz9KA062c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xn1wQ9xJgqfLIr1yWitH-02yDir4H0Jo_AnmVe_sYFA&oe=6A1EEE20"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6NmuTt-7H0Q7kNvwEh4XaK&_nc_oc=Adp6GUIKhBnYkfjephd6yuzxPC8DgWx-dsYGMdxJCfSfybRNDlQQ4mJC3tkIqs_9pIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VNyP_r7VRliKSu5d_kYs37cfE6sPm49BB5Z2N8i8QIQ&oe=6A1EFFCC"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47HUsbi7nFsQ7kNvwHeUk1s&_nc_oc=Ado20g5eVXjCNuHY05o1WksU18TDuHkyPXnvAEqowv2JArV93oNk7uiMO9RQJQYMiak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YHk5wVX0Cl-hAvW26eo0g6wxI1DdSmTPEdYDqZTZoNg&oe=6A1EEF7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302770_1652435462675279_5195998813947567288_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPiTegRiKOEQ7kNvwEEyPGH&_nc_oc=AdrKeTaAky_vILP6WNZGyjEFhnl031g09KFzNzdzV0dz7vWtjJVS7HsByI9TfgKGat8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54WGDX0IGp_uF4lQlWW0z3NMhMkf7pGiFdpcMEM-l1VA&oe=6A1
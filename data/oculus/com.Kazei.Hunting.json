5/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cM2x0kMZjsQ7kNvwEPPLaP&_nc_oc=AdqDv8lamNe0aYlf_y4EdAoB-Tj8q0SYl2vuHW7ONVekJLttUdiC7Ztic_PEXHERotg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VN-cG-k4Zp7BCJlMNGH3RrPHZMT5bumxpDsWREGfiDw&oe=6A47BE1D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTB_rFyKdhcQ7kNvwGGIYfl&_nc_oc=AdpPdtJsQKibb5uruWRphlx6Zl40JVIvZJz-ezKE7CFSoF7kXE2ZLEekgn60FTcngfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8LGQKoSOhlr27GWKx_aeqwXcrpU6U0JNQC5MVfj0uJQ&oe=6A47B0C1"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GiUaRO_KuUQ7kNvwExDrb-&_nc_oc=AdrZrwcUOyGtzSpgzY9ilrIQoMTGHQn14kD1y5yQkeoFJ51MKKB_8Ylh8oM9W132WT8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ce-_bZ57tgN1u9juXNdnsk9EruyOHXr3pJ8LVYJlsmA&oe=6A47C7F1"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3NMeuINOyAQ7kNvwG0WSxa&_nc_oc=Adql2eBM4HvMvza9J8R_Ae7Z7Us6S8Ao7Jz1hRjAAKUIgv_xbt6RPgpE8fUMyXxt5DA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sD32FF1JAYOqsrUz6_OlAp9xUWLr4_awceXgA-Ew7BQ&oe=6A47CCA0"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk_71VTcUi8Q7kNvwF3pUeB&_nc_oc=Adp-hwHkQzRFlTzCuIk0aGGj0WQXDerwAMAjkFLcPQDVzizKkPwVmhIXDbKGPxqmmjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t6KPeUoq-LDBDSxaRqdz4hcXqriofjmncbjiFEUcV1A&oe=6A47DE4C"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reHsblkhzZsQ7kNvwFz1o_0&_nc_oc=AdqAeQt6o5jvfw3MVbqhO-4w-1guR2gwqEf_Jy40gVKE4xOwECLC9Ksk-hBupTxLkBs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vv95ozDkALi4XCmQet-1ya9Yk4MiBok7GWS874_W9iA&oe=6A47CDFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499302770_1652435462675279_5195998813947567288_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdeXI2uxkokQ7kNvwEgiLui&_nc_oc=AdpD8iYZBQndNxpisqLp6qE3evTgWl_Lt0w_pdMGcmj6ipl6dIHWrgmAi3nKmDIwYBw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tU_GlFpiqWzo7f5cN2DOSfcFl_yKQUZCREsNuB5IyHg&oe=6A4
2595", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyOjrvHVOO4Q7kNvwEBZgEw&_nc_oc=AdoTCQtr0-Yd6gKzTO1PdnOl9TL1j5UjhwceZ2lImgU2PLztd5odoAV4Ps98vzOBOyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8vCqsjSWhFz6KC-dJusHZ9QyHi-cCR8XTqs-l_sRJQQ&oe=6A296B9D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P764dby-InoQ7kNvwGfg8oj&_nc_oc=AdpR6uvucqH2vU0mdHmysyY6z1SpO2o2tzyXAw1BjOG0dEGG3-xErAokxSsK-1aLHFg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zntDa3JVoQkPYBwzA4BW5dPFWJWSqW13zbdHCuTSVhg&oe=6A295E41"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhpHyjrubiIQ7kNvwFwRhq9&_nc_oc=Adogd1a8LFjEB0YZiA6Im7LZ7ToWrjgxpdxlVbwZedzi0a5MFHeZw0Kx8jGTn4_4NEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94ow4MdWHwbBd7nzuS-ZDBKgQM_yIsvRqMIiHo4vk0Ag&oe=6A297571"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXMkXVTPvFEQ7kNvwGkOyYG&_nc_oc=Adpc9BWxSztcCqp3oJ5WX08mWjqbPg1A_3WAPhsWUy7sfqRwXJIoAzilR95uNqYSbYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fqH4rF0ZgZtlk5c8HazfIhY15aXsWep4j-j9CrPigMw&oe=6A297A20"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RltRFeaiEVQQ7kNvwH9eD_k&_nc_oc=Adq7f5us_z-KBpsja8ooZkzn6U9SEnwHVJ4xUbWjn_2lhfZ5B3MaubXDVJIXXKDiXkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OqxD_cqoGo9QAcXilI3T0j7v4s8b389HgSzF9HCVXnQ&oe=6A29538C"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmClZyE3btkQ7kNvwF2PIdn&_nc_oc=AdoF0prIHc8v8lmVxpRg31fNejO4waNQ7PUpSXcwbyjI9mKJEVmhucpoO2bbVkpZgb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eSngpHw_sLAk1M9lTcaT0jxSalutojM5WHjq4sw2pFQ&oe=6A297B7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1574661204267869"}]}, "baseline_offer": {"id": "1574661204267869"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779476280, "status": "PUBLISHED", "id": "1574661204267869"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename":
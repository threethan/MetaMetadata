tent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3d-dn7t3bES5H2J8m3uDUWKd9BSbLjxV5ma4poLrAsw&oe=6A58EB71"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHuzHE8dDUYQ7kNvwFA74jG&_nc_oc=AdpJSpDiJkT4fkwJt9oeXrKnwYA8FBxPZjDnctrVHZo0OzeCasu_5sLiPNJHE2i22Fk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN6dgCCTdND_SsgCasuKHkl6b2mHDNc3ddWusg5R5NRQ&oe=6A58F020"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erQ7MAZkMfwQ7kNvwF0_1t4&_nc_oc=Adq9vJgin7cICu2ajMmPk-E7dCSF0aJsjuPIMRZw7NaCGkC5gjplohOJUJdQASHjgJM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXLIxVukuvoYYdf6gkyW1dBS2uMXLMhGaBQrTbaF9N_g&oe=6A58C98C"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzNI1Hh7-E0Q7kNvwHKdBrP&_nc_oc=AdpxyhFZF-4f800DhA02_BHGBjcRt8nPK2k82GF-ZMjeRBbwgVU4MIvgNc8Y8QJfpcI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnN1YVuZa9bQihuRl30kDfDUibeDPBxnnpr_TUWqfLVw&oe=6A58F17B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
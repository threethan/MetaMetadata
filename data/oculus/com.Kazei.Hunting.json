5/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2-gTGD0uXMQ7kNvwGW_pzM&_nc_oc=AdoEaV1bdCRYt_vQVtdTi4TUwS_OfRf7Iah2ov6FVPOO7ou8eH669vaUPwKBnTa5IOw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O6tWmk5HGGxvSVxRJdLznGPSEyQCS494IjtEr79X4qA&oe=6A2C0E9D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvYaXElionoQ7kNvwHSV3t3&_nc_oc=AdoBJNSKX7gYrX8ElPvmZGqi9YvTnDr7sF1et-b44xD6tsWnc6L4w2EDscI5oGH9pLs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-qGgmmgVetHLeSd6_SIu09zioEG73bCaREgjwFjnqIg&oe=6A2C0141"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhpHyjrubiIQ7kNvwG1ry-1&_nc_oc=AdoMn6Yk0-KUNcjHfgMPMotdMIG0qYTs-1ZdS-lMxbIxypi6ngb_0Ps5J60jVWGS1rw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R9NVy--Dk_mKEFQAE9GUad50jj14sVtbXkjlTRmsDkQ&oe=6A2C1871"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0dEF0OUloAQ7kNvwG-iz_t&_nc_oc=AdpDVlHcVF0-pjXrQLyPteQ14vD6D2-Nm6VVhXNHG1brcKRQHIFOyu51tt-4K66clqg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pRZeJ99uA4yXrRp4DHOGbH0npXOTv_d8K26iKPVw5gg&oe=6A2C1D20"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnG-AbhheXYQ7kNvwElHEO-&_nc_oc=Adp1lfSht5r6YTuSllHDRv48dwFFt9OyGOLbK0dKb7XlY6JNjbYOCPLP3SFpXx6R2Qc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pQVMkyhg1AKrDVoSTkiyr_9HNOT-yrJTSv6XMS2iIow&oe=6A2C2ECC"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG92sMUwFdoQ7kNvwE4_fWd&_nc_oc=AdpkymAnsdP8XbqbCVipZsS6lIMCobelMdq9tVyuxdPgRPAINmG_KXrQNc2stPEKuFQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VOxZZtfpwHEWg8Y9-QdzNjaOAEI5hyIRqmtrRG66KoQ&oe=6A2C1E7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499302770_1652435462675279_5195998813947567288_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LvbFWPLgvoQ7kNvwENcFQC&_nc_oc=AdrfZ0GZg0i5vE5jTqLUkHY7ToI37P60_tuaqXNTT7iyJuRlJEwXQsb5SogOJ85hXCk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PnzrManSX73rWGp0-H207Les-4o4EWaZ2RDhiBokLqg&oe=6A2
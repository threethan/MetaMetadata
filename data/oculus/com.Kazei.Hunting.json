5/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgZCN05iGP0Q7kNvwFsNx4r&_nc_oc=AdoG8JBljG6qcyKAdLFiXfH4bRQDJnOmdX-N6hueZdnwT2KPHNwRqC8ctdiTPcBQ6GA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yQv5Q6-w8NvbxEazhYYF9dhVdq5ORfszxS6G0fCa6Xg&oe=6A451B1D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9oGEnGvxloQ7kNvwHoY2RJ&_nc_oc=AdoKlsMT2n9ictUvql2-Nshy5THwy04OuM4RMNMJgyR9U4YrMR7eHS4B5g0BRx8eGgI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c4FVzzMkmkYUC2fNPR3eZdJmXmy4-YZQQ084BEZJQRw&oe=6A450DC1"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GiUaRO_KuUQ7kNvwF1WdUz&_nc_oc=Adp8BrNakMJ7IhyIseWz-a-fDR9GWG4ozisAlr0iLQZ1fVZovQD2Apr2swP7Ll88fvc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G9K98U3jbZ8nROo08ozhH6wuKQKFfX8JNstjQaxnGeg&oe=6A4524F1"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsgrDGRlGKMQ7kNvwG1p2Tc&_nc_oc=Adpnsse-ZQyKniQq32lj2MsYK-QmKpw6Nji25flQC3PKL08fVZo2dkptYK6BVeN_nG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7WfDV0BKb27qVuvc6ooLA8sldmIVAqbLSdT8LlOZcag&oe=6A4529A0"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LBhDzIalgAQ7kNvwGS5Lqt&_nc_oc=Adql7yrjg-3PLPVu6AzSaB9DVk98EzXUrPGpEA2X7hbz6E47KxEm5iOuCpa0saskK_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zly-BvhRa3e5YKEeLfa4xxwb7wH11Tw-YN3Hi06NmrA&oe=6A45030C"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMBhsC3icbQQ7kNvwHOjGN2&_nc_oc=Adoxg037x3S8aJQezwIHbpj_JgiPydwDweSg9tmMEjcvHr8SetQ63tz2TpVp3zjmVF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dAAbn6yoyBlWNXXr66v14TNxvOn605bflODdLzL5_Mg&oe=6A452AFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302770_1652435462675279_5195998813947567288_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOPR2WidmsAQ7kNvwEJsz_n&_nc_oc=Adqyzk-vMJ01XZ8Bllo44vVsr4qE75OpzgTCDbZi-mTCQPb3ZkEaccXFhAIwLV5gFoQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vLNNninbHtijoNFdXeQbKpBhMgdteFnXGMx1WhMgR1w&oe=6A4
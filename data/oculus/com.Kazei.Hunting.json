7743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duN2YL178BEQ7kNvwGlnTSu&_nc_oc=AdomFg78W5T6UStWhjmE6cGn1UHUV1wF1AcGTKoobb1gS5-FmT9jdRE5ApzdcM6h46E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5U2OxhyVWs5XI_s9ENeKGInVg_HabMEzLwMFG-Vp8Rg&oe=6ACCEF71"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vhT6KaghIcQ7kNvwFaSwAc&_nc_oc=AdrmqsTGoO3t7wrazPXgeAHmdfzTpB1nmtmx1_s8ShymzZL4L7O6cO6HgCdndrcIfsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkl9jIHrmQJAs6ErOQXY-7TQ6XwAH5Hab42q_ONU-CfQ&oe=6ACCF420"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb7ag1cuoyoQ7kNvwFgDr-N&_nc_oc=AdoeUoMjo1Q2b9ZpEIJ9EdLCR7kriZq1aBCYZFT1Pn786AGUJWvRMa1BCiLxRTaVGac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD-mavlmQx_23uo61ejySZSzjwGFmSq0S3Y5Z2u8QYKA&oe=6ACD05CC"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoJ5Xz4HpfYQ7kNvwH1cCP3&_nc_oc=AdqZkRhTvzHu2a417fNGmBjlQ06C_FCtsMtKMEhUeVLUsKa6QfmFaNOOrIxVMhXDNKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZcGw0s5K2rnrXgR-gZKG4SQ7PTfeMWHWOoBzc9w917A&oe=6ACCF57B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hunting Simulator 2 Sniper Hunter 2560x1440.png", "id": "1616793386581172", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823279_1616793389914505_4372029613373522623_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20ohfoAkUQ4Q7kNvwENmosn&_nc_oc=AdqrGC4Yh5cKGm4jzLWFWDTcKuS2RA4KoaJz4kw7auMvzYaPhI9UvmQHaSd0VtonkMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4B61ZVGJkNMbnQ5rnHKsBdd9SMueAVtduHVeq1Hligw&oe=6ACD092E"}, "display_name": "Hunting Simulator 2: Sniper Hunter Game", "keywords": ["free", "shooting", "animal", "deer", "hunt"], "long_description": "# Escape into the vast American wilderness and put your instincts to the test. \nThis is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n{1546921823826208}\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel. {986860827460610}\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point. {3074033742794244}\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}, {"images": {"nodes": [{"file_name": "Screenshot with Deer Scope.png", "id": "1836268027798855", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_1836268031132188_8806795065441336692_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq7qA0jgOxMQ7kNvwF6t07E&_nc_oc=Adron8YvOMyf-zsh_xpFmQGmiYa57vCx-OA5ZEkwsINo84O7j4QnJRjKN8nlD-SnE3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbZGkLSSM4wpZfY4r2kOPPQrcstPL93s19B_sMLHomiA&oe=6ACCE68C"}, {"file_name": "Screenshot with helicopter.png", "id": "1357461429575916", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_1357461436242582_3505275614872360770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tbld_VpplcgQ7kNvwGLJs45&_nc_oc=Adof2EshS657M-43KD-8Rg2sFUiVC2lhN3V342iZyYF76OmGIEUoEuvvy-dv6UCL80g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvj0tGq6NLqWk33hD3g-n6bs48nqJzt9379fwk1pf4dA&oe=6ACCEDB9"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1136268156027807", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1136268162694473_3426842828417395937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1KAHfUrEAMQ7kNvwGdNYZW&_nc_oc=AdpVXJYgikMSG3pQUbNWTdgddWdhT2PbO1JTyjTfEDyifjtaXwaPG3lzHElUsslElwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc-fRdHBdZtwrjVfu-iJ5jJeq2KsmK9ounbMP5xGgQhw&oe=6ACCE9A4"}]}, "id": "988190437657900", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Simulator 2: Sniper Hunter Game", "keywords": ["hunt", "clay", "shooting", "shooter", "animal"], "long_description": "# The Ultimate American Hunting Experience\n\nEscape into the vast American wilderness and put your instincts to the test.  \nExperience an authentic, long-range hunting adventure built for VR. Whether scouting from the air or stalking your prey through the wilderness, your skill is your greatest advantage. \n{1136268156027807}\n**DOMINATE THE WILD:** \n \n- **Precision Ballistics:** Master true-to-life shooting mechanics. Account for wind, elevation and bullet drop. Every shot demands precision and a steady hand.  {1836268027798855}\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boar and American Black Bear. \n- **Total Mobility:** Take on the terrain your way. Pilot planes and helicopters or drive your 4x4 across rugged trails to find the perfect vantage point. {1357461429575916}\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the power and precision of authentic hunting equipment. \n- **Untamed Wilderness:** Explore vast biomes and manage your resources and fuel wisely as you traverse the unforgiving landscape. \n \n# Are you ready to take the perfect shot? Gear up, venture into the wild and claim your trophy.\n", "short_description": "Enter the American wilderness and experience the thrill of the hunt in VR! Track deer, bears and wild boar across vast, breathtaking landscapes. Take challenging long-range shots, fly bush planes and helicopters, or drive rugged off-road vehicles in search of your next trophy. Realistic ballistics, authentic gear and total freedom await. Are you ready to hunt?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
_nc_ss=7f20f&oh=00_AQHjuQ9n3PkefXtw5_SeWWE0vErDB-FLDAz_24-OHOCmSg&oe=6A7DBE41"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJv_t5hp3AcQ7kNvwGleAPX&_nc_oc=AdqT9Eit3l6YlhygO1grE-BR9F3-Z9oa4AnCV9ErZyA4yjhBuM0ckCn_jW4IIRJHlco&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu8bO_LZW59mjAiOreIIekQyyYagRMFyH1_H5GHLvRMg&oe=6A7D9D31"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2BBdbpG2HQQ7kNvwEhHJOy&_nc_oc=Adqrt39TWeeDGApRaztryoRtXnisIsHeyDZl7xVF7BJR79WUPYTd60dzaJEUTmnPpJk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6mMx9R5GGlyfiwtHXHFxiz6pDRlN9Ukq3xsJ3zUog5w&oe=6A7DA1E0"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtyq797JmPMQ7kNvwGyWn8A&_nc_oc=AdpPQjbW3EmKOxUhzma1EysIglvpKhKstetwtPJ1d2y27vHKdoynRQw7ZWunHgSMcUw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxKiXsUVTCFJBo21a96nInVoD9ByQq9OnFilecQiaN5w&oe=6A7DB38C"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cSQLJfBcdAQ7kNvwEpyQXQ&_nc_oc=Ado4M_ArSDOSd8qW_hww6xEalUdKPSmN0R9bdwnZ9g2aVvSPPyS3Ozns_IIvS62QfJA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs8ARweriuetuRmV5PwPOoGU6nb650Ra1017WlxhTBjA&oe=6A7DA33B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hunting Shooter Sniper Sim 2560x1440.png", "id": "995353556705162", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824700_995353560038495_5487729942137770731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9GbjUGXSRUQ7kNvwFiafTC&_nc_oc=AdrJwrlljn9kMv-ibh1cahDcGZ-pzp3Ks0EJek44nlnWePXJWf1sZJ8wnpBNreSA_Ek&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYZd3nQxlqsMMkkp0VICMvm0P5raKJTFBhqQacYgzvRQ&oe=6A7DAEE0"}, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# Escape into the vast American wilderness and put your instincts to the test. \nThis is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n{1546921823826208}\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel. {986860827460610}\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point. {3074033742794244}\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}, {"images": {"nodes": [{"file_name": "Screenshot with House Jeep Airplane.png", "id": "2292755628220042", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/593909648_2292755631553375_4747310080233420799_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w57iG34CCPoQ7kNvwFpJB6P&_nc_oc=AdqalcolyyhNsG1oH-Qjr2u55h6bjYtRua_XvNnRndDI86kCbDeULxG1WmbojBhsg8A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxgC7a7XrcYtwaqhwCEog2KQTPUIwSaqyeGAQebcEqCg&oe=6A7DA0F7"}, {"file_name": "Screenshot with Deer Scope.png", "id": "2131381550755003", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312332_2131381554088336_5787859982724967283_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2PEEv9GEiwQ7kNvwFQQRLB&_nc_oc=AdrzsFr6AE6pxN_jCwFlZwXslImGXf9xgzsrp5Mz14K0HIYx2SeV1F4L7aaqqqU0rao&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeA7RcI0DAlhZT8_LnSUMbO58MQs2fyfCwfmdEDJxeRQ&oe=6A7DC29B"}, {"file_name": "Screenshot with helicopter.png", "id": "1041321218452084", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/604370996_1041321221785417_8626986679439647874_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whb-Is_vzGIQ7kNvwHIB3JV&_nc_oc=AdqkvpipSNYnOVtMt4V3cyZKuO9nHxRE-x2uv-WAIJOnQE7KlV1PSdIUvoAKlQU9_a0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYNPwqId3ExC-UDbcGAztCtfidJc_-X_dt3f7AglYuNA&oe=6A7DCA2D"}]}, "id": "1369124424689124", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Simulateur de Sniper VR", "keywords": ["chasse", "hunter", "virtual", "tir", "cerf"], "long_description": "# Plongez au c\u0153ur des grands espaces am\u00e9ricains et mettez votre instinct \u00e0 l'\u00e9preuve. \nD\u00e9couvrez l'exp\u00e9rience de chasse \u00e0 longue distance en VR la plus authentique. Que vous rep\u00e9riez votre gibier depuis les airs ou le traquiez \u00e0 travers la nature sauvage, seule votre ma\u00eetrise fera la diff\u00e9rence.\n{2292755628220042}\n**DOMINEZ LA NATURE SAUVAGE**:\n\n- **Balistique R\u00e9aliste** : Ma\u00eetrisez des m\u00e9caniques fid\u00e8les \u00e0 la r\u00e9alit\u00e9. Tenez compte du vent, de la distance et de la chute des balles. Chaque tir exige pr\u00e9cision et sang-froid. {2131381550755003}\n- **Gibier Am\u00e9ricain Mythique** : Chassez des esp\u00e8ces embl\u00e9matiques comme le cerf mulet, le sanglier et l'ours noir d'Am\u00e9rique.\n- **Mobilit\u00e9 Totale** : Parcourez tous les terrains. Pilotez des avions et des h\u00e9licopt\u00e8res ou conduisez votre v\u00e9hicule tout-terrain pour trouver le meilleur poste de tir. {1041321218452084}\n- **\u00c9quipement Professionnel** : Utilisez des carabines haut de gamme et des optiques de pr\u00e9cision. Ressentez toute la puissance d'un \u00e9quipement authentique.\n- **Nature Sauvage Immense** : Explorez de vastes biomes. G\u00e9rez vos ressources et votre carburant avec soin pour survivre dans un environnement impitoyable.\n\n# FEUILLE DE ROUTE \u2013 ACC\u00c8S ANTICIP\u00c9 :\n\nNous continuons d'enrichir le jeu. Prochainement :\n\n- **Gibier d'Eau** : Chassez les canards et les oies.\n- **Oiseaux de Plain**e : Traquez les dindons sauvages et les faisans.\n- **Petit Gibier** : Perfectionnez votre chasse aux cailles et aux perdrix.\n\nAvez-vous ce qu'il faut pour r\u00e9aliser le tir parfait ? Pr\u00e9parez votre \u00e9quipement et remportez\n", "short_description": "Vivez la chasse ultime en r\u00e9alit\u00e9 virtuelle dans les grands espaces am\u00e9ricains ! Traquez des cerfs, des ours et des sangliers \u00e0 travers des paysages spectaculaires. Ma\u00eetrisez le tir de pr\u00e9cision \u00e0 longue distance, pilotez des hydravions et des h\u00e9licopt\u00e8res ou explorez en v\u00e9hicules tout-terrain. \u00c9quipement authentique, balistique r\u00e9aliste et aventure immersive vous attendent. T\u00e9l\u00e9chargez le jeu et remportez votre troph\u00e9e !"}, {"images": {"nodes": [{"file_name": "Screenshot with Deer Scope.png", "id": "1691502618728548", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823901_1691502622061881_313257318028832307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0acLa9zYYVsQ7kNvwHHXSJ9&_nc_oc=AdrKA-G3STBjIABnCCblxB8BpIynr2UrAgySxB4wyldz0NsMWytdeT0S4YGoXsPomYc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHksunwfWQok43KHdkTeUubF5q7zouwQHz2CW6ubpSzqg&oe=6A7D9EA7"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1565173848518322", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823351_1565173851851655_293611742634863887_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pz8ub8oS3wQ7kNvwHZUm7F&_nc_oc=AdqEHWttCco5jrujGf8qrgTh0vLWMVrSmY7VBw-g3Kn-5BT_cuf7Kuj67m9Bqmt2Sk8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGti9FSnHc5XRD2vUym4Mzi7BdpssrDxLWLSkyE991XTg&oe=6A7DB843"}, {"file_name": "Screenshot with helicopter.png", "id": "1024222440561665", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311585_1024222443894998_5505219204595535935_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlVVKbKCh2wQ7kNvwE01vVF&_nc_oc=AdrNuFihoxDgk-0tfQWaJjZp-Wd7xiW7Ut6-IrWYqFLlWP7FcDNqCcFgwtYhck45y4I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyuB_eV2AYDCZE7we5wpWi_GSKKdczkNhvnoi_8j5pkw&oe=6A7DBE2A"}]}, "id": "1047750274289139", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Scharfsch\u00fctzenjagd VR", "keywords": ["Jagdsimulator", "Jagd", "hunter", "virtual", "Jagdspiele"], "long_description": "# Erlebe die authentischste VR-Jagdsimulation mit realistischen Weitsch\u00fcssen. \nOb du deine Beute aus der Luft aufsp\u00fcrst oder dich lautlos durch dichtes Gel\u00e4nde pirschst \u2013 nur dein K\u00f6nnen entscheidet \u00fcber den Erfolg.\n{1565173848518322}\n**BEHERRSCHE DIE WILDNIS:**\n\n* **Realistische Ballistik:** Meistere authentische Schussmechaniken. Ber\u00fccksichtige Wind, Entfernung und Geschossabfall. Jeder Schuss verlangt h\u00f6chste Pr\u00e4zision und starke Nerven. {1691502618728548}\n* **Legend\u00e4res amerikanisches Wild:** Jage ikonische Tierarten wie Maultierhirsche, Wildschweine und Amerikanische Schwarzb\u00e4ren.\n* **Volle Bewegungsfreiheit:** Beherrsche jedes Terrain. Fliege Flugzeuge und Hubschrauber oder fahre mit deinem Gel\u00e4ndewagen zu den besten Aussichtspunkten. {1024222440561665}\n* **Professionelle Ausr\u00fcstung:** Nutze hochwertige Jagdgewehre und Pr\u00e4zisionsoptiken. Erlebe die Kraft authentischer Jagdausr\u00fcstung.\n* **Ungez\u00e4hmte Wildnis:** Erkunde riesige Landschaften. Verwalte Treibstoff und Ressourcen sorgf\u00e4ltig, w\u00e4hrend du raue und anspruchsvolle Gebiete durchquerst.\n\n**EARLY-ACCESS-ROADMAP:**\n\nWir erweitern das Spiel kontinuierlich. Demn\u00e4chst verf\u00fcgbar:\n\n* **Wasserwild:** Jage Enten und G\u00e4nse.\n* **Federwild:** Sp\u00fcre Truth\u00e4hne und Fasane auf.\n* **Kleinwild:** Meistere die Jagd auf Wachteln und Rebh\u00fchner.\n\nHast du das Zeug zum perfekten Schuss? R\u00fcste dich aus und sichere dir deine Troph\u00e4e.", "short_description": "Erlebe die ultimative Jagd in der amerikanischen Wildnis in VR! Pirsche Hirsche, B\u00e4ren und Wildschweine durch atemberaubende Landschaften. Meistere pr\u00e4zise Weitsch\u00fcsse, fliege Buschflugzeuge und Hubschrauber oder erkunde das Gel\u00e4nde mit gel\u00e4ndeg\u00e4ngigen Offroad-Fahrzeugen. Authentische Ausr\u00fcstung, realistische Ballistik und pures Survival erwarten dich. Bist du bereit f\u00fcr die Jagd deines Lebens? Lade jetzt herunter und sichere dir deine Troph\u00e4e!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27558607803798250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619704_1782431122913287_1333686975378920489_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W9i4Azjp1IQ7kNvwFRhIZr&_nc_oc=AdpeeVI-V2puMmwLjWdTk9jAKdyfhUt_3Bx26D6zeUgFAWsFDeJhrIgWg7CQHm0hwnk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFt1qTtTalBpVLYlC74EEcyP5HfIE2sbLMpTrul-eYRQ&oe=6A7DB488"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hunting Shooter: Sniper Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Ac
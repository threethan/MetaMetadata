5/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2-gTGD0uXMQ7kNvwHU32YY&_nc_oc=AdpI0iilk3aGcXmSsZTWKPjTQcKW8MaK0wYD9BAQ9CpuZ0wy5s-iVf19wSWsEkA8CiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pNdb10kmAvTcTWO93BcU6WnOrHedz1gY9MiFlBFX1yQ&oe=6A2EB19D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XKsDKdn7VcQ7kNvwGHJYlm&_nc_oc=AdoarM8SQoApMktCuIr63nYGvKW9GzAibhLPNu_dwN9P-4PN2hhmPwBBfFyGhWZSOV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af857Y8I8WmVNarzygc2pXDQLEXZ9hZs9RepnXTiu8RvQQ&oe=6A2EA441"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hUx27sk4P8Q7kNvwEpboGM&_nc_oc=AdpPXBvfu9Gxi8SkGnnTIdWc9XdWfSOFdPm-zFwvPcMeRd-rsDJB8jM7evj0bE795j8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LfGe7tSLPC4vNR6o-JoaVZWozFkccJLHuRMXkDZ5rrw&oe=6A2EBB71"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0dEF0OUloAQ7kNvwF5ynOP&_nc_oc=AdpvEQ7IJtBUIdtFdv7yZS80E1j7AiCFNBRPFLxckBZx9xtm_-llcBF8OBCul6HHtZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9se4qAmwrKdEMySfaPAqaZsyDn2WjGXAOQSomnWWvqwg&oe=6A2EC020"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZN5Trv6uYEQ7kNvwGPovol&_nc_oc=AdrGiigVNZ_PKrDKNgjh9hRTGEhsCVAf3YP_xahNmGM4c1__ocO9Kujyn8hrMweklH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rq4-RDBXDUB5khYjTKaV-Evk0HeSC5OqJ8VHTrucCOw&oe=6A2ED1CC"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG92sMUwFdoQ7kNvwG7Rp7V&_nc_oc=AdrJTBAd2sbtwigwVpo37RhZ8sMgSoQEHbLM9VsHwYUHLLwYICNKHeCnK6ZtpI-pwwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GyaQ3RJMuM21N18vnk4rLmoN8_K4WXlv-QdXXXoAPzA&oe=6A2EC17B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302770_1652435462675279_5195998813947567288_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LvbFWPLgvoQ7kNvwFAllql&_nc_oc=Adqt9tbvFu1vAO-a0OyWrtlpBrFx7hR1xQZbP9X43LoCU9ssxUgqibdMXwUoTo-S1do&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HObla2_Jr3FbZZMQWvBcfm896N7W0QgR50FPPWjN7OA&oe=6A2
5/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyOjrvHVOO4Q7kNvwH3HjGx&_nc_oc=Adp7Hb0dzMoz5zjCwMu8pycNg66QY8Hl1erCPGR8j_GWqO9XJcwwTBdWimh8s7yvJtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wdq5FzldKJnTWNbv5qBrTqHK3nnko-mrwvqFkwpiRUg&oe=6A281A1D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P764dby-InoQ7kNvwG-CXNm&_nc_oc=AdqvctDvWyIIDI466hidPOODSlF6K8Oo1jeu1y6lFkRa8I76cEh2OvCTLMGBSXAcKB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bwwl1p49EkS7GcEZzTgFlrEeW-55cwS8vge5GYVbaTA&oe=6A280CC1"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3VAKLpz7mIQ7kNvwGZcOrs&_nc_oc=Adr-gcN-KHg6QJkUWi24fotuOKVcUPuMkj31_RYydlWw_3JQpZQzFT3cDdOfpHof3XA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hxhzK0kI741hAICLU32FNs8D5JwMEfKoM_y7EeXTh9g&oe=6A2823F1"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXMkXVTPvFEQ7kNvwHxWns6&_nc_oc=AdrGJ2c0QxNaFIiEpl5Z-q-2lbPh8Aa6yuFB-7ldGoQvnRQH8x_WfoeMRdh86XpH_q4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yp_5cGCgLCD5GJxfMlN9xUjJ17N_XJCjCHuc6M7pCUQ&oe=6A2828A0"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RltRFeaiEVQQ7kNvwE15yKi&_nc_oc=Adoir-QcR0_xQQ2bC3LGvxHaAQUywnxzxNYYhRRJ7OtjwoY7Lc5iL5c1-sqrDCdZH_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m4ivdl9O4S81wu_-9D1Mf7A1rnJBIS2b01lt1p6DR9A&oe=6A283A4C"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmClZyE3btkQ7kNvwHEWpZR&_nc_oc=AdoO_5Yw-hmKR1OkAM06MsCGSUJn8A1FpQANemMivDGqdxCoAkY64oJ-hsjhJA5xzTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lgu46HioxwoVpUNVp1KxXKKUu0PKaKyHXIIr5k5rbYA&oe=6A2829FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1652435462675279_5195998813947567288_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtnQGe4Un1MQ7kNvwFkpE6D&_nc_oc=AdoSWAysgEJsETIdOtuj2jtMI0rHrS6ZueoyrQZ6058XlysGRLKS0SSqvPkdBBLtQic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7myfGCDRvBnJ9iNtwOQXs8B04IQkuOdFBkybr3ItW-A&oe=6A2
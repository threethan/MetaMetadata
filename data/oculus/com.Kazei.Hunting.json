5/491823351_969800395685928_3394512970229962969_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrweqyV8yWkQ7kNvwE55aZz&_nc_oc=Adrl8dX0VF2BIawRqvWVuoewK4eWiFPVNoZ-GqYTXjswK7O9zTWsbOH6nKGwq4D-EFA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1opR_5vz3PreN8AqTcryj7lKGW4fHXLCmJGGR_VE72A&oe=6A32A61D"}]}, "id": "1298912438407911", "locale": "en_US", "screenshots": [{"file_name": "Screenshot with a moose.png", "id": "991466650096061", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820441_991466656762727_2790707460315502198_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK75ImixVSIQ7kNvwHncU52&_nc_oc=AdrTwg--WR6EXn3U0AADww6HcfERRa-QriNgMpSO15PFgRBwCqsutKb-G8kSZeoiE50&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UlYpfMd7RWidedlqkoPB21BHmI1xY3CX9bLZqnG8NFg&oe=6A3298C1"}, {"file_name": "Screenshot with helicopter.png", "id": "2293233881505443", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499312236_2293233884838776_4353020427743295579_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6uEk3mRjtIQ7kNvwETahcP&_nc_oc=AdrVqWRoskUhBNEw2EvckvV9ESg-ZMHgaNngi9ui1hkv4TUSY1ljYV2pyPhb1qbUuuA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ATxoUM4PVTXfC3tXOBc8BAJXbHM0JbSuinWnwDphr7Q&oe=6A32AFF1"}, {"file_name": "Screenshot with Deer Scope.png", "id": "1541197004377263", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818852_1541197011043929_4695827154338383850_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8uKC9aYo4YQ7kNvwG9FDeY&_nc_oc=AdqVfiy27s-xSu_GcshxtXZYQdE6CvYfvrAXvayY_LgLJtnFmpdcjUdfG0sSd5PQHlY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MSNUQMrlDvrqs1ghiiQHtrphxHufJFGcJtvTaD9CgCA&oe=6A32B4A0"}, {"file_name": "Screenshot with House Jeep Airplane.png", "id": "1797997051174352", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/593868733_1797997054507685_4467252946920426059_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_7o8Tpe7CMQ7kNvwE_MlY1&_nc_oc=AdpHRRAfMIoS6-T2k6PmNx5BbVhMxOUIcN2nm4R0TIb55rj10yDbT2yzZ2m6W530giE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NH4dcga7TTeZrZsMuLu58U4_A4pBfOLXuwWOVjimo6w&oe=6A32C64C"}, {"file_name": "Screenshot Plane.png", "id": "1721152925549039", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/593909648_1721152928882372_527790312932723863_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PW_5gBMA-JwQ7kNvwGy_hqZ&_nc_oc=AdrxXv9tdRxTipOVtDan3DMcjr9_ItCFgVEJbscj-0okIg8KyBQ8tgi8GaUDMPud_3Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AH1EwFLGd2G8QHogHffvgdbogJMqTxPtBPVaHzU9r9g&oe=6A32B5FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hunting Shooter: Sniper Simulator", "keywords": ["hunter", "free", "shooting", "animal", "deer"], "long_description": "# The Ultimate American Hunting Simulation\n\nEscape into the vast American wilderness and put your instincts to the test. This is the most authentic, long-range hunting experience built for VR. Whether scouting from the air or stalking prey in the brush, your skill is your only advantage.\n\n**DOMINATE THE WILD:**\n\n- **Precision Ballistics:** Master true-to-life mechanics. Calculate wind, elevation, and bullet drop. Every shot requires nerves of steel.\n- **Iconic American Game:** Hunt legendary species, including Mule Deer, Wild Boars, and American Black Bear.\n- **Total Mobility:** Dominate the terrain. Pilot planes and helicopters or drive your 4x4 through rugged trails to find the perfect vantage point.\n- **Pro-Grade Gear:** Equip top-tier rifles and high-end optics. Experience the raw power of authentic hardware.\n- **Untamed Wilderness:** Explore massive biomes. Manage your resources and fuel wisely as you traverse the unforgiving landscape.\n\n**EARLY ACCESS ROADMAP:**\n\nWe are constantly expanding. Coming soon:\n\n- **Waterfowl:** Hunt ducks and geese.\n- **Upland Birds:** Track turkey and pheasant.\n- **Small Game:** Master quail and partridge hunting.\n\nDo you have what it takes to land the perfect shot? Gear up and claim your trophy.", "short_description": "Experience the ultimate American wilderness hunt in VR! Stalk deer, bears, and wild boars across vast, breathtaking landscapes. Master long-range sniping, pilot bush planes and helicopters, or drive rugged off-road vehicles to scout your prey. Authentic gear, realistic ballistics, and pure survival await. Are you ready for the hunt of a lifetime? Download now and claim your trophy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikalaikazei.github.io/hunting.html", "developer_terms_of_service_url": null, "publisher_name": "Mikalai Kazei", "support_website_url": null, "website_url": "https://mikalaikazei.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26709744025351303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499302770_1652435462675279_5195998813947567288_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH10JgFv_EkQ7kNvwEZanU7&_nc_oc=AdpBx49Rvu-JbLK_rfSgpRvxB0ipwdNI7SYrdo8NNW7Frhbv_2Ywor-agcBhhe2Xtw4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zQFOQGLwJ-Yuk5jLGChGHupfVbb0wTSf2JLKgWpbDYg&oe=6A3
5GqbyhUBXRvAlnrvQ2alBYqXOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfupXBuaQcCX1ajSD6VwFl-82CU8Sj09wv5prNhWc4pqHw&oe=699EFCFE"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU1rGHGgGNIQ7kNvwE79iuN&_nc_oc=AdlghFvFCX9eiEcQ9Wa4f1cBhSCyemmX4kT4-HWhmV_vivAlMJO1T3-Bpbpze3UqPmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuqbz_m1U9o_cFWZW6Q9CQizc_4_AEvtNUukAqcOux91Q&oe=699EEEB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A5UGqEQUcQQ7kNvwHenESA&_nc_oc=AdnY0yKKK4Ydl1u2PY4WhrqAU7HcjB1imrWOe0wfq_iilBlOmXeP5TbmbDE_tvGBfPE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvif7Cvk_m87_eA-UgmX8HUMjYuUYqEMM5gPPHO66Ilng&oe=699F06CF"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also playable with either one or both controllers.\n", "short_description": "Explore the underground caves, find the gears and solve the puzzles to escape. But beware, you\u2019re not always in there alone."}]}, "developer_name": null, "developer_privacy_policy_url": "http://
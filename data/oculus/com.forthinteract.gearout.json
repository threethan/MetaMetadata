48705700454894", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297582_748705703788227_1181917996033779433_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUC44_SpIbwQ7kNvwFjczKJ&_nc_oc=Adpi6XneWqXiBp5JuYO-_ArEoHRvwPDXBBVPuSS7OXZwRLhTYzqyYdP0fPZjL-MwKAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhJw_zFMh9wuJbAnUrEoUWX5nhbBaHx8TC258dYg334Q&oe=6AFC6DCA"}, {"file_name": "metalGearPlace_2560_1440.png", "id": "682450700437153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031363_682450703770486_3475114188374750327_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6pWwSKKHuoQ7kNvwFjhFdN&_nc_oc=AdqVQW_B1SSdZesqpHfQxMo8y9lB60oXLtyLywy8u8JkoGAAR_wIEJzfRD2FkypBszA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNAxSGmKPzwBjhQ1esjkBWF_edr_IWlCw6vdNgFfS1XQ&oe=6AFC8DEB"}, {"file_name": "coffinSkeleton_2560_1440.png", "id": "357715490193772", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982548_357715496860438_3229979792850571367_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb0i4urX19cQ7kNvwHBfP9D&_nc_oc=AdocH8QHkCyz0_9LetuATPgYQ7e-m0JNQp_GysvYU71wW52CdjLZndcKVbFrCvUdAdg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDLIYv1IWmSBVtw5-DbWd9ZKsNZGUmHyb_8HrsSEU_Gw&oe=6AFC64D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_v4_2560x1440.png", "id": "1567125167682229", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_1567125171015562_4370470436802925701_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4vdU0KzHs8Q7kNvwHUKQEv&_nc_oc=AdpCYqRsD-eIFXm0X2S6vx7xS4ZIRMJH8ZGwfzOQ3H0MUMpxp2xecZAQIqlTudPE8JY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHXLZljukHFSIqxC2uums8Fc5-Grd1BY2sOl006-0dXg&oe=6AFC6AFF"}, "display_name": "Gear Out Escape Puzzle", "keywords": ["puzzle", "puzzles", "escape", "room", "creepy"], "long_description": "# Gear Out Escape Puzzle is a unique, tense and completely immersive interactive escape-room puzzle game.\nExplore the creepy environments and solve challenging puzzles to escape to the next level. But watch out - you're not always in there alone!\n\n{793570542745458}\n\nNavigate through 26 different environments, solving problems and interacting with obstacles to locate gears. Arrange the gears on the final puzzles to open the door and escape to the next level.  \n\n{1137153677435027}\n\nEach level can be randomised to generate up to **9,999** puzzle variations for extended game play. Explore caves, tunnels, underwater, basements, drains, industrial areas and offices. Interact with doors, wheels, cranes, levers, buttons, hatches, drawers, lockers, wall-bashing hammers and more. The scale of each level varies from single rooms to expansive complexes and mazes.\n\n{1795887044254758}\n\nControls are fully customizable to your specific preference. Play seated, standing or room-scale with one or both controllers.\n\n# To succeed at Gear Out, you need to be smart and brave. Ready to put yourself to the test?  Install Gear Out now.", "short_description": "Gear Out Escape Puzzle is a unique, tense and completely immersive interactive escape-room puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://forwardthinkinginteractive.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Forward Thinking Interactive", "support_website_url": "http://forwardthinkinginteractive.com/contact", "website_url": "http://forwardthinkinginteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
4F3YR-YUVKsmZgIFQ&oe=69AFFB8A"}, {"file_name": "metalGearPlace_2560_1440.png", "id": "682450700437153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031363_682450703770486_3475114188374750327_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJANHOq4UewQ7kNvwE-j-yn&_nc_oc=AdkMjXDtCVqVyAK_uI1K0aPe2iGuJ5YZQyNTkqkW53d9LFI41UfKhsUsbwfVXw2B848&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQaV-KzBElDcRjxswpMl6couygqlYS3taDI9E-VpQxyw&oe=69B01BAB"}, {"file_name": "coffinSkeleton_2560_1440.png", "id": "357715490193772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982548_357715496860438_3229979792850571367_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7U7V3nDolsQ7kNvwH1XpZD&_nc_oc=Adl0JCvuPdOTUvf2R7krp6DDT4YNgIdCS4OWi-Cnp8LEtloyOkiF_Lqq-dr7u3TOsL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpQJwYEHPzpdhMUL9wV4jf9H7K8KYib_3t_W5jY_Vj6g&oe=69B02AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArt_v4_2560x1440.png", "id": "1567125167682229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1567125171015562_4370470436802925701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNBh7k-dx2cQ7kNvwGPXjSw&_nc_oc=Adlq83k8lxZ5pDzSo8GtiIHGbvgF_rcOpHTEUoRxe3298ADyZdnemIk1u1uCO8ihUjY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTMmFpN98GnmjSj3fbFK87qSaEt8YyAH30C8-yoJT7LQ&oe=69AFF8BF"}, "display_name": "Gear Out Escape Puzzle", "keywords": ["puzzle", "puzzles", "escape", "room", "creepy"], "long_description": "# Gear Out Escape Puzzle is a unique, tense and completely immersive interactive escape-room puzzle game.\nExplore the creepy environments and solve challenging puzzles to escape to the next level. But watch out - you're not always in there alone!\n\n{793570542745458}\n\nNavigate through 26 different environments, solving problems and interacting with obstacles to locate gears. Arrange the gears on the final puzzles to open the door and escape to the next level.  \n\n{1137153677435027}\n\nEach level can be randomised to generate up to **9,999** puzzle variations for extended game play. Explore caves, tunnels, underwater, basements, drains, industrial areas and offices. Interact with doors, wheels, cranes, levers, buttons, hatches, drawers, lockers, wall-bashing hammers and more. The scale of each level varies from single rooms to expansive complexes and mazes.\n\n{1795887044254758}\n\nControls are fully customizable to your specific preference. Play seated, standing or room-scale with one or both controllers.\n\n# To succeed at Gear Out, you need to be smart and brave. Ready to put yourself to the test?  Install Gear Out now.", "short_description": "Gear Out Escape Puzzle is a unique, tense and completely immersive interactive escape-room puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://forwardthinkinginteractive.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Forward Thinking Interactive", "support_website_url": "http://forwardthinkinginteractive.com/contact", "website_url": "http://forwardthinkinginteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "es", "ko", "cy"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33765453063045722"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1
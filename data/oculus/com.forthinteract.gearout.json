9stBoObS6OrO242J2VS-lBV0LM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afto7Nu5HmXjqiqDl8ihIG46943EU4c7WUAu3_jobMhS4A&oe=699C59FE"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU1rGHGgGNIQ7kNvwHPFmhk&_nc_oc=AdnLoCsovnaBBF2Lm8Tqgn6QX9lJPIij-YJ_HY5NAKVs0eHZJ0puSilui88Q5DqTpSc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfspW2V4z1wOhlk5DidBVrJO18dXS6fA8VRC-knvQ6QlBw&oe=699C4BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKs4YyvkVw0Q7kNvwGBChdi&_nc_oc=Adk-SQ6HNlzwnGqC3-DDqR-Std0rIO55rqHggozKMktBWpy0npNoR_8sBCvqJGdkIx4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftG9Ceru8YkmaoaE3_Tx6xTR8sDf2pTK-c6nB-XTWoEOQ&oe=699C63CF"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also playable with either one or both controllers.\n", "short_description": "Explore the underground caves, find the gears and solve the puzzles to escape. But beware, you\u2019re not always in there alone."}]}, "developer_name": null, "developer_privacy_policy_url": "http://
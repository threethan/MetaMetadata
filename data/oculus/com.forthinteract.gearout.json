79080253601432", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001703_679080256934765_5244425530880622471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0DKaX8IseEQ7kNvwF72Fsc&_nc_oc=AdkmJ70rvY1sxZGe-4OcDjFu3vdqzMflZtgHNmYYIuF9c6e5N599reQN7NUhw0ysug4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVQ3pDF5LGlumxf6mHmBPdW7Zjh1OL8PueoAApfxiO9Q&oe=69BEA0FE"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T4cVK3cN8sQ7kNvwGoszCu&_nc_oc=AdloAIUDV9abxt31L3GZILqHqrMW8ZkWoFylCNWVry9e65uM6Q48M2NXC-nQPQjNXxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2LX82iyDNwXXYOUwAI-qEr-MdJJAQp0M82UVCvr-djw&oe=69BE92B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH3f7aQ-sAkQ7kNvwFSGoj7&_nc_oc=Adl9A4UjPh6vF7rj0kiEuq95xG0k5l4zJ_bNCqrRGb4mTEd6n7LZy0NEOhM_2YmcGpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCpsfpMGcoRp2y-rM61yF7ietM3FZ5sPo02uU83UnPXg&oe=69BEAACF"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also p
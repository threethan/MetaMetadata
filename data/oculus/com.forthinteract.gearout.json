79080253601432", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001703_679080256934765_5244425530880622471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_cj8oDte4kQ7kNvwG2wxHU&_nc_oc=Adki1vlmy1vyinc_HUmNwqbIsIbINUjmh47_8dxre97KBwe6T9vWN4trjeNjT_g-KLg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afykl9ZrMv9ze4GNg-7KqsXAku3CHpDn_n6ETW4PT4wdqw&oe=69B6B7FE"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y37JQwvrne0Q7kNvwEabUDP&_nc_oc=AdnOuj2wa4QGdINJ6DG2p4qqA3_y_12BWeyVCBIEVSLqsgsz6Q1NyQu1WeXeBRdu9y8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzaw56HPlmrUR7yKv0yP2cjP32VGM58DhLh10FK8a5yQw&oe=69B6A9B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBavvz_xXtgQ7kNvwG8anDg&_nc_oc=Adnkqkld946T_drkRdD7TQ1v-T-LboNaPBkASuwbXwZ7gSdbSmEMxt6zvZtz-5X6PMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIRMrPDtMXg6cJRX9ef-P7FJ6_i82ZNT6UXfri_uzo-w&oe=69B6C1CF"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also p
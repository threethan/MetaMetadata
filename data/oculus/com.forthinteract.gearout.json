VibqF-KJaoPengaIMPN8onbSYa5BTkvNVHd6nwA&oe=6A748362"}, {"file_name": "gearOut_mummy_2560x1440.png", "id": "679080253601432", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001703_679080256934765_5244425530880622471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7batcd1rT4Q7kNvwE9xvRf&_nc_oc=AdoASMdsluvKrRIrT-GdSHGkmiHhO3v3OpcbefMAoDBDVnX4SODw11mKi0aiylzOzV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_tg1j9X_egyuPVz_H1ZVIIXxpI72fSEYPMVjdtD0SDw&oe=6A748FFE"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sryh8PnTAyAQ7kNvwE_EI7F&_nc_oc=AdolP8DrsQo7OoCl5EIb5SA3cFZI3CjD-Yos3jaKWUHiSwmztiLBOq1qls4ToUl6lQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlbE0HQ4UeP1gw4ZL3d7ZM4CiIGDS3L6y8ZyhGFv2Fag&oe=6A7481B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNaGkVPvXAkQ7kNvwHZqLxP&_nc_oc=Adrv9_Ho-F-GRvrEK57tbrON3PfrKuHLHvggdCMQUoRwmmd55xR-_CrDOPhAth3ZRZw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3hIE7gak9oc4lB17hCBXwafbiT5FK7ChG0C36J1t9VA&oe=6A7499CF"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also playable with either one or both controllers.\n", "short_description": "Explore the underground caves, find the gears and solve the puzzles to escape. But beware, you\u2019re not always in there alone."}]}, "developer_name": null, "developer_privacy_policy_url": "http://forwardthinkinginteractive.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Forward Thinking Interactive", "support_website_url": "http://forwardthinkinginteractive.com/contact", "website_url": "http://forwardthinkinginteractive.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "es", "ko", "cy"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "698329405159821"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "840252828968078"}, {"status": "PUBLISHED", "id": "2508620816218822"}, {"status": "PUBLISHED", "id": "1473467193643518"}, {"status": "PUBLISHED", "id": "3145982138906816"}, {"status": "PUBLISHED", "id": "1214281644122984"}, {"status": "PUBLISHED", "id": "1242426581146501"}, {"status": "PUBLISHED", "id": "1539980530454587"}, {"status": "PUBLISHED", "id": "1359990839251301"}, {"status": "PUBLISHED", "id": "803097985914456"}, {"status": "PUBLISHED", "id": "2010272633121965"}, {"status": "PUBLISHED", "id": "632149776169846"}, {"status": "PUBLI
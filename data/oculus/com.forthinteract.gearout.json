5iXbx-2GOLIV1-1-FCJAWCjM9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3WfD2AtC8XclWzzRalyvOdJlRUnD-yaO9MSDLFOScPFA&oe=69F0B9FE"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkykNk237IUQ7kNvwEh_pa9&_nc_oc=Adrl3avT1n6nLkeDgiYIrMj5MfMdDCOYP3xEzjhzEb2I8We9bk8igvuLqugDz_zE2xU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1VnkgWoaIJLpS21ZTbx9GY6EF-yCQI4KzpRKPtaNpxhw&oe=69F0ABB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVF_Kex09jEQ7kNvwHKunid&_nc_oc=AdqMON81cxva3WRW-zYoGRSk-_w-LdRTDMabsJz-irnwe9qT-2IYBZwgw-PhskYrCV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3lEm1vu11SC6sF3_3jdtl3ZbcdkX1AiodjNSbflW0Cmg&oe=69F0C3CF"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also playable with either one or both controllers.\n", "short_description": "Explore the underground caves, find the gears and solve the puzzles to escape. But beware, you\u2019re not always in there alone."}]}, "developer_name": null, "developer_privacy_policy_url": "http://
79080253601432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001703_679080256934765_5244425530880622471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii9LwwL8tnsQ7kNvwGxPyuz&_nc_oc=AdmNPm4uJdxQ1PR4qgEV5dIG5PlCOqGmOszNAdWyHsnlcfN9qp4J5H4OIT4UMLxS4uQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyqwcP_2ainPPvb7Eih73nn6Q2szqcSUgMl2ZMYBIQbtw&oe=69B2C37E"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwUYdYWM9AoQ7kNvwGCqzBm&_nc_oc=AdkxhCXAXKLF2h8BLOhugKIfbxXgJbfJIXxE54y1ULAqh-arx5SuhLoic6lFfApkVR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPJ5Iqfea2UMGcFtjYBZ98B_f6mxgGigPlhu2WxnmYqg&oe=69B2B530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jb1_QWR33MQ7kNvwEeRUlV&_nc_oc=AdkGzvjqHgmslDDEB9KRxRW04Lui_kdow0y4EUM4LHdAa4Mmrd-KyTB4Qf-1mcEFdVs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzL-Ue_zvli4tC6F-DEcIka2xiHQqaOqNjX-2jvQzC1EA&oe=69B2CD4F"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also p
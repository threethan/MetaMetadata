79080253601432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001703_679080256934765_5244425530880622471_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_cj8oDte4kQ7kNvwEIOZn4&_nc_oc=AdlOTnBcwguS4dTbv81oo9Khq-KhnaWJu6w2dgn42dUe7i_5v9VHcKkSehqkCtJ2a04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3y4vDGQNFyrm2PQUOKJjrDuvRa8Y2L3bi4pq5a12iEQ&oe=69B8097E"}, {"file_name": "gearOut_skeleton_in_coffin_2560x1440.png", "id": "657440632790719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303837_657440636124052_7175170353512171189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RAmIv8N0_0Q7kNvwHQFhMc&_nc_oc=AdmNMQy6peP7GNE5V_ci85SGvHoc4YxbcJKL8SM2YwJ5Mn7qhDXq169w2XysXlhIg7I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxALenPGmxY2auG4BGGGjP1fwH5Kbli19dmLEEVlAOaCQ&oe=69B7FB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_2560_1440.png", "id": "573593934780293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974744_573593938113626_499325477876599777_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBavvz_xXtgQ7kNvwG0-jD2&_nc_oc=AdmJ9rDiGtF59qrFSpv5HBc_W0kj-JVfS5B4geQBZineo3tRTjYePWvEvW0QVuyuNvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyK87C6w8a3CRoX46NDgo4SQ0Lh-WHL9trONwBysbZ4eg&oe=69B8134F"}, "display_name": "Gear Out", "keywords": [], "long_description": "Explore the underground caves, find the gears and solve the puzzles to escape. \nGear Out is a tense and immersive interactive puzzle game set underground. You must search for gears, interact with obstacles and arrange the gears on spindles to open the door to the next level. But beware, you\u2019re not always in there alone.\nThere are 13 levels of increasing difficulty. Some have time limits, some have additional challenges. Each level can be randomized to produce up to 9,999 variants of the puzzle for extended play time.\nPlayable from seated, standing or room scale environments. Also p
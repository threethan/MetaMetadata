ter mit der Umgebung interagieren und so die Welt der Finanzen spielerisch erforschen.", "short_description": "Mit dieser Anwendung vermitteln Sie Finanzthemen auf eine immersive Art, um die abstrakte Welt der Finanzen f\u00fcr die Menschen \"begreifbar\" zu machen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bevr.finance/datenschutzbanking", "developer_terms_of_service_url": "https://bevr.finance/eula", "publisher_name": "ImmBlend GmbH", "support_website_url": "https://www.immblend.de/kontakt.html", "website_url": "https://bevr.finance/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29810702638577836"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974681_1065700591940212_1546541029309288066_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzZ-GLv1ld0Q7kNvwH4Z1Cr&_nc_oc=AdqcXB2kq9OQ-31uFohoTRZNCTktOHFg3QRPKApmw2xaT1LGRxIU7pJ23ux9MVSJcgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSReSZ6po-mhr8dcXvNFgMzbLE-Qj-KCC9RjWdUKY7i3A&oe=6AFDD316"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BankingExperienceVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "con
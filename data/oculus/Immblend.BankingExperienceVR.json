.5771-25/39036647_3689785291279272_7693436945368737116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x01wnqGFq0YQ7kNvwENyNXb&_nc_oc=AdnEPpACbwv-zc0qIACQkNpK5uyydr2k4sNNY8qd9jHiJGCmrIMCdB7pl5GQ-0iWtys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvpEVxcP_qCOPctEacNObM_KJLbOqK1MXQpCx9yFPYxYg&oe=69984FBF"}, "display_name": "BankingExperienceVR", "keywords": [], "long_description": "F\u00fcr viele Menschen stellen Finanzen ein gro\u00dfes R\u00e4tsel dar. Daher meiden es auch viele sich damit zu besch\u00e4ftigen.\nIn BankingExperienceVR schl\u00fcpft der Betrachter in die Rolle eines Menschen, der die verschiedenen Situationen im Leben erlebt, in denen die richtigen Finanzprodukte wichtig sind.  Ebenso kann der Betrachter mit der Umgebung interagieren und so die Welt der Finanzen spielerisch erforschen.", "short_description": "Mit dieser Anwendung vermitteln Sie Finanzthemen auf eine immersive Art, um die abstrakte Welt der Finanzen f\u00fcr die Menschen \"begreifbar\" zu machen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bevr.finance/datenschutzbanking", "developer_terms_of_service_url": "https://bevr.finance/eula", "publisher_name": "ImmBlend GmbH", "support_website_url": "https://www.immblend.de/kontakt.html", "website_url": "https://bevr.finance/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
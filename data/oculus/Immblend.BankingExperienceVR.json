-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_784883937181421_8266013789177457646_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbGRaE0SnkQQ7kNvwHNS6fU&_nc_oc=Adp2Za8DtQ7SVwEEFIXrLMMP9f8yqyIB-FOq78L6EHNV2voRmVH1-E3gUlXeYfdezho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUR0hovaYWzdFNcCbdMdlKlIbMIVcZ2rWEQRBLLpllzQ&oe=6B0DCDDB"}, "display_name": "BankingExperienceVR", "keywords": [], "long_description": "For many people, finances are a big mystery. Therefore, many avoid bothering about it.\nIn BankingExperienceVR the viewer slips into the role of a person who experiences the various situations in life in which the right financial products are important. The viewer can also interact with the environment and thus playfully explore the world of finance.", "short_description": "With this application you convey financial topics in an immersive way in order to make the abstract world of finance \"touchable\" for people."}, {"images": {"nodes": [{"file_name": "Trailer Cover 8Bit-8.png", "id": "7257346717699001", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_7257346724365667_354465199735306419_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISPG3HILU_cQ7kNvwHnqqvi&_nc_oc=AdoDw6BA5HtpDxuW68GLSe7c3G8whuWh2JzrzSGd2cTF_b3Z41Pu3tZyl7YHtr-2iMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRj7tG8-XTKO3kHcneSXE-GJYfMh-YMaFV3PDN6ZQvGRA&oe=6B0DB773"}, {"file_name": "TEst Cover 3000 900-8.png", "id": "1440424583280694", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974531_1440424586614027_6243873380347803265_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGUowfkIjcQQ7kNvwHYeSzU&_nc_oc=AdpOMIW2XxXcVKGlO9m24dpNGqJWxcDhHKIkscfMLsVyzb4NTfQamq8OaFCtnXbgdUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqHT2lmcTMoGKqlUEytaKwRB3vqgQna8l3Bm
44760_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YXL2jb74gQQ7kNvwHAsO1O&_nc_oc=Adp5ZPluq8q9BBZJsmQtC1GEmovvfVzPRo9f_zHKKbA07I3WE8m0tJSws1Dvc02YqrI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQna30925293S3gsaXblOxe18ydWrM8tIxWit4IvTtVAg&oe=6B0DA3EE"}, {"file_name": "ss_d3e67170ba39ef9ca773d07e0b3dab65cb64404b.1920x1080.png", "id": "519501896634768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003276_519501899968101_3666167532333045361_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBxwluEa2sMQ7kNvwHdazW2&_nc_oc=AdolDiPGwKuZ7EQLrtRQcB6h-hGXjj9eVZIGLkuuMBKXLjy9wsxrUUj5tWPpd30sMco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0P01Ma3an0HBz9dYfIDW2ojf1VJ0Q6rXJ9q9FgWpI-Q&oe=6B0DBE5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimg.png", "id": "848855059562579", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982584_848855062895912_6314837845818043239_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSVRq76UXUEQ7kNvwEA8Xwz&_nc_oc=AdowY4IcnonaD2CzONEdbeWGzhjZW-BqyzGlcXmZqQu_Jeeh3w2R3gXDBAh2LUjNn7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXNCIiBmzMfd_MHRnChb5oLwZL1MhC8LrUPQDEZuzzvQ&oe=6B0DC340"}, "display_name": "The Obsessive Shadow Demo", "keywords": [], "long_description": "The Obsessive Shadow is an Indie VR Survival horror game about fending off a home intruder that you can't exactly identify... Keep yourself safe with nothing but a flashlight and your own eyes...\n\nWHAT'S THAT?\n\nYou're going about your business winding down at home for the night when suddenly you see a very strange emergency broadcast come on the T.V. followed by a knock on the window...\n\nWHO'S THERE?\n\nWatch your windows, something is close by and watching you...\n\nGOTCHA!\n\nyour flashlight is your best friend\n\nPOWER... OFF??\n\nKeep things quiet to avoid angering him...\n\nS
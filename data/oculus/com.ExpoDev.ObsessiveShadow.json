6e7a0a&_nc_ohc=Me49bjifzEgQ7kNvwHvLDKj&_nc_oc=AdoLfPM5lvd5onakx4-LdI9BQHpT5o6e_608sjyKFsZwfv2HOOBg5nXyk3Z8P3l-GpQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzkgsjX6JYhII5sNHAdO0PjwMrgT8kQgQW9WdNqNFEvg&oe=6AFB19F7"}, {"file_name": "questdemoscrn5.png", "id": "1084402754184469", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299876_1084402757517802_3491294572190596493_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlO0d-U1x5QQ7kNvwGo-66g&_nc_oc=AdqIhes8WISIJ6KHX1e5silkoDS1Y8vS759bJuDOF9Lc_wBnp_fjn-Tctz6SgzO3PRQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNiysf6eZNND5CA2e4RXHcumqsiLZtnZ8BU64dN_O2tg&oe=6AFB148B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demoq1.png", "id": "1693076352073722", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827960_1693076358740388_3356333982443193886_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkSgTqgb1rMQ7kNvwELL3Aw&_nc_oc=Adqlit1AQhTbo8QIXlMFPqUCybNSdBk9GWeqbJI3HlrGypbrDASYvzkkXDtev0_MQFc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCDvC6fMOHSRQ03jOBi5lezpSdMK86MyWCu9bm8Y6JfQ&oe=6AFB42CC"}, "display_name": "The Obsessive Shadow DEMO", "keywords": ["horror", "scary", "jumpscares", "strategy", "stealth"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away.\n{2024491844936765}\nEvery hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "The Obsessive Shadow is a Short Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://pmhinteractive.com/pages/privacy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive LLC", "support_website_url": "https://discord.gg/WC6fHGwq6U", "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28304178769210559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391934_1289530902133968_8310872907317805417_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c2tCFgzf_UQ7kNvwEnYaQ_&_nc_oc=AdpmA_dzt_VWlAq00uTRewPeXZOLITGwZXCkHG11V_z4RoB5BRxmEkO53n35luscZXU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTebTE3ElcrCi8uaRfxxKfnV_rWLPHF158KhiZeGwKItg&oe=6
png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e05wfjMH-oQ7kNvwE_wN_3&_nc_oc=AdrrprgAdcvoJ1-BahvI6nL51yBXR0ioYGrOlHSKQpxhzJVftbs0DrP85hb8exreULA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-Lbv_V9fitwZomPwABkQxoBQ6zIdqZcD7vus7QVQlGQ&oe=6AC8F81A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimg.png", "id": "848855059562579", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982584_848855062895912_6314837845818043239_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K4-Sv_aLXsQ7kNvwFQF3EC&_nc_oc=Adr3tBNl4-OuABc3qv5f-0roC_t9nfUJDQpEEpDAiefq5rdzcd8cjKHPpTgwt_fcZI0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbtbMuxZ5esoRtVAQzekio81hvz-ShosEYUIK4TMDmgA&oe=6AC8FD00"}, "display_name": "The Obsessive Shadow Demo", "keywords": [], "long_description": "The Obsessive Shadow is an Indie VR Survival horror game about fending off a home intruder that you can't exactly identify... Keep yourself safe with nothing but a flashlight and your own eyes...\n\nWHAT'S THAT?\n\nYou're going about your business winding down at home for the night when suddenly you see a very strange emergency broadcast come on the T.V. followed by a knock on the window...\n\nWHO'S THERE?\n\nWatch your windows, something is close by and watching you...\n\nGOTCHA!\n\nyour flashlight is your best friend\n\nPOWER... OFF??\n\nKeep things quiet to avoid angering him...\n\nSHOW YOURSELF!!!\n\nCheck under the bed, something is reaching for you!\n\n", "short_description": "The Obsessive Shadow is a VR Survival horror game about fending off a home intruder. Keep yourself safe with nothing but a flashlight and your eyes..."}]}, "developer_name": "Sleepy Dog Studios", "developer_privacy_policy_url": "https://sleepy-dog-studios.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sleepy Dog Studios, ExpoDev", "support_website_url": null, "website_url": "https://sleepydogstudios.net/", "category": null,
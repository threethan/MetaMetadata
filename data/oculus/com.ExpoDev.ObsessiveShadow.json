44760_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfrppWh5PcUQ7kNvwFqTWr3&_nc_oc=AdpMNJtwMZnhIKEiE89W3p2YkIbGCJC9tF8OePaHH7ZLQpkSXTMi24Whi9GkKwfEbSg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR9WfmCx1C6oxPi8cziPRC9YgBa2ACGbrKaIg5FVf4mA&oe=6AFB2EEE"}, {"file_name": "ss_d3e67170ba39ef9ca773d07e0b3dab65cb64404b.1920x1080.png", "id": "519501896634768", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003276_519501899968101_3666167532333045361_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4I4Sy4J1dsQ7kNvwEZVw-M&_nc_oc=AdrWkzGBPiTwZLrn-RrYx7sX2syyr2cOq0mEbIgzxX8ki4UH8k2V3Ku8RfLUBZi7Q38&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxxsswm74lILtZIvmVqZwMTt43d_towZIlHMTEwZ6-RQ&oe=6AFB495A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimg.png", "id": "848855059562579", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982584_848855062895912_6314837845818043239_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wi14rYfzb0Q7kNvwGSIvzZ&_nc_oc=Adredx4grt3oQHBDDI1vUDGhgspN2fUn_iEx9H6b_ESopyMVSXtbGpg3HvUOfg3IADY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo1sUfxqhpJGXXE5QNnzQFv0oFdM6-UczQznW1sm5ovg&oe=6AFB1600"}, "display_name": "The Obsessive Shadow Demo", "keywords": [], "long_description": "The Obsessive Shadow is an Indie VR Survival horror game about fending off a home intruder that you can't exactly identify... Keep yourself safe with nothing but a flashlight and your own eyes...\n\nWHAT'S THAT?\n\nYou're going about your business winding down at home for the night when suddenly you see a very strange emergency broadcast come on the T.V. followed by a knock on the window...\n\nWHO'S THERE?\n\nWatch your windows, something is close by and watching you...\n\nGOTCHA!\n\nyour flashlight is your best friend\n\nPOWER... OFF??\n\nKeep things quiet to avoid angering him...\n\nS
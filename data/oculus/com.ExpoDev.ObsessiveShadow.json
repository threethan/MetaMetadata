6e7a0a&_nc_ohc=pmHY5qtnlisQ7kNvwGO-ptm&_nc_oc=Adr0FTPnVO-cGbsE8bnjukMjK53K7rz1VT8EcXh0gXuSt-Wfe6lc9bHmnJdsHDkSc_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE4572egpE_1Ea8flnPYLQepiEiQyLgsh0T8QBTiNJ5g&oe=6B05A5F7"}, {"file_name": "questdemoscrn5.png", "id": "1084402754184469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299876_1084402757517802_3491294572190596493_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkSiaVit-GcQ7kNvwG2cDFz&_nc_oc=Adqd8btSky6DeMAGimvZVs1WAuHZhrYaMolVXu2SGDNQeEaFqlOlM1Uz_d6hLYc0D8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2NSENkcr6pNbS8Fvfp9R_Ojh7W7p5Co_IHusNLzYP1w&oe=6B05A08B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demoq1.png", "id": "1693076352073722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_1693076358740388_3356333982443193886_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmsq4zHQeEMQ7kNvwGt9Vti&_nc_oc=AdqYjyIkE5afzpFbERHg7R6ky1A-p_ZcgvzhgnuIQrFkPu2GrQyg3xWFMRW3qx_pyTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_o_8FKwDqoEL8_ZLIaF_mh6fT5Y7k-zhcNThd7IJpnA&oe=6B05CECC"}, "display_name": "The Obsessive Shadow DEMO", "keywords": ["horror", "scary", "jumpscares", "strategy", "stealth"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away.\n{2024491844936765}\nEvery hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "The Obsessive Shadow is a Short Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://pmhinteractive.com/pages/privacy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive LLC", "support_website_url": "https://discord.gg/WC6fHGwq6U", "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28304178769210559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_1289530902133968_8310872907317805417_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GTQ-JnHoJQQ7kNvwH3GqvO&_nc_oc=Ado5LSuYobMLqLeA4cHItEuxqMxPyefqo8i3r9XT-jbvCzZmd_dXSMuNHmzmmoV-Smo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1jgvoLpp7MxXr2OgNiqPo3hH0zifMaG-EgL9iP8x5TQ&oe=6
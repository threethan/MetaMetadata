937890126378653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393368_2937890129711986_4420291210556562702_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvQkRrd1p1kQ7kNvwE33vTh&_nc_oc=Adp6Hbkh4LCiPQVTMN4AFO99OIkcDgYYRJvh4Ze5AyfHL7G9To5qu5iO0QOzr94kczc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoSfphyf6ekBql74ey8M_x4tv6YU0jw9DMD4WAK2xr8Q&oe=6A511007"}, {"file_name": "ss_3f3ec6cf3dcd60d9d9e168399f9f1c277f5d0bb1.1920x1080.png", "id": "1975696369594785", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391982_1975696376261451_625062873347035175_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_Ym-CVXUGIQ7kNvwGHTWCl&_nc_oc=AdqJOCv4f4qe3IiDaUZizTQkGPepRrzEep3gDMXG3ZogF1YSiXIMBRieStq81FPNV7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHViMKJus5JXuUZIH1m6PNXcOTcO3lx03_O0CEWRofVQ&oe=6A50EB25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demoq1.png", "id": "1693076352073722", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827960_1693076358740388_3356333982443193886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzm5LDZN9lQQ7kNvwENSHwx&_nc_oc=AdpkGXACX0ev_i4rWqKGBM5hegWWsvQekNyBS6Q7QvNOSgn-qX7eDddf5-jJ37Ce6n4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2MS3RcH8imIaF8AUEqVSAl6UyX8L40mrO-X97yMf_yg&oe=6A50F90C"}, "display_name": "The Obsessive Shadow OLD DEMO", "keywords": ["horror", "scary", "jumpscares", "strategy", "stealth"], "long_description": "NOTE: THIS IS A VERY OLD SHORT DEMO VERSION! THE FULL AND UP TO DATE VERSION IS AVAILABLE FOR PURCHASE ON THE META QUEST STORE:\nhttps://bit.ly/quest_shadow\n\nThe Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away. Every hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "Note: THIS IS AN OLD DEMO AND IT DOES NOT ENTIRELY REFLECT THE CURRENT VERSION OF THE GAME! \n\nThe Obsessive Shadow is a VR Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://pmhinteractive.com/pages/privacy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive LLC", "support_website_url": "https://discord.gg/WC6fHGwq6U", "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26257160930579030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/47339
44760_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YXL2jb74gQQ7kNvwGgAS3v&_nc_oc=Adqm63HhGQMEGiiSq-TIpVUZGOY5eCpgLwlNdHlET7rVZ4LpArAjZYvpvi07GIzA4Yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMXNdCZ1IT0CSJz1usy2grUzZC3jxlnIKkG-0Qkld09g&oe=6B0C526E"}, {"file_name": "ss_d3e67170ba39ef9ca773d07e0b3dab65cb64404b.1920x1080.png", "id": "519501896634768", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_519501899968101_3666167532333045361_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBxwluEa2sMQ7kNvwFz4YA7&_nc_oc=AdqDoIniBjr0zGpcNytStiPaEKHTDML6G8VI2cx1O4ZWVW6qXBhGMxNV_mDHLCJVDF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzCRItypo6kBTw6BnQ5iFomknxyLT5og5ClVNhxn9DhQ&oe=6B0C6CDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimg.png", "id": "848855059562579", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_848855062895912_6314837845818043239_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSVRq76UXUEQ7kNvwFws_9P&_nc_oc=AdqHGlGni60CgA_XrRiCNo4AcY-dXh2DgeNzqpuMAob8wfoiZEZJFiYPL_u0M3Sf_KY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSURmr732dTWuhtG-CB0ruk4OJs-tDZrKvGhuevCuR0uw&oe=6B0C71C0"}, "display_name": "The Obsessive Shadow Demo", "keywords": [], "long_description": "The Obsessive Shadow is an Indie VR Survival horror game about fending off a home intruder that you can't exactly identify... Keep yourself safe with nothing but a flashlight and your own eyes...\n\nWHAT'S THAT?\n\nYou're going about your business winding down at home for the night when suddenly you see a very strange emergency broadcast come on the T.V. followed by a knock on the window...\n\nWHO'S THERE?\n\nWatch your windows, something is close by and watching you...\n\nGOTCHA!\n\nyour flashlight is your best friend\n\nPOWER... OFF??\n\nKeep things quiet to avoid angering him...\n\nS
c_ohc=TwaO-5Kp0McQ7kNvwFesA1o&_nc_oc=AdnrQodqaFeQzBrSoowL2bPRcYoXp0svhW-shVBR3hpE6c_MnM8Ks0WXBC93YG5dZxI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvdX2ftOacd_8v6NnsnBC6A7UBXoNEr9eoqA_M2xzjHbw&oe=69A18047"}, {"file_name": "ss_3f3ec6cf3dcd60d9d9e168399f9f1c277f5d0bb1.1920x1080.png", "id": "1975696369594785", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391982_1975696376261451_625062873347035175_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dGBeAsaVosQ7kNvwGXayjr&_nc_oc=AdlNpVkeL38Ys9IWJlYFoq15xPnvixAl12eGEkbzkWWctnztQTvT6vkC5BhLQSvefbw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu0kr45JGnXH3iuQwMxX9F1qQI3JkYGkdO-7uEq4oToZw&oe=69A193A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demoq1.png", "id": "1693076352073722", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491827960_1693076358740388_3356333982443193886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Kt4_ZCoW0QQ7kNvwHPcYfl&_nc_oc=AdnyoxH2vlZYUxNHwUKuPAPARGjjQcNMIvRiBDLM4j97yOry4eReggYFpF5MoI7Zhes&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afut0c8YmWTbySLI1c3fbcr79jnddeXFa_24ftF7bdh40g&oe=69A1A18C"}, "display_name": "The Obsessive Shadow DEMO", "keywords": ["horror", "scary", "jumpscares", "strategy", "stealth"], "long_description": "NOTE: THIS IS A SHORT DEMO VERSION! THE FULL VERSION IS AVAILABLE FOR PURCHASE ON THE META QUEST STORE:\nhttps://bit.ly/quest_shadow\n\nIn The Obsessive Shadow, you take on the role of Liam, a 9-year-old\nboy left alone in his home after the power suddenly goes out, plunging\nthe house into suffocating darkness.\nArmed with only a flashlight, you must navigate the unsettling dangers\nof the night as you are being watched throughout the night.\nYour mother's voice on the phone is your guide to surviving,\nBut as her instructions grow more confusing and the unease deepens,\nthe safety of her words begins to feel increasingly fragile.\nSomething is watching, a shadowy figure moving just out of sight,\nwaiting for you to slip up.\n\nAs the hours creep forward, the once-familiar home becomes an\nunfamiliar labyrinth of fear, each corner hiding the possibility of\nconfrontation with the lurking entity.\nTesting your courage and instincts as you struggle to stay one step\nahead of the unseen threat. Your mother's voice remains your\nlifeline,\nbut survival demands more than just following her instructions\u2014it\nrequires vigilance,\nquick thinking, and a determination to face the overwhelming dread.\nWill you endure the relentless terror and make it to morning, or will\nthe suffocating darkness claim you before dawn?", "short_description": "The Obsessive Shadow is a VR Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://heckmanpablodev.wixsite.com/pmhinteractive/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive LLC", "support_website_url": "https://discord.gg/WC6fHGwq6U", "website_url": "https://heckmanpablodev.wixsite.com/pmhinteractive", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25854049004223560"}, "review_messages": []}]}, "cover_square_image": 
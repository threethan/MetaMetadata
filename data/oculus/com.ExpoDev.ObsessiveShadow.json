ohc=OOzxsK3NZzgQ7kNvwELdOEo&_nc_oc=AdkyqJUKb4-HleFHUampbsLl_nN-cJAJxu_NN_OmM2GOabCccKM0UZ9YI7xZjKkujTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftZksS9CO21qd_MO_C2xDZZsZ9N8jxdntHVZ73Ly9zDww&oe=699C3A47"}, {"file_name": "ss_3f3ec6cf3dcd60d9d9e168399f9f1c277f5d0bb1.1920x1080.png", "id": "1975696369594785", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391982_1975696376261451_625062873347035175_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5Tku6eWPZcQ7kNvwFzBh3c&_nc_oc=AdlNcXjIHLW_6qggomKX54Z5CMQqe5SLFF3tFx9tFP-5Vg7JX8LxFUvUjMGVcSgfDgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfueyCBjEurvquSfSji56CtR6qAUc0Tb_Sy7pEYkCT4imQ&oe=699C4DA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demoq1.png", "id": "1693076352073722", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827960_1693076358740388_3356333982443193886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CDV0mn9VOEQ7kNvwFssbQV&_nc_oc=AdkfTk-xinFm0606Z9gyaMAhKg1ESQrcwWAXpJF7OnMjae3hMlYvhvKMDNRlORPbSkA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu9719nIPbZyOCJ2wc26tCnUA2YXpYOHjNd5rQs2-T2Bw&oe=699C5B8C"}, "display_name": "The Obsessive Shadow DEMO", "keywords": ["horror", "scary", "jumpscares", "strategy", "stealth"], "long_description": "NOTE: THIS IS A SHORT DEMO VERSION! THE FULL VERSION IS AVAILABLE FOR PURCHASE ON THE META QUEST STORE:\nhttps://bit.ly/quest_shadow\n\nIn The Obsessive Shadow, you take on the role of Liam, a 9-year-old\nboy left alone in his home after the power suddenly goes out, plunging\nthe house into suffocating darkness.\nArmed with only a flashlight, you must navigate the unsettling dangers\nof the night as you are being watched throughout the night.\nYour mother's voice on the phone is your guide to surviving,\nBut as her instructions grow more confusing and the unease deepens,\nthe safety of her words begins to feel increasingly fragile.\nSomething is watching, a shadowy figure moving just out of sight,\nwaiting for you to slip up.\n\nAs the hours creep forward, the once-familiar home becomes an\nunfamiliar labyrinth of fear, each corner hiding the possibility of\nconfrontation with the lurking entity.\nTesting your courage and instincts as you struggle to stay one step\nahead of the unseen threat. Your mother's voice remains your\nlifeline,\nbut survival demands more than just following her instructions\u2014it\nrequires vigilance,\nquick thinking, and a determination to face the overwhelming dread.\nWill you endure the relentless terror and make it to morning, or will\nthe suffocating darkness claim you before dawn?", "short_description": "The Obsessive Shadow is a VR Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://pmhinteractive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive LLC", "support_website_url": "https://www.pmhinteractive.com/contact", "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25689652017329927"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculusc
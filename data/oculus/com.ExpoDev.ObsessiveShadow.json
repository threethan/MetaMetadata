44760_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCWZkkzIcvUQ7kNvwGWAzpQ&_nc_oc=AdrEYj27IUEevbLMMvi9rFqCB3WohawP2gZB-DiAb8HmlpXEUQ1XZBwxPUvBDW16oaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTveqh8Rm1XiNGmAVmqjUSNUNciO30rP61MSGnvkoFtIw&oe=6B04696E"}, {"file_name": "ss_d3e67170ba39ef9ca773d07e0b3dab65cb64404b.1920x1080.png", "id": "519501896634768", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_519501899968101_3666167532333045361_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6dRIFDEAmkQ7kNvwEv8Ovw&_nc_oc=AdoG3CI25vRpP_1fRbaXY0YFlCo5mrPhbdZNqS5essQqKphcyjzoMHd2DdLIwzxykY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5aIxHmirIRBZR9vC6ypxUKWK34Vt3kojdWteN2wWxCQ&oe=6B0483DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimg.png", "id": "848855059562579", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_848855062895912_6314837845818043239_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbcfQ9JZrnwQ7kNvwH9qlh9&_nc_oc=Adq7Hw367AaB9AJMjXvKumg9UMMdXxsp0pvNyy9js_9ZWoVT2WTt6yOLflFnNIRVvpc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5oxuJV-0WvWazFgwEwRFJM9ciYiT6Zy2P7FjGAqRY7A&oe=6B0488C0"}, "display_name": "The Obsessive Shadow Demo", "keywords": [], "long_description": "The Obsessive Shadow is an Indie VR Survival horror game about fending off a home intruder that you can't exactly identify... Keep yourself safe with nothing but a flashlight and your own eyes...\n\nWHAT'S THAT?\n\nYou're going about your business winding down at home for the night when suddenly you see a very strange emergency broadcast come on the T.V. followed by a knock on the window...\n\nWHO'S THERE?\n\nWatch your windows, something is close by and watching you...\n\nGOTCHA!\n\nyour flashlight is your best friend\n\nPOWER... OFF??\n\nKeep things quiet to avoid angering him...\n\nS
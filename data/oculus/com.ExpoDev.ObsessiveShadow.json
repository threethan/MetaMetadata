6e7a0a&_nc_ohc=Z1rjCeHWVXEQ7kNvwE5dat_&_nc_oc=Adoovof_Gm_PpCwcyj_xxQ2orCmgrKVPf9gX_Qs2f-Fq-asQL_8AcUfyKclaHg-nAuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwY8yR-5nAlNNHMr1GfhA8-T1EUpz3Nb86DpJDKrTIDA&oe=6B005FF7"}, {"file_name": "questdemoscrn5.png", "id": "1084402754184469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299876_1084402757517802_3491294572190596493_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geVJRXdN2csQ7kNvwHKWBtt&_nc_oc=Adq8tdjbxfb8EdshW1H2ku_VScIaiuRJy39DMI6TVjwukUdnPboUOU7pqy_BTSCEazs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROB2YSMieSJiSlatKlGfUUKiUULH4QIJSotOzjRnqCgg&oe=6B005A8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "demoq1.png", "id": "1693076352073722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_1693076358740388_3356333982443193886_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGswSsWhoVAQ7kNvwG2vH77&_nc_oc=AdouWT8Qy7iMBEPuUO0iQKJd_cT4ArUBKHULy0O2YvF-inlpXpx2wHbolhDmGh6XipY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkoX1ZUJXS_fH58nul15mg9aUL6iz1gjW3GsoQlwIamQ&oe=6B0088CC"}, "display_name": "The Obsessive Shadow DEMO", "keywords": ["horror", "scary", "jumpscares", "strategy", "stealth"], "long_description": "The Obsessive Shadow is a short survival horror game set in 1986 American Suburbs. You play as 9 year old Liam Robertson. While watching tv, the power mysteriously goes out. You quickly find out that your mother is missing when a strange phone suddenly call becomes your only hope at surviving the night. While only armed with a flashlight and a familiar voice on the phone, you must rely on your eyes, ears, and pure instinct to keep whatever is hunting you away.\n{2024491844936765}\nEvery hour that creeps by, the rules for survival change. You must adapt and overcome whatever the night throws your way. IT. IS. HERE. With 3 different endings and multiple achievements to unlock, you must push through and face the darkness. Will the increasingly odd instructions keep you alive? Or will this monster catch you when you least expect it?\n\nCreated by\nPablo Heckman", "short_description": "The Obsessive Shadow is a Short Survival Indie Horror Game about a stalker you can't exactly Identify. With nothing but your eyes and a flashlight at your disposal, it's up to you to survive whatever horrific person or thing is out there watching you..."}]}, "developer_name": "Pablo Heckman", "developer_privacy_policy_url": "https://pmhinteractive.com/pages/privacy", "developer_terms_of_service_url": null, "publisher_name": "PMH Interactive LLC", "support_website_url": "https://discord.gg/WC6fHGwq6U", "website_url": "https://pmhinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28304178769210559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_1289530902133968_8310872907317805417_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paWyM6XIAA0Q7kNvwG0Nu9p&_nc_oc=AdpWk_RC6II1Ukxec-mku0iZIxWM9rN4rBud3CBZmMT6gMTSvyWMCmm29oyxOeBgojU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSEQ2SdgQLLc7rLAOxEGsoTEpLuXsj4Qf7Ai7FoHE5Fw&oe=6
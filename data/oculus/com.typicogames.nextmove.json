t7Yn8VsVMLli87gK-lgSUoBFIlye_jpC6xQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwalUTSRg7abOgGoMVP4ptyoRBWC2aBaZK6D1GY5c-o2w&oe=69BC0EEF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pT4h0lNKGocQ7kNvwEz9ey3&_nc_oc=AdkmcjPiPGEgCtFy6n1oE5rn1Aiiqqu1FUZgregG1G4KQNnnXFi3-7APnXF3qhV3KHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwK8jCx1TzEQEoWsAd_aPs_NK93ki7hZi2X8d6f4Nt-9A&oe=69BBEB7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUyGRcoRR9QQ7kNvwEZ4Ys0&_nc_oc=AdnDlqp4DPY4omBcH9dOPXBdEibekV6kElom6z4tHDXqEmLKsExGZKq43Ey_VkAW2D4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1D17TltjJlm2EgKJVWNg8h2odXKg0cTtFRWEf-WIdXQ&oe=69BBFF74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj4PKyOnpeoQ7kNvwFsjPES&_nc_oc=AdnX10zj-271_mwAL4hJ_VmpW_RE3Wdw_rcm3wkLS8p5ICa34H2DFx2VfAZcH17V50E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxysJBQIxeITfYhcSjYylBEe9NixAn834mH5Bj1MWIlcg&oe=69BBFE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZAex0FdB2oQ7kNvwFcLkiU&_nc_oc=AdlL0RIXeRTfdPvCzDJ9UCRYkqiZCZc-uRCKylG71LTZZ84MfB1YMziDCX1G9olIFQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYPHB-3SDyXGgKZaL4bsdhWZpQYjT3B38yD4upDD3pvw&oe=69BBE22F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
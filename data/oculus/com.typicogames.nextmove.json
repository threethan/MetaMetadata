7f20f&oh=00_AQKRd6v9fyN6Bu0NzZVgVhNOfNRAr8_V8PNdhxuCa5KKcw&oe=6AAEA2EF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdN9_eQS9BsQ7kNvwFFRriC&_nc_oc=AdqoHbCXeNDN_Oz0OAWkaD9FKAJ3drPtH4fgwXerNWPBfG2Jbun4HrvLqHiBk29Gpn0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLapuv26OV6dKawcfoeR23SmFXbBvoBy56UzxGl9cAhA&oe=6AAE7F7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSBiEZR2EO0Q7kNvwHMY3_A&_nc_oc=AdpcJi-clm0xikulQG2uz-JwvWVm2buWnho973eu4FB0CtY0isuH2v078Yrey3W3VI0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf2TBC5PJd_9P8wq9MRK_GqUuMigkqLb3gDC7ZTyI63g&oe=6AAE9374"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TciaT9nNCcoQ7kNvwHiIDIo&_nc_oc=Adot0fBg2JWRXe6zeV8pMZlPjU7dyJNjD9jzUrdXZIq329w1bCfQvLxaHEnH_g_xPpc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1-lzlRgqurFzO2gKqmpjWU83TKimA-mpFpWjkbF7TdQ&oe=6AAE9296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUOEJdl6VmcQ7kNvwGKVm4E&_nc_oc=AdpgiipNiNLzjQlOJXTxqFf-dGpeNumY3xzWvtf-mviuXmlQao2URfR1GUuC1cvQLAA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUJeJ7DAPpBh7jdm6_8sKtWwRI_P2Fwuh3VSb4H3k_Hw&oe=6AAEAE6F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
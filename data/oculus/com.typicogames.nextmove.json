f&oh=00_AQKm-uw2FpVFPPrrbcZ-ix4UQhYvgZIlGZe2FC59USweOA&oe=6AB92EEF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZ7gVK9LpLYQ7kNvwGsIMNW&_nc_oc=AdouqteaYTJ-QlHeyvNtrss5f539ybfbiOtZE1J-NGp2r-YIxrumR2Gw1BH7fq-m3PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPqRBNzDM5TJ2DzAhTo6ACjAXpF8t0jZQlUCysEQc2Cg&oe=6AB90B7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qETvhsqtUCgQ7kNvwEDcIo5&_nc_oc=AdpL861hKmDR3mp2Y0Y_hpbiwDDEec_bdSlc8UBeLZX55_v1f-rnUhrpL0OV7v8Rcco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAyXjZcqJKsnYXiX8vCCfY8V0aQjfI14BfL74E1sEnhg&oe=6AB91F74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ51gDI15ksQ7kNvwEcgNHU&_nc_oc=Adonf9WxWH9HGelOoagx72bjcrD4NKzCzzS-7Hu-wMt53Wua4J2XnPXp7wenJuiS_uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIci1CainuJVQtKhzmLV1jUYtW8g7P-EuTpoweFWyVM7w&oe=6AB91E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQFDSGZ_T5cQ7kNvwGsKQU8&_nc_oc=Ado0mvWIwf2t6DtspOP2RucZ2yPdwBi_IO-oKqz6WPgB1NcmH9_SEaz9Uw6u4s3Dlso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuyMmbdbNodPyMalLP_u15IDbb-SuUBxLUxpJnUh4H2A&oe=6AB93A6F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
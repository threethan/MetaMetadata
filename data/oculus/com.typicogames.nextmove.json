e": "S02.png", "id": "1056640998680341", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74DfIHAtogkQ7kNvwEqm3RK&_nc_oc=AdqblVJo3QyvksdRT9Mfy8Ph-Evh3vljM5lrsJLJsiMhweUeJ_TyDX2BGXkStHqGcok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3t2Q0rcM1mUsjgZEz0AH5w79wmdy7MnxD1wcKOIhjBew&oe=69F34A7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbq_skjlY0YQ7kNvwFufAOp&_nc_oc=Ado9Xhu8TFfsRvsOgKQLb28oP8GEmRFUgLMU5XbP3Xf_slPSb9ibP4-rPhokrIyqysc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ggoDxoxZu2EWptOjpSul8_op5kYkXH9cA9Gy_zTJtJA&oe=69F35E74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjwIxiX-SjIQ7kNvwFo-Njp&_nc_oc=AdpeQaLWw6RWQOBhVYh_BzhElX862kXcnug0PnYSlzM_L67zzuqDu0tXbx1Ne7p4QkM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af292PosDIq2-QqRqXCMswUYqoSdEIvIjI5Ynu_bwgXEJw&oe=69F35D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwBheL3wyz4Q7kNvwEUwgPg&_nc_oc=AdrAPHW26hoUtCfhA4trvXyaeBkRVqJ19_3EjBDfvCTa_T2LpdePRMIuVL2p5QF5cAU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hNrDnLGW7Ywe6lIBJmtRaBuMUfDxWiwGJKG4x4AVgWg&oe=69F3412F"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gr
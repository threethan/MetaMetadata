02SsohFcQcFvbk0KHvHqPCu5Dsa9IJ-qBaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzIpDLyb42EvKixTG0H8gNL1PBhIDRaYOkiTpa5JqJXIQ&oe=69BA852F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pT4h0lNKGocQ7kNvwHGozk2&_nc_oc=AdlJ8aHySfEAlaKLbcg300n01ExyjWzTLOgf30LaHqJhY73AhwdJPgq2Jwc9YplH6dU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfytsNV3JEopkiSNUMt5MnyX9arpaOKhabJoVRXIcAL2xQ&oe=69BA99FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCMjo9x2DxsQ7kNvwEWQ6h2&_nc_oc=AdmWuk6qLa5eAdk19Kju4YwF-YfFlg65MsGstcSxRgrTOSTG49LSFr5jRnMgTDj5Azg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwE3rHlel6PbfXBOYKAZW1lZCvVlL_84XWh-I2NDaLF9w&oe=69BAADF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj4PKyOnpeoQ7kNvwF-luP0&_nc_oc=Adnbkd5HAoI7WhhikYR5_hsvON6xM_o2ta7wv3CzTbFemyPdoEGqJpCMZ4Y8V-MvEps&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2QsJMrZP714oDYlio-NMrT3fbdW4pyDJylFAb6vxbsA&oe=69BAAD16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZAex0FdB2oQ7kNvwHQP-6e&_nc_oc=Adk5gRvLRPHZWEFgQGL3MMaCAGqjQBiNRL7iOPY4QDGYk27Xht2IAnWT2_i3W1XvwvM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyC9HTdItQQd53DS-xSk9KteUB6IBb-joP-tCLaNG-muA&oe=69BA90AF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
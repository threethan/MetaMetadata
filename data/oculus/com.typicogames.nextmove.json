f&oh=00_AQIwTcyTCdhaRDHI4eAqaBS9GX5uRQ6EZcKC4HhmCf2ZmQ&oe=6ABBD1EF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cDdxvL_K8cQ7kNvwF2r60S&_nc_oc=AdqL9Y5FwQapaE-osuiuwOlxeBP8Wbxumji8LcszfKp966aHpkhiMhqYN3u9_-LC3rA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP_WOJl1WchF8vAiYyhAXqPW1TkAKBxDGMnzZ33H-23g&oe=6ABBAE7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qETvhsqtUCgQ7kNvwHkV3QV&_nc_oc=AdrPYTNsh7M8w1mV2pPuuEC2G8MJEw6DBCw7cYKqeSvAZtoOEzDZxpXwKtKUcegIH_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsFfC3Rk5qB4o0F1dF0fxgBxKU2e2_lCIl10dft6_y8A&oe=6ABBC274"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nePCDo_KMhAQ7kNvwERMjD2&_nc_oc=AdrkcvPwhvnINa_8F2t_nwDGmTtWaVqfOnVs6ynuaeAV2i9DCOQE-EL7QiIg29OfazY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-resy0jf4x1mNhFq0alDO-aogUyBqNBR4wXiuucxH6A&oe=6ABBC196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjVO2FS8nrMQ7kNvwGv9CwW&_nc_oc=AdryqtFwqCXAr-5_51iS_P4L96o5-YqP_yENPncTD0FUPbkihVFhFmwDhohOLQ74mdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8qYZx4pck4zDgy-qy0lxqYyy5mS87bsPGG4_VmR3oLg&oe=6ABBDD6F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvd8WRfVt2WnWMRf21EU25dM5jjdUCte8mXVRnugEmkhw&oe=699C477A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYeGj31IK7QQ7kNvwGOF-BQ&_nc_oc=AdnSdmkfa9kS7DRgE2E8VO_A6HlWW56jl2kIEkqv9pBlASlQILTrCKlphwvHuodcOk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsFqNStFCRVE0J3K3j6BK5IGz-7-SprjxHlZpuIrjbPFQ&oe=699C5B74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8GomKKQig8Q7kNvwFNNKug&_nc_oc=AdkRFbXabvJUmPGIrgVw-TB-Zpqep-sIwSGx_ssaopLRmMWQHe4oASXAsva9yaIwbOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvy0OkXqV-uT4W0TmfB4vEvHDCYQ7ioyFVgV5_ScAa3MQ&oe=699C5A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMHpdOpVPYYQ7kNvwEM7m7x&_nc_oc=AdkVunUYfZrSpsRINt1bnGj2eTqCD8nniU6xCfg5EkLQvnZLuUTofnFTzgN5CxJJDmQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu0afnEbm1_rFuTzOmPe1gxGh6k27zjUQ03_0SdL4uqFg&oe=699C3E2F"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6785834638189983"}}]}, "scheduled_offers": {"count": 1, "n
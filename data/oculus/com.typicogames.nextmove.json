4_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvhUb-hHyQ8Q7kNvwGngZ3j&_nc_oc=Adon8OXMZvSFLwjcUTaW5LvLndsn1m7qNT9V5BG3UQO66225QI3o1tYKFtUqXwwVaXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbQ88KTMmBIe17JKlCZShzOSb5Oa-vJ5HoSp3DjpRyLg&oe=6AA544FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-tBB9nMiPoQ7kNvwEa-tiw&_nc_oc=AdrTQzCd2-SEb0CsmGdyZmq74KazFKnC5GB3LbHx9Khrxb9BLzAvBZxOECG8W7cAh7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNMpiTNaSksUvfNtQucU0UiaKq6dQsaMQJcWNBahk2xg&oe=6AA558F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuwPz_oefQEQ7kNvwESlhze&_nc_oc=Adp-gwUw2y_fhyXv8EQ2oARX9uO0Lp1rgMCW-0-PCi8YxuLFB34x_D56Xxg7R9nxkn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIneZa8o6f2MJ-Rl9Sb2hESETj5xGJQzkXoXpkLYoF3yg&oe=6AA55816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cksqtELFE-cQ7kNvwH97Djh&_nc_oc=AdrGoMfX8kFII0IiWkAMfw3S3_iLtDFJTTvNsJGoPGE7ID72oKS8wVoxxp9bs10Emls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnLBJoQ_UI7dTc8hG-kA-PuRIHSSh5-7L-jFzu4ss-Yw&oe=6AA573EF"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
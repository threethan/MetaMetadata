1TS&_nc_oc=AdqWgUxp1lLHGQti2ZdYv2w9Hd1G4JJ9cf6jPZbwcNXnV1676jaW72b9IQr4jvCWqpw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0USm4v7f70FBhHbOuaq9z9xpWb0rza475Vqyt_x69bw&oe=6A8EC6AF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uoj18u1msgQ7kNvwHE4Pm2&_nc_oc=AdpF5dcVn6r_ncsNOEiHjCxq72CCMiRdyJV-NrCVIW7vOAKY1NPC69dSrQf_YNIuBNg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJtbUTBZNrk5YUfBHUAEcZAaxXEjtkDz-kJxs0pqD8ww&oe=6A8EDB7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XHNeBlNeOcQ7kNvwF5Izvs&_nc_oc=AdrSpmyONPAtrZpRcsyNCmbQnmoO0-EZSQjBYugot_zEK1LJDdJdEf0GBntKRqwAm0o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeFtB6fDapxhSYi1nGGrjHaF-eRYAW9Mupo44gQVurzQ&oe=6A8EEF74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuoZhhFmZiEQ7kNvwErhHzr&_nc_oc=Adpv_JrK1hUIPcN1uHsZmZMuMeEj-pIZ10vbpT3Zoeu85K77H_gMEwFdj4g84c6bEBE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDWZlTK1H49QqXn0EMalsCUU_CvPwReCXZkSk5A4748A&oe=6A8EEE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLbwVj47jbUQ7kNvwF4QwMQ&_nc_oc=AdpRWVG3kkdPIOZ-A_aDWvYcKXClljfuddlVyHSH4iDyu6lhyNW8fuuummwubfA6vyY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRFfSNy7Buy-fNaJPB1M4NFHCpr6q0gA-_1RB0r2OUnQ&oe=6A8ED22F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
f&oh=00_AQMAHnd7oZSrlF2SHyDPTpKk6nHxaDxFs1ihEqNkqvaC9A&oe=6AC7AF6F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5kYOU1OXXIQ7kNvwEajY2p&_nc_oc=AdrtEmUm9i47Go8Mxc7W72o7fcw4ke9x6Shm0jAJTPxqOofs739O8L9QioEafuveLX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2qyLHnG2RJ0sr471qyaGhz4IfPyGgpdX6iy7URIhDtQ&oe=6AC7C43A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81i-B6k8a20Q7kNvwFeOUsP&_nc_oc=AdpryLf24sPaDf2eOvn4rKv5_TDnPZRE6AJykTRCMV-Jf9in-DyNKl9WbogCMJ3cYt8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO94DHqLnodPOzHIVTDRJM3JTaz0k-xSHfzD2RGC4R8RQ&oe=6AC79FF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwIiZy29qsgQ7kNvwFG1Ndh&_nc_oc=AdqvoVtXqQz-TZ4h9NL_g0FyULFBAYSZiZhOkhQ6RCiVJktS4J9gKxjan0xBaTrzzAk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYN3xMDGzZtqLav6WkmUYRlcd3ZTKkrHnulFNC9RngJQ&oe=6AC79F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT5TNhlWdokQ7kNvwEfAblU&_nc_oc=Adq8D4WoL6p7NVP4ekHXA6ojFNOHa0yYFDjxcDmYFXT7qRTP2ZM3AGXbVSMrD9b41wo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLWcB0pgbRPJSc_wW10n4ZN06aXpmcgejwzwuMiBm4Dg&oe=6AC7BAEF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
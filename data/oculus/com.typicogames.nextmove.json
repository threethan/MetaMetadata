SyWxi9_WjKJx1Y7mwoZweFsaAIvtiX9ZPpgLd0M&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPh55ZvC8Taxj_Liygu_KdqmS4K4Y65nBrTMSoHjFubw&oe=69AAB32F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSpakzCiy-wQ7kNvwGiQLmI&_nc_oc=Adl9a1Kv9SoviCBhEnEJEUNYRvux4TY7oM2A-0FKfv_OHF5aYPh3-fOIxA5_k6nFk5E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvlUhAxcEW3S_F7fecIGQ0ExRNZ7O6s6AMKkY3qa7Acw&oe=69AAC7FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNy7VYObEJYQ7kNvwGPpheM&_nc_oc=AdlQLMBy_t-tW6KQmqJs989-EXihoAWvnxdpmAEBJg-lxvFnIhwk9qYb3ypwq_VmLj0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgTLw7KUzOBKLTnXQul-5NmbIl5XvOjHcVc5_-EL-vpQ&oe=69AADBF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScleLago_qAQ7kNvwFxqv61&_nc_oc=AdkGUXEoCeC0wg55HmBgp4KDiL2blT8RB5YUrgmhhgvo0KDsBjR6FsIMvxQdk3gHvTo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMdLgW4eXEQzyRsEyevanOaplTaYVJvUSQH2S_NTD_4w&oe=69AADB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O12kwxMalU0Q7kNvwEG6DUy&_nc_oc=Adm-L0p5WkeKTedZzx4dgkxXHjF7qFgM6cDyMII6vIOl3EOzbobYQXSHYglOZ2DJBag&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afx--XoULyVLwbpo5DG_qx4uitTSdRe5lLU2_R4ZAcHzLA&oe=69AABEAF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], 
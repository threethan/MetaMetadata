f&oh=00_AQKAFNWwVCAmAuJD3wHXMVtvTTIxF5AE8j_jLA_q18WW1g&oe=6AA2C56F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41Cm52yOWiEQ7kNvwHa0M96&_nc_oc=AdqX0EFyPc3Ih13j08ShpZeLIGpia6V_RDysJDP76wNHbSqBsC0JcHm-FjnvcFD_joI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_Rgn9Om6GgL8GTlxrgccIbjYEyiV1hZhQivgEyqtnQw&oe=6AA2A1FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzaZG3zMPA4Q7kNvwGIMnAt&_nc_oc=Ado7Ue4sgvBvj_lvO-10Klu6Ud_yzCV92m9m_xMwCDGa1oSWwcigxmEe0Qlv7Gox4h8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp08VA4TdaJrp1qAlT6gnMtHMgimoP9RquKGJQCUr-ig&oe=6AA2B5F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB66JYuvKk8Q7kNvwFABbUz&_nc_oc=AdptFohPiSGZutpEVx4aQuL_PGn_BFa4Nzp00jNHoUHuxz2FVLWI4PbDHoKmToLk7nQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDBkcyuJySIuWMsXPfPt8O4oNKAVPwgcB9o-SwNZnJoQ&oe=6AA2B516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cksqtELFE-cQ7kNvwG7_pH8&_nc_oc=Adq-GE5_ekJL9E3E7nBftlPm07PDO2afNU-0VvJ3-f2w6SyBhmkvVG1iwk6QxE6eLHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu_OMwabW4-YEzJd0M1ZXGwEjLKF4Rxj6pw8ugqWX8RQ&oe=6AA2D0EF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
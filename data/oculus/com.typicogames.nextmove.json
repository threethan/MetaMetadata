uscdn.com&oh=00_AfuMZndfhIAOcKGNNIhpF9KZiJMZoRKORKqHcTt8Iz8Kpg&oe=69A2CA2F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGCMDZqQ1gAQ7kNvwHHJvDV&_nc_oc=AdlFFq6pE-_GGklgO2K3cHGAQbefEsW9flzIuJLp21gSZ8O5QRFUrG4pEGu7VErwEfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvigjGlI0LX9J9lAma1U5nU388gVtvlVHpcabiiv_5hOg&oe=69A2DEFA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRPmvCg7e9IQ7kNvwENZMBL&_nc_oc=AdklNk1wLreA9o4NY8nt0Gkf2RBu8S2qgDKvri3X5y2EBLdnGlVPf3Mjc91OKoNqPxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuzbwS8r1vois4GwagSoTiwxvX4mJ40Qayf_D7r4XXQRw&oe=69A2F2F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ha9WF__7yLQQ7kNvwFUc_Mf&_nc_oc=AdmWtAjxb2b36LHhxEvpT07te1e_PFYNHSuxDz6kKbd1BgADX4c0QemUGAaN_eMICRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrcANgTycaHFPktUZLVrQY3KZzYDDNGom5fyB5H-vbJA&oe=69A2F216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FIEaqPIbS8Q7kNvwEQoQiP&_nc_oc=AdmKb2x-ph2yob3m4BWxbKEC8n1ltO_THTPeIrcyrX1Z03JN-0vwN4v6wpW1Jjk80dU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYK2ZadU-KnUoboyzOc-bDRBEUDFT2L7__QPepC1OyDg&oe=69A2D5AF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
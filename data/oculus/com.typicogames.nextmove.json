f&oh=00_AQJK9zMYWQ2hOfnzeoeLlx_dtoWhKmvdT9nXANNTAH7Akg&oe=6AB53A6F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sfu2zyZ_csQ7kNvwGAV8g9&_nc_oc=Adqg3pCEOl4dG-s_Cy-7s1qa8aoNDjB3Lis9WCvmfXlmgg1W2JtbLhTE7agJt_bbBtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxzOdRJtWGQSDIkCYLm_acp2eMsDL8gj14qaAk06JJWQ&oe=6AB516FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61k1U0YXO84Q7kNvwGhZ2X8&_nc_oc=Ado8dcIJFt-Tu-sOWsIlqenuFQL6TOQfMiItKOjm2JAKEplWwdkaIUVrqJivAUjODBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwMvyNSJHtmmtI_OFit2iMp5tRwoUiHS0KcuHHJou1qA&oe=6AB52AF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnML0V8UIkwQ7kNvwH5TB_-&_nc_oc=AdraWIBPHQiICEUGMCiI3LIIR6bD6HSD-YyOD8cj2GDZkS-B1Y8XB-HZjdBMzooGZmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyxIoMFpLaVZsXPBIs5FrEk6LKinx20xbUTtrtC8VSrQ&oe=6AB52A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYB14Ybp29IQ7kNvwHS-n4Q&_nc_oc=Adr1rdJlxFeNZ5sOY0y4oadqbKvq9O5ahu3M9ImqLA6wDIAHZX8riKLAtvr05d6of8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz17-7O9bFhCKxObA3_3XPbpZTYtp3yUBvr2jhqYw-eQ&oe=6AB545EF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
f&oh=00_AQJ6RZ9aa4aSCC8SIetvyjS0p-upzUElr8umTWWUhw-BsA&oe=6A9C2DEF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdRChGVMNkYQ7kNvwEiKxbE&_nc_oc=Adpwofw6ncNOO4Unul0Ab_7MaKQmWWiWKRJ9Azzvb0oa6qAA-3K9y_fRGO4rzNH5GE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFVmffcXl9fW8uCdJz-UQWudZKpIDDDlS7zTSg4aiPGQ&oe=6A9C0A7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihUKVCtIZXUQ7kNvwHsIx5I&_nc_oc=AdpCmlf1tNaKdS-EnrWaYE4M1bauHhTaSgswtEA_KSul5x-rcPjMrnMGqf7BFu2wtno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvEzlYXE7xfiwM1Is8l4ZShj52skP_KPjkh7R_-ZRRXg&oe=6A9C1E74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXifGxXGGrYQ7kNvwGN-C29&_nc_oc=AdqskMZZoq-kw64Vt8Mg4DgX2oL8Eg6RaNuPD34qxN1ipYZKszEZBDBUbY3xs5gt0yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqc_I0j83WIcFuVX3XMOYbCU_5RSkGHRMHcc9K6v5cPA&oe=6A9C1D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjNNNJY1AqUQ7kNvwEnCQOG&_nc_oc=AdrKNLS39W4TkQ5k8E76wbO2Cv5C5dlBH32nXgIxDv1-TY_QG-RzhTKm3DQbl-a-xb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpuLZ02_lAPSo4Wm-kXOX_g19OUQNeNNXHKUFvUI6DpQ&oe=6A9C396F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
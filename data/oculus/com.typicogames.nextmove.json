oPk0gei5YlNiSWQloodDa130y_vQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1ePNt0lWWvnelzDAbCR5_YtqpvjocPYF-hcebUTZK0EQ&oe=69F1E42F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74DfIHAtogkQ7kNvwHP_-zx&_nc_oc=AdqFIkAP_SRsKWWAkrdJAfbGLMyRY8fy738SeosG_jT_hOnKEYuMFynlXJZ0pbZCKwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rE724Vv1LBb0wIQWcdns2FyzYuDjm6vQWK0qjo28OWw&oe=69F1F8FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7pL2TYC-d0Q7kNvwFGTzi9&_nc_oc=AdpZ5tW0Nxb_Ib_VYg5HAehWlwG004pKvicjFpm_bVjJHiBD5R15r3RYwge8ujbd_XA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qU-7Z43Dsjgxy_H0lkHfG7K-iYEj79XDBSAcnmU62Ww&oe=69F20CF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjwIxiX-SjIQ7kNvwHAMUkv&_nc_oc=Adrx632cJ26TpkT2gv3cGJrayod2POE8eYyiBKThDyhZ8DHHuA6face50HEn5WT26bQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cdJuw8F5XqgjENLywd-LNc2UxcGyFV_YGUg7ti0lVbQ&oe=69F20C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwBheL3wyz4Q7kNvwFISXX2&_nc_oc=AdpFTLPZdBF_BuTpHNbPvuPpYBZ9YV7vEdR5rBxXA2ySux-lKD6WnYz5GuzQgajnsw4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3QxiZ89yLq47l4wi17iBfvUJUripzEGI6DYJUkuyHZVQ&oe=69F1EFAF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscriptio
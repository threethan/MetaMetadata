N2HM2jDCRFaPX2lVC2mx7Id2WgTi7h_9HtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyUDxZU5uvaS9yG-XnU7LeBos1Yom13JJnxgp29I1TtQ&oe=69B7E22F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grwpA6FRw1MQ7kNvwGaL5mw&_nc_oc=AdmucfdPoxqQYA73B_QjkKNtnVOOtHNK9KdfD6SBvKQ9tXie7yMv9o0yfu51GyWFYLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxehv4s1LRvVUYXLFH-8AYqkCtNAhzekYJS65X7IaDLGA&oe=69B7F6FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCMjo9x2DxsQ7kNvwFlgAhN&_nc_oc=AdnWrEGQGY7E6Sxn733_GQCaLSUFKPxm8-y4SprS36gNwMkakZtMY9xLJSEOUtyI_ys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuKuKMD14sws2oTi5vQTBPAGkn8mIyK8Fw6agisQnAkQ&oe=69B80AF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAyMLMAUXTQQ7kNvwETrylL&_nc_oc=AdmEeVwn-AnxO5iKc1ft6g7Ez6DB7sPwCNeqP2FR2WwogMyId5YGlZp88wRuHTZK5OQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyykDBd7jXx8fjR9NGd_lu2ixqooMwkGlftMuAp0Tj4Qw&oe=69B80A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZXIch0wMTgQ7kNvwFlHFgV&_nc_oc=AdmYaKiXJh7-FkjPlPPSluUXZSBvoyZtYoZxR0-TMr0Tmem-8cUSFnqgNQUDMRTdxGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyre9TqHBjY_MGo3BSRN-CcAP_F_m-vrRpKtEV-aNdw1w&oe=69B7EDAF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
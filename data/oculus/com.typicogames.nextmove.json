jCLfu5ARqlmuqAPFsr5rqMR8zeLdJ4Exwi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvIw8uwCG_VA64_JKSMQA35lmEJGJdzhoS0re5DLgqftQ&oe=69A961AF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcHGL30ZRJsQ7kNvwEQrIiS&_nc_oc=AdliU5ThAzMExBoqE4zFf3QqYsK-A6pAPpKIrjONOPVekYReR8LjO_wneNo0k13j2fQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftEx7Q0KxiBJpLvfzphrv5Oq7xUFn0zyQhUWjH4GrASow&oe=69A9767A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNy7VYObEJYQ7kNvwEGXwQT&_nc_oc=Adk7-vReJMoMpVSIxjqeojAO8Fup651ax4V0XmP97FOhu9HhxAJpdszZLTXxV8-sED8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu9XG327JH2k3W3mx46whiVTLi7phJ9lhMoggOnoTgqsA&oe=69A98A74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93ZmBJz3XlgQ7kNvwEu1pSy&_nc_oc=AdnvMgT_e4lC8ef0bUlLtk6JG-pGwlk02P3qSoPzvvxqllL6uygyhVRdCxfMA0ut2yI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsTiB1W3Omnnr-e3ca85JxomNYOMUkhZBepIWvxEiiqfQ&oe=69A98996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O12kwxMalU0Q7kNvwHjaTTR&_nc_oc=AdmfVEdTLzx8i9s9q9mjHsZHPs-xME0RusFZhLtkhkgKKNYvQ3jSG8qJ8UGyAWypSmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuaIPjL9L3F1QUlvB2S8CfI5r_2l5l2cA9G32eOmhS6KA&oe=69A96D2F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
4_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrK5M0BVwx0Q7kNvwFYD2CS&_nc_oc=AdphMUDftMrdmycCun0Yp5XmfjPN1CBYxx4n4SmunqnCS8-zkL8ygbF256V3rgYSz9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwbPALLQYO_nwwvD0YtI2_ixWHEYGdziEBKx3G3vuUkw&oe=6ACBB8BA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu0kMIB2JfgQ7kNvwFEzvLm&_nc_oc=Ado33EDGfZgozeAfSyUuVE5A_j9b3b7wM3Qviol32piqP-fCgQkagIIa3vU3pUbtcM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhsRlYoA1VPhWc6028FXkGG9dceASstT3tFmINmP_K0A&oe=6ACB9474"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlPjXC9geKMQ7kNvwHMc7Rj&_nc_oc=AdoaIQcu4763cekQvIpDZzQR29f8Btu1HSmqjzP1mfDoQQzYT2Bhc511B_WDCC34JjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPtA7hnNLuXzV1QZQHSDRqwBKbo_yhoEiOm_waIQqunw&oe=6ACB9396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tH9RKF4TeFwQ7kNvwFE4H65&_nc_oc=AdpnxPPiRz8Q7nOiYw8kYnORPhTiqonlr2eVOuhBgX8qucV9SL4osk0r-yiei28xvWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYUcAo8XYgOjxPJEmXhNB4sYKhTY6CNR7QwF-7Go_NkQ&oe=6ACBAF6F"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
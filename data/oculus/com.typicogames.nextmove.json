ArbUeUsbenr7KIzW8xtSz2a5XrXrl45ZNhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPlYPAK-BqNic4vI0yoP6qaJvFvOciF2qhd59m6xAlnQ&oe=69AD562F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSpakzCiy-wQ7kNvwF_ybLb&_nc_oc=Adkr2wYYWZo98Zn7VI2PABSmzCsnDryZHiI1r2v7kkjV_CkdpQ-mHR76dEpRl4mGlGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLin4GD2PME76KymAGtWE0bOeceIiAvaz4kBLuUpJy0g&oe=69AD6AFA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1bnWY12JDAQ7kNvwHV2B34&_nc_oc=AdnHH-wBVWi9ZqXsZ1XpVhpOhZSNmKf-dAsGU3yxbx0RRMxQFhCiynS8XTyTITVV1e8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAwWCg5rkU3P5vbLeMBgdATCLYWSXU0iVpFuBAgfwFGw&oe=69AD7EF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScleLago_qAQ7kNvwFHOOHc&_nc_oc=AdmSqOsJhkjVuzRrGBx7OvcEwe48Xi9c2ATWtzGDtPppmba--BICV_vk8pvFUMs5AK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfySK_xqzcl9sxn1hLQnQOV_c0aOCDy-5ExcRQimMileLA&oe=69AD7E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-W607_kvg0Q7kNvwFSVzLg&_nc_oc=AdkAz2njGkMGQNsKAOIc7DFxnGfH8hJ23znyx--3m-OE99fvbnrKKmipnry2aYAGvzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX6lYMhcr9Yuh6e88OFvSzh4sj3kdeFZtZFdjF-Rs8lA&oe=69AD61AF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
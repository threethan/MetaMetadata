e": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnQkyfXsSuIQ7kNvwFZ1Soa&_nc_oc=AdpcZSBUeHhOh6Trb603HmCbMoRwtzLCiDSv0k9k-Qb0y_hb6sEg8yaKNOkRxPUqfTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E-mGZdxKiBC7ilXFb67Vw_X0b43RIv2bkQdhiJsycGQ&oe=69E8BE7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRxC8jG8ACIQ7kNvwHmQnA_&_nc_oc=Ado19CvHWDGJT0cq8ubBDp3pmJ82XhU_FhgSgOVv40RTfub0sZEcahjzFtVv-l-PFII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29eX6Bq5IMi3cqkqVyzT5EIx_UKZMuwamQtCf_DyLvRQ&oe=69E8D274"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjIo0Bh91fEQ7kNvwENHO6w&_nc_oc=AdrzMJayj4pNcbydl1DlUGgfoB_T8tOImCyi7j8esHovIIC2lgJLaHKYPvly-lGrZA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19-AZ_0W00-2sUvpZxM9qpM5rRjrxtPyvpZh6BSqSs6A&oe=69E8D196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb92K4I2hdAQ7kNvwFsk_gD&_nc_oc=Adqs9rk4-uDdpKNPe0mTldBU8yMbeZ8LcQLxXgm3ztoYoNrDXavcXKgQwm8Ub4qz17s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WNjpWrl6wieQ78ou5qRX0Uo8pC9z0xNHnVKcJ1VQ03Q&oe=69E8B52F"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gr
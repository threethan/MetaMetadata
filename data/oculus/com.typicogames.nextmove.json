, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRCgllbbb04Q7kNvwHVO_2z&_nc_oc=AdoOJaS03Vc8w4ioWU7Il6qpQgC3nl-eeF7vXnxWgWn3KCBgoLhw8rXxSVGEu-8FWm8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KeJ04NoJ9suLkSUaDLCEhMohuCK9yIuuPPdwniJ_RwQ&oe=6A4658FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcZEQMKhKaIQ7kNvwG1aXej&_nc_oc=Adp64kTohE0ODmuo6RoO9AAc1MewectofJ36ZPdPcyVa94u-s9IOdsxCl0HhHYJpsdY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qN-0hE-X970Vz70vIUHEKu8BVE-IZ6rawFL5TaN7AKQ&oe=6A466CF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGyOwkf1ts0Q7kNvwFNZaft&_nc_oc=AdrQjt7_6TRYymyRKS4xyZxGXLSfkH221LKbZMpkQKTvfs_dPdQJ_lIvlEurXLv_cu0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J1Ffa8W5m-fjLn6B_-izNJUI1gQQDQXS7NdoN-gMJhQ&oe=6A466C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS93c24NzHoQ7kNvwGCYMMj&_nc_oc=AdpccS5EPgVtO7npbwXP-QKn_gLHNK6TxcMLyvlud-aFstkva3X811N61EaoSXsv7Bg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SX21xWYps_g2A9HajWo5ZRrKyRdr5b4DFTORepkQb7A&oe=6A4687EF"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT",
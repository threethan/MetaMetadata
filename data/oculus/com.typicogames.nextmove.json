zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftNhdq_rwGPV8qJXQ2Dbl4WavUKU618SLqYxYfxD0lXDw&oe=699852FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78wc6u2wTlUQ7kNvwEn8YK2&_nc_oc=Adm1Io0cVOLZRYvqGRU6lFPTUT1XQcyYzGcZFaG-t1cWMOPfzKCYfUTCh3O0Q8w_O9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuyqgo6aBHs_UxqMuWTyBQc7AAA-FuPrgfi5qwg8RTQ1w&oe=699866F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pOj_z6pnyoQ7kNvwH_RDEG&_nc_oc=AdnMLIYFjWYzZ-3uUrzh1a0v7LNAhr61M3gtVD12HTirT1Tcq2vS_UoFuneBroSF-6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu42Zv2-2ZKUEmhVxlnKF8Ij47_ko3JbdFH00-qGVt1jA&oe=69986616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZUQVh2y0jAQ7kNvwE-mO_9&_nc_oc=Adl53GR2IWQCz5cVHTLyB_h9VuwbBmsF3YoQJXpL1EzjInwOnVPCr0DKPkbqo9eIBG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftXTTmdrq7EtwYqpuriPSR6oPlv4V0MrlC1-Wht4BykAg&oe=699849AF"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6785834638189983"}}]}, "scheduled_offers": {"count": 1, "n
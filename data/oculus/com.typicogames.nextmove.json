f&oh=00_AQIQyv2wCeNtsRY_E-05bu0QKXs9dkREf886jybVVfliiw&oe=6AA0226F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41Cm52yOWiEQ7kNvwGHT4i2&_nc_oc=AdqwRztItez_LiL_kGRJ4nhwuIxs9JfK9-hcm6snUrKY9XNY38Ntk4A4zwryzNwLX6s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnAd5WrDainPDcBEqEgkNq6EpsE7qbzg8Y8SXq0Ej8IA&oe=6A9FFEFA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndm0BM-6qzcQ7kNvwEyecPB&_nc_oc=Ado2_bxM33sQSQlZeNvyZBT15uEOP3-F46TgvqhUAhZ1QB8sklUcFwotPi6PuuGW23s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEK0GB-A-NNj29UH8WXZ2wC6GCwmlqSRcOBrC-C2qrbQ&oe=6AA012F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB66JYuvKk8Q7kNvwGHogne&_nc_oc=Adqfa1c_QQppmLx8wXky2HQmUtqDo-O23M1hFb5xEjdnBU0PghhGslgpSHL46XSt0Ms&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzAM3reaSI8gW7hi2qWno4FCPRG-6-j42wpSMiT-N8xg&oe=6AA01216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPE0kiJqDYAQ7kNvwHe4Q1_&_nc_oc=AdrO47q_ZsNFhKjA5trZT_fPL2zBfDaxzRnEWTeKzpATLLKiLTbPfl_7M3wTEPEZF-U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6XqKXd3XtvSw0oP8-v0rg6CoQQMbtImZLPnKmq_jSAQ&oe=6AA02DEF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
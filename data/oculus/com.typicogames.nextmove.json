Bu2Ujhrcv0Hxw9sQsvKnX_A2OTo0cO1l4kY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPyldo0q0ST6DCXEHGXP5CL1AoEp2Fc4vr67ol_I_ccg&oe=69B690AF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grwpA6FRw1MQ7kNvwHAcEfB&_nc_oc=AdkqZl_KjEpvXWtQIWUYj8Qj3LpKbkRKPxvDpkoSw0084vtVXrhQ0VvQfFhKrMSjdvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO9Sk8ZKnfC_60xagLbt0nxCVSJgaU28Fpq-3uYYMiyw&oe=69B6A57A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmnooiKLFfUQ7kNvwEXXavM&_nc_oc=Adnw2UUQ18fAlJJvNCnqNWVyQyXTVvQSx8mrzMZIkEnZsy7ryWZbKc_xOlwiBcI16vM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj1CKGnu3zwHqInad1Qb_YFLHbvRyvnGDpC_iAWayDOw&oe=69B6B974"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAyMLMAUXTQQ7kNvwH2C3Uz&_nc_oc=AdlKHtQxvpwGrXF3fMrm3oSXjMckJKnR6szdta1jySLEBOdFb7UpyoUajDAXYDTMLuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnELYdDj16vYXCsTEKJOoRXJSNZ5FwUbEEEf36YNeqQw&oe=69B6B896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZXIch0wMTgQ7kNvwEviYJO&_nc_oc=Admu2o0wi7Y3jiIYQCln1Kb8QTYgFlpuMqPHndbhZ2eppe3yPfylFOtoPL5MrpqJL4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6RRYr7qblcGMY6JzTbaH7IQkJNMVyNnzVPBKfBsIdyw&oe=69B69C2F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
: "1256260851735422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1256260855068755_5817586504918168326_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPTymR6SrPYQ7kNvwH0nSqG&_nc_oc=AdocZNcPJRuRkBsr4q6ODizNY-UNyFwMKFxKVULIXCO34hunLtoMy7f95QH1rrkkPXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIt17OeKPVmmm_sZPGfGimjGTCFYWHKOMQrVyNwbjM5Q&oe=6B05A5EF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L943jfH3rgQ7kNvwE0l7oF&_nc_oc=AdooKM4UuVgseocx33vQF99o3SiQ0WtToTPeL8hUIsqcZ_f1AOBjnfjru6q-4i3E9xI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrFzPGqbiAkPgs9hGeeqkFV959MgGSdKvKYEDFSxg7ZA&oe=6B05BABA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfiFkkygMHsQ7kNvwG0i_zd&_nc_oc=AdpybjNuqcebi66MmTYM_siLzlh4zBZdB_eqJ_ZBuszILNntpmBCzyvmHR8VAWCicBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWW83DWloHSJfkIi7upZjEr7uMAUtVrzA9K8d7SjH0oA&oe=6B05CEB4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mGUVwOE89cQ7kNvwHs4cXH&_nc_oc=Ado9n6L2Vv9DEBGPBhe_g-6T4SFrqZTdrfTYCOmILUe72IFu0wE9jetmf3b4gw323zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-BRgUqae8bjzkjrlqXyreOdPAU3PPAARqNEQsqOcIQA&oe=6B05CDD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3dOkE1FtS0Q7kNvwFczR4N&_nc_oc=AdpKmsBOPd2yBE2EXPK0855t0GLIpd52sANiWAYuJyPSmnbFCEz3xbd6-2z-Ok-Ydw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAtgtIvTvdZYvdt8UJDrCC_w8illBBxP6-2mblcJZXfQ&oe=6B05B16F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6872248722881907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_800966611832898_396443871045776339_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIxEboJvlt8Q7kNvwGB8w0m&_nc_oc=Ado9lX3tMXWZufHcAqsb8CeQWVeBPuW0NfK1pu_o_931Rve3xlzfG6RT2rqj_tUt9c4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQspBWFTc3QREQh8LSBO6epCm_V42wKCyVml4WBGVld8g&oe=6B05D5A4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Next Move", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1701374400, "lastRevision": {"nodes": [{"id": "6785834651523315", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6785834628189984", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1049870459532028"}, "iarc_e
e": "S02.png", "id": "1056640998680341", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bij1jTHs-EcQ7kNvwG7OvqA&_nc_oc=Adr5JT54C20fLXiy0Xyncr6ieaAuNVOE-ELuwdU6tGQ9M7gNoniFR6qvMscDHha27Ik&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkq2LlnPPFqC4aUhvIC6pr7U6tz3qv5LIB3saURaacOg&oe=6AE33B7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mda7eTLMOq4Q7kNvwH61-OA&_nc_oc=AdqTqlxKlTZou_0tKT4wMgquFr5jdYE4xBQXZzotkfrAcLxdFsIyPsIADfA-fymF8yI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKcU_c62SFhDwjTDaF-hrVPm6wuLjyTV6U8bdjiv9i5Q&oe=6AE34F74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EpyDhtfsXwQ7kNvwHRF-qg&_nc_oc=Adrn-Cf12l-SgdK0d_2FYc7LD6q-xfOg4c8woCpyyr2V0VAAeS5vfbJcfm5phJVR2BE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQjQUjj8FVrCrxjaYhE1AJMxwhRTLeW246Ugu9utED8w&oe=6AE34E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfZcguOpLLMQ7kNvwEMV0QK&_nc_oc=AdqiAysbLs6EVrwI7ln0Gzq0DjAZxOwVjPXjT_F0rwuGXTf83vOmnfeSN274-jw0Y88&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeZhwoNm3lYiQAwR0oyTq4SlCweo4i-OS9nr8OzmwjZQ&oe=6AE36A6F"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gr
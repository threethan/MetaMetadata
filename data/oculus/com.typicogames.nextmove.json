.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRPZcObBz1QQ7kNvwGEZRsh&_nc_oc=Adllb3Iy0GTjZhEewqjOrep2tNo647AVUiy44nwTdMXSMOck7sZw44IPYIH5RUgjB_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa52lQaF9XqyVt77cxr16D3dYMdgRi5Ozek17lPmhZag&oe=69AEBC7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1bnWY12JDAQ7kNvwFaGlpV&_nc_oc=Adnwrlcx6P00h2HKEFBMSVZXENxbSq37JOsvplzbNiV_QGZK8fLOBDG_et4iNjSyqVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMRS1mIz7Yb2YbKWge3UTeTUskJDoDGRCpEUdwiX8w6A&oe=69AED074"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmQDFBTepUIQ7kNvwHdx64b&_nc_oc=AdkHfGnUzuxTODTOfBzGW1pNlYO6j4nQJn7lv3YHF4l5SVGx9VAtC8K-H-0VzMXOPUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUWK0jRjpdm9sAjcpvc8POHImsT4gxyRSoXg0cU6gmEw&oe=69AECF96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-W607_kvg0Q7kNvwHeBtuL&_nc_oc=AdkMzJ7cxWX_uhz6Rdqx_gEkkQWlG_gUUFUMo-k13sVLbmYl2oCqaUJK44X4zgeLfjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaUiQrGpvk381vUf1yc3v7qkykKfSI4o-KgwCi7y-EMA&oe=69AEB32F"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [
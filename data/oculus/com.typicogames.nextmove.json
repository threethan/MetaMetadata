: "1256260851735422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_1256260855068755_5817586504918168326_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgu1rFaFzG4Q7kNvwHxfug3&_nc_oc=AdrdsE69otQ1C6gErzFZOR1w6dqpZIk2ZvYdgkN5kCHeMbu4XUQrcNVrY7I9Tjm-k1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRXdyGfdeR4fcuYo-OYbG-5GjvfBauzMGwXTCmdV6q0Q&oe=6B106A2F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KZhRiL7Kw4Q7kNvwEm_ULv&_nc_oc=AdqQrjybKF-rETcXPmcIARjU6e8phmfpyFldZCvP5BtHz1L7YY9A6iTquthmnGgQOHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPkIMmrvgBV8_smpAiBzjdP1Ti6IH5Z4GP55ZO5lI5zg&oe=6B1046BA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28oYir222gMQ7kNvwEVx_0w&_nc_oc=Adpu4XNEeBagcW_96pSxIXgmKErf2NUQLYpOmTa7LRJoG2rode5JR4Wzi7TJ5XVgQoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnL77-yqcXfFXyEdvfmIQo8zyg6VFBb6qiqmu1krUAZA&oe=6B105AB4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHH5YYq-33YQ7kNvwHs3aE1&_nc_oc=AdrS3zFVSPTlvCK3iWbgSRfMcTTVzFXzCNhO_NAwZhcKaR5W6nWDPsB4yqKEYe2Eu_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUs7v3Mu6UUS3X_GYgZ_iC6RSQiEGhCWJ6EuxINJ-Xe-A&oe=6B1059D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-W8TfcTYaNkQ7kNvwFuu4Vn&_nc_oc=Adr8zN5ng9xJeJbTA67gUaJaptTeDEyZ1-7Uj_ohnl0DCiA-72o9GQhj0MLiZoUugQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEGJ9--mCkdft0PpfdloQ6t4lhj6eveWY8mBGg5MoApQ&oe=6B103D6F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6872248722881907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75236135_800966611832898_396443871045776339_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEI0CqOFPH4Q7kNvwGsrRvd&_nc_oc=AdrnYI24T6ezqvpbBliJQ7f6z7TAnjVAaHw8UQRYzdcGu4A5FOzxtzOdLRMpoCtJoUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJ6fNCZyf7zLgshOjmRte_M4Iy0Nu22kXf6AB1gYnAPQ&oe=6B1061A4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Next Move", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1701374400, "lastRevision": {"nodes": [{"id": "6785834651523315", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6785834628189984", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1049870459532028"}, "iarc_e
Y4c&_nc_oc=Adq3PmBqvbMH1KxC4fwTxLkC-FP5TiBfvSsKu1wV9N6Q803_TYKFqFiIM3bAJUtu5_M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3mT8WdFRTwGyBKieOxysSVUSebJmi4heoT-hNWIRVWw&oe=6A858C2F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlwGgtm2k-8Q7kNvwHJ-DRT&_nc_oc=Adr2QHzWEa9w7kP2r-xoOW4ckzWx9rx0smfFyz89ivDXmJLVxMEJFEG2KeIzIW2lnOo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENYFtY7p4CrJDHyTqYbEbebcAq8VFqedFqNWBG_ZNj_w&oe=6A85A0FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxwT4WC1aSIQ7kNvwGnD0Zk&_nc_oc=AdrZFR9zN7jcRJ3j77XLSqSBiONRQh2Q41Y5lUZyTm9mcAdG8lTLgo5W8g0N7y1kff8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-TXdMaa5lNX4IoWAjUaCrqpoEbJA0pwBxSUN3mEbP3w&oe=6A857CB4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fiGzMnX3L0Q7kNvwG0tsFK&_nc_oc=Ado-eqdf4X0TVfFldlVMxhlxMnx-0CrIRDguAbWC8lRxDiWTq8M4umKQbcWkFqrasYY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9bb_1jMZuEYyKqsqhsIEpvGNmARpt9mBpfpnOjfkluQ&oe=6A857BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Cs91zQBJkcQ7kNvwE5t9HT&_nc_oc=AdqwcXaFnXpVCwdoDHsQMLNNN5YpgjWdH8N-iTyNnp8ytqaFFetVEhKCfhTx6O2c_dE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc--yxtlvPew7rn1_Wl_LJNqNa5M28Tgy36WglrnW-Bg&oe=6A8597AF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
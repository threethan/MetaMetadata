_oc=AdpuptKtoxFZHK8xWJBYqxVW6J_XIduMm2jS7bHdeSTSbiDM5edK-dZfRgGU5FrZ_uc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T5sdRxKv_sWUJJiFBm7IQCeFF4yd5oXumsQULPA_Hvw&oe=6A11C06F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF_YUn30N_kQ7kNvwE7QeUp&_nc_oc=AdpfXbkr8lSHeRgDLHfTr8MabxZL64yaPHFw6nN7MpaWzzXXkZxyd1MMF5n-9ZvxUVw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ot4itCzc7jFydYkn_xI0a5oLNwnkuxw4RTn1hewZjcg&oe=6A119CFA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do6Sb62esAMQ7kNvwFBkgZl&_nc_oc=Adr6xz24Ay6DekGyjjbGvvaLBEOgpP-xivAiGd75jDiOOx510iwCMc-0gpeUCGUsYNY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MhXWXspAID1LKdHoju6q5IuRCr_KUGHvzvu3fWJ_l_w&oe=6A11B0F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq7JXUpL1EgQ7kNvwE7FctD&_nc_oc=AdraL0lrN_cbnjblYmfvsSwtlaEmGEmZmkyfoLSmBnJaHphpM6PL6bfSWhPC4IPqyOI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57zFqAgVMPKY6W6Wuy4Dlfon3omC95TerYnzrdOTIaIA&oe=6A11B016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agRAIv5HWTYQ7kNvwGfJceT&_nc_oc=AdpWFugMm_eldsZVAbhGpN1RGBg16OArpxs8f6RiQjZXBrbCgLjY-5nrSITZ_UI_fVA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oVv6BpMXqEcV3xwRMsXAxcAVqPY7QVkjKWo4ZzjDRBw&oe=6A11CBEF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
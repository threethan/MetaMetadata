m6VHoLtX6V89THybcRhIa7RUZMSMMjeiP84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvi26zo3FcSoFMU5x4CWY5vuZX3SW9gvEEBhN4BLKoLrg&oe=69A8102F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcHGL30ZRJsQ7kNvwFABE20&_nc_oc=Admb2jisyLL8H55kLSWzuzEmmHBU9e6-2YHeRX0YD3Gl-afJ_d9996bzkcP8aEVGIs8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvIxn0YTUhZhbke-ILOFUCU5uoJ2qeaUVuBu4i_J8BBUg&oe=69A824FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNy7VYObEJYQ7kNvwFqmOlf&_nc_oc=Adn-4SdYeyAQbEvXA5gI6fkOe-TfMJbm5p0r_BDhkXcdHso8dEhbvcNdgy7V_b9KzsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsXXFn-9ygM3LrK0odwHbKTjsNvxQ61oSvyanNqCVM2ZA&oe=69A838F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93ZmBJz3XlgQ7kNvwFlJLxe&_nc_oc=AdkftMT47O_nj8aC0GxZsr8-glHluG7YlrZoGPOXtrww7krWHYA0OlvJdejbbk_eA7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvXIEmZk2CFv142NuZAS67mjv80Fr2wLdbZme_IYFx2Bg&oe=69A83816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3v67nDQNCIQ7kNvwGkCPud&_nc_oc=AdlF-Hli48-6Hgh0GJXqeFPdzE_d-tI9A7vkUMgnP77FwUSurLitVdsHjThpP0ki7jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuN3yueZv-R5VtpRyhtPJHiKofZnfuulU4X2CfTexgVSA&oe=69A81BAF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
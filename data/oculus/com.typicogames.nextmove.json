_oc=Adowo8j1mskATqHqBEpwUlBO4l0Frt1PrFwJdGkVqKiqt7DVBoR3nIzQ6EbeYZpoQkI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ca0PywG6o7xQxJAFnXNruKms2nI3eqAE1XtovFsuwPQ&oe=6A394D6F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrS_OjFgsA0Q7kNvwFGN7Pq&_nc_oc=Adpkq3x53LNVNvROSYCgPY8Ol1BWcdFqix0nq72qGtMdwEQ_A_VEdyaeLftIFWr-oZw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5CPYnWMKzrfS3xsd3fwJWoqqillDax6UgNK7a-_epsQ&oe=6A39623A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiF4pnB-YpkQ7kNvwG5J9-y&_nc_oc=Adof2HxnRD3CflScITPbgT1iSqXEC_28kCES46lbIfkg6vlo8vFNSr3qbyd_4mXhnLU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Up7lKjrWIGXz10jsb2M7URNex2dK1GbE8_X2E88jqw&oe=6A393DF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZNrJEQvhqYQ7kNvwGo3-GD&_nc_oc=AdpJ0CVm7Nd3V3DaL32kRvkD_Gm_-cV46ENWtkOsJgR8y15aFOXzwubfW1mkbFkEB68&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M0wVUapfBCSQfcQL-KVbD904dvs1fEeQMq-OT2_oavw&oe=6A393D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rlz7CBIUh08Q7kNvwF5AAfP&_nc_oc=AdqLaOOB0LO3ISJKnrhxb56THV6LSOQwvzE5y4TkLKyc9uQiIW0CzBscm5FZVa6vq7Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93H7eiUI3XhZvCUuhRO8KuzOI0wRbsoPKApwFiw1mhTQ&oe=6A3958EF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
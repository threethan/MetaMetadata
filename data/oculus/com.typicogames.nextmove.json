f&oh=00_AQJO0Lyivv4Ulo-5-rEY3wcO-3Bw97zGntZMyQB1lvPhSg&oe=6ABE74EF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cDdxvL_K8cQ7kNvwFCphgq&_nc_oc=AdqPsc6DvZzm-L4xNrLTpjyLGOd3quQjwjaPrUr3AV4xlh1TTaPMc4uxsmOQwkxbsZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH6LAZZ0eqcjf9raoX3qfNvSsbMZ_ovhAirtPP4J3oig&oe=6ABE89BA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHdGKvuKWI0Q7kNvwGQc7RD&_nc_oc=AdoVPR_wuQJTJTk3s6EgSm3LEGdmVJkbEY61WqX-8zPz4fdBY6b-t2QYjFzUxVyXdXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7hQJhyu1WrrHsvq9cJ-tmk_eIQ-piKKwAo5JkcaPvQg&oe=6ABE6574"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nePCDo_KMhAQ7kNvwE_4LRe&_nc_oc=AdoMAkGgJg0-3Vobgx9Udp4rAjpFVW1oceRKNh_RQnA2TPDf3a320m32zqVUZqONukw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX7J8MkATVb7Ej6c7KjDYF1nyRLDdx1Zq3LNB_mIrlKA&oe=6ABE6496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t359S-BqD4UQ7kNvwFW0PHz&_nc_oc=AdpPd4ACjhMW3lPESpZp1DJKVYmSDCyHLShpXWopv1zfsoaZewrgrWjTIbet4Tu1i5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBdsC9GDDkwqvAjMTUsqs67mj0k4Tpl7P_o_KrWIc6OQ&oe=6ABE806F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
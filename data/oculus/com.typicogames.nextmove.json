vqQzM6p8JHDM40aoisJsTYHkD5wJFufhrB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp1OnQT0VRrfwoDsDk644_ilP6X9cPijG-BWKcLugXIA&oe=69B29C2F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrFd3c4HVcAQ7kNvwEtfDjR&_nc_oc=AdlUtq25RYGJFRU2wxPVh_lwcoRD-9ZlbOIVz23vie8N8Q4PNB8yrHBmNZkkTSjWDT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBoZ9t0VqrkaBIp7GC8iyolByzLmc5z3zVcdtf8kADcQ&oe=69B2B0FA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOR-mBMYuOoQ7kNvwHUju_Q&_nc_oc=AdnrenB95IECU7lbTEOZIIbMfejCqOWV1nj2DBh1qxD0ngBEWC__NZlyFFbYP4m77ws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC0EIiz_wYtRlMGqCn9145YD0wBWobGNIqHsrJ0gWNwg&oe=69B2C4F4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY1EvzUoA7oQ7kNvwGaCg_e&_nc_oc=AdlX5iDK5-YcrxaiRdIo8myy-bhB2BZRZ1CUIspZqRCWmqt6zD5QRrw7WSBU40FbgZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx014zgb8MQpr_3hUVOQLc9AkqqHfmVZZgJtdBM76-EVg&oe=69B2C416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmCDOKIsBFkQ7kNvwH9d83C&_nc_oc=Adnel-17AftqFFUMXyqcCyNyeOF8O3kFO-KSdxNmHv3R5QldNIKJu9DdQJNPrv5B0wk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwc8mZYqWIybamPd0zfWygqxomo9PVm69lraKATDMSl5g&oe=69B2A7AF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "externa
f&oh=00_AQOL7BuLeX4Zzg8o-r7rZWTeuJfrPsRASFhDyAAtqHHcGg&oe=6AD0E9EF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNW5uqKQ2loQ7kNvwEVxNfZ&_nc_oc=AdqcJLqL61e8R9tKmFuYEAgq9Xfr9X-J3G-VAQJr6yMKWeIf9pZ-yeCHGxa8sA9eA6c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmBlFVs5z2PLYcWcuDmqr0R-MnUw5LE0l-SsSfmm15fg&oe=6AD0FEBA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4LrJnjBQbEQ7kNvwE4Len2&_nc_oc=AdpkTzgT3XCJJeHB9X7GQqPW0evQOD_-IevRrQyLflW0clJ3j3KqIn1Z3Uk4vuJd5lA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd8fVJT6MtEzHJBMmxv0nVTHEtW5CEgjVVfg2rSVEo-g&oe=6AD0DA74"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yikt__bqSB0Q7kNvwG5oF6E&_nc_oc=AdqzoJI8n70u3RSjZ_y7bLUUk6II9s-0IEB9VyrXihgYJeRLPLvE6QtxdLk-BpdWzvU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsE1b5XLdKki_2hPXyRfgsiB22oXI29l-c8NOEJBjVSg&oe=6AD0D996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qTzWSLgCmEQ7kNvwFpysb0&_nc_oc=Ado_z4tksuRldPSHpWkopAKEpyi-zWPZ5RaPHt_XXSf5loeRIb8w23mahwd0CnNn4hg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOT5vGVJL3cPDuMJ35k7RPW1sxSH0mP9m6aUYb0brNcg&oe=6AD0F56F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
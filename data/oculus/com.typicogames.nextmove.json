f&oh=00_AQI_Esx-ZUw5bPj-GthzFza0GcAoXUtJAX_cH9LkOfF3tw&oe=6AAAAE6F"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw6ujwqt1JMQ7kNvwFNRaW-&_nc_oc=AdoSEdTTIKaDfjcJCFerm5ZVtICD6xIT_QgQvus61Gp01QUlLsdkUiUnOAI2QTDYN8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-eDIs8B7aur6FOYNrcito886G_EWDO21jL7EUBponaQ&oe=6AAA8AFA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkyu6FekeUQQ7kNvwHAYIW7&_nc_oc=AdppjC0peOmZPLIX2cnkHRS-3neq8y-4b_0KXfDkxb4qQgy_Q2l2LuYazwDaijdN00Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINkob7YmeGjRdS1Ndajpd1RdOwwO4FtR9-fCAcQ1LMGQ&oe=6AAA9EF4"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UBjm4MkJWsQ7kNvwFRqet-&_nc_oc=AdplA11_ciwcBXe3PoYKMlkOugKt2o7DV9GrA_O21Qk5maNwS8qxmWHi2FgbJpP9i0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiG3h5kCtI-bsg_KePP46z6FMAjDZUaP39fQNRssoYpg&oe=6AAA9E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJQ-8681yqYQ7kNvwEGXTmF&_nc_oc=AdrkoZPtDhR7ogTyxvmiDpqkgBhWHO8qfSInpYNEM7v9t1TvQae3LMXn29OVm7zr80g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX8iEpJJZkDoQUCtXhDNEuVVpZloRRgm1aoX6VYYkSTg&oe=6AAAB9EF"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
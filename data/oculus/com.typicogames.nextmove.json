f&oh=00_AQLtXI0A2f_V-i2AmXDbWVcZ1pQSwVVVnLCZnTjvvjUqtA&oe=6AABFFEF"}, {"file_name": "S02.png", "id": "1056640998680341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974852_1056641002013674_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdN9_eQS9BsQ7kNvwF0Vbum&_nc_oc=AdrlgZSo7E8LJ4aFVwJLeS4PTbTYmnDPw0cJ2muT71biU3hP-_vJZ9ELzbm6FzoqOnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL__VSaP9H4Z-D2cwwc1ysRs1vjIFZsxFOEgSdMgxOW2w&oe=6AABDC7A"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkyu6FekeUQQ7kNvwH1nRg4&_nc_oc=Adp6Q55kiWFqbQCYmBQLlDVqrKw4OnqfwBLPQLFV8BrHpMM1DR7kOtvnGlmGaiMInsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW6cns4eFjNqaJe4mnp5Yrw_esgbyfn2VcqTg8Zex7CQ&oe=6AABF074"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TciaT9nNCcoQ7kNvwHJn1VX&_nc_oc=AdolgTXFAikFH4EOasZ4VPlpjjbOVS74oQwIIw6xOrtwLrsYhjfuREwJ0FfUjpNvQLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICEuK0MkUlj1Zc8D7-5ilOF5eikR2emHuYiYijEY8ajg&oe=6AABEF96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJQ-8681yqYQ7kNvwERMzpY&_nc_oc=AdqN8a_o5YyTMKWq2h9-wt7jOG9NBNAXN6ABbiCmO8uMMZ-uD1H3GU6vOTU6ZXZjv84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYX57fFWdkNqSuBNnU_27nYfzoP6WhWBop6sUYnGF8_w&oe=6AAC0B6F"}, "display_name": "Next Move", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
4_4761754661857566275_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX9qwFfwlQ8Q7kNvwGEQzhp&_nc_oc=AdqAxylZFoBrYCKQlktTJlAJsZ6ONXplvhLX-aNcaqc12QVoLg2ZAuKyuAM1-_DBRA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYC5x79QWp1v5Qq98d1Nv3tNW9sPC_35GSTwwhqZeo0Q&oe=6AC12CBA"}, {"file_name": "S03.png", "id": "872398361128505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031332_872398364461838_2263855009932982984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2SLoru1M5sQ7kNvwFzr3_p&_nc_oc=AdrU0N5SXpbDm6q9hoxdjhvot4pB8I5lzbGuKQDp4pt8zEKAJhA7rVGJ-NP4uS_KqjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIbACiRfXs6zyLz-hUXCkuRAufKhgsxuMnV6gdoDjuew&oe=6AC10874"}, {"file_name": "S05.png", "id": "358323299978559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974811_358323306645225_8838719242007339138_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK3ZwTN0lswQ7kNvwENtAuM&_nc_oc=Ado5NDWYl2ySnpW3tgBPF5p5wTjC8_Wk1YhyyRzuc6UVsgH9Z-GS147-dX3uS75k8H0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPysS3ez7-AoHTnsh4-P8My1eGE_bPo-c8L83C0YGePqA&oe=6AC10796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "247394871658138", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_247394874991471_6651050792807733714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t359S-BqD4UQ7kNvwGafZ__&_nc_oc=AdoIoJ1GGThm_Mh16IFy4ugUC-L_si08WQPs6DN76IMNY5W7V4V40bA2UW_BNh4P7IY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPixbswOWHpTKJ3HSPMzLZHef2p0iEk0EsvitpkdJN56w&oe=6AC1236F"}, "display_name": "NextMove", "keywords": [], "long_description": "Dreamlike VR Platformer Adventure\n\nTake a journey through surreal landscapes and fantastical architecture with your physical movements directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will.\n\nTrue VR Experience: No joystick walking! All in-game movements correspond to your real-life actions, making for an engaging and immersive adventure.\n\nDreamy Worlds: Explore mesmerising environments filled with whimsical architecture and otherworldly charm.\n\nTime for a challenge: Test your skills by climbing rotating towers, chasing gondolas across misty lakes and even bending the time itself to overcome intricate puzzles, and environmental challenges.\n\nClassic Platformer Feel: Enjoy the nostalgia of traditional platformers, now enhanced by the immersive power of virtual reality.\n\nTry out 3 full levels and tutorials in our Free Demo to get a taste of the captivating experience that awaits you in Next Move.\n\nMOVEMENT FEATURES:\n\n    Running: Swing your hands like you do while running/walking.\n    Jumping: Swing both hands upward.\n    Climbing: Grab the ladder with your hands.\n    Air Control: Swing your hands in the air.", "short_description": "Take a journey through surreal landscapes and fantastical architecture with this VR platformer. Your physical movements are directly translating to in-game actions. You will experience classic platforming like never before while bending the time itself to your will. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://typicogames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Typico Games s.r.o.", "support_website_url": "https://typicogames.com/", "website_url": "https://typicogames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
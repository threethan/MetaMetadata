": "Untitle2222d.png", "id": "1912606519328753", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822034_1912606525995419_7541342920971005193_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-FVh7902BwQ7kNvwHi9xE6&_nc_oc=Adqeref3-hO03lKG7yfD65Ai7nZ53fXJbjtU-TwuNmz0QNN1OZcSBBKD7jB5RUk3OwM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAHTkDz820sdB4XYNpJkYMg-S-le_fB4le97g2bkyHVA&oe=6AFB36F8"}, {"file_name": "Untitle2222d.png", "id": "1748820522480597", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820208_1748820525813930_4502059080447491783_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HbCZuA90XYQ7kNvwH3wZkD&_nc_oc=AdoS0Oo8Why2Jg71SVPhkiQrop-JsGW7-yBVMnjVBUxwXrqSd80S5M2SLURx41leAj4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIK9xlAsapznPHNcBQzJEWAY6CIPMJT7m6V07iz8SHKw&oe=6AFB23D4"}, {"file_name": "Untitle2222d.png", "id": "1184814450528020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307326_1184814453861353_1980196718273096040_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPlLc_Nh2z8Q7kNvwGN8NB_&_nc_oc=AdplAvaXHrFD0z3UjsOHLAvnphMLTMUH3fbp6fMlYElB2NGWHlAVIocLyxgwGz4IPbA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwsD8tPxsVcLU_Qu32BZkc9R_sVqHJ-1a5_h64iK2ILg&oe=6AFB2EA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Running", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Running drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Running is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/13XCm7hsH4utcElLLhx_FJZg34iHIO8zdcPIiu1HLwrc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumrunning/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25872356055703003"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26728653696739897", "version": "1.1.100"}, "id": "2539030906493203", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {
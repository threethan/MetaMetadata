CI5fKsa2YoSW2smagYTjFv8faygHTQunOvaPClJKuw&oe=6B047178"}, {"file_name": "Untitle2222d.png", "id": "1748820522480597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820208_1748820525813930_4502059080447491783_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opxegx39skEQ7kNvwEcKO3S&_nc_oc=AdrS8nz3iVwN47jbaQHcrHgCaOZUTCuYoJaYLrvYPrSpLMOXviI-IpOq0Z_xWyEvGwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ9keMEOcS5_0-XWz2zwtM9S6CQQa50wT3Ptg9rIEAlA&oe=6B045E54"}, {"file_name": "Untitle2222d.png", "id": "1184814450528020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307326_1184814453861353_1980196718273096040_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HLEcGRCeBEQ7kNvwHBq3m1&_nc_oc=AdpyIXaA-YeWWvtdipEbOhYpH_fBBENoqmp43mgGckvaYbxNJSaR2yr2eV6JxcmIV-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu-XBk6xPGPGPmMQrozF9KfUGKnYJf-dNOTsBJpfKhlg&oe=6B046924"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Running", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Running drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Running is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/13XCm7hsH4utcElLLhx_FJZg34iHIO8zdcPIiu1HLwrc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumrunning/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25872356055703003"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300619_1557720825510293_5358439346875960018_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuw3ooBWrXwQ7kNvwGLPZa0&_nc_oc=AdpHre3NWFSz5b9IASLOu8eEU3vDh3yoUMyTmFCFJsUJmTWoh2pRCQ5zMxsd4CIGi7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ395AEEl5pIGicY29V5ySLKQ8qPJDTKEHZ0f6hZlesPA&oe=6B045522"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Opium Running", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "5281423164603
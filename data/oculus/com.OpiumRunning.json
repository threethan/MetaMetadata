": "Untitle2222d.png", "id": "1912606519328753", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1912606525995419_7541342920971005193_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLGwSVXH5PAQ7kNvwHiE6vF&_nc_oc=AdrniA4gSl8mCHV8TSfyaN_SBLzAHm7HWsoh4Dm38qCXXpcMApd_LH7cGH6csNkuZ_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2gBYRJyFhilNEpA1aiMQnUSl7BlsylQAtgYjyl1URAQ&oe=6B0EFD78"}, {"file_name": "Untitle2222d.png", "id": "1748820522480597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820208_1748820525813930_4502059080447491783_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIjwjoAFqcMQ7kNvwGYWUR7&_nc_oc=AdqJj02u_g0RtQHTv6QIOsGfEHGRy2Mj1sljOsxlmm0k_o4LyEdaZpmpFkV4FBEnUqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKiwG7ku0ItHqz51F8KQf9XqK0OvNd1fE-N2jgsgKnyw&oe=6B0EEA54"}, {"file_name": "Untitle2222d.png", "id": "1184814450528020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307326_1184814453861353_1980196718273096040_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv9iXpdGikAQ7kNvwF9F9Qe&_nc_oc=AdohYM3Mp4fFVat2D1C0snzJyRpUMme2iWhcfjrnX3BcDuor95QlGfrTHO6v7qweY5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9XAT7TMv7TXbdY86J8EchSUvUlX2bYbqgaroNGJlbAA&oe=6B0EF524"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Running", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Running drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Running is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/13XCm7hsH4utcElLLhx_FJZg34iHIO8zdcPIiu1HLwrc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/opiumrunning/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25872356055703003"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26728653696739897", "version": "1.1.100"}, "id": "2539030906493203", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {
ry.colorballmr-20251107-150731-1 (0-02-18-31).png", "id": "1179227937643873", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299164_1179227940977206_3333494265874775803_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEGGU4K2xbcQ7kNvwEy857n&_nc_oc=AdlJJrWz-FqEk2guYksF36dR6peBo-_gNjCrn_7-5rB34DNnkRQ377V_dS0uTTMlMWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYzr_nD3ijemx2eXrmZzudKnD0nkhZ6EYV5AJiYY4mWQ&oe=69A96F69"}, {"file_name": "com.newstory.colorballmr-20251107-150731-1 (0-01-21-20).png", "id": "1487677309011837", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296465_1487677312345170_258541675610207891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoWf_ePtNyMQ7kNvwGL1SR6&_nc_oc=AdmTswcAIFUw9Zrm7lSTsJRPjqzC5W8qC89HoBO_wFe_q55iL9QEMbfi1kU1fAuR4mg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuZvvAjwCnpHhsBjp8Fv7omd--6Xo4zcTu6VVt3Nt5d5w&oe=69A9828D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Color Ball MR - SplashWalls", "keywords": ["Painting", "Splat", "Splash", "Paint", "Throwing"], "long_description": "Welcome to Color Ball MR, the most playful way to paint in Mixed Reality. Have you ever looked at your boring white walls and wished you could just... throw some color at them? Now you can.\n\nSplashWalls uses your Meta Quest's passthrough cameras to turn your living room, office, or any real-world space into an interactive canvas.\n", "short_description": "Just pick up and throw colorful paintballs at your walls, furniture, and ceilings. Watch them splash and splat, transforming your space with vibrant colors.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"i
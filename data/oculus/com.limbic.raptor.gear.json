A826C4"}, {"file_name": "migrated_image.png", "id": "1421263998078679", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427628_566595230382062_7564833912577327104_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0ReRoii348Q7kNvwHEIUzb&_nc_oc=Adle4caFtZmWlKHGZVtHIRdvZv-20v5FdZsaXj8_l37PncIFT4NFwcRskRk4JjpDL8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afub0Cd1AyaimFMiGz3ijLbuTeskX38-rrPj4mws13Lt2Q&oe=69A83023"}, {"file_name": "migrated_image.png", "id": "199323351514000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504788_322938688233940_7472215816172208128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns4pnOFeXm8Q7kNvwHIN7hF&_nc_oc=AdnYwT13cIgbKO2ED8INYKwDKjfTlc1nOF8dFOEqID43uCUhPO4c6erG2kenZQqMc1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvTcELZIA3asx9O88HxsG1Y4oeppmVvbGtECjEdimzGPw&oe=69A83AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kjrXUm", "id": "1977502622579249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410487_1977502625912582_136891581364961280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RMfjNVsWSEQ7kNvwGYPhhP&_nc_oc=AdmwPaIc-R9oseZkJ17_xB7r5y4mRyXfpdto5havBti3teLTDlxhM9A_VTXz9K4AIJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfucJuynjv1azeVtxnFpsZ1WT3VpzmVYFU0xR78yUHpC2Q&oe=69A82751"}, "display_name": "Zombie Gunship Raptor", "keywords": ["zombies", "helicopter", "shooter", "military", "gun"], "long_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nAim and fire devastating weapons from your Gunship Helicopter to defend against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles or you'll be overrun by the  zombie horde.\n\nREPLAYABILITY\nMultiple missions with unique challenges on each difficulty level. Plus compete for position on the Leaderboard in Survival mode.", "short_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nFire devastating weapons from your Gunship Helicopter against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles.\n\nREPLAYABILITY\nMultiple missions and difficulties, plus Survival mode."}]}, "developer_name": "Limbic Software, Inc.", "developer_privacy_policy_url": "https://www.limbic.com/privacypolicy/", "developer_terms_of_service_url": "https://www.limbic.com/terms-of-use/", "publisher_name": "Limbic Software, Inc.", "support_website_url": null, "website_url": "http://www.limbic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "438518151202142"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1798582170209073", "version": "1.0.0"}, "id": "2013304175557314", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"
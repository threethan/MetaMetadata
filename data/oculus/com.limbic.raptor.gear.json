B7F8C4"}, {"file_name": "migrated_image.png", "id": "1421263998078679", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427628_566595230382062_7564833912577327104_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J43UDrJNLMYQ7kNvwFfqWbw&_nc_oc=Adm3n-rLs2hs-lVTG4ODwXzhTFYc3hNTE6HQgoIsb0IZo1z7ekwZHAVJKKz8TLRdfqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9pCi2NJ95ZoRL0XSUkrj4MTH-sAQy-Xv5P1TBpSQP7g&oe=69B80223"}, {"file_name": "migrated_image.png", "id": "199323351514000", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504788_322938688233940_7472215816172208128_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b4-xjBf0eAQ7kNvwFfMvJM&_nc_oc=AdmxRRJjGs2oN0ok9eup467DnIUr9nLw_UkJe927BGM--V9KJU0SHQet3EZrjySutpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuBHIiahg45D-I1ri017sw0cARQGTLcVOa5UcDpox1Bg&oe=69B80CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kjrXUm", "id": "1977502622579249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410487_1977502625912582_136891581364961280_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP0erM9WarIQ7kNvwEZAGMQ&_nc_oc=AdltF36lD0IjJWnGiOM0KUWg179ftpXCHqS21Y6_SI_0hJdmc3pMNzSZIN-wrNu8cZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxypB1lN4kin4odtMUbeqOnywz04mQUYCbxrfJWgXCpA&oe=69B7F951"}, "display_name": "Zombie Gunship Raptor", "keywords": ["zombies", "helicopter", "shooter", "military", "gun"], "long_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nAim and fire devastating weapons from your Gunship Helicopter to defend against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles or you'll be overrun by the  zombie horde.\n\nREPLAYABILITY\nMultiple missions with unique challenges on each difficulty level. Plus compete for position on the Leaderboard in Survival mode.", "short_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nFire devastating weapons from your Gunship Helicopter against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles.\n\nREPLAYABILITY\nMultiple missions and difficulties, plus Survival mode."}]}, "developer_name": "Limbic Software, Inc.", "developer_privacy_policy_url": "https://www.limbic.com/privacypolicy/", "developer_terms_of_service_url": "https://www.limbic.com/terms-of-use/", "publisher_name": "Limbic Software, Inc.", "support_website_url": null, "website_url": "http://www.limbic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "438518151202142"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1798582170209073", "version": "1.0.0"}, "id": "2013304175557314", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"
ZSXFpGu7a31lp1BKk1ZJ6gQdRobPNlErJOsYFLsmlzmbjC8GI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeguyY9jrm9X7EseuOYvHvC9jA3CQyhLexN4s07MMhAQ&oe=6B05BD11"}, "display_name": "Zombie Gunship Raptor", "keywords": ["zombies", "helicopter", "shooter", "military", "gun"], "long_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nAim and fire devastating weapons from your Gunship Helicopter to defend against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles or you'll be overrun by the  zombie horde.\n\nREPLAYABILITY\nMultiple missions with unique challenges on each difficulty level. Plus compete for position on the Leaderboard in Survival mode.", "short_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nFire devastating weapons from your Gunship Helicopter against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles.\n\nREPLAYABILITY\nMultiple missions and difficulties, plus Survival mode."}]}, "developer_name": "Limbic Software, Inc.", "developer_privacy_policy_url": "https://www.limbic.com/privacypolicy/", "developer_terms_of_service_url": "https://www.limbic.com/terms-of-use/", "publisher_name": "Limbic Software, Inc.", "support_website_url": null, "website_url": "http://www.limbic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], 
_name": "Zombie Gunship Raptor", "keywords": ["zombies", "helicopter", "shooter", "military", "gun"], "long_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nAim and fire devastating weapons from your Gunship Helicopter to defend against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles or you'll be overrun by the  zombie horde.\n\nREPLAYABILITY\nMultiple missions with unique challenges on each difficulty level. Plus compete for position on the Leaderboard in Survival mode.", "short_description": "ZOMBIE GUNSHIP RAPTOR is the ultimate virtual reality zombie shooter. Take control of a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nFire devastating weapons from your Gunship Helicopter against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles.\n\nREPLAYABILITY\nMultiple missions and difficulties, plus Survival mode."}]}, "developer_name": "Limbic Software, Inc.", "developer_privacy_policy_url": "https://www.limbic.com/privacypolicy/", "developer_terms_of_service_url": "https://www.limbic.com/terms-of-use/", "publisher_name": "Limbic Software, Inc.", "support_website_url": null, "website_url": "http://www.limbic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
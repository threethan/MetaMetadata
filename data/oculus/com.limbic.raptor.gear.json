f a heavily-armed helicopter gunship and obliterate zombies from the sky.\n\nVR GAMEPLAY\nFire devastating weapons from your Gunship Helicopter against a zombie apocalypse.\n\nINTENSE BATTLES\nFight hordes of zombies using night vision, IR, and thermal cameras.\n\nDEVASTATING WEAPONS\nUpgrade your Gunship's machine guns, rockets and missiles.\n\nREPLAYABILITY\nMultiple missions and difficulties, plus Survival mode."}]}, "developer_name": "Limbic Software, Inc.", "developer_privacy_policy_url": "https://www.limbic.com/privacypolicy/", "developer_terms_of_service_url": "https://www.limbic.com/terms-of-use/", "publisher_name": "Limbic Software, Inc.", "support_website_url": null, "website_url": "http://www.limbic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "438518151202142"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1798582170209073", "version": "1.0.0"}, "id": "2013304175557314", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1564071926993433", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1798
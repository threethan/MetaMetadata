40D"}, {"file_name": "02_Select.png", "id": "775894657385953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422387_775894660719286_7706048991940202269_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy0vaQTCjC0Q7kNvwEjtmfR&_nc_oc=AdnL94OY8Nw9Fhy5qYW2u_6ilzT_4wju_Ft_p4OGngp4GeQhZLVoJyDxD3kHZBcXClA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8ACfQDh3SQydIlINtK0cgrUIJfkbTAKmMAnZZy4r4TQ&oe=69A6CE36"}, {"file_name": "03_RightSaberDisable.png", "id": "337248882633963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294241_337248889300629_4915515880094386044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28AIR2jvEGcQ7kNvwF06X5l&_nc_oc=AdnbeaHUWAifQrkPNYSaspxevPDtxglNyfR7zAeHAo-j6YXJG6Ej-58OZbb5237OptA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnyhszIVJxX5Rk4DWl_uaA6Qh0Jll_4lAdzvGkPPQzeg&oe=69A6E251"}, {"file_name": "03_RightSaberEnable.png", "id": "3486643708316775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75302225_3486643711650108_6026949720335473223_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l-DKUFtFY4Q7kNvwE9IzqU&_nc_oc=AdkViIH9tqpvvZjQrU1csN1j3LeIBYbb6OHwnI02GZ2Nd3cIY0a0qpjzhH--W_ykMDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvdiTGzP5FNJApuAY4ePJdrSdk0rc_oNYqHCicz2tLrjw&oe=69A6E63E"}, {"file_name": "06_MeshCut01.png", "id": "7065716766816659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223470_7065716773483325_1478637253818509986_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YmhXgLJT04Q7kNvwHeeFcj&_nc_oc=AdncwqgI0TdrM1vLHrCuTSA4yMR1ih65lhesQZ4c1PABUV9GACm9tYEvUqdYmC5Z0oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFOetorzKJSCxLhzHvMMtcLDMwzoyodWqGz-0RgHL7KQ&oe=69A6D966"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud06c\ub85c\uc2a4\ub9e4\uc4f0-VR-\uac00\ub85c\ud615.png", "id": "2272979282906786", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223486_2272979286240119_6958588813366122620_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGDDxWUBt8wQ7kNvwEnX8Om&_nc_oc=Adk3SU3Ylc1fnllvN4Vmjl18xlYGCTxaj2ULve6brcw-2rZFxngsCN9MYvLhm7DF5DE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvdDFgRKR7SzPX_j9KJUDnQfRjS-8NTLUw-T-JsLXpAYw&oe=69A6DE64"}, "display_name": "Cross Math VR", "keywords": [], "long_description": "Learn the basic concepts of geometry for elementary, middle, and high school levels, such as cross-sections of solid figures, through an immersive VR experience! Upon receiving your MISSION, identify the shape given and then use a lightsaber to slice through the incoming 3D figures! If the cross-section matches the shape of the MISSION, you will achieve MISSION SUCCESS! This enjoyable HandsOn experience is designed for students of all grades. As you move and slice through shapes, the principles of 3D figures from the curriculum are embedded into your mind. The exciting VR experience combined with a gamification system that encourages active participation promotes voluntary learning and growth.", "short_description": "Cross Math VR | cross-section of a 3D"}]}, "developer_name": "Hey Iam Co., Ltd.", "developer_privacy_policy_url": "https://popschool.us/member/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Hey Iam Co., Ltd.", "support_website_url": null, "website_url": "https://popschool.us/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
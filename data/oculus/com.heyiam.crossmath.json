5.png", "id": "2272979282906786", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223486_2272979286240119_6958588813366122620_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-6DX36k8DYQ7kNvwHvDD-u&_nc_oc=Adqjq5YYTXrs1WAo3hwgNhLNcLw-oaID5suc0Ykniw4ZFTdAAByM5TRtTaOW9sCaR6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3uO1UQa9u_RjY1j2dzI8gSJuQagy6vOdPhKcqLgj9jw&oe=69D10E64"}, "display_name": "Cross Math VR", "keywords": [], "long_description": "Learn the basic concepts of geometry for elementary, middle, and high school levels, such as cross-sections of solid figures, through an immersive VR experience! Upon receiving your MISSION, identify the shape given and then use a lightsaber to slice through the incoming 3D figures! If the cross-section matches the shape of the MISSION, you will achieve MISSION SUCCESS! This enjoyable HandsOn experience is designed for students of all grades. As you move and slice through shapes, the principles of 3D figures from the curriculum are embedded into your mind. The exciting VR experience combined with a gamification system that encourages active participation promotes voluntary learning and growth.", "short_description": "Cross Math VR | cross-section of a 3D"}]}, "developer_name": "Hey Iam Co., Ltd.", "developer_privacy_policy_url": "https://popschool.us/member/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Hey Iam Co., Ltd.", "support_website_url": null, "website_url": "https://popschool.us/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
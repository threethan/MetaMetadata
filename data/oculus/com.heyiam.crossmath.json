3416F6"}, {"file_name": "03_RightSaberDisable.png", "id": "337248882633963", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75294241_337248889300629_4915515880094386044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g2330Z_7KoQ7kNvwFlbo5J&_nc_oc=AdolDixY5-mHaW32NzNLre9YI25xKfvXodk4ZnRowH6WMYcNm7B_pbas2dVL0Q_3HEc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5V8bA3l9hRCQ9B9e9hF5xytEMcZ57gPXUTDn55i5oVA&oe=6A33F2D1"}, {"file_name": "03_RightSaberEnable.png", "id": "3486643708316775", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75302225_3486643711650108_6026949720335473223_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_OO0GBfbmUQ7kNvwHurAqL&_nc_oc=AdpclhsX5fphcF1JK0RpEo1YalAbqTPLQvrGRBFuDU1Qxb01i-6L2HLw0ppny6-i31U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af951Kb2sMpydIjN53PUhM5bBaPt83bmvkdhE7AqN6bgnQ&oe=6A33F6BE"}, {"file_name": "06_MeshCut01.png", "id": "7065716766816659", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75223470_7065716773483325_1478637253818509986_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE4h1PeKYiEQ7kNvwEfxlrd&_nc_oc=AdoBv9qqJWFKVu53TCcVt7QcKReLMc-OHm51pOaaGrVEMP-0N8CItip4JOLLBRkCC4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wJ9FopqlRtjnYWgfa_DGsztrfa7y9lkuubp8Xu-KHGQ&oe=6A33E9E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud06c\ub85c\uc2a4\ub9e4\uc4f0-VR-\uac00\ub85c\ud615.png", "id": "2272979282906786", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223486_2272979286240119_6958588813366122620_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTlz_mfPBT8Q7kNvwGcNSTZ&_nc_oc=AdqcRWVjt_T5gZuC0U3GImOdFV3K9gYPYyaBZaS1eftAbieLGrAvuw457MZH4bodVE4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HRoCqxylfNRxBt69wSK_Vzm2rA9B7J00cWye4sg-QJA&oe=6A33EEE4"}, "display_name": "Cross Math VR", "keywords": [], "long_description": "Learn the basic concepts of geometry for elementary, middle, and high school levels, such as cross-sections of solid figures, through an immersive VR experience! Upon receiving your MISSION, identify the shape given and then use a lightsaber to slice through the incoming 3D figures! If the cross-section matches the shape of the MISSION, you will achieve MISSION SUCCESS! This enjoyable HandsOn experience is designed for students of all grades. As you move and slice through shapes, the principles of 3D figures from the curriculum are embedded into your mind. The exciting VR experience combined with a gamification system that encourages active participation promotes voluntary learning and growth.", "short_description": "Cross Math VR | cross-section of a 3D"}]}, "developer_name": "Hey Iam Co., Ltd.", "developer_privacy_policy_url": "https://popschool.us/member/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Hey Iam Co., Ltd.", "support_website_url": null, "website_url": "https://popschool.us/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7795168817173555"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7795146303842473", "version": "1.0.0"}, "id": "719909623596817", "channel_name
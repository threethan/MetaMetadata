AdquScbbqXA2Z3nT2YmUFVRh6k1u-zSfxEonfLQQ3thEgxzvNyBc4pzFTRjkDmqBiyQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvGg9-FjZJQYmI1BRk4fUGCw7LsqYJdrAETDRrX4NqNw&oe=6AFB34A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud06c\ub85c\uc2a4\ub9e4\uc4f0-VR-\uac00\ub85c\ud615.png", "id": "2272979282906786", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75223486_2272979286240119_6958588813366122620_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMf1kDSgl4gQ7kNvwHjl03u&_nc_oc=AdpIFCqpJYILgNVceJL5s-YJ0Jh1KFrC5tfx0lMCbetqyRnxNpNiaK2xjVaa9U3PeaA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRZdJ4juM7JRsEPcNC7WFY0KeEOHia7y-aIuHgM6BUsA&oe=6AFB39A4"}, "display_name": "Cross Math VR", "keywords": [], "long_description": "Learn the basic concepts of geometry for elementary, middle, and high school levels, such as cross-sections of solid figures, through an immersive VR experience! Upon receiving your MISSION, identify the shape given and then use a lightsaber to slice through the incoming 3D figures! If the cross-section matches the shape of the MISSION, you will achieve MISSION SUCCESS! This enjoyable HandsOn experience is designed for students of all grades. As you move and slice through shapes, the principles of 3D figures from the curriculum are embedded into your mind. The exciting VR experience combined with a gamification system that encourages active participation promotes voluntary learning and growth.", "short_description": "Cross Math VR | cross-section of a 3D"}]}, "developer_name": "Hey Iam Co., Ltd.", "developer_privacy_policy_url": "https://popschool.us/member/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Hey Iam Co., Ltd.", "support_website_url": null, "website_url": "https://popschool.us/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
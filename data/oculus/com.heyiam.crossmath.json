sjYLpTF6OHVU5L8RVyYHINM-xZ2png&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBIc1TkNreBIRzUywguXpdHfeUpry7vxk1uCRPLYFTwQ&oe=699C5651"}, {"file_name": "03_RightSaberEnable.png", "id": "3486643708316775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302225_3486643711650108_6026949720335473223_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS7IWe1OWPsQ7kNvwEdDt0q&_nc_oc=Adm8bqk0o4VDFN2P4H_iS7TrQzQtc0gvQhom4mdlKxmEehlh31xipZxkYhqaTd-ITRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfudO36Twvf35eV-KW_HrLSRF0ejtZ4fd5qV4dHgmzJywA&oe=699C5A3E"}, {"file_name": "06_MeshCut01.png", "id": "7065716766816659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223470_7065716773483325_1478637253818509986_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPZ8WvWUL4IQ7kNvwFpUB8y&_nc_oc=AdlOwJKnq4J9onis0SSqJRcHmEfYOWuLWr3hEAKGXdHfGgaYTAF5pnokZvxf5NL9cjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuLi5HWSmZRhv4Fzsn4BuRHFbsbrz0CsKe19bIb8WfJOw&oe=699C4D66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud06c\ub85c\uc2a4\ub9e4\uc4f0-VR-\uac00\ub85c\ud615.png", "id": "2272979282906786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223486_2272979286240119_6958588813366122620_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv4E8INCelkQ7kNvwHuXdwV&_nc_oc=AdmdHBLGwNFo2OmYo2IIiVfGAck9xAJlLSTs2uVmgS4W7oZq976zZFPU6COVg1j_7M4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsAN1AwhGDU4GxbFSmF432-1SV0HrAJjvvWngfHeJ4ICg&oe=699C5264"}, "display_name": "Cross Math VR", "keywords": [], "long_description": "Learn the basic concepts of geometry for elementary, middle, and high school levels, such as cross-sections of solid figures, through an immersive VR experience! Upon receiving your MISSION, identify the shape given and then use a lightsaber to slice through the incoming 3D figures! If the cross-section matches the shape of the MISSION, you will achieve MISSION SUCCESS! This enjoyable HandsOn experience is designed for students of all grades. As you move and slice through shapes, the principles of 3D figures from the curriculum are embedded into your mind. The exciting VR experience combined with a gamification system that encourages active participation promotes voluntary learning and growth.", "short_description": "Cross Math VR | cross-section of a 3D"}]}, "developer_name": "Hey Iam Co., Ltd.", "developer_privacy_policy_url": "https://popschool.us/member/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Hey Iam Co., Ltd.", "support_website_url": null, "website_url": "https://popschool.us/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7795168817173555"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7795146303842473", "version": "1.0.0"}, "id": "719909623596817", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7574733252550447", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7795146303842473"}, "release_status": "REL
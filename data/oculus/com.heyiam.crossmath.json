E762F6"}, {"file_name": "03_RightSaberDisable.png", "id": "337248882633963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75294241_337248889300629_4915515880094386044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuoWtkYy6AMQ7kNvwEG_mL9&_nc_oc=AdoG5MT7ticvZUxRZmMhen3TIdX5ApZK1eoMR35aFKsml0_n2dJORvYbiHYJ9Fzr_g0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp60zfyMPCBEqAuWOeWivqWrj9ElS68NHfOWfjPuOUKg&oe=6AE73ED1"}, {"file_name": "03_RightSaberEnable.png", "id": "3486643708316775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302225_3486643711650108_6026949720335473223_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6drBjcUlpcQ7kNvwHXAUP9&_nc_oc=AdrYPQ-fqA3AXmXGjURA_NSkW6Nh9JPqsBs4EUtKdOqVsXbvZfkJvlvGjP-Y-PGJP84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Bm5DA-TsMsqPxyesll-ZMuOaI0RL4h_hUalR_2nxDw&oe=6AE742BE"}, {"file_name": "06_MeshCut01.png", "id": "7065716766816659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223470_7065716773483325_1478637253818509986_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6DwgaQs8AYQ7kNvwGZVonF&_nc_oc=AdpcKbizFMazmHlGF41FkbAwzuXya7GQHcNLqQ2BIWny0pVDXvqQCmm1kxRufj_4qB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJNVrnLoXLAHFd9nu5N0VTbMeBYx0oW4FnQPCczLWvWA&oe=6AE76E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud06c\ub85c\uc2a4\ub9e4\uc4f0-VR-\uac00\ub85c\ud615.png", "id": "2272979282906786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223486_2272979286240119_6958588813366122620_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTAh1wQ_QtUQ7kNvwG98kui&_nc_oc=AdqC8HdAf2OS1Eb4rF0rfZUESCTjg04MhV5nr11p0AmUYgUgUd36I_bs7zeeHjdHUlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKs5FaNq_xkJw88eo1JTAeCWPxITxvSg9Tr2zsdB0M2Q&oe=6AE73AE4"}, "display_name": "Cross Math VR", "keywords": [], "long_description": "Learn the basic concepts of geometry for elementary, middle, and high school levels, such as cross-sections of solid figures, through an immersive VR experience! Upon receiving your MISSION, identify the shape given and then use a lightsaber to slice through the incoming 3D figures! If the cross-section matches the shape of the MISSION, you will achieve MISSION SUCCESS! This enjoyable HandsOn experience is designed for students of all grades. As you move and slice through shapes, the principles of 3D figures from the curriculum are embedded into your mind. The exciting VR experience combined with a gamification system that encourages active participation promotes voluntary learning and growth.", "short_description": "Cross Math VR | cross-section of a 3D"}]}, "developer_name": "Hey Iam Co., Ltd.", "developer_privacy_policy_url": "https://popschool.us/member/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Hey Iam Co., Ltd.", "support_website_url": null, "website_url": "https://popschool.us/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7795168817173555"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7795146303842473", "version": "1.0.0"}, "id": "719909623596817", "channel_name
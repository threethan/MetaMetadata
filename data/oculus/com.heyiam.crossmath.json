F8D"}, {"file_name": "02_Select.png", "id": "775894657385953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422387_775894660719286_7706048991940202269_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYijzzjKL7sQ7kNvwFT4EAQ&_nc_oc=Adk-xCq2n0VOr3LMCDDHKMUoQa0Lf4LyjHO-6nqP6c9wL2IYMMdNhS5Aobo0RNO4ehY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4bez0eg6GSfPH-jxHMB0Yk8QKDYSvC6aJFEGKtQ-_xA&oe=69A2D9B6"}, {"file_name": "03_RightSaberDisable.png", "id": "337248882633963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75294241_337248889300629_4915515880094386044_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voFwWdvQQGYQ7kNvwFBMT3X&_nc_oc=AdlhCT_E1kAVcbOn0XNzsbZmNJ1yEYZA2w3DnQ9ZoV4yxYCUC9UFzbherg2Fk8EVRj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQf_QMMsT4Om-iyoFKQ7_LZnLdrw2SiaInXNyfxF7EHw&oe=69A2EDD1"}, {"file_name": "03_RightSaberEnable.png", "id": "3486643708316775", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75302225_3486643711650108_6026949720335473223_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69anM-GNMGMQ7kNvwFtV0JH&_nc_oc=Admh33v8kq6LacBX-E30MktN5MZJb5esM3ai8pvpDf5GNTdYAyyoXD6lfVDb0tUjRzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGhNeKwlxwhY4n0ysd-dM_fH4Udc14n-0Zow2PlVkALA&oe=69A2F1BE"}, {"file_name": "06_MeshCut01.png", "id": "7065716766816659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223470_7065716773483325_1478637253818509986_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYVsQAtxd_4Q7kNvwG3ryiK&_nc_oc=AdlkE__ofOWh0LIps5N5GxJ7Nqq9jHRGFDzaQ-V7nyfIt-RT3EwGUMP_6Cj-PE0pWkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurZdYq6khuaF9BAYPeZZcrEEmVD-NkZAGQlvgyG-xnwg&oe=69A2E4E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ud06c\ub85c\uc2a4\ub9e4\uc4f0-VR-\uac00\ub85c\ud615.png", "id": "2272979282906786", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223486_2272979286240119_6958588813366122620_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrvmGCVNSzwQ7kNvwFrzbpp&_nc_oc=AdnixCwt1Z-pVu06jIYIak6c7zfk9fNMfdMSXaUKbeLmLQ4LluoRH007n-MhmUtAcj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs1Bnlz9h00iaGjFajn6T3p3QMnRbrdoAnkkxfK_MVa6A&oe=69A2E9E4"}, "display_name": "Cross Math VR", "keywords": [], "long_description": "Learn the basic concepts of geometry for elementary, middle, and high school levels, such as cross-sections of solid figures, through an immersive VR experience! Upon receiving your MISSION, identify the shape given and then use a lightsaber to slice through the incoming 3D figures! If the cross-section matches the shape of the MISSION, you will achieve MISSION SUCCESS! This enjoyable HandsOn experience is designed for students of all grades. As you move and slice through shapes, the principles of 3D figures from the curriculum are embedded into your mind. The exciting VR experience combined with a gamification system that encourages active participation promotes voluntary learning and growth.", "short_description": "Cross Math VR | cross-section of a 3D"}]}, "developer_name": "Hey Iam Co., Ltd.", "developer_privacy_policy_url": "https://popschool.us/member/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Hey Iam Co., Ltd.", "support_website_url": null, "website_url": "https://popschool.us/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_
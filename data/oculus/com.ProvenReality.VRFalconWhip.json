6b8Mjv2wMsad5ms38Yrn58fLtAPge0xQEtvWS28o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Vr8_RkH9oJBm5Aui59t0_FXCbWkJWJQqNyNbH_UaJ5g&oe=6A43C42A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "2058918255002298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823949_2058918258335631_8589063721509731024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pmAdsOknb0Q7kNvwHZft4H&_nc_oc=AdoT8QlfslnjwmHiCQ5jViGHte8pexNhUzdbLT7NR7bOlRusRh3xvx15wwA6rMtwHAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8InyF6gcOdDyivfCkEhNTnDZMBfKGp_u7NzCjwxNousQ&oe=6A43D607"}, "display_name": "VR Dubai Falcons", "keywords": [], "long_description": "Dubai Falcons is an immersive VR flying game inspired by the spirit of falconry and the Dubai skyline. Players take control of a falcon using either VR controllers or hand-tracking, moving both arms together to simulate the motion of flight.\n\nThe gameplay is simple, active, and intuitive: raise and lower your arms to guide the falcon through the sky, dodge incoming obstacles, and keep flying as long as possible. The experience is designed around natural body movement, making players feel like they are controlling the falcon\u2019s flight directly through their own arm motion.\n\nSet in a vibrant Dubai-themed environment with bold UAE-inspired colors, dynamic skies, flying objects, and city silhouettes, Dubai Falcons delivers a fun and accessible VR challenge focused on timing, coordination, reflexes, and movement. Whether using controllers or hands, players can enjoy a fast, energetic flying experience that is easy to understand and exciting to replay.", "short_description": "Dubai Falcons is a VR flying experience where players control a falcon using their hands or controllers, moving their arms together to fly up and down while dodging obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privac
A9hFLtEbgGY5nP2RTcZOvc66qRh7axQ&oe=6A636D89"}, {"file_name": "01_2560x1440.png", "id": "1978216036136078", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829165_1978216042802744_5345050193838169484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCt2uiRW9CoQ7kNvwGYoTMV&_nc_oc=Ado4RHj2UixsowSftSvV6KHgdVRl3nbgJ882U0ybMSE2ofX87KQD-4-76_vMEFlMcXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGHaVUW8O-Z1OBA04FGHPoVW5_CFlbB73e5f2xCxQaeg&oe=6A6376BE"}, {"file_name": "03_2560x1440.png", "id": "2168884880525280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819822_2168884887191946_7983662642647708411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_cFEyPovCoQ7kNvwHvGKmm&_nc_oc=AdqMFb4KBjr3krEi4A2CIenUjSlyZhUQDjM0G1PLZHWy5wRQ945iBn1FCoJK6Hh7u-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOHcx4lsRewOhbW0RPErkNur_pEAU6KPAvOXbd7GSY6Q&oe=6A63522C"}, {"file_name": "02_2560x1440.png", "id": "1680377173413976", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_1680377176747309_8433825510553152867_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE5C8Qd6ztMQ7kNvwH5AME5&_nc_oc=AdqStJmyYpJDYwnBdbb0YeEruBNcyvlH1PKipai32A0dgnwvJlspiR8YK-LAWG6CQp4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABZRtxwtf1J5C0HX3WncFIS3scpBtQs3eRP_BC1ofyDQ&oe=6A63682A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "2058918255002298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823949_2058918258335631_8589063721509731024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ7cGQd8FK0Q7kNvwFv9zG-&_nc_oc=AdqIVPh-we2ef3qlK1PGb1ZjwhPLHokv3Tz5pBr81z0R5KeyONsYcnydiwj86ECfHWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKfvB9fH8SDbbbdJNYMwryIjA94zT0kUBc0IKIe8FkpQ&oe=6A637A07"}, "display_name": "VR Dubai Falcons", "keywords": [], "long_description": "Dubai Falcons is an immersive VR flying game inspired by the spirit of falconry and the Dubai skyline. Players take control of a falcon using either VR controllers or hand-tracking, moving both arms together to simulate the motion of flight.\n\nThe gameplay is simple, active, and intuitive: raise and lower your arms to guide the falcon through the sky, dodge incoming obstacles, and keep flying as long as possible. The experience is designed around natural body movement, making players feel like they are controlling the falcon\u2019s flight directly through their own arm motion.\n\nSet in a vibrant Dubai-themed environment with bold UAE-inspired colors, dynamic skies, flying objects, and city silhouettes, Dubai Falcons delivers a fun and accessible VR challenge focused on timing, coordination, reflexes, and movement. Whether using controllers or hands, players can enjoy a fast, energetic flying experience that is easy to understand and exciting to replay.", "short_description": "Dubai Falcons is a VR flying experience where players control a falcon using their hands or controllers, moving their arms together to fly up and down while dodging obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven Reality", "support_website_url": null, "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SC
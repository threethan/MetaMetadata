k2fRdhTbCHFKtocLY0Ln_dbJULKKpKQ&oe=6A997B09"}, {"file_name": "01_2560x1440.png", "id": "1978216036136078", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829165_1978216042802744_5345050193838169484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3_deX2yM0oQ7kNvwG-HboK&_nc_oc=AdqMqCUZOLqVqir2Av3DQQLi1mHc76MtTO7gjulb7gyiPASYoswyjkbAWhNaz7Uq694&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYbc_cEjXmr-cCISsuYhr28f7XPtFByKJa6leYjlb8YA&oe=6A99843E"}, {"file_name": "03_2560x1440.png", "id": "2168884880525280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819822_2168884887191946_7983662642647708411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCNZVrMML60Q7kNvwFshn8G&_nc_oc=AdrEb-9e0zGZm_MUrgL-r0aLIlpA7FbY46Tgcgib60y0GBK_Ep5U_jxFZ0g2osEROiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-wXE70_XlhcBBSqSmcMxVEiyCvh4AMk4RDA2Co-Bb1w&oe=6A9997EC"}, {"file_name": "02_2560x1440.png", "id": "1680377173413976", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1680377176747309_8433825510553152867_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL5Iiz8cLe0Q7kNvwGC0eU2&_nc_oc=Ado5kFfjJhRFehIMUd-X8kj5zFLVkto85HtyicUPYXR1_zNCH3xIbXleg42UxMHcGzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzhni7HnDnHAVnqm-3m50VVaa-gE-E7Rw5kruFuVLNMw&oe=6A9975AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "2058918255002298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_2058918258335631_8589063721509731024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjTzne4BjLsQ7kNvwF7j6Ff&_nc_oc=AdoeRkjOewmcz6m_rGbCTTm0djAptoxjQckayxipXq8uzwqqVa9yn5aIaranhuYjHCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi34Bt9GYAQbcQGpvgkYE1cTgxiikvb7J75U-WkXXF7w&oe=6A998787"}, "display_name": "VR Dubai Falcons", "keywords": [], "long_description": "Dubai Falcons is an immersive VR flying game inspired by the spirit of falconry and the Dubai skyline. Players take control of a falcon using either VR controllers or hand-tracking, moving both arms together to simulate the motion of flight.\n\nThe gameplay is simple, active, and intuitive: raise and lower your arms to guide the falcon through the sky, dodge incoming obstacles, and keep flying as long as possible. The experience is designed around natural body movement, making players feel like they are controlling the falcon\u2019s flight directly through their own arm motion.\n\nSet in a vibrant Dubai-themed environment with bold UAE-inspired colors, dynamic skies, flying objects, and city silhouettes, Dubai Falcons delivers a fun and accessible VR challenge focused on timing, coordination, reflexes, and movement. Whether using controllers or hands, players can enjoy a fast, energetic flying experience that is easy to understand and exciting to replay.", "short_description": "Dubai Falcons is a VR flying experience where players control a falcon using their hands or controllers, moving their arms together to fly up and down while dodging obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven Reality", "support_website_url": null, "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SC
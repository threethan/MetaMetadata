wRjyQctsBeMnmDAfknnXlbItd_5vP4g&oe=6A242589"}, {"file_name": "01_2560x1440.png", "id": "1978216036136078", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491829165_1978216042802744_5345050193838169484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzPA9Uqeew8Q7kNvwHAnLuw&_nc_oc=AdpKTy2hDXCb2pGqyePrUn5NFWf6Li0JFyG49DYT2djP-XqgLEjaU8Jt7hKXXDmkheY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wB09vFXpzf8bL51HBRIelRH2Qg6HjJivpksgIO_E2YQ&oe=6A242EBE"}, {"file_name": "03_2560x1440.png", "id": "2168884880525280", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819822_2168884887191946_7983662642647708411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KXYVk-oRvMQ7kNvwF2ndzq&_nc_oc=AdrzPxK3npvXU6rShmdF_MtTovcNvJyibA9P3AI3lQ8QTYB3dAjz_xqBhazFnJJAVW4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HI-gBXBY3PbjMBs8DONPlRyhXelcZc3wi1Hh9-MnQDQ&oe=6A24426C"}, {"file_name": "02_2560x1440.png", "id": "1680377173413976", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823783_1680377176747309_8433825510553152867_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDcjtqtu8DMQ7kNvwFNpRqt&_nc_oc=Adq23eu5hfWJlLKAH12KkiRxEINYjzBgRbZ-wLDcSFPdqPgAtkmnYUTyWQMF2D1wuu0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mzutRABTBdrETS5Yj5_wXpj9-cSewjsQx3c9fWV8LyA&oe=6A24202A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "2058918255002298", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823949_2058918258335631_8589063721509731024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVyCr9nhHHAQ7kNvwFvm04h&_nc_oc=AdpVfmd4REQHjVqQ1Ssfv4kTTnjxXNtWSyfGLG6dPvWWuOxL5_UEvWV9_7e9ueLfbVA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TVvn3ZeCg7IuVwRSuRnovNiH_nzL9hU1wF1XzMvO77w&oe=6A243207"}, "display_name": "VR Dubai Falcons", "keywords": [], "long_description": "Dubai Falcons is an immersive VR flying game inspired by the spirit of falconry and the Dubai skyline. Players take control of a falcon using either VR controllers or hand-tracking, moving both arms together to simulate the motion of flight.\n\nThe gameplay is simple, active, and intuitive: raise and lower your arms to guide the falcon through the sky, dodge incoming obstacles, and keep flying as long as possible. The experience is designed around natural body movement, making players feel like they are controlling the falcon\u2019s flight directly through their own arm motion.\n\nSet in a vibrant Dubai-themed environment with bold UAE-inspired colors, dynamic skies, flying objects, and city silhouettes, Dubai Falcons delivers a fun and accessible VR challenge focused on timing, coordination, reflexes, and movement. Whether using controllers or hands, players can enjoy a fast, energetic flying experience that is easy to understand and exciting to replay.", "short_description": "Dubai Falcons is a VR flying experience where players control a falcon using their hands or controllers, moving their arms together to fly up and down while dodging obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven Reality", "support_website_url": null, "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SC
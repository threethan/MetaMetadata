"02_2560x1440.png", "id": "1680377173413976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1680377176747309_8433825510553152867_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIhlvIIMiVwQ7kNvwHfhBHb&_nc_oc=Adr8trnqAqnZ6CPy-AlPFp71U1uABAkTZn3lup5f4SmTS88QP0eEGZXQkwuGMJHiTCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0orc3_GuP2FNKCVo5hw2oIGteJ2RvCI1k_rhwa8JZnw&oe=6B1054EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "2058918255002298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_2058918258335631_8589063721509731024_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU-WEmohqD8Q7kNvwEdzrNV&_nc_oc=AdqFyTj4sLlDQT2s02Qpj-krtHM-wMEGm6gHAnCLpvye0ihKKAqRe0qauyyqqGqUK0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxsA21EXLsVecZ2gf1r7Gk8WAiJAZuQfEHcO_71CUqFw&oe=6B1066C7"}, "display_name": "VR Dubai Falcons", "keywords": [], "long_description": "Dubai Falcons is an immersive VR flying game inspired by the spirit of falconry and the Dubai skyline. Players take control of a falcon using either VR controllers or hand-tracking, moving both arms together to simulate the motion of flight.\n\nThe gameplay is simple, active, and intuitive: raise and lower your arms to guide the falcon through the sky, dodge incoming obstacles, and keep flying as long as possible. The experience is designed around natural body movement, making players feel like they are controlling the falcon\u2019s flight directly through their own arm motion.\n\nSet in a vibrant Dubai-themed environment with bold UAE-inspired colors, dynamic skies, flying objects, and city silhouettes, Dubai Falcons delivers a fun and accessible VR challenge focused on timing, coordination, reflexes, and movement. Whether using controllers or hands, players can enjoy a fast, energetic flying experience that is easy to understand and exciting to replay.", "short_description": "Dubai Falcons is a VR flying experience where players control a falcon using their hands or controllers, moving their arms together to fly up and down while dodging obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven Reality", "support_website_url": null, "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35180831998170495"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_2027705404830632_727433114353627744_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgVL74IpO-AQ7kNvwFXotDP&_nc_oc=AdpTI-9cvLucVjjMIZvkVYGohkbKxx8lSgvJTfZLSJqJ4vK4vkJipR1RvjPT6ymoYVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfRGd7r6lT8HgzQJQRg2DEkOnm_q9T3xgqAxyiHBCN8A&oe=6B104D9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Dubai Falcons", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", 
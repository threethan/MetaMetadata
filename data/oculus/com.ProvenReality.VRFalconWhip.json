_9ndM_EEfx9r3nQDcvF0CZcSIysifBg&oe=6A427809"}, {"file_name": "01_2560x1440.png", "id": "1978216036136078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829165_1978216042802744_5345050193838169484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKrtQujNcDgQ7kNvwHZB5Ds&_nc_oc=AdoTjexUk700uNXVqgtiums20dWs8izk4-tNavLbEQP-ksIzd1VrCnR5asNXN13RCoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rT4eCRLzniY1Q5MPac1HqvYHOcgfryry2N_iHTIA9ZQ&oe=6A42813E"}, {"file_name": "03_2560x1440.png", "id": "2168884880525280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819822_2168884887191946_7983662642647708411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1MTuDYhk2gQ7kNvwGXV9nu&_nc_oc=AdoG7uyDXcpiPzA6fK-YNRp7X6pxniQn5x4sZSJNswnpudFsvlymvYOf5kD8v5qH7YE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SWK4B8auzvILI7qz2mSfz1a6-NBsX2Ug2j4HjVzE7mQ&oe=6A4294EC"}, {"file_name": "02_2560x1440.png", "id": "1680377173413976", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823783_1680377176747309_8433825510553152867_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK1jHvP4k88Q7kNvwEOoyyC&_nc_oc=AdpcVOtz6C9YhCTIs-BYTR53ld3T2uYkGUiB_H-zU02WK4unwyMpKecfvfGBQIyFcNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oUYBp6O-wFk6KNvYUDlj_M2U9G99JlAuyiZeLaAg-0Q&oe=6A4272AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "2058918255002298", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_2058918258335631_8589063721509731024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pmAdsOknb0Q7kNvwHelq9h&_nc_oc=Ado0rSqXFtXtYUGHV2hfF3NJyRaxKhqnp7cDpEOUwyRJaYBZb2RQHiVdhsYMXVvix8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PbcxOYkuZhhTHkOeyOquyMfH-RKsvEDOyolRxEY3JcA&oe=6A428487"}, "display_name": "VR Dubai Falcons", "keywords": [], "long_description": "Dubai Falcons is an immersive VR flying game inspired by the spirit of falconry and the Dubai skyline. Players take control of a falcon using either VR controllers or hand-tracking, moving both arms together to simulate the motion of flight.\n\nThe gameplay is simple, active, and intuitive: raise and lower your arms to guide the falcon through the sky, dodge incoming obstacles, and keep flying as long as possible. The experience is designed around natural body movement, making players feel like they are controlling the falcon\u2019s flight directly through their own arm motion.\n\nSet in a vibrant Dubai-themed environment with bold UAE-inspired colors, dynamic skies, flying objects, and city silhouettes, Dubai Falcons delivers a fun and accessible VR challenge focused on timing, coordination, reflexes, and movement. Whether using controllers or hands, players can enjoy a fast, energetic flying experience that is easy to understand and exciting to replay.", "short_description": "Dubai Falcons is a VR flying experience where players control a falcon using their hands or controllers, moving their arms together to fly up and down while dodging obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven Reality", "support_website_url": null, "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SC
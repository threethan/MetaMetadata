f20f&oh=00_AQH_QPh_UsnYEkUHge0V7_xwVZT9ukaEEIpIq8krtezxLw&oe=6A857C49"}, {"file_name": "01_2560x1440.png", "id": "1978216036136078", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491829165_1978216042802744_5345050193838169484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-CD452NREEQ7kNvwFHAJU3&_nc_oc=AdohICJabjihoGviL4SOitAjTRaBIMP4sK1dHBfANeaQxKmmWaSh5xA0PNy0XdBxqyE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgQx_1YatDfy9XkzYD6DpZ_IxhzEO5Y_V3cqCgW6oUkQ&oe=6A85857E"}, {"file_name": "03_2560x1440.png", "id": "2168884880525280", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819822_2168884887191946_7983662642647708411_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERxUzsDGa2kQ7kNvwEMNRpS&_nc_oc=AdoBQNKn5LLm-UZJSvpM3DyO6naoOG1btm8nnPOrD1gUeNcJSDqA8rWUie7SXGhl7sw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGTxp_7hb2KjSmU1XWUTQd0LvKORJpwaBeO3K-yjJjHQ&oe=6A85992C"}, {"file_name": "02_2560x1440.png", "id": "1680377173413976", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_1680377176747309_8433825510553152867_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ikqapS7yF8Q7kNvwHVED2d&_nc_oc=Adq9gaTXsXYrKI02JqjvYRvYADvDmp6aoYe5B5yaQ0BXX3VUuGh-OiD5FZ50eA8JnFA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJEmyjJPKYYZE4-dfD8upUieXMkFODVJ-osgemM_Bx3A&oe=6A85AF2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "2058918255002298", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823949_2058918258335631_8589063721509731024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEcMXLTpGWwQ7kNvwEUj3Ye&_nc_oc=AdpkE6YYh9jmc9sVF-BXd207jBooBX4MgJaK7sTuE3PsKnjSvDRy4OsElrMsACW91Js&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-ck2I2W59C_pElKklalYZL7b_QnH5Xqrc9fPMCrfQOQ&oe=6A8588C7"}, "display_name": "VR Dubai Falcons", "keywords": [], "long_description": "Dubai Falcons is an immersive VR flying game inspired by the spirit of falconry and the Dubai skyline. Players take control of a falcon using either VR controllers or hand-tracking, moving both arms together to simulate the motion of flight.\n\nThe gameplay is simple, active, and intuitive: raise and lower your arms to guide the falcon through the sky, dodge incoming obstacles, and keep flying as long as possible. The experience is designed around natural body movement, making players feel like they are controlling the falcon\u2019s flight directly through their own arm motion.\n\nSet in a vibrant Dubai-themed environment with bold UAE-inspired colors, dynamic skies, flying objects, and city silhouettes, Dubai Falcons delivers a fun and accessible VR challenge focused on timing, coordination, reflexes, and movement. Whether using controllers or hands, players can enjoy a fast, energetic flying experience that is easy to understand and exciting to replay.", "short_description": "Dubai Falcons is a VR flying experience where players control a falcon using their hands or controllers, moving their arms together to fly up and down while dodging obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven Reality", "support_website_url": null, "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes"
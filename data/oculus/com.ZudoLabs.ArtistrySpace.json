=6e7a0a&_nc_ohc=gEo3b8pnWOsQ7kNvwHsouqU&_nc_oc=AdkB0sg0FEBIwuQCKWmwyrsyL5KeQV1qvuyK6upvLj_SdF2IwgY1OZKDwX_UWYKxNiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_kPdhvGiW0Rb4tJ52RQyxTnSRtN0JoEOCFRYVRbLLcw&oe=69A037A2"}, "display_name": "Artistry Space", "keywords": ["painting", "art", "sketching", "vrdrawing", "artist"], "long_description": "Artistry Space is a VR-powered drawing experience designed for artists and enthusiasts alike. Switch between 2D canvas painting and 3D freehand drawing, allowing your creativity to flow in any dimension. With an array of brushes, tools, and vibrant effects, you can craft stunning artwork while immersing yourself in a dynamic and interactive environment. Whether you're a beginner experimenting with strokes or a seasoned artist creating masterpieces, Artistry Space provides an intuitive and engaging way to express yourself in virtual reality. Dive into a limitless creative playground and turn imagination into reality!", "short_description": "Unleash your creativity in Artistry Space, a virtual reality drawing app that lets you paint in both 2D and 3D environments. Use a variety of brushes to craft stunning artwork on a virtual canvas or bring your imagination to life in a dynamic 3D space. Whether you're sketching intricate designs or painting immersive landscapes, Artistry Space offers an unparalleled VR art experience. Step into a world where your creativity knows no bounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "g
scdn.com&_nc_ss=8&oh=00_AfxFn0lQyi3OPOiV4ThvLYcgF-xHQr55FMNHJAmBbeKZDA&oe=69B7E03C"}, {"file_name": "Screen-shot-3.png", "id": "9090833461002794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393738_9090833467669460_4438718988404661975_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIdacsPHPtEQ7kNvwF53WIz&_nc_oc=Adl6wrjyQRrJYPzf6PL7_JzCjAMYWcVBfiyip6_XmULQREesAAHVf07Y1tVRH_noiXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvzTHJaMJmpJhESN8eKiqy6uubjm9VXp-1RqYkUZC5uw&oe=69B7E83E"}, {"file_name": "Screen-shot-4.png", "id": "2425235351162075", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391816_2425235354495408_7812762797549416843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDMTZIZHWOIQ7kNvwGAjVrE&_nc_oc=AdnLN75nTyq-vdkbzR0G5pxU2LWsRNF7Oufcj2MeTbjgcrfuj88H-zoTclsufUQM9uU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxc-K6LA78AZZvEoOfdngSdo5459nxBIKSih0ZCZtcWtw&oe=69B80E83"}, {"file_name": "Screen-shot-5.png", "id": "641308828427880", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391780_641308831761213_3306778632859821046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds4UJQ59-OQQ7kNvwEODAYb&_nc_oc=AdmPKSOYr8GJcFjrEr_JUvxMAGtUENir2oeCLiDo26MO8axP5NqVJzfCIjaa-HuJE-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxgfawE1g6L8QiXM_NVN8dQJurHiBu2_s8IZMSNVdZzuQ&oe=69B7E764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-.png", "id": "1292036278732034", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_1292036282065367_2999551275727789180_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boCzBqQSAYAQ7kNvwHojklK&_nc_oc=Adkb8q9giwMoyJsqk0hMUbPoGTltsaNZLeM7tKlUl6mY6e9lVg0BlMhTG45rqe58Ts0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx81CkBWB1Uw7vOdfoxuy7o4ZV9Ft_i5axmj9BstixotQ&oe=69B7F2A2"}, "display_name": "Artistry Space", "keywords": ["painting", "art", "sketching", "vrdrawing", "artist"], "long_description": "Artistry Space is a VR-powered drawing experience designed for artists and enthusiasts alike. Switch between 2D canvas painting and 3D freehand drawing, allowing your creativity to flow in any dimension. With an array of brushes, tools, and vibrant effects, you can craft stunning artwork while immersing yourself in a dynamic and interactive environment. Whether you're a beginner experimenting with strokes or a seasoned artist creating masterpieces, Artistry Space provides an intuitive and engaging way to express yourself in virtual reality. Dive into a limitless creative playground and turn imagination into reality!", "short_description": "Unleash your creativity in Artistry Space, a virtual reality drawing app that lets you paint in both 2D and 3D environments. Use a variety of brushes to craft stunning artwork on a virtual canvas or bring your imagination to life in a dynamic 3D space. Whether you're sketching intricate designs or painting immersive landscapes, Artistry Space offers an unparalleled VR art experience. Step into a world where your creativity knows no bounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
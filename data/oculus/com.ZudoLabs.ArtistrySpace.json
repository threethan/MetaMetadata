scdn.com&_nc_ss=8&oh=00_AfwL9tIh-CAuWNHHhCuiQ7-AWb0GKXx2laQmUDoU4P0aUw&oe=69AFF73C"}, {"file_name": "Screen-shot-3.png", "id": "9090833461002794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393738_9090833467669460_4438718988404661975_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-2tUd64VuUQ7kNvwEgDToY&_nc_oc=AdkYDsshzuot2H5EA_XrOOa-_qlUgJ7LXJHtHpwlmzqHTvLLTWw06EL1enM27W6Ab1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk8hwCTwVKh3-mn4sQeUEfJ264PQm9MBPXasFsC6IO4Q&oe=69AFFF3E"}, {"file_name": "Screen-shot-4.png", "id": "2425235351162075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391816_2425235354495408_7812762797549416843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygMEfgSYQc8Q7kNvwGBDpUr&_nc_oc=Adn2p9Xj4bPlDFkrzQgPJj5ivNEwf7hi_fXicdN6e8GotS8kPTcvU-zWbCk6eZTjCZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDHeTGqC3nImAJF1-yyvP0JWjaLVobX4jm1aZYY-_0dA&oe=69B02583"}, {"file_name": "Screen-shot-5.png", "id": "641308828427880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391780_641308831761213_3306778632859821046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYb5PWSYCpgQ7kNvwHUB3eq&_nc_oc=Adku4b49ziHASmmUtVCIuG9dh88V01CGbXPhAp7ENFiwkgWlikeuFGfK-KN3HcNhkmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXgpyUnokElD3hXMry4f8Z_QSjfJoDi0urV9BfLi1Edg&oe=69AFFE64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-.png", "id": "1292036278732034", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391934_1292036282065367_2999551275727789180_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcXPlk7j8fMQ7kNvwHbS8qK&_nc_oc=Adl08FFyxlbE7_qPTT5YdvMS1zUxk1P4mL63_tl_QG0VmbQPILt0ngph7HBa630i2iU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxrnqf0RbB8x7nCXnitlgJ6cv92_RhLAILOrfS2Xo8xvQ&oe=69B009A2"}, "display_name": "Artistry Space", "keywords": ["painting", "art", "sketching", "vrdrawing", "artist"], "long_description": "Artistry Space is a VR-powered drawing experience designed for artists and enthusiasts alike. Switch between 2D canvas painting and 3D freehand drawing, allowing your creativity to flow in any dimension. With an array of brushes, tools, and vibrant effects, you can craft stunning artwork while immersing yourself in a dynamic and interactive environment. Whether you're a beginner experimenting with strokes or a seasoned artist creating masterpieces, Artistry Space provides an intuitive and engaging way to express yourself in virtual reality. Dive into a limitless creative playground and turn imagination into reality!", "short_description": "Unleash your creativity in Artistry Space, a virtual reality drawing app that lets you paint in both 2D and 3D environments. Use a variety of brushes to craft stunning artwork on a virtual canvas or bring your imagination to life in a dynamic 3D space. Whether you're sketching intricate designs or painting immersive landscapes, Artistry Space offers an unparalleled VR art experience. Step into a world where your creativity knows no bounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
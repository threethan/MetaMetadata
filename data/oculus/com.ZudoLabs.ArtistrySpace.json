scdn.com&_nc_ss=8&oh=00_Afy-hSHiYO02hUgCq3H2M00pGSY1di9xvxNKd_CxmF4AKA&oe=69BD5E7C"}, {"file_name": "Screen-shot-3.png", "id": "9090833461002794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393738_9090833467669460_4438718988404661975_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BTD9zqpeBAQ7kNvwEEC0XJ&_nc_oc=Adl1TGUVLuGjyn0opKtUCRQZyEPQaYnNFkk7uQfaXuB1HLu5TYbrsT7NBPTG7sV0_68&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxreMXE3Xizx1mJFuCsm3nBHbIUp1vxFx0U1z78m4bfjA&oe=69BD2E3E"}, {"file_name": "Screen-shot-4.png", "id": "2425235351162075", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391816_2425235354495408_7812762797549416843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tIShdOafBUQ7kNvwEN3-ec&_nc_oc=Adk2b7usfPRIlBNtTc05BcnGGqVG3Cr2tin_kx-v0OO-RyKxjqVFeuNs2q3oKOlMDjU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxpc4r1ZUvQ_gIA6SimbjvhMbUeIrV9S4_cO9qKPboqJQ&oe=69BD5483"}, {"file_name": "Screen-shot-5.png", "id": "641308828427880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391780_641308831761213_3306778632859821046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqIZBEYpZrYQ7kNvwEwf43D&_nc_oc=AdkHuh27Brt24ppd4p-wY9lteMQye1ytD0-rmyKdbt3jHewSyfIxL5L87JrPBCAi3KE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlXEx9dgaTvRAOVJCIQL6LL9OMg91ctjbeqfBExmsekA&oe=69BD2D64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-.png", "id": "1292036278732034", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391934_1292036282065367_2999551275727789180_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3wtBzSMOuMQ7kNvwHII0XC&_nc_oc=AdngCFOmo9SGMbPbWRSXkcgAhvG-GIffrOqE1g4CMA0705edJ762LwbY4o4RzdgCFsM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIQGlg4EAn-FeU6IKUAX0w2YisL3I3xwjarCfunUBjUw&oe=69BD38A2"}, "display_name": "Artistry Space", "keywords": ["painting", "art", "sketching", "vrdrawing", "artist"], "long_description": "Artistry Space is a VR-powered drawing experience designed for artists and enthusiasts alike. Switch between 2D canvas painting and 3D freehand drawing, allowing your creativity to flow in any dimension. With an array of brushes, tools, and vibrant effects, you can craft stunning artwork while immersing yourself in a dynamic and interactive environment. Whether you're a beginner experimenting with strokes or a seasoned artist creating masterpieces, Artistry Space provides an intuitive and engaging way to express yourself in virtual reality. Dive into a limitless creative playground and turn imagination into reality!", "short_description": "Unleash your creativity in Artistry Space, a virtual reality drawing app that lets you paint in both 2D and 3D environments. Use a variety of brushes to craft stunning artwork on a virtual canvas or bring your imagination to life in a dynamic 3D space. Whether you're sketching intricate designs or painting immersive landscapes, Artistry Space offers an unparalleled VR art experience. Step into a world where your creativity knows no bounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
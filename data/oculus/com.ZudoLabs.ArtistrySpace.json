scdn.com&_nc_ss=8&oh=00_Afx6u0SHtvWTKBbMNCjsQtbowOBGGRiUSOHXhztpOaiZcQ&oe=69B29A3C"}, {"file_name": "Screen-shot-3.png", "id": "9090833461002794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393738_9090833467669460_4438718988404661975_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-2tUd64VuUQ7kNvwHcXKBT&_nc_oc=AdkoK7HFCO91JaqV-Xqv8XpBghUWu_Us8XMFddNSrIIDTTPq4oTvqjca72mjZZX0z_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmXjZ_nDxuUzN6Gk-KvescMS_caVvvAsfHgVfwtIx8ow&oe=69B2A23E"}, {"file_name": "Screen-shot-4.png", "id": "2425235351162075", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391816_2425235354495408_7812762797549416843_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzlWx2CnJLAQ7kNvwHja992&_nc_oc=Admz6H5xR-nCS38FlujF7TY-Ype3UBCrYLs_0th0jxeL0y4NkawlUmdOtzUMgdwiNy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxon3mLiy5gbw7ktaECG7JjwuNgbs3f-u20fBAXzUn9-g&oe=69B2C883"}, {"file_name": "Screen-shot-5.png", "id": "641308828427880", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391780_641308831761213_3306778632859821046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVSZIhqEslAQ7kNvwG_nK7-&_nc_oc=AdkWiScRfTBvjGHumurl5M_vTR9iWW8z9XA72_SVsh2ZL3TT1YhqvjE5o45FXxW20tU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyaj4QC57JbgARzUR2A57efLv_E0Vu805WWsMzkq7SaQg&oe=69B2A164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-.png", "id": "1292036278732034", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391934_1292036282065367_2999551275727789180_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcXPlk7j8fMQ7kNvwF6J3N6&_nc_oc=AdkXdc5Lr1mf4tkC7RHTAM_r_lLYA4yulLm3wVnf2XsBh0SNKTr79Wz3jz8eeBGbu2o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9NTGkRRCIEaCgqcK-Tu-ZzfsBvaNldtps5nKH7lz1Xw&oe=69B2ACA2"}, "display_name": "Artistry Space", "keywords": ["painting", "art", "sketching", "vrdrawing", "artist"], "long_description": "Artistry Space is a VR-powered drawing experience designed for artists and enthusiasts alike. Switch between 2D canvas painting and 3D freehand drawing, allowing your creativity to flow in any dimension. With an array of brushes, tools, and vibrant effects, you can craft stunning artwork while immersing yourself in a dynamic and interactive environment. Whether you're a beginner experimenting with strokes or a seasoned artist creating masterpieces, Artistry Space provides an intuitive and engaging way to express yourself in virtual reality. Dive into a limitless creative playground and turn imagination into reality!", "short_description": "Unleash your creativity in Artistry Space, a virtual reality drawing app that lets you paint in both 2D and 3D environments. Use a variety of brushes to craft stunning artwork on a virtual canvas or bring your imagination to life in a dynamic 3D space. Whether you're sketching intricate designs or painting immersive landscapes, Artistry Space offers an unparalleled VR art experience. Step into a world where your creativity knows no bounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zudolabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zudo Labs", "support_website_url": null, "website_url": "https://www.zudolabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_t
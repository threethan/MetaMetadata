.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn62f_7--D8Q7kNvwFhVZUH&_nc_oc=Adm5qGWWX5v2_DHEmW1vKeo9wfVx_wLgjZ9gk1TVC9s-lGpCDyhRhTKB9LeTb3p1UgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeX5DT_oKaScYpe17sDs1rIpuAJ1YZYOCOSb7cmuuL0A&oe=69B54EA6"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ypK8R8sj_sQ7kNvwE77YKr&_nc_oc=Adllv9qkNZkLBGgeY5VbCGag6xP-ZJk3aCF7p5_jr2Onur76w16F_Vvs2HKgWLqytKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afytk4ZjK12HgooqjUXgbE1X1SDlkr20P5ZHo3ZGHrHOgA&oe=69B55EED"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oPbgy6ocnEQ7kNvwEaHrzD&_nc_oc=AdlbXtpIswFpKUra-Vr31lalkBAH3rj-ba31-sNI_Yjh6G28HHmcquMem8TyKp9Pqtw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5jb4sp-rhJAvMJZbROaEuoCYdcIFB-Qg6WiSsM5ajrA&oe=69B53B58"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ECE9Hzs1hcQ7kNvwGJKnfM&_nc_oc=Adkwo7k_8qXpUOFYZSaODZs4-7aiYcbTUAIZFyG5wYB4q3Diw6opuk0-Jitoi5mDBiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfykJvBYG43jyvvZmsh9M18JM9Vyfyn5FqJ03YQECuitkg&oe=69B54C0C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKdHAuMtjm4Q7kNvwGO7C1b&_nc_oc=AdmNcofwNiUNYXufSpZmtte3QnDemC9MRClj3q9gCimvjH-VKbeI0QESuBnk8Fp81JI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwo21rZ9QAkAJ38St74RWvtja_X_v7OkYw3BulLVEqwdQ&oe=69B54600"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFpl3KylLpcQ7kNvwF5W5xP&_nc_oc=AdntenvCtGj7Ed-RgBFILmZsFc2Abx30AfR1yRrYT5t3EiDETO7PdbRyo68pBkmds2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSj5RKUHTU0ImrQMc5Wtd4Orr-gVHTzeWZiFAE5bwOQA&oe=69B56589"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQqX3RJ85wkQ7kNvwGFAK8v&_nc_oc=AdkyxxV69hA26HLpvnUMlqwkmwz-gb14EHWjR6mooDQSHE-9_vng5rhQ0pKQ1_QdnE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjJOXkwMeXfd71wVu0xH40_hcvw7WxAdiDHols9NxEow&oe=69B55AEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUyOo1jlI2oQ7kNvwHCDmmc&_nc_oc=Adm3nqMKdNgI6aaEM3VJDvbeoRBkiF-4vloESZgfLNhw14VB6-uNq1xD_DEfiefCvjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8DcOoYYFrKGgEAh4DcQkfy5kULAcKSYvkRX3tEnVavA&oe=69B54B39"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
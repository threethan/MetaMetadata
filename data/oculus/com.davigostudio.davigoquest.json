8501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcew3JtZbD8Q7kNvwGY3hEc&_nc_oc=AdkeiYei_zXFSDJ8h_JOlOHYg2e3-ECgfDphmXJf6GSq1ASggmmKeBROeau8VyKmwDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNwHQXXQcj8RUzMHrgHBcUJ-OUmZ3NTwCH4w-NXPeNBA&oe=69999680"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=actZ0l4XdzMQ7kNvwHutUZg&_nc_oc=Adk-xzH2Bl886gCHZ7wP1sX-e1WxwNlYZoq1FXFWNeWQ3cTAQi1mJ3lVRDZnzVzQOo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuR1h8w5c0sVrU07R-B2RVXto21wDMa8RvE1PGepDnTIg&oe=6999B609"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYhjELnZlWsQ7kNvwFjFF5T&_nc_oc=AdkqVc8h0VR09nMGyXGpmrD7gg1DuG00XYgGrS22HXKbtedaThJZQ0OX-yQTw1xL1V8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDGd8Gs1Q915NQtRdXnJNfnZwis7F59mgNlImMY0J4Ow&oe=6999AB6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUDTDjywPxYQ7kNvwE7RPy4&_nc_oc=Adluiw3OkcGWq43mlpF02lo0KH2v-OVhgiIqLwL63w0MqRmkuxXbvh2L3moMX3yCNZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afso9I65s7rwYpBsE2PTM2LxBkX8sLbjgClUd3_vWm_6sw&oe=69999BB9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
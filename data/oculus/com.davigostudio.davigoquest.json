.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osHrg22apsQQ7kNvwHDAxoR&_nc_oc=Adl4n4U5aJdnY5OMsR8zOk6qpqtZ9dUA7KKT3V1-rfq2qFpIqUnoiB7xSJ8HriNfkQ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOIl7hEbpe8utiyPfaQKdvIM7ti69jP2t1iH04z8vH-w&oe=69B7F1A6"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM6KoXMU6y8Q7kNvwF7jHJb&_nc_oc=Adk_fw-v0VgTOFHzp01GnOf9SRSQlKZUJbW_EnP_UmmXtRYBfFAz5rFUCxTo9qA4eys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyn0V5RwQxfVd8wf-Uug6tKc33kVExo-vvY43jER90kBw&oe=69B801ED"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kLGqUVBI24Q7kNvwHuE3L3&_nc_oc=Adljno9e_UeHSUSQetsjWyKqOGz76YC2-CCXBjjim91R7HNyXesyJkIRLVIUjoDDyQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxcCEh0DW6kHiBWPXjoOjBrmrR7TOIVhDyO7NJWv9IQGQ&oe=69B81698"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foyWy-T5MfUQ7kNvwG04Mee&_nc_oc=AdnvQOCS5AGGCUw-LZ-RosxWCTPjH08AQtC6YV9nOaHn7R3onWzc7F-x18V7TOhWfB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1nm5GDwn8bUzXtBHwTdoHt6-aT2wVl44n0Zow1hyzVg&oe=69B7EF0C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKdHAuMtjm4Q7kNvwGfL7L6&_nc_oc=Adki3HXs_u4jFqkHm0RZUcEj_T5i2f9hLg2vLgBo7uQpcNtWoNFu2M9_TEDY2HKwjjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwaWepuwtJSaeyGkzaZhwVsOoZxeOXWBt_rVG4Fbvutw&oe=69B7E900"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ6LhdSXvvEQ7kNvwH__mM0&_nc_oc=Adm5E1J-G4ZFzJy7NUAoiIa_yZQoI2xSKY6E2onaQTO5uygX79MUIaab6SXwNMi8dTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqQYiEngg_htUgHjs4ykUlmPH4-63lbczEkalUKJ7O6g&oe=69B80889"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQqX3RJ85wkQ7kNvwHfbelC&_nc_oc=Adneh323clWlYjhMRce5oPmTm6py2dnWzToSMxgQFCwv8KlflkviBLgZwWI6huQeegM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwE3yfiRQR6NGrLbWu67Uic32VVU-rDadlRq9HstGyKiQ&oe=69B7FDEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01PbBZ98HGsQ7kNvwFnPeQt&_nc_oc=Adkq8EHoK9vYX-6nnVksMJOlaoqI8ecF8t9suRMtxMmPqDQjWETNPGpfemcrljXEfo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFCEfTCZMQyXqNvttktYVCPrAg2lKd-hU1eWGsvdA78A&oe=69B7EE39"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KBR90ns9wsQ7kNvwHTDA0L&_nc_oc=AdkaQgPiDtx5_XJnKZA8Ct5pgB_plaOs6Ve3bHUEv79u-xmGFE4B3240BXgGXOudBdQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjOoraJmyXjn19R8bhW2Uyj0X2Qyo3QAafUPfcdIzC_A&oe=69BE8926"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBuU7yd68PwQ7kNvwF02e-V&_nc_oc=Adkj4hND0DG68VfuJS6xQm3nOiTv9YD3fqI3us_WHxw-xdKEYqQafHn6d4njA5P7k04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZMeCzKn5b3w64tzx8i52l0yO60CyvXzpZGdOBIB4smg&oe=69BE996D"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5GgRY7kX1YQ7kNvwErZXMf&_nc_oc=Adl6jY_9MTsftGqhZVIAuWlEEJQqqDTyWqoJobYYbB4UOBoDOjQdCPETlbzYx8VU_VU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDkao8Exy1Wu3FdlQj5GzgK7ssYdRBzFDj53mX7POpag&oe=69BE75D8"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNvLwCZvs9sQ7kNvwHxWC28&_nc_oc=AdnUETxpDwT3GTi3GvYW_0RMuHiIa8Mz4kIeKKgcj0wnQ923t8O36mZDK1MdFcGgUwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoG6X36_7kOVbfjod4KVx8Tkzm3PHYgmoVGgMzZBQhkA&oe=69BE868C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiT0R8257dQQ7kNvwGon1BY&_nc_oc=AdmWbHu_jrzQlFGcg1CwT7nrM5h8XkoKmPio7Hh5jACDUfxX5YNPVgohyzC__gdeeac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjFGvfqhFUIM7XHH-MxpNfRXjQjA1F-e_A881-oP-vBw&oe=69BE8080"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y3R97mjVdIQ7kNvwFWn_d-&_nc_oc=Adko_HGlly4fwSg4rGMNM4wqEoGhcaYSC_kYpl84P3iCaJqOgIt8qDyiR1M_nrqB7aQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWNQxd-CCU_8jRfKX4mjuK_oToiEikORfXjBFRCqNC-w&oe=69BEA009"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EYPDnJyV2QQ7kNvwEOQ_bd&_nc_oc=Adn7S9izKhh-r0pH_rTr1AwboG2Syu8okG6aMEGF222wVnJ2giCyK5NgeEN7Y_VB_BM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU8L4PxvTkGmqHVqTXUH7DW1kYeACeIxAiCFKKmsRBjA&oe=69BE956C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i19Zd0wmSsQ7kNvwG6dhpQ&_nc_oc=AdmrsSeanJIFIayIysZJujYc1G90iAuUrWHw6503GLaxYAAeNqRTZKqs-QcYANOkHtw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRgEE9kRf1m5ku3YoaI-kMvqyk_ly7_vL4Ym3NqaQUyw&oe=69BE85B9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
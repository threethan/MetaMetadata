.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn62f_7--D8Q7kNvwHIhs5i&_nc_oc=AdnT452IKWVPjL0MGP-vMnBokWzPx1xl0-UExVuvMZZuuZugHmco7jQh9wlFEkcSVNY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzASlRx2h63ZG4KrNDTlsU1O_WIrO6Y1y8jVZFbP4AnaQ&oe=69B2ABA6"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm--cQRvkCAQ7kNvwFR9I-m&_nc_oc=AdnC4GoA9t1UHKGvPOv7iLbGaBEGScc2T-pQKjWgdQddAA06OxetjGGTOglrQtqK89c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBcLB1bRvRTyESWCG2BqF3Zfxy1X7cnbFuv7AoFcd6Mg&oe=69B2BBED"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oPbgy6ocnEQ7kNvwHw2LLn&_nc_oc=AdlsS97h6KI7OMANkJ9OiJi-fSdrzPKGSfh1znmVVIlTR5Fwlpdp4soV8m4dCaE8iBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJftvETJrMVZRdTd01VSEx_ndsBsDnttrZI-qvqungWw&oe=69B2D098"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ECE9Hzs1hcQ7kNvwGBORPd&_nc_oc=Adn2vPf44zdedgMB54v-fYVnztBXLQireRBiNBCpe2XqJjS5DF5c7mFN1ajjindhtXg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOdvxclona5mBWO9bf2Abe9zAg3wWKg2mDtj1sHnWLMQ&oe=69B2A90C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXguQ6FZBN0Q7kNvwFcEyJx&_nc_oc=AdkwXmfESdp4xR9Y6rodINidL59kZT-k_c8PO4N9LinAio5aoB10_NUvxvm02jCPS3U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJXa1Dirts1KV4ZoaIgW-tWGxojC-qZQcZu8lDwTxU3w&oe=69B2A300"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnSiWukry3IQ7kNvwHx8ngn&_nc_oc=Adk13y32Nz9YxZpNJ193yIjixrV2omiO2wqGff9ltb9znKw58ZrPf0f1n5n98uYF0W4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpcclN-NlJQG89fKKnJGTsYSAKAptrJ2b56ozTuGpXzg&oe=69B2C289"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdsbjWUFP5sQ7kNvwEoDpq6&_nc_oc=AdkleiCAmFNSs5YWNZobgHoZwG9CEAhS9YJVjvULjCGC08rfS8rVLX6K8R5RZxv1Sfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7A3mSuPkQRXt1Jy6VUUgIH1Fh-YFczjfG1V49MpunPQ&oe=69B2B7EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUyOo1jlI2oQ7kNvwHDmp5F&_nc_oc=AdkRrHXbahYAJuuxSeL_pjPYLQM00dk8skBPGWB1mhdHPnJhljBsu598rz82yyUZEvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeCR0czquEJKSgX1gSKj0ThJohkMJc8_8F8lab98ydyw&oe=69B2A839"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
sBMJ5hCpcIDoEtKundMbXL0aoDwNXhqCdJuWGbJjQFa8Ws8wc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_j7_J3aAZCKLMVJFzV9etXnMnbvu1OtecJgT-zS8ZPw&oe=6B0B310C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZufsix8uLcQ7kNvwGeThuG&_nc_oc=AdqF4WoNhwlP_85ZPGMvY4qS2SSQSAGGMYlUR1cTdHJKjQ8VR7ZqGyS0auHUPqiSIcM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFzovYl1zayREJfN2UYQllVdli_tBC1iCK3tVXECUC3w&oe=6B0B2B00"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6WWLrf7H7oQ7kNvwFBEeE4&_nc_oc=Adq3WV-4IQVBqGa-FIg6WlsFZo2av86HU3pI2lzw48XyAX-8OoKPK8u0MOX_Q1m5tQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbPDlN5XEu_fU6MSWHjMUJP7tIKIJ6AH6XWwrEVsiR5g&oe=6B0B1249"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTNlhV7cbRMQ7kNvwFoQOn7&_nc_oc=AdqZqsz6oFllqPMYjcTKKrB3V_hi5jX9kXVdibyoctWGmEnoDEcl89JEOUyRIErworo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSi-fbZzGzqjj6cS7o0f8gCj_dF0_jCrn3Uh5O3wzcy4A&oe=6B0B3FEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7cSigbov-wQ7kNvwHWFz4A&_nc_oc=Adqr_KK7dRRhZ_aOF6GbLFOLgczz2km7bxJyZctwZ3HShSTX2kCqwLKNjMp4ISbhVZM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2Ank0xxuqpNZsmSF3R4ukI-eHmSYdV7FYd9oPLFWdkw&oe=6B0B3039"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Stud
.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr7nelMveRkQ7kNvwH1_Th5&_nc_oc=AdlobPsCO23JXdXW95Hh5rWgpgSUAhE_MvzM6E8zbEjfVYhzygHWxLqIpUhxbG76nmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7iXY9GabBV9CrvzbMnKNkyGORKLjFwFiHRm9PM_8E9A&oe=69B15A26"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm--cQRvkCAQ7kNvwGYCKRJ&_nc_oc=AdnQPAGZ4w5XOM9AE3zdvX22i0R198xK-f8GNpzGNZGJRcUrGlLmwvhXPVRDWlSatz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGOBgxc9GE8TB4_DTE-aOpnH8DdhCcHl6hgrdtKpU4hA&oe=69B16A6D"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1h1J5UHZeMQ7kNvwHEuyRv&_nc_oc=Adk7eMhcd3oxmYBwjZtQS85Vo9j0E9AOpNzOY7hBE7mOzox0f2fyy_1LTckgaGL1jsc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhUH9YikEiP3Oty8m1mMmAeNpBmdTkX697v_O8f6iS5w&oe=69B146D8"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBMFatBG9QEQ7kNvwFAoHfU&_nc_oc=AdnDzlivSby7F31IYkgR5n4VFUrjx-X_1_w93m9MCakSpddsHH16zYjhuqUH--i0SK8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzEY3NyXRvWKF6XH7ZDGPYw3eh58LVNptLXwg1L2476g&oe=69B1578C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXguQ6FZBN0Q7kNvwFe0KWF&_nc_oc=Adm-A09hxk3qXRVSAUOKMvkjZw0n5aJCyfQ2D-5LFa3dyN7vFDpMn4vnGVZWkceBS3o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJIoHiCqxishlcU7YdhjyLMNJPPMmKRA9DpUs_8_G6tw&oe=69B15180"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnSiWukry3IQ7kNvwErCbJN&_nc_oc=AdnjhmbBhtxtoZCij4qt7Epn3XgPTgCZXk-2K-6CKWNSXHo2ArltBdtFV_w0vgLaDxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfycCiHanQg4j4IY1IQN0-qDhLFY8-LrpCpvnedbwpq1XA&oe=69B17109"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdsbjWUFP5sQ7kNvwHpzBKT&_nc_oc=AdnKhDhxXlBAZ9OuruyuLnOp6WN_A678dfRRubE0V_FFFKuTB1Qq6s8qPbOzjsLCh-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm-D5gWJjmNp981_1BOiJokFV_jSJ_LwXHewr5spBfqg&oe=69B1666C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVUU_PUHeaEQ7kNvwHH8EhL&_nc_oc=AdlCwXa-HaJ5eDrVjVBBIRaZMM1ZyuH6XQvroVPt42co-6sZtbftPjL1j7wzsTd3AJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5LcrTGagNCRbtDW-9S1KgaSwaDM8VzLRQu5vYn_98vg&oe=69B156B9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osHrg22apsQQ7kNvwFrnjAc&_nc_oc=AdkhuuiU5WfQxatogYunfoWhdtmJialojJyuYPnupGKuGWq1gQjuWnoz3Rc2HLJEAvs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk-cRFx6gpBLciWMKA3Jj0bkz0qOt9_LE0RLBssk9RQg&oe=69B6A026"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ypK8R8sj_sQ7kNvwEBiBJx&_nc_oc=AdkNs3OzEDQa6rgB0Wom4QOO325nlfuLuLnhZpTlxg8QccxxGKMQYE10fs6avYqpegQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlAIG4h--UWMRv3lz8uwI314H__pzR4Ndg2rUSItPc7Q&oe=69B6B06D"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kLGqUVBI24Q7kNvwGcOb6W&_nc_oc=AdlS4DQ4G2DWk3dI9RaA7CpxuxlUDcNzY0J3xo-XDyRwLzAajlJ8lLqMgkO10dMYBhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxg76uNRNUjpobNSbdH6KNJSd1JWyCSm3NTuVKzd_Vz4Q&oe=69B68CD8"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foyWy-T5MfUQ7kNvwG_P_TI&_nc_oc=AdnUgwCSXFV6-FfqYYESgeVwqKxa1u1n8kxNF9tgnGl0gYAFylJ5DLnuFwtfJkIWQlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjTi-VedzMZTA7D1ORXOB1ByEMH5hVvohbkEbEeU0Qag&oe=69B69D8C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKdHAuMtjm4Q7kNvwHS6wV9&_nc_oc=AdkTuvQTAenj4FBhjDcD4kpzd4GF0RvJ51qA6XYgJQBt_SP6N-NOSwKEs5ip1QL4zGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyhl-oFbnanJztx7-am_FLnTgUWtLnSJI21Vkq3x2O3Iw&oe=69B69780"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFpl3KylLpcQ7kNvwGMl2ov&_nc_oc=AdnXtWf9Ew5M3EklM8TZ8d2A_2qD2GHGifybGiOJckvqLPH-XrX1goQwdw7MqRKukyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXm5Qc5XYVR9AM-oBNo_Pj7dNIE82nm2aFQtACrLMiDQ&oe=69B6B709"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQqX3RJ85wkQ7kNvwFo-fkf&_nc_oc=AdlH3zKBgBPvN_9Wue4p4MNFUYASMfYzKecqnXvcOVc4T26NA-_iTgKbtsr64oShnkE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9L0iGiqPCz4Y1sTAfRAvTN7sj7HXcwVDVhVhOzNbxEA&oe=69B6AC6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01PbBZ98HGsQ7kNvwGwdItg&_nc_oc=AdlXdjtHScqld7kANpMgheXSbL_Npmxcc-yivp9V645QuB_qGb9o087wDUtHwRTrK94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyH059Wd8bfnJYO_NmaulodeDQ8NGKdwFQ7BMSSKXyNWg&oe=69B69CB9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osHrg22apsQQ7kNvwE_rDOb&_nc_oc=AdmVXFTATZBZ2C10RWHqtdgqsAUgRkrY2kUUXbTRQUNtsbFFLAmDLoKHc7KNUznCJEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzf2Y5uYRGY9Y7GSCSAPhK7s5m0PfNJJZH9C8D1Bv4Y8Q&oe=69B94326"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM6KoXMU6y8Q7kNvwEn2d72&_nc_oc=AdkSdPBkHmzfzdADAX6mQlY0xSdtl_yjY5n2WED4c2uyla6krvseW3h_kO22FyU2cFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvG4JrxxcWaLtERj0zDlMMbz8wVF1BLDldhh-yVWJu2Q&oe=69B9536D"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kLGqUVBI24Q7kNvwGZ-IQA&_nc_oc=AdnD7mQ8i4z8GBaDoTRYs4kb2wbLeZ--bKKyIECcT9gGhGbtm-Sk8d_Mf8iaVJqNqRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrF3RMryAXK4VqZnsC9rEfR5u6DkbRQFLy_HCKc5JT1g&oe=69B92FD8"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foyWy-T5MfUQ7kNvwFb9jn4&_nc_oc=Adn-Vrj7C1RnITuF2vtBzv63z00-dhUasS4RNMC-6ml3vuHYmd_Vnr5-aRw6FKf-NJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyStfu-ay-KsgpXIujvjRrwzIkeIW8WfwUDYwc5JmIEHA&oe=69B9408C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDhrzL2iDHgQ7kNvwH2GmEi&_nc_oc=AdmBtG7EX_oWJz0B3Do5jUBd7nMnc4gEqR2aaRk12w1XjhhJHy8daB-bfP6lVHEzzYY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZUedHaq6HUpmaq4TqupYumn_omSOLgBeK_aw2HV2R_g&oe=69B93A80"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ6LhdSXvvEQ7kNvwE3U1Jt&_nc_oc=AdnrnV_XmV51NpkR6BSfeW-QQeMMcnZ9-bOq3fd9uwfKzPweAmG7lU59bG-_-5xr9ZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHt69Eew5iGQBK3UnvKi_ly1CO1RP_AqoivQvmxXi1Og&oe=69B95A09"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOdysuxhgCkQ7kNvwG1xQ39&_nc_oc=AdmL3WojuI_-7lbmFdBf2eZb5Am9BHESfJ6GeySSuCaC_n8l1HWTJINiRtIUF3h-npc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwdNg6MBDKD87axueTrlIcnk3cji0q4kwPZM-sahGiLDQ&oe=69B94F6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01PbBZ98HGsQ7kNvwFM3oBT&_nc_oc=AdmUhwUiZhMZEhM6ffrBjh0SbKugEsfrG1r0_8odonkADJrfV2HZCe9O9pRog624pbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXfe8-5-FNOQTxsUw6ktWj7iCEyN3fHDbVEV060KiDLA&oe=69B93FB9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
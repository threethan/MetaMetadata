.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KBR90ns9wsQ7kNvwHDfY-k&_nc_oc=Adq2ImJsa18bsvY1JDRqvaPJlHb4QukdBE8IRtoDgkc9EklzaugRtDtwP78q8YxanWE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjvkt_i3L8xn4FSW5vVut1GScuRHIBGnxjQfXhmJK8PA&oe=69C12C26"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEFCN9wXXMsQ7kNvwEXp3t_&_nc_oc=AdptTZBwM-cAVeVkwdJTU_Gkf_SNCGpvM3RFStXHX6n6zVlifnKqes1sgqeDR-A3Pg4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGBUbtA44Xw_OWEC6bYrxZ2h2MZdA7TBhPDKTnl-BWFw&oe=69C13C6D"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5GgRY7kX1YQ7kNvwFEe0Mm&_nc_oc=Adp_XqzaA5nFSxS9bVRV3p7awX6v6wunLPh-o3Y05r3WfsVzqOxIfjbzPjMv1_xqA2Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6dnTN8pZrbt_V3aviFDWZOlxRQ2ICU3j5M9h-2OYi4w&oe=69C15118"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNvLwCZvs9sQ7kNvwE4Vbu5&_nc_oc=Adp0kCzGbF2mn175zCgL0ji5eiCopV24aXy1IzLDt2WSWd5DD50fq0vF3FzsZfbPU1o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzw4O92eiuynemULHFetSfrr-BlNC7s_7G7WG9O_goOCA&oe=69C1298C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzjPhCmL2-gQ7kNvwFY-f-E&_nc_oc=Adoqzxh0p7x6jnqhBrPBh_3U0xIwYxWEWENlJkTIkjGZYj8FSacoRBay8Qlb6sAZ2Pk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwlj8RSStfrSz5QcjtKejIsuaqlS_Qnpfes5-qaZ6GRMQ&oe=69C12380"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xj7Pbg9gmnUQ7kNvwFPrp8q&_nc_oc=Ado3itJhIYa4KajaRvoIdQjjhmUBsMq7G3rHLtKw11X1-CZ4s2vdGUSVAq0WXFpmm2o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJTsWnXec2Qlt6ki-rcEo4bud3aZ0fHLrBEUQu9F6F0Q&oe=69C14309"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rsDAWj976IQ7kNvwGc88Me&_nc_oc=AdoczKzOBzGaSekTL4K8tTCAoSQmMJ2k0kX5WI68zNNKmJzSq1GcsJvpQmOw-82fFEQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw62Pmo1Qpwlmx-fnPPGH4du-9K4izaDCi5we9Xotgpkg&oe=69C1386C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i19Zd0wmSsQ7kNvwHkhfa2&_nc_oc=AdoZZiUx06P35G35g9t4IU2mexl6wfffDvkT1KyFyaqkgTm0W9jWFbtxoZPU78O36t0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxx4Qh5ksMGPF1lH-wa5167N0v_c9G6UfNHwe8LwAS5ew&oe=69C128B9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr7nelMveRkQ7kNvwG-8mm_&_nc_oc=AdlZ0oMiztTkIIp0r9rTt1N8236M9d5xl_gRSuU-5M-yOlMSi6ux1-im4RtbjPy-zmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz15-Ni8YO6t31c85aw5UDRCdRj2HPKAEFP_I7kuYpgrg&oe=69B008A6"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm--cQRvkCAQ7kNvwEYjMOS&_nc_oc=AdnipEh_CI6s8Y85wqajGgsFInPUW-BMyn8j6PoAvM4YXK_COjhkeyCZQ-PJkjgEIPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2SwlauuWllUuSezafQC63o7fQz0wBopMZ5dqgQ4C4Fg&oe=69B018ED"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1h1J5UHZeMQ7kNvwHi0w1z&_nc_oc=Adn5-WWNEb-Fz80mbuDrSM41bQpxnigpFvbsWV0OvuGPjpUd70QyOptKbKREk0XCYGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwc8A4K3uaaiGyVaiQl7Q7JuyP2bfX1gbnHjYO0zPRijw&oe=69AFF558"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBMFatBG9QEQ7kNvwFeg_7F&_nc_oc=AdmV0xYIXM6EiF95NVTBSQOX2tSpfZZ-wKHoolZScNNDSiYo1KxVmtR6sLkklI5zvfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyzPMqGzd3STR1AY0ePLu9uHL0UaMjnTSXN-yV8SztxQ&oe=69B0060C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9EacIBiTSoQ7kNvwF3Xdr5&_nc_oc=AdlBa1nVgeBBuMQ3hCmZ01iRE6NeO2fEAC8kdTpQp8VWFW_eV2ZjsfvrEE43N52KvVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8e3xmRpXyLO3JTESjTohYWvr58lgchVzreqUlaQYhcg&oe=69B00000"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnSiWukry3IQ7kNvwG0tklv&_nc_oc=AdnqCSzc-vel9HYnSa7BUOYqpIIHQSHD5TH4I4k1bswIhwFjqq8OWdHfjeVXyBvr7bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykpqzTwXD73fpkwh6UOClJ5h9xVrHn9kat8RPoDp3cTQ&oe=69B01F89"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WNREz2JMzYQ7kNvwFOVqh3&_nc_oc=AdnhDszBrtRoSQPQVFotwX6n7KN6uuMCy_KpbM70yIAnD7fZt6L1sq1rcIDjI9be5pI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxQzLXDGHC-5ytn6cfSWlc6H9XsBE8AF96wmN_ZMyinA&oe=69B014EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVUU_PUHeaEQ7kNvwFn9mlM&_nc_oc=AdnVI585AMHmmsTOlKz8A45qNSU0BO_l-QLIZq6KfFNRAOHmdXneyMtNIVfVqHrok4Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMPkLeCsgDUruLeEbD90IM9XHZJwx2rYttuW2fUW4u1A&oe=69B00539"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
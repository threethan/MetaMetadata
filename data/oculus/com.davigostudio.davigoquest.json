s://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoWJ0QPGDl4Q7kNvwF4t2Ff&_nc_oc=AdlWbVhF0w8zO20lAx5xO6eZ-oidXxMbIpiWox422HjXV3MDjMbMO1N6pHTMeMs1S6g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPgUDqvyObtlcVly9OBrWag3RwNb0jDV0enssIMbpjdg&oe=69AABA00"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz8p77nVqrEQ7kNvwFZB4iC&_nc_oc=AdkIbt8vzkU7WGeYGn030980Qt-aEP7NIcgmCQtSq66nEQomqIZ6NDrR9XWLpwlt9Ns&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxS6MHqG4mDugRbzsGJ6ECsa2kWW2TFbt3cfyNc2F1MaQ&oe=69AAD989"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3sc_5JWRgcQ7kNvwHYrsak&_nc_oc=Adm4J_aW_TSvzM58a4EzkgNgTsu2uC7MwAzTGPwln_0fY0jy3WTNlC-a17QyraR2Gic&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTvQIuPIADv6kgaOJbg0cqpIskhMp3vmyfLRgs1cdpSw&oe=69AACEEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8FKa-BFYtgQ7kNvwGiy1K1&_nc_oc=Adk-znM3Kf3rjV1Hl9VoCDLE3-tAn6nCc9OEgakiTt5nG19bw4cvmFJkF_Oj6B8PLS4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZ_0_ru36uu3tm9w_PGnHuhdiAEB2v9jusWQqm28KL6Q&oe=69AABF39"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
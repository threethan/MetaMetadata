.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wFZx0rx-uUQ7kNvwEIDUxP&_nc_oc=AdmdjcLf7jGWONeTeSOAqC5FX6J4U2npRm2Nxew-LtN4B6i5JP3tZbucyNkRmpCEolk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxASiryB8L8pd-PoGZpi-WzoFr9cOJnQMv9PVnbdyTCzA&oe=69AC1426"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBKii5VQPd0Q7kNvwHNIFzd&_nc_oc=Adlg_M8Od9UxaxpSrCoTOaJtRc9sJCkn8M6078gh2Us0Oubv4-nz6VLyexpAI8lg2sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzw_7fryEb1oY31cO0HYZTM88eq1L7Jm0pTm5EtXsZPCQ&oe=69AC246D"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5xpQrMiZpAQ7kNvwGzar3L&_nc_oc=Adlh87MxcmLhQn1CHYvZMgwpRnJWuMpHK5YYmGftq-1hqMzXXlbQcncwWiYqV3EeLIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSuJIm8_8kdoOqGiZmjYARIcTEsmQpHc9N0ashp1LPLA&oe=69AC00D8"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5YCvpr_ywMQ7kNvwF9YGEu&_nc_oc=AdldBRBWYk0v-EB2UUutxLTV12rxqRekkvy6SCIeI1dPQL7GpJZ38PFFTDXwjfLLb6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpdqXkx1-boOYVzbvU9D6CtET6L-LjBsbieOQR-4aBkw&oe=69AC118C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoWJ0QPGDl4Q7kNvwHT3nSk&_nc_oc=AdkKcGJyyUl94Yu5bT73um7Rq_dT-OmRTqhdqZ7bbW-2hNHKQWNoszyEI4gF3Ncf-RU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymIetqn6umcxCMHYdH2kxZIf5KRT-GG3oslgMVQ9cHSg&oe=69AC0B80"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bknFb8aRBsIQ7kNvwHgBVl1&_nc_oc=AdkkUHt1xoDwN1mN7AjgjUmcE6p3bbDQXCdC44gbLd4XcEBRFkaaAmtcPY1-ZsvDyeg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcCriqHWGNmQXMzLMbrwM4Y6EG4QCfLPEAMrHL1tVx_A&oe=69AC2B09"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3sc_5JWRgcQ7kNvwEDakYa&_nc_oc=AdlQJVdScPoFwY9Ab8KYwTlE_YHeUCJR8o6cLYLY5UqQ-Ql47kd7WzMTq5_3qFtVIvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxgmHxOm5yO_Z1HdQWQvd4VVfQGkQfyP_f43qYtoonpcA&oe=69AC206C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8FKa-BFYtgQ7kNvwFXFYID&_nc_oc=AdmzkeR6GhepIAJNkJGVPhdWyq74oIiMswG8xfB_pZOPcOafuAmYKSYbwWng03-5nkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV5ea7FL880jmrmwIZawph47wW4nF1q2YHCUFN90hXKg&oe=69AC10B9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
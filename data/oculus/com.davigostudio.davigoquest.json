.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn62f_7--D8Q7kNvwFkdswY&_nc_oc=AdkYHlMdwtrn-s3TnUmQ2thFh8CIQqht0F_jWYx6guOASad8Ly9OCc4qDi88dZcp0Bg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTaTpi4Q7JHAg23FQyI_sjQa8sszKsd6KGJp1-yqbd2g&oe=69B3FD26"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ypK8R8sj_sQ7kNvwG-d2N_&_nc_oc=AdmTrmk96OaTbHZUf5Fy98eDooIZ41Quy8Rp91yvrlynDVknK2-bezVjaZJPMzQk_YQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSdzzjw6rILWTGeZHGQ0c_uuVpu9aEB5VjNJyR3SVPfg&oe=69B40D6D"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oPbgy6ocnEQ7kNvwFBfCOL&_nc_oc=AdnOwbdOGlGRlpqCio4s5M5OWVb7GW2TttmA4Lez95uAxo4vFjlNFzWX1hM-3k2z7K8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwc0Zya1qWCcn3x4orjl-5GaO-tlV3URpu2LDFumKwvEA&oe=69B42218"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ECE9Hzs1hcQ7kNvwFEgBun&_nc_oc=AdmtDRQSA0Kg0mJqYgV3igV7_5z75qvT73pLblQ6Y1XPtW9EiWPzjkpx_7J0rbkLeaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8gR7yj9h7EmmfCa6MtACuaO1GCCuuAGyA8EyC664BIg&oe=69B3FA8C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXguQ6FZBN0Q7kNvwHkJwxS&_nc_oc=Adlw7s_fXg5zXS3fkxi7AZ4yeg8J_5ymCb6khpHoNRc0GKuwHnxzMaHXgX65BtY56os&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWIxy3344Yo6ZyJOgohqjR4GNIHdq5FaHRjJJug66OoA&oe=69B3F480"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFpl3KylLpcQ7kNvwEYrsIW&_nc_oc=Adn2LY-0ClEJvnKn8rmaD5Nm2RypSJ-aF3eSojQihHVp5Os371Dtovyqb_wrVkVDswc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1SLjUmK1g6Crp2PXSHrZNehNWp9TXxHQysI3WHxu9eA&oe=69B41409"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdsbjWUFP5sQ7kNvwGkgX4g&_nc_oc=AdmLkgg35VMFqDsaWckFCSBOxNLrmDArtZIJ88Tlv3XKyxanKohbPGlMuI1UWS3Jd9c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz78O6BKMmVMDHjUFCva9dJ52ZPBkVzv8U_zdGQMBRAPw&oe=69B4096C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUyOo1jlI2oQ7kNvwENYcrB&_nc_oc=AdmEf45AhYIHlRrinUiwi1dQYR99tX9U4l92Ce9iYpWWqpZ4Ju_clG6AGqRKyqmgDxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9imrhiJ13fkXVPkDZiDGAS1uXN8J_0XbKQc_PeeGNwA&oe=69B3F9B9"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
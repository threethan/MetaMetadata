.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx9QM0uVmZIQ7kNvwGgMDu2&_nc_oc=AdknhQF2BwfxiTXnQeFWuB3iY_TtGza0P7GWAS9PZOK3mHcA67tH5dldmIbHb97hwT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftdwxwLAj2RusWa8ISmqhdCK1rmr2yddLmmZoRoTJfBVg&oe=69A81FA6"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuRRpNFZigoQ7kNvwFWN0fp&_nc_oc=AdkgjQIZ2RIAiqA2IEJKtGL6oWw1JptE8-J3gkTMnbvRhQaAn1rcI535gaJsdsoU6H8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftMXWrqxTIRhkmn8uLVUYEm8z70jjKR-8RYzcUdaynfRg&oe=69A82FED"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uOc0can818Q7kNvwEyKqOD&_nc_oc=Adn1q_lTcoLy3ZSMlnUJ5QbsPjLwrU3lHnLXT4Xny3gfk6L5TB4uG6_mtkbqa94NdsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftAaDP2P1qzyzjfykNNQ_Jw3QuFLEAxzPaqTfhf4Zy6KA&oe=69A80C58"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbgMpLuGm2UQ7kNvwGhUUJc&_nc_oc=AdnpSuGx2GCQIoSl2FsutH2PkMkidmXM4_rIIZpxADMbWwFLOf2LSTs6DTk6k3BlI_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftZwA7o81CcQFbsDrb3lJoq2Lof2AgOYpgMk7b8T2AxGw&oe=69A81D0C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwNsTn_aq2kQ7kNvwHcESvD&_nc_oc=Adm0v0d-plib29tox9i48O7akioRahtp9SK51FFDQ8QK2KP7cCrQIVPlN_l4cuaorqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsJnWuFQABHsU7HKt-qP1mSbgUYn-S4d5rmS6XnZGiLJA&oe=69A81700"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz8p77nVqrEQ7kNvwFIP3eh&_nc_oc=Adl_qxr3gzVXWH_Ckhuhpqp17iRVeCXAuwyYrFCqudpHv7CMNW2T6SZOdvuBdRrom6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsG22tUMypvH0n5zEYAMCtym_grlVoUK6_O_XVnORs-ag&oe=69A83689"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU3vjZqLlk4Q7kNvwHj4SAl&_nc_oc=AdlepQJ6fZ4c10z_uwAKVEw1Ix96_i4qYgnv0k7gYFM8YT1N868bgnSpxrudVJmZL_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuzk5vnkXlvSVQlXHpnKv3SMBxIFf0p3gJoyLdlUNQ_mA&oe=69A82BEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPF0X8EZabkQ7kNvwFP047N&_nc_oc=AdkhNxeU2oN38t_8e5_Myys8mVB6STa2O6jYPFzkE17g2KWQ2Lii18NO8VNIIuHUxDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvnNBx-Lzt2X_C8RUQi_nQXPQzHIUJn_JYCkvgq5e-Yew&oe=69A81C39"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
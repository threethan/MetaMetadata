.png", "id": "726178765605005", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982469_726178768938338_2243970941997617771_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68bbGIqC3cUQ7kNvwFshZFg&_nc_oc=AdmF_JELBZEsFZmEwZ5ZYE1y_27jGoJ7r9MyFat-UnHxEeRT9Q7VQJJGyjGEhrVpSEw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQCrFPB-QQ9BK4-7lFqAd_cLMJ786SckeoG24ys2ABrQ&oe=69BD37A6"}, {"file_name": "Davigo_Quest_Landscape.png", "id": "716674940481191", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75604734_716674943814524_7235525228688905148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBuU7yd68PwQ7kNvwErEZcr&_nc_oc=AdkHM0-mcIsQfO85kvZI51ZGKPPg7snLuCFCfApOFVrtZbFFIpimd6YiBOQ1Ihl_uX0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRaGfYPAdvmFiolFWUgU0DpWZKhSjz7XNVFl9oZJLq4Q&oe=69BD47ED"}]}, "id": "1182460320100803", "locale": "en_US", "screenshots": [{"file_name": "Davigo_Screenshots_GoodBatch_1.png", "id": "3503126089952943", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_3503126093286276_3374357759262109682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duUUESye1C8Q7kNvwHwsmVO&_nc_oc=AdlMNSzIzPBJwUPyoFaH6TF48gcrpqvZA0tNGKlLwU8qXizKN8mySQBDCQfcQU5EXCc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPBKdflk1tigNvIy0Cw1UG8U78DabagYCFuWRcvYvt6A&oe=69BD5C98"}, {"file_name": "Davigo_Screenshots_GoodBatch_8.png", "id": "1715837335548900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569471_1715837338882233_6683397076211579886_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeImUs6ctksQ7kNvwGLcl4j&_nc_oc=Adlca0KJqzZerxlHoprGm43Bz-PsnPRDKrUrcZsEpDFNlh5ZIetiy4aF81DE1wAcqVU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy91D1jiuP-F413T5D_c8pgLTl_KJRW-7Oo5r7vAfYeUA&oe=69BD350C"}, {"file_name": "Davigo_Screenshots_GoodBatch_4.png", "id": "349637924187676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982671_349637927521009_5319405368238501207_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiT0R8257dQQ7kNvwH0jWh5&_nc_oc=Adnc8wz9FFJxpe4m9-J8N6Gicvf6MGIhdnAC7HxD_QtHiEWLze8MHCt3q8j8QDxGgwQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIEH9wcCONzRKpZFkDg71pmDWYc0dEtI7aj7gJcgYqMQ&oe=69BD2F00"}, {"file_name": "Davigo_Screenshots_GoodBatch_9.png", "id": "846448866977689", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974513_846448870311022_3691110310329812622_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y3R97mjVdIQ7kNvwGCy_t5&_nc_oc=AdklM2O9-CH6n_frlZq_a9lDA4pIzqZwwrf0nnNdfifbpMz0iNBDzHCxhTA9dyUxkYc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9a7-e5ExdLwPY71VRVEH3xAtonRsrBd4aBZGheOSx6g&oe=69BD4E89"}, {"file_name": "Davigo_Screenshots_GoodBatch_10_YellowWarrior.png", "id": "245796888145226", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75520119_245796898145225_2210460177510141286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EYPDnJyV2QQ7kNvwFE2cT3&_nc_oc=AdmhKGkUnhkwI6FCw4KOJI1smtN4fnpIZZVjK7sh2hA5S1ZdQ4LDadLprkF-exzNFT4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxuawf9XD58sMaU_gXBVwfYjUH056LmFF3fruRFCSvPuw&oe=69BD43EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Davigo_Quest_Landscape2.png", "id": "649494150680615", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974703_649494154013948_5417440697342019613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbURPA6Ti40Q7kNvwGOelGB&_nc_oc=Adm40NkNe80ZRDmlvNXCJnDQ40DNx1vKpydVWw5cmdDcSkTgexhjP8lQ48XHyYT8agk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzqB4pItUyBTu_QcEDQ4ZrbJbVmKDYwOwo69vwxvT052g&oe=69BD3439"}, "display_name": "DAVIGO", "keywords": [], "long_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and battle tiny KNIGHTS online in a variety of maps and game modes.\n\nDAVIGO requires an internet connection and must be played with at least one other person who joins your game on PC. Your opponents can fight you as a KNIGHT on PC by downloading the free DAVIGO KNIGHT'S PASS at davigogame.com/knightspass.\n\nYou are the boss. Unleash devastating power on the puny KNIGHTS with physics-driven, full-body gameplay. Pound the ground, rip trees and stones from the earth, and throw everything you can to leave no KNIGHT standing.\n\nBattle in 7 official maps that will take you from the hellish sacrificial pit of ALTAR to the desolate, snowy peak of SUMMIT. Download custom maps created by other players to continue the fight.\n\nFace off in one of four game modes. BRAWL is DAVIGO's flagship fight to the death, while TOWER and CAPTURE spice up the battle with secondary objectives. CLASSIC recreates the DAVIGO Alpha experience and will challenge you with a limited arsenal.\n\nFeatures\n- Cross-reality combat with 1 VR player and 1-4 PC players\n- Physics-driven full-body gameplay\n- 7 maps and 4 game modes to compete in\n- mod.io support to download custom maps created with the DAVIGO Map Editor\n- Free KNIGHT'S PASS for PC players to battle you online", "short_description": "DAVIGO is a VR vs. PC physics-based battle game. Become the GIANT and face off against tiny KNIGHTS in online matches. Connect with up to four PC players and show them who's boss! KNIGHTS play for free with DAVIGO KNIGHT'S PASS on PC."}]}, "developer_name": "Davigo Studio", "developer_privacy_policy_url": "https://www.davigogame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Davigo Studio", "support_website_url": null, "website_url": "https://www.davigogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection":
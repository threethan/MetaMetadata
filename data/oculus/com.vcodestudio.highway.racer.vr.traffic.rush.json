Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9MjPF6OhX4lKlGjjMSuFQufCBjEfx6AQSWtaMOmqAIw&oe=6A9ACAD1"}, {"file_name": "Screenshot_3.png", "id": "708652621803112", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823431_708652625136445_6316944835634319209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7vytAQ47agQ7kNvwGlz8Sx&_nc_oc=Adrq63-x6SMI0K0KpiTSZQsJK2hvUZnrSmWeAOeO6CSfMUHFivwNLwzjqSL5K9rXcGo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL38ASW2eEdHFFOnWYSJllOP_fBA-LjyplqGHTBOfLsrg&oe=6A9AED3C"}, {"file_name": "Screenshot_5.png", "id": "852692613950967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311613_852692617284300_3448724180639816175_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK2slRt1feMQ7kNvwGWe3n1&_nc_oc=Adqa4ayOsjTeOpZiF7uK1GowfNnXsPIYPcVRBriIdI-CJ0Ca7BKn_RoiFzIU_7KLRh8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_BBUMnx8td_fQsMTuEgBAtAm7YRSXsvt3BVFb-l0tFw&oe=6A9AC41C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highway Racer VR : Traffic Rush 3D", "keywords": ["VRRacing", "TrafficRacer", "HighwayDriving", "3DCarGame", "CarRacingVR"], "long_description": "Experience the ultimate highway racing adventure in Highway Racer VR : Traffic Rush 3D! Put on your headset and immerse yourself in fast-paced VR racing, dodging traffic, weaving through lanes, and feeling the adrenaline of full 3D highway action.\nRace against the clock or compete for the top spot on the leaderboard as you navigate busy highways at high speeds. With realistic car physics, immersive VR controls, and stunning 3D visuals, every race feels intense and thrilling.\nTake on challenging traffic patterns, master sharp turns, and unlock new cars and upgrades to dominate the highways. Perfect for fans of car racing, traffic dodging, and VR speed challenges, this game delivers non-stop action and excitement.\nKey Features:\nFull VR highway racing experience\nDodge and weave through traffic in 3D\nHigh-speed adrenaline-pumping gameplay\nUnlockable cars and upgrades for endless fun\nCompete on global leaderboards\nGet ready to feel the rush of highway racing like never before \u2014 only in Highway Racer VR: Traffic Rush 3D!", "short_description": "Dodge traffic, race fast, and feel the rush in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25083997161252497"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1044100421875790"}, {"status": "PUBLISHED", "id": "1584220889993866"}, {"status": "PUBLISHED", "id": "1528894055309773"}, {"status": "PUBLISHED", "id": "938614735716482"}, {"status": "PUBLISHED", "id": "1737343343899991"}, {"status": "PUBLISHED", "id": "906860688882214"}, {"status": "PUBLISHED", "id": "1520516515682975"}, {"status": "PUBLISHED", "id": "2021881011717794"}, {"status": "PUBLISHED", "id": "1866034774049130"}, {"status": "PUBLISHED", "id": "845921628027593"}]}, "baseline_offer": {"id": "845921628027593"}, "
ng skills to the test.", "short_description": "Search for the hidden AI character in this immersive single-player VR hide-and-seek adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/artsidegames/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Side Games", "support_website_url": null, "website_url": "https://sites.google.com/view/artsidegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1213914005145126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296127_2278090549628877_7629942758544519050_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLd4HD-kx4sQ7kNvwE6TC28&_nc_oc=AdrT9xl6LgbiJm92GocGRWe9B34KHGmaMa4s53ncd0UdZozINdYfOyQDb4AQROLmtes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_He4sxF5YVKtCAJXs4Bkrbl1IIfFUyViBLbLtxofJgA&oe=6B047D5C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meccha Chameleon VR Hide Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1785780120, "lastRevision
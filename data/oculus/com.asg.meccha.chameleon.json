\n\ud83d\udd0d Search for a hidden AI character\n\ud83d\udd2b Pick up and use your weapon during the mission\n\ud83c\udf0d One immersive game environment\n\ud83c\udfae Simple and intuitive VR controls\n\u2b50 Easy to play and suitable for all skill levels\nCan you find the hidden AI character? Enter the world of Meccha Chameleon Hide Game VR and put your searching skills to the test.", "short_description": "Search for the hidden AI character in this immersive single-player VR hide-and-seek adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/artsidegames/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Side Games", "support_website_url": null, "website_url": "https://sites.google.com/view/artsidegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1208387765697750"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1209912702211923", "version": "1.0.3"}, "id": "1959696141341362", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"
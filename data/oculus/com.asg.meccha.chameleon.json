ng skills to the test.", "short_description": "Search for the hidden AI character in this immersive single-player VR hide-and-seek adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/artsidegames/home/privacy", "developer_terms_of_service_url": null, "publisher_name": "Art Side Games", "support_website_url": null, "website_url": "https://sites.google.com/view/artsidegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1213914005145126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296127_2278090549628877_7629942758544519050_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BorXLpNa0pUQ7kNvwHqb99U&_nc_oc=AdqmtIWSycAn01WFUfFowfU5AldeIisL9ixX9sgt3AFxUH0oE0kj9wvuDGs-XS2ZOlo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwEV_1kFL55xQ1tkfGAnerb7as_T4pTqagMsN3-SazoQ&oe=6B0B14DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meccha Chameleon VR Hide Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1785780120, "lastRevision
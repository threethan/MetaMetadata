UMFHa8-knvSge6QJZ_swFFzY9gzMuvqTABcZ0bpEc6la8hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8EoMEhfCqng_MDT3E1sU0vFWNtlzIRNcWfV0lLaOZFQ&oe=6AA2BBE3"}, {"file_name": "Cashout Gunplay 5.png", "id": "1192273433068346", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311585_1192273436401679_65359783804822879_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fkz1XU5h3LoQ7kNvwHHJQzZ&_nc_oc=AdpMSfqadOnBalI1P5bnGwgc5rwBm6EluYJzVGcfkEKCJmeG_d64ySdEzuz5J2uyWSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuJhA3_NHGdtpNjX6AF3trg4uLaIJHTPcD6aA11FLBgw&oe=6AA2A153"}, {"file_name": "Cashout Team 2.png", "id": "1388959129812967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593995458_1388959133146300_4096552509309304049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqkJKN0O3AMQ7kNvwEPrueC&_nc_oc=Adp4UDJnugNSr7R_cxEYCZ5EQxpgj-wDi3Gu6I4vwEdFMNWpgYDu4shjwZYl7kqrN5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInQDXWI0mjgJaTpSY-KD7U_dusT7WNsIr6GlAiV4iMEQ&oe=6AA2A0CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CashOutCoverImageLandscape (1).png", "id": "1397387905616411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310734_1397387908949744_1211696257107143742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnlF9yxcnfYQ7kNvwFSfFGr&_nc_oc=AdqSUo77nGO4zQWONLK97CadJ6EJBEt87sFwz6Syho7WlEUbX99HQa0e7zQ-XAXsuYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP_1WQWijU2hrWM6ZaWspCXFZG2tIFvWZJ5r4asKYNkw&oe=6AA2A793"}, "display_name": "CASHOUT", "keywords": ["shooter", "fps", "pvp", "shooting", "free"], "long_description": "# CASHOUT is FREE Forever for Early Access Players! Get it while you can!\n\nCASHOUT is VR's fast-paced, competitive multiplayer shooter inspired by your favorite PvP shooters of the last 15 years. Fight to become wealthiest assassin ever known.\n\n# 7+ Highly Detailed Maps Built for Close-Quarters Chaos\n\nBattle across 7 arenas pushing Quest 2 and 3\u2019s graphical limits that are designed for fast rounds and constant action \u2013 with even more maps coming regularly.\n\n{1783400183095461}\n# 15 Weapons and Counting\n\nMaster an arsenal of 15+ weapons, from run-and-gun SMGs to precision rifles.\n\n{1767144354713263}\n\n# Get Rich or Die Trying\n\nEvery kill pays. CASHOUT has a progression and customization from Day 1.\n\n{1053319800587266}\n\n# This Is Just the Beginning\n\nEarly Access is the start of a long journey. We are already working on new maps, weapons, modes, weapon customization and much much more. Early Access players are locked in FREE, forever. Thank you for your support.\n\n# Join Our Discord!\n\nVote on updates, join giveaways, and squad up with other players!\n\n**\ud83d\udd17 discord.gg/dy87XDY5cF**", "short_description": "CASHOUT is VR\u2019s fast-paced, competitive multiplayer shooter inspired by your favorite PvP shooters of the last 15 years. Fight across 7+ high detailed maps with 15+ weapons. \n\nEvery kill pays, every match levels you up, and this is only the beginning \u2013 new maps, weapons, and modes are on the way. Drop in now and become the wealthiest assassin ever known."}]}, "developer_name": "2080 Games, Allware, Silent Nova", "developer_privacy_policy_url": "https://www.2080.games/privacy/cashout", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
a&_nc_ohc=xsxsn7R4bcEQ7kNvwEPLv7R&_nc_oc=AdojAppfDGTDGuM9ZnYm2i6wpWPBLgHu1VSExUwiRQCkLhgSn7nBrP-Bsc2TLEw5mmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmQhvnPnZOsWbjUUrdZlSGUADBJR_07s5UH3G_DP72EA&oe=6AF34513"}, {"file_name": "Cashout Team 2.png", "id": "1388959129812967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593995458_1388959133146300_4096552509309304049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCoF32mFHuIQ7kNvwHKiqFW&_nc_oc=Adqh1_dvxv7cE8txefiF7gkWLHXJxTul6CPZAJqwqDQm6ka4s0twrEjEZG_RuaM8Kuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMdNWJqBXV3gytPZUw5Vx_vn9xHbOmpfme5N13V0-qCw&oe=6AF3448D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CashOutCoverImageLandscape (1).png", "id": "1397387905616411", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310734_1397387908949744_1211696257107143742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx7vwBA5UTEQ7kNvwGQNsiY&_nc_oc=AdpAjQEo3gTcavNowF82ScgPrzENbLymZuqup5eZYnRhXeameu_szl7taTmyelPvE3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTXRK81KAoeN3U5RSVuGBN5VtL1vck6siRk744mSwu5w&oe=6AF34B53"}, "display_name": "CASHOUT", "keywords": ["shooter", "fps", "pvp", "shooting", "free"], "long_description": "# CASHOUT is FREE Forever for Early Access Players! Get it while you can!\n\nCASHOUT is VR's fast-paced, competitive multiplayer shooter inspired by your favorite PvP shooters of the last 15 years. Fight to become wealthiest assassin ever known.\n\n# 7+ Highly Detailed Maps Built for Close-Quarters Chaos\n\nBattle across 7 arenas pushing Quest 2 and 3\u2019s graphical limits that are designed for fast rounds and constant action \u2013 with even more maps coming regularly.\n\n{1783400183095461}\n# 15 Weapons and Counting\n\nMaster an arsenal of 15+ weapons, from run-and-gun SMGs to precision rifles.\n\n{1767144354713263}\n\n# Get Rich or Die Trying\n\nEvery kill pays. CASHOUT has a progression and customization from Day 1.\n\n{1053319800587266}\n\n# This Is Just the Beginning\n\nEarly Access is the start of a long journey. We are already working on new maps, weapons, modes, weapon customization and much much more. Early Access players are locked in FREE, forever. Thank you for your support.\n\n# Join Our Discord!\n\nVote on updates, join giveaways, and squad up with other players!\n\n**\ud83d\udd17 discord.gg/dy87XDY5cF**", "short_description": "CASHOUT is VR\u2019s fast-paced, competitive multiplayer shooter inspired by your favorite PvP shooters of the last 15 years. Fight across 7+ high detailed maps with 15+ weapons. \n\nEvery kill pays, every match levels you up, and this is only the beginning \u2013 new maps, weapons, and modes are on the way. Drop in now and become the wealthiest assassin ever known."}]}, "developer_name": "2080 Games, Allware, Silent Nova", "developer_privacy_policy_url": "https://www.2080.games/privacy/cashout", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "38674666375510004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_2328546561251144_123474720
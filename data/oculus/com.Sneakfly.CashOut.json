vXwpiNyxEMhFcmweRYeII5fxr35IacU2gtZAzXpEJLmW4ghiQ8SDaU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDAn8ZTqxx3wjMVpZ1GvZOzNPo4PTd4QUb7WW__ycKFw&oe=6A8EF563"}, {"file_name": "Cashout Gunplay 5.png", "id": "1192273433068346", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499311585_1192273436401679_65359783804822879_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rqNwkGVwssQ7kNvwFQRf92&_nc_oc=AdrHdcWQgZlYqs06Ey_VvWKvYq-9pivXya1dNVkG0qYtjCga5Ref9spUGn7rfc6zYLU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7OpOaG3fRqzsvbYwIOE2Lp_L-lDJ3g1j8e1nOjHcAwQ&oe=6A8EDAD3"}, {"file_name": "Cashout Team 2.png", "id": "1388959129812967", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/593995458_1388959133146300_4096552509309304049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qgato_38Af8Q7kNvwFJO3r2&_nc_oc=Adr9KdZQ5nlNYA-351a36iZvJIZFKR-e9nBMHV--CMqhGj2s3AUFpTqwPQon8mAY1To&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqnkajT_ZDKcNn_ILct5ZutIyFv4njKyNml-2CIJm71g&oe=6A8EDA4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CashOutCoverImageLandscape (1).png", "id": "1397387905616411", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499310734_1397387908949744_1211696257107143742_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXzNy8xSkvgQ7kNvwEvAlMa&_nc_oc=AdrvSiabH7JmPzZXmXU7zBgBZ78UM_YH1iW3lUxVBSpmAHejsbIs9Ckz2-WIngRMCBQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTIt9J6i6dt9dB8RR14NAcIRpOetejwOd2jCXcWHgyyA&oe=6A8EE113"}, "display_name": "CASHOUT", "keywords": ["shooter", "fps", "pvp", "shooting", "free"], "long_description": "# CASHOUT is FREE Forever for Early Access Players! Get it while you can!\n\nCASHOUT is VR's fast-paced, competitive multiplayer shooter inspired by your favorite PvP shooters of the last 15 years. Fight to become wealthiest assassin ever known.\n\n# 7+ Highly Detailed Maps Built for Close-Quarters Chaos\n\nBattle across 7 arenas pushing Quest 2 and 3\u2019s graphical limits that are designed for fast rounds and constant action \u2013 with even more maps coming regularly.\n\n{1783400183095461}\n# 15 Weapons and Counting\n\nMaster an arsenal of 15+ weapons, from run-and-gun SMGs to precision rifles.\n\n{1767144354713263}\n\n# Get Rich or Die Trying\n\nEvery kill pays. CASHOUT has a progression and customization from Day 1.\n\n{1053319800587266}\n\n# This Is Just the Beginning\n\nEarly Access is the start of a long journey. We are already working on new maps, weapons, modes, weapon customization and much much more. Early Access players are locked in FREE, forever. Thank you for your support.\n\n# Join Our Discord!\n\nVote on updates, join giveaways, and squad up with other players!\n\n**\ud83d\udd17 discord.gg/dy87XDY5cF**", "short_description": "CASHOUT is VR\u2019s fast-paced, competitive multiplayer shooter inspired by your favorite PvP shooters of the last 15 years. Fight across 7+ high detailed maps with 15+ weapons. \n\nEvery kill pays, every match levels you up, and this is only the beginning \u2013 new maps, weapons, and modes are on the way. Drop in now and become the wealthiest assassin ever known."}]}, "developer_name": "2080 Games, Allware, Silent Nova", "developer_privacy_policy_url": "https://www.2080.games/privacy/cashout", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "https://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
Hwrx60mUDoh4K5XGv2_HR1ajA&oe=6ACD0585"}, {"file_name": "5.png", "id": "851444302605070", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974515_851444305938403_3822159500547791133_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ys8hNMoESAMQ7kNvwHtQXvZ&_nc_oc=AdoEuuZulYDBh2d1gWhS5rDBL4em10tmSiHaHA9L_MBr8bJWIqr3uQNUw6Vx_MQGmhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPFvZ--5nderzofvjQYzHPqKMTSy6BVNtbhz9b_WupzQ&oe=6ACCFD86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "5778209072228594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75557068_5778209075561927_6902180764481123801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmdBde3yXNUQ7kNvwEe8SdI&_nc_oc=AdonggIC9GbOtkdVcPx0suUh7G76m78YxSHNHVR7ebpBwr5ny40Ycdb8kzPn-zuMmTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNopwGHlUZSveLZLY5ID2XPr3ATuqtR0n4ZXAHq5gnO6g&oe=6ACCE315"}, "display_name": "Presentiment of Death", "keywords": ["shooter", "roomscale", "action", "bow", "archer"], "long_description": "Presentiment of Death is a fast-paced story-driven adventure of intuitive and aesthetic archery with an unusual passage of time, inspired by one of the best games SuperHot.\nVR action where you have to survive with the help of your dexterity and quick reaction.\nYou have to face the robots in ranged combat and fight them, because only in your power to stop madness that is happening inside.\nIn addition to basic robots, you will encounter more advanced creatures that will require better skills from you. Try to catch enemy\u2019s weapons and use against them.\nThe boss levels are challenging and the final battle promises to be epic.\nNot just a game, but a full immersion into the world with a special time dilation system.\nRemember that time is inextricably linked with archery, so get ready to act smart and think ahead.\nFight your way to victory \u2014 dare to become a Timeless Archer!", "short_description": "Do you hear that? Sounds of classical music and an arrow rushing by. Burst your way through the enemies inhabiting on different game levels and come out a winner. Remember, all in your hands \u2014 a bow and a chance to survive..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9744759338901965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393859_1175433074590192_7324459467311326421_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvAOqRYwulUQ7kNvwEQ9z91&_nc_oc=AdqEPD0zqD9hNKPdMLyOICZJO-f-vlCgMS9VwfbQMfSrkL6bNB1FRG8p6N_nDRJ1ozc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUX-kK0iN87znozJScYenCkkKn7F6JyrwuSO1kYG9-mA&oe=6ACCE21B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Presentiment of Death", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "15921929
nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEMOlEOWIH4Q7kNvwE8iACK&_nc_oc=AdqXDD6v7WVTa0OmSjqP-HvNbYiDaaC6uMeXSn4nKx_3q1YgdTG0vuBQvxH49DHdmQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEc8EBqiOIilQXORbTiPdjNN9HsWtA1WrH6OPYnoypEA&oe=6B05B605"}, {"file_name": "5.png", "id": "851444302605070", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974515_851444305938403_3822159500547791133_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBL8FTvEi3IQ7kNvwG3FjEB&_nc_oc=AdrQmlrfcpY2UqSW4z5Qj-PSgg-lxASKkNQn9S3VHgfjjfa5MicqGru1Nn8ZdVL_REk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUQk41Hkd095CVeqNWoqtS97QFqei6l-a0SI7Ul250tg&oe=6B05AE06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "5778209072228594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75557068_5778209075561927_6902180764481123801_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLsMY6h99YAQ7kNvwFOLqQd&_nc_oc=Adpo8Cy83eSuzXY4JAFhTL0t9IKvOenMPmRCTEjEzCvWaYwmXilFpc_P5jWXw23ny4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV9CM1_1k7nwcSrGNnxr8kvycw8FQ_1hYWysPfS-7NEw&oe=6B05CBD5"}, "display_name": "Presentiment of Death", "keywords": [], "long_description": "Presentiment of Death is a fast-paced story-driven adventure of intuitive and aesthetic archery with an unusual passage of time, inspired by one of the best games SuperHot.\nVR action where you have to survive with the help of your dexterity and quick reaction.\nYou have to face the robots in ranged combat and fight them, because only in your power to stop madness that is happening inside.\nIn addition to basic robots, you will encounter more advanced creatures that will require better skills from you. Try to catch enemy\u2019s weapons and use against them.\nThe boss levels are challenging and the final battle promises to be epic.\nNot just a game, but a full immersion into the world with a special time dilation system.\nRemember that time is inextricably linked with archery, so get ready to act smart and think ahead.\nFight your way to victory \u2014 dare to become a Timeless Archer!", "short_description": "Do you hear that? Sounds of classical music and an arrow rushing by. Burst your way through the enemies inhabiting on different game levels and come out a winner. Remember, all in your hands \u2014 a bow and a chance to survive..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "702708281319480"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1648970397007495"}, {"status": "PUBLISHED", "id": "1027250843192709"}, {"status": "PUBLISHED", "id": "942961185333139"}, {"status": "PUBLISHED", "id": "3803913916421460"}, {"status": "PUBLISHED", "id": "1315675086556461"}, {"status": "PUBLISHED", "id": "1201193151510682"}, {"status": "PUBLISHED", "id": "853045649103032"}]}, "baseline_offer": {"id": "853045649103032"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1
/t64.5771-25/75367595_614808336690914_8709922739410994730_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9C3hU0BjpsQ7kNvwHhQ_ru&_nc_oc=AdlvHcCHHnc5ElAg3pkmvMszsf_mYVRVSYdhtla4KrZSxaniiouRzbU1VjsDW_c0wnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAaR0LsmXxmIqh8mK5M6Qh4uFkng6Ju98vyJRvzhAelw&oe=69A03CB5"}, {"file_name": "Screenshot2.png", "id": "830107978355425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75314846_830107981688758_708232131660660581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeFcvZR1GqEQ7kNvwH8AsFa&_nc_oc=AdkasGOY1n7r9vF69GTGTzxb8WEkyaaDexb2iz49MYaqQOIxyBcV2oM20jZRjxtXWqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsJlR43R8XXR7oJ2qe_9xdJ5JEb190ONd3UyqJskxyyuw&oe=69A05906"}, {"file_name": "Screenshot3.png", "id": "363846782482585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_363846785815918_4504657108639784316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81zoK21U62IQ7kNvwEyzjrG&_nc_oc=AdkiOIatymOoHECXuRzm9--BUEMJ1CMAo5PvY1b3_C6AWzF4pvqABOFH6ZYv49A9v-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6oHNhsN6xxQIzrf_0UjFPIr6CZbi9KS05wL3P86wilw&oe=69A02EFD"}, {"file_name": "Screenshot4.png", "id": "615936303418693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974457_615936306752026_1145098500816248758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Yk24ZtmaT4Q7kNvwFpdbpQ&_nc_oc=AdlELA0n4d66YlPFTzdeDFZ-XAh1o4-3Mbnf2PQ18J03x4XoK9U-66dJY_ES2dnM_j4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLu5PH5Pxwul_MElXBtFjvtvxo5rBTFmFeCKEK00ilzg&oe=69A048F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "461601282560023", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031402_461601285893356_7581554104634840885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApG10UXri9kQ7kNvwGHX23A&_nc_oc=AdlkicXg-ltgA2-7JkE4j-3MMnSJCsREDqlB0GRFIT2-dDoXkW8K1HBUHBw91ojjPbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuzuHUIKgDeGRBLqAE0rwICTJCgKdYAXW1dTWeBvB-mfA&oe=69A0291C"}, "display_name": "3D scan of a forest", "keywords": [], "long_description": "Move like a pedestrian in a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a forest, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 800 meters in a forest."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
509910111_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zc-c_V5uUxMQ7kNvwETku5t&_nc_oc=Adqlqv8gALOoPfJvs4jbZ3XOfpgGM0j2KTiEsQZvR4XrSfKlnJQ8TyUM9xHnlgePQwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSybi37c2o7DejCpqzc1BBH4SUSyJxWODBv73XmiPOYuA&oe=6AFDD0A6"}]}, "id": "665745651636066", "locale": "en_US", "screenshots": [{"file_name": "Screenshot0.png", "id": "760658055265699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75393561_760658058599032_9158221575533110537_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10BWJcvY3zAQ7kNvwEFMz3e&_nc_oc=Adp7bcZz_zRyp1zSckPcBFm_Pf148DA7yt60o0JMcxIA5RGyQD7fsaA055VFaQzL8R0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT22lC_kWZ543Bb0KNE3fg36gnLVLlJ7dnaq0nMyJO3Ew&oe=6AFDB121"}, {"file_name": "Screenshot1.png", "id": "614808333357581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75367595_614808336690914_8709922739410994730_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-4kj0qVgLcQ7kNvwHVFPNd&_nc_oc=AdrYaY0sIcBVUWcx1eJsQZG0vKHYnoOfQT4eIOBVX1Hzkd7LXKbZtQZ7C0ZBmRrY26Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWPrhIGK-rgj9TPsa-7e4ybI4SMdeiHkq8NsRvxukqkQ&oe=6AFDD275"}, {"file_name": "Screenshot2.png", "id": "830107978355425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75314846_830107981688758_708232131660660581_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnCe7ZAQiEAQ7kNvwFJsfnL&_nc_oc=AdrBKC1n1Ob8yEdof7Ru0quNX-b5OjgyNFoOKLX29Cvq8zZ0-PeGfRcbQWOtbQGanTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuf04nQsUwoNcBYrmOqcQGFPtKGOp3VQXDZNZ1n9ECzg&oe=6AFDB686"}, {"file_name": "Screenshot3.png", "id": "363846782482585", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_363846785815918_4504657108639784316_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWC8algMFvIQ7kNvwE62X3F&_nc_oc=Adp4EXR6mmcAISQra04XSb9G0UtGjsyQOFFud4pMM7F2Z_3_dIbdOhU2Ny0TwN3o-pI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCBZ8Am87_-sBlN0r2pgY5e28nlKOk88rZxN3ANXe5zQ&oe=6AFDC4BD"}, {"file_name": "Screenshot4.png", "id": "615936303418693", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974457_615936306752026_1145098500816248758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08qwywgUpEEQ7kNvwE4oaLJ&_nc_oc=AdrJAbW02s2dga0WfDwWKhLdjU2e8Jx9bEnfGleSEg7RybgYSUn4m2gJpCTzuAKf0cg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgi_cTSZhDAKXfQVhX9xLPCHHAvztJruX9M1TDnJxTDA&oe=6AFDDEB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "461601282560023", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031402_461601285893356_7581554104634840885_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQt-awetXmQQ7kNvwHdFb-q&_nc_oc=Adr7qBlRMlpmwDSzUpStkuLsjgQb6-My5P2xJX_Ch_-Tw5Ckl5Eoka8FOMe-WbiudCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbmp5zBd1816mgImmNjkPwAaHRx907lzx1LDgI3V-iZA&oe=6AFDBEDC"}, "display_name": "3D scan of a forest", "keywords": [], "long_description": "Move like a pedestrian in a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a forest, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 800 meters in a forest."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "988384362558220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250458_751923672547617_638713737026394932_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iHVGfrOlIcQ7kNvwF-Pnhf&_nc_oc=AdpdAqLTtlPYGN2j0i-wi7k-Cn-tBUKaH899l5qZIh4H-xkEC-EUlyuxOSGyFsIcGZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTClBkFBVB0m330exNIbVzzqwHVQ3sZKsqADGX9jeWFTg&oe=6AFDBE6A"}, "is_concept": false, "is_test": false, "is
509910111_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zc-c_V5uUxMQ7kNvwHU6I7S&_nc_oc=AdoROjCnAsZOezlljCPV0uebZthkaSgy2ZwKrQ3FZX9Emt1-xxKNZHhSbnNqDQTauhM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO5PDFwABl853IF4dldeoXkHBAbJmxrH-xItSiZBQKgQ&oe=6AFF2226"}]}, "id": "665745651636066", "locale": "en_US", "screenshots": [{"file_name": "Screenshot0.png", "id": "760658055265699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75393561_760658058599032_9158221575533110537_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlFhqLbd2iUQ7kNvwEt1bR7&_nc_oc=AdrzA-ob57_w7BHJFTN7QtevkGGUP-KvHPzD1qqLp7pWZdTDEL8T6rti7UAv064Dp5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5hBXNBtxvp8myRBko3jQBNpWEPlhJsrIpCVD8YFeIQw&oe=6AFF02A1"}, {"file_name": "Screenshot1.png", "id": "614808333357581", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75367595_614808336690914_8709922739410994730_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kacVsxaUVaMQ7kNvwFNQEr3&_nc_oc=AdoeY6PRvLMxeLH2I1hNmbKnxmcDQNhzivvoFKPBLwEq5IAoXo014NelqaJga_HUrvs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBzUKyR_xv8_NuZ2jXDLGx0NRRCfGPXF0eVKqEvSYKpw&oe=6AFF23F5"}, {"file_name": "Screenshot2.png", "id": "830107978355425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75314846_830107981688758_708232131660660581_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnCe7ZAQiEAQ7kNvwFE7BJ3&_nc_oc=AdoM6vHunzndp7L0C0S-36_VU0lXlEyb5ewg461K-vy3itH-silcWdgWZ4yDt1etOQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIF-SSwAPHvZ3K7MqjMA3Jsz5hXAfhhRHMeTeJJGnGpg&oe=6AFF0806"}, {"file_name": "Screenshot3.png", "id": "363846782482585", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003244_363846785815918_4504657108639784316_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWC8algMFvIQ7kNvwF0Bt7T&_nc_oc=AdoNyMqXBX6UUpd3nkOaOhGAULw9IK0yI2bi_9MDSVF3X_I0UPABmcjD9EVqgdnp5pk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHP-nGwlWEnHPi0UDGg2rqWV60sbA_Pal9UNjELI_Rog&oe=6AFF163D"}, {"file_name": "Screenshot4.png", "id": "615936303418693", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974457_615936306752026_1145098500816248758_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08qwywgUpEEQ7kNvwFhh8i3&_nc_oc=Adpr_CAqOD3gCPBkAKa1VVlvj8Nc1UEz_LVL5vYNDB6Xw9fF_9Mx-IWyBey7eCyTkyI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaK3jFY-xqA8JUmDoQY0N4cNZSo0foR1dfWbhVTqgnvw&oe=6AFF3035"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "461601282560023", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031402_461601285893356_7581554104634840885_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UowMzR8gMoQQ7kNvwE3DQBa&_nc_oc=AdoOXf17H1Ejl6XZrRQJ07Sw65PHLRHy5ECSn-o8bUxhyDYZOdR78xx2Kk5Dqke6XF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEM2ENId2WQDk4kgFu1VosPXp1Vexbm8WQOTd8Cjva-Q&oe=6AFF105C"}, "display_name": "3D scan of a forest", "keywords": [], "long_description": "Move like a pedestrian in a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a forest, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 800 meters in a forest."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "988384362558220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75250458_751923672547617_638713737026394932_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd4826BoY4UQ7kNvwERHUU-&_nc_oc=AdqGhprLxN0S38XBsq15CyChkpKmMWXk3K_vOg16gQ7Zldm0PSINXDnCtJNQ-U_Cm8c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrkdHIBkGRqmUc-B_1uE63e2KxUsWW5hClai2oAZ1BTw&oe=6AFF0FEA"}, "is_concept": false, "is_test": false, "is
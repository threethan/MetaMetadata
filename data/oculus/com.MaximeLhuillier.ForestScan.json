/t64.5771-25/75367595_614808336690914_8709922739410994730_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ-D7s6HlzoQ7kNvwE1eMak&_nc_oc=Adn1FtEQayDLVDVZRMsBkdPW_g2UYkexynT51rqMvaksueQ9nWWbA-urNhzj7HLiJLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuE2sJ35sltK8jqDM2O67LuvctKGcgSTI4ZTF54bpshMg&oe=69A43135"}, {"file_name": "Screenshot2.png", "id": "830107978355425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75314846_830107981688758_708232131660660581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebZzY5zkIJsQ7kNvwHNKyNe&_nc_oc=AdmZY12uUTj6rnVPlMJmkxE7GFQ2Jw7szAy9xB1tDIGJrbpslJht_V5qeJWP3iik9oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv5xzjz-Tx0AteerWhr1AhZ_G3VrMUYLv_ZYRMMnL3LTA&oe=69A44D86"}, {"file_name": "Screenshot3.png", "id": "363846782482585", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_363846785815918_4504657108639784316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J58VT2jmNWIQ7kNvwHWiG9V&_nc_oc=Adl3eVb4fAlfGvZbTD26Nt-3xeCa9tq4AN7OWWUf2X8A9L3oZnKkAghWK8JSy3gzCcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftMm-pv85PsDQqTAjK0FhVL7YskT89MTFzejO_C96atNw&oe=69A4237D"}, {"file_name": "Screenshot4.png", "id": "615936303418693", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974457_615936306752026_1145098500816248758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKGQg_dqKVIQ7kNvwHixgFp&_nc_oc=AdnE839ZklmEBVLxJEEBGhogAvE0Fv8KNtKaIfYts80HVv4dPOKmcNOl1SbvM5_znb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftfQnBjcfkzuW1MhCBnzwP8B2ejeEDabq0rf8BeGquQew&oe=69A43D75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "461601282560023", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031402_461601285893356_7581554104634840885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRMq45lQmlAQ7kNvwGSPixW&_nc_oc=AdkpV4TyXRaiJgqtLaoMUMxnI0NfVaJk4RGspm3b39IdPEGzh18RYZEMLPlAWXBZcRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuTXRV05yWrb1Nv_HA_VrZM_yQao-rr2yOWevn0onNqXQ&oe=69A41D9C"}, "display_name": "3D scan of a forest", "keywords": [], "long_description": "Move like a pedestrian in a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a forest, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 800 meters in a forest."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
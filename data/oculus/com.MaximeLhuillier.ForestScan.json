/t64.5771-25/75367595_614808336690914_8709922739410994730_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9C3hU0BjpsQ7kNvwHsTSZ9&_nc_oc=AdlH54fdV9AePYjoNOspM2AwJcNpdZ54K3nPhOa1fxV89TXVuVdUgVmXQMnD47gGH34&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfujTubQ179VegX8j4G6LlWChjorOBKOdJUknsLiNhCrQg&oe=69A18E35"}, {"file_name": "Screenshot2.png", "id": "830107978355425", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75314846_830107981688758_708232131660660581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebZzY5zkIJsQ7kNvwH8h2S3&_nc_oc=Adnj2-fWSSCnCEKftOFovUl6c8I7y-4cawVLxUF_3CeLNbTFZdX14LQqUOMoTwxJC5U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsTdtxQFIRz3pcX6xMu707SnPIruOpTekCWOMFMzwFpjg&oe=69A1AA86"}, {"file_name": "Screenshot3.png", "id": "363846782482585", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003244_363846785815918_4504657108639784316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J58VT2jmNWIQ7kNvwEp_cyW&_nc_oc=Adnc2IJfngJtPsGXVtuz_FofFmeAStMsaGKlSJQalLWWHvgt-CIERiQDdphgIaIzHQw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftVYE2t9CFBBoi8Go4uxAg-LLKHlOvP3r_GbLbzM8mI8g&oe=69A1807D"}, {"file_name": "Screenshot4.png", "id": "615936303418693", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974457_615936306752026_1145098500816248758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Yk24ZtmaT4Q7kNvwG5P0Ze&_nc_oc=Adlfne4cxfFN07CcOSP1yQjOlceMW5jDeYk5dFcN5lLYEWCGcUBpBE657645PbPDOJM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvkbSkwUjhVZDmCqZG97DuK1CTdcgzTaXZ_3oNhHtv5gg&oe=69A19A75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "461601282560023", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031402_461601285893356_7581554104634840885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApG10UXri9kQ7kNvwEwjavn&_nc_oc=AdmxSVKi88MN0Xxn1HB5myIEHRX8m5Q_myYsjG-2_fU4erjv3lCqVLmQyxnUR0i4pmA&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfthD_YlU5aMIL8EVbuCKayZGUd5_sYAoiB3p_D411rKHQ&oe=69A17A9C"}, "display_name": "3D scan of a forest", "keywords": [], "long_description": "Move like a pedestrian in a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a forest, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 800 meters in a forest."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
/t64.5771-25/75367595_614808336690914_8709922739410994730_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2NNq4RAUJ0Q7kNvwFUjzMu&_nc_oc=Adm2kQi4q7CvNhC-9s7hnjbfYnl7qSnjm377fp8DW8SCcfV_eu8ghW-g-qSCE6hO8RU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvR7uV1T0wCEfT443sESXxj6PB9HZz93hdt7XA8fUKRYQ&oe=6999A535"}, {"file_name": "Screenshot2.png", "id": "830107978355425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75314846_830107981688758_708232131660660581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1fDqPZiqsMQ7kNvwFEYdTf&_nc_oc=AdkC9iNy-iNZcPlOsbXn3Tl5Gvm6Yt6WAQWzY-8jqbsl-WDSp4cZhYuUD1hJu91j060&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzSMJ4_m-uzebB7yoSOiev3DvQq_GTEIqv4RF92-ascA&oe=6999C186"}, {"file_name": "Screenshot3.png", "id": "363846782482585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_363846785815918_4504657108639784316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AROuKg5XrOUQ7kNvwGSp5Hp&_nc_oc=Adn3qHNb6GyFFQ-mALBhUfNwt9xtvcgnp8GqDfNUTJvKNFdcm63-pPTHf0vRZ5ySut8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftUs2fEfB1ay0nWciadY4QUeLJXYCsJmQSDdfY38RR4Wg&oe=6999977D"}, {"file_name": "Screenshot4.png", "id": "615936303418693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974457_615936306752026_1145098500816248758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6CEJsCpio4Q7kNvwGJug3v&_nc_oc=AdkpJF7QhT8binCDEiH2vYGRJHKLl1cdYNdJ6LBmpGEhSlJWlaYefO9CMPBgg6DVZ64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsVRJ98ncTTDEx3c6UbRajmz8i8DU3Tladc1lRO7Sbhog&oe=6999B175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "461601282560023", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031402_461601285893356_7581554104634840885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u40AfCXkt5EQ7kNvwHMd3BN&_nc_oc=AdlUcFD6od7zq1fMqU77J4bRslYV_2oeJs-rurTXMn2aZe4lAAIQK1f5aJj42XezhgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuZbpW_DQlT57NQRvWhoEM4J__5D_I9H7mT5i2bNmNYjA&oe=6999919C"}, "display_name": "3D scan of a forest", "keywords": [], "long_description": "Move like a pedestrian in a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a forest, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 800 meters in a forest."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_
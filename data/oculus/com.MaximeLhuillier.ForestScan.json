69F210A1"}, {"file_name": "Screenshot1.png", "id": "614808333357581", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75367595_614808336690914_8709922739410994730_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A610Mo-iHkEQ7kNvwE9feig&_nc_oc=Adp7isuKgfTAyJ6nBGWzG6OL7JN9UcVVMaudmaVOxPufnU3r3d4If6Sx9EujpGL_C94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KYDWm7FcJsZ_s049TaAXFyKuDy4UTl5ShRXw5uKwZuQ&oe=69F1F9B5"}, {"file_name": "Screenshot2.png", "id": "830107978355425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75314846_830107981688758_708232131660660581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPsQO8smKhAQ7kNvwEg2MXk&_nc_oc=AdpBgcVJE_dxqdezwihJWzFObzxPLdsqh_q2OdlED86isFI5VGBjfaJEyI9lm3HqFKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2jqzRJd21l3uPDdT7Ced3JJwjoEWx_7Hq3a4-TrwfI5g&oe=69F21606"}, {"file_name": "Screenshot3.png", "id": "363846782482585", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003244_363846785815918_4504657108639784316_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASLcaqzn5xIQ7kNvwEWH_J1&_nc_oc=AdrHAIdulX_K5_VK9CC1BqcQ1hj_vQ_DWIR4jh43xwhEkxXB3NiAfc56eryaB-ZKdkw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3TwEp9nGGbjKjTKTuTxq-Y-k1S_MXKJ3TxPT0MJ9nKIQ&oe=69F1EBFD"}, {"file_name": "Screenshot4.png", "id": "615936303418693", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974457_615936306752026_1145098500816248758_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duWwaEOEHMkQ7kNvwG5fM2U&_nc_oc=Adpd2KcbH9rgzVvbUFyx_syAr895Cje8aaINUI6umomw1t980sT1DdxVBXQWknihPnY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2n8fbv9UBBoWw3Xz3lrSSWOt9KP6kCNGgI_1nnDSLXaw&oe=69F205F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "461601282560023", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031402_461601285893356_7581554104634840885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6Hipf1iQrwQ7kNvwFvEP39&_nc_oc=AdrRIOKzADSp7vA1MLNqOPAGXYBLaBezw7sk2kKo9rf6P5hzbrluJk2traRgxSWMNdE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JiPgkT-9mxP0_s_NJuGy8BR9tGv8dTU7li_4wvP8IKg&oe=69F1E61C"}, "display_name": "3D scan of a forest", "keywords": [], "long_description": "Move like a pedestrian in a forest, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 800m long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a forest, which was computed by photogrammetry from two 2496x2496 videos taken by a helmet-held camera (Garmin Virb 360) and by walking about 800 meters in a forest."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}],
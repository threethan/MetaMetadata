.com/v/t64.5771-25/491822802_1242084467544594_4675062272293375769_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLe-QJWWVEwQ7kNvwGoGt_N&_nc_oc=AdotRfeLx8nZQCL56Cv44ze51Ss-cCaBRSmrCTndXhO9NitFoHz-Y7D1Lu8mfYv7brI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbWMhRn4mGvtCq2oIXx1BDhszClzfRB2HhhpUsxM1DJw&oe=6B099C01"}, "display_name": "VR Speed Color Boxing", "keywords": [], "long_description": "Welcome to the ultimate color-punching boxing game \u2013 where your reflexes and color-matching skills are put to the test! Colorful balls come flying toward you, and your mission is to punch them with the correct color before they reach you.\n\nSimple to play, but highly addictive \u2013 this game challenges your focus, reaction speed, and hand-eye coordination. As you level up, the speed increases and the color combinations get trickier. Do you have what it takes to become the master of color boxing?", "short_description": "Color-punching boxing action! Punch the incoming balls by matching their colors before they hit you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/3f25982a-7b6e-4386-bc5b-78550e1d9f41", "developer_terms_of_service_url": null, "publisher_name": "SHTechcom", "support_website_url": null, "website_url": "https://sites.google.com/view/vrspeedcolorboxing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_in
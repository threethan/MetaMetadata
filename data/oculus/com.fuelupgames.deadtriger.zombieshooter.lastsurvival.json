4", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304131_908697868232487_1139469662422733713_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rocv4jtUf04Q7kNvwGrTXUL&_nc_oc=Adrlys8t8he2gpxCXNeCGcjTrHIWr6N2ocaKQYhjthC9-3huDJvcbxAXfUtaEd_MwZs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmxM4609t2oIe46BNqq1fJwYA_zBc9pmXGdCPn7yvaAA&oe=6AA155E3"}, {"file_name": "Zombi Screenshoot (4).png", "id": "1455174076223433", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822467_1455174082890099_8152782557589599963_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMUTbknro4wQ7kNvwHYsnSZ&_nc_oc=Adp3Uyrifwjd7avSDEDcrVmxVOt9KK74NdyftUlfCLpfM1sw1_3H8C72ieWStg9TU-E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8Y92Cffx-rrHxnTcYCRYuRNtM6-Yv9VFJBHnCgCgIsw&oe=6AA157A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dead Triger Zombie Shooter Last Survival", "keywords": ["ZombieShooter", "SurvivalGame", "ActionShooter", "HorrorGame", "Apocalypse"], "long_description": "Step into a world overrun by the undead in Dead Triger Zombie Shooter Last Survival! Face relentless hordes of zombies in this action-packed survival shooter, where every shot counts and every decision could be your last.\n\ud83d\udd2b Intense Zombie Shooting Action \u2013 Arm yourself with powerful weapons and fight through waves of terrifying zombies.\n \ud83c\udfc3 Survive the Apocalypse \u2013 Explore post-apocalyptic environments, scavenge for supplies, and stay alive against the undead.\n \ud83c\udfaf Upgrade and Customize \u2013 Improve your arsenal, unlock new skills, and become the ultimate zombie hunter.\n \ud83d\udc80 Thrilling Challenges \u2013 From fast zombies to massive bosses, every level will test your shooting and survival skills.\nDo you have what it takes to survive? Enter the world of Dead Triger Zombie Shooter Last Survival and prove your skills in the ultimate fight for life.", "short_description": "Fight hordes of zombies and survive the apocalypse in Dead Triger Zombie Shooter Last Survival!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fuelup-games-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "FuelUp Games", "support_website_url": null, "website_url": "https://sites.google.com/view/fuelup-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34144383835206952"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303788_1689730342192978_1975316235682959617_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNlgaaUdxccQ7kNvwFTqk2R&_nc_oc=Adr_Gi2R8aKD3iCv08XHkVEcvlmAtnayFoW05yEmQeAcwGeJIbAYuY9djBgXrKZh9QY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0AkxQuhXWswjA2KbjUgqy0c_da8_5s3Df0eOgUQr2RA&oe=6AA14A03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dead Triger Zombie Shooter Last Survival", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1771688400, "lastRevision": {"nodes": [{"id": "33695703086741698", "release_type": "SCHEDULED", "administration_status": "APPROVED", "
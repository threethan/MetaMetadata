6AA3F73D"}, {"file_name": "01-shaping.png", "id": "1354405553539603", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TViUbL9imNIQ7kNvwEFlwKW&_nc_oc=Adrx_HQfWI5bf_GOzWt8tTjZNTvK1Qs44VMDvznlzHNesC6Vt6GmofBI4lif2AIbkd0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNyuyxkXyuqxU2kRiY2YmyllJXgwIy4VXnQELONlD3bA&oe=6AA419EB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jimTD5i44K8Q7kNvwF6IIP-&_nc_oc=AdoM1G2jXxZZk7GR194VRlQCUfa-fyJQzBx8PuzfDSammIwDLcSLOT4ggMNrXD-9psY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcnu2MK47XL7saShhCVc8nVQvXSaZ0sVDopV5KpxGjnQ&oe=6AA424D1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9df19ClR18Q7kNvwE0QEMJ&_nc_oc=AdoY8UWx_sOV0GuyWzy5c1UBpy_28DwKB3lJBE9poGC3IPaBqQpreDaQh0g7FPySukM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGVGlo2Sxe6KftWJot2NeIvK3rlil_bKOMx0g1MEGkjg&oe=6AA3FF17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF8LDvBh-rwQ7kNvwEUvniH&_nc_oc=AdqwxlyFTv71A0z20074F7LYWxc_L5ip9dqJgSvdtigvcaumq-dLZaKEaOXdyWkKL28&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt2xvwcrknphn8hflZ16xyUEGRU_2upLJY8pQ-OooM1A&oe=6AA41BC8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNDw0Q4nL4sQ7kNvwGk81Ru&_nc_oc=AdpKZnQqkDS38Xtz1mVqmbiwthWJiEBgEM1zpXUgwcUMXz8yI3obetTvpaQYU2BNzN0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ9Ya71-y4O7AZbjObHqxXTQUeqC-0wQZ-j6wDRwrHgw&oe=6AA40B54"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp4wD-QVUssQ7kNvwGDPhTF&_nc_oc=Ado4XUDurgLezm9ha80FLRKqyEKPgIWkDwWKj01XShV0BIPSqUpbiC91xxnJJzebmQ4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI
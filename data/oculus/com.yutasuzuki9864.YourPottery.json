6-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSWn0oy3mxMQ7kNvwHi8VKL&_nc_oc=AdpgpaElM0PYwOLk25VGsuvZGb2W2P9wki2NtkppP-paPzaAFOFV6wnDN3MjyB0gC14&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyu_lKnq3rMCui89wAo1IWI-BWZPxRP6mTWQIKgr-R8g&oe=6A8EC9AB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX8o-3LfaNgQ7kNvwF9T1jW&_nc_oc=Adoh78kZ4-Uoo5HoIxSNTvkN0xW_h2dZAGxCCabnZzk6j0966Gidm5YLeMv2pu7IySE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF89bmKzEkjwti7PtrLx-38ovw4nmTih9K-pSdLsIZRvA&oe=6A8ED491"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV7SO1B_FVkQ7kNvwFtsqpx&_nc_oc=AdpaqNCI9p35WR0X3Bo5N5qC2nVYW4mwXUBE696wdj2LQSzH5kMYXOgXgzM6YqmheFA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl5q5HCTF7WDSjE4gEUtEy-RE0oJyjiB56smTRaX4nsQ&oe=6A8EE717"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-endcard.png", "id": "1368527337994875", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619672_1368527341328208_5619816149097200429_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsdO5v68u8QQ7kNvwGgoGYs&_nc_oc=Ado707cWoTEt21wQNmj6_y-G4VujG52ylpSYtpx9UxBCEPepiSmw2ZOBh1Cb76N9aqk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgPkSaSzqPL_GVhQZxLwMBMwzRTcp0XhF8DTorCYWrWQ&oe=6A8EDC96"}, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}]}, "developer_name": "yutasuzuki9864", "developer_privacy_policy_url": "https://yourpottery.yutasuzuki9864.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "yutasuzuki9864", "support_website_url": null, "website_url": "https://yourpottery.yutasuzuki9864.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235230383011274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499307303_1070704728767447_22737736237157980
6AAE833D"}, {"file_name": "01-shaping.png", "id": "1354405553539603", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIB9wFhsVPcQ7kNvwEEZiEt&_nc_oc=AdpkrId9DTjNft3i3Ku7a5WNYHdSxh0ZDrYAMoDcUO6sFyTh20QBPW3mdkjMTfiRbis&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaB9iwUWD8BKWze5L3cc_PygeTwHcYR9scF9jvIjDV5g&oe=6AAEA5EB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b6bxmDZjvoQ7kNvwF8tmcZ&_nc_oc=Adpmkx-1fIVldhqyLDgrll7kY9wAcsnKd3XTGx9-JWtetk8joVjQq6KO3gGW5zYV22w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInEbfmJb0JQR0-GDPTz5l8YJ-QDpnwQcmmfyHVY_eB0A&oe=6AAEB0D1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyZaiJCloAcQ7kNvwFVnKJz&_nc_oc=Adron_FFVJJk2Lky3kg_nviie1yFwaE7v-oh7G2zCmoXqSV287MoYABVEAMjuntSjS4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMhjThUfJfQdyaNCeyjvYOBITOuj9baEuTXOR4Lxukng&oe=6AAE8B17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fyya7IN_VtsQ7kNvwF_itm6&_nc_oc=Adrv3SA8ajmhtl3aU5pc06cR2nkiW4NQjenF-Swfuc4KOH4NLWVFGxHtmq7xbPC9jF8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbssQgJwKQMzEt-WWMqklKgjwQ9Aztl9yGK3lP878Bjw&oe=6AAEA7C8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMDrLdQfiwQQ7kNvwHwGoYs&_nc_oc=Adp3pFaxOLwUpj8sUGgE1ROQyDobVUKI9m8YPWWmzpG4Cf02Cdotr723icsNaPsSi9A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLNDVeXzAIrGB8ZOXhJy1OTQuvHaQB-vW7hkrZQJONng&oe=6AAE9754"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcLqiP81pD0Q7kNvwFcHwLG&_nc_oc=Adp0okMUJOGW-8SBdu7vXUnUb2iz2PkPdsrimY40nEtrSDXDnIMYJlm1IqwRbxNw30Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI
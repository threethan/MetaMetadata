shaping.png", "id": "1354405553539603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZVU3hCT_K8Q7kNvwEbBpra&_nc_oc=Adr5T8CZz-oFHSgKP6oZ-TFjlkI-m2hDNPokCKfgOVDg8AQCs8RO6kexc1nIrTfWGSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcLKR0L2g59Gz3lyPn_B5TGKvw3X0dGZBpdZSsJx2NTg&oe=6AB931EB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dna7VLLm9scQ7kNvwFq9Msc&_nc_oc=AdrCnl5eW1ccvboZbJ_L0xeW2cT69xevlE0jAxOewy9W5NF1yNIu-7_qcGePpScFYMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGz13n584CkhakO1Jcn_f7wI7UQYQyVTKstEbCArY27g&oe=6AB93CD1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIVHbBxwFmMQ7kNvwFema0i&_nc_oc=Adq5fO169RxSOeKSgie3Ux1CQd9ZHbpz4bJlaxq_IuvvBjOMwJ3kab0AGCmgBVpKS04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-6Ty0KwjEtyXvkUzeaECUiQsCRRR8CBi0hndS5nvjgQ&oe=6AB91717"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT6gca67QQsQ7kNvwFcRs-g&_nc_oc=AdqWURwoHeIXRa1pi204Im4qS7LPdsMmjLsIz9N5Q3atejEVfobXboObL0_LI27WEEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMgo_xmFPo9M1t_WATsTo09N_NSrcNF4Dl25zkj0qt2w&oe=6AB933C8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gap8N2w_l9YQ7kNvwFfA1F-&_nc_oc=AdqyBx-ZyjRJ0Q6F7jiukz6sD9MfjqDH4buGI6Tx9yNpjDKaau3PfSylFPxgyoRKe4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOquu6VtgZ3iM1DNsaytodO6Otyf1xQNL18XGvJ0UXHw&oe=6AB92354"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2lQMJEoL_4Q7kNvwG8AJeb&_nc_oc=AdoDwuWhVg3uC3GKRMiFnu9Twh18vG1SBrLrkDvfY5tZlDjyV4gL1XWwS3AwhcHdOkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfw_s0uh7JeJDGkZkcApAo_iqRhQjF05fy-H1
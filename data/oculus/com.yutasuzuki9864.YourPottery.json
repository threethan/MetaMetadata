shaping.png", "id": "1354405553539603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyaEqmQ72igQ7kNvwGW9Ghb&_nc_oc=AdpXqYs28PubPeRgpEsfENHvbONT3u9gYC1KizdVBInNlAnNfazwX3i7_skGjtN5Djw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjRxt2mZgqesrenCzxOUqsjOTWy42beurpqhk1OiMlKg&oe=6AC11AEB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LEW5C0iK18Q7kNvwExxXMS&_nc_oc=Adp2CTHypldHpOgMBVh3Itfrr9PgxjCzTq5nVkcz_I9AZ6vtT8W6KQh5ajuj7dH5ilk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiQ6zqiu4eI7BAaJ_DatZijFKePmhbDOlq8EEEACP8lw&oe=6AC125D1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUHIfwCMb-UQ7kNvwGOVeKw&_nc_oc=AdoBinRzxhMWFhxTLh2n2a0oE4ZvvfdZW7r8phQ7ThfCfJvVMhnjV_Br-6x-dWv3QmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm0C7aXr5ra8e_f21twlAc2aCHlxfg_bsT6fZTjUnM5g&oe=6AC10017"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAQrMWpV-owQ7kNvwFvjEyB&_nc_oc=Adq-8ehzAccgLGEN7JOmgFlL6YJg_AUnTxYgXnjU8WHU5Kf9bqm8RyWktYaQMh7FTlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf0TdhvtT7drUZaJk5au9wuEsNbY90wO2ogo1fTdCqeA&oe=6AC11CC8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJzq6ehZ9tAQ7kNvwE5AhXb&_nc_oc=AdotKlMcRcbrSLDGpfNYgrz81-8hHgDqODDAQKAZkiFbLs1NIzp9iyqAG5lhw82naaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc35tfql4LE3x9U1L2DBh9OmV9doIkFSLq3VqxfBGBCQ&oe=6AC10C54"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCd2gFQYfM8Q7kNvwFrWQg-&_nc_oc=AdqtiPNpIcUntn6X7dIQpy9gp9FwPVIWl2KvJTytIVTVZGJ4wBESrCZZEhERTu1j5hY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfVSX_9_TPIcfak-w4HfLd6c8KJv2k2ROxMwT
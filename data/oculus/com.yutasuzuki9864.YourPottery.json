shaping.png", "id": "1354405553539603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzpPyOHN14IQ7kNvwGijT1V&_nc_oc=AdoSQ1cPXlrQlx3xvfpt2cv-K3_c2OrQH8HiOIqwB2qqW0yf1-6oZt6bdlqMEEoXOlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdOBtkcD6EHI1sN0s2aUlXvIH6QXtlR6Hct0LPJYDd5Q&oe=6ACA556B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_-lEo_GPdEQ7kNvwGUzBKR&_nc_oc=AdpdMFCHK3kvtdFsmlR2OehAksqu1wmTpmi2JflJMhpzKzZ0yVNu-mKPi9MFHkeiqgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNelGjTbqmFkKG9FuDfjD8qpNhyG13pumWV7quVv5KZ-g&oe=6ACA6051"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VrtTLzXVJcQ7kNvwEJBeub&_nc_oc=AdobMdMvbtyBfBE03CNPJLneJp4lMh6Yil0owAQZoWB0mYofAcLtrX6JQUHjJLdd7EA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRzVlC5FKe2i9jdL21Q8IhtCfeOVupxWgfJND9-QEdaw&oe=6ACA72D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HYN8awE5TsQ7kNvwHJUjBd&_nc_oc=AdpWAaSX-2bdrLfl6nBYF72mFtbTCdsUzJxzqIDQZ9-Q35JoFtN539fmGWcmdiJVvmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTLKvf8-amKpOVHpMSt6IAkdIJsJIisjByv0YnkVqvbQ&oe=6ACA5748"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_tLEKCmbFUQ7kNvwFGS5Kz&_nc_oc=AdoUmX9bSBcjV-sVsAbirPLtMhBOCPw40GkTOJCzFjeOXUtAMkXyU4G7y9pfTKn-3pM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNreGpcsWe3vCeDj00Ed7jgcfqSYjtZXUtzPFiTWYdy9w&oe=6ACA46D4"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJbOqAow6WkQ7kNvwEA7CNC&_nc_oc=AdqePG6IeGV1VJ9FHzkqBe0EBAn1G2bGGfkoS1u1bipdck0mFASIOQZxO1Oa1qaqNmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnWHEZfkW_1JFRQ9GymBYCRO1z5RfC8s90cNZ
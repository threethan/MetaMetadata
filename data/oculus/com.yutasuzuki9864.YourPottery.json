pwIGeM2RYg&oe=6A8EDF3D"}, {"file_name": "01-shaping.png", "id": "1354405553539603", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSWn0oy3mxMQ7kNvwHi8VKL&_nc_oc=AdpgpaElM0PYwOLk25VGsuvZGb2W2P9wki2NtkppP-paPzaAFOFV6wnDN3MjyB0gC14&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyu_lKnq3rMCui89wAo1IWI-BWZPxRP6mTWQIKgr-R8g&oe=6A8EC9AB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX8o-3LfaNgQ7kNvwF9T1jW&_nc_oc=Adoh78kZ4-Uoo5HoIxSNTvkN0xW_h2dZAGxCCabnZzk6j0966Gidm5YLeMv2pu7IySE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF89bmKzEkjwti7PtrLx-38ovw4nmTih9K-pSdLsIZRvA&oe=6A8ED491"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xV7SO1B_FVkQ7kNvwFtsqpx&_nc_oc=AdpaqNCI9p35WR0X3Bo5N5qC2nVYW4mwXUBE696wdj2LQSzH5kMYXOgXgzM6YqmheFA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl5q5HCTF7WDSjE4gEUtEy-RE0oJyjiB56smTRaX4nsQ&oe=6A8EE717"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DAtEnNTZWoQ7kNvwH_39Y9&_nc_oc=AdotrsjxmcyZXIdkKwI68c92wPxxIyyd935kgckAMSlHoOv3DMK45TzaczfFiehG9S0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFlIr_bLms7JsZT5xugfLsin5gMfdawDL3hFNdL8TUYQ&oe=6A8ECB88"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YejSG1OAiA8Q7kNvwEYhEea&_nc_oc=AdqMqLIm6HTcpNZHIyPkpjUmzvBO7LjFu3cSvsoqVwWH9y4zJo0s6tYxJk1H2TtsTdU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF61_LC6nr9IaL4Fpwx7t8TpTUqxWFeiQBg3QmXCkvwNw&oe=6A8EF354"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqvtaH3P4WgQ7kNvwEUZdok&_nc_oc=AdohNVsCLJMyRb1TcMTWLHU_37xQ0E0zUu7Nu6ynKkZOAPxg088bwHrZZVVwPzJMBPc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f2
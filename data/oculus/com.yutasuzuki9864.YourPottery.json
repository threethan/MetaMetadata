shaping.png", "id": "1354405553539603", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SwEhEkzD5kQ7kNvwFRuNXR&_nc_oc=AdovRgajy4OIa-VJwJ-p5sNHdVeaqLX4_UfVqqQ6d6zjCVar5eRpFf_vrzc4NwWerUQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxCo_CuZCr9kSyBA-LP830BWUMJEg24g6JExKov9azYQ&oe=6AF9CB6B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKxGkVrInOUQ7kNvwFDAfgm&_nc_oc=AdoUt9RgDafTN4xjvAs_Oz1TeBiRXchrCjuSO53AcJCSBndMJyLA295VBWsR515PqsI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoo7rrUfzFCVWAGYQczHbf0jzsJPmbZSR4o6hcuIqtLQ&oe=6AF9D651"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h8Jmk_7R0YQ7kNvwGYRuM3&_nc_oc=Adrq3D55pqvOtgbBW_1eaaid1vpQUQyAeu5vctuKz3yEzAVXLgxgX-iu45nSq73xoD4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBkDTEIlGGyd4oRiAEvkHOPS3QCzSB055Wioh-zK6JjQ&oe=6AF9E8D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbCp6qY36eMQ7kNvwGS_CL3&_nc_oc=Adqu-gnUNw6qbWZMqWUv8xKVde8TfN0YF8JY8M0chAj2HO3mCjOFIF9ZC6HLIh6TQX0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNo0-Vp84PLC1ALM3SXC-7fIPF7ZxryVFSgEltYF-AYw&oe=6AF9CD48"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ncO4Ya3LhcQ7kNvwGjzDkz&_nc_oc=AdqDGvFPz0-QOQGCBcYwIJo-9Bs-fgBftzNofXrOkHtSpLcJjfAg1jsGjwYXsAgnKCI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOtnZK4ZOsrvZ629Io7A8lgmU8imjR6zj0EYFjaSU5CA&oe=6AF9BCD4"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7WPVWlJ5JgQ7kNvwGOdiWU&_nc_oc=Adq3AjeLjoI07u5TLFpOrz5o_YdzqfQoF1SGeM2pZuUKZ_UWm1Ipqh1HyWnfiPnw8pk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9jzemUg1COc1ylaYD4_rAITjVwJsjm7WPxvy
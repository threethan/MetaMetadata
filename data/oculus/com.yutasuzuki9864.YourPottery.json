shaping.png", "id": "1354405553539603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJBdCtbdjE8Q7kNvwERtNJK&_nc_oc=Adr7-dwmH_5WTCGw5L0ks-iUtKUC9621CFHUxd013Mr9_-dT63gihGagzImKMLbA_sA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2cvoNnuxmgfp_5hmUu2-OC1mXJjAN9LyA5h-IpAot5w&oe=6AA6BCEB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jimTD5i44K8Q7kNvwEE2pGD&_nc_oc=Adqse2rxBnSfMPvwMe4bTB3YQKs5lkw_rFiSjidqDsNu-q5fGgBlwsm3HxIyepSkDWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq-pkTMpLAljmKoSgMfwpWelkRhB354oRVArLOmdoupw&oe=6AA6C7D1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMcpFZ5tOTAQ7kNvwFQet9F&_nc_oc=Ado11f8JXu97rGwNmF1J5hhMIf-IPKPnZNgXwCgfvt1dDMxy_lTdTQihpxw5JuDYmrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFLlH53MSFlJtVaipJtGAFfn_NnW5ZsIp5ihjCYOSsfw&oe=6AA6A217"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLtzLQkXL2cQ7kNvwF_4p3a&_nc_oc=Adolr9V-E3yCwvGLpWpankKM6g4IPb7zfQzee6PrB53mxpKZaGsTdm3Ho4o030RfYkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkhqlfSoi26OT5jFKXfxGrHe7XH5DJG8KTahWfuv_0pQ&oe=6AA6BEC8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNDw0Q4nL4sQ7kNvwG-Ufwz&_nc_oc=Adph8_uO3qIBNFnHDvID1Q2gZTszhLpiJIxL2JtiR8nxuPB2ebt5jwJTIpQ4A2D1mLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjXwq7IlnYDyE0ScXhGJC43sm6-gPkDX6IBe34LbtoUQ&oe=6AA6AE54"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp4wD-QVUssQ7kNvwFXt5Qq&_nc_oc=AdoYiEYO2S_5Y3XPrJBKaEGH_Sb51ArnWl458xVnWk4DtNxuyHtpvlDOkZmNel4lI-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIICNu90oy1SWG9dpg36fg1fShP2zbcjrv_sH3
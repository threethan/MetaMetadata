shaping.png", "id": "1354405553539603", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es7POeQieGAQ7kNvwGU3FBe&_nc_oc=AdopUbNGitbi6tG2vQkiTJGe1dw0OhMrfyoYt1l6t8wTgkHtVseZU1dYoPbQn_Z9klA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI93_8yUBPpP1K0gw1VdlC10MPU49Gg7G6_AfA8RLChQ&oe=6AC7B26B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_-lEo_GPdEQ7kNvwH2O0Yp&_nc_oc=AdrTn9O43_m1yc4zLqiWl4e6_g7E09Wi_MX7EKcAGap6fKFTmDkA4QlI0-WYS3oVhHg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN13jgsQ37TYsFMNkVGhXiNRo30qYhkjAohkP-NlGMmZQ&oe=6AC7BD51"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3OYuY98PykQ7kNvwHcdiUK&_nc_oc=Adpnh-BX9BQ7LdaOBBSbjxDt_zmELvt4DZ4EBa5ihQLoyQSWqakxVjiOplaCjoDg__0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVHSyIk9ZQZRtmiFLzfrJwZU4mfc9e1K0RE3J_Ws4Bdw&oe=6AC79797"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5C-hkN-kYkQ7kNvwHoRdZx&_nc_oc=AdpWGOG3FEjI4ljie8vHvFiXvUVwl1ELS_QSEvFgVlrrz_cXI3-7sR87gVe954t5y5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMefjtiGE9vqxtk3g7uNEQ9q5u24hyt6ukFGZrN1QFeww&oe=6AC7B448"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_tLEKCmbFUQ7kNvwGVamXy&_nc_oc=AdqZFOVXyqIT564H5bg_lNFXsBEX123HMeyWA0tpPwd-K509pruK5kCUJ_IIEmAHQuQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw5QgTzY6nklhcTMhJxsIdcguKUC2j2CCix5w9XnwWTA&oe=6AC7A3D4"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJbOqAow6WkQ7kNvwEvFGM7&_nc_oc=Adq2dsAyn4jh_s5MqMBu3HJocBvmnbOAAapfRk0n_GrENcT05Zd6FjrZZuud8kHA_8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzKun-_PTeWhCtf4VlmWFMe7ZRhylAtm2WhJ8
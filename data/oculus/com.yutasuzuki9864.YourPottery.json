shaping.png", "id": "1354405553539603", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB4rL9GncOgQ7kNvwGi6816&_nc_oc=Adpr1z_0L5vbTaQmBivlfHun-CQD5aJwEEbc4I3y9qV9vQjrRBcL9FOwp1DSZWvqArA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIKWUZmQIXpU-mF4kI4Par16drJ5sIGBn8JwdLVnp2iw&oe=6ACE49EB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyXnciC9k0sQ7kNvwGZtqVy&_nc_oc=AdrHRcZjMhhSaGWHuM0S2TAf2XFad46lyJusvDttBLzYJeAdL8lBGjETRLa3yV8K8-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFDbLr9ereQd9cqQ_M63tR2q27n7r2zbfLp73yXEALdA&oe=6ACE54D1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJpUo7tAZgIQ7kNvwG8ryNl&_nc_oc=Adp88Selyrt_LuQNTTnoyy5U0juV6YcDs5OzBg0DrF0R4UAOrFPuZNAWVWS_Grqsrow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7cEl5oy3vcBeZc6STouwpRrSkRZF6DwYAE9kGc3nGag&oe=6ACE6757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbO37CUYYgMQ7kNvwH_u6hA&_nc_oc=Ado-jNzVB3_8G3e758SXPvfMvYQ7VzDFQySAlr1tdHP98tttAcIdDPzT6fsqHVy2JK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFWqu0mxBUCYbpWeABsGL2gSDDF4Mayqr8WjdZ8oFhnQ&oe=6ACE4BC8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjCMwd5udkcQ7kNvwH70n3D&_nc_oc=Adou9vutbEkUhufrvWlOEs29OjcnibN5fADtTGGXeVka88RSzpXuDqTNRafxUr8gc44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPirzn4xCeVccnMMjzLmhWAqk5aFL0OIi74WFqlcrQyRA&oe=6ACE3B54"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idUj_mzusYIQ7kNvwFFyJ9j&_nc_oc=AdqazSb6lttQjMhdLNgIV7E53S_o5FF1wkJz_BKtNHJ7shlRXmYnCx4Ir2tF1S5VsIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLucX7gFxoP2rguWpMU9a4x8lEBBLREqXGcqT
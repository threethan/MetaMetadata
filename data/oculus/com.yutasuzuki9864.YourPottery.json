71-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YCCdq2nzRwQ7kNvwFYH059&_nc_oc=AdowMqNcEmyG-VTZ2r3aO3e-nZso7PeqIQ_UwqaYmBiMqB2aF8JGH6mBRUHs1QBkBH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN0DQRzcQUTCnJtyff3dEI4UfiCX0ro-KOYV-8RErPuQ&oe=6AD23E6B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynWrtR19piAQ7kNvwEZxMwS&_nc_oc=AdqsaWJEXaPxkjhfADC0meDBsNTBz4tOXEU598Lu0CdA76AGmxwIxpTbxOLo66i6AOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVjWge9QyrP6iB18Gin9SB7Y1zW-01grhHZBDUtl0n1w&oe=6AD24951"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewir_XJrIzIQ7kNvwHT6Yx8&_nc_oc=AdrKvluDvaic6If1rH9f1BtvnVygn0jviYqxTagnz-vDdR4ZisVOnusYiGu7wgfk3HU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2-sfTFD6HGPCc5cp-vM84jPhD7WgtzKHS9sxdcWfMqQ&oe=6AD25BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-endcard.png", "id": "1368527337994875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619672_1368527341328208_5619816149097200429_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsUDNI0td10Q7kNvwHFy6hV&_nc_oc=Ado6wk4IU9h62fm_5VhecljwkgxhHl66uRalpu94AJTi4vfoScU_3FTG8_5xhxpgW5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj8Qfi_V5aN5V--uJjaHJsdZh5w_pHH_RpomkZVvF0Rg&oe=6AD25156"}, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}]}, "developer_name": "yutasuzuki9864", "developer_privacy_policy_url": "https://yourpottery.yutasuzuki9864.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "yutasuzuki9864", "support_website_url": null, "website_url": "https://yourpottery.yutasuzuki9864.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235230383011274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307303_1070704728767447_2273773623715798098_n.png?stp=dst-png_s360x360&
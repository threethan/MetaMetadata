71-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ9H6He1HQYQ7kNvwGr4I5A&_nc_oc=AdqpwPXXuvg5pZQ_MSU8M13Vk_YOu4A6Y6dlLgkDx_s_4Mugau2wwD8rxRX0QgrqqNY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHICFarSSVDwr8_0bUd7v5jZXcTs_47W-fTHoYNWeFGOw&oe=6A97232B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJgRQU1NSL8Q7kNvwEVZ6JR&_nc_oc=AdoOwLbWAH7sSjNMkZMzIIg2nWyU18A5Yjjir15diqKutT4IMY78ygg0g40Ui4dUyhU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfM0rwGSCM6OZx4MgV_Ju_l0VDLeK_5ABHmn1Z4hIfJQ&oe=6A972E11"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0SDi7VMICQQ7kNvwGCxR_d&_nc_oc=Adpt239dHg7tzVaqWPd83UGWKK9-A588wBi8FpqABdco6wNbHM_53MrzpmWyl-htJ7Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiLodfmOFmeVL6Q7Qmfhlv4CVgMl3kQnz-zoiMmH1S-Q&oe=6A974097"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-endcard.png", "id": "1368527337994875", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619672_1368527341328208_5619816149097200429_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JoXyhnZ6B0Q7kNvwEx7VkC&_nc_oc=AdqDKjXC01toKRamS7XoDMRbqStCwAYfbgOwCrv4HGN6pdY1G3Zrb3dog7oIaIntjjQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHMP4nacukBybVO__yd9dYBYhwej-QYXoIqZU5RVFu-Q&oe=6A973616"}, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}]}, "developer_name": "yutasuzuki9864", "developer_privacy_policy_url": "https://yourpottery.yutasuzuki9864.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "yutasuzuki9864", "support_website_url": null, "website_url": "https://yourpottery.yutasuzuki9864.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235230383011274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307303_1070704728767447_2273773623715798098_n.png?stp=dst-png_s360x360&
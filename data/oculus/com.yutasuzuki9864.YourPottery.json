shaping.png", "id": "1354405553539603", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBcW5XebaOQQ7kNvwHfhafl&_nc_oc=AdrIkHhrDbeHgl3Si6zOMhc9NhjXM52Q_iM-OgH2hOjUOHYBj7BsiHP_s28GkVE7-ow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN7XAaAqUkmvhERLLiJZ0V2YJ25Ijhu9lBdXCacGm62Q&oe=6AF5D6EB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pM57XgLvwCAQ7kNvwFWHFUr&_nc_oc=AdqHAGzilZUGQU4I3fSgkv7Qw1EiN4HZSXzY98Wpaz5K_TuAYgvPFiwKwF5ZlCGfk3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3I_jGwSQm1HCf4vTLRo1t2f6frNO_KXkCy9oy6RvnoQ&oe=6AF5E1D1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hF49RT1Qj-4Q7kNvwFWELFh&_nc_oc=AdrFB3EipzfzU1O2aLpaPUJy8ts6ZSh3ZK-5_PJbGoy2nFKQYOWoRBKuGL8fvsx605w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTarvZt6ckZS632WFeKRK_vg_wXGTH7MzrswYTR7zmyYw&oe=6AF5F457"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufK2M6HTFSEQ7kNvwFkKVGG&_nc_oc=AdonVbTaeGPjZkOiOZcyS06Zo_mn94-GFvfhAF6BdI1uSH-2oEAVEd74kFuqoaZl8qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXhKyZrW_uTpb9d6ECD9QadUX0OHBHrMi7YuT8SeHijQ&oe=6AF5D8C8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_MdMpQgBqkQ7kNvwFrQbsc&_nc_oc=AdoRRZpEcy_JMKX_DMyZ4mpSEV_RTK8ZH8NUG8eqdgHDQFtFGu3DGsynM8Ol7bD296g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2XbLZe5L9Bgep8X4Vulo-UaWiri0qPDVVrx7dMFfOhA&oe=6AF5C854"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZaTPhRLJYIQ7kNvwFSYoLv&_nc_oc=Adp11AyF-ruGKupReIbz2tb9fyF1kUJ634CAJHcFgdYokfYWiVXFOArfy_KwCI2ehlw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIsfBK7D_YQQStp-c75RxA8Xo-_O_-M1EuJyg
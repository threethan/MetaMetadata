shaping.png", "id": "1354405553539603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yossxyIwqTIQ7kNvwF-VpbU&_nc_oc=AdoOqfmquTB9TFLwIYVPofDrRXuoskaf-1iC9MOZdr7Bl4-gHDZmnbL3qkdoTn3lyec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS6Z5PcGNDFqA1bw6HiwVQhTflm5PJH7A6EFIxa6KZSg&oe=6A8983AB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLup-Twb4EgQ7kNvwGpZ5lD&_nc_oc=AdpEcpRUfSXaD-T9vGoNLdQl8D5eWnJLIlNvVOUXP8cv3iOiSd7ceADP003OPPHJW94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiDNecJ2ItaArcsNv0ILGGqMhAZBLML611JbVD7yjrBw&oe=6A898E91"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdQvLhsFwp0Q7kNvwGqrT4K&_nc_oc=AdoDrdQPRkgUStFXd3jVCQzUYQ8EULlZct74fpzxxAM83HCOnKbCxiHUkxQtofTrp5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-xFOU82rb_gz_n-L3g2s_xDZ16-F7wnDowCaY2lJmww&oe=6A89A117"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roMiUjCcFhsQ7kNvwHucc5R&_nc_oc=AdoK-V7HRH9ccaBb_jRstmPsN48i4KLor_yvD3HvAfDkp7-5GOE1Fvll1sMESw-zs90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF0xxYQI0FqUYq2GrnAWGmE8WHLLkhgDj9v9e77kRN2A&oe=6A898588"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7AHdkwAyDwQ7kNvwHtQuX6&_nc_oc=AdqabIy6cDeBxdfn0p1AgCReprRrc0qM9L0NJCBUG5oIeDxVqvDjaL-CbcGfNtqX1II&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEp08_vzIRPnXSzIRdozMtUS7NjrNePSU2OBXusZI85Lw&oe=6A897514"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0MkZy7-2sIQ7kNvwH3i4WQ&_nc_oc=AdqtfOzodWEo_Cv7fgqFY2YohmZrNRZccGzxSoTRDCUNj_84bPctSWIkCv_mS8RgBa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFadXKJRNk2jLf6_5Q1chA436imhNbqizCHUCp
shaping.png", "id": "1354405553539603", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJjvdavW3YAQ7kNvwF_neLr&_nc_oc=AdraaD1cU7W7o-U74Z3gl82kwdemV95DCFsp1BLRZ5NB5wVRMiIJDC4SNskC87F36vY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgy9SD5Q1qXR5dGSCHLpBAHofOPHBQM52n2Gv56gtZew&oe=6A8AD52B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLup-Twb4EgQ7kNvwEgShAi&_nc_oc=AdpRH7xO09R4x9FxfFyFB2Dfnfre5YNenGfjYBTknkqMr6PSTyszLT5d0ahXpo04Ia4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTvf1rQLGkqOvJLPptUdA49UP_SAVMr3tK0Md6f4f7zw&oe=6A8AE011"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OdAuFOdlbwQ7kNvwFjJ3eW&_nc_oc=AdoGbWnCD_a_BFWcGXGkCxS2_PpNdFeh8gxjvZPI8ik_SpzUv0VJ566ou9vmXkwZlnE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcIFBmArFtkF2UBOidZLbMwS90jV8EMXzLN6U77W1TXg&oe=6A8AF297"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYPHILFT4tIQ7kNvwFyQt1I&_nc_oc=Adr40MuZKanw0oOwu_hSLgZ9LTHSF6M4MIbXWCWCKDjeXwyEFkeST_Sxbtr_DeX2Wm4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV-LlbNAyNdmLrOjQVDE7QAhMgej_G3nP1-abh0Jga-w&oe=6A8AD708"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7AHdkwAyDwQ7kNvwH3c34p&_nc_oc=Adr8SvVkABwUD01xj3WmijIJCQUluvPlLNdQR2fZg-xPMWtFtLbP3eLWOKJqUqaHUlI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-ohFUTer5QBA8qZf-pqyOCO577pP-iE4wbPL7kZ9xxw&oe=6A8AC694"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0MkZy7-2sIQ7kNvwFs10hV&_nc_oc=AdpVq9nKHAuOlxLYQsJWy4t-RIiQ7Kjlpht_IopVnboH3TrCmeXjPDTTZEAEundHHAs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeV8DP0rOp8Yno7yLPEd6fCvViSplh0VwrJ6v
shaping.png", "id": "1354405553539603", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es7POeQieGAQ7kNvwFrMdvK&_nc_oc=AdpM6FlU5mWnAulBqPPw-40A8Bxjy3Sx9MZIM3IYyDvEqvP1M95NEdDpiQfAneKHZ8o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObiy1X2Hc7X-pRDibxa8lfcO2tTJYrJQjILzUGmnx9DA&oe=6AC903EB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_-lEo_GPdEQ7kNvwE7-qeu&_nc_oc=AdqW8hQkrml6xbPyKL81xuWipytyjFQqee5v35qPlBe5a2sTMplig39sMoCFuBc6nbk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsklITUZ_7WSNilCTOzprT6y9Xp0T070qFcjdzAqyIYw&oe=6AC90ED1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3OYuY98PykQ7kNvwHdTz8_&_nc_oc=AdqyFTWeCxfFVC031E5CdDOdso8-K4yF8bvtlxABPKViwhv6IBtm4qDQbH3yT3ltHGE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu_yCsIHnlYKG09tX-mxbC_gnlC-yf3R1iUbNLY8jFMg&oe=6AC8E917"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HYN8awE5TsQ7kNvwEnKCZn&_nc_oc=AdoEWTc3OJivhQoeRSPJLvcgN3b0RAtcFvvHT-bLXHnu1hmfQBhKBZt-LPNBFQFmwwk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkM6w18Duv-3M7u3v9H9PF1ExxPmH3KVZd4iyafZkR9Q&oe=6AC905C8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_tLEKCmbFUQ7kNvwHPi_G4&_nc_oc=AdozKxCLsy4h3tQvIpLszW1S1tMdDHT0s2TJWyHvFYi7khM6bB8sj4rlylHEUS6_LBI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgrkKgSbwMwHkwTlHdDOJa1TdjaBF_W99dO4qcdiRv6g&oe=6AC8F554"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJbOqAow6WkQ7kNvwFbv0ts&_nc_oc=AdrH85I09m3Mn1TdNmT_X1vFN-ZEDbVy9HfyLBHI6gxtgoEp5TwwImV_e9HMkqFk3rU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSZur0QtF1v0tijZgr4bIAhkEX6P-OzjOjye0
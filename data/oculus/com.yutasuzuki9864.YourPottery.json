shaping.png", "id": "1354405553539603", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGSiIr44O1gQ7kNvwFn8gd2&_nc_oc=Adril4x2cagJI1vq2GnqZWQP9zrGCOhGTrfdyN2jCdqgI0lqQOmdbo1x1lnYiSa8rs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNTm3I5F2ry-ciZ4lCitMuCYYQeRWOAnhnQzazDCgHyQ&oe=6ABA836B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dna7VLLm9scQ7kNvwGCSOPy&_nc_oc=Adri_iOaCWBpyNFXLDMJ2ijhMymfxJ1YdF4_GucNql_Gpx6CCKrPlmdgg-d0an41kGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXYeo8bGeqPy4vrnC9XMmY_m9skOHEx6Dsas4JT6Ck5Q&oe=6ABA8E51"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW9KJxOLR0YQ7kNvwHN9pvy&_nc_oc=AdplN-u1wV5u5POWOZYWG1yN_3taZcZuBieoZcQ6DuYRDHCD3kIELwHfNXAnEITByZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaJj3DL41EICngEe9cyFvgSRMPK3LoRh-qV1r3tJ2_Lw&oe=6ABA6897"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT6gca67QQsQ7kNvwH4tg2R&_nc_oc=AdpeopgZITljxk4SgmMCxIj_djRs5DzYzaJR6hAUWmgC8a1pnJuME7uZMKod9VBXaek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6H3lYvYXPQlOXeRT_DI0kKN24jtQliNbBFPgtpIYfqQ&oe=6ABA8548"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gap8N2w_l9YQ7kNvwF4pENu&_nc_oc=AdpA-NnZH36OM7KpSMN_K6TYBI5FNhJGcrgF2HG8oqmNR97hfZ2bEj9QsVgO0i8J4hQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlybYLdC2s6c_j17FS-WJvcGuLtDM_w0jvrfwvOcAjiA&oe=6ABA74D4"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2lQMJEoL_4Q7kNvwFDgIzU&_nc_oc=AdqNxGBhbWU3GFDdI_xYK8CVld9L_prov-mvXoqGDj7wA1Ss5-COnoNKyk7v2ys_kGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhJiN-sam4J9N4GiI7EJIMz9k8NeZmpbhlcel
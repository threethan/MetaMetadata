shaping.png", "id": "1354405553539603", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB4rL9GncOgQ7kNvwGQ9Mii&_nc_oc=AdqETgzmkH7pR47MH6d6VH4AxNwzmdScDyBy3FpmTVcFFOHjhpE3EU9Vf82B9lEjO0U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND7gsvDuK5FQ_UoGhBozdQ7GhNRAGEBNw3lA8VFXAmvg&oe=6AD0ECEB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynWrtR19piAQ7kNvwHa6xGg&_nc_oc=Adq2vuuDORqORogCFjWTr_56e3zkQXPOe0McVrNMTRuDQeHqzyo1XBrb_gRE2Eaonl4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcM5bSXUM0KsJmqdWBA6e15MU3tsAljELe3xcH7Wl7qQ&oe=6AD0F7D1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJpUo7tAZgIQ7kNvwHHcM1w&_nc_oc=AdoH27uAyALnjhxtk3pKy0K7CvDJveGRQ1oFA4Qq3FWlYk8z6P1l5oGabh00UAS15fg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQyk-LdvZnXCilXqd_Ia8SDofc3Hsb8UBQMDlryxz-nQ&oe=6AD0D217"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyviy_YScSsQ7kNvwFf9kUA&_nc_oc=Adpuf43k1tc2v_53PI825Vl1vwVTJYI6D4cfMXPrqCysFIHC1VQCOWJsh1GlQREUpOg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwx4_8A4HGaXm8dh90SQ7VHlQZ_sX1ckM7yg05NqAb-A&oe=6AD0EEC8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcgE17lC9IEQ7kNvwFWvaGP&_nc_oc=AdobzGw8oygm--CPgmxDRwagOoNA8rlY8W_gispSA32UWCFDZxabnBHV4s6_7Oo5EcA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8t5vf0oh3lQqMyBNRTWdMbzdkeQ-TFA7lp3Z2ASsSjg&oe=6AD0DE54"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prbo3ENHpDAQ7kNvwEEmfbl&_nc_oc=AdoDNPww-De8RtKoMB3uxM6z4vBlpDTWB5tU1yFadoWEUmBponNt4P4lkUEBB6oQSAQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX4n1OV02F92kk6WZwXH41RiNc9qY4N2MKdOd
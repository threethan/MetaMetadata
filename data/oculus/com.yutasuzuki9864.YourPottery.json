shaping.png", "id": "1354405553539603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8x6hnAFn-0Q7kNvwGXZsp2&_nc_oc=AdpEr0qM5Mqk7tQGcGDeoBbOCpg9qVxR7c9nuy666YV85i0S0Zk_htNAmvl_rhG08D4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKZYmHHdJlTYT1YtWsSpqr0DN7mPCoXBevWySQc_et9Q&oe=6AF333EB"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pM57XgLvwCAQ7kNvwGNTJrY&_nc_oc=Adpix6EqDU95XMGeBbNa5BHWElFWoQ9XYO_P_Ekhhbl9523FGLipOiQKvKDhYLKmTkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtWZKs3_xai4gJwkeSwUWUnOSXMpKhfU6HHVXwBDecug&oe=6AF33ED1"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLwapJ6hLAwQ7kNvwFx6s4j&_nc_oc=AdoE_B7do_K4d03RhxsO_GKen3YlhTixUTllG4IsVlDTO9gQwjD5AqgTL2T0TgTGg4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd2VCkLtQ9TWM__u5VoozbzbQ1BbRNe-lCI-DLTJrGoQ&oe=6AF35157"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htZMggLFzn4Q7kNvwHZboty&_nc_oc=AdpQKlxVguMF9xCnPkvAhNWXqI7StnaUScZeFttniqn2JMGZXahpkbNX3aJmVeuhRDA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr7XA1w4O5IFYNNogrveJrQSzWDpFKI_UkA0gomegm7Q&oe=6AF335C8"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_MdMpQgBqkQ7kNvwH14Hy3&_nc_oc=AdoAiP5uEsBiWbx0zIlsQ86r8D1oucBatakBQPSFI3JMbLRKCQ8_M4SjlVDiicxybxM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwl6ESZLnm2CLKxejp4dkTIjscf391WDkUYYU55vAplw&oe=6AF32554"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZaTPhRLJYIQ7kNvwFh_r-G&_nc_oc=Adox7So8f4L5duxPT5x33kTcVzgoju5YZAIpNNIYjKTigud5nDkaXxJEL9wpLy4ZgWk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbdfft29S24pE4uZDS-pswZpCS2aAzAl0eHL9
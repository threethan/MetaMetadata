gAN0D53K-A&oe=6A85A4BD"}, {"file_name": "01-shaping.png", "id": "1354405553539603", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTrFYzvVBY0Q7kNvwFhF7tY&_nc_oc=AdrDgXH0CGD4FG3uHKJH2Kz52wRearto4wTgVTMoVSmHfXdp-tcjMTxbc2Ys3ySdcZI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJp1Hg0xZzqw5osBtffM_MgfOp2-_0rFvoTnQtnQwMpw&oe=6A858F2B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_10odUn3d68Q7kNvwEdu9op&_nc_oc=AdpIwYGCgkhpMdB6xjVcCiS61oixFJG9XJoXJBGy9vvldlpNd-KzcrawRRBSQfWkvp4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXSfrzrKI2k7gmMMo1zdzTaaN3IrUivB6Clq4Yokl8bg&oe=6A859A11"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb_3cLAlJ7wQ7kNvwFVd9NI&_nc_oc=AdqU9xb-7vJLCaogi8CfMriudw5TmlavK_i6wntuVhVarRw-6GePynt-a_RpHi7mdHk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXZbaBH1dx7Q0ut2MOPxwyWShTqSr-Cge9_kT7-tq24Q&oe=6A85AC97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8Jyn9McryYQ7kNvwGxw59Z&_nc_oc=AdrU3C37JIbdHRoh2rjzMVpwobrBsnCdPTSwtbONOGTEgHtaqCOSqMAXVWKphyTQRdg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3iVA8W3JdXE05cw-vaemBuuJedUQO1JAC2Aku4XZ6lg&oe=6A859108"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oEt2qBcj5QQ7kNvwGpb3io&_nc_oc=Adpa3VYqOI99CLOVHs-CW2sM8UtNIiQRDJtjIL65iQ686fI6lNpNVR8GeLn3fyRort4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2BRxjgaIY8FLxuTkZRlAEkyIQuYra-yIIbegZqN6y-g&oe=6A858094"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9jjk9674bUQ7kNvwG6ethV&_nc_oc=AdpC3OHnXjLotX8x6OebqpF_JU9oRm26TLCA34YlBiGe-WxlN-dLI8YGIZFfmOeUXcA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f2
shaping.png", "id": "1354405553539603", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654944867_1354405556872936_1700639642390017842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7X6DrqFwAcQ7kNvwGdYjCR&_nc_oc=Ador7Qh-mNF4AbBqjhGXWudptbY1Y_emRnHBxBZu8SytBJ-PIBwwvxkKtAd9UVqZSUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnUVmGKxvCBCSMcph3_C2g5FAV8HkHzr4KOfg14pKumg&oe=6AE2106B"}, {"file_name": "02-painting.png", "id": "1104123238960523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1104123242293856_1807574773629114068_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMJIk3Q1cNsQ7kNvwFLzmui&_nc_oc=Adq3u5F51RP1ZxZ4INX-H6YN3TyiAlGShHwH9Zv64Vw2OV5800JoW7wci0bEDPbTXpI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqBC4UdRlnKlzXSS_zl5F4t_9i7l_R8RgK0ueA-g7ZeA&oe=6AE21B51"}, {"file_name": "03-kiln.png", "id": "1279588440770027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619805_1279588444103360_2654115310108284879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdIURLsDgHMQ7kNvwEfUm4p&_nc_oc=Adr-Pg5Ks-hYxtMXivmsOA2k7Y1aTvqKQm4-9fao_FS2SjH40JUDZ8osk_26nPfWuXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCAppPkaHHYLOlemEdQRKM50zfuMzyNv1xKLdiQWL_GA&oe=6AE1F597"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "YourPottery", "keywords": ["pottery", "craft", "art", "creative", "simulation"], "long_description": "A VR/MR pottery studio built exclusively for Meta Quest 3 / 3S.\n\nCup your hands around a spinning wheel and draw the clay upward. The clay follows your fingertips \u2014 the waist, the swell, the shape of the rim, all yours to form. When it feels right, decorate it with gosu, iron, and cinnabar pigments, dip it in a clear or Oribe glaze, and load the kiln. Every firing brings a one-of-a-kind kiln transformation (yohen): the glaze melts and settles into a living surface no two firings ever repeat.\n\nThen carry your finished pieces into your real room with MR passthrough. Line them on a shelf, set them on your desk, and build a gallery that is yours alone. No locomotion, no hurry \u2014 a calm, seated, deeply immersive kind of making. A guided tutorial gently walks you through your first piece.\n\nFully offline. Nothing is collected or transmitted. Everything you make stays on your headset.", "short_description": "Touch the clay. Raise a vessel. A pottery studio in your hands."}, {"images": {"nodes": [{"file_name": "seedream-v4-1784017326525-1_180x180_transparent.png", "id": "2679158835814615", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_2679158839147948_3520356550721223513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyIJFO5etEMQ7kNvwHecXxm&_nc_oc=AdoF1eVrCmvINv36R5IigxFmKAaXF1VK3lB1UK0PSM-PPH7SrWHBdAu9i8OZ3ahxN2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd0eGpnR_tn92sZ1kUTyOpSQcrloQw0Pg4rVQZGaWPxQ&oe=6AE21248"}, {"file_name": "seedream-v4-1784017357725-3_180x180.png", "id": "2151007702135424", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604298355_2151007705468757_8289236063368096898_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPoFs-6Hy10Q7kNvwGR78HV&_nc_oc=Adrqt8Tt3kvLbrFgc8n8tOc_stcLS6blpdUH_whkOZ3MFRLLQ7PVCo5LyMtxDraqC0w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrr0yr6HK66ftT_sc8Qel9F8xvyXrKJdT5Rg5R0Wtuaw&oe=6AE201D4"}, {"file_name": "seedream-v4-1783998420588-2_1440x1440.png", "id": "2007893327269511", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619685_2007893330602844_8890526686537933188_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKQwR-tTLRsQ7kNvwEv2HDQ&_nc_oc=Adq75G7-jHNiT3T-0AItNNYUSVC269q6HfvEp-uiYY4w2K910xRh4TvOVhNUpRFJvxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw6L2ZPxAQyS-mY9w5x9EnbdO2a_Wn4f1Dcsr
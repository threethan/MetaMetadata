l": {"file_name": "HNM_Oculus_landscape_V3.png", "id": "366760917825153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031621_366760924491819_3967465794339364040_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J27p9thzfP8Q7kNvwFZG3A7&_nc_oc=AdkltT9-rAcoTAuNunS-btfe-MMoqIeIdl1SNko7aO_sx4Hpso2QWVnsWWN9aZC5Jbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvpW8aG5Qj6mYcvjmSYRx3TbiPiZ6EThQPsiaZ27kuAiQ&oe=69A43E4F"}, "display_name": "Hidden No More", "keywords": [], "long_description": "Travel back in time to 14th century Persia to experiment with rainbows in the lab of Kamal al-Din al-Farisi or hunt for exoplanets far from our solar system with Dr. Mercedez Lopez Morales. Improve the lightbulb with Lewis Latimer or experiment with solar radiation with astrophysicist, Dr. Hakeem Oluseyi. Amplifying voices and shedding light on science stories in the shadows, Hidden No More lets you explore the hidden stories of STEM innovators throughout time. ", "short_description": "Travel back in time to 14th century Persia to experiment with rainbows in the lab of Kamal al-Din al-Farisi or hunt for exoplanets far from our solar system with Dr. Mercedez Lopez Morales. Improve the lightbulb with Lewis Latimer or experiment with solar radiation with astrophysicist, Dr. Hakeem Oluseyi. Dive into Hidden No More: Shedding Light on Science Stories in the Shadows and explore stories of STEM innovators throughout time. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pdfhost.io/v/nvkJKwD4s_HNM_PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Morehead Planetarium and Science Center", "support_website_url": null, "website_url": "https://moreheadplanetarium.org/hidden-no-more-vr/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
l": {"file_name": "HNM_Oculus_landscape_V3.png", "id": "366760917825153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031621_366760924491819_3967465794339364040_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIFM4bMBHiEQ7kNvwG2ZbGL&_nc_oc=AdnL6AiWZQlMwgVvFTyO74Wp2XsEs1P9x5VGBDileOmkjNUE8w8w_ISKBsj9JsqV66c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFGBS5LwvZvyVhNerECgMgjA-aXDVctzrXFE4BwkV43g&oe=69A049CF"}, "display_name": "Hidden No More", "keywords": [], "long_description": "Travel back in time to 14th century Persia to experiment with rainbows in the lab of Kamal al-Din al-Farisi or hunt for exoplanets far from our solar system with Dr. Mercedez Lopez Morales. Improve the lightbulb with Lewis Latimer or experiment with solar radiation with astrophysicist, Dr. Hakeem Oluseyi. Amplifying voices and shedding light on science stories in the shadows, Hidden No More lets you explore the hidden stories of STEM innovators throughout time. ", "short_description": "Travel back in time to 14th century Persia to experiment with rainbows in the lab of Kamal al-Din al-Farisi or hunt for exoplanets far from our solar system with Dr. Mercedez Lopez Morales. Improve the lightbulb with Lewis Latimer or experiment with solar radiation with astrophysicist, Dr. Hakeem Oluseyi. Dive into Hidden No More: Shedding Light on Science Stories in the Shadows and explore stories of STEM innovators throughout time. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pdfhost.io/v/nvkJKwD4s_HNM_PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Morehead Planetarium and Science Center", "support_website_url": null, "website_url": "https://moreheadplanetarium.org/hidden-no-more-vr/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
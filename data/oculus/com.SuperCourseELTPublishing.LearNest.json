71-25/491825503_2070044346890181_4596665371644256532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kk_BcaGyvNgQ7kNvwElSqbr&_nc_oc=AdpisOsD3vpV4YlNSSL-rM3FFHrMP7Tc5B4Y31fSkw2k1VausOcVbk4LLjuPCJmtAC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwEiuKxrCitke117NX8aGkfRPRiqEXLqQ6QrR484MZJA&oe=6A896D8E"}, {"file_name": "3.png", "id": "26886709824281014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_26886709837614346_5148484565198777903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7h1WPW80dIQ7kNvwFVDPFG&_nc_oc=AdqwHkRVMsZvC0uPaB4wdICiGSGxbLAoZp-6ymm8slXSaUr2KP3KfKQRcsp54fJ3N90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRHXgxGrK3uX_B9w4hTur-EJKFsY0Qtgd6gE3Q_bNt3w&oe=6A8978CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SC Platform", "keywords": ["virtualclassroom", "immersivelearning", "Onlinelearning", "vrclassroom", "elearning"], "long_description": "Transform your study space with the official SC Platform VR application by Super Course.\n\nExperience the future of English language learning.\n\nThe SC Platform brings your coursebooks and the entire learning management system into a fully immersive, 3D environment designed for maximum focus and accelerated language acquisition.\n\nWhy SC Platform VR?\nTraditional screens are full of distractions. In the SC Platform, you enter a private, 360\u00b0 virtual study suite where interruptions disappear. Engage your muscle memory by interacting with your material through a high-fidelity spatial interface.\n\nKey features:\n    Zero-distraction environment: A meticulously crafted educational space that eliminates external noise and optimizes focus retention.\n    Spatial UI & interactive media: Organize your workspace exactly how you like it.\n    Natural interaction: Complete your assignments and activities with intuitive gestures and natural movements.\n    Real-time cloud sync: Your progress and grades are synced bi-directionally between your VR headset and the web platform.\n\nImportant notes:\n    Account required: A valid SC Platform student account is required to access the application.\n    Optimized for quest: Supports hand tracking and touch controllers for a seamless spatial experience.", "short_description": "Step into the digital classroom. Experience distraction-free English learning in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.supercourse.gr/policies/", "developer_terms_of_service_url": null, "publisher_name": "Super Course ELT Publishing", "support_website_url": "https://www.supercourse.gr/erp/sts/", "website_url": "https://www.supercourse.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34920539044227746"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_779904088148859_1502687652429801644_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrt1D0497hUQ7kNvwGLbRui&_nc_oc=AdoIJgAdyzV_TI5hvvMENSsb_MkGDzdrDyo_xP97_2UviYs8SY3QKAoc_UVNo3TReck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELn6p9Z-hvX80ROlo5hhBcMDfwduLd-EqtxSmY_sFaIA&oe=6A899AE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SC Platform", "platform": "ANDROI
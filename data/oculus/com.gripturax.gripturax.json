s=7f20f&oh=00_AQEpw9lTDy-ZWpy7KzuChL5z1PGY9U6-b3D7FDwEjEJ_rg&oe=6A79B346"}, {"file_name": "SampleScene_Custom..._06.08.2025_14-26-19.png", "id": "1109695774363045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827718_1109695777696378_2548336774681994485_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzvsWJPc6icQ7kNvwHyL9mj&_nc_oc=AdqoOKJiiCOmm9fv6jTiFXtSQUgA0d_9VoAyPVjo3Jct7Izg7trl2akKifAF9bh3BWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAzHBnIYEEd5ypjLYXSxWjEuY3RlDzBQl7MaNOs-mCXQ&oe=6A79E806"}, {"file_name": "SampleScene_Custom..._06.08.2025_14-27-07.png", "id": "1052349100003168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1052349103336501_3599846666430497808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNzKdLNosA0Q7kNvwGkUdoN&_nc_oc=Adp3TOtGNopHVFDrLIy94iD5SKD3p21kR5OvkKruxk1MYOSxAIfpdUK3eZITdBDISkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOC3A3DUlYbmgOBl29pyzEcCCrdQJymncw7KPK4cCUBg&oe=6A79B743"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GripturaX", "keywords": ["gripturax", "griptura", "tag", "fun", "gorilla"], "long_description": "GripturaX is a high-energy VR multiplayer game inspired by the viral hit Gorilla Tag, where movement is everything and the only limit is your skill. Using nothing but your hands, you\u2019ll run, climb, swing, and launch yourself through immersive environments in a fast-paced game of tag that\u2019s as fun as it is physically intense.\n\nBuilt on physics-based locomotion, GripturaX offers smooth, button-free movement that makes you feel like you're actually gripping, climbing, and jumping through the world. Whether you're dodging other players in forested arenas, scaling huge structures, or testing your reflexes in parkour-style maps, GripturaX delivers heart-pounding VR action like no other.\n\nChallenge friends in private rooms or meet new players in public lobbies. With responsive controls, customizable avatars, and frequent updates, GripturaX is more than a game \u2014 it's a growing community of players who love skill-based, movement-first VR fun.\n\nAre you ready to grip, leap, and outsmart your opponents? Then jump into GripturaX and master the art of movement.", "short_description": "GripturaX is a fast-paced VR climbing and tagging game inspired by Gorilla Tag. Swing, leap, and grip your way through dynamic maps with friends in an intense, physics-based movement experience. No buttons \u2014 just pure motion. Are you fast enough to escape the tag?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/griptura/homepage", "developer_terms_of_service_url": null, "publisher_name": "GripturaX dev", "support_website_url": null, "website_url": "http://griptura.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23980251931647301"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830021_1276323037620964_86834072873251189_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDBsW2IfLR0Q7kNvwFO_zLa&_nc_oc=AdoZ6mdrMKVwEAAVR_vKpeB8bEm660iewGfK0Rz2Vb1ITh53wueMjQMzDP2hzwsLSsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPplNdNrPU5_M15-rBdi4Tz3luz4yKVAWGAt864UZgTg&oe=6A79BE50"}, "is_concept": false, "is_test": fa
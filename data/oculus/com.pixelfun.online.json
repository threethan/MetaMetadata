fzPANIve1D7Gy7b1tza_peoeU180L0PW4x5f5aLG1a_7IfUk39Oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMCKDUz9612Je6SKY10TgQt3BKCRdEAtSN3ASu5bFHEQ&oe=6AA6A64B"}, {"file_name": "V9 Screenshot 4.png", "id": "1887058972144098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623565_1887058975477431_2548622667185903053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CviiZIIDG7cQ7kNvwEIJX-L&_nc_oc=Adon_Ijo-AlC6MTp2LXLNX33t04PjnLM6qf-2sBSfwlCKvWwnuFwbzPD-hC2S_sTFtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5nMu35hv63Jxv6TRuEL3N9p0AzYrQfYjdaGkxG52ZoQ&oe=6AA6B67A"}, {"file_name": "V9 Screenshot 5.png", "id": "709749065210018", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304988_709749068543351_3552112504996435976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWnd1clR-EYQ7kNvwHaKFqs&_nc_oc=AdoF33YKNSs_R0YyQuWvHvbRxNnfI9bwJWqB3w4TIrM9ExYPPAEnsHt-TTO3-KzkjKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4oFDjL2P7rxDy2ahuYXIzZ2TjWo4TxHwO02VRwp-QxQ&oe=6AA6AF17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V9 Trailer Cover Image 2560x1440.png", "id": "1455407112259050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819980_1455407115592383_4290145165040033183_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPkQYMpaMy8Q7kNvwHaZw8o&_nc_oc=Adp5lttQuGpVFRXesntNJBa0JmzODzqw0_Xc2JHUyTUIo4WzC5HsbZt1cBLukF558dQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGq3c2d2-WC62peFMbFGpEP3hCDAD98BVSvAf3PDvSLw&oe=6AA698EF"}, "display_name": "Vortex 9", "keywords": ["shooter", "multiplayer", "online", "battle", "browler"], "long_description": "**Well, here you are, fans of VR shooting games\u2026 Find yourself in a totally strange and Xtremely attractive world of fighting cat-people and speaking robots.**\n\nIs it a demon girl attacking you with a big gun? Who is this guy with a box instead of his head and a bat in his paws? No worries! Get your battle lollipop or a shooting gun and show them who\u2019s the boss! Stylish brawlers, insane weapons and explosive shooter battles are here in Vortex 9!\n\n**Become a strong brawler in this 3rd person VR shooter!** Choose any hero you like! Maybe a giant spy Mr Goodboy or vicious Hellen D. Mon or better both? Vortex 9 - shooting games main features:\n\n- **8 amazing characters:** John, Jane, Marvin McSpy, Mr Goodboy, Jess Purrfect, Hellen D. Mon, Mercydroid and Beelzebox. Customize your hero from head to toe or choose someone special!\n\n- **Weaponry: dozens of crazy shooting guns!** Atypical melee weapons, heavy machine guns will make you the strongest in online multiplayer games!\n\n- **Generics: little helpers in battle!** Create your own and join a fight!\n\n- **Game modes:** Team battle, Deathmatch Solo, Capture point - get a gun and join the battle! More online modes are coming!\n\n- **Various maps:** brawl in a variety of beautiful locations and enjoy marvelous graphics!\n\n- **Play with friends:** make fights more fun and intense together!\n\nOnline multiplayer games have never been so dynamic and exploding! Grab a Space Minigun, jump into the brawl battle!", "short_description": "Become the strongest brawler in this 3rd person VR online shooter! Stylish brawlers, insane weapons and explosive shooting battles are here in Vortex 9! Find yourself in a totally strange and Xtremely attractive world of fighting cat-people and speaking robots. Choose any hero you\u2019d like to be! Let your journey of the multiplayer games begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.itales.mobi/vortex9-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iTales VR", "support_website_url": null, "website_url": "https://vr.itales.mobi/vortex9", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
dKp6KFK8Q7kNvwHzdGsp&_nc_oc=Adqzun2M5b4xuTRtu8tH46oOCqxM5Ky8zwAJyMu2h-CRA5B-ZknE4bnNFflXwfJl0i4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWQMOy7SphVCVHqc0GUQiKYjQ4ZTV_fq8OxCXxOjCiIQ&oe=6A4E6572"}, {"file_name": "V9 Screenshot 4.png", "id": "1887058972144098", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623565_1887058975477431_2548622667185903053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYCYStb4zE8Q7kNvwG8qOUL&_nc_oc=Ado62YMigHvUrAmDKprNqXHMu1yPaWsC8FiAavK2Vkc9ljJ4iLUQrOycLPa-NGe_J-k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL0woSv6p4euTnPeU6Gs_Ti8V6VE3uZqkp3JD7KrPcJw&oe=6A4E61FA"}, {"file_name": "V9 Screen 4.png", "id": "2165697133965690", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_2165697140632356_8122620618765227654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPIl0qROsYoQ7kNvwFRzu2U&_nc_oc=AdrB27WZFxWa_VLdwgYLQBGgaf3xZh3FdpB3JLHz6PsclD2a6bUiqrLBnhwTs6Uh8uo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKcjCVyvacxOI9mUm_XC96sEw7_q05hX6jJ8tBAuYdNA&oe=6A4E6F47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "test01_fin.png", "id": "885979967249650", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819239_885979970582983_5973129291003223139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M68ZGukLOJEQ7kNvwGazCOm&_nc_oc=AdpMs8_-P38qvZnMyg8GWkFZuJ0xzNP0Thy7PPXSY_Drvr36HaZdwXOVUNili56AhtQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvsG8UHiLkbs-DT_Fw2NjShiSg9EvusgUJsi85FozUFg&oe=6A4E6FAC"}, "display_name": "Vortex 9", "keywords": ["shooter", "multiplayer", "online", "battle", "pets"], "long_description": "**Vortex 9 is an online shooter with stylish brawlers, insane weapons, explosive shooting battles and cute pets! Supporting cross play with VR, mobile and desktop versions.**\n\nFind yourself in a totally strange and attractive world of fighting cat-people and speaking robots. Is it a demon girl attacking you with a big gun? Who is this guy with a box instead of his head and a bat in his paws? No worries! Get your battle lollipop or a bubble shooting gun and show them who\u2019s the boss! Stylish brawlers, insane weapons, cute pets and explosive shooter battles are here! \n\nVortex 9 main features:\n\n- **Crazy characters!** John, Jane, Marvin McSpy, Mr Goodboy, Jess Purrfect, Hellen D. Mon, Mercydroid and Beelzebox - one is weirder than another. Customize your hero from head to toe!\n- **Crazy weaponry!** Atypical melee weapons, heavy machine guns and bubble blasters will make you the strongest in online multiplayer games!\n- **Cute little helpers in battle!** Create and breed your own pet and let them join a fight!\n- **Various game modes!** Team battle, Deathmatch Solo, Capture point - get a gun and join the battle! More online modes are coming!\n- **Various maps!** Brawl in a variety of beautiful cartoonish locations and enjoy marvelous graphics!\n- **Play with friends using Cross-play!** Make fights more fun and intense together! VR players can join the same matches, use the same weapons and pets, and experience Vortex 9 in a fully immersive way while remaining part of the unified ecosystem.", "short_description": "Vortex 9 is an online shooter with stylish brawlers, insane weapons, explosive shooting battles and cute pets! Supporting cross play with VR, mobile and desktop versions. Find yourself in a totally strange and attractive world of fighting cat-people and speaking robots. Get your battle lollipop, charge a bubble shooting gun, team up with your hog and show them who\u2019s the boss!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://iworlds.studio/vortex9-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iTales VR", "support_website_url": null, "website_url": "https://iworlds.studio/vortex9", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categor
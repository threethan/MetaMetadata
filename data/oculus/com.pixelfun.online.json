iu1hF2LH79VOpR1pTBFI1U1oOlA2-r1douW3mKas1y7UYY_MoU0ooD5eg8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4BfW0fodAsbOqPrQ3LoqdXH1gL-HU2nixwVcd3CPSHg&oe=6AAE8F4B"}, {"file_name": "V9 Screenshot 4.png", "id": "1887058972144098", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499623565_1887058975477431_2548622667185903053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96XCUmUGzGUQ7kNvwFnY6qv&_nc_oc=AdrtiYWYc0bXgePQdeXoEQBySfWNuZpqBp731U1DjIsOYFoBs_OAd3lXcyToeOFE638&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQZkkQQ_jGmCx7aZwUDW2fHd4-T668KGXELuvHkh2zFQ&oe=6AAE9F7A"}, {"file_name": "V9 Screenshot 5.png", "id": "709749065210018", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499304988_709749068543351_3552112504996435976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6JQSvLpsMsQ7kNvwG5ttr1&_nc_oc=AdpXBQUX8qYemqCAWG4MUmd3Y8XVEzlTLXCzsqiqs3xqTHy7RmiEheYMC88TU8vyTxM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5DlC2g5KzHkoRhhGLYA-jDtwwpXMK1Hfp09dn_qH-kA&oe=6AAE9817"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V9 Trailer Cover Image 2560x1440.png", "id": "1455407112259050", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819980_1455407115592383_4290145165040033183_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ySpgfw9er4Q7kNvwHIk11o&_nc_oc=Adr-5klAE4IeXLXwhvg6c6oF1qrVsUnrSg1tW5YmVBjLP6NpuGdoDuWZoHfpyMwGrHY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzgnlaI5dE1BIRiRL4xvR0RZeGs4CM7BQwHebQ_E4HbQ&oe=6AAE81EF"}, "display_name": "Vortex 9", "keywords": ["shooter", "multiplayer", "online", "battle", "browler"], "long_description": "**Well, here you are, fans of VR shooting games\u2026 Find yourself in a totally strange and Xtremely attractive world of fighting cat-people and speaking robots.**\n\nIs it a demon girl attacking you with a big gun? Who is this guy with a box instead of his head and a bat in his paws? No worries! Get your battle lollipop or a shooting gun and show them who\u2019s the boss! Stylish brawlers, insane weapons and explosive shooter battles are here in Vortex 9!\n\n**Become a strong brawler in this 3rd person VR shooter!** Choose any hero you like! Maybe a giant spy Mr Goodboy or vicious Hellen D. Mon or better both? Vortex 9 - shooting games main features:\n\n- **8 amazing characters:** John, Jane, Marvin McSpy, Mr Goodboy, Jess Purrfect, Hellen D. Mon, Mercydroid and Beelzebox. Customize your hero from head to toe or choose someone special!\n\n- **Weaponry: dozens of crazy shooting guns!** Atypical melee weapons, heavy machine guns will make you the strongest in online multiplayer games!\n\n- **Generics: little helpers in battle!** Create your own and join a fight!\n\n- **Game modes:** Team battle, Deathmatch Solo, Capture point - get a gun and join the battle! More online modes are coming!\n\n- **Various maps:** brawl in a variety of beautiful locations and enjoy marvelous graphics!\n\n- **Play with friends:** make fights more fun and intense together!\n\nOnline multiplayer games have never been so dynamic and exploding! Grab a Space Minigun, jump into the brawl battle!", "short_description": "Become the strongest brawler in this 3rd person VR online shooter! Stylish brawlers, insane weapons and explosive shooting battles are here in Vortex 9! Find yourself in a totally strange and Xtremely attractive world of fighting cat-people and speaking robots. Choose any hero you\u2019d like to be! Let your journey of the multiplayer games begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.itales.mobi/vortex9-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iTales VR", "support_website_url": null, "website_url": "https://vr.itales.mobi/vortex9", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
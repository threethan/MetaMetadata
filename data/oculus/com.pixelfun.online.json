OBKbUt50Q7kNvwGzOsy4&_nc_oc=Adpafw-EzuRT_lxR2qmwzhuegUeu0Q0CaurgTOVIyDyOY7JuSCwmmh6sGTvEE6u2ztk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xZUI4v0FUCp7B_6pqeZrXMtTCUkl-ElZC6AbNhZtbdQ&oe=69FF4B72"}, {"file_name": "V9 Screenshot 4.png", "id": "1887058972144098", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623565_1887058975477431_2548622667185903053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLgkrbT7nqMQ7kNvwGf94QD&_nc_oc=Adqr9kTOgJa0L4zKcrVpSxSTDp9KI3yQFH2HUsQNJh5AA_c-Zc9upP9igASbl_zMsBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UpsI-FJA26pgSIJXJbYjJq6Wma9jkhRGJkierBmeECw&oe=69FF47FA"}, {"file_name": "V9 Screen 4.png", "id": "2165697133965690", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_2165697140632356_8122620618765227654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYr5zw1KbiQQ7kNvwFNU_Wd&_nc_oc=AdoZbjaxqvKHwxAqZsjCOcRKQf-KEvuFBPHfNXtG60MIsgk5NjKJ_1ICgz2Ht2nOFgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kXntXcjqxKowUxPBhVEaXu4yhz13BfoGRL1NnNXxKgA&oe=69FF1D07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "test01_fin.png", "id": "885979967249650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_885979970582983_5973129291003223139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72IjzR3zKWMQ7kNvwEv78Yf&_nc_oc=AdoKE-QGSlXQdDb31ZCc7ggyNzEFn1sNrcUlE5b45rnSSR6-YLlRmX1mQ9Rjo97klH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4420K6y6VyxZVKPL9ucP-vFZLhzPzDo5OZP427HXUL7Q&oe=69FF1D6C"}, "display_name": "Vortex 9", "keywords": ["shooter", "multiplayer", "online", "battle", "pets"], "long_description": "**Vortex 9 is an online shooter with stylish brawlers, insane weapons, explosive shooting battles and cute pets! Supporting cross play with VR, mobile and desktop versions.**\n\nFind yourself in a totally strange and attractive world of fighting cat-people and speaking robots. Is it a demon girl attacking you with a big gun? Who is this guy with a box instead of his head and a bat in his paws? No worries! Get your battle lollipop or a bubble shooting gun and show them who\u2019s the boss! Stylish brawlers, insane weapons, cute pets and explosive shooter battles are here! \n\nVortex 9 main features:\n\n- **Crazy characters!** John, Jane, Marvin McSpy, Mr Goodboy, Jess Purrfect, Hellen D. Mon, Mercydroid and Beelzebox - one is weirder than another. Customize your hero from head to toe!\n- **Crazy weaponry!** Atypical melee weapons, heavy machine guns and bubble blasters will make you the strongest in online multiplayer games!\n- **Cute little helpers in battle!** Create and breed your own pet and let them join a fight!\n- **Various game modes!** Team battle, Deathmatch Solo, Capture point - get a gun and join the battle! More online modes are coming!\n- **Various maps!** Brawl in a variety of beautiful cartoonish locations and enjoy marvelous graphics!\n- **Play with friends using Cross-play!** Make fights more fun and intense together! VR players can join the same matches, use the same weapons and pets, and experience Vortex 9 in a fully immersive way while remaining part of the unified ecosystem.", "short_description": "Vortex 9 is an online shooter with stylish brawlers, insane weapons, explosive shooting battles and cute pets! Supporting cross play with VR, mobile and desktop versions. Find yourself in a totally strange and attractive world of fighting cat-people and speaking robots. Get your battle lollipop, charge a bubble shooting gun, team up with your hog and show them who\u2019s the boss!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://iworlds.studio/vortex9-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iTales VR", "support_website_url": null, "website_url": "https://iworlds.studio/vortex9", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categor
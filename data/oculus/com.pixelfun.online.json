_ohc=1wtU3y_Csm8Q7kNvwHvMGRp&_nc_oc=AdqesLB48nig5UC7cU6iVTN1azVK0NLeg9EN_RLGnOWeDQhWQARrMs5zH3mjLb8-kIQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSs6pmDFWa4I7OOnZsTWjeQ4PlT4v9AEjARTkCLosQhng&oe=6B0B3B6F"}, "display_name": "Vortex 9", "keywords": ["shooter", "multiplayer", "online", "battle", "browler"], "long_description": "**Well, here you are, fans of VR shooting games\u2026 Find yourself in a totally strange and Xtremely attractive world of fighting cat-people and speaking robots.**\n\nIs it a demon girl attacking you with a big gun? Who is this guy with a box instead of his head and a bat in his paws? No worries! Get your battle lollipop or a shooting gun and show them who\u2019s the boss! Stylish brawlers, insane weapons and explosive shooter battles are here in Vortex 9!\n\n**Become a strong brawler in this 3rd person VR shooter!** Choose any hero you like! Maybe a giant spy Mr Goodboy or vicious Hellen D. Mon or better both? Vortex 9 - shooting games main features:\n\n- **8 amazing characters:** John, Jane, Marvin McSpy, Mr Goodboy, Jess Purrfect, Hellen D. Mon, Mercydroid and Beelzebox. Customize your hero from head to toe or choose someone special!\n\n- **Weaponry: dozens of crazy shooting guns!** Atypical melee weapons, heavy machine guns will make you the strongest in online multiplayer games!\n\n- **Generics: little helpers in battle!** Create your own and join a fight!\n\n- **Game modes:** Team battle, Deathmatch Solo, Capture point - get a gun and join the battle! More online modes are coming!\n\n- **Various maps:** brawl in a variety of beautiful locations and enjoy marvelous graphics!\n\n- **Play with friends:** make fights more fun and intense together!\n\nOnline multiplayer games have never been so dynamic and exploding! Grab a Space Minigun, jump into the brawl battle!", "short_description": "Become the strongest brawler in this 3rd person VR online shooter! Stylish brawlers, insane weapons and explosive shooting battles are here in Vortex 9! Find yourself in a totally strange and Xtremely attractive world of fighting cat-people and speaking robots. Choose any hero you\u2019d like to be! Let your journey of the multiplayer games begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.itales.mobi/vortex9-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iTales VR", "support_website_url": null, "website_url": "https://vr.itales.mobi/vortex9", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30358396483804030"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1205568631206571"}]}, "baseline_offer": {"id": "1205568631206571"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772128800, "status": "PUBLISHED", "id": "1205568631206571"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34543488155294821", "version": "1.4.0"}, "id": "722712964059706", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "30260007240309622", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34543488155294821"}, "rele
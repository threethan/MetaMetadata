_9VXBVd4Q7kNvwFCraaI&_nc_oc=Adojn3GPw5AaV-3ubaRfU-4zSNCOJHISJBXIqmjbizDhmsQvf0Sn7UUnN1fu43kXh9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9LfUVs-AiCJL7ybN28o_EnQ9Vq_1-IGr6ZlC8gzEkVw&oe=6ABBD1F2"}, {"file_name": "V9 Screenshot 4.png", "id": "1887058972144098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623565_1887058975477431_2548622667185903053_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w97PgbmMtBkQ7kNvwFgjjaf&_nc_oc=Adry6nfHKiEdOUR_o-yt8RaMoygleQpkn79KS43u9_vZ9CbtlNUf2f8TVV5AT0UoXK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzxySilYgkiqUrDjc02MCLXjwtE33ntwO3GAXq7FJSzA&oe=6ABBCE7A"}, {"file_name": "V9 Screen 4.png", "id": "2165697133965690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_2165697140632356_8122620618765227654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bys1T6327IQ7kNvwESVUSX&_nc_oc=AdozoqZGesAE6-ntHxnWwTyIRYOZeVuq-a33D1CNiJJEc1XZRZv4zKIx92J-8h0Zbh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqi1buHlSSXNFShr62g7RFzAZ6v29SNFfjW1hp1wP2ZA&oe=6ABBDBC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "test01_fin.png", "id": "885979967249650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_885979970582983_5973129291003223139_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3tqZYNN-qoQ7kNvwEhm0KN&_nc_oc=Ado9tY9l9B-f4VnU5OWzMxovuH_y3pOM8VZinqU1UpXZi8eiRd1SzhGHeSf732oyLkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIORHRVIy92e7tsS3JoyaEXKFQNJkEXwt1HN8Wcxq448Q&oe=6ABBDC2C"}, "display_name": "Vortex 9", "keywords": ["shooter", "multiplayer", "online", "battle", "pets"], "long_description": "**Vortex 9 is an online shooter with stylish brawlers, insane weapons, explosive shooting battles and cute pets! Supporting cross play with VR, mobile and desktop versions.**\n\nFind yourself in a totally strange and attractive world of fighting cat-people and speaking robots. Is it a demon girl attacking you with a big gun? Who is this guy with a box instead of his head and a bat in his paws? No worries! Get your battle lollipop or a bubble shooting gun and show them who\u2019s the boss! Stylish brawlers, insane weapons, cute pets and explosive shooter battles are here! \n\nVortex 9 main features:\n\n- **Crazy characters!** John, Jane, Marvin McSpy, Mr Goodboy, Jess Purrfect, Hellen D. Mon, Mercydroid and Beelzebox - one is weirder than another. Customize your hero from head to toe!\n- **Crazy weaponry!** Atypical melee weapons, heavy machine guns and bubble blasters will make you the strongest in online multiplayer games!\n- **Cute little helpers in battle!** Create and breed your own pet and let them join a fight!\n- **Various game modes!** Team battle, Deathmatch Solo, Capture point - get a gun and join the battle! More online modes are coming!\n- **Various maps!** Brawl in a variety of beautiful cartoonish locations and enjoy marvelous graphics!\n- **Play with friends using Cross-play!** Make fights more fun and intense together! VR players can join the same matches, use the same weapons and pets, and experience Vortex 9 in a fully immersive way while remaining part of the unified ecosystem.", "short_description": "Vortex 9 is an online shooter with stylish brawlers, insane weapons, explosive shooting battles and cute pets! Supporting cross play with VR, mobile and desktop versions. Find yourself in a totally strange and attractive world of fighting cat-people and speaking robots. Get your battle lollipop, charge a bubble shooting gun, team up with your hog and show them who\u2019s the boss!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://iworlds.studio/vortex9-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iTales VR", "support_website_url": null, "website_url": "https://iworlds.studio/vortex9", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categor
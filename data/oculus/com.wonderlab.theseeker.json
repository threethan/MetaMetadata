scdn.com/v/t64.5771-25/473400248_646988718009957_2597070422686561245_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djRxdGLY9NcQ7kNvwGXVuVS&_nc_oc=AdqDSllPVSiZtjUASijubypDYhyQFpiRQJdSOwxGyOAcmrQXIWnf5MQvKTQHXG0V3DI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kRGyMxNsI6ZF4UelQysmnKk81OXwjH3-pg0LJRLpu5Q&oe=69F2098E"}, {"file_name": "4.png", "id": "1369452690878879", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392000_1369452694212212_3774620464022249993_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPAnJmMhkJ0Q7kNvwECeehM&_nc_oc=Adr9diOWIlMIGL3pBIaFETMbesHJDxO7AJ1aeDKk8UngXO37b2hiFMLYDI8Kp1NCkzo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0CZydNWEXtOGQrZPELDk-XMclm67WmCemUygF-WwINRQ&oe=69F1E56F"}, {"file_name": "3.png", "id": "1831605180998708", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392000_1831605184332041_5211661841336810569_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-7GXdtub40Q7kNvwGOqg80&_nc_oc=AdraNkAmjz0SnFJM5DyypISx9VqcAIoR3Lz6rpAqafgePegiS_yljPP1EFEC3nl1Dlw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0CWJxiaxOXT2FtMD017V5HWl4QI0qhv8U2zqG2yUIYYA&oe=69F20781"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Seeker", "keywords": [], "long_description": "The Seeker rappresenta un mondo virtuale in grado di immergere completamente l\u2019utente nella natura veneta, stimolando la mente e la curiosit\u00e0. In particolare sar\u00e0 possibile:\n\na) muoversi all\u2019interno di un bosco rigoglioso e suggestivo;\nb) accedere a tanti scenari naturalistici incantati, come la radura, le cascate, la casa sull\u2019albero, una malga e molto altro\nc) svolgere stimolanti attivit\u00e0 cognitive per la ricerca del tesoro misterioso\n\nMuoviti all\u2019interno di questo ambiente e interagisci con gli oggetti presenti (piante, animali, oggetti, ecc.).", "short_description": "Vivi un\u2019esperienza immersiva alla ricerca di un misterioso tesoro immerso nel magico mondo di The Seeker! Divertiti a svolgere stimolanti sfide cognitive e metti alla prova le tue capacit\u00e0 di attenzione, memoria, controllo, pianificazione e flessibilit\u00e0.\n\nRiuscirai a trovare il tesoro misterioso?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://the-seeker.it/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Oculus Store", "support_website_url": null, "website_url": "https://the-seeker.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8782599948511638"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2358567554515605"}]}, "baseline_offer": {"id": "2358567554515605"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1745401680, "status": "PUBLISHED", "id": "2358567554515605"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9065877406850556", "version": "0.2"}, "id": "1123370269472650", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8765421750229458", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9065877406850556"}, "release_status": "REL
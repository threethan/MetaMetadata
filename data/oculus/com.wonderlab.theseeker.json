ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_558252800568666_5875384112340447760_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoHQZ-oVVlIQ7kNvwEb93pX&_nc_oc=AdmUqSMNTXSDZlbfQO8kGU5BLb4nlO1zaVEeu4uUHILgX8DTp7dGNBDWFnJjRq6q6kk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwG9tz_obvGmOeFH4aqn0JTmGOxIB6rv-dh1o99qRJQ4g&oe=69BEA9BD"}, {"file_name": "4.png", "id": "2098462950607842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_2098462953941175_5552185821460782435_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOwBifSiUysQ7kNvwGC3IiF&_nc_oc=AdkCCJ1Saj0rMMEXWaBxyw6evcK0ymfV4_m1vJoOWA5wC_83hC0iOmb2JFnvSJb8YaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmwHGdkTSYkrhjg9w-Zj48t-5uPK15S-1KO_eHXGmK0w&oe=69BEA0AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Seeker", "keywords": [], "long_description": "The Seeker represents a virtual world capable of completely immersing the user in Venetian nature, stimulating the mind and curiosity. In particular it will be possible:\n  \na) move within a lush and evocative forest\nb) access many enchanting naturalistic scenarios, such as the clearing, the waterfalls, the tree house, a mountain hut and much more\nc) carry out stimulating cognitive activities to search for the mysterious treasure\n\nMove yourself within this environment and interact with the objects present (plants, animals, objects, etc.).\n\n\n", "short_description": "Live an immersive experience in search of a mysterious treasure immersed in the magical world of The Seeker! Have fun doing stimulating cognitive challenges and test your attention, memory, control, planning and flexibility skills.\n\nWill you be able to find the mysterious treasure?"}, {"images": {"nodes": [{"file_name": "Bianco - The Seeker logo.png", "id": "2067693420361231", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_2067693423694564_2251
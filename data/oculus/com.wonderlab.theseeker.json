_oc=AdrvfeDQwaISXvbntAnrESjXzN_9LUJXW4L_cEbjfFk8iMHYcvZpX5YGm3EAxV8aeAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BgGmYoiCK7JCGejf_u64F4VaJ6tlmFxgEYV2gffPh7w&oe=6A43C481"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Seeker", "keywords": [], "long_description": "The Seeker rappresenta un mondo virtuale in grado di immergere completamente l\u2019utente nella natura veneta, stimolando la mente e la curiosit\u00e0. In particolare sar\u00e0 possibile:\n\na) muoversi all\u2019interno di un bosco rigoglioso e suggestivo;\nb) accedere a tanti scenari naturalistici incantati, come la radura, le cascate, la casa sull\u2019albero, una malga e molto altro\nc) svolgere stimolanti attivit\u00e0 cognitive per la ricerca del tesoro misterioso\n\nMuoviti all\u2019interno di questo ambiente e interagisci con gli oggetti presenti (piante, animali, oggetti, ecc.).", "short_description": "Vivi un\u2019esperienza immersiva alla ricerca di un misterioso tesoro immerso nel magico mondo di The Seeker! Divertiti a svolgere stimolanti sfide cognitive e metti alla prova le tue capacit\u00e0 di attenzione, memoria, controllo, pianificazione e flessibilit\u00e0.\n\nRiuscirai a trovare il tesoro misterioso?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://the-seeker.it/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Oculus Store", "support_website_url": null, "website_url": "https://the-seeker.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "support
uHquJylXDQOFQ&oe=69984B92"}, "display_name": "OPERATION SERPENS DEMO", "keywords": [], "long_description": "Operation Serpens is a fast paced action shooter with great arcade feel.\nJoin an elite unit that formed to dismantle the evil Snakes Organization.\n\nFeatures\nCo-op multiplayer up to 4 players.\nSingle user campaign story with 3 difficulty levels.\nZombies survival horde mode.\nFree locomotion, teleportation and room-scale.\nLots of guns, grenades, flashbangs and drones.\nbHaptics support. Suit up!\n\nGet the full game: https://www.oculus.com/deeplink/?action=view&path=app/5748603085165962&ref=AppDesc&utm_source=AppDesc", "short_description": "Arcade Shooter | Single user campaign | Co-op multiplayer mode | Fast paced action game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thegrook.com/operation-serpens/privacy-policy/", "developer_terms_of_service_url": "https://thegrook.com/operation-serpens/terms-of-service/", "publisher_name": "GINRA TECH", "support_website_url": "https://thegrook.com/operation-serpens/", "website_url": "https://thegrook.com/operation-serpens/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "891665628185914"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003241_3220157771547451_8778930276297573046_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w
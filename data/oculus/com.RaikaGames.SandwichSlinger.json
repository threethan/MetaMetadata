17676423_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhJTMG07V30Q7kNvwGQX2Du&_nc_oc=AdkscoGcShKGRkipdBX_cx2WyQwzNn5RgJLDtEFtUWpwcaaoCqmeJkeGASeO-aSDQ-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjtkro1iqxBgzP5waraaB2YD2_UDea_Y3_Bg0A96W1HQ&oe=69B805E3"}, "display_name": "Sandwich Slinger", "keywords": [], "long_description": "Craft magical sandwiches and fend off enemies in this fast-paced culinary adventure. Stack your ingredients strategically, cast spells to protect your cooking station, and become the ultimate Sandwich Sorcerer! Use everyday sandwich ingredients infused with magic to fight off hoards of enemies. Use the three elements to craft specialty sandwiches with different effects or collect new ingredients with special properties that give your sandwiches a bit more \"spice\".", "short_description": "Craft magical sandwiches and fend off enemies in this fast-paced culinary adventure. Stack your ingredients strategically, cast spells to protect your cooking station, and become the ultimate Sandwich Sorcerer!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dylhigaxr.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Raika Games", "support_website_url": null, "website_url": "https://dylhigaxr.github.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7294197287283255
, {"file_name": "4_P&S_Meta_2560x1440.png", "id": "1695510495090265", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/507845837_1695510498423598_6463864364416230291_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16SYxqX82dAQ7kNvwFs0HQ3&_nc_oc=AdqGXlZybESinA2NwiPj4nmGa3EPUmpht_EfQK4sbvcHBevr-SlUFx-SdReAEpXHkOc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgxDqt28yrg4KqyTDuLR47n9WRQ1t-ALTKDt3SOTq7TA&oe=6A9722DE"}, {"file_name": "5_P&S_Meta_2560x1440.png", "id": "3099754496861662", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312338_3099754500194995_5452334139249002501_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLxT0ADnJ9oQ7kNvwEFegOJ&_nc_oc=AdqC5-Cfsr4KHLu_xTWJg5Xxko6rsXYkTvgGFuArURoI2BpbuzRC1cfoErq5kuJN4Uk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhT__IbUFrY7n4pseO-LZhLZfOAt8Vy6sZtW_rVDqvEQ&oe=6A9746F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "[P&S]_Landscape_2560x1440.png", "id": "830638623314699", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499315353_830638626648032_5161134839617465880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXy9vY8KVp4Q7kNvwGc8pM0&_nc_oc=AdoR3HDy_aKx0fw3NWI851uOjexjXVUbjPIZh3Bu997TK7AranYPduAYoUp9ncGF2xs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1BC9Ie43u1BiYNBviNCx6HIhf6dbMP15iLLw1EE9NyA&oe=6A971B13"}, "display_name": "Pets & Stuff Demo", "keywords": ["cat", "animal", "monkey", "cute", "cozy"], "long_description": "**Pets & Stuff** is a cute, relaxing VR game where you become a caring pet groomer and veterinarian.\n\nHelp adorable animals in need, clean them up, treat them, feed them, style them, and make them happy again. Every pet is different, so use your tools, creativity, and care to give each furry friend the attention they deserve.\n\n# Care for cute pets\n{956876957366350}\nMeet cats, dogs, raccoons, foxes, deer, and other lovely animals who need your help.\n\n# Use fun tools and accessories\n\nWash, trim, brush, clean, decorate, and style pets with a variety of interactive tools, color sprays, collars, shades, and more.\n\n# Enjoy responsive VR gameplay\nFeel the fur, make satisfying trims, interact with every detail, and capture charming photos of your creations.\n\n# Discover more to come\nUpgrade your cozy clinic and explore new locations, including the Clinic, Forest, Farm, and Fantasy Land.\n\nCuteness overload and furrrr everywhere guaranteed!\n", "short_description": "Pets & Stuff \u2013 a cute, fun and relaxing game where you become a skillful groomer and veterinarian using a variety of tools, meds and stylish accessories. Let your imagination run wild! \n\nHelp little friends in trouble, make them happy, pampered, clean, well-fed, and while on it - feel free to add a pinch of chic. Enjoy a fully responsive and polished gameplay with different locations to explore, many adorable pets and lots of creativity boosting gadgets to play with."}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/petsnstuff.html", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
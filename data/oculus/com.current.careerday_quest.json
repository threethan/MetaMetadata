, digital holograms from a variety of fields. This unique interview experience will open your students\u2019 minds to what\u2019s possible, and potentially inspire them to pursue a career they once thought out of reach!", "short_description": "Whether you're at home, or in the classroom, users can spawn and interview numerous career professionals to learn more about their career pathway and their unique experiences growing up"}]}, "developer_name": null, "developer_privacy_policy_url": "https://currentstudios.ca/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24197043646628749"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75520124_777980571084543_6179242270829073263_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8j-FgxgNxUQ7kNvwFrH6Eb&_nc_oc=Adqp2CcFpyh3kO79M-5wUIzPAYFFc4YsfAO14p6MZFs3cVnyNrCzBN7gMDhW8mBPss8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE2gf-MsoPVCBNYkhsSWhRbwT3diV2SkRoIZ75Q0kxfg&oe=6A8D6461"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Career Day VR", "platform": "ANDROID_6DOF", "context_category": {"context
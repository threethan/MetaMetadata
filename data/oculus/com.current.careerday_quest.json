 to pursue a career they once thought out of reach!", "short_description": "Whether you're at home, or in the classroom, users can spawn and interview numerous career professionals to learn more about their career pathway and their unique experiences growing up"}]}, "developer_name": null, "developer_privacy_policy_url": "https://currentstudios.ca/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24197043646628749"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75520124_777980571084543_6179242270829073263_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g6m7v5HG5YQ7kNvwEtwySw&_nc_oc=AdkkmMXBs4Lfq5VRT38riAZiSOCYzPuv3hGtlSSu3VWxZ_rSaLU5qGybHdWXow0fe0E&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfswXUqTi2A-S2U9GAuatLxn_4vAjbL-VrXYJU_t01Jplg&oe=69A1A021"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Career Day VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1718221920, "lastRevision": {"nodes": [{"id":
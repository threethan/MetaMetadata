"}, {"file_name": "EspaceV4.png", "id": "348612566759078", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982596_348612570092411_2885760547221774208_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQuWn_CabF0Q7kNvwF4d4_h&_nc_oc=AdrI4u0sgwtuQ0DSdoy694L2zpM5uwMzqBkc8C6mRzMN_6R1uDB4EKGevYZSaqIki5Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0g0JiMoi42TyAGZ578NYdLPNuArfrZK-1zsbZD8RalA&oe=6AFB25E2"}, {"file_name": "EspaceV3.png", "id": "1240284536419679", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031308_1240284539753012_8499509793362346124_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHzkOshMC-0Q7kNvwEZkrng&_nc_oc=Adpd96l3G5491tcSvVxIMvcu1ZaTxcR4iA50iyEUPqTFY6jNJkZ2adLasJxwNvf9Y3M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsmFCodTfeULFepac5duxoMs09THnQh2_0lSH1APidtQ&oe=6AFB31E3"}, {"file_name": "EspaceV5.png", "id": "1148571178987759", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982596_1148571182321092_370411540919559272_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll48iD065L0Q7kNvwH2QqQr&_nc_oc=Adr8QhMNZiGy6lByPNyn8Qhvdc207Kar0MDLBngK6tnxPA475rqHZ8OnU4INZBmqR5s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNyDRTpJMpAhKuafnl8ZUk6KtsvlQClF6omGj0Y_nQ3g&oe=6AFB43D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Espace V", "keywords": [], "long_description": "As one of Vancouver\u2019s oldest not-for-profit organizations, Alliance Fran\u00e7aise Vancouver is\nrecognized for its commitment to serving the community by providing French language\nprograms and promoting local and international francophone cultures through events, including an international ART & VRexhibition since 2019.\n\nAs a continued part of this commitment we welcome you to a Espace V! Created as the go-to immersive space to connect, consume and engage with Francophone culture presented in its variety of digital media forms.\n\nExplore the iconic space inspired by the real world building of Alliance francaise composed of 3 main spaces: The Lobby, the Auditorium and the Gallery. \n\nEnjoy curated, traditional 2D francophone films, rotating 2D art and photography, digital sculptures and artistic 6dof VR experiences by simply wearing virtual headsets found in the space.\n\nConnect and interact with other visitors and creators and share your love for francophone culture.\n", "short_description": "Welcome to Espace V created as the go-to immersive space to\nconnect, consume and engage with Francophone culture presented in its variety of digital media forms.\nExplore the iconic space inspired by the real world building of Alliance Francaise Vancouver composed of 3 main spaces: The Lobby, the Auditorium and the Gallery. Enjoy curated, traditional 2D francophone films, rotating 2D art and photography, digital sculptures and artistic 6DoF experiences.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kre.is/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kreis Experiences Inc.", "support_website_url": null, "website_url": "https://www.kre.is/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id
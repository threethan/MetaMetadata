NvwEEx8sE&_nc_oc=AdnQR0sF8s1NZyEtT8noG1vR83c2VDfaTNjcX3cgMtRLWJbNOd-XrphenOnABf9OURc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxX-e6ZQP3L0N6J2S4F_PZC2ZV37x9s88CnZPh5HHyw-g&oe=69BBEEA3"}, {"file_name": "EspaceV5.png", "id": "1148571178987759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982596_1148571182321092_370411540919559272_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Apocs-8qstUQ7kNvwGY7vcU&_nc_oc=Adk-NcFcqQKeiuuMmHZsfKLrrS-XlSI-IezZT6qzybDQrEbq6zsNXr1VKIVXrvdXGAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZ-jzN6KWXaLtRoqr3OBktgk2X0_PT-8im-K8Tom2o5g&oe=69BC0092"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Espace V", "keywords": [], "long_description": "As one of Vancouver\u2019s oldest not-for-profit organizations, Alliance Fran\u00e7aise Vancouver is\nrecognized for its commitment to serving the community by providing French language\nprograms and promoting local and international francophone cultures through events, including an international ART & VRexhibition since 2019.\n\nAs a continued part of this commitment we welcome you to a Espace V! Created as the go-to immersive space to connect, consume and engage with Francophone culture presented in its variety of digital media forms.\n\nExplore the iconic space inspired by the real world building of Alliance francaise composed of 3 main spaces: The Lobby, the Auditorium and the Gallery. \n\nEnjoy curated, traditional 2D francophone films, rotating 2D art and photography, digital sculptures and artistic 6dof VR experiences by simply wearing virtual headsets found in the space.\n\nConnect and interact with other visitors and creators and share your love for francophone culture.\n", "short_description": "Welcome to Espace V created as the go-to immersive space to\nconnect, consume and engage with Francophone culture presented in its variety of digital media forms.\nExplore the iconic space inspired by the real world building of Alliance Francaise Vancouver composed of 3 main spaces: The Lobby, the Auditorium and the Gallery. Enjoy curated, traditional 2D francophone films, rotating 2D art and photography, digital sculptures and artistic 6DoF experiences.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kre.is/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kreis Experiences Inc.", "support_website_url": null, "website_url": "https://www.kre.is/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1150312732446776"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5764354160335071", "version": "1.1.ASG2"}, "id": "909539519593631", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3739776379459536", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5764354160335071"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
uscdn.com&_nc_ss=7f20f&oh=00_AQSbT0v_Yjpx-AKUqyDsU98pOkn8L9i1dJ-4cB5TQtqKPw&oe=6AFDB6BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Espace V", "keywords": [], "long_description": "Welcome to Espace V! The immersive space to connect, experience, and engage with Francophone cultures in a variety of digital media forms.\nInspired by the upcoming real-world building of Alliance Fran\u00e7aise Vancouver, Espace V is the permanent cultural gallery in the virtual world. \nWe invite you to explore the modern space, socialize with other users, admire 2D art, photography, and dive into curated award-winning VR pieces of local and international artists.", "short_description": "Welcome to Espace V! The immersive space to connect, experience, and engage with Francophone cultures in a variety of digital media forms.\nInspired by the upcoming real-world building of Alliance Fran\u00e7aise Vancouver, Espace V is the permanent cultural gallery in the virtual world. \nWe invite you to explore the modern space, socialize with other users, admire 2D art, photography, and dive into curated award-winning VR pieces of local and international artists."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kre.is/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kreis Experiences Inc.", "support_website_url": null, "website_url": "https://www.kre.is/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
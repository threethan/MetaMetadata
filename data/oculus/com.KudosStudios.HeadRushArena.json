_ss=7f20f&oh=00_AQIqQZoBqjbhFHSjVIG_u-DtwbbbrYTulbgHA0SVdFTG9g&oe=6AB3E7EB"}, {"file_name": "Store3.png", "id": "2190480955096033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818852_2190480958429366_1295034775603676876_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94ngho_HGmoQ7kNvwGHOvqI&_nc_oc=AdrvUmq2RHnOeY2wFCS3bZBJaDVslittTC_sA88NqBGm2ygNiV3gACmfh-vX9Ri159g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJQGfJ63GqWGErzk8iUaZDDDWXeKj43cNdyesRWMjA1Q&oe=6AB3E50E"}, {"file_name": "Store4.png", "id": "1565496948341191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1565496955007857_9132589140963924270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCSYaIzeQyEQ7kNvwFd9hhz&_nc_oc=AdoOO67HZ0O_qKfcCYJ1gh8U1cn_Z40sdIHI6x84shaU4pCEFv-3FY9U0Yo9J9OTLg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsaMCYqIV6xvNjNxi4etZ5YnO60ivdoNMTH0yyMwa6AQ&oe=6AB3EAB3"}, {"file_name": "Store1.png", "id": "1510516233814521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818885_1510516237147854_7650846265889716536_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hjp1M3Nh-0Q7kNvwFqS_9m&_nc_oc=AdqIcfx6dXAMRWhkJhxW8pbpwH7AgMRr-WeGLmt9HkLv9vq1X6R_5XGrYqNnGOG-Wxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkouW4-DHeKOyngB68lhQTRhIwWDw2dCAuTyYyP0YoLg&oe=6AB3EF83"}, {"file_name": "Store5.png", "id": "2176423133160360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_2176423139827026_3290956574822865069_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAXPIaNVGSEQ7kNvwEAgUxS&_nc_oc=Adp3qrVQe9G9VgN---ouzRSy5jyxzbJfaMXtWnfFQ8ZXmvMYXwSxOhk7JTxm1v0nP6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfvFOKcU7cKyfFul9f2oSJc0r7THTq_KJ8rCxkWzlczw&oe=6AB3D410"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Headrush Arena", "keywords": [], "long_description": "# Get Farmed in the Most Ridiculous VR Shooter on Quest\n\nAI slop overwhelmed us in 2026\u2026 now, imagine life in 2126! Welcome to **Headrush Arena**, where AI is out of control, harvesting human knowledge. Rebel leader \u201cDave\u201d has been plucked from his couch one time too many and he\u2019s not donating any more pearls of wisdom! Join the rebellion, grab ya\u2019 guns, destroy the bots and reabsorb your knowledge!\n\n**Bigger Head, Bigger Plays**\n\nThe more knowledge you absorb, the bigger your head grows. The bigger your head, the higher you jump and your voice\u2026 well, let\u2019s just say - embrace your helium balloon status! Soar across the arena with your massive head, drop the bots and deposit knowledge at banking stations, then do it all again.\n\n**Two Modes. One Existential Crisis**\n\n- **Arcade**: Pure combat. Pure fun. Terminate bots, collect knowledge, deposit and repeat.\n- **Party**: Get shot? No problem, it\u2019s a chance to win more knowledge. Answer the question. Choose an upgrade. Knowledge is power. Literally!\n\n**So, the AI Probably Wants You Dead!**\n\nTake on various bots in their wacky hallucinated formats. Each type drops knowledge when terminated, they're less \"enemies\" more \"walking databases that shoot back\u201d.\n\n**Power Up**\n\nShield. Shotgun. Magnet. Minigun. Speed boost. Use them. Lose them. Cry about it\u2026 in your whiny helium voice!\n\n**Launching With**\n- 3 modes: Free for All, Team Deathmatch, PvE\n- 2 maps\n- One AI overlord watching everything\n\n\n# Headrush Arena. Early Access on Meta Quest.", "short_description": "Headrush Arena is a VR shooter where an all-powerful AI harvests humans for sport. Kill robots, steal knowledge, and bank it at the Core to win. The catch? The more knowledge you carry, the bigger your head gets...other side effects may vary. Sorry.\n\n2 maps \u00b7 3 modes (FFA, TDM, PvE)\n5 upgrade pads: shield, machine gun, shotgun, magnet, speed\nParty Mode: get shot, answer a quiz question, pick a perk\n\nComing to Meta Quest - Early Access."}]}, "developer_name": "Kudos Studios", "developer_privacy_policy_url": "https://headrusharena.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kudos Studios", "support_website_url": null, "website_url": "https://headrusharena.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25009174582028608"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2112388342708363"}, {"status": "PUBLISHED", "id": "1602239134811819"}, {"status": "PUBLISHED", "id": "1577863173895975"}, {"status": "PUBLISHED", "id": "2272337803586877"}, {"status": "PUBLISHED", "id": "1939375986592465"}]}, "baseline_offer": {"id": "1577863173895975"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2112388342708363"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28431194696493229", "version": "0.0.53"}, "id": "1587856315905576", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25009174532028613", "is_concept": false, "latest
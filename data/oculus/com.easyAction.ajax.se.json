T-JZ6jleg&oe=69BD3F07"}, {"file_name": "AJAX_Screenshot2.png", "id": "415560834694075", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036646_415560838027408_5231876752149474420_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4URwwtKsdyAQ7kNvwHjNnvl&_nc_oc=AdmdXU8yGLrK-172-0Hc5Pf8gUZWjvq33AMNeLd1I-nEILMKLrO59DugCqY6OLYEazw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXSMA4yODmTkEKWj6oqr9UtkiYLvwea7niWAeo78WXeA&oe=69BD45C8"}, {"file_name": "AJAX_Screenshot5.png", "id": "2578070402351909", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036704_2578070405685242_1343157930056250401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPEw0HQGU1AQ7kNvwFwA2rh&_nc_oc=AdkkNWUUDDQ7nFrCxXgzpYW1r31AxyoZxcyXlBid-Qn0WEcjSWLgecZ8pIUhPCmwphY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx10cCs1KXesM710ZwyHQfeEfIO7RKvCqtrie6XVTCOvQ&oe=69BD42BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "425474040229866", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031357_425474043563199_2421595426568864261_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLbBO6eeGBEQ7kNvwE39pfI&_nc_oc=AdkecR08L11_9YoaprfT7PgM5-IIcnon-vvCHHPaiE_Xo__d9pEC9VCkw2wql4kFxV0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWtM62juw3jlBEjd-gkJs0zjlOyRi3RsV1p4LDrgiw2A&oe=69BD5805"}, "display_name": "Ajax All Powerful \u2022 Special Edition", "keywords": [], "long_description": "A unique VR comedy from the creators of GARGOYLE DOYLE!\n\nAjax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (GARGOYLE DOYLE) and starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL), AJAX ALL POWERFUL is an innovative immersive experience utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. ", "short_description": "A unique VR comedy from the creators of GARGOYLE DOYLE! Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer (Chris Parnell) to negotiate her wishes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.easyaction.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "easyAction", "support_website_url": null, "website_url": "http://AjaxAllPowerful.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8910982848989366"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1124214132637024"}, {"status": "PUBLISHED", "id": "533957229264738"}]}, "baseline_offer": {"id": "1124214132637024"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735589280, "status": "PUBLISHED", "i
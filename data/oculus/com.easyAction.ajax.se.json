_name": "AJAX_Screenshot4.png", "id": "452681220668581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75292493_452681224001914_3169072586658586191_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS_1Zm4VZNMQ7kNvwHHkXBQ&_nc_oc=AdrSlUBXmk72ArtWu1O3qXD1nEp4_cdwj3YvOmfkELjqTybZ5CcqsDpNID28PDI62NU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7R_oKTYGFH7-8f3MQLUdW-qtVagX5qgMdHkzjJGf1FA&oe=6AAFD307"}, {"file_name": "AJAX_Screenshot2.png", "id": "415560834694075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036646_415560838027408_5231876752149474420_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2kU9hqY3rAQ7kNvwFmRJ9f&_nc_oc=AdqfBoaqTCpNlKrPRuMXsan9v2EZqpHXOejkwpnShHwTor8AdlYmRmH_csSBvzNAc34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4Ppq2ro-jhnYuu9sRl6nEsP1dVpPwJEMIqwUPwupgKQ&oe=6AAFD9C8"}, {"file_name": "AJAX_Screenshot5.png", "id": "2578070402351909", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036704_2578070405685242_1343157930056250401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVE10Be55IQQ7kNvwEFnkJ6&_nc_oc=AdrmPBj_7aNppbajg8ZatRRtI5Uh5XWna2gyVpPfiWiyq-qE1uaoL66kQG7AN6U5BeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbCWbtuB9_wW25gnjBdvGtiKOHcz-sxhtYZD1FGOfOQA&oe=6AAFD6BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "425474040229866", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031357_425474043563199_2421595426568864261_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYyONcn0dWoQ7kNvwFmf06Q&_nc_oc=AdpN07bj1XCeXPPuaMthz8rkGlFQJls4595GK_pwVbM337a2hhrM2VHd1AczC-on3Tw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-hWxnlUXi_ASq8KR6ckPnmH1cy730DsM_lkaPacUPiQ&oe=6AAFEC05"}, "display_name": "Ajax All Powerful", "keywords": ["comedy", "gargoyle", "genie", "fonz", "movie"], "long_description": "A unique VR comedy from the creators of GARGOYLE DOYLE!\n\nAjax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (GARGOYLE DOYLE) and starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL), AJAX ALL POWERFUL is an innovative immersive experience utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. ", "short_description": "A unique VR comedy from the creators of GARGOYLE DOYLE! Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer (Chris Parnell) to negotiate her wishes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.easyaction.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "easyAction", "support_website_url": null, "website_url": "http://AjaxAllPowerful.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCU
eZKcTfKOA&oe=69BBED87"}, {"file_name": "AJAX_Screenshot2.png", "id": "415560834694075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036646_415560838027408_5231876752149474420_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4URwwtKsdyAQ7kNvwGNOfiQ&_nc_oc=Adl7yCC2RW0JJ-bngIQBEPA1M27fjnB4LlH_NhIpw0zGzgjP2gf5c5amVZvDKzYW1eg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCr5h5aY-EmpH1iiJ-nOLBcEiTdhn96ofn1ZjsfGc6bQ&oe=69BBF448"}, {"file_name": "AJAX_Screenshot5.png", "id": "2578070402351909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036704_2578070405685242_1343157930056250401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPEw0HQGU1AQ7kNvwFDQRo2&_nc_oc=Adk0OIUA5HqujkBw2h_mBZvDIkTVEUHh3a7n0xo-QTfrC-33de2uQneruIoc8qu0SIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz3BlXh702DG79vS4KF_BG_9ozkTgxVA34dS-rbc6zEyQ&oe=69BBF13D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "425474040229866", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031357_425474043563199_2421595426568864261_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncsZDwSTPysQ7kNvwFCrGBy&_nc_oc=AdnETrqI2ND-Sj0Bi9h7eYp5KcyK-ykegZQTV3PSaax_Iegea86whQclfbvH4qyGtC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRKIhczhgcOb3TjZsD4MttUyge1-ZT1EJRjRCT5zWAgA&oe=69BC0685"}, "display_name": "Ajax All Powerful \u2022 Special Edition", "keywords": [], "long_description": "A unique VR comedy from the creators of GARGOYLE DOYLE!\n\nAjax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (GARGOYLE DOYLE) and starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL), AJAX ALL POWERFUL is an innovative immersive experience utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. ", "short_description": "A unique VR comedy from the creators of GARGOYLE DOYLE! Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer (Chris Parnell) to negotiate her wishes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.easyaction.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "easyAction", "support_website_url": null, "website_url": "http://AjaxAllPowerful.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8910982848989366"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1124214132637024"}, {"status": "PUBLISHED", "id": "533957229264738"}]}, "baseline_offer": {"id": "1124214132637024"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735589280, "status": "PUBLISHED", "i
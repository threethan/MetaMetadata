_name": "AJAX_Screenshot4.png", "id": "452681220668581", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75292493_452681224001914_3169072586658586191_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUPYvkiJtXwQ7kNvwECU9rU&_nc_oc=AdrKdmUhtTAQmOmA7AhizcXtZmZHadBq43dzkqB6GmOeQsRu-hy1L3UOjtHdXeJlDXM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZr_TL77qM6c1cvp2DjVYsuDOAjgu4o3-kPXCgzMAY6w&oe=69CBBF87"}, {"file_name": "AJAX_Screenshot2.png", "id": "415560834694075", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036646_415560838027408_5231876752149474420_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tnbb7G_FSrMQ7kNvwFxwYPJ&_nc_oc=AdrXWQYa1OXAqIjBnD8628uDq7nuh96AiV5Q2GvS0ZmlGTX7X6wNUhDHdalMfRpVSR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1O3jxyncrvIwU2Q6kO9f6-iY4qiPR59iF4ULTe-HzLg&oe=69CBC648"}, {"file_name": "AJAX_Screenshot5.png", "id": "2578070402351909", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036704_2578070405685242_1343157930056250401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR_Mp6cUkv0Q7kNvwHz2JgA&_nc_oc=AdpYFkG2XRWAzjogKS0g5jmdRYpFH11oU9XYrUqlNwe2cOXALGNiLcC3AQxSqslbvwg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPiopmEift-gFt15Z6ZAnAjnxEyUd3VH5n7VEVtJJ3_Q&oe=69CBC33D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "425474040229866", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031357_425474043563199_2421595426568864261_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9xypxIRW7sQ7kNvwGZgtOH&_nc_oc=AdpIWfi4qM5oL_rENsDpWooFOs0Wt3oYBqFdP_BYVyUJXOyfaDOVynaKnC_dUnnCczE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkArW4nLTUF1QYen5TnpfVHBDmidvXqlH33oFmT4NTOQ&oe=69CBD885"}, "display_name": "Ajax All Powerful", "keywords": ["comedy", "gargoyle", "genie", "fonz", "movie"], "long_description": "A unique VR comedy from the creators of GARGOYLE DOYLE!\n\nAjax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (GARGOYLE DOYLE) and starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL), AJAX ALL POWERFUL is an innovative immersive experience utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. ", "short_description": "A unique VR comedy from the creators of GARGOYLE DOYLE! Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer (Chris Parnell) to negotiate her wishes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.easyaction.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "easyAction", "support_website_url": null, "website_url": "http://AjaxAllPowerful.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCU
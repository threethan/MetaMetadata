le_name": "AJAX_Screenshot4.png", "id": "452681220668581", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75292493_452681224001914_3169072586658586191_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpA20kIxmdAQ7kNvwGaf3Ha&_nc_oc=AdoWzDGH9rpVQF_nT8GCelHCCDX9G0YwzNLN2PP1TXZqVC7iegQNA23lEcaCC6QsUmQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E-eEqt33-JvGCA0K2GYjBhMwLqbUrM-ISq4oj48Sw-A&oe=6A392C07"}, {"file_name": "AJAX_Screenshot2.png", "id": "415560834694075", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036646_415560838027408_5231876752149474420_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQLpEAa3ZHgQ7kNvwGxxqMK&_nc_oc=AdqPSv1wK_GFk6Qp0IYNLoSX0Z113xYYUk7sEruDawjKJKiwKhasEisTHQtY1u2B91g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zhmsqssD-cJC7ng6d7BoUh4-PGDseoIovz9VkeVs6uw&oe=6A3932C8"}, {"file_name": "AJAX_Screenshot5.png", "id": "2578070402351909", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036704_2578070405685242_1343157930056250401_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq1BkHuRKbwQ7kNvwGtSwWb&_nc_oc=AdqMYXVPAYqoSBx0EmBtbebxZ5zOPO72R7uEDCqyn4woiAapRLvCdvHH2_EVwcUREF4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_05Z5igl1IGBIb3EGnCZJWOGNZ50oZ82cA_AC6c_T3ZA&oe=6A392FBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_cover.png", "id": "425474040229866", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031357_425474043563199_2421595426568864261_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhzsVOVDNWIQ7kNvwFDQw8t&_nc_oc=AdqgqQ72ioFtLI0ConYD6jHn1vQMx4RT60XT8z_lpZR0b2jXx_we6Kyg_gcx-KqlX10&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2XkOuUhAA20ZEmD7S7X-TdFM9Vhy2BSW91mAn_p1pCQ&oe=6A394505"}, "display_name": "Ajax All Powerful", "keywords": ["comedy", "gargoyle", "genie", "fonz", "movie"], "long_description": "A unique VR comedy from the creators of GARGOYLE DOYLE!\n\nAjax (Henry Winkler) is a foul-mouthed, double-crossing genie addicted to the human souls he collects in exchange for granting wishes to gullible humans. However, something is different about the seemingly-naive little girl who has rubbed his lamp this time. For one thing, she\u2019s hired a strait-laced lawyer (Chris Parnell) to negotiate her wishes, and they might have a trick or two buried in the new contract\u2019s legalese\u2026.\n\nWritten and directed by award-winning VR creator Ethan Shaftel (GARGOYLE DOYLE) and starring comedy legends Henry Winkler (HAPPY DAYS, ARRESTED DEVELOPMENT, BARRY) and Chris Parnell (RICK AND MORTY, SNL), AJAX ALL POWERFUL is an innovative immersive experience utilizing behind-the-scenes interactive triggers to create a fluid world of changing sizes and perspectives as the story progresses from the lamp to the real world, and beyond. ", "short_description": "A unique VR comedy from the creators of GARGOYLE DOYLE! Ajax (Henry Winkler) is a foul-mouthed genie addicted to the human souls he collects after tricking gullible masters. But something is different about the little girl who found his lamp this time: she's hired a lawyer (Chris Parnell) to negotiate her wishes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.easyaction.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "easyAction", "support_website_url": null, "website_url": "http://AjaxAllPowerful.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices
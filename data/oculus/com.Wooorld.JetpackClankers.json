scdn.com&_nc_ss=7f20f&oh=00_AQJKlH65YFSXA5-FdvUchlMWJ01SIjts7vPeqLYPUXgoUw&oe=6AA54EB5"}, {"file_name": "Trailer v1 - Landscape.00_00_22_07.Still004 copy copy.png", "id": "1711395410191159", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_1711395413524492_8400896612552052476_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQEyViClcZIQ7kNvwFxdJTO&_nc_oc=AdrfMoj0odIv2-YRoGgEr2oxUbJZlxQp7mnwmMnIEOipozyhq3MOIFXsaN9EmCoZg4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHzKRCAXYt_h-i7K83VakDBs7qBa3AlKInK5oc5y7MJQ&oe=6AA570AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JC_Store_Assets_Landscape_NoLogo_4K.png", "id": "2090307324865144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620429_2090307328198477_2062000649987811648_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkAA2AfVVyAQ7kNvwH1tJkI&_nc_oc=AdoJvz8WVu-bv8nSjbk2eoZoSBbZmXqboYBXAuFnMIImcdRgEZSYSX5WWVnwPJcjq-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-r3vCYEVuJdjOj7YtQ6mGPkU3lVcFmy7sR7nrfJg3Gw&oe=6AA54348"}, "display_name": "Jetpack Clankers", "keywords": ["Racing", "Jetpack", "Speed", "Fly", "Shooting"], "long_description": "Jetpack Clankers is a **social VR racing game** where your hands are jet engines, your legs are wheels, and staying in control is half the battle.\n\nBlast through massive arenas at extreme speeds using chaotic, physics-based movement that is easy to try and hard to master. Boost, drift, climb, crash, recover, and find faster lines as you race through wild robot playgrounds built for speed, skill, and ridiculous moments.\n\nBut racing is only part of it. Hang out with other Clankers, shoot blasters, throw toys, play Clankball, try mini-games, practice movement, chase records, or just cause harmless robot chaos with friends.\n\nWhether you want to compete, explore, mess around, or master the art of barely-controlled jet-powered flight, Jetpack Clankers gives you a fast, funny, social VR space to do it.\n\n## Features\n\n- Social VR multiplayer\n- Jet-powered hand movement\n- Wheels-for-legs robot locomotion\n- Skill-based high-speed racing\n- Blasters and throwable toys\n- Clankball and other mini-games\n- Massive arenas and robot playgrounds\n- Funny, chaotic, physics-driven VR gameplay\n\n**Race fast. Crash hard. Get better. Repeat.**", "short_description": "A social VR racing game with jet-powered hands, wheels for legs, blasters, and chaotic skill-based flying. Race at extreme speeds, crash, shoot, play Clankball and other mini-games, or just hang out in a massive robot playground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wooorld.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wooorld", "support_website_url": null, "website_url": "https://jetpackclankers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "25147775078228514"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "981031701470486"}]}, "baseline_offer": {"id": "981031701470486"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782998640, "status": "PUBLISHED", "id": "981031701470486"}]}, "liveChannel": {"nodes": [{"latest_supported_bina
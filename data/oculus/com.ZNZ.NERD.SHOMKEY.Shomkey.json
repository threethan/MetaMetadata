Chw&_nc_oc=AdnLaWB6pVi2t3kRVVgFbvDUSSXUlTgbZe7ZkWzoRF0YwnD5Eb-ygSmA1RK0F0cteL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNf-L2mbuL8uyuVt_sVqBDC0xaw5iGCpeJS74Lp7CrjQ&oe=69BFFB30"}, {"file_name": "New Project (2).png", "id": "954323620179982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392309_954323626846648_813905039384864369_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo1NbD6WJ2sQ7kNvwGXOszR&_nc_oc=Adl0kQYkVe6gPzbm-tNhpdilh4MfNeQ3f22BCr3sshRxCREzWB7ydbvFpxb8G6QbJOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_wgXEJWHKtpOdpZ0lON185OimX1thSFMbli8ur3hWvA&oe=69BFF9F4"}, {"file_name": "New Project (3).png", "id": "1176996044433619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_1176996051100285_4372520982038225829_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_s6EFoxaH0Q7kNvwFyFX8y&_nc_oc=AdlBkkJ2vsmdBJxfIMKCXUlrYxOJ3O6jWbvFca-C1fzPhUezjOOhMzM4ORz7Dzk18Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5gRwCeAhbTVIrZ4F7KJ_Eb1Ny0ygIY-beJGUpQSXqhw&oe=69BFF7EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (15).png", "id": "9358765127535459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391986_9358765130868792_3087122209433439927_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czYSqJFF5rIQ7kNvwFmHND5&_nc_oc=AdkeGUAsq5oKEspXOzL-XATCdtfFfaB8GzgQuSw5M9Y04lwO6IIZDBPOiZlkI9pEUyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE67_APpJwtNP-va4NrbyQsav6uUBTZJ9wrjjFx9lFMg&oe=69BFF640"}, "display_name": "Shomkey", "keywords": ["fun", "chill"], "long_description": "Shomkey \u2013 The Ultimate VR Tag Adventure!\nGet ready for an exhilarating VR experience like no other! Shomkey is a fast-paced multiplayer game where agility, strategy, and skill determine who comes out on top. Using intuitive physics-based movement, you\u2019ll climb, swing, and bounce your way through thrilling environments in a game of tag like you\u2019ve never seen before.\n\nExplore the World of Shomkey\n\ud83c\udf32 The Forest \u2013 An underground world full of tall, climbable trees, hidden tunnels, and strategic spots for both escaping and ambushing your opponents. Use your surroundings to gain the upper hand as you leap from tree to tree, dodging those chasing you.\n\n\ud83c\udfe0 The Lobby \u2013 The heart of the game, where players gather before matches, check leaderboards, and interact. Customize your settings, chat with friends, and prepare for your next big chase.\n\n\ud83d\udecd\ufe0f The Shop \u2013 Want to stand out? The in-game shop lets you customize your character with a variety of hats, cosmetics, and accessories. Whether you want to look cool, goofy, or downright mysterious, there\u2019s something for everyone!\n\n", "short_description": "Shomkey \u2013 The Ultimate VR Tag Experience!\n\nWelcome to Shomkey, a fast-paced VR multiplayer game where movement is everything! Swing, climb, and bounce your way through the Forest, a unique underground map filled with climbable trees, tunnels, and hidden spots perfect for intense chases.\n\nStart your adventure in the Lobby, where you can check the leaderboard, tweak your settings, and gear up for the action. Head over to the Shop to customize your look with cool hats and accessories\u2014stand out whil"}]}, "developer_name": "ZNZPURP", "developer_privacy_policy_url": "https://sites.google.com/view/shomkeyprivacypolicy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ZNZPURP", "support_website_url": null, "website_url": "https://sites.google.com/view/shomkeyhome/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
748&_nc_oc=Adl5Ldt1DOPX8AE6wBnesJAl2HiwliaR3QYlVGco6zkumiwJUFSvMkccW96PHGUTzf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr8qZLvoODalvjTZ-enMB9wB95ddu7NVGM4fLxB-YTzw&oe=69AED7B0"}, {"file_name": "New Project (2).png", "id": "954323620179982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_954323626846648_813905039384864369_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APrcwCl7xHAQ7kNvwHCnLU9&_nc_oc=AdkUdXOukm44MUN83Ns-t4QRUGwz7cvgsC6qFH37ppoHGdHr4euGC3mmlksx3D2lp8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgFDkxHkNUvY2yh74Ywhpjv8-Sl4k-DOGBslw2-tHyhg&oe=69AED674"}, {"file_name": "New Project (3).png", "id": "1176996044433619", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_1176996051100285_4372520982038225829_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiL8WrhazlwQ7kNvwFJShHZ&_nc_oc=AdlQDjDOSlf8lL_XsputOUEfAFrVUITO85v2KgmhbCwyrfklS8nVUq23Bgm0ozjQENU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM_bpbuiDe27eAHnlJuE_yL5GE35Ud3kZB_t2Acbq1Ng&oe=69AED46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (15).png", "id": "9358765127535459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391986_9358765130868792_3087122209433439927_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dc-1zjqLYEQ7kNvwEpA7hO&_nc_oc=Adl4rEKJdBj0TKK69WQIJ5CIHOZtJazYTyQFduIeFEx12q0ZvezXN8Fl7wkPL1a0OgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsGqfWlJG5sih1NjdJV_IYRZKdbaNVziPXudLNTnm6rw&oe=69AED2C0"}, "display_name": "Shomkey", "keywords": ["fun", "chill"], "long_description": "Shomkey \u2013 The Ultimate VR Tag Adventure!\nGet ready for an exhilarating VR experience like no other! Shomkey is a fast-paced multiplayer game where agility, strategy, and skill determine who comes out on top. Using intuitive physics-based movement, you\u2019ll climb, swing, and bounce your way through thrilling environments in a game of tag like you\u2019ve never seen before.\n\nExplore the World of Shomkey\n\ud83c\udf32 The Forest \u2013 An underground world full of tall, climbable trees, hidden tunnels, and strategic spots for both escaping and ambushing your opponents. Use your surroundings to gain the upper hand as you leap from tree to tree, dodging those chasing you.\n\n\ud83c\udfe0 The Lobby \u2013 The heart of the game, where players gather before matches, check leaderboards, and interact. Customize your settings, chat with friends, and prepare for your next big chase.\n\n\ud83d\udecd\ufe0f The Shop \u2013 Want to stand out? The in-game shop lets you customize your character with a variety of hats, cosmetics, and accessories. Whether you want to look cool, goofy, or downright mysterious, there\u2019s something for everyone!\n\n", "short_description": "Shomkey \u2013 The Ultimate VR Tag Experience!\n\nWelcome to Shomkey, a fast-paced VR multiplayer game where movement is everything! Swing, climb, and bounce your way through the Forest, a unique underground map filled with climbable trees, tunnels, and hidden spots perfect for intense chases.\n\nStart your adventure in the Lobby, where you can check the leaderboard, tweak your settings, and gear up for the action. Head over to the Shop to customize your look with cool hats and accessories\u2014stand out whil"}]}, "developer_name": "ZNZPURP", "developer_privacy_policy_url": "https://sites.google.com/view/shomkeyprivacypolicy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ZNZPURP", "support_website_url": null, "website_url": "https://sites.google.com/view/shomkeyhome/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
QNZE2ZrL_uYQr0-T1ZgF3aPw48OtACZZxxUGIw&oe=6B1041DA"}, {"file_name": "HighresScreenshot00006.png", "id": "813965208403942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_813965211737275_2414030102048495591_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTWRv-yu-TkQ7kNvwGAWq1a&_nc_oc=Adrm9X2D9BZRAK-ZnpK4YXAFsDjWn9vAu-madzVR9D_oZClcP2fcX0FL0GsgmloMhw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9llwmGtW3s7k4M2XZXJM0531w-VwSeEv-7zBHN5ZB5A&oe=6B10457C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cube PoP", "keywords": ["arcade", "shooter", "action", "pop"], "long_description": "Cube PoP is a high-intensity arcade experience. You are in the arena with one goal: destroy as many cubes as possible to drive your score to the max.\n\nThere is no filler, no narrative, and no downtime. It is raw, precision-based shooting that tests your speed and accuracy.\n\nThe Gameplay:\n\nPure Arcade Focus: The only thing that matters is your score.\n\nDynamic Patterns: Targets spawn with increasing complexity, stay fast and stay accurate.\n\nInstant Replayability: Every run is a chance to beat your personal best.\n\nGrab your blasters, lock in, and see how high you can go.", "short_description": "Cube PoP is a high-speed arcade shooter. You have two blasters. Your only objective is to destroy targets and push your score as high as possible. Fast, intense, and pure action"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/cubepop/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscript
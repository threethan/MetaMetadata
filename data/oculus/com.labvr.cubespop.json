There is no filler, no narrative, and no downtime. It is raw, precision-based shooting that tests your speed and accuracy.\n\nThe Gameplay:\n\nPure Arcade Focus: The only thing that matters is your score.\n\nDynamic Patterns: Targets spawn with increasing complexity, stay fast and stay accurate.\n\nInstant Replayability: Every run is a chance to beat your personal best.\n\nGrab your blasters, lock in, and see how high you can go.", "short_description": "Cube PoP is a high-speed arcade shooter. You have two blasters. Your only objective is to destroy targets and push your score as high as possible. Fast, intense, and pure action"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/cubepop/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34622234457421893"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820496_2398140163992638_7747488402508753435_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnJMHpT52A0Q7kNvwGatLNM&_nc_oc=AdpeqfHVdbkOrBG5LSiEzPOwEgCI7pIQ2tP_xRIQW8WOJqfOLOVep-9mCSfVCA9Bp5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn
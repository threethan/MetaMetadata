i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_813965211737275_2414030102048495591_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_FOynsGXvIQ7kNvwELYY5Q&_nc_oc=Ado55yZIFT51G3nKHUNvIzDugybAAaz2XXczQsZ-wk256AdbtX1xMuouWeBpjkgtl4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpkOF1xxetJdqj6xJ_yT8JjTF31lRZsHiAQOOBTBP_1g&oe=6B070AFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cube PoP", "keywords": ["arcade", "shooter", "action", "pop"], "long_description": "Cube PoP is a high-intensity arcade experience. You are in the arena with one goal: destroy as many cubes as possible to drive your score to the max.\n\nThere is no filler, no narrative, and no downtime. It is raw, precision-based shooting that tests your speed and accuracy.\n\nThe Gameplay:\n\nPure Arcade Focus: The only thing that matters is your score.\n\nDynamic Patterns: Targets spawn with increasing complexity, stay fast and stay accurate.\n\nInstant Replayability: Every run is a chance to beat your personal best.\n\nGrab your blasters, lock in, and see how high you can go.", "short_description": "Cube PoP is a high-speed arcade shooter. You have two blasters. Your only objective is to destroy targets and push your score as high as possible. Fast, intense, and pure action"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/cubepop/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEM
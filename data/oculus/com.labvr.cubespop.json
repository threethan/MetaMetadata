_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayUgsaEi0vEQ7kNvwFu6_qZ&_nc_oc=AdqsbCZlKbF7UjumNXz8Pfx_Axhx3H0yAKqVqWW9j_yAXOJMMrVOY9vy3IdE4TeZWtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3sU0u5Jnmxx3CrESGSs21w9SiHzzLnx_D50BiESIuo9Q&oe=69F0BBD3"}, {"file_name": "HighresScreenshot00009.png", "id": "3697111523762181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_3697111527095514_3066957844678988267_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptjSePlOXMkQ7kNvwENM33d&_nc_oc=Adq4QcUGsYHaUscchR3Ajsr9bBZGTqCIySx4o00b2uKqhhmRECcPmc93iRBmgoEkaK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0SdA-5Rnlurhxln-V6dmHSzpKYc6t2sRyiH_PODs-iIw&oe=69F0AA6C"}, {"file_name": "HighresScreenshot00011.png", "id": "1418191269633793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_1418191272967126_8130119255870356390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeWzuM7dl3gQ7kNvwEmTEYx&_nc_oc=Adrif_3RPK1ia_V4jSl3s3g7gjqg3DmZy16rSmh2TEBYYwpySCNGcX87k3KvlyeRmx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Pm5hvkZiL7WGqmwJ20jWF-12LJ304IC0oIV7ZNdO_SQ&oe=69F0ABFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "1296035482586265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_1296035485919598_7051243896326381517_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TY5CJJ1xX8Q7kNvwERrH_1&_nc_oc=Adqai5N3FvLlpdIR7IgcXrp1R-8g1u1EsCUmvD-58gpDHCCy8-V3adhe6TiwBolU-xk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3fRgQNfjcK6vF0vHaxyWsVYFhFw9Q6CbnrqJ8BdWUCuw&oe=69F0CFBC"}, "display_name": "Cube PoP", "keywords": ["arcade", "shooter", "action", "pop"], "long_description": "Cube PoP is a high-intensity arcade shooter built on speed, precision, and focus. You step into the arena with one goal: destroy as many cubes as possible and push your score to the absolute limit.\n\nThere\u2019s no filler, no story, and no downtime. Just pure, skill-based action.\n\nThe Gameplay:\n\nPure Arcade Focus: Every second counts. Every shot matters. Your score is everything.\n\nColor-Based Combat: Switch your weapon color in real time and destroy only the matching cubes. The faster you react, the higher you score.\n\nDynamic Patterns: Targets spawn in increasingly complex formations. Stay fast, stay accurate, or lose momentum.\n\nInstant Replayability: Every run is a new chance to improve, adapt, and beat your best.\n\nGrab your blasters, lock in, and see how high you can go.", "short_description": "Cube PoP is a high-speed arcade shooter where reflex meets precision. Wield dual blasters and match your weapon color to shatter incoming cubes. Fast, intense, and all about pushing your score to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/cubepop/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34909412028704133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300897_918762941025470_5987860998605958704_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfO_vLo0aFIQ7kNvwEmnMZa&_nc_oc=Adqe
uxMGbVKT6RS08zTv-XbEXWzYJiYhA&oe=6A4921EB"}, {"file_name": "HighresScreenshot00008.png", "id": "1818760075485444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1818760082152110_2746243480042490050_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSjdWCj5j6oQ7kNvwEpQJGp&_nc_oc=AdrZQ42qI_ONb2EBYDAIu_m0PdJdpW9qS64bLqf1W74j3VXbvZqHtzIaFE1Zzy6YpCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP1qQIR8ssYTau5QYCxoXM37tcELW7su-k2COqjh7OSA&oe=6A491053"}, {"file_name": "HighresScreenshot00009.png", "id": "3697111523762181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_3697111527095514_3066957844678988267_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDEaX6OeHHMQ7kNvwHslVvU&_nc_oc=AdriIvYG-ZTrkD3bucub2q9SH88IqRt0XldOcbdR-SHAZeqNmP7l9NT92BOAHQE49XY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_WjJiDFrWohH0Oi4PbPfYlUOSUXVBv4_72rvmLb_pCA&oe=6A48FEEC"}, {"file_name": "HighresScreenshot00011.png", "id": "1418191269633793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_1418191272967126_8130119255870356390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4XqMhqYZqoQ7kNvwE1TnNs&_nc_oc=AdogmQwsvrEeEWhEPgL0wfK9zTUEAxAe6Bb1WUfaDEJIwBzH_YduPkOdco93x4YRSNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbndU2GTndJbDVH5l1mjJ76H7EwSP0eLW03UNNkjesCQ&oe=6A49007A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "1296035482586265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_1296035485919598_7051243896326381517_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0ruRynodzQQ7kNvwFMLOK4&_nc_oc=AdqgKtwuWvjAhnC3tzXszn17EqL3W7Q6cmj3oOfY_A4kvI9G4xLyi8F8AiCnShiKyzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZO5j3RUuc-jRRMx1a6tLhMF4BpKCiddA4GNWvAjB2qQ&oe=6A49243C"}, "display_name": "Cube PoP", "keywords": ["arcade", "shooter", "action", "pop"], "long_description": "Cube PoP is a high-intensity arcade shooter built on speed, precision, and focus. You step into the arena with one goal: destroy as many cubes as possible and push your score to the absolute limit.\n\nThere\u2019s no filler, no story, and no downtime. Just pure, skill-based action.\n\nThe Gameplay:\n\nPure Arcade Focus: Every second counts. Every shot matters. Your score is everything.\n\nColor-Based Combat: Switch your weapon color in real time and destroy only the matching cubes. The faster you react, the higher you score.\n\nDynamic Patterns: Targets spawn in increasingly complex formations. Stay fast, stay accurate, or lose momentum.\n\nInstant Replayability: Every run is a new chance to improve, adapt, and beat your best.\n\nGrab your blasters, lock in, and see how high you can go.", "short_description": "Cube PoP is a high-speed arcade shooter where reflex meets precision. Wield dual blasters and match your weapon color to shatter incoming cubes. Fast, intense, and all about pushing your score to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/cubepop/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3
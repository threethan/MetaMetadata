f&oh=00_AQLszF6FB1Q0TzqXKVz6W4ypvlp5wnpCoCNBGRAmsN4H3Q&oe=6AA3FC33"}, {"file_name": "HighresScreenshot00005.png", "id": "2015225826095648", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821081_2015225829428981_1931011295913045541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn2rETfh_1IQ7kNvwEi-4QS&_nc_oc=Adrqb7cW-7309PKPLITTVhvjUz9C5AyCdmmJ0zThOVomfY01zVhybAjBhbNwiQBwONs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvU8OkwAwqIqPukAGGI7smM1vNtwmj9PN1IcvMkH-B5w&oe=6AA41D8C"}, {"file_name": "HighresScreenshot00009.png", "id": "26093057743712080", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823746_26093057760378745_3002078238442179989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HQ_nxgBFi4Q7kNvwFihqtz&_nc_oc=AdrcVNJtmeDubOi4eZnhrElKdI5iqzX1PHhfs_TKlvjEAbzJoJl0BtnaWArEu1K4w6s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICJgjVhzre533-t74wO01-IHh1v8o9TYXG2NBAzblPzQ&oe=6AA4006E"}, {"file_name": "HighresScreenshot00000.png", "id": "932043889319445", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822550_932043892652778_2676384829697636386_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeRqz2oYK-wQ7kNvwHOpwr5&_nc_oc=AdrfpqdCqv1LHj3TZI0UVvY44I9m0Sl-QeNsTVi53yK6mK5U4MgZajh_SY05WZM3tMQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMxhXcas4W69OG3nASTibmVLbmi_np03xVIOPqwrpZjg&oe=6AA3EE9A"}, {"file_name": "HighresScreenshot00006.png", "id": "813965208403942", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819859_813965211737275_2414030102048495591_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBKweYsy6UgQ7kNvwGX56ei&_nc_oc=AdrVMUKTdNjMmzmSLmudNzd5AygnNsTeOnqe59iqsAfuX8pQdjIdpxreUoXYKeiZdsk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLozqMuv-deslqz7kDrqVEHPudB4nS7oCUF7_Dkmeep2w&oe=6AA3F23C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cube PoP", "keywords": ["arcade", "shooter", "action", "pop"], "long_description": "Cube PoP is a high-intensity arcade experience. You are in the arena with one goal: destroy as many cubes as possible to drive your score to the max.\n\nThere is no filler, no narrative, and no downtime. It is raw, precision-based shooting that tests your speed and accuracy.\n\nThe Gameplay:\n\nPure Arcade Focus: The only thing that matters is your score.\n\nDynamic Patterns: Targets spawn with increasing complexity, stay fast and stay accurate.\n\nInstant Replayability: Every run is a chance to beat your personal best.\n\nGrab your blasters, lock in, and see how high you can go.", "short_description": "Cube PoP is a high-speed arcade shooter. You have two blasters. Your only objective is to destroy targets and push your score as high as possible. Fast, intense, and pure action"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/cubepop/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34557431557235517"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "942171364921307"}, {"status": "PUBLISHED", "id": "1417480957104211"}, {"status": "PUBLISHED", "i
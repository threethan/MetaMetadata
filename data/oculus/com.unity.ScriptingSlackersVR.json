r11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS8ELfPK69YJjpi1PVBqjQPir2keP4vzTOE5-JiiEsUg&oe=6A858859"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZCIJuXPS6EQ7kNvwGnm0Ew&_nc_oc=AdqRublI23rhCmBsfOScWg8ghlWACqUO8tiOjWTe5n38b4Z_ZpxcHGh0KVE4e0ncPYc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4JT2knsb687CRNiFlAE4C1EZ9C_JINDQ4Lc0XUDpTUg&oe=6A85A5EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uSl3REtE7sQ7kNvwG1JfRZ&_nc_oc=AdqK4rIyCJzQG1efWwf_w5VUTGfKQOhf-DBgHrcwNTtwE7Aefms1u21w6srSwpNEc4o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGukyna9mBzgYxALleRezAmA_TtoeEqtU0R9OPljTH9tA&oe=6A858F3E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twf6oj5mBqgQ7kNvwHOWyiE&_nc_oc=Adq6MWPfF02qYBL5KX2rD4wWR4iqL6dED9KD4Coex088ADLn-hGT12WP8YOJCDeIUYU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFo6xdhAdIRD3q38L5KT4qGiuo2Qr7cP9SpmZvmUHdAQ&oe=6A858358"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syn6uq7KD-YQ7kNvwFcsalH&_nc_oc=AdovykRZgkppNjBDzRnop9u0oQx4wds-JpM1a7Tbuzh2wMDLLQl_YrH6ND0Nx5OwLck&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErqZ7l0DM_d8ZU1lRyyCkpmK3uwyT9m61EYWLdWU6eSQ&oe=6A857FA1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
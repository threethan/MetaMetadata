5"}, {"file_name": "Map.png", "id": "1023368656652649", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IsZMZJ5IE8Q7kNvwFJj70f&_nc_oc=Adq-PP3UfPowky75jleoIjgKaBdZAGitVjn4r4K17iD0J1y9v2XOCZ7pOfGnZwq5OuQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6pmLuRTf4iRJtHp-tGMoDjkazzdfv7cTk3SgHG5Jp1Q&oe=6A8EC2D9"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzjQXS-GzDcQ7kNvwEGfzJz&_nc_oc=AdpgpWXiMeoeKW5J6PKvUtZxKraNQsQg7LJwFVc-KQon-URDSmxpemKVbkLoCqvDOv4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-UHZ7sxcKEpYjIvn2CjtDgfz756U3FwdVkbjV50jpTg&oe=6A8EE06A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtMwKUDhWkIQ7kNvwEaUBXD&_nc_oc=AdoKFU7jROAht5HL2iPZ6ycRDUtulzrvcaGtGdmaF6Yn1CJrLF_pJYKXFTanx61hOQs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjWCy7Fe7UgLBcn1f6Vjbm41RJQwFzQR6cD9UJ3TVOew&oe=6A8EC9BE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXVl6TzldvwQ7kNvwGfJnqX&_nc_oc=Adoa-tP7853QC7j80DjDDIEeUU2iVFQhCZGjLL-qMODMtUJzJS7-NrOVAfHzr4Sdf8I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBx1nrqbz4Jn2dc9wAH0TP59OupDr7dy88DmQ2aica7A&oe=6A8EF618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6VGnoJwpzwQ7kNvwFhAce4&_nc_oc=Adr_BWok3ao5d5pO-Z_bsBhD1S-0tNtXDW_n3Ck2Qkjs9PaJk6Trm_r6qtxDfgEaxpw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY38ljI2GDr9taAEKlA4Pq-l3BaDMvjOyiU7YFeBTx6g&oe=6A8EF261"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "
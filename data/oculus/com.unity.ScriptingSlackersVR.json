f20f&oh=00_AQKeiJeiLbUQZxmh6aBjTApeyxPtU73QpEb_6-wnyVvwng&oe=6A9C2A19"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQGyZJpV56cQ7kNvwEiC5h0&_nc_oc=AdpuWgkHZ5-8oV71YOoqF6fCcs6QGMJMW8vKdWpibbz_-rJOGLt-cYlpTkETgoNt9V0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfRaAHU2Efq0QVwsBI4zAfR0dZJpLDvA1k5cjPGB2vGA&oe=6A9C0F6A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9saCrdSjcdQQ7kNvwG_Zz6T&_nc_oc=AdqiZ9cS5HZ21prTfwPOSG1Bx-AW97Z4p72hzdiMb-nCB9fFg5AhwmZDy1xpvTPBOFU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb5uMShdyRFlAJkJ_uewAMGOAd9weOTvspVI0XCF6vNA&oe=6A9C30FE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYtiuNUSjEcQ7kNvwER1tjF&_nc_oc=Adq44b7I6Wga1Ov4mAwwy4MMyBtey-Qu6hrI1-hajqbibB6OEZ-7uZxlVCbNGHrZ2UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMNyvK9TEozq9YjhXpBMz0nsZYj9rMoCOSpmeKZQnFJg&oe=6A9C2518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZkE5fB0Zd0Q7kNvwHohbe8&_nc_oc=Ado0Es4LPMF7-Ko8nBruAjYGIsMPGoRiRWx4rClClMBjhXiiZcNZDZtVCFul5-NmsRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8VVkJB0xfpxpWKwJBP4VbzpykC8o73uklgemPHVDAxQ&oe=6A9C2161"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
68656652649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo1FFzekbrMQ7kNvwHjoc_E&_nc_oc=AdliZ6zKt3GGTZH53HhTsLwDzrSyuteEvucaQwtmpg9r7FkVwqYr0i5iyE6X0kUCsxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxB_w7svAEcX8_4uZfdGXIRPaEaI68ehenkpHWp-cF2dg&oe=69BE75D9"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_lLzqVGwdYQ7kNvwGOASXb&_nc_oc=Adl8LjTsfwv49BZsru5mID-6d1IZQLNN9gxhfKnIAirf2ZfkfB6DZbjAO7voHQopYTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK-rhzK3v0gtax007AEWadaPw9AJOcC9_1cWXrvvbgww&oe=69BE936A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9UaBrsOphgQ7kNvwFJ2b8I&_nc_oc=AdmuM4T-wyPd4soD0vDEbug36UJHGb74c2Y3JlZj7IgfV8uv9FS1GOLHoVzyexdTC6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS5bQq0br1u3YjtgJIWLjOKgDsYpazllBM_f2HFxh3cg&oe=69BE7CBE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NW0a_08KM4Q7kNvwEfk6-O&_nc_oc=AdlWfc_p7lg6btkCSuXho01dnJ9tj_0K8nVU3e-5KxBQD_Ph-wyzsHCaBIvHOoQtCrE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHxmmivAvqscCUZRnxU5kD4ExWf4WXRSocsfIBsUcxwg&oe=69BEA918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDazU5cRj1EQ7kNvwF67hrU&_nc_oc=Adl50U1WF6Osja8TysSOC7uHRZScWjwH4CUxC2khqYlm6pDVZ8uDVunWxsZJzccEFBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaWPoi-qJh7LYSO9_yhQ9627J5NJEPI8LnU9tciTabzw&oe=69BEA561"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "52
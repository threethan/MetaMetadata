H-6Bla&_nc_oc=AdkUr7sT-9BCis7ReFpS5cQsgkF5uuzHq5Ei6fm4qmFIVsFovEYmwBBROxPU1pomt9Q&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuRf5X050MOhYT156N61yxL8GJff8CU2KxUBjJoARnRUw&oe=69A1926A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jCodGpAJikQ7kNvwGAGT6Z&_nc_oc=Adltz75ZjsjuNr141eLglOQmwxc2c_hPRa2kk9Z3ZwEof2rRhYS6apQGAeyRiYpRwyw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftecZGngJG_kfyyymRaBXb1mBdRMhnVL16lIHLaTFAo2Q&oe=69A17BBE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwzkVOmEx-EQ7kNvwHJZzvB&_nc_oc=AdkI6byfAWdB2bfhkc-J7_JfmqSWLmvNGKMst1KhLUpyHsYsAA07OOve-ytRAdP8O_0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv0iyAQ05BhtimBOEN-Gn5jhSHlSSCdwOFnEJpCw8kMYw&oe=69A1A818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88FpH-eQC80Q7kNvwEXIMM1&_nc_oc=AdnzLAH6Q4Yc-U5hitIpOLT7bhWuSZhdcuOjB1CeCq6APAcAgpbPYmBxxrna4N3ZqMw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfueiNBIu9e92CZnDCmYz_f6tvFEKAJPrQy4DmY7JE7KJw&oe=69A1A461"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10017382254978097"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1178662897376366"}]}, "baseline_offer": {"id": "1178662897376
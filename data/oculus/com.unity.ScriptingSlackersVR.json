f20f&oh=00_Af2FblIdGAHhtANCNGmt9DYL9mhOLW6WAZb4_o3w2AsTAQ&oe=69F36A19"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Il00FGb_9QQ7kNvwHeo0vK&_nc_oc=AdrH5oWF35QInLuqqNGteukytx7SwaqLIykUODpQhJZynD2XWK_P9muYHlpIavgpZMs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TJ9XLziLpyZuf78tn-N4eaQSQJaEXQC5K6bQ8bJk3AA&oe=69F34F6A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtlAbZDj8QMQ7kNvwEbS1Y8&_nc_oc=AdrzlQRvjt_M9C_aAMFzTXMSM7CdZDXNE41VIYRG69Gw8K-afFEt1q4eQ_lDAnlC8zg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KrId0uxG0FXh3cXEta69Pq6IkqytIvfafEV3IP89Jhw&oe=69F370FE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEfDWhmx2FMQ7kNvwG4ptB2&_nc_oc=AdqcMexcJOQGv1C63XY7hyYucXBxMOF6JJK4I9B5Vq43ahZN8tioX3pcot0SzWjrtro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RbdEbYlepEsCAfjcjISQpBu5Mrn8h50v8t8-4ccjYfg&oe=69F36518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAwZYxQ1nfMQ7kNvwFYOoI7&_nc_oc=Ado2CC-dffgyyxCsERi5TsB04BSEw8tWq9LvioIXlqykg9uB6yh9vpw8rj5wMyPk_Zs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2l0poqWv7AIfxQxw6Wl5xfyp0Am0rbrLf9Td4kGo7dQA&oe=69F36161"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
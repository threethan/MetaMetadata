f20f&oh=00_AQAh4HbrM51ASiX1B4lO5nNpDzavhoK14oZ22SqgdS5CDg&oe=6A68BF99"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y0NWCjxk6sQ7kNvwEJrD-Y&_nc_oc=AdoAB7VLLmqhzDxg3XtTmai3onEV4gQNn9nmnnC8gxtWhZ_4zzn20BpsJaLruOUDaj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM_tJIUmxYyjKrNPsVyC_OxREvgjPo_pvYj030W_zlGg&oe=6A68A4EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX4Hk4EAbOwQ7kNvwFcDcI7&_nc_oc=AdoOsTzQtyDCRp4RHfEl1BXViBRdmrVCbRm51pp4mRJgTFRicVgF6hOOgjKXNKKSJls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjqUZyM9-7UgNvb_KSsVomOsTqa2-kbUQmJNWK8BfZQQ&oe=6A688E3E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8t9Vz9pTR4Q7kNvwEbGcF_&_nc_oc=AdpmCecrZutges1ah1X02hqJHOTlfzGPNSBNddQLyOYVVv8txChoAqYa8DF7d7VGi58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTm43FS39fVOSLf2wxxs3tcO7a7EoGBhXFUE_TnKYSDQ&oe=6A68BA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nlov59t1EA4Q7kNvwEuP_Mj&_nc_oc=AdpD45C3MBhRmh7l8rEsvTAhJ8Aat78lYVHmLaGzd71DhPUMkcYuTu1reuTkb8TAUGQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnt0LjgVbp6QntL04wP8WWHxmQqfgd1D5G4E6dOozkpw&oe=6A68B6E1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
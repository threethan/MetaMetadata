68656652649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kPvWh28GnAQ7kNvwGgHMxF&_nc_oc=Adn-nKaUY_BMZAiZV141PGlJXG2ch2P5OMYVSNZzeixWF6fIkk02YzRNQxU0-oth1Ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHhYZ_QQiHF7VIg5xJ8qZ6QBwPtzwOUwVfnhOTeYGrrw&oe=69BFFF99"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZMrvSdoLLMQ7kNvwF-lTy0&_nc_oc=Adn2L_K7c1ESfeFK3bZvNa7LkJF1Zr3jEX6HkfIs8htOBtwRFFFM9IHhNKofe0fMqmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEgRX7lOsgBS7vojkHd6R1YUzhMorYhCN5kgN_FFbbRg&oe=69BFE4EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9UaBrsOphgQ7kNvwGVdaiv&_nc_oc=AdkTWPCoBDUBFHzyNvtjZ07wWgL26be6N8TygguG2Lkk_v8Uvj0z1ebEYFZ4Bc6WGIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyv4xnxqBPHeo_JThcB2aekV43nuBOzpMtB7S-4YHMFHw&oe=69BFCE3E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NW0a_08KM4Q7kNvwFNm9IT&_nc_oc=AdllaZwpy_n3cFfQB58XlvbYHyTiK573p-EqcRUsC1jXD4K_AHFTQsfEBaZABp7uo7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQIFKC2YqW_XTlHhSI1Ny5fOwfrv7IyodHns2M4ipiWA&oe=69BFFA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0_v_SIplfcQ7kNvwFuv7bn&_nc_oc=Adlr7WudLir6_nl68EzdOX1r3W-32xg0Iotr3fVNmHgpCl8913C27SGlOKm5j4EitBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtKNA0s9MifLNnnVmlnE8fYE33XdGKPI9ETgkyu9JO7w&oe=69BFF6E1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "52
f20f&oh=00_AQJV6Og4z465XKjVuRjlUhJ_rQARqXy4IkjnE4pcRpui6w&oe=6ABA7C99"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCgLCusLr4gQ7kNvwE3glCn&_nc_oc=Adpej5G1LNKC8I2sbkVGaKonEb-v_ulEmVuJ2uspxfP9e7W1xSU0OHDSLmHVaL5xUzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQMqDKhKpn7gjGLoFQ78dchlHnzMNiDUxYPRl-IvDu7w&oe=6ABA61EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ3LCKMAxt4Q7kNvwF0la6q&_nc_oc=AdoIAR4SFbXiZT88xBBhj-ymwR4MA8VEDuHa-BTNdA0S_oRENSG8_TAwQfbGDA02cD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9sq4JQLy6wDy0xEvYX7wfahrEGQhO1ipzf-tg0GCdyw&oe=6ABA837E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqG4OK1FkqoQ7kNvwFPYf5e&_nc_oc=Adp4YWwt51E9hf7QeNVoPSb60Y047VtpE1SIc5AVqrCULf0EvFrFEX7H7LBn_FK7C8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaGvh75ymTPM2WjzODFtw8FD6AWUF4JD8KQLT3M6MpwQ&oe=6ABA7798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM3PebCBXx8Q7kNvwEU4ewq&_nc_oc=AdpHNbDAlcRMb8x8ALyCAuFStotdwtpjFQ8BL8hf7wQ2Tsg4plkaXuwg7QUTUsBxEmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYCThx3znSJP3O4YCKKXXx-LlgciFM88RaR6gq3UQYsQ&oe=6ABA73E1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
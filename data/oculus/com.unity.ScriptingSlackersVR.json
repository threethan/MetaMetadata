5"}, {"file_name": "Map.png", "id": "1023368656652649", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IsZMZJ5IE8Q7kNvwFSqZUu&_nc_oc=AdrwdAM_JvqubLIwVSebOv_9N9UtaIpDfOFhdcuuthwrlo6Zthscbka3FtLXlUHbzUU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfa4gXPQ0n4zTzI-K53_4_9-VbWgA0_Ou0kS5cT7msZw&oe=6A8D7159"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzjQXS-GzDcQ7kNvwFmS6Hg&_nc_oc=AdoRhdeqaSGC2FsLc7UkrYQzi79PP8w9dBdtWidKBjYCS0xvuazAAZlNQC_5IsshzUo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjYWf7RpX5VN6yt7Dp4dKEt_r89oZnq55UL6uQroDjuw&oe=6A8D8EEA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT7A8mLAvnQQ7kNvwHMAXYd&_nc_oc=AdqBR1io_pmWbTr-TXpa3tIWVpOdpHR1DYeI7J5I8KBUf0t9G0AKiiZaaB-9Luv6-dc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnxoClR8_th2w22VA3likuvdkLKmRVm71ZjsfGZkUGfg&oe=6A8D783E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtaFhSoUzw0Q7kNvwGNcU5K&_nc_oc=Adoaj1Me2HpO7iYuX99uZuPUH2Hbu5pVC4aUsa82bHGJJP27FwqKxkJwHPRn-15xOI8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVh-w2frQUpFSSlh-a9lbw9YOgcfjaPgpCFXFbd_oPVw&oe=6A8D6C58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6VGnoJwpzwQ7kNvwGZRo9D&_nc_oc=AdpPqVm3POjxhI3izBbVwUuKGtvmuWmKnur6pZ8sQLXXNyix2FSDvrOIAqDecQ8rD3s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyLgMCieCzUF43Rl24QEedB6hHiT5YdUY8_4x1rjl2ZQ&oe=6A8D68A1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "
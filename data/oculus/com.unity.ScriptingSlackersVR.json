f20f&oh=00_Af9mGmDydwKiYUYayuTc3wfOgYoV7xELjEnW3H6Cq8HIyQ&oe=6A2AC919"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edsTyCDBJZkQ7kNvwH16w9b&_nc_oc=AdoolocX1Db2b9gpomw9pwL8rTPAV2-eVmRBG67NFF26P5xmF1Tkk1xahbcYBYdnesk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jDOlDRS1c7NctbFY7lIG6sOU_0_KJSD6Jfka_IL6Ugw&oe=6A2AAE6A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af22vDiZWRYQ7kNvwE5x8bg&_nc_oc=AdoJ0vd_80Al5ICA7J2_DJYZh8mao1XzOg8BsLXtizxm0H2al9xmACsxGXHmty3-G0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t_2otG0cZTPaAcX_kVf8yEclZduZSmQR0MxfVq8cx0w&oe=6A2ACFFE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rklRkv3tWEgQ7kNvwF93ooT&_nc_oc=AdoJqeT7qiP8RjzF3dRwYUTuKBR2yjfUEm1NTQLLZGKezykjcYG1usYhpOYukMeScLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M6mODCgQDwLyCs40tfzDcHVa3LgZmWmzl7k1Zhq43cA&oe=6A2AC418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnV7Py4hCZYQ7kNvwHIV1_N&_nc_oc=AdpWbL2KPTB1Wvp4nKK0F9XteswTcKojHvc1hxpMi7_x5tpwHY1D25jFSKqeKjgVlBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af831Bbx7Flru8Crt2zv2llAI4IcJZuQ6n0MUMViienjCA&oe=6A2AC061"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
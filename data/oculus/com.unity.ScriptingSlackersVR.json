e_name": "Map.png", "id": "1023368656652649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnpSJvR3tgwQ7kNvwGrise0&_nc_oc=Adr29Hvmv47fMKsmge2da9m9Vlmatwh5L3_rNPDuwUiImqxxxYA4rOTOnBF0HqHjpeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVO-6PTXsMoQ3Oc--kjf-7dejJvCtoDDmCHqRkXHyKxA&oe=6A82E559"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NNdDhjrNCgQ7kNvwHzR9s5&_nc_oc=Adpm5A6k_VItmziFx_vlHSpMsGWqh8ubJ1X3xtBHEAJKNDaRY6EcxGEFevHpkIcVD7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpdywrk7k6O3YT-LL17ExojjnuhUFr1Voz0Q8H-Phglw&oe=6A8302EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uSl3REtE7sQ7kNvwEcf9Zl&_nc_oc=AdqjHaVYV9EDt5OK_sMLDMG2Q7l9tEiSalNNBpS67hxaEO5q3zBZuITyVzDkicR6xs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEhbc3OcTWY_FGmkRnHgu98GCv2CBuyy8Y69ELssnjGQ&oe=6A82EC3E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twf6oj5mBqgQ7kNvwGdwWM6&_nc_oc=AdqNuohDtTKjpEtGccKp7a-AIO87DdGwxEJZze4nm6CzUN4_jS71d0y6zoN6zRq07M4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGKKSSptRmV97vwXksDzIG0SpfQx2jZoCO_FoPqsYdvA&oe=6A831898"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEIaOjfGZ-0Q7kNvwF-L8bb&_nc_oc=AdoLAl-sLyzPg1Lv5EPwDWFmubstwqHrBanbaVKYK0H2_zTSdj0Q_gaTZ4egF4pVcrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkpDyELCJ6hYDMPO9zu9yeuW5j55MYtiwYi6QkUiP0IQ&oe=6A8314E1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
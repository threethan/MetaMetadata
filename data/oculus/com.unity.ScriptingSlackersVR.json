e_name": "Map.png", "id": "1023368656652649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLJhXTNDYqIQ7kNvwHp7Fxf&_nc_oc=AdqVTvMk2J6v56NKRyhzc1mXimIblPP2reYwGSPHJXL0sd-wmT5o7MtiuVp0LiiOmMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6pmquOInrUTnkHoDjJfDEsX8rIPgNQ5uSPJz9bvnXdQ&oe=6AC26599"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm0_G-KIOrQQ7kNvwGTvttl&_nc_oc=AdpOMml8QakAsZ5uBFqnL8Gt9nzMCDjUkOmevDfNR3OhNpgW-etphDqPhs-0BIbnkj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGtOtsXFHpi4Szaj7K8qUQ1E0WIud5T_AlTbYKhF1V6g&oe=6AC2832A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHYOo6uahWQQ7kNvwEPDXgm&_nc_oc=Ado4ZmKtS4Lyo6mMtHBtt-73IX7GxLb4Gn_nhcCuYuTYxaFfn2vJRm_IbcOeFMfAKU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYQSKv5Qmw2tpQxnFO28Ueof-p4K8RacObikMVV9I_Lg&oe=6AC26C7E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqu5W4oj2j8Q7kNvwFinJ1Y&_nc_oc=AdoHTfx6b8DG8UDWBV1F3d-TMX78VOTG1BbdyrmM_Evfq5tAdsoKubeJlOo6XogF12Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe-2O1K5jw9o8fnefQWHN1JsHdA0k_AoQQN3LC78HtNA&oe=6AC26098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRQufAQn4ewQ7kNvwGei8vg&_nc_oc=AdrB_6tTGR_FlvBQiw1upeRJwLTu-jtKX2sAKIzpr0kjKYMdION-S4Pbu4JCQwhuNeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz54cqa-VCCgxhQYsq01Mci8gl2S_SchjsNDW7S3OrgQ&oe=6AC25CE1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
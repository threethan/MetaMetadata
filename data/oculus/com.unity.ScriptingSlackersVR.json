e_name": "Map.png", "id": "1023368656652649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52GSg28YgXIQ7kNvwEuTIvu&_nc_oc=AdqSMztcMvLmoTGlnbQGu_1ZQHkGjdHcXUNzfL7fG33svjhynC5IDibJxJDjTUF_4s8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZzVOkUJDSkipfpYSD75woQv5vuBUaqnsIVdN5xsoMNQ&oe=6A75EE99"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7GCq9YPD9QQ7kNvwHeA3di&_nc_oc=AdrO58plz5x5nII6VXc8sBhh2hrn1HymDcubhV7rDnIklIAD6q7bnkJI6uMMpj0t33o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcLBRs_R9Kpf1Ml0A49ZTC6CzudZ5EzTYhO2i29eO_UQ&oe=6A75D3EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qikeQCwPdbQQ7kNvwH6Wv3s&_nc_oc=AdoBoF2Hz6yOeyvpu6RpAnvlUutpBCpd_-yAvW44LzassNUSuQMfNh11ZImXRxdplXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOu6cWxdiQql_vWWqC94GHCgqaurFt6to8WluPAMB0sQ&oe=6A75F57E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lxvCA5g3XkQ7kNvwHNIwf2&_nc_oc=AdqDtikUc2uK0zQtNxGx2jvViz8ykLI8xZuCTzTXtsS90TP6Xs-7VAtu8nbqT4RXANs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH12WyTB5yJd-x7l4UDNRshYBR3DPyF4VB9NXxpU6vjbA&oe=6A75E998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL3mgkdze-sQ7kNvwEc8Ymy&_nc_oc=Ado836HkL7_IpB1HdPn01mqrlEHnzDL-eCAPLR9ceYmSgAqvI7lM4jtwBrkCCLsYifU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs2w2lg-afFRoGREvH3phdbHiBQ98Uh8QyRbbx1cT1ng&oe=6A75E5E1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
5/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvqNYbpKYLYQ7kNvwG2EdaY&_nc_oc=AdnJ-NLJAJZM_w-AphwZv8Y6rIlWNJ1dfVOlbVmXHCOVlLOw9qBXjSssJBPmAzsdEJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiXKEbOtFR8NYbGgUS67MMkaxeO3NF0bUtyBV0PXRtVA&oe=69A2C659"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgMIFIbQH1AQ7kNvwFZ-I4t&_nc_oc=AdleLWFypy2yZeJDCySnqeGQrqI334G0x3jSEuGMcb0S5RRk6NKZ7xvxZBoTlNeO6eY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJj46L2IcuDtGkTqLbcX8-CqWbCcYcYtBEFI3g7xFiyg&oe=69A2E3EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jCodGpAJikQ7kNvwHVH9dC&_nc_oc=AdnLH-s4BVNfy66UwZhR8-7WHTCwc3M65eJCwbmN8_sR6DBigLIQPHMNdKwPvsdXp64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvytipsohZOJCoZIM1gII80LG-yQqJEYBpmk6LzSEMrw&oe=69A2CD3E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwzkVOmEx-EQ7kNvwHnTzjn&_nc_oc=Adkkq7hojgf-7kxnSCyiGWmM_HH1dgp3FgJuZQIlKLJu_nYVz3UZr9XFjJ8FIE9OqC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFQ5iFz3lDQO_0D2ML5DOO4RdCiCVwsuz0eTuAR_doyA&oe=69A2F998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88FpH-eQC80Q7kNvwHx0iB8&_nc_oc=AdlG3POcrcKbs1AJfnaKHAkqjHvP8v1pHwZxZZ_dsZGo-eH9iOuQKi4Ge-htib3eOw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGsMA0_mShtzouizyPPEF7GWRFdRdRHhQO_n89bEhnPQ&oe=69A2F5E1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conne
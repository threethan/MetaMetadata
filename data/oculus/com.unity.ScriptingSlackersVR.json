68656652649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB6dlfhQlgwQ7kNvwG8r0mJ&_nc_oc=AdmV3lvB5_aYZr57peBYrgkU8jEabcXSJMQgtev4xPGpCen774Q1ce2pSsXa8waca0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuqq_OspiAO9UQiD__bcMgU0ymG7AkSKmlp9PT9z3kCwQ&oe=69A99619"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cuYufRL5nEQ7kNvwHResoq&_nc_oc=Adltxn0u7mGmVpBoo0u_3OVnbf1wj440eUkIpVsG9_VQG4eqfhdXYghDltGXAl8PYgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsyZg9GXFAyFvLBOgNV3UG1eHwujDjhxRBFitIF_0T_zw&oe=69A97B6A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc4XQ2sdfO0Q7kNvwEbA4Up&_nc_oc=AdkPY_02XfM8xQN4S8zVKtawBTfOPDml4ZhvPsQPsPpr729J2mrtIU4FLt-QJAnnCKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuu6Bkp7DaLE5hO_uD4lym-biN6KfErasJiEkbFBTg-hA&oe=69A964BE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So-QpCThDJ0Q7kNvwGx00kj&_nc_oc=Adnc99lK6IJ_n54-1SYeoSdy1hTdAxErM1odfER6zlpPaFYVYesxoJLdeShvdqdwZ10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfveJnfy4hw3-nTLOllQ17jDGAha7iSEfzbtMO4yW0C8Nw&oe=69A99118"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXMgCpICm6UQ7kNvwHWSMoU&_nc_oc=Adnp2wy-tWs3j2COVU8aPjNQUSvMqK-CexX5RpONEpmiB-4H6ouwYfdbJyYeRzqqBt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvqV-YwOB23HKLhWH9F3Cr6CRfZe2YjpDI57hKq1vBhig&oe=69A98D61"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "52
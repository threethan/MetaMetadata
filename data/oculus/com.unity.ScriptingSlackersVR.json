f20f&oh=00_AQGLN9rubzc41RaqLqqeH2I9BdrPbywubMZhlUIbC4k_Vg&oe=6A71FA19"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNm4IQXQ-pUQ7kNvwE16Obc&_nc_oc=Adp-3HzXz55C5CA3bnRGZJBLM36YoCgMcSy3kCKj0v_nh-7NLa6BWQXZZppL3WS5h78&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESYaBp4sHwKSCxl1cIMHC2gcKIADyWDyYNtvkS6EwTow&oe=6A71DF6A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK3ul2sU_ScQ7kNvwH_TzzV&_nc_oc=AdpfnG3NlC7nZ3vj9nqy_onyOzBepNRXxXZMVBzzqqyOGtTwDAOYzUbp3nMrNku_Yxw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhPsBjtsJ_1tAopLs58Pr2ryhCxguG5lqteobFosCe2A&oe=6A7200FE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SttublaIGXYQ7kNvwED8D-v&_nc_oc=Adr473A48IByDlQBotZI6R9n0ZVIRPc0Lxrjdz3U7byfdsuHKBhP5lWyuG2x6hrYCR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY8NU7xozp6QY1VTD9fAV95KeWWkCGG8tZ776K8FtoRQ&oe=6A71F518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUjKujiZo7UQ7kNvwHl4m7E&_nc_oc=AdpY5HeOc9ksClGxdRqoti_c2kZEJ9V9uq48pUpBV0lJ2S5W1fxOPLTU7WnwTZGLDA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3YA0LXv2X3JGclaLLtb5pEpS1KK3WdM5p0IplduSXuw&oe=6A71F161"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
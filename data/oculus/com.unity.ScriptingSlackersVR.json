f20f&oh=00_AQEP3AbrWQ9qh_bFzTK8-yvAVkdImyqxn6WfMIK9c98ehw&oe=6A749D19"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNm4IQXQ-pUQ7kNvwHEAlJH&_nc_oc=AdqwjD04d-W7xQy5nC_njze3ZKvwWK0imsObHg-Swk453xQ71sWUNYisX-rCpC1cTNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcfsH0qw1yqFldUMG1srKefEpcxKGbajOI2_ehOXN6pg&oe=6A74826A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qikeQCwPdbQQ7kNvwFo6QJe&_nc_oc=AdrCJV_n9kBqnkWei3f_OwKxcBwQhG3MzwW2_wAMC9gHzox4xR-WbRybYTb0cK1XjUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYBer0CQgO7kp03IAm-ZroRsfeUUhN5orT1dg8EVovgg&oe=6A74A3FE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lxvCA5g3XkQ7kNvwG0Uh_o&_nc_oc=Adr0uuaAoiudz72VvZ16MAM5R0TwV1yfUCjIRuuYOAgS_3M3VhgG-bjzbX3czdw5Ok4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWpt8g7nLMY9qHy3AZhYjAnHVG0KK0umv5-qIbj38atQ&oe=6A749818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUjKujiZo7UQ7kNvwGLEVSR&_nc_oc=Ado_kJ3Bej1gti6L6JxZwB83EnmOjoG5Obj4MyTPT4REQ3T4BYzLsVBzD68FODmKLZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETtc5EgVsoBa1KjeusBT4OACr95Wrd0luEEXmohlHMrg&oe=6A749461"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You are gonna to need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
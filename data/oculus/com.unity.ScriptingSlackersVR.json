68656652649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOvrzIVHibkQ7kNvwG-te91&_nc_oc=Adn8Di3fbKeR5-IOGL-cKKpr5m6t_X890diPML3izfc02HM52x4aQhBCS84Irbdq_OI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoucH6xoCAap2oTI3fsmKMn8_psjopDGFyor0IvzKLfg&oe=69AC3919"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc-xc69jUnsQ7kNvwHrU2AU&_nc_oc=AdmNRSI4N1PRmG2b2RRB_EJipGzlbjduVclNQn-khVxY_HGwbszkGcAH6BVvInxHKsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxxlzqrw_MZM8QAyyxJoQnfSrHVPFGMuzcojVmYlrCRKw&oe=69AC1E6A"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc4XQ2sdfO0Q7kNvwHPnsSx&_nc_oc=AdkTPtkuHcXrlyZYX6BYCQiTQUc_aMNDZecYmsAbRV57ngiQt5xwrsViWW5GeCklvhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF88r9UWsZihU71JJqqEdP0mQ63D0uYntjeCshqiC-Nw&oe=69AC07BE"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So-QpCThDJ0Q7kNvwFw939b&_nc_oc=AdnC4rzEe7WL3QS3mPZd1M3g_6jeum3mkCf6_IGX8lr-okNuLSvpjZS4mGn4iKVmCx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNIbPOqkfkkc9yC6Q5U0vzjQ--_jGGxu4q6TRSxLjbDA&oe=69AC3418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XyEKYtoUiIQ7kNvwErmxKj&_nc_oc=Adk2kb_SwH2nP5gMu3kX0PnDBha1NR6uaoh-zvaWXffVS9eg0nP0nbRMGY_p3EvOIXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3NId5i9VCZbiYnABmRVqAO_mM70fh3dMF0sGfnJyONw&oe=69AC3061"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "52
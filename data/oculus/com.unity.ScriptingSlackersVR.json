68656652649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825039_1023368659985982_7843781364262794222_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB6dlfhQlgwQ7kNvwGggkez&_nc_oc=Adn0Oo4dL-oTcANGUkYCTANdtig_bNCL9HCuWNDTfdsg3FGjff28zZZOxZHrWMiVeJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftQiRHRSDCigo7EPCtZizO3qqLhR9OLl81tZNplKTnwRA&oe=69A80C59"}, {"file_name": "Naked.png", "id": "1297801308381664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824618_1297801311714997_1574836694705023023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cuYufRL5nEQ7kNvwGx7nwK&_nc_oc=AdmglNX_YslaDqfSmspPNAut478R78J2v6k4MWzynCs9CeXgLWH-46PWPXPuphJPDOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftjOFtJ5UXQ7qZTxS9ZzzCsVrAaf9eTMv1gTZ16K7TvXg&oe=69A829EA"}, {"file_name": "DED.png", "id": "4099589893586587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507832394_4099589896919920_326185351851078226_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3L0UWZlTekQ7kNvwFzzkpt&_nc_oc=AdkkORX47eJB3d-mgQwwImMEuEOAc54DYQI3MwXAqQCkTjUD1CzgjMA0g1CEYLXr0Tg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftHwEJGRBmviw4E6JYiQcTnzj6pKSaFzVAR6XkwkCjdBw&oe=69A8133E"}, {"file_name": "Counter.png", "id": "2149114752205132", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307303_2149114755538465_48267184942900581_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuqREVNhCKIQ7kNvwEsSAr8&_nc_oc=AdmcjtxRXimPEIThdtBnCQCJEUXMvWGpGq_HOZc9NkFnyvC6A7sKeUBMWeHzlv_vuLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftH9_50WL2IeHqcdVOd7iOXm4HTK3sL4bn5R892mRLWbw&oe=69A83F98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "738201058771334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507818746_738201062104667_338732583358517658_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXMgCpICm6UQ7kNvwEsBMdB&_nc_oc=AdlqgfNcd13k7fnVyTHDmVW10_5w4uRFdz3bjpHll-6T2ijhM5JANqGSBhhA4jI4Hpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftFgNLoLlzxpaKF9UXK0iT0wMx8VFGotewBAx-GqiMRiA&oe=69A83BE1"}, "display_name": "Scripting Slackers VR", "keywords": ["platformer", "speedrun", "pixel", "spike"], "long_description": "Back in the day, I almost called myself The Scripting Slacker, mostly because I slept through just about all of my intro to game dev classes. But time passed, the vision sharpened, and the name Doubt Not was born.\n\nThis is the remastered version of the very first game I ever published (Scripting Slackers Origin). A chaotic, pop culture packed platformer built to test patience and inflict glorious suffering. What started as a simple side scroller quickly turned into a brutal challenge for all but its creator. Every jump is a trap. Every obstacle is a joke at your expense. Every failure is part of the experience.\n\nNow it returns, rebuilt for VR with sharper visuals, tighter chaos, and the same relentless spirit. And as you struggle through every moment of this cursed creation, remember the name. Doubt Not your skills. Doubt Not your sanity. Doubt Not your spirit.\n\nGood luck! You're gonna need it!", "short_description": "This is a remastered version of the very first game I ever published, now adapted for a virtual experience. The initial idea was meant to reference a bunch of pop culture and inflict suffering on all who played the game. It's a basic left to right platformer but don't be fooled, 'basic' don't mean easy. GGs everyone"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "http://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10046644142051908"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393444_715527497574073_6204363165940697754_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRDVmSZlnKQQ7kNvwGYM0TD&_nc_oc=AdlcShYoXWRQfQtmzmOaiSOMai9fHyq2Ucd_Hz9ZPGWO6nEXxFsbjkmHCL5scGdjD7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvVNJKELltou_NmKkQLG0HSeFlvBaFwvQ1Jvz2bxpBATA&oe=69A83200"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scripting Slackers VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1750196820, "lastRevision": {"nodes": [{"id": "9712646442118348", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9712646395451686", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1009650878011969"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "MiniLandscape.png", "id": "1334100484485436", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_1334100487818769_5605255927784698669_n.png?_nc_cat=102&ccb=1-7&_
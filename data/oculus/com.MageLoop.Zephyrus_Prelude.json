WhCMLmGf5xI8JRk8b7SVlc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9i_L-dWT4BuU9dyhMYGhuLprql42NM1ORYApKpo2FSQ&oe=6B099E7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZephyrusPrelude_VideoCover_2K.png", "id": "2657342657895072", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031425_2657342661228405_699582976185715733_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q4LfJK2GuwQ7kNvwFnvOwD&_nc_oc=AdoaZwn9WAZsKNyNCHB7MvzXNGXTwqVyKADd8KdmWv12AfUvhQPfpP1yYkQn0AdDJ60&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEYSVRosxH-ualLpr4QKd1SblDKvK5W98fLIt8O90Eog&oe=6B09A89C"}, "display_name": "Zephyrus Prelude", "keywords": [], "long_description": "You play as a mage, who is trapped on the verge of the logical and the magical. Learn how to find hidden chests, unlock and use your magical abilities to search for the way out of these amusing and enchanted ancient rooms, caves, and labyrinths. Cast magic at certain places and prepare for the unexpected metamorphosis. Open pathways with fun-to-solve puzzles, and defeat creatures in this relaxing fantasy adventure. Go for the adventure alone or gather company (LAN-multiplayer) to uncover the secrets of Zephyrus!\n\nDungeon crawler on three levels of adventurous fun with magic mixed in. Seven unique character designs and countless curses. Localization in 12 languages. A big old dice in order to teleport to certain areas.\n\n\"Witches, Switches... flying cats!\"\n\nWe're excited to invite you to join us on this journey and look forward to your feedback and ideas to help us shape and improve the game!\n\nThis game can also be played in single mode and cooperative multiplayer mode on a local network (LAN/Wifi). Comfort Options: Snap Turn, Teleport, Comfort Tunneling (optional), Head-based locomotion. Comfort levels will vary for every player, and prolonged use can sometimes cause motion sickness and eye strain. Please refer to your hardware\u2019s safety guidelines!", "short_description": "Zephyrus is a family-friendly magical escape room game in virtual reality full of mystical and cursed beings. ...like flying cats!"}]}, "developer_name": "MageLoop", "developer_privacy_policy_url": "https://mageloop.com/PrivacyPolicy2/", "developer_terms_of_service_url": null, "publisher_name": "MageLoop", "support_website_url": null, "website_url": "https://mageloop.com/#contacts", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "sv", "en", "pt_BR", "it", "fr", "hu", "es", "ja", "pl", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8991773507510799"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974576_499266594478630_3212713623579683970_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okmqz9IiIdUQ7kNvwFxM0Ce&_nc_oc=AdoV4g8tMtHrZJd02iwD_3k24aNlKUJqLwLWJY4-fKGD09UvGwYRIzU3Ox5tIrtdtbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJsFCSbkMNtJ381P-ntZHV7tFDl9ldrAOQzTxYC2OwZQ&oe=6B099EB3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zephyrus Prelude", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27
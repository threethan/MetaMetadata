c_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKfUiQRKZTUQ7kNvwEDgA_J&_nc_oc=Adr_HWUSNyS8d0tTC_jP7xGr1km7PVcjkBuswBCYlcAT-MruzgTEY1w537S1t1FG2g0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM6tAoAswRAgslvHv-Pe81bAm4M_X6tiheubCGwcCV5Q&oe=6AFDACCF"}, {"file_name": "ZephyrusPrelude_2K_04.png", "id": "447055770282127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/229154367_447055773615460_7679644027065007351_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbxgVdHOrZcQ7kNvwHOWC7E&_nc_oc=AdqEv741WnuSalZQHV6ole_VtODM1dmp1U4x2zabD9Co-3gV_nBH0NVk6Oafy5xMpCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT__sGADBB4fLUQDpyY8OUgyGEdSxhfJ_TvFip7kYqwVg&oe=6AFDC0FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZephyrusPrelude_VideoCover_2K.png", "id": "2657342657895072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031425_2657342661228405_699582976185715733_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnTssXHpCTkQ7kNvwEIXIuo&_nc_oc=AdqGfBHrtRp-WesHzJcSZqqRpXlRHv2u189bQiFlJgGvzq69_vqpXZLcrYt6MjtEtmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyKe50P4gEFIxELUT6wHC3vJ0SoOysxULp7A1pd9x6-w&oe=6AFDCB1C"}, "display_name": "Zephyrus Prelude", "keywords": [], "long_description": "Welcome to Zephyrus, a world on the verge of the logical and the magical, full of wizards, witches, mystical and cursed beings. Become a mage, wield your power to escape from the clutches of your enemies. Gather a company to uncover the secrets of the world, solve puzzles, and defeat creatures on the way.\nSearch for the way out of Zephyrus. Collect and use mana to unravel 3-dimensional sliding puzzles. Be aware, at times it takes more than one mage to solve a challenge, acting at the same time can become essential.\nCasting magic in certain places - like touching a floating rune - can lead to an unexpected metamorphosis.\nBe on the lookout for hidden chests, who knows what you may find.\nThe creatures you will meet in the world are magical - curses, spells anything is possible!\n\nMore content coming soon!\nComfort levels will vary for every player, and prolonged use can sometimes cause motion sickness and eye-strain. Please refer to your hardware\u2019s safety guidelines!", "short_description": "Solo and cooperative multiplayer fantasy adventure with a single-player or LAN-multiplayer mode in a family-friendly fantasy universe."}]}, "developer_name": "MageLoop", "developer_privacy_policy_url": "https://mageloop.com/PrivacyPolicy2/", "developer_terms_of_service_url": null, "publisher_name": "MageLoop", "support_website_url": null, "website_url": "https://mageloop.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "sv", "en", "pt_BR", "it", "fr", "hu", "es", "ja", "pl", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1302447753909177"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "1428168462359183"}, {"status": "PUBLISHED", "id": "1374546894791504"}, {"status": "PUBLISHED", "id": "4445218315750685"}, {"status": "PUBLISHED", "id": "1516835486854524"}, {"status": "PUBLISHED", "id": "1791267758920584"}, {"status": "PUBLISHED", "id": "1593394826122727"}, {"status
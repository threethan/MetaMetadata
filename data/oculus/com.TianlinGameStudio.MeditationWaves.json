45nkNfw7gJbXIagJFlCqQl8qfE1A&oe=6AF9BCFF"}, {"file_name": "S7.png", "id": "1521117519842505", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604385997_1521117523175838_533706805762614057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyf8KWQ3dhwQ7kNvwGVz5nB&_nc_oc=Adq-8gnDINULdtHTWKQ59IqkIi2px6RSQlne5VOm9R7y3aybPffiCvb4Z7nOZ1NRrWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQldazJjRbwcuW39LoVJ_MHv3jEIG-czXZVhSoHxYbtrg&oe=6AF9EB98"}, {"file_name": "S9.png", "id": "2805134163214806", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596061819_2805134166548139_3278301589625312950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe4-B8VmUIsQ7kNvwFAziLn&_nc_oc=AdrMW3aZJ_TY6t0bPKA8QtCCRrWwDpkDkTXXAFMY9R9ECA4Goo0NPmJVx9W3q3X4N8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYAwaTJ7CdfEgODJCHxObGQWNq3sTZFztnwjvtQxhlnw&oe=6AF9E77A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s13.png", "id": "1569755554918023", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604360590_1569755558251356_8838077867903314336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK6GxNtFg3AQ7kNvwFAg3O8&_nc_oc=Adpzx0EglCZ3HOeaCUB2fqRCCX0PZu1lUH21b_SeqOgBGiSlmaOM5jN4R6NhcWHd_TU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMEws97kIMrqJWZCzsCqiV9bw_mt5_5AYb59FTkN2EzQ&oe=6AF9C9CA"}, "display_name": "Meditation Waves", "keywords": [], "long_description": "Find your rhythm and calm your mind with Meditation Waves.\n\nDesigned for comfort, Meditation Waves is a completely hands-free, seated mindfulness experience for Meta Quest. By eliminating complicated buttons and controller straps, you can guide your sessions and practice breathing exercises using nothing but natural, gentle hand movements.\n\nLearn and practice traditional relaxation techniques in an immersive sanctuary where every element moves in harmony with your focus:\n\n\u2022 Belly Breathing: Foundational deep breathing to ground your attention.\n\u2022 Box Breathing (4-4-4-4): Structured pacing to promote calm, clear awareness.\n\u2022 Alternate Nostril Breathing: A traditional flow designed to quiet a busy mind.\n\u2022 4-7-8 Breathing: A deeply relaxing interval technique to settle your thoughts.\n\nSimply move the interactive slider with your fingers, and watch the entire environment respond instantly. The gentle water ripples, opening flower blossoms, candle flames, and visual text guides automatically speed up or slow down to match your exact breathing pace\u2014creating a seamless, soothing flow tailored perfectly to you.\n\nFeatures You'll Love:\n\n\u2022 No Controllers Needed: Move, select, and adjust everything using intuitive bare-hand gestures.\n\u2022 Effortless Control: Tap menus directly when close, or sit back and use a gentle laser pointer from your hand.\n\u2022 Personalized Space: Adjust slider using your hand to place menu exactly where you are most comfortable sitting.\n", "short_description": "Find your rhythm and calm your mind with Meditation Waves, a completely controller-free mindfulness experience for Meta Quest. Practice traditional exercises like Box and 4-7-8 breathing using nothing but natural, bare-hand gestures. Simply move the slider with your fingers, and watch the soothing water, blooming flowers, and candle flames instantly synchronize to your exact breathing pace. Sit back, relax, and customize your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "https://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "810139357995560"}], "external_s
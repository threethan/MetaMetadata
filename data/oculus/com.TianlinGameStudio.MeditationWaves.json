_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN2L1PPzKqsS_YIXHts9hknyIEDM6LYkUvwvfVPrIJ6A&oe=6AFDC545"}, {"file_name": "S3.png", "id": "1352229027982090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/791586454_1352229031315423_648206650764255283_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZP4wy5BTDUQ7kNvwG94Aww&_nc_oc=AdonAbkYiC26DJ_QH_3piju4ykDmc66dXUzvUNRhrPmPKAZaBKjBrgmRHvhP9B2E3zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs8bBPeII7z5R2TUq850cVu9tN22rK3Hn7d9vueegIZA&oe=6AFDB17F"}, {"file_name": "S7.png", "id": "1521117519842505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604385997_1521117523175838_533706805762614057_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ1-pdtIZC4Q7kNvwEWCMqC&_nc_oc=AdrR4JZenlUuv73FJ1xKpNWqQVE3Ciz5MB7zCsK_Lm_QeFLR9wYkoWSWfProt5dVc8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDzEPnhyN77sAxdnKTExF3k72AVbhHECTE4mNQlyZNkQ&oe=6AFDE018"}, {"file_name": "S9.png", "id": "2805134163214806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_2805134166548139_3278301589625312950_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-VLLWP8dEMQ7kNvwHGol5W&_nc_oc=AdrlhzcPwPeBlJardN-JlZINErXsnO5Orih6kBcz6yiaPfNnnmmQ9YRyrOWT7tDUXcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7NKoOAjZkAUUUnJi7LJzoOmYpPLTgUn8yUSki-kzntA&oe=6AFDDBFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S17.png", "id": "1679493947039540", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673759338_1679493950372873_7704651289182607284_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95ECYtO7RakQ7kNvwH7hhn-&_nc_oc=AdqxBN3lavw1eUIcORGZBFd7-EoGiSm3akY6KYeNzLzDMFQE4FIA21yq-0-_CnxSqOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_R21xVSNyXowF7lEgtpWQratPhdxYd-gRJF8EYdtuTw&oe=6AFDC1BD"}, "display_name": "Meditation Waves", "keywords": [], "long_description": "\ud83c\udf3fMeditation Waves \u2013 Breathe, Relax & Find Your Inner Calm\n\nEscape into the peaceful beauty of a starry sky with Meditation Waves, a completely hands-free, seated mindfulness experience for Meta Quest. No controllers needed\u2014just natural hand movements.\n\n\ud83c\udf39 Intuitive Visual Breathing Guides\nLearn when to breathe in, breathe out, and hold with three memorable visual cues:\n\n- Smell the Rose \u2013 Breathe In: Follow a moving Rose and gently inhale its imagined fragrance.\n- Blow Out the Candle \u2013 Breathe Out: Follow a moving Candle and gently exhale.\n- Savor the Scent \u2013 Hold: Watch a Rose Petal resting on the water and pause to hold your breath.\n\n\ud83c\udf2c\ufe0f Learn & Follow Every Breath\n- Animated Vector Guides: See when to breathe through your nose or mouth.\n- Visual Sliders & Countdown Timers: Know exactly how long each breathing phase lasts.\n- Adjustable Breathing Speed: Customize your breathing rhythm to your comfort.\n\n\ud83e\uddd8 Four Guided Breathing Techniques\n- Belly Breathing\n- Box Breathing (4-4-4-4)\n- Alternate Nostril Breathing\n- 4-7-8 Breathing\n\n \u2728 Your Personalized Meditation Space\nWatch gentle water ripples, blooming flowers, and candle flames respond to your breathing rhythm. Adjust the breathing speed and reposition the interface closer, farther, higher, or lower to suit your seated position.\n\n \u2764\ufe0f Features You'll Love\n- Completely hands-free interaction.\n- Intuitive fingertip touch and hand-ray controls.\n- Personalized breathing pace and and comfortable UI positioning.\n", "short_description": "\ud83c\udf3fMeditation Waves \u2013 Your Personal Sanctuary of Calm\n\nEscape into a peaceful virtual world and discover the art of mindful breathing!\n\n\ud83c\udf39 Smell the Rose \u2013 Breathe In.\n\ud83d\udd6f\ufe0f Blow Out the Candle \u2013 Breathe Out.\n\ud83c\udf38 Savor the Scent \u2013 Hold.\n\nFollow beautiful animated guides, visual countdowns, and nose/mouth breathing instructions. Customize your breathing pace and interface position.\n\nExplore 4 guided breathing techniques in a relaxing, hands-free VR experience. No controllers. Just breathe and relax."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "https://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1138165178697343"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/806363909_1453276686987910_9189577380579370181_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAaDAZfpZUoQ7kNvwFrE3Bg&_nc_oc=AdoFdZNZg0FnrPP_xMPfFJr0Q1cd3Fyh95EWIB9Ew2vfrQK3qqyf7G3YFrTzPaAdrj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA9pMf7aFe12pNtIwC-A2FaAhRH1oaBJf7E1NMSKIGOw&oe=6AFDE23D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meditation Waves", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "36269
AF9D0C5"}, {"file_name": "S3.png", "id": "1352229027982090", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/791586454_1352229031315423_648206650764255283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yArZlfQ9qQUQ7kNvwEC8Krf&_nc_oc=AdoTP7y-9-JB3b5ivjZ7m22Adq1-UVkxvo8K-NbzcAURdHK_zDhQs8gkLbp1kxC0wQM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNlYJ2Ta49VwGfWX45nkNfw7gJbXIagJFlCqQl8qfE1A&oe=6AF9BCFF"}, {"file_name": "S7.png", "id": "1521117519842505", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/604385997_1521117523175838_533706805762614057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyf8KWQ3dhwQ7kNvwGVz5nB&_nc_oc=Adq-8gnDINULdtHTWKQ59IqkIi2px6RSQlne5VOm9R7y3aybPffiCvb4Z7nOZ1NRrWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQldazJjRbwcuW39LoVJ_MHv3jEIG-czXZVhSoHxYbtrg&oe=6AF9EB98"}, {"file_name": "S9.png", "id": "2805134163214806", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596061819_2805134166548139_3278301589625312950_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe4-B8VmUIsQ7kNvwFAziLn&_nc_oc=AdrMW3aZJ_TY6t0bPKA8QtCCRrWwDpkDkTXXAFMY9R9ECA4Goo0NPmJVx9W3q3X4N8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYAwaTJ7CdfEgODJCHxObGQWNq3sTZFztnwjvtQxhlnw&oe=6AF9E77A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "S15.png", "id": "4787789604787208", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312231_4787789608120541_4324511784154837676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCoSAWCEVGoQ7kNvwFtcIzX&_nc_oc=AdrJZbz3HJQoloOkC5PNmaTRLvhkSFkCDXcpEWbu1QMkTK1kdm7uRz0NIdyN9ZmlkAc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3PPAepBn0SS9g9QZ0nzrVZUQHtpVunQWZMdj8Nwf1Zg&oe=6AF9C1A3"}, "display_name": "Meditation Waves", "keywords": [], "long_description": "In the absolute stillness of a starry sky, breathe in synchronization with the cosmic tides. Designed for comfort, Meditation Waves is a completely hands-free, seated mindfulness experience for Meta Quest. By eliminating complicated buttons and controller straps, you can guide your sessions and practice breathing exercises using nothing but natural, gentle hand movements.\n\nLearn and practice traditional relaxation techniques in an immersive sanctuary where every element moves in harmony with your focus:\n\n\u2022 Belly Breathing: Foundational deep breathing to ground your attention.\n\u2022 Box Breathing (4-4-4-4): Structured pacing to promote calm, clear awareness.\n\u2022 Alternate Nostril Breathing: A traditional flow designed to quiet a busy mind.\n\u2022 4-7-8 Breathing: A deeply relaxing interval technique to settle your thoughts.\n\nSimply move the interactive slider with your fingers, and watch the entire environment respond instantly. The gentle water ripples, opening flower blossoms, candle flames, and visual text guides automatically speed up or slow down to match your exact breathing pace\u2014creating a seamless, soothing flow tailored perfectly to you.\n\nFeatures You'll Love:\n\n\u2022 No Controllers Needed: Move, select, and adjust everything using intuitive bare-hand gestures.\n\u2022 Effortless Control: Tap menus directly when close, or sit back and use a gentle laser pointer from your hand.\n\u2022 Personalized Space: Adjust slider using your hand to place menu exactly where you are most comfortable sitting.\n", "short_description": "Find your rhythm and calm your mind with Meditation Waves, a completely controller-free mindfulness experience for Meta Quest. Practice traditional exercises like Box and 4-7-8 breathing using nothing but natural, bare-hand gestures. Simply move the slider with your fingers, and watch the soothing water, blooming flowers, and candle flames instantly synchronize to your exact breathing pace. At the center of a vast, starry sky, your breath controls the cosmos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "https://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131403739373487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312257_1284214000537368_270325845455834497_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu5GYAl1fowQ7kNvwG6sThP&_nc_oc=AdqD5PBFwS1biz14SQ7UnVyFpkp-tqZT3L9m8ik0FjDBuWXItFuxfb2U1uhbYvFHZXs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8F5s6phaTgWXQZ7k6vZezmoyEbEidLhl6-d94VLfm0g&oe=6AF9CD0D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meditation Waves", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1793982600, "lastRevision": {"nodes": [{"id": "1098927412621120", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defa
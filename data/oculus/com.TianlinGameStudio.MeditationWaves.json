dp8tMD7vX3CXu0XRDlidFNLz2S6NOxxOMmtX5BCHSpRJBkTMgN8Nvuq9JlUKNAsmug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN2L1PPzKqsS_YIXHts9hknyIEDM6LYkUvwvfVPrIJ6A&oe=6AFDC545"}, {"file_name": "S3.png", "id": "1352229027982090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/791586454_1352229031315423_648206650764255283_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZP4wy5BTDUQ7kNvwG94Aww&_nc_oc=AdonAbkYiC26DJ_QH_3piju4ykDmc66dXUzvUNRhrPmPKAZaBKjBrgmRHvhP9B2E3zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs8bBPeII7z5R2TUq850cVu9tN22rK3Hn7d9vueegIZA&oe=6AFDB17F"}, {"file_name": "S7.png", "id": "1521117519842505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604385997_1521117523175838_533706805762614057_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ1-pdtIZC4Q7kNvwEWCMqC&_nc_oc=AdrR4JZenlUuv73FJ1xKpNWqQVE3Ciz5MB7zCsK_Lm_QeFLR9wYkoWSWfProt5dVc8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDzEPnhyN77sAxdnKTExF3k72AVbhHECTE4mNQlyZNkQ&oe=6AFDE018"}, {"file_name": "S9.png", "id": "2805134163214806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_2805134166548139_3278301589625312950_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-VLLWP8dEMQ7kNvwHGol5W&_nc_oc=AdrlhzcPwPeBlJardN-JlZINErXsnO5Orih6kBcz6yiaPfNnnmmQ9YRyrOWT7tDUXcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7NKoOAjZkAUUUnJi7LJzoOmYpPLTgUn8yUSki-kzntA&oe=6AFDDBFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s13.png", "id": "1569755554918023", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1569755558251356_8838077867903314336_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asLYBexBLYkQ7kNvwGXuJQ8&_nc_oc=AdqfXw-iUmvC7XsB2NIMB1TMW64ah7WBfV26X6-3h5hGlmBSyaPltvUIe-oisqrdjYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoMBpI-wVpmZ3Jej2zqP40db6DptMCVd7cnh8DZw1aQQ&oe=6AFDBE4A"}, "display_name": "Meditation Waves", "keywords": [], "long_description": "Find your rhythm and calm your mind with Meditation Waves.\n\nDesigned for comfort, Meditation Waves is a completely hands-free, seated mindfulness experience for Meta Quest. By eliminating complicated buttons and controller straps, you can guide your sessions and practice breathing exercises using nothing but natural, gentle hand movements.\n\nLearn and practice traditional relaxation techniques in an immersive sanctuary where every element moves in harmony with your focus:\n\n\u2022 Belly Breathing: Foundational deep breathing to ground your attention.\n\u2022 Box Breathing (4-4-4-4): Structured pacing to promote calm, clear awareness.\n\u2022 Alternate Nostril Breathing: A traditional flow designed to quiet a busy mind.\n\u2022 4-7-8 Breathing: A deeply relaxing interval technique to settle your thoughts.\n\nSimply move the interactive slider with your fingers, and watch the entire environment respond instantly. The gentle water ripples, opening flower blossoms, candle flames, and visual text guides automatically speed up or slow down to match your exact breathing pace\u2014creating a seamless, soothing flow tailored perfectly to you.\n\nFeatures You'll Love:\n\n\u2022 No Controllers Needed: Move, select, and adjust everything using intuitive bare-hand gestures.\n\u2022 Effortless Control: Tap menus directly when close, or sit back and use a gentle laser pointer from your hand.\n\u2022 Personalized Space: Adjust slider using your hand to place menu exactly where you are most comfortable sitting.\n", "short_description": "Find your rhythm and calm your mind with Meditation Waves, a completely controller-free mindfulness experience for Meta Quest. Practice traditional exercises like Box and 4-7-8 breathing using nothing but natural, bare-hand gestures. Simply move the slider with your fingers, and watch the soothing water, blooming flowers, and candle flames instantly synchronize to your exact breathing pace. Sit back, relax, and customize your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "https://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1098927405954454"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1821464239061033"}]}, "baseline_offer": {"id": "1821464239061033"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793982600, "status": "PUBLISHED", "id": "1821464239061033"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1129720692875125", "version": "1.0"}, "id": "2152227175374027", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1098927402621121", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1129720692875125"}, "release_
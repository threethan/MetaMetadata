-25/491822550_1392976464940046_920535681472284622_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdGBvBU49XgQ7kNvwHQeFar&_nc_oc=Adk-FCARcT_AY3WY8-saNgmR44gmqoOpXyS4-WW3oXV1Jn_fHh9KPDFJsSvjs4T6UkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVcrmt3N4G9IUZWJuit7cfGxJTB9DG12ddxDHqijbNeg&oe=69AEBCFE"}, "display_name": "RAGER", "keywords": ["RAGER", "Combat", "Rhythm", "rage", "action"], "long_description": "Hand-picked by **Meta** for the **Oculus Ignition Program**, an honor extended to only a handful of VR projects, **RAGER** is the VR melee-rhythm brawler that hurls you into a roaring arena, sets relentless robots on you, and lets hard-hitting music power every swing, block, and dodge\u2014each move sparking to the beat as you rise to become the ultimate RAGER.\n\n# CAMPAIGN\nA \u200blinear run of **12 hand-built levels** including **3 boss fights**. The game picks a different weapon for each stage, so you\u2019re forced to learn every fighting style. Every level offers three difficulties and its own high-score board.\n\n# FREESTYLE\nA second set of **12 levels**, all unlocked from the moment you start. Pick any weapon you\u2019ve earned, set the difficulty, and chase high scores without limits. Perfect for trying wild load-outs or just jumping straight to your favourite stage.\n\n# SURVIVAL\nOne wide-open arena, **endless waves**. The longer you stay alive, the faster and meaner the robots get. Last as long as you can, then try to last a little longer.\n\n# LEVEL EDITOR\nLoad any **song you like**, drop enemies onto the timeline, and jump in. Tweak the pattern until it feels perfect, then play your custom level for high scores.\n\n# WEAPONS\n- **One-Handed** - Sword & Mace\n- **Two-Handed** - Axe & Hammer\n- **Close-Quarters** - Claws & Fists", "short_description": "Hand-picked by Meta for the Oculus Ignition Program, an honor extended to only a handful of VR projects, RAGER is the VR melee-rhythm brawler that hurls you into a roaring arena, sets relentless robots on you, and lets hard-hitting music power every swing, block, and dodge\u2014each move sparking to the beat as you rise to become the ultimate RAGER."}]}, "developer_name": null, "developer_privacy_policy_url": "https://insaneprey.com/privacy-policy-for-rager/", "developer_terms_of_service_url": null, "publisher_name": "Insane Prey", "support_website_url": null, "website_url": "https://insaneprey.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30343481935251348"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "1403230051131613"}, {"status": "PUBLISHED", "id": "3743553612619019"}, {"status": "PUBLISHED", "id": "1834748660478147"}, {"status": "PUBLISHED", "id": "754858904115868"}, {"status": "PENDING", "id": "939720347826170"}]}, "baseline_offer": {"id": "754858904115868"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1403230051131613"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33653090294290479", "version": "0.8.0"}, "id": "249149524829837", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typenam
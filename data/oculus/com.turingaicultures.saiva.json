kp1oJ4b_k4tOD9Gex-fMM7De2FaQZljSzTCal_31w&oe=6A6B4E77"}, {"file_name": "screen_2560x1440_2021-02-11_17-11-44.png", "id": "329248201831724", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982454_329248205165057_3368797503949159349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abGoY-yDkKYQ7kNvwFMueZI&_nc_oc=Adp6TbfhPd3Lh3iWp9ecLnbHtHjP0UAjrF1_vqYnvlBVCJikarerjUPAyryTK6-ctJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8nq8eXlvZ4-VW1xnRL0VxxLAVMDSeA5B7giLNOmjJvg&oe=6A6B5644"}, {"file_name": "screen_2560x1440_2021-02-11_17-09-43.png", "id": "181877713273987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031442_181877716607320_673247922973513878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzSBlNZZ7PkQ7kNvwGjWXhg&_nc_oc=AdrBmvq8RigLE4m7pa1XQ-RdHqKEHueOj-3xP-4v6OJdha0mEz39q6Kgtu5bYXz9dhg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQAOVJiO4lf87gH0kDGNWwpYEAw-r-Dl98WJtL4nZQBg&oe=6A6B4C28"}, {"file_name": "screen_2560x1440_2021-02-11_17-23-04.png", "id": "163104352108665", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974899_163104355441998_3112624760032388224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=makRbfnYHHAQ7kNvwFM-hE3&_nc_oc=Adon87Rmnihbq3RlmxT09R3WK_BklSU0U0Fgf5t1StKdcldZ__23K0dkA0ERTHvB8Yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLK0CyOtYes5_Mn3JCDVptixi2FeFXCkSdrHOFifu_vg&oe=6A6B4F18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1408974982780204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035327_1408974986113537_1806111711424974479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1Y-b6K5jj8Q7kNvwGbSAV_&_nc_oc=Adrn1-IQUJIakJ8pGtBgojM-TPLT5bgZmOqyJ5bvaDWBvigPpVwj32AA_JH9FZDsqjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA7OYuFxZNUcqqqxRCcMkNzv2xWxbqRvpHLVjZxKaCPg&oe=6A6B47AA"}, "display_name": "SAIVA", "keywords": [], "long_description": "A technical tool aimed at professional coaches that want a deeper analysis and understanding of their replays\nTraining in 3 steps\n1. Identify the action to train with your team\n2. Create the action with Easy Sports Animation\n3. Upload the file to your online SAIVA account\nBe it a standard play or a 1vs1 situation, feedback quality can be improved by repeating any situation from different perspectives and positions\nStarting from an academy level, all players interact, train, and play on lineal training methods. The problem with Lineal training methods is that they are not player specific\n\u2022  SAIVA helps players provide tailored training. Tailored training is designed to interact and provide input to individual players about their specific needs\n\u2022  This allows defining defensive, midfield, and offensive strategies and specific tasks for each of these positions\n\u2022  It gives coaches a wide-angle perspective and helps the players to see their own performance from a third-person perspective", "short_description": "Sector: Sports\nProduct Type: Software\nPlatform: VR + PC/Mac\nTechnology: AI + VR\nLicense Model: Subscription\nOrigin: Germany, South Korea, USA\nState: Production\nUsers: 3 to 20+\nSuitable (Club Level) - Amateur, Academy, and Professional\nKit Includes - Easy Sports Animation License,\nWeb Cloud service\nFeatures:\n\u2022\tReal-Time Collaboration\n\u2022\tDifferent Perspectives\n\u2022\tSpatial Memory\n\u2022\tUnlimited Replays\n\u2022\tComplex Scenarios\n\u2022\tTime Saving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saiva.football/privacy", "developer_terms_of_service_url": null, "publisher_name": "Turing AI Cultures GmbH", "support_website_url": null, "website_url": "http://www.saiva.football/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}]
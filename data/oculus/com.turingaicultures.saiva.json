4.png", "id": "329248201831724", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982454_329248205165057_3368797503949159349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxKdtyYNa1AQ7kNvwHIZjKW&_nc_oc=Adp_egrvYcDy8QDE0nklaYoPHrpPpgG1q8-c4U3YrHm2N1-Kefjm7UuXSsOvR-8xblo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe5RNyl0g68S3VAL7ihG4zO0jV9Ai3wt_iFBR9HIIEKQ&oe=6A7DCB44"}, {"file_name": "screen_2560x1440_2021-02-11_17-09-43.png", "id": "181877713273987", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031442_181877716607320_673247922973513878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxMuAxNgfXUQ7kNvwHsoreS&_nc_oc=AdpKkeU4HbexmNk5lT6WVJjyeWU01BsvPUzxBEyIX_e3MiepMNl-XicqhbQvB5d-K4c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeWJjbVPunAAEQZvtEHOE7RCXYDnmgWVsWBm2Qv-2dZg&oe=6A7DC128"}, {"file_name": "screen_2560x1440_2021-02-11_17-23-04.png", "id": "163104352108665", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974899_163104355441998_3112624760032388224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VCDmJE8ApsQ7kNvwH6PqGl&_nc_oc=Adqlr95P1A1MonHSFrFU_d2irjoEhNd9JCI8XhC_vev4d0iWNMTtgKappmXn9mB0tto&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW1ITLGnsI8D9_8wc22dAYb8mLWbPGfzksC7pWZNGhRg&oe=6A7DC418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1408974982780204", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035327_1408974986113537_1806111711424974479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7K_t_EJxnAQ7kNvwHMcSFY&_nc_oc=AdrRtUCVTbd3US-tMIJSsbZED29C2BOSIshkw_HSmrq1oWNJ29nSUaWZbRwCSA4on0U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB6551IUacfIurDhdltceGlWu_w3BGKhw2M6CGfAr1tw&oe=6A7DBCAA"}, "display_name": "SAIVA", "keywords": [], "long_description": "A technical tool aimed at professional coaches that want a deeper analysis and understanding of their replays\nTraining in 3 steps\n1. Identify the action to train with your team\n2. Create the action with Easy Sports Animation\n3. Upload the file to your online SAIVA account\nBe it a standard play or a 1vs1 situation, feedback quality can be improved by repeating any situation from different perspectives and positions\nStarting from an academy level, all players interact, train, and play on lineal training methods. The problem with Lineal training methods is that they are not player specific\n\u2022  SAIVA helps players provide tailored training. Tailored training is designed to interact and provide input to individual players about their specific needs\n\u2022  This allows defining defensive, midfield, and offensive strategies and specific tasks for each of these positions\n\u2022  It gives coaches a wide-angle perspective and helps the players to see their own performance from a third-person perspective", "short_description": "Sector: Sports\nProduct Type: Software\nPlatform: VR + PC/Mac\nTechnology: AI + VR\nLicense Model: Subscription\nOrigin: Germany, South Korea, USA\nState: Production\nUsers: 3 to 20+\nSuitable (Club Level) - Amateur, Academy, and Professional\nKit Includes - Easy Sports Animation License,\nWeb Cloud service\nFeatures:\n\u2022\tReal-Time Collaboration\n\u2022\tDifferent Perspectives\n\u2022\tSpatial Memory\n\u2022\tUnlimited Replays\n\u2022\tComplex Scenarios\n\u2022\tTime Saving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saiva.football/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Turing AI Cultures GmbH", "support_website_url": null, "website_url": "https://www.saiva.football/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SPORTS"], "has_in_app_ads"
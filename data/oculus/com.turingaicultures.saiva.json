44ynNf4_xqPDgDJu-WihVgAYMwORdEMphZJv3HeyQ&oe=6A60C277"}, {"file_name": "screen_2560x1440_2021-02-11_17-11-44.png", "id": "329248201831724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982454_329248205165057_3368797503949159349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNguJOM3MeAQ7kNvwFQSnBO&_nc_oc=Adpjof3G3MDxVJlba55wCDj5HugqdlEZxrtz8_iS3PJPtBHUgcjdlAVDdzykb_OONoI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOYJUFoWvqiB2dYTdDxANTN9CkLIHH2eTclP8R74ovYg&oe=6A60CA44"}, {"file_name": "screen_2560x1440_2021-02-11_17-09-43.png", "id": "181877713273987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031442_181877716607320_673247922973513878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qA0VaPgSPIQ7kNvwGT4Oph&_nc_oc=AdpvHz0Qm2r0psgfcxAVsGTCH5_rzTckQRsuUDLb9S_5_dHUOwmY0R5NWDy1PN9V0Ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6CYlzDVBylB-ePimG0_97rFLgIYkxfoQwoLBCJLm_ow&oe=6A60C028"}, {"file_name": "screen_2560x1440_2021-02-11_17-23-04.png", "id": "163104352108665", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974899_163104355441998_3112624760032388224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRLk-8HBDsoQ7kNvwHRE21I&_nc_oc=AdqHfuc8tcr_-nViXNKZqxdnXtn8s8k3zrx8E2p7wDaAJIQdq-Np5iXakcthU6Q80gE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAck0emxVXOAJWXLMIye2BO-0tGIEPxbXSrGtrnruxicg&oe=6A60C318"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1408974982780204", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035327_1408974986113537_1806111711424974479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GiQ3FJWhDoQ7kNvwHlMlt-&_nc_oc=AdpBjy4NuHQya0McmUISVobPKLhfK6yitmceg9lN957EpfPvrVJDVD5dmyqeAelJ4bA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnAYBBXpLc3biKhGQ77X0OHxhcXJ2YqDHdxGLRScz5rg&oe=6A60BBAA"}, "display_name": "SAIVA", "keywords": [], "long_description": "A technical tool aimed at professional coaches that want a deeper analysis and understanding of their replays\nTraining in 3 steps\n1. Identify the action to train with your team\n2. Create the action with Easy Sports Animation\n3. Upload the file to your online SAIVA account\nBe it a standard play or a 1vs1 situation, feedback quality can be improved by repeating any situation from different perspectives and positions\nStarting from an academy level, all players interact, train, and play on lineal training methods. The problem with Lineal training methods is that they are not player specific\n\u2022  SAIVA helps players provide tailored training. Tailored training is designed to interact and provide input to individual players about their specific needs\n\u2022  This allows defining defensive, midfield, and offensive strategies and specific tasks for each of these positions\n\u2022  It gives coaches a wide-angle perspective and helps the players to see their own performance from a third-person perspective", "short_description": "Sector: Sports\nProduct Type: Software\nPlatform: VR + PC/Mac\nTechnology: AI + VR\nLicense Model: Subscription\nOrigin: Germany, South Korea, USA\nState: Production\nUsers: 3 to 20+\nSuitable (Club Level) - Amateur, Academy, and Professional\nKit Includes - Easy Sports Animation License,\nWeb Cloud service\nFeatures:\n\u2022\tReal-Time Collaboration\n\u2022\tDifferent Perspectives\n\u2022\tSpatial Memory\n\u2022\tUnlimited Replays\n\u2022\tComplex Scenarios\n\u2022\tTime Saving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saiva.football/privacy", "developer_terms_of_service_url": null, "publisher_name": "Turing AI Cultures GmbH", "support_website_url": null, "website_url": "http://www.saiva.football/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}]
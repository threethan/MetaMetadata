mQvTv3Zi7DFNZSjlX982eSGXOuR6MquLVuCrJpmSQ&oe=69FDE1F7"}, {"file_name": "screen_2560x1440_2021-02-11_17-11-44.png", "id": "329248201831724", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982454_329248205165057_3368797503949159349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo0sCMpFlh0Q7kNvwHbRG-4&_nc_oc=Adq0IIc9pJI8QQ9me8pa8D0l2mc9D9TfBJuuvhNkRFmYuzwN8w2o_ZgP3NsZIHmgfsA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49Fph1R6sh19XM1Phgnvj1ZrhTmOe3LvxVFT9fusq01g&oe=69FDE9C4"}, {"file_name": "screen_2560x1440_2021-02-11_17-09-43.png", "id": "181877713273987", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031442_181877716607320_673247922973513878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOaG0Pef93oQ7kNvwEa0t4H&_nc_oc=AdpJtXqAEoVrFlbriyzr1jNPUpn8QjXMdmKB_ryfj9UqFYv05Vrmxq041VBjkVObBz0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OJiBDmGppqFkstS22Fgln2jZ6U-VrgtaYSaQSD9-4ZA&oe=69FDDFA8"}, {"file_name": "screen_2560x1440_2021-02-11_17-23-04.png", "id": "163104352108665", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974899_163104355441998_3112624760032388224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2G2y7gc7OwQ7kNvwH4Pbww&_nc_oc=Ado4jB0l8-G3jYIscmcLczkZ3BbBNSsgffe2sBqgC-Nrt3PTrjY02CDtz_HAbT2F8_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af718f_oLzwpb7KwayAV9vT2l3ZAwExzZeb2Pt3HMvZw-w&oe=69FDE298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1408974982780204", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035327_1408974986113537_1806111711424974479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gzxFTefiuUQ7kNvwFn4xBA&_nc_oc=AdoTaTiFPa_tzidLlptqbeMVuaQ0Um6s_2tjiwgZXyv0SZdUT35R7daqtTyEO46QUZU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M1FXlAb-Phryy7IGxlPP_-NiIl2yXqw6xMWsvFKatHg&oe=69FDDB2A"}, "display_name": "SAIVA", "keywords": [], "long_description": "A technical tool aimed at professional coaches that want a deeper analysis and understanding of their replays\nTraining in 3 steps\n1. Identify the action to train with your team\n2. Create the action with Easy Sports Animation\n3. Upload the file to your online SAIVA account\nBe it a standard play or a 1vs1 situation, feedback quality can be improved by repeating any situation from different perspectives and positions\nStarting from an academy level, all players interact, train, and play on lineal training methods. The problem with Lineal training methods is that they are not player specific\n\u2022  SAIVA helps players provide tailored training. Tailored training is designed to interact and provide input to individual players about their specific needs\n\u2022  This allows defining defensive, midfield, and offensive strategies and specific tasks for each of these positions\n\u2022  It gives coaches a wide-angle perspective and helps the players to see their own performance from a third-person perspective", "short_description": "Sector: Sports\nProduct Type: Software\nPlatform: VR + PC/Mac\nTechnology: AI + VR\nLicense Model: Subscription\nOrigin: Germany, South Korea, USA\nState: Production\nUsers: 3 to 20+\nSuitable (Club Level) - Amateur, Academy, and Professional\nKit Includes - Easy Sports Animation License,\nWeb Cloud service\nFeatures:\n\u2022\tReal-Time Collaboration\n\u2022\tDifferent Perspectives\n\u2022\tSpatial Memory\n\u2022\tUnlimited Replays\n\u2022\tComplex Scenarios\n\u2022\tTime Saving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saiva.football/privacy", "developer_terms_of_service_url": null, "publisher_name": "Turing AI Cultures GmbH", "support_website_url": null, "website_url": "http://www.saiva.football/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}]
TbxolB95Q9uVJNkPsjJ2gzJTKl64xkaKybw5HYG82wFIXaLs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGJRqVDNjV1Z2n00C3xjJdbOdVpsJma0GIwdX3scKjoA&oe=6AFF2EB7"}, {"file_name": "screen_2560x1440_2021-02-11_17-11-44.png", "id": "329248201831724", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982454_329248205165057_3368797503949159349_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CAKwChzzuAQ7kNvwERwepG&_nc_oc=Adro0EffHRmuO6tvABv2EC371nB4m1ec19_7I6IO7WEv5F8jBVGs8nwjmOE5_CP8iMY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbXT4zkwUpH0piNtdYJxDdFo_aGpGNlKOdBfoTFAHGfw&oe=6AFF3684"}, {"file_name": "screen_2560x1440_2021-02-11_17-09-43.png", "id": "181877713273987", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031442_181877716607320_673247922973513878_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVS_l3T0py4Q7kNvwELfVZF&_nc_oc=AdppQVu38p1iHM8kIRqsda4GqPF7hr2wwkXVIiXSnQVB_E8A3BL6ZELTbAJwYkSOsoU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCKZX53IHB2pAMkFENl4aRpICziXBnOG4xgtqtQcWRfg&oe=6AFF2C68"}, {"file_name": "screen_2560x1440_2021-02-11_17-23-04.png", "id": "163104352108665", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974899_163104355441998_3112624760032388224_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKKU0_n3DtwQ7kNvwEfm5PN&_nc_oc=Adr3ik93BFFozy7gFIDo4h1EdcwbDrtupgtmjHayz_mZRzr6WCyRh__Zr8n3vI1qB4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoEPrO_9hA9rJwVQL7torbKI6ERSi1PXgZH4abnTCxGQ&oe=6AFF2F58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1408974982780204", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035327_1408974986113537_1806111711424974479_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oq0MBZZ_pkQ7kNvwEm7XQs&_nc_oc=Adq0rRgpJevN_0mquzaHKyr2ZKlgdawTgwz8iDASD-KcPI1hUyHRgYrNy8vYQ3vw_eQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeC8wZqQOHAV7YI8yutz0EU7_RYiLwP2eAfPOgzpwAGg&oe=6AFF27EA"}, "display_name": "SAIVA", "keywords": [], "long_description": "A technical tool aimed at professional coaches that want a deeper analysis and understanding of their replays\nTraining in 3 steps\n1. Identify the action to train with your team\n2. Create the action with Easy Sports Animation\n3. Upload the file to your online SAIVA account\nBe it a standard play or a 1vs1 situation, feedback quality can be improved by repeating any situation from different perspectives and positions\nStarting from an academy level, all players interact, train, and play on lineal training methods. The problem with Lineal training methods is that they are not player specific\n\u2022  SAIVA helps players provide tailored training. Tailored training is designed to interact and provide input to individual players about their specific needs\n\u2022  This allows defining defensive, midfield, and offensive strategies and specific tasks for each of these positions\n\u2022  It gives coaches a wide-angle perspective and helps the players to see their own performance from a third-person perspective", "short_description": "Sector: Sports\nProduct Type: Software\nPlatform: VR + PC/Mac\nTechnology: AI + VR\nLicense Model: Subscription\nOrigin: Germany, South Korea, USA\nState: Production\nUsers: 3 to 20+\nSuitable (Club Level) - Amateur, Academy, and Professional\nKit Includes - Easy Sports Animation License,\nWeb Cloud service\nFeatures:\n\u2022\tReal-Time Collaboration\n\u2022\tDifferent Perspectives\n\u2022\tSpatial Memory\n\u2022\tUnlimited Replays\n\u2022\tComplex Scenarios\n\u2022\tTime Saving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saiva.football/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Turing AI Cultures GmbH", "support_website_url": null, "website_url": "https://www.saiva.football/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7564910960197266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38984460_893919131425205_6482433198148083140_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOklOpoWxPoQ7kNvwFnCnOP&_nc_oc=Adq3MnKKbVM0QrBHVkd5OOfu9-aMfoELo5GH2cNEt-JoRAjvW78QgvvBNKsyJEa1tAM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXuWZQMD4JJn8pQGCYMEfdb2c8oXlJFPtKSSpMYux7uw&oe=6AFF317F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SAIVA", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1617647015, "lastRevision": {"nodes": [{"id": "187646339769794", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3889659081055824", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "413079939757151"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{
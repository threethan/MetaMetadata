wQ92-OhybI_WLvHnJ3C1jiD1XHQYrA0sH1wCoGQ1w&oe=6A33EF77"}, {"file_name": "screen_2560x1440_2021-02-11_17-11-44.png", "id": "329248201831724", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982454_329248205165057_3368797503949159349_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M85VskKEKEwQ7kNvwFeFsx8&_nc_oc=AdqjsuFI0SzbHiAQVQEgzu-RYmbQCtq2twv99rIvg3f0Rz1HSWU5pBFAEYvw_70JTw4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3pbqYr87VzyV6_k0mMAg-iaeI21HOGkJ46ApxdxV13w&oe=6A33F744"}, {"file_name": "screen_2560x1440_2021-02-11_17-09-43.png", "id": "181877713273987", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031442_181877716607320_673247922973513878_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q40PGdbYCNwQ7kNvwHIJr9R&_nc_oc=Ado925RbFZFU6_X-pyoju_xQra5WTRgCFv-2CJ0zxF8p8WXCE2vtfENFWWq2zpeEVOU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HPcMSBe9T9Nean1zkFq7kcLhhNrmunn_7PEnLX6SkCA&oe=6A33ED28"}, {"file_name": "screen_2560x1440_2021-02-11_17-23-04.png", "id": "163104352108665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974899_163104355441998_3112624760032388224_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Plub2CQScZIQ7kNvwEeI8Uh&_nc_oc=AdpEV-DqbX2Vb_qTsTUibLmVm8ACCmFTjN_RQSZRvLZ_hQPhcoP-2uyJYwqy2l1XmTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oxNJLevVW1EeoCNk8qnMbreCievp3cex2p3vfX90uNw&oe=6A33F018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1408974982780204", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035327_1408974986113537_1806111711424974479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51MEw04U83gQ7kNvwGPKF0g&_nc_oc=AdrphL5dMH6i_uydWsG1UGiGBs4vAUo9fP-JuythwryfVIMm3aK4kYCkdPr7JMmsMoY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aqpWKeqYOcOhnTfRKG5GGuWfoYVdgQOq2U7h0KplDGA&oe=6A3420EA"}, "display_name": "SAIVA", "keywords": [], "long_description": "A technical tool aimed at professional coaches that want a deeper analysis and understanding of their replays\nTraining in 3 steps\n1. Identify the action to train with your team\n2. Create the action with Easy Sports Animation\n3. Upload the file to your online SAIVA account\nBe it a standard play or a 1vs1 situation, feedback quality can be improved by repeating any situation from different perspectives and positions\nStarting from an academy level, all players interact, train, and play on lineal training methods. The problem with Lineal training methods is that they are not player specific\n\u2022  SAIVA helps players provide tailored training. Tailored training is designed to interact and provide input to individual players about their specific needs\n\u2022  This allows defining defensive, midfield, and offensive strategies and specific tasks for each of these positions\n\u2022  It gives coaches a wide-angle perspective and helps the players to see their own performance from a third-person perspective", "short_description": "Sector: Sports\nProduct Type: Software\nPlatform: VR + PC/Mac\nTechnology: AI + VR\nLicense Model: Subscription\nOrigin: Germany, South Korea, USA\nState: Production\nUsers: 3 to 20+\nSuitable (Club Level) - Amateur, Academy, and Professional\nKit Includes - Easy Sports Animation License,\nWeb Cloud service\nFeatures:\n\u2022\tReal-Time Collaboration\n\u2022\tDifferent Perspectives\n\u2022\tSpatial Memory\n\u2022\tUnlimited Replays\n\u2022\tComplex Scenarios\n\u2022\tTime Saving"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saiva.football/privacy", "developer_terms_of_service_url": null, "publisher_name": "Turing AI Cultures GmbH", "support_website_url": null, "website_url": "http://www.saiva.football/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1043107547362485"}]
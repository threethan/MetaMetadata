uluscdn.com&_nc_ss=7f30f&oh=00_AQTEDL75LzSdKNybjdx8ylRL045gIihEeixot9c6f3L05Q&oe=6B0DB94D"}, {"file_name": "asfsg hgfxhSE.png", "id": "1308464297854680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302483_1308464301188013_2779886059796046420_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwklLAb5X24Q7kNvwEqTiVW&_nc_oc=Adp-fTTDUOdWVoha3QZn5gQTyMl6R9P_XMWAw_NOFkmQuZBDARz-bcNecnv1yh4twdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkS-481REZXss5HJRvGDbxutBIProGSYzSD6wlmtkkWQ&oe=6B0DCA69"}, {"file_name": "wdawfesesf.png", "id": "936373418798248", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304106_936373422131581_7320428048611402101_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVZ1vN1eWKQQ7kNvwHnAEYB&_nc_oc=Adq_LM8GwTzOeqT8EV01wXIg-GI5-4P8uz77i6bcBWohYDJQJt7r2LBE3Ta0bZpicv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEJ_fNhHxjzJgaOESSFtzQxWlYCHzJhuGgFWve_nClUA&oe=6B0DA431"}, {"file_name": "fSRGdrszgd.png", "id": "902600006116549", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307451_902600009449882_24328673381610072_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_PXm5Bo97cQ7kNvwHAL0wG&_nc_oc=AdrubjYLUCb9BsO4bhJV86itT5_tYCfTUozox-LGYVod3G2N5V2EQlUyyr02YwSU_B4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTo_Ym95BxeX2qvxVN8cS6Bh5JqT9T9orh8ZIqmI95Yag&oe=6B0DC1B7"}, {"file_name": "sdfghdxzgfzxh tgeS.png", "id": "3076687455872329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_3076687459205662_3109430660852286349_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOJap_0nnc0Q7kNvwG2_8hb&_nc_oc=AdrK8OXEVSpaKCTnBJH-6K1i6rX8PSB64n4iFGjunQ_zWfF0puX8FxFhaakYFwdFm9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbZ0hsmCREWNKqMfYSVf0sWYl5D1AJEHdTZIdtTCZDhw&oe=6B0DC5A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RV Tags", "keywords": ["Rvtags", "Rvstudios"], "long_description": "In RV Tags, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of tag-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\n\n\nPrepare yourself for a game that includes arm swinging and alot of movement!", "short_description": "Welcome to RV Tags! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "publisher_name": "RV Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/rvtags/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
-ZALK4l5cGgN5-6Z3cS4-pL-F4Gagiomyh-5Wq2v2R8jBdN_rUKK52ChrYeI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0MM-b3_KhcW3Dcpd6WfKpa4d0wqRIIlYwi3470VMjdyw&oe=69F1E769"}, {"file_name": "wdawfesesf.png", "id": "936373418798248", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304106_936373422131581_7320428048611402101_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVpUPVj_tHoQ7kNvwGW9gL7&_nc_oc=AdodkiyNdnZC4uL5lDi1wD1VPAV-_ZDrfonL_rZyc_bhF-qP6ismFkuHWymkD2p8UK0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1MAtChDAW8BH5J4VdV77NQ_Shw7cmeStcT__N1SdFZEA&oe=69F1F971"}, {"file_name": "fSRGdrszgd.png", "id": "902600006116549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307451_902600009449882_24328673381610072_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shh95g3vExoQ7kNvwHWwM9e&_nc_oc=Adrp7oVHqJdu_6nDckMgdm1W9AQ21EAIK4NoGc0Na5fQomZ0uiUtgGQHd0suIghhJrg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xcsshYoF3BU2mb6xzVC_fHAq822SX-rc8qTMlAvmkiA&oe=69F216F7"}, {"file_name": "sdfghdxzgfzxh tgeS.png", "id": "3076687455872329", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303746_3076687459205662_3109430660852286349_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZkYobzQvbEQ7kNvwE3nwoa&_nc_oc=Adr1wTad9WHTeCV2zN_CYo5kdkVvqB8BQ9nFuRJqoLzh3H51TiKV-BxAJ1OTwPmqFog&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1v0BcBYnQz0xC0z4cWMAlduS2iRP6rcBwqGgfNzhBacg&oe=69F21AE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RV Tags", "keywords": ["Rvtags", "Rvstudios"], "long_description": "In RV Tags, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of tag-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\n\n\nPrepare yourself for a game that includes arm swinging and alot of movement!", "short_description": "Welcome to RV Tags! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "publisher_name": "RV Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/rvtags/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "MULTI_USER"], "id": "26602514522678274"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2098515990939595"}]}, "baseline_offer": {"id": "2098515990939595"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775337240, "status":
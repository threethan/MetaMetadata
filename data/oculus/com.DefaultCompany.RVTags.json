5-1.oculuscdn.com/v/t64.5771-25/499302483_1308464301188013_2779886059796046420_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL8VLgYnA3wQ7kNvwFYt7zB&_nc_oc=AdpsymtQmYDDOG_2mmHi5fOsJU7trY1He0PuCeH0P53J0Xc1klXchOp9tGNb09yYuwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzT338Cj6_qS6SbD8LFia5jPYw5sWeflFqK3-l_ngw0g&oe=6AEF3FA9"}, {"file_name": "wdawfesesf.png", "id": "936373418798248", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_936373422131581_7320428048611402101_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xacaa1A6YGUQ7kNvwFyh_Ue&_nc_oc=AdoGbqt2TQNWbQI_CbOaSXtL32AvynKBmv0dTua1yj_B1tFRlmXFyxYJszaJ1lwtwEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo0dthxvYQORXtmW0Uw0AnowmmSAT-nyNTdQK1GLOZ2w&oe=6AEF51B1"}, {"file_name": "fSRGdrszgd.png", "id": "902600006116549", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307451_902600009449882_24328673381610072_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2qStPpxlsQQ7kNvwHwzhHP&_nc_oc=AdpIb_YjFQ5PijjpfXFbNfO9w86U13O2oRVvjeOX7a5ERizEfwAy9KTybp29JP8Vmas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHiJhGwYEjjIc_BIHCdkcnCT6yZWFrFnZBAg-9qOxM8g&oe=6AEF36F7"}, {"file_name": "sdfghdxzgfzxh tgeS.png", "id": "3076687455872329", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_3076687459205662_3109430660852286349_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3801N3D6qkYQ7kNvwEGcGVK&_nc_oc=Ado0L8OdYqdIK_6IyVpTQld_Viu8Kfx_zv-bSuThZ0eeexjYiFXTh3TxNRIQdhOmMSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBl3b2H5zz6HDDpMfL7uihFRWl0VQrn1UwkTRYbe3fKA&oe=6AEF3AE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RV Tags", "keywords": ["Rvtags", "Rvstudios"], "long_description": "In RV Tags, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of tag-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\n\n\nPrepare yourself for a game that includes arm swinging and alot of movement!", "short_description": "Welcome to RV Tags! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "publisher_name": "RV Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/rvtags/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "MULTI_USER"], "id": "26602514522678274"}}]}, "scheduled_offers": {"count": 1,
uluscdn.com&_nc_ss=7f20f&oh=00_AQRQh5Wm_gGCxzfA7tSYM7Y0CwvJ8jRY7s5Edq_5MdDERA&oe=6B0721CD"}, {"file_name": "asfsg hgfxhSE.png", "id": "1308464297854680", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302483_1308464301188013_2779886059796046420_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvAK0ukWfiYQ7kNvwF2Ml32&_nc_oc=AdoW1q3N9IlIAQjFNDCRwP8BPbsuaTjsCtbAw5X6KukmH2YOTX4uFhg08YromhvW2DA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr2NIqpV8aN28MOHqP04v7PdFdy-vhAUjDB-WvuRwyhg&oe=6B06FAA9"}, {"file_name": "wdawfesesf.png", "id": "936373418798248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304106_936373422131581_7320428048611402101_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPhSakJBVpEQ7kNvwH6d6cT&_nc_oc=Adrl6x96KRtntP1WIO_-hIq7-h8ej0l5Oz5pDWzCALHrpSPfJ2UoGD5nB6cJu4FrofA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJZM0VpfbyWkb87fnMa-cdHUpSnsw-rF9UbL3zILk-MA&oe=6B070CB1"}, {"file_name": "fSRGdrszgd.png", "id": "902600006116549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307451_902600009449882_24328673381610072_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usK_nzKB6psQ7kNvwE33Jr_&_nc_oc=AdoMcyu1a5w4SYKsNSnCNmYrcY6h0Dy9O_txVPlRUTpl8IGSSOlfXMIM9oijnhzyeQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlcQ25bB9L3huEm71Gip8KULUdyIq2SahP7dL2i0Q60w&oe=6B072A37"}, {"file_name": "sdfghdxzgfzxh tgeS.png", "id": "3076687455872329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303746_3076687459205662_3109430660852286349_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdMyPEaV3tIQ7kNvwEajrwD&_nc_oc=Adow4_E_KPavJEFfTYtrorSW87uKEGJRc_62z-7S76v4m543maSueVtoJTITjeEO5To&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb5b1m1EBZQpPEs6fmWN9xsWCtXq0Jht-odpDku5Fk3A&oe=6B06F5E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RV Tags", "keywords": ["Rvtags", "Rvstudios"], "long_description": "In RV Tags, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of tag-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\n\n\nPrepare yourself for a game that includes arm swinging and alot of movement!", "short_description": "Welcome to RV Tags! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/rvtags/privacy-policy?authuser=0", "publisher_name": "RV Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/rvtags/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
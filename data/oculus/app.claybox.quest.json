uluscdn.com/v/t64.5771-25/38982626_1099051324448756_6000254658868017176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AwQHsb4dvkQ7kNvwG7y0G3&_nc_oc=Adr3t40gDiN2QfAm1G3NL8K_dM-JTyyId-O4MUou2m3Vprd87fGnV7Y6B8a4x9O-hV4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3eag8kTL-2BQRpFKgEechyNNZO2u5vIoGofIsnnTh8Gg&oe=69F2013A"}, {"file_name": "ClayBoxAppSubmission-Screenshots-05.png", "id": "2206108323087478", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974502_2206108326420811_4166374131902517756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSjYydiYmtgQ7kNvwHVkRP3&_nc_oc=AdqvPxBxCvklmMwb6Uj8WUPw0bu8_maBI-Qdjgtvv6J0XSXhAFS087_j3PM8xanrxZg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eWjJHP5NTD-W15-cIqeHt2-WkGziL63IvQV_L5ibDIg&oe=69F1EEC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1988972764945617", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75241696_1988972768278950_4865238281920524131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Np1iApJrAcIQ7kNvwEFwwBB&_nc_oc=AdpoM3PzZGz4orRrfAy1aSYKSBFpy5NtqvVwEhbWHRbtAqqEL7YCTjCq7KZtoJtiGis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Mq3cMs82EHRIyPX8iTbRnx7NOmiNztCvL-zwb-BBIvw&oe=69F1F39A"}, "display_name": "\ud83e\udea8 ClayBox", "keywords": ["Sculpt", "Relax", "Paint", "Create", "Sketch"], "long_description": "ClayBox: Unleash Your Creativity in Mixed Reality\n\nStep into the immersive world of ClayBox and discover the joy of creating with digital clay in Mixed Reality. Whether you are a seasoned artist or a curious beginner, ClayBox makes it easy to express your creativity and bring your ideas to life. Everything begins with a simple box of clay. From there, it's up to you to mold, shape, and transform it into whatever you can imagine.\n\nUse your controllers to add new clay, remove pieces, or smooth out the rough edges and corners. With a versatile set of 9 uniquely shaped brushes that can be scaled and reshaped, the possibilities are truly limitless. Craft intricate sculptures, abstract designs, or playful creations\u2014all within a mixed reality environment that merges the digital and real worlds seamlessly.\n\nThanks to ClayBox's unique volumetric clay technology, every piece you create looks and feels just like working with actual clay. It\u2019s a tactile and rewarding experience that captures the essence of real-world sculpting while offering the freedom of a digital canvas.\n\nLet your imagination flow in a remarkably relaxing atmosphere. ClayBox is not just about creating; it's also about unwinding. The immersive experience will keep you entertained, relaxed, and inspired for hours on end. Sculpt, experiment, and find your perfect artistic escape\u2014all in Mixed Reality.\n\nDownload ClayBox today and let your creativity take shape!", "short_description": "Step into the immersive world of ClayBox and discover the joy of creating with digital clay in Mixed Reality. Whether you are a seasoned artist or a curious beginner, ClayBox makes it easy to express your creativity and bring your ideas to life. Everything begins with a simple box of clay. From there, it's up to you to mold, shape, and transform it into whatever you can imagine.\n\nUse your controllers to add new clay, remove pieces, or smooth out the rough edges and corners. With a versatile set "}]}, "developer_name": null, "developer_privacy_policy_url": "https://claybox.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "mixed.world GmbH", "support_website_url": null, "website_url": "https://claybox.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
d=6e7a0a&_nc_ohc=iaLWRzpDMAQQ7kNvwEXq8pD&_nc_oc=AdlqjJ_-bDnUVypslLpGVu_0i1YiIlnSjwABnss4wMM1oeDrmsZBq1QLxgAoGigMiMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnAObp8Wr42Q1DmoWBWCNcqKKBKw4oyDsTP_vyhIunKA&oe=69A6DBBA"}, {"file_name": "ClayBoxAppSubmission-Screenshots-05.png", "id": "2206108323087478", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974502_2206108326420811_4166374131902517756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB_aAmc8BUoQ7kNvwFaxSJ_&_nc_oc=Adk5nyqDxSKEpf7XiqmTclvfO1m7pTLrTM4wInYYdQDd1xqOMGR1QAZ5pxHfPXH6bNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9o2DMa6Dh1cV9ipzlRn2sNJrAX5olYMeT6FsVeMLm2A&oe=69A6C941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1988972764945617", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241696_1988972768278950_4865238281920524131_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZViR_aZ6ahkQ7kNvwHrxXtR&_nc_oc=AdlSG89V1gtXDzDQlTl4sb76HKTjef-9nSzcVaUrCOtDf9equrAmUh9deqU_3K8-_28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuntdidvVuJg1ejjDrkXuvQb5ep9iZZ1B13DELmWjOAdA&oe=69A6CE1A"}, "display_name": "\ud83e\udea8 ClayBox", "keywords": ["Sculpt", "Relax", "Paint", "Create", "Sketch"], "long_description": "ClayBox: Unleash Your Creativity in Mixed Reality\n\nStep into the immersive world of ClayBox and discover the joy of creating with digital clay in Mixed Reality. Whether you are a seasoned artist or a curious beginner, ClayBox makes it easy to express your creativity and bring your ideas to life. Everything begins with a simple box of clay. From there, it's up to you to mold, shape, and transform it into whatever you can imagine.\n\nUse your controllers to add new clay, remove pieces, or smooth out the rough edges and corners. With a versatile set of 9 uniquely shaped brushes that can be scaled and reshaped, the possibilities are truly limitless. Craft intricate sculptures, abstract designs, or playful creations\u2014all within a mixed reality environment that merges the digital and real worlds seamlessly.\n\nThanks to ClayBox's unique volumetric clay technology, every piece you create looks and feels just like working with actual clay. It\u2019s a tactile and rewarding experience that captures the essence of real-world sculpting while offering the freedom of a digital canvas.\n\nLet your imagination flow in a remarkably relaxing atmosphere. ClayBox is not just about creating; it's also about unwinding. The immersive experience will keep you entertained, relaxed, and inspired for hours on end. Sculpt, experiment, and find your perfect artistic escape\u2014all in Mixed Reality.\n\nDownload ClayBox today and let your creativity take shape!", "short_description": "Step into the immersive world of ClayBox and discover the joy of creating with digital clay in Mixed Reality. Whether you are a seasoned artist or a curious beginner, ClayBox makes it easy to express your creativity and bring your ideas to life. Everything begins with a simple box of clay. From there, it's up to you to mold, shape, and transform it into whatever you can imagine.\n\nUse your controllers to add new clay, remove pieces, or smooth out the rough edges and corners. With a versatile set "}]}, "developer_name": null, "developer_privacy_policy_url": "https://claybox.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "mixed.world GmbH", "support_website_url": null, "website_url": "https://claybox.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
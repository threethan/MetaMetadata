048_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_t1h21RrMUQ7kNvwFWKn9e&_nc_oc=Adr4OYgDUe7qZXcTSGYUMjXB1ZLsEaZG4rN4N22lp6cofnIjMIGYKBDby1pFCFyWDJw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aXE0-_bN027pI9gwc4cOlRnK6jzkte15dC52EJ-sw2g&oe=6A11C11F"}, "display_name": "Earth Defence Program:Wayfarer", "keywords": ["space", "simulation", "fps", "wayfarer", "best"], "long_description": "EDP:Wayfarer is a story driven first-person \nsimulation shooter taking place in infinity of space. Developed by Refine Reality Ltd. it gives you a chance to choose between freedom and responsibility in a quest to solve your own identity.\n\nMechanics of the game are build for interactive feel to maximize immersion in virtual reality and giving the player more control of the experience.\n\nGame utilizes a gamepad controller to access variety of controls over HSF-14 Space Fighter Craft  and On-Foot mode with freedom for head movement.", "short_description": "EDP:Wayfarer is a story driven immersive\nfirst-person simulation shooter taking place in infinity of space. \nDeveloped by Refine Reality Ltd. it gives you a chance to choose between freedom and responsibility in a quest to solve your own identity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.refinereality.com/RefineRealityPrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Refine Reality Ltd.", "support_website_url": null, "website_url": "http://www.refinereality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supporte
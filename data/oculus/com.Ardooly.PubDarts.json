"}, {"file_name": "DartCabinet.png", "id": "764082710876929", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75314846_764082717543595_5827192745392422510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeAqHvJs8FQQ7kNvwHwwyab&_nc_oc=Adr37B--4G2VZ-o5L6JIxcz13YPm4w_9Le1L1PX11qS0b09-ZNtcYMtt3DVhTmiaHGY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6llQ4msmqg3zxKzlUl7NOtmjbiP61t3X3x60YGQ7ehGg&oe=6A11AB0E"}, {"file_name": "SelectDart.png", "id": "436170744482531", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75251818_436170751149197_825983173380606270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RokU0-Uv80AQ7kNvwHdBwYs&_nc_oc=AdpU__3ooqO4vZdqcTAqSh-s1i1Vm8Rjs299JiejDexOFmfKjGDUl2geH5f0DNLZztk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I4ooH_9ZmGxaXj10EPADf_fhYVTWqeK0YO5EM8mrYQQ&oe=6A119A45"}, {"file_name": "Throw.png", "id": "734477514098369", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75356791_734477520765035_7817285667048774015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQSsu-sfGOMQ7kNvwFY2Tju&_nc_oc=Ado3R84CnNKnRttIZwxhXFVOjfQ0y5J7liZatBAA_-jazKHiRnRJuR_Xd2i1ZgN1mhw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vUYVTgahRJ7YczTVnoCsueHSnxrS84jahwzwBRTCFNQ&oe=6A11B4F5"}, {"file_name": "Join.png", "id": "416966659369108", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75542959_416966662702441_789052643303403720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMZ2Awk0rzEQ7kNvwFW0kNi&_nc_oc=AdqLg6ADnVxhgkkU3PMfB0_0ZxM56PHK_m4RAiCwm0Q3B0MurJENDe8HURVVGEyacXo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DeyDqMI4nJfUssjoX6ZW2hMYRBgdIr9XWCi4uZmoLhw&oe=6A119EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "718683388821409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86662329_718683395488075_416264793561488069_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pIJFluFOJ0Q7kNvwHY4Nix&_nc_oc=AdpB0om-mGQoNkQ4TZP7IV_QazwF7o_9L9Sj_hdfc9wie70Z9FEXWUWOG8cBvbC1yNw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TkDq5DDFg0tYMvYUA4mFbdDfB709OzzpzHtGL16V8dA&oe=6A11CB4D"}, "display_name": "Pub Darts", "keywords": [], "long_description": "Step up to the Oche with Pub Darts.  A detailed simulation of the game of darts that immerses you in the familiar environment of the Pub.  From the crackling fireplace to the hustle and bustle of the nearby bar you'll find yourself transported to your favorite local as you enjoy a few games of darts.\n\nPractice alone or invite a friend to join you for a match.  The dartboard and oche are precisely calibrated to BDO professional standards, and the automatically updating scoreboards will keep you well informed as to how your game is progressing.\n\nSupports both Left and Right handed playing, just grab the darts with the hand you do not intend to throw with, then take a dart into your other hand and throw.  Games are played from 501.", "short_description": "Fancy popping down the pub and playing a few games of darts?  Well now you can with On the Oche - Pub Darts!  Practice on your own, or invite a friend to join you for a match in this immersive recreation of this wonderful game.\n\nThe experience has been created to the exact specifications of BDO World Darts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ardooly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ardooly", "support_website_url": null, "website_url": "http://www.ardooly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_g
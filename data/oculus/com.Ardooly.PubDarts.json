"}, {"file_name": "DartCabinet.png", "id": "764082710876929", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75314846_764082717543595_5827192745392422510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL9A1B4n6roQ7kNvwElV_N6&_nc_oc=AdrWaMALsazn1fNvzqDRSfTbJRujt8FMuXvawZAt_SPixkNyAy0sWVdS-ZiQxRMdySo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Ra1hgFfSZkVq0b1BuQM9EpjBf0t951O-UL-Qkf5_yA&oe=6AA9478E"}, {"file_name": "SelectDart.png", "id": "436170744482531", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75251818_436170751149197_825983173380606270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K10_Hk27-yQQ7kNvwHX3hwC&_nc_oc=AdoIM_8yWiD9y_YrAqvEHEi9DJf1NeAK2_K2HlDuxVPgMso0PVSCVKRR4WzLCHG_jNM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdowgRXYLF9XHhVsdOD8NbNGUNYtl91ltzfTj8IrIC8A&oe=6AA936C5"}, {"file_name": "Throw.png", "id": "734477514098369", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75356791_734477520765035_7817285667048774015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8mURwgo1koQ7kNvwFM3EAe&_nc_oc=AdpKXdWp_gjctM8CyU_sk2fqoayknb9ZWgocaFInA5YpPmphdMZ1FP8ykmCjhvZjleA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6nUDXyjGKgXRSRju_9H_RRpooyGZ5ZWmG7LiOTH_Awg&oe=6AA95175"}, {"file_name": "Join.png", "id": "416966659369108", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75542959_416966662702441_789052643303403720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu3rdnWouwsQ7kNvwFpoxwY&_nc_oc=AdqubHWXEYtGUaM8p-BzivGPrV3ph4fbHiK0LOZHAa12KSKaRxbnOgza-ZrHcNaY7I8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK06DULxMjMAngfaOs9EhkZd3uawGgih4CUMHGKOAhFXQ&oe=6AA93B63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "718683388821409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86662329_718683395488075_416264793561488069_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sinRq6Ecml0Q7kNvwHK8o9-&_nc_oc=AdrE3lUueMFRz0Rx0SbGH882h-K_t9RFc_hIj55CzZkgTe2d0h4uDtiDrvA8UA-UdsQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMdgY2wSTJOQgd8xY95_96lgp1uE8BCW8LV4YEgCccGg&oe=6AA967CD"}, "display_name": "Pub Darts", "keywords": [], "long_description": "Step up to the Oche with Pub Darts.  A detailed simulation of the game of darts that immerses you in the familiar environment of the Pub.  From the crackling fireplace to the hustle and bustle of the nearby bar you'll find yourself transported to your favorite local as you enjoy a few games of darts.\n\nPractice alone or invite a friend to join you for a match.  The dartboard and oche are precisely calibrated to BDO professional standards, and the automatically updating scoreboards will keep you well informed as to how your game is progressing.\n\nSupports both Left and Right handed playing, just grab the darts with the hand you do not intend to throw with, then take a dart into your other hand and throw.  Games are played from 501.", "short_description": "Fancy popping down the pub and playing a few games of darts?  Well now you can with On the Oche - Pub Darts!  Practice on your own, or invite a friend to join you for a match in this immersive recreation of this wonderful game.\n\nThe experience has been created to the exact specifications of BDO World Darts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ardooly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ardooly", "support_website_url": null, "website_url": "http://www.ardooly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_g
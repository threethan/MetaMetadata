m/v/t64.5771-25/75314846_764082717543595_5827192745392422510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDQ2wJ4dDXgQ7kNvwF1oNm_&_nc_oc=AdrDGvUdPlY6AjgVoIMhGWoFRi55qjLTfiO2AgzniLZHKDHiWnd_M8Mma7pMKaih6yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0xdX_t0RGp3Opm3uzDwdy3z_WfejyOT9v_7-HTnALoNA&oe=69F0B58E"}, {"file_name": "SelectDart.png", "id": "436170744482531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251818_436170751149197_825983173380606270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0M0dXbwq9hkQ7kNvwHZwbc2&_nc_oc=AdpDonzuewzf7In86Mg0Yx4Ns-14PK9bfPF_1F5NZNhGHqsOTKi3AHfT6RU0kLdzaCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1mrc_kcUV0jaCIXIlud1D8vu_X7VDTJaNPGCBr4m71yg&oe=69F0A4C5"}, {"file_name": "Throw.png", "id": "734477514098369", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356791_734477520765035_7817285667048774015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYkt8O5KfT4Q7kNvwH40Ki0&_nc_oc=AdrXvokz8zdYYn1Y3CLPKVC1FccdfoJ3X_ilrjUP6IKwl0lbuHEN31Sd4LKeR99Lti4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3yjMnLumyLYqM7gucsQCMg0V9SehmRqng9XaqsrjlniQ&oe=69F0BF75"}, {"file_name": "Join.png", "id": "416966659369108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75542959_416966662702441_789052643303403720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZYS-ntsSpsQ7kNvwHQwI7s&_nc_oc=AdrVVFw5zsMsZb4pVMz-1tn553nEPxINzf16LptXleDcGW0cPEds_K3m5xRdw_ePgMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1kBZMu33Pb8ZNb_5TmHCMZoLNrXR7WzSb6P4XeBPJP3w&oe=69F0A963"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "718683388821409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86662329_718683395488075_416264793561488069_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFBi06v8MVAQ7kNvwGVHUMo&_nc_oc=AdoEkT17PIiB4YIIYaG8W9dvA4_ztpqLDd_qMRGFOxFNf8t_ZOPWEB6OXsFem8JCEcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3QWddDgcVAB4Kn_r9h4_N459Xi0A0sCbSTqGyPqG0PiA&oe=69F09D8D"}, "display_name": "Pub Darts", "keywords": [], "long_description": "Step up to the Oche with Pub Darts.  A detailed simulation of the game of darts that immerses you in the familiar environment of the Pub.  From the crackling fireplace to the hustle and bustle of the nearby bar you'll find yourself transported to your favorite local as you enjoy a few games of darts.\n\nPractice alone or invite a friend to join you for a match.  The dartboard and oche are precisely calibrated to BDO professional standards, and the automatically updating scoreboards will keep you well informed as to how your game is progressing.\n\nSupports both Left and Right handed playing, just grab the darts with the hand you do not intend to throw with, then take a dart into your other hand and throw.  Games are played from 501.", "short_description": "Fancy popping down the pub and playing a few games of darts?  Well now you can with On the Oche - Pub Darts!  Practice on your own, or invite a friend to join you for a match in this immersive recreation of this wonderful game.\n\nThe experience has been created to the exact specifications of BDO World Darts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ardooly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ardooly", "support_website_url": null, "website_url": "http://www.ardooly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
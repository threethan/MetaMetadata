m/v/t64.5771-25/75314846_764082717543595_5827192745392422510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIsPwhOHUVIQ7kNvwHTvOPx&_nc_oc=Adkm2HrRVcza8mYdEwIIh5Qtmwn0R5l8_4LZYwVZcPTxB86QxudOjB8P79QgGTMvWxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftuJG6XvDsM1j1BSMSzYZe5G0ehvbFshWBNxo9_c2d5BQ&oe=6999B28E"}, {"file_name": "SelectDart.png", "id": "436170744482531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251818_436170751149197_825983173380606270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPDZ8nRIu0kQ7kNvwGhCiHd&_nc_oc=AdmUVxYxON5StWletZD4L9sP6Xn8jAKm-Xi4ljbTpkyOF0JrugO44BgWK7z7bJ5qlHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuY1hHOnuX3eXBlN9oUzNZR6_9KhZ4rePLj-hDkPVw2xg&oe=6999A1C5"}, {"file_name": "Throw.png", "id": "734477514098369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356791_734477520765035_7817285667048774015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6PfnUMStuEQ7kNvwE-77PR&_nc_oc=AdlI0cK7LZmX15iCeeM6t9zvicCCB0RUHrQwHoM8l40zpvrzgJY_alta-n6c65132qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7Bwc0KtyeUCHizbi02Kpy3Xu7xK_i6p6rCBhmTzSyRA&oe=6999BC75"}, {"file_name": "Join.png", "id": "416966659369108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75542959_416966662702441_789052643303403720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8ESmTHF5hcQ7kNvwGkTpAT&_nc_oc=AdkYDIE9VcKJA7SdXexDzPSWQxiDXbgVtWa4aBRs0Tw4-C4YtNWuoJBibiabfAgCX6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs53Su6jtd9y-S9914HDboWHel-zjRT8iCiFXTexZxeCw&oe=6999A663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "718683388821409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86662329_718683395488075_416264793561488069_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMhAZHRvgG0Q7kNvwElhP3C&_nc_oc=AdkoTKWn4ooxsiLg378aDYJ-FqZ2lYR8BgOMQF_RuKeLa_rgc8SOUiHtFmDpa2zaKO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEKdwzuQX8mK30JmdX265qIJ_lV0shywH11HP-mU4mHQ&oe=69999A8D"}, "display_name": "Pub Darts", "keywords": [], "long_description": "Step up to the Oche with Pub Darts.  A detailed simulation of the game of darts that immerses you in the familiar environment of the Pub.  From the crackling fireplace to the hustle and bustle of the nearby bar you'll find yourself transported to your favorite local as you enjoy a few games of darts.\n\nPractice alone or invite a friend to join you for a match.  The dartboard and oche are precisely calibrated to BDO professional standards, and the automatically updating scoreboards will keep you well informed as to how your game is progressing.\n\nSupports both Left and Right handed playing, just grab the darts with the hand you do not intend to throw with, then take a dart into your other hand and throw.  Games are played from 501.", "short_description": "Fancy popping down the pub and playing a few games of darts?  Well now you can with On the Oche - Pub Darts!  Practice on your own, or invite a friend to join you for a match in this immersive recreation of this wonderful game.\n\nThe experience has been created to the exact specifications of BDO World Darts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ardooly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ardooly", "support_website_url": null, "website_url": "http://www.ardooly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
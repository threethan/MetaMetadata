m/v/t64.5771-25/75314846_764082717543595_5827192745392422510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDyrj6r5-_8Q7kNvwGAZdeu&_nc_oc=AdmqCc6Ihg4mmdmmDyGT--ismnCdvvYEfCQvNyXukJkcZSKyw9i1GWxZpOPh0Asz6yI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuDvSs6ivKRPSe0xq4a1ZHKv_swBVtEK1Y6u18XkDVTZA&oe=699EF88E"}, {"file_name": "SelectDart.png", "id": "436170744482531", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251818_436170751149197_825983173380606270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Di1PyW2DlHQQ7kNvwEGcUGI&_nc_oc=AdlDVZZ0Uvd4Z-Ht5XkDDWj8Nr3YD7FNQxnjxCeUA7eItl-YggNtPfO8rBott1XoulE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuBNqARXF54402moz-RTpss4apul1nMYfkW4nisKgt_mw&oe=699EE7C5"}, {"file_name": "Throw.png", "id": "734477514098369", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356791_734477520765035_7817285667048774015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v0uzF7eKUoQ7kNvwF5rtiG&_nc_oc=AdkL7-4y2NFe-zp_kfIPCjn5N4--jWbfrG0ni6LvQtXPyQqH6LtEikmGAwMnEmeferM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs11C1breFyOHB8I0NTFdG904zvdwybexIAJ89dSPSOtA&oe=699F0275"}, {"file_name": "Join.png", "id": "416966659369108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75542959_416966662702441_789052643303403720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvwUgUkms_kQ7kNvwHEy4S_&_nc_oc=AdmTCyexPMLBIjzIVMdwrzlW1UzJNihz3iMTgMKZXXr6NSrPacETsaNKMUIyLethcEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsdWkyEprziTvrOybOeGkO7Lm3ahAfhRfSJSBrXM11dEw&oe=699EEC63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "718683388821409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86662329_718683395488075_416264793561488069_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3e9ReBnr-sQ7kNvwE6dGVz&_nc_oc=AdmvyBMFpSbchETgLeHY3BEbcdZNdSQzW2_MyL6kfMnWGwidVHacSDuzyVmwFUpX4vc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu2JIPOAUlBydnzANqh180gqiLH7d4v6psOOFTMYhZ3kw&oe=699EE08D"}, "display_name": "Pub Darts", "keywords": [], "long_description": "Step up to the Oche with Pub Darts.  A detailed simulation of the game of darts that immerses you in the familiar environment of the Pub.  From the crackling fireplace to the hustle and bustle of the nearby bar you'll find yourself transported to your favorite local as you enjoy a few games of darts.\n\nPractice alone or invite a friend to join you for a match.  The dartboard and oche are precisely calibrated to BDO professional standards, and the automatically updating scoreboards will keep you well informed as to how your game is progressing.\n\nSupports both Left and Right handed playing, just grab the darts with the hand you do not intend to throw with, then take a dart into your other hand and throw.  Games are played from 501.", "short_description": "Fancy popping down the pub and playing a few games of darts?  Well now you can with On the Oche - Pub Darts!  Practice on your own, or invite a friend to join you for a match in this immersive recreation of this wonderful game.\n\nThe experience has been created to the exact specifications of BDO World Darts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ardooly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ardooly", "support_website_url": null, "website_url": "http://www.ardooly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
"}, {"file_name": "DartCabinet.png", "id": "764082710876929", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75314846_764082717543595_5827192745392422510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxPUDpuHflkQ7kNvwGbDEL6&_nc_oc=AdqoxXNNMjm-SO3We9LnSBrM4SgAvNrbN-piSfh2FlnlSxa8mNPb3rveul5pQ-7_wKk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rnqXLYiVjloEax8m-A01jKUSpZmBPQAv2pIgd8O3Prg&oe=6A46670E"}, {"file_name": "SelectDart.png", "id": "436170744482531", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75251818_436170751149197_825983173380606270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItRtbjGPHQsQ7kNvwGkXbSo&_nc_oc=AdpYkLFG3pPgSujtNIUIaYqMP04vroOCs_cfdKvdt9tNgGXVSs3bRgVj9JRNUPHBtho&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FiQHc97gxe-d3CU2YwA1rcRL9M5aU-dJi_-GvgwEsyg&oe=6A468E85"}, {"file_name": "Throw.png", "id": "734477514098369", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75356791_734477520765035_7817285667048774015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhPlYg8Au20Q7kNvwEjmb24&_nc_oc=Ado0niGFGCaZCAr9egTzyODP_tYFEIqnWujrhvPb7l40FhfkCG2FdZU3pqaYg8ISsOM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96n26NT46O-HbNcRIhzp2gbfSokERQQj4NenQk3x29Sg&oe=6A4670F5"}, {"file_name": "Join.png", "id": "416966659369108", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75542959_416966662702441_789052643303403720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS8bn4CKvDkQ7kNvwHeHV71&_nc_oc=AdryTbA0L8jSXGNwZotB0vW6SfpqoiAIV_FTqWoOsEsXpEZK0aQyM-LS0vOXIb_OUAQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iGhdpXNH7_QSgiBp-ti9u_Vt0HaZx_3Id5X6JT3ixXw&oe=6A465AE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "718683388821409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86662329_718683395488075_416264793561488069_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMk4ki0zANkQ7kNvwGtHM0P&_nc_oc=Adq6982Nn-6SrIuN5ZkfAlZNIdWo59VXGj_2u3791nup3i0GF3hZb4zzLU9StHCu5Ho&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6FxSUUYu03J2-RVq4YygURNZd1xskTXTAZulTkx1knw&oe=6A46874D"}, "display_name": "Pub Darts", "keywords": [], "long_description": "Step up to the Oche with Pub Darts.  A detailed simulation of the game of darts that immerses you in the familiar environment of the Pub.  From the crackling fireplace to the hustle and bustle of the nearby bar you'll find yourself transported to your favorite local as you enjoy a few games of darts.\n\nPractice alone or invite a friend to join you for a match.  The dartboard and oche are precisely calibrated to BDO professional standards, and the automatically updating scoreboards will keep you well informed as to how your game is progressing.\n\nSupports both Left and Right handed playing, just grab the darts with the hand you do not intend to throw with, then take a dart into your other hand and throw.  Games are played from 501.", "short_description": "Fancy popping down the pub and playing a few games of darts?  Well now you can with On the Oche - Pub Darts!  Practice on your own, or invite a friend to join you for a match in this immersive recreation of this wonderful game.\n\nThe experience has been created to the exact specifications of BDO World Darts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ardooly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ardooly", "support_website_url": null, "website_url": "http://www.ardooly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_g
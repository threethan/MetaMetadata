m/v/t64.5771-25/75314846_764082717543595_5827192745392422510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKMkznCYQHUQ7kNvwEdBReq&_nc_oc=AdlsTjbjg7rAJQ48QSYltiqdTEFcjdfVN5m0B664zVHFTmxnTjqc9ZlYEdxuNXuawXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzLTpl3U7ufqR14bOQf5mzDIqJ5crDOZ3jEZA3h0AMgg&oe=69A2ED0E"}, {"file_name": "SelectDart.png", "id": "436170744482531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251818_436170751149197_825983173380606270_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWTEGVTfjCAQ7kNvwEZKGlW&_nc_oc=AdkntoBk9TwAraXXmoauCF0u6Fi1zqx6Ej09Plkaf7wtY7GMLOE_Zbo3ET3H141dfRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvyF9WZCXRQB3g5BRwArbFBwthzlAFKGvMm32S38Vc6LQ&oe=69A2DC45"}, {"file_name": "Throw.png", "id": "734477514098369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356791_734477520765035_7817285667048774015_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAPzJLArv5cQ7kNvwHydkpQ&_nc_oc=AdnIh8xeSvSh7_UI-fCCfO0tmnl_XG8OupvHzmz4smgZfpRNgWzuys3vz7Hneqt0I1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuX_QjAyoxSVgpM-ueuB6yx81ps1Xm_KwEyAvetXQicMw&oe=69A2F6F5"}, {"file_name": "Join.png", "id": "416966659369108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75542959_416966662702441_789052643303403720_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flkl_fCWF3sQ7kNvwHOv_SU&_nc_oc=AdnKn7qGDguIJuCgGbhwv9AoLtyByzrSBlnliXLXoIVcTWmL2RGlfjqwHwppQJFwQzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDgd7es6AhH1Tg60LhS5_SYziZoq_vxLz3oQSFb_ggLQ&oe=69A2E0E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "718683388821409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86662329_718683395488075_416264793561488069_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfw0XIN7NTkQ7kNvwFwI6zD&_nc_oc=AdnyEtR6kToJGLRqcO5K4nYzCs_Pi8wOoralRRDJ4IXmFlP-vWhlCfagbWyPb1yamCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwrFEXlBzFYZ7HXcCii6CfyfWcgf8EQ0zE7KcLhBKrNg&oe=69A2D50D"}, "display_name": "Pub Darts", "keywords": [], "long_description": "Step up to the Oche with Pub Darts.  A detailed simulation of the game of darts that immerses you in the familiar environment of the Pub.  From the crackling fireplace to the hustle and bustle of the nearby bar you'll find yourself transported to your favorite local as you enjoy a few games of darts.\n\nPractice alone or invite a friend to join you for a match.  The dartboard and oche are precisely calibrated to BDO professional standards, and the automatically updating scoreboards will keep you well informed as to how your game is progressing.\n\nSupports both Left and Right handed playing, just grab the darts with the hand you do not intend to throw with, then take a dart into your other hand and throw.  Games are played from 501.", "short_description": "Fancy popping down the pub and playing a few games of darts?  Well now you can with On the Oche - Pub Darts!  Practice on your own, or invite a friend to join you for a match in this immersive recreation of this wonderful game.\n\nThe experience has been created to the exact specifications of BDO World Darts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ardooly.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ardooly", "support_website_url": null, "website_url": "http://www.ardooly.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
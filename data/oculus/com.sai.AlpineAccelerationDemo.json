0e\nX\u30dc\u30bf\u30f3\u9577\u62bc\u3057/\n\u4e0b\u308a\u5742\u306e\u6642\u3001\u30b9\u30d4\u30fc\u30c9\u30a2\u30c3\u30d7\n\u767b\u308a\u5742\u306e\u6642\u3001\u6e1b\u901f\u3092\u6291\u5236\n\nA\u30dc\u30bf\u30f3/\u30b8\u30e3\u30f3\u30d7", "short_description": "2D\u98a8\u30b9\u30ce\u30fc\u30dc\u30fc\u30c9\u30b2\u30fc\u30e0\u304c\u767b\u5834\uff01\n\u30b9\u30d4\u30fc\u30c9\u611f\u3001\u30b9\u30ea\u30eb\u306b\u5bcc\u3093\u3060\u51689\u30b3\u30fc\u30b9\u3092\u99c6\u3051\u629c\u3051\u308d\uff01\n\n\u4f53\u306b\u611f\u3058\u3089\u308c\u308b\u75be\u8d70\u611f\n\u30b7\u30f3\u30d7\u30eb\u306a\u306e\u306b\u7656\u306b\u306a\u308b\u64cd\u4f5c\u611f\uff01\n\n\u3042\u306a\u305f\u306f\u3069\u3053\u307e\u3067\u30bf\u30a4\u30e0\u3092\u7e2e\u3081\u3089\u308c\u308b\uff1f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2021/06/alpine-acceleration.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2021/06/about-alpine-acceleration.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "618097406115639"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "352829176503444"}]}, "baseline_offer": {"id": "352829176503444"}, "is_approved": true, "firstOffer": {"nodes": [{"start_t
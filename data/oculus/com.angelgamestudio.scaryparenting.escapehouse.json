7&_nc_sid=6e7a0a&_nc_ohc=MZdxcc7CE2oQ7kNvwHgWyx2&_nc_oc=AdqIkLd3skkSJulOXJpUIXLbegbhvLOojX2snGETQ0StyVmdZ3Ocf1tKzkjYx4nVnz4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LTEQRrmeEw5Vh1LnYmMgf5rEZ8AQ0pFdKHEGGzRAtew&oe=6A4664A6"}, {"file_name": "Screenshot_2.png", "id": "1330129208076125", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473404023_1330129211409458_1653875782419338872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTa1s5HbukUQ7kNvwFfwRDm&_nc_oc=AdpTbhTx4XcQ9Zv_gKOqFK-JXeF6UaDJ6Z8ad5LDp3-9RROQ5DfsqU_t-46ke5q3XMQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2lj4gBSNdTS6Z3-UhOeF0Lov6LlRstM96cD8TI5GNhQ&oe=6A466371"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Dad: Escape Horror House", "keywords": ["parentingsimulator", "familychaos", "badparenting", "crazykidsgame"], "long_description": "Scary Dad: Escape Horror House is a spine-chilling horror escape game where you are trapped inside a dark, eerie house with a terrifying and unpredictable dad. Your only goal: escape before he finds you!\n\n\ud83d\udd26 Explore the haunted house \u2013 Search for clues, solve puzzles, and uncover the house\u2019s dark secrets.\n\ud83d\ude28 Hide and survive \u2013 Stay quiet and find hiding spots to avoid the scary dad lurking in the shadows.\n\ud83d\udd75\ufe0f Solve mind-bending puzzles \u2013 Unlock doors, crack codes, and collect items to escape.\n\ud83c\udfae Immersive horror experience \u2013 Stunning visuals, eerie sounds, and intense gameplay that will keep you on edge.\n\nCan you outsmart the Scary Dad and make it out alive? Play now and test your survival skills!", "short_description": "A darkly comedic VR simulation where you experience the chaos of being an unprepared parent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio
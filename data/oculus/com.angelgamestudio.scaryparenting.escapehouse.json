null, "display_name": "Scary Dad: Escape Horror House", "keywords": ["parentingsimulator", "familychaos", "badparenting", "crazykidsgame"], "long_description": "Scary Dad: Escape Horror House is a spine-chilling horror escape game where you are trapped inside a dark, eerie house with a terrifying and unpredictable dad. Your only goal: escape before he finds you!\n\n\ud83d\udd26 Explore the haunted house \u2013 Search for clues, solve puzzles, and uncover the house\u2019s dark secrets.\n\ud83d\ude28 Hide and survive \u2013 Stay quiet and find hiding spots to avoid the scary dad lurking in the shadows.\n\ud83d\udd75\ufe0f Solve mind-bending puzzles \u2013 Unlock doors, crack codes, and collect items to escape.\n\ud83c\udfae Immersive horror experience \u2013 Stunning visuals, eerie sounds, and intense gameplay that will keep you on edge.\n\nCan you outsmart the Scary Dad and make it out alive? Play now and test your survival skills!", "short_description": "A darkly comedic VR simulation where you experience the chaos of being an unprepared parent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/angle-game-studio/home", "developer_terms_of_service_url": null, "publisher_name": "Angel Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/angelgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracki
jdTqA&oe=6AFB407D"}, {"file_name": "Screenshot2.png", "id": "1827105278301056", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618274_1827105281634389_7206514209031878017_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcZM-bdQrdMQ7kNvwEydw-K&_nc_oc=AdrF48-a0nJKOctFpZfuwLOkeQzI7MT7iaYwKNEUgmDWTfAHbD_7YxHW357u6jfyQ-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeJYaUlawZ715hWLl6qLUGe2XPY6NRBmcqIA5U5irFxg&oe=6AFB45EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot2.png", "id": "1511107483934272", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617847_1511107487267605_740869897902930723_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEr5p_Wutk8Q7kNvwF3ZG_0&_nc_oc=AdoLogG59fA2lj8PyJyYiCV7VqybBSi7YkZkCWr5Uhpfi9NW_tHDi6ahf6WPAGIpMlQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxEv6E-XyzO9ZI3kfmDnnjbH5YZ5O7H0TUa3Smmca9DQ&oe=6AFB4172"}, "display_name": "See-Thru", "keywords": ["Art", "Paintings", "AR", "Passthrough", "Canvas"], "long_description": "# See real art. In your real space. Before you commit to anything.\nSee-Thru lets you experience artwork the way it's meant to be seen, on your wall, in your room, at true scale.\nBrowse a growing collection of original artwork from independent artists around the world. Each piece can be placed directly into your physical space in augmented reality, so you can see exactly how a painting looks above your couch, in your hallway, or in that awkward blank wall you've never known what to do with.\n\n# How to use See-Thru\nWhen you first open See-Thru, it will request a room scan (if it doesn't exist already).\nYou may then select and experience art the way it's meant to be seen!\nIf something feels off about the artwork placement, you can visualise your walls and adjust the artwork position from the in-app settings page.\n\n# Why we did this\nBuying art online is hard. A thumbnail on a screen tells you nothing about scale, colour accuracy, or how a piece will actually feel in your space. See-Thru closes that gap, giving you the confidence to say yes to a piece because you've actually seen it where it will live.\n\n# For artists\nSee-Thru gives independent artists a space to showcase their work in a way traditional listings can't, letting potential buyers experience a piece at full scale, in context, before ever setting foot in a studio or gallery.\nDiscover art. See it for real. Make it yours.\n\n# To upload artwork or learn more, visit seethru.nz", "short_description": "See-Thru is a platform that lets you view real artwork in augmented reality. You can browse art by different artists and see it in your physical room as if it were real!\n"}]}, "developer_name": "See-Thru Technologies", "developer_privacy_policy_url": "https://seethru.nz/privacy", "developer_terms_of_service_url": "https://seethru.nz/tos", "publisher_name": "See-Thru Technologies", "support_website_url": "https://seethru.nz/contact", "website_url": "https://seethru.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "877379582865093"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26639135505702599"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4546552085605404"}]}, "baseline_offer": {"id": "4546552085605404"}, "is_approved": true, "firstO
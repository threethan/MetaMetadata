 immersive world of Monkos, a thrilling fan game inspired by the wildly popular Gorilla Tag! In Monkos, you don't just run and jump \u2013 you swing through the jungle canopy using your arms, creating a uniquely exhilarating experience that brings a whole new dimension to the multiplayer gaming universe.", "short_description": "This game has gorilla tag based locomotion where you move with your arms\nyour a really strong gorilla without legs!"}]}, "developer_name": "SkateboardVR", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyformonkeyjungle/home", "developer_terms_of_service_url": null, "publisher_name": "SkateboardVR", "support_website_url": null, "website_url": "https://sites.google.com/view/privacypolicyformonkeyjungle/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6796429773796458"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/43931339_368636029452602_3174587635331690565_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVuB3qt0h-sQ7kNvwHEI67J&_nc_oc=Adrw3S2BJ0r6ZFVOvRT1LKcieih0VmrB4qHMdjlPju0tidkweTE_nL2bBLRwSy1XY0E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwW3jWT0uqLS_yJaYPFLwMDdhVrh4aKXfQmbonYAq5Ejg&oe=69C14455"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Jungle", "platform":
 immersive world of Monkos, a thrilling fan game inspired by the wildly popular Gorilla Tag! In Monkos, you don't just run and jump \u2013 you swing through the jungle canopy using your arms, creating a uniquely exhilarating experience that brings a whole new dimension to the multiplayer gaming universe.", "short_description": "This game has gorilla tag based locomotion where you move with your arms\nyour a really strong gorilla without legs!"}]}, "developer_name": "SkateboardVR", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyformonkeyjungle/home", "developer_terms_of_service_url": null, "publisher_name": "SkateboardVR", "support_website_url": null, "website_url": "https://sites.google.com/view/privacypolicyformonkeyjungle/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6796429773796458"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43931339_368636029452602_3174587635331690565_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZyI_5w4xw4Q7kNvwGdcwBd&_nc_oc=AdltlEWk1opR0DFKP3qOZ-BV0nu8XcOm7pppK76ldLZsuNe0ribBCkSw2fwdoaUyHSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8u0dDAZPr2U95z9pE4NEYMcmb_EbudHFbCO-C-tVy0w&oe=69B95B55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Jungle", "platform":
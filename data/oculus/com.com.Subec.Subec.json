er_thumbnail": null, "display_name": "Subec Tag", "keywords": [], "long_description": "Subec Tag takes everything you love about Gorilla Tag and cranks it up. Jump, climb, and wall-bounce your way through custom maps with friends or strangers, all while mastering fast-paced, legless movement. Whether you're outsmarting chasers in tag mode or just messing around in lobbies, Subec Tag is about freedom, skill, and pure VR fun.\nGet ready to sweat, and scream\u2014it\u2019s all part of the game.", "short_description": "Subec Tag is a Gorilla Tag fan game where you do parkour, wall-run, and tag your friends in unique maps\u2014no legs, just pure chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/subec-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BostonGT", "support_website_url": null, "website_url": "https://sites.google.com/view/subec-tag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24170979182498871"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2688883244782851"}]}, "baseline_offer": {"id": "2688883244782851"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753966320, "status": "PUBLISHED", "id": "2688883244782851"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary"
10889_673634937216441_835295034836502690_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDFZdTs2ZWIQ7kNvwGbOAu9&_nc_oc=AdnY4AbtMTLzhHABD3mSS0Z95u1g1rA5efntz-qYyGcz9S_zXgOnvo0GWU8XyVFtzds&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx5UY03TdZzsyYBGB3CdnPjHoGfXwMkedHdl2WFoyEVTA&oe=69BD5856"}, {"file_name": "vlcsnap-2022-03-11-18h40m53s565.png", "id": "369666991646940", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974504_369666994980273_4267715495250266592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCpgGj2XvZsQ7kNvwHjOrpE&_nc_oc=AdnVUrABctxWz1T6rwoxSjowxlHJE9qMucsQZLtUWlIC4BuhjuVaQKHQo5iYTUZ_shA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx08S9y_ezVDz50pZOQxnVNbTHFL1IOyO0NlCjdHRqlLw&oe=69BD5504"}, {"file_name": "vlcsnap-2022-03-11-18h39m43s154.png", "id": "934454660550111", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75307246_934454663883444_4239669583677544814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ppB6yzuO4UQ7kNvwFC_WP_&_nc_oc=Adk5ZKOuOCkWLn1IozmgcYaC1U8KqHLh6Wp3Ml8xrPXQwMSybRcX83AA3mHR6lXikQg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9Jpv8wrMyq2GnvvI9iDMS6NpTRz0ZSLSr8Ps7ecegiw&oe=69BD3ADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_demo.png", "id": "364517208944825", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974456_364517212278158_3595773936783342624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9q7yTALhZQQ7kNvwE5m_cS&_nc_oc=Adk-go5gegGBVqyTaqQkmaVLhzxp1yQRrdw87LhierJKXkqiUDuM6gn2RIgULxljnMg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYSDw2v6K_4r-dTFgVsdNF8mj9sn7L-KmGjSydMdZs-Q&oe=69BD5A07"}, "display_name": "Unblocking Demo", "keywords": [], "long_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\nThe Demo supports 2 game modes: \n\n- Puzzle: 6 levels to complete by clearing all blocks on the boards\n- Arcade: make lines of different colors using all the available pieces before the time runs out in order to avoid the loss of lifes (and for demo purposes, this mode is limited to 3 minutes of gameplay per session)\n\nThe final release of the game will have more puzzle levels, remove the 3 minutes limitation of Arcade mode and add power ups to it and many other features not included in the demo", "short_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\n\nThe Demo supports 2 game modes: Puzzle (6 levels) and Arcade (lifes based mode limited to 3 minutes for demo purposes)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://unblockingvr.com/privacy.html", "developer_terms_of_service_url": "https://unblockingvr.com/terms.html", "publisher_name": "Cristiano Santos", "support_website_url": null, "website_url": "https://unblockingvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "677898063264507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974504_4662614883866412_3232766945765350759_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rWis2EfzcgQ7kNvwGF-V26&_nc_oc=Adnn2QadCS8T9I_G6oDLSI7xfmxyBjdr00og7ELKUCDPhf64ZFt77WPZpAmcuCtbsCU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Af
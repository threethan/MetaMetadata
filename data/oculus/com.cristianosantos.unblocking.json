210889_673634937216441_835295034836502690_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjN9FcJP6GcQ7kNvwHIohR9&_nc_oc=AdpGqXQ4fLemg8CNbW7-8Al_56PH0pgNaYXcsYUu74NSY3hy-QIXN9fWe6RVk5kG9ME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrWZytaG34ilEMUNsuIBPI7FxaWPiZCCGHm5PsR5B1Lg&oe=6B0C6D96"}, {"file_name": "vlcsnap-2022-03-11-18h40m53s565.png", "id": "369666991646940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974504_369666994980273_4267715495250266592_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0qExboIVloQ7kNvwG40ZQz&_nc_oc=Ado4F847ZvWw5C8nNIrilhOBlRNd7ev68CHuPBsimdWrxKYWwclgsdAbioM1SuGKlT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRkgy4Gf5ormRMM3pUq66o-WEFm5tvzzbYgYmO_J5EMw&oe=6B0C6A44"}, {"file_name": "vlcsnap-2022-03-11-18h39m43s154.png", "id": "934454660550111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307246_934454663883444_4239669583677544814_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-9XEhrHmpEQ7kNvwFCro_d&_nc_oc=AdoQreV2GAqbaPXaoj5RlM_Lnz8kyNGct0g7BklWYYgiR66GKx4CsvTBGZV1W5vQeTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQl4np85cK3TeQBgyME7A9Hqnnj6FboK2WQF6jYIjrx7g&oe=6B0C501F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Unblocking Demo", "keywords": [], "long_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\nThe Demo supports 2 game modes: \n\n- Puzzle: 6 levels to complete by clearing all blocks on the boards\n- Arcade: make lines of different colors using all the available pieces before the time runs out in order to avoid the loss of lifes (and for demo purposes, this mode is limited to 3 minutes of gameplay per session)\n\nThe final release of the game will have more puzzle levels, remove the 3 minutes limitation of Arcade mode and add power ups to it and many other features not included in the demo", "short_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\n\nThe Demo supports 2 game modes: Puzzle (6 levels) and Arcade (lifes based mode limited to 3 minutes for demo purposes)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://unblockingvr.com/privacy.html", "developer_terms_of_service_url": "https://unblockingvr.com/terms.html", "publisher_name": "Cristiano Santos", "support_website_url": null, "website_url": "https://unblockingvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "673981157191899"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "404945871471245"}]}, "baseline_offer": {"id": "404945871471245"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1650754800, "status": "PUBLISHED", "id": "404945871471245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8035057023186428", "version": "1.0.2"}, "id": "1039010436651254", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7856656291026503", "is_concept": false, "latest_rele
OnalvihujF1sPFHJYgueEThHrSI67duochHLelwghonPwJ-Ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40pL_Kba10oGZzjkX3xu5ghHhBuZ2YXyODd9DINlUqHQ&oe=69FB4B84"}, {"file_name": "vlcsnap-2022-03-11-18h39m43s154.png", "id": "934454660550111", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307246_934454663883444_4239669583677544814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02agartHYXYQ7kNvwE1kjqc&_nc_oc=Adrovw_UfzAugbQC-cCVQP6rAGTjPWIH6qR-xWburwkQLF4v4Zr_w9KQlgJW4iCinZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6drxv4Dlp6YEy9-ZBP-_mH91pZ0-S4qQ2YVE5y3X-QKw&oe=69FB315F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Unblocking Demo", "keywords": [], "long_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\nThe Demo supports 2 game modes: \n\n- Puzzle: 6 levels to complete by clearing all blocks on the boards\n- Arcade: make lines of different colors using all the available pieces before the time runs out in order to avoid the loss of lifes (and for demo purposes, this mode is limited to 3 minutes of gameplay per session)\n\nThe final release of the game will have more puzzle levels, remove the 3 minutes limitation of Arcade mode and add power ups to it and many other features not included in the demo", "short_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\n\nThe Demo supports 2 game modes: Puzzle (6 levels) and Arcade (lifes based mode limited to 3 minutes for demo purposes)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://unblockingvr.com/privacy.html", "developer_terms_of_service_url": "https://unblockingvr.com/terms.html", "publisher_name": "Cristiano Santos", "support_website_url": null, "website_url": "https://unblockingvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
K1N95tw6WprxtFo1R_s6ZpFXFIdyd6mL4g032EniscntudslQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa7pbFbLzD4YkcJKWsn05fJqv5xOUce4HndNlwEmMYQA&oe=6ABBC684"}, {"file_name": "vlcsnap-2022-03-11-18h39m43s154.png", "id": "934454660550111", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75307246_934454663883444_4239669583677544814_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTpFFEfwlL8Q7kNvwFPto5Q&_nc_oc=AdrUksNaTCIQvZFajeQ7xIdPzyXpK7t6wYqa3IHuHBIf4CMBlbSZLIJZT7doerq-zao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZx0jgCa92_VcYi_Pohwm_Z4h2x7gyBChEOJthwhhaig&oe=6ABBE49F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Unblocking Demo", "keywords": [], "long_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\nThe Demo supports 2 game modes: \n\n- Puzzle: 6 levels to complete by clearing all blocks on the boards\n- Arcade: make lines of different colors using all the available pieces before the time runs out in order to avoid the loss of lifes (and for demo purposes, this mode is limited to 3 minutes of gameplay per session)\n\nThe final release of the game will have more puzzle levels, remove the 3 minutes limitation of Arcade mode and add power ups to it and many other features not included in the demo", "short_description": "Unblocking is a casual VR game based on dragging piece blocks to clear lines/boards.\n\nThe Demo supports 2 game modes: Puzzle (6 levels) and Arcade (lifes based mode limited to 3 minutes for demo purposes)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://unblockingvr.com/privacy.html", "developer_terms_of_service_url": "https://unblockingvr.com/terms.html", "publisher_name": "Cristiano Santos", "support_website_url": null, "website_url": "https://unblockingvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
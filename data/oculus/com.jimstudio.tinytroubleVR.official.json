1rUynRsxZQ&oe=6B0C6EB9"}, {"file_name": "02_island_course.png", "id": "1143192974969717", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/788764420_1143192978303050_2608727546700511991_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8hge_AHZL8Q7kNvwHqe4W8&_nc_oc=AdrdtQU6dnv5FzfklLE0mxLdCTuq9PV6I2cl4S_o-wfPhgKgVjD057Gw4w1NQRw_8jM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMxZ9R9tMhVaVTMXdnzrpPBzHH6faSQtViYSmUNx8Law&oe=6B0C67D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1035754236250456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593761155_1035754239583789_1116660503830677760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE6vbl6F5rsQ7kNvwF8E66b&_nc_oc=AdoSh5rw0qowH7THQr9KqWkr0Fi6MOHYhxN8I2KhMnqDuT0cZ1Kx8lZeNSF6qc7Q9KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJC5P67pO3HqQsgYcvnitSrPDDsb6Tl6T-yrPmzbf62w&oe=6B0C4F7A"}, "display_name": "Tiny Trouble VR", "keywords": ["bird", "flying", "racing", "exploration", "BirdCare"], "long_description": "See the world from a bird's perspective in Tiny Trouble VR, a single-player adventure combining flight, racing, and caring for your growing flock.\n\nEXPLORE AND COLLECT\nFly between colorful islands, swoop toward picnic tables to collect food, and bring your finds back to the nest. Watch out for tourists defending their snacks and birds of prey on the hunt!\n\nRAISE YOUR FLOCK\nHatch eggs, gather food for hungry chicks, and watch them grow. When they are ready, release them into the sky and see the birds you raised join your flock.\n\nRACE AND COMPETE\nFly through course rings and compete against computer-controlled birds. In Alley, collect items and use them against your rivals while navigating the route and avoiding incoming attacks.\n\nTHREE MAPS TO DISCOVER\nEnjoy three playable maps with different activities, plus a dedicated flight tutorial. Explore ocean scenery, islands, and distant mountain ridges as you discover your favorite way to play.\n\nTiny Trouble VR is the paid full release.", "short_description": "Spread your wings in Tiny Trouble VR! Explore colorful islands, race against rival birds, collect food, raise chicks, and release them into the sky. Enjoy three maps combining aerial adventure, playful competition, and nest life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zp1412042552-hue.github.io/TinyTrouble_Website/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ZP Games", "support_website_url": null, "website_url": "https://zp1412042552-hue.github.io/TinyTrouble_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1614993913270274"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1652779826334037"}]}, "baseline_offer": {"id": "1652779826334037"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795227720, "status": "PUBLISHED", "id": "1652779826334037"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1621431869293145", "version": "1.0"}, "id": "2653741715098598", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
VpqdZhlElRVQ&oe=6B105082"}, {"file_name": "03_rival_bird_encounter.png", "id": "1162973876422731", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_1162973879756064_2979667026547452987_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_ig4UO4fCMQ7kNvwF-0B_v&_nc_oc=Adqk4da7tsEXLa2ly7pdB9-PhX9ZwjWMQyphlESvfkN_oOiqLE--xutJTVKbgdhKegA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdKsjFPjLWhyBs0lCT4_0mgkFVDBuRQlMFvTCgJh_fvw&oe=6B10643F"}, {"file_name": "01_alley_city_rings.png", "id": "1894925611920982", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499627477_1894925615254315_1054154935886545686_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcULK-6EB7AQ7kNvwHjJnGU&_nc_oc=Adpz2VWug5qszweR0aqh8eRcG249uv-LHl2Ek3UVeq0G8P8EfhGeZvjZZn0CExvf0yI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVd5kNORbTA-U3xu9wdpVSuVYAOIPAGo6IE10FKGoPWg&oe=6B106339"}, {"file_name": "02_island_course.png", "id": "1143192974969717", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/788764420_1143192978303050_2608727546700511991_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_bjpA4Vpz8Q7kNvwENXrxu&_nc_oc=Adqux6CgidMkUgCkYZwCSniOroDYLWUqqVQGdomouKYd10LQRHuYCyKzI2aal_bxGz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqJqh5KcJhlMFUxXG_6iIUm8CVKpc1ICBi73kzJUDNmg&oe=6B105C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1035754236250456", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593761155_1035754239583789_1116660503830677760_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kxdoA3yVXYQ7kNvwEfPDLI&_nc_oc=AdpyxLw-7hqlgtJiTGrwMpToH7-v9EnzLFjpUjuDY24BYzEELz74xOt3GpsvCqifiYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUd27V3X3AfbQye1S-Y0hLmPomgF-dpQJIjoEyKgHEh2g&oe=6B1043FA"}, "display_name": "Tiny Trouble VR", "keywords": ["bird", "flying", "racing", "exploration", "BirdCare"], "long_description": "Tiny Trouble VR is a VR flying adventure built around the fantasy of becoming one with a bird. Instead of simply controlling a vehicle, you feel as if you are standing on the bird's back, sharing its movement, speed, and instinct as you race through open skies.\n\nIn this demo, the core experience focuses on flight and aerial racing. Players guide their bird through the air, learn its rhythm, and enjoy the physical sense of soaring, turning, diving, and accelerating in VR. The goal is to make flying feel natural, exciting, and personal.\n\nThe project is designed to grow beyond racing. Future updates are planned to introduce exploration and combat modes, where the bird is not only a mount but also a companion. Players may travel through beautiful environments, discover scenic routes, and face enemies together with their bird partner.\n\n\nEXPLORE AND COLLECT\nFly between colorful islands, swoop toward picnic tables to collect food, and bring your finds back to the nest. Watch out for tourists defending their snacks and birds of prey on the hunt!\n\nRAISE YOUR FLOCK\nHatch eggs, gather food for hungry chicks, and watch them grow. When they are ready, release them into the sky and see the birds you raised join your flock.\n\n\nTHREE MAPS TO DISCOVER\nEnjoy three playable maps with different activities, plus a dedicated flight tutorial. Explore ocean scenery, islands, and distant mountain ridges as you discover your favorite way to play.", "short_description": "Spread your wings in Tiny Trouble VR! Explore colorful islands, race against rival birds, collect food, raise chicks, and release them into the sky. Enjoy three maps combining aerial adventure, playful competition, and nest life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zp1412042552-hue.github.io/TinyTrouble_Website/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ZP Games", "support_website_url": null, "website_url": "https://zp1412042552-hue.github.io/TinyTrouble_Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1624493098987022"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622195_1009297178878113_3252497131309740834_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjdqkI-BMS0Q7kNvwEdB6t0&_nc_oc=AdqpLEP5lxPCIJRPQ41sE04uBYbnsaK_Ps1Lb5_CpBbGoOrS444TZ73XmcHhwOo8Ru0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWsOqtpHVk977WJgUBG2hTX2SFOLPjgdIq0RLDhvrot6g&oe=6B106BBA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tiny Trouble VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1795227720, "lastRevision": {"nodes": [{"id": "1614993919936940", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1614993896603609", "is_first_party": false, "ena
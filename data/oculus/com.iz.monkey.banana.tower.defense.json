=6e7a0a&_nc_ohc=nswc3s4LkM8Q7kNvwGxCiU8&_nc_oc=AdpFrzN30g-dMkQIUTriS8wl7V6FKtmyyVEOitlHWqUWdGo3QFKuh5QYlge0-cNJU5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T4TGupQuz8Wrmh8SVrUjuTHJXBdD3bJa1oOOLimhFFg&oe=69DA2EEE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNrHEYGg1VsQ7kNvwGrcO4d&_nc_oc=Adrli9uGiUe0VL5tb0v90CPR3nBZxWlDFt85q8oQedIJwP7zflfPcwXurE_tTrcRyho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NriLdoGu0e1NqaLSTuIEPGYmGQeSGSNVN4Juhu_Vjig&oe=69DA575C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8B91DlzteQQ7kNvwEvSnlU&_nc_oc=AdpO-1EAen7R975MpJmn-N1OjVZWkw4Kg7yrik3s2uAjUFCUtbRINL1UilJP4vxDLkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2558esfD5-NNFakHn_MV5aVz23NWgmin9mYf8knPcTew&oe=69DA4F9B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQpd7t4HocAQ7kNvwEHODsa&_nc_oc=AdrPzevGL77YA6AFRo8Ef6sDuSSXHhYlZqs1gsXzRpez6mOEI8I2y6bh3Xg_UboG7tc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BP6X5-54aP3xqpEGrikhhJZixfb0SPJmXCvD_AoIWqA&oe=69DA2C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlkvY0O6soEQ7kNvwEPNVEW&_nc_oc=AdpKMCCRSE_9l-wvDHEzSj2bKEVWqFJa0wUnm2mAtEF3QgyCpNzj3HPmPKVNylxL65Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VnTUuZwDEtXiP9hUWkfblC9QF4n7ODvQy7TL81MW7vA&oe=69DA435F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
=6e7a0a&_nc_ohc=vwenvSJU-SoQ7kNvwFV1sWs&_nc_oc=AdrwcBrqde1UFm9-67LJ82UC1B7Cy3WXaWabPV8Jvpnrbg5dGYVXVYS9OL7pe09o8L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hzHC1ayvhVbKvxN8paMvi_j8lnEDTRP6ILgsU9EjAJA&oe=69D4E8EE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmnTRyzyiVUQ7kNvwEotl29&_nc_oc=Adq6iTG3CPnUbpUQ2N-Co9SRlovez25BbdiRzju3NHVND82p_rcMGTZRIwxBKJOQWMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SJeaLVhvanJXo6fqSCFX_SkdmpaRNNYtN1C9qyHFZng&oe=69D5115C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIWRXZn5CT0Q7kNvwFctoI2&_nc_oc=Adq14F2Fcdh9Kzq3XMFZlW2eZzLIJFqLzeYhz3zux1V_JJ-8wWvhVKscYEd4P4qszwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xLF_n6VMHTNf3VCUMU6nI5XmWPNq7vbPmKPoFMM8GsA&oe=69D5099B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6DIT8FGAwYQ7kNvwGUbG91&_nc_oc=AdoVXNrxTSAdk26HvMSsilhCvF9tlR-q29UKz2KAom8KiNEw-oTaxw1-_fMWRE8Hp40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R-Tq45ENw-ZX2Uvu0QFVW5UstVu7BwDVALGYSURtb6w&oe=69D4E69A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93krycy-UREQ7kNvwFtYZ1o&_nc_oc=Ado5KbEiwiyDuu8ClLGCWTgBRVoMmG21HEWrcPe5T7cUq--YqfUKX1gE78scLbz2YkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F17xaxraixfeP_MVHWZfcJCdISWOknlkjY5viRS2tWw&oe=69D4FD5F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
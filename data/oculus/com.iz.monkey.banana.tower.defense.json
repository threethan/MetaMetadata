gxb5IyfazUgkg&oe=6A2448D2"}, {"file_name": "Monkey Tower 2.png", "id": "1313076090246168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619627_1313076093579501_7380278124506426359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0C3Q2YOdJUQ7kNvwEEmLOY&_nc_oc=AdqT6bHLbHOmoIpbkai3g68xmCv5H1q7hzUtYD2RK720idp01VoMjwlUZAgFaLe9RlI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YTjmND319gJDpyoX5cDzWQdjdn5FN0XfxZJ0pKd947g&oe=6A2430BA"}, {"file_name": "Monkey Tower 3.png", "id": "1025829273341428", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619481_1025829280008094_6959055357781014068_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIg56VCZ1wkQ7kNvwGhxtL1&_nc_oc=Adqr0OYOjWLSi_ihhF0bsdiAMzIyBdyBmEbIIUg3kXI9EQKZfmHhR7rXTos0J1JWDo4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__y3VAwRx_H5XxDdqaP24LZScMpXIIr0EaAcZxF9VbMQ&oe=6A24448D"}, {"file_name": "shot-5.png", "id": "1146153354244203", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304305_1146153357577536_3351294725127879628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHxrLsIM-RgQ7kNvwEL53kz&_nc_oc=AdqFuBt78mV9aH2FJ293UQCyugquHnDWBYbZPpRQBdphuA_NzK-24lnTndi7dkokTeU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RW96fF2z3ynYUuTRVi-qg_2kY_QBHiFLfqpN_XUegTw&oe=6A243B2E"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sESdtV-X6oQ7kNvwEqbIQ5&_nc_oc=AdoxoJU8s0bxoA2vUKohd42aUZ0HKEOGYydJygXCzGVJNbPyX9m9O3O-kkGCmih3uho&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97z1uDR0VOFjcBj-976j01AatYx3YGiopyljJ5ljXAHg&oe=6A242B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ3DPvIGNqoQ7kNvwE2W5es&_nc_oc=AdoRSI7-GustA18VHwMwoHa_0jveAiTcn8hXyqhaEaZWRPqMPkKVguw9KFP4hg1jsKY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80sbbCwc-va59Ib__kS-QDA0JTwRZpGYGIIs68UagWYw&oe=6A24175F"}, "display_name": "Be a Monkey : Co-op Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "toss"], "long_description": "Join the Treta Studios Discord:  https://tretastudios.com/discord\n\n# Defend your tower, monkey-style \u2013 in VR!\n\nGuard your monkey tower from incoming enemies! Build defenses, stay alert, and protect your tower in this fun and exciting tower defense adventure in VR.\n{868678299586288}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nJump into multiplayer mode and play with friends! Team up or compete with others in fun VR challenges and enjoy exciting cooperative action.\n{2193224821532532}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\n", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}, {"images": {"nodes": []}, "id": "1496202308620209", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Monkey : Co-op Tower Defense", "keywords": ["Disparos", "Ataque", "Guardia", "Explosiones", "Lanzamientos"], "long_description": "\u00danete al Discord de Treta Studios: https://tretastudios.com/discord\n\n# Defiende tu torre, \u00a1al estilo mono y en realidad virtual!\n\n\u00a1Protege tu torre de mono de los enemigos que se acercan! Construye defensas, mantente alerta y resguarda tu torre en esta divertida y emocionante aventura de defensa de torres en realidad virtual.\n{3290417087806716}\n\nPrep\u00e1rate para una batalla de RV trepidante en la que tu mono debe defender su territorio utilizando una combinaci\u00f3n de lanzamiento de piedras, minas explosivas y disparos de doble ca\u00f1\u00f3n contra implacables oleadas de adversarios.\n{4482249018722536}\n\n\u00a1L\u00e1nzate al modo multijugador y juega con tus amigos! Forma equipo o compite contra otros en divertidos desaf\u00edos de RV y disfruta de una emocionante acci\u00f3n cooperativa.\n{1513027570202027}\n\nParticipa en combates de RV repletos de acci\u00f3n, utilizando minas explosivas y una escopeta de doble ca\u00f1\u00f3n para abrirte paso a base de disparos a trav\u00e9s de oleadas de invasores cada vez m\u00e1s dif\u00edciles en este intenso juego de defensa de torres.\n{1685683619121969}", "short_description": "\u00a1Ponte en la piel de un mono en realidad virtual que defiende su torre! Usa piedras, minas y una escopeta de doble ca\u00f1\u00f3n para detener las oleadas de enemigos que se aproximan en esta experiencia de defensa de torres inmersiva y de ritmo fren\u00e9tico."}, {"images": {"nodes": []}, "id": "1466161094744031", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Monkey : Co-op Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "Toss"], "long_description": "Join the Treta Studios Discord:  https://tretastudios.com/discord\n\n# Defend your tower, monkey-style \u2013 in VR!\n\nGuard your monkey tower from incoming enemies! Build defenses, stay alert, and protect your tower in this fun and exciting tower defense adventure in VR.\n{980021711434443}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{955345830834740}\n\n\nJump into multiplayer mode and play with friends! Team up or compete with others in fun VR challenges and enjoy exciting cooperative action.\n{1015490991060908}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1731532301616173}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}, {"images": {"nodes": []}, "id": "1206937768107890", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Monkey : Co-op Tower Defense", "keywords": ["Schie\u00dfen", "Angriff", "Verteidigung", "Sprengen", "Werfen"], "long_description": "Tritt dem Discord von Treta Studios bei: https://tretastudios.com/discord\n\n# Verteidige deinen Turm \u2013 auf Affenart \u2013 in VR!\n\nBesch\u00fctze deinen Affenturm vor anr\u00fcckenden Feinden! Errichte Verteidigungsanlagen, bleib wachsam und sichere deinen Turm in diesem spa\u00dfigen und spannenden Tower-Defense-Abenteuer in VR.\n{4305627776356424}\n\nMach dich bereit f\u00fcr einen packenden VR-Kampf, in dem dein Affe sein Territorium verteidigen muss \u2013 mit einer Mischung aus Steinw\u00fcrfen, explosiven Minen und Sch\u00fcssen aus der Doppelflinte gegen unerbittliche Gegnerwellen.\n{1627674442046369}\n\nSt\u00fcrze dich in den Multiplayer-Modus und spiele gemeinsam mit Freunden! Verb\u00fcndet euch oder tretet in spa\u00dfigen VR-Herausforderungen gegeneinander an und erlebt spannende Koop-Action.\n{1757786785396139}\n\nSt\u00fcrze dich in actiongeladene VR-Gefechte und bahne dir \u2013 bewaffnet mit Minen und einer Doppelflinte \u2013 deinen Weg durch immer h\u00e4rter werdende Wellen von Eindringlingen in diesem intensiven Tower-Defense-Spiel.\n{3556517871166638}\n", "short_description": "Schl\u00fcpfe in die Rolle eines VR-Affen, der seinen Turm verteidigt! Nutze Steine, Minen und eine doppell\u00e4ufige Flinte, um anrollende Gegnerwellen in diesem immersiven und rasanten Tower-Defense-Erlebnis aufzuhalten."}, {"images": {"nodes": []}, "id": "864424486054492", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Monkey : Co-op Tower Defense", "keywords": ["Disparos", "Ataque", "Guardia", "Explosiones", "Lanzamientos"], "long_description": "\u00danete al Discord de Treta Studios: https://tretastudios.com/discord\n\n# Defiende tu torre, \u00a1al estilo mono y en realidad virtual!\n\n\u00a1Protege tu torre de mono de los enemigos que se acercan! Construye defensas, mantente alerta y resguarda tu torre en esta divertida y emocionante aventura de defensa de torres en realidad virtual.\n{1976354149680258}\n\nPrep\u00e1rate para una batalla de RV trepidante en la que tu mono debe defender su territorio utilizando una combinaci\u00f3n de lanzamiento de piedras, minas explosivas y disparos de doble ca\u00f1\u00f3n contra implacables oleadas de adversarios.\n{1515158070077972}\n\n\u00a1L\u00e1nzate al modo multijugador y juega con tus amigos! Forma equipo o compite contra otros en divertidos desaf\u00edos de RV y disfruta de una emocionante acci\u00f3n cooperativa.\n{1009245988463019}\n\nParticipa en combates de RV repletos de acci\u00f3n, utilizando minas explosivas y una escopeta de doble ca\u00f1\u00f3n para abrirte paso a base de disparos a trav\u00e9s de oleadas de invasores cada vez m\u00e1s dif\u00edciles en este intenso juego de defensa de torres.\n{4375495476039102}\n", "short_description": "\u00a1Ponte en la piel de un mono en realidad virtual que defiende su torre! Usa piedras, minas y una escopeta de doble ca\u00f1\u00f3n para detener las oleadas de enemigos que se aproximan en esta experiencia de defensa de torres inmersiva y de ritmo fren\u00e9tico."}]}, "developer
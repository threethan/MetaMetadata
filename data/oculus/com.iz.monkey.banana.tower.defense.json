=6e7a0a&_nc_ohc=hflPmzbxTFkQ7kNvwFHlaHo&_nc_oc=Adr8ZkTdQY2q4mXUjfD1g4s0blK8pRrKQsczlJ1remG55WIxdoUqhULFUl2IS0IfeyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzooaoKm6h8qkfWx-ip_Vj4uVJLj7adozLKg2SGla-Jjg&oe=69CCFFEE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTE_EAl7xscQ7kNvwHCVkTj&_nc_oc=Adrv4zi7E2bZU560ID1J4AP86v2l77hJ-wgMP7zPQu1Uy7Qe3t31Xa15ioIebReBEJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwotz_JVP-hL7L1sHZwQh3su1ykAtXhvXYe-Wsw1jIVKA&oe=69CD285C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s394QBOoZcUQ7kNvwGEUKBp&_nc_oc=AdqQlN6ze1gA-rwvbamfyTUuwsfPUUIxlOvytGCtLIw_F0s6jHWOaX5phWrVvfJB-q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBsacBXeJ3oPR0pJoWV_DxYcDX6NY3lOBRGZv2QRmXaw&oe=69CD209B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDxR5TyRvocQ7kNvwF1TmdW&_nc_oc=AdonMiSFhkk4w4NA3ySj9NHQlmtxeoiCI6PgG6bstzku3TY9NsArrvhxj8NgkvHaAUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJFcoUQlkE3rvB1ASbbI_UXu61xjYMaepv3zpzRS3eSQ&oe=69CCFD9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BevOOqr2ed8Q7kNvwH4xK7k&_nc_oc=Adp9dMZVwf-aLtsbKAYjl75wTyjtsZFRQiX4M2CI4vE_Xw3ujRucyGaqvOmrBlxfDBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPYlhFe8Z-UckEehWORY6hV_BYsojT2LjgsjSbjhckPw&oe=69CD145F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
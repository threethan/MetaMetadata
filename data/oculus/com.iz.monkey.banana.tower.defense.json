-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quc5-kV49hQQ7kNvwFvkhi6&_nc_oc=AdrEZ87-Qd4i0p1xc6iCAoBxdEGjB8AzRfrfUco11jWLf2fnpsfDS13Y4nZMsxICvco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1sa9w34fALDmgq8py38c75ajQYyCgyix0fyXf79v5TVQ&oe=69F8B75A"}, {"file_name": "shot-4.png", "id": "814073127743296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820382_814073131076629_6986470731692759230_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0Nza7Xk2ksQ7kNvwFFw4UU&_nc_oc=AdoS50XSKj1LFvJ9sogQtnc0BPWJ5gNKqbE0cHc0zEEDhG3elOtTaAM4kyhHR6JOmvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZTDCRu5nMhwi0Og1IbvIdrh8hLtvx9XnZ3B5rZHNPLg&oe=69F8954E"}, {"file_name": "shot-5.png", "id": "1146153354244203", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304305_1146153357577536_3351294725127879628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auau6-4nlv8Q7kNvwHQI91F&_nc_oc=AdoOKeQIb3i3x5As8bCmcs54xMA8RqQxAz2ReCry_VgkLSbxo5_Wk6vDWq05ygK_Spg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NoCKC4IpD-vdeSs6kSgDuz6lX4Y6HgiZrigQe66nVoA&oe=69F8B9AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24916489591350213"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1647025683429986"}, {"status": "PUBLISHED", "id": "1404649591416108"}, {"status": "PUBLISHED", "id": "1247858044141970"}, {"status": "PUBLISHED", "id": "795779713127244"}, {"status": "PUBLISHED", "id": "805043025448035"}]}, "baseline_offer": {"id": "795779713127244"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774409640, "status": "PUBLISHED", "id": "1647025683429986"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__type
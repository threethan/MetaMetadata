=6e7a0a&_nc_ohc=rszV-qFuh3wQ7kNvwHVYaPN&_nc_oc=AdqqQAhPKWPCbPbVzengucWPEF7DdQOh7dWAEPqo2aOFFXZBQ3ci0FinvEd5f0TVHqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qJ7fYH_VwmRV5lSjfgoAHbSumZkEW858bY_k5ty8LEg&oe=69E8AF6E"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auktu0hXSeUQ7kNvwHXzShr&_nc_oc=AdoYsglZQTH2PWWkks4ZA5u56bj6xgmH24hxs54kjtHoxfRV9yqk-PQA1nT-n2LiznQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bYx9d2j-JF4VQTs_aFpPgVYXNGC3RUEhwitT7_RHptQ&oe=69E8D7DC"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL_PU-hAQbUQ7kNvwFq4hkv&_nc_oc=AdovBsPpIaIGpjZ5xlyWV9-qDxgMmKGBbbb2N0i--yqpi7oABJAUOEJmTlg5XfEgucQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k-PDildgrAiGVOkeWE3Af2FjdgSFfiCT7mPEdL5uwzw&oe=69E8D01B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DULN1c9RahQQ7kNvwFw5607&_nc_oc=AdrNyUNgEjyPBarssdGHDlDXNrEXddzr_fkTvsENalvb3sRTqGX5YUZXyNT8yQI8fKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23YEj7KJaGfEjarWCHdyVL3MaDuxdRHtFDkyt6dHU5jg&oe=69E8AD1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPW-q8a7Ru8Q7kNvwFaclwc&_nc_oc=Adr-AO-qmhghneYGuthbXTMNlkqST3k_ZULXeVBXidPXURtBo2DdaIQ-tGm3csSAoeo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VZWDoVZxCOAD0Pb1KY8c1hmhvvr72FPa9UaBkQ1IFtg&oe=69E8C3DF"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
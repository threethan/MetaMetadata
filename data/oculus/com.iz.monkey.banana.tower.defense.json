=6e7a0a&_nc_ohc=rszV-qFuh3wQ7kNvwFcJwVN&_nc_oc=AdroLyYjOCcmar9Gm_k592PE8ZxNBdtoP_Pn6A6rbBI-rtzGd7Cbf-xxTULFggcFyAU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CGV3_Gh2V0AetOYZjeHBp-gkHe1bt1tut8OHXVYqpJQ&oe=69E75DEE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auktu0hXSeUQ7kNvwF1PLvr&_nc_oc=Adpr2Uf_SkrJTnk38ccidjUWT6pJzZEzgXMOuvRrYDDIkvmGnXTlR2VkbLVPUPg44qM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3p2pfj3lfsCbRhe_1bcdzVr5fmBqvudt-YwTcFuph1tQ&oe=69E7865C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL_PU-hAQbUQ7kNvwHQgc6t&_nc_oc=AdqpgIKlzoRx8X4HylE-_ippPiZXzRZAdPti2JXgfmHC5BbHpxxErJxyDNxCBA8-5NM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06Ted8QebQs_H2SKMk8VkBPftahhgzjBaoPdEnU3RTOA&oe=69E77E9B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYPl2ADskqQQ7kNvwFpJyEv&_nc_oc=AdoBsfJUrPU41-Ykofk_E3qauP6xq_DtbgFy9ptHh0zZA7rqGVFwLGhT83SkPB1DlKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JxFAt8nTbfoxAFMJfN4jQDfTWRrnYQIaCos0Fd9_ENA&oe=69E75B9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPW-q8a7Ru8Q7kNvwGus80Q&_nc_oc=AdqDMNi04d63BFemdaxNtEcSimp89GA_Arb7dARfsLleFCo2rt_FWInwLB5rwh9I_fg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kJMASmOEXaE2Jm2vxzHa8oyIB9LfNynLhorDUAZPUNw&oe=69E7725F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
=6e7a0a&_nc_ohc=GXSWh6eHIUsQ7kNvwHp1nuy&_nc_oc=Adpv0Qq4OtGWHEBtj_ELCW3oEvXXk4J_u1UcFCp5dUFMyBpMkVETgtXPrTIOR0rrIkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35Z-nLr25-x6cLfnrQDIePa-k8Jhy5ulV1vmD3RnM_ag&oe=69EB8AAE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfIiedZug-MQ7kNvwGq1Q_M&_nc_oc=AdpZAERzojBs21WOJNZBk0vsmnfaFZLfcuaoiBNFhpbl-6vBZsLKllcB7VKBNZgTqQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_Gdez9yaejF01bG3HOLqmFCHya2DnTTf81S62jHj2Rw&oe=69EB7ADC"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E92r7PZnjr4Q7kNvwHw2XwI&_nc_oc=AdqGYfBGO9V5Jy4CJ_BYqI6zTA-_y_IebJICTitff3jNVGY5OScTl1nS9yB0GO9VK1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZPPt9RZpyxwNvj4tXnAAihuD9m-pK1dc_KJUKc4u_Nw&oe=69EB731B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DULN1c9RahQQ7kNvwEivdRx&_nc_oc=AdppwuGGoqAD3SY5comg1l451kJNDyVDMyCauH6UvBtVPziKVFcci8B7S8Uer1d9P5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20vXLLXIavmcYUcW5zZbPj4tHxvMToe5hNTKH99v0xZg&oe=69EB885A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqC3eolo-EwQ7kNvwHT9yk3&_nc_oc=Adp5daP7I4SONjK5buVm_egARYrUQnDyMYRg599TQJ4xcIaNG58Ax-1guf0b05pfLbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XC_tEwWc4G7lxXTe4Ih31w8mP9ndOgB1KLYdXtvzjjA&oe=69EB66DF"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
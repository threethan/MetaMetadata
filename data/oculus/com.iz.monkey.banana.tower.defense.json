=6e7a0a&_nc_ohc=QsO-s-O13BwQ7kNvwF7u4Xk&_nc_oc=AdqzvF_eK_85aqnBh4nJm1zyGy7xPZGpQaG-offcRWJt113Q0h1qewY4BZpDKX-hais&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fZvYqTbFiJUOVT9RxlQoluBRK-eAmrwWWMV9KP3zwaQ&oe=69E3696E"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh1Ij_UvVIIQ7kNvwFYMNBr&_nc_oc=Adq0s4ejrwTJdL4UuyifJPgmwgtavEXBg5G0vx-cxGjDaHit7Dbx6MesUDKmFLJ8vEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xp_65uwZtQhKNFoGTjxfASVzGlOwTzvV2MR_nEazaBQ&oe=69E391DC"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwllBfwRoIMQ7kNvwGdCeso&_nc_oc=AdrlEv6de10WRLa5Ivkvxi8iYOdgavQAey-xrdoXzu-3YD6pOlfcDyqz9ZGOBFYXll0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kdez_cXu2rk5EaqOAyxiGIsgZPaRtq4bGjhoOlynbjw&oe=69E38A1B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTVxVCqfZYYQ7kNvwFsAJcL&_nc_oc=AdowDR5LqASnQpOQ0UEk8nLsUc4oHTcT9k6BFBmOQ2zokwLEqWL0qtTj-ksvXixlvKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S-b0FZtqzzKG2fRCl9xxenjathgKbQ_KfspNTMfVywQ&oe=69E3671A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta-QlnedtoYQ7kNvwGXWEAt&_nc_oc=AdqIfRETEMXoji_6o6UxxcOiCweCaxKQL_yKmoT7ZoxGyw6Iawn__KfTvLbUzhWewLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HOAAFoX2rMp6Yd6ipiMy1uqjE8doNXjHPuo4zXdmm1w&oe=69E37DDF"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
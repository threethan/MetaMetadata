=6e7a0a&_nc_ohc=4vMJG6rKwVwQ7kNvwGBSuhh&_nc_oc=AdrV9oP3G93v0D3IcP3VodtGjl2emkH4CaGNWEZeSynWYic6ca3aDXM6An2Sl5l5RP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2anl70HQ2Yt_k4D6ywPaRvWyr-HO1IYiheosAsRj0qBg&oe=69D27E2E"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47KdBUvCD3AQ7kNvwGSZKrU&_nc_oc=AdrdBC43e_5KLcRgHPt0W5cxx4ILY9OmH45Do7gxznNkkyKEZXY_EIafmPi3S9Xc_KM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BVs29VmZvdzNwZqemB0kT6nAWDUgR3Ak1S8BohsIiQA&oe=69D26E5C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIWRXZn5CT0Q7kNvwEZsE_G&_nc_oc=AdoTaDJpIyehqNp4pWcfkojTqMWkmMKsdF0r7vZJelyg-4CoT1Dy2hzqxmYuQfjUVk0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LkDhp_VC0WhDX0lEddqha7XkL2oLyVuPHeky5O-cQ9Q&oe=69D2669B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDntJZjLLzEQ7kNvwGcOicr&_nc_oc=Adp3WNiatRbyf0XN7nURHVo22_go__xFfgmPWCowG55r6-mmO-GenSUm-fCabGgcpKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NiJlDYXBZ7nO3bDf7IyXRSubFexTCf_0CpqAxz9kiwg&oe=69D27BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgH5Wot_-CAQ7kNvwGhZuTN&_nc_oc=AdqzEQJPwf4ZZLEDhcL1i5KuGvxt5ZVq59Ke85WaBy6VpfmPJDRXIyRDCgIzP6MkuhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S_cOnVpfTyrEXc-F98ELRmcGpiy_QP5z9Pi3jNPX4CQ&oe=69D25A5F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
=6e7a0a&_nc_ohc=1KzKZVB6LxQQ7kNvwH-vdS6&_nc_oc=AdrX9GhPv7tJfhn1K2BYYafbAiCN5IMZqXtX-AP_rHaUO5fzNQNyA0dAUBvpEpnvoFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fg9r7Y7xxXG5YiYyQKZ_lfmNo39nhm5pbQfZOyETEbQ&oe=69DCD1EE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-8Yez2dxqcQ7kNvwEcu519&_nc_oc=AdqNxFHm3UtZxEdUs9zBi0CKjzXMl2i8SatjgXhD7c7AGxwl9dDKGRIXf1EEXSealM8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a1wQWeeBkRb7auL2y6eh3p7p5p5mae9959uQonhPiFg&oe=69DCFA5C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8B91DlzteQQ7kNvwEYj1-2&_nc_oc=Adr2AYKKNzCQ-rbAUsQE_hogxYa9pjX86CHNS0_i6v_rHVH9lqQud8GlODeX_KQHBy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A-tXzHofUTXKQhLQ95qO3IcEWbkT1_Sx7d_Ne8GPuEg&oe=69DCF29B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNeOlekyyk4Q7kNvwH5G48D&_nc_oc=AdqF_D08Hcb0JGxBb1AIuP6dkmSOQ1vUGwk51yny2GPd7TBorOAoBUs1GhS-QohYhPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ba349_Pk_Ca8D2LOUe0f3_YAuoR0JjRRRRebi4CGUzw&oe=69DCCF9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVFf1BXfY9UQ7kNvwHNQsC0&_nc_oc=AdpFEz05f6ZSN9u1p4lqWNl7cVRgCVaGkZrP1kAxA8E_guM3n4RXm4df9C-sTy9ht-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eCXkQkgr4zP2bnBMPbnqRjOmJ8yt8J3hPAbW44-Swvw&oe=69DCE65F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
es": [{"id": "10017113878373725"}]}, "id": "1167765258406445"}]}}, "firstRevision": {"nodes": [{"application": {"id": "24552001997798976", "release_date": 1760422920, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 5}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27010649925267492"}, "id": "1946299812830860"}]}}, "binary": null, "live_binary": null, "created_date": 1779854574, "id": "27110046808661136", "is_initial_release": false, "name_with_fallback": "v13", "pdp_metadata_with_fallback": {"version": 11, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "27124145563917927"}, "release_status": "RELEASED", "id": "24552001997798976"}, "id": "27124145563917927", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24552001997798976", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "823831366637312"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1694536138239052", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Be a Monkey : Co-op Tower Defense", "keywords": ["Strzelanie", "Atak", "Obrona", "Eksplozja", "Rzucanie"], "long_description": "Do\u0142\u0105cz do serwera Discord studia Treta Studios: https://tretastudios.com/discord\n\n# Bro\u0144 swojej wie\u017cy w stylu ma\u0142py \u2013 w VR!\n\nChro\u0144 swoj\u0105 ma\u0142pi\u0105 wie\u017c\u0119 przed nadci\u0105gaj\u0105cymi wrogami! Buduj umocnienia, zachowaj czujno\u015b\u0107 i bro\u0144 swojej wie\u017cy w tej pe\u0142nej zabawy i emocji przygodzie typu tower defense w wirtualnej rzeczywisto\u015bci.\n{1222452856495661}\n\nPrzygotuj si\u0119 na porywaj\u0105c\u0105 bitw\u0119 w VR, w kt\u00f3rej twoja ma\u0142pa musi obroni\u0107 swoje terytorium, wykorzystuj\u0105c kombinacj\u0119 rzucania kamieniami, wybuchowych min oraz strza\u0142\u00f3w z dwulufowej strzelby przeciwko nieust\u0119pliwym falom przeciwnik\u00f3w.\n{1469071408322827}\n\nWskocz do trybu wieloosobowego i zagraj ze znajomymi! Po\u0142\u0105czcie si\u0142y lub rywalizujcie ze sob\u0105 w zabawnych wyzwaniach VR i cieszcie si\u0119 ekscytuj\u0105c\u0105 rozgrywk\u0105 kooperacyjn\u0105.\n{4330172417244585}\n\nWe\u017a udzia\u0142 w pe\u0142nej akcji walce w VR, wykorzystuj\u0105c miny-bomby oraz dwulufow\u0105 strzelb\u0119, aby przebi\u0107 si\u0119 przez coraz trudniejsze fale naje\u017ad\u017ac\u00f3w w tej intensywnej grze typu tower defense.\n{1715477372969862}\n", "short_description": "Wciel si\u0119 w ma\u0142p\u0119 VR broni\u0105c\u0105 swojej wie\u017cy! U\u017cywaj kamieni, min i dubelt\u00f3wki, aby powstrzyma\u0107 nadchodz\u0105ce fale wrog\u00f3w w tej wci\u0105gaj\u0105cej i dynamicznej grze typu tower defense."}, {"images": {"nodes": [{"file_name": "1008_1440.png", "id": "26927649383494578", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_26927649396827910_5525611861569998555_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38LhK1AtxH0Q7kNvwH3oiu-&_nc_oc=Adre5dgFng3W3OGPFnsz8WUOhXZEBRwhEYWvrK_zESmLyR--LhU7b9QDvRYYoFCNLyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3zEQzbU6D0ut0WSe8g41_vXe8Mu8WyHxNtAq7ggm3uw&oe=6A2AC3A3"}, {"file_name": "2560_1440.png", "id": "2049913852557461", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_2049913855890794_2487693328059737925_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSmlqU0eiygQ7kNvwFHkwAK&_nc_oc=AdoEbYgU3eWNqcpy03O5zoiruLIaSxrkpsfVvhw2zLBko_yhAR99kh5ZynkrmzvpPxg&_nc_zt=3&_nc_ht=s
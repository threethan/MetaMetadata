=6e7a0a&_nc_ohc=ohBTy0l8B-cQ7kNvwGoa9AH&_nc_oc=AdpAxK1vokyGWu1Oum24UedwSXEN0wo1dzZpbtml6drV4U-vUr6To2mMUI7FKPuFIUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXFngRAyKvGFDADbuj-tsKlZQNv7HKyFWFLsIfLdTbFA&oe=69CA5CEE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBsbLrLn45IQ7kNvwFk178L&_nc_oc=AdocEJRNJ-nuPxvMbmgniTafy-pLuVPBGNvo7hfEnPnQOHSDPoGBedcTDo3U9PI1t5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-UaPUt8rhGZyvlzuTOHBgfXdliLvhRWTeP538gOEWkQ&oe=69CA855C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s394QBOoZcUQ7kNvwHn9hOm&_nc_oc=Adrtj_z2KIEzkA5PQ14AFLBcohcsMivw4RfGSuVgIys2SmV0qu0-WtU5xr9hDmGeDlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVDKbit5T_FuVevSCQmem9RPy7k4CYfrmXaSO4PHkpVw&oe=69CA7D9B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URkG70v9XXsQ7kNvwHqbQEk&_nc_oc=Ador6TpmVVWtqnXeeXFqU_5qmBUfvgYjYjF7yqn1BflbLpogMZ_eXuE-wDqWyPkRE6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymyGX_htgnNI0J-Yw-uh5VDf0ADw2QgVd2mrRSF26uGg&oe=69CA5A9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j4nH5Qo5WQQ7kNvwGdUasS&_nc_oc=AdpZk2oUk6EsrYyOTMnizzI4CKnTnWCkoWN7L-FXxE951L08vtGHC6vV-FKT0lZxhZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypzU9SlAgozwfV5oQ50mD5jcvx7DxeYgGXlTfaQzafLg&oe=69CA715F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
=6e7a0a&_nc_ohc=nswc3s4LkM8Q7kNvwE-y-MH&_nc_oc=AdrOLDpZszY6kSQiHu5WvcX0O20mlpRb6PEnB5oGk1bS-7QZ7g-7GotT-YZOW9hkbak&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lzTZlATEHa75fZMibIw1uC9yKVkhVQmrRFxvMQ1yXVg&oe=69D78BEE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNrHEYGg1VsQ7kNvwHWRMnj&_nc_oc=AdpdAqDUTH0v7da2xHUvvr5K8V6zjX8WkJtXotkM0Jq8U8Puz8yh10SxeUbUYhl53L8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TqbJcyVLqxLklKQz12gThsEEsJSmwGUxPRoBfa7Q69Q&oe=69D7B45C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og0amvxJtMkQ7kNvwE6gsCk&_nc_oc=AdojjVkFthEnMgMaIGfXDob4_duYuyGE7LjSmhyCVvnS1uG9QxKKOP3ovCzbcKYIn2E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22a5X6DbWrWS-9hRzJYxlMvqNZ1H7lgmwMBYUF2mZAqQ&oe=69D7AC9B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6DIT8FGAwYQ7kNvwHDOoOy&_nc_oc=AdqBCG3845VAA6Z-is3SEOSWvbpKESHiU_5EWtQzq9A2fmahSN-zGPk77eublXYgUHk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t-iTo86gQAXXFNXdwQt1JQ8v2LytNaK7altc28a-MHA&oe=69D7899A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlkvY0O6soEQ7kNvwEP3JVH&_nc_oc=AdqDnePU63b2HsmsphXbjS3Q1Tes8V4Epp6Ba_n-mKCRll2_CIyIdMGboNHjufbW1FA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00SaZi4C7H8dmMBpyvxoTJWFZv2blCQP0ftZYJRA4-Fg&oe=69D7A05F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
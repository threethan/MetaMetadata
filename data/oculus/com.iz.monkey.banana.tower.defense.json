=6e7a0a&_nc_ohc=hflPmzbxTFkQ7kNvwHW5Lol&_nc_oc=Adpv4iimZmJraFhtnlmzCmGjdA8I9OPdvL0TXXIO9myhqYrqw9Jvd79gVwnqFd7CkGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXMiBfd6WmkoKFjH1Ccb--ungjG2q8yLHfFkn1iLH7EA&oe=69CE516E"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTE_EAl7xscQ7kNvwFDaOyB&_nc_oc=AdoFnBatqdXvcAWp63dbNdkLWWtkO5x3zCxWOvVR0gPbaJH98wFVDdPmThgRCDmszdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXJVSsOxirB7_QqxHpP6K5xFGWN33YvYkBy7nyYGRYnA&oe=69CE79DC"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyfQrzM8YF4Q7kNvwFA_lRj&_nc_oc=AdrMkONef18vWJozgt450QgGl0avdSca1rBezAHNQmmSqpWGU18a0KmPyCg2bMKCpSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCe1BewRs5iBQhEnwTe3TWrkxzYKZX-HyH5waQh8gBzg&oe=69CE721B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDxR5TyRvocQ7kNvwHLjsUM&_nc_oc=Ado6xvGbvCkpNXNvQGWdkR0X-SG-cJAG7K8vE0qyh1_tDZhQt1Lw2jVD4Rl10aLLglk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzosZlXLsyvtRgTMkojdC8QseXG1pcNfYJ2Uxz7JD6HUA&oe=69CE4F1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BevOOqr2ed8Q7kNvwFX40O6&_nc_oc=Ado2-c5CR9GNLW5TgFug0WqenRB5vkQq0EsARNOGeMkdkpGzNwb7-IFxv1qvSAe2bTo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbO2Vlxc7mTAhV8zsdIsIH1T7yClnGRr4rANNrLGggJw&oe=69CE65DF"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
c&_nc_oc=Adqy8sRfM5J9CG5fU1eKFBNGMurBFkxWBdNxzOplSlvwc0QbH-kDaaBfSqbVFitwOFw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6af-BQ-mJ_pqsUuNVxaVGdJxJwx2a3V-mHB-CeH9sXYQ&oe=6A1ADC4E"}, {"file_name": "shot-5.png", "id": "1146153354244203", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499304305_1146153357577536_3351294725127879628_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwkqk3oxyvQQ7kNvwFKjtD3&_nc_oc=Adpq-qOLEc8335512eY6ZPRkHvXS7XscuJoTQABsTOMzPmuhP8tH98g3KZrkF_uq_I8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aSVA26HKkQINBS36QsgTCIZPuANbt_XZzsWv2sWS6NQ&oe=6A1B00AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php"
=6e7a0a&_nc_ohc=b84X01zVbs8Q7kNvwFFZLkg&_nc_oc=AdrV8pTB-paWfqyuSAyxh87LrMY3f14R9TTrIRAklwLy1IRmwDBEkAJID9gWGxqsnU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Cx52blnN7Bxkjlx2QzlnNPVFl_D_5dt0i_RJ-5FLRlg&oe=69DF74EE"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7eiKxMjceUQ7kNvwEV2wPp&_nc_oc=AdquSanXZOI0vgO5Pd3e_yf-nNCXyLMoROfgm9hwy5tmLzjBDhxaMjTguy4O9TER_Qk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N3HmUDZ-CKYehzOYL1y2ghSeQcyUmGY2DVXggClugHw&oe=69DF9D5C"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlBefLCt0D4Q7kNvwGpjpUB&_nc_oc=AdreOVXa8u4V4StHcUEbzdR-M4eljGKENdTafvaC5L80tFfEtOInouL4YwpTQhjxD6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W_O-s2mOcrlgtoC6YpNYLE_M5q013QTmfARnr7Wvlbg&oe=69DF959B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNeOlekyyk4Q7kNvwFcJk_W&_nc_oc=AdpyfjqVT5kZdaeA7mh_8-PBBxArOCl7w0e-S84WQHJ8x2WNP4umsGeV0xfyd2Kq_BM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dAg-KqhkAumVJT45AYa6zl-bxhLhvK8UDlRVr811iBA&oe=69DF729A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMc6MiSZ-iUQ7kNvwH6kd5V&_nc_oc=AdqJ0fiw-ZUI9axd7SGTbcrXxyUoI7f1mmRkzSSPZqv0HwsJEC-Pd1A81ZYXm2_xrDU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gv9QT59cf98v1h7bP26zbEYKaNYUatGFVISVYqFI8pQ&oe=69DF895F"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
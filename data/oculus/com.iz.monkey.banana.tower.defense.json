=6e7a0a&_nc_ohc=vwenvSJU-SoQ7kNvwHTZmDe&_nc_oc=AdrwZC6zp02zgP04Zc2RRCvKSI-8dRMx5_2qbw0-Ra7rgDq_p7GffhRgQ4F9qJJ1WGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X3YbEJrGIvOpVwFid_0DuCHpS6Bz8pLDw0hoTnCw8UQ&oe=69D63A6E"}, {"file_name": "shot-1.png", "id": "1293314288574637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_1293314291907970_2687473307735763286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmnTRyzyiVUQ7kNvwG1LYo7&_nc_oc=AdqIt4r_NDpO3ni3D74ZgByUoUxF1GQ3R8zS7bHTlxMFnNSR6B7sjhAZ-Wo1Eb3hOFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af184KewFZZwKDWVijn-hYkPMYVTiw-lNFgPQiDk6VlnVA&oe=69D662DC"}, {"file_name": "shot-2.png", "id": "1652728499501860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821972_1652728502835193_2608456378047914906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og0amvxJtMkQ7kNvwHtc4qr&_nc_oc=AdpEkNhu9XzB-cF5vn-1hxMkxkEvVAf7cU0PSjIIj9jYFbuYqZuep4YlGBYrXZ6IvhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CoG3Ies_jTiePxbyR02KBACAsTa4S-KP0KUnCihX0Zg&oe=69D65B1B"}, {"file_name": "shot-3.png", "id": "1362520938841762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_1362520942175095_7205304139859358367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6DIT8FGAwYQ7kNvwGuiRPo&_nc_oc=AdobLuSRmCYYmLCQS9pZtfOmvcgyzUsU8aClzQ943JFDcCCTSF07nrduehcWCx6VSwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bhpC3lRaYJwap_XFtY4uMFC40XkdB83GBS4n3TzO5jQ&oe=69D6381A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3843076395988504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_3843076399321837_6178001357169447043_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93krycy-UREQ7kNvwGDuRn6&_nc_oc=AdoGkBggYBJQmNOxH2TysOy8ulFDRt8LHXjusqiENZx2Vu1RkDKWkNSpSBaf1mmAdzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HiWcRorvGkDSQQgpE_ZQGZrG7gU3oZr8B0TNoLkqZMw&oe=69D64EDF"}, "display_name": "Be a Monkey - Tower Defense", "keywords": ["Shooting", "Attack", "Guard", "Blast", "TOSS"], "long_description": "# Defend your tower, monkey-style \u2013 in VR!\n\nDive into exciting VR tower defense gameplay, where you control a monkey defending its land, throwing stones and using explosive tools to take down waves of enemies in each challenging level.\n{1106357808149538}\n\nGet ready for a thrilling VR battle where your monkey must defend its territory by using a mix of stone-throwing, explosive mines, and double-barrel shots against relentless waves of foes.\n{1991091181708554}\n\nEngage in action-packed VR combat, using bomb mines and a double-barrel gun to blast through increasingly tough waves of invaders in this intense tower defense game.\n{1316809356621388}\n\nA fast-paced tower defense VR game where you use precision stone-throwing to fend off waves of approaching enemies, combining quick reflexes and strategic defense.\n{1993748424811092}", "short_description": "Step into the role of a VR monkey defending its tower! Use stones, mines, and a double-barrel gun to stop incoming waves of enemies in this immersive and fast-paced tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
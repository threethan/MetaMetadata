kQ7kNvwFzjswl&_nc_oc=AdnNFDEJvnK0QVki2RjUUeFN3B2obZsaWoVkqUdlyEmXW0SsgOQn5ZGcGZhVDiXYFAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsXjlzOp6OSa44bU-swjBGTSyUxyIaAIioFtIfCDHQSg&oe=69B4213E"}, {"file_name": "3.png", "id": "1576552266090267", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86655531_1576552269423600_4984616128372531169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLvDVaNOHAAQ7kNvwHGxDlc&_nc_oc=AdkRW59mJGp-s4VQmrt1un08EVKKIkI-6Bi0h5afOWxNKJmOOaOFViUEdr3059mqdng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfwJwmZ-nxPf52DhAFEpY2g0feCnPu0YRuiiICTVYuEA&oe=69B402E8"}, {"file_name": "6.png", "id": "139766818713251", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031647_139766822046584_943563966746048327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtiBOgAnq8kQ7kNvwF7gmgA&_nc_oc=AdngHRojOneTWKdIs5JSPR7cQ0go7SGj2Cx5I466ALuYtVOydeUFvyrJk-1uqE_d2vU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2y11hkSQwE3u-JUtc-kWx4tr4npIO3L9D-nWiBmbH4g&oe=69B40299"}, {"file_name": "7.png", "id": "1385494998930250", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_1385495002263583_6065459306224225233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAVXovVN6_EQ7kNvwF7mDgE&_nc_oc=Adkte_pbYkeMZSKjRKlS8b-EwxZJxcxnLOcmCexKqkSWBbzugdX-Ozt7bWXrvpJBvOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWtov_y6SyGryJQ5mdLOjmpwjG3AcixEvs1hrL8T-itw&oe=69B40F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape 2560\u04451440a.png", "id": "150893671170315", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203626_150893677836981_3219850835677365161_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6PQUk4Fn6gQ7kNvwH_ZAon&_nc_oc=AdmvceFAdfuydlQutcAAHKUTT_VYL6yKTdIhiu94Y-FeC6rhPqVKpnrO5yBP7QuDXz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNWALvJWo0u1B966Qy1mqb5Z7qTUnsO3DKZDh92I3aRA&oe=69B41054"}, "display_name": "Blokshot VR", "keywords": [], "long_description": "Take your gaming skills to the next level with Blokshot VR! This fast-paced, action-packed shooter combines classic arcade gameplay with futuristic immersive VR gameplay, for an unbeatable experience. Compete against other Oculus players, Rack up high scores and climb to the top of the leaderboard as you blast your way through a geometric cascade of fast paced shooter action.  Put your reflexes to the test, using a range of unique weaponry to maximize your combos. The excitement doesn't stop there - prepare for, 4 player competitive multiplayer! Challenge your friends, see who can survive the longest. Are you ready blast your way into a new experience?  Blokshot VR!  A totally new way to play!", "short_description": "Step into a world of heightened gaming with Blokshot VR - the fast-paced, action-packed shooter combines classic arcade gameplay with a futuristic, geometric punch!  Get ready for an unbeatable, immersive game play experience. \u2013 Blokshot VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.player1games.com/privacy-policy", "developer_terms_of_service_url": "https://www.player1games.com/terms-of-service", "publisher_name": "player1games ", "support_website_url": "https://www.player1games.com/support", "website_url": "https://www.player1games.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
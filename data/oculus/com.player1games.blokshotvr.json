kQ7kNvwGkDX4t&_nc_oc=AdmD1XOuMRXdmiTVOT9LjfqRzixJW2Vf3MYFAk8AqTRJRAf2RjtEEjdBZPbYPNudYws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1lXu3IAPVv2tYYlmFVniattNhfsA2OtBRoveSpGU1GQ&oe=69B53A7E"}, {"file_name": "3.png", "id": "1576552266090267", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86655531_1576552269423600_4984616128372531169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLvDVaNOHAAQ7kNvwEWCKgL&_nc_oc=AdnSBsQr6jCxjxB2HgIENyEU8tJEaRdzw228s2X5qfpHL3VFhKtORgb34f77DE8GkRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxlg8dSa59dcm4GfTgPR9pmra8n2vAy9UI3nIOeqIin-Q&oe=69B55468"}, {"file_name": "6.png", "id": "139766818713251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031647_139766822046584_943563966746048327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtiBOgAnq8kQ7kNvwFG1VuD&_nc_oc=Adl3dGYmSDv0EDDmyN0UHWcQkLfKsqLagTXVsaRXVQYRdb7noy5CVs4G7gZnK4jo_rA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFCBZ1Pr9RUYSXzgsTFeznRfQ3G2eMDHJIQJAPpF7hJg&oe=69B55419"}, {"file_name": "7.png", "id": "1385494998930250", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1385495002263583_6065459306224225233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAVXovVN6_EQ7kNvwG54519&_nc_oc=Adm_DrDcHxUcR8K5dRz_FYpxVp0210yuz21V9KabcRdvC-uSzT-B4PBb2AC3qzfloRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIB4x17w9XU6-C5FGgUwWtsElL8FgrxorzC70_ouqv8A&oe=69B5609F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape 2560\u04451440a.png", "id": "150893671170315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203626_150893677836981_3219850835677365161_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6PQUk4Fn6gQ7kNvwFbU8ct&_nc_oc=AdnG3_UNhbFlMPSYBs8OZjLeLKgXQG9dA-PHF7SqLPxLTnEcITHjEguPwoCa58YjeYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVdy5ToP9sV0w_GpJFwEIoq2WR4K1XuRPYg9oQsmTrVA&oe=69B561D4"}, "display_name": "Blokshot VR", "keywords": [], "long_description": "Take your gaming skills to the next level with Blokshot VR! This fast-paced, action-packed shooter combines classic arcade gameplay with futuristic immersive VR gameplay, for an unbeatable experience. Compete against other Oculus players, Rack up high scores and climb to the top of the leaderboard as you blast your way through a geometric cascade of fast paced shooter action.  Put your reflexes to the test, using a range of unique weaponry to maximize your combos. The excitement doesn't stop there - prepare for, 4 player competitive multiplayer! Challenge your friends, see who can survive the longest. Are you ready blast your way into a new experience?  Blokshot VR!  A totally new way to play!", "short_description": "Step into a world of heightened gaming with Blokshot VR - the fast-paced, action-packed shooter combines classic arcade gameplay with a futuristic, geometric punch!  Get ready for an unbeatable, immersive game play experience. \u2013 Blokshot VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.player1games.com/privacy-policy", "developer_terms_of_service_url": "https://www.player1games.com/terms-of-service", "publisher_name": "player1games ", "support_website_url": "https://www.player1games.com/support", "website_url": "https://www.player1games.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
-lga3-2.oculuscdn.com/v/t64.5771-25/75203626_150893677836981_3219850835677365161_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uejm63pWS7cQ7kNvwHJwazx&_nc_oc=AdoWGdMq3OiVhpb8ebGMwnOXxBl99GULoGold_nopZTGOyeYkoHH1VWBTMPuabogAvc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHAIEGQvf3YCCGQY9c-i3O5oqLeO3qzKai5hQ7pzLcwg&oe=6AFB3C94"}, "display_name": "Blokshot VR", "keywords": [], "long_description": "Take your gaming skills to the next level with Blokshot VR! This fast-paced, action-packed shooter combines classic arcade gameplay with futuristic immersive VR gameplay, for an unbeatable experience. Compete against other Oculus players, Rack up high scores and climb to the top of the leaderboard as you blast your way through a geometric cascade of fast paced shooter action.  Put your reflexes to the test, using a range of unique weaponry to maximize your combos. The excitement doesn't stop there - prepare for, 4 player competitive multiplayer! Challenge your friends, see who can survive the longest. Are you ready blast your way into a new experience?  Blokshot VR!  A totally new way to play!", "short_description": "Step into a world of heightened gaming with Blokshot VR - the fast-paced, action-packed shooter combines classic arcade gameplay with a futuristic, geometric punch!  Get ready for an unbeatable, immersive game play experience. \u2013 Blokshot VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.player1games.com/privacy-policy", "developer_terms_of_service_url": "https://www.player1games.com/terms-of-service", "publisher_name": "player1games ", "support_website_url": "https://www.player1games.com/support", "website_url": "https://www.player1games.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "45978150
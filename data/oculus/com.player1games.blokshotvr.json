5771-25/39031647_139766822046584_943563966746048327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw8i7UX059IQ7kNvwHlzjNC&_nc_oc=AdkZFjwjViJJ0MDso0W1q_TcwOpB3_WT-uXKnLvrPztFDirKjo3uyBVuOGD6lKcQI5Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsZvbdWiX33mogNP3PH_f-fPlSvsnOcbPeO-jqeILcbjA&oe=69A58219"}, {"file_name": "7.png", "id": "1385494998930250", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974594_1385495002263583_6065459306224225233_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hUQw7UglbAQ7kNvwEhyXbK&_nc_oc=Adlw6I9dITCqinPUQB9hB7tnXd-2UxAxzLqMoHdG-uBLiXhnSVikEs1wI08sXIeLgAI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft4depmbTAF3yAtygrlp1LyRWyCKl4Sj6VpP8648F-W7A&oe=69A58E9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape 2560\u04451440a.png", "id": "150893671170315", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203626_150893677836981_3219850835677365161_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhjb6fBSK8wQ7kNvwE2zNtX&_nc_oc=AdnvJO7yYudEj5W6bAWrfqgSymthjxXl_xsAbBTEleMqAmaF2NTCvdZS0Tt3iPguKe0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs_nV4L7NLWKTyfzAIItKKgEuptU_Mfjde87aW4fM9oSA&oe=69A58FD4"}, "display_name": "Blokshot VR", "keywords": [], "long_description": "Take your gaming skills to the next level with Blokshot VR! This fast-paced, action-packed title combines classic arcade gameplay with futuristic immersive VR game play for an unbeatable experience. Compete against other players, Rack up high scores and climb to the top of the leaderboard as you blast your way through a geometric cascade of faced paced shooter action.  Put your reflexes to the test, using a range of unique weaponry to maximize your combos. The excitement doesn't stop there - now introducing multiplayer! Challenge your friends, see who can survive the longest. Are you ready to dive into a new experience? Get ready for a totally new way to play  - Blokshot VR!", "short_description": "Step into a world of heightened gaming with Blokshot VR - the fast-paced, action-packed title that combines classic arcade gameplay with a futuristic, geometric punch!  Get ready for an unbeatable, immersive game play experience. \u2013 Blokshot VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.player1games.com/privacy-policy", "developer_terms_of_service_url": "https://www.player1games.com/terms-of-service", "publisher_name": "player1games ", "support_website_url": "https://www.player1games.com/support", "website_url": "https://www.player1games.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2108889222628226"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "897285338152845"}, {"status": "PUBLISHED", "id": "657390095847889"}]}, "baseline_offer": {"id": "657390095847889"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1679616000, "status": "PUBLISHED", "id": "897285338152845"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5977659285672062", "version": "1.02"}, "id": "1902051896802187", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary"
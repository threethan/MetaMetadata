18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21UYYRxgSXoQ7kNvwF92JiH&_nc_oc=AdoQoCF7f3dkwY_zsLGsX64X5ebhfucgKRtlV5Kl_0HDFsUUm097Dw_Xy67IH--GRwE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vY05MfWA8CM7mWKrVtdIZhNDiimiZDFVmjhZR1XIJCw&oe=6A15BFD9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzY5rUmXZFIQ7kNvwFXreLS&_nc_oc=AdrhPDa93y-0uJa7CCHdXLrZnKz8pygPfgUKjCXTQctHcwQ-AP6GzaJZwoFJWuFp0a8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PiveSB8KpjyKcLYPHlfhi-7LSwehmCe67qkeiyv2Y0w&oe=6A15A7DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Tqm0WewWGQQ7kNvwFDDgi0&_nc_oc=AdrAdYS1T6L6-Y_BtgMTj8eiUD4IRxPOksDkBM8Y79DBq12uIhje7Q1ikn-sGCHDwhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gxWTvokZqe2FwoA6v9LUek4uuhKfrQYKwUmw8ilWvfA&oe=6A15AD65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jb_vhPg8UHQQ7kNvwGyOUC0&_nc_oc=AdpkLcNG3Lvdh5vlOut22YNArg8cBuKdxuakhD7Nl7cVYPKrt-PMG1Hec1Y8YfuNM90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XtCYRRxlUvL_a21vB2zPDTTs4pBHgxGpDb2B3MxmR_A&oe=6A15A71C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwkeXNYd_2UQ7kNvwEUsNqc&_nc_oc=AdoqG15zRCRFEhnNRsglTgpg8bArSRKPSQxH6AqwUdGkYyFCrCT2MNDeeYGvngaFKQ4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ER1TZ3xscvMIvJ6cnx68x2QCI-gVzJI01nKFyZh1QuA&oe=6A15C1D3"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
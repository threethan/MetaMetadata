18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNovVFEdmY0Q7kNvwHTJf0Z&_nc_oc=AdqKRWtN8TwLdmLuS-T4cDEDsUbYsL8Muet-HZQLo5hrZMvW4tOXT2b67kKU5zhLMfc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjmBsSqg7PomPSAd6PsgfxnBjrKRwkvQthBL3GT2AWVA&oe=6A5B6719"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWhG9ReWanYQ7kNvwHhGylT&_nc_oc=AdrmPyFDjdYXXcxV_Ia4s6iEj5C2rUAFU6vKpqcVI0I8y0SfW_rwUBKa4lVKOQKakqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7yCg7dGPIZlL8Y_Yl_z8svmJH7My6_B7OEqDqE-XI1Q&oe=6A5B875D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZECoaTcVzAQ7kNvwFvQzYh&_nc_oc=AdpcNUWJCT1xiSPuKgOp-88b3ap2TAHX2Z7aFVo-Ys_mKPXv-_jKiMiqUsuPdiKm1X4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAuYBAXcfnvw4DkoZsIRH2g6oKOJdvXUskxFmwZmK2aA&oe=6A5B8CE5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQZEURQz_FEQ7kNvwFLo7Pn&_nc_oc=AdqA9kb0q44LM81ovKSAr3RQRvGQskDjNWyilCKmr3baFJotBWgYu7svPD6p4Dp2MIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOB7GUEK4uaK10vQc6lz8gj5UFHTx351wgDSLxyA5jjg&oe=6A5B869C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_BdDOQDlVYQ7kNvwEr7_aH&_nc_oc=AdqMZEri9uI1haYXtf9OaUBAbXxCaQH6X7XjHaxa2bHu_9tOJtzvQ5NPxwM4RMRm4VM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJpr7RE0kJl7tqnU1COSQm0G6bzgMH_VvOR9TG8ls1nQ&oe=6A5B6913"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
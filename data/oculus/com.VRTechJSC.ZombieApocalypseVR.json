18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSKFsQUr85sQ7kNvwGdM_Ov&_nc_oc=AdpYnC3FraNeKSt623sx2qVK5jcSLxeIXpo9sKFSVUHOWGQ4oyi5AACr5hdUbt0usj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJjAHQvcFjqaWJOuGnbzgxIzgyT4mFA0LcGy64iVXZ2g&oe=6A4A7BD9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LroOe43KLRgQ7kNvwGPRahQ&_nc_oc=AdovXfIwiNqa1Zt-MDSBdyJawqVI10kWLPXWcINklXzPJIU2faAwNPEPbCbLHOp5aqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4usBNSVpdbfTU289oY8uicGXUDHCK961lHsBX0b7HdQ&oe=6A4A63DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3coLhMFYGOkQ7kNvwHbd4Yi&_nc_oc=AdrzxxJO_Bd5RSooouXFVihYGsTvpCFzvY-ITQQaBvbOwoChh0hphmuPfMogmNd9ai0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe2X1Zcz7cvY4EfxDyLif4dcv985FMoLIpSN6RYH3hzA&oe=6A4A6965"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR-CahqQeNoQ7kNvwGzKUqV&_nc_oc=AdpDOYh1tJ49qfQ0w899es2BNFeKsoFrQTWqxvmcpAr3fYg32ctkSU0UH6T0yXHa4rk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_9T7olj5JZ-m4E8mNha6i_MPhgGrDzaFi4BmAezt0dg&oe=6A4A631C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5twFxInT-4Q7kNvwFrCcpV&_nc_oc=AdqydUN7XQ3XfziuMQK0G892lQFs01LFXspRzjOew4-A9FKZflDfiYWFxghNeVRlF9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLWwLECBG4u9gQgR_SIdN_XZWvlzrxm9L90XRdvRi34A&oe=6A4A7DD3"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
ZBlmNaJvAQ7kNvwGSbliY&_nc_oc=AdofK4vCEq1kD2krD81BR1Cy0K8uACJd5A9V4P5_wqJpmSdMvl_o4djUpBjY8QLfaqY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JuasddU8pespVhirBhvAcAFKNLIn5d7zTlR63idJoAQ&oe=6A09E259"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZx_LtMg2-cQ7kNvwHX4XvI&_nc_oc=Adp78PfSMDSozsme_e2mh_Dul9PbkbaPEf-3RyPiXm_9MF8vUCMREmD_DHh_EL_rZGM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zLdLZSgGmKlq2zv9ylrZ8P9cT-4878TGQWEoYgeynsQ&oe=6A09CA5D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbjbhEh30ycQ7kNvwF6ybyv&_nc_oc=AdqWalrKBu2rmYxVB3-hvbPmpR6I6_6dYhTipZVFQ4MXVoISsjlogrl70LquoH378QQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tJhf7UmaCau7ZFgGn6w86kN5jXMQHrMG4TydV2I_8ow&oe=6A09CFE5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxPFtIJhhPMQ7kNvwEsyQQq&_nc_oc=Adpqktdp0A8ITXA9tu4ImyovSnmx3J-TwwS_cSflc8pFNSgIwEbP59FbuWUeFvm8zTg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pVS5V6Jox-IzzBhbwWy6x1yrVGeEQCPUTBl5topr9zw&oe=6A09C99C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 16_9 - 2 (1).png", "id": "1496898618762464", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618288_1496898622095797_4212913132683484877_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzpBmqDc4SAQ7kNvwFnsdSO&_nc_oc=AdrzKh9um2hXpfhG7Zmki_ukpsCQ0J0H5hjiMcRBR1sY5GdUgdJ57OpP_aQAwzj8wqI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D8a3oarvca072M5Di8PiGF2riD5rRNz8Cq0fQLqBnEA&oe=6A09B977"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"i
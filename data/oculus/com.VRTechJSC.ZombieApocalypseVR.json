_s7S&_nc_oc=AdofLBJ2LBF2sFGSrnBqBZXCde6_AEqrVC3O5urKzygX_hseluThy8MkhC7GSD0APE4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01u9ZLNZnrxIp9LjYhi9mEAVChKAmzLdEQIUELlneEZw&oe=69E8B499"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzrxpGTaFLIQ7kNvwFxnNp0&_nc_oc=AdohE9joYl0w1_5C9RorTJ7_W02tz85L1UwJ_kE--Y0hDJ0KQMQI32mAbVC7MZS4Icg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J3yn3C1tamGkMpFbIU0YJKd1x6Rk-eVduTZ5lfIUC9A&oe=69E8D4DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MirCXS6YudgQ7kNvwGhAMGE&_nc_oc=AdqCsk1zvXTpvM9twIo2zXMxIUxbwBh_NkgravvOqDZLW6gMQxy0sHRe1cGJMeTui7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ko_1JLEZXIaxfiIddiTYolwKk_yS8doTg7QkjObh-hQ&oe=69E8DA65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lD9sLXjEZkQ7kNvwEwFLpy&_nc_oc=AdqC03zw5W1dMNbCdA7_vcNZ55kKprKE-iXq_9KhJ9hwayQSlwWBOwTNzXTgbUHbqx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12XvuHGkITKYt5safQlo6iV4FjP15aUvSqD52fwiuO5g&oe=69E8D41C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omBbejc6XAMQ7kNvwHDb_EV&_nc_oc=AdrG0qPv2jpksNqQcOrJQWx__F_9LNOPT5nR7tdjGMXWkao5kDsHbdkbUNO9Sz2ZJX4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01e2MPK-AsV6lsuIXVMQ-JJhNy0AIBDTWzYoa-emaq4w&oe=69E8B693"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "64435487310
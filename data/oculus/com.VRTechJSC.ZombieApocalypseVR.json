2gkws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3ZyZ8WDW3KG_3YHF5DXXv2p40EAI40bW9Nvon_mtBiKQ&oe=69F09D99"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL0bK_1mkQsQ7kNvwGFGS8m&_nc_oc=AdoagjXL267q3JI-1GfwVcyY9O_L0gtvDt6hEov8lvwSOSR5Q-K9NrHASndedfVEwJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3YqQdxyjuvaEP9G-drsLb7o_XM_Ll8h3o5QAOHFnOfVQ&oe=69F0BDDD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBfes1g8QEoQ7kNvwFejOun&_nc_oc=AdprY6ro9Svy5FPyToxZ4DcEiqq4qscnwWJ_Vtu0yryA7ruakVJiB0MgQyaT1oJtRFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3MuT_mBMppBUDnNhhW6XKpT0YmknMfq0e5exH7LJ1HCA&oe=69F0C365"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgRwwQNHhWQQ7kNvwEN5pP5&_nc_oc=AdpB7ql5pNheCLhmQwPk3ww6sldm8rHXF4UYoZluyGyyi8RdieVCMaZCIOyWZit4J74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af16qs0lgmS4_4im6Jiuk-O-yj2QLJqhnBRsjoaoUr2YtQ&oe=69F0BD1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 16_9 - 2 (1).png", "id": "1496898618762464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618288_1496898622095797_4212913132683484877_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTU1Gs3Y3MwQ7kNvwFhS305&_nc_oc=AdombyH2_HrCVF92JL5rGHXwHT3GNMoCHMFShXZPx0tAcMJe_YcbgzRSAWinvCgbSFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2gUH3eDz8we6bpIyFj_WeED4rGLc9Xtj5j6A1QuYNYSg&oe=69F0ACF7"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
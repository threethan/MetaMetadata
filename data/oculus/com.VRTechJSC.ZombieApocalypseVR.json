0FaMWv5NUQ7kNvwEXa9BC&_nc_oc=AdrpXjJqUQs7cH51ylWTYMNJEAcKS3WU89H_XRQ0TOosTCWPW9tfFpnAbUoq_-JBqUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MwXQr6CcGrcIDpWgtaJHgdpsjdw-6dDnQkRrsJ3aJUg&oe=6A0DD6D9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPPJ8ZuwXwYQ7kNvwHQ75vj&_nc_oc=Adqtl9ekkr_3E9kftAT4SeoXoyYnmTGLvyM829kuk-AsUHJg-i4ccMp5CHlh3z-JI5s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iDypSWCYrtBHOOvT2Kf-O-fTH7t-RqnbQ3kNx_nqSSQ&oe=6A0DBEDD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwWcdJp2wCsQ7kNvwFZY9mP&_nc_oc=AdqMGXX4762kLodHr6u_zkk3DXcn2zSbUKZ-Kwq1PY32iJwVKrHbQr6hotqD_lrLo6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M_LL92-F8JxejxeCuOoDhqqTta4U9sB_9sm_4rKl1gA&oe=6A0DC465"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69rb7BOxSp8Q7kNvwF1HXzB&_nc_oc=Adrp0C_rOorybEYBAPQ5YkzOxx3_NzDIyy_5okWcCADf-4oeF1vDmM4B6YFBs_Uw6mg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LUPgQloUWClT2BLNjzlHogjObCVS5if5U0zuGPHOcag&oe=6A0DBE1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 16_9 - 2 (1).png", "id": "1496898618762464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618288_1496898622095797_4212913132683484877_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fij5BinQBgUQ7kNvwE7ZL8Z&_nc_oc=AdrAQEiC4w9LoKVlcVXoVVCWBSsCiA61uODf1V5jOX4ueh0eY6d8G3PjJJ0T-vFMoCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A1AIoqV4mxQ1MarzKqNRpoFogZrL9GIJVS18vjJohDQ&oe=6A0DADF7"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"i
a3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i0ZSslEZFxeubc08o5GjfQdYQ7IEEoOA6kQt0ETyBqQ&oe=6A131CD9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u__VkFd5pz0Q7kNvwGqjF00&_nc_oc=AdqA6FECnnq_LfT_ex_q6wEDfNZBK6_e7DfFBHRwSKrCducOmU5jC1Xmm4CdRmnBgFY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y81Rr6lBI05Vrnn3yrebxWLs7BYCkq0QpIZRbcH52Og&oe=6A1304DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3IyYFQtX5EQ7kNvwH_-FFw&_nc_oc=AdoNUbsDqBndFKLFWg8sHMWfnhTy1uBmwXvbJ3Y1a62YFKGT9Zmd_MhuqwwwEcwPcXY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xlr10z1oJWT2874U25DtcKkzo5VV7HEHM9J3k0Frzhw&oe=6A130A65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRcoLx7QOHEQ7kNvwFJLYfb&_nc_oc=Adp0TXgfbqNW88fgA-70kqK83EEiPGfzEK96tEpyccPPxId9mzefb0QjxVXbSU4ISco&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63X35LlNHUjH7C62Nc_55qixPn2CJKVXsDaBaDLxHsqg&oe=6A13041C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF2IVEOSQiIQ7kNvwG2zDc0&_nc_oc=AdpV_8drqNmeT7HEBOVcSoaLL8tDv2I9JQvzrIpICk-Uqh0zv6_SI5_fB90QhMmugGM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6He6pW7AY215h4j05foqWtnrYeTmTbWDmlDJJ2etMaMg&oe=6A131ED3"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGfzyYbGCxgQ7kNvwH8nmff&_nc_oc=Adq-gAh8kGzk0BDYmju7ZL3OM98Ak_9Kuk4KhQtoYE-TAJJOsIW68S-mgath7jnAP34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoT1Y29incAUCLcGHLokkPIggNn7Gg3GVHK5iJovgXiw&oe=6A786819"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm3YWo9Xkc0Q7kNvwHOamHf&_nc_oc=Adr2GDrHg3rZESnQATDDm5G5RIqJpiRF4rj-8yzw_kNN5C3d63dmCrkVqSfLiCAPGy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_3gjSZfKg8-tzPVA_h1Bujz_iSx10PavFQfubgcthWg&oe=6A78885D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC3V3h9wLC0Q7kNvwE_Wsu2&_nc_oc=AdrFCGEd9osAcBrK6uCrrzMQ6VeSAra1nD1E9FbysLYDVwfB_vbHCQI8MIgNc0Uz-k8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMoxkdMGmjUqt40WEdaVzxGyJpghE8BwdOqnmN1KKiOw&oe=6A788DE5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQR7P0BsF0AQ7kNvwGpJRry&_nc_oc=AdqLWNV8lb-BVyw2wfLIjsgIARMVFXt3bph8SOiNZ5R9ywkancs4aB9D82WEj6osnLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6YNkpo-wfuVtlSp368Qh2WsQfSZzBI9ZE3CeJF9mcXA&oe=6A78879C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCi_xVUBfcIQ7kNvwHXlqRd&_nc_oc=AdoPJYppEGMXd4VROGLuiisnt59mRn4kcypK0ternxdYhzuLn_J9kdkjD-uXUbdd_rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7LYm42HyS9uUNT6agd9gd5gbwQrdeDjFdj9kmD5OdEQ&oe=6A786A13"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUJWwPXv-e0Q7kNvwHD4PUD&_nc_oc=AdrW2TBBV888wN5eLi294dZtyBKV1ibqA8V3If714CIXPikEhm-gw-QVU1dlioGaL1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHshpam2qcrtCYalv5P0le7nhgEQTuE4_qXHibgj-Anrg&oe=6A7EFF99"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2814Z3XYEu4Q7kNvwEHMJBi&_nc_oc=AdpYeEwDrBOvtxbO1--vLMIt3Fj3PJRMb3VD-0dPbc29QY6b4vOo77mm4qDSH7Un4ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdbEngoBe2SqvwXpj-w1C2KQp2c78YqO9_Rd5w8QZyIw&oe=6A7F1FDD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su9k7hSYsaIQ7kNvwEBg0W8&_nc_oc=AdrCTHBuvty_of0ucEO3tpTbfQ6GBIo4rzhBQiTIqrFLntWsdn1m6npukLo1YEEzuyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD28otJR96wwHU7ZotnZnFSiNQa7BnIm5PlakI33-7Xw&oe=6A7EED25"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qXlUn3rGocQ7kNvwGTL8Dn&_nc_oc=Adpcy_XgYVVrcJOspJopaw68D4PmtnrCKVhSZkNdzvvGl0BD42ApW2OrBfPOSNs3g7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_n-E2wYNMVoGQ7_lG4Vd0ArJDhzJelPQ6hGQDJLI7iA&oe=6A7F1F1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl2nwVkGk3kQ7kNvwEqcn9u&_nc_oc=AdpP2Alqgt6FSIiQvTAllfilOm7X-x_DSQWZpNL6vT2DiqE1Q2pb6OkrNbz9IeS8D3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2lzbDMNDkV8XEQpmGBy9YOXuqfbRvJppUi87DjjQH4g&oe=6A7F0193"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
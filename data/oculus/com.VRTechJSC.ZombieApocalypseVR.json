3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0Pj6Po_1A4Q7kNvwGutxsE&_nc_oc=AdlcAoPj-juQiXYMYYDwfQYK07aXF3wsn86hgp4lrmwaw_7kzqZCJI5LYF5imQpgjwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvsWYZaBmIwY2fZmWcHVswhefKirBrYDPlQw5nY3QPSHg&oe=69A446DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkpI15buGF4Q7kNvwGhJXHI&_nc_oc=AdmboME6Prd1U-3A1ntLbSID09KHa967V65Pm1x6gWap3INvVZ3BR_PZs8Y37drcjXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftfnnCW4mhLGELghWIGeqsDEMi_fZ4gdrBuO-x7s6jDYg&oe=69A44C65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nt27y1ogWEQ7kNvwHSKcJv&_nc_oc=Adl4c4x7GYene31nzcUVRMSoFdyJotBj02MFNJiLS9xwl4lo91scQ7-y5Y9QzPdSGKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvOlvrDQ8rJ5ZDTdwqIg71tn29T0OjZ7aNIuSw4I01oAQ&oe=69A4461C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS-YlX29M8kQ7kNvwEkW2KX&_nc_oc=AdlH_jP52XBN5-k0eF5SG_yISVkKuZzQVlgRjSa2vjRlZXUj1ch07r1Ql8YWL1-a0P4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftn45-nBCBchRwNWRTYO3JGoXqEjlh4hq4OFPNifrGYNQ&oe=69A42893"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDI
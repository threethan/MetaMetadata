18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUJWwPXv-e0Q7kNvwGAFQOr&_nc_oc=Adr8BK6m4g7ssPwOQ55YrvB30xz9cx3j0ri8qnHey8Wbm2WDeUVOm6GDlQ9BTuViMUY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-z1qlXvh5xainGISIQOQsbseQaLj-uxOPLjj4AjAPLA&oe=6A805119"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8InLRlF66qUQ7kNvwEV7kwX&_nc_oc=AdqdnwZXbpPqrQVw3Pz4aPRFU4nCVXggc9GAH4yrlFIQ8OdHpQz3qHoGMe0rqybRH3k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw_dpGzK4zsiD0pG9vHkI57lFyV0QmeQR-HACTX8Purg&oe=6A80715D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su9k7hSYsaIQ7kNvwE6mxQ-&_nc_oc=AdrYuRulDOWmW4qdWgTbsgfU9aXW069IOYM-ttZZSXStJir3MDWPO8UTrtJ0X0oQtx4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKBHUk00FC-EvEov7kbGAIh1jeMxSsoUvzMAAhbNUOvA&oe=6A803EA5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qXlUn3rGocQ7kNvwEQwOcT&_nc_oc=Adp6-VOXvpmeVsiVHIty9ApI4Q6Y5zpStC5CVPwfXoZw7Eu82huggjM7AZ-bmbmIrdU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWo5YJHoytuvnz9Q7mOIBqdujRhxYefFOW0Uoq0uU7Lg&oe=6A80709C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl2nwVkGk3kQ7kNvwGw4Fov&_nc_oc=AdpHYJxVMJK39EIwE57Rpc37DH-V3Eibeu4x0qwuN619S62m3PvLLV7o6CTEMd9lcy4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFybydJ1rXnw6eqayFCsTOJt852p67R32zT1JhU67Www&oe=6A805313"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
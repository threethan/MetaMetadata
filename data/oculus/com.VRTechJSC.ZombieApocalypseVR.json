18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haZRyylhmxUQ7kNvwHaltxP&_nc_oc=AdrWRQqQERAEgHBZT4indsZxEsQsUJCw082A7d0ucG0mV3k0q6M4iAAUSbYbCpRcTxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP84iIhR4ibDBi2VNbh2LCgwS5tl8dQ9sJU7q8442M_w&oe=6A6CC2D9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP201QxPv-kQ7kNvwE7pY1E&_nc_oc=AdqNBmq-1lwf7swUWI8qOJf0YXpLENCkkJa7OMSG1BxZ2zIxmE_PXN4aVFoeKd6d2fw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMssqTmCSxysmlrVJseSuChft82NR3_vPwXDwninTE8A&oe=6A6CAADD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWB1mNYTxj8Q7kNvwGhR3zm&_nc_oc=AdpOCr1sxl5rOtLMUGAXZPfbMOBVSdY4Vkx9dXgVTT5av_Q1oSvKZqvqT3LTLiS9D6g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyDgtytLwaZvK6cbNYu-QsLB107j8L8FZXqt1t7s_9sA&oe=6A6CB065"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTRyGEnKTvMQ7kNvwH_xFkn&_nc_oc=AdpM8J4EqUecHCUpF45DWjYhSoZPaG4-o068ttAuF6ryrp53pOmKqt60C88uM1hCJwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3dqCxM6DV2hVM-0XgosVzxhAG58bfBUPB079stwCo7A&oe=6A6CAA1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WDRqW48u_YQ7kNvwEd5SD2&_nc_oc=AdoMWLt79MVyhIZgTJDuY3K_KHsxVYBIhfyxjQmRuSuJmYh80SIKrd7-eIO-aclZYsk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT609ODCN_6qUolXM2f-dMchm61MszhXOHXRCEWTUO2w&oe=6A6C8C93"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
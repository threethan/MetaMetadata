18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TtBzXgQTzkQ7kNvwHeZJQT&_nc_oc=AdqLhf6M6SjUWCoOWqUHCnVf2f36MJS1ySmik7a9S9974quELjeWHydTecpjCXkga4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UcB2likkpbeb98rQoZ2qoaqIjiZ2--P7L1QYGVB3apQ&oe=6A2D7AD9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm6Zox4AYEIQ7kNvwFVz7sY&_nc_oc=AdryxTYZFTwkf-I262s4O3ysjwHhlGktpoNBWocpjOQm3yRqFNN4ZNOekaWDkJmJznk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rA3416wXiKAN2AJsVaJ1S-1TG19BtMVsUVx18QYYy9w&oe=6A2D62DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnGz7DnC8FUQ7kNvwHZdKEK&_nc_oc=AdrUDdVMQCenrvJCWw0RbqErB05EjLoq4okS_T1f1XBivd538ORXEJ4ohE0BX9bo0Ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HKNg7R3wlTkUB_-ayFDvoqDNXI_yZlPPKWZmAi9Qk3Q&oe=6A2D6865"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4uqCktH4OEQ7kNvwHleYmP&_nc_oc=AdofptRXSzjcsUEARyJ90ZyL5Q1k1L_DLg6O16L-YgFE-Y3U4R2YztlDJw3YCjSSvjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hbj1LqqM7kvk0vTfweT3bUsOqpgH6LeSok34toBC3zw&oe=6A2D621C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpvLIPFyXCwQ7kNvwGqSbpX&_nc_oc=AdoBeH_viCMOa_nxz5iglg8IMq5Y3InfYzwn0vLUU9JvVw4F6vzY_5Idb0rj1sCU8eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QwY189HkJl_tKq8ygNQVZy-_hENmZvMzZrEsgRO_UsA&oe=6A2D7CD3"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
.png", "id": "688449120654377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-__axXe7esQ7kNvwFZRLfv&_nc_oc=Adr_mEOcXF312Ooq-fZObWWWcbsG86VLQ7I9Y-84PA2Yovtw-vcDaf5lbhBPdS14CzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSRz1bzBxahUDa3oTyb88FsK_sDx_9rTr7EPR4VGRaFg&oe=6A95D999"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGeF4aqyH9QQ7kNvwGpM2qn&_nc_oc=AdpGKCkaxyqY5EDrhrOudQc1rtRxa1QdPN8TVP_uHpp8iEI1yYvNLsZNo44SLB8pQ6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvMCGK52_OiL3BTKy4OBQXkk573gbmcoj-hsS4VR58VQ&oe=6A95C19D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HLD2eLWDugQ7kNvwEjbssa&_nc_oc=AdrXyZfj7AvrqoutoKmT2KHrKae38tp9URmWikrY5uOvtECti1v2zlfBTaeIbsoW7fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH51wY2WHn3YOX0BOlE6O4GuD4Sgi9EBDX1sWc1rJLfA&oe=6A95C725"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeeT3zL6n50Q7kNvwEeUiqa&_nc_oc=AdpOWUDm0_6AQp7TB-Q3l2yB4JJfyoQ4AtIH2mZpS1BZYZnEE0YBMu7Ni9lT-w_YLyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdIzZOTqmzskUICVpteQxGqvE5A4sljnBM-x1ihhwiXw&oe=6A95C0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619193_3965841703674334_5697259317351281797_n.png", "id": "1313408776897190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313110_1313408783563856_8356873071102881000_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fRhJMVXHJ4Q7kNvwEJChwf&_nc_oc=AdrP4Qc7Po5-ezf368MImw_OZFHqSNT_qOI79lfCLnmrusw4M-1NixhfIvRzzz-6Syw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY5ZBI_XJcTu90467Egy3uu8tjDRbGZTp0ll3DMytXGQ&oe=6A95C06D"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtec
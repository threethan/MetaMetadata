qelza08FQQ7kNvwHWFYik&_nc_oc=Adqf2b0iMD_vzTMnRuZwprVuolM_1e10JVEHKWosaR1V4BtT_xnAKoxv90I8v3eHNuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kvBwAuFEfO7ioyYbmMO_lrahRBptqo8EKq9BBVWVG1w&oe=69FB2999"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nke5yj02o7sQ7kNvwH2h9ur&_nc_oc=AdrTBZMtIe-0MqKASLqNZEeJcQUylYv313DSVsz5L4lM39gt-dBt4deBSN1Dwd3XDS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ip92OOv2YiUpG6rjOnUK0yw0beLNuNhow93hPDJeX9A&oe=69FB49DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Xdq9hhmykEQ7kNvwFah3ZF&_nc_oc=Adr_-7TfDgjPx9qQQk_2eG0abebIpn1Yfeit83Z-2HEJ-6g4uZXFBSR3Izfrc1bgbEE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68yrAR528p1aaiWCeo9h97qc1Vfcqs9hxx1QOTzvuUTg&oe=69FB4F65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIaL9OpyFtMQ7kNvwGdNueg&_nc_oc=AdreMCe6mSGhbbdUpJLrB942eVNcIpFJAdVrVkV2nRe0oKEh-Rf2rwvR8Zdkc0675Wg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_iheWl4SOfO7lfnGBIkpufuQTA7qxWozsISzS8Cbsow&oe=69FB491C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 16_9 - 2 (1).png", "id": "1496898618762464", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618288_1496898622095797_4212913132683484877_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bX2PjNTRnqUQ7kNvwEuTVv-&_nc_oc=AdpGkjM-qa8PHTEjoss3THQZwKtmYt-SVenLbSibizF9fhJpWzBqd0jxIYiE0PpDpU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41JSsVrddiMEVg1r5YqMYokTYPi3HbMU4utjDKgRbiRg&oe=69FB38F7"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"i
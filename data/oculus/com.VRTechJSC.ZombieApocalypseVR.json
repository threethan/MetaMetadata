qelza08FQQ7kNvwFw2ZlS&_nc_oc=AdrwoeDAtBW9BqpSCoOtUSi8gE7yHfz_7N5ve0uuWAEPH24MXSMV4am8kpMG__tt_R8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NG5JNvKykopgVC6-i_zzZR3sPa9LJLFAtji_jr5u7Kg&oe=69FCB359"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nke5yj02o7sQ7kNvwGDn9nl&_nc_oc=AdqKalLSFM1wTjj9ik7y0tnLlyol9OTGqHJz-cBLQv53B-qeBywi6T_w2gu1ZbsP4tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7urpLuPiAygmt1H-iYpmP82FC6pqXchLEuQ46prFMkXw&oe=69FC9B5D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz4HVLSRDj4Q7kNvwFlrDKI&_nc_oc=AdrzFPEdqP_LBnQVSh-yjmkrv9v1O_PPGVHToTBQ8aPhiDKC8Fb6yrHGCg4kdjviqbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WhWWET1TBWjrW__8ky6GqMlzxSmm4KeIm6xAZTsgs5w&oe=69FCA0E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsgBlekO7y4Q7kNvwG1RRWp&_nc_oc=AdrvGWwwReBXaHpsjYfRKxUi1UzeA14uvGX5bSNum743QAbx73goprH66H31WNERZ6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yrNMpJrNcosLffQDseWleT01UNqAc95c4ZFY0xuI8oA&oe=69FC9A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 16_9 - 2 (1).png", "id": "1496898618762464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618288_1496898622095797_4212913132683484877_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bX2PjNTRnqUQ7kNvwHSUXX6&_nc_oc=AdrBrQkE6xnLfpeO--JkYybYwuPo5F6_uouJItwz0gCyEO4oqsvOBGwUL3Yb0OhB80o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56tiAjlR9SXDv4a5lpfhLAWqWYIFskAE5CEK7PpXnK6A&oe=69FC8A77"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"i
18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5HM2XAgU5kQ7kNvwEEHtaG&_nc_oc=Adppd0rX5Gz4W99LcDhLXawcaa0OTkkSj3_SyzJzzDtR3B_t-oLACcABEfSFnxCmNu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_uEzwllpqN20phzt8saghzpVGDwZmZNVeVOTRrPoG5w&oe=6A3BFB59"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gq48y9oLsToQ7kNvwHxGD7y&_nc_oc=AdpGJuRA2usGkvHlyNgumve_wU76KfyXiIFND7aRKBXbuJzZ6K8Mbhq23mILnLZPPRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rpf8oOlICsgbutk75S1ZDZSU_F0Slg1AA29qO3VAW3Q&oe=6A3BE35D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bk00qxZl5cQ7kNvwFsEvJ5&_nc_oc=AdqObkL77IxEPm68BvPqW_k9Von5Vf1IjHJdUl3Zv5k2fWTocMUfvaiSCxpgJsaX0XY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NvWaSnaU8ScX3gRsk1EWdl43PMerRp2EnwipoB1Zy3g&oe=6A3BE8E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sUNwxpLVCEQ7kNvwEvJivz&_nc_oc=Ado3R4BWKjNvvAQWnMEFYv6BTpuXibd8d1f4zeU6dy-wqGp3IWBCBfre43fJone1oxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BmqiBBugL9edjQ-0e2JrBVvKKpurgmuuQe9JVPQlLWg&oe=6A3BE29C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB_DhVujnGYQ7kNvwFsC0KS&_nc_oc=AdqMVdfUYD6RGKLlxg2bcGWlG6dtE0q4ZzHtJbzS3QQUNl1oZpt4mqXBS60p8bYLFv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3LrmIsncR5jbjAkj2qZBs8OAJnXA5abyuoERwr72PbQ&oe=6A3BFD53"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
o3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JuasddU8pespVhirBhvAcAFKNLIn5d7zTlR63idJoAQ&oe=6A09E259"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZx_LtMg2-cQ7kNvwHX4XvI&_nc_oc=Adp78PfSMDSozsme_e2mh_Dul9PbkbaPEf-3RyPiXm_9MF8vUCMREmD_DHh_EL_rZGM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zLdLZSgGmKlq2zv9ylrZ8P9cT-4878TGQWEoYgeynsQ&oe=6A09CA5D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbjbhEh30ycQ7kNvwF6ybyv&_nc_oc=AdqWalrKBu2rmYxVB3-hvbPmpR6I6_6dYhTipZVFQ4MXVoISsjlogrl70LquoH378QQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tJhf7UmaCau7ZFgGn6w86kN5jXMQHrMG4TydV2I_8ow&oe=6A09CFE5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxPFtIJhhPMQ7kNvwEsyQQq&_nc_oc=Adpqktdp0A8ITXA9tu4ImyovSnmx3J-TwwS_cSflc8pFNSgIwEbP59FbuWUeFvm8zTg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pVS5V6Jox-IzzBhbwWy6x1yrVGeEQCPUTBl5topr9zw&oe=6A09C99C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOB23Umo6ZsQ7kNvwGaDtKU&_nc_oc=Adp36zB_Tzk-Y2iQuzhb_2g60KxMsjHWPrvohlSmz2ppD-LpuZqMg_fZoa4ru2Fbrcs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ajc3ozvxQNzGjy-FoFZa04T0t5I6-Y4O5Inh3iJyy4A&oe=6A09E453"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
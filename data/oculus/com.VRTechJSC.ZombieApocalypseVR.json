18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSnWkGlvBgQQ7kNvwEy7q18&_nc_oc=AdqI5wHkb6VslMxOEP9AhYZ2fFM-KLwbaKRhmKEe_vUGiAOgCStKeesO-6nfsN-hcJU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I4HGtM4yCFtX8Cmj1n3hy7tRaM2FprBetnSMOPuDZqA&oe=6A1C5759"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-va1vgYD4AQ7kNvwHuP7lp&_nc_oc=Ado9jDWqb8w0By0jFXm90B7eS5vr4kYAIJz9fDKEVWCMVqacnZ_dkyL9IprwkNwb8Ek&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RC6F2HQ68Qxc6NvTz6PS7fDTN68YX6TYDYrf4BzolTw&oe=6A1C3F5D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGj5oLKdng0Q7kNvwFzclEy&_nc_oc=AdoAqyXZ4vAI8HCHa-qXPsxfsuT-OPTlwcOYxcpBDf9w5r7FTeeEu6_x8C_FmKdchEc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7laLYavEmTJy3IDhkwhpvQBNxpTCVKJL9KyyINGwUnSA&oe=6A1C44E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pP5mlfQAl0Q7kNvwGpEfZV&_nc_oc=Adpj83ywLj14nLwQCGXUX3Y-57X5c0VLjhu36dF7smTW9x08p_n8KWj-Wjg4CXswaaQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xTiTP9k5fu0IcSIB6pzGZ55JaEsn4zUQ2-ehaJ4kn9g&oe=6A1C3E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr_Z_prVThoQ7kNvwFn7Z3g&_nc_oc=AdpNrrxe1AyW7VtBy8qVEnCIOiQzE4HIZe3h5ct6IQL_z2_vs7hw8iaskCwP6PQksc0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nxYKajPCSQdCGEU8ewIrykdqDxCXs5uW8SR2yyBvAxw&oe=6A1C5953"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
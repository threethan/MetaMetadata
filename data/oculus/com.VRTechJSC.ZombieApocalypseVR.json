18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kp4GI9-9a2oQ7kNvwGmmK9R&_nc_oc=AdpP8xV8fYb8gKppKKZiF3xokK4qJHivCYJAXVFm-osTGAC8ZO2RN24o2AI1Dp6erQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuIR1T0Dm5DhoTpvlotRwRS7EimIgqZ_J4GWKUlNCymg&oe=6A732219"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsMNYfLVPdoQ7kNvwF-VCs3&_nc_oc=AdqwB2PPsF43Vr94d6hilBRKHBzYtbkFYS0YRCoR3nWEKegyqCgnm-oEmgabBbPgpMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsg0eRH6QzPYhjSelchIFU2EJZ6VadY474m3RDjAGCDw&oe=6A73425D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkXuHtv5wvkQ7kNvwHWEe1q&_nc_oc=AdptAs7gkHOmpk7_1h5dKcAHZGPOg0TtmC6IOjLuJXaXbRzJG0RybR1Dz8Qmj0uGQjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU35T-PHVnmrAiefuYMxrmNYgk2xqkneVY30bcQhPBag&oe=6A7347E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQuOiL4qpO4Q7kNvwHO0MSW&_nc_oc=AdoXeLj_eIC_y8fJRIhyOmoOocTxdfUG2Ltwap0TQb9oCU702ULyzRMkptsckoNBIRo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnHXTnpfM9cwi26lR7ASq53IxrXuNfuOP3RUALVpDoxw&oe=6A73419C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZXeNSwRheIQ7kNvwE4-cQM&_nc_oc=AdqGm8avZ3RJ5UuO8QsW0Y68cV5Xp2u_tPWFXfZvUgdQ1AOjhWl660qhhnHI_ElqCYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgy2Gf1VW8433mIftXLy712F_cWmnQuSewY5bkcrrThA&oe=6A732413"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JN5m_4duoEQ7kNvwHxp-U_&_nc_oc=AdqwxSP17Vf6cYy2iNi8j33sZAZ4PBLxPjpnpMn87rB-mN9PHM9WqcJqS30lqPq3_Dw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmuyAQh5RcCkHVnTahJVoZyO0hcXQZOhVKYLAcGxbiPg&oe=6A6F2D99"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP201QxPv-kQ7kNvwEEf7Bb&_nc_oc=Adr_-RjnRQQJKXSZ8KcykfNupVJi2opaw7wxcUq1UBJaLLGyUB0amoMUU6V_-pY8rk4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_Bk3PFbHOl5vEC9N2iGC7Gr3Iokys_DNxzTittbMNIQ&oe=6A6F4DDD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvBPOsot7f8Q7kNvwE_alxu&_nc_oc=AdqB1adEKRyiLKfjDZQO4IdC-ROsrPOo1mLdDspU3uVcQWVXrvQAS0x2wf5-pNHDG_E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrXoExZbMpj4SzHSXjWMJQI90yjUBd--bU5GawmE_fvw&oe=6A6F5365"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rz-31q9X_tMQ7kNvwEOnXM-&_nc_oc=AdqiiifRdQGocHkm4fZqQ9NxH0URUrde3iXxFO7I0mrhM1-dEstSDrc-GGnBpYtc0t0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD87seZZpL1GocnyYCVjSMtnc81w-sqCmUWm0VSRzSV3A&oe=6A6F4D1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lb3K7kcGcygQ7kNvwHYYgU5&_nc_oc=Ado6W52fQDngkrmbYVdsHerOz_8iqNFuC1icJmm3BEb_K0LrbbbXJAYXW5B8TzuHyEs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1SqN_UkgTA_5ezldEi3F9Va_oqAejjr-Hc3OhlGdfew&oe=6A6F2F93"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
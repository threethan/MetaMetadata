18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGfzyYbGCxgQ7kNvwF_UXT2&_nc_oc=AdpsSHxnux1mWR_PTbdBM_ElU6ANqMQv386GECiDmzLnYUddAdRSyI4A0q_r6GRxxbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLUvCrNR5ARCnX5eO_1SCrVwFq_8VKtg9QUYXNYp14RA&oe=6A75C519"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPIFRCAvf3MQ7kNvwFg4o8g&_nc_oc=AdqPY2OqZxefWBWPULrEFOq8OaR-vQR5yahJ1lMMTvzHwrn-b9q8qOwA01TGH5ewzKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkJyuCHJHfr_ihdi2wZQxASiNgIr-X2bhIwOP6cWNDlw&oe=6A75E55D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkXuHtv5wvkQ7kNvwGsFJxq&_nc_oc=Adq9fXC-yW8RKf23HJxKQRrSQ4Z4Jt91toC5OnaN8PHpCCMBm_FxpMoOgM5fMWhaQ6s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc5DjWifQuPfAVSC55THc9dM8um8yQnyVkg__yUZaM_w&oe=6A75EAE5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQuOiL4qpO4Q7kNvwEKc4Wa&_nc_oc=AdqqrpRrMB9ga_4SMSRbvci5ReuPoGs48QpcFRAoSs4GjBGoRGat8VDPKbiayqF3I6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzZzcxSF4k5Dv2-cpEtRl6vw11wXIf8rO-vheE6kae4Q&oe=6A75E49C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZXeNSwRheIQ7kNvwGD6Xb6&_nc_oc=Adr5108w5KSvsYypJlWkxehAFTOG4Ur1V14YAr_zYZz8gucYNc9uHaY149oyvpbIJCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT4b8CJVh1VfLF_rp0v9pe1HiVcSnZY_ivFvbINVgXig&oe=6A75C713"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
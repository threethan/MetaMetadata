18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edq5xQIqKPEQ7kNvwEPAmHk&_nc_oc=Adro3a02JzRIeEGtm84bwwxhmoq65X8PHVsbpZKDOVTkioq1TTV7VKqmqXmFDdR2eRU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9HZx7yhKkEcD7UC-WiJNNZMUkcqV8wRl4ha18N6rkRw&oe=6A65F319"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOXh_VY_wcYQ7kNvwGoJH1R&_nc_oc=Adr602ZUVQGDVI2agNFgANO1cAbtVTeSA-alSooeSrGU8hPZkWKhrJyo-b2mZHW0Z9Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWslHuYruQ8XC-m5IjydGKwIVFScnJ8VjO7YzSHUgtQQ&oe=6A66135D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf-bdx6g6n0Q7kNvwHK5NCx&_nc_oc=Adp7QjtA44vkMhAsaV4HP4UlsBXY-GouJpziu4KmFV3nOipcNcgUqwIgopLZodExYEc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRYHL7c0CxnkOSCuWl9WHjwEH8spPXx7cVlJCFIrx3aQ&oe=6A6618E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIxi3DOVHqcQ7kNvwFPtkwO&_nc_oc=AdqEfYi0jwWf4XRxXr8BGu0YzxxctTL2mMQkvYnnnRtIAVQX28XDDalr5glfeju6TTQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOZzKdJKFLwZSmEILZkP9srz8WNvjc8xcp7O3aaGQE8w&oe=6A66129C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esa9acijfyEQ7kNvwFDF5SN&_nc_oc=AdqZDO-uUstqzDeeafdPbp0pN1Ms1N0KCfalmjaY2M7MTLrmVn5dDAoQCnjALtgRs-4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgdYTf0oVF39x_t26J2eEnaRTOnbZeRhXoCNwVit6nbw&oe=6A65F513"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
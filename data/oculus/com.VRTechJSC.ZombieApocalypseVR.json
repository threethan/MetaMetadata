18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeU310UHIFMQ7kNvwGL0coY&_nc_oc=Adolhj6kzt4MWJleT0n2cXZJeMN9hW9ivHhdm1yiu1L7srgZ6JWrydOuzRFsqAScEyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzgMJgwbsvGsCKIDm9pl_DQK9ftliIeW4TiIyaYbxUfQ&oe=6A64A199"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOXh_VY_wcYQ7kNvwErlczL&_nc_oc=Adre16Za1z2oFnNBHM-fYu-trzUWOCCPZtkphP6nMUerv20ZOqZQDHB2aLezESMaFzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG-U59LS6BX21KMDE1EFMKqvY8hdcSE-NVAVG0b9E9Rg&oe=6A64C1DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf-bdx6g6n0Q7kNvwEAeEUz&_nc_oc=Adr4XN0kp93BdrtSWCShWy3wY4lUMN5o0m-q1cULze_9R7Q5oOHjqA002jG3Xyb-Awg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAatH9VP3R1PD4vVo8NKmA1btgxTHvXWx8PoJzNbjF-Q&oe=6A64C765"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIxi3DOVHqcQ7kNvwHrq6mT&_nc_oc=AdoJDR02JKv9P8Z7Y-pORFUJvgDGOdz83Go5oJMqPDQ61lD5s6iAhiS1-OodIpOww1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW2th-PgCMsyIXWjX8ze1tWcS6ZVF8h41F0ivQK64AqA&oe=6A64C11C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esa9acijfyEQ7kNvwHRNPs2&_nc_oc=Adpd51mONSrLUpzo_pCSpkpQS-N5j7wxVRshpMW6IrTLg57Q0FJipvzE531sHSZMCl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgu0WGCRxtpOeXweiqzd7LiQWVQp9dbRF0LzXDw9bLfg&oe=6A64A393"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
w6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SjRgFdEykJRrl2V0LKJrn4K6gO45aDko6Ulka1_u0IQ&oe=69EF8459"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL0bK_1mkQsQ7kNvwEN8rwE&_nc_oc=Adp3Z30ibbSdVnA5VdBknFC9iurmQ7K5EicDNxYwLqd7PqaVUUKQhq_rk8OWZFFQV8I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18EGnc9Oh3j-mmw3LUlGbz1_8COPgyVqr597r-aoVYSA&oe=69EF6C5D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnRIabbYaGIQ7kNvwEn9HDa&_nc_oc=AdppmO1LZXmW1J9GmhALBaILBWariIaqEvxpG0uRitGX-BsybJ-cniV_ra1ggz8AGNE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nw-i8CYAu4YiRkJIAb8Lrtm0TSqzdOmi-yItdSiV0LQ&oe=69EF71E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAofXg_C_VEQ7kNvwEGgtiC&_nc_oc=AdqYXaraBI9S5i0vH7nn-DvBglEmn5ynxxWDd3lKM5EFhyPvTDqVKDIEnXBHbPa2dt4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nLle9Fpu5SHVuKttJm81YI0CLpXMGBLNr221wg0RMKg&oe=69EF6B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pV78raOl78Q7kNvwGbmuW4&_nc_oc=AdpilvVwaTePg324sRbc258AZBADpvIWMK1Ip4-nnjJnZEXqWNXTDW3D-wd-6MrYtf8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0x4w--Hpcxcr9A_TN0SBMcL8buf-BOAM7UmAlP7t5Kvg&oe=69EF4E13"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
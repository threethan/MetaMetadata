ng", "id": "1867755770461341", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcxopyYKdj0Q7kNvwFWnNX8&_nc_oc=AdrG9BygMogtbQ5BwEgcDJP8uGcseOOrVOmM-6mHdeGBmvL0fH4BKJzXj3pnlRJThNs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3C3s5Rs4uTk1DztW_-ytldtsy_z8y3oZO3hWQhBoBh1A&oe=69F20F5D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBfes1g8QEoQ7kNvwEuSaoR&_nc_oc=AdoSne40e9yp64ukyNjaSoPtZ-CIsEHg_AtfpceSfvTsrOpiapuwwA1XaqBpaHETr60&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0bHFIHSWhZg7mSx8qGD1GU9B5g2AXw3V1p3WGTcTKxWw&oe=69F214E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgRwwQNHhWQQ7kNvwGT--uh&_nc_oc=AdrGEutBThg1RChOXlOVIlEI943JIIpxGu-elufMxBsgFEZXcEuC-vMecVBOaUmoFSA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Ygu09YUVxANMoRiGoUWfWzrjZBNT1__9T4SLLmcVzoA&oe=69F20E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF1df0otf_MQ7kNvwGHL4kz&_nc_oc=Adqh09iIOIvTdDQ2Aw6l_TIpeb0Z3YR-SLNYbJGyhXd9H3AwtDzs12j9DxanaqynAJk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3e-4VVOHG09G9PayIQ0-sg9Gup6uUHADxziXZjVjmnCA&oe=69F1F113"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
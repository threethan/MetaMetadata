.png", "id": "688449120654377", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBUbfFOBJWQQ7kNvwFF0YI3&_nc_oc=AdrXAS9V1K7wW6GGjX5G5dTawRSr4XVoDQZEAlSTYdG-mcjwyqg47ABdcyT-DU4UXy4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWPfAUmPBrtkjR1aAJOExr7Kas-3Ac4FoS1W5LspqW0Q&oe=6AA17ED9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfMnVvyI1rAQ7kNvwF2uUF8&_nc_oc=Adp0beIe5xmBQtFT_owMD6hWj-DlzO_k5DUC9324QZakVOAXUgKY4Y6avl8j7hyCqNw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGNU7FeE61iN1z5meUpgaXy2K-M9xaAKpaMffiMY6wyg&oe=6AA166DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WckCK5yPWNkQ7kNvwGMwfez&_nc_oc=AdqOsvpDht5u-a76LPZNNHP8rQ-EwQcRG8N1JZZ4uto9fC2h8SCaJLsYmJOPk4CPLfg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY8LgBRdSKdfpOC4bt0KQV58fzcyf4kDJHqivaXGXVkw&oe=6AA16C65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SowmlMpAMZAQ7kNvwFULW1E&_nc_oc=Adp-xN42ke3hO_3OHqYPAYo4rkmp4GNAvpZOaNUCeScxgpRxO2Cs00Sm6isU3jIezU8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKThn3LGiYtsSgyWNmaELsjbSFFrAL3YjnH-IwhBEev-w&oe=6AA1661C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619193_3965841703674334_5697259317351281797_n.png", "id": "1313408776897190", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499313110_1313408783563856_8356873071102881000_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiq5wl-KnqQQ7kNvwEQH_uz&_nc_oc=AdqVUoxMZ06jD0428Dov8guvWU88BvO8Y7kkxnuXmLdnSfA1t_YkOeachhQ7gcLtpGw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWKb-gH_TWlCGN7U0BeJ1mbA5N2i89qLyVjKpTpWgglg&oe=6AA165AD"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtec
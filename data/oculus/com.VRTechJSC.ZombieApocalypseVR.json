18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg8odI3fjRcQ7kNvwHAzXOY&_nc_oc=AdpRvfzvMpDjGdxbBxFaPklpDIVfQMG3ilW3cct1UUNsVB8Q8rlUi0HIUonYNPrqAYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY2i5imF5FpXxkOD2amKsCto8CqoUme2UW9FesJsj0zw&oe=6A79B999"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm3YWo9Xkc0Q7kNvwHF95ms&_nc_oc=AdrZfeYFqOJDDYYhlGguVrgXYa61YC_0uDkSqigDl-kH8Ys29eH10naAUvhwe35GuhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcfxoU3fE_o0Q0f-Zh4CItWcZpiOm4IcfK3yNfblAf1w&oe=6A79D9DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC3V3h9wLC0Q7kNvwHhvzQp&_nc_oc=AdpplJZP_9bIKAW7NzjSGZx7-I61xy__tPx86bGMZuNh6PnWQOWObVuYTCgIJSUxzRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHStnE2_9kugp96A-VIuDocFk7XyxGriQw1QJXPCS-Ug&oe=6A79DF65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQR7P0BsF0AQ7kNvwEyAJ3-&_nc_oc=AdpFGii6ZbCWRTcxwGQOflN6Q0QbzyeTpOoqEkmzobW_9v3PLQqcNatHpu3qi8syZJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB4c-T4raN7UwyUJqmkU6zkdIM0Jn93ZPxVTy0sO_MnQ&oe=6A79D91C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCi_xVUBfcIQ7kNvwE-7VAI&_nc_oc=AdpvN_WrsYc10xDzAfT510AoEq2Gh5nqBk_LRWGtD7dJyR09T9v_LeJEdp8IyM_2kFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWuzGKqD-fuC57rE5A09k3Z8wAo5vNtmJaTLWn3RXbOg&oe=6A79BB93"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
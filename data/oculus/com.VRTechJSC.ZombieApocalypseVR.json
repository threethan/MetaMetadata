z6toOPBIAQ7kNvwFBhkko&_nc_oc=AdrYRckRRQgvghQt4F-9cMhgHGPQJy9GeOpKH-anohwxpKUUTK0aRlO6H-P9loweebI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3M2McgssH-Ylj7jyknDHAqidn-8GxeXJeH9lEaMRg97Q&oe=69F5E399"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa448l0JKkwQ7kNvwEA6nxy&_nc_oc=AdpDx5QGi8xllDpldeZdLThDQGAgry_zDSxXYisq4RkYd-71n-UVL_gjNqqbhdeIhTI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sJvCjqD_N00uKZDIA44jfj0f7CcyafjkBR9CkAtzyOA&oe=69F603DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JBTnTVOxVcQ7kNvwGASPGp&_nc_oc=Adr8btf9Ylvn0Vq42pQ9iacL5N0r3SYJKGuOWxJjONwDA4F6BYIuALCWsHbYj8JnhSc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ta9v1CeMbnGRdZIB1FJvG3m7hDg6UvuqQzQhWZ3kPGw&oe=69F60965"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clhCXkG88QEQ7kNvwEOkGfJ&_nc_oc=AdrbOGVtn2Q4H3rSlaBJeHTlFxGOfLewPPbYYpfH8cu52Wfr7Hq6lxxoUF2j6yYGxY4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21tI16k5HQii9JyewOjLrVniqxEDlgIe0J72k-rrBgVA&oe=69F6031C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Slide 16_9 - 2 (1).png", "id": "1496898618762464", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618288_1496898622095797_4212913132683484877_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xph2np3I0sQ7kNvwH5EWlL&_nc_oc=AdqO5UILW0iZKsmtelf5Es-yEPhIJ1FTHcY2_AE5AqqKoLfN-BsO0PakmT_yEMKQpfQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vKazm5vBJArohjVNvF-YvbwSzThb0xoZEygC1hw-Xxg&oe=69F5F2F7"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "**Update:\n- Create tutorial scene for guns\n\n\nStep into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"i
18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_7o0GV0zNgQ7kNvwFB5xLR&_nc_oc=Adr0kuz0PqgeAamsjDy7G_uAhAWrOUQ5g7jWGf594geAGRydlhbihdDTieW5nXQFTls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R4dq4tq5e3GJSXfDKTEZ0KjFcckkyWqDps7s8RoN-vg&oe=6A1EFA59"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOG5NPh0bJ4Q7kNvwHbGxSa&_nc_oc=AdopQ7iRtHtf6oPOkbaksdo86X9h1HJRqUyx0H0XjKiYv5d2ZnyjRyzCDfUyRLTPJNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N3Z7mTH-IlrDG2F5uwdHLRC9EPmdC4sRxkypA6BgE2Q&oe=6A1EE25D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGj5oLKdng0Q7kNvwGiygxs&_nc_oc=Ado57Cg8X0aAc7euorhNxsgqokosOSj7TExp6vm2wdJopyf5PcXNtoyGAJSmLvBJFHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e9BbbqxAhB98da3oiGcBRsuV4CNrgIWn9wyEkbixV1A&oe=6A1EE7E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pP5mlfQAl0Q7kNvwHCN_1O&_nc_oc=AdpkdLsew_nEtTH4fJqM--jnwxlTRgxcEcgjMAmStcg3RP-n7bdySL4BvMKacwKXfhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75Lemm2cBjQuEmTtGXQfqba8hbhotNso_9JruG5VxPig&oe=6A1EE19C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr_Z_prVThoQ7kNvwECRtDa&_nc_oc=AdoHSakdu-q0K0jKdyhiaG_-RDyA6DgMatBGmOb5odcxQgGDWx4H6yJazzE7FE0g524&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NI8PpfyLGkbkboaJ_XiadcxQk2JVeRf-8AnrQ2LTtUQ&oe=6A1EFC53"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
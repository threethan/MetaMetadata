18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edq5xQIqKPEQ7kNvwGqxgL8&_nc_oc=AdpyTZpNI1nO9EXjYdk3pkwowYOVw-kC2JspFu08vEr6sw_QHRs63fJ3hdBjIkPVCas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGC3AuvCbWnLiH4gFhDHQ5iPKzxuWLYDBLsMnjlr1eiQ&oe=6A674499"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOXh_VY_wcYQ7kNvwFc5Hgq&_nc_oc=AdrhTY88xO8_5nPq6i_lbw89dy8WdlzoiiBnEWS5xd6mYNdrJycKq_nqJ7xT6PbIWQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeMd4tbjSngB-yLMWm0m5eWXTQcJmlO7-iQNraqCeahw&oe=6A6764DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ-CEo52e5YQ7kNvwGM-785&_nc_oc=AdraqSjMtWB_PMEKkQZBZEXA835ov3XHWP_FSFv1VWsoSjostVxwAncvNBIi6aCQw5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATexd5Y6V4rEDMiVs48CJy8OxBlmW4Kdq1Q2daX7MhHQ&oe=6A676A65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWQ0ZoyBgrcQ7kNvwEP3ycS&_nc_oc=Adr4_W8BZnxXWmNXdFNDhDXVZQ-IW8knP4Gj2-0n1ZOLhngdGnJE6VdgcotVTPj1GFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAbq7ezuM2z9IXUeinltF1avNJqoRioeyOc9KU-dcK5A&oe=6A67641C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql1Divdo2voQ7kNvwFf8v3c&_nc_oc=Adp-YShWbmgp8qO7wOusfjaxejro1SukKru9WQrOagDVfaHqYCRmIzVfXxBphncIL00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwQipAU27a0NUHr6Lbwbfg3vio4wPb8v0n4ZEUKHwnyg&oe=6A674693"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
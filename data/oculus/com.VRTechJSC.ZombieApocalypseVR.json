18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSDfDWNKUz4Q7kNvwE1BfBG&_nc_oc=AdplgUTWFFiODZzdNQoM5Vt-94xDGuGgLNJbm9DnzBVgmZCZJ6Z5nmWwTvyodyzNe20&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOuhmqcj-46qb4rPMVyJ-BxdEQmBm-GtarIKwjJ69QSg&oe=6A565959"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtyG6jQonPIQ7kNvwFXylnH&_nc_oc=AdpdOSua81-8l4UGUUafo7Ycrrq7JiTvOyNfdFJrtgrzKwAPBeepEecW1BqxAVeTf1E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_XEI-HA9JEcCwg-VbUPOMxyrQb4GvhhhXRMZtEuoX5g&oe=6A56415D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRBs-eureqYQ7kNvwGcAryN&_nc_oc=AdqMjTHneoflJRNkFVwIVEs_9kW2X1CNt5HwUyG67YC8BABEL4CvqNrnqiuRI9Bbb-I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw9f28HkzkvJDLZoSE1ZKFT6-UbFnLUeC4R4B4jqTzwA&oe=6A5646E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Dap6sMTgbEQ7kNvwFQ6Z3-&_nc_oc=AdrO4NSqettVtPHTceQrzVBY8_yGpts1f1JHZowqi3k5eXnZktGl4fNk1yaxAi2rchU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4-gkMjFESCuiM_caPs6S6F818Zvn8e1ZgsFUg_sYCtQ&oe=6A56409C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erJuX-_NlnkQ7kNvwFnWJXn&_nc_oc=AdrQzNxX3cznOG9xITJGHtarUknEZJTpuefQwd2kPzpOSJ7RYKT5Z3gnSi2XMOpzOmI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2AkIG9e8jWpAz59U10xJANJ0Qm1wppcVv9YxckG_kcg&oe=6A565B53"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeLZbb4dN8sQ7kNvwFnppqp&_nc_oc=AdqpKiw6Yxb4peefnu3yhHGaLsRbUozC149iiFqix4vz7jgJHJEdyEMTU8Bxx_GKdEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYefVNZflyajWmdDwKospkpDly3EVWpiWZQfetVjnttA&oe=6A60AD19"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SsDNXq3FNcQ7kNvwFmn0sz&_nc_oc=Adq_DDzupWEJRsUgSkOxZJSz69XwMtVp5IK8E0nqftmbXtbrhvEmha7kR9B_8TLRHp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5pOzTmRSbpgOtj_nVbrAqoovm1TEc4LdkxlQyPqDwvw&oe=6A60CD5D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zMYzJr_UBsQ7kNvwH3lrbR&_nc_oc=AdoM8WrX5InOwf0d7XtR5-pdhjKcEu8rt1OaBRnXVVLJ1rGHVV0XcOruBkQcZcjPhfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTUUXmBEkimJYYUbtwMAn_wdw1jvn8hlKWkP1Gg1RTSw&oe=6A60D2E5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YXKAw_RpgYQ7kNvwGX27Il&_nc_oc=AdoQKrKvBntYJQisgVvMSXDRLPeYS7InhmZQ84kd7i-jifJak7FzTxdgfrcbkorEAgA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_ztFneihH0Rig635j3f857OAgiHqEmnwP-mn0xk-7NQ&oe=6A60CC9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW1-34qM49AQ7kNvwF86asV&_nc_oc=AdqAM_ULMC03ITr6e5Ua0Py3sk8WzIPtt0ddZMODdy9RJXSGKM0LsCR2NRd_hgMJVJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkzHqh_7bkXT8yqV39i9IcBDoShUZfNsP9ihBq7KtGVQ&oe=6A60AF13"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
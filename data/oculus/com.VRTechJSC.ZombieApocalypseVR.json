18095_688449123987710_6111928753173723754_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5HM2XAgU5kQ7kNvwG89fU1&_nc_oc=AdpOaxa3PCUC3rzUu32-GdFwhmVkigdxrLpWzLmPKjDhMk1SYSVzEIUYMiQ5MwUs2EU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HzTW0YqC_KuqY7vsFgfYPDr1x6_dZ8Oxj6t5-na7O2g&oe=6A3D4CD9"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ejQmp8RXSAQ7kNvwH9gwks&_nc_oc=AdpusfnkFjPCd2GJcEm3em3bpReaX5PSMLUiFt9HaCbFDOFjh1A6RASjuKvGA_mYPiI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92GewH7IH3xa1LjUvhqI6RSn5cO19zysXtWkJCkJTLeQ&oe=6A3D34DD"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bk00qxZl5cQ7kNvwHhIXRf&_nc_oc=AdpUhdRKEt8m6NFRwt0-ALN2vfXRejEx76ZxLRaIdHy4DZyvMoukSNAb82W_nMU8cj0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z1ZUeeAzw6glZHjU0A7K8I3TMZlQQ_4_S91FvGkfxCA&oe=6A3D3A65"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sUNwxpLVCEQ7kNvwEmAuRr&_nc_oc=AdqJFxjtqPjYrscCoR82s3djekKbP4yIS--c2vQh1FGlyvx7fWjkm_6-bufp1a1Wp4c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89va-9rWSadWWjcutOAnLt9kIkUtKHXlqFd66sa4DUig&oe=6A3D341C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB_DhVujnGYQ7kNvwH0Y63U&_nc_oc=Adpvl5BPPQIyg8Wj8aBwn3LmZiKcVwI4CIDYVShZf19Uq01nPqdUPWB0BAsHD1as-WY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hz98AOyaGZTHYUWvgBwYft46wYVrxr7PvT3eeJe5ymQ&oe=6A3D4ED3"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "cont
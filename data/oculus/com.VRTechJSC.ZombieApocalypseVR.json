d5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jXXJEJPx-ySz2sG3powitP1nqdhpqa1_Th5A4FI_l4A&oe=69FA1059"}, {"file_name": "Screenshots_3.png", "id": "1867755770461341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617783_1867755773794674_3857996551257610627_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nke5yj02o7sQ7kNvwGvRuWw&_nc_oc=AdpHLd4EfKZXjLKvyWJP7NBjXSzQhEWJ05LenS3ACcgIIZcaiL1kaquU5SdxxGCP_d8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67Tmwb50p-x4OKj11odLpS-n9wz2vo8H2bh6oGby33TQ&oe=69F9F85D"}, {"file_name": "Screenshots_4.png", "id": "2096049390914648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619590_2096049394247981_3503683373350431193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Xdq9hhmykEQ7kNvwEyf-kj&_nc_oc=AdqNu0XHmuW0rcXAku_S6VZVI51qufsQCHRz-kPkdvXccsXrEqDH4G5s1jzNlKvuVXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YTbUgUKzLf-W_YbQ32RpaBhGxGsEvdYhYVgMkHTGECQ&oe=69F9FDE5"}, {"file_name": "Screenshots_5.png", "id": "1460854708421221", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618254_1460854711754554_174434901764807153_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIaL9OpyFtMQ7kNvwG2AcDO&_nc_oc=AdpQwq6NHG3apvJyKBai3ctK-CPakWDlL4FN4r6UlAWf3URgmtmYYWHNZEmGCHZ0lEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af602iZRKl0jKvX29LK-1FvXShKW9Nm1WxcYAgzoe1x2pQ&oe=69F9F79C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "3965841700341001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619193_3965841703674334_5697259317351281797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmXWGSpegJwQ7kNvwGWsJB7&_nc_oc=AdopX38oC2h0M4yIF_Lg4JZWovDwDBD7cJVbXACt0EOfmZZBjk2twVLCpP0L5uoDywA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44jtmXNvGqJAXQhjcExi2zEQAFk916Yw3KC5DcPvlI7A&oe=69FA1253"}, "display_name": "Zombie Apocalypse VR", "keywords": ["zombie", "shooting", "new", "fps", "trending"], "long_description": "Step into a crumbling world where civilization is no more, and survival is the only law left. Welcome to Zombie Apocalypse VR, a heart-pounding, fully immersive virtual reality experience that drops you into the middle of a brutal zombie apocalypse. Built from the ground up for VR, this is not just a game\u2014it\u2019s a test of your instincts, your aim, and your will to survive.\n\nThe outbreak came without warning. Cities fell within days. Governments collapsed. Now, you\u2019re one of the few still breathing, trapped in a hostile world where the dead hunt the living, and every corner could hide your next nightmare. Armed with your wits and an ever-growing arsenal of weapons, you must scavenge, fight, and endure if you want to stay alive.\n\nZombie Apocalypse VR delivers adrenaline-fueled action with motion-tracked weapons, free movement, and full environmental interaction. Every reloaded clip, every headshot, and every near-death escape is experienced as if you were there. Feel the tension rise as groans echo from the shadows. Spin around. Aim. Fire. Survive.\n", "short_description": "Step into a post-apocalyptic world overrun by zombies. Armed and alert, explore deadly environments, take down relentless hordes, and stay alive\u2014because in this VR shooter, it's you or them.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
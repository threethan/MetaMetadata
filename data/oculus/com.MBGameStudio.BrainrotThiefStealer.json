ntent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQROz7qdyDSDih7IXMLkHt1kSWd4s7QFkka4gukMqw8g&oe=6AC65364"}, {"file_name": "5SCREEN.png", "id": "1594567148863193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1594567152196526_7121521512018384198_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD35izccOJcQ7kNvwFrCBeO&_nc_oc=AdoremZlceP3ix6KHwmyf-Y0v9fGqsqb5FQem-jKxQyvDgbJCdS23tqqHbW-efVCKlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh9EK0uaBwDLS72x-JCXK9pqoxiI2eXboot4qJCYccCQ&oe=6AC64AE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steal Brainrot: Thief Stealer", "keywords": ["steal", "brainrot", "stealing", "survival", "tung"], "long_description": "Welcome to Steal Brainrot: Thief Stealer, a chaotic brainrot adventure that blends action, survival, and simulation into one intense brainrotting experience. In this brainrot game, you live in your own home while brainrots appear on a central platform, pushing you to steal a brainrot as fast as possible and secure it before it\u2019s gone.\n\nYour goal is simple but addictive: steal some brainrot, bring it back to your base, and survive the growing challenge. This brainrot simulation focuses on timing, movement, and smart decision-making as you continue stealing brainrots and improving your runs.\n\nCollect iconic meme brainrots like tung sahur and more while building the ultimate brainrot collection. Stealing Brainrot is all about mastering the loop of stealing brainrots, protecting your progress, and surviving longer each time in this fast-paced brainrot survival game.\n\nWhether you enjoy action games, survival challenges, or simulation-style gameplay, Stealing Brainrot delivers a unique mix of adventure, meme energy, and nonstop brainrotting chaos where the goal is always to steal some brainrot.\n\nFeatures:\n\n\ud83e\udde0 Steal a Brainrot Gameplay - Run to the platform, steal some brainrot, and bring it back safely in this core brainrot stealing mechanic\n\n\u26a1 Action-Packed Brainrotting - Fast-paced action gameplay\n\n\ud83c\udfe0 Home Base Simulation \u2013 Manage your own space and store your brainrot collection", "short_description": "Steal Brainrot Thief Stealer in this chaotic brainrot game where you and others compete to steal some brainrot, defend their stash, and survive the brainrotting madness. Grab iconic meme brainrots like tung sahur and tralalo tralala while others try stealing your brainrots in this fast-paced simulation adventure survival meme experience.\n\nHave your own house, buy brainrots, protect them and try to steal as many brainrot as you can but watch out as other can steal a brainrot from you!"}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25608515892155156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1523045749821500"}]}, "baseline_offer": {"id": "1523045749821500"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784804220, "status": "PUBLISHED", "id": "1523045749821500"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
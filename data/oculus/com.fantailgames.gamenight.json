939448815013885_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-logrNZFi4Q7kNvwHNLlFD&_nc_oc=Adra0nOfBPzRQlBrMTtKoms5AnTdLFFXMZT1gcJKHi6I1Mcd6OibRq7wq9uHNzb2Tp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtQ_r6pCz7ZuGosdUdH7sV3Cmdma7r9gNLpalU5ZRzCw&oe=6AF1DB3D"}]}, "id": "1617498179201400", "locale": "en_US", "screenshots": [{"file_name": "Screenshot5.png", "id": "907177008020445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75299164_907177011353778_5280054790589429898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFUdnBi7DrIQ7kNvwEcRuXP&_nc_oc=AdpCmpdCFhSGGqcETmNE_AVjjW73drae4Sw_9txpjBQKntZ7gzBVu1g46dkox3VZjLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHt2pP8tYTSWYViay_azS_vjJOZrzYJCyrM_Ma_s5eIw&oe=6AF1DD54"}, {"file_name": "Screenshot1.png", "id": "1095471751421767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974879_1095471754755100_4139716018714587894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCTjmUTReLQQ7kNvwGhskYT&_nc_oc=AdptXl5_bEQjMvzDNbABwsDLFD5BgRSX5O5gcWUhuX7VG7GhpDUIwPqBhkORpbFiFMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQheyiNol7kd6AfIq7vRNTE7558r5SM8xckxSi1VPI8dA&oe=6AF1EF9C"}, {"file_name": "Screenshot2.png", "id": "1269718507781466", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001727_1269718511114799_4049486010738995088_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0AInyoAOOsQ7kNvwEhw8tW&_nc_oc=AdonUPWdGqi6c2pzGAqendlJA-6LTynsFuERWDBCXv96qf2Vaj915hx7eJTGQ3whLfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmOsOk4zINpeKgQT-2qzYB9Si8HTkmw-v-QPazDfHwlw&oe=6AF1EA72"}, {"file_name": "Screenshot3.png", "id": "502703552730574", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974463_502703556063907_7418726509708352419_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILGIXZ5flgIQ7kNvwGC4RIQ&_nc_oc=Adqgr4HqqrJeDUq8Oe34uYJgOolgivHmHPqQ--z9kIiCeIZvU8sRodsGqiISaZrYE8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8Sjx_zJIYP9v_2-M_BhX4L5OlUoqsX_8yBRFwp7LzNg&oe=6AF1F7B8"}, {"file_name": "Screenshot4.png", "id": "459311616671184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031447_459311620004517_7580658906980873012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DJ4zinB-cwQ7kNvwGuQyTO&_nc_oc=Adp4nZ908a7t7rZUB711Qc3XFjgqbshAvyX9pttMGBnNtOG_eYK2izWFAdy_dg6Uigw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpdYeQeoQXoFzBD8ddeTNdmpa1BYDVEjYgL6I9Lvv2ZQ&oe=6AF1F75C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Game Night", "keywords": ["party", "family", "multiplayer", "MR", "minigame"], "long_description": "# Local Multiplayer Mayhem\nInvite your friends and family to bring their Quest to yours for the ultimate party experience! **Play together** in person with **up to four players**. With **competitive and cooperative** play it suits everyone from teens to grandparents. It'll bring any event to life from birthday parties to team building exercises.\n\n**Online multiplayer is not supported** as everyone's rooms are different sizes and shapes. Plus there\u2019s just no substitute for playing together in person!\n\n\n# Single Player Mastery\nOnly have one headset? No worries, **perfect your skills in single player**. Each minigame has **hidden strategies** to learn. Beat your personal best and give yourself the edge for the next party.\n\n\n# Get Physical\n**Move fast** comfortably and safely (no more standing on the cat or punching the wall)! **Your body is the controller!** Use your hands, head, body and even your voice to interact with the game and your friends. Play hard and feel the burn.\n\n\n# No motion sickness\nIn MR, you\u2019re moving, not the world so your body doesn\u2019t get confused. With the Quest 3, **even the most prone can play** without risk of feeling rough. If they don\u2019t believe you, say I said it\u2019ll be ok.\n\n\n# Join the community\nJoin our discord to share your ideas or to find other players in your community.\nhttps://discord.com/invite/mDWR7yjXy4 \n\n\nAvailable on Quest 3, Quest 3S, Quest Pro, and Quest 2.", "short_description": "Run around your lounge together playing your favorite party games imagined to life around you in Mixed Reality.\n\nMaster minigames solo, or invite friends and family around for the ultimate party! Combining the best that board games and sports have to offer you\u2019ll test your mind and body. With cooperative and competitive play there is something for everyone from teens to grandparents. \n\nJoin us on our Early Access journey. Together we will make Game Night the best MR game on Meta Quest!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fantailgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fantail Games", "support_website_url": null, "website_url": "http://www.fantailgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8603854549649724"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "2712391312527359"}, {"status": "PUBLISHED", "id": "1471534161451399"}, {"status": "PUBLISHED", "id": "1838662830849582"}, {"status": "PUBLISHED", "id": "1578902666579364"}, {"status": "PUBLISHED", "id": "1544893894028382"}, {"status": "PUBLISHED", "id": "1400136078829486"}, {"status": "PUBLISHED", "id": "1413477867113375"}, {"status": "PUBLISHED", "id": "937261515577769"}, {"status": "PUBLISHED", "id": "1402802851048179"}, {"status": "PUBLISHED", "id": "1965327361079891"}, {"status": "PUBLISHED", "id": "1359986312015750"}, {"status": "PUBLISHED", "id": "730748286738963"}, {"status": "PUBLISHED", "id": "1849302439027441"}, {"status": "PUBLISHED", "id": "750166094484589"}, {"status": "PUBLISHED", "id": "1997058834456065"}, {"status": "PUBLISHED", "id": "1331747784591438"}, {"status": "PUBLISHED", "id": "3608302112803856"}, {"status": "PUBLISHED", "id": "1182288839918021"}, {"status": "PUBLISHED", "id": "914957820358023"}, {"status": "PUBLISHED", "id": "1022010503012400"}]}, "baseline_offer": {"id": "1578902666579364"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2712391312527359"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28077473788527843", "version": "0.5.55"}, "id": "532812109502638", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8603854472983065", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28077473788527843"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "532812109502638"}]}, "change_log": "Just when you thought Game Night couldn't get any better, we've got a new update for y'all\n\nChangelog:\n* Fixed \"You don't have authentication\" issue when not online during first run\n* Fixed game failing to run when player name couldn't be accessed\n* Fixed Penguin Pucks penguin arms having poor performance with lots of players\n* New intro/outro for Hungry Bunny Uppy\n* Fixed occlusion issues on scores\n* Fixed hat sometimes getting stuck when two players use it at the same time\n* More sounds in Fishing Frenzy\n* More hat sounds\n* Fixed sounds sometimes bleeding into the next game", "created_date": 1787890330, "id": "28077473788527843", "version": "0.5.55", "version_code": 188, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8603854472983065", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28077473788527843"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "532812109502638"}]}, "change_log": "We've fixed a huge number of bugs after testing with 900 players at a major culture expo here in New Zealand.\n\nChangelog:\n* Fixed rare bug where game elements don't appear\n* Fixed ready button sometimes not appearing for some players\n* Fixed ready buttons counting down but the game not starting\n* Fixed glitch allowing 5 players (which breaks the games)\n* Penguin Pucks: Improved networking performance of Penguin arms so they don't lag when many headsets are running\n* Penguin Pucks: Sped up scoring animation\n* Rattlesnake Railroad: Engine hitbox size increased\n* Simplified scores flow (no longer require everyone to ready up between games)\n* Fixed numerous bugs relating to spectators joining/leaving during an active game\n* Fixed issue loading game while standing outside of the scanned room\n* Fishing: Fixed vibration on fish/boat\n* General performance improvements", "created_date": 1786685267, "id": "27903207729287784", "version": "0.5.50", "version_code": 184, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8603854472983065", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28077473788527843"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "532812109502638"}]}, "change_log": "Game Night just got a whole lot prettier! We've given all of the minigames a lick of paint. If you haven't played it in a while, now is the perfect time to give Game Night another look!\n\nSlap-a-martian - A UFO has invaded your room, beaming down its invasion force to turn you into a jelly alien\n\nRattlesnake Railroad - collect coal, silver and diamonds for your train. Travel through the rocky desert terrain.\n\nFishing Frenzy - Your room turns into an aquarium filled with beautiful coral, waterfall and clownfish.\n\nPenguin Ice Hockey - It got colder with snow drifts surrounding your room\n\nOther fixes:\n * Fixed occlusion on some shaders\n * Stability improvements", "created_date": 1784263890, "id": "27571384969136730", "version": "0.5.32", "version_code": 171, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8603854472983065", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28077473788527843"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "532812109502638"}]}, "change_log": "Co-op Update!\n\nGrab your friends and check out our brand new co-op updates! Will you take the crown or work together to unlock secret co-op prizes? There is no mode to set,  just play how you want to!\n\nNew updates include:\n\nBeautiful new score boards!\nCo-op Stars: earn these as a group. It's based on the lowest player score, so work together!\nCo-op Rewards: unlock these based on how many co-op stars you earned! Can you get enough co-op stars to build the whole rainbow and unlock the pot of gold?\nDress your friends! With the new character customization system", "created_date": 1781064962, "id": "27144372671837964", "version": "0.5.26", "version_code": 166, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8603854472983065", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28077473788527843"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777237700, "id": "26597848969823673", "version": "0.5.25", "version_code": 165, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
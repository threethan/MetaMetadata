5/491821989_1400588584378372_4292997279504718722_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmYouLXKUNkQ7kNvwG5zoCY&_nc_oc=Adp1WPHDMP0PTC-l-REgPn72SY5ftC-UUbiKJEx5FpXuFglyCE4N9-7CXW-X1b7k3g8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpna1FhAOCWiS6yeZv3hhVGtoOq9-IYrMqV4WvIacVZA&oe=6AC66B7B"}, {"file_name": "com.HKUST_vislab.Gavis-20250818-103802[1].png", "id": "785004970573124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819407_785004973906457_6546641235720316737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3odedVde-0Q7kNvwHapgrQ&_nc_oc=AdpdYupSpK_jUUhYu-mXTLrZ7COWw4r_t3oORFZ8YAQIFlPLP9dr3IfMkh_JV62eCaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1P7ClUbxqbfsj75ov5Mcjh2u3IZaY4PiFCZODFBzOQg&oe=6AC65206"}, {"file_name": "com.HKUST_vislab.Gavis-20250818-110144[1].png", "id": "1193012022624319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823893_1193012025957652_1298939059516620975_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGLY6TCt_iYQ7kNvwGq7NdI&_nc_oc=Adq8WOqD9CGGKxcn4_9yvEi48pSt3fr66rl1bh7uq8A-cPtQTnk-56Cvdfr9g1BbfL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM__OSsO96Qf4GmYCAQpkoqTCdSUFvrGKAJ25QpO09XSw&oe=6AC65F45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gavis TTVR", "keywords": [], "long_description": "Elevate your English speaking abilities with our comprehensive app designed for language learners. Featuring a wide range of interactive lessons, speech exercises, and real-time feedback, our app provides a structured and engaging platform to enhance your conversational skills.\n\nWhether you're a beginner looking to build a strong foundation or an intermediate speaker seeking to refine your fluency, our app has something for everyone. Through immersive dialogues, pronunciation drills, and simulated conversations, you'll have the opportunity to practice English in a supportive and risk-free environment. Our app leverages advanced speech recognition technology to provide instant feedback on your pronunciation, intonation, and fluency, allowing you to identify areas for improvement and track your progress over time. Additionally, the app offers personalized recommendations based on your performance, ensuring a tailored learning experience. Accessible from your Meta Quest device, our English Speaking Practice app offers a convenient and portable way to improve your language skills anytime, anywhere. Embark on your journey to fluency and unlock the power of effective communication with our innovative language learning solution.", "short_description": "English Speaking Practice - Improve your conversational skills with interactive lessons and speech exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gavis.ai/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Trumptech", "support_website_url": null, "website_url": "https://gavis.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24747790924846544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639802_470981525806863_8872198684142402695_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0QzUyF5K5EQ7kNvwGBrqlK&_nc_oc=Adpr5Aj6CZWa4A3gbvmJhX2tKiAR6ee45odgAnXkOIo
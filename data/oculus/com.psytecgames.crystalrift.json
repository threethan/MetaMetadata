_BBEy-T1mzDeyYbfIzX9P4PRUZb5MKzKce8D1ly_pZTXskp-NZ5CZ5sE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7jRvMVLnClsZnzckWJ-MoJbry6imMIj6sE4aJyN2hzQ&oe=6ABA83BD"}, {"file_name": "12138840_658065914349379_1225992143_n.png", "id": "1349766259086227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_1349766262419560_134214310981000175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mEZRKNZxekQ7kNvwEcqViw&_nc_oc=Adq5kKAiWWvW0shfmwY2XoFerNETxFlJDU5XJE3bY6vzBn67KGL8ibdEaFxXzMSBwqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuhtXkY1ohdU2wJz7Cv9npP495m9DWbX5kU48Ezu0dUA&oe=6ABA78C0"}, {"file_name": "Screen Shot 2.png", "id": "1833013518054664", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1833013524721330_7592967030426431821_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN88xz3pZ3wQ7kNvwE896_K&_nc_oc=Ado_VO64HiGW9z4N-3O_YftBfYMhTtHtr6vj-cJMniYA01GEFFhN1vL87U_QfwABiPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-Z3o0f1AtHfdRBack3nb2A2teoi1pv7JIF3AL5bHzwg&oe=6ABA8C79"}, {"file_name": "Screen Shot 6.png", "id": "2952497958420542", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_2952497961753875_1383754931031863755_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahcQDXQ32ckQ7kNvwFd-9nM&_nc_oc=AdrurNeB0WaJrSB1z8kxRbPnER1v2mtHzIJsIdovL3T_AE73CM-eV6bRWEiaOY6IC4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnMNtz_gSJ5cI7CYu-1j9RSJOOblGX1n3vdMb4Xsu2Cg&oe=6ABA6310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landcape_2560x1440px.png", "id": "210572401394008", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031350_210572404727341_8241821180130177923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN9b07HlhpcQ7kNvwFrd2UP&_nc_oc=AdqjqgDxGY4Rr2iqmU93nyDF-hCynBcouHltL3SPNetLu2SO2rmuQ9NYFVKmn_cPsS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3ktK0wOY_owlHeMRig7jm2dOLO_WmF25B_yFEMb9WPg&oe=6ABA7907"}, "display_name": "Crystal Rift", "keywords": ["Dungeon", "Maze", "Rift"], "long_description": "A grid-based dungeon-crawler, in classic first person perspective.\n\nCrystal Rift is an inspired by classic dungeon games such as Dungeon Master and Eye of the Beholder with grid-based movement.\n\nIt\u2019s an experiential horror challenge game that takes the player through a series of increasingly mysterious locations. Crystal Rift has 26 levels, with unique styles and settings, to provide many hours of gameplay. The player slowly uncovers the narrative and story through exploration, discovering dark secrets and following the path of those who have come before.", "short_description": "A grid-based dungeon-crawler, in classic first person perspective. Crystal Rift is an experiential horror challenge game that takes the player through a series of increasingly mysterious locations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy", "developer_terms_of_service_url": "https://www.psytecgames.com/terms", "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "http://www.crystalrift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27403958502560118"}, "review_messages": []}]}, "cover_square_image": {"u
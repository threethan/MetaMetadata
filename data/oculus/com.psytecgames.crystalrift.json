QULuLoydQSjES4UCirmqtialVUcxCGA&oe=6A69DFFD"}, {"file_name": "12138835_1682233945350932_58087739_n.png", "id": "1261531801415696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_1261531804749029_8450869964928990167_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiTZHA-6yiEQ7kNvwEpedAp&_nc_oc=Adq5rmSHAiWNTmZUK99az1KtD9lniHT_1hmFIsTymXoJLIAHXBUiZd8CEvJstlPoYRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDShy9Py48YQ8pyfeck6wtJ_xnMoWnecxjpNZJQafFriQ&oe=6A69F040"}, {"file_name": "12138840_658065914349379_1225992143_n.png", "id": "1349766259086227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974807_1349766262419560_134214310981000175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA6hcpk2rgYQ7kNvwGx_vhT&_nc_oc=AdqfSFRCLTp8DWGzvjpX61aY6rK2xaJ6kB51lM6GT4Nv-XmVyNIX4bfIsuo79kz6glQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa2EKeTkoLank_oJg14bkA8yhXjwCTkUlPMCO_IqpC2Q&oe=6A6A0D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landcape_2560x1440px.png", "id": "210572401394008", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031350_210572404727341_8241821180130177923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Q0LtQLt3EUQ7kNvwFFXZ5Y&_nc_oc=AdrRdLr4ebUXeiIQi4NvFM2CGGw5rWYSnpA9oNECjHN1lQ37VsfKTLKF7itzp6GdUfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtKePLCJztjReAMPAz9wiNLxfhWprHqYlPySvYkCK-5w&oe=6A6A0D87"}, "display_name": "Crystal Rift", "keywords": [], "long_description": "A grid-based dungeon-crawler, in classic first person perspective.\n\nCrystal Rift is an inspired by classic dungeon games such as Dungeon Master and Eye of the Beholder with grid-based movement.\n\nIt\u2019s an experiential horror challenge game that takes the player through a series of increasingly mysterious locations. Crystal Rift has 26 levels, with unique styles and settings, to provide many hours of gameplay. The player slowly uncovers the narrative and story through exploration, discovering dark secrets and following the path of those who have come before.\n\nUse the In Game Dungeon Editor to build entirely new adventures and challenges for other players to solve.\n", "short_description": "A grid-based dungeon-crawler, in classic first person perspective. Crystal Rift is an experiential horror challenge game that takes the player through a series of increasingly mysterious locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crystalrift.com/privacy/", "developer_terms_of_service_url": "http://www.crystalrift.com/terms/", "publisher_name": "Psytec Games Ltd", "support_website_url": "http://support.psytecgames.com/", "website_url": "http://www.crystalrift.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1192826961398224"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1054221324211612"}, {"status": "PUBLISHED", "id": "936351189238925"}, {"status": "PUBLISHED", "id": "1209650707221830"}, {"status": "PUBLISHED", "id": "1001274630864373"}]}, "baseline_offer": {"id": "1054221324211612"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782410940, "status": "PUBLISHED", "id": "1054221324211612"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "b
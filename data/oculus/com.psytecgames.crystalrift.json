hYxA&oe=69AC3540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landcape_2560x1440px.png", "id": "210572401394008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031350_210572404727341_8241821180130177923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF4wby4uNyAQ7kNvwGPKjiu&_nc_oc=AdkJ7qBquodNXhf7jhZYatNSEX9xX0vE2KisDFjZ92xnEy1-SY1rkNGqyL384OJbcT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1mPtO2MYJ44vvDbVPro88bh58kD8oeaUaggGn-h4QWg&oe=69AC3587"}, "display_name": "Crystal Rift", "keywords": [], "long_description": "A grid-based dungeon-crawler, in classic first person perspective.\n\nCrystal Rift is an inspired by classic dungeon games such as Dungeon Master and Eye of the Beholder with grid-based movement.\n\nIt\u2019s an experiential horror challenge game that takes the player through a series of increasingly mysterious locations. Crystal Rift has 26 levels, with unique styles and settings, to provide many hours of gameplay. The player slowly uncovers the narrative and story through exploration, discovering dark secrets and following the path of those who have come before.", "short_description": "A grid-based dungeon-crawler, in classic first person perspective. Crystal Rift is an experiential horror challenge game that takes the player through a series of increasingly mysterious locations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy", "developer_terms_of_service_url": "https://www.psytecgames.com/terms", "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "http://www.crystalrift.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
z05qqLZ591IaISQBN-doH3OWHyE48-w&oe=6A9C313D"}, {"file_name": "12138835_1682233945350932_58087739_n.png", "id": "1261531801415696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001660_1261531804749029_8450869964928990167_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUAM5eEuHycQ7kNvwHVhiJ5&_nc_oc=Adp0PXAPgKJ8ZIkLla1E-7Ks6zRhZFlqgS9igSxL0enULOftet5IST1puxqyBeTcguA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0MXjW_FVWVZEy4GStDEQJ58Wjlc-FWaNDE0zc7DOncg&oe=6A9C4180"}, {"file_name": "12138840_658065914349379_1225992143_n.png", "id": "1349766259086227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974807_1349766262419560_134214310981000175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjnkAYOMUvgQ7kNvwE4xIIA&_nc_oc=AdpysH5tM6jNQGK-XA1C1Q8pshPNPfQgmFw_7imvTBqcZI0ND4aiKmoMl0macu0RwZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYgwq2EbaNCY0p1QRC6oy30UhriKwxac9zYco4r4ItCg&oe=6A9C2640"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landcape_2560x1440px.png", "id": "210572401394008", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031350_210572404727341_8241821180130177923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn5gI5HaQi8Q7kNvwFGH0dK&_nc_oc=Adr9i68VEQ1ExdS9cxVFYdHHTjMoJBggnbQ9O3y_WOc0931e5VdsBMR3riq6CYI8xKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXKwPzqKIRCxcnku4UwjjZDqvmAE-By5bStUjv4jtXqA&oe=6A9C2687"}, "display_name": "Crystal Rift", "keywords": [], "long_description": "A grid-based dungeon-crawler, in classic first person perspective.\n\nCrystal Rift is an inspired by classic dungeon games such as Dungeon Master and Eye of the Beholder with grid-based movement.\n\nIt\u2019s an experiential horror challenge game that takes the player through a series of increasingly mysterious locations. Crystal Rift has 26 levels, with unique styles and settings, to provide many hours of gameplay. The player slowly uncovers the narrative and story through exploration, discovering dark secrets and following the path of those who have come before.\n\nUse the In Game Dungeon Editor to build entirely new adventures and challenges for other players to solve.\n", "short_description": "A grid-based dungeon-crawler, in classic first person perspective. Crystal Rift is an experiential horror challenge game that takes the player through a series of increasingly mysterious locations."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.crystalrift.com/privacy/", "developer_terms_of_service_url": "http://www.crystalrift.com/terms/", "publisher_name": "Psytec Games Ltd", "support_website_url": "http://support.psytecgames.com/", "website_url": "http://www.crystalrift.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1192826961398224"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1054221324211612"}, {"status": "PUBLISHED", "id": "936351189238925"}, {"status": "PUBLISHED", "id": "1209650707221830"}, {"status": "PUBLISHED", "id": "1001274630864373"}]}, "baseline_offer": {"id": "1054221324211612"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782410940, "status": "PUBLISHED", "id": "1054221324211612"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "b
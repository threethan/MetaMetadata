9031350_210572404727341_8241821180130177923_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jjk-IctxT0oQ7kNvwHYVQTk&_nc_oc=Adogc3kb8MKsRM5BGGCWKba8Z6OsdVdpn2SOSR6d1AxJv2omvfn4WdBkVb2VVUC-mbc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhtFwFsAydlwogLEijoHe5FeRNna6lSXO0jQM7loGehw&oe=6B0B1CC7"}, "display_name": "Crystal Rift", "keywords": ["Dungeon", "Maze", "Rift"], "long_description": "A grid-based dungeon-crawler, in classic first person perspective.\n\nCrystal Rift is an inspired by classic dungeon games such as Dungeon Master and Eye of the Beholder with grid-based movement.\n\nIt\u2019s an experiential horror challenge game that takes the player through a series of increasingly mysterious locations. Crystal Rift has 26 levels, with unique styles and settings, to provide many hours of gameplay. The player slowly uncovers the narrative and story through exploration, discovering dark secrets and following the path of those who have come before.", "short_description": "A grid-based dungeon-crawler, in classic first person perspective. Crystal Rift is an experiential horror challenge game that takes the player through a series of increasingly mysterious locations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy", "developer_terms_of_service_url": "https://www.psytecgames.com/terms", "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "http://www.crystalrift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomm
_ne0zPOIBMCbSCPG0pF7hk_9Nkerauo5srHDFgeN9vYSytuQBAylCRkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAlH5_u4RwtmLO86l6rHt2hrwgxGU4S-pZ-XQu6OkYDw&oe=6ABFC9BD"}, {"file_name": "12138840_658065914349379_1225992143_n.png", "id": "1349766259086227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_1349766262419560_134214310981000175_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6IvuiF6rMcQ7kNvwEDvz02&_nc_oc=AdrKB1wBCAm7723ZyCuhppGwoajSLZwP7V4SUY9nNLAz8ZolprZTOa2Adpqaepq-05E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhbPL74YIaMEK1Gp24a50Z_t4aCLPoZTr1FX16VvpOKQ&oe=6ABFBEC0"}, {"file_name": "Screen Shot 2.png", "id": "1833013518054664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_1833013524721330_7592967030426431821_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiQPNu3qtX4Q7kNvwElKBRQ&_nc_oc=AdpTTwNA3GEqhaOQlpGAUH12evQqOtD3pdcFZk9KyIWE-g4AQD9MAW2f69Ov5k__uz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXfQ03wYrWfDrASlC13D5mKCH-V_kDXvFqidUJhQHLvQ&oe=6ABFD279"}, {"file_name": "Screen Shot 6.png", "id": "2952497958420542", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_2952497961753875_1383754931031863755_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euFTSH84fJUQ7kNvwF7fzrF&_nc_oc=AdorG-C7QYccSSLswDnNMPO__D_1piXsFOqfaQH_-tl5p6G7fJraeLoELTHF5ycZRHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq6EXLee8Jot_tjCFVBjI8k9wrC06L8Q1keA_2TYa1gA&oe=6ABFA910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landcape_2560x1440px.png", "id": "210572401394008", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031350_210572404727341_8241821180130177923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdLvUHW1kZcQ7kNvwE-5gAC&_nc_oc=AdomGE16uWnNpW6sh3G6JUqczwjTy_SiWMwIAay0sJOG_NvhVZP33-GEZuLpiOUpGoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgStfJUsqqgoVIY6ErR6AoiRNTezDUP5rAqw0rQdFfOg&oe=6ABFBF07"}, "display_name": "Crystal Rift", "keywords": ["Dungeon", "Maze", "Rift"], "long_description": "A grid-based dungeon-crawler, in classic first person perspective.\n\nCrystal Rift is an inspired by classic dungeon games such as Dungeon Master and Eye of the Beholder with grid-based movement.\n\nIt\u2019s an experiential horror challenge game that takes the player through a series of increasingly mysterious locations. Crystal Rift has 26 levels, with unique styles and settings, to provide many hours of gameplay. The player slowly uncovers the narrative and story through exploration, discovering dark secrets and following the path of those who have come before.", "short_description": "A grid-based dungeon-crawler, in classic first person perspective. Crystal Rift is an experiential horror challenge game that takes the player through a series of increasingly mysterious locations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy", "developer_terms_of_service_url": "https://www.psytecgames.com/terms", "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "http://www.crystalrift.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27403958502560118"}, "review_messages": []}]}, "cover_square_image": {"u
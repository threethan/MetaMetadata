id=6e7a0a&_nc_ohc=TbGrYVlRYwsQ7kNvwFBbf5G&_nc_oc=AdoNlnp8SDCQqTvhMeFzASjBjeQ4GoQ9dtYvNdrf6ODnHG9NOWnzI_RCEWaMN2UVLoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37fc2xdK_kerMq07fZwM3Qbn91Pwrs_JMS0hNDqdSklw&oe=69DA3C09"}, {"file_name": "tk01_desert_sh_01.png", "id": "1311927996494010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618351_1311928003160676_2367975399821143973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v89emBgqyHIQ7kNvwFSYZ0e&_nc_oc=AdrCfR1QghObk42BcJA47DIaPKCU-GECkPQis7Vu-AoTp2Q_AMb01NIDxOMTGpBbErY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dqwM-JGFgYNWP91t5NLc6iN5nQNyn-pgIwhMPpQiIHw&oe=69DA4D71"}, {"file_name": "Screenshot_20251107_115540_AA32x.png", "id": "1168157164715859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_1168157168049192_2479882568592864687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7vsyq_OGvUQ7kNvwGxUW89&_nc_oc=AdpibcxBaqw67qcxLoYd80ilcPCYph6paiKf43k5jrw6q0QdVLFhUdwPprWqTDXncsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uYtL0N9LtLaO0W36ot7tljqJ4aEpiShM2MZTXWActcQ&oe=69DA5028"}, {"file_name": "Screenshot_20251107_115631_AA32x.png", "id": "4198240360496176", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303391_4198240363829509_4130224922256050764_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZE7arPATH0Q7kNvwFNcBJ0&_nc_oc=AdrXCOoH-4opFTh9cA5h532WomAw8NJGsR5GHcXtcAxOQey-5hlexBQuQuOsuOUlzt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j7bMbIRwUb8dRc0X0Hc2ATSB-MKk7U8MVKR5PERdomg&oe=69DA53AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RACECLUB", "keywords": [], "long_description": "**RACECLUB**   \nThe most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come.\n{1860485371222005}\n\n **FORMULA V12**   \nTake the wheel of an F1-style racing beast powered by a roaring 12-cylinder engine. Fast, sharp and brutally responsive, it rewards precision and courage with every lap. It's just you, the track, and raw power.\n\n**FORMULA ELECTRIC**   \n Inspired by next-gen Formula E design, it combines lightweight handling, instant electric torque, advanced aerodynamics., regenerative braking and multiple power modes. \n{854625600339899}\n\n**THEMED RACETRACKS**      \nRaceClub\u2019s circuits are designed for pure driving pleasure. From sunlit deserts to snow-capped peaks, each racetracks offer a unique mix of speed, elevation, cornering and challenge.\n\n**HOTLAP+**  \nRace against global ghost cars and chase the best lap times on every track. Watch the leaderboards update in real time, every millisecond counts! \n\n**DUEL**  \nChallenge an increasingly fast AI rival in Duel mode, no collisions, just pure speed and precision. Face twenty levels of rising tension, with every race testing your skill, focus and nerve!\n\n**AI CLIMB RACE**  \nTake a rolling start and battle your way forward against increasingly fast AI rivals in a non-stop climbing race. Cars overtaken disappear, keeping your attention focused on the next rival. Beat them all one by one!\n", "short_description": "The most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixerlab.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixer Lab Games", "support_website_url": null, "website_url": "https://mixerlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274
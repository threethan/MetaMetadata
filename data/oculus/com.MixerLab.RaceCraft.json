&_nc_ss=7f20f&oh=00_AQSCpDwgVDx8DkJWh3f6ESX7uo0iOWm4nTjicBRfY0TN5Q&oe=6AFDCC02"}, {"file_name": "tk01_the_hills_sh_02.png", "id": "852323100780683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_852323104114016_3144099938780230953_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOG8nmwETAMQ7kNvwFYh2AA&_nc_oc=AdqHPSCilMW7kiTAcB_Z-bxIK6RNvEtF3Vw2WOHUV0lvV7SUrtvpOd5NtnLXSOkVMXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLUR8_Gu8AxYG1u559iA7Q6qpHdhgCjamS2wLPZZqe7g&oe=6AFDCFC9"}, {"file_name": "tk01_desert_sh_01.png", "id": "1311927996494010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618351_1311928003160676_2367975399821143973_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJaMu9QuUMUQ7kNvwHzDKYQ&_nc_oc=AdplAmGqkxTBrPtiHL9Ozk6nuefBOky7B3jRjocAYbf0N1W2AnQMIpbMOfYHEeBN4n0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY6w7Xs4zEIepd0FkcIraXRMPOtBY7Bo4mn2W04U5aoA&oe=6AFDE131"}, {"file_name": "Screenshot_20251107_115540_AA32x.png", "id": "1168157164715859", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_1168157168049192_2479882568592864687_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEsCS350iOwQ7kNvwGcbeDg&_nc_oc=Adrm1IgX1t2JbanlvilGi2H_PBxmPmT1HLO9Gg3xZj1wD9vSw4CbP8KEi12rzJiQn1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgrc07a7PPp0DtCnbEol1Gz05H7t4bN8zeORppxBJT7w&oe=6AFDE3E8"}, {"file_name": "Screenshot_20251107_115631_AA32x.png", "id": "4198240360496176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303391_4198240363829509_4130224922256050764_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMX-RfY2OloQ7kNvwGHB6on&_nc_oc=Adpv4x748g634hycJKUJKO9__ot-3AyUFBxp7N2R-mJ7N2tH8kVmLzQp1CUvHmei1wg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUcTSLBxtstxgUyKg6bcBRuJBM0M_FJnz28NWLQsYCUA&oe=6AFDAF2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RACECLUB", "keywords": [], "long_description": "**RACECLUB**   \nThe most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come.\n{1860485371222005}\n\n **FORMULA V12**   \nTake the wheel of an F1-style racing beast powered by a roaring 12-cylinder engine. Fast, sharp and brutally responsive, it rewards precision and courage with every lap. It's just you, the track, and raw power.\n\n**FORMULA ELECTRIC**   \n Inspired by next-gen Formula E design, it combines lightweight handling, instant electric torque, advanced aerodynamics., regenerative braking and multiple power modes. \n{854625600339899}\n\n**THEMED RACETRACKS**      \nRaceClub\u2019s circuits are designed for pure driving pleasure. From sunlit deserts to snow-capped peaks, each racetracks offer a unique mix of speed, elevation, cornering and challenge.\n\n**HOTLAP+**  \nRace against global ghost cars and chase the best lap times on every track. Watch the leaderboards update in real time, every millisecond counts! \n\n**DUEL**  \nChallenge an increasingly fast AI rival in Duel mode, no collisions, just pure speed and precision. Face twenty levels of rising tension, with every race testing your skill, focus and nerve!\n\n**AI CLIMB RACE**  \nTake a rolling start and battle your way forward against increasingly fast AI rivals in a non-stop climbing race. Cars overtaken disappear, keeping your attention focused on the next rival. Beat them all one by one!\n", "short_description": "The most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixerlab.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixer Lab Games", "support_website_url": null, "website_url": "https://mixerlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8300022430122397"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "25539110355731168"}, {"status": "PUBLISHED", "id": "879280248385722"}, {"status": "PUBLISHED", "id": "1926674681563238"}, {"status": "PUBLISHED", "id": "1537995797469458"}, {"status": "PENDING", "id": "4182079265337693"}, {"status": "PENDING", "id": "1413405133724335"}, {"status": "PUBLISHED", "id": "1509823703935305"}, {"status": "PUBLISHED", "id": "890892917282168"}, {"status": "PUBLISHED", "id": "862225293493393"}]}, "baseline_offer": {"id": "862225293493393"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1509823703935305"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26101529619545071", "version": "0.5.18"}, "id": "1389145809063704", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__is
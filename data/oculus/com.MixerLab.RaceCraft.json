ad3-2.oculuscdn.com&oh=00_Af2LByO23vqKHta6fqn5PbcC6Mw5IJnZwMV4Jy4axWg4oQ&oe=69F0A589"}, {"file_name": "tk01_desert_sh_01.png", "id": "1311927996494010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618351_1311928003160676_2367975399821143973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsIS4Zkd6GkQ7kNvwGKoAW5&_nc_oc=Adqf0ucQ2DjYupVe4Etcmt_bmcRuDdVUD0DzcfMwFs-nDdpMfJcln1-L_FZyfJ2407A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af39WjqfZmIRrvxjyhJb57F9lI_QVNcyYd3iY2QPwZqWZg&oe=69F0B6F1"}, {"file_name": "Screenshot_20251107_115540_AA32x.png", "id": "1168157164715859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821081_1168157168049192_2479882568592864687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OzKB8BKETQQ7kNvwFkSHf2&_nc_oc=AdrHKU3-MdETtY4_whQQwoZBrQCMMDGMibjiZlDnzZDx1bpJqmpG343bhvKoYF_T4Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af25kGFFsaUctPeOobfbx4QAOOpWzHFiCIxe8LztC8uYmQ&oe=69F0B9A8"}, {"file_name": "Screenshot_20251107_115631_AA32x.png", "id": "4198240360496176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303391_4198240363829509_4130224922256050764_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqKEpGD1VpoQ7kNvwEvLJX_&_nc_oc=AdqFfMP-GT4bIfPrm_5QTmktAZlzgmFlS_PrcPGbJh1WcG9E93zokOzGHf0c-1_XpdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3_lkH1Wrzg7kXGQt78JULrPysMnxH6kRx4La8HiSTU5A&oe=69F0BD2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RACECLUB", "keywords": [], "long_description": "**RACECLUB**   \nThe most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come.\n{1860485371222005}\n\n **FORMULA V12**   \nTake the wheel of an F1-style racing beast powered by a roaring 12-cylinder engine. Fast, sharp and brutally responsive, it rewards precision and courage with every lap. It's just you, the track, and raw power.\n\n**FORMULA ELECTRIC**   \n Inspired by next-gen Formula E design, it combines lightweight handling, instant electric torque, advanced aerodynamics., regenerative braking and multiple power modes. \n{854625600339899}\n\n**THEMED RACETRACKS**      \nRaceClub\u2019s circuits are designed for pure driving pleasure. From sunlit deserts to snow-capped peaks, each racetracks offer a unique mix of speed, elevation, cornering and challenge.\n\n**HOTLAP+**  \nRace against global ghost cars and chase the best lap times on every track. Watch the leaderboards update in real time, every millisecond counts! \n\n**DUEL**  \nChallenge an increasingly fast AI rival in Duel mode, no collisions, just pure speed and precision. Face twenty levels of rising tension, with every race testing your skill, focus and nerve!\n\n**AI CLIMB RACE**  \nTake a rolling start and battle your way forward against increasingly fast AI rivals in a non-stop climbing race. Cars overtaken disappear, keeping your attention focused on the next rival. Beat them all one by one!\n", "short_description": "The most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixerlab.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixer Lab Games", "support_website_url": null, "website_url": "https://mixerlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "
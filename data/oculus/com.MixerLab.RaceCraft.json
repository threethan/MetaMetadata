t88g9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIllRYT2sFWOmVn-XxFkzr-oib3Ve5ER3GYNRZZdPUDg&oe=69AEBBC1"}, {"file_name": "cockpit view FE copy.png", "id": "1283832096911098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821719_1283832100244431_2739702374591119680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTB2qJqTcE8Q7kNvwHH2f3P&_nc_oc=Adkyv3eUvAqt6Fgmy5hZARVEsRvcN4O6Z5Qw8yfljkgr8q-_WwoXWKVNXQ_BGecClsk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycCtJD2D1wCuohX3aUfZAEOgO_30LBwE4QSG5ZEWVdHQ&oe=69AEC0D1"}, {"file_name": "start les arc v12 2 copy.png", "id": "33610016025308721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_33610016038642053_7921989570909340093_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htr1cBJyblAQ7kNvwERRAW5&_nc_oc=AdlHyzs6VcxCg5u_0mEFZSx_9U9oF5tt1vhQ52ThU2j-_VEgZg9MvDVuYSPDFNiM1a0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXUruD9kzhp9nVrLlsHwcfuGXrKPgBDq8KoC-0AVjVKQ&oe=69AEC072"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "raceclub_cover_01_2560x1440.png", "id": "1360363205295563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_1360363208628896_2884654977249337941_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiuWrM7LX4QQ7kNvwEBP-MS&_nc_oc=Adlae1rysWzw0ejgWDYnoWpzyPTaVsptpprs58irXA4rzPbSJKU2ADkLZY0q-HhwDxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRVj1_x_ZKWOtFSEx1a94l2EZDqo-KGLyPMNf7dXUBvQ&oe=69AEC49F"}, "display_name": "RACECLUB", "keywords": ["race", "f1", "racing", "formula", "cars"], "long_description": "# RACECLUB\nStart your engines and experience the thrill of true-to-life racing, with authentic physics and stunning visuals. **Get ready for the next level of racing!**\n\n\nIt's now in **Early Access**, with Multiplayer and much more to come.\n\n# \ud83c\udfce\ufe0f IMMERSE YOURSELF WITH REAL DRIVING FEEL\nRace in immersive cockpit mode or switch to thumbstick controls and multiple camera views.\n{3841363182827323}\n\n# \ud83d\udd27CUSTOMIZE YOUR CAR\nPick your number, colours, and skin design to match your driving style and dominate the track.\n{754811487274616}\n\n# \ud83c\udfc1THEMED RACETRACKS\nRACECLUB\u2019s circuits are designed for pure driving pleasure, each racetrack offers a unique mix of speed, elevation, cornering, and challenge.\n{2108639103335448}\n\n# \ud83d\udd25FORMULA V12\nTake the wheel of an F1-style racing beast powered by a roaring 12-cylinder engine. **Fast, sharp, and brutally responsive.** It's just you, the track, and raw power.\n{2093717158062983}\n\n# \u26a1FORMULA ELECTRIC\n Inspired by Formula E design, it combines lightweight handling, instant electric torque, advanced aerodynamics, regenerative braking, and multiple power modes. \n{2077570346386775}\n\n# \ud83d\ude80 GAME MODES\n- **HOTLAP:** Race against the global ghost cars and chase the best lap times on every track. \n- **DUEL:** Put your skills to the test against a challenging AI rival in the Duel mode.\n- **RACE:** Battle against 7 AI rivals in a non-stop climbing race. Coming Soon!\n- **MULTIPLAYER:** Coming Soon!\n\n**Join RACECLUB Community:** https://discord.gg/SJPKwujq2x\n\n", "short_description": "Step into RACECLUB and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. "}]}, "developer_name": "Sandbox Games", "developer_privacy_policy_url": "https://raceclubgame.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixer Lab Games", "support_website_url": "https://discord.gg/SJPKwujq2x", "website_url": "https://raceclubgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscripti
c_oc=AdmdXlvtiYYjT_AEPCRjfsbb6DQOQqwQIU9-8jKLusXRAEdkq3IbAiM8Vur6a3mAraY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-bEEGRjkHsdbW5ShqUx8KNaA7RzsnMaayIxTcWWupqQ&oe=69BD3B09"}, {"file_name": "tk01_desert_sh_01.png", "id": "1311927996494010", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618351_1311928003160676_2367975399821143973_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVU0cljup-0Q7kNvwEaUiEP&_nc_oc=AdkKmU8vKN93FIRzpA-jdBeFonRqyuWPTVwxiha6hco53BQAUjpKl-ddyk2DiV20lck&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYKdi0Pj9cxyyXbziyd7edLDRJxzrAyAGAvEbiOZiJnA&oe=69BD4C71"}, {"file_name": "Screenshot_20251107_115540_AA32x.png", "id": "1168157164715859", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821081_1168157168049192_2479882568592864687_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDNZluv1MTEQ7kNvwFunUrX&_nc_oc=AdmWvm8soc0dllYPYTpIvTtLQFM_ia4DKcxWxpedeSh8FQIPUHFeo3YTImOql2M8FqY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHPN_CRzRBSM6ktZk0maXBcWEyFk9ufjxxA2DHsdNqig&oe=69BD4F28"}, {"file_name": "Screenshot_20251107_115631_AA32x.png", "id": "4198240360496176", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303391_4198240363829509_4130224922256050764_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zeb0rEfHoxoQ7kNvwGAEjRg&_nc_oc=AdlLebHXoXO59x1vZkZYfvtIA2KiLW69BR1HBPGXxIK5sGJqT4GPiHoVg2jJSBBti-A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw53aiWYUE1_7-9CAmVgcykJn8AYM3J1ccURNIfM4MdQg&oe=69BD52AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RACECLUB", "keywords": [], "long_description": "**RACECLUB**   \nThe most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come.\n{1860485371222005}\n\n **FORMULA V12**   \nTake the wheel of an F1-style racing beast powered by a roaring 12-cylinder engine. Fast, sharp and brutally responsive, it rewards precision and courage with every lap. It's just you, the track, and raw power.\n\n**FORMULA ELECTRIC**   \n Inspired by next-gen Formula E design, it combines lightweight handling, instant electric torque, advanced aerodynamics., regenerative braking and multiple power modes. \n{854625600339899}\n\n**THEMED RACETRACKS**      \nRaceClub\u2019s circuits are designed for pure driving pleasure. From sunlit deserts to snow-capped peaks, each racetracks offer a unique mix of speed, elevation, cornering and challenge.\n\n**HOTLAP+**  \nRace against global ghost cars and chase the best lap times on every track. Watch the leaderboards update in real time, every millisecond counts! \n\n**DUEL**  \nChallenge an increasingly fast AI rival in Duel mode, no collisions, just pure speed and precision. Face twenty levels of rising tension, with every race testing your skill, focus and nerve!\n\n**AI CLIMB RACE**  \nTake a rolling start and battle your way forward against increasingly fast AI rivals in a non-stop climbing race. Cars overtaken disappear, keeping your attention focused on the next rival. Beat them all one by one!\n", "short_description": "The most realistic driving simulation is here! Step into RaceClub and experience the thrill of true-to-life racing with authentic physics and stunning visuals crafted by an expert team of racing game enthusiasts. It's now in EARLY ACCESS, with Multiplayer and  much more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixerlab.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mixer Lab Games", "support_website_url": null, "website_url": "https://mixerlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
he latest action throughout the season\n\nExperience the adrenaline, intensity, and excitement of Australian Supercross wherever you are. Never miss a race, a rivalry, or a championship-defining moment.\n\nDownload AUSX 360 today and stream every lap, every battle, and every victory live and on demand.", "short_description": "The home of AUSX Supercross. Stream live. Watch anywhere.s"}]}, "developer_name": "SportsAI", "developer_privacy_policy_url": "https://www.sportsai.au/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "SportsAI", "support_website_url": null, "website_url": "https://www.sportsai.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1135163862196619"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1077548744926646"}]}, "baseline_offer": {"id": "1077548744926646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790309520, "status": "PUBLISHED", "id": "1077548744926646"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1141359068243765", "version": "1.0.0"}, "id": "2914072828927494", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applica
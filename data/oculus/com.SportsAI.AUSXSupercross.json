WhD-Y23bvQFTTuS2LItxp0pbtiTDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyndnjfVb3HmZHBmxh23g6SnbgYaBidECc32_EoMm-ng&oe=6ABFC314"}, {"file_name": "Untitled-5.png", "id": "913854031799622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593832569_913854035132955_3481840559423470750_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-LMplHycuEQ7kNvwFaFKpR&_nc_oc=Ado7DrOgDPD5GCpZafmAOPLc6DfAHSv7zdwKl05puxuDL_onJa05nqXeHeIi02lLD1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUMKM6fqcbxbn8Dai3HZGpQ3DJ7ROoIBD0U5sSNSLG_A&oe=6ABFCB58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AUSX 360", "keywords": ["Sports", "Motorcross", "Streaming"], "long_description": "Get closer to the action than ever before with the official AUSX Supercross streaming service.\n\nWatch Australia's premier Supercross championship live and on demand, featuring the nation's fastest riders battling it out across spectacular stadium and arena events. From gate drops and qualifying sessions to main events, podium celebrations, and exclusive behind-the-scenes content, this is your ultimate destination for AUSX Supercross.\n\nWhether you're a lifelong fan or new to the sport, the AUSX Supercross app puts every moment of the championship at your fingertips. Stream live events in high quality, catch up on full race replays, relive the biggest moments with highlights, and stay connected throughout the season with exclusive coverage only available to subscribers.\n\nFeatures\n\n\u2022 Live streaming of AUSX Supercross championship events\n \u2022 Full race replays available on demand\n \u2022 Highlights, interviews, and exclusive feature content\n \u2022 Behind-the-scenes access to riders, teams, and events\n \u2022 Watch on your mobile, tablet, or compatible streaming devices\n \u2022 Easy-to-use interface with fast access to live and upcoming events\n \u2022 Stay up to date with the latest action throughout the season\n\nExperience the adrenaline, intensity, and excitement of Australian Supercross wherever you are. Never miss a race, a rivalry, or a championship-defining moment.\n\nDownload AUSX 360 today and stream every lap, every battle, and every victory live and on demand.", "short_description": "The home of AUSX Supercross. Stream live. Watch anywhere.s"}]}, "developer_name": "SportsAI", "developer_privacy_policy_url": "https://www.sportsai.au/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "SportsAI", "support_website_url": null, "website_url": "https://www.sportsai.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1135163862196619"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_927064333793212_2798828244130225719_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoL__vpj_ecQ7kNvwEBQ-8n&_nc_oc=AdrGg3WqXB-XDa92eErB8cqsmhCnZw0CaOQgglK2-1bNBLtRgd00VOUjy10tUmvOodc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-PnE-B2hgxzfv-XZ-sJT33krFUI7Px6bssAy6J28ltw&oe=6ABFCE96"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AUSX 360", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961
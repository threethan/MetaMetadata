c_sid=6e7a0a&_nc_ohc=rbY-LrMlvbcQ7kNvwE1zRXA&_nc_oc=Ado5hZfCzR_8oSKmb0G14irDj95ZKyJocPXUIAjDwnMDbjBp9tkl1MG2kdKr9vUtm-U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VJH87UySxcmcY294AgS8FOhtXDQFL1nHbQRzHjDNXAg&oe=6A26DFE3"}, {"file_name": "Screenshot_4.png", "id": "963696866229247", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499295272_963696869562580_4935856149549263810_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEV-Kn9yEdkQ7kNvwGt5hVU&_nc_oc=AdohJxm4ocbQxMdrHqOvZSg7hRPpf77X3_8LvxGa-rsYDAumkJ2NV9RUd-e__MW0aCQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uxUxcQhI4jSmG0XfEc3GBFaNOZplyMYlTm2IkkdiYgA&oe=6A26EBAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Whackemo_cover_art_landscape_2560_x_1440.png", "id": "968839905613610", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304131_968839908946943_8082694832623963178_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7ZJ43Ghgc4Q7kNvwGEQBeV&_nc_oc=AdpCYyz_FgtdaVwii700lS7P_tdXYB5O0UV4aLiRnWqtZ6PotV_trArVNfPsxkYBqMw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rQaakK2dY2FpFdqUh3sHnWzaG_MR1tmbkkaL6mS5-Xg&oe=6A26D2EC"}, "display_name": "Whackemo", "keywords": [], "long_description": "Welcome to Whackemo \u2014 where the mallet is your weapon, the arena is your playground, and absolutely nothing is off limits.\n\nSpawn up top, grab your weapon, check the leaderboard, customize your look in the mirror, browse instances \u2014 then jump through the opening and drop into the arena below. You land armed, DANGEROUS, and ready.\n\nBonk opponents on the head to shrink them \u2014 and watch yourself grow with every hit. Every connection lands with weapon-specific audio, haptic feedback, and cartoon cotton stuffing EXPLODING into the air for everyone to see. Nobody misses a bonk.\n\nShrink a player all the way down and score 10 points \u2014 they're Out, back up top, and dropping right back in. No waiting. No downtime. Just drop in, ready to go.\n\nSpeed rings send you flying. Trees bounce you back and drop loot when you hit them. Towers dare you to climb them. And somewhere overhead a UFO circles unpredictably \u2014 dropping loot crates with boosts that let you FLY, SPRINT, or DOUBLE JUMP for a precious few seconds.\n\nAnd keep your eyes open for the ELUSIVE ACORN. Rare. Valuable. Hiding in the trees and crates. Find it and it's yours \u2014 real in-game currency dropping right into the chaos.\n\nUnlock animals, weapons, headwear, and footwear. Mix and match. Build a look that is entirely yours. NEW CONTENT DROPPING IN REGULAR UPDATES.\n\n16 players per instance. Leaderboard. Block and unblock up top. Smooth, stable, and built for PURE CHAOS.\n\nWHACKEMO. LET THE MALLET MAYHEM BEGIN!", "short_description": "Grab your mallet and drop into the chaos. Whackemo is pure, unhinged, mallet mayhem multiplayer VR. Let the Mallet Mayhem Begin."}]}, "developer_name": "Mirarami", "developer_privacy_policy_url": "https://miraramigames.wixsite.com/mirarami/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mirarami", "support_website_url": null, "website_url": "https://mirarami.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26357975690498021"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
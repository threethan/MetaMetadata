max", "Revit"], "long_description": "Overstruct Viewer App\n\nYou can view both your and featured Overstruct files with this application.\n\nOverstruct is a PC software for you to create architectural virtual reality (and website) walkthroughs automatically and easily over a shorter period. With Overstruct, 3ds Max users can generate architectural virtual reality or web walkthroughs, with a minimum configuration over their already existing project files, via our plugin.\n\nWe have developed a brand new method and software framework that have several advantages over these current methods. It's cheaper, faster to develop and supports mobile.\n\nCheck it now, on http://overstruct.com", "short_description": "Overstruct Viewer App\n\nYou can view both your and featured Overstruct files with this application.\n\nOverstruct is a PC software for you to create architectural virtual reality walkthroughs automatically and easily, from your existing 3d project files."}]}, "developer_name": "Overstruct", "developer_privacy_policy_url": "http://overstruct.com/viewer_privacy_policy.html", "developer_terms_of_service_url": "http://overstruct.com/viewer_terms.html", "publisher_name": "Overstruct", "support_website_url": null, "website_url": "http://overstruct.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "343828637430936"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculu
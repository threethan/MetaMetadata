5/12139031_409099769528546_8769329822561206272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSCjx0XLu-kQ7kNvwH_v5l9&_nc_oc=Adq0UDx3Hs93GHr0NK1CRjSTvG-59IKHMe6-f4mzP6KlujBVb8zTsgAlewexL98zZNs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4p5T8FaeOjKp7rWjUsfiouXjzWDMynKW9RhTkesdpDw&oe=6A8D706A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumb.png", "id": "1674431269312786", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12386220_1674431272646119_1325694591382323200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB3sHDHgIz8Q7kNvwHUW0JC&_nc_oc=AdqrSE4ZRKoT4CI44b0BcFkSCQOK9l9h1C1gQqZqDol-YqXBcQ0XyQ-FaANqp2FBnO0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5NcpS-Q2Czx82MEI8UDG-YAGyn9_xxoNX1yAjzNhesA&oe=6A8D7051"}, "display_name": "Overstruct", "keywords": ["architect", "Photorealistic", "Vray", "3dsmax", "Revit"], "long_description": "Overstruct Viewer App\n\nYou can view both your and featured Overstruct files with this application.\n\nOverstruct is a PC software for you to create architectural virtual reality (and website) walkthroughs automatically and easily over a shorter period. With Overstruct, 3ds Max users can generate architectural virtual reality or web walkthroughs, with a minimum configuration over their already existing project files, via our plugin.\n\nWe have developed a brand new method and software framework that have several advantages over these current methods. It's cheaper, faster to develop and supports mobile.\n\nCheck it now, on http://overstruct.com", "short_description": "Overstruct Viewer App\n\nYou can view both your and featured Overstruct files with this application.\n\nOverstruct is a PC software for you to create architectural virtual reality walkthroughs automatically and easily, from your existing 3d project files."}]}, "developer_name": "Overstruct", "developer_privacy_policy_url": "http://overstruct.com/viewer_privacy_policy.html", "develope
t files, via our plugin.\n\nWe have developed a brand new method and software framework that have several advantages over these current methods. It's cheaper, faster to develop and supports mobile.\n\nCheck it now, on http://overstruct.com", "short_description": "Overstruct Viewer App\n\nYou can view both your and featured Overstruct files with this application.\n\nOverstruct is a PC software for you to create architectural virtual reality walkthroughs automatically and easily, from your existing 3d project files."}]}, "developer_name": "Overstruct", "developer_privacy_policy_url": "http://overstruct.com/viewer_privacy_policy.html", "developer_terms_of_service_url": "http://overstruct.com/viewer_terms.html", "publisher_name": "Overstruct", "support_website_url": null, "website_url": "http://overstruct.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["UTILITY", "PRODUCTIVITY", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1352239895248234"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1986205188162492", "version": "1.3"}, "id": "2000048256884432", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1579937682122580
B78xKiifsaDKdkSXBPCTIvk5aO9TQ&oe=69EF6A0D"}, {"file_name": "shot05.png", "id": "575217544293288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86624162_575217550959954_3810451879936696685_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkgoKBxT05YQ7kNvwHMR5gE&_nc_oc=AdpQVSzE77q55GoEfhiL5Jivulu3lxwWLvbfu3okl60FWFht0gwcv6CHbGZc_Bmo06w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JmlC3kT1j1C7r8rO88VdFtKURp04zU1v10E8BrLSMag&oe=69EF5E44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot01.png", "id": "799705071173958", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974677_799705074507291_2198562808322171786_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4INhJiPHfgQ7kNvwGuZWqI&_nc_oc=AdrPDLACbt5VpBSBixlAR3ial_MyTXp2-apieY22km8gNf7bDBBUjRvfNmpD1LB3eUs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zhf7ebdthD_ivi8HPYLaHam4DOkVFR-OGLMvsmZwmNg&oe=69EF5C6A"}, "display_name": "Castle Capture", "keywords": [], "long_description": "Will you join Mighty Crusaders or Legendary Jannisary. Whichever side you choose, there will be a challenge waiting for you. \nCastle Capture is also available for Rift.\nThe Crusaders, the ironfist of the western civilizations summoned against common foes in order to secure control of holy sites considered sacred. Crusades successfully extended the reach of Western civilization, brought wealth, heightened interest in learning and paved the way for the Renaissance. Many Europeans joined crusades to be forgiven for past sins, to get land overseas, to see the world, or to have an adventure and prove their bravery.\nThe Ottomans, a Turkish Tribe established in 1299, quickly grew into a large empire. With is highly disciplined and fearless infantry along with well-educated and intelligent officers, they became fearsome among the rivals of their time. The lastest encounter between the Crusaders and Ottomans took place in 1699.", "short_description": "Action-Packed Medieval Archery. \nCastle Capture is also available for Rift.\nChoose from 2 Sides \"Crusaders and Ottomans\""}]}, "developer_name": null, "developer_privacy_policy_url": "http://moonstargames.com/privacy-castle-capture.html", "developer_terms_of_service_url": null, "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "http://www.castlecapture.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "307449721357782"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1495821788844919"}, {"status": "PUBLISHED", "id": "2061110844795746"}, {"status": "PUBLISHED", "id": "1040658581588399"}, {"status": "PUBLISHED", "id": "9994604813929791"}, {"status": "PUBLISHED", "id": "1299661794097335"}, {"status": "PUBLISHED", "id": "592520075974726"}, {"status": "PUBLISHED", "id": "667828058412298"}, {"status": "PUBLISHED", "id": "1527745270971575"}, {"status": "PUBLISHED", "id": "2858030064359707"}, {"status": "PENDING", "id": "1243770812855466"}]}, "baseline_offer": {"id": "1299661794097335"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777057200, "status": "PUBLISHED", "id": "1495821788844919"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8263360980400828",
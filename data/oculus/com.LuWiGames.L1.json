 "946834181837423", "image_type": "APP_IMG_ICON_FOREGROUND_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_946834185170756_6155186583621448829_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7zCYn_0CkAQ7kNvwGTcarU&_nc_oc=AdocyqQyZidTL5FWa8MAKxK1It13Hrov-zDh3W8nKiXtOPVSNaPeh0wd6EIaZGs_lHI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhWbdyKtA4sdNx38MKkwtGKcmrlYQOJKJWYbBOVAeLCw&oe=6AFC6348"}]}, "id": "1647707286382142", "locale": "en_US", "screenshots": [{"file_name": "Cascadia.png", "id": "1658774342471033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1658774345804366_2990047674352994980_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RozmKz0-6OIQ7kNvwHWnHPS&_nc_oc=Adq_fIhgCaEeCOkL3b-xzgwrg7Z5DKHKqN1XqN5AlIekPIfYEveNYJWfYBAcLd1DE4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSuKSAwTVFgVWB1kQ9mUQIzh2k-2skUec1uGogTKJr1A&oe=6AFC7038"}, {"file_name": "Vicus.png", "id": "2179288889666765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_2179288893000098_5488073946684402961_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=u8msdj8ZkuAQ7kNvwFWa4e_&_nc_oc=AdpMp_djZz5SchI_P6eAW64V5TY2xezWdU2iOpkkgSLCVN4IIH6K5kW8oJLkAB4FbeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdGBMmreFzXPd3TSfIkxWToz8Rh9q3RknkEJCYxKs0uA&oe=6AFC83CD"}, {"file_name": "Shop.png", "id": "1568127497922318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_1568127501255651_597466820259528917_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC48dN_eLlwQ7kNvwEb2oOo&_nc_oc=Adrs9ifRSmlO_P3n4o4jF_gmstO1IXV_2i_hFcaOwVNySNSNjB4P4HOi8d1AygfKDgQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxj6rzoXMPGm48dr_pAdknWSAa1Fn8V9dIi6IGnq-nVQ&oe=6AFC71D9"}, {"file_name": "Rooftops.png", "id": "1398988462400264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1398988472400263_4021276575775683011_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVkuVQf2e-kQ7kNvwEw03cF&_nc_oc=AdpuWQktPXY2vzz3FqwQx4c5gKra-1rRm53g1Y7VpyydBU4WWYEqE3Ae2yfO4V-7498&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO48Y3WD0dFqFJaMMDoaHOGSgwG3RYH8RLWQTZAvNvHQ&oe=6AFC65A0"}, {"file_name": "ForestCamp.png", "id": "1775968413668229", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_1775968417001562_8986960545962424176_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qczCC3IZrDAQ7kNvwH_ZPPM&_nc_oc=Adr4z_eOJ4PIM2fi5dBsmcGWP3ssklFEZNpKaZyA-urYYu_lqfpOmpZCujeoZdzEzMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNvEot1qvjl5HUDqbm8iFbhu_H7ubnQueItFgUpY-poQ&oe=6AFC5D3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Legion 1", "keywords": ["Battle", "Gorilla", "Monkey", "Shooter", "Arcade"], "long_description": "Legion 1 is a multiplayer VR shooter for people who want to use their hands. Every weapon is held, reloaded and fired by you. Every gadget is thrown, planted or slammed down. And the buildings you are fighting in do not stay standing.\n\nThree modes run around the clock. Team Deathmatch, Free For All, and Platform, across arenas built to be broken: the rooftops, the forest camp, the old town, the water park. Walls come apart under fire, cover stops being cover, and the map you learned in round one is not the map you finish in.\n\nEverything you do pays. Kills, damage, assists, matches and time on the field all feed one level, carrying you from Recruit to Legend. Every weapon levels separately, so the gun you actually use gets better looking the more you carry it. Spend what you earn on cosmetics, and put your own stickers on your guns.\n\nBring people with you. Parties of up to five move between rooms together. Clans give you a tag next to your name and a feed of what your people are doing. Voice chat is built in, and you can mute or block anyone at any time.\n\nOutside the headset, legion1.live is the other half of the game. Watch any live match from a browser, follow a player and get told when they come online, leave a comment on their profile, and check where you sit on the rolling thirty day kill board. Nothing on that board ever hard resets, it simply stops counting what you did a month ago, so it is always winnable.\n\nThere is a daily bonus at the lobby board, daily and week", "short_description": "A fast, physical VR arena shooter. Hold, reload and fire every weapon yourself, bring the buildings down around you, and climb a kill board that never fully resets."}]}, "developer_name": "LuWiGames", "developer_privacy_policy_url": "https://legion1.live/privacy", "developer_terms_of_service_url": null, "publisher_name": "LuWiGames", "support_website_url": "https://luwigames.com/", "website_url": "https://luwigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER"], "id": "26286628214298238"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4011123722524535"}]}, "baseline_offer": {"id": "4011123722524535"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791485400, "status":
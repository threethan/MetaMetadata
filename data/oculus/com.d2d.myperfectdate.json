i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297507_797497283451094_4167494620815379368_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NozVbZpTujgQ7kNvwGF7jPG&_nc_oc=AdphCu2m4URXwBGwEs2rV1dew-7Y8xDJz-HpHFMR1skQVJ4BLunpEcffrdjVECrfj8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHhdGPmdABTIH41nTLjuVa9SidRl7dyK0vKe3jGzIyOw&oe=6A95E045"}, "display_name": "My Perfect Date", "keywords": ["simulator", "date", "dating", "casual"], "long_description": "Welcome to **My Perfect Date**, the chaotic dating simulator where you decide whether your night ends in glory\u2026 or disaster.\n\nTake your date out for sushi, pizza, or even a hand-grilled steak served with a bit (or a lot) of Tabasco for extra spice. Have fun mixing exotic drinks, but be careful with your choices: nobody wants fart spray in their drink... do they?\n\n**Food, Drinks & Fun**\n\nFrom testing your chopstick skills to whipping up the perfect drink, every choice pumps up (or tanks) your score. Get it right and you\u2019ll look like a pro. Slip up, and watch your date\u2019s patience wear thin.\n\n**Gifts & Gadgets**\n\nImpress her with hats, glasses, and bracelets\u2026 or mess around with wilder options like the water gun or the electric bracelet. Be careful though\u2014push it too far and your \u201cperfect date\u201d might walk out.\n\n**Score Big**\n\nYour goal: turn an ordinary date into an unforgettable day. Make the right calls, keep her entertained, and spend some quality time together with your date.\n\nEvery choice raises or wrecks your score. Can you pull off the perfect date?", "short_description": "Step into My Perfect Date, the chaotic dating sim where you decide whether your date ends in glory\u2026 or disaster. Cook steak with a torch, pile whipped cream on dessert, or mix cocktails to show off (or disgust) your date. Impress her with gifts\u2014or test her patience with a water gun, spray fart, or even an electric bracelet. Every choice raises or wrecks your score. Can you pull off the perfect date?"}]}, "developer_name": "D2D Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/myperfectdate/", "developer_terms_of_service_url": "https://hypervr.games/eula/", "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9463578553766647"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1681210053178865"}, {"status": "PUBLISHED", "id": "1627464805191338"}, {"status": "PUBLISHED", "id": "2068370627067476"}, {"status": "CANCELLED", "id": "896744266472728"}, {"status": "PUBLISHED", "id": "1372438244455221"}, {"status": "PUBLISHED", "id": "2417315628664801"}]}, "baseline_offer": {"id": "2417315628664801"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1681210053178865"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24301867589511166", "version": "1.0.1.17"}, "id": "653715771142547", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9
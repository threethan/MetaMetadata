0x1440.png", "id": "26282134538046890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_26282134571380220_5630448050572220867_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agFTJC9nCRIQ7kNvwE1K_qq&_nc_oc=AdpQ6boxqW2-v8oiM3EvD7nztUQygo3GgIYh4r7WNdHznLREojgcJ7TFORqEhhQ4c3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8MbscWNL0kf5DDwKi9tguSMI0Rhj3X_tOIIWGUDBBdg&oe=6A95D807"}, {"file_name": "3_[MPD]_2560x1440.png", "id": "2096178467843001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821674_2096178471176334_420980515923421077_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwq5d6yw378Q7kNvwFNXvxz&_nc_oc=AdokJrIersa2yms95N2gc7yxTsGQ8vfrJ28lOIv7ocH9k4kJT-6aCAIXm5Eb8qhJCIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3VMkfNSpFjB6eARJxFRdp0IxURjm0YIL4iIHADF9_Dw&oe=6A95BC96"}, {"file_name": "4_[MPD]_2560x1440.png", "id": "785509741261607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_785509747928273_4869692986524820225_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YW-gk6xNX3cQ7kNvwGylEYi&_nc_oc=AdrM4CwY2H0n4ASc6c6mn527PQVgcFZ9s-oo9ClipQdrU8Ii0BehyqgAIo5a4dt6TGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXFdqGLmJTeU2rs0-LJN00G7wRHH45H8THsclt-I3-Rg&oe=6A95D291"}, {"file_name": "5_[MPD]_2560x1440.png", "id": "1304343628421592", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_1304343635088258_301216160350063381_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6lC6IxZhMIQ7kNvwFRIcQZ&_nc_oc=AdoaPx3zQ4X629lzHSa_jQYCkbXCwjcySUitJUY4MkhKF_K-QhGMSJPexebx7Vq2L3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQJ5utSioLD0eiPN9hbO6d_vqy-z6rbe9qJm9fFm0ZTQ&oe=6A95C63D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MPD_Landscape_2560x1440 (2).png", "id": "1732609991049211", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823270_1732609994382544_6506203993817088078_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bSzrCeBamoQ7kNvwEintfh&_nc_oc=AdoLkPnKJXdwzCwaG81Hmhgw8o7-QiSbT13XGXoDjZoi9jFKQ4UbQzsv-YfEdfDfL7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdMZTLZxT9unHiMU8Ujw8GgqLhhdpT1JYtPDf8Jl8gMw&oe=6A95BD4E"}, "display_name": "My Perfect Date", "keywords": ["simulator", "date", "dating", "casual"], "long_description": "This is not a calm dinner simulator. This is a romantic disaster sandbox.\n\nStep into a VR dating experience where every interaction can turn awkward, chaotic, or completely unhinged. Flirt, provoke, impress, or sabotage the moment. Nothing is scripted, and everything reacts.\n\n# \ud83c\udfad Unpredictable Personalities\n\n{26846580841598448}\n\nMeet dates that don\u2019t behave:\n\n\ud83d\udc7d An alien who manipulates gravity\n\n\ud83d\udcf1 A streamer filming you non-stop\n\n\ud83c\udf54 A messy foodie who throws snacks\n\n\ud83d\udd76\ufe0f A suspicious spy with hidden motives\n\n\u26a1 A chaotic wildcard who fights back\n\n\nThey don\u2019t just talk. They react physically.\n\n# \ud83c\udf2d Use Items to Make the Date Unforgettable\n\n{4274552569465200}\n\nPick the right items\u2026 or the wrong ones.\n\nFood, drinks, gadgets, and ridiculous tools can instantly change the mood of the date.\n\nOffer something romantic.\n\nOffer something weird.\n\nOffer something you probably shouldn\u2019t.\n\n\nEvery object can escalate the situation and create totally new reactions.\n\n# \ud83d\udee0\ufe0f Full Physics Sandbox\n\n{1569007920978631}\n\nGrab objects. Spill drinks. Steal phones. Trigger chaos.\n\nAlmost everything around you is interactive and physics-driven.\n\nRomantic dinner\u2026 or total meltdown?\n\nYour choice.\n\n# \ud83c\udf81 Random Surprise Carts\n\n{1213196037565562}\n\nOpen carts to unlock unpredictable tools. You never know what will appear next.\n\nHow would you handle the perfect date?", "short_description": "Step into an immersive simulation where romance meets pure chaos. From dreamy dinners to total disasters - every decision shapes your perfect (or perfectly awkward) date. Show your mood and style. Be romantic, be wild, be absurd. The sandbox is yours to play with. Flowers? Taser bracelet? Your call.\n\nRead the mood. React fast. Complete goals. Each choice affects your date\u2019s mood and the outcome of your Date experience.\nSow how would you run your Perfect Date?"}]}, "developer_name": "D2D Games", "developer_privacy_policy_url": "https://hypervr.games/privacy/myperfectdate/", "developer_terms_of_service_url": "https://hypervr.games/eula/", "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24284048144626444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_1949626526432219_1776715158094962543_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aPLapV0xeEQ7kNvwGnd76r&_nc_oc=AdoCQbemsuuCnJ4xPuUda1LM_uODimugiDA8lqA4SYSfWJ8XZ3fQPVJQwGsJx3PNJf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHij0GiCQW2CNlWohA2hnUElJxNb2cxw2rtVr_EoXq8sA&oe=6A95B702"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "My Perfect Date", "platfor
_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fx15OOUJ1oQ7kNvwF8hzoQ&_nc_oc=Adpx31mEd3nxlcwLWRfCb9jRKWwRjeh6WbjaW9SHY1y3xeXrB5rVs3Jpl8qg9TUkW14&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTarhHDbJMGLOl5UUw3sQGeZt9EK31wDxFygOpDp8_ig&oe=6AA40174"}, {"file_name": "75210891_5441969079214514_5020506565144759968_n.png", "id": "1115576252886566", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86627649_1115576256219899_2284973846805312015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UihwDPsejZwQ7kNvwGcAUQt&_nc_oc=AdqXlEFH7M1vCQJMmPiN7Zypj83jGn7qo-QAEEmxRyMOdTKFthxFGT-u2d28kdBXk8Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHIedBl4X1jLSST-lzF5QJaogbZS33N8k8Tl1lr-ngeA&oe=6AA4102A"}, {"file_name": "75462965_601876351583554_5297430548521710064_n.png", "id": "806686838073768", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569432_806686841407101_7724895919713055786_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBVC3v0xnPwQ7kNvwHwjAXw&_nc_oc=AdqW0ejPrp8tTA29BsGsx3WdzpA3TikOzpR3ILX564PR1YUoJebM2EnNCVIrQEV6yiI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzpIwN1LRQE1a89i4akwik8F2i5F7F6UtnkMmWj7qVTA&oe=6AA3FAB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRelax - Quest 3", "keywords": [], "long_description": "Many people suffer from stress, such as burn-out, depression or anxiety. This results in a lot of personal suffering and high medical costs (CBS, 2019).Reducing stress and learning to relax is an important pillar of good mental health. But that is easier said than done. That\u2019s why VRelax was created because we have experienced that Virtual Reality has a very fast and strong effect on body and mind.", "short_description": "VRelax is a virtual reality app that helps people to reduce their stress level and improve their mood. Scientific research has shown that VRelax is effective. It is a relaxation tool to reduce stress, burnout, 
YBEDXEpjAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvF6KOWnQB-JdpaTyTUWCo5E4SRjTjAjej9DihoVjdQuA&oe=699C5574"}, {"file_name": "75210891_5441969079214514_5020506565144759968_n.png", "id": "1115576252886566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86627649_1115576256219899_2284973846805312015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4ljjIh4g8sQ7kNvwFxZzhd&_nc_oc=AdnQ8r_sVlu79WMk3aY9jbIemeXPusVx6EbwHvj-6BTM0KhI1ajVYahqSkmwJ_cZYV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afse818mJ2kOvvAG1G0H67R9KhMbw0SIjhouIPhVBj0AQg&oe=699C642A"}, {"file_name": "75462965_601876351583554_5297430548521710064_n.png", "id": "806686838073768", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_806686841407101_7724895919713055786_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp9o8nJOSREQ7kNvwGS8mex&_nc_oc=AdnMOyrDXbuO2FGMtpyTdHTc3X4atWvLfLKwPeQmZAr2RZhEF8jMAjFateUp3QB5KEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfveGP3T5sCLaCWnoAMgxDkTNjdxS4cmmopdMUSX_Z_Pgg&oe=699C4EB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRelax - Quest 3", "keywords": [], "long_description": "Many people suffer from stress, such as burn-out, depression or anxiety. This results in a lot of personal suffering and high medical costs (CBS, 2019).Reducing stress and learning to relax is an important pillar of good mental health. But that is easier said than done. That\u2019s why VRelax was created because we have experienced that Virtual Reality has a very fast and strong effect on body and mind.", "short_description": "VRelax is a virtual reality app that helps people to reduce their stress level and improve their mood. Scientific research has shown that VRelax is effective. It is a relaxation tool to reduce stress, burnout, anxiety and depression. VRelax can also be used as a distraction tool for pain management, physical discomfort and medical procedures. From mild stress to severe health complications, VRelax can provide relief at any time and place for any kind of stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrelax.com/en/privacy-statement/", "developer_terms_of_service_url": "https://vrelax.com/wp-content/uploads/2022/06/VRelax_Algemene-Voorwaarden_NL-C00421-1679622868-61-002_ver.-WeFact.pdf", "publisher_name": "VRelax B.V.", "support_website_url": "https://vrelax.com/en/support", "website_url": "https://vrelax.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7811059505609195"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1192180082907043"}, {"status": "PUBLISHED", "id": "1016878043103727"}]}, "baseline_offer": {"id": "1016878043103727"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1192180082907043"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25862951103326759", "version": "5.0.0"}, "id": "494317693471141", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7811059492275863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25862951103326759"}, "release_status"
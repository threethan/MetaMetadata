_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAcHXP2X-cAQ7kNvwHA26K4&_nc_oc=AdrfN7hDhFZYkZSza5WHzJxgRYUfd7PMA7k15RFvt7tkx7NSJiCV9duW64VeK1NcE1Y&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sT1pcCOZg_2qllkbTdDjWQ_6bkZVra8A-iQ3FQVXjlw&oe=6A22CE74"}, {"file_name": "75210891_5441969079214514_5020506565144759968_n.png", "id": "1115576252886566", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86627649_1115576256219899_2284973846805312015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezbTS2Jha20Q7kNvwFrtb-b&_nc_oc=Ado0M85G2TV-t21XAAVvySXgtcSdU-qfKtqS-vYTp_iNJlrFzIkOKSnWD_b7oY6H0mc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tqIWxptWXvZc3S0PRVQ2S-QyGLV_mKGR1miBVz1tiJw&oe=6A22DD2A"}, {"file_name": "75462965_601876351583554_5297430548521710064_n.png", "id": "806686838073768", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569432_806686841407101_7724895919713055786_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRMDmGqD_F8Q7kNvwGQTEQT&_nc_oc=AdovlvQo-84V-tMb-0LdCTod06MdVFtK5en4gCRIHCRrCBhj5WoffpcrRWa75IbnH1k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8unCTQF1an_OdM_etzRiLZeghhoGIpHeryUDRfRG8oUg&oe=6A22FFF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRelax - Quest 3", "keywords": [], "long_description": "Many people suffer from stress, such as burn-out, depression or anxiety. This results in a lot of personal suffering and high medical costs (CBS, 2019).Reducing stress and learning to relax is an important pillar of good mental health. But that is easier said than done. That\u2019s why VRelax was created because we have experienced that Virtual Reality has a very fast and strong effect on body and mind.", "short_description": "VRelax is a virtual reality app that helps people to reduce their stress level and improve their mood. Scientific research has shown that VRelax is effective. It is a relaxation tool to reduce stress, burnout, 
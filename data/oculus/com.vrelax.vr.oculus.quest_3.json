_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8tX4dkcJ-AQ7kNvwGojjFb&_nc_oc=AdoKmAJeuj4OFZXEpwXekBsktfm2S9IOizUd4u-c5NirLuygDI7dQ53ulihcE1hWIi0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc8fSK66UD-tQmtfgBKWq9-cx-2pCd6M9vqMkycn37Ig&oe=6A7DC5F4"}, {"file_name": "75210891_5441969079214514_5020506565144759968_n.png", "id": "1115576252886566", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86627649_1115576256219899_2284973846805312015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf1Brid43_sQ7kNvwGOZbJj&_nc_oc=AdrWoEn3LWxNXBcmBVmxsUTpC6bsgsFdQYq4Y9NkOejzkbyEx4wajJvzrlxac_oPx6Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUvm7R6mvh4hJNW3QdgHLUZ9t_G79z2E6R8SqwletLjw&oe=6A7D9C6A"}, {"file_name": "75462965_601876351583554_5297430548521710064_n.png", "id": "806686838073768", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569432_806686841407101_7724895919713055786_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7cE-L_xv5wQ7kNvwEJ5CN_&_nc_oc=AdqqGO97jHu3vyIl4IeKPKziQ4jf31Qgd4-EVDsdbbvPNzcUqeH9SeCAcNNynnL1Suc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2vJ5qMkg1zWWm3QwJ3zqeOkBSlDSWErqsrPywfiZANA&oe=6A7DBF37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRelax - Quest 3", "keywords": [], "long_description": "Many people suffer from stress, such as burn-out, depression or anxiety. This results in a lot of personal suffering and high medical costs (CBS, 2019).Reducing stress and learning to relax is an important pillar of good mental health. But that is easier said than done. That\u2019s why VRelax was created because we have experienced that Virtual Reality has a very fast and strong effect on body and mind.", "short_description": "VRelax is a virtual reality app that helps people to reduce their stress level and improve their mood. Scientific research has shown that VRelax is effective. It is a relaxation tool to reduce stress, burnout, 
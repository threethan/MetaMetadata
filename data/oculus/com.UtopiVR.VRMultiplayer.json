3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzFOu-y8T2EQ7kNvwG6cTxB&_nc_oc=Adp6pcWnMkEeBev6GvXNVZnJxZ7_irJrJYRD8VFRoCLf2X9_xZSrEi0K_emTULv9ofQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA79w8oAIW9Gm873ysLOP-JNFQrzg8Q-9XLhAeAuCySrg&oe=6A5E290E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oS5yEoUlfVoQ7kNvwEFNylI&_nc_oc=Adpkmshtw7NV1Ruv5H-5lJsg7VGxiatO4cnnTxcKqLcpI_iyuO9QMKMng-1pgHu4I3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1OBpnkzvYXkHTsyqsPqYaTVJ92Gwuli6TFu8oFeiNUA&oe=6A5E3919"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5vrj_zfEVAQ7kNvwHEhUKR&_nc_oc=AdoTMjguP_t4xWSjH4kWcXiY71Fzpo2Y39dI9iVJIy1UZXhRiI_ccHl4veQIVSTLitA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsT_KkAKllquJAbCl8H5IBHh41Vq5G6bMHSr49U4NvyA&oe=6A5E188C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
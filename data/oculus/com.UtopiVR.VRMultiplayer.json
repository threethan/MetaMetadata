3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MueQQySR_qIQ7kNvwHWSPED&_nc_oc=Adrpv-3eocDE4rpDOFL34hZVkdBMbXBqGbOKW7n5lSv_JLscktIBEwzAMxm_w_0TcpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSMNlG4_BY8k-xeFy_cnLWhx8RF1VqPM8WhGifWVRbEA&oe=6ABE668E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caXVoJ2fHHQQ7kNvwEPG6KO&_nc_oc=Adqpe5ne0h8ksX3IVm2G_ToqsZJOrM3FWq9ScfrC9KR4czoUWvV3TQ3FOI7DmGRLCa4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBdcT2iA4BwcDk67qmgiaXJTRAId7oY_Ovs4U6oVxMpA&oe=6ABE7699"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qRQ-QJuK_4Q7kNvwFsIagM&_nc_oc=Adp1YsPAxKzDF7IyA9NeTp5zCoKtc1tnKjTWWffkdcO8SFrKQ8jmLK-k5wdXQ_awV88&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF0La3iKdiF5LvFwaveTb5Tg_y_Pwy9HHaWjAHXne1Dw&oe=6ABE560C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
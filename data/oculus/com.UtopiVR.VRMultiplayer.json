3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgpgjjr0lR8Q7kNvwHrog0F&_nc_oc=AdrJZ_ZZ7ee9QjecHjvsGdCdjKoVbzEIMXutiO4ipDGnOTtms3vF26xFWYlKwFGZntE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCybctq40kt6NheTfpAlSIZu4aCp-o50B7F_O4uZiKX0w&oe=6A66120E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-8qjDwsaYYQ7kNvwHtcSJa&_nc_oc=Adqn9duUkwO4yJHD8q5NbZBviuJ1G3ktwiiqxyP4IRxAAq3k-nAh7INVJskgXreeuqY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdibnYDHSg4BgnpA7OicRtKqPEoTg--q4OAa-cVm8SSA&oe=6A65E9D9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0MpIDrw4r4Q7kNvwG2Rfn7&_nc_oc=AdqeyhrLWMEfOkOTZHmqPkATcfj4ofzE0cwlqvhKoOUMXjNvqlxg6cM3mU3xaiH8vBA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmdV8RMAqHSFdYmIROjbf65HMPpaqziqoJxQ7MzDuOYg&oe=6A66018C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
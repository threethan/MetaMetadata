3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZu4fyiWq9wQ7kNvwHk0nx9&_nc_oc=AdpfSgJVTuXQIVOVk9dci2wwAYhi7YS6RYHPZoWBwK_GGunK2S-9P8MGBZhWn2q-1s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcKk02K-DsvzdKG8810S8NSBggrTEiBjgBUtTLtfscKA&oe=6A74928E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E-2V59UU6oQ7kNvwGcDtm8&_nc_oc=AdpI1t_nr5pDh2VvvEHDfhLhB4zR2EOuZO7r8KVPb-lgOrwJBdcsjw97r2Tb1LYa_EE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6yltn3T2zQQEoVm3AuQoD36jqa6M7YHKKuuekNNMZqA&oe=6A74A299"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37P3_RGcpzIQ7kNvwEYqy0m&_nc_oc=Adp2-Cd5vuKNva3aDNJz9ISiPn4YJEaUMmT2xHzy2LO1Na1s9oVdbnzzIBHr6uWQIrM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp8rzGKHoOrbPZ_XwKEqFw8mpNi1_T-tPXDqVlQTOc1g&oe=6A74820C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
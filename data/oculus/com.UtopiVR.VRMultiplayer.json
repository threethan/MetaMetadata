."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR9DNYryPtEQ7kNvwEPsuQ-&_nc_oc=Adr3mfL56f__V2pBgWGXjcD3hhHO2xBRpEksOK2_e17IY7F_pJrrdnU9amDv0Lyfi44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WuX9-uMlSMy9ECXPF-EZLhom8yd3gJWJIEWLu4S-LAg&oe=6A19A42F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KzWfCGBjrUQ7kNvwE8xGLP&_nc_oc=Adr6ag958vwzuOlAhj_i9mDk81W5quAEmdrZDMVqh2umI2GUMiESpf4sWEaG-quhG9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_BqLS8MkqxAPxhb7wrtaH7Qonvw27MSRTW1vQ8cztwQ&oe=6A198A6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnlqfkAowzcQ7kNvwF-X2Ut&_nc_oc=Adp8-sNKTBVm9MgCjbyDuuykS3JWMzqwSM6svM7uRAgi5mzK_RL__7ZKQWFkNcHsjFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ms5o8c5emrL1tq76QgoqTaY7V6UfySW0f8DHLrlCokw&oe=6A19BAB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osIniCDshrQQ7kNvwG1pzNp&_nc_oc=AdrT7RbzkpaKlsDf8FHV92UM68MCKxPl1016xF7vvsF_6i6kUhwT0qr4iBF2Oznp5Zo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TwCOGqSdXSdtyi9PuwJPvSbrl8iQNI6uKwFHaux9b1w&oe=6A19B0C6"}, {"file_name": "Hero Cover3000x900.png", "id"
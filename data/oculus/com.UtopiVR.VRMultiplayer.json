."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfmdWX_8IPgQ7kNvwHh5gXV&_nc_oc=AdoEmYUC0_4gXEUI8M1wno75noy76AhxQxmZbKsqXjkZK6Xdv2VQKgEv2bQj060Mpic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yhkVSivgCH8AbiPoMT3ajOsWnvC0e7S4m0bP5i_VL0Q&oe=6A1852AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KzWfCGBjrUQ7kNvwHF9jHo&_nc_oc=AdpQoutg8oh75quDJO6gvCmcyhK6Q_DzmQ2zB9MSCvyms9dyI-rQRHBhBRyYQxyUJqg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QJehdQDRo-FWR58vIHd34si0anByKw_NOjQXuPh5rHw&oe=6A1838ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnlqfkAowzcQ7kNvwFM3Iq9&_nc_oc=AdqDHrlmHZZEZQaRH8Z9FdFYCkeJ0aAWeC7pvxxuvy-rRVMqDAsnwNRI1jzY2Vyrpqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vBAw6WjuLNO6ThZJP-zUzdJCzFqJ6QWCC2RpRlGvBBw&oe=6A186939"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6hMCoRg43sQ7kNvwFyyBXm&_nc_oc=AdpcND531Vd8vZmctVmVLqwcIn0LWhvgUbdx5fXgwM1ON4dpS6yT5bCgPOMgLZzc9ZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kkIsACc37e4N4TWKu4sm0pG77hpw1zuzVxAnE5Er-rw&oe=6A185F46"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56Mq44ilFX4Q7kNvwEAusye&_nc_oc=AdqtTSkNPzVd3fTqWw2cxFiElsiwGdqUdBPdRZvNQXh1U2q5LKPge1CZUJtW6BnOQRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KPnzf-2huEnHI_GkBNY5lbLhUmbV2TUd-g7-KSFtkqA&oe=6A33F90E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYNRVX8WqrMQ7kNvwFI8C92&_nc_oc=AdoaZczcbHUhlsZAYgzbI83m5kUsyPUt4Fh9Ca8WQ9sMyRnosTGD-mdmNU3aeKhgtBw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N2_IA2A2t5lqkonCDEx-p6_RaT6zhtVk4xzXChI9wVg&oe=6A340919"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1tHMKV3vcMQ7kNvwGOH0LH&_nc_oc=Adqrx5gssgWX-o8HpkrnZgIoGa_GifQqcFjPeYKu8stSsKKLKPzPXX53X70D3EaIDvU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KQCFMBgSF7cUfzs8EpDvGQVal4emYKgMwTVOEK_UzUA&oe=6A33E88C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
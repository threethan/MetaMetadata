."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pnIUxhOvVkQ7kNvwGtoJow&_nc_oc=Adp2pWolfQnPElSdfPwYiVOIjfq-irW7wzNFIHm_M6pJlulmua-PlfKDGjpZeZFGXjU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT8aiheDH9HW90bWV7GCaawlwDtOrSQLSzV9TXSLQ5Ug&oe=6AA01D2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpjv_kQmp5YQ7kNvwGTI5z1&_nc_oc=AdrvlwKILkKYr0GOOexcgdgPH1rVW9U2XzRonJY5-miaGTDZGL4xPigCHQfoBp5FA_k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMYrGcp0niO-5v60QNPYYarbULgmDcFgkLlHUEyFknoA&oe=6AA0036D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42ORyy1a9jsQ7kNvwEq4OWM&_nc_oc=AdqfLqLn__yfnzXSVXzvknqRhZ4wO5bTezjQpJNrfVCilQG8CZjCJ9W8cEOPdVkMKQU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEKLbt-Su2kBy9IYWr86gpKv2r3fVKt2lSZfEKQOq7wg&oe=6A9FFB79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1if3qdiwMW8Q7kNvwHpPtJR&_nc_oc=AdpJ1XOxbYdrQ62SBVYCpBqoYH4INzE8AmlTvyPC3NaPZRkTEm1I-f9L2ZyNd7RgpAA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqrcURFpbay9uP1TRJXVTD5o7o13f4QxUmFQ8ql0dIDw&oe=6AA029C6"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWTENUfzs9kQ7kNvwESGvzS&_nc_oc=AdqTn-_PGdonKS6zvAYKkYuelSEtPbgmONBqIapwBhkyVf8GF_Y4ul17WUX7ycP-sWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49hEJywHGjO-3zcAR7AwG13hOaYh541nerH4qAGQBO2w&oe=6A1D8F8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_at28LbK5oQ7kNvwE2cjn1&_nc_oc=AdqG-e_shzElZY1b4UvL6ZSDDOb3ogHEjGN3JtshmQ-xEdyGKu5PZcbgOFwOju1D0sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DrxH09mg05B0FeuNAkVoa8dH7sskf-h7WMShyPw_ctA&oe=6A1D9F99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32fAZVqu25UQ7kNvwErtsnB&_nc_oc=Adr5gbXCjBCxZ7B3U559Ukm45rQ-PFfYxCufv8OKu0j-GpV6VPes5KDqFYKB-Jr_7LE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rG_PBAoMVi5OYRFcsBMosdlZXT3Mjz8yjcyStXqLPVw&oe=6A1D7F0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SidDgZwmsNQQ7kNvwGsjSKF&_nc_oc=AdrU3Ip4e76bHzVn7ie5yUc0BMJO1N2acy09rhAahFjdROjOLfMbYPBMADXsw5XavMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65w8jTnbxI2d8RI7oXjlO72on3c8sgMKcqutUqLZY5NA&oe=69FDEB8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxYt7tps5FkQ7kNvwG09Y5M&_nc_oc=AdrACchyB1l0dPyIz8GIh-_mWGTeydM48mRSs_T_TbAjYWOaGIon0MtENLXb3-guyq8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iUEwuY8xHbwDdMykI3g_FV6ak1-LF_1L2Ebp4h-Q6Mg&oe=69FDFB99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfRtmkVnL5EQ7kNvwEnaqR6&_nc_oc=Adphuh7xchSDiKjKmWNjPztIkmq62RmECora4PoeaK95QFaPVKu1T16yc6eWBM43bd0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NMJRZLJNUPa9dvC7cVzLDnoBr-XmwFfGahHL9RxM0Jg&oe=69FDDB0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek_vWOsx33wQ7kNvwHh8CGH&_nc_oc=AdqBnHW2P-8t9vYEWCTHBui3rCGLjWRkLv-6ykUbdejRxAoNWxqjZ_yL5BibgPfXumA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbGNocl2k8cYnNIQOalG6gmAC4am1m9jSLGpN-K4kkYw&oe=6AB2922F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv6mfp9DOvkQ7kNvwHgW0_q&_nc_oc=AdrYsDWJ0ZBzZNy4Evu80xP5U6_h0dM2oMEpt5eiv4xjFt6MsF-cnDsR82PTlKORLM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHjhm85V-p1pvpblBVZi4-bBHE5yhpP9BG8Jc8A2jefg&oe=6AB2786D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YPeJ9XZXfYQ7kNvwGHXpgg&_nc_oc=AdpgP9S7aiVTIrXcmQxwFT2pARaHXI9VBA7uZrek1Gzctv1nhfpIscdTp8ilKZHoz5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFoIcG3njif1x_gNG9aTX-3Qa8xIV9XL5L9Nzstrx0mA&oe=6AB27079"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVP7y0pgzZkQ7kNvwEMmdh6&_nc_oc=Ado4MENdvDCZfyf_eE7ZMwnVIZAiUzHqEdCXEDtFTvUgRhZvEGUZ2os4iEr7A2lkRKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs95g_QlgJ3omoI5_zAnIe2s_SY3ubCHidhb9sgiqrZQ&oe=6AB29EC6"}, {"file_name": "Hero Cover3000x900.png", "id"
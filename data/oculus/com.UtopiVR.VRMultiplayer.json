."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkOuzIx_9A4Q7kNvwEO7W4V&_nc_oc=Adpmf-zkiDSUSrxrYpsOVsR6OQNIYtYThKdugqqE-rh9VgR7CZ5IIJYCshpCfuX8lYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpDMWcoOXCwhTlkMBaw83oSnsaxXpo3dwNJJcl6qnK-w&oe=6AC8FBAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNAQ5tpdgewQ7kNvwEhiAbz&_nc_oc=Adp_QHTBte_Ktnt4gItUdR1rc7iRbxYgk5mo6sprjcD98e8_KKXB2H88FIc69eF-u2M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxa7VFVBrVKANLszw4c5zHWgg8v6uZncDJSHT_gi_MxQ&oe=6AC91A2D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-Mbb_cZTKgQ7kNvwEy1I-l&_nc_oc=AdpTeeMtCMvu8bc_exTjHJWuJaabXjTALyAfh4hGEHqpGEbU4JnwJolXcaVtgX5eVsI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe5xqLs0W7mQGTzt3B6DSuuNQakM2hKYTQgzuESfN7Zg&oe=6AC91239"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNFlBDGyUdMQ7kNvwHxKRuM&_nc_oc=Adq1LexruWCD7OiG-uSl8UQCH7WEHghpjgfkx1LTZ-IthbalVdwRMNAcEO3Ca_YNisY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu2Nbvx36YU4fz5sYsftX1z-j8dCMhiWgQds-U5_TD7w&oe=6AC90846"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydHXhZUcnXAQ7kNvwHWnB4i&_nc_oc=AdpyAfZ3XuGHem1zJyvvMuVZZAnuBS90nff3ZOrfhUZIx_neGNw9tbR5V66eNwgwTYM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nP8H3VI2Wv2-h3f3KWRWG4os2LB5EGkwtjaevnW9JcA&oe=6A13038E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UGYELnHVn4Q7kNvwGga_ed&_nc_oc=AdqJktg9k5unC3KrMQkBX5mEU5XCR_6ZuLIh3Oq8rPXTYkA_3h2LEgE4cLbtXbnCtRI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7evXrNQErzPMkX_BiKWfBXulh7stNUzzIKfQPnh5YZrg&oe=6A131399"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EuGRIJu7vwQ7kNvwEccU-A&_nc_oc=AdrYe45OGG750Nmw7uXCiTmifC7yx-LmIyO-kPwYDN3HdlDT0h9X69ji9IWdsgWEcL8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dc-iThO27mXjz8AJi6QxTsfRghtwtHUEFrEbfm6oy6w&oe=6A12F30C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
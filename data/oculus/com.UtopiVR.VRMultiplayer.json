3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56Mq44ilFX4Q7kNvwFyPkRP&_nc_oc=AdpKJmvhDEB0FLkZd5MHQ1hEUTOQ03iAMp48zuY8ZsVrrvvksnTaTqmiZs2u6yjQZKk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xi4e03gDE-9Ass_Sl1PUEs7Qh4T-oWMcDm63y4fwKZA&oe=6A32A78E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYNRVX8WqrMQ7kNvwEq41Li&_nc_oc=AdrW_JVaFhlqnvtDEj3zZdNiIYtEOkyOxUWEmYrG2EpwX1ZhPxI0p0g-KYqvSPOqt_E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wAgm3RgZlpeBoF5tQ5XwFkeQR0gHl6XNKMJA65PmL2A&oe=6A32B799"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1tHMKV3vcMQ7kNvwEtsUyD&_nc_oc=AdphY2nb9O5Fd174qgVANtg9aGSnUn1p64MiwHy_XM6SgeINNpBwRD6JRL80Ql-Z7YI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mmaqSl37a-sGNin8MiWcs-Oqya9wmXi6-j2UjA1j9nQ&oe=6A32970C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
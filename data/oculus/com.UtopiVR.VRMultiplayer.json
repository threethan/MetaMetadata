."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oPaH5r_ReUQ7kNvwFl_7pZ&_nc_oc=Adpf-U4uhVA0BKs46jxIypLh7Bh4K3_qWJ7C8AkicRe17yJJn-5lv4hn2rkR44vGtAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKRwWq2dki9LRhtg-vw3vSpqnKfyIRxfveMD1XvajEYg&oe=6A8C1E6F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fg3BbGBrjUQ7kNvwF8l2sr&_nc_oc=AdoR9WLTVVgl7Z-MdcPUMGBcue5u49CC37HYC5zWkfgY0d2NWlR70lOvRF_h2mXk5fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8-rXSzhtXq-_eaFnnglR0DEfCFSoz0VXmZURSBLdVRg&oe=6A8C3CED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHscq8GpeUwQ7kNvwEvTMz0&_nc_oc=AdqyHN3PgyCAJQYJTt_dCHJVPecOVv27h3lhcpPiDdcPei7gbPdsr7A_6Iz0ZYx_AHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJUaWn1ePHU-EI4VQh9s97HCePovbfEKh-52RuNHc6eA&oe=6A8C34F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqiGOcWLJFYQ7kNvwH2cATE&_nc_oc=AdovrJtOwUhYjieLcoQispYQ5l6s5fJ64cPoRGncpjM1nfvmjRWwR8Bt0tDbETPNZlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL6DAMNjNePlQdjZSXEjSgC34E1e2NsW8Y7tay4gW9uA&oe=6A8C2B06"}, {"file_name": "Hero Cover3000x900.png", "id"
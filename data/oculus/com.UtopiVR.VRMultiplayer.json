3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QInkPTIUfRMQ7kNvwHtPIiB&_nc_oc=AdpyKQGsnICHJUVgosZGEBP_oaTXdrt8vShqee_pVFsjFEdYX0ojRp0yT98q8qSSdv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8tKodz7lpAGY_VBmRpI3ur-bnQOi5SIZuKDIWemcP2A&oe=6A64C08E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBnMPKpgqRcQ7kNvwE0QoFn&_nc_oc=AdpOV5U1wzbKLupZu2TgdIJ2I1s0MO3fPAHCDKvUykOy1S4ORehzJSbEjOTmgQh6pbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqgP790ezeIAd7lmn__fg-X6yWv4DhfXkxgZajTYjBpQ&oe=6A64D099"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0MpIDrw4r4Q7kNvwGlRaz7&_nc_oc=AdoP-4Qkgtu8S14MTxnZoMU7Yk4KRIBWggfkUEtaqt8UsuHp2XtzYRFtCGQxiZQYuQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4fDPU3wSpcIGJODrGsr9sB7Dal8luUrUvflC0UAzfyg&oe=6A64B00C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
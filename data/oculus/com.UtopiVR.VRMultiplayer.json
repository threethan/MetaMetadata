3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgpgjjr0lR8Q7kNvwGV2GLU&_nc_oc=AdqM_8UpyS9PULvOymIGhMiiIueq3ddA-nCfqozQBZpAwZX9poqNPN5bZGs5ZZQgNAw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi-k3NRmDnZUo8wwuw-8E_-1is1wAZd1zacrrbl7JE0A&oe=6A68B50E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-8qjDwsaYYQ7kNvwErE0lG&_nc_oc=AdonpoZKqzI4petBnfnUivRKON539rVP4B75KvX7XKsZOy5GUzzzz0NiB9Vi9jvaTVY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh2DZaV2Hakp4fy5pi-gcdf2-5UkdpDEPcna01H1hO9w&oe=6A68C519"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6RCFw1g8R8Q7kNvwG6OQan&_nc_oc=AdoNoyBW7xUsS-6QvNvJZ7AcdFm-8CKpjRBrJQmbD2WCi2SARMP6ybAKAm4yX1hQnjc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM612I1Jmy4W-9qaB6KkXEt_DG4-4YqXxyvxcfneo_mg&oe=6A68A48C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
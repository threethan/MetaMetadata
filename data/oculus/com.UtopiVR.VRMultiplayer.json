3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjRpe6VdSFUQ7kNvwG1qb7I&_nc_oc=AdrtcwDL7u-7pe8R7tGN7Wx7jANnlKP4U5yiUSrQIBZF11h8MMjUKmas4aI_NrvG2Os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFHIELfRTE9J4qp9igc8zInZEpgku50VqdfIJfHhnB-A&oe=6A7C7B8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKxK67121OkQ7kNvwGNovqp&_nc_oc=AdqtR4VNOI5ZLHWv7ZnbcXJT3d-QIR3a3G9xq86og2M47KwBgDZM2f_ISpJC5UkFIrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2TnhLxjqYGjoR3GwJWxZZldIsppoIli_MmiY08LhdmA&oe=6A7C5359"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCTgxuOXMTMQ7kNvwHc8KdV&_nc_oc=AdpKqm3hb6tUwmoXwJ6LqXHNgglKnLoqWrigSp3V9oVudRYc9TZiy7x3vFM4okdUbuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnm5zDuKtR8nBNmFfl8iED_bK98j5S_DoomfV1ELgERg&oe=6A7C6B0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
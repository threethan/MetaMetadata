3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag9Y5j9JHKYQ7kNvwEQFGK3&_nc_oc=Adq1Pcnm3U-TV0zvMQhdG7LdyIgrIE8g6wsr1GAeXxc7bU5NgLldDtgDUwHujYy0NHg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeGSolrAtC38F6aEjahMlBSLE_IYL5cf82YNoAUFZusA&oe=6A8AC3CE"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoZUffPhWh8Q7kNvwF4uizV&_nc_oc=AdrSt9vaHKJi4MetA8sA1rAFUUd-pHiaxNZU8Vj6gFW6GtmseB0u_BjMCRLUi6SluVc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7KBGFhfIkOhG_6v4RRjDcokeihY0Qv79thwllv0roQw&oe=6A8AD3D9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_jjJrkLs5MQ7kNvwGrgXFo&_nc_oc=AdpCBvdYtZxlm2kdddBt997URLlItXF8xu6SwJ-Ths8q45IRrF0tytE3L5HFCXgQthU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2p0Xdi11wKozbyyDscPuf_OEFaW5hr0Ty0DVLNsLanA&oe=6A8AEB8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
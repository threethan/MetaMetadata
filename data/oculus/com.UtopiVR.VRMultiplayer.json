3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZu4fyiWq9wQ7kNvwHHx7p3&_nc_oc=Adr__GjqXrEbTnmDTWKZqBnO6Mw2FWQa1es84OyW9ieYIXqvWsX96uVUsSGe_9zwPos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVKAoI6K2Ydm8wcLn1t0ed06p-gX58wSC8AVShAwItwg&oe=6A73410E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E-2V59UU6oQ7kNvwEB9Thu&_nc_oc=Adr1viCEEmPgP_eEtm0ZW0UFIRR9ZRsZkRZxckLZvU4ztnu36koIDgIY8kzunGuvKtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqS_5-T7K76h6OfNPSwYVscGjDGKiRgVtEMk5pDmTiNQ&oe=6A735119"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id0GMHsBrb4Q7kNvwH4dDAG&_nc_oc=AdqB1JBYpMUKriEEyYRl5mlcm1uGzAOzdFgRrGxmsZOWUHouSdnJl-QAnFAz9tcV7cw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgLQsf5xqi2W3j45fbk1_b8FHTVAL6jUpcPp6Oi58oCQ&oe=6A73308C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNdk6uBd5EUQ7kNvwGx94u4&_nc_oc=Adq6JIB7rUP60b6II3e8AAJooPYRSZOfFOAVbTz6N43DAfDabQGtwjwwrs8fU96Ofhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEISNiqemV6cMslXwd6YmJ1JVvz54S9rpZqdQyNIhaQcA&oe=6A734A2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgkysdEg7tIQ7kNvwGXiTTW&_nc_oc=Adq3mAXXrqjbeujsaQ5jf5LpL8s8nDcmJ9odE_AO_ixqwIqMcabYYPrn7JetRUN6lns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7NIz2EvCJZFKAkvrKvwi8Oa65CYDhswmF_bHvXUw0Xg&oe=6A73306D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMc3kl537NcQ7kNvwEesqYE&_nc_oc=AdqrGOEo4qJRwU8lBxCm5W6qYyMfHpNT6z3t0G_rzt_jzZjddvLUcPZWqfXSnwMmW2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5lG0cGjrGxXZLMybdNZSQouhm85pd8LQtbHVkHD__Jw&oe=6A732879"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OsJ2Mb_N5wQ7kNvwFccm2m&_nc_oc=Adr83vU8RI7QK4GaYbi9mdxXfP9sZrBcP2tJQNvXtnbEl-Nq0wBAYFEkcLud3kJ2j_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER1iOviEuaWBomniOEgJsa_cXgBib7mD2MKWNjL3j1IQ&oe=6A7356C6"}, {"file_name": "Hero Cover3000x900.png", "id"
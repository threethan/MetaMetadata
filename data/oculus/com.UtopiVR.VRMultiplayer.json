."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4vpz7XQAuQQ7kNvwHwfBP4&_nc_oc=AdpirO2c3s9oUJVMSCV8i--YPH5QdfOQOIIAgEFqevRc4KjKkSiU5bo9zpt7wgthPY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXyNJaW0twlDS4tp3jnnUqTmZtsA8NnHs6WjujbcJdYQ&oe=6A773EAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrtMDtsXhcUQ7kNvwGwXmC8&_nc_oc=AdrBBYAgKcnuFfB5VJKCYfKcmsreR0BgX5brNIdQ7OLTbGg6OuBPKPmKye4MGGhry04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFur4C78-S8DG51BfMwqInnKNmcPY8KwpSrdYqi2qYBnA&oe=6A7724ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaVUkj-aSZYQ7kNvwEAh0fx&_nc_oc=AdovT-Zx3TnLaEMjePYY_zwt2YYvnbaarkpnWFj3GLoqD7Xlp6rs262-2Cx1cf5hqRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB0c1GUdwLPZHGUjEootUaRfLdI_r2Nn8F77PQ7cW9lg&oe=6A771CF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8GEEN-ZjgQQ7kNvwENFDA7&_nc_oc=Ado4fRjS896qcIgUbhyccZ3cfDgtRyoTE6zKrfmEOUrfbZOXz9qU_65LoZe8jKk0NAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdry3PjE-qQDaJZZq-ibF0KLIC6Fvwr7H3vfSqqS_Rhg&oe=6A771306"}, {"file_name": "Hero Cover3000x900.png", "id"
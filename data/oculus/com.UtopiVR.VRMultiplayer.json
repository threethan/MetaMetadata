3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URZcg3LxGTIQ7kNvwE7A6eh&_nc_oc=Ado2dN3khgm59G6q0enZ5VSKq9PZ93YaCBEhw8R-zi0ZDGlRm6ZU4-ue1D7H16j33Lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rVFSqsu7iN32kT7JMABayldptAzIYi6uksOH036ML7w&oe=6A01E00E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMXFSLOaytoQ7kNvwGg_NkE&_nc_oc=Adr8tz_bfdZom5mj74tnx4IvRA5lZkLncnbAY5GhPe5dVDV0htqoY_gUwuLgxHkovjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7567uGSLjAM1mrzoVRgqNWSbYBzzhBsAqw1qpuDDSMmA&oe=6A01F019"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdxRj5VurLwQ7kNvwFI7F0I&_nc_oc=AdoJBJ6mEnlr6TXOWa9IXLtWmqu4Xs0WUFb7l93ILJDxoGznGew20hTuyQ_6DVH43NE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SCODWgK2xyUA8N4SlZlOg1SOXXyhoJ3ICQ_LhnxQklg&oe=6A01CF8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
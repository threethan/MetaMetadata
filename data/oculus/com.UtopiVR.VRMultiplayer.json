."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjo6ysN_R-0Q7kNvwHZb4no&_nc_oc=AdqJfgVmMlPqEIIKnogDzBnHunPvpi-hKRdDWGRchuSppGypDNsuX4cleNgc1XY5CPA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dFDQEynX6YsUt4acLW_W4cQX4QWOp3Br8SF0kf0keig&oe=6A24302F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKcN7lAfr3wQ7kNvwGMpgt7&_nc_oc=AdrxjIjbF4XeZroXGsomrSVYUaFMfw29-T-Xg6543TCqNrqau-XqUgfgbpJJTTTQduc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JCAKuf90hnEepKySVVpISOidN71JBhrkteiTiNuQG8w&oe=6A24166D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktzI30wN1EAQ7kNvwHPzFjn&_nc_oc=Adrl7DJd-98UIMvVygTBF9xe4RSgFc5rwfmqcDLtpLg5EKKksYFNBLOHcuvE-YECCBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qvlnFgdlW_ukuOlkUiP9cZ1dhU62qfOT3pIBxPGTkGg&oe=6A2446B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6HjYg3Gsl8Q7kNvwG8Uebr&_nc_oc=Adpo_K_L-CGLjRLOeGCjWqi38bp86RaizSZBAS9uq3_arkoo6UfEIqgoHlFSpsQzxQc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JuY3xNGf0ADrwB0ULgazFhlWOeqNDmE9EHoZebo0W4g&oe=6A243CC6"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZLyH0UY4wgQ7kNvwHWGJMv&_nc_oc=AdqIE1lZA005ZxORyYDk_xEvk0gPCO2m1GIOTGN9I0MAsliptvwk3sUGSipZ0GuNR4c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKlZ6Z7zW6UDT3iXZtTnoIZoU0HS3wR0CEqdO4xrAjKQ&oe=6A539D0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoaJaOKUC4kQ7kNvwEC2rFx&_nc_oc=AdrkqzFCwgWQwAjS1s47Kgv8watSqJhakxBiN03aRZOAIogao9yzJvkvMqAB4hK5SfQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUWiNxd5s5SPwMW6xX6gXvwz8DvgDVsLH9P-BOosWdPw&oe=6A53AD19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDPKE6SAt-sQ7kNvwG08aU0&_nc_oc=Adp7wATg2-J6iKGMI5OIQHhJoSZo1m1B2zsrt6iMMa1nPsZpk9kqSoAGbFo-wKB626c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYnRQxzH0e3Qa7eY43v4t6t1i9EmMqaUmVJkBK2g4XCw&oe=6A538C8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
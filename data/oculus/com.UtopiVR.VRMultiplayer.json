."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lVELzaZc2oQ7kNvwFRqRgH&_nc_oc=AdpIekqNB9anRPZh4UjKiuMrwPPW2GJ42exUkDuftnBtyF4SWbOdiEQkCk9gb075R_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mJwd0RIZo6kK3R-45jCnCCJdovZ0tNzqa3h7e-Zktcg&oe=69FF462F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqggTmQ95roQ7kNvwGrqkpp&_nc_oc=AdozxQa7AdNSnM8NFxCpPmFE-SdAX6CTQGQlX8tKGD1Ti5z_Ak4U7fRsEWflJQvibvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AwlEswG8K1XHM84X0ijG-ioEwVwGnD2GiDq0k0YwxLQ&oe=69FF2C6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaIH_hD4jZIQ7kNvwG_VPXS&_nc_oc=Adrky34MTjWYsItiBhtk-IJGXf-If3xYt9y2hkH_ecpCB7XVUdHFhgEib9IbKdaudb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tB_rBoqGHzTZR10PilkVCvPLNu1ZrvL-eiyDqgRHvkw&oe=69FF2479"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZOY99wMRcgQ7kNvwGJcSPL&_nc_oc=Ado2U7qazKs_gX75Ihonlb9ir9kVjPddcnq3w54YS3jS3KiQK_Zpb6ynWUKSenRYZ_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uXzWkpO-KWN4uQsV6q_IucNtYZnHnQgh1DgDc700MLg&oe=69FF52C6"}, {"file_name": "Hero Cover3000x900.png", "id"
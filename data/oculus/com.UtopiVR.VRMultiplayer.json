."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfmdWX_8IPgQ7kNvwGAc2RS&_nc_oc=AdqHDC-QngHQFepwGNreCcm_a8nD51ksEyWVRMxY4h7LSltJP8nkdsI9KAoZan8k4uQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46O6HjqCgM4sNdONBoEnp4Tvm9AOuVwZ8PfpD6AaBtIQ&oe=6A15AFAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqJsw9VePLkQ7kNvwEL0Vm0&_nc_oc=AdpCToGXk9xNs78b7r1vW5U_vlWs3kg1LtSlngavG8c03z1Z-uMG8BVWMz7p2gSKnWk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5613VHYu0HePCqM8EICFWo2Xie7g7LT3jIDg1Fhxr8ug&oe=6A1595ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvLeBnCrOfsQ7kNvwFn5i8h&_nc_oc=AdrhCDybxzqr2Pi5ThiulEsCG9sPGQPDLVvekZosHusuni68JLR_wpkobICjnNU4fkg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qycbf5twDytYatQd4rI9btAIKx1bf0p3l6PW-VfYcVQ&oe=6A158DF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6hMCoRg43sQ7kNvwHrJfr7&_nc_oc=AdqDyaRytA1o3GmbzNQL6N-DsZMbQLgBAXYOCrhGyWR59HLzULidYBhBwX_XZV_2zDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cQPCOVFZdn0h0YsA7O6N7l5jNF_H5qGNOmWOwCKn0jg&oe=6A15BC46"}, {"file_name": "Hero Cover3000x900.png", "id"
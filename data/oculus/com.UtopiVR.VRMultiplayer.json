."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pnIUxhOvVkQ7kNvwExsQCt&_nc_oc=AdoO4NvhBEtjtejWHTV2ORr2VrPUWI-VXyEsshAQLsw8rJNMELI71icf8CNF_wu3Dv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjjO813lRdFrizV82YKNycf_azyvXa6DiuOrXM42Larw&oe=6AA2C02F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C9v8ZfVM0QQ7kNvwGQpL1f&_nc_oc=AdrBSV8pjIbhB7YC62w8kXpgBPHcoL7hvVlE8II7WB72y_G2yHIeRUHXWEKGHsdjoNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK83vLb1rHBIRZHUnIQFI56jkzLr3843uziw3rPjhEhqw&oe=6AA2A66D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATxrTq8KA_YQ7kNvwEA5RR3&_nc_oc=AdrVXXx-EymdaRMpekL9uGDhtto8LfSojNzzxlMFiiPVt39YX3WHLeBwF_Yeenz48Fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1oE6caUuuVqB14PsFHT30UQkZv4LjEVAYMsz5OwDQDQ&oe=6AA29E79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1if3qdiwMW8Q7kNvwEbZAlG&_nc_oc=AdoE_LPRjL9mQ-gIYfoqtV_xltiO7ngOc_Wf6klVpf2UchDYoYhY4t4H6gMQPIYU7Bk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxv3t_xlWUiM5XUGNfEM753LcqAEudKRC9_0LlXSUlmQ&oe=6AA2CCC6"}, {"file_name": "Hero Cover3000x900.png", "id"
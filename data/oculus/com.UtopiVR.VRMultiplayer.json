3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSYiH_-_uyMQ7kNvwGD2jbv&_nc_oc=Adri1cAFAGyY7Y-u6QevpgzudcUBOzOtKat0Vt433SZV8-JMhw3QdzB-LqFRFjlqIYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Dti9d7l0HPSkCXXse7eTxCUSk29Pe37DyB1O6X25GLQ&oe=6A2D618E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJLEMAmVseEQ7kNvwECBQpA&_nc_oc=Ado8A4H7cbSMT1ucGmAgzaLqGQzqGqlNCzC76BgzA2hAeNkRl6em2WF8my0KMrqtSgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98XXolExa1TN38FnXEIYAz6b8eITcOiYTguIntZMP9eA&oe=6A2D7199"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgNyqEbhtX0Q7kNvwHlzWqH&_nc_oc=AdrP4cWoLnoG1LSNE0GS3nRTNB1RV7WP1Ntbz1Mn16_yYBNi1wlzV14su8DA41c_QjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_63amInWFfk-k_mOkYtY73lpJHb9h0TI9qOYGh3Y5H_g&oe=6A2D510C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
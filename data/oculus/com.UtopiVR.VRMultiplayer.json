3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5wu6DbsDQYQ7kNvwEG8dZV&_nc_oc=AdqM_rWcj6bgcUGIHd2wJOlWcHjxRziHy-vORfY2xp3AB0mdCHhYH4e6KGOTqc5AAH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzRBD5y_Sj9lLuktW-yK_Gkndvxbmxvfy-TEG6lZy_zg&oe=6A84648E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGX0YqKvaYoQ7kNvwGPpDkK&_nc_oc=AdrGSxbymvp4QuuKn31cj3zEAgc7kjS22DEvJ14Is-XYj40QyZQPk5FWkZgXiTbnv4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJA2OJv-zHPyr4k16e5R_Z7ye2quRWNvLDo3xjBhAF6A&oe=6A843C59"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyCxG1GjXcAQ7kNvwGfdU4D&_nc_oc=AdoiYv7XAw3Oizux-CBXyAukDzjqiPmqOFw5ymwYP2fUBESyFMTK6gSdrHHFB_M4XMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmeV_K_nQ-yC7jbmh2Gu77vky-bziC99GH8kuvY-SlCQ&oe=6A84540C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS9OLpXRdigQ7kNvwE9Q38Y&_nc_oc=Adqd5tGaV8jHTTnQ4GdRWtz1a-jZvG9u1bZ2-mg1-L1yBn6EJ62suc6-Q2ojtlRZmZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58JXFyWKZmQfQ0jep549gY5OSVVEy4LWR74-IkSiqzPg&oe=6A1EEA2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fnfk8YTjToUQ7kNvwFaduek&_nc_oc=AdqXWnM2K0o4pXfRRwa24OpekTO1fP6nDr4q_oEGDW9joieq0bIqYLjqjYzR96akv7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78qF_xFGH1VKBkjCdKT3Rzauzy9_FR56uYTs6nkB5tKA&oe=6A1ED06D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYUb2HP9FWUQ7kNvwFZVqJa&_nc_oc=AdqX59y-FUb0jiiOYmfkf6Hup6lGvGaQQtuE4LI4SKXpJGN4EocFoCrw2-EIP2De6UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rgDaCQJDQT1APLSKV6b7M4broCVQu-SIkb8LsMrFnXg&oe=6A1EC879"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-mtdkM4NkYQ7kNvwEurjrV&_nc_oc=Adp5gnFRKmDzObKbwxDkNvPZ0k5hZjotv1GCGoc1QaoB7X3Tlgf8vN1za5-GkxE7lOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C4uqW1RoYtJsuF6CP6Pxq5QF17aOFF6-BlAquvq0Bow&oe=6A1EF6C6"}, {"file_name": "Hero Cover3000x900.png", "id"
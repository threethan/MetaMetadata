."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_IVri4XOhAQ7kNvwHe7WIg&_nc_oc=AdrJQO-mz-u2zTNs2aPNGB-Blh1eiDwTASm6TE_GSOZb45sldDA0C4YDYRwIG0xahiE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL23rQoUvz3CwmL6ekANydSqgHgUl9vmktixOWwEmXX4g&oe=6AB7D82F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEtxlrafaHkQ7kNvwEUkkx6&_nc_oc=AdrlRkXlUA-JP9fZSOom2YVfgeDg_DOU-PZJdTp1ELzSRRuCclcC2pMuST0O7gWahSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINXwqlDE1y-NFl6pPDO_gBssrWLXZEqoNH4rZHVk9i6Q&oe=6AB7BE6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpflqDB-L7oQ7kNvwH7XwAH&_nc_oc=AdqZu-B4N6tP9y7RcwOVgkmj50Trap1Z6nwQyDrJrqgbqh09v_dz3iI7kW0fIur-mqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfCMGH0R9fp0VIxQ8Xje9DucAGF6JxYF5O4zAVBbMWmw&oe=6AB7B679"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMh62DyE_LUQ7kNvwFrXN1n&_nc_oc=Adr2C2kjHaj00OmYnPzL2bGkVvLIFaecPt-yfDlUWoEKVCAD91D2Rc4SFC3vNqIECdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInxLwHDC4oXg1L-lwaezKfmKJMufmAZPhpbnNvEHAZ_Q&oe=6AB7E4C6"}, {"file_name": "Hero Cover3000x900.png", "id"
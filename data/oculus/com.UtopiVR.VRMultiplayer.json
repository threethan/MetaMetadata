."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g50bR8wgPUkQ7kNvwFNXWA1&_nc_oc=AdoW7yDVUEb3AjJHIopzrIlYCZQmRw1LAZa9FYRw5l56i6le6vxrAF0ScthzeDnCyAo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35CkGqBs_rszo7F3sRc6FTLK65Ko4fW14QCZdEL27VZQ&oe=69F8AEAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hcw2AGW6dkkQ7kNvwFDHbGu&_nc_oc=AdqKgrW2VoJUp3-WaoOFNYYeU5HxWVJjpY-_xK88FbWr6I549E-NvnVC6msy0I2nbLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XtnyQ9qS5XFXhYJX0njx98cMhetGnbTS4hR6KRMwVqA&oe=69F894ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3oK_qbJsNUQ7kNvwGE4cbU&_nc_oc=AdonWEwEQA9sP_sXHa0mxtXHrqPaq96QK-5W8j5Lo4F-RI5ElsWwmoIHV6Icw-tCHL0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05h9brJRCpvmeJA377YzThGzmEmHBHXUzp6YXc7ENh6Q&oe=69F88CF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj4Yy86QrPwQ7kNvwGgb-rE&_nc_oc=AdrzCvhHPyQsLn974gUQwsIKDz65QczUAQn2YX3m_lwRIpBuDiOz6jVkWAUtqk8jaik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aSMphftUHrek9CMVgdIh8tPvDwMbpfQKCfnU2xvG9Pg&oe=69F8BB46"}, {"file_name": "Hero Cover3000x900.png", "id"
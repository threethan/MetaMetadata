."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_BAUpAsXzEQ7kNvwGTx-qO&_nc_oc=AdqYv8fiNpbqHnveuSqsG6myQ8Su_abf8xYFManMBfNNi3FvXD6fNHclPCQ1rIOlInU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMILbTcwzXzKShPzcJaxRJ9-JtGsr7ayWGowPzZybK5jw&oe=6AC3B5AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZehIFO7qI8Q7kNvwFdtWyC&_nc_oc=Adp1iuL24eMrI6ljY2wzFik6Lkz8Jbjts0XBn1NKbXOcU1zx3BNXclHPBofCABAbunw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6ARPwSEpNTf1_E2Hfia7SjgDDmzz1oAINPCz7L58MTg&oe=6AC3D42D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FdOnkFz5AAQ7kNvwFpqg_1&_nc_oc=Adr6KDzaK0DxpysyA1zCCeGyZ56AcOKMRsoGao9nF3Rk-6-9YoBzr4IpaR3-p9FmLkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Vz6hr4ZdInc9REAoRUIAskOr6bHjMASUy53yYgXZrA&oe=6AC3CC39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFE45K8_pHIQ7kNvwEnx_Qq&_nc_oc=Ado4Wb24N392lbf6uWpsGaByBqe9ZJtLYvR2vTCI6vDgMi0jSpbDYy6EAxerZgxtEaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfbXrqkAoofIuUzlevbuMw1sRwL5eGH_IjDNIPgJu8dA&oe=6AC3C246"}, {"file_name": "Hero Cover3000x900.png", "id"
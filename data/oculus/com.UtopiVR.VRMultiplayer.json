."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmrfgr877xQQ7kNvwEt-Hyr&_nc_oc=AdqnED0cd8_OcdQKFpeJNq5b7PRSkjrzgZjOVpJRatSfgARWioU5BsjxCtvOjvvjE7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIiaxf9-7IzLTTG2Nt79TJ-RcwtEA5IH9YSPbK02OMCQ&oe=6ABBCCAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajtG2QdU7PwQ7kNvwH6mpx8&_nc_oc=AdqmOJtbU8hWcB7JtGu-aPl39ThXLM-0HgSKtHE0LcgvumZaCILb66aSlMC7Ev2zt3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjC-lQO80dDialGghatSEE6UoQC2DQO8oODKEUoaOqRg&oe=6ABBB2ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47vSXIxUAywQ7kNvwGDUEFC&_nc_oc=AdqZ7bBMkqe20oWMbfdiRGJ4wxVIk4R-h2re6054Tw34jKBquoz2GLx2DchkQ5PdiL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxI_GAytVj7jP76BbTi5wG4-tHyMJJx70bBc-kQTlb1Q&oe=6ABBE339"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oA06Zn4abx0Q7kNvwFLAfbz&_nc_oc=AdoNyzat-JDKCuK_RJrl9L1M3GA9TbjlgpOfweaEFhGBWkJjVDRUQqj-n8Y2W1JRXaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvl1i_8Xz3JMGeWIi7s-5YLOXCSWryNPZ1Gr3GzYWSpQ&oe=6ABBD946"}, {"file_name": "Hero Cover3000x900.png", "id"
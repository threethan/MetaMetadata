."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALlKjQjfPh0Q7kNvwF1KVXS&_nc_oc=AdpzaqYNe50qobxWtvBCfbYOZNglpFDTmgaaaF7HwzNUdy-ZaCSekuz2wbEOsjtYZbU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kefxuL6gkbamhT858U_Q4AEASITuWAqc8T0ETmqXeyQ&oe=6A2C192F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxLfMd6XkDwQ7kNvwHs09k8&_nc_oc=Adp1u6MFW7TicQKe4-ONGg8yL5CcBCe-xEfpQbJrxK_4AnZDFOotcq68DmC0zhLlZ4s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YieC7JH1SGNUTNX-Wx0BqVbkCT2vXjFY98DGT7d_A6Q&oe=6A2BFF6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdct7azlZpQQ7kNvwEw1h1-&_nc_oc=AdpD7e5BTD2yoZ45MSACow7QMBbyCgMXuX2M9d4SGrCjIGTN7Hnta1CKbYYy6sS0jfU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OoP6iwnXcg1xbR3Iy2i8Jl9y310zlwSNnvkBXkGNn8A&oe=6A2C2FB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxiUOiuaz7EQ7kNvwFskkQv&_nc_oc=AdpYvEbRfaZ_taN3HDWlXCAc-3AHx-RhBL0BXvIIunh05o9iGZsSlduRaNoKlRcAIXM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-tFJCWzYJK_reGgt9YdPAep52uawhve_0UuYOZcgO_A&oe=6A2C25C6"}, {"file_name": "Hero Cover3000x900.png", "id"
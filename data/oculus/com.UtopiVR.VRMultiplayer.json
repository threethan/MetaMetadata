."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FegThtMtfO4Q7kNvwFYAzTG&_nc_oc=AdpdbX6Cj4bP8D20ICpwZn2z9sx1wX7bd6VQ8hOmWA6PSOeU_zCEVAyXd65e4BlOrNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXwePZlL6l5rJ8pIXbmtF91DFlZhIUrqF9iCY2CDImSg&oe=6A9ECBAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpjv_kQmp5YQ7kNvwHtfvRj&_nc_oc=AdpHuh_R4O54BqkFvwj5NjV3yR2F03CqBoHiOiwdDrCTmLOzqf2rBfE5tcsM-_4N5Ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmVrocaXFmQC6DucfsghIGHzbTfjWhnPQAiotQswumCw&oe=6A9EB1ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42ORyy1a9jsQ7kNvwETer2u&_nc_oc=Ado-mYmypvTeaPeo1s4WxMYnAOBKvzZDJY05jtAJIU_PvF8dyLqzzwROzjZC0Fv96AE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuGyMi9CuG2bLzB7fHYMk1vwUCyxrc8rL10K6Ct7mwCA&oe=6A9EA9F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQ5oQioEI1oQ7kNvwH726A8&_nc_oc=Adpefhr2i3LGMS7_3jhjxyJfSRXNYzTLi_TYdt1J9vd_SXpZ0g-4tZNJZ66XcvwGHhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLClq1zhK3ChOykcFM2KhMH05SCDd0hP_n8ikuej0cFWw&oe=6A9ED846"}, {"file_name": "Hero Cover3000x900.png", "id"
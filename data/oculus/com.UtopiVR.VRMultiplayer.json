."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNdk6uBd5EUQ7kNvwHHUuf0&_nc_oc=AdqfbWQo10iZsMpFzY7GL-Osti_YjJFdr1ewlAlTNnE5d9ul8CZyqtVK0K4Cz6tmPpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGau-XliFrH-doZ6hJVYXLN_hIQkHrvmi-B2JxAAnoJFw&oe=6A70A72F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOsBAd4VuKIQ7kNvwHL7k04&_nc_oc=AdoIUsy8VTdvSiw7hWNGQGYAHIckfHbu9G4_eBxXHIajt-twhqwagipXFgr2wh7j4no&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQFYvcQ02bWUglM-sUsjcmyO0_0HA7GzOkWIOfI0EzDQ&oe=6A708D6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X3QothmvPQQ7kNvwGw1I8H&_nc_oc=AdpCxO4zXoetNIIl_r5_iwpkK00ayD_-8mQbnIVUb2QKXFGU3lsxGXon_pTwakicTrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLVUXAbybV3BaTRvNvIzyx-9HurLKS7MIAjSrPdS7egQ&oe=6A708579"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OsJ2Mb_N5wQ7kNvwFCIeLM&_nc_oc=Adqlxe_9TP72EFH8abpJjKDdRRPAClJjABGPSqamyvZdoTZzcR6eFcwpC-lARR5jQI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJkn1raioQ2Udtrp7lpE6TVKiSJO-y1XaC_-WIl1ayNQ&oe=6A707B86"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag9Y5j9JHKYQ7kNvwH_vI8U&_nc_oc=Adpd-h_JTzec6BMlgAGIuybNjrg5O2dleQpxexwvi0D0zLt80TGKQEfan8bsP83G1L8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHywm_f2jFXbZm0Pjh_yaYIwkFxo5cYB7NS-xgUYt1Yjg&oe=6A8C154E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoZUffPhWh8Q7kNvwEnPboA&_nc_oc=AdoEqHvPQLcgeTCoL__KxiwZvRf_a5qxN7Pyeee5CDDzdLxqN5gXI71MoGimc1npYKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvFj0PkYdUOSfxQ6MOqugY_ZXzDBAbC2UbDdcdIVzxxA&oe=6A8C2559"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r4EH_2sl0QQ7kNvwFqmmUT&_nc_oc=AdomaGG-0dt-yZvXtD4oZ7H6HzWhM0TLIFpLsGj3ZmRDdROm96qbYtmQPn1x_dgarQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtGbb8UzQZQ5x5R0F63fGjEcIoahv_PvLXi3L26jYjSA&oe=6A8C3D0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
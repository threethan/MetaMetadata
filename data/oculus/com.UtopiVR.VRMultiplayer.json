3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgmzDJmym7YQ7kNvwH-p_90&_nc_oc=AdoOpAbrbYCqIPdSNrJPXbYArCOoEBjzP-pvQzFG5bdpMuJsOYD6Kvag_TxUmssuCF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nJi4RIP_p45PrMH4sVUHcUljDhtyWlgcGobB9_rEfJA&oe=6A04830E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEtxbA3xxVYQ7kNvwF9JT9Q&_nc_oc=AdoCOXg-v5IsZKjMxu0VP_mDFVVfEbqcdu7RGu4oXnOZ_aRzKvXB8nJL9ty3epHvUzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OQs6gLczq9U2uL6CHBEg3-w2-7tgfv5BctnACOxBwKg&oe=6A049319"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdxRj5VurLwQ7kNvwFC1yYx&_nc_oc=AdotncObWKSLuz-9TfdivWk0pQ0kbOcZ5HzGgAKwKs1zPz_vtTd0vhZb-3za_qoYDmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hfG1D3bbnx12DhqfP4mrCdUqhvxAjbTLavnRq4pyMqg&oe=6A04728C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
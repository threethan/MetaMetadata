."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOcrTvQvwKwQ7kNvwFJ1kqT&_nc_oc=Adp4glYMfmlVjKCH0ZJDOzSKL5at0cT4iBQKXu4yV7v8x6MIMM_iXe4dbVcfJvRJEzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWNHPXUs1gyuXODXWiLKvRJ-N6sldL0iGhlagmUino1A&oe=6A9985AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV-S8WOmlyMQ7kNvwEet6uB&_nc_oc=Adpu649Bq3HELBJ6STx92DdOSZmpSCslCCZ0dS_rk7ivKZeMuRyD1NqC1HiAXGuDx1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7SEL4IhL6LitSlRDEGr4P9tDEF2Nh4P-PTuiuWeOIrw&oe=6A996BED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW2PgRacCrIQ7kNvwFLm_47&_nc_oc=Adqh86o31S9l7NXsB7qfMvDY1kR0hx_Emss-MOGpwfAdeGI0p9_9xRY-u_LfEeMUHUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4qfJpY0gB62WwphX8h5GtAXmN4QQYKkCHulkIsn2mmw&oe=6A999C39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zO34oeKphIQ7kNvwFiJ77M&_nc_oc=Ado57WKlw75hUNtoKkK8dY70axsGvnnzTeK7pvGRs2yU6SIx_G-rL7mGUY22j30jjrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDnLurc0xOqLYILoreXadPe-DFMxsWpavUM_ujjZJ-Gg&oe=6A999246"}, {"file_name": "Hero Cover3000x900.png", "id"
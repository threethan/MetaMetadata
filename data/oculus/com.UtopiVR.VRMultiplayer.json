."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8WoirYnmNcQ7kNvwH-aMKR&_nc_oc=AdpnX-TMtR-Q55lUnytq9zxvN2N9UgIz2FUGyNcKnhy3j0ZGwOhQJi16truElNfpz84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy9NlQhvgjS_Koo0JJyv4eYpfNp4qzzSdjv4cbLYFfWA&oe=6ABFC12F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7zEfDviqtEQ7kNvwFOkHQK&_nc_oc=AdrV46LhaKaT53Ld7StjlPpLIMVqOWaF3rLh1apREBg6yLn0GqUd3sg1gZpG4OGYCB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJuhXSR-_sG-jDiRVhf24CFDlzZLEjk8ifmseH2yVG2w&oe=6ABFDFAD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZthZZjoz1HAQ7kNvwFBrtXq&_nc_oc=Adr6PaR_C2_km0nQNd3QjzEYF3o45mP_-t10GftJyzkw5lAWDxAl3lIwYvXXOZprhMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOso1lYPz7Y_HsWxSgLwgMCu9yUOvFwi9o-EnzO2FI5hA&oe=6ABFD7B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTYk3Y1DwQIQ7kNvwENezTV&_nc_oc=AdobDqaT4o53s6gf5bBqF-enLM79UPt7wJidDrdlX9eQ8rcvmnOCfOcj1maRpKgohfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzsaSuFZpHtPmadUFstu3W-yVy9P9gQt-ZK4QQd7tSBw&oe=6ABFCDC6"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCPG7mqj-YkQ7kNvwEZARYE&_nc_oc=AdqSsdITfi5Z7BhmyId9YCPpt5pI5LnIYNhBS-3oeFVRgCXdR7IfvPysvLdstZLgBNQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETSZ0HaPeXiw298iiF4FKCTDQa5TS1zZ47s8Wj8jWmMA&oe=6A86CF4E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X4cJcij8P0Q7kNvwGBJCt0&_nc_oc=AdpFxEPEQLNPkLSK_hNU9l9ORGv1tShnkQwXdVWIcCppl3cFf8of5TBOWD5Mm9Ev8jo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf0K6DuC99DXhpIee-LgdJZk1b27yP_jghAz5PvYZ3ZQ&oe=6A86DF59"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyCxG1GjXcAQ7kNvwFZYl99&_nc_oc=Adr4jBDuWtSDLu6GQ7Wr-4wc14nR2S-kFIAUahpRgszdOpIKxoFTg0bvYQNtl__llKo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSu3NNjShEhPo7DiQOWm54W7FuEaXD1JeXjJwTL2DwYA&oe=6A86F70C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
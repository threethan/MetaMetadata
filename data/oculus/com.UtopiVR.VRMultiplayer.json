."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJZqfxQZBd4Q7kNvwGeFpFr&_nc_oc=AdrrXgbAFOb_uue3iTYC0h5TvyqKGU9gPwawfQj22OHRxEfPK9mHA2A7z-hpE62pqVo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0l_ti_3mf82wO_sjTjXhuqmMnSsLT4iMLeGkNKWiBLg&oe=6AD0E4AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYaCxa04Bp4Q7kNvwHly8Vr&_nc_oc=AdoBZQSdvpwDvHVsWrpBec3vDX43Xf3a0a011O0DE5QUsp6W9ofiKNMy80JjhGRHJ7U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkT7iYQic_y69HRlhNsZa70fELX9CJEaqDrLU09Iwx8g&oe=6AD1032D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0x2kqttgkIQ7kNvwE_gsn1&_nc_oc=Adqwo43WrcMU6IQRgxYjegLu6OpitUakNwQ2l2JzkjatJ3wtnWfXyaVrgYZl24LtPJY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd9Rvo19t0R5USYc1LWwtwlT3lpn7UjGlNTOEJePh65A&oe=6AD0FB39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsK5c4n3fNQQ7kNvwHPdGbI&_nc_oc=AdpXJ_2POAaegQYzL5BGHY5QF4tywZ-3jQ3nPzZ-whSZTxhrWySwlAS2YWqlUudoE5U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDjmXBqjIGn29MZkjHi75DnBDhgE1vy-CylrZJLaN4jw&oe=6AD0F146"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pnIUxhOvVkQ7kNvwE-rW-m&_nc_oc=AdpcqmIt8ab6444Q8Y5F_93Z94zyyh_ut6CDAG6tkWc5NGjHLvj1CjghfynMh4TUXyM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTZWJ_dihd-SsxeVaEQkC6C2NP0Tx43E8lRqvkMPIINQ&oe=6AA16EAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C9v8ZfVM0QQ7kNvwHccVMD&_nc_oc=Ado6HF1aTu-p2npVH9oGKmF86AXtgYqaWdcqiP4geinh6nq4u0F8DoBBVvRhTel6Ch4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnq0RvkkclzDLRytYAXhBVM7690gza7SGOzGqnGNHBxw&oe=6AA154ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATxrTq8KA_YQ7kNvwFr9jLU&_nc_oc=AdoCuYzJMeBCmLzS36feO0_s2-naozpVEql5FabbaDkcaGft_rzxV6O7_O_CGe2tDRs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsCYSquabg_JkDMS5EOnSfSJgIZeXUOHuMbX_DE31R2g&oe=6AA14CF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1if3qdiwMW8Q7kNvwGKgG4m&_nc_oc=AdpnyP7_epr6Hk6s87GgRXZvbFmsMb83dYaFGKSBJ_hohSYMWh-qa5VmhQb5et1N-pE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEYrz7xBlAO0q18hMw7R_nPfsSQtNh_HWbui61hR3kyA&oe=6AA17B46"}, {"file_name": "Hero Cover3000x900.png", "id"
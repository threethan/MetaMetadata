."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSB6qF8iC6kQ7kNvwHocpA7&_nc_oc=Adqg028qczoxI7llhvR2tjRcyWWsO8SQr9X-k0fJEF9p43ZqYaDZndLvwR5j-Qt-1aU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBYH1zakDwxxiaoz2KNKLpn4AXaJgmz3Ozv89dLOpCTg&oe=6A7F27AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STSDHpfIRhUQ7kNvwH0GsEk&_nc_oc=Adpy8ifPT7pY9fTwU3eV7fCZb4IaviKYrEMq5YgejwyCt2jf4kB2a8eLW7qg1zD6QiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER1iod1yksIbk2AS0KGCr-d2POKO18rY4xvdZD-PKCSA&oe=6A7F0DED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkiu7_s5QCwQ7kNvwGGO_6H&_nc_oc=AdpFrVZklvzs3-uFHKmT6cibrPbPJnpkhpPeEme3GlgHddBbG4hhKzAeDEUJeU07k6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG44ZZGyUpBUpFC6G88r0n4OcDzd5w9IQLtbuotzG6yiA&oe=6A7F05F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7w6QmyPkg8Q7kNvwHv0i6W&_nc_oc=AdoiYeQegm7JuWL57m_LJUpX_MF_9DxiNlbV6ip-O5R5BpWFTo_NLcYDjHqksXicLzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMb-vchYsfAuzZGUxOgYQayS24vNLfqu-IniUkDoyy6A&oe=6A7EFC06"}, {"file_name": "Hero Cover3000x900.png", "id"
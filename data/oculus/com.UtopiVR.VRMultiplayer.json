3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fTk9BMwtlIQ7kNvwHCq8mE&_nc_oc=AdpJGEa634v2t3G4DYSCodYS3coW5BHHx1gmDZGAfw2_dXYETSIcUkT_wLUNm--jtNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Drwf1jgF6vdyS41AXgcGd5EvozBaoBA_DDN2p7PTy7g&oe=6A30048E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G2jUAbJXgUQ7kNvwFgLgJb&_nc_oc=AdqIpm9XvyqPlKWOue1tyOhPjiSr593B3H7Ag1HY7V-j20Mzn543HBcvETbICjlZ_M0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h-q_aU6gvuFxlKpjoPWteXf2vbJTPMzsc_nA8t5E0JQ&oe=6A301499"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgNyqEbhtX0Q7kNvwHwnvZj&_nc_oc=AdptsV8h7qiuXIxfITPz5tNu6ZAdm7xpRXyA_VDl9IAM6uZyMRYA-M9wjsLmeqieu80&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_saN-cL3wzhI16OczJ3ckVOmG8ci5ClapzI_84lSWclQ&oe=6A2FF40C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
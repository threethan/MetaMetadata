991"}, {"file_name": "Utopi screen 01.png", "id": "4303246779911211", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618351_4303246783244544_4805874035622876239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7d5ea575DYkQ7kNvwEgWBvO&_nc_oc=Adqw8swsTj9Y1gN6Lalw9i4KqeRKFkDlY1ZOaIKDXR6mYnT22q-zfNdDV3T4gkMkmaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4v6bhmJENaJYpWZLKqZ44IMCRB7LwEgD2Fttkb3pyCA&oe=6B085415"}, {"file_name": "Utopi screen 05.png", "id": "1670993150248850", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824532_1670993153582183_2928640391252588422_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT8KcPKfqo0Q7kNvwGZLKq3&_nc_oc=AdrF80sqXoEOQqoUAnY-_WCBJVsSoKDNZS6bRAVqKRZmg4tWjilvqCMMZzXWaBuFboE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg8aeLk8R5IZu6S5eGgA7BkVmf3LVl2slj9YaBjijaZw&oe=6B085538"}, {"file_name": "Utopi screen 03.png", "id": "1287060295777096", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830428_1287060299110429_7519371814019840060_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9feCjdQk3hoQ7kNvwF9iz9h&_nc_oc=AdogMfitpKFnIy1Twq2Es8DuemZAuxk3dsGmyBScl9otVORNkh_c5uMUmXls7FXiI_M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4rBfAZivcJOuk_m7vzhHJt9sxau698IwJ9Mn-WMKNsQ&oe=6B087140"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR School", "keywords": [], "long_description": "Long Description\nuTopiVR brings the full experience of a real classroom into virtual reality. Teachers lead live lessons, students interact naturally, and learning feels just like being together in one room. The app features an interactive board for writing, drawing, and sharing slides, as well as personal notebooks where students can instantly copy content with a single click. Beyond simple online classes or educational games, uTopiVR offers authentic, engaging education without travel, without borders, and with unlimited possibilities. Join us and be part of the future of learning.", "short_description": "Immersive VR classroom with live teachers, interactive board, and personal notebooks \u2013 real education without borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6gSBZ1LhW8Q7kNvwE_IU-0&_nc_oc=AdpIk56RzLgS-Mkq7I29EcBm82rioC2luKShUqk4zMlqhOOG9wxCje9p3zPq_9OOyM4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUzJjyxziElSY-WVjUIxCAJRX54Mqb3-IuQs-F0VTGMg&oe=6B0843AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J4UKwcM3qQQ7kNvwFo6pkq&_nc_oc=Adoyvz8s6qYgCnmsZurawuj7i56C_auttbwdn3RF3RuQ3V9N6HosK91naA0gjLbMhzI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGXAMBmRebH1E6M4n6yv3PElg3ThM6IXWe2MKsx0CIPw&oe=6B08622D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAniszj1OzoQ7kNvwH_ToYF&_nc_oc=Adqx1Kfa9cyfXcGo331QYaO5EstkbuEC8M_cO09qsnCrv4c2zuho__XO-xByJ1adY2g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgR9f0bnT_SYuDU-93y_YqQO4vUYOyAAsbYtjtlKisag&oe=6B085A39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/49
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDFRP2H5rEYQ7kNvwH9kBS4&_nc_oc=AdqNYb6wNJ65HC9sJO_k7uq6p8DHB5KFks1YUwSgTmBh9U02J1A7y_J_Xc-Y3ZyshCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRpgpqIvJnWqaCxQIUCZ0p-IA4S1XUrTg9vSK1f6gOXA&oe=6AA5632F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgNajuHKl8wQ7kNvwFnJN9Q&_nc_oc=AdpxW-7xDFfgoo--qJIKFVR0arlMowjXnr77h7nniBn62dqJdTSyfGubCAXsKUzl5v4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-9pPtXfEq300tIO31IBg_VWSlHmcKTp7FAeg-D-saUA&oe=6AA5496D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6bHLmxRVGoQ7kNvwGppW1C&_nc_oc=Adoy9RsU4SPQCMVjtgJm0mtxN9wdJuvr7cLN5tz8O5bdXn7ZDPJek8-M33wtmm0mEgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaVkqezrpL1VFnCvJmTg5FXm68sVeJi7gRKnPqSbpgKQ&oe=6AA54179"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaFXVQbI2uEQ7kNvwExfzb6&_nc_oc=Ado6_taQVGUX3qXBoReNh--cwpqy1unZwDdZuVmbqZbef0lCpA_Vr1ryE9nYwDtBKNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLGUoHIEBP7kEpzJ1m4isvnj7H5ZRLzlQkTke6mGqDuQ&oe=6AA56FC6"}, {"file_name": "Hero Cover3000x900.png", "id"
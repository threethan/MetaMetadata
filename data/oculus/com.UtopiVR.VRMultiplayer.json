."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjo6ysN_R-0Q7kNvwFHhPaV&_nc_oc=AdpM-f3-zu0JL0GU0-whgSs3nyb8A-D2fzhgvdG_3u6XOIYCmRp0XCANr8gC13bBvBY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EO5zy0W_oZyUZKjNTGmx3657Zba2wD-KvoFHjUaxVcw&oe=6A218D2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fnfk8YTjToUQ7kNvwETI3Sr&_nc_oc=AdoxbZK8AR8OHosl5wJCS0iU0AgflK996qFx8sBmfna9LP3lyCci5gSI8r4JC9fcPdI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TFwRcT7NBRoB-5SQ0Q_P8KCMlQ31JV7hK6zlR78uFSA&oe=6A21736D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYUb2HP9FWUQ7kNvwENbgPN&_nc_oc=AdrPpng-b6tYA1YLhvcdPZliiP3p0Bgy25fQDTgTTusuQ1uAGnZaU5KKXzuSnltB2Cc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aD5b8DpMLTjcHbGE2sUvsKuCwOyNF1IH29ACkMrXmZg&oe=6A21A3B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6HjYg3Gsl8Q7kNvwFxLhQA&_nc_oc=AdrIYe7GyWVve5TlIvzWZbEU4lZX7aYNvWwygHJbZi8BD5IjGC4tiXE-FL8qUgbvIG4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f4TdGG2LARfgtD90Xjpa2_g9SIfKELft57ZvGLGxYHg&oe=6A2199C6"}, {"file_name": "Hero Cover3000x900.png", "id"
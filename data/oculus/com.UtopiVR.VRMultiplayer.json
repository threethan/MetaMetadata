."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kW_Z5bTfKCIQ7kNvwFarzXc&_nc_oc=AdrzJGzRrJw4JDLdmQYAm1R6HZtCi99ir1vIXzgcht1qZLT22OWoceHsBIWbGFEAT8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEW9rSaLcAvovzyFTfYyvQqrwHHuUwf4f5Tbon6KcBng&oe=6AE4AB2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCjr_yH_e8cQ7kNvwHrrs2N&_nc_oc=Adpbu10eThMlps69y5RQ2NqTWggVk1u-Cmc1muvQTx4TACmVS1ICiOVeAGgp0sYsaac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj1VvEejo8XYOwkm8o3gYKq0MYDmTY7ucRr7-mEDpyUQ&oe=6AE4916D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WT9TtY0wmOIQ7kNvwGngEWj&_nc_oc=Adpniukvf9AQaA0NDMy2YONhisrQZA3-GDfGBzSbbXeaM_qJC344nFwbBsw8zSYSRpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFUPawKg8ADoseF0qNi-L394nkWkHQqYTT2NUyaW5uhA&oe=6AE48979"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq8ZUJbFDM4Q7kNvwFrLb1g&_nc_oc=AdoHinM7r1r0RlmXdH8t-SDXPQcmK6mLexUnbSa8d4gK3sxhNmiZX09BOTpI4auCo8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE8-NTcIvefoCp2x3Frb2taZ3KXgjg2iO0dXD-gU-Hkg&oe=6AE4B7C6"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUM77x4QeFcQ7kNvwEODp_A&_nc_oc=AdqgwuHHUQDAyFZMrLIAwkeP0HrQzgt4WvtG1IlSUsxwWKb5RiObZTCrCz6ax1Q80Vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4XXgIQTrJ3rOcBex0N1gL9eQMFROfikWau_uasPXBjw&oe=6AAFE60E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inn0zB4vx7QQ7kNvwEJrrX-&_nc_oc=AdpdjmNNwr4N085Ijt9JgaOdHONtSc5eWmq3IYqnmgCsJBeW6s7ylhUy2mmKYYvRw_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE27KeZKMUqQL7qmxuNaIc1BML1X5WxwIBSmI9WIczNA&oe=6AAFF619"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1D-LKUY6lxkQ7kNvwGpdiWy&_nc_oc=Adq3c96HXuOc6rJYza6oACGMHm7gWE7xdQeJuXl9qAB5UHoW1gIJBuXsECMvq-R437E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2oYgUykOPPwbkbmoQvp4q-s594yaH6CngsoX_IeulPA&oe=6AAFD58C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
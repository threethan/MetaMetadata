."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxOemum1AI8Q7kNvwHHcdjG&_nc_oc=AdpqKl-JDln5eBHM4o96nZSrOO3HEgng2vCVXXYT400uJ5im0QrqBSSTArIEwqKtEH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHi_jPwes6usE4zrnYKrCznSPmSXtm3E432PgHePzeZg&oe=6A9012EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvIJy9fPnPwQ7kNvwHsjnlX&_nc_oc=AdoA9ncPJBDbUYGuh5WtJ70pNhGPVzxWpzEttgrBbX-ZtjxLoSPGZ1JqxfFUwJn3wLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIHD9HDbLWD6tfTbP8Vw4A8MFZQMCrpDbxmbSY4waCxw&oe=6A90316D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEskUFzUqA0Q7kNvwHfqLK5&_nc_oc=Adq3WAm-g9qlrFd3qEAGsZac9kHU3FPi4aoSVTbPaB7vVodmEhOs9LH4YcANE3tGTnM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEpRCrSP9oljbaj0qtkdUp68VNVNx6yEUAx04gwt3QjA&oe=6A902979"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umN5My50PQ8Q7kNvwEAqW97&_nc_oc=AdrNFgPa7dpP8L9uaTaZfhmzDZxSVwiAZeUOsunnbNUsYJJXRuaowFiTs2O_ztCatnU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjlST7yD_J37zczPPN1-u5G5_1OhjxYH33XtLHYxw1eg&oe=6A901F86"}, {"file_name": "Hero Cover3000x900.png", "id"
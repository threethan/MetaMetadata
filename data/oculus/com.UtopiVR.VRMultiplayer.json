."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuB1CAwOc5kQ7kNvwEsyqkj&_nc_oc=AdrtnDk9MtLiQrVQq7BGQ1kcVwaTs6vhi1fUGQNQCQhUBqZfh7SsGHd9gPgVOZ4Lkj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H4T-syTVU4meYnHR5Iy7n2yERysus5IlfEi3nGuxYpA&oe=69FB51AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbSZC71aZeMQ7kNvwF-NCSo&_nc_oc=AdqWljPmltanWKMseO-g5VBQqDke1neX-yIRShihKo277QJtpAlWRtST5iPFJCXtNE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DvoHNau5nQGUp8vhAaP0NhAbnz-WGIjPbSRDRrRnhZQ&oe=69FB37ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cHYoW9kAtoQ7kNvwF-KjEf&_nc_oc=Adpbxvp25oqu4uTarEKkYkJBYC34dBEUTPcTZEW8lLlqwmtABXe3gCevnP3-Bn8yReo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57OOJJSfQRqgvAoyvKpWYHp9OLjXAPss1DGFOlHtO-4A&oe=69FB2FF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc6idHtRUwEQ7kNvwEb6U59&_nc_oc=AdqhYS0ujAds9q8nVt1R75fxftQndAZ1jNefYnQw5QCrnWRYlWS5_XgxN5a6b0IFbBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dEXfrBPlpCh_onr4bqAQv6QJLIrVFfty5h1lz3tVi9g&oe=69FB5E46"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itKwCFgzt8QQ7kNvwE60dJr&_nc_oc=Ado_JJ2c9e4Z5yeYzqzcXDWkMBMgya1nePqGCnTLO0tJnKbCtEXzzAGMRzoLq1eqLvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7i8bHTQGBv_gwREwjDjtIazNn2V-GYTdSw_SOtdqhCA&oe=6A3E8E2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbqpFHhgPmQQ7kNvwGN1lmh&_nc_oc=Adq_jkUptFMHjwcEdYu84CcTC34P-LZmWA587ucGgrHh1BQicNBw3KpIhKlwql5iryc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_91mp6mSFSfrRuiOce3qNn1hlZOzBYYgFebehbC_AlUA&oe=6A3EACAD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMIike1HAB0Q7kNvwEuDqgC&_nc_oc=AdpTjr52ggtbR1LYFTDAvPqpwjQSBN11rnsmk8G05K79R02leFSfdR0f2vZDrfIqy7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hGFZPig8UNbjHNqe7zL738dHERx0PChmnyngX3motLg&oe=6A3EA4B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9buxZk0ac7wQ7kNvwFxfvtu&_nc_oc=Adp5M9TIdl7aQ7Ln63NYN3xh4ucHvYuxXUL9u8ROr0VXtY2SESH1QUYg1OTpd7w1bCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-NymGjZDDsTsCyrLpGl3edLEzzvWDxktMJA34c4zYTA&oe=6A3E9AC6"}, {"file_name": "Hero Cover3000x900.png", "id"
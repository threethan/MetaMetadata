3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRJ3JtPvQaUQ7kNvwGnCUMp&_nc_oc=Adpj9RUkaEBZ4WaEYOSsiqHhvdwXm9EJpIiDQkmiFHexVDs5HyWQUkZTDATeqHxlyQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0XbGXhm9SXhPrj15eRgnqqAW0wPx5g1iqICnThGHz3g&oe=6AF7170E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVu8xinVtRMQ7kNvwHKypYi&_nc_oc=AdoB88BacR9asaio5ZuW6dBZTdHs6djVD4ti31l9mO1R8RVvoqfLrYXC1Fq3oFdlH6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0UaCn_UHR6x1Dw8iAp1Ps9LBWlp6m4hih142gw4wLiw&oe=6AF72719"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3PAQ_-s3m4Q7kNvwFY9RFC&_nc_oc=AdqXv9KLIkPGEu_tdIBO5foZg2zoGqJSzyKP3eHpxs9wrL0b6aCcKxXayuHjlL7Ljf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn4x5x9uz4O9eNRoM2AiYtioXHTTnY_lS3ckHqXJeWdQ&oe=6AF73ECC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
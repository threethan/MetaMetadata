."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-Xk_C0_4OIQ7kNvwFT4Xs0&_nc_oc=AdrN_ZSWoVT2aeSozGJAQ79p5BTK2N_tmgTnyNcNQGd1ms9_prHK-fDJlAY8xigVXs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO938S71E8flKa17uAgEEi0fNOHhx4rk2a0REzgbFzG7w&oe=6ACCF02F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syl8X-EG_4UQ7kNvwERMmDh&_nc_oc=AdpWcVCAP_EE8CRgLpbs_RAWvMszSVMc-J7esRHq_4CZjoBQJPoGv9xA1_BBomtRj90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYdZ2a89MkMDsZBWcvq1mf0kk0jIWZLo_Sxs-oM4343g&oe=6ACD0EAD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXH2AHrnZq4Q7kNvwEuWVaS&_nc_oc=AdoBN29_YJQixw2yeJkMafDa9A6HgXpW78ZBKcJ9I6GhnddaVZJauNoUTqR-9XttyOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhOC3ekwxPe_-SjcH4PI2hcYcuMd_9ztzA2lsx4jaQEA&oe=6ACD06B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMvZ7gxk7LkQ7kNvwFtCu5m&_nc_oc=AdoYOpGyO-tdr6GRhfsKyUQrR0SljNmR7oEqJd_jqRMbTa2ReKSKJsUbHpFpnxbg4yM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoZmXGpVsvnOhba30Q6KwFdjQMCyyY3UbZYT56ka0Now&oe=6ACCFCC6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKAz8pTcuLMQ7kNvwFn90du&_nc_oc=Adp56H_qdKn9mxbYWGuEK8J2vnXgoCKWyDq57ssXdgzH1FNbQjudonpO2Oqk7vLUN5o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nyNh8I6h9UMCVez1SSgUbtwt3jXYf3mN3N4lt50VeOg&oe=6A130CAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqJsw9VePLkQ7kNvwERaY71&_nc_oc=Adq7Gur1JVx7rEHKR996qwf3EaJL4QVwRuYd9yoUJ15pchMTjuZeULGjI4wyFcaogfY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z9AXDEhaUWd2k_Xjydm1HcqXzHNSByv7c-vwxNMz_rg&oe=6A12F2ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvLeBnCrOfsQ7kNvwG3mjBp&_nc_oc=AdoPd6kezjq5-wtQrrU9tZQfaR3Ka1VI7bnilnyNunDSLL2JECLg_j4KYqCUYbjfcaA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Htkx3rUP3VaSqWDSGkVzP1WyenWSMrc4jLdc6S83LUg&oe=6A132339"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHdhG1sZlWYQ7kNvwFIRSfF&_nc_oc=AdrexfMrSBVU4TBmWIdG0IL1mZUQIAgIOiMjCOyweqsokV2xJfhlOaOXV5YP2pa1KPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_2Gc9bLreuwOXzsZzFXGSNXsAf4iqw9Xl54TlQQi6Hg&oe=6A131946"}, {"file_name": "Hero Cover3000x900.png", "id"
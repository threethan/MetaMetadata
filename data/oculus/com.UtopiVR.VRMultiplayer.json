."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDFRP2H5rEYQ7kNvwGPWE5t&_nc_oc=AdoDP-h0J1mYVAkFLUrZ6YEMl3dRmiFY_IqfdV9O4yWZSe9okbe8f8VDycP53QSfyhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8WFHb84mKa19cY5LNBKQbbVxHs77iBqJ99t4IvXjRIw&oe=6AA6B4AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgNajuHKl8wQ7kNvwF3EO-3&_nc_oc=AdrSnj6s9TNfFQMNv68hIgKGsPpFjT_Faq91CYfYMmxdNz--sBVhIhmSiv9DxyTJesk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1NekBdcPECAxBjD0JRrOULDvoq1thp5RmT2QMs5AWOg&oe=6AA69AED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6bHLmxRVGoQ7kNvwHvBJDY&_nc_oc=Adrw8Pamzo1GggQ6qCoABp8Vj3mU1YXp28i1DmXM_9m2_0Qvv6qBvm3uznK_jQpEeK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5tx5-V66P376NEAr5Up274wFqXRi-XtnKsmh3Y-szZw&oe=6AA692F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaFXVQbI2uEQ7kNvwEf0Hnr&_nc_oc=AdrSNT9WpI-AlcKVwok8VZla8FhZn8-_sxPli1PlDQDZeya5HzgWDpkX1mYDviVXXAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnMBxL02eu9Tpe9dcHNnxKgSskMXv3NJr-jx7QgIVnLQ&oe=6AA6C146"}, {"file_name": "Hero Cover3000x900.png", "id"
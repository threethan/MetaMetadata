."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzukxokXQ9gQ7kNvwFxp8CQ&_nc_oc=AdoeQfueYkgwErePNrnB7TZKaooFGTSbTTtJekvHuA5fvOz7G-KsRLuRpDHgRUlure0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeka0AoEabqemIggqA1WluNUt01-ZnXKPzdkVj6mms9w&oe=6AF7202F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBufFfJmHmQQ7kNvwH_ZwzH&_nc_oc=AdpyjwRv5CmbutRnkxuKYfVYdVupOSgHDNbUIduvPD1sxQXt_wPiCaWjjUtjPg6Upj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmJKXD0gdDd1ZbWAeWYywzWqmDkD5fK_ReUe6KnB2Xvw&oe=6AF73EAD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPTSgug9rSwQ7kNvwEdrscP&_nc_oc=AdpfI5WuzclEb9ySWy3WOq1K_XNuiTHHevb36JO4qj1_8QQocMdv1qmq2MJuOJ1vyAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXdjM48-zqGuq6GRUHZug6Bk5QeUsAtfeEkvpZyrINPQ&oe=6AF736B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hbj103Cg7cQ7kNvwFyr4HT&_nc_oc=AdpSDzVZsiI4shdyTp60wIGnThyRCCw1QL8f-Qm8ZM_HS9SQ8GLLDsVDqijB7_Zz-IM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvrVqsDrilIRvbJsLAf2d5q-NfZ2hGKg2m8sGWTLqMFA&oe=6AF72CC6"}, {"file_name": "Hero Cover3000x900.png", "id"
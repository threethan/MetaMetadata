3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WQiAHj85rIQ7kNvwHhfH7V&_nc_oc=Ado8xsf_RPl8-EegmGmpUfnkmRClKf-kkSE0YudtQYNOhyLxQb0dzS_XKGtvccUciIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWx9TGUqaMPk-Jor40XFzHyluHB36gCqF2Kq65KmA1cg&oe=6A6CA98E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiDFCuxfr7MQ7kNvwHcfo6Y&_nc_oc=AdpU4W4DobnUA2TLuyT4asLOmR8IILz-dRCAB_j_z8tct0GKUttpNtPXpdgMzaouao4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUCiCUKthHcprl4C7CO8fnlGlxPx_5Lvd30VzL8P2Oqw&oe=6A6CB999"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lRY6ymKZhwQ7kNvwEW2c9a&_nc_oc=AdpKSoR1Rphx7f4WlOhhpo94rE-Zf-BE1w5v-044kdwonMrxOpATf5Fxesma0nIKgZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlyOQQyPwRBDdJQjqB6ZjiN-6cYuHnr1dziMJ3lZAioQ&oe=6A6C990C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
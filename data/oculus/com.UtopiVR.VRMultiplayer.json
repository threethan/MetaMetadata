3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMnOfoR29zgQ7kNvwHWrJsN&_nc_oc=AdpIUmxtAUSB_Q2K0O7VQYMVlo3dUyvjY9RjmLYbaBHKS1W2I5TgTNLEi1omf22zZME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGITczCC7zBcL-nliykEQVQmm8IpMDzPxkKQrX3AbTrDw&oe=6A95C04E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXEEwDxCXcMQ7kNvwFayAuI&_nc_oc=AdrHsqHEns7jwmuO4hWlHso6oClDbq3xxZM8u-IDx-HMl22c-lSV4xP9CpqNU9KqZI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCfEMA3V_DuQFAYpZZfS3dXIKyB4wMWd3VOluAYjmjJQ&oe=6A95D059"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JfF1SyyRAUQ7kNvwGEpZ7X&_nc_oc=Adqv7wF1JNeue7-tf5-nHatA5RDXIKXvTdm2co-9_liB40wLPpmgZ9l77iBQrZZSuZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeuNihcAkQKrMlr9ZyIdTYnQE2CfO0si8U_StUl9uI_A&oe=6A95AFCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
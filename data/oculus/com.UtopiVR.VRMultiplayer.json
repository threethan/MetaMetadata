."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDTkUfX4zlIQ7kNvwH_thK9&_nc_oc=AdpYnHlUSTO2TSMXYpnN5h3WL--7sOabMvE3V07V4nedfjqvoQqfugEgZUZzvKF43nE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbxTO3MdF8iC7GyRqGmKL17Y_d_Wk1i86Bkrbur0cpSg&oe=6AA8062F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgNajuHKl8wQ7kNvwGUFXw6&_nc_oc=AdoPdq97DtYorfsiWY2ejRpk5s6dMZAiWXc4fAcEN9KVZYxwuPeG32Rax0RH05G2WnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjoGSnZHJeoCQAGNz9mFn9WT1TwTNt6pc3ILPfqD-KxQ&oe=6AA7EC6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6bHLmxRVGoQ7kNvwGzuE4e&_nc_oc=AdrvpPLZnWdVmLUvB4HMqQpUJHDfTagVlzV7K3S3806BqIklnxD2Aepowz9IDklsgWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU3UXxz6JZO_XstplkvJLyxJWZAi7L0iXZV3QNxa_KlQ&oe=6AA7E479"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcVsylGK8QcQ7kNvwGDGsqc&_nc_oc=AdqBmHWzOaUG_OUYxEVRYF7rhhlooDtTvSQKr26Hfp5meidY_z2Dt7YSmkU-aseh6b0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgI95rhExkqRwLUFXUqSOptFxCY-THJVQEyD2x_p7fKw&oe=6AA812C6"}, {"file_name": "Hero Cover3000x900.png", "id"
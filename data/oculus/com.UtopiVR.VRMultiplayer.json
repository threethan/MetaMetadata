3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2wi4vY9VIEQ7kNvwEDNEcP&_nc_oc=AdrfiZam_fzLkMgpHrR2DNHPbVgxBYS5WfrqjwzvJfZI7yoQcKosVN7sTG_yy2tJdVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHidLtYoBNCW802zpeICS-mvS4bbofBS-ax84J6W2qFA&oe=6AF07F8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGhBqmR4WQEQ7kNvwGslTRm&_nc_oc=Adpk_KH_SH1Kg5Snl6CDSdp7dTJQUM78JBd0rSfMowmud41uC9kafywWhsOWTeEQKAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRwoVXV1Xu8bKdutlpjKS-ElxEmC655mxTRur_09CfEQ&oe=6AF08F99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xChbWN92h2cQ7kNvwGXWWW0&_nc_oc=AdqUktqYMqzmvlw99GH6pirXq-NYVptl74XqnJVtBbJfkQTlL6plKl33nKJp-fgt8ww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLYEZpZ9HvOamr51Q9K3FrWJWBOaA0OAHcRdpAqB9VNw&oe=6AF0A74C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
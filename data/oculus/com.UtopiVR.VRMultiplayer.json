."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek_vWOsx33wQ7kNvwHdMpI_&_nc_oc=AdoLRm8smcqwxYW2kxvJAV5FkbZrWcWIJqsnGOwxMJV4BJooTjKDJmtmGT3UQRa2oxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3SsqOv0mHW7MflItCpVKT4H76hxXbRUHwwR1oiPB0hg&oe=6AB140AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv6mfp9DOvkQ7kNvwFaRSUj&_nc_oc=AdrJV1cau2gVTs2677mdBvZ0UpLkKnhigELNEHYuGNx8GiBaPHNOQTnmBin7DXfMXF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeMo6oYbYHWU5jaS_B5W-Ajcbf104Kf2i-LeSA0vqJsA&oe=6AB126ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YPeJ9XZXfYQ7kNvwEy8yrR&_nc_oc=Ado94LSe8Bl2_fGcsyD_bYyIOqghQIoWOt46bnMMTEWLkgaTNiNBFa4CxMKkdMpeVjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5pv9HQ2ZeywspVYAXIRegA6srkcGlZwRxcJ5dt-Tz0g&oe=6AB15739"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVP7y0pgzZkQ7kNvwGCWC6p&_nc_oc=Adp4omX7Vo4yCmYTaO-sWpxzgxfkRqlON6W2ZEOarOD4TnlEJyh8nsr0-OjtnzNETgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYmGYXog2HOfYzZXB-jNdv8sxPCUQZaaWG2Br3lj1RmA&oe=6AB14D46"}, {"file_name": "Hero Cover3000x900.png", "id"
771-25/499617693_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yvTiVxnVC0Q7kNvwGw8Bnt&_nc_oc=Adr2NMGKQCV8H0fw1YkGBxhn9ez12r0NxpVjhcwM4QhDRxyY96IaEfKZTVnaAb4PdEw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOZ2bBNh8CJfHmOCTOzdwaI_EFVD-jzyFMt_9E7GkKBQ&oe=6AA94E8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0OBGihCffMQ7kNvwHISSM-&_nc_oc=AdoIz2td_KaUHVo8nU4apVvWirExui-LusDRL7aUIb3u6ZNoanygWlL6tlkSKnukhPY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdGDU9C3GnUs9Aw_q-tZtrFDfQBqV2CyZ2cKiYXoIW1g&oe=6AA95E99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu8Z0vUycYwQ7kNvwF6xKmI&_nc_oc=AdrnumSlsa8PXAYvZcZi7gisBtGygoOZLwRWlQh7Ne4tvT00W6opo3radtyogD6H3Xo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnqU98Dh5tBR9OlXRq0SDnOAwmYT5gvKVFAuqCRBIMsg&oe=6AA93E0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, be
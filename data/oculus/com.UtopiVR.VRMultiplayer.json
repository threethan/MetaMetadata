."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7OzpuEKsfQQ7kNvwF7Dado&_nc_oc=AdrmQaLjqgB_N988xAP-Wldc0ZcQpy72ivhebJ4CsZY48ohVyh3qH5aN1YOV57G_E8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93hiDWmk6rRr5vZkdS-TIbDmbcAnT3C49zZeE_7c2Uzg&oe=6A2D6AAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxLfMd6XkDwQ7kNvwFR0sGr&_nc_oc=AdoNPY1EdLPAPWbGNuYJyFHsOM-OZJJ8d7IhVeZkiDPwPe2KIoTI_l-Lp-qXzx5VVnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4WmKVlnqcXjDMMNL_O_83tnievXtqa_rAi-mjYb9Fvg&oe=6A2D50ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdct7azlZpQQ7kNvwHFRkeO&_nc_oc=AdrME-xSq0dx_u5p4Pj-MqALVNNR9BoSu0rqIFuH0nMGwgiyaBusRx1Nrk21WIJ-9wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80D953lIPNr_baE5HhFsXG6Mv7Qg8lK6LSNA_VBCx4Uw&oe=6A2D48F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiOcCJpJ0NEQ7kNvwHze4Zw&_nc_oc=AdqlIOI9RJpK8kaJgixthTAConM1j3fxDzRdtx7BPb75jE7soXDpK8v1H0vyYkO71Vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JO9uAXB8FZNOS9lx8jKN0UgacXSNxZydb6-oXNygA9g&oe=6A2D7746"}, {"file_name": "Hero Cover3000x900.png", "id"
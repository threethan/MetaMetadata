."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq15TWMnlaUQ7kNvwGBG20p&_nc_oc=AdrYUCXG_QfxiDXLbY6tlpbOJVlHZrXS5RXug1czBZbYhhIhP5ebvu1SLv3ktPIFWZw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5XXG0LqzwjbH-wCsia8I51UirNLpCdyiq4qrNSFZ6yw&oe=6A3553AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hx9Z83215pQQ7kNvwHq1GBr&_nc_oc=Adr68I7sYZLT555sI7_8An5WRLclcJmfC8MjKtGsXXkeR9hrrfjF4i2zp3noELtcds0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vOrQcLsCKB1SocQ0wQdpfBz68c1jV-2S7Hyy6c7lqEg&oe=6A35722D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY03T2n5leoQ7kNvwH6asPl&_nc_oc=AdoxDASfnoG1hmItGKcn5rqxDzkcaSqNam0GYYfRPV5eT3UDWGgB9vOPaoyjZmJ56Lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O0QuTx1hvcEDcz_rpV6Slkk_OTPclOb55J6aY1TIEvw&oe=6A356A39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GhrQyitJycQ7kNvwGsU7Jp&_nc_oc=Adq7CJ6wtdXxUwzvFYWCEnhHCf3Vbyq1g-wjhGHQLIcERLU2mmjYcRQRKt8R_bsPP2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-tKFxMskGa-w2j4WEfxDWnVHSXfP15u6qGcb6E3iviQ&oe=6A356046"}, {"file_name": "Hero Cover3000x900.png", "id"
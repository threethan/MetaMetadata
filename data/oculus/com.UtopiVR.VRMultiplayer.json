."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNdk6uBd5EUQ7kNvwE3FMcz&_nc_oc=Ado36qpAqCtwnqXoTmn6wQlot-9CzDvVcvLhijDnuC8__czZcPwB3XjxHsfy1Zjhx2A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd5oqMb8xBGi5iWWPO9iAZkCod3tFeCstFLVtd0kIKaw&oe=6A71F8AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgkysdEg7tIQ7kNvwFk-FK5&_nc_oc=AdoyTkn6SCnsTcQoXDiUY-9Z1EoDccYGcON3KSy9i1V_h-W36nEjEScwToqZx04-ytk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6j-n8kI6nMYuvlNIbMRLeBc3te6X5KV9IF7AIqihzsA&oe=6A71DEED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMc3kl537NcQ7kNvwEKP31m&_nc_oc=AdrQzdWpeo2kX4mpgiDXO5u6euBino6tjUzeI4ehf_Z0h29EHF1aMpUAQe5w_8DgpxY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgr9U5abEI_sRmOY3xpErWuWv0cmai0TRKyyZgr0ZlYA&oe=6A71D6F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OsJ2Mb_N5wQ7kNvwGZNiSa&_nc_oc=Adr1Ky3kX1zSk4Kfx4mFiEFxUgk7lFfpcY5JE0ZbyY3AgmpopBqvhlHywD200qDgv4E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyRzSB6rxT5HMWpUZQZ5YzsICwsFUVMXUBbwvmA6qs6g&oe=6A720546"}, {"file_name": "Hero Cover3000x900.png", "id"
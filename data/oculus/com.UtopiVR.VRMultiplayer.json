."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YATPeaBOVYcQ7kNvwFFNtc0&_nc_oc=AdqKs7IkBvfGSVv30yN7bFf8gN87AHop_LZ0OT15Q_du8RyV1zBIKoI9_nIyT3q_9FY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5nYw7X3KNivuALegxSS3ktmdyRcjjlwkMddvGEptjGg&oe=6A4E602F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL5VnzAVneYQ7kNvwEuf77r&_nc_oc=Adq_vCJSeUpox0_6VeJVyTSGKMck2ZjC9QEReKTvfts0PnDD0kwuj76nbJ6hAqsDXnY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn34vojlnCvYyAkOueEVAoxOzlrB__S-I1_mC9v2AEkQ&oe=6A4E466D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UldEf8Eh1vMQ7kNvwGR4jTt&_nc_oc=AdpVISq9r4z5JNZ__lVlnhwZSyba0F-M-40X6B2E-jodhdDAoa2NyXEcRttfRw3eEzA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADYgOiospixHtlZ1iJuUKTabrG68nz3KbZJ5wV9liWmQ&oe=6A4E3E79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlWnP1N4NcIQ7kNvwGR5trk&_nc_oc=AdpATiwiyryugLkosPST6x8c1SAq2CswoSaB3Y1OW2_z6c87snQ6QHNGbd2VIsVm6TQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARIDvZtjC8Y8iU-0qNeAjTmbIeAaD1kAej51c04ogfQA&oe=6A4E6CC6"}, {"file_name": "Hero Cover3000x900.png", "id"
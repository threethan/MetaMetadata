3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycC_h8XoKtIQ7kNvwGsHxCy&_nc_oc=AdqManTy8408H0aKhcfhG3oc_9cwj20xi7yK-5wh_Gc4xZRFhi43qPF-qbfBQAg3S8U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6JGQ5VGxoXTDrvVjcMWsaqOKEfUKxTpG9uZwQXl24YA&oe=6A50FA0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cyD06YdmMoQ7kNvwFMwkZF&_nc_oc=Adp8BpmoACLprBOB1fpZAVhRvfmIDVdPKGjl5EcKOXsV9Z32oj3VrJUykG0IMamb8Jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxjr50AStd1nYkcKKzjvckz5u0tsH2aWOJAD4pEn_AEA&oe=6A510A19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDPKE6SAt-sQ7kNvwEwoXxS&_nc_oc=AdomaHfbO5-uUlaTyUKCe4q2OSKmGOak4geX2NSYAReg-eWU-pPfUxtuXIbKBEI1z2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKjoNPjTeYd4qv2cL38yGKogD2EzzOfq53E1OgiFIhOQ&oe=6A50E98C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
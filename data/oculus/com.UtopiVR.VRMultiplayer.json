."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxOemum1AI8Q7kNvwHAevZH&_nc_oc=AdoKY6jJFY-iocjsFikJ6rrxajiDaNKkWhbDi3VIUIm41ZeGusV4MEY-bIY6TVoOoNE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvrWmIuxVxK023UXkabhzcbyzFgvz4c2_WHEDQ7FxkNQ&oe=6A92B5EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYh_EporL7AQ7kNvwFPEwTx&_nc_oc=AdqK6RRVGYAMPiOAQRKI9oux1olDDDpUPKX-2da8bVbiRnCpim7rBbjtcPPcYzY6Hio&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7GCLLSmTEmep5_1yov9QscK9_PDh7PNk08R9-QURVfA&oe=6A92D46D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_PnuTxsg6wQ7kNvwE6Ilgb&_nc_oc=AdrUNGzr09Ml8uhgds9MDHKessH_2NNAAXHTC9cQJfncIs5D67tTlDo0y0Dib5awz4s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZIr-kRGswclm-CScq8G7xo_ZZwvUR9O4EcfjOibhDyA&oe=6A92CC79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umN5My50PQ8Q7kNvwH-pEzm&_nc_oc=Adox9qH9SKt98Pcv_6rwZHbGfXz9AUaorwh4V6hGX5QnIGRxf2cOloaoZ-Cei8RSjww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBfhhAWH-Nr4zpI4fwFfa13Ky6dlp3dX_O0uHg-C_qHA&oe=6A92C286"}, {"file_name": "Hero Cover3000x900.png", "id"
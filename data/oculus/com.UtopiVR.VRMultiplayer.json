."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtxOqrhyAeIQ7kNvwG9Vbpd&_nc_oc=AdoauDm49QN6dZV6dAraRDhat_YbP_VlwR01cFnIGilL77GAHHqce7gCxuG9Ng8PsPQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGzDaDsmGQUi944EKAj1oF73fAm0AHLVQ2P-SBCVcsrA&oe=6AB3E3AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv6mfp9DOvkQ7kNvwFGL-L8&_nc_oc=Adq4bRm5ycTQ-zPGrUvR6FugQ6msAXotmhFH_55d-4ZcC7vXih0UCcO07W10r_Ffp7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvn-HLGmvIMkgOwlib8khp4mTDrrPoHrYBHZ1uKQotTQ&oe=6AB3C9ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YPeJ9XZXfYQ7kNvwFiE4jT&_nc_oc=AdoUxATKV6g46SaAmDh2BFbdg2O-oa2vxurnxb-BPKoYzUjthcO0DcEn1NTaF0kctwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH5UAwYK4hfsxOg7dMJDVwCFXc1SoI6vjtyhcYNQ-JEg&oe=6AB3C1F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q67W2VPVfsQ7kNvwFIrpZU&_nc_oc=AdqVJhVLv0lSS8cM5DojFNetwbxKBLtC9v7OyiCvnlO1kpxMVa8NcyZzAqAJjIck9_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe2ISMmgiWRmlxoaATXim-JZ5fNfQnfxH9eaHPOD7PLQ&oe=6AB3F046"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM_pLofuTfYQ7kNvwGx0bZ3&_nc_oc=AdrK6MT5YwjnG6OCeGGgP3OWFCrbDmgUGdenumnuYXU_RbB7SV8lOjCkOGO57h2zmXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDteBk3Y1mijdr3gmIYjTfARgiCs75lr5p2pnmWTnMRbg&oe=6A6F4C8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBhXxe1AkIcQ7kNvwHS49SX&_nc_oc=AdqKYQRvnTnPl-M0lYLz4QeMlHEkHJf9xBf1l1rLyZsaXbj-xGNYxUDouE3LMR4m8BY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeF0AQJPu2SQjwu9HZe2d_1SZ2zU0srw4A-H-rIk5DDQ&oe=6A6F5C99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lRY6ymKZhwQ7kNvwH2fnsQ&_nc_oc=AdplAIrlLeJ_sQtFXYVBzPwRNezV8cp0svQGsWOV7c0FIfkIUIeyGr8cKyFzP81jtT8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjCRp27PitAOPbqAR-Pym_hDz3E89Jz6x9y4Qm_ChMmg&oe=6A6F3C0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
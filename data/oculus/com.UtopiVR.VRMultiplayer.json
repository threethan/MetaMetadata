."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZAqVrVjrgYQ7kNvwGkVaqB&_nc_oc=Adpg9it3ktDFLFdydEMYD8OTBiKFgtqpkbFPDQd4pCbhR1g6qOOsN7huTyzCVQY4F_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l-srB9bPXXr03bbmENdoT9-RIUvLA0M-Ca9hbS1YHlQ&oe=69EE22AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXmlEznrMPYQ7kNvwEUzuvt&_nc_oc=AdozAFNcgE8Zj3a3hHakk4ridkQE4Ek4G1OZVL5bbfBVevr1OLINeGZa0PYvAbW_lVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DoUgm6uig8nWLunxquaYhXQpso_NpXWsNovxF5oQirg&oe=69EE08ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUmdesrtHFEQ7kNvwHk5oZK&_nc_oc=AdoHNAVflm4nKxXSZCM_hTo70iQDsYKdObOmmSN0prPPxzDJ7lF5sNY7OO0dpXBg94I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KawNNIQNH4gQbygWKai0Hu5MvDhqDEhpSfz_NsVFZJw&oe=69EE00F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78_XaqNvW18Q7kNvwETVV-K&_nc_oc=AdqU_KB713CzczdL_LKwh-9pTBWu4ZB5E0w3qxHGyY_T_QPM6xUGjXbdrpxCb1mxH90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pd7EdsfCNnr6YIVyAYDmQeIgFzD2XB04vJE5SjLndFA&oe=69EDF706"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSB6qF8iC6kQ7kNvwHikqJI&_nc_oc=Adq9fut7EArtpBHWZMx1ZRtwzzLDuIcwqAfDkAFguwEtR0PJRBO8YiB20I7ql_4DM5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc6Yf67JVxBKRXh4xhDfhSnASpLLXarrLyFzNG5el-aA&oe=6A7C4C6F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Jg4CJZnWIQ7kNvwH-jDMr&_nc_oc=AdobXl9pN-wfSpeKfD0ywMc6-ZCC797hnYEEaeOjbiFPOLmF9Txaw7m8DQ-2Vht_8gk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGThkOvOEJK4uJOY91kf9ORtJx9jP1hwa6YnKuEJz2l5Q&oe=6A7C6AED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EFikze44EMQ7kNvwHjabPt&_nc_oc=AdpIEdQo5RA_x3MDN_VCjawRIEaO3LnnCV2aZnT16oWjXWRxEBLylY9HNeslMrB9rRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu4E7TwgWfCSkLXXqRoW2ETSR21StwbyeJarDshPlDsA&oe=6A7C62F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7w6QmyPkg8Q7kNvwHxLsud&_nc_oc=AdoFNuQHPSGRjE6ljxrIBOaghhcZD9qa4dc35poZwRh3farWrE8vgyEoDbjYb7oEN94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjQVQLogIDjz47buF7BHzvqP2ZAZq4tReRlBXHIAQcMg&oe=6A7C5906"}, {"file_name": "Hero Cover3000x900.png", "id"
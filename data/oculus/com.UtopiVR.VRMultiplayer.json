."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRIYgO6oqnIQ7kNvwEcF7qY&_nc_oc=AdpiEtSZmpg_MIXfq3LdrPbvALlrpqJbD4eGOWu5jJqKBiAjb_dLDBeMlTlqh9rw56U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-9UwPMLcMfW0bYZPhzvkMYFrac6uQfKM04rw-f72RuQ&oe=6A32B0AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hx9Z83215pQQ7kNvwGHwP0a&_nc_oc=AdqbSGBQhvBaWXo1pwRVse7VnmqPLaw44y1jKA1nNGp4IPAjFbN6QJWfHciHMzQAqbw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kHZw6i-_LV9t28c3l4OQmnTs44tpsaPtVArVtXXEgLg&oe=6A3296ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY03T2n5leoQ7kNvwG7BM72&_nc_oc=AdreGCURM57OdEXXt2tPWT8dpYNO7L2YyEIY9HjQHtslRuDBoGwX_pQZPTGgUbfCZas&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zpwyeIPjhS8pf5ZU4vFrhDoC-lINb-sPUXVLy_qVryg&oe=6A32C739"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iteYfHpIvTwQ7kNvwGOxjzE&_nc_oc=Adq4TW8SBXGvfTLoRg1s8k6u5xF3eEXq1hr7ePfPCjiz-K1wYXiP_ykyyKoiQniRciA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LMrtW3K_yPU_nULSkBl_JjKOtmWOM3-RgWG6ei_mHEQ&oe=6A32BD46"}, {"file_name": "Hero Cover3000x900.png", "id"
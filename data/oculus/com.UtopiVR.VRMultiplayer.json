."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EizmNlgVjlcQ7kNvwHN26hd&_nc_oc=AdqA_3ULkKW3gvsytF6FiNrfnQ4x0wlAGpk-cgi2x5HBrK4BjfVDe-LV6pNKV772eGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU6sl8Bj222lcwaNCllpSibilAnu8EwyhTGLSxRtayWA&oe=6A5254AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U72xFpQaMzEQ7kNvwHcmLyZ&_nc_oc=AdqWfILOAGIrEaWrWZDnLLDijVn_XtXwGeQax3CV0Oveci3ZKq_9MC8HncGyb3-6A_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRux91cEzCHRIRh2bf3kEpVu3eqoJvRwnUR8Y0GHToQQ&oe=6A523AED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gb12VPAUdwQ7kNvwGTFodD&_nc_oc=AdqwofBCCyL5xoYJpVeLnvQNj4z_H24NdzS5RU23vvhj9i7pPJSHXbrpMwLl2XRmzXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8B9oAs6omkMXrhPjYt_CKxz-UMvPZg2m9OrxHBAUjww&oe=6A5232F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWOBQPZD0ZsQ7kNvwHSjyaa&_nc_oc=Adpu-K8I_pXMzqpM5WYSHeiortLEnKuqIY2SRYPX2H9J7cCqKcngBQLFfdmT7s1ygsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgpAialdWQL5FxSpq-VuwZKNqGJDKo6yVFG3I-YBf6oA&oe=6A526146"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZoSVDulknQQ7kNvwHcjNYB&_nc_oc=AdrMY7KUUHYjMNypin4L4-8JtiZepfMfufxJqqKvf2vWEKOcKt3cCO0VxoNliBT6vt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MnUs6-4WdfHEMcgMiNLeP68jt2dxrYTW7R_funHN9RA&oe=6A3A908E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuwT2yWzK1UQ7kNvwF08EC0&_nc_oc=Adq-17-XL0OE0MYyBfEXcCD1-caBqyDgg_t0SHdr05TBM466iLPtvIneVugFWPXkz5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MN2_MmI3fP3YvA5GwK-nSNU3S_cQljNEpP8eZd1RQDg&oe=6A3AA099"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n1gvySo1RkQ7kNvwH0W46v&_nc_oc=AdqqRa7WBe1uCJiB3evdk-oHerKx60jyZm04yU3VD8FoJGgw0v3EXDLNfu2mxPUxVFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LfHkf5AjAz5yuqS4ZDmaMS-_3pGUYRpPCOujziz_ofw&oe=6A3AB84C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
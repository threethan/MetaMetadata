."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjP4Ok5xXt4Q7kNvwF5zAkn&_nc_oc=AdobA-QQPfMd1f0yiM7QUM4guh9cksWifKstXG9I6XYdJFx8F4CVDCF5csJ0gn6dnk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScKDmZYWc8xfeq_ECr9u8wOtSAIu2D24TfjDhMeGQohg&oe=6AEDE5AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qybnNRyMXWsQ7kNvwHO4jVU&_nc_oc=AdoiobdCkCRVTPFHNt_dDwIarszN4QkjxbW1UFQQwe6o-det7WuU3as0LaZkhPzi8oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXLc42tAx8NwcJSi5lV1kd-Yzs0as7in5kFbRUvgmjew&oe=6AEE042D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHLnIP3gBpgQ7kNvwFuMRLG&_nc_oc=AdpFiSx0ZLI055wSQ3MCu66SGRhTpznGG7Y4sGIf0xM0P7JYdIDhePD2N4C23A0oi0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3jNo_g8x8amRvg7oIVYR2TKhZ1GHX9mqqtQwpd3Y9VA&oe=6AEDFC39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7pv_YGRECgQ7kNvwHEygrr&_nc_oc=Adpf0J8hUPazLxzDAjxMUF1FMS09L0CBzBoo82Nt7sEfnj7rIpqNIY0ppPBoguT17PQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbP-VgfPGDx2bNHW6S5PNOlfz1GoZGbTJ_WNNmhPxyOQ&oe=6AEDF246"}, {"file_name": "Hero Cover3000x900.png", "id"
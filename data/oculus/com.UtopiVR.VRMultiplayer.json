."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujYxEejocrMQ7kNvwFaKLYf&_nc_oc=AdqCmaVi0RX3cWye-KQzI0dXpsrWBDdxxssdEGq7frzvey3yIyMzduLqa1BDFYIad7A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvUiFPRK85kVilsDLNJZjgJuL2sCXqSpXpVYMpWztwHA&oe=6A6F55AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOsBAd4VuKIQ7kNvwGAYnF0&_nc_oc=Adqdo_bVIPj1aac2QQt9XOCAM_aIRWBRkunF0RqtxB_d6F9WDVY8tm9MMrax-8Q3dyI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4s1-BT77eyCgMlG1C3rn6-dqFi1C71B_CJp-SC86B2g&oe=6A6F3BED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X3QothmvPQQ7kNvwHP7Lw6&_nc_oc=AdqZe81kg9bFj-oj9o_bIFx7NjlScLB4XZ6I9aWG7I9TfotygZax_r9hTy1nFtR79QA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpYkb3F4HvAO-3uMNaOT8wLM__QU1Wq2DTnLLYcxqOmw&oe=6A6F33F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHJMi-Zm07YQ7kNvwEmrXm2&_nc_oc=AdoscOPhSnnzHdmXiwRTRKLotCp7ZWlCu32Pz6tBlU2b2P0SJFNNKF6sBy9AGmHhRJY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjU43THPpDcHBIVyhtMx-wQ7ULE9J8iTUYbTAvedxiDA&oe=6A6F2A06"}, {"file_name": "Hero Cover3000x900.png", "id"
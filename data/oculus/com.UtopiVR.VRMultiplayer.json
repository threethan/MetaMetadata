."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g50bR8wgPUkQ7kNvwEfHolt&_nc_oc=AdpApAkrulOkHmKX1GU3PxLIucHQSxLirTfcqN0pHYJ8FXRfpbXN_3zRAFVSPxfldi0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3X7tWADo8yiUyx2BOxcw2ILGYgDCclFwU3axHmtMNjmw&oe=69F60BAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOSTubHOiqgQ7kNvwGDTVRF&_nc_oc=Adq34LElSHlcjpKuXLnH3uycb_7lbUoKBr7pu-CdHSrzqhFEHjfboJlnxKcSq2ln4v0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZuDWtj8akE7SwD4LTLMkCsWaIyCqKhguOCKoL_jPmhA&oe=69F5F1ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_9H8gcwsOcQ7kNvwGMGiKL&_nc_oc=AdrZCShHQIEzyARgKvEPWaAhoDhrYbdBZxC5Tjlx8U6PTiFRXS_-hZdDUISUO2j-x5g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rvTIMcjILxYByasLB4mo-KxniC_-ZEnQsbaiO91m4hQ&oe=69F5E9F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj4Yy86QrPwQ7kNvwGCIQ0g&_nc_oc=AdqHC7ybK0CogQo9c4jvD40LnsHYe0fWnmTL8IZkFU0gWau-y6K6S1w0ZsNyEooJpwA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04dZ_wC6nZC_6I8VxXnJXKxHmOQGZpw43tJMwn_XYVmw&oe=69F61846"}, {"file_name": "Hero Cover3000x900.png", "id"
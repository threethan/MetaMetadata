3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtVwJh1z2PoQ7kNvwGoi1pE&_nc_oc=AdosJiOH23qkZxn1dHcXz3CDRONQZIrgQSuMoVhdh9iq3vtkOif5As3fM3R-0fTetw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOonRVcF4alQ0lpXHtGlbpxBZphmSzWTTWWNvo7dy5mAA&oe=6AE0AD8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSV9HI6RZIkQ7kNvwFn5_Bj&_nc_oc=Adr0OUXIVW0fQw4p_LupFNBX5IEyAC4Hj_cEqaSPVgC_jSgL9PYsOxVJCnY2Aq5xs80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa7WObQqWCa21OqLLzH2rXokFHzZ-goWmWkLkN3K6uAw&oe=6AE0BD99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj0jusM4-4EQ7kNvwEQDQZn&_nc_oc=Adr4sJFcBIJds5FNtMfe0s8r2wezB8LseVsBhxr-YswvyZpK4Vzd33dKCL1P1TxefIQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqEnMpN10K0wOZ4cprpTbcm0-WngygY1e623CnEJccTw&oe=6AE09D0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
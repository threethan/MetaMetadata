."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmyej8vm0OIQ7kNvwE0m14G&_nc_oc=AdobTuvp3qBC5ugFKx82LurA1D7KekQD8KQ7J5WtQR6erGe8RbkEpcpFiCeWzbzID40&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1IIyCmq6pAMpyFBdSMguIWJog9r_yJiGPhbQThW8GOA&oe=6AD387AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYaCxa04Bp4Q7kNvwHQcBqo&_nc_oc=Adoujj0DQUg92PjTOTDNICZfQNOdMf3hRD6LLEGJx85ie6uLAnKXW0GuLOpumoEL7Vg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiofFzyxU3w3O-R5DJ1zrQzX_iJR_uWarZbbTB9SVsxg&oe=6AD3A62D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0x2kqttgkIQ7kNvwEkhfuu&_nc_oc=AdpUDNUxjE960ZUOJnByb5JLD32NUByYRGlecdwmTMEEKk9Of8pwD3nEFqfcZBhAFOw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMief5Q7r9moD6DtJTKcd0W0xxCBOkHTI0Qb-cz6EbaLg&oe=6AD39E39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo2SUEMt9UoQ7kNvwFk68q_&_nc_oc=AdoBs7T9E0F1z6rUgi1yzf1eYC0zIaU7F0itqnMuL6CRusdLCXTSsnsfnOsoDEt-u4k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxTdcjWFrz6v1qWqgeqEjMnyKI5aGkvfWaT9KVW793_g&oe=6AD39446"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=627hOLz030oQ7kNvwHvnhTM&_nc_oc=Adqrnj91S0NgjcI5407SSKMPa1NhWtbOMnsOfyIKiDSilgEG0U2R2P0nQrWyNP_2cXY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo7x7uKFot-_I9Hu-j3mtDrOtgUPP-eY8p7klowPpH3w&oe=6ADE13AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pn38QCaVsQEQ7kNvwEHcP8f&_nc_oc=Ado-za7FucHL9L-9vruMx2GZbwHeS5t49bA5kQiqI66-iS76o6InoEb3dqgB4O9xvV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbEezExcVgN-YiYPWue3QfiNBFFaAcZp6rLQ5uZR_XBQ&oe=6ADDF9ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBWeF5iU9ocQ7kNvwGj8rIm&_nc_oc=AdrINhhvgJI8tcm78IVRtijq3-25FjtoZur0KLVCA_jywTeNiTp2pXIPOh_rwc6atyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYXTgVHq_J1ph0vqrWHkQatbQPdBcdeeu6W2VQsD_z7A&oe=6ADDF1F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v333KRRN2e4Q7kNvwEgO-y9&_nc_oc=Adq3mMTVvq_s-WUn1Nj2_3-h7YHi5Fvpky57a7MlbY7BSsZ_gnw6EjvER3Psp7PhMe4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIz2zCbRI2aIoY_HE-7SMMkD8W0ABE2Ikzyw5rn8tU5A&oe=6ADE2046"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heUGdMa3qu4Q7kNvwH9VmcP&_nc_oc=AdqLoF3FOPaAx91lUnNonfW3hu5POOzOgFJL1-EtgaHUzllN4-OlEFY1-1IzL2bEeW8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fq6mzfv-E85lLDoMZV9f39N_GBFlrZ1VNPXECoPr8kA&oe=69F6028E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LUxdgbLEW0Q7kNvwEhaCFj&_nc_oc=Adq9HDqnTiO7s-wA58YGCwn6s2DgGbv4t13FPIRiSXAkZH00aLA_pOBd837B2Yd8FJ4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wHxKQUxMRK_C7WBgWznMVLJjrJi4p-MHSEK05Jo9sxA&oe=69F61299"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXMM-2e3pRAQ7kNvwGSrxSE&_nc_oc=AdoRF7an2kwZnfpKKJwprGOXLAMVn7WbwqORIwEvqb6Bu6Vr83SYepx7WPf6QCgFxUU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yZ2JqHkP21BzVBdJkKDGw_yJk2zyVXc6UFQcbfrzzOg&oe=69F5F20C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALlKjQjfPh0Q7kNvwEe5sPh&_nc_oc=Adr-q9kkrVBGpMMlu61H8yZ9WZcdXXHFH8-boBX5_YJNR9jm20zbjq5_ADW6psaaG_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87k9eI90nw4-lSNsBW2jpWKYuEoVgmz9YTUE35AxK_WA&oe=6A2AC7AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxLfMd6XkDwQ7kNvwFo7NNe&_nc_oc=Adp_nnW3WkA4BMaSYWqZcgLYZ20d51eV_heqOHagVFnWWKbKO6smuxVemlnkiAnj1Qg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-64wvv3SRfbppyxA2BjyqzV3jA56W0vtotqJ-_IXEmyg&oe=6A2AADED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdct7azlZpQQ7kNvwGxUavk&_nc_oc=AdoaN3ZctMhF1CCKp5HLMY_tAOiEtf0fuaQbAMKM1KvLgLIOZ4tM_nTbt6Iap1vsq3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96sCOzeHzrjhmqdP9t68fJTg-ET4YjySdGSBpekOIjvg&oe=6A2ADE39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxiUOiuaz7EQ7kNvwHLcIkW&_nc_oc=AdrQPwJAXWb0_YLoji9DUI884EI2YBFHJrgOrzU2_eKAUyFDul6s_6-_SFHMxN0EVxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oeANgbTuEf9dm0y2DYmW_Cx3JFD0-g2o1dt3ATTXQ8Q&oe=6A2AD446"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xOlE9msv_MQ7kNvwEEnDcY&_nc_oc=AdriiIM_ouS4icJW91Hf6-JjlRtdO0vXgnK57rEe5BjSCSfbYxjL_NqdLBVAb5IFJ4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5ngxcRBpA-zqz4BalM0uzmF5OrzMzjFmL2MTI9YYRaw&oe=6AF088AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpSYfG1n5SgQ7kNvwHqB-x0&_nc_oc=AdpRvRiWz7cKG6OGnfa__vuOuliId7TUCRfGDsyuZS16QwS9iY3iNG9D03K5nHsbx6E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgsod5ZV04WaBUeBOzimrRarURn-dJcnOCWdRt1xn6IA&oe=6AF0A72D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO9VLBh3RrgQ7kNvwFc98xa&_nc_oc=AdqGEmGXUI8DQN80S1HgboumojjpGRNZhVYY6fMyCYsZefFt8PUcmwgewItewrypZ38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtD66rlQC2zDhS78FKqorphHN75SzJ_VTGkhtW_BYVXw&oe=6AF09F39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7pv_YGRECgQ7kNvwFx-Rhi&_nc_oc=AdoU7Vszn0dn1abM9BiLEaraKx9yBicDUQl6MYwd6iYA_828z3Aq-O2a-KmgssqGeWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkeI79eXIczybJuJLUZrRvHJW1MBQTPqsQO-mMpjLedQ&oe=6AF09546"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mW806zNdWKQQ7kNvwFmNMCk&_nc_oc=Adq73BSjrGTSdV1JenOokEiBkZLjDOvIa8nzH5ncIwVrBZps424wKsbC6p02nrd5sIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cLbnEuTKQTS1iNzYDyR4PRmKusLTr6n3oWmpShLrRJw&oe=6A18498E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_LviyGCUT0Q7kNvwGkZ39p&_nc_oc=AdoDCcTJqjutRFhKaKFqHvSGj9bliVWOzdBUvcqNh1c5Nkk4R9iyWXCj-qKX6CP5nMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44_gitkxYiHgEIKA-2rBZ5nxaKRH6-r95WHUntNPjC1A&oe=6A185999"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIZAm5VF_pAQ7kNvwGpCWJP&_nc_oc=AdqUvdKXSNoC7XJVCjiUYPJkV55zx2a1MZzgVeb8Rb3yaqgfSaO6kSbFYkOGpXw0GfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VpSEyIiUS3wlsSD-rwFtjG0P8Zkpktic6WtCw1Mnclw&oe=6A18390C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
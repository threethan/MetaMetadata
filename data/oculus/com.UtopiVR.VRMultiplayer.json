."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vQWnFOccAUQ7kNvwG4wLj0&_nc_oc=AdqRAUDb76KDZI5uynd56LYS5vBvO4YJCkqZjMTpOG1OOaPmuhANtPi0kJTOJ1x0e9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMfgXHtwyPxVwaa4xTdJ9rD11wV1SJNiSMIoK7TLhnAw&oe=6A5E322F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAzXHBv_140Q7kNvwFGsPyA&_nc_oc=AdrHBSpAxGseDnGckXjxSdf2wlNWKvwbHR0nkuu0YXYctf5CxFj6JnSz2vNFUET5AMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgjXRDp_5bfxWiDhtsPGhJcskC7hZHlaAa16VqLSUJ3Q&oe=6A5E186D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNF4g3iG9YgQ7kNvwHVT5cC&_nc_oc=AdryNCZ0Xwhoh_gK6Pdjwuil0K3GJrrntmlqMo5ItGD59ds9dUlSU0SA9QNzM8ZiDac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1kwhN8lMc3dajQn1woLUFwEoFveCRAafL3TIcGKN0Dw&oe=6A5E1079"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZNRqceef_cQ7kNvwFIpbBo&_nc_oc=AdoGvUQ9PzB3ykzCtzE8Sz689AyDbCwjiTCSgfv-qiXBoJa2qfHNX2m2JUk0HrXp5D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK8gu-KS0qnSCJc27bqSRV-bb-E9A8v_ZIWh6ufzRpJg&oe=6A5E0686"}, {"file_name": "Hero Cover3000x900.png", "id"
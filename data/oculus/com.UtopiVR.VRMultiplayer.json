3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYuGjzRdnBMQ7kNvwHngnGr&_nc_oc=Adrh6UB-pkKJwalNDRzTB6ckq1lVUnCmY50P-Z575Xuf4OWfsZMZEFTR7EpkcxAHRqA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j_Kh3VD8CHhVo_9h-KaCIg8CpgQNggVSIUwNlD9X6xw&oe=6A0F0F0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfBL9Mh_BpAQ7kNvwFigCt6&_nc_oc=AdrDikphY59-_2o4SCz9MoT4ZNpVIeQKk6yhfiVjNaJBU_L1oTefs7IWOyCMgxWYMfg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ppzv_VPD9pw9fBNVajRYfLUJMb-xL25V5z06e08t7ng&oe=6A0F1F19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9VzO8JbPUIQ7kNvwFE8cVJ&_nc_oc=AdowrHTdMIhCsFhRBb4IZJG0j-ROmOeO9MitJtizQ_iB66bE42NX5-iqhoxqG3XeoXc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pAoyC43xeq6HFfRBrijTtEpQ1G7nuiu5IfimoVJRLtQ&oe=6A0EFE8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
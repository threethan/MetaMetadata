3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBW5kicfQoAQ7kNvwHDik1y&_nc_oc=Adp2YojOugyZok3mRDgZpijxvD6Cv6ftACGJokCHziRblvHrzV2ihUm4zxim55tnrxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ji2DfAtP3fx3r35OQkjaluLnZfOmNVSeimv61M5t4Vw&oe=6A43CB0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3Z1lhb-rXUQ7kNvwG3aIow&_nc_oc=AdrHCQVrlmJok5J2JhO654Oh7MYQ7TsPOQsAVtxMzfMTSz_Q1BlzuGzRovQy9BZTsww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jgoHj4kbu632hpn0reqPtbxrGO3z2YYGZfOejvC674w&oe=6A43DB19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ithL1Kqdoi8Q7kNvwFrwxfF&_nc_oc=AdqD_XCQ92wPW_DmH7lSLE-_3WieL4PdL-79BCdPGWkkBbNlOOPD9lIWVEgnv5hWV68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YM21q_dHv3vH9x-NcCERfahkTJLQe2SWJUTr7NPpBJA&oe=6A43BA8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
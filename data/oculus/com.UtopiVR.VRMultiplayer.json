3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_TqWMfCdY4Q7kNvwGbN2Aa&_nc_oc=AdqM43o_5Fqmblfq9a8aoeA2MEE78u4NrF-iud1dtFbyKRXrYhwSC_v4a7g7EnHjN8Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMh9ZW_XV4qtLetrjuPKErtwxIMynGGET_0QmppURwHw&oe=6AC4FE0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6v79xIq1-YQ7kNvwHYu5Eu&_nc_oc=AdolFFKRI0kZEnWGkY8mwxqyPyZuFzDJHc8C9x3leCJSO-nN5QSoL3BOruaLmv5oX6E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAFwxD3V_iitnE3qdjLaPpJfHV1xugZFoA2wpm6Jb7Ag&oe=6AC50E19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvB8fK7VHDIQ7kNvwGLEd4M&_nc_oc=AdrFUFhOImBDvO3n7K2zvwH9Zxfwnk5DnbfxbwpNhYbQiowzm4ul1vezr0lBC6cFDQs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVfksS3QA_YwduxS0XEVOt-VGOK_iRSB1lEFVy0JEQqg&oe=6AC525CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmrfgr877xQQ7kNvwFMdeGh&_nc_oc=Adqz8JYiImsKTPTla9G47IJJMg0yaLjL1gMXn0bR6wqJmeHKgozPhCUJQRCV7nK2If8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsitp2Ayn8m2_OkgOC97Lv2rV9Fz9gBQDsI1_upb8m3g&oe=6ABE6FAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7zEfDviqtEQ7kNvwHZ4YQp&_nc_oc=AdoiiPsdPdxuJcv25xg6d_uwL3Eb7_e_INQN2sx_xGWszrQxuMFCEdguPBpINZD1M74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm4zlfsAcDVM3RtFjqbC3D0a_xCVvXmukctufjrxAtCw&oe=6ABE55ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZthZZjoz1HAQ7kNvwFCwWGW&_nc_oc=AdpazO7x1SVpVoJxINrU3qU1z-0hpbFT7ii7y7wdFX4sToxx8O-jwBuCmqNSEc-FpBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_DIgW9E8hdZxnFTgKh8VWvQYQSxMFvMdC_LDYHrq7Ag&oe=6ABE8639"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oA06Zn4abx0Q7kNvwELUEfl&_nc_oc=Adrvz3X2-uY1k3uUJq4t9y--OezQt4zkW8RzGiHDNiF5wQQSwtylea4KYMZFCgpe0rU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWnSv9mgepda-3EweCvYbCGcEfxZpWZCmqllUHlN0p3A&oe=6ABE7C46"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfDCfbzjPFgQ7kNvwE9VkqD&_nc_oc=Adq5slQDTRXkzefcnMgBy_M5ju6B9HlZTf_XHY8wWifqYc1Y2yR6fqLigIIWzU8XyKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdcHot45JnNOihlFUDvmXFtVrYg6pPcZ32rDAxJAVqCw&oe=6A897B6F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fg3BbGBrjUQ7kNvwGsaBcc&_nc_oc=Adr6OTxTFr8QM58x2ZEJOaxcDoKTmbpN24DUnI4hL-UQRzl7QXOJD5VCMg6De8xLT_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-V0db1KkWYqigAqCFRMBJOpb03KLQ7zQrn37rf8Qk8A&oe=6A8999ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHscq8GpeUwQ7kNvwFviii5&_nc_oc=AdqHePjxK-rukUWFtY8PVwApCtz13ymH66445nNfTxmaCbgBrzloipuy6nJb_sGSChA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqFdA15LwuCOs918Iqz_85ZG-ia1wcdG7V0WR01t9DOg&oe=6A8991F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U73eLGQ-IUQ7kNvwHUXXeH&_nc_oc=Adphnw1vAkdgHLp3H41Lk9tKqHAv6OyHTxUiYiXj0aVtCEhK0qY_YljwM2pZrXYJUSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeycW99jvWSPg-V7sD1_OJOBEr9n5mkcIlAU509YdBJA&oe=6A898806"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JdP4qrW3b8Q7kNvwEZLNzn&_nc_oc=AdrSnUBKQUXmR2IkBK_434VWZJqjuFPIfDpvtwcAKsSjCpJZFOjj3wgp3Lzs1F1rNb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJK0ZXMmU8oqYVOQtm2ZjTKyqPEyCm4OFIlhtf0Q5aWA&oe=6ACCE70E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb0AYMd7MgMQ7kNvwGOaWVS&_nc_oc=Adq8BjsjRK8vuHZzeE0JwdtXs7sr7MAOoIb_GOSS_8L3u5rboC64X-XbfXB5KRXwyy0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWHnRhBG7Jfhg3XHoRrWBu68UW1wfUY9tWDCZjZbrf1g&oe=6ACCF719"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYyjzK2P9hkQ7kNvwFWzmg4&_nc_oc=AdrCIcSPuZotzk9JDITiBd6186X2xy9pqjZVMfkC7u3xCIou5ngrEVj9Db6PwPOzIn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV7cPzhIFZ4lUuWK63BBCnF-kcZwgDTp8-pcSZOE09Og&oe=6ACD0ECC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
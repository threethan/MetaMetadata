."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHdp8PzOxcAQ7kNvwFCtihk&_nc_oc=Adqsq8C1qZb8j0lXKTO8jzIDk_cDj9OTucZ1G8hZJr5J7hwlhHTcSsq2XHhbWuJeGwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn0zmP1TaPTYaF9k6tMxn1FRaezJE7HWwGpjKUqI8Vqw&oe=6AE2082F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zgf2qaIi2xkQ7kNvwFsukTp&_nc_oc=AdoFyw3ozCUJaDR1MFVP7jBPyixpgrTvpYnyCn6EPMHcMTSu3vCKauyy9H6xaOItQls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoqTKNkvSbdIxgaSBr_JTCdJXhimo_RtzR63FzY89QBg&oe=6AE1EE6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B37-CUjNPFMQ7kNvwEYo505&_nc_oc=AdorHFgS8mOZjd8I5NtEkz7UFdfxynrSGwjbv4TkGF9QWvRcqacf_PncdD2rRyk5hgU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCZiyotbk5zGI_q7QRuznrfXk6xUx36nm57fbqP2sKAw&oe=6AE21EB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivndMI51Aj8Q7kNvwGFViuU&_nc_oc=AdoVfYmfI5NE1Fz_7Jv7-BvaykCLL40MUXfdsxgHqrcy7XhqQgnOQJUbx5XJ6P64V7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfueVKW0KeUOPgT9AG2NmlEbc8aZfjHsXvyNHglvXvmA&oe=6AE214C6"}, {"file_name": "Hero Cover3000x900.png", "id"
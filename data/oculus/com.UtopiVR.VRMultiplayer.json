3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWTENUfzs9kQ7kNvwEn5ksZ&_nc_oc=AdqQEBy3Pf69toLRQV35w_C50KX_uJySM62iMp3KODCXMJjJC-a1wYDJkBce8Vpi3Vw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68DfWhXQsI-uRkG6Bkxa-AqFT_z5h_OTZixi9f4_e1DA&oe=6A1AEC8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_at28LbK5oQ7kNvwFK5PgU&_nc_oc=AdprVVzw44QEzInXb8zQkWX775ItvnrBMrNrSNGU3Ep2Z8w-DVgp69gATsG3ZNUFyv0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KgiCoWLDdIFZGcw5QHPKOVteJE_SY7Hsg912S3AynjA&oe=6A1AFC99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dZVxhOeepUQ7kNvwFNtjky&_nc_oc=Adr0l00tf5befCrNXAr_PVt9eBaC_R8iXcH9LQMmBQ2ku0BKWLeCD_aYFdtOZyDt-Cg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CLt2RuLTGoPJ0QPSaSKbqjGGM8mmRzqVlhb7DlTWuxw&oe=6A1ADC0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
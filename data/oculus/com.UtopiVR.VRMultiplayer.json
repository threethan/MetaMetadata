."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8WoirYnmNcQ7kNvwGoNeVx&_nc_oc=AdpeJPghRHb9zRekfgBDyVJ5LnzJDwlG4zXh_mvTiZpovjuWleubi8oNrr0P11WLf-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_2tT82of88wKpGIvOBYEzMwk5_RN0au9EnliIfsGBCQ&oe=6AC2642F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZehIFO7qI8Q7kNvwGI_jCU&_nc_oc=Adry6uBKHIUJWkkLHQ06ubAl8J4jeHJjWVzsmn8Ksc9ZpKTh5vh8gCKHVmLXB53tfKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA1okNS0fp5U5aaDDLz87DnZGf9Ob97Kh54HbVPNz4KA&oe=6AC282AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FdOnkFz5AAQ7kNvwGZna_z&_nc_oc=AdpBP3GzPlhK-niRPstfKagP6OEontnu0J5Qno54SJDbKccrDpjqxBMXt85VCrvVebc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCBj1QpBqwj45SMI3oT3zyikX-n1rH7Q_szLlYUOYPaA&oe=6AC27AB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTYk3Y1DwQIQ7kNvwFuvQ7A&_nc_oc=AdqpGvTF_1cxcR8zdO6baQAQs2wZ-ugr6YY2s9WAk6d6Z0tQQR9ZKVCcmmzg-O9GUp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC30usnEb3GLammkZL6sGMonm8kThvdUIbrEcfjm3Cgg&oe=6AC270C6"}, {"file_name": "Hero Cover3000x900.png", "id"
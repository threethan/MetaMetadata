3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uURw6BsgecUQ7kNvwHkcqDp&_nc_oc=AdoJfLwsTIlzyrFEeND-Pnaxqh7jmObip5zr3-LbAM3RPUdnQt5eoun_WtFL7u5ZnMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8w9n7l_7r_DXqfrL8fjDC2uWpkknqKhD1nDVhBUJ9oQ&oe=6ADE0A8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9O6Cp_SfTgQ7kNvwEmSiUG&_nc_oc=Adq8jQ80133Byukn8s0N-t4ufWwwREiQz6IqShK39bt6xQd6-ejFJXlkY9ipqmuz0Z8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW6v2g2SdEX8dzP3FRuaxCu25CQn6kPW8wMgpTFMSBPA&oe=6ADE1A99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSauQn3BdNQQ7kNvwGAAJyU&_nc_oc=AdoH-xw6Babkz_lfR66tDXCcu9ytfJpFrYdvU4DtBazuFgDeFolDkcAZKxqUmarnvRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_UlbRPudQtVypa4QjnDX_HfTwyLuwKh5SJSAfldNewA&oe=6ADDFA0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUdr2BJ-Wc4Q7kNvwGN64Dn&_nc_oc=AdqD0ULx4wRV4W5Oplz_KS0GvA-ciRPhW6pHWdnguIVcS5qACBbo1HrS2DOT1WzYio4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTTY4-f3crTK3AMAiOXlfZM4hRep2cL578Z98pBIgSeg&oe=6AC3AC8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RaUgWeQL7UQ7kNvwGdh01Q&_nc_oc=AdoA9epyh8ijla_fqqdO26ept4TMhEukxG_gIK4lzKslfsWwhWywsBiH8emp1Ej50_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6dz2ChdWM10c8XRrJlmMZLC24dxGpCeemNELLEhFpAQ&oe=6AC3BC99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvB8fK7VHDIQ7kNvwFH0k7b&_nc_oc=AdpxMqlKKKsbkiJYR3BXjf_EQLGoYL4YcK2RMzeLTXxTcSZVVjOkSKAA60Rhpye2ttI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj--y-FbNmofzdTTG8ro7pj1Mja9eamk3sqo-05RBkZA&oe=6AC3D44C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U3fgw3Dl0MQ7kNvwG5WN3_&_nc_oc=AdqPrRvVTtexq9S_Lxjfw7oM-QnWVO-otPQRZjifqEyqRR870cPluSbIomTSd9XhCug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY2POUj8Xuo8iPj3NAIEy3ix9VewCUvESEQfCrmpD3ag&oe=6A4BBD2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUIlMEdfOcQ7kNvwFScd84&_nc_oc=Adog8-JC8Wmb6JU_1z-tsXCE8NSYTtaI-enhbJy2wEUtVDpzztIygIrC6mdstyhmDe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByjXNgs9BKOyjvkibIpKaSWVhvt-X5DA6fPqSQmyy2iw&oe=6A4BA36D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LljlvjCt6UQ7kNvwG_kYsd&_nc_oc=AdrQ8OhbvGww5p-LksJvC3DTu8pWhqdzhs-dswYZvBCSmM7X46Rqs5qm2_9sR033qaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHfMDV56e4tEltDjI2_6Ll-x73wf9vds4NWgF76HyXYw&oe=6A4B9B79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBeEuJ137D4Q7kNvwGqXtGF&_nc_oc=AdqWmtGXW8vYEEdKjra6XJ-UAqhHPnu0SnvKzR8zOdGz-05kOfL1JJw8sA9BvS5ImLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqUatpaX-ozQk96ZWe_bnm9IOm4rXwH7N5EOoXU1n10A&oe=6A4BC9C6"}, {"file_name": "Hero Cover3000x900.png", "id"
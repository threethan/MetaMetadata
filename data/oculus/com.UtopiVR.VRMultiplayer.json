3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWTENUfzs9kQ7kNvwGrcczb&_nc_oc=AdrVpDA_lpOUCK1Nu0OmJii80QyhSVN3Oie9kFuf4iMREtFqqqYEDSGgQRmNGzXEXqU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FVj09vfGeA9Ad1Rtw2IpE3J_6q6pjm_nJUZIc-LoP_g&oe=6A1C3E0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_at28LbK5oQ7kNvwHlF7La&_nc_oc=AdpYz-Mk69Jl3o7gL3lxwKJ2M1tarWXYhNMSeRmSucM9yzwidoDDOvyaY4pwOI1YnFo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X7Z_AfXnbbsw4CkbG3xHYfwHP85EJm9x0udordY3H1A&oe=6A1C4E19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dZVxhOeepUQ7kNvwF7Rjf7&_nc_oc=AdpWy7411nSmZ3I-QYBB0gt_cZzEojQNwTxvfOR2QrtXHnSVp7hM3qE7t3crgZTetXg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CItED577o-CA6sWNk26G-9vSbdZ4iELy7E8T5Dlfg2g&oe=6A1C2D8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
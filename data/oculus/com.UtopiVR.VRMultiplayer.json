3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag9Y5j9JHKYQ7kNvwFdeieI&_nc_oc=AdpG2C3Ue44ZWc6AseWix5AVLBlL7328c_TmZjt-CHfDGF38j3ObUsU10aIrcqoF_LE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCd2ZO3EkXm-WcYGP-EZiRG9bQx4BTNlTSpY2zNcykUw&oe=6A89724E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoZUffPhWh8Q7kNvwEYISFi&_nc_oc=AdphC3-rULLz2Ge7NxJMfr-H3XC0fstH9DOhrW8A3rzIPnWJeXVo_CgaZxf7Qh4OE9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUUeen7f0xGHyS6aN7r064xWQWq66bARwINf99HeCmEg&oe=6A898259"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_jjJrkLs5MQ7kNvwHifw9W&_nc_oc=AdpwYR_KtjENwcadx10cr1zWcy61QhPBaUAUoiIxlEQ6QcnGZd0ZJ4K1bSn3Z0_Vf7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0D7nit4L26EZ3KXAG7use5Efsc8FMsxPZPWyac5aqaQ&oe=6A899A0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
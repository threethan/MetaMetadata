."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kW_Z5bTfKCIQ7kNvwE9jCJq&_nc_oc=Adoocmqn4yoooGuT2ESMD01abtbq_7WJ7uENbvZkH2euVuH9tdRYtl_-vsiBVDhKpAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsLo95WT7mW7ETGvU4qRoqnFyPxAVVjtOSg5N7XpbA7g&oe=6AE5FCAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCjr_yH_e8cQ7kNvwFL2BSf&_nc_oc=AdoVIo-dq3BWodzAKAj8YZgKo-Qsu_1BWzo6xHA_ZkH99cxnn-DOclxjZ-ZWHg0wtzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9eNOwTkMulzgDS9_eb84bc80tNURWOJQnEqcD4z1TkQ&oe=6AE5E2ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WT9TtY0wmOIQ7kNvwHhuBz5&_nc_oc=AdrTyNGM3OXJMhBlVJzDlWSte6D7AK9a_NLH8MdidsJQHORCDS02yRL3L8xwAdUGZ0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7t06BFiA5QoYv__OdZagPyW4HIZCZvQfVVENc6r5mig&oe=6AE61339"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oq8ZUJbFDM4Q7kNvwF6_lSC&_nc_oc=AdryJlzZKDJ1Io4PQE05bJCKNp2mP6G5FKQYklBzgI_6E-PZXazL6Jw_5C3t7yIuflQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzxWike8ClcHnGE0En37vIoEtP-BJ5kCHxaGdtgUNUMg&oe=6AE60946"}, {"file_name": "Hero Cover3000x900.png", "id"
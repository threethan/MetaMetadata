3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB-zgNmIbPsQ7kNvwFv9F6b&_nc_oc=AdqhC0JL7o1EbUK3rsGZ6qlz-Qx4A1LPZ3bbejQ15Io90DOSN2MKmSMmpsaSe11nbs4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoBZMxb75_0XA3B5cRk-ijT0gTC3B_eWfm4O-aZ7cgZQ&oe=6A915B4E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vd_q8b23lkQ7kNvwEqhv13&_nc_oc=Adp7oZO3B3-X8V3ZmDr_zojQNASzTblhzbUJh_tJfWTF4L79WpA14z0Je4BCYY6_qSE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPELiZvbyavQxJhmgXR7prlhwC-EsfWYagxM9HWfN7nw&oe=6A916B59"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkrjKxL6rWcQ7kNvwELGDXD&_nc_oc=Adr8QuHksPTfqujHOd53ml7Ga12uB9_JeUkgPPA5tyifiTu-is71k3lqAGpbhlwU3Fc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqDOOhJ_T32VtTvvGsA6Kuofl87z9RNja_AyItojupHg&oe=6A91830C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
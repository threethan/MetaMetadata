3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr4OqgCsggIQ7kNvwGSDWGy&_nc_oc=AdrRbdRZe7ji9IQbXK7FcT3G_Ud64SYnx9a7KcbG8es9dNFtu4MOdQbd10n_g8JeCA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwZzLcfO87qVF0OoNeBORiIQjvdqP4q22yDVUwZjFiJA&oe=6A5B860E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRL0-fLl-_8Q7kNvwFQJPzY&_nc_oc=Adrf47NoSNsOhqJwVPe9awyLZC-17NnsKWafB3f1KEPC7D_dxqfAVYlWgkJsdZwk4hw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlI1JbkfTSWbXkr9BT3irTa8YMlcc8xhbGPwViVWhK9w&oe=6A5B5DD9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb6y5MhXkRIQ7kNvwF0FgNX&_nc_oc=AdoL7jZM7YhgqXy-M7pbWy9u54CFvUfBJvXiBQtDk-NOAg9VnqneNE3rqx3VrvKQt_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJV20FeqLfcipUl0KKwCSoyfRIyl43ojsHPskNVsRs3g&oe=6A5B758C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
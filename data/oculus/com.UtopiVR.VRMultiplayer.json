3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIMpnvTODMUQ7kNvwGSSI0u&_nc_oc=AdreZx0k5N0vBADq4Eqe_kQBMicplvTygLDoqWIuUNxkpvydahPegIqmyX8M7Gvm-dg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTF2I8IvW1B8tAsEmQYw9rPm90BYSMQB8NzxyjCJxeRQ&oe=6AE4A20E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXt-zYWBWhwQ7kNvwE_ja6R&_nc_oc=Ado53pA0jbyQ82Zs3byS69gP_AkVHamQYLkVBGqeU72MlC34vwORdtv9GAEoFGoQBlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8u-io1j74uIOeCk13ATk1MEGb5Tq76PHG2yfPH9nlQw&oe=6AE4B219"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65_yegB2IDwQ7kNvwHZe5Jy&_nc_oc=Adrgp1U-aPixtwdYSdwzf62ePctg4PgN1EQtc_AWLOzNK_BRE-Tp-a8KQqT8k8uBcjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIkH_hBneqR3tvHXNUGCh7koA-7NhzwoXwJyyylerWog&oe=6AE4918C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
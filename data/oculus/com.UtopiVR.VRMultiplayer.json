3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASP2-E8TqMgQ7kNvwHOYI0H&_nc_oc=AdrG5an6xOClTN9pKLP7vJ3zcigzThE_Qn_qfd5NqjLd2_mqYIJKki8AqDqd0N7BzVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxdOkYBFzXPbUqjwlzotaew69gZM3y972UthBJ5BUlTg&oe=6AEF664E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tBGCKbrEtcQ7kNvwFj658f&_nc_oc=Adq_UKGDSTq9WzlVy17peJ9lI_6R1YOy0Zj2oH0MmpcbWsySNIpUhtdRG1yNNRIl-cw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb3iqet7XFwyIY7vP9OpJ9MN-Fdqh30KnMgB6i2qXoqA&oe=6AEF3E19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xChbWN92h2cQ7kNvwHhaoX1&_nc_oc=AdrGManJktO3Oy7CZT1QxIMxL9V5__QId-0anvV29H209oAr6rqrJPYVtjyCE3coCwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnh15dVHD3a7GjrdFEI4NJVdMoxI5VI1oC2w6Ov9HhbA&oe=6AEF55CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
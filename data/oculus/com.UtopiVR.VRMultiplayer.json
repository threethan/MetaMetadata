."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDcj9U8n5tEQ7kNvwE4a-uF&_nc_oc=AdpgDnMr2P403Unn9fZyJPaWlJjxcscA2mCrZLJE__5G8sYSuGvbyIRZ3V9A2Dfaamc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P4QCzUEvd10DTsf0OFt1sg0QdQ7JpTtYGjonJkIIpsQ&oe=6A09D22F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6qhrPslkCAQ7kNvwF8vNfk&_nc_oc=Adqh2BxsdMBCT-YnF9ukBnW7MwLKCPePImfiivmpy-SpJHpxZWCF793Do6imZuGDjIM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4S77KaHdLJBO9j_umgn47_hojKcU5-6Tb6fSv3q6NfZA&oe=6A09B86D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAKOjMebnYEQ7kNvwH9VT0Y&_nc_oc=Adro6Y_fWlYrekSBAFOcvCCg85-YyqE0w24EVUpLqQcn90xnO5E_rd40XhCcSyzwQzA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SzCdLCxTt7xJyx_bS8VDxn8BsYFfeX9hnbiftxbvzDA&oe=6A09B079"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_jl3fmqBkIQ7kNvwE33TjX&_nc_oc=Adq3umefpJHG-mUeHbabNvUIIq8Ml1NyHPMgUu4qWq-ooKYxnadh9Akd00uYppLMLko&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6StEhkFeY0k1WDtjkVblG8tK_GhBZa2uObqA1c_w0EfA&oe=6A09DEC6"}, {"file_name": "Hero Cover3000x900.png", "id"
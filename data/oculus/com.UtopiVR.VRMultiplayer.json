3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H333oOnj5LgQ7kNvwF84Pp9&_nc_oc=Adre0brZ5GRuHRIItjsNj7JKCxNsPn1yArsZOGevwoDnqkxRZ47iNEf5jRzWTTF4cJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlKhLw5M7aIFw0EYtn7OXMYXD3_UBt31gGxjR4ThmoBw&oe=6AA7FD0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExOQBbkyiJcQ7kNvwHq8BJ5&_nc_oc=Adr2mL7qtCPz3MCHn2ZkfxpfeMgyebtGZxGZs8t42mWVeE4txagAPXLicYknQtrQ5WU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMHYnWb17nDXE6gJQx60jsQ8igzyj0vuzr_mkjaKJv6A&oe=6AA80D19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu8Z0vUycYwQ7kNvwHqRIFl&_nc_oc=AdqVRS28TDsHzOW2k_BoQvhYJM2zH1buLEgpaotFMFMyiKLyIn_M5Nq6MgH1oBoHEtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcLvpGaWK0CnjW-HKTDnQLzd6ckieW3J6fF8v9dB4DTA&oe=6AA7EC8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
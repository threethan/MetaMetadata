3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URZcg3LxGTIQ7kNvwE4xzCn&_nc_oc=Adpc7vnz3sqt00z7cZglD1IJRxvpn13vjKGKdiMS3ZSVJYcymXaVv4hzh8uKjW-NCps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gaSP_8KZJT2BvJLlh5w_10poCHhm1yohX8FYVLJnhcw&oe=6A008E8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMXFSLOaytoQ7kNvwFwRmqO&_nc_oc=AdoMzLzkk9MNKaCpQJB0_hATETEk-n7DgpLfpqBrcs56G8VbHEh9C9lqkPW5u47rCi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ze1s9EDhKfxbXZVrIgPBmkIZST6tN6pjAiQnsvxGYyQ&oe=6A009E99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfRtmkVnL5EQ7kNvwFZ_Zfv&_nc_oc=Adq7vp8GvoTgh93ogawEMbAtGObMv-p_WrHWBWPhpqUPbarcLQUwRY3aAyM_IRrOV9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rdYFSgZfaqqujXIEA47XOebU0ddnPdDHYAi7bvIKQeA&oe=6A007E0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
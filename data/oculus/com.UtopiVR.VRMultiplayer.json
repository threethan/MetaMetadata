3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvlB_QwxmJMQ7kNvwGlUykD&_nc_oc=Adov29zR6paI9tbp3OwtSGMFiOyJ77DnQJILlkdvi8clTkmdnd5DyLNTVWDvN3LkjW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZRqSseMrQ07eNGjtOeg_XkaVMXdzuMvLjn-P070PsQQ&oe=6A3E850E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg77HQyAw1UQ7kNvwGmaZG0&_nc_oc=AdqS4BzqVVU-VAMODZ5d3Q9DurgNxScD2l1WpRiPfO17epaBye2FUZeijMxD7vnmjTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aqpg_FC2DfoApPswu5EiLtnY_xjL_AdmGd1tzFOI_Aw&oe=6A3E9519"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOlfsB_UZOoQ7kNvwF7Vb0o&_nc_oc=AdrlF9fyiJr511v5f3NIIJjDF-0WHOeWj9KSLuhYms3g-zdsTU2ZJXTsOZtnyoXu1I4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uxjGkLGd-ZVKv8GY5WRzD2cutvTVCFtxfIVOHl0ANAw&oe=6A3EACCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
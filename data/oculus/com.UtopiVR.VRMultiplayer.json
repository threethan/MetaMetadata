."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoMqInmjKgIQ7kNvwH52bsj&_nc_oc=AdrUDClDfDJ95ToAddHEe2iNz_kByM3j2dV8F1aiqynkRKQw-2PyzTq2lHkVAWmA8rI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AGAWh2S_U0WE2zoe3iAklUbeIWNY62J64vr6ZexnB9g&oe=6A4282AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5CShvW_QSYQ7kNvwH7IVGn&_nc_oc=AdqIh5uWrtGO7e9epbu9QriAtRDd0anbwCinmUBfLENID1AzW11RmYdNdlqURCCg2Cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WFbKBGAHzZE2CuE-lGP05F6go6Y7OwXL61SeRdSIf6w&oe=6A4268ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7YtncK8NBMQ7kNvwEnehBI&_nc_oc=AdoHjtBlyqwjl_YcIGqW7UBpjHb9rSd7lqzI3FUSceiHZbe-KDRU52Xns3iC7Qyz3Tg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_piz0MNQ5f9CDpOl7Yz9MosYk32-MbsUUQld9sQF6gCg&oe=6A429939"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWkDMqqOXZcQ7kNvwGLIX9V&_nc_oc=AdoQyGxLgc0NW6fHpfOJaSXn3n6raL06CMTD6jEO9foEBOluSSx3HR-3uW3UlV2WU4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9Y89VRUnqpmtSplh00JbxWt3bySzNI5P12L4ibCZZhg&oe=6A428F46"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R1FrZURZvUQ7kNvwEblaFL&_nc_oc=AdqP4FLPkEeC7Sd96ENmLuHBkmIxepnAHw-v4pCdnKymRsPa-XlcrZ8HX1VRW8O0K70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82GovfKITJLbElzLhsfLPmpKtCw5dJoDhDkLp_r0Bi2A&oe=6A296D0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T3yBoipqHwQ7kNvwF1fyCW&_nc_oc=Adq7_gtyUR1xfN0_3cr1IDAuQJgB-2CFfBn8COa4onltjpq1xyvPiWbzh6kzPY3phC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K2R4M5oZKdp7iaP_0OwoUzDbAMvmsxjrI4NCjt8cRTA&oe=6A297D19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OthBWs5rvzUQ7kNvwF8tHnu&_nc_oc=AdrqHGlHhY8TulKZ3ec1uOqEeTtkkZ0tFb3UKzbbhtVSw6S3bkMs1S71DbBQPi0TU7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_izyNnMy8zE_0egZ7ywOmZBAybWDz0RXhM7EFiTnSfSA&oe=6A295C8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
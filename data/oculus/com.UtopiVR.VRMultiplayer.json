3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahILhlwORwEQ7kNvwHmG7oh&_nc_oc=Adp0YqOhfYX_A72XzWzEatAPuBK0oqZVcsk22sYFOFjF7RrwSOB1v-9oChygTx0JWmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzZx1J_Ehf3J0RkeTAeEYNCZD7H4Jw8zcPP9ZxNWjX8A&oe=6ACB958E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twl3Onb9QzgQ7kNvwGFS8MQ&_nc_oc=AdrvF-SUwk1V070FMmt3OKG-vslRM_ufIRxKvYk7ReOZmfx-QGqHsqP6WwtcOmJQ-NM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLDfv3JBPJex1Ci3U5RXPYqsxATKVM9SiOoA4nOoF3mA&oe=6ACBA599"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYyjzK2P9hkQ7kNvwHhsfAY&_nc_oc=Adqd3KfiDusDsqXcE8tlszvtB9zS4OXpyBHlZON5f0-6OfwY_kSrMLG5J2dMCYV0cE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCbMwD3qgJ0J9Wgum3MXUGAS3bFcb7v-ZddotCEjhIVA&oe=6ACBBD4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
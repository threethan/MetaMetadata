."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9T8ScWioH0Q7kNvwGgRTHS&_nc_oc=AdpqA9an5A6AxMM3lbaBB0qkpUc3s8_1khJUl-cqo08no59j32wYfweSpZdN9etRVEY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HPZdR7uxBp2P2NcCiQwwb9ehksO5hSY4-nS5JMJFPfA&oe=6A1069AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTcPD3SESD0Q7kNvwGP5JsM&_nc_oc=AdpeKPL4x9cRSuZL8aNldz_lXxidxMhs6FzvkS8WGWl1KUZKC1aT6WNPPqV-AoAI8F0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x28B7-8UyUbdfveAKGZktl2InZH03YhQoPnqaSskLxw&oe=6A104FED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtJ0In9oQgQ7kNvwGLT4Qq&_nc_oc=Adq2z89Vlwn9c1mPqjgZZOltNXDWLaiNf-ZpYvqsJ58B36tsVjZFfG-Y_ZMW1fYH27E&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E-EsE1ovzEGgVH-yZ4wcW22clJxsq1lmiM0Gy0aenIw&oe=6A108039"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSDquQBPSaMQ7kNvwGV5fvz&_nc_oc=Adrde4jdEZak9oCHzzo84Zsn3rSQJUdCAsrtANLm0CBO7KTULUy_9uKPiRis62lp00w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dzWRo60_z2B3Bo47dVzAqAzalGKa2prOVccoRn7zu1g&oe=6A107646"}, {"file_name": "Hero Cover3000x900.png", "id"
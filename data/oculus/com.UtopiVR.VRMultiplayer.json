."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-L-gj1RVQkQ7kNvwEXT0Mk&_nc_oc=AdqIODHC3zwKltUrAqfoerUxsHQHHhJO0Tcc1av7-z5DsbNvlBV3r8GsFc5AYLNtow4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_jmRXDAifWT-qFv7RQhx80fBEd0FGjp387g-2aIa7Dg&oe=6A63782F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf50vMv2VGoQ7kNvwGVDKw4&_nc_oc=AdpHfPu9lQqZUuEuxrmpb06k_29HT-IroHaDG0aKw73x0BDigBdlUhlju-PCm1k07EQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsPctR5cAyVQkBwV_JP7DakZB3M4lQy1uEDoBnI6Pj7w&oe=6A635E6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFhhnCnfM3sQ7kNvwFZq-59&_nc_oc=AdqNmGoEy3d-Z1R5fld8EOCMSnAjP1tpaOr5Rh_hmVb79WJ1W6hJqXHcKMwKEd6HzFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXRintwh4b3ipk_lTX-iNgyDC6-fS4Pb6xDhL2xOmhgg&oe=6A635679"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISgls8TrEcgQ7kNvwEtKhrZ&_nc_oc=AdpUoxzDMj8rnSsrrdz0vlejTiAeOytx3EwYRTNJNqaeqE2jaOuQsXeCJdo0pf-xjrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKk9G2DJp0G9ygSPs6zhFygJ7dy1elBBvjOHk4QWWIQg&oe=6A6384C6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JO-RLiUr4UQ7kNvwElTnuG&_nc_oc=AdrNBkJrXY223zpcJoRgKwbktwQ9cHbj9BfScxjGqvab-i1Rm40FV4biTYGzYdZyrs0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5IfhJpH12hVn_xi78jrmgnWj294xeCY6DTylNGbt3Cw&oe=6AE9F12F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2aMPRcfqdcQ7kNvwHAnLw4&_nc_oc=Ado5SbzhV8fvRxQPlyijiN3Lydr2IsF1Lf62nlFYsSuaWU-rdoQljPU60sDfS5JLd5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0rP_o1bZkQSJsopnsE8LLUMLyOMYFrv2MW2sKtuo7EQ&oe=6AEA0FAD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvBcurmIxbsQ7kNvwELvHET&_nc_oc=Adp5hXDF1hhHfdGWQzzv5FM8o0Ttv6E1BrokhiaHWLsjItFMVwJYpd7YOhCaKHwPRgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjew5vzUQQV7DjDtH5HbTbRsvFVIkZMVMiHWuWtwOtRQ&oe=6AEA07B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swxRDC62ZTYQ7kNvwFZ6vyu&_nc_oc=AdqmM23dMvLY4LKFqP6lc5_qHdh8KH0Tapg2cgvSfeS2PFy63UpdKfD5eQjZa3HrXM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT__B9y0-wFW5NtDrI2mQmDD1TSMFWXMYSUwU8QSKV_sA&oe=6AE9FDC6"}, {"file_name": "Hero Cover3000x900.png", "id"
771-25/499617693_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmgMVI0LaPgQ7kNvwGdS6x1&_nc_oc=AdrVqJUsd2H1SobxxbX3n2Dsq8bSpCo4ZjRx3a_n7DKSIPTmKGpyj_Pk4QrMIV8ZTxs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI70waWn1ri2_gxYQJGavaxu64-jkzrrOac_z7RHL-73g&oe=6AA4088E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmC0044sot4Q7kNvwELTkwK&_nc_oc=AdqTntEb5wbmtvwhkkjbyatjGMxS-HWboN7jRk8zEXLorPLbMqW5aJ-_GW7qDwpp-JE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFnqSjpviCFimAdweX_oCMKpVRSFVtsiQToy5AjAztrg&oe=6AA41899"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWSXawJMjfcQ7kNvwFht-EZ&_nc_oc=AdqzV7LEeFnvzFcOlxQ9Nu-1C61ArkWxapar4IjT56-_hH1l7_wJOi9J9I8lB-TfhAk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc7J-anFvzDlkZpBSYqgRBvRM8YvY5nHZjcs_fheGSSA&oe=6AA3F80C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, be
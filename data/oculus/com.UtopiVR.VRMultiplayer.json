771-25/499617693_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUM77x4QeFcQ7kNvwE80Y98&_nc_oc=AdpO8jMY0nuLlDG06c5JnNFT4KAM6lhBSDSUymqOpYqdg58GQ4h8IbdL6TiCNz2UtCM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLB4orbjP9Xx0HfGHGkr_lhv2iyTE0jCXyyPmu1RvPZg&oe=6AAE948E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inn0zB4vx7QQ7kNvwEVcBBv&_nc_oc=AdoWRDO3Q9Rky7xQ74FU_B_AwBbpI7mj_v6BcipwzNc4ZnuYzljS3TLOwFFa-b_jbD8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-WvUd93D0Pruwc2ifVr9Rd_rKbfEJZBoQiPxaqYfuIw&oe=6AAEA499"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRkH4BqmTyQQ7kNvwHMNgxv&_nc_oc=AdqFLEQInWj8JSRrDKvsj1nDgqYQ54xVqfFIqUlAs9FVn8Eq-Hnmp4D9ltmiBC9R4ME&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRIjtVigATTyZN-boCj5aIYPsO7RBeQENKuDmhLkCCpw&oe=6AAE840C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, be
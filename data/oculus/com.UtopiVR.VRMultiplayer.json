3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahILhlwORwEQ7kNvwFJS8iM&_nc_oc=AdqdYHCTH6txUzSE74MF6o35nWt_3V5MX68jdY3xMZbo0YzUjfX3gGCTmGP-J2QuHyQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq00QtfxT4pmLHiXk9gxs9M38dPHE4FUIvda3KMSAIdw&oe=6AC8F28E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twl3Onb9QzgQ7kNvwGsJ5kn&_nc_oc=AdqPK8EUVOvPxlS3q_dUisRTeK8z1ZfYJNpPq4G1TnStvlrzKulIAL0dn5xiiHa5iuo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwpYH6DYDqV2RAZq__FBEPtKN3oGbD4K4Lj3tmzgMskw&oe=6AC90299"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nkdM6quqasQ7kNvwHIE80V&_nc_oc=AdrM9Uo4fQTyXzuHGlCRFDgn8IxTs2Tsh9CdL3YZ9poHD5SHxiHaa1fzInAkT0Ggkl4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnvEFS6a5tHERAwKzeoejyXTRVyZ0YRSBgZS3v00GYSg&oe=6AC91A4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
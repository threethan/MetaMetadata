3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMnOfoR29zgQ7kNvwEmuZNW&_nc_oc=Ado-bVChFZwAWNsakDS-RzaCMp7mtF1jzY7oxklfghjA-80YmsjeYk0eA7-yXIRkm3c&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH0xh-BNfipr7mI27lpHz1DGKiYL_IoOAosGxp9SB9qw&oe=6A974A0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXEEwDxCXcMQ7kNvwHH3RSv&_nc_oc=AdrEc9xobSW8NXcLH2QWxir4QdnBoV1Dl68O8FDXThhMYCvDX-njYU1-5QyxZIjYHY0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFZM03KsNaIPd5OSTl1Gpm0L1yH87UcamICOblRy31pQ&oe=6A9721D9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JfF1SyyRAUQ7kNvwEtEd72&_nc_oc=Adr_9yK5Z05P4XylgpA0seK1VK8KGEVTUCXo425sILeOEw6tDU28BjCtKSFuGIR8TMI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3DjQi1QGwt9Zv_-rbozxtr-pwyItO3yCmnzGFOhR9tw&oe=6A97398C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
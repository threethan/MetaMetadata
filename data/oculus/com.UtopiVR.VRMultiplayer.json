."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFv7fLHrzgAQ7kNvwG-0D8t&_nc_oc=Adp04-_NNJxAaC8ruHX-KLuFE5ESVBk0nWkXwIjofFQ6o2dy8er1hXAUTAMlBKzonSE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV88kvumpGLugXn1iJ1fEq-UNuBGdNGFPUjH7c_svWOA&oe=6A661B2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1dNvLGUdZoQ7kNvwHmfqQM&_nc_oc=AdowdyYuazsPDRR2FN6_QfZ1zePRcjKU0Rtve4fykr4Na-nFnT9rkNOG8DaFx8xtnBg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv-eNwzT0HTuMlVwrXzd0Fx5CKHR7V9m33OlHBy5gHNg&oe=6A66016D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl_nMAoFb7sQ7kNvwFbEoAs&_nc_oc=Ado427jsQ1--3zQmEYtthbE7hvqXF8xJNNl4AuT7gIwC0_arnf9RGT7SJo6pmWkFwFk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Tn4OqFvNTRnn9QsxNiiw1LihBskYTlyYJsbccNy7jA&oe=6A65F979"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSbdZq_0vVYQ7kNvwE9IE6r&_nc_oc=AdpWWlbqJKup4vpXkZB83TZ7en6ugjiH4EL3leNNngmDDL0jBTlS4XPy0K6cIEsO3Uo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcmNlEr0xIOL6GJLnre79DGOgV2gOnJHi_WVYAwDsSeQ&oe=6A65EF86"}, {"file_name": "Hero Cover3000x900.png", "id"
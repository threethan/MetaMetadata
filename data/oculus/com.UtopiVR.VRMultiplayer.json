."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x35zK2D8yFEQ7kNvwE5UTf9&_nc_oc=Adp0w1qoZIErvpOrXOrg1s4hKFcZGs60JCNlfV3LzPRVvOq-Ccmu4crDaSPMCbzj94o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05Azbu0TKC2AqJYC11FVR_0otREOktbxfKkS72sDIgQw&oe=69F368AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOSTubHOiqgQ7kNvwGadMcW&_nc_oc=AdrmGWq7U-ItHCHfP8AfDTk4deV2mMYGZZeGuQjwiWXnTve5q-oNHvfJxkKqC5H_GKw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tDGdfTIbsMczdgvB8R5JdeY-VIcihUchW9OgD2P8AQg&oe=69F34EED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_9H8gcwsOcQ7kNvwHsScGC&_nc_oc=AdpL6fxNWF9hNkgvv-tR6yb_jXX58RVCOpmotYUdDCBSajGjNw4qODv5aePr9Ugyxrs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XqNQsbTQXfsRMbWhR_pas_AkSxazu3lRH8uwKAvWivw&oe=69F346F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afn86ZjJ_xAQ7kNvwHaw27L&_nc_oc=AdoJyHD1R0LXx8OZNZzthAvfU_R53_Sz3qfvpknEcckSmuf-VuEPGQD_sR9sQX3BleE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fAEH5ycE-H2wo-1UMjxWezD64RTulKsZHuim26FrEtA&oe=69F37546"}, {"file_name": "Hero Cover3000x900.png", "id"
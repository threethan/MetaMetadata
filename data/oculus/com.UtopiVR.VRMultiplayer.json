3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahILhlwORwEQ7kNvwGwpIT0&_nc_oc=AdoHESJ2iT7EsKD2L52oC5RTX2ZBMBCkJjXz9kG_aICuGSB0eTulO_fwIkfPeXHXT2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPphGRyf4iVXABjxCIvHPNKUAe8J_rh9Ca2L1Eik4wV3A&oe=6ACA440E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twl3Onb9QzgQ7kNvwFSqwVT&_nc_oc=AdoLywd5R2HQvcDLfUm5YOwC0TiELwlr2LZ2M4dcTL2VQgvae2Z3NbnitLmYmTx0HWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhrQYklkNB7ARoIbOgzZ_uQEWKihhtmjpy0G-5UmIxzw&oe=6ACA5419"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nkdM6quqasQ7kNvwFtEpL5&_nc_oc=Ado6vE1msAf7Gcd_2ZD60Ik_UU6RoiLz7YivuI5K8FPno9Lr5LOniNX_AjwcLSZlB60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx2lrC2aAUag1mN9NStBvoVAo96ZNz1KTTPq83PCc1GQ&oe=6ACA6BCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-Xk_C0_4OIQ7kNvwEfPcH-&_nc_oc=AdpBsJIBjNtCl_Zh_l5Wwx5gYNAwl1G4RkNeFrgszFRxuJogA630bMDhCqLky72zX08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB3TpEQADSG_0Eb1YhO7enfiQvuCz1I7pyNg9WCAtomA&oe=6ACB9EAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNAQ5tpdgewQ7kNvwGbvu2D&_nc_oc=Adr41VY-ExanS1ibHIrKGe-b7SWehn9SFl-ghXSaG4tryoEo0RJdHgBG66HlN7q4ans&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhM42ikzipzG-gSCuCgntpyOegZVf9mDWtWzWl0STEDA&oe=6ACBBD2D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-Mbb_cZTKgQ7kNvwFSeKTT&_nc_oc=AdqXdehvnhotmS2pyln7U5yqSEtXnM0DNg15O0QaFrDT8JVQCMSp1XhQpZTCItYtcjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPENf4U_mwH_RIQM639rHdiYLUFi28VXb3j294o1UilvA&oe=6ACBB539"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMvZ7gxk7LkQ7kNvwGc1vf1&_nc_oc=Adqv47DEkJEBiZp3i2IXmGbEvQFsXvf7w6oRpBg_cdeXgyy2CxptZWhAuTsFFXcB9QM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMecrt122uoSLcC5am1XVpkXl1gehEXWN21lnrnpLG_xQ&oe=6ACBAB46"}, {"file_name": "Hero Cover3000x900.png", "id"
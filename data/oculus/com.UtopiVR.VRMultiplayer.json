."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EizmNlgVjlcQ7kNvwFM19iB&_nc_oc=Adqi6dd7NX99noawRrtK9v7ANoFJsF64u8wP-e3DXPueEI_-2Rtxd34rnxQLs7ZaWzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKYRkzQyUfzCjnmtfJtXbewlRa6cRCOspHonRMqmIgnQ&oe=6A53A62F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U72xFpQaMzEQ7kNvwFgaWlR&_nc_oc=Adq49Kz_jJs8Urwh3wInxPAUE4R_0Ma1wSUJV6tQW9iPUzRmOn0Mo6itenok1vPECkM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSApYFXo9H58YwG9DIzaRa6HUbLRgny7a52SludMhkvQ&oe=6A538C6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gb12VPAUdwQ7kNvwFa2HpP&_nc_oc=AdrZJCMuDv_9gv56WyruJM1JcDjRH2cf5WlCX6CQMAyrqplvQx2B6cAuvrtUyWw2IqU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClj0O-nJVw2-WHApGq5Q8xy1xObkPvQGaasYqsa2X7eQ&oe=6A538479"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWOBQPZD0ZsQ7kNvwE6nLVO&_nc_oc=AdobFjEnosJE4huMvHaN3Rfdt-IkE4wy0PipQ65WPxHO7qJAchq2HQZ6XdaYDnBew_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVGDOrW9zvFRSxcPWWEdK8jLlnJ4oO92ll_b484fjHWg&oe=6A537A86"}, {"file_name": "Hero Cover3000x900.png", "id"
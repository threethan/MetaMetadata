."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQLN7GxGdtcQ7kNvwGpv3b5&_nc_oc=AdoU9obVC35xaBMib3CK6JvSS-XJmTV_P4dO1elAbwtndQT5WDVcv84VhHX3Uq3Pq6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yxyB1X8V5WGp4UyajHdsZlukpxS5CMq1LVLcX3kSYQg&oe=6A05DDAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zc0O5SN38oQ7kNvwHWH3K_&_nc_oc=Ado662IHJiDmgN8MH0GgRpqg8nYn6e5ZQQbommoyxLF_RMwOScjZYdV-VZZVsBQjAvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YQOFMUM7qrpJcIKuIfGaF4KtHwgH2NH6pP3Deb0g_uA&oe=6A05C3ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x98pYtzWVDMQ7kNvwElKdSY&_nc_oc=AdrNVb3t5Yf3Rqe12_5IfimXVqRC6S1-kLJMsyx0fz5xGMDX6jtiKYbvhJONhLy4O3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IEYA_qI6QOKBFfAPcVeXbHQN2IQgl_4c_87MBcIXoOA&oe=6A05BBF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tahMh7ZV5wQQ7kNvwH4LwBw&_nc_oc=AdqQP5ryigLyIVJ0KGQsk158fwXlN6TIJ0rcX3JeI92D-TFyNFTamzFbbWV2LPXJ2v0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RsTV7eA2haIEYX2ow3-LHeg0_8lYFXsSDivBwRVLQAg&oe=6A05EA46"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_TqWMfCdY4Q7kNvwHsMFzq&_nc_oc=AdrYs6wrKdbNeBNJHBjQJPGmP1Hoc0XM_MpEKjExnEZtbGFW8AqBRzcS8QzsfY9iTkU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbqYLcFyCxfZlCwIl6ZxjTVsJdTn1izm0j27vUmDtkNg&oe=6AC64F8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6v79xIq1-YQ7kNvwGb0aTH&_nc_oc=AdpEubioKFGydTPnUvrJnO7gRcJJSCPEYfG3paO-2w9WCOxXxKXWVW7EiDzqJeD40yI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6OtdEIMyBOHnIdCf4-BkWzWysWocg7f-sQqZ_kY9dVg&oe=6AC65F99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvB8fK7VHDIQ7kNvwGbjZDJ&_nc_oc=AdoSoUtR49tyCMtYEKh4mz-goU55KE22Fdsg5hLmLeF6F2suo5j2oJm9f5msAua2Twg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEtaxVoQ1DvLKj28oUqVVTlxJukI2Sy-rZFJgaSM3BDg&oe=6AC6774C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
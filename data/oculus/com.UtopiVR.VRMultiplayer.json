3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eutg0aj0rTMQ7kNvwGJXGiC&_nc_oc=AdobHGTGQuIZybUInsXwUO4s30QVFAoS0ixUsjdGgK9kGeNEMJ_pzP7Jaag49wvekPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwlHLS9qN69f1MGfUVEdk_JhUEbkGIKu9z0vOWdohD2w&oe=6A77358E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO6tsc3m1wIQ7kNvwGsUxZP&_nc_oc=AdpmwrOVRpWTlNCyb3f5dMDXxM_FSGevsk7SPCexPf6n8QRoGV2HXRhKM3OLLaPLPy4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpRntmzaRM1jWOPJI6n0x9WdGla2Sb-Ln9tuu_KyFEKQ&oe=6A774599"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37P3_RGcpzIQ7kNvwHgsHjQ&_nc_oc=AdpiVnDKj3TQ3wGNEeEKINMLk4Xn_2xOATnxy79Bgj0cGWm5-43ZohYm7uap2y3Nrpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO0UxW5wrXfSfpz0iplHxX7eZTp-jQzuAHLc-mFGRNZA&oe=6A77250C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
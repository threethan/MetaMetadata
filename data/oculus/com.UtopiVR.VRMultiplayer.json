3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WQiAHj85rIQ7kNvwHvJ6VY&_nc_oc=AdoMt8jUFzBd4UGEdDttjkGvbi9QmKgyXXp7YnDDN6_eB0QWzOzjrE-UklrQeIxkasM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOVYuNjXJtea6kikC1C1ZZjGj12HxydZ3XqqhPrG-buA&oe=6A6A068E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiDFCuxfr7MQ7kNvwEk5_ne&_nc_oc=Adovs7inAXIl1k_e2roFqTrYqdnRdeDLG2o5UnbysXmcDecZGn8hzwIjvImXR5UYFRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYDy84Rufjp2K5h1HbjhzE2JfneV-laWkPLQaSqoLvdQ&oe=6A6A1699"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6RCFw1g8R8Q7kNvwEcrYGn&_nc_oc=AdpKFHmHFZZSFd3NUr109gnXMIW3QJ40F3-DL28JLJfJaT1Lg7yIQJQVSBByBbHWgyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-YdH29kbzSbkBf3J23pjq9F-N7yvqmqMdKCxqO_J9sA&oe=6A69F60C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
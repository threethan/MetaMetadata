3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SidDgZwmsNQQ7kNvwHd2ud1&_nc_oc=Adopxg4JJya5g0Is8y73Jo-tV_bpdefanaO2un3XFfOlMV5PMlOiKuwg96CI_cgLnK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DWAu03qmWYsz-85XJj2T3DcUcq_Y-35E8POWEZKiBZg&oe=69FB488E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxYt7tps5FkQ7kNvwGL46co&_nc_oc=AdoPPv2Yd1djnfOSJ742Uc4sIWCzVtUIlSSnXK3-EBUISDqX8jDz23MGAr7qz7Ul0tc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R-v18bmY3hgPV5QQhz0D4QFTlBSbHIeq152el6zT0gg&oe=69FB5899"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq7W2-djXScQ7kNvwGG-sRd&_nc_oc=AdrvRHX90ThVVf9RGgg3amqXMOWxeAhkr8KEXMfDjwG_5ZUmc5uJ-KNMuEI2iyO37Kk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xjpDu0dmRHJcI_Ak_DX0WZN3uTG22sRgFZAYmde2WkA&oe=69FB380C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
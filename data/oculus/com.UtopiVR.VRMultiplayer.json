."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoMqInmjKgIQ7kNvwHC1yvS&_nc_oc=AdqiRVDS-62k3TaPntjy80bqU7F42Mz59-DHYXL1i4dZUAOcblaXZeSnHbcTUodwvZg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-np6sEcVwWFLOft4_viVbtFusGnYSwCcfpnQh4v8u1HQ&oe=6A41312F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbqpFHhgPmQQ7kNvwG1-X96&_nc_oc=Adqz0cidYr2zABVnFiUYue2I7K-UcvuIw1Bl93zVb32PzpPMhuDGHY2Q53e4jEC4Lho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zH_LJ4QeFx4cBHWbHGQjbQS-NUmMs98s6xTfTf-G_vg&oe=6A41176D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMIike1HAB0Q7kNvwHpvC8d&_nc_oc=AdoDwx-ZbeOrhT5mY0gowb-rkThsmLNG8B2TbVkpWcnocdrbbcz9b6B1AOdpp5oGluo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V6maSqAAvizuPxvg6NBlT3EmW55OmZjeOPG5MZPbC1g&oe=6A410F79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWkDMqqOXZcQ7kNvwErsBPp&_nc_oc=AdpcUdrzNeYCdgjx_tTGN7R1OYlF3xarruNWA4-CNt8aZgQtf5pTXhF0eDK7Zv6mQXU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4dQ4nBk-_xSWK8BVhQlosT4LhmDRdCDxDGgwhqpv4Ng&oe=6A413DC6"}, {"file_name": "Hero Cover3000x900.png", "id"
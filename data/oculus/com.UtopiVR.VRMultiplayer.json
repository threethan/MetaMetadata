."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDcj9U8n5tEQ7kNvwFNPzs8&_nc_oc=AdqR6NobmNJngBqPiGkjy5tqAVnSBz0KNPBzvs4U0f0N61sVRO5SfusE3gFr9IItg1k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fkCK0hZFoHlry0n5wWmTqMdNdYo2NxISotVVnB3QUHQ&oe=6A0C752F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvYS16uxRwoQ7kNvwHzR06z&_nc_oc=Ado5uqe9ivltkvHd0oAYVL32U-JTXYnvRkp_6-zMz09HSPYAYNf5Nj8lq-35EZrQWj4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TjoOYbwcRYkAkvyTp3I7kockDOMiqZXAAWxz89pyG0g&oe=6A0C5B6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IcxLjlGa1QQ7kNvwFRUryc&_nc_oc=AdqimUfW59NUlj2LDBXoh3bCYFe9ot6GQQc2ReOIuI57dBBgu5oDA62b9g3CTUdWd3s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p5h9ZUFEb--rx7z7c4zSUz30wux8ca0c84cdLu3lKfg&oe=6A0C5379"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_jl3fmqBkIQ7kNvwHDZ-7V&_nc_oc=AdpBQeh8fMl2fVRCeXAuGRYQeDuNdJnGLYPfqvbiwliEQ7eODMk5aJB5grOZkhMGxw8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eIvaC4mDmA67Z8s3S9BV33_jo5MWqJHlJJpv85XRyAg&oe=6A0C81C6"}, {"file_name": "Hero Cover3000x900.png", "id"
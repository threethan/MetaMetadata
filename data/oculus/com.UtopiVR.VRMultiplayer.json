."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vQWnFOccAUQ7kNvwGnqdo6&_nc_oc=AdryO3Snu3bP3A4NYAlPaqRfewhZgUgv62esgk8_rQSrSRFNSw6rD21f_47lxFZWSqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkm-vu3PLkO1hGBzHlz_VhQLBR3QykB4fN2DAJXfRNXg&oe=6A5CE0AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=963A7DODlr4Q7kNvwGuIsbo&_nc_oc=AdrX1oUBoGzDvAnxjA0NmKHNKRoG7K2wX8XrEm-QynNfw4j79COb8NHRkthYfPs4eRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWcbq6I8yGzyldrAeJGyXdkbg1gcDrwLYKVzdEiDbB5A&oe=6A5CC6ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHqm3HhQyvwQ7kNvwHi3RDE&_nc_oc=Adq7CJzY_NyBG12qxrJTpjTaIT5rlM9KdaRd4l4C2SAIcrZT2-YXMGldGJZJiPZrzQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7JQHjn2el_knXbWND3i4OhCz9aHNO7IKqcKGIU48hfw&oe=6A5CBEF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZNRqceef_cQ7kNvwGkXZyf&_nc_oc=AdrHKZP-6D-rQMXq8vtzGov1cJrJin9kLLbInr4pxpqvdZFLeE7RegtrWxMktFEANeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVGG3p3cESrfFclKXeM5t_bNNfZAb_PLd0cO2qzP-Qmw&oe=6A5CB506"}, {"file_name": "Hero Cover3000x900.png", "id"
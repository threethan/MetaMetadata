."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itKwCFgzt8QQ7kNvwFFz19q&_nc_oc=AdpdndfZYbPG6SDbgcymIUDjgQmdYvjTQchR8m1BPp0xRrXBoThWlLP2jOhTnoKpXkE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wxAmGye7Ab87CkDhYVP_urxzG63lcd_kFdFDY6x1ozg&oe=6A3D3CAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsli1CuqsEIQ7kNvwFXnhZg&_nc_oc=AdpFEytPHHyKKisdgchy3aU31B-DlDAntwPBkf6NmRZ6RFIqjkSEve-hSIIlebccsZI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kjhonCniy3YL1IJHMdvBlFeMsX1gqrJlTYTnvCE_Grw&oe=6A3D5B2D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skx9y6PI-l4Q7kNvwEtOFMh&_nc_oc=AdrFaUN6hZaM3fAdGto4tbqSOWnkJQkZo2xdVcQOxH87v_gloru4AKzyfoOJV4OhYro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dvgN92EEnP9H90wLKhFniEkcnkKqUs6EQ_xy32IPkeA&oe=6A3D5339"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9buxZk0ac7wQ7kNvwEgXI5Z&_nc_oc=AdpwMMXzWdh68o0-PKePZOuPolSykhf3hhyR0S2u0rwO1Q2BwDR_YYdmJirw6tWH8lQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eJA4kHPlYCkWnMNIWhdvHhs5zyh-4ZjBHkr64UxXMRg&oe=6A3D4946"}, {"file_name": "Hero Cover3000x900.png", "id"
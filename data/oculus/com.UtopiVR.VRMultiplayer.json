."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR9DNYryPtEQ7kNvwEDeGg5&_nc_oc=AdqaMCwkf0miVxm7jXmVTfJJXR3E9suZU_7HM9NlBm6yih77-076zipEN4XB4o4P9tY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n6N-XxeTRiPviZbZDLVvPSMnweXWbkfdaLOK8ySLX-g&oe=6A1C472F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avSfVpZXl4YQ7kNvwFj9ooR&_nc_oc=AdoUyirvFgt4KzvIoUG-1NtPycsZSlr0_CukBHf9R0gYEYqAkibPMqgAZbrLH0XBty8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L47SStO5N5R0OqH4lwWJuXM6uFQpfWlFRLVofNwJ9Dw&oe=6A1C2D6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R8zS4yx5QkQ7kNvwFI4HwK&_nc_oc=AdoOINXRk3jZ_R5Ig6HDmXEPJ14Aj2ByzOvtQoG6hKPsNEA_p1mLtPOw6OFq58vihxA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yyBnY2awfoz97V9H22-3PHVpXFbIUTisYGvCgxDpL_Q&oe=6A1C5DB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osIniCDshrQQ7kNvwGafaWH&_nc_oc=AdqNB0VXadYhjj2glXAlBM8CwqeFagBEXP05FY0lEARWVrWRQzOjx30LJCGznt0BHGQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gF0tClr4ji89_rN6So2jPaWKne31ZW2ylvh2vIK9PtA&oe=6A1C53C6"}, {"file_name": "Hero Cover3000x900.png", "id"
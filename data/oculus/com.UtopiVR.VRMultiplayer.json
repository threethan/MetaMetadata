3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JdP4qrW3b8Q7kNvwGNS9Tu&_nc_oc=AdomJtQx9PxWs7ZvQSq_fk_kVArxa4WpAs9CTIMDyLsKE4tNgEnfeOtD5NFh9eioc9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxBUAQA4WKY5nSGxrmRfCOWJ7AXhJUC6_yrXWQizgWGQ&oe=6ACE388E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb0AYMd7MgMQ7kNvwF2q8Ak&_nc_oc=AdqmFxDkWwWVposhS-WH1KQSbC2PyCl5uvdBzDg5TeFG5uQzoCTdJJOJA58czIN0JBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5s_qI8hsVjSasejaCgkS-FmhTva3O2p5rZESkevFHpQ&oe=6ACE4899"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYyjzK2P9hkQ7kNvwGwlFEG&_nc_oc=AdqeQsJ_9tGe--9pByqJc7eiVciT90qy0uP3kxx6acr9-BRaMK9XN5P6GNNqjGn1jg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYbAv-diFdOsxAAErfUeEDqNZ-ljgsSwBxhpMM1rFpaA&oe=6ACE604C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
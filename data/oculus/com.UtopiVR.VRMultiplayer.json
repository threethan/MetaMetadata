."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX-SrXSBl1oQ7kNvwEI-tRx&_nc_oc=AdpqsvDj1nP3Tbg9KQcExs5rF3pMnbSVUEoeztiq24f_qXoIzJrh80Jxp_w4WlTuR0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1bL4IP9dKsRNYgtTU6rIkzA39xKQuT3PS8y9B99gNbg&oe=6AF32BAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpSYfG1n5SgQ7kNvwEgqJ-S&_nc_oc=AdpMADgWgcOrlTipbmieKYaXcb1oEPbAjS79bYRtEXEqfce4fPJycMMUxpA1JPyeS7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVfWVdbQgPrVjQp7byHKEO2fUNn1z1gr5Z_0ErCTic3w&oe=6AF34A2D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO9VLBh3RrgQ7kNvwGW1l5Y&_nc_oc=AdqvUJ3VQLKoq9UexkqXUlkAslI9GP0ePe2X28_QANnhW2O05NBswiDVejExB3BRJJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZuM-GgLU9eccsOQtFlKWdUPt8KGGtw6mqcjrIiWsFyw&oe=6AF34239"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1ybaYQs4fIQ7kNvwG5D3ji&_nc_oc=AdrGV0R5ZP4okhqnz7DPJakBKvHEh9Od2g8GhEs7-kAWB8ugt_BqyfK86-U5vAf5vIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGPxD9_TguILvCKobqtgTWTf9MkZq-AaZRYEQuHA09Zg&oe=6AF33846"}, {"file_name": "Hero Cover3000x900.png", "id"
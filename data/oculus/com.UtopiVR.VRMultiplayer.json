3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MueQQySR_qIQ7kNvwEhd6Dj&_nc_oc=AdoQYRdkwGbbm85gCPUs_5ZHWnbsLHId7pa98rNfx9wc_zfZNdUC4BaBpx0qU-VnV1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODURlEAaSQLyDots64ehPKHfEi6XPnumLbULkN5HWh-A&oe=6ABFB80E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caXVoJ2fHHQQ7kNvwFzqalY&_nc_oc=AdpGp41BK9zfIqHujlR_kEzp4xv5jc-ulitidCmAGMXbUTfBIhgpPMucaYEI2I977zo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6Dfm7vx-lzROpt7Jw9rWQ6blr4uLeBTnconDT6jQhVg&oe=6ABFC819"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I3kpmAkr4IQ7kNvwGjn7_e&_nc_oc=Ado-I5dpToYkdKUZC4YpVcWMj_PlQAtGB3Wr34b3N8wLddk7zj3hj9hceiqG845fkcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPig7N5cedOB6Ke__n8aDaUq9RYw9S9O6ptrt7x8-cGsQ&oe=6ABFDFCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC0agYSDlb4Q7kNvwEsirRc&_nc_oc=AdoOh-JDi58wK0tzjzW_B2TsSYnFSev3Qj3PkchPFGs5i-Tvv7KzIegzQVYoVF7GgMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdG54tGi0yQw25Agf8K1OWRMSHM9DHIW5TUGM_GcO-pQ&oe=6A4D058E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph_avbK2-C0Q7kNvwEFzNVN&_nc_oc=AdozRVkEMgQCE3tm2XlwsPXiy5LhjkVIn3KtXEYJAVb2TrDH_dckAK1yDXIeW_WPAPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT3d8Lt4_ZlAhfhrhMbfLgziqhtXE-MHGNnXIoUnbqmw&oe=6A4D1599"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wave8Jq9-HYQ7kNvwH_k126&_nc_oc=Adpyt75zl5eKVsl23aI9N5hXEPlGL4aGPQc2m2OYYJLGr8idDtGrGklL4giauyKQzDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIVm6vnp1TKTmi0AJ1gDyxnFr3MkerfT5NHCoTlDpqJw&oe=6A4CF50C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
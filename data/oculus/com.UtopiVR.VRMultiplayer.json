3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heUGdMa3qu4Q7kNvwF7x0Wb&_nc_oc=AdoD1pelq5YLgQeSDLAnzCu_uCPdWPTLJepZfCFgYXudCOBU0LyFKmd4Uc0EU2OyiIg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Twn5zwOK2Nh_Mw1XoqTEBzgt_fG4sDRTd7y8fDllvXg&oe=69F35F8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LUxdgbLEW0Q7kNvwESRldY&_nc_oc=AdoNkJomnYZxZZRtJN2ECBztPthZ6BwPu5Ls6J_6xsifNAYu0lkAdkOb6wbUzHcpwFE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3I4CK8tWEHbmAOwOws2GvYKGciZh4XglM8XnqO7SWNnQ&oe=69F36F99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nM8jQSAD9wQ7kNvwEsIO0w&_nc_oc=AdoHB66DgxK7CPZsI3yns9WhU5z6P3tQIZLSZcxFVEgTuslIk8TGJCXhohubh_3oP5M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17M9CptPAAnm1Ong3wrpFXM1WaH88W-MLb5lTECcoozQ&oe=69F34F0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
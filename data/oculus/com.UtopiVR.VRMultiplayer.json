."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek_vWOsx33wQ7kNvwGFq2pY&_nc_oc=Adqn30GRdX5w8_XGshaUDW0WcaI5EFypz7BWl0Y9-dm6pscUo_gTKZdHzbgpQq-9QZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLarT5-yn4LmISMNzfa3_esnpIY6VumNlKN1dVeAK1UOg&oe=6AAFEF2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjaRIIPtM68Q7kNvwFIkVGa&_nc_oc=Ado-TPYsxc5J1fkygFukZt0Ut9S5REhKAr8yuDXw6NY1jZf_5oUnI4Hmva_codXktz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHNP6IjAFLes1eXBE3jDJlQWc8-uy7EyUsPsuedSPRiw&oe=6AAFD56D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLL46xmlJToQ7kNvwErXxgl&_nc_oc=Ado--fZ6S8w1NOBtMHafV7jYcdLqhFvtgAzQwfZPHMC3OE6lwsJqXNknE0ds-RcwAYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXtEx_WoEvNjTuv8MO1cAZWzT0uPfPJR4SRYigWfI2Xg&oe=6AB005B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVP7y0pgzZkQ7kNvwHChJ2e&_nc_oc=Adpv3hGoK70vBuHnTRRWlFL7kO_RzOMxWzCQnFQrE4oexctl7w9JOGJSqoR9aOSH0tY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiFNLWaEeywdw0tU7SfEGyTu8DcdesXP9wBgPvyQFxug&oe=6AAFFBC6"}, {"file_name": "Hero Cover3000x900.png", "id"
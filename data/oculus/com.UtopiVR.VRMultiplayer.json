."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g50bR8wgPUkQ7kNvwE3zczA&_nc_oc=AdqCTq2rJYie1059_619OSW5aTbg1xINJVnKpyc8Z914sq7_waV7bBDBNK0ide0dxs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1C19i5NTVMBSMChNivbtGHzXEQCl7eneoKUD3lzq81Pw&oe=69F75D2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hcw2AGW6dkkQ7kNvwEqsAof&_nc_oc=AdoJUQv0geX3ZeWGjV4JMKZaL2dPz78YO9njcinyXQ1u4w2f6-TrTdB4b74m8i0Wd7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ON6IiE2bRsAGdVIUiBrl-ArwZfyVQOUm5VbEmZTj__w&oe=69F7436D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3oK_qbJsNUQ7kNvwHKpNwu&_nc_oc=AdqmUnfdtEXJeEVrRKxhHDTpaa1SczwwgqeyhrzsWKd8C_MigHURxZ6E8ThWJ8o8hM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xVo9IdOgc4d1Wg5Uxv28wd1DwAYlJ1yYmrlv5SHK7WA&oe=69F73B79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj4Yy86QrPwQ7kNvwGFD7bB&_nc_oc=AdoKbK6iKHLxAzOXwiOHKgufIs2ezK2TGErCqed8FKzePsZJIKZHUY4Uux0QOj0HXjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3w3nIW058SPSzvS5YCGdj-rUosfugJTk5O1ZzJCLmZeg&oe=69F769C6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YATPeaBOVYcQ7kNvwEw_NZp&_nc_oc=Adoz3mW9VJjk0YDKIiZIkDNPjoDV9OjMNgvwYFblcCq7eloJmq2GpR2QjwfWCN0XxO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH8eP4QBMG2d1127RjpVwtuO6ifoHdCaE_yubUZtc9YQ&oe=6A4D0EAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUIlMEdfOcQ7kNvwHbKSQE&_nc_oc=AdqhEB6nUnnDOP9iKNbVMfsrwh0Q4NAffuqIQlvpZXGSYurionW5Af273sZ7XiKX88w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwjCIOJj6ilDx4AyNfU9JRg554kx5OCJpLilESKSFbgA&oe=6A4CF4ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LljlvjCt6UQ7kNvwG7qfH7&_nc_oc=AdogkC4Q-0JlaHFxRzQnkUS5F2EF3a1IStK2bHnDHhxOjgskM06UOCtlZJY5RCO3eYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBmSlx-12Em2hBC5xpmTW_fKnbvi_U2lrzcYEfW5jeew&oe=6A4CECF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlWnP1N4NcIQ7kNvwHAloS2&_nc_oc=AdqzTsSS4FdDx0ayJG6DgZIkMXYSV0lPSyNOO21ti_YWgAC5TbBr-6ZaBpxBghoRcf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2cPb_wFbdcr374rwOG0Jr0PgsYcXG2zHfcw77Sc3Wtg&oe=6A4D1B46"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4vpz7XQAuQQ7kNvwG2OYGK&_nc_oc=Adp_JdJB5YMAHh0ih_hGUxywvcUpFm6juz23eB8uhhzRfJUxnaaYz3OFAcHJdc3Tdpo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzIsG-lyjBRyxaCmQ0jWT2eEwU-XqN2ObXi_Bhec5dPw&oe=6A749BAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgkysdEg7tIQ7kNvwHR8A61&_nc_oc=AdondvK4vJq0QKywmN0H92MbcIkMfhfQXmLS4WWVmGM0fLd33eTBa1y9I-qgrtRHcdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMWzaZvtRFLN5ZKwIEglbJXckwMgx9itNkAAosN8obmQ&oe=6A7481ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMc3kl537NcQ7kNvwFszyNS&_nc_oc=AdqUpFm74WcVjJTNLRoj9Ew4eFLike6uIZPCDzM9tqwp8EkWHWZKqRE-tOSC7Mkt_FU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD22ccpxRyqONjfCtAUuBLPru8F46zb51_VmSCn3u05Q&oe=6A7479F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8GEEN-ZjgQQ7kNvwGab4Lo&_nc_oc=Adq5SOPJ_Jsp0lNr2PZiOxzr4EJ6GYfW3pe4l_SBH2yJXPJDR98m3pR96xBleKzoA94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI61b7F7hhtej_Y2CSmzxoviue_zaWSBHDS_mT9467zA&oe=6A747006"}, {"file_name": "Hero Cover3000x900.png", "id"
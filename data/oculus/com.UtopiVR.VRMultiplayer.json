3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fTk9BMwtlIQ7kNvwFjhHde&_nc_oc=AdqobnEcee3ZtMe3n801Zjp3zkCtd58PreJ9e4FtHFPDIIVwPYrYk0kr-HOf26LTW-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92qgy-CbviDB4IqQkDEAPrJBOycQ5uo2FVqSRSHxFZVg&oe=6A31560E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G2jUAbJXgUQ7kNvwFtSsAK&_nc_oc=AdqEjXvgBMxCQqZ5jo6Jm4EEc8qJ8HRSlBKRLJ2QZmxL2waNe_MuygD0GEBZ5YCdndU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af879hYBoVgRoj8o8qC0o5ls0Ch1dIBuoKDgZhxOt9B8ZA&oe=6A316619"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1tHMKV3vcMQ7kNvwFvRtgm&_nc_oc=Adq0iO5VDMASUWVQ2opXIQbHIEztkGJDxORaBeDmF48GSJFZHOOP4mmosldKsKtp7cw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88BgxGmHXalV0-NMbSOu66w_twaShMDx24t0HFVLO-wg&oe=6A31458C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
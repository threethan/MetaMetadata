3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mW806zNdWKQQ7kNvwHJw8qK&_nc_oc=Adrc_VYKXnHDbtpMPdirIcyp1aQFE61ugHxaW1Q1HJTb6tDz1Y_XyURJOGJYX9s9G2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af455LEiJ0TaRMb2F6HPigKSAO550cLiQjIgJ-dC2zD8uA&oe=6A199B0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_LviyGCUT0Q7kNvwF5fwTC&_nc_oc=AdqVZFhula7ohTu26j_eDl6-UVsjCSCD1jGp0V5CyAY5k2nIoVFN3zVju4twv0898OU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IpbW9UZ8e_r9dax2TsEaIYD0gdfdzVZ-kzby6CC7FzA&oe=6A19AB19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dZVxhOeepUQ7kNvwHPB3t_&_nc_oc=AdqmoGMzW1poiVaaAfHJ2k8nz2-cbj8lwxRkpoLcchQ6vSqkZML1mywkflmK2s2f5hw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MWfZPxP6Esro9HUat5jPZeCHFBdtQJJ_9N3lI2SYBSQ&oe=6A198A8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
ut borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oPaH5r_ReUQ7kNvwFfRvcs&_nc_oc=AdpoBvOVESltzAflXMxJWnAl1Ew3ptyc6Kwr5IkQ3zhnhybBNF9iVryrfU3By2vt7rg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6btXuwrWWxgxGO74PQ6sxaR7UCt2yr-SYaW5piPSAoA&oe=6A8EC16F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvIJy9fPnPwQ7kNvwE27JFZ&_nc_oc=AdpoReshTBTOx_nt3eNNAL7HqvowvAui4xbvu-nX1LkharuV3TeNkvH4BljiSu2uJkI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhmCMNTOruQWmmqoXxKX1VL47xnX36c-ijriHkl7udTQ&oe=6A8EDFED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEskUFzUqA0Q7kNvwF72mPm&_nc_oc=AdpgTx7PiYswLM_MpFvtuGjguGzwGZTwAwuwnm0t91FuwsLskttMjBPXNGRtsaIt9-Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElZElUBss-qmUGPnzLO9YCdZPH4UmWKEWkpnMjeKVXbQ&oe=6A8ED7F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqiGOcWLJFYQ7kNvwGDHhxo&_nc_oc=AdozpSKCCwEgyCmMe5BHJQqgJin5zdq6bV5AVuM0fZl-9AfUlcNn5NyEmp0GRObcExY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_hMMaMOU8e7qWIObD5RLd2XfHP6XFeO_ttQZBug7CMQ&oe=6A8ECE06"}, {"file_name": "Hero Cover3000x90
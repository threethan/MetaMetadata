."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujYxEejocrMQ7kNvwGMBxs_&_nc_oc=Adpu6Y2wz7CtLk7hUORmX0YQ0qtIrkPvqcZTME7UUc9tZYm66bipU9BS9_RlgU5kfGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3JUUyc0KNaOGnUaYupCpfYO-7sCkhv7EpaazBuw0fGA&oe=6A6E042F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOsBAd4VuKIQ7kNvwG3MfU_&_nc_oc=AdoAn8xOICSYdvH1fyMqo1tVhL-NhusC0-HWOMoExsvzn-hk_N7jXg4z6gJ3NaNyi8U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqV2gcaB8lS_9YbJAkRjWOq2HTzsua0DZ8p0O2mqP2Pg&oe=6A6DEA6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X3QothmvPQQ7kNvwHFH9ow&_nc_oc=AdpZx5ew94ksTXzqwn_AYzgpytm1TQujkvkdR4tTYKlgtkgrUkTr3kcJhx5wXcZdoGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb5hpByTw62HToUJMsbKQMFMjDPqYhKcJbQqLco2AfSQ&oe=6A6DE279"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHJMi-Zm07YQ7kNvwEknaGG&_nc_oc=AdobB0P6I3Nb9sSXcbDEns2JuOybBzya19kycSeLY-_UOBLczDFed7objbyPLxZLVXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHCo3nTzf4HnK_6U-H64651lNn3WyS-grE9o7djEpp8g&oe=6A6DD886"}, {"file_name": "Hero Cover3000x900.png", "id"
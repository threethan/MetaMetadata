3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NodGIwmle-4Q7kNvwGk_Cu-&_nc_oc=AdoCjsLa6lkBy_Do-A5mOnCujr7il9YDuuVlk01OwNxnsfQKL1M8YXfixBZJPe1JPls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zYWnY21fz_I2LTZqkRwXAyFVzIP1S3wxYw4QG29InUg&oe=69F7540E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6qnuFeEyegQ7kNvwHeAXVm&_nc_oc=AdrCwZWh31J6rvwifjeq6HYSNYRQUPaW1fsyTOQjB5K0z1Q154FlWT-rOlJ4UciWW0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3060dIWX0dgMlyYBo_OZamZFNFBs3w-e8RCJlLFKyr6w&oe=69F76419"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXMM-2e3pRAQ7kNvwEPjXbE&_nc_oc=AdpMV6OTnRRpcpzHIqnun96-lmPCyRDMCR1GlZ2YlGle2xhm7Ux1daXvcDTm8XTMz8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KvT12OrviakpQoF3IzzorQsqjexsC3Jz5PGhWpbBX5A&oe=69F7438C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
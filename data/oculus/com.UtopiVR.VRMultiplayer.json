."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FegThtMtfO4Q7kNvwHMhjRO&_nc_oc=AdpD2dqUsPtMgYwdw4OXi4MV_IKnxnI753TD4PKeZohlXQdq21MweGy2pvhNa_Q7ENY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINc2m4T-L1NdpiVmU_cSwnKp_PCzzu_BpanQ_u1RVI1A&oe=6A9D7A2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpjv_kQmp5YQ7kNvwHUm6Xz&_nc_oc=AdqjLdWAEnpA6VK4X5Iytp2lpKyK6VcK9ULPjXJDXvWrrTArlZeAWEqT24FZ03ICznA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInXtg2gHqlCbqA2YMKZIOZ4uNWgmKus70q6KRO-qyinQ&oe=6A9D606D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42ORyy1a9jsQ7kNvwG9OeU1&_nc_oc=AdrD9t3cMOVvtih75pjhfKhIp3nPYvyCWfoNDSpo8YUXfXadM7srZzm9ic-DW0IwUEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGrA2BuNs43RHNDUcnUBuUt5iU4VbDM0qXFZllQ7H9JA&oe=6A9D5879"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQ5oQioEI1oQ7kNvwHKkSut&_nc_oc=AdpDFguHkh181b97KFzeRUVdgOchSOiU4qJOCmQCPQWjSdM__HoUtbTomTwpVebISFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAJK1HbPLLmrN8psBIl2cnvPH-SXyaNqN7Sy8rcDRDig&oe=6A9D86C6"}, {"file_name": "Hero Cover3000x900.png", "id"
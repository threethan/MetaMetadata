3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H333oOnj5LgQ7kNvwEYk3Ei&_nc_oc=Adqz-Cli35C4jJdaswnrkycpqhvT7WS-ink8Qj6QhdIwLd5lvjaG0LM_T8ELnCEecpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ_MWhycmHktuGtbas5oeUCy2F9htKyTzkOioyg7a1yA&oe=6AA6AB8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExOQBbkyiJcQ7kNvwGlghjg&_nc_oc=AdrC_DrlkVmqdCHMKZnrSW0RRlmn1EqUKzu19oLdxXnzFklZx4fb9uU7UOqottVVFCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwQGkbySXQC6mbQ52fFLwXWYzjJlmIp0NzYMxF3oyFGw&oe=6AA6BB99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWSXawJMjfcQ7kNvwE5wJG_&_nc_oc=Adp-Z3byQAoZ6p7OthTMcxArfNoGW7AQ2QkC2Nkp-4I83G71XS6InXak7aJ4327jGFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOejLXMcF3EFXzHEtQJyyazgSolQ83n7E8q25wHMK7vA&oe=6AA69B0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpsI249udYwQ7kNvwFPFZck&_nc_oc=AdrZBu1zp2r5Pc4PB5O5XllL63UPREjXhiBk7-eFns3hAPaRxRp3dZsyYA34n6bzjSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkYA4gCYGtVA4wRfqzEu0D-Xx6rLbOnSUwtehZZv_2Gg&oe=6ABBC38E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tBYVGCB4e4Q7kNvwGW5LR3&_nc_oc=AdqHthNdudiNhsyq_Ei-5gBGjVuKIH1W8ba0mdXMDsHBqhy0UjEJX1nZDUsDRINhl3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI85UFKFsa-uT6-Rz2a6OlFSEoawVT031wKLZqYqPkTwA&oe=6ABBD399"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qRQ-QJuK_4Q7kNvwHLu5Kn&_nc_oc=AdqzCmLpy2l1Vs1P7cJY56aF2kX9UPFiG9-YYlYiF5L_z9tyLvp3nhPVcR6P2bUrEt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoYerLHcIQWS3k_KZCR7fDWUYObG_htUck8PeIw7tmyQ&oe=6ABBB30C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuB1CAwOc5kQ7kNvwFAE5BX&_nc_oc=AdqS42B46yfpVPXcQBigdOCkQYg-abYrcBSH-V8WDLp7CKsy98LKg-aBUG2lzBafOdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Q6JfUzy_vHrDhz8nKxnUnnIysa2F6dIAmS-javvKrQ&oe=69FCA32F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbSZC71aZeMQ7kNvwG3-O1I&_nc_oc=AdqrzYbjwL7z7WRGzmlhrqXARi_s2iMEtR5tTzWkw2DbGAByd11u_rtEX4lOv5pREKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66jvZmZCvTat_IjAoDIWlRDWIRU7-Tkyj2BCLEwaLjTw&oe=69FC896D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cHYoW9kAtoQ7kNvwFNRX6s&_nc_oc=AdqJkrN4pX66C3op1jfqXSQ6Zfee1bSZASOGfOKRCuzD-CBK_KnRnV44GDUe854TUQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sETq2xBit5_hwToJLkooS6rkP_sSesMMHEFS67tUUBg&oe=69FC8179"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc6idHtRUwEQ7kNvwFK_O0C&_nc_oc=AdrloeaH5bxa_P1qOBp5m03njb61eP1F89C9orv_L4v3lHXoXZ5Oyc1-35hszzioDXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AYAtKnCS0Jt_XczE3WPqucB-Kt7TwyqjTUOOxsQWmqw&oe=69FCAFC6"}, {"file_name": "Hero Cover3000x900.png", "id"
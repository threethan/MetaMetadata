ut borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oPaH5r_ReUQ7kNvwFDOkQV&_nc_oc=AdoZFs4dcGP5E1Hdrj5kR2UjBPs9IhNq3BSpNjyN4z_SC0TZ6D-tCMLrUDFko-uIeq8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOSrjmgTvaLz2FOYQde2DAiui5ReLju9BjcnhiSQ8jcg&oe=6A8D6FEF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvIJy9fPnPwQ7kNvwGRV5EX&_nc_oc=AdqG9tzMMOU2SWJ0nsFmje-W294GZRLwLXy2qqohxLR-zGztvaZZQmMuprHE9kUnFnA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPKMCTU15KzEYZURCSXuzHYRpi4KTryv7XDR0PxtKCuA&oe=6A8D8E6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEskUFzUqA0Q7kNvwFHUbdK&_nc_oc=AdpAUV_YZ-0HpiPdvhv7gI0ImIlA50vZDUFNMPmaQAoLs678dqWt3jSXHLwwVjI4Tcw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6HXjXf5jSu1HpB42Tcb_SkVI_0cZR6xZtZ9vzN3AXnQ&oe=6A8D8679"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqiGOcWLJFYQ7kNvwGPpe9u&_nc_oc=AdqvcetJ70JNwXDCGs93QNqYNByMECDaikTG3K8r3ftoKmgxPKQMSNU9VFJ9wpTfOg4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO11FIlmeLQU-nH-8mD4M135U1dhUt9flHwgdR55podg&oe=6A8D7C86"}, {"file_name": "Hero Cover3000x90
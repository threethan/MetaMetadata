."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOcrTvQvwKwQ7kNvwHWn6E5&_nc_oc=Adrfp8mymTJgAiLdXcIjB7XegsQGrLoT8aFdCmWarWelhbXgP3uI8Xgcc6ZA7X72yVs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd4mQxn8nR3uabjFhzfVkyBp2SHQaukbTRzRcXgJYrpg&oe=6A9AD72F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV-S8WOmlyMQ7kNvwGpvvof&_nc_oc=AdpFJpET4S14sdFRpHYeUMm6ZJWbYsbQv_f4aStxzQkkw0dCCLVJpuKQQEn5QlJ0bMI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyQ8SqTVIdDa5zvUsWI5XN12_lDQQjGCNh91fW0dCTPg&oe=6A9AF5AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW2PgRacCrIQ7kNvwEXBJut&_nc_oc=Adokvtr2-5oYK4T0xMLkbWSMo4H9_LUjb7OipPLJ5QO11gzcJfwnmx-_98VZ1POlhII&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH3zuUJoTrXKZgF1F9JE3Hbc2bfGsaO3bRForoeii8yA&oe=6A9AEDB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zO34oeKphIQ7kNvwGcTnlD&_nc_oc=Adr_tBENCsr3t6vSOfhGo7qdg2l5BOVprHPQnWnXTrx9Bln6BPyEvvD-flgZgW1Vhtg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJhlXkivcN0GhCGMdhJTA4FI290XUfZvJQzdyDa8uolg&oe=6A9AE3C6"}, {"file_name": "Hero Cover3000x900.png", "id"
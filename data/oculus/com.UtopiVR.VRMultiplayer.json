."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNXFxDHhYdkQ7kNvwEKb3Ov&_nc_oc=AdrHoprHH0gP5q790rQCUfzF5CkcF81f3avqtjZz2GCRH29Z4K-yt_2d2YTe2l_4LbI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFY4kjw4GSWTK6SpnqF5FbdPMsUeMO76K-Ke_ZhbR79w&oe=6A68BE2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1dNvLGUdZoQ7kNvwHrESX1&_nc_oc=Adq6yRnO4iFnIhxHIwFjy_ZuLHtQiwvhVuKAXdSFrJjkagacRmNjhT5-eu25TxM2gnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1XrI47jKf5WsuA2616jIsMy9FDD4MKeAvtNKhHh9O3Q&oe=6A68A46D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl_nMAoFb7sQ7kNvwEgzfEK&_nc_oc=Adps1bFcKUWQuL3l8_paodw4wxg_U9K9-KPAG7JtLJ2KC9_JjNb7Gg7zW_CVc47jZag&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwp4ixQWsbxkYjKoxOcAYgUCL6Wk88wpABLFu0YiLmzQ&oe=6A689C79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sP_dEd2QewQ7kNvwFIAzeJ&_nc_oc=Adq6SW0vF14-F4Nx7Eexhh7wRSvDHBAqJ1_c3XT1FNfWFOSiNL1UWGjywOEFUh3qh40&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuwPw4tEXjo8co1nSXWQuQ11rsoeZTE12ZTjMYhCXv4A&oe=6A689286"}, {"file_name": "Hero Cover3000x900.png", "id"
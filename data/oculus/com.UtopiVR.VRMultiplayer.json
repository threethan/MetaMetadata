."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq15TWMnlaUQ7kNvwExoz0g&_nc_oc=AdqjbXf7qR94FAu0BbxD4TJC8v8nR0xACT2fyz5TiaM1dzH7hIMJi7FeAl83cDeKhLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CHub90ukqGy_4LUdXEfy1RIuJcVTRjLO9psn4IKWPHA&oe=6A37F6AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pShWWyOuoJcQ7kNvwEhTs1y&_nc_oc=AdrdceXxJO-mGvyHwTFawwFC8g0WbGP6hlxVwpNJSUW0pT6yL5LG_sBf13wGLJG0vNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ptkqKS1Oy6N7VFrSd_eaKtfuZsbFtvmlDp8rMoud9kA&oe=6A38152D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=771BSS9NubEQ7kNvwFI0-Q6&_nc_oc=AdrTqtUGoUSwclQEhV5W70uelcXcC_UjCN32QyhvBy1n6qOImCYjW_Syd6q8d-wC6_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x6pnDAJ0S3qcOsNvzJQyLmVmBE3vNxZ0XVJN62NFoHg&oe=6A380D39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GhrQyitJycQ7kNvwGi3Z6G&_nc_oc=Adq00QCSNG7BUmCZyXXFtJBg0sJLgSFvHtoYfI7dhA9HbKXME75sWDk76BaLuWkLqyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xe0bt7QIHQDKU5cIw77k1kpn3kmK8qXR8h4OtJ1e_pw&oe=6A380346"}, {"file_name": "Hero Cover3000x900.png", "id"
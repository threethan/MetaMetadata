3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZu4fyiWq9wQ7kNvwE9QaXB&_nc_oc=AdrWzIs0bKmWp49qNe6UBJQC-HHa6aIf79PYGx6o71CjcyHgBiyf1A9Nrg2_MdqVhgk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-npQugQhGkFeA6ZiATw1cQ62s6rozSruzigzyIpm8Xg&oe=6A71EF8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E-2V59UU6oQ7kNvwE5KIWp&_nc_oc=Adqak8up_EbICPd7dJP2N8An4Gv0-EvLYNeinoF1996MviXI6O7vl0GAokcw8v4OYGs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRdoV0H72PKRpa4VGUIUQbsOi1z7RFDrMnz4RjTlwH9w&oe=6A71FF99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=id0GMHsBrb4Q7kNvwG8uC6F&_nc_oc=Adp0rJvOQlzIujtNykwz_NwrWqLYsQaQhnGrxKY-edhwLttUcgc7lNWJpnd5N-GMMyo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENgR_ZOdtiCzVH63wtPgEonuh_mF2BpazAuAyGhTPg_Q&oe=6A71DF0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
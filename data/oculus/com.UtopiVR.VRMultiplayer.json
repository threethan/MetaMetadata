."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS9OLpXRdigQ7kNvwGz4dz9&_nc_oc=Ado_Bdqi3OZgROb6obMIXnz-t-mYnpERAMRF44jkzMQcRlpcx46_bZNgmBSeXNLLtX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47K4SGyZVkpi6gANTvAQuGBxFGRnDeDJ81uy-3E4oXlw&oe=6A1D98AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avSfVpZXl4YQ7kNvwFaPC_2&_nc_oc=Ado4zWMSNaPxf86u_pdeRJMQ6Mlcm0rjZJD1yOHVLSCFPdR2iwDosYZKeGhXkV3K7aA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M-XW64dsuaatr7VR1Iln1o5uprMc20VN7zn7doZqpsg&oe=6A1D7EED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R8zS4yx5QkQ7kNvwGWxFK8&_nc_oc=AdpSpRcIuKTDwBwTCY9n6jv2OOUU6RvL4cFqcPhNVGnngi65ssZwysVHuxITbSojcw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y8dviMYynPnU1uc5TPnGd4fE_rFb5XF6vvsHk9n6r1Q&oe=6A1DAF39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-mtdkM4NkYQ7kNvwEgLWkU&_nc_oc=AdoYquEW-4ZFT2oj04bdZ-qj_wlsf4HmAKXu8OofQiDn9DMQJU9ohRQyowfgj6gGbU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FjmJdULm-AT1Dy7tufbVQ1_Qg7mIyFAhtGP8yZRJ3mw&oe=6A1DA546"}, {"file_name": "Hero Cover3000x900.png", "id"
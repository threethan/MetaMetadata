."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoMqInmjKgIQ7kNvwGayU9D&_nc_oc=AdonikI27b4hWO-ylpSPYdVj4TpcJr7IWJNcZnEXhRCawmxGxvRo1LeStePLJhqMHKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LPycbio5uLP9Ykjp8loIW1kv19Q2Wr4yhoKJkQ7zweA&oe=6A43D42F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5CShvW_QSYQ7kNvwHlJPlF&_nc_oc=AdrMyDMdvrQKbPhinP85jBk2zdl6pJs6O60tbqlQwBvn4qI6sdGh5IujZIxcsdQAY80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80x_NNRWhabwJUvs-teboxwPCkPWUorpKSYNONUlPp-Q&oe=6A43BA6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7YtncK8NBMQ7kNvwHoAdkR&_nc_oc=AdpTtEjxbO7g6js0uBViHf6TY8yWVvi3IP6gh8YWbjjcG2BNTRJrlXGLmb0snAoTXRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TJQcDm4fcyzBDy5nXohIaHFFnDyrTMWn0cPDeypguBg&oe=6A43EAB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWkDMqqOXZcQ7kNvwH1PYA7&_nc_oc=Ado0D6C7Z9Fz38QbA1knF53e3i3bT0afsXJc_DXTR54te_aMPIkJvQbZ8O_K9kYjYtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91dWkNGSLIRWLBu21CVC7GThK_tXfQOnUigqOnB_enMw&oe=6A43E0C6"}, {"file_name": "Hero Cover3000x900.png", "id"
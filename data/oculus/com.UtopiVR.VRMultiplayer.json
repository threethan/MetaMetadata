."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHdp8PzOxcAQ7kNvwEP9x7K&_nc_oc=AdrWsO3VcWlkxluWf0cFKK_EH0R2JBjFfKUJ4leaR9Pt_-bneTpeH1hOs6aX4rNrW8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_XHid6NcUeanfNncSh0AetuSEjzQfkoVHehMOM0U8Vw&oe=6AE0B6AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zgf2qaIi2xkQ7kNvwFzjvY-&_nc_oc=AdpI-zOl5ZunxGVwDLA6EFuvA8ijgNUXN6FU-J0Lvo4tZgnv623YWzqti-t9OBWX194&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgj-XrBNdqkc1eSKx-Q3LSk6suZQUN87_LfvKzG5krCA&oe=6AE09CED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B37-CUjNPFMQ7kNvwGkWVv2&_nc_oc=AdpnbvRijzoF1grCXpS1pfOo_yfxSWb7njmuoFdPRjepMPjfJlQ8l12-x6R3qwVQZ3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL2R-7usih3Q74rc_NkUN08E7GDJVKO3Wmkf6HaVkBLA&oe=6AE0CD39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivndMI51Aj8Q7kNvwGFWTaO&_nc_oc=AdoQg5s-K6r4Vjumg62FYRxy3H-l1iEowbk8LPhzPKaWdubI98EqkWJ5UKnQwzb_mm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrj-GCUzAk50iBB3u7lwx4QjeUBJzyjWLcbw3duKLjsA&oe=6AE0C346"}, {"file_name": "Hero Cover3000x900.png", "id"
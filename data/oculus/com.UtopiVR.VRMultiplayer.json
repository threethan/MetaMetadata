."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-Xk_C0_4OIQ7kNvwHAsnpm&_nc_oc=AdpfbT6ee0Q-d6aDIQTHMfN2HDr1-VH58PgLRZXM-Vy-G4tkNxul_Ni58M0HXQFCOi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1l3k5U8Zt0ExVXgBp8N28t-9zfb6MztSB-UsaYVDEFQ&oe=6ACE41AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syl8X-EG_4UQ7kNvwHLa-AC&_nc_oc=AdqRZSi-0meLR5DnNEeWz02WpPT6cSbYX7VMlJ4Cljmcg_hNyhDkuUdE8zEvngjAxj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRN_sPmcXxzhgiI8ejDn8cKibDqbW05rJYW-yFYmyfXQ&oe=6ACE602D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXH2AHrnZq4Q7kNvwH6S11f&_nc_oc=AdoqY_7woDsqW0tKOb88LH2SbH_sGS9G_73NF16CSqtT71nS6rXXc_iLQw3-AsNGzJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8kUXP2-fZ0m-uW9qMxX1ehi2ze-RddSYCn6GBoqFlHA&oe=6ACE5839"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsK5c4n3fNQQ7kNvwHNqFX7&_nc_oc=AdrYKSOXv1lL5MAUm29k2v22NC67XKJXosn0f5xOp0556nXWQ2cfWjPtJFIuY36O69U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgC67MuLC_DJ4h6IPp-QxtTjvHo2Jn3bOwnhkWVGSQOQ&oe=6ACE4E46"}, {"file_name": "Hero Cover3000x900.png", "id"
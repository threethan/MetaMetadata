3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYyCDj8KP44Q7kNvwFQhJ8g&_nc_oc=Adr8M5S5EE0UT3IT5UMf02EmZ1EiImJrlA9IRnPPGsED-3Lqu0wgoANGG_BGWlFzArA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKy8kxhLWarv_hQpFPxVhb9dNB3Oq8wotHURdCleVdvA&oe=6AD3B6CE"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeamwOD3xHgQ7kNvwERhJbr&_nc_oc=AdpqyqtDrGfE52zO7Yg75LDBpgFSHK8ubvQKSYHc6HHG66SmS7KmvcDILoEH-s4J_Io&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdGlIxEqCMC0hrsyVoiOxxRky9Ai6hbooIgTbyQsdo0Q&oe=6AD38E99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyP-scMdw7QQ7kNvwE34RUB&_nc_oc=AdqayXtsvkj9GR1VQ6pyKGbv4BRg2xialrDWBL7ip5_7s1y9g5t7_x4lrNSGWTt5BAg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR9H8QarQkNcPfgLrSs5PbJdVmHOlaEEVeW4qbX1caSw&oe=6AD3A64C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
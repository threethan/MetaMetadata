."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9T8ScWioH0Q7kNvwEHHBWH&_nc_oc=AdoXQGTDVDT_nNNinQadTg1JHRgh8FKVba4F_D0PjL0LyhjV3eU0zstRvrmmM3sRbNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_asrFAXfpOUa_R33QujJ5O3F5Trc1DGs6trLeARcdrQ&oe=6A0F182F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTcPD3SESD0Q7kNvwGgMl-O&_nc_oc=AdoYUql3WrUz4Dgh1khBCwZyewztyUuRl7oPSCDjICSx7_ryND6l7Ks3hN07rP30m4g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MVVWBgqUKu1HQOioApR2LDxbYi9QquT-M6SEUWFFWKQ&oe=6A0EFE6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gtJ0In9oQgQ7kNvwHk6zBB&_nc_oc=AdrrgXUMA-3UQVc3TjVsEcVqdyM3M07-BKi-Ye3vP9dL8ciRI16qMTtL4JKCaZNUy2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V4_byRysFZr2B7KIiMqBgIOdYhwdLxzJWXcURJy-F1Q&oe=6A0EF679"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSDquQBPSaMQ7kNvwFYmotv&_nc_oc=Adqk8yKSpZEFgksFMdQbsXIRV0kAwBNWRAjriq7KmE29IAeyvPBYOYBCLaq_t2UT3_M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FmG4YpTtj3zx1gGMBk4RDsKIBvjbrsmXnHW8kD3xTFw&oe=6A0F24C6"}, {"file_name": "Hero Cover3000x900.png", "id"
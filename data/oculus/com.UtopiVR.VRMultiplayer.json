3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GOqkJTHcGsQ7kNvwHn6wEx&_nc_oc=AdptKr_B-YBpdb2FYH2erR6auBi0wvV5ZRJqaPT0HII2ro9l99JhbyBkWX98BIj1-_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKCN4JT_KfHWANVI3E-vdWCzCYdTKELsbbPsSM3ebhZg&oe=6AEB398E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDElobrKsPgQ7kNvwGE_pLN&_nc_oc=AdroLQsMz7g_-PYuzvBH2z8i-tkRl08Q-D3Ky2BK6wfQRFwnkEENZTOA3-ppScXQDEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBjDM4C7DA-Ydvk5Rb65D1_OWNNLfts0_kKHR3OIWhdQ&oe=6AEB4999"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuq87UtwjIYQ7kNvwHHSzOE&_nc_oc=Adqe4JafmlHBRr0W7kouqh20cI5bSB58JrPD-6Q7btp3kU0FB-SMGzfld9xIWni3yPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBpVG7bH9gCsDiCYX8uOpU1ZY9DZ5TBuDo0oDRBOCxpA&oe=6AEB614C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
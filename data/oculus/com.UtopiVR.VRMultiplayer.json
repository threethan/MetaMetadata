3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB-zgNmIbPsQ7kNvwG7oXhV&_nc_oc=AdrEunyD39XnTJJJVkyXGQNvutv3lG0CCEKJl1r_iEi1NYaJiIgXyD12QyCguVKcoY0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhl4f54fqyi52hivwP2_LBhl9IGi54bg3bAjUlXHGGXA&oe=6A93FE4E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vd_q8b23lkQ7kNvwGTJ5W1&_nc_oc=Adqmxo1_aOqLQb-dWfSVtp4A2-Xj0qLsxVEb034tpRl-E3Sas4LlJbJjIYVAKHkZnYs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGY_kRgJibKJBUQ_g_X7KBSu1LW4zmG1FeqQ8CSZp5XQ&oe=6A940E59"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JfF1SyyRAUQ7kNvwGEK7yL&_nc_oc=AdoAvL4Rf66XGwTjpbd17aj2V0wri-T9_wrlaw4akbML3GtVHTgccQIy_AIfMfLERmg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMJpejoRXMbgoobBc5Fxw2wC-eSgXkfaaKUJRago9p3Q&oe=6A94260C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
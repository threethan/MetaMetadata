ut borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o84QfcRrbEoQ7kNvwGMpTC8&_nc_oc=AdqbVtAuMuvQ6mqtZ-KcmcZiRovHsli2dvjg2b_9J0_YLZr4Cjuo3WF9qzlg119Fxvg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6ow3fITzi9d7WOCTjrgsBGUb5tIlZwA3J1Cy0t4e2mg&oe=6A8586EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuNJlcQEPWoQ7kNvwFMxCCs&_nc_oc=AdoBV6sifuG1G8KGc8M__nPSXlh36jQbgwcM-a-5afZN53FxVlj7aQDzW18x-bVvSv8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0aKAo-sVEZa-khzY-1AZQzDC0s58jYgYPzA221yH4lw&oe=6A85A56D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqIxsNz9A8Q7kNvwFx5nnX&_nc_oc=AdpGunn92pq_hnean3mtWL3h3y6lv1ZVdeiGHeHSAlEbDn14QvWo9cZjFbEmD1hjYTs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2AVBRtU0IHJEKw9OqKEt_7_KRBz-vchzQMNXDqzitUQ&oe=6A859D79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxfKpjfeGjwQ7kNvwGF_05c&_nc_oc=AdpFmkhYCggWu6kCnaMXdbKvaeZ7dkf282bfmxoPTjM8i28ybLQch7OUYNTpujaNTTs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwb9IyctdO57eG62jSM6To5IOuZVi7ZVzZ8l8fDZTYhg&oe=6A859386"}, {"file_name": "Hero Cover3000x90
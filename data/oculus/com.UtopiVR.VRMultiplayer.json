3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56Mq44ilFX4Q7kNvwG9sz1o&_nc_oc=AdoTvVE99V1xJRuTytkV-xhQ3t7TAwb_YGQkMNmxzw4y8N0eSnq2ADTS4A8LFCS-ztI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ukXH-7WaQJFPyMWSPBuvYupIYcco1y3h2qlUtm7b6vg&oe=6A354A8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYNRVX8WqrMQ7kNvwFeFtRo&_nc_oc=AdrzlYKXcTu1szBb7Ebf_ouazUbWmH4xgWYCDs8K6IvJ_oVqFrRFOcsj6RfnEqYEgvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_omAlnrAhyU3_DLKWsIZ30tzdWvYU2aIV4wL7Ut4PSEQ&oe=6A355A99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQDx4yzI8MMQ7kNvwHrSFQ-&_nc_oc=Adr-dK1UufIfFs_KZp2KYAQy5kaxduFYEkRn7Y2mncq1wzirfOdToWn7yF-2mKqWI_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jh2HA3Cx-Ube4HZGd1RZkMynCoVvyA1dCI4FxGZOcCw&oe=6A35724C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtVwJh1z2PoQ7kNvwFrwlX2&_nc_oc=AdrfwLSTVZJgGb3U8fxV4HGcNVZk-TCYZi7udhjhsW85fOXPXMV51PLAdoO4YHYfXQ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDwoU4rCTMFfVaoM0cLAOxtdITx9cI9l9UaA0nNWmnRA&oe=6AE1FF0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSV9HI6RZIkQ7kNvwE2S8yq&_nc_oc=Adq7tbd9LNFvNfEBnrR7XY0yHOc3bV46F645Gouuxek0muQ7diRwyX9u_PLTcyJZC-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2UWe_NJpylEM6Cu9v_2XN6_ipKb4Z2ByqiGrY6Rx0vg&oe=6AE20F19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj0jusM4-4EQ7kNvwF9EAH6&_nc_oc=AdozsC7LcjjQ-24VteiOIa0VQ3mj7THFuMP0R0mYpZ2pGlzCcmNNQNjY0pf8uItkzOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYCCiJFbMzPzHYwmBFmqX55df4nW48b7dzxlPKU7NQ8Q&oe=6AE1EE8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
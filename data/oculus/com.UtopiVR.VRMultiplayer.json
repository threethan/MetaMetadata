."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFrYrmL0mj4Q7kNvwE7AENE&_nc_oc=AdpcinRkWXZ4ikQJwFjaQ1dsAzs-8oAsvs97Q4vG-spIsZRUbzfaKtQ5eD6_CEu1kKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3KdGeTEALWmiR-HzeEdbW0rq997CicalFB3fG8TJpIw&oe=6A95C96F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5CicnVFL-UQ7kNvwFYCfre&_nc_oc=Adr0ZPdoJMsiDyi8fCOd5hAhEZtmMEETEHaqoxZQuX7h54xwz3SjKRjrLMNgVxi-__g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG0_LQk2uC1cfTaCYN6jkKK_a9VwlWzYSEVSw38i9NiA&oe=6A95AFAD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tN0wE7_NuEQ7kNvwF41ALz&_nc_oc=AdrujjrSz_hKPmKWeMqY6WDRuCjFTU5s3nFbl5KGg76JDUGXOvbubma2BMUNzGuQCi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQzROHkLtQgG3wZXHvi0zH_3By7yYciqkrBVsEQrzCKg&oe=6A95DFF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iAu3bfCK_cQ7kNvwHIKIOa&_nc_oc=AdqAK_s9OxYQsHnfDvLd5uRqhjdRk2-facyZEDZ5ak9hr8AzwaA01EHxKGNMgMT3Klg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjDcEOj1AnSRE8H6nf9Lt7nOyhJgaKrpa0CIQ9P0r5Jg&oe=6A95D606"}, {"file_name": "Hero Cover3000x900.png", "id"
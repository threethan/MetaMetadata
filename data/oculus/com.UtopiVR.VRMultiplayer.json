3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqIxXcWB_fAQ7kNvwG3LMea&_nc_oc=Adr-0j-BF8y6nq9UofZowylY7A5Ab_oJNGilckY8r4OfocIaKJ_eWFtkHYHwzame3wU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrYh609C-qj8khdX-6P2PnXe8nWTHj3WsHoSSdfUlkbg&oe=6AF9BA0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXaaAv9JxtMQ7kNvwHiUs-3&_nc_oc=Adr-ZU4ge7qrd6f8hei4FIxeTkKexAX5CUqCDtUHYEA6FkqSp2iOYy3-Gaa-wew41zM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbudsCPuEUAUexhwZVAfRHuamOjTdps8OZeuEcYlhS1g&oe=6AF9CA19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3PAQ_-s3m4Q7kNvwFGHSpJ&_nc_oc=AdqqC_2BrZ23F6fqx59wzk-U3hI5_ZrZxPiMMt_8mSIBHa8ZluziNC43jYCC9LojZds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSptBuBVR709uSNNjgTu9bRCz5bdL1bfCV3aPFlpdsBpw&oe=6AF9E1CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
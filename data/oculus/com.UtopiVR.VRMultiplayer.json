."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS9OLpXRdigQ7kNvwHBXKXA&_nc_oc=Adq-UfZY2J5hypvjB6_ov3oLc6pP2rIgekBxXVtfZl8FEScb-63lvgWFzWR9y6x1lDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dAMlCAV0_rMpvJjU-Mvqpvy9uxw2ObNaa1A2EiQ5piQ&oe=6A203BAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fnfk8YTjToUQ7kNvwG0tfbd&_nc_oc=AdrLdQAfVoNKs0uPIgus3inMGrhX6Mo1uZwvwDKBZlyUwJifTbtgpUXWyt3BJweFfv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e0D_GJlnjQlyCtjQSrO4iEtrLI0zCNcgVT1XsUFK6ZA&oe=6A2021ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYUb2HP9FWUQ7kNvwGpQiuZ&_nc_oc=AdoCKMWHdghXZh_y2wwSiuK9RLmNa4cQ0RChUh1TonaAs1OcTALhr2JPBYejOx-38MU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pmjYT2ia_5RsoRcJCSY9Wus2e8t3wsgzILfz0FB44Gw&oe=6A2019F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-mtdkM4NkYQ7kNvwENWj-f&_nc_oc=AdpOppSx85jfPQGKHetFL99n7FpUDN8VcBvIsp71Sbu5fIvslKt_X5wITJP8yzKboLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xALGglegHyiSgcZr_I5VKerg35MKqp7_CrBqDy7Wmuw&oe=6A204846"}, {"file_name": "Hero Cover3000x900.png", "id"
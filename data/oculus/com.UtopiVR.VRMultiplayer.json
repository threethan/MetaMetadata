3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_Edkp5IvogQ7kNvwEHO5g4&_nc_oc=Adpu0NQ-Gf3DAcjknrAyGZw1covGjX93u82MeMz3XeqH_Pgxk325-v5C0IJaOiqO-uM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RlqdUgxrD8fp39eZjSxKvCXPFG6tB4I5PzyY7Sovgfw&oe=6A20328E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS6VdWkX-3kQ7kNvwGQbHn3&_nc_oc=Adqf7SuMR7rWnUBe038PVc_BB_c4Db6u06bllTX_yce5b3hMgDids0ZuOcXymw24q-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BwOTW2JO4H_I0_q2Pl1Dz8X1xXWv3SLfnJ5_bzJBJRg&oe=6A204299"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32fAZVqu25UQ7kNvwHinqGQ&_nc_oc=Adoim18tJusWNAHbV5yyoDJAlx09867d16mlNqdJO5-JIv_3YNbP9gNds2TeD5MSl8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rClwOjaDzvJhs2EOoCWhK0gWZYHRUszl82D4kdXhstQ&oe=6A20220C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
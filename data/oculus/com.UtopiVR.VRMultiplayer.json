."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjP4Ok5xXt4Q7kNvwH_o3cW&_nc_oc=Ado5B32JL0X6aXyxKeahGUrn-mc29xqhfziKLQlVeeMZOgrGUrnvRemv7_Ktj7k5m7E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ZZzPneFWuZCCcqS1JPSvlPr8kS-G4cmZ9C087I_rCw&oe=6AEC942F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qybnNRyMXWsQ7kNvwGLP2Tz&_nc_oc=AdpEfKRts8bzrUIoIJvMCLVBkp--lGHhccKXQ_Vz7zA5l6mXrNX_elvh-PfeOJbUyJI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6BscKWnv5ZHnCVUvx4iFF0IvXJmUP7sMeiSVKQbfksA&oe=6AECB2AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHLnIP3gBpgQ7kNvwF_7y-P&_nc_oc=AdpCplP4szd6hPgbT32vndjLlvQ7IeN9NeSpaqsdEnGFxrLiQns4gZ-rWAMx4JPoqUs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4dTel896L2ZRHgJB1HzD4TTkau90s1MdIRN4c0uASiA&oe=6AECAAB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujtjmI93WQkQ7kNvwGHM-Uh&_nc_oc=AdqeojW-KeIK8mn_itOwS5rQPxvxYuaEdiUm0WdIZkwAMcuqHZEttetW0zoHBIVsxPA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzdBVncrIWiFvOJs_1q6NWBP5QqltL6OjqtqtgI_jXOQ&oe=6AECA0C6"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycC_h8XoKtIQ7kNvwG_NbVX&_nc_oc=Adqe8WTV50HeUlB-J-93Lq3G9Hc9ELTEzKH_K3xTzZ91wmpY-x_BvwhZyVWSnKiaG14&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcfzXgUMv-DWQjIIOhbRAS8hlskzSDNErWWGzKpruWnw&oe=6A4E570E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cyD06YdmMoQ7kNvwGhc-pe&_nc_oc=AdpTnzSp_HfnsOno6K2eEGdCtaUaLgn0Io7XIE5p9YBssCJH5eDii6dtM1xmQ5ljsnA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABZyiwmLM8UaUtaClQU8LG_natmGb2H1T1qaehbxJ1Dw&oe=6A4E6719"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wave8Jq9-HYQ7kNvwHycV_D&_nc_oc=AdoENY6gMmOndZMBJaYrewH2zLES42mghMoo2MH2AXEDdV778sQAz8Aq0Td4f5_dlVY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMv7ov-t9U5siFhyPgOkQ3VRDquJpWYBopnt8Ar3hKjA&oe=6A4E468C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
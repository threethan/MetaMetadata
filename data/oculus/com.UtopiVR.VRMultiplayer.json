."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5gN1AVkpBEQ7kNvwF3p_2q&_nc_oc=Adrh3dJ5gYkiESo7Zji3SYFiaqXFSFI7_8IbbOYLMK5pEnHDOJlZPEwQQrYOTE3Cm34&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfTyR3K1lSqTwaYXX5H3bPW7-toe7IiWk24dWXN5uG0A&oe=6A56492F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abG0Cy2BNJgQ7kNvwHZE8Z3&_nc_oc=AdqUdaHqgD8dI76ZnYwBcMyZQ8aHDyGuqOL9RNtoHbqEmLzg_us4PYsLC5syYJJyyYI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlBftynYXsT7SMWd69HdEocKtOvEwfaAb_wG4_m9zW0g&oe=6A562F6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tupRY4TOxfwQ7kNvwEkN5HC&_nc_oc=AdoYYDF8byrZdM61j9vCYYoIiS4hlStaqt-pyu4UfULzodpSakj-WDkTAVeTMos8gCI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD55W2vmQo8KDDZ8tBvcT6mN9Q6U2QWu-Zq7OZuG6CXsg&oe=6A562779"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGmHR2bJSqIQ7kNvwGnIytO&_nc_oc=AdqV2upofd6s2TE4fxScgrCtS8-5U_vdtV4H3uAi4oI9xyJYfv_CpnVwVOR2cOhNmjc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ-sjdDkyJ_NwY4ckwDPLXpLRcslTUY5YxvEMscMSqbQ&oe=6A5655C6"}, {"file_name": "Hero Cover3000x900.png", "id"
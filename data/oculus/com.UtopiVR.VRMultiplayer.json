."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFrYrmL0mj4Q7kNvwHNPOjD&_nc_oc=AdoDg-s1zMO9nXwtOV8A3ujZQxJXwL0flFSJh5waJxypxXgXu-MugsLgg00woCg9McY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz2OV4707roOFgLKvcAsIndf0WosHacblArC5Sq1GbuQ&oe=6A971AEF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5CicnVFL-UQ7kNvwHTlY_B&_nc_oc=AdpddsYQii5Kg2n_-WcEvReNGoIsNc2ZjIYsMv7pF16ofQ-RcgtuvtYKtHsRKXMGWow&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9Qtfu8sW_oamT52giTaN0MF9ukksWtcZACk315XV1Kg&oe=6A97396D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tN0wE7_NuEQ7kNvwGKEu08&_nc_oc=Adq8c4zNzeP3Y2PuTv-zrpC80cbSxkxE2_lKxRXeBSz-iytQex2JCMuEfiqUsnmHFuU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS0Q4ScusQHXE65cXmarwtw6mGgHLncCGWjocmul2Q8g&oe=6A973179"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zO34oeKphIQ7kNvwHGdH3S&_nc_oc=Adq6JPeyRtNyab3mpDDXjhy5jqBrooWliWz6JAeDTOknJVu5lAL4yatmLvjnrsrqhPE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV7iXlZCueMEzWrMes4gR6byEc3WDKbT1xKGguGuFXWA&oe=6A972786"}, {"file_name": "Hero Cover3000x900.png", "id"
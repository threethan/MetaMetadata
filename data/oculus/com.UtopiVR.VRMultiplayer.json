3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB-zgNmIbPsQ7kNvwFH9p4j&_nc_oc=AdosaWR0yyxWGf0No1Xq0rxcD7Vv7BfZ8gbQjvEA5mtt1ljoNl0vzOTJCpNRvd2G1Fo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsWLcjDhBPk1q6srs9mM6t42YxWjlLXd2ncdNQ5zMFKA&oe=6A92ACCE"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vd_q8b23lkQ7kNvwERWYcV&_nc_oc=AdpmkWaYKeIbxXo-z43dfe5KztKn5escDk8uY4iAzbuS4IF3tx5ezDTE-iati7qfTNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM7-raHv4t7legerRoRwdF_1nAxXyeTCSKehM9uOQkuQ&oe=6A92BCD9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkrjKxL6rWcQ7kNvwExjieu&_nc_oc=Adr-fi8EGiz_G18Qk70z0OLO7WUBqCtWJktGNF-hGOqUys5PuoXiWwecIAYg4c9C2FU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFiA3xrrbiJ86m5qcxXbVa7U_QGxbShzC-6Ys14yCoxA&oe=6A92D48C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFrYrmL0mj4Q7kNvwGf0gyV&_nc_oc=AdpdPOqG8zPmxchVUdB4Q_SHM4VRliVXUwoO0Brd963-H2Mi7wlzxZsjSZ7BuUjnFT0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_VtaIyWFXqBsqDhGAUS-mppC3AK8292TfGCuck-cHeQ&oe=6A94076F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYh_EporL7AQ7kNvwF1dRD4&_nc_oc=Adr_2r-RHtZVeYxOPthGrN4KGnNZXwuZ8dfVsrIbCeIYDKK7E7KIw3_Pnyx7aOJSOfk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCI29Fz2rjSn9cjxRgTTcyMehPxC7ibB15c8LRK21-gg&oe=6A9425ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_PnuTxsg6wQ7kNvwGv9WPw&_nc_oc=AdrXU42z0kpcQFkSwlJZgEDZDnd5pJsQNLDDwfpkH1hnBrq2x7bBWp-0VuY07d8joQQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu7j7yL0k1S_ylW7vuSvsMk-xeUyXdrIzspKk2HsgEXw&oe=6A941DF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iAu3bfCK_cQ7kNvwFsOqhs&_nc_oc=AdpgIKCuh4ep9Dba6gpoynNaC85MGfUjNldDPqdRXudldm9DS_WfSGtUjoIj66AD4TM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqfRVCqRxclgu0MiVU5FcJPsNW_E7KnrOfE0mZcSCRXg&oe=6A941406"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxOemum1AI8Q7kNvwG_16gb&_nc_oc=Adr84rBbwOGZ1MbdVsUTWrdmF7gHezZ_9qhrSTIADy2EoWLG6vE96M6a2hZQhCR6zTk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHANTrtOZ4uO8J6n7htJH7AZ_42X3bM62mzKxvrQOOkA&oe=6A91646F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYh_EporL7AQ7kNvwHtIJid&_nc_oc=AdrSg-ZZEZ7DEAV3YeU8Nfp2u2ZZHrEG0196B45DuTU9tyFdFmXJm064NvSRXSov08E&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHr9o1I2T65ZAe-B3s0YKc-GCwk_X2SGJUvW6FApiv2tw&oe=6A9182ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_PnuTxsg6wQ7kNvwEneJlk&_nc_oc=AdpeeD9Z5V1k3LqXIN0zthkDlHXMYvHxa5HcOj6swWxWLJvh-C5iYfHaq7fnshCFYg8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCF7P3DvG4bXu7Uom31AzOjoyu1axTEp6OFxmHCWtqkQ&oe=6A917AF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umN5My50PQ8Q7kNvwGdO8Dg&_nc_oc=AdoobzqikQ9wae3K3ur5ngqcaWnNcGKZIkfi1zVSzx5L_Rb7alP1xy1hyYK0FZobwi0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6z8Jd-PwXYDcywCmdUrHQnNmOt1kwv6pwJCN87Q-ZAQ&oe=6A917106"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzukxokXQ9gQ7kNvwEzT9ym&_nc_oc=AdpNhDV14xjrnkGfNr-nxDWxzErio4HSGOsm95lb8Fdq3vu5zSP-ibxJAbU6vnI3dpg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7AP1jx4PpOP_QMkVcKF6nfVlDa9HP0HaI_vu7lx-eHQ&oe=6AF9C32F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ya1ETWR8tYQ7kNvwEziHd7&_nc_oc=AdqWX8yTwSgET-ZLV__UH95xprAtbqA5zKaNeisw6QYEoiQX-28ySki2pmqETXEFtxA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKJ64fWKA22yubKuvsaqifQDzRx2vfuiIyVAYf6r_zkA&oe=6AF9E1AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l-wVypIpFoQ7kNvwHolj5p&_nc_oc=AdoMPXhIwsGqJ6pzyPuqQqBChe5E_txgItEgAwQct2roqvbO_UeBGlmyxCN7b7eS3gQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQe_rUIibrssd0gvWHjjpuvp8L7OlJSZqQ1LlEfhM3BA&oe=6AF9D9B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsRvoqIgxJQQ7kNvwHTZQ5i&_nc_oc=AdpIdR6-zInyTLaQwUJZCkoGwm2siFJwDISafofNowrCTp6p-wfw5mo0FmPPzvYPUT4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDiq1Jo7h668FmSG3x-I2doeFW1JTBrN6WyX2zFAOOmg&oe=6AF9CFC6"}, {"file_name": "Hero Cover3000x900.png", "id"
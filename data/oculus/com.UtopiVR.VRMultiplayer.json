."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr46x9rIPeEQ7kNvwH_bMfX&_nc_oc=Adqb3aztJDhlVJy8wb6yE3PkfoIa0nKgH0EdXkGxBNb7mkuOM0RlL_cA6r_ErzvFPWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9UYhKqGturb0cqEds3H1OOwTHTchus45K1JGeoPcKvg&oe=6A2581AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKcN7lAfr3wQ7kNvwEzLc1E&_nc_oc=AdowS-qlW4wx44Tcl_zIkJ4FZblqle3Xd4--tGToA0Ds1oXP8wKKzYw3g7EtJhib0Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KQdQeaUBz3TyQmrKMnT7Rg3TcFMZHb87K54rHbZwXEw&oe=6A25A02D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktzI30wN1EAQ7kNvwGBoyTk&_nc_oc=AdqI4JlGm3K4h2IEtejDZ9ACLIlCAixmy0ZpBI7Pf9HxZRO4Rjie0BWvQUSVTBDIsN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fOiYYZA1WaZH6Ds8I6kgWx6E4ysKjpOXr5OBSsyEDqg&oe=6A259839"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_oeTX8MM9gQ7kNvwEyKPxJ&_nc_oc=AdrTZITTOSSpfgyGtFy4354k4E4vqXERoJ5Q9hHS5kwjK2HsukpwkBZxgIU7h3UrWcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BW_rDdKEn1mziIFMEe3RwrsuD9pqghkmfCkSjS1oJIw&oe=6A258E46"}, {"file_name": "Hero Cover3000x900.png", "id"
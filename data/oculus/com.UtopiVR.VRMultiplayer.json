."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o84QfcRrbEoQ7kNvwHXYEaL&_nc_oc=AdrHR_NEz34Hr6UNFPR-dc8O_wK04QrPQmLQocIslWmDQN-u88cBtGgyEPF54XA29uI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_LQqB9kyl7bMOPYqqSpPB1aJKLez5wZj2ydm6lPwrXA&oe=6A86D86F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuNJlcQEPWoQ7kNvwHHOqqL&_nc_oc=AdrI5rNDYd_IA96gU4_UUHC8YnDnySgAzc8A0Sf7DbJbGPSd41o3aoDcaFOly6gYkJs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDvBS_uCw1eNu1cYL-0vS4_e6ipa6pZ8wk6trYyfhYwQ&oe=6A86F6ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqIxsNz9A8Q7kNvwGxTmLD&_nc_oc=Ado3QKaLFj0h6AJksPxmz9nR98WIXrFyuKVTJ2KYwuVbMaEs8-iEORRrdxm2E1CU-XI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7IIi8NE00t0wEHfgPlaatqpYTqrtGfjQSJSPFsPj2qA&oe=6A86EEF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxfKpjfeGjwQ7kNvwEql1Ae&_nc_oc=AdrwijZ7njjUTnvhmAOx5gqTiZSW71pvwfHDkV-k0zWJVs-9FvxtA6t4CFXMeU4M7M4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlYlzgV0VKj3pQdsix7z5OuqpJXIr7ZAXLS-3Ee2YifQ&oe=6A86E506"}, {"file_name": "Hero Cover3000x900.png", "id"
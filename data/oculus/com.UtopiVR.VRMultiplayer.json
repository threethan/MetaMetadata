."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YoBI_IrsLgQ7kNvwFmInuk&_nc_oc=AdoyVAq8liyxXh9Aqx7PAtTQt-gVRsmu4ggniE6spAcZoGvM4dccpUvTqxLKFdAXUwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FAr-hqARTVAN8TsuM4CoBaWUL2WUKwvVEDiqpPbRsqA&oe=6A47C8AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=728GZqgiNVEQ7kNvwEdfwQ_&_nc_oc=AdqWVWJsOvaOAIfT91K1GX2b7af0YZlG41l5J5i_q6T16dzv0l8FlJlWLtBPfA3BNAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vzZ7UlxMj2NClA3f9I7HTuP2i1ysl-D4oBN4ijAUzTg&oe=6A47AEED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld4Zq0w7K64Q7kNvwF0aY4I&_nc_oc=AdqCKBp0KvRYi3bPy31pGO_79va7GEh_3AcEVgP9IGozOnHHKicB3Vv-OvPH6zFC62g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-19hkm5L6LFBzCyMKbzqcKWhwWdzEQjf9ftdXLBxlsMw&oe=6A47DF39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRsJO6RSauEQ7kNvwHCmHDg&_nc_oc=AdoEX16kMfWnyu-Ut5An33tyeCzk0v9LmawAleT9t0mTog85eJ19CMBp2AkW9zqQU-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9grSJJpNsteJojPz1CeAuS0s0Br6jz2rXYxnV6N8YEkQ&oe=6A47D546"}, {"file_name": "Hero Cover3000x900.png", "id"
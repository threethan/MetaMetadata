3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqClOgN7LfoQ7kNvwGy6r2Q&_nc_oc=Adr9KIbMHe-QmKryY_qHmcSImc7Hw8Xa6IfsZ27fEmLwTVp0Axuhj3-Xq0ivnztyEZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpXxwJKm552sRKboYkB7kXx16hbLot_8BMv_2Hv8I3KQ&oe=6A9EC28E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDPH1qD0tQ0Q7kNvwF8H932&_nc_oc=AdoeRZjyVEmszyENuNK1_2opWjJ-Yp-zu8oflYCLEXwaPaTCDd2KPml1hAf9i8nNMl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc1YEtdiMddpBbFXos4Btgf7V41_Gl70YzxvQCnQbmPQ&oe=6A9ED299"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpqd7Sow5wkQ7kNvwG0Oo1T&_nc_oc=Adopma-7kMRN_vBSyl5GTodgKlDgIigBP9BgdqD3F9FpTQ37ZiQLzNwRtg-xcGPIzIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQWQ-qQRr5m8YN8Rb8Kx2hug9WjjEVCD0pO9rmD63LZg&oe=6A9EB20C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
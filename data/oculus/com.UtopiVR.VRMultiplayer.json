3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmgMVI0LaPgQ7kNvwHR1D7n&_nc_oc=AdphjDMwL-ADSHul4n9zpSu0CQC6HsH6pGy8MyaSdh6Vyr-en4od-81atwbXasChejQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLwE13UvTwnEtgXh0t3RSpsRYJ4Ki60fnviZKpR72h0g&oe=6AA1658E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmC0044sot4Q7kNvwGHXpeK&_nc_oc=AdrRjZISCtELySZbl9uUIhteHuxY0mSawGKZQ4Shb1_B7jUHkFHGcfcgQYlCz-k-NX0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMpxxW-ixmqm-30tzVn0YBwHnOL7jRG8CrTGRH01j5DA&oe=6AA17599"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rotYkrbChDAQ7kNvwFij7kf&_nc_oc=AdqvpjDE4uJEbxJnH0HfjoeNfmYxFCCdJ9oNav3f_epmisdaEueHlBEUKDO80WFN_hI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYO2l4woo0yuImeD239VykQy5-2g_Js1MJOBetX1Cq8A&oe=6AA1550C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcpLfeW7rrAQ7kNvwHrSdDG&_nc_oc=Adq48UM31Jx3jtFR6wFIPEOpJiCutDE8G-nkt2aGny7ExFOnCD4R1bKt6Unt4VnVggQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lAM2PdV-SfWjd3rCSZGY7YrhHMX7SY0Onx11raounjg&oe=69EF6B0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I-ihgDFDusQ7kNvwE-JkKI&_nc_oc=AdrzIsJzqF2sLsCGo0n0gyukFGNcog3r1JrejVvOmXBBE1cQDnzHNzJHc2T21hUtihU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rTimW7X3z5q3JxvScq80BEdhhyvPrwU1ntSyYwC9xug&oe=69EF7B19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pYFnLio1KIQ7kNvwFCoTaT&_nc_oc=Adpxnuoq20ZV51ZdpUBL_Df1-KIieIHKt4zEhrMMHtILzjUxsAtiG38Gee7ZxkvYNg0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0brVppPL6gynNTtsp9Q1Omzf8Iskp_jtMw-DTieDBq3w&oe=69EF5A8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
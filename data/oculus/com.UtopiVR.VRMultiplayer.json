."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EizmNlgVjlcQ7kNvwEUsY3-&_nc_oc=Adp_8F8MR_-eQYqCz1gbinGzlC2xlUFQGRuPDY-jJ1RmZGFPsTYJzaKoJEzjgwZRyuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeaVge7PKDwsYZuoSGlFxSln-4G6YashDO0g4QxH_W5g&oe=6A51032F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rL5VnzAVneYQ7kNvwH09sNr&_nc_oc=Adrqrn5NU4MUQjZxEeaIEUriInmK5Djf0GGMZ1Yg7m2jQREGOP1eonvJ3pNf6UXAsvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALsmyESYdqxySxKu3mQuHUuz-f2lf4dOAr4jQ0-oepEQ&oe=6A50E96D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UldEf8Eh1vMQ7kNvwFt7V0N&_nc_oc=Ado8E-X8gfSRoshUlZz6-7Eqt3-N3gY-pNHpSR_8dispSVuZt5A3xm34hohpk7A9s9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB66execqt0pg2jc_phVWiu3Tq-5adBC65aBb4cGYZmWQ&oe=6A5119B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWOBQPZD0ZsQ7kNvwHKlXfP&_nc_oc=Adrk0Gnubj86w28cXsYdF9OY7ydzq-7do2L7UE4sx9tr-Fx0vFLIJt1cR44nPbSkqLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk3JrMo1O2eAm8Nr9o_13q-VQU7RmtfU3SIkX29WAoLQ&oe=6A510FC6"}, {"file_name": "Hero Cover3000x900.png", "id"
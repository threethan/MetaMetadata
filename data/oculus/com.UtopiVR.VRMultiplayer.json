."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJZqfxQZBd4Q7kNvwEF_ypj&_nc_oc=AdqkNjHjaLiQDsZZxaCHfcGGOp3Hyvi9lyJqzxkOrytfOs1XBIaaykjJIdnZL9wpB2g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBfkOAJEHg7SJQ0a7BXKs52OGzR3F6iSWfcfiBzJft9Q&oe=6ACF932F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Syl8X-EG_4UQ7kNvwEoblyO&_nc_oc=AdrWn4QEOuJm6hZJUKH5QrabeZTXQs39lGabSJG_HIawRJIXzZ23ObIWNi33ORxqv50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmS604z0X5y5CmKCn4Vr-QoSykK5M3oK80YQbCpHouAg&oe=6ACFB1AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXH2AHrnZq4Q7kNvwGlYeGD&_nc_oc=Ado1i1oC6qN31yttATrWfXjnaHFun6hAkv2fXkHpvaWWNzgZai2K_BXRC4E8bkz4rgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXB3k0DOuVkwnPhelZHukLmVlgQ1M8MrEbI1CFmPYmpA&oe=6ACFA9B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsK5c4n3fNQQ7kNvwE5nAZA&_nc_oc=Adq2FS1KIDaGTE2hyLrgP_-Y34JaMH_6PVq3LM3ltdgamj4W_QNYofJGcWUZnhOkoOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLOftlxZRgVGmZF6ouwmbr1w67LWMX9EqVMIjx8i-JOg&oe=6ACF9FC6"}, {"file_name": "Hero Cover3000x900.png", "id"
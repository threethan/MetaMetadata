3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg_I2WTUgesQ7kNvwGgXl7J&_nc_oc=Adr2Dec8qwcE2gSUDaBjinHRXG5gZg5GugCC2RoMFGMVVD_M94wXkVV2hmrmSE6kIh8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FXMeDzy4i_Ck6_OWemiEc_EYfSaEuxeqcK_cLlUufNQ&oe=6A09C90E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vPZ2oFXzCQQ7kNvwG-wJ9e&_nc_oc=Adq1sV51PdPPN2QJCAD-2IgkVUEEdjVu4FKCfOpkWkXvWyupODkH7R3L3oNp57QCz-k&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gSItn4aqH1AoNkSgdyMxdG5bKAX3UvWlK-V-CX7v4Gw&oe=6A09D919"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a80BpwE6djoQ7kNvwHo44Rm&_nc_oc=AdqsY7nLh0_398snK_lH6iXmeCciDozPhvMzpvi1Fa1--QOYWIywZm5aj6EZPFHrrCM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FE-DWB_mqN17QasypV_Wgs0nQ8OggcXQRZZIPoqPW9Q&oe=6A09B88C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
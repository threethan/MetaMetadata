3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYuGjzRdnBMQ7kNvwH7M3Hp&_nc_oc=AdoLlqErrRPVa1nuUYMP-IGYeklCnUyvaazFQ5Wsd7Hpo588uZPlKYT27MtjEhFRk0Q&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fjd2Mev06NocLNGRwgdm1NUVD3jNFq9zUFNfoFvd7ag&oe=6A10608E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfBL9Mh_BpAQ7kNvwEfZJEV&_nc_oc=AdqNhtakwQlwWNHoHjwlyQN-dQZlE70NTIKFe-dqW2OPlZAtD0r_wTW6fkuDeLp4wlQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46CCFat0icNY0sX-ApNBXaXD8D507EoV4Mn3kqe5NkHg&oe=6A107099"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9VzO8JbPUIQ7kNvwEAxh30&_nc_oc=AdrdiRy4w4wz7-N6mp7DW63Y3QuT48JkMjjzB39SpKe8n0VCfW-jHDrr6rkKinzZy_U&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s__ZF3mqfMldCSAM10RVRhAjzRK9qV7k2HVTAJjCQeQ&oe=6A10500C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
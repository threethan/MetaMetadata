."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5gN1AVkpBEQ7kNvwG0orSM&_nc_oc=AdoFfQUOu-tFaVeKuEXNvsvD8WdNSrduIyYaFdc31EhlxaMnvhMET_86KFx2uP5q5U8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGkNdJSt3pKcOuZalUUFOnMzIQNsvptg4gHQyxjLDWOQ&oe=6A579AAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abG0Cy2BNJgQ7kNvwHjy6Ga&_nc_oc=Adq_X4Zzq7ajaLgAK5XmN4hjpNuz9IUI_sn9oCIpiTu1w7Fn8bO6V7aC83PQz0BmMPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEmXEV1pGnWPyAlSYMv4HSiW8OWj9zFi9VfqNXeDb_WQ&oe=6A5780ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tupRY4TOxfwQ7kNvwFdZGtJ&_nc_oc=AdoGCSDUK6GRxwLfA3FXFC56-2cQQaZAhe4PiNkkXRRFRGi12RG6VCi1K2oeINmd4js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYUQ8bGKY70L-6Savfrg-P3HhakpSYb8qyQUbjg46tAA&oe=6A5778F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGmHR2bJSqIQ7kNvwEclsgl&_nc_oc=Adod5HR-lPdpY4YX6Ngly0gqwq2F8gMDGBEeNzrm_JvdYmmUgLrv2rcA061onk7jnGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuBo0tuu2pqWC9FJenzVeriBeUbmSU868DU2SIata7kg&oe=6A576F06"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFv7fLHrzgAQ7kNvwGrjqNw&_nc_oc=Adpn6_E-Pyxk1RwJUIuSDK46OY2vhuKUpBYa3emlIeF1icgOWYs17q1EHMw0cP__ukk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCS54AnoDvL-ss44Wpr-9C0BttEWyyNO4QJ8C8MfuxVA&oe=6A676CAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1dNvLGUdZoQ7kNvwELabR8&_nc_oc=AdodmWsd4eaBGMR2wRh29EM_hqS6niBUPWfjjhPFTIi5nW1yCdO3C2_or4-om-7tFNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcB3ZT20UFJhIVhSVtr3tpwsByiZSDOvPocXRPl13w_A&oe=6A6752ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl_nMAoFb7sQ7kNvwFtR6T0&_nc_oc=Adqids6DD6c3n8ftR56W37e6vtTwlJkRPv-pWU6iobFFBJ7ur2xBVquD0TE747h0Dr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcNnZnwwexS8aAhKpeIuvDEZk2z1tsuQ3xjh5O6SoZUg&oe=6A674AF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSbdZq_0vVYQ7kNvwH1Kbp8&_nc_oc=AdqCZKlglnoQWHcw8Uj9m1CAJe3VNvacqSYHNmTCsQfVyYq8glJ948pkzYsPQA5atjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMzAlbzWErjrFpYXJ8qp6O5rq0KGtEpemICT0uoDtx2Q&oe=6A677946"}, {"file_name": "Hero Cover3000x900.png", "id"
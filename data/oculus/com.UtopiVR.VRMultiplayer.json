."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfDCfbzjPFgQ7kNvwGyIXRy&_nc_oc=AdpSOtID3-k3Yd045ik65jprMIXOfT5L85bQk_Hpo6u3i8iJg8Zpv5fSrpmhsRPykRQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8q5jxNzQvneeK5xv2z2yTI8XnPTLW6TxI2kIcCV2H5g&oe=6A8ACCEF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fg3BbGBrjUQ7kNvwELmoxD&_nc_oc=Ado3tO5i45pJ5YqdRoJyEnq9dPmQXoB254qqWs6B0kfGNzcYuhMaXdnivnmZhKmnpu4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExOcCEwgzPQ_Spts2U7F51L0SAw_cxOmcKv7cOBeVcoQ&oe=6A8AEB6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHscq8GpeUwQ7kNvwEzItXz&_nc_oc=AdrkwOaIyWVBFzN7PC3bjuckUTcGbCQa_rT0i2l00unckHxU20m4Uka1JI45u5RS0F0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsmjCIHCsWLioQWp9BxpW-ZTs6li72ERGce8YEgG3Ldg&oe=6A8AE379"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U73eLGQ-IUQ7kNvwENyeL0&_nc_oc=AdotSemYdic1cMWdN_B9EgUd8sGeXuC6OSx3Vk88YLQcsuTIKQ37TvAXoS0olAO5QWI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwZ55P8hJBjN4qwEIEoRWur8-IJ_K4g9cTt0unVDVeSw&oe=6A8AD986"}, {"file_name": "Hero Cover3000x900.png", "id"
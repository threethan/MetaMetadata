3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqClOgN7LfoQ7kNvwH0Pr3S&_nc_oc=AdrAlR0C3lTzWL1TlgVACGnTwrj220bBKYAmUSCHvRpPgEpWNbG-c2ZhW4NUA7SXixc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMM4g_bSJgb7C6hxkv7WGG-zyMpQKAhMIcKC1-i6bmvw&oe=6AA0140E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDPH1qD0tQ0Q7kNvwGR-fCL&_nc_oc=AdqP2OM-O5gWztnMJV4stQMLoLaHnlvYSHNrEptppMZGTBS4nzqt_RVFXOCkDNsrwdw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKHr2HZWNjqoefGGilsz5W0N1HzDqTBBk-pPqtAczhig&oe=6AA02419"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rotYkrbChDAQ7kNvwHIGb1c&_nc_oc=AdohLVSvasQxR-UZq8wvGkPBEg9dfVX9LrGLLn1xM7s5BUbzD7Y5YuDM-6hpuFlaKZI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ7ouMpIrNo4irVEdnxtv3aQNz3qBEcH_GuLtQyhb_Hw&oe=6AA0038C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxcMw_XkY00Q7kNvwGMTZ4e&_nc_oc=AdpheXF-HRFaI91a6kpl2weTEcE6P9HMEk--9Qc2uPQujooTemP9wgB7hq6359Ggx1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-ZbLnziOvlZGjH_BEyT13StDkfYdr4EMAOl_JEDGe0w&oe=6AABFAAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ4JpbF0Oi0Q7kNvwEIebKs&_nc_oc=AdoCoppwQZJbMwEfNfD7GfIRqg8OjmFnCfcPmTJCiCpPVP9qxYR5bkyX4qBYgG_TywQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiKXl7VaYWv8StCKcGcFRA0VKnbTAGwG7AgynTq0kjbA&oe=6AABE0ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTWK1C6zs_YQ7kNvwF1DkyH&_nc_oc=Adpu9YwNDiTTH2l9c58Xcdsvf5L77guzB1cE2xBV_M6i7rt6HO9dSwhxMz2ImtNN9Po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuExySMJu4RFyDfqXbUo7AY3Zk0-866sZ8j2vSYoZfyw&oe=6AAC1139"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6C6yFZHrKcQ7kNvwFzT7IL&_nc_oc=AdpGQDhXFQoHFdlp6E8qMDaYDoXoKD_DMuWQcDtPxzMuoR_E3dG2mx3RT-03CwSDTKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBS0MYduE_au1NSK86GiuQeajOytyS7aaRd0-UnCKWPA&oe=6AAC0746"}, {"file_name": "Hero Cover3000x900.png", "id"
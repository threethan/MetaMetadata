3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqClOgN7LfoQ7kNvwH1GIOU&_nc_oc=AdoyfCzlbISB4k8Mb6YofDLot-Tc7_fgx1e3Qrlb6yMSezSLKgZDGh1D6R1cv1CzQ8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFIEPfZngXISiaAm16Z4fD3Z4aDfvp0Rug017of__FMA&oe=6A9D710E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDPH1qD0tQ0Q7kNvwFeCPA4&_nc_oc=AdqmDOLkm1-XU8klh1q3uH9H0csbg8T633vVv4rNN3pu2_HnY0X6QAEUNbE6T_V1qRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1w5PzBdpFx-e5Y1eOilF0XjQyV37cacld5uy2_8s1Mw&oe=6A9D8119"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpqd7Sow5wkQ7kNvwEeqm2x&_nc_oc=Ado1-4cDxmakeAmFvnl0LstNtKjPoJ5oWeMsdXR360mnckLYPd7txEwRKWjiV1biSGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlqVuRaAxhMHWNco0Afgb6rVT3wc4-RlVUkmZWVpKsGg&oe=6A9D608C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
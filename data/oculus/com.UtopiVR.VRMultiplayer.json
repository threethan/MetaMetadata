."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALlKjQjfPh0Q7kNvwFtXDt8&_nc_oc=AdqNnqX8mcQw4Q2OHygpd85We6Ae-ZISDe5j1nvJiF6rORrPLP-Z6frP8DWfr6HfURI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bsmYBNNz6uYh2ZReffigThPCYrT9I-NIl-A2I8-emgw&oe=6A29762F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XouaFiTyxQQ7kNvwF_rEcl&_nc_oc=Adrz7Dc1tKDTRqOaAMjwWYAsigpuFK1_IjH-emB-axW1Qlp7ABPOOOIE_azPjeHY7Y8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jyGhfPS_IcotV1SiNUel44GiYAhGt4vRsVhwrRTtUEQ&oe=6A295C6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSgw1Uvio7sQ7kNvwETxoK6&_nc_oc=AdpL2FgscMc09HLRPOK-eW_60t6NVn3DIL24pO15fObaohDlZTFn7gnm-tLdBYxX2sE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cr15i8oudntn-xNz4YUmuRwr2YObp8c1g3XnY_tfvMA&oe=6A295479"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxiUOiuaz7EQ7kNvwESc-Se&_nc_oc=Adq9443usWBlUUV0LGcxG_rEMGxXvYyEFEfIvjH56T8OGawJeGY58wR-hlgRMHSHJAM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h8qRv7LM1-7m6B79FR9s97L3CRgwTcUvAeANR0W2m8g&oe=6A2982C6"}, {"file_name": "Hero Cover3000x900.png", "id"
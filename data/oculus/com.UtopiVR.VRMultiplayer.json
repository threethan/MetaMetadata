."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guuKtT_y1a4Q7kNvwFTeaHT&_nc_oc=AdoZXrAVKfUxplMRgSF4CAvQWKwSy7D-E9QsvdiWGrRu3ndSV3TOi_QiJ9ULW_gCo_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6cHp6Rtql4mF2zCJjXSc1uNng03E5vtYz9bZqJuX8jg&oe=6A3A99AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsli1CuqsEIQ7kNvwHRNkt4&_nc_oc=Adpo9aY50Awpc0hWG1M6TxZmaAy3BSNkiHXJWYQJ-Lfmwj5jDcrqbTm7KsnZi4iMQqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ouJ2BhHzhQheN1u6XJO0hY33jPTOlYzAxzaetJ6wzTg&oe=6A3AB82D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skx9y6PI-l4Q7kNvwEnw-Sf&_nc_oc=Ado8RdFdmZ9k-pxlLJu9W6xPUaLFAPC-8HY3A4q8V6MOwYbG-fGUBHdy_EXTZm9FXX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sU6NuVEK1iuejMsYGk7QYu5eBVAM4-tKKv5gH3B3_Lg&oe=6A3AB039"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dom813ZjVxkQ7kNvwHpUE1h&_nc_oc=Adr4kIeu1ZQFyZxK2Z-dFz5WyQyyrtBc0bKc-Q3sZI9hViFpMQRyG83DfWPm7JyqXb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yultFsZTF-luoOCC2UsCHMr7ejmFjcE0toHGkBnv6sg&oe=6A3AA646"}, {"file_name": "Hero Cover3000x900.png", "id"
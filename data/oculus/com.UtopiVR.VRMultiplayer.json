."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8WoirYnmNcQ7kNvwFn7OXS&_nc_oc=AdqRbj78Fd88a1LGkldiagjLNBcHoKhRqBhhuyeJdDl8h4HNgos1qtpw-ZN1kKCD_L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAyHHyGgItRH5acUZg3cYVmMXsMQfvzAm79MN8PUlJfw&oe=6AC112AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZehIFO7qI8Q7kNvwEueySK&_nc_oc=Adpp3htfSpscZXq50nq8gL6JISG8WBoDHmDoIfJhQCRgRlgXZIfzZEWdAxSXtu1rfuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOslPJg7Ne5lJzEjvVKRVSqVP4YGflDCUKl9StDhE2dBQ&oe=6AC1312D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FdOnkFz5AAQ7kNvwHTugyo&_nc_oc=AdrFgWILX3Zc3s4q4JfOxmhadXK2UV7w9kw5KeySr0m0kOrS9dTwfx20mZHHsXxcOOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZzcMnSQ41-zEcRfRo4i87erQZuVOnjwWiveHNwkh3AQ&oe=6AC12939"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTYk3Y1DwQIQ7kNvwGDbktz&_nc_oc=Adrm27lYN2J4D5zM_KwUd4axojD9arZ_YfYcjQ9thM66r_Q_HY857uBM00KYBHaXFuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO611tve3oEp5Mj0vuCZLEDmDJDPnHIfYzq9rJvZMz1Lg&oe=6AC11F46"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXBgWMeVw0oQ7kNvwF_RKUU&_nc_oc=AdqzOyQwzblCJLo7Fq-G5QUC2S3UgJdf5qiUT2bX8BKkF9xWPpx6AHj5G8JnGeKdO3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDMupfoWKx-3D7ATl4IdHx47JnYCKmFvf6k-rYN1QoOg&oe=6A997C8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXOnP6G2gl8Q7kNvwF0PGu0&_nc_oc=AdoIj4rT9UfQZClA5mRrS0Eo_qPdC1TbreIyDhJBvKItLiGbE2DaVeiDPadRYfaWrbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbQNErZuMtwZSfwwKrNB-7J-jGRxjB-QHgcVLwtOuuxQ&oe=6A998C99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJZsTpZMIv0Q7kNvwEtKQ6j&_nc_oc=AdoxufFtY-OVZzhaq4iHljdk5GwvZh-oi0D_yq8VJ1vsi98gVxlyGu2KycCT-l_KZpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGWTZGqGE5AYFyIbi158XBOU00jVnhRuqZWjcoD4mkAA&oe=6A996C0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
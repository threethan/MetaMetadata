3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JdP4qrW3b8Q7kNvwH3fkpD&_nc_oc=AdrjtmBCM1faK84rSHGB73t-Nn-x2QpundTA6MqAQeW9X2ghlSNmiA7IQRDBMy8C2Ys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhe_KhaJt9Jp1H66qgTAeidaILH17icyAgTRcgPbFgqw&oe=6ACF8A0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb0AYMd7MgMQ7kNvwGubE8W&_nc_oc=Ado4m6gp5mssWW3EO2HWUKrh_gCrhctutWprDHG_eGR24U0S_gk7xFpzOv3gM3CDzbU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYwSUX4t-gBP3vMqjozfy1oSKXfmCdLwrpmhS3UCja-A&oe=6ACF9A19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD6gQpSt1cUQ7kNvwHYlcvk&_nc_oc=Adohi_6FT6630YoGtPsOzO1eHrb1NbFs7xziDZpSHLiR85Z1gdCSRIjsKXmtaolms7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBFMU3eN41rDz9_rxPwGn2A3tJt7I777N95s4IiE371w&oe=6ACFB1CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
o_XqU-Bng_J4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2EZTdmde5fvYR2XS4KPq0zo5WHztfDa1-dPoC0OENdnw&oe=69F09DD5"}, {"file_name": "Utopi screen 05.png", "id": "1670993150248850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824532_1670993153582183_2928640391252588422_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKCuuMOl3IsQ7kNvwH0wevs&_nc_oc=AdpvL9BVcU84yoqBwEA6HP7SASuUrN1IUOYtfA2ddCYf92BCjTMZ4D990PUBndRFwDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3M2wXnRcyks3uAIrOZpgwOd1uQArQ7PEIhHk8Tv_4h3Q&oe=69F09EF8"}, {"file_name": "Utopi screen 03.png", "id": "1287060295777096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830428_1287060299110429_7519371814019840060_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfSvWceLgqoQ7kNvwFIFUjq&_nc_oc=AdqRcRtNUUx2-r6MpX_W6U--9v_GpC044tpXwEEE6GwobFBIc2ARgVvkQI_0A7sFCtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2gqhc5E8shMcBjBAezjNm8Jgk3Rmens9fM2PNdHEqZfA&oe=69F0BB00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR School", "keywords": [], "long_description": "Long Description\nuTopiVR brings the full experience of a real classroom into virtual reality. Teachers lead live lessons, students interact naturally, and learning feels just like being together in one room. The app features an interactive board for writing, drawing, and sharing slides, as well as personal notebooks where students can instantly copy content with a single click. Beyond simple online classes or educational games, uTopiVR offers authentic, engaging education without travel, without borders, and with unlimited possibilities. Join us and be part of the future of learning.", "short_description": "Immersive VR classroom with live teachers, interactive board, and personal notebooks \u2013 real education without borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "h
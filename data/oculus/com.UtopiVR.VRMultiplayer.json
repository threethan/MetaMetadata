."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7OzpuEKsfQQ7kNvwFqASEw&_nc_oc=AdqYHuXsdB9G-ROKdCcJlDiM2ADcF972IV7b5tCguhnQy60_BBjtmbw-_ovbzaQBBXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bqv9jkN8mVN0Q1LvU_BBSEGseo3is30ZhY_TJ9SyOcg&oe=6A2EBC2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B73_KE_LTnEQ7kNvwFxpeCi&_nc_oc=Adr2_BC6xJ-3D52ypzqbvjcTVIKtPuj_mTKG2mxncXvZbjJGiiG4_c7D7HsKnvtbDWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PBADf_HbuIQIP7pPIvgBGcbE0vQeS3gCZwVYva0xX6A&oe=6A2EA26D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMrJmPHPqTYQ7kNvwGIcaNS&_nc_oc=AdqzMN3eaUbAifY4y6VYIQwS_USLud7c9nzdJKfazMqKP_R7K5E9TQeqPk6BO1QGIXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ATns2EuVl0gN5xbANTuzq_X0aL4uiJRqL3y92tlWnSw&oe=6A2E9A79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiOcCJpJ0NEQ7kNvwHMPGPa&_nc_oc=Adriz4NNHIsLvO-at-tOa3FQPDoUYHV6QObUxvTl1SCpv_4tw-ooTWnTByAnu1IpAnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AvZlol-nh4IxytZazfKU3zIAQW8iLY7QrxiV5NQ7dCA&oe=6A2EC8C6"}, {"file_name": "Hero Cover3000x900.png", "id"
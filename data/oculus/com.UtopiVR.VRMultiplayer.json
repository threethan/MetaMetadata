D91"}, {"file_name": "Utopi screen 01.png", "id": "4303246779911211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618351_4303246783244544_4805874035622876239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxRvQrsC828Q7kNvwHDmsOb&_nc_oc=Adq5lQdfbc09XVpVxhSdA1XSDXBoEAaM9lAz_oZgV0niwNafN6s2t3CqJ0ZME8sEE74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ6UlL0paonlnMVZtufePf95-SHfN3IytmNgnG-wNm9A&oe=6AFDC815"}, {"file_name": "Utopi screen 05.png", "id": "1670993150248850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824532_1670993153582183_2928640391252588422_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxJ8KiswZZYQ7kNvwEdZmYT&_nc_oc=AdrGVAGdMTE0uCN0Ouj2IHtE6LqqlZcfPbPGZ3_l7M4_r_mJUNdk_CYhdTQ1jvvrORo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3gQPUpSjbv23iqVlqXEKZkqEuDPmxasRG5EIT2q1ZFQ&oe=6AFDC938"}, {"file_name": "Utopi screen 03.png", "id": "1287060295777096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830428_1287060299110429_7519371814019840060_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gihq1ua9-bsQ7kNvwFP6M5r&_nc_oc=AdqjcDNoE33YwDrbCAolqNoFuWhtCcqyEt4vZrNBMp70FaG2Ge0KHzE03DzVaa4GHkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSttdX0C6LLCn9Y5HPgVZR3aLwgpFQ6cdet9XlpbWhEPA&oe=6AFDAD00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR School", "keywords": [], "long_description": "Long Description\nuTopiVR brings the full experience of a real classroom into virtual reality. Teachers lead live lessons, students interact naturally, and learning feels just like being together in one room. The app features an interactive board for writing, drawing, and sharing slides, as well as personal notebooks where students can instantly copy content with a single click. Beyond simple online classes or educational games, uTopiVR offers authentic, engaging education without travel, without borders, and with unlimited possibilities. Join us and be part of the future of learning.", "short_description": "Immersive VR classroom with live teachers, interactive board, and personal notebooks \u2013 real education without borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyHDa-Q4WDEQ7kNvwE9aFst&_nc_oc=AdqR4PZEfdoMEY5COcM9UGlq3s0dizypw5HpV3Nk7bkPQeCrIxX2ntZwY9p_UYmuyOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzZghK4rcdO3kj10yW48RvTnpHNy3uxESjkj6YZyD6Zg&oe=6AFDB7AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b17FxPw1EV4Q7kNvwHEr8eC&_nc_oc=Adq9SFMVD9tLLqL6HfxC7is5zT0EwMm0hwhIN23-H9QDXqZNKkC5kD9L9r0ujfFcmdo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjKYv3ZoyoMVGg1jMiqyiUXsULgTOhkLx_GF3FrHVArg&oe=6AFDD62D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jjt9Gqs_Z8oQ7kNvwEXZLpj&_nc_oc=AdqsYyPft5VRrqVHA2Cebj6QWixl4F_FOT7WEEFa2xB9UP5B_tIrgW2PmXJYteWufx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST4uVJQZKnb7BX31_rvu8rvv9lZCd-ZZz4ANkCCHjdzw&oe=6AFDCE39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/49
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjP4Ok5xXt4Q7kNvwGcdr3C&_nc_oc=Adp_oDxU2lvJuBT1VS-9DH3MgLyo4vDywN5-kPqIzbHJ-w96AgwyiBzKBnKFi5ECB5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0o8HTm6Isc_Y0mpEz142P9MNeTZRGM9atdk-nui0a6w&oe=6AEB42AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2aMPRcfqdcQ7kNvwFmEeo6&_nc_oc=AdrWFM12LEZJCFShmeI3Oltzc7q5yiw1l6M2NEVAALtZ7ZHZrCZH2pWUZKKtkSGKQCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeuIL3Pz0aMzyU5MzlCiPCsTAKI_8dXf4Hf6vZ7TGsmQ&oe=6AEB612D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvBcurmIxbsQ7kNvwEOZoPA&_nc_oc=Adrxugf_b7YngyiFIwBCdJFX24W8Ub11XjrKsQZH03-z4TiGQSuCoQU96WLJYHIfuD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR27AcggY2BpNFAyU-YMdUGRe_rgUqku_iqZuvpqY31pA&oe=6AEB5939"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujtjmI93WQkQ7kNvwF2Alub&_nc_oc=AdrgDOTZ7omFOssnxksD8pGP1X8JMjqDFbQZYvAnIII8LMMpSx8wt7WDAhdOJV1t1Ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd3a5ShiZGLe5pzVjWlykRc3xuj712rx6lZmMZm378RQ&oe=6AEB4F46"}, {"file_name": "Hero Cover3000x900.png", "id"
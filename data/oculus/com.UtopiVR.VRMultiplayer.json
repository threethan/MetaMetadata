3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWWTMEbQj_EQ7kNvwHPCnNP&_nc_oc=AdqtajSzRss10usPB-3k4K6Z1NatGUfuGK0B797pOAqwGfvwwxsbHRIXKmylodPcMQs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1QK8QEgePbRMtutOHqE96d3QBm2qC8M2DFfIeKGfWSA&oe=6A9009CE"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hB91Nv93e8QQ7kNvwGlNfQq&_nc_oc=AdplIHuBl90oAoMksINV06MyxvPQwrmBS70oPUal1-O_l9o-heubzHXemabXDbC78y0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl--rz67oodMZHfTKk0Lmcq9K_Svp1T1_3h90oWsGehA&oe=6A9019D9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkrjKxL6rWcQ7kNvwES2BfK&_nc_oc=AdrWgofRxDezvi0w8n09WCH_8C7DB6dLmRpe1l3fL_RPA6qrwNxlz1W9zD1a-MSQRYI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaiy1Nkmof_HaCpIKVf7B7cfmmh5JPH9fssu5Kuu6xmg&oe=6A90318C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
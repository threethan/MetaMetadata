."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-L-gj1RVQkQ7kNvwHh7PZv&_nc_oc=AdoZ_ygNFl6ioSZqQhbHt5P3zl2jxYJvntLG3Vd-Mb4fvAoVMRnE6AtVfDoMNRPD38k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZSk98b9B02rq6CnAI5p-M7Jnzqc8-cLisfzMdYXTQ4Q&oe=6A60D52F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAzXHBv_140Q7kNvwFj68GL&_nc_oc=AdoQQoy_5ENv3eM_EWdFcch42mlN0x4-jVMU1afwxND8Kb_xlWet5aAUY51lbIjU5FI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADKOjIx9eb-BrSiAEf5LOuu9127v1Ff4iwEd_y1IRWGg&oe=6A60BB6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNF4g3iG9YgQ7kNvwHcvLJc&_nc_oc=AdrI7tYP7p_EOmInsTpI7kWiFbqJQfnMImf8Hzjo_0Snbln2Fk8jse12z2jp-Bwxw1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArEbcfOzgkCoV0BermlBPhVqHcUNLBiPU53vSyNmB08Q&oe=6A60B379"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISgls8TrEcgQ7kNvwFe6GFz&_nc_oc=AdoJdrRW-23aIITz8frL1FLbQdttwx4w4EcHtnBiRAjK22b47nL354QSp8yOglXR37Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3NQSfNN-Oc0KvS7jEzdm92KsGjRcmiZshrmJL3e6yeQ&oe=6A60A986"}, {"file_name": "Hero Cover3000x900.png", "id"
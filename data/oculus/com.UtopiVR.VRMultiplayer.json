."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKAz8pTcuLMQ7kNvwFSeWin&_nc_oc=AdpwL21osp8UeD5XtFgMWAQ2uirWMeYRvndXzQ9rq-MwVlGJ01cdMLXGB0uEgtnHMKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vl72g0D9TJMppes5PNr3mXWd53wQ9V_X1R-V5WgnjQg&oe=6A145E2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqJsw9VePLkQ7kNvwGEZLKP&_nc_oc=AdoKXSRYcZpNc5neGFIkEhGAlWR5y1HjD9ozNEn-hrQRiMs7tKGO_p2lXFaDLE91NPY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cuHvqOawPnwUnEeFOeVNabNJMEns8Ou2U1T7uJY6BtQ&oe=6A14446D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvLeBnCrOfsQ7kNvwE15AIG&_nc_oc=Adq2v_vKywk0jeuISeqgNbhNcCk5bWwHPJdDp8aMtCUivn_Sbs6WVLOacAahhK0zOn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af698z2bN7YAqSG-n51rNZD8WvAb8WQYAPpFCWYvGEOopg&oe=6A1474B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHdhG1sZlWYQ7kNvwEuviAG&_nc_oc=AdoJqm_ZysB2r2ZXFV3WKCoIIN19ioMX67K7vQh6YuhQL1_kE4I0APwAp9dWBzu7kVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79RhkT54vjQ5l7M4TKj_qhNHTujSoPChviPjoVoxWMdA&oe=6A146AC6"}, {"file_name": "Hero Cover3000x900.png", "id"
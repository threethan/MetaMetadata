."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxcMw_XkY00Q7kNvwGiWan5&_nc_oc=AdqAy8rGMjXzErjCMfhCyEMa665e2Lp-_7MGFJQYbWL8l5WZrHYh2Z85RYxfZeH8VQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPzEPQbWkMSjKyFRhex9zIdHTuzrIQETwWfjMLYYBcIg&oe=6AAD4C2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjaRIIPtM68Q7kNvwEB54pC&_nc_oc=AdrV25lexuyxmtU4OUcpaYHIJAdOs7_qQUlYRsJ5CCc0twEeGbM_JU6RFdvWkIBGNMA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6Zcx_aBGE63sV7f5lCCyuH2QU67erm2ZN80Bz86BAoA&oe=6AAD326D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLL46xmlJToQ7kNvwGE14no&_nc_oc=AdrPI2i6iqo85EUwyMlfpQScXItdiB9Q2tO-zKAzTnklHytZLOHQhxtFP5WVF5ET3i0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhU-XCXpzzBGma97Oyf0CwlvIqEvzY10q4Fq9P8J8G-A&oe=6AAD62B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6C6yFZHrKcQ7kNvwFrqgPR&_nc_oc=AdpqgRHPlkhZmwifsnwB7xzF6I8dJgIZX7k6vo9TvpNxQSce_CD1ga3Cx4hC-JBL0Qw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICnDV9LS4tlROMKt8WN53Ys9VmEN2CMXQ2NfqdvfdviQ&oe=6AAD58C6"}, {"file_name": "Hero Cover3000x900.png", "id"
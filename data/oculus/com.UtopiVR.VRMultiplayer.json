."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNXFxDHhYdkQ7kNvwHoxsNF&_nc_oc=AdrjK5wtqHoEPTXF-Ry5XzjAOFFcB0bgK8k_wWoq0n3dVc2loCC1UcI_d06OaulKLkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs3ZH_gF5DuaO6M2KLPa7C_RDT8XzYVR2J4rRQwDtZDw&oe=6A6B612F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1XSNGvuwTMQ7kNvwF-HoVw&_nc_oc=AdqUCjDPNUZusUqns6XTUMxnciwT6ftynhLzOMHzKz7PZKX_fYP-FfmO9IDZyFu2eZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC68XJVApT-0TbuoFOteQ2RdT90Vrpyh4KIT48bkvkVdA&oe=6A6B476D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-RLBo6YKpoQ7kNvwFPLq9d&_nc_oc=Adox_jLFPqBKkxVTc1nXdBEqsNmWC9WgWRoeddOWpyt0GdQBYHlEJd-HsIUHD_Rs4fI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfpyrnAbA-k4vgPPzPMvpMa2KUT9N4WZmkWMFdnEFgug&oe=6A6B3F79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sP_dEd2QewQ7kNvwFLygfD&_nc_oc=AdqUKPyXhc2h3jdxsi_RXhr-3kc8Iz_zuzEynLR646n2tKJ5ZbOvzqWPJ77n92ldRB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKvUVQNGVoxyFO7VRs_jS1D5L3HeQyCSipvAL1cEYKsw&oe=6A6B6DC6"}, {"file_name": "Hero Cover3000x900.png", "id"
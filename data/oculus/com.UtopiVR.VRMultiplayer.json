."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x35zK2D8yFEQ7kNvwGGzdt_&_nc_oc=AdoRnuOLX2OnVL0ZPnknox_No3_71H9heDbTjEKn4623f8mpj9N3DynBbfuVbC2uWIM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1liq2xD2fnXkOsrzrXoaH1_XKR_g8CcS-RNfp5kdur3A&oe=69F4BA2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOSTubHOiqgQ7kNvwEXv_4D&_nc_oc=AdomFFyr_3Yejiv7I8smszv4zGpGhJEAsx2OVO2SX_0KbJWuXX5l4cIckbh023bwmYg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23DG5ti-BrwpMjOrjY2zaxXyj99OK5VodwgqmMcV1Fhw&oe=69F4A06D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_9H8gcwsOcQ7kNvwEvPmDS&_nc_oc=AdqqFlxI7lqp1BuyIaPRB0ODuXpuSQvCLa2qdqq3eJjkQKApLHhQgPv1FVvsg_pVtYU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yF1X7SFtxiKu9JLhmkrmyAw7DqMbi4OvBEWJivuK2iw&oe=69F49879"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Afn86ZjJ_xAQ7kNvwEx5l6V&_nc_oc=AdrkvYRoEGFAYWDoKzaEBPVwTIz5jsYMXuzkeSNG9rRZaGUi-5mgynJUbNN-SfMpTD4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mGK-rGeP2h1CPZZMII3RHeWerU0jH6nD3aFq4zGJ2nA&oe=69F4C6C6"}, {"file_name": "Hero Cover3000x900.png", "id"
811"}, {"file_name": "Utopi screen 01.png", "id": "4303246779911211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618351_4303246783244544_4805874035622876239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82W4FDsHrm8Q7kNvwGv7EjJ&_nc_oc=AdqoQV3YxmblYpf-wagLcSQnLOVGPX2tm0B_4UtwLCTesx0tJjPAc_kIHsq-Z4COKkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBklZuOxS9NmiEisVcMVobsg8zX_tZHdGSVL3ihfC52Q&oe=6B070295"}, {"file_name": "Utopi screen 05.png", "id": "1670993150248850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824532_1670993153582183_2928640391252588422_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wT8KcPKfqo0Q7kNvwHUEn2J&_nc_oc=AdpzdeSaYKNA5LkxdJwic_RZKNXgiuwvWEOxLG16W6edI04SkE1F68R-vB1Ko_Qj0b0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkSHylyGs4uB07zTcaeadg1Nd4b2pvbDaZn3vtUQd_eQ&oe=6B0703B8"}, {"file_name": "Utopi screen 03.png", "id": "1287060295777096", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830428_1287060299110429_7519371814019840060_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9feCjdQk3hoQ7kNvwF02N48&_nc_oc=AdoVIorbuobn7UI5D8x63mIVlPMpXT3r8Ak35-a0nw2d4COegS7Z-fm_kOCADrQGFCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNf1ipBgveYrChtOI--vCN0V9z2JwVhb9Tc_boNmJfqA&oe=6B071FC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR School", "keywords": [], "long_description": "Long Description\nuTopiVR brings the full experience of a real classroom into virtual reality. Teachers lead live lessons, students interact naturally, and learning feels just like being together in one room. The app features an interactive board for writing, drawing, and sharing slides, as well as personal notebooks where students can instantly copy content with a single click. Beyond simple online classes or educational games, uTopiVR offers authentic, engaging education without travel, without borders, and with unlimited possibilities. Join us and be part of the future of learning.", "short_description": "Immersive VR classroom with live teachers, interactive board, and personal notebooks \u2013 real education without borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6gSBZ1LhW8Q7kNvwFXDWUX&_nc_oc=AdpkZ6jaDE-cTHbmLsjfmq0jKD7Y4RTsiNLoWH1SLa5t0ihUV6NzXw4n92rjXQKZlkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlYDKR1Jq20dU-dwk93OfcNx5phrJWGuKFSVmn-ukpjg&oe=6B06F22F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F1xQxH0vrEQ7kNvwGQWUm6&_nc_oc=AdoYFm7880BUFUAGPXJwIOSwNUu63A-kSEiN_hTH3iD_QRqm6W0XUirgZRWGTUmWtWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwC1kpjbEMiNyBKwkMX6jtOCiHZmOH72GN5a7UpWZvsw&oe=6B0710AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPa1wBofhrUQ7kNvwFIiz1F&_nc_oc=Adqwcik47RBPRIIuptUH9h09QpSIUAs3reqUe4kLZdhlMAFtW5SWR2J0bET4uz_dE40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB7TT0EMULCy_1IVMCgO7Xt0QFV73M-XtcWlgX3PsebQ&oe=6B0708B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/49
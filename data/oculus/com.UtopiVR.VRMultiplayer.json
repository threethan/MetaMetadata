."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9T8ScWioH0Q7kNvwG7H0D3&_nc_oc=Adplxdpca_31tSczgCRyqqlDGLYCkUfGDMKk1oJ5eNkYQVr-1MbnRooWXrzg9hy5IpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eqJSYi1yYoVQVC1A3zCBtQWRne70msQ_or3D4QavviQ&oe=6A0DC6AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvYS16uxRwoQ7kNvwHfi769&_nc_oc=Adq8nP1BCUW4oIWpBjhwHGwwFWTaHN4itGvzPe3HZha9R4mvWD9maOuWB5Oc3dZGZ5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mV_7H4i4hlXUkK_y1WvMdIhLu35KIm1zbt8pU14Xlyw&oe=6A0DACED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IcxLjlGa1QQ7kNvwEmb8Er&_nc_oc=Adr-ahRiP3h1gxTRAgGg83NV3Q8s8-p_Lfh_FsjQ0sQo_R1Nv0_XY8gvAGa-FwlPjSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FrgLFS6U7k-nv0s4p4BE8JXP9ypS9BsDJATUPnAYraA&oe=6A0DA4F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSDquQBPSaMQ7kNvwFjUWFB&_nc_oc=Adp9Oqg6NOweYtCZJ0KzTvDMD_WCHXmpFWtfkSaJe9sMPjULhfnSIr3XgDdEel0YCK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af515B6-GaXlOhwWVv2py_HXNotHs5gDT-yXNRcHMLArfA&oe=6A0DD346"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_sN1WTvgt4Q7kNvwHPMJWg&_nc_oc=AdrrXFfwyQwocq-Tq-kQxUnSoiRaGDng3sSRrfeW9Rwj5grLqSSVjQ1MRLN88Fglry0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af606vkaMf73P0j7c8F8QEuX6WoA9aKTrgHkyJAabNMQXQ&oe=6A0C6C0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3C0MOsnYrUQ7kNvwGdnInp&_nc_oc=AdoAp-MoDDkBYEjH1ApA-euDheROLlSpAlPeDHKw1nVEZHlgb2RCyMO1CT0C7AhWWB8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72y4i61G7EBZYNITlja1eyd5NK4BX89lv8VabNPyOmTw&oe=6A0C7C19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a80BpwE6djoQ7kNvwG49kwh&_nc_oc=AdoA7LSmmtUQOOIypQRVy8FxMDRNyPCDhkHe2rskok3scwvEJuOeb9HdVP3qB4H94JU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M7m20VaVpnrrk0S5eUJ3tUKHuT68PJTAez4bLyZUutA&oe=6A0C5B8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
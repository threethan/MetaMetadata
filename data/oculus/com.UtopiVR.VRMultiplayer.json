."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lVELzaZc2oQ7kNvwFMhAn1&_nc_oc=AdrCWDg-JPT4ui2-H9wQ83ouL-cqxXBqWbbfdt89jTxGEf-HCWhR4yxZhXxf2tQW8h4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kWOs23QsCtD0SUSwKqu7yyDCC5-EAjSuZZp_gDKD4Fw&oe=69FDF4AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbSZC71aZeMQ7kNvwF8esj8&_nc_oc=AdqiHrM_FZJkx8huDV7oe57FpDBzkdHpPaGrSbDckHmXVxMgL-MvOl-5z45QeuQcZP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gOnpMOOX45YxaAYhLc4OLYs9YDD8PPj5p3-MVt9XeZw&oe=69FDDAED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cHYoW9kAtoQ7kNvwHJkMzf&_nc_oc=AdrVQbkPeuGvWdMxDJhqIlJN-EJmG0qoCH9caev6x5aBaigzm4WGV-9TUSeEwY6mDRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J1zNCzG0JcrPljVjbEJLq_z3qbNDBQKiMvWymynkz4w&oe=69FDD2F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZOY99wMRcgQ7kNvwGiH35V&_nc_oc=AdoFgqvxXIjiP4T1oIoZb5Co5HiLn89lh56U3sPkSZx73xXzIjd0jsyR2QQEL-HfCRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55IKjXErsE0MnbrQHgpE82TPL8mKUapdnzTJzJyVpujQ&oe=69FE0146"}, {"file_name": "Hero Cover3000x900.png", "id"
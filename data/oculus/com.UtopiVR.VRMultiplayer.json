3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZLyH0UY4wgQ7kNvwHCLRkk&_nc_oc=Adq9rqIQG1RJh4rPzWwvqKfHppvYq16UWkt_vfaHwrEc-8aryCRBr4rhsvjmB1mQ6bQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYgBvMLH2mDByceoqC86kTVfIlVBOBDlddIiRUuqKgpQ&oe=6A524B8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoaJaOKUC4kQ7kNvwEkd-Th&_nc_oc=AdoHDUUUkPIo-FFzgEgi9oiEGbj71GgdnIgBNgrc3iFv1S6koBuLZBiof0U1LOJCSas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmsCkdUh9xSN4qRiO93gJvdnbUFQTyBxAVyZPpkOBs7A&oe=6A525B99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDPKE6SAt-sQ7kNvwHkekGO&_nc_oc=AdqTp_r8DHTnOEAg0q_nJEL_LgDjcrPsr0KhcD_qEUicFiM1DK3x4zLuQGw2so195x0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAve0sdZoVSuADgIZXlvSn5Sw5C_BSRg3G1PYfVAU1tg&oe=6A523B0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
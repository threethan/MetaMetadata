3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmgMVI0LaPgQ7kNvwEnHMST&_nc_oc=Adpu0xzJOmo8UBG4I5dC_iev_Fvve1jTSC0EO5Tts2VdSB6mXgm2vFKVy2g-uzMmnNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq4o3K6S6Ytrestr342vU0XwaGTIf8bZfl-US2lkxuDg&oe=6AA2B70E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmC0044sot4Q7kNvwHsXnIp&_nc_oc=Adqd_4Vg8tu8IGb_o6YF_9TswaIOzpFjac-E8eQjeY-iK7NEzwyCwiyhGeSGAXHqhwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnmKY88VDzN9c0XGemzuKZKFTdyMTX83t18rmfVteaSA&oe=6AA2C719"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rotYkrbChDAQ7kNvwHq2aPq&_nc_oc=AdqJ9wjhhcy9Horc83uOKdJSlAYZ4lDsjOXnDgPDNTKmaIBhnUBVkFrnQCRGkw-EZps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWgpi8ifiLTdi-e-0PfqvYZyubO7OBeYkvkyJTtHpQHQ&oe=6AA2A68C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
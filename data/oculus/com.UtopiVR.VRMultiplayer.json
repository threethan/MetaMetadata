3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5wu6DbsDQYQ7kNvwE3uOZ-&_nc_oc=AdqweO3buQFeDH8fyL6L_O1KOXJqOwp13koFJtb6H89n5hZbzX3wsLz6d1MaD4tBuZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSfXdXU0X4OJnU9C9Ug62lRHHwC-S7MAi8EzAD2E_ppw&oe=6A83130E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGX0YqKvaYoQ7kNvwE-HlP6&_nc_oc=AdovFiEtIUD8d8bXRKSQ_PtrlTlWb_0m13nR3ZuBXSn5NsSX06xUfe5uUheqpwLeWjk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDWGNxNIIidiyJ_pMjRK284J67UnK8obC_wnroE0tU8Q&oe=6A82EAD9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E690U93dY8Q7kNvwHwv_VR&_nc_oc=AdoBKZfjDVm5mHi6-8VTcqEG6PrKyy2cfYZs-4V4iHcU512I0PlaA7YaPWLoa7QQfo0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe01jeiTeUvRsl0nsW0J3sMOhLzR-J44HKbUvxKKsXMg&oe=6A83028C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
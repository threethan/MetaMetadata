771-25/499617693_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J7lezgj1ZMQ7kNvwHRYwHu&_nc_oc=AdptYQEeljXa_3LnSKs5qw7FzsLnjjxKy4vDVkvGvxT6o5c84hFbzmFIb18kCk3JzkA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Sy3uPqth4CZAk_c-7jT2g2jN9kEfYVY9nKfA7W-cX7A&oe=6A22D58E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54UTzZaM2A0Q7kNvwF3xfUC&_nc_oc=AdprfHTLiHPKvAg46MCYhT7WNHnQc9OOkCxGO9LiicSuwTnIrMj3qTPT7ltY2Jt1stU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rT0i6HZ3gJm5rj3KNIOaGJDhMc4JpsTSjEP3uYitJPg&oe=6A22E599"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tktfzbih6AsQ7kNvwG-CYAb&_nc_oc=AdpGMDYETRFTfIdLCGa0rv1U2qA2_Q-HvcQLo1MMmvyY51Tv56DaDbvNZ2FG4NZD4Uw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qzcYw2kKkAdmaqv8VQD_IqW90p9VCXTcCy-wo31PFWw&oe=6A22FD4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, be
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNXFxDHhYdkQ7kNvwFt07AM&_nc_oc=AdrrCvVG9Sr9tr3JYot8sDOX-JWDBf9yGmC2fbPpPcmZT03smhzctXofPq30Hwo3Uw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmglJDy3cmaBUE_VsDmZLHtybKs9FEZGh4Uoy1ZHDUGA&oe=6A6A0FAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1XSNGvuwTMQ7kNvwEcotQC&_nc_oc=AdprontFR8XRLe1il8tazHTT8ebeBf1K3iqYgCDzx_gxLFf8G6llNwy5iBj7LvFDNLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9JnQXNJ9t-7VmV87pdVzdQD0qdEhQUciwkT0TVkbcoA&oe=6A69F5ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-RLBo6YKpoQ7kNvwEm2DAJ&_nc_oc=AdrlBCCeJ4LVdIglwu_ZRA_qvU8AGEVmXLg_DUTMEIXb_xgXlMeK9x4vu4RdlAGa6w0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLMYEewgWvETwMF3smvcbLu3uBDrKAAjHG1DNc-9zUrg&oe=6A69EDF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sP_dEd2QewQ7kNvwG_Ivya&_nc_oc=AdoiXrYw0lQEa6u3IZ8Xls3CZJPc1zgPz1TMwf72Mxl-lay6BN8dU2txZVsIwcLVvAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1jX2EIHmDxosIAgQeWVeuhnv49ndqfpLjwTYwhXMmyw&oe=6A69E406"}, {"file_name": "Hero Cover3000x900.png", "id"
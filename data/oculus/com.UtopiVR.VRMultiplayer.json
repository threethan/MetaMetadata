."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJZqfxQZBd4Q7kNvwHTGmWX&_nc_oc=Adqw_nBHu6PgdTGRdd2Xk8AzaA2uMgoNo1JsymLW8LEEIPZWCq8zVkjIy6m-P89kpTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa5iAQ_m27x1V_SGXzV796Ik5t3k_djKStklCN7es6Eg&oe=6AD2362F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYaCxa04Bp4Q7kNvwHQ9yMj&_nc_oc=AdrYJKdJo7sVpFM67xuoR1vRtlMQ10GQvy7pxqjIMD1IPq7djsWx0LIAaYpUiNWTYRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPS0a9HJ1aAlpPKdj8mCHJhrcX9pfhQ-HmSGb47WVa6g&oe=6AD254AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0x2kqttgkIQ7kNvwE_up5J&_nc_oc=AdqrLLjYWR97LQnl6P5umVklf7j3qf6GCN_KanJCKrOwaIfgjLRvQ5okLdVKJjPkpyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpCuuHr9127P3Eya1zqDw8IjZPcTVV0cduthiw2uW1FA&oe=6AD24CB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo2SUEMt9UoQ7kNvwEaV0_A&_nc_oc=AdpcrZVtOqJgIu22gLeM9vA72PQ1QcvUBUxYkUQs7OyMPRYWmXDEnIjYYg28h9Xh9jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXfEENrfoG-2kH1RduD9testj5qUW73KG1DNq0jD0NmA&oe=6AD242C6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U3fgw3Dl0MQ7kNvwF79Xp5&_nc_oc=AdqVMqQV-W44Ca3xO9kOCIPXWPyFll3f6zhIwGsO6S72nKlr2mN9-E9oqo4AgYmEAec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ9PSM4hiAJM_iHb4MCjFu8cpda_8zQLzmZPd70K-8MA&oe=6A491A2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=728GZqgiNVEQ7kNvwH379eI&_nc_oc=AdqRzHKhaK0eGgV_-QC3dCCe0BAzO-rdZe6gkbyxt17eySikTU4R80UNmy07FRgBmb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDthbUX4ugOJK2i6pD9RcgaDDL-W8ZX6tTLiDADotq9MQ&oe=6A49006D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld4Zq0w7K64Q7kNvwHSP6li&_nc_oc=AdrPGfsjxMukLHx4zO7Edpu8N2YOWKHcjVzyoKGRcQ5RYM82jK7dJlZEf17Z3lUYtXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIO6dWksJgwLR4SzPCX594hEUYiB28uiMuEz86CMmLWQ&oe=6A48F879"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBeEuJ137D4Q7kNvwHDcOyJ&_nc_oc=Adqfat8zq1QzEEZp_-N7bTkV1RoFr5JmOadMW0wRrEUVsE6ehq9TFnkDD2IQe9iU1Cw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2Amk06BYTrTGrA8uHYTy3Rl9ROLP1PnllKAKw2tBGcA&oe=6A4926C6"}, {"file_name": "Hero Cover3000x900.png", "id"
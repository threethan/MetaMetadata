771-25/499617693_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYuGjzRdnBMQ7kNvwF6dr3s&_nc_oc=AdqSpR8mKN-eHn5ZfAYhhrdPChGX1ojOat5RYNLuy02CrAOVC8Khn8GdUaWGErMAqyc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tsojuHJ9nBnK-WreIoJxhhMsPf4CAHqRCwp3uEgY4Tg&oe=6A11B20E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfBL9Mh_BpAQ7kNvwFvQJuI&_nc_oc=AdqoAb88Qu0_o2JjosubPPY5jvUyHO8-ZSKgdCuCqbnK0lFUkkflv-25F6CJQPRqQUg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zSwvF2Zpo-njrtcg50B6xBBjj0PyweM8DhLOpIGen5A&oe=6A11C219"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EuGRIJu7vwQ7kNvwFHaL3h&_nc_oc=AdqZvTEYWGmgTML4dIGY-0DpUUoTGNRaDw73GMHVRwAvOdcmcPVt6IXRmvKuskYRaBI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EdV0L-QY9l5sOP7mbDVFNcDsuaZ0XLGAtMFc29uQQGA&oe=6A11A18C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, be
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuB1CAwOc5kQ7kNvwFW7WBj&_nc_oc=AdqwbXxXcjnYSIr0R6ACm_TW438WM0-i7N87wJkGuXniWRW7ulTqUX5wKxYg1j9PHbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ww742bAw0ZYTdMUwJ0XkFtApwUySjBMjUcyEbRq5kLw&oe=69FA002F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hcw2AGW6dkkQ7kNvwED1SKn&_nc_oc=AdrgMjHYkLiEwK1x9VWnKop1K4O_Wo6jQU-iho4vDikNqSXC1X6RE5lL7f9RbLx6TjY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TgZroVZzO-EsiXWjQ9tEngyVR0ORZzZbKZBGfAP2fCw&oe=69F9E66D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3oK_qbJsNUQ7kNvwEkvyPE&_nc_oc=Ado0sEJwaoyW8LUlV0GyoPQ14G8Ac2K61-oj23anZ8FzO5dUZiSrLDuxKSYLS0lKs2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QO38sCguaOfhfJS-ifli-CRQ6MKPPHuf9BlhD_c6Emg&oe=69F9DE79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc6idHtRUwEQ7kNvwHKZbQ2&_nc_oc=AdqJorx7dN4TMGVx962EKQDbOZ7oH8x6B52y9fvj7V_UhdgD2LsUQvQH9l1LUYONSPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vtaGxrT7MF4uT3lid9aSIuLCM2zT2uzXbaq9THtb-NQ&oe=69FA0CC6"}, {"file_name": "Hero Cover3000x900.png", "id"
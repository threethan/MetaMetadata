3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqIxXcWB_fAQ7kNvwFdwEUP&_nc_oc=Adr_w0Ip51DuoxrEU2XfAR6KKIouro1rvymwMPcZJDRFugWwhm9Thl9KiHMZYgzw_YI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIliwuOhQAE2LbNBL7YuF-jsvR75usVatoveSwZYv7-g&oe=6AF8A0CE"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXaaAv9JxtMQ7kNvwGMy-27&_nc_oc=AdrROHAOYl-XjJjctR47jYBqhw8LmYIX2IMbJqDpDWG0CfHH02NlGiFqPjDwYx3Akro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgo9LwKBiCDHAPpqWNW4UzrvZqJYT8JKFKbvclJ2DAUg&oe=6AF87899"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3PAQ_-s3m4Q7kNvwG9jXTV&_nc_oc=Adq0JAxlrdvybv1MMMmzO-wRdciNyt7mw0vfYlRJcpQD3-r4FZG7PYjgB3qY9DjQXU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3xwzHli8dpTqCL9MHGHBFEvY9reC5mPGVJhNBfMbohQ&oe=6AF8904C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
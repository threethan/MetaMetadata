."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZAqVrVjrgYQ7kNvwE9jKVO&_nc_oc=AdqhbGoI2WgHm-I7tr0JUlBZpcZ73ypXntSHEzz9vJjqYpwaQnOglle4ImeqJabxujI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39VeQ_B5dFhbGHOBBGEExR0Uxfg5JvjLYd8uN5-8lvPg&oe=69EF742F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t81UPAlgTYQQ7kNvwHuC3Ct&_nc_oc=Adrn4xQ9yS5vc8BngYiIlva8eNLWGSvXueyeK2WcvZqFYQzpGSTdg7pjqtV9Ng-4LY8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CiLrnJlb8rg1OTxv9X6pgwyAJZzwIgFu9OdTiwByK0g&oe=69EF5A6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBJWoH0D13UQ7kNvwHm-IMi&_nc_oc=AdoDY3wQhIrIhxHF7Oh82JWy5Aed9yJR2lhJ0b5LZ7r0GNNPrVVd1GDa_ceYYPqve6E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ePqnCT2qXtKV7FLoEz0Ez2WI0FSo1wUH-hJPQHHKhMA&oe=69EF5279"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78_XaqNvW18Q7kNvwFoyF4t&_nc_oc=AdqqHZHagK6DlvT44agEGvNxu_dSMrudsdntFroeml6OctI4mb_bp1LUlG6VRRMoRD8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SOuLxHne6i-CGWE6uzF9fFKlU7Fn5ZZ1nP0xE-MM-Uw&oe=69EF4886"}, {"file_name": "Hero Cover3000x900.png", "id"
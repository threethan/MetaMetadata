3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_sN1WTvgt4Q7kNvwEF4MVE&_nc_oc=Ado7T041PO9TzNmyB3Ta1yr6VwechAgx0AXFo5pFlxgO1CKqMSc-otXJYEvNvVQuMHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IG3xYteYeHKSR-qrKA9GRcOJBwdDK_Tqn4AphibO4OA&oe=6A0B1A8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3C0MOsnYrUQ7kNvwEXbQoz&_nc_oc=AdqHWRXSddsY2vfKxGTexINPwHD9Frli5Jszc8StzLfywTxaJRGpbLmzdBxYNBZ6hQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ebn7w7uI-7x9UZljiWk5JzcLa7_JsaXCtBcnr4CMMaQ&oe=6A0B2A99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a80BpwE6djoQ7kNvwEXBoCP&_nc_oc=Adomq6vhZ3i_fcqd7CIU8v_VD26iWgzUe0mzRHxSd91p3Cvd4SVb_GYRxH5iWJmfi2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cAisANfzyQLGByJiMicAr_pktcaemfRKMYAP-WBUGSw&oe=6A0B0A0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
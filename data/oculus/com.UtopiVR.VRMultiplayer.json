."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFv7fLHrzgAQ7kNvwG80rNQ&_nc_oc=AdppOQZe_OYz6g5ulDN3fAFvG6tH_B7x9liptrrLy_q-7IJjXf2sBW31P7Q34-nKSbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmXuCEn-DVfZU1bWUrNW8ExpX836AJJLXuehY3caqm2g&oe=6A64C9AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf50vMv2VGoQ7kNvwHpq-Pc&_nc_oc=AdokmEjGhDpZvZKXjwyMdZzhly63SYqIBJZACqI-vVLc_DsZ8RumLwfhoDXHJUfLuxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo-OzYuf73kLXgHW90q5B6ooYhhJHyd1smKT8sN5oQPQ&oe=6A64AFED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFhhnCnfM3sQ7kNvwEpfk4p&_nc_oc=Adpkar6BG3MdXLQKlYhfIXqUtc9mclwNgYXQWwDbsKmmGT7thz0aLucB6zl_-Pw0gr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9cFBkl_1B4l2iBAeLcPRWqr1QXfRX7FXC4XFbQdqTvA&oe=6A64A7F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSbdZq_0vVYQ7kNvwGteg7V&_nc_oc=AdqwDAlrHxAwqKJzsrB6JR47hnb4YTVb-gu6nodG8vnbPSf6Xxd-YOCrrVfPlgKTlsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnnIaO7w5zSPzoxq1fqkHvL3VzO5XqSH-yhwAOnsArbg&oe=6A649E06"}, {"file_name": "Hero Cover3000x900.png", "id"
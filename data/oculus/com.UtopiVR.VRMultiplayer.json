."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hejPsGFK76sQ7kNvwF9j12W&_nc_oc=AdqY-YaNIZcLQwlncvKSWEml2VPGsSyU0OYtf-sKcRDkuTFdHUQFwvGzVvC8ByxOTfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE93v4795bI40trWpvig6rdRdLHIWNOdIbrpwl96v_PuA&oe=6A82E3EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQmwNeMCVuAQ7kNvwHDd8zN&_nc_oc=AdoZoXpl5XJ7mHY3UaCnFTqBtZlQZdotLZe5NDOsZpy4ypvMftFBrgnm8Pbq-0naryA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVCOtJ6R6jwm44ATrdswpwLJlOs0bMvZ3GQ9hycgWpNQ&oe=6A83026D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTR4XC67ZWoQ7kNvwHebjRE&_nc_oc=AdoPEbsw53ntGsTMVBAI4_MKBYKN59PZp7e_2zC3R00y6eQNdc2F-wEJNIEREy91_Pw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9aut3uA7j9Aecv-opwWnATlqR-P1aQiS3cr8QYLplVA&oe=6A82FA79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZcHdzfzTl8Q7kNvwGCtEga&_nc_oc=AdqqrZXmwCr2h8sxIVpW7zrYxhP7XsMvuuxgDFVJ5R77gChLlfiRjYKVOWWakc-by9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu7qPaGJfdsXtdmTPoq72xa30pQd9FhRXz4b4VjSPDGQ&oe=6A82F086"}, {"file_name": "Hero Cover3000x900.png", "id"
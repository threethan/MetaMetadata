3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J7lezgj1ZMQ7kNvwFXTGPw&_nc_oc=AdpQDlJLOVjyA7xVahf__qGwef8qepoanEBU37jpTBmmj5pUa7wekFb8qr2wETVHb5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fn0hLqS0pt-KIp7XrCNU70sYouRQFx7sInXASqodG2w&oe=6A25788E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54UTzZaM2A0Q7kNvwFq82MC&_nc_oc=AdremWNePqQIVhnNiuuZEG2Jbab2VVeeMhJ46bNiiYliBcZjuBy3eIe-QmisZBnYQxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LlFP-ksbXtklt2OR-hccbDupDpdk6vGE-EOUSXN6mbA&oe=6A258899"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O--ezQmqVLQQ7kNvwHzk-oO&_nc_oc=Adr4SgfOTIkIAYGS0S2ibn6xqPH13Cyoby7UfH1Ps8B4DMBukHQ7JDQvy9AsRlWO3f0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L8ax2yLy6wyB6BG7_RD3Fi5l0yzxjpYFWGKVZJJ59EQ&oe=6A25A04C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
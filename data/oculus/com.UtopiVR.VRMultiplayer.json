3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2f3aV4MAtYQ7kNvwEEiTLQ&_nc_oc=AdqvLsA33ztMvYDx92CWsvZtms8ClXtUv3Zu2Nab6kJ4RBfH5QNGyg0BXKxGGLqjKHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MTDY-EGPL8SNEUmtf4NJMUS_T2MXSa8Hi6z1LbRJlVQ&oe=6A47BF8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2yOu5_E27cQ7kNvwGU1dzB&_nc_oc=AdqVyALHFRV55ZCcY2cLfJSzsmv4DWZdpr3HaVvuyCh2mop37zicEW_-9C8wizuNC2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3LYasMQBRfXlaU-C6WBjCsL4LnFQD3g5No-9Mgu3TDA&oe=6A47CF99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyfk1LjQOvMQ7kNvwHBuY84&_nc_oc=AdpQ13o3h3_loXhC5XZumigaG92qvPheo2HY-IWDDdSainwb0O_NnhSxqW8Pabf9CMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a9b-xKY3ACXEdZzcILWlEoNE3HSvhGMleuuQ-aX1mxA&oe=6A47AF0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
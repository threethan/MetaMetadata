3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvlB_QwxmJMQ7kNvwHMG8OU&_nc_oc=AdoTYsZqbqh8iZepuqkQt-Y_rnjNu_7zkfWEUHtp8rlVBlCTAiyoqTUmx0cDLwMIvyE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_flQBxgh-V5caLvbyziK1WQigyM0q7fqxbMj1f9_3YQg&oe=6A41280E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg77HQyAw1UQ7kNvwFrUOwI&_nc_oc=AdrwJn3pOK6Pn1cNJ1lGpkX08Q88_1cQSKriwn_LlR02UrBvkbvA5azl7O3wSEqSuKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IO7WbrW6BvxMjT-FL2pgOOrj-G90FmSp9bJ_UMD1b7g&oe=6A413819"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ithL1Kqdoi8Q7kNvwGZQ70m&_nc_oc=AdqFpJKeL8McK8CHlofGYIHYSFUK1WdbJ8hll4mWzaot0mas2pIleL_DFp-Z7J6AoVc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BJzliL45lgXWzny0SQKLmngU0r7ImnJByt2Ro5Gbj0A&oe=6A41178C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
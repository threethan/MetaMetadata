."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOnMqQ4T8w8Q7kNvwF1zPAg&_nc_oc=Adqgz7wNzG5YlEfin8f6AxIRpq9pPvv94kyaS65vTBZB_p50P60ic9e9EMV2nbOXRRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G56re9OggdOhqs6oZKmQkV3FI_LNKYAo2ywNrdazk-A&oe=6A01E92F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqggTmQ95roQ7kNvwFB4Zfm&_nc_oc=AdrchioEVZmMh10kUeXUxwMSNEAB1a5j5YEH19fNuP63Ke_S0HKI_kJb-92oH9lpEZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LBWDL-7s-7X6sd8yBlbwW5yuOnwBU4rlLTJ4TVS5qXQ&oe=6A01CF6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaIH_hD4jZIQ7kNvwGTi2qT&_nc_oc=Ado5XhFkRXjVDoaNIF14T0cz5aC6JDTiQOE3Rpv3Fibfe1R6_snxSEJve6KONbHiN5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ClxBN0fEQmacAcdAElPpnCIJf-DUbKJpLli7fidLASg&oe=6A01C779"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O011pryS7S8Q7kNvwFE6ijz&_nc_oc=Ado6Aw1ZWoh_TqyTAqcu9BPtuHuUDz5X_IIfx8gGOPJuAMpWyfxiqcwMLbdW85-NJMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z968C5Nx3fDSBFau3hqfWIGnjeWKuZWzNB-O20jPwOw&oe=6A01F5C6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlNx7jWgygAQ7kNvwG_RfLO&_nc_oc=AdoRU6lq4UegERf4KdVC65zrb-yrMmtdeaePOyxabiF9--XW_Q0HbocQ6RWraP8hHkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfQ0br961fHmjWxIqNGDq3CVZcxdDJlEuSWX96MaxDhQ&oe=6A7B332F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Jg4CJZnWIQ7kNvwG8eNx_&_nc_oc=Adrqqrwe7lJ2ed0JHvqck5j-TMHgqv8LHr79NLHOOE5uwkm5aMeabl6MDNITRvz66t0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_qpEC4FQjNNY7ibNdS67-d0fMNVO_HoccqiA6Ehp_DQ&oe=6A7B196D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EFikze44EMQ7kNvwEfX9eR&_nc_oc=AdqmSOTSrIf710RO8M8_hLIW4yP7bnKEMwKjrdOPGq48rhlzrHt-FF9P4c4F8iPkJ_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnanLsaFYrxH3nZo7fcUT5c1B5i_IlC3A28F-OyvK-ng&oe=6A7B1179"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UHvldolqh4Q7kNvwFeX8q-&_nc_oc=AdpAN7h4UQWneQeDW0SaLjeNWkLGjNRdS_nhZDI8ZQIEXgbHADVaWL0y-BsywgVkgYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlMsVr3jdak4iISnPfsIMNQzM33T82_RDjtklyv1zz4Q&oe=6A7B0786"}, {"file_name": "Hero Cover3000x900.png", "id"
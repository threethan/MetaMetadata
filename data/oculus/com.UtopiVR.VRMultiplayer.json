."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_IVri4XOhAQ7kNvwH_eB0t&_nc_oc=Ado3QVhcdkN4tLWPsbbt1bMdFtJJ1NsYcj2Wm88yu3N5LpzsiPItUKfcWkKAO6A6j3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNVr1ej5GRZ0qX1JW2NjQkboeqOZG2RIVhcCCkCSKR2g&oe=6AB929AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajtG2QdU7PwQ7kNvwFPV3n3&_nc_oc=Adq8SYiabOBSx1B8VSxnwyyc6lBQ47iVWudS-v21P0fNvPBRu_AJrb3IfSskzBTUSOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKLHsuU84TGQEm5w2c8-75KTibNihdAbseK45QDq7K6Q&oe=6AB90FED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47vSXIxUAywQ7kNvwGu7cYW&_nc_oc=Adp69_vtkT__MJyCbO8n2yQwwpbqSkjs5hYhVd7v0BGAFtYv7q1fP4fhgmZl4mIAV80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR9cqxePDnSMCg4afoa83f1MJrX2H-6pC04pByoyHBqg&oe=6AB907F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMh62DyE_LUQ7kNvwGK7qsX&_nc_oc=Adr2nG_I7m7kGhRL3mkeyEfzni82z3aDam7B0zE33oPNA7lfNfUBKK96x7It078medo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT6DuKWMXkDPrK22GkZufQaQd9Gfz3W77SnbY0SuygHw&oe=6AB93646"}, {"file_name": "Hero Cover3000x900.png", "id"
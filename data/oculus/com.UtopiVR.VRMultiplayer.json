."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_BAUpAsXzEQ7kNvwGTnGhe&_nc_oc=AdpkYoYIIoLcylrvI927_WbRE1bSR8GL7sy7EaIp0Q32p-wjumkMzbe6sfESY45L49c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1DtZ4PHTCEfLL8FTWNiyO5Vdabeci3dtRxtAxlD9Ukg&oe=6AC5072F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6inEorzX4UQ7kNvwG48ANb&_nc_oc=AdrrbDLc8ZDdN41TJA4lz-sX_2ed_nswGSCoh1ZllAmyvLUbR67GW9jQmgdXg1P4D5I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE04vUSAS7C5uWV4w4yesNJhzOe7546j3T9mBl4lsWpA&oe=6AC525AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlDzEJGH4nYQ7kNvwHpBeBf&_nc_oc=AdopIyIsxl1ArygdyfPAGhYYOYDg2ivQts0WihWUIuWfR_3YEMCeWjdVfFwQFszW7Kg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKfFwOeQ46cdHDSLQHPz2D00qyXOWF9pEgmTfJUYWv2g&oe=6AC51DB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFE45K8_pHIQ7kNvwG4hVw8&_nc_oc=AdqoFOy-V5HZJdgqRcfMwa1ryeVDm6XDR38jgo-Xbjxj0PJxZE3GWA4I4lDIFgBXOek&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN71iC5nJaZwZTEyUh2nYROpRGiEFPKuUe03E0UDz8KKQ&oe=6AC513C6"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBW5kicfQoAQ7kNvwEPrnqh&_nc_oc=AdpRn_xuiDrYokt9ONQIPFxdN7NJZIStQcQwe5DOI6RIcCVB0Xz6vSD8oFsJJsBy6co&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zSZ56aohg96_9cBYA0u3RLU-RGyxjYwQbnHB0vTJZtw&oe=6A42798E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3Z1lhb-rXUQ7kNvwH21FU0&_nc_oc=AdpmASVpKHNldBJ2LimET6KPuTtVFZ6U54ykjGNGWTbia1zM7SqGrA3hnnBNnjhoYno&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qKt2kWomteUi0wlvPK9QnIRqZKka7iQO7BIYhWgQLgQ&oe=6A428999"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ithL1Kqdoi8Q7kNvwF8AODw&_nc_oc=AdqbqfCVbAYpOwY0HN_JPf7yNz9na6Zzx4fEby0_XmqyboDpcqf2bxXENK4KJF37s94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4_YigbGewbvwV3Ttw0A82dyrS_d7p_jAxkew2LQyZBg&oe=6A42690C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
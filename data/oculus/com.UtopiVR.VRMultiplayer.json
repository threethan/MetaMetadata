3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WQiAHj85rIQ7kNvwGi5QGa&_nc_oc=AdpsCHzZx5vZG_GFrueM5UT9d2gOq4RvkmwQETBCxvxQPe9uwcEl4CWfuTzA5izzcZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3d_JmKAmqgQ5emhX0Qvyz5DAJHqMZuhIJizGGkhz8gQ&oe=6A6B580E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiDFCuxfr7MQ7kNvwEYyCjc&_nc_oc=AdqH-_hBAm1bKEC2k6AnldPa_TzltF9n9WOtEq5B7ynHE39b-YKXRCr4TAK2muf42Fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1apcZrFkO_1MZ4sCJbeO9CQOb469BbuIe84GdNIxUjw&oe=6A6B6819"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6RCFw1g8R8Q7kNvwFU7czi&_nc_oc=AdrktjPFhkmKYnGtq4vmionR0pw2P6hFKb6Fiyn_OBzdrCg5H_104-KhC9eA6zTsBug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUsl_I_3CKXfNcFjiaEiYfIPnxHVmGvmhJPcX_-iBGFg&oe=6A6B478C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
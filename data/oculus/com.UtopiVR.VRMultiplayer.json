."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRIYgO6oqnIQ7kNvwHbcO2h&_nc_oc=Adr2VrOOt-hMuqVgNWuK8Nn4v09SHIOvVuKbYWLB0ec7P6UJvq6MAiAs5Mjwanoeu6M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JnI3DZRkdwt9Ftg7K3o3QV1-6AbNWdGavcDd7VsWd7Q&oe=6A315F2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B73_KE_LTnEQ7kNvwFvgUBR&_nc_oc=AdqPZTyuh2tQxC_BeMhSz0jX8v_AlJ2c53bYjtc6agbGXKdBoAQ7HftlGI76muHKCCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yOBEfma0GZkl4uSGWesV1vfZf7xLNxbRDj3L-Vw8MDg&oe=6A31456D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMrJmPHPqTYQ7kNvwEPKgMm&_nc_oc=AdobHgUQ1U_toikZ0YlSaIFA1eCXENUkzsINJhG1OWGoKYPEQLldhyjUo30eOZKgjVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S0QO6GLMfOPLT2TEG5NuLcwhrWXhk7Q1ZnW_sLUs3Qw&oe=6A3175B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iteYfHpIvTwQ7kNvwEUFl9A&_nc_oc=Adprn5cwoj7-lidy2iB2vEDkeHqGXl_z9buMzTrweETwkmeSwMWen8Fpzko5YFCdoYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6MpBgo47O4Jlq7hmfwFtIfOuas0K3J0uih3kGbGNh3w&oe=6A316BC6"}, {"file_name": "Hero Cover3000x900.png", "id"
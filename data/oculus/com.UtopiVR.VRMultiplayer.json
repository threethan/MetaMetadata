3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzFOu-y8T2EQ7kNvwFoz8pT&_nc_oc=Adp7a9NU9KPhm_8yytbo-OUeiqf9AAeuM3GqHK92tS_V8PKTdwUWZ0lUouefpkh4J4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkzurW-snpFsGxRv7KeI4AL_9QeMUkPr4DJSUKx4wPUQ&oe=6A60CC0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oS5yEoUlfVoQ7kNvwGJ_IYg&_nc_oc=AdpU7CfgE2j0WVggY5BH8TYYpOL6SsPwynJIqfHZz2_EzoFyeKJ6XyU1DgRu3TNr2bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6VlWisVEwdkH8RkGUd3jpnCWYn_X_4hROLbjITq0h8Q&oe=6A60A3D9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r5dDQYW6l0Q7kNvwFeql7O&_nc_oc=AdoJLjZhhzjduOiirk6enqNw_TGD0KzR70o4tYMgvQy3FRmCVTt4Y9_GeKylZgvtmKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2fOveLzwk8a2lJE2Cdjrr8i9Y4extgtsgWJq2ZBdHsQ&oe=6A60BB8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjRpe6VdSFUQ7kNvwH5_8dm&_nc_oc=Adrk-okfKroRPT2nihjIGTbm1VsqNYmjqGEIb4aEN_9XDfP7_5Ik2BF7d15KADRv8p0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMQCIY7wf0ZegKvAh7fgf2C5OQhz0jIVgWIbGoBOKnIQ&oe=6A7B2A0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKxK67121OkQ7kNvwEOsS_Q&_nc_oc=Ados33bOpmkkkLUWicfDKrcsmA0jgsV6UlPhTrrF5eJvo960K6FTGEoaEztKikULUsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcxAS9sQLebma_hkx82E466649AeAW1pNE4fKKEMJyKQ&oe=6A7B3A19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFz0Rt95CgYQ7kNvwGh63kY&_nc_oc=Ado-PRcEHcvLNY9qTlME0Moz1RXK04IbFebxbF6TsIDNvAStbl9PsFxMGI5U0tuaG1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2OEO0tSs_06nzoSd2c4V8D6blMR5aXrDc68NzfUe9Aw&oe=6A7B198C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfmdWX_8IPgQ7kNvwFT0PFa&_nc_oc=Adr1OQ2INuoyxAY362dd-FCttCoEYURVi7Qpf6waGPzuedVGblhgKftQfZ-zgsQ7xug&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nWpBdkNJiD7H3W_YBBNLGVWge8Mu2Gd4TfAIYVDCNXQ&oe=6A17012F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KzWfCGBjrUQ7kNvwEy-h6t&_nc_oc=AdqU2E-cJbOAiz2jV5beuficaXT8FhRJyMUg1EYE3fq1qHYUzRdXDVge8o5Deuhri7g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RG_9phsMTjivO-VYPMpFy9EXy1pb1LVkOd605njkiQg&oe=6A16E76D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnlqfkAowzcQ7kNvwFYlGgi&_nc_oc=AdpgJIovUHcou7RN4pX_QqkSFkblKVLGEJuQIGQA8UIAABN4DfiKDEEQbcAoamgkZw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yDerBAIyyvVF0dcGv_YxxTx_rj36dNGTdRA76Ja3LBg&oe=6A16DF79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6hMCoRg43sQ7kNvwG0aEja&_nc_oc=AdpdLlWKO9jMVvIRMWgFBiUaVMdEUbRWWsC9aA7d4kP_Rnyey7dvNZoJLgIwbLhUK_U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ukPmeT7nlyaQ6VsZBuqs75OuM_GFe3oNlRrDtNTWX_g&oe=6A170DC6"}, {"file_name": "Hero Cover3000x900.png", "id"
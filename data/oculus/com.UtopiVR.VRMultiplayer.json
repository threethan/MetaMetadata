."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfDCfbzjPFgQ7kNvwHcijL-&_nc_oc=AdoyBzGt9rq1EbPHVZQ85l-mZzEmUFE5lsc8TMdYfqX6MnswM6_kp6qSz5bFXDPVx2w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj2eqM92CKNJStiM_Zch_7-GBXKuifAysgVMXy00APEw&oe=6A8829EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuNJlcQEPWoQ7kNvwFCvQOf&_nc_oc=AdqXCiEVTIFoL7d7eWtZNYmaz8Z7_n27ZSafMrgShS8zVlMgvLDO1iWrpuCxURPuJqo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpa4NEJbZvYYebjIBE71OPm-8pxgrkBRgjfzsqUne-Xg&oe=6A88486D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqIxsNz9A8Q7kNvwE1eJe5&_nc_oc=AdrhDkCSQUEaBx-V7k4-NNGL9s2glFgvYGnBA6uSFLAEDInx9kY0O9ndqLo98ILy35M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzIV_N9B7QGSB23mc51mQUM_3zXz36I33TmjVNJJFEAA&oe=6A884079"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U73eLGQ-IUQ7kNvwFR2NaU&_nc_oc=AdohaVACtKS6PhiCHFbsE0iiCkaOskawrAuZ9UZ2QBlJkrSFEEGTn741I9bUWOqvkaY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6_lZRyEhqVMY2ZLTFh75_Ex71GEDPnRP0o5vmil2R0w&oe=6A883686"}, {"file_name": "Hero Cover3000x900.png", "id"
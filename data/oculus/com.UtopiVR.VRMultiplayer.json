."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzukxokXQ9gQ7kNvwEf0uug&_nc_oc=AdrT25IrPGjAkDTN33VaMiaqZ1pm88ZwCAXIFsC0HFSN4jiE0ZW-Ut4eVCSSwNEefD0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWzNTVAvFPiFRWqAV-ZXeARwjwUwBaa_9mIKj8Ux7R9w&oe=6AF8A9EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ya1ETWR8tYQ7kNvwFy987Z&_nc_oc=AdonqbqaLXDZG5pYDD0U1VKjgQMM85nimEYmhx39W6h0Ol0PwBMh83Prbj6mB4pPsOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK_pJEf5qj_2QkkABBZXFGRPEMVb-Kmt1Qar5H6WvKFg&oe=6AF8902D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l-wVypIpFoQ7kNvwFm2n2U&_nc_oc=AdqvqdUAlW6rbyuVj0mPeDUntLkhOz1THtx38ROFT9nZTNnvbgNDtg6rHr5nSI0i7fM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2stlbVM_MtW8IegJBxaZoVQw9BWeFivFICcxOAMX7Mw&oe=6AF88839"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hbj103Cg7cQ7kNvwFOQkn7&_nc_oc=AdrrV71TNi5TzVrYZ3y52VLQuiNCl_ytzulq9fBu5vW-2M1wYTA5LoAE6vqSCg9hFBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmHolY8E508PMdY93VZLP_ZImQRWmWG8WW6yGou9ibCA&oe=6AF87E46"}, {"file_name": "Hero Cover3000x900.png", "id"
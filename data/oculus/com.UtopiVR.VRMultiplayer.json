."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guuKtT_y1a4Q7kNvwG0vkow&_nc_oc=Adr45VDmimHGXLQSoEhWoueNCwPMLHgp7GMhM8hCjRGtEfbC0dIDdGp6YW0MuH1PhdQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hFLMPmkNkKAXddYwRv4I3RaGJsH5zXAkc1jE5zFwFVw&oe=6A3BEB2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wsli1CuqsEIQ7kNvwEXadkh&_nc_oc=AdpHTIUmrZpb7zDbIygq1u1RKHiD7WKFQF0NE40ExDEWJDA58MZJjqGE2QUGCNS7Mt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zUs07EJ0ExGe4uJpZlspwSYunZW2zxtVFsMF4bxnEyw&oe=6A3BD16D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skx9y6PI-l4Q7kNvwFyDVio&_nc_oc=AdpQwIWLEHUeUanK7iOkJ4iYFef5-XMXVlD8iBJWYOWpbHZBySN0UQgf0ksBBwLsPWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SmDZIpargUtEvHjIhjTS49LdaPm72n7KEyMKOCyiigQ&oe=6A3BC979"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dom813ZjVxkQ7kNvwEuhYf4&_nc_oc=Adrk_95IJAe5NKtOX5IMQv2AgeGngOe5HiaCW2d3vOpoukqAlUJqgrfGBEWF8Nh5uPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xe3tGOOQd3DuC-3GXQViKoUc4dLHpwel0m3hCcKa8RA&oe=6A3BF7C6"}, {"file_name": "Hero Cover3000x900.png", "id"
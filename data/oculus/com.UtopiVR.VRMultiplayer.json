3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM_pLofuTfYQ7kNvwH3sTzi&_nc_oc=Adoz1uI57_y44fFRqSq9Ewt9aiL_dmASm193zGFoeVBxFbMtcUA1u3tLnEKJz6mlofY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwEmbEoX_g1FsHDOqG4YO7zcaHaOHv1PZRF4zq6HI0Rg&oe=6A6DFB0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBhXxe1AkIcQ7kNvwF1_BWJ&_nc_oc=Adq3zacVklUtJTjbdLe09Ln5mPVDIJ-0KwJNGgo_VGWS5Y0IK0k62Zb9B2P6s-Au0ps&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD84iZruKRT5iyryVRzD0-dz_zMx9_tet8yUVcLXrGFGQ&oe=6A6DD2D9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lRY6ymKZhwQ7kNvwHe1Qmg&_nc_oc=AdqRvO1gV82Njrj-kjtUcTsPJhH93ozp8z7xGdgGmU_yTaSnjTi8Nf7Bzl7CG2XBAJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6udmeCwMzQvpVtVnWc-FU9VIKYj8MrcH8Ob6u__RAhQ&oe=6A6DEA8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
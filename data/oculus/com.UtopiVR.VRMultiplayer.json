."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbrLGeIzXuwQ7kNvwFlTfer&_nc_oc=Adrrk2CXVmGNE0GBDVE3uNMg7SIUZZU4Rhd0u2PV4CSuV4CpkTI1qtuoElb3wXNG8oo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvZMEymKjuVIgj_bjzGaTYcMaYgTZouQPajPRpN5Vgbw&oe=6A5A3DAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=963A7DODlr4Q7kNvwFUGNRW&_nc_oc=AdqLtSvhu-KvaUAZpPOnO-GSOYFZsHGTcHinLINtAJ-LmIgayTeoXLrn9H5dGVLglUM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhFsBgfJAHmCSCHcL_MCW0-E3bSmjp1diEmuu9w4iDNQ&oe=6A5A23ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHqm3HhQyvwQ7kNvwEGiyya&_nc_oc=AdprsjlcmYtFn8cR1DNyQDOfK2mCu-WHsWtNV5ISB0zRkeGdVeu2-4Pg_YdT5bQ8igU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRtf2KXlAtxolnVbFz5SskL3tkytdV-CEUBzZ__9Qg8Q&oe=6A5A1BF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsHJfen8ymMQ7kNvwE_MXvS&_nc_oc=AdpQGhIQH5BZayRgdYE2CG3wpz5a_RkIDREFnMB8IwEU6367OXe_XDJ-hkiTW44V2cg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClvG32-7w5UKhcPHuAHfT_zf1u-U3Jzdle0qojn7eVww&oe=6A5A4A46"}, {"file_name": "Hero Cover3000x900.png", "id"
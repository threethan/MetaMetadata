."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR9DNYryPtEQ7kNvwEOwWvW&_nc_oc=AdpCVCRRbGBPT9BB2NSLzpJq9wAM2Ab89J0juwCGUBgR9kn-R234XBKL_nVEej3hIMM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b18zv_6j0iIQbJRXj6t1ANJ72DQ1_Ee8KmlR2GBHfbw&oe=6A1AF5AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avSfVpZXl4YQ7kNvwGS1VIk&_nc_oc=AdpzNRaaqnBHyCRRfOyXqIA-1_5fNnqQNlhbPOxsT8LKBJxzfzlKQGxyjlGZYOExq_o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dPqYGulbtci3wghZKt6y7x3-mYtcozlIZlSc7iUOqAw&oe=6A1ADBED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R8zS4yx5QkQ7kNvwHMVIck&_nc_oc=AdoTCwNKxwwtALGQaqlNZnhFhPsJWMzQLImmUzAzL8jFHyXooqyYd4Clhy5-AFZtb8o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WYZmzZrE2Y10Y_6OMddicuVFiRC4CzJ6IX56_nkKjtQ&oe=6A1B0C39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osIniCDshrQQ7kNvwFQQv2o&_nc_oc=AdqbxyDdng7-GTwN9sEaC7muN6a-MVWHALxQ924mtdnlHPjYD4OC73iguA6QqoCkjHk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q4oYJBKBsk65JwX3i-dFlgZ1hGjgiV-z8YrnSf1hq8g&oe=6A1B0246"}, {"file_name": "Hero Cover3000x900.png", "id"
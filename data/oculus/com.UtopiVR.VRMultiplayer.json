3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2wi4vY9VIEQ7kNvwEh_B91&_nc_oc=Adororhj_YVvZrZZ2n3wh_I1Vp8Pb7KpPamttCU-NWfnKTS3T-fR1WebN92zt2yrepY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxHKjSfeoEPxx-8sNr1POOK9NN_rdRptWqXMQHXsLG6g&oe=6AF35ACE"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGhBqmR4WQEQ7kNvwEmaIby&_nc_oc=AdrK32OsDYfvmUDlz1qYAzulBqbIbDiLuUk3M20Dxif_Zk8O95j64JYJ28BLaOTmCDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6fb2SHFz7CE-MPFfHCL-TLyxP4jMS3Wa__8-GWdm7Dw&oe=6AF33299"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6ZD5sL64BcQ7kNvwGSnn_G&_nc_oc=Adp5FIoMH7LsoueHmnM-Aj_OIvPdi2ibs1t83t2s_juWrzX40rHQPCylPz8entwg27A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHnisK3OECvW1lfnP0i0Pa4jMjHAV3Tw6bnnLbqU2fJw&oe=6AF34A4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
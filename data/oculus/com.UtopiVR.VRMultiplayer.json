."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xOlE9msv_MQ7kNvwHOKj3R&_nc_oc=AdpMi9i5cDMG5zHdCUaJDE21vkfdmhcAbPoUuLZy1E9sjeWZsljLMqNXtx72SVSJ5ZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTto_ssBn4TSrvRP4NCJCyadLwZq_mveBtd8HC5tQOD6A&oe=6AEF372F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qybnNRyMXWsQ7kNvwH_kGaB&_nc_oc=AdrwdvkbnHyam4WfBV2-YkYVy5hTjbeP64xE_OKovlDfK1nRz9HPv3j-ASpOYDtutps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWcUHO5evH2NTM5KhUSnm0N_CvadriJJJ7TBXQQ2puxA&oe=6AEF55AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHLnIP3gBpgQ7kNvwFI9sjn&_nc_oc=Adoryhkncp7ckArU7bdqFlq8MAlHhoxz0h-cZhzxrJiWBJXSQb0M80L-aOCdrI3upGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR360fMP1fhrE18nQNXbXlGicCEYFXrPW7dIXvpqHYc4g&oe=6AEF4DB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7pv_YGRECgQ7kNvwFfYqKl&_nc_oc=AdrukI4tEYY5cbN9lzfEyQvyrwKvq1eQSFnGZzKRKhZAUhi3DPfQin6VsCUBeWCsuZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQIoXcjR_1qBhIAq-Ay2F37M4X_TmTlm0PW8cEbuD69g&oe=6AEF43C6"}, {"file_name": "Hero Cover3000x900.png", "id"
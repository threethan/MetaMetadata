391"}, {"file_name": "Utopi screen 01.png", "id": "4303246779911211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618351_4303246783244544_4805874035622876239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYtd72zuJLAQ7kNvwEOinck&_nc_oc=AdoA4dxasYBFxZ4xPBlO2e9HAFhcTKDbbY7X5EW1aUs8R7mDKK_jvJXGp8mVU2eemu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCs56rPUnvu726RsQyp_RL0GcQaqIbaIJu-cx69xNITw&oe=6B030E15"}, {"file_name": "Utopi screen 05.png", "id": "1670993150248850", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824532_1670993153582183_2928640391252588422_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7tUxA-8HGEQ7kNvwF6VZ6V&_nc_oc=AdrN2IcYKPf-owSChN1Ad1ZH-K-WQaSp0iB9VQf2oqoOYocFYgzF9T8Et29PXdtXj7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwF8eJ4bqXiCpWA5V93oYSIcvfCcIuf1v92hRsP69oAw&oe=6B030F38"}, {"file_name": "Utopi screen 03.png", "id": "1287060295777096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830428_1287060299110429_7519371814019840060_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPlfgJM0AuwQ7kNvwH8ojh-&_nc_oc=AdqW403oARtUrI_Bqxuln_uB3VkSyfRGjwlv_oGQKbQ8KSV017rjrkVnm-7sXEiHt_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ7iyGhpwcWtxJ8CCcSo84tjJ3x_sLIYIGCtbiuMDUZw&oe=6B032B40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR School", "keywords": [], "long_description": "Long Description\nuTopiVR brings the full experience of a real classroom into virtual reality. Teachers lead live lessons, students interact naturally, and learning feels just like being together in one room. The app features an interactive board for writing, drawing, and sharing slides, as well as personal notebooks where students can instantly copy content with a single click. Beyond simple online classes or educational games, uTopiVR offers authentic, engaging education without travel, without borders, and with unlimited possibilities. Join us and be part of the future of learning.", "short_description": "Immersive VR classroom with live teachers, interactive board, and personal notebooks \u2013 real education without borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDtGaaYZDtsQ7kNvwGluhVu&_nc_oc=AdoVnBqwJO5cxnTsO-vkV6JO-jNdcEgSlv8zV1Bte4PoWzOAGTBL1TmL7dAhwTSj_P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuQ1Z_KmaL2KXTfBvHSBSg1em3pOS8PuLE0udyZ5qGfQ&oe=6B0335EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjcG6t5QaTUQ7kNvwHb-aIN&_nc_oc=AdoqzfKcPZ5DPpNQ1KDFd4UMmSoJYrtbNjC8RRhvVIvdZxD-1LgCMxZYb-xyGiWjTKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbEYUBlGrzAexpz1YCiGtpbdLOuBr-lZ8D9HHlnEq-Qg&oe=6B031C2D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA6dqIq0YIYQ7kNvwF5BL7b&_nc_oc=AdpuNgH73CAvWEY8tg9r85XnYwVc7FmCu_962od4VCDmOn2ZzzlLr15PIFQuapcKvYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiDx0ZzZjSgTCDb2N8KN0iYxONhfZLAfJKZJJj0l1XyQ&oe=6B031439"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/49
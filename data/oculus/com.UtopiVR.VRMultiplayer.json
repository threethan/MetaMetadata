3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H333oOnj5LgQ7kNvwF8fYkK&_nc_oc=Adqpi2J6QGPVCpAN_yHM8zCZUn3zx3ra36FZtDbiEYnJVgPH6vO5cepJHoT94vaNAmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInGlXwjdIQcSVJJUWSHqwrTPAU5Pt0WNAlcXzWdke55Q&oe=6AA55A0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExOQBbkyiJcQ7kNvwEqiUDX&_nc_oc=Adp_eE708cMQmuefR3IL4wruHx9AZIGgt08Tlhy89QKqRZeb-TA8kqxNq3mOcmJdCAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInMT2hezJakulrjoCIEenSa69MXxpHeqKBke7v7n2Muw&oe=6AA56A19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWSXawJMjfcQ7kNvwGvbuFk&_nc_oc=Adr5tsChyYsJayXYRRWJgVAunmxfaalxSiOO0_Gnwcuk0nQtQHHvekzQKnE9jPNP14c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0cQjJZc3SvxwVVBP5id99lhU9VjWNsNSwCtnnk5U3wg&oe=6AA5498C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
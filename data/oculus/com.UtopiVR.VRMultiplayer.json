3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvEeIBeVbLgQ7kNvwGtSqSW&_nc_oc=AdoJMlKxwj3U--PxT2L5T_BAskjX0tx60rmd6QohvhuwA1nv-aXXxN-TMYbNsPnFPqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKL4yPNGq7vyWGPoN7JNJj06XkeNLeFCoydb_ESMdcMw&oe=6AB3DA8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQhZuOgMIYsQ7kNvwEGKds6&_nc_oc=AdqnbYCKTxX78EHyEUZNBeXKm6sJssM2MKM0TUIu0_oHLMhddDUvxM29PoBlxUGPBjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH3HuZD36UpTRC-9wobp1dAlInGrhSJMW_ZffomwtPIQ&oe=6AB3EA99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcE7wjxLNEgQ7kNvwH8DEAj&_nc_oc=Adosdw5zIWVFQYKfhI-Viv5_sevx-qXai4j0BvpvkaRYWD-jfIj9POea4Q9KQSc-_Ug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRY9kjM_l4G31l63V9OjnEzLsecUhrRqCEEfHZqcda0Q&oe=6AB3CA0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog